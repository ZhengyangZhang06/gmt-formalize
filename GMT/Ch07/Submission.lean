      (Poincare.SimonGMT.Chapter03.blowUpMap a (lams i) '' M)) K) (φ k)).trans_lt (hRa K hK))
    (fun K hK => hνK K hK (subset_univ K)) (fun f hf hfc => hνint f hf hfc (subset_univ _))
    (fun K hK => hνlimsup K hK (subset_univ K))
    (fun k => ((hθ.comp (hmeas (lams (φ k)))).stronglyMeasurable.smul
      (hζ.comp_measurable (hmeas (lams (φ k))))).aestronglyMeasurable)
    hθa.le hζ₀ hRd (fun k => (hsc (φ k)).2.2.2.2.2.2.2) hCrep' (fun k => (hsc (φ k)).2.2.2.1)
  -- Step 7: `ν(B_R(0)) ≤ ωₙRⁿ` and `ν(B_r(0)) > 0`
  have hνball : ∀ R : ℝ, 0 < R →
      ν (ball 0 R) ≤ unitBallVolume (d + 1) * ENNReal.ofReal (R ^ (d + 1)) := by
    intro R hR
    calc ν (ball 0 R)
        ≤ liminf (fun k => (μHE[d + 1].restrict
            (Poincare.SimonGMT.Chapter03.blowUpMap a (lams (φ k)) '' M)) (ball 0 R)) atTop :=
          hνliminf _ isOpen_ball (subset_univ _)
      _ ≤ liminf (fun k => (μHE[d + 1].restrict
            (Poincare.SimonGMT.Chapter03.blowUpMap a (lams (φ k)) '' M)) (closedBall 0 R)) atTop :=
          liminf_le_liminf (Eventually.of_forall fun k => measure_mono ball_subset_closedBall)
      _ ≤ limsup (fun k => (μHE[d + 1].restrict
            (Poincare.SimonGMT.Chapter03.blowUpMap a (lams (φ k)) '' M)) (closedBall 0 R)) atTop :=
          liminf_le_limsup
      _ ≤ unitBallVolume (d + 1) * ENNReal.ofReal (R ^ (d + 1)) := hRb R hR
  have hνpos : ∀ r : ℝ, 0 < r → 0 < ν (ball 0 r) := by
    intro r hr
    have hr2 : 0 < r / 2 := half_pos hr
    have hc : 0 < ENNReal.ofReal (η₁ / (4 * θ a)) *
        (unitBallVolume (d + 1) * ENNReal.ofReal ((r / 2) ^ (d + 1))) :=
      ENNReal.mul_pos (ENNReal.ofReal_pos.2 (div_pos hη₁ (mul_pos four_pos hθa))).ne'
        (ENNReal.mul_pos (measure_ball_pos volume (0 : Euclid (d + 1)) one_pos).ne'
          (ENNReal.ofReal_pos.2 (pow_pos hr2 _)).ne').ne'
    calc 0 < ENNReal.ofReal (η₁ / (4 * θ a)) *
          (unitBallVolume (d + 1) * ENNReal.ofReal ((r / 2) ^ (d + 1))) := hc
      _ ≤ limsup (fun k => (μHE[d + 1].restrict
            (Poincare.SimonGMT.Chapter03.blowUpMap a (lams (φ k)) '' M)) (closedBall 0 (r / 2)))
            atTop :=
          le_limsup_of_frequently_le (hRc (r / 2) hr2).frequently
      _ ≤ ν (closedBall 0 (r / 2)) := hνlimsup _ (isCompact_closedBall 0 (r / 2)) (subset_univ _)
      _ ≤ ν (ball 0 r) := measure_mono (closedBall_subset_ball (half_lt_self hr))
  -- Step 8: `∂C = 0`, as `∂Γ'_{φ(k)} = 0` and `∂Γ'_{φ(k)} ⇀ ∂C`
  have hCbd : C.boundary = 0 := by
    ext ω
    have h : Tendsto (fun k => (Γ' (φ k)).boundary ω) atTop (𝓝 (C.boundary ω)) :=
      hwk.boundary ω
    have h0 : ∀ k, (Γ' (φ k)).boundary ω = 0 := fun k => by
      rw [(hsc (φ k)).2.1, GeometricCurrentOn.zero_apply]
    simp only [h0] at h
    rw [GeometricCurrentOn.zero_apply]
    exact tendsto_nhds_unique h tendsto_const_nhds
  -- Step 9: `M_W(C) = θ(a)ν(W)` for open `W`
  have hCmass : ∀ W : Set (Euclid P), IsOpen W → C.massOn W = ENNReal.ofReal (θ a) * ν W := by
    obtain ⟨β, hβ1, hζβ⟩ := hζnorm a haM
    exact Submission.cbr_ci_const_vector_massOn P (d + 1) ν (θ a • ζ a) (θ a) C
      (fun K hK => hνK K hK (subset_univ K)) hζ₀
      ⟨β, hβ1, by rw [_root_.smul_apply, hζβ, smul_eq_mul, mul_one]⟩ hCrep'
  -- Step 10: `M_W(Γ'_{φ(k)}) + M_W(∂Γ'_{φ(k)}) ≤ μ'_{φ(k)}(closure W)` is bounded in `k` for
  -- `W ⊂⊂ ℝᴾ`: each term is finite and the `limsup` is at most `θ(a)ν(closure W) < ∞`
  have hzero : ∀ W : Set (Euclid P),
      (0 : GeometricCurrentOn (univ : Set (Euclid P)) d).massOn W = 0 := by
    intro W
    refine le_antisymm (sSup_le ?_) zero_le
    rintro r ⟨ω, -, rfl⟩
    simp
  have hsup : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      ⨆ i, ((Γ' (φ i)).massOn W + (Γ' (φ i)).boundary.massOn W) < ∞ := by
    intro W hW hWc
    have hls : limsup (fun k => (ENNReal.ofReal ((lams (φ k))⁻¹ ^ (d + 1)) •
        Measure.map (dilation a (lams (φ k))) μ) (closure W)) atTop < ∞ :=
      (hlimsupμ _ hWc.1).trans_lt
        (ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hνK _ hWc.1 (subset_univ _)))
    obtain ⟨c, hc, hc'⟩ := exists_between hls
    obtain ⟨N, hN⟩ := eventually_atTop.1 (eventually_lt_of_limsup_lt hc)
    have hfin : c + ∑ j ∈ Finset.range N, (ENNReal.ofReal ((lams (φ j))⁻¹ ^ (d + 1)) •
        Measure.map (dilation a (lams (φ j))) μ) (closure W) < ∞ :=
      ENNReal.add_lt_top.2 ⟨hc', ENNReal.sum_lt_top.2 fun j _ => (hsc (φ j)).2.2.1 _ hWc.1⟩
    refine lt_of_le_of_lt (iSup_le fun i => ?_) hfin
    show (Γ' (φ i)).massOn W + (Γ' (φ i)).boundary.massOn W ≤ _
    rw [(hsc (φ i)).2.1, hzero, add_zero, (hsc (φ i)).2.2.2.1 W hW]
    refine (measure_mono subset_closure).trans ?_
    by_cases hi : N ≤ i
    · exact (hN i hi).le.trans le_self_add
    · exact (Finset.single_le_sum (f := fun j => (ENNReal.ofReal ((lams (φ j))⁻¹ ^ (d + 1)) •
        Measure.map (dilation a (lams (φ j))) μ) (closure W)) (fun j _ => zero_le)
        (Finset.mem_range.2 (not_le.1 hi))).trans le_add_self
  -- Step 11: assemble; each `Γ'_{φ(k)}` has the integer slice property, so `C` has it by
  -- `SLIM_{P,d}`
  refine ⟨φ, ν, C, fun k => Γ' (φ k), fun k => ENNReal.ofReal ((lams (φ k))⁻¹ ^ (d + 1)) •
      Measure.map (dilation a (lams (φ k))) μ, fun k y => ζ (a + lams (φ k) • y), hφ,
    fun K hK => hνK K hK (subset_univ K), hνball, hνpos, hCrep, hCbd, hCmass,
    hSLIM (fun k => Γ' (φ k)) C (fun k => Submission.cbr_ci_dilation_slice_property hSL hRU P d a
      (lams (φ k)) Γ (Γ' (φ k)) μ ζ (hlam (φ k)) (hΓ' (φ k)) hΓbd
      (fun K _ => (measure_mono (subset_univ K)).trans_lt hμfin) hζ.aestronglyMeasurable
      (Eventually.of_forall fun x => hζbd x) (hsc 0).1 hΓisp) hsup hwk,
    hwk, fun k => (hsc (φ k)).2.1, fun k => (hsc (φ k)).2.2.1, fun k => (hsc (φ k)).2.2.2.1,
    fun k => (hsc (φ k)).2.2.2.2.1, fun k => Eventually.of_forall fun y => hζbd _,
    fun k => (hsc (φ k)).2.2.2.2.2.1, hlimsupμ, fun k => (hsc (φ k)).2.2.2.2.2.2.1,
    fun K hK => ?_, fun f hf hfc => hνint f hf hfc (subset_univ _)⟩
  calc limsup (fun k => μHE[d + 1]
        (Poincare.SimonGMT.Chapter03.blowUpMap a (lams (φ k)) '' M ∩ K)) atTop
      = limsup (fun k => (μHE[d + 1].restrict
          (Poincare.SimonGMT.Chapter03.blowUpMap a (lams (φ k)) '' M)) K) atTop := by
        congr 1
        funext k
        rw [Measure.restrict_apply hK.isClosed.measurableSet, inter_comm]
    _ ≤ ν K := hνlimsup K hK (subset_univ K)

/-- **Smooth approximation of `g ∈ C_c(ℝᴾ)`** (steps 4–5 of the translation-invariance proof):
mollify, `u_k = ρ_k ⋆ g` with `ρ_k` the normalized mollifier of radius `1/(k+1)`.  Each `u_k` is
`C^∞` (smooth compactly supported kernel against a locally integrable `g`), vanishes off
`K = B̄_{R₀+1}(0)` where `tsupport g ⊆ B̄_{R₀}(0)`, and the averaging estimate
`dist_convolution_le` gives `|u_k| ≤ M = sup ‖g‖` and, by continuity of `g`, `u_k(x) → g(x)`. -/
theorem Submission.cbr_ci_cp_tr_smooth_approx_of_continuous : ∀ (P : ℕ) (g : Euclid P → ℝ), Continuous g → HasCompactSupport g → ∃ (K : Set (Euclid P)) (C : ℝ) (u : ℕ → Euclid P → ℝ), IsCompact K ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (u k)) ∧ (∀ k x, x ∉ K → u k x = 0) ∧ (∀ k x, |u k x| ≤ C) ∧ ∀ x, Tendsto (fun k => u k x) atTop (𝓝 (g x)) := by
  intro P g hg hgc
  -- mollifiers `ρ k ≥ 0`, `∫ ρ k = 1`, supported in `B_{1/(k+1)}(0)`
  choose ρ hρs hρc hρn hρi hρb using fun k : ℕ =>
    Submission.dgcr_stc_exists_normalized_mollifier P (1 / ((k : ℝ) + 1)) Nat.one_div_pos_of_nat
  -- `tsupport g ⊆ B̄_{R₀}(0)` and `‖g‖ ≤ M`
  obtain ⟨R₀, hR₀⟩ := hgc.isCompact.isBounded.subset_closedBall (0 : Euclid P)
  obtain ⟨M, hM⟩ := hg.bounded_above_of_compact_support hgc
  have hgm : AEStronglyMeasurable g volume := hg.aestronglyMeasurable
  refine ⟨closedBall 0 (R₀ + 1), M,
    fun k => convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume,
    isCompact_closedBall 0 (R₀ + 1),
    fun k => (hρc k).contDiff_convolution_left _ (hρs k) hg.locallyIntegrable, ?_, ?_, ?_⟩
  · -- vanishing off `K = B̄_{R₀+1}(0)`
    intro k x hx
    show convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume x = 0
    rw [convolution_def]
    have h0 : ∀ t, ContinuousLinearMap.lsmul ℝ ℝ (ρ k t) (g (x - t)) = 0 := by
      intro t
      by_cases ht : ρ k t = 0
      · simp [ht]
      · have ht' : ‖t‖ < 1 / ((k : ℝ) + 1) := mem_ball_zero_iff.1 (hρb k ht)
        have hk : 1 / ((k : ℝ) + 1) ≤ 1 := by
          rw [div_le_one (by positivity)]
          linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]
        have hxt : x - t ∉ tsupport g := by
          intro hmem
          have h1 : ‖x - t‖ ≤ R₀ := mem_closedBall_zero_iff.1 (hR₀ hmem)
          apply hx
          rw [mem_closedBall_zero_iff]
          calc ‖x‖ = ‖(x - t) + t‖ := by rw [sub_add_cancel]
            _ ≤ ‖x - t‖ + ‖t‖ := norm_add_le _ _
            _ ≤ R₀ + 1 := by linarith
        simp [image_eq_zero_of_notMem_tsupport hxt]
    simp only [h0, integral_zero]
  · -- uniform bound `|u k| ≤ M`
    intro k x
    have h := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := (0 : ℝ))
      ((norm_nonneg _).trans (hM 0)) (hρb k) (hρn k) (hρi k) hgm
      (fun y _ => by rw [dist_zero_right]; exact hM y)
    rw [Real.dist_eq, sub_zero] at h
    exact h
  · -- pointwise convergence `u k x → g x`
    intro x
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨δ, hδ, hgδ⟩ := Metric.continuous_iff.1 hg x (ε / 2) (half_pos hε)
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hδ
    refine ⟨N, fun k hk => ?_⟩
    have hkN : 1 / ((k : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) := Nat.one_div_le_one_div hk
    have h := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := g x)
      (half_pos hε).le (hρb k) (hρn k) (hρi k) hgm
      (fun y hy => (hgδ y ((mem_ball.1 hy).trans_le hkN |>.trans hN)).le)
    exact h.trans_lt (half_lt_self hε)

/-- **Smooth test functions determine measures finite on compacts** (steps 6–7 of the
translation-invariance argument): if `μ, ν` on `ℝᴾ` are finite on compact sets and
`∫ φ dμ = ∫ φ dν` for every `C^∞` `φ` with compact support, then `μ = ν`.  Both measures are
locally finite, hence regular on the `σ`-compact metric space `ℝᴾ`, so by Riesz uniqueness it
suffices to compare `∫ f` for `f ∈ C_c(ℝᴾ, ℝ)`.  Approximate `f` by `C^∞` functions `uₖ`
vanishing off a compact `K`, with `|uₖ| ≤ C` and `uₖ → f` pointwise
(`cbr_ci_cp_tr_smooth_approx_of_continuous`): then `∫ uₖ dμ = ∫ uₖ dν`, and dominated
convergence with the bound `C·1_K` gives `∫ uₖ dμ → ∫ f dμ` and `∫ uₖ dν → ∫ f dν`. -/
theorem Submission.cbr_ci_cp_tr_measure_eq_of_smooth_integral_eq : ∀ (P : ℕ) (μ ν : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ φ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → ∫ y, φ y ∂μ = ∫ y, φ y ∂ν) → μ = ν := by
  intro P μ ν hμ hν hφ
  -- step 1: `μ, ν` are finite on compacts, hence locally finite and regular on `ℝᴾ`
  have : IsFiniteMeasureOnCompacts μ := ⟨fun K hK => hμ K hK⟩
  have : IsFiniteMeasureOnCompacts ν := ⟨fun K hK => hν K hK⟩
  -- step 2: by Riesz uniqueness it suffices to compare `∫ f` for `f ∈ C_c(ℝᴾ, ℝ)`
  refine Measure.ext_of_integral_eq_on_compactlySupported fun f => ?_
  -- step 3: `C^∞` approximants `uₖ → f`, vanishing off a compact `K`, with `|uₖ| ≤ C`
  obtain ⟨K, C, u, hK, hu, huK, huC, hlim⟩ :=
    Submission.cbr_ci_cp_tr_smooth_approx_of_continuous P f f.continuous f.hasCompactSupport
  -- step 5: dominated convergence with the bound `C·1_K`, for `m = μ` and `m = ν`
  have hdom : ∀ m : Measure (Euclid P), m K < ∞ →
      Tendsto (fun k => ∫ x, u k x ∂m) atTop (𝓝 (∫ x, f x ∂m)) := fun m hm =>
    tendsto_integral_of_dominated_convergence (K.indicator fun _ => C)
      (fun k => (hu k).continuous.aestronglyMeasurable)
      ((integrableOn_const hm.ne).integrable_indicator hK.measurableSet)
      (fun k => Eventually.of_forall fun x => by
        by_cases hx : x ∈ K
        · rw [indicator_of_mem hx, Real.norm_eq_abs]
          exact huC k x
        · rw [indicator_of_notMem hx, huK k x hx, norm_zero])
      (Eventually.of_forall hlim)
  -- step 4: each `uₖ` is a `C^∞` test function, so `∫ uₖ dμ = ∫ uₖ dν`
  have heq : (fun k => ∫ x, u k x ∂μ) = fun k => ∫ x, u k x ∂ν :=
    funext fun k => hφ (u k) (hu k) (HasCompactSupport.intro hK (huK k))
  -- step 6: limits in `ℝ` are unique
  have hlimμ := hdom μ (hμ K hK)
  rw [heq] at hlimμ
  exact tendsto_nhds_unique hlimμ (hdom ν (hν K hK))

/-- **Translation invariance from vanishing directional derivatives** (step 2 of the
constant-planes argument): if `ν` on `ℝᴾ` is finite on compact sets and `∫ Dφ(y)[v] dν(y) = 0`
for every `C^∞` `φ` with compact support, then `ν(τ⁻¹A) = ν(A)` for every Borel `A`, where
`τ(x) = v + x`.  `τ` is a homeomorphism, so `τ_#ν` is finite on compact sets
(`τ_#ν(K) = ν(τ⁻¹K)`, `τ⁻¹K = K − v` compact) and `∫ φ d(τ_#ν) = ∫ φ(v + y) dν(y)`, which is
`∫ φ dν` for `φ ∈ C_c^∞(ℝᴾ)` (`cbr_ci_cp_tr_smooth_translate_integral_eq`).  Hence `τ_#ν = ν`
(`cbr_ci_cp_tr_measure_eq_of_smooth_integral_eq`), and `ν(τ⁻¹A) = τ_#ν(A) = ν(A)`. -/
theorem Submission.cbr_ci_cp_translation_invariant_of_fderiv : ∀ (P : ℕ) (ν : Measure (Euclid P)) (v : Euclid P), (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ φ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → ∫ y, fderiv ℝ φ y v ∂ν = 0) → ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => v + x) ⁻¹' A) = ν A := by
  intro P ν v hν hD A hA
  -- `τ(x) = v + x` is a homeomorphism of `ℝᴾ`, hence a measurable embedding
  have hτ : MeasurableEmbedding (fun x : Euclid P => v + x) :=
    (Homeomorph.addLeft v).measurableEmbedding
  -- steps 4–7: `τ_#ν = ν`, both being finite on compacts with equal `C_c^∞` integrals
  have hμ : Measure.map (fun x : Euclid P => v + x) ν = ν := by
    refine Submission.cbr_ci_cp_tr_measure_eq_of_smooth_integral_eq P
      (Measure.map (fun x : Euclid P => v + x) ν) ν (fun K hK => ?_) hν (fun φ hφ hφs => ?_)
    · -- `τ_#ν(K) = ν(τ⁻¹K) < ∞`, `τ⁻¹K = K − v` being compact
      rw [hτ.map_apply]
      exact hν _ ((Homeomorph.addLeft v).isCompact_preimage.2 hK)
    · -- steps 1–3: `∫ φ d(τ_#ν) = ∫ φ(v + y) dν(y) = ∫ φ dν` for `φ ∈ C_c^∞(ℝᴾ)`
      rw [hτ.integral_map]
      exact Submission.cbr_ci_cp_tr_smooth_translate_integral_eq P ν v hν hD φ hφ hφs
  -- step 8: `ν(τ⁻¹A) = τ_#ν(A) = ν(A)` for Borel `A`
  rw [← Measure.map_apply hτ.measurable hA, hμ]

/-- **Riesz vector of the wedge functional `w ↦ ζ₀(w♭ ∧ α)`** (used in the constant tangent plane
step of the compactness theorem, Simon 7.2.4).  For `ζ₀ ∈ Λ_{d+1}(ℝᴾ)` and a fixed `d`-covector
`α` there is `v ∈ ℝᴾ` with `ζ₀(γ) = ⟨v, w⟩` whenever `γ = w♭ ∧ α`, i.e.
`γ(u₀, …, u_d) = Σᵢ (−1)ⁱ ⟨w, uᵢ⟩ α(u₀, …, ûᵢ, …, u_d)`: such a `γ` is `d(⟨w, ·⟩ α)(0)`, which
is linear in `w`, and `v` is the Riesz representative of `w ↦ ζ₀(w♭ ∧ α)`. -/
theorem Submission.cbr_ci_cp_dir_wedge_riesz_vector : ∀ (P d : ℕ) (ζ₀ : MultiVector P (d + 1)) (α : Covector (Euclid P) d), ∃ v : Euclid P, ∀ (w : Euclid P) (γ : Covector (Euclid P) (d + 1)), (∀ u : Fin (d + 1) → Euclid P, γ u = ∑ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (inner ℝ w (u i) * α (i.removeNth u))) → ζ₀ γ = inner ℝ v w := by
  intro P d ζ₀ α
  set W : Euclid P → Covector (Euclid P) (d + 1) :=
    fun w => exteriorDerivative (fun y => inner ℝ w y • α) 0 with hW
  have hWf : ∀ (w : Euclid P) (u : Fin (d + 1) → Euclid P), W w u = ∑ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (inner ℝ w (u i) * α (i.removeNth u)) := by
    intro w u
    have hd : DifferentiableAt ℝ (fun y => inner ℝ w y) (0 : Euclid P) :=
      (innerSL ℝ w).differentiableAt
    rw [hW, Submission.dgcr_bwd_extDeriv_smul_const P d (fun y => inner ℝ w y) α 0 u hd]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have hf : fderiv ℝ (fun y => inner ℝ w y) (0 : Euclid P) = innerSL ℝ w :=
      (innerSL ℝ w).fderiv
    rw [hf, innerSL_apply_apply]
  have huniq : ∀ (w : Euclid P) (γ : Covector (Euclid P) (d + 1)), (∀ u : Fin (d + 1) → Euclid P, γ u = ∑ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (inner ℝ w (u i) * α (i.removeNth u))) → γ = W w := by
    intro w γ hγ
    ext u
    rw [hγ u, hWf w u]
  have hadd : ∀ w w' : Euclid P, W (w + w') = W w + W w' := by
    intro w w'
    ext u
    rw [ContinuousAlternatingMap.add_apply, hWf, hWf, hWf, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [inner_add_left]
    ring
  have hsmul : ∀ (c : ℝ) (w : Euclid P), W (c • w) = c • W w := by
    intro c w
    ext u
    rw [ContinuousAlternatingMap.smul_apply, hWf, hWf, smul_eq_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [real_inner_smul_left]
    ring
  let ℓ : Euclid P →ₗ[ℝ] ℝ :=
    { toFun := fun w => ζ₀ (W w)
      map_add' := by
        intro w w'
        simp only [hadd, map_add]
      map_smul' := by
        intro c w
        simp only [hsmul, map_smul, smul_eq_mul, RingHom.id_apply] }
  refine ⟨(InnerProductSpace.toDual ℝ (Euclid P)).symm (LinearMap.toContinuousLinearMap ℓ), ?_⟩
  intro w γ hγ
  rw [InnerProductSpace.toDual_symm_apply, huniq w γ hγ]
  rfl
/-- **Vanishing of `∫ Dφ[v] dν` on a set of directions extends to its span** (the linearity step
of the constant-planes argument for the closure and boundary rectifiability in the compactness
theorem).  If `ν` is finite on compact sets and `φ : ℝᴾ → ℝ` is `C^∞` with compact support, then
each `y ↦ Dφ(y)[v]` is continuous with compact support, hence `ν`-integrable, so
`v ↦ ∫ Dφ(y)[v] dν(y)` is linear; if it vanishes on `S`, it vanishes on `span S`. -/
theorem Submission.cbr_ci_cp_dir_integral_fderiv_span : ∀ (P : ℕ) (ν : Measure (Euclid P)) (φ : Euclid P → ℝ) (S : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → (∀ v ∈ S, ∫ y, fderiv ℝ φ y v ∂ν = 0) → ∀ v ∈ Submodule.span ℝ S, ∫ y, fderiv ℝ φ y v ∂ν = 0 := by
  intro P ν φ S hν hφ hφc hS
  have : IsFiniteMeasureOnCompacts ν := ⟨fun K hK => hν K hK⟩
  have hint : ∀ v, Integrable (fun y => fderiv ℝ φ y v) ν := by
    intro v
    have hc : Continuous (fun y => fderiv ℝ φ y v) :=
      (hφ.continuous_fderiv (by simp)).clm_apply continuous_const
    exact hc.integrable_of_hasCompactSupport (hφc.fderiv_apply (𝕜 := ℝ) v)
  intro v hv
  induction hv using Submodule.span_induction with
  | mem x hx => exact hS x hx
  | zero => simp
  | add x y _ _ hx hy =>
    simp only [map_add]
    rw [integral_add (hint x) (hint y), hx, hy, add_zero]
  | smul c x _ hx =>
    simp only [map_smul, smul_eq_mul]
    rw [integral_const_mul, hx, mul_zero]
/-- **Testing a cycle condition on `φ α`** (used for the constant-plane step of White's
tangent-plane argument in the closure theorem behind Simon 7.2.4).  If `∫ ζ₀(dψ(y)) dν(y) = 0`
for every test `d`-form `ψ`, and `ζ₀(w♭ ∧ α) = v · w` for every `w`, where
`(w♭ ∧ α)(u₀, …, u_d) = Σᵢ (−1)ⁱ (w · uᵢ) α(u₀, …, ûᵢ, …, u_d)`, then `∫ Dφ(y)v dν(y) = 0`
for every compactly supported `C^∞` function `φ`: `φ α` is a test form with
`d(φ α)(y) = ∇φ(y)♭ ∧ α`, so `ζ₀(d(φ α)(y)) = v · ∇φ(y) = Dφ(y)v`. -/
theorem Submission.cbr_ci_cp_dir_cycle_fderiv_integral_zero : ∀ (P d : ℕ) (ν : Measure (Euclid P)) (ζ₀ : MultiVector P (d + 1)) (α : Covector (Euclid P) d) (v : Euclid P) (φ : Euclid P → ℝ), (∀ ψ : TestFormOn (univ : Set (Euclid P)) d, ∫ y, ζ₀ (exteriorDerivative (ψ : DifferentialForm (Euclid P) d) y) ∂ν = 0) → (∀ (w : Euclid P) (γ : Covector (Euclid P) (d + 1)), (∀ u : Fin (d + 1) → Euclid P, γ u = ∑ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (inner ℝ w (u i) * α (i.removeNth u))) → ζ₀ γ = inner ℝ v w) → ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → ∫ y, fderiv ℝ φ y v ∂ν = 0 := by
  intro P d ν ζ₀ α v φ hcyc hv hφ hφc
  have hmem : (fun y => φ y • α : DifferentialForm (Euclid P) d) ∈
      TestFormOn (univ : Set (Euclid P)) d :=
    ⟨⟨hφ.smul contDiff_const, hφc.smul_right⟩, subset_univ _⟩
  have h := hcyc ⟨_, hmem⟩
  rw [← h]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  have hd : DifferentiableAt ℝ φ y := (hφ.differentiable (by simp)) y
  set g : Euclid P := (InnerProductSpace.toDual ℝ (Euclid P)).symm (fderiv ℝ φ y) with hg
  have hγ : ∀ u : Fin (d + 1) → Euclid P, exteriorDerivative (fun y => φ y • α) y u = ∑ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (inner ℝ g (u i) * α (i.removeNth u)) := by
    intro u
    rw [Submission.dgcr_bwd_extDeriv_smul_const P d φ α y u hd]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hg, InnerProductSpace.toDual_symm_apply]
  have hz := hv g _ hγ
  show fderiv ℝ φ y v = ζ₀ (exteriorDerivative (fun y => φ y • α) y)
  rw [hz, real_inner_comm, hg, InnerProductSpace.toDual_symm_apply]

/-- **Translation directions of a constant-orientation cycle** (the vectors `v_α` of the
tangent-plane step in the closure and boundary rectifiability part of Simon 7.2.4).  Let `ν` be a
Borel measure on `ℝᴾ`, finite on compact sets, and `ζ₀ ∈ Λ_{d+1}(ℝᴾ)` with `∫ ⟨dφ, ζ₀⟩ dν = 0` for
every test `d`-form `φ`.  For a `d`-covector `α` let `v_α` represent `w ↦ ⟨w♭ ∧ α, ζ₀⟩`, where
`(w♭ ∧ α)(u₀, …, u_d) = Σᵢ (−1)ⁱ ⟨w, uᵢ⟩ α(u₀, …, ûᵢ, …, u_d)`.  Then `V = span{v_α}` satisfies
`∫ Dψ[v] dν = 0` for `v ∈ V` and `ψ ∈ C_c^∞(ℝᴾ)` (test the cycle condition on `ψα`, using
`d(ψα) = (∇ψ)♭ ∧ α`), and `⟨w♭ ∧ α, ζ₀⟩ = ⟨v_α, w⟩ = 0` for `w ∈ Vᗮ`. -/
theorem Submission.cbr_ci_cp_wedge_annihilator_subspace : ∀ (P d : ℕ) (ν : Measure (Euclid P)) (ζ₀ : MultiVector P (d + 1)), (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ φ : TestFormOn (univ : Set (Euclid P)) d, ∫ y, ζ₀ (exteriorDerivative (φ : DifferentialForm (Euclid P) d) y) ∂ν = 0) → ∃ V : Submodule ℝ (Euclid P), (∀ v ∈ V, ∀ φ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → ∫ y, fderiv ℝ φ y v ∂ν = 0) ∧ ∀ w ∈ Vᗮ, ∀ (α : Covector (Euclid P) d) (γ : Covector (Euclid P) (d + 1)), (∀ u : Fin (d + 1) → Euclid P, γ u = ∑ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (inner ℝ w (u i) * α (i.removeNth u))) → ζ₀ γ = 0 := by
  intro P d ν ζ₀ hν hcyc
  choose v hv using Submission.cbr_ci_cp_dir_wedge_riesz_vector P d ζ₀
  refine ⟨Submodule.span ℝ (range v), fun u hu φ hφ hφc => ?_, fun w hw α γ hγ => ?_⟩
  · refine Submission.cbr_ci_cp_dir_integral_fderiv_span P ν φ (range v) hν hφ hφc ?_ u hu
    rintro _ ⟨α, rfl⟩
    exact Submission.cbr_ci_cp_dir_cycle_fderiv_integral_zero P d ν ζ₀ α (v α) φ hcyc (hv α)
      hφ hφc
  · rw [hv α w γ hγ]
    exact Submodule.inner_right_of_mem_orthogonal (Submodule.subset_span (mem_range_self α)) hw
/-- **An orthonormal basis of `ℝᴾ` adapted to a subspace `V`** (used to show that an `n`-vector
annihilating every `w♭ ∧ α` with `w ⊥ V` only sees `β ∘ p_V`): each basis vector lies in `V` or in
`Vᗮ`.  `V` and `Vᗮ` are orthogonal, and a vector orthogonal to `V + Vᗮ` lies in `Vᗮ ∩ Vᗮᗮ = 0`, so
`ℝᴾ` is the internal orthogonal direct sum of `V` and `Vᗮ`.  Concatenating orthonormal bases of
`V` and `Vᗮ` and re-indexing by `Fin P` (`finrank ℝ ℝᴾ = P`) gives the basis. -/
theorem Submission.cbr_ci_cp_pr_adapted_orthonormalBasis : ∀ (P : ℕ) (V : Submodule ℝ (Euclid P)), ∃ e : OrthonormalBasis (Fin P) ℝ (Euclid P), ∀ i : Fin P, e i ∈ V ∨ e i ∈ Vᗮ := by
  intro P V
  -- Step 1: `b ↦ cond b V Vᗮ` is an orthogonal family of subspaces
  have hW' : OrthogonalFamily ℝ (fun b : Bool => ↥(cond b V Vᗮ))
      fun b => (cond b V Vᗮ).subtypeₗᵢ :=
    V.orthogonalFamily_self
  -- Step 2: it is internal, since `(V ⊔ Vᗮ)ᗮ ≤ Vᗮ ⊓ Vᗮᗮ = ⊥`
  have hW : DirectSum.IsInternal fun b : Bool => cond b V Vᗮ := by
    rw [hW'.isInternal_iff, Submodule.eq_bot_iff]
    intro x hx
    have h1 : x ∈ Vᗮ :=
      Submodule.orthogonal_le (le_iSup (fun b : Bool => cond b V Vᗮ) true) hx
    have h2 : x ∈ Vᗮᗮ :=
      Submodule.orthogonal_le (le_iSup (fun b : Bool => cond b V Vᗮ) false) hx
    exact Submodule.disjoint_def.mp (Submodule.orthogonal_disjoint Vᗮ) x h1 h2
  -- Step 3: the orthonormal basis subordinate to this decomposition, indexed by `Fin P`; its
  -- `i`-th vector lies in the summand `cond b V Vᗮ` for some `b : Bool`
  refine ⟨hW.subordinateOrthonormalBasis finrank_euclideanSpace_fin hW', fun i => ?_⟩
  have hmem := hW.subordinateOrthonormalBasis_subordinate finrank_euclideanSpace_fin i hW'
  revert hmem
  generalize hW.subordinateOrthonormalBasisIndex finrank_euclideanSpace_fin i hW' = b
  cases b
  · intro hmem
    exact Or.inr hmem
  · intro hmem
    exact Or.inl hmem
/-- The determinant `n`-covector of `g₀, …, g_{n-1} ∈ ℝᴾ`: `u ↦ det(⟨g_b, u_a⟩)_{a,b}`, with
`⟨g_b, u_a⟩` in row `a` and column `b` (for an orthonormal basis `e'`, the dual covectors `e'^I`
of the projection reduction in White's proof that limits are integer multiplicity, Simon 6.3.11).
Row `a` is `L u_a` for the linear map `L x = (⟨g_b, x⟩)_b`, so this is the row determinant
`detRowAlternating` composed with `L`, an alternating `n`-linear map.  It is continuous, the
determinant being a polynomial in the continuous entries `⟨g_b, u_a⟩`.  For `n = 0` it is the
constant `1`. -/
theorem Submission.cbr_ci_cp_pr_inner_det_covector : ∀ (P n : ℕ) (g : Fin n → Euclid P), ∃ γ : Covector (Euclid P) n, ∀ u : Fin n → Euclid P, γ u = Matrix.det (Matrix.of fun a b => inner ℝ (g b) (u a)) := by
  intro P n g
  -- the alternating map `u ↦ D(L u₀, …, L u_{n-1})`, `D` the row determinant
  let f : Euclid P [⋀^Fin n]→ₗ[ℝ] ℝ :=
    Matrix.detRowAlternating.compLinearMap (LinearMap.pi fun b => innerₛₗ ℝ (g b))
  have hf : ∀ u, f u = Matrix.det (Matrix.of fun a b => inner ℝ (g b) (u a)) := fun _ => rfl
  -- continuity: a polynomial in the continuous entries `⟨g_b, u_a⟩`
  have hc : Continuous fun u : Fin n → Euclid P =>
      Matrix.det (Matrix.of fun a b => inner ℝ (g b) (u a)) := by
    fun_prop
  exact ⟨⟨⟨f.toMultilinearMap, hc.congr fun u => (hf u).symm⟩, f.map_eq_zero_of_eq'⟩, hf⟩

/-- Laplace expansion of a determinant covector along column `k`.  If the `(d + 1)`-covector `γ`
is `u ↦ det (⟨g b, u a⟩)_{a b}`, then `γ u = ∑ᵢ (-1)ⁱ ⟨g k, u i⟩ α (u₀, …, ûᵢ, …, u_d)` with
`α = (-1)ᵏ γ'`, where `γ'` is the `d`-covector `v ↦ det (⟨g (k.succAbove b), v a⟩)_{a b}` of the
tuple `g` with `g k` deleted (`cbr_ci_cp_pr_inner_det_covector`): the `(i, k)` minor of
`(⟨g b, u a⟩)_{a b}` is that matrix for `v = i.removeNth u`. -/
theorem Submission.cbr_ci_cp_pr_det_covector_laplace : ∀ (P d : ℕ) (g : Fin (d + 1) → Euclid P) (k : Fin (d + 1)) (γ : Covector (Euclid P) (d + 1)), (∀ u : Fin (d + 1) → Euclid P, γ u = Matrix.det (Matrix.of fun a b => inner ℝ (g b) (u a))) → ∃ α : Covector (Euclid P) d, ∀ u : Fin (d + 1) → Euclid P, γ u = ∑ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (inner ℝ (g k) (u i) * α (i.removeNth u)) := by
  intro P d g k γ hγ
  -- Step 1: the minor covector `γ'` of `g` with its `k`-th entry deleted, and `α = (-1)ᵏ γ'`.
  obtain ⟨γ', hγ'⟩ := Submission.cbr_ci_cp_pr_inner_det_covector P d (fun b => g (k.succAbove b))
  refine ⟨((-1 : ℝ) ^ (k : ℕ)) • γ', fun u => ?_⟩
  -- Step 2: Laplace expansion of `det (⟨g b, u a⟩)_{a b}` along column `k`.
  rw [hγ u, Matrix.det_succ_column _ k]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [ContinuousAlternatingMap.smul_apply, hγ' (i.removeNth u), smul_eq_mul]
  -- Step 3: the `(i, k)` minor is the matrix of `i.removeNth u` against `g ∘ k.succAbove`.
  have hsub : (Matrix.of fun a b => inner ℝ (g b) (u a)).submatrix i.succAbove k.succAbove =
      Matrix.of fun a b => inner ℝ (g (k.succAbove b)) (i.removeNth u a) := by
    ext a b
    simp [Fin.removeNth]
  -- Step 4: `(-1) ^ (i + k) = (-1) ^ i * (-1) ^ k`.
  rw [hsub, Matrix.of_apply, pow_add]
  ring
/-- `n! · β(u) = ∑_I β(e_I) · det(⟨e_{I(b)}, u_a⟩)_{a,b}` for an `n`-covector `β` on `ℝᴾ`, an
orthonormal basis `e` of `ℝᴾ` and `u ∈ (ℝᴾ)ⁿ`, the sum running over all index maps
`I : Fin n → Fin P` (the expansion of `β` in the basis dual to `e`, used for the projection
reduction of constant plane currents in the integer multiplicity part of Simon 7.2.4, Remark
7.2.5(1)).  Expanding every argument in the basis `e` gives
`β(v) = ∑_I (∏_a ⟨e_{I(a)}, v_a⟩) β(e_I)`; as `β` is alternating,
`n! · β(u) = ∑_σ sign(σ) β(u ∘ σ)`; the Leibniz formula collects the sums over `σ` into the
determinants. -/
theorem Submission.cbr_ci_cp_pr_factorial_mul_eq_sum_det : ∀ (P n : ℕ) (e : OrthonormalBasis (Fin P) ℝ (Euclid P)) (β : Covector (Euclid P) n) (u : Fin n → Euclid P), (n.factorial : ℝ) * β u = ∑ I : Fin n → Fin P, β (fun a => e (I a)) * Matrix.det (Matrix.of fun a b => inner ℝ (e (I b)) (u a)) := by
  intro P n e β u
  classical
  -- multilinear expansion of `β` in the orthonormal basis `e`
  have hexp : ∀ v : Fin n → Euclid P, β v =
      ∑ I : Fin n → Fin P, (∏ a, inner ℝ (e (I a)) (v a)) * β (fun a => e (I a)) := by
    intro v
    have hv : v = fun a => ∑ m, inner ℝ (e m) (v a) • e m := by
      funext a
      exact (e.sum_repr' (v a)).symm
    conv_lhs => rw [hv]
    rw [β.map_sum]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [β.map_smul_univ (fun a => inner ℝ (e (I a)) (v a)) (fun a => e (I a)), smul_eq_mul]
  -- alternation: `sign(σ) β(u ∘ σ) = sign(σ)² β(u) = β(u)`, and there are `n!` permutations
  have halt : (n.factorial : ℝ) * β u =
      ∑ σ : Equiv.Perm (Fin n), (Equiv.Perm.sign σ : ℝ) * β (u ∘ σ) := by
    have : ∀ σ : Equiv.Perm (Fin n), (Equiv.Perm.sign σ : ℝ) * β (u ∘ σ) = β u := by
      intro σ
      rw [show β (u ∘ σ) = Equiv.Perm.sign σ • β u from β.toAlternatingMap.map_perm u σ]
      rw [Units.smul_def, zsmul_eq_mul, ← mul_assoc]
      have hs : ((Equiv.Perm.sign σ : ℤ) : ℝ) * ((Equiv.Perm.sign σ : ℤ) : ℝ) = 1 := by
        rw [← Int.cast_mul, ← Units.val_mul, Int.units_mul_self, Units.val_one, Int.cast_one]
      rw [hs, one_mul]
    rw [Finset.sum_congr rfl fun σ _ => this σ, Finset.sum_const, Finset.card_univ,
      Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
  rw [halt]
  -- expand only `β (u ∘ σ)` (the right side of `hexp` contains `β` again), then swap the sums
  have h2 : ∀ σ : Equiv.Perm (Fin n), (Equiv.Perm.sign σ : ℝ) * β (u ∘ σ) =
      ∑ I : Fin n → Fin P, (Equiv.Perm.sign σ : ℝ) *
        ((∏ a, inner ℝ (e (I a)) ((u ∘ σ) a)) * β (fun a => e (I a))) := by
    intro σ
    rw [hexp (u ∘ σ), Finset.mul_sum]
  rw [Finset.sum_congr rfl fun σ _ => h2 σ, Finset.sum_comm]
  -- for fixed `I`, the sum over `σ` is the Leibniz formula for the determinant
  refine Finset.sum_congr rfl fun I _ => ?_
  rw [Matrix.det_apply', Finset.mul_sum]
  refine Finset.sum_congr rfl fun σ _ => ?_
  simp only [Matrix.of_apply, Function.comp_apply]
  ring

/-- **Series of currents of finite total mass** (the closing step of B3 in the proof of the
deformation theorem, Simon 6.5.1, where it replaces the completeness theorem 6.3.13).
Let `Wᵢ ∈ 𝒟ₖ₊₁(ℝᴾ)` with `Σᵢ M(Wᵢ) < ∞`.  The series `S(ω) = Σᵢ Wᵢ(ω)` defines a current with
`M(S) ≤ Σᵢ M(Wᵢ)` and, by (VO), `spt S ⊆ closure ⋃ᵢ spt Wᵢ`.  If every `Wᵢ = τ(Mᵢ, θᵢ, ξᵢ)` is
integer multiplicity, then (MR) with `U = W = ℝᴾ` gives `∫_{Mᵢ} θᵢ dH^{k+1} = M(Wᵢ)`, so the
representations have finite total weight and their actions sum to the action of one `IMRep`
`R'`; by uniqueness of sums `S(ω) = R'(ω)` for every test form `ω`.  (IMC) is not used: the
tangent locality and orientation bound it provides enter the series of `IMRep`s through the
accepted lemmas `rsdic_ae_tangent_iff_of_subset` and `unit_orientation_norm_le_one`. -/
theorem Submission.cmcdt_im_series : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S) := by
  intro hVO hMR _hIMC P k W hW
  -- Steps 1–4: the series current `S`, `M(S) ≤ Σᵢ M(Wᵢ)` and `spt S ⊆ closure ⋃ᵢ spt Wᵢ`
  obtain ⟨S, hS, hmass, hsupp⟩ :=
    Submission.cmcdt_ims_series_current hVO P (k + 1) univ W isOpen_univ hW.ne
  refine ⟨S, hS, hmass, hsupp, ?_⟩
  -- Step 5: choose representations `Wᵢ = τ(Mᵢ, θᵢ, ξᵢ)`
  intro hIM
  choose R hR using hIM
  -- (MR) with `U = W = ℝᴾ`: `M(Wᵢ) = ∫_{Mᵢ} θᵢ dH^{k+1}`, so the total weight is finite
  have hmeas : ∀ i, (W i).mass = (R i).measure univ := fun i =>
    hMR P (k + 1) univ (W i) (R i) isOpen_univ (hR i) univ isOpen_univ
  have hsum : ∑' i, (R i).measure univ ≠ ∞ := by
    simp_rw [← hmeas]
    exact hW.ne
  -- one `IMRep` `R'` whose action is the sum of the actions of the `Rᵢ`
  obtain ⟨R', hR'⟩ := Submission.cmcdt_ims_imrep_tsum P (k + 1) univ R isOpen_univ hsum
  -- `Σᵢ Wᵢ(ω) = Σᵢ τ(Mᵢ, θᵢ, ξᵢ)(ω)` has the two sums `S(ω)` and `R'(ω)`
  refine ⟨R', fun ω => (hS ω).unique ?_⟩
  have hWR : (fun i => W i ω) =
      fun i => (R i).action (ω : DifferentialForm (Euclid P) (k + 1)) :=
    funext fun i => hR i ω
  rw [hWR]
  exact hR' ω
/-- **Area formulas for an integer-weighted oriented piece** (Simon Ch. 6, 3.1 (‡), via Ch. 2,
(3.3)-(3.5)).  Let `G : ℝⁿ → ℝᴺ` be differentiable with injective `DG(u)` at every point of the
Borel set `A` and injective on `A`, `J(u) = √det(⟨DG(u)e_a, DG(u)e_b⟩)`, `s = ±1`, and suppose
`J(u) ⟨α, ξ(G u)⟩ = s(u) α(DG(u)e₁, …, DG(u)eₙ)` for a.e. `u ∈ A` and every `n`-covector `α`.
With `w = (θ ∘ G) s`: (i) `∫_A |w| J = ∫_{G(A)} θ dHⁿ`; (ii) every `n`-form `ω` has
`∫_A w ω(G u)(DG(u)e₁, …, DG(u)eₙ) du = ∫_{G(A)} θ ⟨ω, ξ⟩ dHⁿ`.  Since `|w| = θ ∘ G`, (i) is the
area formula `codim1_lura_gram_area_formula` with `g = θ`; (ii) is
`codim1_lur_cd_injective_area_formula_gram` with `h = θ ⟨ω, ξ⟩`, whose integrand `J · h ∘ G`
equals `w ω(G u)(DG(u)e)` a.e. on `A` by the orientation identity with `α = ω(G u)`. -/
theorem Submission.cmcdt_lpi_pr_oriented_piece_area : ∀ (N n : ℕ) (G : Euclid n → Euclid N) (A : Set (Euclid n)) (θ : Euclid N → ℕ) (ξ : Euclid N → MultiVector N n) (s : Euclid n → ℤ), MeasurableSet A → (∀ u ∈ A, DifferentiableAt ℝ G u) → (∀ u ∈ A, Injective (fderiv ℝ G u)) → InjOn G A → (∀ u, s u = 1 ∨ s u = -1) → (∀ᵐ u ∂(volume.restrict A), ∀ α : Covector (Euclid N) n, Real.sqrt (Matrix.det (Matrix.of fun a b : Fin n => inner ℝ (fderiv ℝ G u (EuclideanSpace.single a 1)) (fderiv ℝ G u (EuclideanSpace.single b 1)))) * ξ (G u) α = (s u : ℝ) * α (fun a => fderiv ℝ G u (EuclideanSpace.single a 1))) → ∫⁻ u in A, ENNReal.ofReal (|(((θ (G u) : ℤ) * s u : ℤ) : ℝ)| * Real.sqrt (Matrix.det (Matrix.of fun a b : Fin n => inner ℝ (fderiv ℝ G u (EuclideanSpace.single a 1)) (fderiv ℝ G u (EuclideanSpace.single b 1))))) = ∫⁻ x in G '' A, (θ x : ℝ≥0∞) ∂μHE[n] ∧ ∀ ω : DifferentialForm (Euclid N) n, ∫ u in A, (((θ (G u) : ℤ) * s u : ℤ) : ℝ) * ω (G u) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)) = ∫ x in G '' A, (θ x : ℝ) * ξ x (ω x) ∂μHE[n] := by
  intro N n G A θ ξ s hA hdiff hinj hInjOn hs hstar
  constructor
  · rw [(Submission.codim1_lura_gram_area_formula n N G).2 A hA hdiff hinj hInjOn
      (fun x => (θ x : ℝ≥0∞))]
    apply lintegral_congr
    intro u
    have habs : |((((θ (G u) : ℤ) * s u : ℤ)) : ℝ)| = (θ (G u) : ℝ) := by
      rcases hs u with h | h <;> simp [h]
    rw [habs, ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast, mul_comm]
  · intro ω
    rw [Submission.codim1_lur_cd_injective_area_formula_gram N n G A hA hdiff hinj hInjOn]
    refine integral_congr_ae ?_
    filter_upwards [hstar] with u hu
    have h1 := hu (ω (G u))
    push_cast
    calc ((θ (G u) : ℝ) * (s u : ℝ)) * ω (G u) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1))
        = (θ (G u) : ℝ) * ((s u : ℝ) * ω (G u) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1))) := by ring
      _ = _ := by rw [← h1]; ring
/-- **Covector norm bounds: pull-back, interior product, orthonormal evaluation** (Simon Ch. 6, §1;
the pointwise estimates behind the homotopy and Lipschitz push-forward mass bounds 6.2.27, 6.2.29
used in the deformation theorem 6.5.1).  With `|α|` the Euclidean coefficient norm
`covectorEuclideanNorm α` (Simon 6.1.5):
(L1) `|A^#β| ≤ ‖A‖ᵏ |β|` for a linear map `A : ℝᴺ → ℝᴺ'` and the pull-back
`A^#β(w₁, …, w_k) = β(Aw₁, …, Aw_k)` (`cmcdt_lp_covector_pullback_norm_le`);
(L2) `|ι_v β| ≤ ‖v‖ |β|` for the interior product `ι_v β(w₁, …, w_k) = β(v, w₁, …, w_k)`
(`cmcdt_lp_covector_curryLeft_norm_le`);
(L3) `|α(τ₁, …, τ_k)| ≤ |α|` for an orthonormal family `τ` in `ℝᴺ`
(`regcomp_covector_eval_orthonormal_le`). -/
theorem Submission.cmcdt_lp_covector_norm_bounds : (∀ (N N' k : ℕ) (A : Euclid N →L[ℝ] Euclid N') (β : Covector (Euclid N') k), covectorEuclideanNorm (β.compContinuousLinearMap A) ≤ ‖A‖ ^ k * covectorEuclideanNorm β) ∧ (∀ (N k : ℕ) (v : Euclid N) (β : Covector (Euclid N) (k + 1)), covectorEuclideanNorm (β.curryLeft v) ≤ ‖v‖ * covectorEuclideanNorm β) ∧ ∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α :=
  ⟨Submission.cmcdt_lp_covector_pullback_norm_le, Submission.cmcdt_lp_covector_curryLeft_norm_le,
    Submission.regcomp_covector_eval_orthonormal_le⟩

/-- **Lipschitz push-forward and the cylinder `[[0, 1]] × X`** (Simon Ch. 6, 2.17–2.29: products
with `[[0, 1]]` (2.17–2.22), the homotopy formula and its mass estimate (2.25–2.27) and the
Lipschitz push-forward (2.29), for currents `X` with compact support, `M(X) < ∞` and
`M(∂X) < ∞`).  `cmcdt_lpo_lipschitz_pushforward` gives `lpush` with conjuncts (1)–(6) and the
approximation property (PA): `X(ηⱼ) → lpush(F, X)(ω)` whenever the `Fⱼ` are `C^∞` with
`‖DFⱼ‖ ≤ Λ'` on `spt X` and converge to `F` uniformly on `spt X`, and `ηⱼ = Fⱼ^#ω` near
`spt X`.  `cmcdt_lpo_cylinder` gives `cyl = [[0, 1]] × ·` with conjuncts (7)–(9).
`cmcdt_lpo_lipschitz_homotopy` holds for all operators with (PA), (7) and (9) and gives the
homotopy formulas (10), (11) and the mass bound (12).  The covector bounds (L1)–(L3) of
`cmcdt_lp_covector_norm_bounds` are the remaining antecedent of all three. -/
theorem Submission.cmcdt_lp_pushforward_operators : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → ∃ (lpush : ∀ (N N' k : ℕ), (Euclid N → Euclid N') → GeometricCurrentOn (univ : Set (Euclid N)) k → GeometricCurrentOn (univ : Set (Euclid N')) k) (cyl : ∀ (N k : ℕ), GeometricCurrentOn (univ : Set (Euclid N)) k → GeometricCurrentOn (univ : Set (Euclid (N + 1))) (k + 1)), (∀ (N k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid N)) k), IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → lpush N N k (fun x => x) X = X) ∧ (∀ (N N' k : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N') (X Y : GeometricCurrentOn (univ : Set (Euclid N)) k), LipschitzWith Λ F → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → IsCompact Y.support → Y.mass < ∞ → boundaryMassOn Y univ < ∞ → lpush N N' k F (X - Y) = lpush N N' k F X - lpush N N' k F Y) ∧ (∀ (N N' k : ℕ) (Λ : NNReal) (F G : Euclid N → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) k), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → EqOn F G X.support → lpush N N' k F X = lpush N N' k G X) ∧ (∀ (N N' k : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) k), LipschitzWith Λ F → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → (lpush N N' k F X).mass ≤ (Λ : ℝ≥0∞) ^ k * X.mass ∧ (lpush N N' k F X).support ⊆ F '' X.support) ∧ (∀ (N N' k : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)), LipschitzWith Λ F → IsCompact X.support → X.mass < ∞ → X.boundary.mass < ∞ → (lpush N N' (k + 1) F X).boundary = lpush N N' k F X.boundary) ∧ (∀ (N N' k : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) k), LipschitzWith Λ F → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → ∃ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Fs j)) ∧ (∀ j, LipschitzWith Λ (Fs j)) ∧ TendstoUniformly Fs F atTop ∧ ∀ ω : TestFormOn (univ : Set (Euclid N')) k, ∃ ηs : ℕ → TestFormOn (univ : Set (Euclid N)) k, (∀ j, ∃ W : Set (Euclid N), IsOpen W ∧ X.support ⊆ W ∧ ∀ x ∈ W, (ηs j : DifferentialForm (Euclid N) k) x = ((ω : DifferentialForm (Euclid N') k) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x)) ∧ Tendsto (fun j => X (ηs j)) atTop (𝓝 (lpush N N' k F X ω))) ∧ (∀ (N k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid N)) k), IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → IsCompact (cyl N k X).support ∧ (cyl N k X).mass < ∞ ∧ (cyl N k X).boundary.mass < ∞ ∧ (cyl N k X).support ⊆ {y : Euclid (N + 1) | ∃ t ∈ Icc (0 : ℝ) 1, ∃ x ∈ X.support, y = WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))}) ∧ (∀ (N k : ℕ) (X Y : GeometricCurrentOn (univ : Set (Euclid N)) k), IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → IsCompact Y.support → Y.mass < ∞ → boundaryMassOn Y univ < ∞ → cyl N k (X - Y) = cyl N k X - cyl N k Y) ∧ (∀ (N k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid N)) k), IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → ∀ ω : TestFormOn (univ : Set (Euclid (N + 1))) (k + 1), ∃ η : TestFormOn (univ : Set (Euclid N)) k, (∀ (x : Euclid N) (v : Fin k → Euclid N), (η : DifferentialForm (Euclid N) k) x v = ∫ t in (0 : ℝ)..1, (ω : DifferentialForm (Euclid (N + 1)) (k + 1)) (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) (Fin.cons (EuclideanSpace.single 0 1) (fun i => WithLp.toLp 2 (Fin.cons 0 (WithLp.ofLp (v i)))))) ∧ cyl N k X ω = X η) ∧ (∀ (N N' : ℕ) (Λ L : NNReal) (F G : Euclid N → Euclid N') (H : Euclid (N + 1) → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) 0), LipschitzWith Λ F → LipschitzWith Λ G → LipschitzWith L H → IsCompact X.support → X.mass < ∞ → (∀ x ∈ X.support, ∀ t ∈ Icc (0 : ℝ) 1, H (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) = F x + t • (G x - F x)) → lpush N N' 0 G X - lpush N N' 0 F X = (lpush (N + 1) N' (0 + 1) H (cyl N 0 X)).boundary) ∧ (∀ (N N' k : ℕ) (Λ L : NNReal) (F G : Euclid N → Euclid N') (H : Euclid (N + 1) → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)), LipschitzWith Λ F → LipschitzWith Λ G → LipschitzWith L H → IsCompact X.support → X.mass < ∞ → X.boundary.mass < ∞ → (∀ x ∈ X.support, ∀ t ∈ Icc (0 : ℝ) 1, H (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) = F x + t • (G x - F x)) → lpush N N' (k + 1) G X - lpush N N' (k + 1) F X - lpush (N + 1) N' (k + 1) H (cyl N k X.boundary) = (lpush (N + 1) N' (k + 1 + 1) H (cyl N (k + 1) X)).boundary) ∧ ∀ (N N' k : ℕ) (Λ L : NNReal) (F G : Euclid N → Euclid N') (H : Euclid (N + 1) → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) k) (δ : ℝ), LipschitzWith Λ F → LipschitzWith Λ G → LipschitzWith L H → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → (∀ x ∈ X.support, ∀ t ∈ Icc (0 : ℝ) 1, H (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) = F x + t • (G x - F x)) → (∀ x ∈ X.support, dist (F x) (G x) ≤ δ) → (lpush (N + 1) N' (k + 1) H (cyl N k X)).mass ≤ ENNReal.ofReal δ * (2 * (Λ : ℝ≥0∞)) ^ k * X.mass := by
  intro hVO hREP
  -- (1)–(6) and the approximation property (PA) of the Lipschitz push-forward
  obtain ⟨lpush, h1, h2, h3, h4, h5, h6, hPA⟩ :=
    Submission.cmcdt_lpo_lipschitz_pushforward hVO hREP Submission.cmcdt_lp_covector_norm_bounds
  -- (7)–(9): the cylinder `[[0, 1]] × X`
  obtain ⟨cyl, h7, h8, h9⟩ :=
    Submission.cmcdt_lpo_cylinder hVO hREP Submission.cmcdt_lp_covector_norm_bounds
  -- (10)–(12): the homotopy formulas and the mass bound, from (PA), (7) and (9)
  obtain ⟨h10, h11, h12⟩ :=
    Submission.cmcdt_lpo_lipschitz_homotopy hVO hREP Submission.cmcdt_lp_covector_norm_bounds
      lpush cyl hPA h7 h9
  exact ⟨lpush, cyl, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12⟩
/-- **Lipschitz pieces of an integer multiplicity current** (Simon Ch. 6, 3.3–3.5; steps B1, B2,
B2′ of the Lipschitz push-forward integrality in the deformation theorem 6.5.1).
Let `X = τ(M, θ, ξ) ∈ 𝒟ₙ(ℝᴺ)`, `n = k + 1`, be integer multiplicity with `M(X) < ∞`.  The carrier
may be taken inside `spt X` (`cmcdt_lpi_pr_imrep_in_support`), and then (MR) gives
`M(X) = ∫_M θ dHⁿ`.  Up to an `Hⁿ`-null set, `M` is the disjoint union of bi-Lipschitz images
`Gᵢ(Aᵢ)` (`dpf_rectifiable_bilipschitz_pieces`).  On each piece `ξ ∘ Gᵢ` orients
`span{DGᵢ eₐ}` a.e. (`cmcdt_lpi_pr_piece_orientation_ae`), so a Borel sign `sᵢ = ±1` has
`J_{Gᵢ} ξ(Gᵢ) = sᵢ DGᵢ e₀ ∧ ⋯ ∧ DGᵢ eₙ₋₁` a.e. (`cmcdt_lpi_pr_orientation_sign`).  With
`wᵢ = θ ∘ Gᵢ · sᵢ` and `cᵢ = J_{Gᵢ}`, the area formula (`cmcdt_lpi_pr_oriented_piece_area`) gives
`Σᵢ ∫_{Aᵢ} |wᵢ| cᵢ = ∫_{⋃ᵢ Gᵢ(Aᵢ)} θ dHⁿ ≤ M(X)` and `X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)`;
`∫_{Aᵢ} |wᵢ| ≤ mᵢ⁻ⁿ M(X)` (`cmcdt_lpi_pr_lintegral_pullback`) and, by
`cmcdt_lpi_unit_orientation_span` and (L3), `|α(DGᵢ e)| ≤ cᵢ |α|`. -/
theorem Submission.cmcdt_lpi_piece_representation : ((∀ (N N' k : ℕ) (A : Euclid N →L[ℝ] Euclid N') (β : Covector (Euclid N') k), covectorEuclideanNorm (β.compContinuousLinearMap A) ≤ ‖A‖ ^ k * covectorEuclideanNorm β) ∧ (∀ (N k : ℕ) (v : Euclid N) (β : Covector (Euclid N) (k + 1)), covectorEuclideanNorm (β.curryLeft v) ≤ ‖v‖ * covectorEuclideanNorm β) ∧ ∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (N k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)), IsIntegerMultiplicity X → X.mass < ∞ → ∃ (G : ℕ → Euclid (k + 1) → Euclid N) (A : ℕ → Set (Euclid (k + 1))) (w : ℕ → Euclid (k + 1) → ℤ) (c : ℕ → Euclid (k + 1) → ℝ), (∀ i, ∃ L : NNReal, LipschitzWith L (G i)) ∧ (∀ i, MeasurableSet (A i)) ∧ (∀ i, Measurable (w i)) ∧ (∀ i, Measurable (c i)) ∧ (∀ i, ∀ u ∈ A i, DifferentiableAt ℝ (G i) u) ∧ (∀ i, G i '' A i ⊆ X.support) ∧ (∀ i, IntegrableOn (fun u => (w i u : ℝ)) (A i)) ∧ (∀ i, ∀ u ∈ A i, 0 ≤ c i u ∧ ∀ α : Covector (Euclid N) (k + 1), |α (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a 1))| ≤ c i u * covectorEuclideanNorm α) ∧ ∑' i, ∫⁻ u in A i, ENNReal.ofReal (|(w i u : ℝ)| * c i u) ≤ X.mass ∧ ∀ η : TestFormOn (univ : Set (Euclid N)) (k + 1), HasSum (fun i => ∫ u in A i, (w i u : ℝ) * (η : DifferentialForm (Euclid N) (k + 1)) (G i u) (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a 1))) (X η) := by
  intro hCB _hVO hMR hIMC N k X hXim hXmass
  -- Step 1: a representation `X = τ(M, θ, ξ)` with `M ⊆ spt X`, and `M(X) = ∫_M θ dHⁿ < ∞`
  obtain ⟨R, hRrep, hRsupp⟩ := Submission.cmcdt_lpi_pr_imrep_in_support hIMC.2.1 N (k + 1)
    univ X isOpen_univ hXim
  have hmassR : X.mass = R.measure univ :=
    hMR N (k + 1) univ X R isOpen_univ hRrep univ isOpen_univ
  have hRuniv : R.measure univ = ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k + 1] := by
    rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  have hθfin : ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k + 1] ≠ ∞ := by
    rw [← hRuniv, ← hmassR]
    exact hXmass.ne
  have hθmeas : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    measurable_from_top.comp R.measurable_mult
  -- `θ ≥ 1` on `M`, so `Hⁿ(M) < ∞`
  have hMfin : μHE[k + 1] R.carrier ≠ ∞ := by
    refine ne_top_of_le_ne_top hθfin ?_
    calc μHE[k + 1] R.carrier = ∫⁻ x in R.carrier, (1 : ℝ≥0∞) ∂μHE[k + 1] := by simp
      _ ≤ ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k + 1] := by
        apply setLIntegral_mono hθmeas
        intro x hx
        exact_mod_cast R.mult_pos x hx
  have hloc : ∀ K : Set (Euclid N), IsCompact K → μHE[k + 1] (R.carrier ∩ K) ≠ ∞ :=
    fun K _ => ne_top_of_le_ne_top hMfin (measure_mono inter_subset_left)
  -- Step 2: bi-Lipschitz pieces `Gᵢ(Aᵢ)` of `M`
  obtain ⟨F, B, m, hLip, hBm, hmpos, hlow, hdiff, hFBm, hFBsub, hdisj, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces N (k + 1) R.carrier R.measurableSet_carrier
      R.rectifiable
  -- Steps 3–5: `ξ ∘ Gᵢ` orients `span{DGᵢ eₐ}` a.e., with a Borel sign `sᵢ`
  have hsign : ∀ i, ∃ s : Euclid (k + 1) → ℤ, Measurable s ∧ (∀ u, s u = 1 ∨ s u = -1) ∧
      ∀ᵐ u ∂(volume.restrict (B i)), ∀ α : Covector (Euclid N) (k + 1),
        Real.sqrt (Matrix.det (Matrix.of fun a b : Fin (k + 1) =>
          inner ℝ (fderiv ℝ (F i) u (EuclideanSpace.single a 1))
            (fderiv ℝ (F i) u (EuclideanSpace.single b 1)))) * R.orient (F i u) α =
          (s u : ℝ) * α (fun a => fderiv ℝ (F i) u (EuclideanSpace.single a 1)) := by
    intro i
    obtain ⟨L, hL⟩ := hLip i
    obtain ⟨hae, hor⟩ := Submission.cmcdt_lpi_pr_piece_orientation_ae hIMC.1 N (k + 1)
      R.carrier R.orient (F i) (B i) L (m i) R.measurableSet_carrier hloc
      R.aestronglyMeasurable_orient R.orients hL (hBm i) (hmpos i) (hlow i) (hdiff i) (hFBsub i)
    exact Submission.cmcdt_lpi_pr_orientation_sign N (k + 1) (F i) (B i)
      (fun u => R.orient (F i u)) (hBm i) (fun u hu => (hdiff i u hu).2) hae hor
  choose s hsm hspm hstar using hsign
  have hinjOn : ∀ i, InjOn (F i) (B i) := by
    intro i a ha a' ha' h
    have h1 := hlow i a ha a' ha'
    rw [h, sub_self, norm_zero] at h1
    have h2 : ‖a - a'‖ ≤ 0 := by
      by_contra hc
      push Not at hc
      have := mul_pos (hmpos i) hc
      linarith
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h2)
  -- Step 8: the area formulas on each piece, for the weight `wᵢ = θ ∘ Gᵢ · sᵢ`
  have harea := fun i => Submission.cmcdt_lpi_pr_oriented_piece_area N (k + 1) (F i) (B i)
    R.mult R.orient (s i) (hBm i) (fun u hu => (hdiff i u hu).1) (fun u hu => (hdiff i u hu).2)
    (hinjOn i) (hspm i) (hstar i)
  have hwm : ∀ i, Measurable fun u => ((R.mult (F i u) : ℤ) * s i u) := by
    intro i
    obtain ⟨L, hL⟩ := hLip i
    have h1 : Measurable fun u => (R.mult (F i u) : ℤ) :=
      measurable_from_top.comp (R.measurable_mult.comp hL.continuous.measurable)
    exact (measurable_of_countable (fun p : ℤ × ℤ => p.1 * p.2)).comp (h1.prodMk (hsm i))
  -- Step 6: the weights `wᵢ` and the Jacobians `cᵢ = J_{Gᵢ}`
  refine ⟨F, B, fun i u => (R.mult (F i u) : ℤ) * s i u,
    fun i u => Real.sqrt (Matrix.det (Matrix.of fun a b : Fin (k + 1) =>
      inner ℝ (fderiv ℝ (F i) u (EuclideanSpace.single a 1))
        (fderiv ℝ (F i) u (EuclideanSpace.single b 1)))),
    hLip, hBm, hwm, fun i => (Submission.codim1_lura_gram_area_formula (k + 1) N (F i)).1,
    fun i u hu => (hdiff i u hu).1, fun i => (hFBsub i).trans hRsupp, ?_, ?_, ?_, ?_⟩
  · -- Step 10: `∫_{Aᵢ} |wᵢ| ≤ mᵢ⁻ⁿ ∫_M θ dHⁿ < ∞`
    intro i
    obtain ⟨L, hL⟩ := hLip i
    have hpull := Submission.cmcdt_lpi_pr_lintegral_pullback N (k + 1) (F i) (B i) L (m i) hL
      (hBm i) (hmpos i) (hlow i) (fun x => (R.mult x : ℝ≥0∞)) hθmeas
    refine ⟨(measurable_from_top.comp (hwm i)).aestronglyMeasurable, ?_⟩
    have habs : ∀ u, ‖((((R.mult (F i u) : ℤ) * s i u : ℤ)) : ℝ)‖ₑ =
        (R.mult (F i u) : ℝ≥0∞) := by
      intro u
      rcases hspm i u with h | h <;> simp [h]
    simp only [HasFiniteIntegral, habs]
    calc ∫⁻ u in B i, (R.mult (F i u) : ℝ≥0∞)
        ≤ ENNReal.ofReal ((m i ^ (k + 1))⁻¹) *
            ∫⁻ x in F i '' B i, (R.mult x : ℝ≥0∞) ∂μHE[k + 1] := hpull
      _ ≤ ENNReal.ofReal ((m i ^ (k + 1))⁻¹) *
            ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k + 1] := by
          gcongr
          exact hFBsub i
      _ < ∞ := ENNReal.mul_lt_top ENNReal.ofReal_lt_top hθfin.lt_top
  · -- Step 7: `α(DGᵢ e) = J_{Gᵢ} ξᵤ(α)` with `ξᵤ` a unit orientation, so `|α(DGᵢ e)| ≤ cᵢ |α|`
    intro i u hu
    refine ⟨Real.sqrt_nonneg _, fun α => ?_⟩
    have hli : LinearIndependent ℝ (fun a => fderiv ℝ (F i) u (EuclideanSpace.single a 1)) := by
      have h0 := (EuclideanSpace.basisFun (Fin (k + 1)) ℝ).toBasis.linearIndependent
      have h1 := h0.map' (fderiv ℝ (F i) u : Euclid (k + 1) →ₗ[ℝ] Euclid N)
        (LinearMap.ker_eq_bot.mpr (hdiff i u hu).2)
      convert h1 using 1
      funext a
      simp
    obtain ⟨-, -, ξu, ⟨τ, hτ, -, hτs⟩, hξu, -⟩ :=
      Submission.cmcdt_lpi_unit_orientation_span N (k + 1) _ hli
    rw [hξu α, abs_mul, abs_of_nonneg (Real.sqrt_nonneg _)]
    gcongr
    rcases hτs with h | h
    · rw [h α]
      exact hCB.2.2 N (k + 1) α τ hτ
    · rw [h α, abs_neg]
      exact hCB.2.2 N (k + 1) α τ hτ
  · -- Step 9: `Σᵢ ∫_{Aᵢ} |wᵢ| cᵢ = Σᵢ ∫_{Gᵢ(Aᵢ)} θ dHⁿ ≤ ∫_M θ dHⁿ = M(X)`
    calc ∑' i, ∫⁻ u in B i, ENNReal.ofReal (|((((R.mult (F i u) : ℤ) * s i u : ℤ)) : ℝ)| *
          Real.sqrt (Matrix.det (Matrix.of fun a b : Fin (k + 1) =>
            inner ℝ (fderiv ℝ (F i) u (EuclideanSpace.single a 1))
              (fderiv ℝ (F i) u (EuclideanSpace.single b 1)))))
        = ∑' i, ∫⁻ x in F i '' B i, (R.mult x : ℝ≥0∞) ∂μHE[k + 1] := by
          congr 1
          funext i
          exact (harea i).1
      _ = ∫⁻ x in ⋃ i, F i '' B i, (R.mult x : ℝ≥0∞) ∂μHE[k + 1] :=
          (lintegral_iUnion hFBm hdisj _).symm
      _ ≤ ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k + 1] :=
          lintegral_mono_set (iUnion_subset hFBsub)
      _ = X.mass := by rw [hmassR, hRuniv]
  · -- Step 11: `X(η) = ∫_M θ ξ(η) dHⁿ = Σᵢ ∫_{Gᵢ(Aᵢ)} θ ξ(η) dHⁿ = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)`
    intro η
    have hηc : Continuous (η : DifferentialForm (Euclid N) (k + 1)) := η.2.1.1.continuous
    have hηs : HasCompactSupport (η : DifferentialForm (Euclid N) (k + 1)) := η.2.1.2
    have hnc : Continuous fun x =>
        covectorEuclideanNorm ((η : DifferentialForm (Euclid N) (k + 1)) x) := by
      unfold covectorEuclideanNorm
      refine Real.continuous_sqrt.comp (continuous_finsetSum _ fun I _ => ?_)
      split_ifs
      · exact ((continuous_eval_const _).comp hηc).pow 2
      · exact continuous_const
    have hcs : HasCompactSupport fun x =>
        covectorEuclideanNorm ((η : DifferentialForm (Euclid N) (k + 1)) x) :=
      hηs.comp_left (g := covectorEuclideanNorm) (covectorEuclideanNorm_zero N (k + 1))
    obtain ⟨C, hC⟩ := hnc.bounded_above_of_compact_support hcs
    set f : Euclid N → ℝ := fun x => (R.mult x : ℝ) *
      R.orient x ((η : DifferentialForm (Euclid N) (k + 1)) x) with hf
    have hXη : X η = ∫ x in R.carrier, f x ∂μHE[k + 1] := hRrep η
    have hθint : IntegrableOn (fun x => (R.mult x : ℝ)) R.carrier μHE[k + 1] := by
      refine ⟨(measurable_from_top.comp R.measurable_mult).aestronglyMeasurable, ?_⟩
      simp only [HasFiniteIntegral, Real.enorm_natCast]
      exact hθfin.lt_top
    have hfm : AEStronglyMeasurable f (μHE[k + 1].restrict R.carrier) := by
      refine (measurable_from_top.comp R.measurable_mult).aestronglyMeasurable.mul ?_
      exact (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid N) (k + 1))
        (F := ℝ)).continuous.comp_aestronglyMeasurable₂ R.aestronglyMeasurable_orient
        hηc.aestronglyMeasurable
    -- `|θ ξ(η)| ≤ C θ` a.e. on `M` by (IMC d), so `θ ξ(η)` is integrable on `M`
    have hint : IntegrableOn f R.carrier μHE[k + 1] := by
      refine (hθint.mul_const C).mono' hfm ?_
      filter_upwards [hIMC.2.2.2 N (k + 1) univ R] with x hx
      have h1 := hx ((η : DifferentialForm (Euclid N) (k + 1)) x)
      have h2 : covectorEuclideanNorm ((η : DifferentialForm (Euclid N) (k + 1)) x) ≤ C :=
        (le_abs_self _).trans (by simpa [Real.norm_eq_abs] using hC x)
      rw [hf, Real.norm_eq_abs, abs_mul, Nat.abs_cast]
      gcongr
      exact h1.trans h2
    -- `Hⁿ(M ∖ ⋃ᵢ Gᵢ(Aᵢ)) = 0`
    have hcover : (⋃ i, F i '' B i) =ᵐ[μHE[k + 1]] R.carrier := by
      rw [ae_eq_set]
      refine ⟨?_, hnull⟩
      rw [sdiff_eq_empty.mpr (iUnion_subset hFBsub)]
      exact measure_empty
    have hsum := hasSum_integral_iUnion hFBm hdisj (hint.mono_set (iUnion_subset hFBsub))
    rw [setIntegral_congr_set hcover, ← hXη] at hsum
    convert hsum using 1
    funext i
    exact (harea i).2 η

/-- **Coordinate expansion of a `k`-covector** (the pointwise identity behind
`H^#ω(u)(e) = Σ_I ω_I(H(u)) det D(H^I)(u)`): for `f ∈ Λᵏ(ℝ^{N'})` and `u ∈ (ℝ^{N'})ᵏ`,
`k! f(u) = Σ_I f(e'_{I 0}, …, e'_{I (k-1)}) det (u_b (I c))_{c,b}`, the sum over all maps
`I : Fin k → Fin N'`.  Expand each `u_b = Σ_i u_b(i) e'_i` and use multilinearity; for each
permutation `σ` reindex `J = I ∘ σ` and use `f (v ∘ σ) = sign σ • f v`; average over the `k!`
permutations and recognize the Leibniz formula for the determinant. -/
theorem Submission.dor_lmb_fcd_jwc_covector_det_expansion : ∀ (N' k : ℕ) (f : Covector (Euclid N') k) (u : Fin k → Euclid N'), (k.factorial : ℝ) * f u = ∑ I : Fin k → Fin N', f (fun c => EuclideanSpace.single (I c) (1 : ℝ)) * Matrix.det (Matrix.of fun c b => u b (I c)) := by
  intro N' k f u
  set e : Fin N' → Euclid N' := fun i => EuclideanSpace.single i (1 : ℝ) with he
  -- step 1: multilinear expansion in the standard basis
  have h1 : f u = ∑ J : Fin k → Fin N', (∏ b, u b (J b)) * f (fun b => e (J b)) := by
    have hu : u = fun b => ∑ i, u b i • e i := by
      funext b
      conv_lhs => rw [← (EuclideanSpace.basisFun (Fin N') ℝ).sum_repr (u b)]
      simp [he]
    conv_lhs => rw [hu]
    rw [show f (fun b => ∑ i, u b i • e i) = f.toMultilinearMap (fun b => ∑ i, u b i • e i) from rfl,
      MultilinearMap.map_sum]
    refine Finset.sum_congr rfl fun J _ => ?_
    rw [MultilinearMap.map_smul_univ]
    simp [smul_eq_mul]
  -- step 2: reindex by a permutation `σ`, using alternation
  have h2 : ∀ σ : Equiv.Perm (Fin k), f u = ∑ I : Fin k → Fin N',
      ((Equiv.Perm.sign σ : ℤ) : ℝ) * (∏ b, u b (I (σ b))) * f (fun c => e (I c)) := by
    intro σ
    rw [h1]
    rw [← Equiv.sum_comp ((σ.symm).arrowCongr (Equiv.refl (Fin N')))]
    refine Finset.sum_congr rfl fun I _ => ?_
    have hperm : f (fun b => e (I (σ b))) = ((Equiv.Perm.sign σ : ℤ) : ℝ) * f (fun c => e (I c)) := by
      have := f.toAlternatingMap.map_perm (fun c => e (I c)) σ
      simp only [Function.comp_def] at this
      rw [show f (fun b => e (I (σ b))) = f.toAlternatingMap (fun b => e (I (σ b))) from rfl, this,
        Units.smul_def, zsmul_eq_mul]
      rfl
    simp only [Equiv.arrowCongr_apply, Equiv.refl_apply, Equiv.symm_symm, Function.comp_apply]
    rw [hperm]
    ring
  -- step 3: average over `σ` and recognize the Leibniz formula
  have h3 : (k.factorial : ℝ) * f u = ∑ σ : Equiv.Perm (Fin k), f u := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
  rw [h3]
  calc ∑ σ : Equiv.Perm (Fin k), f u
      = ∑ σ : Equiv.Perm (Fin k), ∑ I : Fin k → Fin N',
          ((Equiv.Perm.sign σ : ℤ) : ℝ) * (∏ b, u b (I (σ b))) * f (fun c => e (I c)) :=
        Finset.sum_congr rfl fun σ _ => h2 σ
    _ = ∑ I : Fin k → Fin N', ∑ σ : Equiv.Perm (Fin k),
          ((Equiv.Perm.sign σ : ℤ) : ℝ) * (∏ b, u b (I (σ b))) * f (fun c => e (I c)) :=
        Finset.sum_comm
    _ = _ := ?_
  refine Finset.sum_congr rfl fun I _ => ?_
  rw [Matrix.det_apply, Finset.mul_sum]
  refine Finset.sum_congr rfl fun σ _ => ?_
  rw [Units.smul_def, zsmul_eq_mul]
  simp only [Matrix.of_apply, he]
  ring
/-- **Jacobian minors of a Lipschitz map**: for an `L`-Lipschitz `v : ℝᵐ → ℝᵖ`, rows
`a : Fin r → Fin p` and columns `b : Fin r → Fin m`, the minor
`M(u) = det ((Dv(u) e_{b t})_{a s})_{s,t}` is Borel measurable in `u` and `|M(u)| ≤ r! Lʳ`.
`u ↦ Dv(u)` is measurable and `A ↦ det ((A e_{b t})_{a s})` is continuous; every entry is bounded
by `‖Dv(u)‖ ≤ L`, and the Leibniz formula has `r!` terms of absolute value at most `Lʳ`. -/
theorem Submission.cmcdt_lpi_pc_minor_measurable_bound : ∀ (m p r : ℕ) (L : NNReal) (v : Euclid m → Euclid p) (a : Fin r → Fin p) (b : Fin r → Fin m), LipschitzWith L v → Measurable (fun u => Matrix.det (Matrix.of fun s t => fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s))) ∧ ∀ u, |Matrix.det (Matrix.of fun s t => fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s))| ≤ (r.factorial : ℝ) * (L : ℝ) ^ r := by
  intro m p r L v a b hv
  constructor
  · -- `u ↦ Dv(u)` is measurable and `A ↦ det ((A e_{b t})_{a s})` is continuous
    have hcont : Continuous fun A : Euclid m →L[ℝ] Euclid p =>
        Matrix.det (Matrix.of fun s t => A (EuclideanSpace.single (b t) 1) (a s)) := by
      refine Continuous.matrix_det (continuous_matrix fun s t => ?_)
      exact (continuous_apply (a s)).comp
        ((PiLp.continuous_ofLp 2 _).comp (continuous_eval_const _))
    exact hcont.measurable.comp (measurable_fderiv ℝ v)
  · intro u
    -- entry bound `|(Dv(u) e_{b t})_{a s}| ≤ ‖Dv(u)‖ ≤ L`
    have hentry : ∀ s t, |fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s)| ≤ (L : ℝ) := by
      intro s t
      calc |fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s)|
          = ‖fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s)‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖fderiv ℝ v u (EuclideanSpace.single (b t) 1)‖ := PiLp.norm_apply_le _ _
        _ ≤ ‖fderiv ℝ v u‖ * ‖EuclideanSpace.single (b t) (1 : ℝ)‖ := (fderiv ℝ v u).le_opNorm _
        _ = ‖fderiv ℝ v u‖ := by simp
        _ ≤ L := norm_fderiv_le_of_lipschitz ℝ hv
    -- Leibniz formula: `r!` terms, each of absolute value at most `Lʳ`
    rw [Matrix.det_apply]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ σ : Equiv.Perm (Fin r), |Equiv.Perm.sign σ • ∏ i, Matrix.of
            (fun s t => fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s)) (σ i) i|
        ≤ ∑ _σ : Equiv.Perm (Fin r), (L : ℝ) ^ r := by
          refine Finset.sum_le_sum fun σ _ => ?_
          rw [Units.smul_def, zsmul_eq_mul, abs_mul, Finset.abs_prod]
          have hsign : |((Equiv.Perm.sign σ : ℤ) : ℝ)| = 1 := by
            rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
          rw [hsign, one_mul]
          calc ∏ i, |Matrix.of (fun s t => fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s))
                (σ i) i|
              ≤ ∏ _i : Fin r, (L : ℝ) :=
                Finset.prod_le_prod₀ (fun i _ => abs_nonneg _) fun i _ => hentry _ _
            _ = (L : ℝ) ^ r := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ = (r.factorial : ℝ) * (L : ℝ) ^ r := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
/-- **Jacobian minors of Lipschitz maps are measurable and bounded** (the integrands in the weak
continuity of Jacobian minors): if `g₀, …, g_{r-1}` are `L`-Lipschitz on `ℝᵏ` and
`V₀, …, V_{r-1} ∈ ℝᵏ`, then `D(x) = det (Dg_c(x) V_b)_{c,b}` is measurable and
`|D(x)| ≤ r! (L ∑_b ‖V_b‖)ʳ` for every `x`, where `Dg(x) = fderiv ℝ g x` (`0` where `g` is not
differentiable).  Each entry `x ↦ Dg_c(x) V_b` is measurable (`measurable_fderiv_apply_const`)
and bounded by `‖Dg_c(x)‖ ‖V_b‖ ≤ L ‖V_b‖ ≤ L ∑_b ‖V_b‖` (`norm_fderiv_le_of_lipschitz`); by the
Leibniz formula `D` is a signed sum of `r!` products of `r` entries, which gives both claims.
(`Matrix.det_le` is outside the import closure, so the bound is done by hand.) -/
theorem Submission.dor_lmb_fcd_jwc_minor_measurable_bound : ∀ (k r : ℕ) (L : NNReal) (g : Fin r → Euclid k → ℝ) (V : Fin r → Euclid k), (∀ c, LipschitzWith L (g c)) → Measurable (fun x => Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b))) ∧ ∀ x, |Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b))| ≤ (r.factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ r := by
  intro k r L g V hg
  -- Leibniz formula: `D(x) = ∑_σ sign σ ∏_b Dg_{σ b}(x) V_b`
  have hdet : ∀ x, Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) =
      ∑ σ : Equiv.Perm (Fin r), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b) :=
    fun x => Matrix.det_apply' _
  refine ⟨?_, fun x => ?_⟩
  · -- steps 1–2: the entries are measurable, hence so is the signed sum of their products
    have hm : Measurable fun x => ∑ σ : Equiv.Perm (Fin r),
        ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b) :=
      Finset.measurable_sum _ fun σ _ => measurable_const.mul
        (Finset.measurable_prod _ fun b _ => measurable_fderiv_apply_const ℝ (g (σ b)) (V b))
    simpa only [hdet] using hm
  · -- step 3: every entry is bounded by `s = L ∑_b ‖V_b‖`
    have hent : ∀ c b, |fderiv ℝ (g c) x (V b)| ≤ (L : ℝ) * ∑ b, ‖V b‖ := by
      intro c b
      rw [← Real.norm_eq_abs]
      calc ‖fderiv ℝ (g c) x (V b)‖ ≤ ‖fderiv ℝ (g c) x‖ * ‖V b‖ :=
            ContinuousLinearMap.le_opNorm _ _
        _ ≤ L * ‖V b‖ :=
            mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ (hg c)) (norm_nonneg _)
        _ ≤ L * ∑ b, ‖V b‖ := by
            gcongr
            exact Finset.single_le_sum (f := fun b => ‖V b‖) (fun b _ => norm_nonneg _)
              (Finset.mem_univ b)
    -- step 4: the triangle inequality and `|sign σ| = 1` give `|D(x)| ≤ ∑_σ sʳ = r! sʳ`
    rw [hdet]
    calc |∑ σ : Equiv.Perm (Fin r), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b)|
        ≤ ∑ σ : Equiv.Perm (Fin r),
            |((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ = ∑ σ : Equiv.Perm (Fin r), ∏ b, |fderiv ℝ (g (σ b)) x (V b)| := by
          refine Finset.sum_congr rfl fun σ _ => ?_
          rw [abs_mul, Finset.abs_prod]
          rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
      _ ≤ ∑ _σ : Equiv.Perm (Fin r), ∏ _b : Fin r, (L : ℝ) * ∑ b, ‖V b‖ := by
          gcongr with σ _ b _
          exact hent (σ b) b
      _ = (r.factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ r := by
          rw [Finset.sum_const, Finset.prod_const, Finset.card_univ, Finset.card_univ,
            Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
/-- **Weak-* convergence against `L¹` test functions** (density step of the weak continuity of
Jacobian minors): if `|F_j|, |F| ≤ C` and `∫ ψ F_j → ∫ ψ F` for every `C^∞` compactly supported
`ψ`, then `∫ φ F_j → ∫ φ F` for every integrable `φ`.  `C_c^∞` is dense in `L¹`: by
`MemLp.induction_dense` it suffices to approximate `c 1_s` with `μ(s) < ∞`; regularity gives
`K ⊆ s ⊆ U`, `K` compact, `U` open, `μ(U \ K)` small, and `c χ` works for a smooth Urysohn
function `χ` (`χ = 1` exactly on `K`, `support χ = U ∩ B_R(0)`).  (Mathlib's
`MemLp.exist_eLpNorm_sub_le` is outside the import closure.)  For `ε > 0` take such `ψ` with
`∫ |φ − ψ| ≤ η = ε/(4C + 1)`; then `|∫ φ F_j − ∫ φ F| ≤ 2Cη + |∫ ψ F_j − ∫ ψ F| < ε` for large
`j`. -/
theorem Submission.dor_lmb_fcd_jwc_weak_star_l1_upgrade : ∀ (k : ℕ) (C : ℝ) (Fs : ℕ → Euclid k → ℝ) (F : Euclid k → ℝ), (∀ j, AEStronglyMeasurable (Fs j) (volume : Measure (Euclid k))) → AEStronglyMeasurable F (volume : Measure (Euclid k)) → (∀ j x, |Fs j x| ≤ C) → (∀ x, |F x| ≤ C) → (∀ ψ : Euclid k → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ → Tendsto (fun j => ∫ x, ψ x * Fs j x) atTop (𝓝 (∫ x, ψ x * F x))) → ∀ φ : Euclid k → ℝ, Integrable φ → Tendsto (fun j => ∫ x, φ x * Fs j x) atTop (𝓝 (∫ x, φ x * F x)) := by
  intro k C Fs F hFs hF hFsb hFb hconv φ hφ
  have hC : 0 ≤ C := (abs_nonneg _).trans (hFb 0)
  -- step 1: `C_c^∞` is dense in `L¹`; by `MemLp.induction_dense` only `c 1_s` needs approximating
  have hdense : ∀ {ε : ℝ≥0∞}, ε ≠ 0 → ∃ ψ : Euclid k → ℝ,
      eLpNorm (φ - ψ) 1 (volume : Measure (Euclid k)) ≤ ε ∧
        (ContDiff ℝ (⊤ : ℕ∞) ψ ∧ HasCompactSupport ψ) := by
    intro ε hε
    refine MemLp.induction_dense ENNReal.one_ne_top
      (fun g => ContDiff ℝ (⊤ : ℕ∞) g ∧ HasCompactSupport g) ?_ ?_
      (memLp_one_iff_integrable.2 hφ) hε
    · intro c s hs hμs ε' hε'
      -- `K ⊆ s ⊆ U` with `μ(U \ s), μ(s \ K) < δ/2`, `δ = ε'/‖c‖`
      set δ : ℝ≥0∞ := ε' / ‖c‖ₑ with hδ
      have hδ0 : δ ≠ 0 := by
        rw [hδ, Ne, ENNReal.div_eq_zero_iff, not_or]
        exact ⟨hε', enorm_ne_top⟩
      have hδ2 : δ / 2 ≠ 0 := (ENNReal.half_pos hδ0).ne'
      obtain ⟨K, hKs, hKc, hK⟩ := hs.exists_isCompact_sdiff_lt hμs.ne hδ2
      obtain ⟨U, hsU, hUo, -, hU⟩ := hs.exists_isOpen_sdiff_lt hμs.ne hδ2
      -- smooth Urysohn function `χ`: `χ = 1` on `K`, `support χ = U ∩ B_R(0)`, `0 ≤ χ ≤ 1`
      obtain ⟨R, hR⟩ := hKc.isBounded.subset_ball (0 : Euclid k)
      obtain ⟨χ, hχd, hχr, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := (⊤ : ℕ∞))
        (hUo.inter isOpen_ball) hKc.isClosed (subset_inter (hKs.trans hsU) hR)
      have hχc : HasCompactSupport χ := by
        refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid k) R) (fun x hx => ?_)
        rw [← notMem_support, hχs]
        exact fun h => hx (ball_subset_closedBall h.2)
      refine ⟨fun x => c * χ x, ?_, contDiff_const.mul hχd, hχc.mul_left⟩
      -- `|c χ − c 1_s| ≤ |c| 1_{U \ K}`, so `‖c χ − c 1_s‖₁ ≤ ‖c‖ μ(U \ K) ≤ ‖c‖ δ ≤ ε'`
      have hle : ∀ x, ‖((fun x => c * χ x) - s.indicator fun _ => c) x‖ ≤
          ‖(U \ K).indicator (fun _ => c) x‖ := by
        intro x
        obtain ⟨h0, h1⟩ := hχr (mem_range_self x)
        simp only [Pi.sub_apply, Real.norm_eq_abs]
        by_cases hxK : x ∈ K
        · rw [(hχ1 x).1 hxK, indicator_of_mem (hKs hxK)]
          simp
        by_cases hxU : x ∈ U
        · rw [indicator_of_mem (show x ∈ U \ K from ⟨hxU, hxK⟩)]
          by_cases hxs : x ∈ s
          · rw [indicator_of_mem hxs, show c * χ x - c = c * (χ x - 1) by ring, abs_mul]
            exact mul_le_of_le_one_right (abs_nonneg c) (by rw [abs_le]; constructor <;> linarith)
          · rw [indicator_of_notMem hxs, sub_zero, abs_mul]
            exact mul_le_of_le_one_right (abs_nonneg c) (by rw [abs_le]; constructor <;> linarith)
        · have hχ0 : χ x = 0 := by
            rw [← notMem_support, hχs]
            exact fun h => hxU h.1
          rw [hχ0, indicator_of_notMem (fun h => hxU (hsU h))]
          simp
      calc eLpNorm ((fun x => c * χ x) - s.indicator fun _ => c) 1 volume
          ≤ eLpNorm ((U \ K).indicator fun _ => c) 1 volume :=
            eLpNorm_mono (((contDiff_const.mul hχd).continuous.aestronglyMeasurable).sub
              (aestronglyMeasurable_const.indicator hs)) hle
        _ = ‖c‖ₑ * volume (U \ K) := by
          rw [eLpNorm_indicator_const (hUo.measurableSet.diff hKc.isClosed.measurableSet).nullMeasurableSet
            one_ne_zero ENNReal.one_ne_top]
          simp
        _ ≤ ‖c‖ₑ * δ := by
          gcongr
          calc volume (U \ K) ≤ volume ((U \ s) ∪ (s \ K)) := by
                refine measure_mono fun x hx => ?_
                by_cases hxs : x ∈ s
                · exact Or.inr ⟨hxs, hx.2⟩
                · exact Or.inl ⟨hx.1, hxs⟩
            _ ≤ volume (U \ s) + volume (s \ K) := measure_union_le _ _
            _ ≤ δ / 2 + δ / 2 := add_le_add hU.le hK.le
            _ = δ := ENNReal.add_halves δ
        _ ≤ ε' := ENNReal.mul_div_le
    · rintro f g ⟨hf1, hf2⟩ ⟨hg1, hg2⟩
      exact ⟨hf1.add hg1, hf2.add hg2⟩
  -- step 2: `|∫ θ G| ≤ C ∫ |θ|` for integrable `θ` and `|G| ≤ C`
  have hint : ∀ θ : Euclid k → ℝ, Integrable θ → ∀ G : Euclid k → ℝ,
      AEStronglyMeasurable G (volume : Measure (Euclid k)) → (∀ x, |G x| ≤ C) →
      Integrable (fun x => θ x * G x) ∧ |∫ x, θ x * G x| ≤ C * ∫ x, ‖θ x‖ := by
    intro θ hθ G hG hGb
    refine ⟨hθ.mul_bdd hG (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact hGb x), ?_⟩
    calc |∫ x, θ x * G x| = ‖∫ x, θ x * G x‖ := (Real.norm_eq_abs _).symm
      _ ≤ ∫ x, C * ‖θ x‖ := by
          refine norm_integral_le_of_norm_le (hθ.norm.const_mul C) (Eventually.of_forall fun x => ?_)
          rw [norm_mul, Real.norm_eq_abs (G x), mul_comm]
          exact mul_le_mul_of_nonneg_right (hGb x) (norm_nonneg _)
      _ = C * ∫ x, ‖θ x‖ := integral_const_mul _ _
  -- step 3: `ψ ∈ C_c^∞` with `∫ |φ − ψ| ≤ η = ε/(4C + 1)`, and `N` from the convergence on `ψ`
  rw [Metric.tendsto_atTop]
  intro ε hε
  set η : ℝ := ε / (4 * C + 1) with hη
  have hηpos : 0 < η := by positivity
  obtain ⟨ψ, hψε, hψs, hψc⟩ := hdense (ENNReal.ofReal_pos.2 hηpos).ne'
  have hψi : Integrable ψ := hψs.continuous.integrable_of_hasCompactSupport hψc
  have hdiff : ∫ x, ‖(φ - ψ) x‖ ≤ η := by
    have h1 := integral_norm_eq_lintegral_enorm (μ := (volume : Measure (Euclid k)))
      (hφ.sub hψi).aestronglyMeasurable
    rw [h1, ← eLpNorm_one_eq_lintegral_enorm]
    · exact ENNReal.toReal_le_of_le_ofReal hηpos.le hψε
    · exact (hφ.sub hψi).aestronglyMeasurable
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 (hconv ψ hψs hψc) (ε / 2) (by positivity)
  -- step 4: three-term estimate `|∫ φ F_j − ∫ φ F| ≤ 2Cη + |∫ ψ F_j − ∫ ψ F| < ε` for `j ≥ N`
  refine ⟨N, fun j hj => ?_⟩
  have h1 := hint (φ - ψ) (hφ.sub hψi) (Fs j) (hFs j) (hFsb j)
  have h2 := hint (φ - ψ) (hφ.sub hψi) F hF hFb
  have h3 := hint ψ hψi (Fs j) (hFs j) (hFsb j)
  have h4 := hint ψ hψi F hF hFb
  have e1 : ∫ x, φ x * Fs j x = (∫ x, (φ - ψ) x * Fs j x) + ∫ x, ψ x * Fs j x := by
    rw [← integral_add h1.1 h3.1]
    congr 1; funext x; simp only [Pi.sub_apply]; ring
  have e2 : ∫ x, φ x * F x = (∫ x, (φ - ψ) x * F x) + ∫ x, ψ x * F x := by
    rw [← integral_add h2.1 h4.1]
    congr 1; funext x; simp only [Pi.sub_apply]; ring
  have hNj := hN j hj
  rw [Real.dist_eq] at hNj ⊢
  rw [e1, e2]
  have hCη : C * η < ε / 4 := by
    rw [hη, mul_div_assoc']
    rw [div_lt_div_iff₀ (by positivity) (by norm_num)]
    nlinarith
  have hA := h1.2.trans (mul_le_mul_of_nonneg_left hdiff hC)
  have hB := h2.2.trans (mul_le_mul_of_nonneg_left hdiff hC)
  have key : ∀ a1 b1 a2 b2 : ℝ, |(a1 + b1) - (a2 + b2)| ≤ |a1| + |a2| + |b1 - b2| := by
    intro a1 b1 a2 b2
    calc |(a1 + b1) - (a2 + b2)| = |(a1 - a2) + (b1 - b2)| := by ring_nf
      _ ≤ |a1 - a2| + |b1 - b2| := abs_add_le _ _
      _ ≤ |a1| + |a2| + |b1 - b2| := by
          have := abs_sub a1 a2
          linarith
  have := key (∫ x, (φ - ψ) x * Fs j x) (∫ x, ψ x * Fs j x) (∫ x, (φ - ψ) x * F x) (∫ x, ψ x * F x)
  linarith
/-- **The Piola identity** (the Jacobian minors are null Lagrangians): for `C²` functions
`g₀, …, g_{r-1}` on `ℝᵏ` and directions `V₀, …, V_r`, the minors
`M_b(y) = det (Dg_c(y) V_{s_b(b')})_{c,b'}` (`s_b = Fin.succAbove b`, so `V_b` is deleted) satisfy
`∑_b (-1)^b DM_b(x) V_b = 0`.  With `G = (g₀, …, g_{r-1})` and the constant determinant form
`θ = dy⁰ ∧ ⋯ ∧ dy^{r-1}` one has `M_b(y) = (G^*θ)(y)(V ∘ s_b)`, so the left side is
`d(G^*θ)(x)(V)`, and `d(G^*θ) = G^*(dθ) = 0` by the naturality of `d` (which is where the symmetry
of `D²G` enters). -/
theorem Submission.dor_lmb_fcd_jwc_piola_identity : ∀ (k r : ℕ) (g : Fin r → Euclid k → ℝ) (V : Fin (r + 1) → Euclid k) (x : Euclid k), (∀ c, ContDiff ℝ 2 (g c)) → ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (fun y => Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c) y (V (b.succAbove b')))) x (V b) = 0 := by
  intro k r g V x hg
  -- Step 1: the map `G = (g₀, …, g_{r-1}) : ℝᵏ → ℝʳ` is `C²`, and `(DG(y) w)_c = Dg_c(y) w`
  set e : (Fin r → ℝ) ≃L[ℝ] Euclid r := (EuclideanSpace.equiv (Fin r) ℝ).symm with he
  set G : Euclid k → Euclid r := fun y => e (fun c => g c y) with hG
  have hGc : ContDiff ℝ 2 G := e.contDiff.comp (contDiff_pi.2 hg)
  have hGd : ∀ y w (c : Fin r), fderiv ℝ G y w c = fderiv ℝ (g c) y w := by
    intro y w c
    have hpi : HasFDerivAt (fun y => fun c => g c y)
        (ContinuousLinearMap.pi fun c => fderiv ℝ (g c) y) y :=
      hasFDerivAt_pi.2 fun c => ((hg c).differentiable (by norm_num) y).hasFDerivAt
    have h := e.hasFDerivAt.comp y hpi
    rw [show G = e ∘ (fun y => fun c => g c y) from rfl, h.fderiv]
    simp [he]
  -- Step 2: the constant determinant form `Θ ≡ θ`, `θ(w) = det (w_b(c))_{c,b}`
  obtain ⟨θ, hθ⟩ := Submission.cmr_cc_det_covector_exists r r id
  set Θ : Euclid r → Covector (Euclid r) r := fun _ => θ with hΘ
  -- Step 3: `dΘ = 0`, since `DΘ = 0` and the alternatization is linear
  have hdΘ : extDeriv Θ (G x) = 0 := by
    simp [extDeriv, hΘ, ← ContinuousAlternatingMap.alternatizeUncurryFinCLM_apply]
  -- Step 4: naturality of `d` gives `d(G^*Θ)(x) = (dΘ)(G x) ∘ DG(x) = 0`
  have hpull := extDeriv_pullback (ω := Θ) (f := G) (x := x) (r := 2) (differentiableAt_const θ)
    hGc.contDiffAt (by simp)
  rw [hdΘ] at hpull
  -- Step 5: the coordinate formula `d(G^*Θ)(x)(V) = ∑_b (-1)^b D[(G^*Θ)(·)(V ∘ s_b)](x) V_b`
  have hβd : DifferentiableAt ℝ (fun y => (Θ (G y)).compContinuousLinearMap (fderiv ℝ G y)) x :=
    (differentiableAt_const θ).continuousAlternatingMapCompContinuousLinearMap
      ((hGc.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num) x)
  have happ := extDeriv_apply hβd V
  rw [hpull] at happ
  -- Step 6: `(G^*Θ)(y)(V ∘ s_b) = M_b(y)` by Steps 1 and 2
  have hβ : ∀ i : Fin (r + 1), (fun y => (Θ (G y)).compContinuousLinearMap (fderiv ℝ G y)
      (i.removeNth V)) = fun y => Matrix.det (Matrix.of fun (c b' : Fin r) =>
        fderiv ℝ (g c) y (V (i.succAbove b'))) := by
    intro i
    funext y
    simp only [hΘ, ContinuousAlternatingMap.compContinuousLinearMap_apply, hθ]
    congr 1
    ext c b'
    simp [Matrix.of_apply, Fin.removeNth, hGd]
  -- Step 7: hence `0 = d(G^*Θ)(x)(V) = ∑_b (-1)^b DM_b(x) V_b`
  simp only [hβ] at happ
  rw [eq_comm] at happ
  simpa [zsmul_eq_mul] using happ

/-- **Integration by parts for Jacobian minors** (formula (∗) of the weak continuity of Jacobian
minors, for `C²` maps): for `C²` functions `g₀, …, g_r` on `ℝᵏ`, directions `V₀, …, V_r` and a
compactly supported `C¹` function `ψ`, with `A = (Dg_c V_b)_{c,b}` and `M_b` the minor of `A`
without row `0` and column `b`, `∫ ψ det A = −Σ_b (−1)^b ∫ (Dψ V_b) g₀ M_b`.  Laplace expansion
along row `0`, the product rule for `F_b = ψ g₀ M_b` and the Piola identity
`Σ_b (−1)^b ∂_{V_b} M_b = 0` give `ψ det A = Σ_b (−1)^b ∂_{V_b} F_b − Σ_b (−1)^b (∂_{V_b} ψ) g₀ M_b`
pointwise, and `∫ ∂_W F = 0` for every compactly supported `C¹` function `F` (integration by
parts of the Lipschitz functions `1` and `F`). -/
theorem Submission.dor_lmb_fcd_jwc_smooth_minor_ibp : ∀ (k r : ℕ) (g : Fin (r + 1) → Euclid k → ℝ) (V : Fin (r + 1) → Euclid k) (ψ : Euclid k → ℝ), (∀ c, ContDiff ℝ 2 (g c)) → ContDiff ℝ 1 ψ → HasCompactSupport ψ → ∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) = -∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * ∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))) := by
  intro k r g V ψ hg hψ hψs
  -- Step 2: the entries `Dg_c(·)W` are `C¹` (`g_c` is `C²`), hence so is every determinant of
  -- such entries (Leibniz formula), in particular every minor `M_b`
  have hdetC1 : ∀ {m : ℕ} (A : Euclid k → Fin m → Fin m → ℝ),
      (∀ i j, ContDiff ℝ 1 (fun x => A x i j)) →
      ContDiff ℝ 1 (fun x => Matrix.det (Matrix.of (A x))) := by
    intro m A hA
    have hLeib : (fun x => Matrix.det (Matrix.of (A x))) =
        fun x => ∑ σ : Equiv.Perm (Fin m), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ i, A x (σ i) i := by
      funext x
      rw [Matrix.det_apply]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [Units.smul_def, zsmul_eq_mul]
      simp [Matrix.of_apply]
    rw [hLeib]
    exact ContDiff.sum fun σ _ => contDiff_const.mul (contDiff_prod fun i _ => hA _ _)
  have hentry : ∀ c (W : Euclid k), ContDiff ℝ 1 (fun x => fderiv ℝ (g c) x W) := fun c W =>
    ((hg c).fderiv_right (by norm_num)).clm_apply contDiff_const
  set M : Fin (r + 1) → Euclid k → ℝ := fun b x => Matrix.det (Matrix.of fun (c b' : Fin r) =>
    fderiv ℝ (g c.succ) x (V (b.succAbove b')))
  have hMC1 : ∀ b, ContDiff ℝ 1 (M b) := fun b =>
    hdetC1 (fun x c b' => fderiv ℝ (g c.succ) x (V (b.succAbove b'))) fun c b' => hentry _ _
  -- `F_b = ψ g₀ M_b` is `C¹` with compact support
  have hFC1 : ∀ b, ContDiff ℝ 1 (fun y => ψ y * g 0 y * M b y) := fun b =>
    (hψ.mul ((hg 0).of_le (by norm_num))).mul (hMC1 b)
  have hFs : ∀ b, HasCompactSupport (fun y => ψ y * g 0 y * M b y) := fun b =>
    hψs.mul_right.mul_right
  -- Step 3: product rule for `∂_{V_b} F_b`
  have hdiff : ∀ b x, fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b) =
      fderiv ℝ ψ x (V b) * g 0 x * M b x + ψ x * fderiv ℝ (g 0) x (V b) * M b x +
        ψ x * g 0 x * fderiv ℝ (M b) x (V b) := by
    intro b x
    have hψd : DifferentiableAt ℝ ψ x := hψ.differentiable (by norm_num) x
    have hgd : DifferentiableAt ℝ (g 0) x := (hg 0).differentiable (by norm_num) x
    have hMd : DifferentiableAt ℝ (M b) x := (hMC1 b).differentiable (by norm_num) x
    have h : HasFDerivAt (fun y => ψ y * g 0 y * M b y) _ x :=
      (hψd.hasFDerivAt.mul hgd.hasFDerivAt).mul hMd.hasFDerivAt
    rw [h.fderiv]
    simp only [add_apply, smul_apply, smul_eq_mul, Pi.mul_apply]
    ring
  -- Steps 1, 4, 5: Laplace expansion along row `0` and the Piola identity give, pointwise,
  -- `ψ det A = Σ_b (−1)^b ∂_{V_b} F_b − Σ_b (−1)^b (∂_{V_b} ψ) g₀ M_b`
  have hpt : ∀ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) =
      ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b) -
        ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * (fderiv ℝ ψ x (V b) * g 0 x * M b x) := by
    intro x
    have hp : ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (M b) x (V b) = 0 :=
      Submission.dor_lmb_fcd_jwc_piola_identity k r (fun c => g c.succ) V x fun c => hg c.succ
    simp_rw [hdiff]
    have halg : ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * (fderiv ℝ ψ x (V b) * g 0 x * M b x +
          ψ x * fderiv ℝ (g 0) x (V b) * M b x + ψ x * g 0 x * fderiv ℝ (M b) x (V b)) -
        ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * (fderiv ℝ ψ x (V b) * g 0 x * M b x) =
        ψ x * ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (g 0) x (V b) * M b x +
          ψ x * g 0 x * ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (M b) x (V b) := by
      rw [← Finset.sum_sub_distrib, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun b _ => by ring
    rw [halg, hp, mul_zero, add_zero, Matrix.det_succ_row_zero]
    rfl
  -- Step 6: `∫ ∂_W F = 0` for `C¹` compactly supported `F` (integration by parts of the
  -- Lipschitz functions `1` and `F`)
  have hIBP0 : ∀ F : Euclid k → ℝ, ContDiff ℝ 1 F → HasCompactSupport F → ∀ W,
      ∫ x, fderiv ℝ F x W = 0 := by
    intro F hF hFs W
    obtain ⟨C, hFL⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hFs hF (by norm_num)
    have h := LipschitzWith.integral_lineDeriv_mul_eq (μ := (volume : Measure (Euclid k)))
      (LipschitzWith.const (1 : ℝ)) hFL hFs (-W)
    have h0 : ∀ x : Euclid k, lineDeriv ℝ (fun _ : Euclid k => (1 : ℝ)) x (-W) = 0 := by
      intro x
      rw [(differentiableAt_const (1 : ℝ)).lineDeriv_eq_fderiv]
      simp
    have h1 : ∀ x, lineDeriv ℝ F x W = fderiv ℝ F x W := fun x =>
      (hF.differentiable (by norm_num) x).lineDeriv_eq_fderiv
    simp only [h0, zero_mul, integral_zero, neg_neg, mul_one, h1] at h
    exact h.symm
  -- Step 7: every term is continuous with compact support, hence integrable; integrate
  have hi1 : ∀ b : Fin (r + 1), Integrable (fun x => (-1 : ℝ) ^ (b : ℕ) *
      fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b)) := fun b =>
    ((((hFC1 b).continuous_fderiv (by norm_num)).clm_apply
      continuous_const).integrable_of_hasCompactSupport ((hFs b).fderiv_apply ℝ (V b))).const_mul _
  have hi2 : ∀ b : Fin (r + 1), Integrable (fun x => (-1 : ℝ) ^ (b : ℕ) *
      (fderiv ℝ ψ x (V b) * g 0 x * M b x)) := fun b =>
    (((((hψ.continuous_fderiv (by norm_num)).clm_apply continuous_const).mul
      (hg 0).continuous).mul (hMC1 b).continuous).integrable_of_hasCompactSupport
      ((hψs.fderiv_apply ℝ (V b)).mul_right.mul_right)).const_mul _
  rw [integral_congr_ae (Eventually.of_forall hpt),
    integral_sub (integrable_finsetSum _ fun b _ => hi1 b)
      (integrable_finsetSum _ fun b _ => hi2 b),
    integral_finsetSum _ fun b _ => hi1 b, integral_finsetSum _ fun b _ => hi2 b]
  have hz : ∑ b : Fin (r + 1), ∫ x, (-1 : ℝ) ^ (b : ℕ) *
      fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b) = 0 :=
    Finset.sum_eq_zero fun b _ => by rw [integral_const_mul, hIBP0 _ (hFC1 b) (hFs b) _, mul_zero]
  rw [hz, zero_sub]
  simp only [integral_const_mul]
  rfl
/-- **Derivative of the mollification of a Lipschitz function**: for an `L`-Lipschitz `f` and a
`C¹` kernel `ρ` with compact support, `D(ρ ⋆ f)(x) v = ∫ ρ(t) Df(x − t) v dt`.  Differentiating
under the integral (`HasCompactSupport.hasFDerivAt_convolution_left`) gives
`D(ρ ⋆ f)(x) v = ∫ Dρ(t) v · f(x − t) dt`.  With `t = x − s` and the reflected kernel
`h(s) = ρ(x − s)` (`C¹` with compact support, hence Lipschitz, and `∂_{−v} h(s) = Dρ(x − s) v`)
the two sides become `∫ ∂_{−v} h · f` and `∫ h · Df(·) v`; they agree by integration by parts for
Lipschitz functions (`LipschitzWith.integral_lineDeriv_mul_eq`: `∫ ∂_v f · h = ∫ ∂_{−v} h · f`)
and Rademacher (`∂_v f = Df · v` a.e.). -/
theorem Submission.dor_lmb_fcd_jwc_mollify_fderiv_eq : ∀ (k : ℕ) (L : NNReal) (f ρ : Euclid k → ℝ), LipschitzWith L f → ContDiff ℝ 1 ρ → HasCompactSupport ρ → ∀ x v : Euclid k, fderiv ℝ (fun y => ∫ t, ρ t * f (y - t)) x v = ∫ t, ρ t * fderiv ℝ f (x - t) v := by
  intro k L f ρ hf hρ hρs x v
  have hconv : (fun y => ∫ t, ρ t * f (y - t)) =
      convolution ρ f (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    funext y; simp [convolution_def]
  have hD := hρs.hasFDerivAt_convolution_left (μ := volume) (ContinuousLinearMap.lsmul ℝ ℝ) hρ
    hf.continuous.locallyIntegrable x
  have hint := (hρs.fderiv (𝕜 := ℝ)).convolutionExists_left (μ := (volume : Measure (Euclid k)))
    ((ContinuousLinearMap.lsmul ℝ ℝ).precompL (Euclid k)) (hρ.continuous_fderiv (by norm_num))
    (hf.continuous.locallyIntegrable (μ := (volume : Measure (Euclid k)))) x
  rw [hconv, hD.fderiv, convolution_def, ContinuousLinearMap.integral_apply hint]
  simp only [ContinuousLinearMap.precompL_apply, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  -- change of variables `t ↦ x - t` on both sides
  rw [← integral_sub_left_eq_self (fun t => fderiv ℝ ρ t v * f (x - t)) (μ := volume) x,
    ← integral_sub_left_eq_self (fun t => ρ t * fderiv ℝ f (x - t) v) (μ := volume) x]
  simp only [sub_sub_cancel]
  -- integration by parts against `h(s) = ρ(x - s)`
  set h : Euclid k → ℝ := fun s => ρ (x - s) with hh
  have hhC1 : ContDiff ℝ 1 h := hρ.comp (contDiff_const.sub contDiff_id)
  have hhs : HasCompactSupport h := hρs.comp_homeomorph (Homeomorph.subLeft x)
  obtain ⟨D, hhL⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hhs hhC1 (by norm_num)
  have hibp := hf.integral_lineDeriv_mul_eq (μ := volume) hhL hhs v
  have hlh : ∀ s, lineDeriv ℝ h s (-v) = fderiv ℝ ρ (x - s) v := by
    intro s
    rw [(hhC1.differentiable (by norm_num) s).lineDeriv_eq_fderiv]
    have h1 : HasFDerivAt h (-(fderiv ℝ ρ (x - s))) s := by
      have := (hρ.differentiable (by norm_num) (x - s)).hasFDerivAt.comp s
        ((hasFDerivAt_const x s).sub (hasFDerivAt_id s))
      simpa [hh, Function.comp_def] using this
    rw [h1.fderiv]
    simp
  -- Rademacher: `∂_v f = Df · v` almost everywhere
  have hlf : ∀ᵐ s ∂(volume : Measure (Euclid k)), lineDeriv ℝ f s v = fderiv ℝ f s v := by
    filter_upwards [hf.ae_differentiableAt] with s hs
    exact hs.lineDeriv_eq_fderiv
  simp only [hlh] at hibp
  rw [← hibp]
  refine integral_congr_ae ?_
  filter_upwards [hlf] with s hs
  rw [hs, hh]
  ring
/-- Projection reduction for the constant-planes step of the cycle case of closure and boundary
rectifiability: if an `n`-vector `ζ` (`n = d + 1`) vanishes on every `n`-covector `w♭ ∧ α` with
`w ∈ Vᗮ` and `α` a `d`-covector, then `ζ(β) = ζ(β ∘ p_V)` for every `n`-covector `β`, where `p_V`
is the orthogonal projection onto `V`.  Take an orthonormal basis `e` of `ℝᴾ` with each `eᵢ` in
`V` or in `Vᗮ` (subordinate to `ℝᴾ = V ⊕ Vᗮ`) and the covectors `e^I(u) = det(⟨e_{I b}, u_a⟩)`,
`I : Fin n → Fin P` (`cbr_ci_cp_pr_inner_det_covector`), so that `n! β = ∑_I β(e_I) e^I`
(`cbr_ci_cp_pr_factorial_mul_eq_sum_det`).  If `e_{I k} ∈ Vᗮ` for some `k`, Laplace expansion along
column `k` writes `e^I = e_{I k}♭ ∧ α` (`cbr_ci_cp_pr_det_covector_laplace`), so `ζ(e^I) = 0`;
otherwise `p_V e_{I b} = e_{I b}` for every `b`, and `β ∘ p_V` has the same coefficient `β(e_I)`. -/
theorem Submission.cbr_ci_cp_eval_comp_starProjection_eq : ∀ (P d : ℕ) (ζ : MultiVector P (d + 1)) (V : Submodule ℝ (Euclid P)), (∀ w ∈ Vᗮ, ∀ (α : Covector (Euclid P) d) (γ : Covector (Euclid P) (d + 1)), (∀ u : Fin (d + 1) → Euclid P, γ u = ∑ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (inner ℝ w (u i) * α (i.removeNth u))) → ζ γ = 0) → ∀ β : Covector (Euclid P) (d + 1), ζ β = ζ (β.compContinuousLinearMap V.starProjection) := by
  have hdet := Submission.cbr_ci_cp_pr_inner_det_covector
  have hlap := Submission.cbr_ci_cp_pr_det_covector_laplace
  have hexp := Submission.cbr_ci_cp_pr_factorial_mul_eq_sum_det
  intro P d ζ V hζ β
  -- Step 1: an orthonormal basis of `ℝᴾ` subordinate to `ℝᴾ = V ⊕ Vᗮ`
  obtain ⟨e, he⟩ : ∃ e : OrthonormalBasis (Fin P) ℝ (Euclid P), ∀ i, e i ∈ V ∨ e i ∈ Vᗮ := by
    have hV' := V.orthogonalFamily_self
    have hint : DirectSum.IsInternal (fun b : Bool => cond b V Vᗮ) := by
      refine DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hV'.independent ?_
      rw [iSup_bool_eq]
      exact Submodule.sup_orthogonal_of_hasOrthogonalProjection
    refine ⟨hint.subordinateOrthonormalBasis finrank_euclideanSpace_fin hV', fun i => ?_⟩
    have hi := hint.subordinateOrthonormalBasis_subordinate finrank_euclideanSpace_fin i hV'
    revert hi
    cases hint.subordinateOrthonormalBasisIndex finrank_euclideanSpace_fin i hV'
    · exact Or.inr
    · exact Or.inl
  -- Step 2: the determinant covectors `e^I(u) = det(⟨e_{I b}, u_a⟩)`
  choose γ hγ using fun I : Fin (d + 1) → Fin P => hdet P (d + 1) fun b => e (I b)
  -- Step 3: `(d+1)! ζ(β') = ∑_I β'(e_I) ζ(e^I)` for every `(d+1)`-covector `β'`
  have hsum : ∀ β' : Covector (Euclid P) (d + 1), ((d + 1).factorial : ℝ) * ζ β' =
      ∑ I : Fin (d + 1) → Fin P, β' (fun a => e (I a)) * ζ (γ I) := by
    intro β'
    have hcov : ((d + 1).factorial : ℝ) • β' =
        ∑ I : Fin (d + 1) → Fin P, β' (fun a => e (I a)) • γ I := by
      ext u
      rw [ContinuousAlternatingMap.smul_apply, ContinuousAlternatingMap.sum_apply, smul_eq_mul,
        hexp P (d + 1) e β' u]
      refine Finset.sum_congr rfl fun I _ => ?_
      rw [ContinuousAlternatingMap.smul_apply, smul_eq_mul, hγ]
    have := congrArg ζ hcov
    rw [map_smul, map_sum, smul_eq_mul] at this
    rw [this]
    simp only [map_smul, smul_eq_mul]
  -- Step 4: `ζ(e^I) = 0` if some `e_{I k} ∈ Vᗮ` (Laplace expansion along column `k`)
  have hkill : ∀ (I : Fin (d + 1) → Fin P) (k : Fin (d + 1)), e (I k) ∈ Vᗮ → ζ (γ I) = 0 := by
    intro I k hk
    obtain ⟨α, hα⟩ := hlap P d (fun b => e (I b)) k (γ I) (hγ I)
    exact hζ (e (I k)) hk α (γ I) hα
  -- Step 5: `β ∘ p_V` and `β` agree on `e_I` if every `e_{I b} ∈ V`
  have hcoef : ∀ I : Fin (d + 1) → Fin P, (∀ b, e (I b) ∈ V) →
      β.compContinuousLinearMap V.starProjection (fun a => e (I a)) = β (fun a => e (I a)) := by
    intro I hI
    rw [ContinuousAlternatingMap.compContinuousLinearMap_apply]
    congr 1
    funext a
    exact Submodule.starProjection_eq_self_iff.mpr (hI a)
  -- Step 6: compare the two expansions term by term
  have hfact : ((d + 1).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  apply mul_left_cancel₀ hfact
  rw [hsum β, hsum (β.compContinuousLinearMap V.starProjection)]
  refine Finset.sum_congr rfl fun I _ => ?_
  by_cases hI : ∀ b, e (I b) ∈ V
  · rw [hcoef I hI]
  · obtain ⟨k, hk⟩ := not_forall.mp hI
    rw [hkill I k ((he (I k)).resolve_left hk), mul_zero, mul_zero]
/-- `(2M+1)^r` lattice points of a subspace `V ⊆ ℝᴾ` of dimension `r`, pairwise at distance
`≥ 2` and of norm `≤ 2M√r` (the packing step of the growth bound for the dimension of `V`).
For an orthonormal basis `e` of `V`, `c ↦ Σⱼ cⱼ eⱼ` is a linear isometry `ℓ²(ℝʳ) ≃ V`; take
`u_k = 2 Σⱼ kⱼ eⱼ` for `k` in the box `([−M, M] ∩ ℤ)ʳ`.  Distinct integer vectors differ by
`≥ 1` in some coordinate, so `‖u_k − u_l‖ ≥ 2`, and `‖u_k‖² = Σⱼ (2kⱼ)² ≤ r(2M)²`. -/
theorem Submission.cbr_ci_cp_gd_subspace_lattice_packing : ∀ (P : ℕ) (V : Submodule ℝ (Euclid P)) (M : ℕ), ∃ S : Finset (Euclid P), S.card = (2 * M + 1) ^ Module.finrank ℝ V ∧ (∀ x ∈ S, x ∈ V) ∧ (∀ x ∈ S, ‖x‖ ≤ 2 * M * Real.sqrt (Module.finrank ℝ V)) ∧ (∀ x ∈ S, ∀ y ∈ S, x ≠ y → 2 ≤ dist x y) := by
  intro P V M
  classical
  -- orthonormal coordinates `e.repr.symm : ℓ²(ℝʳ) ≃ₗᵢ V` and the points `u_k = e.repr.symm (2k)`
  let e := stdOrthonormalBasis ℝ V
  let c : (Fin (Module.finrank ℝ V) → ℤ) → EuclideanSpace ℝ (Fin (Module.finrank ℝ V)) :=
    fun k => WithLp.toLp 2 fun j => 2 * (k j : ℝ)
  let u : (Fin (Module.finrank ℝ V) → ℤ) → Euclid P := fun k => (e.repr.symm (c k) : Euclid P)
  have hnorm : ∀ k, ‖u k‖ = ‖c k‖ := fun k => by
    simp only [u, Submodule.norm_coe, LinearIsometryEquiv.norm_map]
  have hdist : ∀ k l, dist (u k) (u l) = dist (c k) (c l) := fun k l => by
    simp only [dist_eq_norm, u, ← Submodule.coe_sub, ← map_sub, Submodule.norm_coe,
      LinearIsometryEquiv.norm_map]
  -- distinct integer vectors give points at distance `≥ 2`
  have hsep : ∀ k l, k ≠ l → 2 ≤ dist (u k) (u l) := by
    intro k l hkl
    obtain ⟨j, hj⟩ := Function.ne_iff.mp hkl
    have h1 : (1 : ℝ) ≤ |(k j : ℝ) - l j| := by
      rw [← Int.cast_sub, ← Int.cast_abs]
      exact_mod_cast Int.one_le_abs (sub_ne_zero.mpr hj)
    calc (2 : ℝ) ≤ dist (c k j) (c l j) := by
          simp only [c, Real.dist_eq, ← mul_sub, abs_mul, abs_two]
          linarith
      _ ≤ dist (c k) (c l) := PiLp.dist_apply_le _ _ _
      _ = dist (u k) (u l) := (hdist k l).symm
  have hinj : Function.Injective u := fun k l hkl => by
    by_contra h
    have := hsep k l h
    rw [hkl, dist_self] at this
    norm_num at this
  -- the box `Λ_M = ([−M, M] ∩ ℤ)ʳ`
  refine ⟨(Fintype.piFinset fun _ => Finset.Icc (-(M : ℤ)) M).image u, ?_, ?_, ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ hinj, Fintype.card_piFinset, Int.card_Icc,
      Fin.prod_const]
    congr 1
    omega
  · simp only [Finset.mem_image]
    rintro x ⟨k, -, rfl⟩
    exact (e.repr.symm (c k)).2
  · simp only [Finset.mem_image, Fintype.mem_piFinset, Finset.mem_Icc]
    rintro x ⟨k, hk, rfl⟩
    rw [hnorm]
    have hM : (0 : ℝ) ≤ 2 * M * Real.sqrt (Module.finrank ℝ V) := by positivity
    refine (pow_le_pow_iff_left₀ (norm_nonneg _) hM two_ne_zero).mp ?_
    rw [EuclideanSpace.norm_sq_eq, mul_pow, Real.sq_sqrt (Nat.cast_nonneg _)]
    calc ∑ j, ‖c k j‖ ^ 2 ≤ ∑ _j : Fin (Module.finrank ℝ V), (2 * (M : ℝ)) ^ 2 := by
          refine Finset.sum_le_sum fun j _ => ?_
          rw [Real.norm_eq_abs, sq_abs]
          have hkj : -(M : ℝ) ≤ k j ∧ (k j : ℝ) ≤ M :=
            ⟨by exact_mod_cast (hk j).1, by exact_mod_cast (hk j).2⟩
          simp only [c]
          nlinarith [hkj.1, hkj.2]
      _ = (2 * M) ^ 2 * Module.finrank ℝ V := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_comm]
  · simp only [Finset.mem_image]
    rintro x ⟨k, -, rfl⟩ y ⟨l, -, rfl⟩ hxy
    exact hsep k l fun h => hxy (h ▸ rfl)
/-- Packing count for unit balls translated along a subspace `V` (used in the proof of Simon 7.2.4,
p. 184, to show that a measure with `ν(B_R(0)) ≤ C Rⁿ` that is invariant under the translations of
`V` has `dim V ≤ n`): if `ν` is invariant under translation by every `v ∈ V`, and `S ⊆ V` is finite
with `‖x‖ ≤ ρ` for `x ∈ S` and `dist x y ≥ 2` for distinct `x, y ∈ S`, then
`#S · ν(B_1(0)) ≤ ν(B_{ρ+1}(0))`.  Each `B_1(x) = {y : -x + y ∈ B_1(0)}` has measure `ν(B_1(0))`
(as `-x ∈ V`), and these balls are pairwise disjoint (triangle inequality) and lie in
`B_{ρ+1}(0)`. -/
theorem Submission.cbr_ci_cp_gd_translated_ball_count : ∀ (P : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (S : Finset (Euclid P)) (ρ : ℝ), (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => v + x) ⁻¹' A) = ν A) → (∀ x ∈ S, x ∈ V) → (∀ x ∈ S, ‖x‖ ≤ ρ) → (∀ x ∈ S, ∀ y ∈ S, x ≠ y → 2 ≤ dist x y) → (S.card : ℝ≥0∞) * ν (ball 0 1) ≤ ν (ball 0 (ρ + 1)) := by
  intro P ν V S ρ hinv hSV hSρ hsep
  -- equal mass: `B_1(x)` is the preimage of `B_1(0)` under `y ↦ -x + y`, and `-x ∈ V`
  have hmass : ∀ x ∈ S, ν (ball x 1) = ν (ball 0 1) := by
    intro x hx
    have hpre : (fun y => -x + y) ⁻¹' ball (0 : Euclid P) 1 = ball x 1 := by
      ext y
      simp only [mem_preimage, mem_ball_iff_norm, sub_zero, neg_add_eq_sub]
    rw [← hpre]
    exact hinv (-x) (V.neg_mem (hSV x hx)) _ measurableSet_ball
  -- disjointness: a common point `z` would give `2 ≤ dist x y ≤ dist z x + dist z y < 2`
  have hdisj : (S : Set (Euclid P)).PairwiseDisjoint fun x => ball x 1 := by
    intro x hx y hy hxy
    refine Set.disjoint_left.mpr fun z hzx hzy => ?_
    rw [mem_ball] at hzx hzy
    linarith [hsep x hx y hy hxy, dist_triangle_left x y z]
  -- containment: `‖z‖ ≤ ‖x‖ + ‖z - x‖ < ρ + 1`
  have hsub : (⋃ x ∈ S, ball x 1) ⊆ ball (0 : Euclid P) (ρ + 1) := by
    refine iUnion₂_subset fun x hx z hz => ?_
    rw [mem_ball_iff_norm] at hz
    rw [mem_ball_zero_iff]
    linarith [hSρ x hx, norm_le_norm_add_norm_sub' z x]
  -- counting: `#S · ν(B_1(0)) = Σ_{x ∈ S} ν(B_1(x)) = ν(⋃_{x ∈ S} B_1(x)) ≤ ν(B_{ρ+1}(0))`
  calc (S.card : ℝ≥0∞) * ν (ball 0 1) = ∑ x ∈ S, ν (ball x 1) := by
        rw [Finset.sum_congr rfl hmass, Finset.sum_const, nsmul_eq_mul]
    _ = ν (⋃ x ∈ S, ball x 1) :=
        (measure_biUnion_finset hdisj fun x _ => measurableSet_ball).symm
    _ ≤ ν (ball 0 (ρ + 1)) := measure_mono hsub
/-- Final step of the growth-forces-dimension argument in the proof of Simon 7.2.4 (packing
`(2M+1)ʳ` disjoint unit balls of an `r`-plane into `B_{3M√r}(0)`): if `a > 0` and
`a·Mʳ ≤ b·Mⁿ` for every integer `M ≥ 1`, then `r ≤ n`.  Otherwise `n + 1 ≤ r`; the Archimedean
property gives `N > b/a`, and `M = N + 1` has `a·M > b`, while
`a·M·Mⁿ = a·Mⁿ⁺¹ ≤ a·Mʳ ≤ b·Mⁿ` gives `a·M ≤ b` after cancelling `Mⁿ > 0`. -/
theorem Submission.cbr_ci_cp_gd_le_of_pow_bound : ∀ (r n : ℕ) (a b : ℝ), 0 < a → (∀ M : ℕ, 1 ≤ M → a * (M : ℝ) ^ r ≤ b * (M : ℝ) ^ n) → r ≤ n := by
  intro r n a b ha h
  -- suppose `n + 1 ≤ r`
  by_contra hrn
  have hr : n + 1 ≤ r := Nat.lt_iff_add_one_le.mp (not_le.mp hrn)
  -- Archimedean choice `N > b / a`; `M := N + 1 ≥ 1` has `a * M > b`
  obtain ⟨N, hN⟩ := exists_nat_gt (b / a)
  have hM : (1 : ℝ) ≤ ((N + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.le_add_left 1 N
  have hbM : b < ((N + 1 : ℕ) : ℝ) * a := by
    rw [← div_lt_iff₀ ha]
    push_cast
    linarith
  -- `a * M * Mⁿ = a * Mⁿ⁺¹ ≤ a * Mʳ ≤ b * Mⁿ`, then cancel `Mⁿ > 0`
  have hle : a * ((N + 1 : ℕ) : ℝ) * ((N + 1 : ℕ) : ℝ) ^ n ≤ b * ((N + 1 : ℕ) : ℝ) ^ n :=
    calc a * ((N + 1 : ℕ) : ℝ) * ((N + 1 : ℕ) : ℝ) ^ n = a * ((N + 1 : ℕ) : ℝ) ^ (n + 1) := by
          ring
      _ ≤ a * ((N + 1 : ℕ) : ℝ) ^ r := mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hM hr) ha.le
      _ ≤ b * ((N + 1 : ℕ) : ℝ) ^ n := h (N + 1) (Nat.le_add_left 1 N)
  have hMa := le_of_mul_le_mul_right hle (pow_pos (zero_lt_one.trans_le hM) n)
  linarith

/-- **Growth forces `dim V ≤ n`** (step 4 of the constant-planes argument, with `ωₙ` replaced by an
arbitrary finite constant `C`).  Let `r = dim V` and `m₀ = ν(B₁(0))`, so `0 < m₀ ≤ C < ∞` (growth at
`R = 1`).  Fix `M ≥ 1`.  The sibling `lattice_packing` gives `(2M+1)ʳ` points of `V` of norm
`≤ 2M√r` with pairwise distances `≥ 2`; by the sibling `ball_count` (translation invariance and
disjointness of their unit balls) and the growth bound at `R = 2M√r + 1`,
`(2M+1)ʳ m₀ ≤ ν(B_{2M√r+1}(0)) ≤ C (2M√r+1)ⁿ`.  As `M ≤ 2M+1` and `2M√r + 1 ≤ (2√r+1)M`, this gives
`m₀ Mʳ ≤ C (2√r+1)ⁿ Mⁿ` for every `M ≥ 1`, and the sibling `pow_bound` yields `r ≤ n`. -/
theorem Submission.cbr_ci_cp_finrank_le_of_growth : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (C : ℝ≥0∞), C ≠ ∞ → (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => v + x) ⁻¹' A) = ν A) → (∀ R : ℝ, 0 < R → ν (ball 0 R) ≤ C * ENNReal.ofReal (R ^ n)) → 0 < ν (ball 0 1) → Module.finrank ℝ V ≤ n := by
  intro P n ν V C hC hinv hgrowth hpos
  -- Step 1: `m₀ = ν(B₁(0))` is finite, by the growth bound at `R = 1`
  have hfin : ν (ball 0 1) ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top hC ENNReal.ofReal_ne_top) (hgrowth 1 one_pos)
  -- Step 2: by the sibling `pow_bound` it suffices that `m₀ Mʳ ≤ C (2√r+1)ⁿ Mⁿ` for all `M ≥ 1`
  refine Submission.cbr_ci_cp_gd_le_of_pow_bound (Module.finrank ℝ V) n (ν (ball 0 1)).toReal
    (C.toReal * (2 * Real.sqrt (Module.finrank ℝ V) + 1) ^ n)
    (ENNReal.toReal_pos hpos.ne' hfin) fun M hM => ?_
  -- Step 3: `(2M+1)ʳ` points of `V` of norm `≤ 2M√r`, pairwise `2`-separated (`lattice_packing`)
  obtain ⟨S, hcard, hSV, hSnorm, hSsep⟩ := Submission.cbr_ci_cp_gd_subspace_lattice_packing P V M
  -- Step 4: `(2M+1)ʳ m₀ ≤ ν(B_{2M√r+1}(0)) ≤ C (2M√r+1)ⁿ` (`ball_count`, then growth)
  have hρ : 0 ≤ 2 * (M : ℝ) * Real.sqrt (Module.finrank ℝ V) := by positivity
  have hle := (Submission.cbr_ci_cp_gd_translated_ball_count P ν V S _ hinv hSV hSnorm hSsep).trans
    (hgrowth (2 * M * Real.sqrt (Module.finrank ℝ V) + 1) (by linarith))
  have hpow : 0 ≤ (2 * (M : ℝ) * Real.sqrt (Module.finrank ℝ V) + 1) ^ n := by positivity
  have hreal := ENNReal.toReal_mono (ENNReal.mul_ne_top hC ENNReal.ofReal_ne_top) hle
  rw [ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal hpow, hcard,
    ENNReal.toReal_natCast] at hreal
  push_cast at hreal
  -- Step 5: `Mʳ ≤ (2M+1)ʳ` and `2M√r + 1 ≤ (2√r+1)M`, since `M ≥ 1`
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have h1 : (M : ℝ) ^ Module.finrank ℝ V ≤ (2 * M + 1) ^ Module.finrank ℝ V :=
    pow_le_pow_left₀ (by positivity) (by linarith) _
  have h2 : (2 * M * Real.sqrt (Module.finrank ℝ V) + 1) ^ n ≤
      (2 * Real.sqrt (Module.finrank ℝ V) + 1) ^ n * (M : ℝ) ^ n := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (by positivity)
      (by nlinarith [Real.sqrt_nonneg (Module.finrank ℝ V : ℝ)]) _
  calc (ν (ball 0 1)).toReal * (M : ℝ) ^ Module.finrank ℝ V
      ≤ (2 * M + 1) ^ Module.finrank ℝ V * (ν (ball 0 1)).toReal := by
        rw [mul_comm]
        exact mul_le_mul_of_nonneg_right h1 ENNReal.toReal_nonneg
    _ ≤ C.toReal * (2 * M * Real.sqrt (Module.finrank ℝ V) + 1) ^ n := hreal
    _ ≤ C.toReal * ((2 * Real.sqrt (Module.finrank ℝ V) + 1) ^ n * (M : ℝ) ^ n) :=
        mul_le_mul_of_nonneg_left h2 ENNReal.toReal_nonneg
    _ = C.toReal * (2 * Real.sqrt (Module.finrank ℝ V) + 1) ^ n * (M : ℝ) ^ n := by ring

/-- **Covectors vanish through a rank-deficient projection** (Simon Ch. 6, §1): if
`dim V < n`, then `β ∘ p_V = 0` for every `n`-covector `β` on `ℝᴾ`, `p_V` the orthogonal
projection onto `V`.  For any `u₁, …, uₙ` the `n` vectors `p_V u₁, …, p_V uₙ` lie in `V`, so they
are linearly dependent, and the alternating form `β` vanishes on a linearly dependent family. -/
theorem Submission.cbr_ci_cp_comp_starProjection_eq_zero_of_finrank_lt : ∀ (P n : ℕ) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V < n → ∀ β : Covector (Euclid P) n, β.compContinuousLinearMap V.starProjection = 0 := by
  intro P n V hlt β
  -- Step 1: it suffices that `β(p_V u₁, …, p_V uₙ) = 0` for every family `u`
  ext u
  rw [ContinuousAlternatingMap.compContinuousLinearMap_apply, ContinuousAlternatingMap.coe_zero,
    Pi.zero_apply]
  -- Step 2: an alternating form vanishes on a family that is not linearly independent
  apply β.toAlternatingMap.map_linearDependent
  -- Step 3: `p_V ∘ u = V.subtype ∘ v` with `vᵢ := p_V uᵢ ∈ V`; were it independent, so would be
  -- the `n` vectors `vᵢ` of `V`, giving `n ≤ dim V < n`
  intro hli
  have hli' : LinearIndependent ℝ (fun i => V.orthogonalProjectionOnto (u i)) := by
    apply LinearIndependent.of_comp V.subtype
    exact hli
  have hcard := hli'.fintype_card_le_finrank
  rw [Fintype.card_fin] at hcard
  omega
/-- **An orthonormal frame spanning a subspace** (Simon 6.1.1; the frame `τ` of
`IsUnitOrientationOf`): an `n`-dimensional subspace `V` of `ℝᴾ` is `span{v₀, …, vₙ₋₁}` for an
orthonormal `v : Fin n → ℝᴾ`.  Reindex the orthonormal basis `stdOrthonormalBasis ℝ V` along
`finrank ℝ V = n` to `b : Fin n → V` and put `vᵢ = ↑bᵢ`; the inclusion `V → ℝᴾ` is a linear
isometry, so `v` is orthonormal, and `span (range v)` is the image of `span (range b) = ⊤` under
the inclusion, i.e. `V`. -/
theorem Submission.cbr_ci_cp_exists_orthonormal_frame_of_finrank_eq : ∀ (P n : ℕ) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → ∃ v : Fin n → Euclid P, Orthonormal ℝ v ∧ Submodule.span ℝ (Set.range v) = V := by
  intro P n V hV
  -- Step 1: an orthonormal basis `b` of `V` indexed by `Fin n`
  let b : OrthonormalBasis (Fin n) ℝ V := (stdOrthonormalBasis ℝ V).reindex (finCongr hV)
  refine ⟨fun i => (b i : Euclid P), ?_, ?_⟩
  · -- Step 2: `vᵢ = ↑bᵢ` is orthonormal, the inclusion `V.subtypeₗᵢ` being a linear isometry
    exact b.orthonormal.comp_linearIsometry V.subtypeₗᵢ
  · -- Step 3: `span (range v) = map V.subtype (span (range b)) = map V.subtype ⊤ = V`
    have hrange : Set.range (fun i => (b i : Euclid P)) = (V.subtype) '' Set.range b := by
      rw [← Set.range_comp]; rfl
    have hb : Submodule.span ℝ (Set.range b) = ⊤ := by
      simpa [OrthonormalBasis.coe_toBasis] using b.toBasis.span_eq
    rw [hrange, Submodule.span_image, hb, Submodule.map_top, Submodule.range_subtype]
/-- **Reversing an orthonormal frame by negating its first vector** (Simon 6.1; the sign in
`ζ = ±v₀ ∧ ⋯ ∧ v_d`): for orthonormal `v₀, …, v_d` in `ℝᴾ`, `w = (-v₀, v₁, …, v_d)` is
orthonormal with the same span, and `β(w) = -β(v)` for every `(d+1)`-covector `β`.  With the
signs `c = (-1, 1, …, 1)`, `wᵢ = cᵢ vᵢ` and `cᵢ² = 1`, so `⟨wᵢ, wⱼ⟩ = cᵢcⱼ⟨vᵢ, vⱼ⟩ = δᵢⱼ` and
`vᵢ = cᵢ wᵢ`; `β` is linear in its first slot. -/
theorem Submission.cbr_ci_cp_exists_orthonormal_frame_eval_neg : ∀ (P d : ℕ) (v : Fin (d + 1) → Euclid P), Orthonormal ℝ v → ∃ w : Fin (d + 1) → Euclid P, Orthonormal ℝ w ∧ Submodule.span ℝ (Set.range w) = Submodule.span ℝ (Set.range v) ∧ ∀ β : Covector (Euclid P) (d + 1), β w = -β v := by
  intro P d v hv
  -- Step 1: the signs `c = (-1, 1, …, 1)`, with `cᵢ cᵢ = 1` and `w = (cᵢ • vᵢ)ᵢ`
  let c : Fin (d + 1) → ℝ := Function.update (fun _ => (1 : ℝ)) 0 (-1)
  have hc : ∀ i, c i * c i = 1 := by
    intro i
    by_cases h : i = 0
    · subst h; simp [c]
    · simp [c, h]
  have hw : (fun i => c i • v i) = Function.update v 0 (-v 0) := by
    funext i
    by_cases h : i = 0
    · subst h; simp [c]
    · simp [c, h]
  refine ⟨Function.update v 0 (-v 0), ?_, ?_, ?_⟩
  · -- Step 2: `⟨wᵢ, wⱼ⟩ = cᵢ cⱼ ⟨vᵢ, vⱼ⟩ = δᵢⱼ`
    rw [← hw]
    rw [orthonormal_iff_ite] at hv ⊢
    intro i j
    rw [real_inner_smul_left, real_inner_smul_right, hv i j]
    by_cases hij : i = j
    · subst hij
      simp only [↓reduceIte, mul_one]
      exact hc i
    · simp only [hij, ↓reduceIte, mul_zero]
  · -- Step 3: `wᵢ = cᵢ • vᵢ` and `vᵢ = cᵢ • wᵢ`, so the two spans contain each other
    rw [← hw]
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      have h : v i = c i • (c i • v i) := by
        rw [smul_smul, hc i, one_smul]
      rw [h]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  · -- Step 4: `β` is linear in slot `0`: `β(update v 0 ((-1) • v₀)) = (-1) • β(v)`
    intro β
    have h := β.map_update_smul v 0 (-1 : ℝ) (v 0)
    rw [neg_one_smul, Function.update_eq_self] at h
    rw [h, neg_one_smul]
/-- **Normalisation of a constant unit `n`-vector** (step 5 of the constant-planes lemma in the
proof of the closure theorem, Simon Ch. 6, 3.11, used for 7.2.4; Simon (6.1.1), (6.1.15)): let
`ζ₀ ∈ Λₙ(ℝᴾ)`, `n = d + 1`, satisfy `|ζ₀(β)| ≤ |β|_E` for every `n`-covector `β`, `ζ₀(β₁) = 1` for
some `β₁` with `|β₁|_E ≤ 1`, and `ζ₀(β) = ζ₀(β ∘ p_V)` for a subspace `V` with `dim V ≤ n`.  Then
`dim V = n` and `ζ₀(β) = β(v₀, …, v_d)` for an orthonormal frame `v` of `V`.  If `dim V < n` then
`β₁ ∘ p_V = 0`, so `ζ₀(β₁) = 0`.  Otherwise let `v` be an orthonormal frame of `V` and `β₂` a
covector with `|β₂|_E = 1`, `β₂(v) = 1`.  As every `p_V u_j` lies in `V = span v`,
`β(p_V u) = det(⟨v_i, p_V u_j⟩) β(v) = β(v) β₂(p_V u)`, so `ζ₀(β) = β(v) s` with `s = ζ₀(β₂)`.
Then `|s| ≤ |β₂|_E = 1` and `1 = |β₁(v)| |s| ≤ |s|`, as `|β₁(v)| ≤ |β₁|_E ≤ 1`; so `s = ±1`, and for
`s = −1` the frame with `v₀` negated works. -/
theorem Submission.cbr_ci_cp_eval_eq_orthonormal_frame : ∀ (P d : ℕ) (ζ₀ : MultiVector P (d + 1)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V ≤ d + 1 → (∀ β : Covector (Euclid P) (d + 1), |ζ₀ β| ≤ covectorEuclideanNorm β) → (∃ β : Covector (Euclid P) (d + 1), covectorEuclideanNorm β ≤ 1 ∧ ζ₀ β = 1) → (∀ β : Covector (Euclid P) (d + 1), ζ₀ β = ζ₀ (β.compContinuousLinearMap V.starProjection)) → Module.finrank ℝ V = d + 1 ∧ ∃ v : Fin (d + 1) → Euclid P, Orthonormal ℝ v ∧ Submodule.span ℝ (Set.range v) = V ∧ ∀ β : Covector (Euclid P) (d + 1), ζ₀ β = β v := by
  intro P d ζ₀ V hdim hle hβ₁ hproj
  obtain ⟨β₁, hβ₁, hζβ₁⟩ := hβ₁
  -- Step 1: `dim V = d + 1`; otherwise `β₁ ∘ p_V = 0` and `1 = ζ₀(β₁) = ζ₀(β₁ ∘ p_V) = ζ₀(0) = 0`
  have hrank : Module.finrank ℝ V = d + 1 := by
    refine le_antisymm hdim (not_lt.mp fun hlt => ?_)
    have h0 : ζ₀ β₁ = 0 := by
      rw [hproj β₁,
        Submission.cbr_ci_cp_comp_starProjection_eq_zero_of_finrank_lt P (d + 1) V hlt β₁,
        map_zero]
    rw [hζβ₁] at h0
    exact one_ne_zero h0
  -- Step 2: an orthonormal frame `v` of `V`
  obtain ⟨v, hv, hspan⟩ :=
    Submission.cbr_ci_cp_exists_orthonormal_frame_of_finrank_eq P (d + 1) V hrank
  -- Step 4: a covector `β₂` with `|β₂|_E = 1` and `β₂(v) = 1`
  obtain ⟨β₂, hβ₂, hβ₂v⟩ :=
    Submission.regcomp_exists_covector_eval_orthonormal_eq_one P (d + 1) v hv
  -- Step 3: `p_V u_j ∈ V = span v`, so `β(p_V u) = det(⟨v_i, p_V u_j⟩) β(v) = β(v) β₂(p_V u)`
  have hcomp : ∀ β : Covector (Euclid P) (d + 1),
      β.compContinuousLinearMap V.starProjection =
        β v • β₂.compContinuousLinearMap V.starProjection := by
    intro β
    ext u
    have hmem : ∀ j, (V.starProjection ∘ u) j ∈ Submodule.span ℝ (Set.range v) := fun j => by
      rw [hspan]
      exact V.starProjection_apply_mem (u j)
    rw [ContinuousAlternatingMap.smul_apply,
      ContinuousAlternatingMap.compContinuousLinearMap_apply,
      ContinuousAlternatingMap.compContinuousLinearMap_apply,
      Submission.dgoj_covector_eq_det_mul_of_mem_span P (d + 1) v _ hv hmem β,
      Submission.dgoj_covector_eq_det_mul_of_mem_span P (d + 1) v _ hv hmem β₂, hβ₂v,
      smul_eq_mul]
    ring
  -- Step 4: `ζ₀(β) = ζ₀(β ∘ p_V) = β(v) ζ₀(β₂ ∘ p_V) = β(v) s` with `s = ζ₀(β₂)`
  have hζ : ∀ β : Covector (Euclid P) (d + 1), ζ₀ β = β v * ζ₀ β₂ := by
    intro β
    rw [hproj β, hcomp β, map_smul, ← hproj β₂, smul_eq_mul]
  -- Step 5: `|s| ≤ |β₂|_E = 1`
  have hs₁ : |ζ₀ β₂| ≤ 1 := (hle β₂).trans_eq hβ₂
  -- Step 6: `1 = |β₁(v)| |s| ≤ |s|`, as `|β₁(v)| ≤ |β₁|_E ≤ 1`
  have hs₂ : 1 ≤ |ζ₀ β₂| := by
    have hβ₁v : |β₁ v| ≤ 1 :=
      (Submission.regcomp_covector_eval_orthonormal_le P (d + 1) β₁ v hv).trans hβ₁
    calc (1 : ℝ) = |β₁ v| * |ζ₀ β₂| := by rw [← abs_mul, ← hζ β₁, hζβ₁, abs_one]
      _ ≤ 1 * |ζ₀ β₂| := mul_le_mul_of_nonneg_right hβ₁v (abs_nonneg _)
      _ = |ζ₀ β₂| := one_mul _
  -- Step 7: `s = ±1`; for `s = −1` negate `v₀`
  refine ⟨hrank, ?_⟩
  rcases (abs_eq zero_le_one).mp (le_antisymm hs₁ hs₂) with hs | hs
  · exact ⟨v, hv, hspan, fun β => by rw [hζ β, hs, mul_one]⟩
  · obtain ⟨w, hw, hwspan, hwβ⟩ := Submission.cbr_ci_cp_exists_orthonormal_frame_eval_neg P d v hv
    exact ⟨w, hw, hwspan.trans hspan, fun β => by rw [hζ β, hs, hwβ β, mul_neg_one]⟩

/-- A measure `m` on `ℝᴾ` carried by an `n`-dimensional linear subspace `V`, finite on compact
sets and invariant under the translations by `V`, is a constant multiple of `Hⁿ⌞V` (used for the
product structure of translation invariant measures in the integer multiplicity part of Simon
7.2.4, Remark 7.2.5(1)).  The orthogonal projection `π : ℝᴾ → V` pushes `m` forward to a
translation invariant measure on `V`, finite on compact sets, hence `c • vol_V` by uniqueness of
Haar measure.  As `m` is carried by `V`, it is the image of `π_# m` under the inclusion
`V → ℝᴾ`, an isometry, and `μHE[n] = vol_V` on `V`. -/
theorem Submission.cbr_ci_cp_prod_subspace_haar : ∀ (P n : ℕ) (m : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → m (V : Set (Euclid P))ᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → m K < ∞) → (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → m ((fun x => v + x) ⁻¹' A) = m A) → ∃ c : ℝ≥0∞, m = c • (μHE[n]).restrict (V : Set (Euclid P)) := by
  intro P n m V hn hVc hcpt hinv
  subst hn
  -- the orthogonal projection `π` onto `V` fixes `V` pointwise
  have hπ : ∀ x ∈ V, ((V.orthogonalProjectionOnto x : V) : Euclid P) = x := fun x hx => by
    simpa using congrArg Subtype.val (V.orthogonalProjectionOnto_mem_subspace_eq_self ⟨x, hx⟩)
  have hπm : Measurable V.orthogonalProjectionOnto :=
    V.orthogonalProjectionOnto.continuous.measurable
  -- invariance of `m` under the translations by `V`, as an identity of measures
  have htr : ∀ v ∈ V, m.map (fun x => v + x) = m := fun v hv => by
    ext A hA
    rw [Measure.map_apply (measurable_const_add v) hA, hinv v hv A hA]
  -- `m' = π_# m` is translation invariant on `V`, as `(g + ·) ∘ π = π ∘ (g + ·)` for `g ∈ V`
  set m' : Measure V := m.map V.orthogonalProjectionOnto with hm'
  have hinv' : m'.IsAddLeftInvariant := ⟨fun g => by
    have hcomm : (fun x : V => g + x) ∘ V.orthogonalProjectionOnto =
        V.orthogonalProjectionOnto ∘ (fun x => (g : Euclid P) + x) := by
      funext x; simp
    rw [hm', Measure.map_map (measurable_const_add g) hπm, hcomm,
      ← Measure.map_map hπm (measurable_const_add _), htr _ g.2]⟩
  -- `m'` is finite on compact sets, as `π⁻¹ K ⊆ ι K ∪ Vᶜ` and `m Vᶜ = 0`
  have hfin' : IsFiniteMeasureOnCompacts m' := ⟨fun K hK => by
    rw [hm', Measure.map_apply hπm hK.isClosed.measurableSet]
    calc m (V.orthogonalProjectionOnto ⁻¹' K)
        ≤ m (Subtype.val '' K ∪ (V : Set (Euclid P))ᶜ) := by
          refine measure_mono fun x hx => ?_
          by_cases hxV : x ∈ V
          · exact Or.inl ⟨_, hx, hπ x hxV⟩
          · exact Or.inr hxV
      _ ≤ m (Subtype.val '' K) + m (V : Set (Euclid P))ᶜ := measure_union_le _ _
      _ < ∞ := by
          rw [hVc, add_zero]
          exact hcpt _ (hK.image continuous_subtype_val)⟩
  -- uniqueness of Haar measure on `V`
  obtain ⟨c, hc⟩ : ∃ c : NNReal, m' = c • (volume : Measure V) :=
    ⟨_, Measure.isAddLeftInvariant_eq_smul m' volume⟩
  -- `m = ι_# m'` for the inclusion `ι : V → ℝᴾ`, as `ι ∘ π = id` on `V`, which carries `m`
  have hm : m = m'.map Subtype.val := by
    rw [hm', Measure.map_map continuous_subtype_val.measurable hπm]
    conv_lhs => rw [← Measure.map_id (μ := m)]
    refine Measure.map_congr (measure_mono_null (fun x hx => ?_) hVc)
    exact fun hxV => hx (hπ x hxV).symm
  -- `ι_# vol_V = Hⁿ⌞V`, as `μHE[n] = vol_V` on `V` and `ι` is an isometry with range `V`
  have hvol : (volume : Measure V).map Subtype.val =
      (μHE[Module.finrank ℝ V]).restrict (V : Set (Euclid P)) := by
    rw [← InnerProductSpace.euclideanHausdorffMeasure_eq_volume,
      isometry_subtype_coe.map_euclideanHausdorffMeasure, Subtype.range_coe]
  refine ⟨c, ?_⟩
  rw [hm, hc, Measure.map_smul _ continuous_subtype_val.aemeasurable, hvol,
    Measure.coe_nnreal_smul]

/-- Let `ν` be a measure on `ℝᴾ`, finite on compact sets and invariant under the translations by
an `n`-dimensional linear subspace `V`, and let `p`, `q` be the orthogonal projections onto `V`
and `Vᗮ`.  Then `ν(p⁻¹ A ∩ q⁻¹ B) = σ(B) Hⁿ(A ∩ V)` for all Borel `A`, `B`, for a measure `σ`
carried by `Vᗮ` and finite on compact sets (used for the product structure of translation
invariant measures in the integer multiplicity part of Simon 7.2.4, Remark 7.2.5(1)).  Take
`σ = ωₙ⁻¹ q_#(ν⌞p⁻¹ B_1(0))`.  For bounded `B`, `p_#(ν⌞q⁻¹ B)` is carried by `V`, finite on
compact sets and invariant under the translations by `V`, hence equal to `c Hⁿ⌞V`; evaluating at
`B_1(0)`, where `Hⁿ(V ∩ B_1(0)) = ωₙ`, gives `c = σ(B)`.  Exhausting `B` by the bounded sets
`B ∩ B_j(0)` gives the general case. -/
theorem Submission.cbr_ci_cp_prod_rectangle_formula : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => v + x) ⁻¹' A) = ν A) → ∃ σ : Measure (Euclid P), σ (Vᗮ : Set (Euclid P))ᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) ∧ ∀ A B : Set (Euclid P), MeasurableSet A → MeasurableSet B → ν (V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B) = σ B * μHE[n] (A ∩ (V : Set (Euclid P))) := by
  intro P n ν V hn hcpt hinv
  -- `p = V.starProjection` and `q = Vᗮ.starProjection` are continuous linear, hence measurable
  have hpm : Measurable V.starProjection := V.starProjection.continuous.measurable
  have hqm : Measurable Vᗮ.starProjection := Vᗮ.starProjection.continuous.measurable
  -- for `v ∈ V`, `p (v + y) = v + p y` and `q (v + y) = q y`
  have hpv : ∀ v ∈ V, ∀ y, V.starProjection (v + y) = v + V.starProjection y := fun v hv y => by
    rw [map_add, Submodule.starProjection_eq_self_iff.2 hv]
  have hqv : ∀ v ∈ V, ∀ y, Vᗮ.starProjection (v + y) = Vᗮ.starProjection y := fun v hv y => by
    rw [map_add, Submodule.starProjection_orthogonal_apply_eq_zero hv, zero_add]
  -- boxes `{y : p y ∈ E, q y ∈ F}` with `E`, `F` bounded lie in a compact ball, as `y = p y + q y`
  have hbox : ∀ E F : Set (Euclid P), Bornology.IsBounded E → Bornology.IsBounded F →
      ν (V.starProjection ⁻¹' E ∩ Vᗮ.starProjection ⁻¹' F) < ∞ := by
    intro E F hE hF
    obtain ⟨R, hR⟩ := hE.subset_closedBall 0
    obtain ⟨S, hS⟩ := hF.subset_closedBall 0
    refine lt_of_le_of_lt (measure_mono fun y hy => ?_) (hcpt _ (isCompact_closedBall 0 (R + S)))
    rw [mem_closedBall_zero_iff, ← V.starProjection_add_starProjection_orthogonal y]
    exact (norm_add_le _ _).trans
      (add_le_add (mem_closedBall_zero_iff.1 (hR hy.1)) (mem_closedBall_zero_iff.1 (hS hy.2)))
  -- `Hⁿ(B_1(0) ∩ V) = ωₙ`, and `0 < ωₙ < ∞`
  have hω : μHE[n] (ball (0 : Euclid P) 1 ∩ V) = unitBallVolume n := by
    rw [Set.inter_comm, Submission.idtp_tdc_subspace_ball_measure P n V 0 1 hn V.zero_mem one_pos]
    simp
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  -- `σ = ωₙ⁻¹ q_#(ν⌞p⁻¹ B_1(0))`, so `σ(B) = ωₙ⁻¹ ν(q⁻¹ B ∩ p⁻¹ B_1(0))` for Borel `B`
  obtain ⟨σ, hσB⟩ : ∃ σ : Measure (Euclid P), ∀ B, MeasurableSet B → σ B =
      (unitBallVolume n)⁻¹ * ν (Vᗮ.starProjection ⁻¹' B ∩ V.starProjection ⁻¹' ball 0 1) :=
    ⟨(unitBallVolume n)⁻¹ • (ν.restrict (V.starProjection ⁻¹' ball 0 1)).map Vᗮ.starProjection,
      fun B hB => by
        rw [Measure.smul_apply, Measure.map_apply hqm hB, Measure.restrict_apply (hqm hB),
          smul_eq_mul]⟩
  -- the rectangle formula for bounded Borel `B`
  have hbdd : ∀ A B : Set (Euclid P), MeasurableSet A → MeasurableSet B → Bornology.IsBounded B →
      ν (V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B) = σ B * μHE[n] (A ∩ V) := by
    intro A B hA hB hBb
    -- `m = p_#(ν⌞q⁻¹ B)`, with `m(E) = ν(p⁻¹ E ∩ q⁻¹ B)` for Borel `E`
    obtain ⟨m, hmE⟩ : ∃ m : Measure (Euclid P), ∀ E, MeasurableSet E →
        m E = ν (V.starProjection ⁻¹' E ∩ Vᗮ.starProjection ⁻¹' B) :=
      ⟨(ν.restrict (Vᗮ.starProjection ⁻¹' B)).map V.starProjection, fun E hE => by
        rw [Measure.map_apply hpm hE, Measure.restrict_apply (hpm hE)]⟩
    -- `m` is carried by `V`, as `p y ∈ V`
    have hmV : m (V : Set (Euclid P))ᶜ = 0 := by
      rw [hmE _ (Submodule.closed_of_finiteDimensional V).measurableSet.compl]
      exact measure_mono_null (fun y hy => absurd (V.starProjection_apply_mem y) hy.1) measure_empty
    -- `m` is finite on compact sets, as compact sets are bounded
    have hmcpt : ∀ K : Set (Euclid P), IsCompact K → m K < ∞ := fun K hK => by
      rw [hmE K hK.isClosed.measurableSet]
      exact hbox K B hK.isBounded hBb
    -- `m` is invariant under the translations by `V`, as `ν` is
    have hminv : ∀ v ∈ V, ∀ E : Set (Euclid P), MeasurableSet E →
        m ((fun x => v + x) ⁻¹' E) = m E := by
      intro v hv E hE
      have hpre : V.starProjection ⁻¹' ((fun x => v + x) ⁻¹' E) ∩ Vᗮ.starProjection ⁻¹' B =
          (fun x => v + x) ⁻¹' (V.starProjection ⁻¹' E ∩ Vᗮ.starProjection ⁻¹' B) := by
        ext y
        simp only [mem_inter_iff, mem_preimage, hpv v hv, hqv v hv]
      rw [hmE _ (hE.preimage (measurable_const_add v)), hmE E hE, hpre,
        hinv v hv _ ((hpm hE).inter (hqm hB))]
    -- `m = c • Hⁿ⌞V`; evaluating at `B_1(0)` gives `c = σ(B)`
    obtain ⟨c, hc⟩ := Submission.cbr_ci_cp_prod_subspace_haar P n m V hn hmV hmcpt hminv
    have hball : ν (V.starProjection ⁻¹' ball 0 1 ∩ Vᗮ.starProjection ⁻¹' B) =
        unitBallVolume n * c := by
      rw [← hmE (ball 0 1) measurableSet_ball, hc, Measure.smul_apply,
        Measure.restrict_apply measurableSet_ball, hω, smul_eq_mul, mul_comm]
    have hσc : σ B = c := by
      rw [hσB B hB, Set.inter_comm, hball, ENNReal.inv_mul_cancel_left hω0 hωtop]
    rw [← hmE A hA, hc, Measure.smul_apply, Measure.restrict_apply hA, hσc, smul_eq_mul]
  refine ⟨σ, ?_, fun K hK => ?_, fun A B hA hB => ?_⟩
  · -- `σ` is carried by `Vᗮ`, as `q y ∈ Vᗮ`
    rw [hσB _ V.isClosed_orthogonal.measurableSet.compl,
      measure_mono_null (fun y hy => absurd (Vᗮ.starProjection_apply_mem y) hy.1) measure_empty,
      mul_zero]
  · -- `σ` is finite on compact sets, as compact sets are bounded and `ωₙ ≠ 0`
    rw [hσB K hK.isClosed.measurableSet, Set.inter_comm]
    exact ENNReal.mul_lt_top (ENNReal.inv_lt_top.2 (pos_iff_ne_zero.2 hω0))
      (hbox _ _ isBounded_ball hK.isBounded)
  · -- exhaust `B` by the bounded sets `B ∩ B_j(0)`, by continuity from below for `ν` and `σ`
    have hmono : Monotone fun j : ℕ => B ∩ ball (0 : Euclid P) j := fun i j hij =>
      inter_subset_inter_right _ (ball_subset_ball (Nat.cast_le.2 hij))
    have hU : ⋃ j : ℕ, B ∩ ball (0 : Euclid P) j = B := by
      rw [← inter_iUnion, iUnion_ball_nat, inter_univ]
    have hmono' : Monotone fun j : ℕ =>
        V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' (B ∩ ball (0 : Euclid P) j) :=
      fun i j hij => inter_subset_inter_right _ (preimage_mono (hmono hij))
    have hνU := hmono'.measure_iUnion (μ := ν)
    have hσU := hmono.measure_iUnion (μ := σ)
    rw [← inter_iUnion, ← preimage_iUnion, hU] at hνU
    rw [hU] at hσU
    rw [hνU, hσU, ENNReal.iSup_mul]
    exact iSup_congr fun j => hbdd A _ hA (hB.inter measurableSet_ball)
      (isBounded_ball.subset inter_subset_right)
/-- If `σ` is carried by `Vᗮ` and finite on compact sets, and `ν` has the rectangle values
`ν(p⁻¹(A) ∩ q⁻¹(B)) = σ(B) Hⁿ(A ∩ V)` for Borel `A`, `B` (`p`, `q` the orthogonal projections onto
the `n`-dimensional subspace `V` and onto `Vᗮ`), then `ν(A) = ∫_V σ({y : t + y ∈ A}) dHⁿ(t)`, i.e.
`ν` is the image of `(Hⁿ⌞V) ⊗ σ` under `(t, y) ↦ t + y` (used, via the closure theorem, in the
proof of Simon 7.2.4).  The rectangles form a π-system generating the Borel sets (`y = p y + q y`),
the image measure takes the same values on them because `σ` is carried by `Vᗮ`, and the rectangles
over the balls `B_{j+1}(0)` cover `ℝᴾ` and have finite `ν`-measure, so the two measures agree. -/
theorem Submission.cbr_ci_cp_prod_of_rectangles : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → σ (Vᗮ : Set (Euclid P))ᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) → (∀ A B : Set (Euclid P), MeasurableSet A → MeasurableSet B → ν (V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B) = σ B * μHE[n] (A ∩ (V : Set (Euclid P)))) → ∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n] := by
  intro P n ν σ V hn hσ hσfin hrect A hA
  -- `σ` is finite on compact sets, hence locally finite and σ-finite on `ℝᴾ`
  have : IsFiniteMeasureOnCompacts σ := ⟨hσfin⟩
  have hp : Measurable V.starProjection := V.starProjection.continuous.measurable
  have hq : Measurable Vᗮ.starProjection := Vᗮ.starProjection.continuous.measurable
  have hV : MeasurableSet (V : Set (Euclid P)) := V.closed_of_finiteDimensional.measurableSet
  -- the candidate `λ = s_#((Hⁿ⌞V) ⊗ σ)` with `s(t, y) = t + y`
  have hs : Measurable fun z : Euclid P × Euclid P => z.1 + z.2 := measurable_fst.add measurable_snd
  have hlam : ∀ A : Set (Euclid P), MeasurableSet A →
      ((μHE[n].restrict (V : Set (Euclid P))).prod σ).map (fun z => z.1 + z.2) A =
        ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n] := by
    intro A hA
    rw [Measure.map_apply hs hA, Measure.prod_apply (hs hA)]
    rfl
  rw [← hlam A hA]
  congr 1
  -- rectangles `p⁻¹(A) ∩ q⁻¹(B)` form a π-system generating the Borel σ-algebra
  let C : Set (Set (Euclid P)) := {S | ∃ A B : Set (Euclid P), MeasurableSet A ∧ MeasurableSet B ∧
    S = V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B}
  have hgen : (inferInstance : MeasurableSpace (Euclid P)) = MeasurableSpace.generateFrom C := by
    refine le_antisymm ?_ (MeasurableSpace.generateFrom_le ?_)
    · have hp' : Measurable[MeasurableSpace.generateFrom C] V.starProjection := fun A hA =>
        MeasurableSpace.measurableSet_generateFrom ⟨A, univ, hA, MeasurableSet.univ, by
          rw [preimage_univ, inter_univ]⟩
      have hq' : Measurable[MeasurableSpace.generateFrom C] Vᗮ.starProjection := fun B hB =>
        MeasurableSpace.measurableSet_generateFrom ⟨univ, B, MeasurableSet.univ, hB, by
          rw [preimage_univ, univ_inter]⟩
      have hid := @Measurable.add _ _ _ _ (MeasurableSpace.generateFrom C)
        (fun y => V.starProjection y) (fun y => Vᗮ.starProjection y) _ hp' hq'
      have hfun : ((fun y => V.starProjection y) + fun y => Vᗮ.starProjection y) = id :=
        funext V.starProjection_add_starProjection_orthogonal
      rw [hfun] at hid
      exact fun S hS => hid hS
    · rintro _ ⟨A, B, hA, hB, rfl⟩
      exact (hp hA).inter (hq hB)
  have hpi : IsPiSystem C := by
    rintro _ ⟨A, B, hA, hB, rfl⟩ _ ⟨A', B', hA', hB', rfl⟩ _
    exact ⟨A ∩ A', B ∩ B', hA.inter hA', hB.inter hB', by
      rw [preimage_inter, preimage_inter, inter_inter_inter_comm]⟩
  -- the rectangles `p⁻¹(B_{j+1}(0)) ∩ q⁻¹(B_{j+1}(0))` cover `ℝᴾ` and have finite `ν`-measure
  refine Measure.ext_of_generateFrom_of_iUnion C
    (fun j : ℕ => V.starProjection ⁻¹' ball 0 (j + 1) ∩ Vᗮ.starProjection ⁻¹' ball 0 (j + 1))
    hgen hpi ?_ ?_ ?_ ?_
  · refine eq_univ_of_forall fun y => mem_iUnion.2 ?_
    obtain ⟨j, hj⟩ := exists_nat_gt (max ‖V.starProjection y‖ ‖Vᗮ.starProjection y‖)
    exact ⟨j, mem_ball_zero_iff.2 ((le_max_left _ _).trans_lt (hj.trans (lt_add_one _))),
      mem_ball_zero_iff.2 ((le_max_right _ _).trans_lt (hj.trans (lt_add_one _)))⟩
  · exact fun j => ⟨_, _, measurableSet_ball, measurableSet_ball, rfl⟩
  · intro j
    rw [hrect _ _ measurableSet_ball measurableSet_ball, inter_comm,
      Submission.idtp_tdc_subspace_ball_measure P n V 0 (j + 1) hn V.zero_mem (by positivity)]
    exact ENNReal.mul_ne_top measure_ball_lt_top.ne
      (ENNReal.mul_ne_top (measure_ball_lt_top (μ := volume)).ne ENNReal.ofReal_ne_top)
  -- `ν` and `λ` agree on rectangles because `σ` is carried by `Vᗮ`
  · rintro _ ⟨A, B, hA, hB, rfl⟩
    rw [hrect A B hA hB, hlam _ ((hp hA).inter (hq hB))]
    have key : EqOn (fun t => σ ((fun y => t + y) ⁻¹'
        (V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B))) (A.indicator fun _ => σ B) V := by
      intro t ht
      have hsec : ∀ y ∈ (Vᗮ : Set (Euclid P)),
          V.starProjection (t + y) = t ∧ Vᗮ.starProjection (t + y) = y := by
        intro y hy
        refine ⟨?_, ?_⟩
        · rw [map_add, V.starProjection_eq_self_iff.mpr ht,
            V.starProjection_apply_eq_zero_iff.mpr hy, add_zero]
        · rw [map_add, V.starProjection_orthogonal_apply_eq_zero ht,
            Vᗮ.starProjection_eq_self_iff.mpr hy, zero_add]
      simp only
      rw [← measure_inter_conull hσ]
      by_cases htA : t ∈ A
      · rw [indicator_of_mem htA, ← measure_inter_conull (s := B) hσ]
        congr 1
        ext y
        simp only [mem_inter_iff, mem_preimage]
        constructor
        · rintro ⟨⟨-, hyB⟩, hy⟩
          rw [(hsec y hy).2] at hyB
          exact ⟨hyB, hy⟩
        · rintro ⟨hyB, hy⟩
          rw [(hsec y hy).1, (hsec y hy).2]
          exact ⟨⟨htA, hyB⟩, hy⟩
      · rw [indicator_of_notMem htA]
        convert measure_empty (μ := σ)
        ext y
        simp only [mem_inter_iff, mem_preimage, mem_empty_iff_false, iff_false]
        rintro ⟨⟨hyA, -⟩, hy⟩
        exact htA ((hsec y hy).1 ▸ hyA)
    rw [setLIntegral_congr_fun hV key, lintegral_indicator_const hA, Measure.restrict_apply hA]

/-- A measure `ν` on `ℝᴾ`, finite on compact sets and invariant under the translations by an
`n`-dimensional linear subspace `V`, is the image of `(Hⁿ⌞V) ⊗ σ` under `(t, y) ↦ t + y` for a
measure `σ` carried by `V^⊥` and finite on compact sets (used for the product structure of
translation invariant measures in the integer multiplicity part of Simon 7.2.4, Remark
7.2.5(1)).  With `p = V.starProjection` and `q = Vᗮ.starProjection`, uniqueness of Haar measure
on `V` gives such a `σ` with `ν(p⁻¹(A) ∩ q⁻¹(B)) = σ(B)·Hⁿ(A ∩ V)` for Borel `A`, `B`; the image
of `(Hⁿ⌞V) ⊗ σ` under addition has the same values on these rectangles, which form a generating
π-system covered by countably many rectangles of finite measure, so it equals `ν`. -/
theorem Submission.cbr_ci_cp_invariant_measure_product : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => v + x) ⁻¹' A) = ν A) → ∃ σ : Measure (Euclid P), σ (Vᗮ : Set (Euclid P))ᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) ∧ ∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n] := by
  intro P n ν V hn hcpt hinv
  -- the transverse measure `σ` on `V^⊥` and the rectangle formula (Haar uniqueness on `V`)
  obtain ⟨σ, hσV, hσcpt, hrect⟩ :=
    Submission.cbr_ci_cp_prod_rectangle_formula P n ν V hn hcpt hinv
  -- `ν` agrees with the image of `(Hⁿ⌞V) ⊗ σ` on rectangles, hence on all Borel sets
  exact ⟨σ, hσV, hσcpt, Submission.cbr_ci_cp_prod_of_rectangles P n ν σ V hn hσV hσcpt hrect⟩

/-- `ν(B_r(x)) ≤ ωₙrⁿ σ(B_r(x − p_V x))` when `ν(A) = ∫_V σ({y : t + y ∈ A}) dHⁿ(t)` for a
subspace `V` with `dim V = n` and a measure `σ` carried by `Vᗮ`.  Write `x = p₀ + q₀` with
`p₀ = p_V x ∈ V` and `q₀ = x − p_V x ∈ Vᗮ`.  For `t ∈ V` and `z ∈ Vᗮ`, Pythagoras gives
`|t + z − x|² = |t − p₀|² + |z − q₀|²`, so `t + z ∈ B_r(x)` forces `t ∈ B_r(p₀)` and
`z ∈ B_r(q₀)`.  Hence `σ({y : t + y ∈ B_r(x)}) ≤ 1_{B_r(p₀)}(t) σ(B_r(q₀))`, and integrating over
`V` gives `ν(B_r(x)) ≤ σ(B_r(q₀)) Hⁿ(V ∩ B_r(p₀)) = ωₙrⁿ σ(B_r(q₀))`. -/
theorem Submission.cbr_ci_cp_atm_ball_le_transversal_ball : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → σ (Vᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]) → ∀ (x : Euclid P) (r : ℝ), 0 < r → ν (ball x r) ≤ unitBallVolume n * ENNReal.ofReal (r ^ n) * σ (ball (x - V.starProjection x) r) := by
  intro P n ν σ V hn hσ hν x r hr
  -- `x = p₀ + q₀` with `p₀ = p_V x ∈ V` and `q₀ = x − p₀ ∈ Vᗮ`
  set p₀ := V.starProjection x
  have hp₀ : p₀ ∈ V := V.starProjection_apply_mem x
  have hq₀ : x - p₀ ∈ Vᗮ := V.sub_starProjection_mem_orthogonal x
  -- Pythagoras: for `t ∈ V` and `z ∈ Vᗮ`, `t + z ∈ B_r(x)` forces `t ∈ B_r(p₀)`, `z ∈ B_r(q₀)`
  have hpyth : ∀ t ∈ V, ∀ z ∈ Vᗮ, t + z ∈ ball x r →
      t ∈ ball p₀ r ∧ z ∈ ball (x - p₀) r := by
    intro t ht z hz htz
    have hpy := norm_add_sq_eq_norm_sq_add_norm_sq_real
      (V.inner_right_of_mem_orthogonal (V.sub_mem ht hp₀) (Vᗮ.sub_mem hz hq₀))
    rw [show t - p₀ + (z - (x - p₀)) = t + z - x by abel] at hpy
    simp only [mem_ball, dist_eq_norm] at htz ⊢
    have hlt : ‖t + z - x‖ * ‖t + z - x‖ < r * r := mul_self_lt_mul_self (norm_nonneg _) htz
    constructor
    · exact (mul_self_lt_mul_self_iff (norm_nonneg _) hr.le).2
        (by linarith [mul_self_nonneg ‖z - (x - p₀)‖])
    · exact (mul_self_lt_mul_self_iff (norm_nonneg _) hr.le).2
        (by linarith [mul_self_nonneg ‖t - p₀‖])
  -- `σ` is carried by `Vᗮ`, so `σ({y : t + y ∈ B_r(x)}) ≤ 1_{B_r(p₀)}(t) σ(B_r(q₀))` on `V`
  have hslice : ∀ t ∈ (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' ball x r) ≤
      (ball p₀ r).indicator (fun _ => σ (ball (x - p₀) r)) t := by
    intro t ht
    rw [← measure_inter_conull (s := (fun y => t + y) ⁻¹' ball x r) hσ]
    by_cases htp : t ∈ ball p₀ r
    · rw [indicator_of_mem htp]
      exact measure_mono fun z hz => (hpyth t ht z hz.2 hz.1).2
    · have hempty : (fun y => t + y) ⁻¹' ball x r ∩ (Vᗮ : Set (Euclid P)) = ∅ :=
        eq_empty_of_forall_notMem fun z hz => htp (hpyth t ht z hz.2 hz.1).1
      rw [indicator_of_notMem htp, hempty, measure_empty]
  -- integrate over `V` and use `Hⁿ(V ∩ B_r(p₀)) = ωₙrⁿ`
  calc ν (ball x r)
      = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' ball x r) ∂μHE[n] :=
        hν _ measurableSet_ball
    _ ≤ ∫⁻ t in (V : Set (Euclid P)),
          (ball p₀ r).indicator (fun _ => σ (ball (x - p₀) r)) t ∂μHE[n] :=
        setLIntegral_mono' V.closed_of_finiteDimensional.measurableSet hslice
    _ = σ (ball (x - p₀) r) * μHE[n] ((V : Set (Euclid P)) ∩ ball p₀ r) := by
        rw [lintegral_indicator_const measurableSet_ball, Measure.restrict_apply measurableSet_ball,
          inter_comm]
    _ = unitBallVolume n * ENNReal.ofReal (r ^ n) * σ (ball (x - p₀) r) := by
        rw [Submission.idtp_tdc_subspace_ball_measure P n V p₀ r hn hp₀ hr, mul_comm]
/-- If `σ` is finite on compact sets and `f(r) ≤ ωₙrⁿσ(B_r(z))` for every `r > 0`, then
`liminf_{r↓0} f(r)/(ωₙrⁿ) ≤ σ({z})` (used in the closure step of the proof of Simon 7.2.4,
p. 184, to show that the transversal measure of a measure invariant along a plane is atomic).
For `r > 0`, `f(r)/(ωₙrⁿ) ≤ σ(B_r(z))` in `[0, ∞]`; and `σ(B_r(z)) → σ({z})` as `r ↓ 0` by
continuity from above, the balls decreasing to `{z}` and `σ(B_1(z)) ≤ σ(B̄_1(z)) < ∞`. -/
theorem Submission.cbr_ci_cp_atm_liminf_density_le_atom : ∀ (P n : ℕ) (σ : Measure (Euclid P)) (z : Euclid P) (f : ℝ → ℝ≥0∞), (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) → (∀ r : ℝ, 0 < r → f r ≤ unitBallVolume n * ENNReal.ofReal (r ^ n) * σ (ball z r)) → liminf (fun r : ℝ => f r / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) ≤ σ {z} := by
  intro P n σ z f hσ hf
  -- the balls `B_r(z)` decrease to `{z}` as `r ↓ 0`
  have hinter : (⋂ r > (0 : ℝ), ball z r) = {z} := by
    ext y
    simp only [mem_iInter, mem_ball, mem_singleton_iff]
    refine ⟨fun hy => ?_, fun hy r hr => by rwa [hy, dist_self]⟩
    by_contra hne
    exact lt_irrefl _ (hy (dist y z) (dist_pos.2 hne))
  -- continuity from above, with `σ(B_1(z)) ≤ σ(B̄_1(z)) < ∞`
  have hlim : Tendsto (fun r : ℝ => σ (ball z r)) (𝓝[>] 0) (𝓝 (σ {z})) := by
    rw [← hinter]
    exact tendsto_measure_biInter_gt (fun r _ => measurableSet_ball.nullMeasurableSet)
      (fun i j _ hij => ball_subset_ball hij)
      ⟨1, one_pos, ((measure_mono ball_subset_closedBall).trans_lt
        (hσ _ (isCompact_closedBall z 1))).ne⟩
  -- `f(r)/(ωₙrⁿ) ≤ σ(B_r(z))` for `r > 0`, then monotonicity of `liminf`
  calc liminf (fun r : ℝ => f r / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0)
      ≤ liminf (fun r : ℝ => σ (ball z r)) (𝓝[>] 0) :=
        liminf_le_liminf (eventually_mem_nhdsWithin.mono fun r hr =>
          ENNReal.div_le_of_le_mul' (hf r hr))
    _ = σ {z} := hlim.liminf_eq
/-- If `ν(A) = ∫_V σ(A − t) dHⁿ(t)` for Borel `A`, where `V` is an `n`-dimensional subspace of
`ℝᴾ` and `σ` is carried by `Vᗮ`, and `x − p_V x ∈ Z` for `ν`-a.e. `x` with `Z` Borel, then
`σ(ℝᴾ ∖ Z) = 0` (used for the translation-invariant blow-up measures in B. White's proof of the
closure theorem, part of Simon 7.2.4).  The Borel set `E = {y : y − p_V y ∉ Z}` is `ν`-null and
invariant under translation by `V`, so `0 = ν(E) = σ(E) Hⁿ(V)`;
`Hⁿ(V) ≥ Hⁿ(V ∩ B_1(0)) = ωₙ > 0` gives `σ(E) = 0`, and `ℝᴾ ∖ Z ⊆ E ∪ (ℝᴾ ∖ Vᗮ)` because
`p_V w = 0` for `w ∈ Vᗮ`. -/
theorem Submission.cbr_ci_cp_atm_transversal_carried : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (Z : Set (Euclid P)), Module.finrank ℝ V = n → σ (Vᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]) → MeasurableSet Z → (∀ᵐ x ∂ν, x - V.starProjection x ∈ Z) → σ Zᶜ = 0 := by
  intro P n ν σ V Z hn hσ hD hZ hae
  -- `E = {y : y − p_V y ∉ Z}` is Borel and `ν`-null
  set E : Set (Euclid P) := (fun y => y - V.starProjection y) ⁻¹' Zᶜ with hE_def
  have hE : MeasurableSet E := (continuous_id.sub V.starProjection.continuous).measurable hZ.compl
  have hνE : ν E = 0 := ae_iff.mp hae
  -- `p_V (t + y) = t + p_V y` for `t ∈ V`, so `E` is invariant under translation by `V`
  -- and the product formula gives `ν(E) = σ(E) Hⁿ(V)`
  have hprod : ν E = σ E * μHE[n] (V : Set (Euclid P)) := by
    rw [hD E hE, ← setLIntegral_const]
    refine setLIntegral_congr_fun V.closed_of_finiteDimensional.measurableSet fun t ht => ?_
    congr 1
    ext y
    simp [hE_def, Submodule.starProjection_eq_self_iff.mpr ht]
  -- `Hⁿ(V) ≥ Hⁿ(V ∩ B_1(0)) = ωₙ > 0`
  have hV : μHE[n] (V : Set (Euclid P)) ≠ 0 := by
    have hball := Submission.idtp_tdc_subspace_ball_measure P n V 0 1 hn V.zero_mem one_pos
    rw [one_pow, ENNReal.ofReal_one, mul_one] at hball
    have hω : 0 < unitBallVolume n := measure_ball_pos volume (0 : Euclid n) one_pos
    refine (hω.trans_le ?_).ne'
    rw [← hball]
    exact measure_mono Set.inter_subset_left
  have hσE : σ E = 0 := by
    rw [hνE, eq_comm, mul_eq_zero] at hprod
    exact hprod.resolve_right hV
  -- `ℝᴾ ∖ Z ⊆ E ∪ (ℝᴾ ∖ Vᗮ)`, since `p_V w = 0` for `w ∈ Vᗮ`
  refine measure_mono_null (fun w hw => ?_) (measure_union_null hσE hσ)
  by_cases hw' : w ∈ Vᗮ
  · left
    show w - V.starProjection w ∈ Zᶜ
    rwa [(V.starProjection_apply_eq_zero_iff).mpr hw', sub_zero]
  · exact Or.inr hw'
/-- A measure `ν` on `ℝᴾ` with `ν(A) = ∫⁻_{t ∈ V} σ({y : t + y ∈ A}) dHⁿ(t)` for Borel `A`, whose
transversal measure `σ` is carried by a countable set `Z`, is the countable sum of weighted parallel
planes `ν = Σ_{w ∈ Z} σ({w}) Hⁿ⌞(w + V)` (a step of the proof of Simon 7.2.4, for cycles with a
constant orientation).  `σ` is the sum of its atoms on `Z`; inserting this into the product
formula, monotone convergence exchanges sum and integral, and the translation by `w` is an isometry
carrying `{t : t + w ∈ A} ∩ V` onto `A ∩ (w + V)`, under which `Hⁿ` is invariant. -/
theorem Submission.cbr_ci_cp_atm_sum_planes_of_carried : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (Z : Set (Euclid P)), Z.Countable → σ Zᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]) → ν = Measure.sum (fun w : Z => σ {(w : Euclid P)} • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) := by
  intro P n ν σ V Z hZ hσ hν
  have := hZ.to_subtype
  -- `σ` is carried by the countable set `Z`, hence is the sum of its atoms there
  have hatom : ∀ S : Set (Euclid P), MeasurableSet S →
      σ S = ∑' w : Z, S.indicator (fun x => σ {x}) (w : Euclid P) := by
    intro S hS
    have hSZ : S ∩ Z = ⋃ w : Z, S ∩ {(w : Euclid P)} := by
      ext y
      simp
    rw [← measure_inter_conull hσ, hSZ, measure_iUnion]
    · congr 1
      ext w
      by_cases hw : (w : Euclid P) ∈ S
      · simp [hw]
      · simp [hw]
    · intro w w' hww'
      exact Disjoint.mono inter_subset_right inter_subset_right
        (disjoint_singleton.2 (Subtype.coe_injective.ne hww'))
    · exact fun w => hS.inter (measurableSet_singleton _)
  ext A hA
  rw [hν A hA, Measure.sum_apply _ hA]
  calc ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]
      = ∫⁻ t in (V : Set (Euclid P)), ∑' w : Z,
          ((fun t => t + (w : Euclid P)) ⁻¹' A).indicator (fun _ => σ {(w : Euclid P)}) t ∂μHE[n] := by
        refine lintegral_congr fun t => ?_
        rw [hatom _ (measurable_const_add t hA)]
        refine tsum_congr fun w => ?_
        by_cases hw : t + (w : Euclid P) ∈ A
        · rw [indicator_of_mem (show (w : Euclid P) ∈ (fun y => t + y) ⁻¹' A from hw),
            indicator_of_mem (show t ∈ (fun t => t + (w : Euclid P)) ⁻¹' A from hw)]
        · rw [indicator_of_notMem (show (w : Euclid P) ∉ (fun y => t + y) ⁻¹' A from hw),
            indicator_of_notMem (show t ∉ (fun t => t + (w : Euclid P)) ⁻¹' A from hw)]
    -- monotone convergence for the countable sum, then integrate the indicators
    _ = ∑' w : Z, σ {(w : Euclid P)} *
          (μHE[n]).restrict (V : Set (Euclid P)) ((fun t => t + (w : Euclid P)) ⁻¹' A) := by
        rw [lintegral_tsum fun w : Z => (measurable_const.indicator
          (measurable_add_const (w : Euclid P) hA)).aemeasurable]
        simp only [lintegral_indicator_const (measurable_add_const _ hA)]
    _ = ∑' w : Z, (σ {(w : Euclid P)} • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) A := by
        congr 1
        ext w
        rw [Measure.restrict_apply (measurable_add_const _ hA), Measure.smul_apply, smul_eq_mul,
          Measure.restrict_apply hA]
        congr 1
        -- the translation by `w` is an isometry carrying `{t : t + w ∈ A} ∩ V` onto `A ∩ (w + V)`
        have hpre : (fun t => t + (w : Euclid P)) ⁻¹' (A ∩ {y : Euclid P | y - w ∈ V}) =
            (fun t => t + (w : Euclid P)) ⁻¹' A ∩ V := by
          ext t
          simp
        rw [← hpre, (isometry_add_right (w : Euclid P)).euclideanHausdorffMeasure_preimage,
          (add_right_surjective (w : Euclid P)).range_eq, inter_univ]

/-- **A transversal measure with lower density `≥ c` is atomic** (B. White's tangent-plane proof of
the closure theorem used for Simon 7.2.4: a cycle with constant orientation is a sum of parallel
planes).  Let `V ⊆ ℝᴾ` be an `n`-dimensional subspace, `σ` a measure carried by `Vᗮ` and finite on
compact sets, and `ν(A) = ∫_V σ({y : t + y ∈ A}) dHⁿ(t)` for Borel `A`.  If
`ofReal c ≤ liminf_{r ↓ 0} ν(B_r(y))/(ωₙrⁿ)` for `ν`-a.e. `y`, then
`ν = Σ_{w ∈ Z} σ({w}) Hⁿ⌞(w + V)` for the set `Z ⊆ Vᗮ` of atoms of `σ` of mass `≥ c`.
`Z ∩ B̄_j(0)` is finite, since infinitely many atoms of mass `≥ c` have infinite `σ`-measure while
`σ(B̄_j(0)) < ∞`; so `Z` is countable.  For `x ∈ ℝᴾ`, `ν(B_r(x)) ≤ ωₙrⁿσ(B_r(x − p x))`
(`p` the projection onto `V`), so the lower density of `ν` at `x` is at most `σ({x − p x})`;
hence `x − p x ∈ Z` for `ν`-a.e. `x`, `σ` is carried by `Z`, and `ν` is the sum of the planes. -/
theorem Submission.cbr_ci_cp_atomic_transversal : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (c : ℝ), 0 < c → Module.finrank ℝ V = n → σ (Vᗮ : Set (Euclid P))ᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) → (∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]) → (∀ᵐ y ∂ν, ENNReal.ofReal c ≤ liminf (fun r : ℝ => ν (ball y r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0)) → ∃ Z : Set (Euclid P), Z.Countable ∧ Z ⊆ (Vᗮ : Set (Euclid P)) ∧ (∀ w ∈ Z, ENNReal.ofReal c ≤ σ {w}) ∧ ν = Measure.sum (fun w : Z => σ {(w : Euclid P)} • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) := by
  intro P n ν σ V c hc hn hσV hσK hD hdens
  -- `Z`: the atoms of `σ` in `Vᗮ` of mass at least `c`
  set Z : Set (Euclid P) := {w | w ∈ (Vᗮ : Set (Euclid P)) ∧ ENNReal.ofReal c ≤ σ {w}}
  -- `Z ∩ B̄_j(0)` is finite: infinitely many atoms of mass `≥ c` would have infinite measure
  have hZc : Z.Countable := by
    rw [← iUnion_inter_closedBall_nat Z (0 : Euclid P)]
    refine countable_iUnion fun j => Set.Finite.countable ?_
    by_contra hinf
    have hlt : σ (Z ∩ closedBall (0 : Euclid P) j) < ∞ :=
      (measure_mono inter_subset_right).trans_lt (hσK _ (isCompact_closedBall _ _))
    exact hlt.ne (Set.Infinite.meas_eq_top hinf
      ⟨ENNReal.ofReal c, (ENNReal.ofReal_pos.2 hc).ne', fun w hw => hw.1.2⟩)
  -- `ν`-a.e. `x`: the density bound and `ν(B_r(x)) ≤ ωₙrⁿσ(B_r(x − p x))` give `x − p x ∈ Z`
  have hae : ∀ᵐ x ∂ν, x - V.starProjection x ∈ Z := by
    filter_upwards [hdens] with x hx
    exact ⟨V.sub_starProjection_mem_orthogonal x, hx.trans
      (Submission.cbr_ci_cp_atm_liminf_density_le_atom P n σ (x - V.starProjection x)
        (fun r => ν (ball x r)) hσK
        (Submission.cbr_ci_cp_atm_ball_le_transversal_ball P n ν σ V hn hσV hD x))⟩
  -- `σ` is carried by the countable set `Z`, so `ν` is the sum of the planes `w + V`, `w ∈ Z`
  have hσZ : σ Zᶜ = 0 :=
    Submission.cbr_ci_cp_atm_transversal_carried P n ν σ V Z hn hσV hD hZc.measurableSet hae
  exact ⟨Z, hZc, fun w hw => hw.1, fun w hw => hw.2,
    Submission.cbr_ci_cp_atm_sum_planes_of_carried P n ν σ V Z hZc hσZ hD⟩

/-- `Hⁿ({y : y - w ∈ V} ∩ B_R(0)) = ωₙ(√(R² - ‖w‖²))ⁿ` for an `n`-dimensional linear subspace `V`
of `ℝᴾ`, an offset `w ∈ V^⊥` and `‖w‖ < R` (a plane in a ball, used in the proof of Simon 7.2.4,
p. 184, for measures carried by finitely many parallel `n`-planes).  Put `ρ = √(R² - ‖w‖²) > 0`.
By Pythagoras `‖t + w‖² = ‖t‖² + ‖w‖²` for `t ∈ V`, so the translation `t ↦ t + w`, an isometry,
maps `V ∩ B_ρ(0)` onto the set; isometry invariance of `μHE[n]` and the subspace-ball formula
`Hⁿ(V ∩ B_ρ(0)) = ωₙρⁿ` conclude. -/
theorem Submission.cbr_ci_cp_fp_offset_plane_ball_measure : ∀ (P n : ℕ) (V : Submodule ℝ (Euclid P)) (w : Euclid P) (R : ℝ), Module.finrank ℝ V = n → w ∈ Vᗮ → ‖w‖ < R → μHE[n] ({y : Euclid P | y - w ∈ V} ∩ ball 0 R) = unitBallVolume n * ENNReal.ofReal (Real.sqrt (R ^ 2 - ‖w‖ ^ 2) ^ n) := by
  intro P n V w R hn hw hR
  -- the radius `ρ = √(R² - ‖w‖²)` is positive and `ρ² = R² - ‖w‖²`
  have hpos : 0 < R ^ 2 - ‖w‖ ^ 2 := by nlinarith [norm_nonneg w]
  have hρ : 0 < Real.sqrt (R ^ 2 - ‖w‖ ^ 2) := Real.sqrt_pos.2 hpos
  have hρsq : Real.sqrt (R ^ 2 - ‖w‖ ^ 2) ^ 2 = R ^ 2 - ‖w‖ ^ 2 := Real.sq_sqrt hpos.le
  -- Pythagoras: `‖t + w‖² = ‖t‖² + ‖w‖²` for `t ∈ V`, as `w ⊥ V`
  have hpyth : ∀ t ∈ V, ‖t + w‖ ^ 2 = ‖t‖ ^ 2 + ‖w‖ ^ 2 := fun t ht => by
    rw [sq, sq, sq]
    exact norm_add_sq_eq_norm_sq_add_norm_sq_real (Submodule.inner_right_of_mem_orthogonal ht hw)
  -- the translation `t ↦ t + w` maps `V ∩ B_ρ(0)` onto `{y | y - w ∈ V} ∩ B_R(0)`
  have himage : (fun t => t + w) '' ((V : Set (Euclid P)) ∩ ball 0 (Real.sqrt (R ^ 2 - ‖w‖ ^ 2))) =
      {y : Euclid P | y - w ∈ V} ∩ ball 0 R := by
    ext y
    simp only [Set.mem_image, Set.mem_inter_iff, SetLike.mem_coe, mem_ball_zero_iff,
      Set.mem_ofPred_eq]
    constructor
    · rintro ⟨t, ⟨ht, htρ⟩, rfl⟩
      refine ⟨by simpa using ht, ?_⟩
      have h := hpyth t ht
      nlinarith [norm_nonneg t, norm_nonneg w, norm_nonneg (t + w)]
    · rintro ⟨hy, hyR⟩
      refine ⟨y - w, ⟨hy, ?_⟩, sub_add_cancel y w⟩
      have h := hpyth (y - w) hy
      rw [sub_add_cancel] at h
      nlinarith [norm_nonneg (y - w), norm_nonneg y]
  -- isometry invariance of `μHE[n]`, then the subspace-ball formula with centre `0 ∈ V`
  rw [← himage, (isometry_add_right w).euclideanHausdorffMeasure_image]
  exact Submission.idtp_tdc_subspace_ball_measure P n V 0 _ hn V.zero_mem hρ

/-- Weighted parallel `n`-planes with at most Euclidean volume growth have total weight `≤ 1`.
Let `V ⊆ ℝᴾ` be an `n`-dimensional subspace, `Z ⊆ V^⊥` and `a : ℝᴾ → [0, ∞]`.  If
`ν = Σ_{w ∈ Z} a(w) Hⁿ⌞{y : y − w ∈ V}` satisfies `ν(B_R(0)) ≤ ωₙRⁿ` for every `R > 0`, then
`Σ_{w ∈ Z} a(w) ≤ 1`.  For a finite set `s` of offsets put `M = Σ_{z ∈ s} ‖z‖` and let `R > M`.
Each plane `z + V` meets `B_R(0)` in an `n`-ball of radius `√(R² − ‖z‖²) ≥ R − M`, so
`ωₙ(R − M)ⁿ Σ_{z ∈ s} a(z) ≤ ν(B_R(0)) ≤ ωₙRⁿ`, i.e. `Σ_{z ∈ s} a(z) ≤ (R / (R − M))ⁿ`; let
`R → ∞`. -/
theorem Submission.cbr_ci_cp_fp_tsum_weight_le_one : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (Z : Set (Euclid P)) (a : Euclid P → ℝ≥0∞), Module.finrank ℝ V = n → Z ⊆ (Vᗮ : Set (Euclid P)) → ν = Measure.sum (fun w : Z => a w • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) → (∀ R : ℝ, 0 < R → ν (ball 0 R) ≤ unitBallVolume n * ENNReal.ofReal (R ^ n)) → ∑' w : Z, a w ≤ 1 := by
  intro P n ν V Z a hn hZ hν hνR
  -- `0 < ωₙ < ∞`
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  -- `ν(B_R(0)) = Σ_{z ∈ Z} a(z) Hⁿ({y : y − z ∈ V} ∩ B_R(0))`
  have hball : ∀ R : ℝ, ν (ball 0 R) =
      ∑' z : Z, a z * μHE[n] ({y : Euclid P | y - z ∈ V} ∩ ball 0 R) := by
    intro R
    rw [hν, Measure.sum_apply _ measurableSet_ball]
    refine tsum_congr fun z => ?_
    rw [Measure.smul_apply, smul_eq_mul, Measure.restrict_apply measurableSet_ball, inter_comm]
  -- it suffices to bound every finite partial sum; `M` bounds the offsets in `s`
  refine ENNReal.summable.tsum_le_of_sum_le fun s => ?_
  obtain ⟨M, hM, hzM⟩ : ∃ M : ℝ, 0 ≤ M ∧ ∀ z ∈ s, ‖(z : Euclid P)‖ ≤ M :=
    ⟨∑ z ∈ s, ‖(z : Euclid P)‖, Finset.sum_nonneg fun _ _ => norm_nonneg _, fun z hz =>
      Finset.single_le_sum (f := fun z : Z => ‖(z : Euclid P)‖) (fun _ _ => norm_nonneg _) hz⟩
  -- for `R > M`: `Σ_{z ∈ s} a(z) ≤ (R / (R − M))ⁿ`
  have key : ∀ R : ℝ, M < R → ∑ z ∈ s, a z ≤ ENNReal.ofReal ((R / (R - M)) ^ n) := by
    intro R hR
    have hRM : 0 < R - M := sub_pos.mpr hR
    -- each plane meets `B_R(0)` in an `n`-ball of radius `√(R² − ‖z‖²) ≥ R − M`
    have hplane : ∀ z ∈ s, unitBallVolume n * ENNReal.ofReal ((R - M) ^ n) ≤
        μHE[n] ({y : Euclid P | y - z ∈ V} ∩ ball 0 R) := by
      intro z hz
      have hzR := hzM z hz
      have hr : R - M ≤ Real.sqrt (R ^ 2 - ‖(z : Euclid P)‖ ^ 2) := by
        refine Real.le_sqrt_of_sq_le ?_
        nlinarith [mul_nonneg hRM.le hM, mul_nonneg (sub_nonneg.mpr hzR) hM,
          mul_nonneg (sub_nonneg.mpr hzR) (norm_nonneg (z : Euclid P))]
      rw [Submission.cbr_ci_cp_fp_offset_plane_ball_measure P n V z R hn (hZ z.2)
        (hzR.trans_lt hR)]
      gcongr
    have hsum : unitBallVolume n * ((∑ z ∈ s, a z) * ENNReal.ofReal ((R - M) ^ n)) ≤
        unitBallVolume n * ENNReal.ofReal (R ^ n) :=
      calc unitBallVolume n * ((∑ z ∈ s, a z) * ENNReal.ofReal ((R - M) ^ n))
          = ∑ z ∈ s, a z * (unitBallVolume n * ENNReal.ofReal ((R - M) ^ n)) := by
            rw [Finset.sum_mul, Finset.mul_sum]
            exact Finset.sum_congr rfl fun z _ => mul_left_comm _ _ _
        _ ≤ ∑ z ∈ s, a z * μHE[n] ({y : Euclid P | y - z ∈ V} ∩ ball 0 R) := by
            gcongr with z hz
            exact hplane z hz
        _ ≤ ∑' z : Z, a z * μHE[n] ({y : Euclid P | y - z ∈ V} ∩ ball 0 R) :=
            ENNReal.sum_le_tsum s
        _ = ν (ball 0 R) := (hball R).symm
        _ ≤ unitBallVolume n * ENNReal.ofReal (R ^ n) := hνR R (hM.trans_lt hR)
    have hpow : 0 < (R - M) ^ n := pow_pos hRM n
    rwa [ENNReal.mul_le_mul_iff_right hω0 hωtop,
      ← ENNReal.le_div_iff_mul_le (Or.inl (ENNReal.ofReal_pos.mpr hpow).ne')
        (Or.inl ENNReal.ofReal_ne_top), ← ENNReal.ofReal_div_of_pos hpow, ← div_pow] at hsum
  -- `(R / (R − M))ⁿ → 1` as `R → ∞`
  have hlim : Tendsto (fun R : ℝ => ENNReal.ofReal ((R / (R - M)) ^ n)) atTop (𝓝 1) := by
    have hsub : Tendsto (fun R : ℝ => R - M) atTop atTop :=
      tendsto_atTop_atTop.2 fun b => ⟨b + M, fun R hR => by linarith⟩
    have h1 : Tendsto (fun R : ℝ => 1 + M / (R - M)) atTop (𝓝 1) := by
      simpa using tendsto_const_nhds.add (tendsto_const_nhds.div_atTop hsub)
    have h2 : Tendsto (fun R : ℝ => R / (R - M)) atTop (𝓝 1) :=
      h1.congr' ((eventually_gt_atTop M).mono fun R hR => by
        rw [← same_add_div (sub_pos.mpr hR).ne', sub_add_cancel])
    simpa using ENNReal.tendsto_ofReal (h2.pow n)
  exact ge_of_tendsto hlim ((eventually_gt_atTop M).mono key)
/-- A finite sum `ν = ∑ᵢ (αᵢ)₊ Hⁿ⌞(wᵢ + V)` of planes parallel to `V`, with offsets `wᵢ ∈ Vᗮ`,
that charges every ball `B_r(0)` has a plane through `0`: some `wᵢ = 0` (used in the proof that
the limit in Simon 7.2.4 is integer multiplicity, Remark 7.2.5(1)).  Otherwise pick
`0 < r < ‖wᵢ‖` for all `i`; for `y ∈ wᵢ + V`, Pythagoras gives `‖y‖² = ‖y - wᵢ‖² + ‖wᵢ‖² > r²`,
so every plane misses `B_r(0)` and `ν(B_r(0)) = 0`. -/
theorem Submission.cbr_ci_cp_fp_exists_offset_eq_zero : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (N : ℕ) (w : Fin N → Euclid P) (α : Fin N → ℝ), (∀ i, w i ∈ Vᗮ) → ν = ∑ i, ENNReal.ofReal (α i) • (μHE[n]).restrict {y : Euclid P | y - w i ∈ V} → (∀ r : ℝ, 0 < r → 0 < ν (ball 0 r)) → ∃ i, w i = 0 := by
  intro P n ν V N w α hw hν hpos
  by_contra hne
  -- a radius `0 < r < ‖w i‖` for each of the finitely many offsets `w i ≠ 0`
  obtain ⟨r, hr, hrw⟩ : ∃ r : ℝ, 0 < r ∧ ∀ i, r < ‖w i‖ :=
    ((eventually_mem_nhdsWithin : ∀ᶠ r in 𝓝[>] (0 : ℝ), r ∈ Ioi 0).and
      (eventually_all.2 fun i => nhdsWithin_le_nhds
        (eventually_lt_nhds (norm_pos_iff.2 fun hi => hne ⟨i, hi⟩)))).exists
  -- by Pythagoras (`w i ∈ Vᗮ`), every plane `{y | y - w i ∈ V}` misses `B_r(0)`
  have hmiss : ∀ i, ball (0 : Euclid P) r ∩ {y : Euclid P | y - w i ∈ V} = ∅ := by
    intro i
    refine eq_empty_iff_forall_notMem.2 fun y ⟨hy, ht⟩ => ?_
    rw [mem_ball_zero_iff] at hy
    have hpyth := norm_add_sq_eq_norm_sq_add_norm_sq_real
      (Submodule.inner_right_of_mem_orthogonal (show y - w i ∈ V from ht) (hw i))
    rw [sub_add_cancel] at hpyth
    have hlt : ‖y‖ < ‖w i‖ := hy.trans (hrw i)
    nlinarith [norm_nonneg y, mul_self_nonneg ‖y - w i‖]
  -- hence `ν(B_r(0)) = 0`, contradicting the positivity hypothesis
  have hzero : ν (ball 0 r) = 0 := by
    rw [hν, Measure.finsetSum_apply]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [Measure.smul_apply, Measure.restrict_apply measurableSet_ball, hmiss i, measure_empty,
      smul_zero]
  exact (hpos r hr).ne' hzero

/-- Let `ν = Σ_{w ∈ Z} a(w) Hⁿ⌞{y : y − w ∈ V}` be a sum of parallel translates of the `n`-plane
`V`, with offsets `Z ⊆ V^⊥` and weights `a(w) ≥ c > 0`.  If `ν(B_R(0)) ≤ ωₙRⁿ` for all `R > 0`
and `ν(B_r(0)) > 0` for all `r > 0`, then `ν = Σᵢ αᵢ Hⁿ⌞{y : y − wᵢ ∈ V}` for finitely many
distinct `wᵢ ∈ V^⊥` and `αᵢ ≥ c` with `Σᵢ αᵢ ≤ 1` and some `wᵢ = 0` (the constant-plane step
of the closure argument for Simon 7.2.4).  The growth bound gives `Σ_{w ∈ Z} a(w) ≤ 1`, so `Z`
is finite; enumerating `Z` gives the finite sum, and positivity near `0` forces a plane through
`0`. -/
theorem Submission.cbr_ci_cp_finite_parallel_planes : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (Z : Set (Euclid P)) (a : Euclid P → ℝ≥0∞) (c : ℝ), 0 < c → Module.finrank ℝ V = n → Z ⊆ (Vᗮ : Set (Euclid P)) → (∀ w ∈ Z, ENNReal.ofReal c ≤ a w) → ν = Measure.sum (fun w : Z => a w • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) → (∀ R : ℝ, 0 < R → ν (ball 0 R) ≤ unitBallVolume n * ENNReal.ofReal (R ^ n)) → (∀ r : ℝ, 0 < r → 0 < ν (ball 0 r)) → ∃ (N : ℕ) (w : Fin N → Euclid P) (α : Fin N → ℝ), Injective w ∧ (∀ i, w i ∈ Vᗮ) ∧ (∀ i, c ≤ α i) ∧ ∑ i, α i ≤ 1 ∧ (∃ i, w i = 0) ∧ ν = ∑ i, ENNReal.ofReal (α i) • (μHE[n]).restrict {y : Euclid P | y - w i ∈ V} := by
  intro P n ν V Z a c hc hn hZ ha hν hgrowth hpos
  -- the total weight is at most `1`
  have htsum : ∑' w : Z, a w ≤ 1 :=
    Submission.cbr_ci_cp_fp_tsum_weight_le_one P n ν V Z a hn hZ hν hgrowth
  -- every weight is at least `ofReal c ≠ 0`, so `Z` is finite
  have hZfin : Finite Z := by
    by_contra hinf
    have : Infinite Z := not_finite_iff_infinite.1 hinf
    have hle : ∑' _ : Z, ENNReal.ofReal c ≤ ∑' w : Z, a w :=
      ENNReal.tsum_le_tsum fun w => ha w w.2
    rw [ENNReal.tsum_const_eq_top_of_ne_zero (ENNReal.ofReal_pos.2 hc).ne'] at hle
    exact ENNReal.one_ne_top (top_le_iff.1 (hle.trans htsum))
  have : Fintype Z := Fintype.ofFinite Z
  -- every weight is finite
  have hfin : ∀ w : Z, a w ≠ ∞ := fun w =>
    ne_top_of_le_ne_top ENNReal.one_ne_top ((ENNReal.le_tsum w).trans htsum)
  -- enumerate `Z` as `w₁, …, w_N` and put `αᵢ := a(wᵢ)`
  obtain ⟨e⟩ : Nonempty (Fin (Fintype.card Z) ≃ Z) := ⟨(Fintype.equivFin Z).symm⟩
  have hw : ∀ i, (e i : Euclid P) ∈ Vᗮ := fun i => hZ (e i).2
  have hνsum : ν = ∑ i, ENNReal.ofReal (a (e i)).toReal •
      (μHE[n]).restrict {y : Euclid P | y - (e i : Euclid P) ∈ V} := by
    rw [hν, Measure.sum_fintype, ← e.sum_comp]
    exact Finset.sum_congr rfl fun i _ => by rw [ENNReal.ofReal_toReal (hfin (e i))]
  refine ⟨Fintype.card Z, fun i => e i, fun i => (a (e i)).toReal,
    Subtype.val_injective.comp e.injective, hw,
    fun i => (ENNReal.ofReal_le_iff_le_toReal (hfin (e i))).1 (ha _ (e i).2), ?_,
    Submission.cbr_ci_cp_fp_exists_offset_eq_zero P n ν V (Fintype.card Z) (fun i => e i)
      (fun i => (a (e i)).toReal) hw hνsum hpos, hνsum⟩
  -- `Σᵢ αᵢ = (Σ_{w ∈ Z} a(w)).toReal ≤ 1`
  rw [tsum_fintype] at htsum
  rw [← ENNReal.toReal_sum fun i _ => hfin (e i), e.sum_comp (fun w : Z => a w)]
  exact (ENNReal.toReal_mono ENNReal.one_ne_top htsum).trans_eq ENNReal.toReal_one

/-- **A cycle with constant unit `n`-vector, Euclidean growth and positive lower density is a
finite sum of parallel `n`-planes** (White's tangent-plane argument for the closure theorem used in
Simon 7.2.4; B. White, Comment. Math. Helv. 64 (1989) 207–220).  Let `n = d + 1`, `ν` a locally
finite measure on `ℝᴾ` and `ζ₀` an `n`-vector with `|ζ₀(β)| ≤ |β|` and `ζ₀(β₁) = 1` for some
`|β₁| ≤ 1`, such that `C(ω) = ∫ ⟨ω, ζ₀⟩ dν` has `∂C = 0`, `ν(B_R(0)) ≤ ωₙRⁿ`, `0 ∈ spt ν` and
`liminf_{r↓0} ν(B_r(y))/(ωₙrⁿ) ≥ c > 0` for `ν`-a.e. `y`.  Then `ζ₀(β) = β(v)` for an orthonormal
`v = (v₁, …, vₙ)`, and `ν = Σᵢ αᵢ Hⁿ⌞(wᵢ + span v)` for finitely many distinct `wᵢ ⊥ span v`, one
of them `0`, with `αᵢ ≥ c` and `Σᵢ αᵢ ≤ 1`.  The cycle condition gives a subspace `V` (spanned by
the Riesz representatives of `w ↦ ζ₀(w♭ ∧ α)`) along which `ν` has vanishing directional
derivatives and such that `ζ₀(w♭ ∧ α) = 0` for `w ⊥ V` (`cbr_ci_cp_wedge_annihilator_subspace`);
so `ν` is invariant under translation by `V` (`cbr_ci_cp_translation_invariant_of_fderiv`) and
`ζ₀` only sees coordinates in `V` (`cbr_ci_cp_eval_comp_starProjection_eq`).  The growth bound,
with `ωₙ < ∞` and `ν(B_1(0)) > 0`, gives `dim V ≤ n` (`cbr_ci_cp_finrank_le_of_growth`), and the
normalisation of `ζ₀` then gives `dim V = n` and `ζ₀(β) = β(v)` for an orthonormal frame `v` of
`V` (`cbr_ci_cp_eval_eq_orthonormal_frame`).  Haar uniqueness on `V` gives `ν = Hⁿ⌞V ⊗ σ`
(`cbr_ci_cp_invariant_measure_product`), the lower density bound makes `σ` purely atomic with
atoms `≥ c` (`cbr_ci_cp_atomic_transversal`), and the growth bound and `0 ∈ spt ν` leave finitely
many planes of total weight `≤ 1`, one through `0` (`cbr_ci_cp_finite_parallel_planes`).  Finally
`span v = V`, and `⟨wᵢ, vⱼ⟩ = 0` as `wᵢ ∈ V^⊥` and `vⱼ ∈ V`. -/
theorem Submission.cbr_ci_constant_cycle_planes : ∀ (P d : ℕ) (ν : Measure (Euclid P)) (ζ₀ : MultiVector P (d + 1)) (c : ℝ), 0 < c → (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ β : Covector (Euclid P) (d + 1), |ζ₀ β| ≤ covectorEuclideanNorm β) → (∃ β : Covector (Euclid P) (d + 1), covectorEuclideanNorm β ≤ 1 ∧ ζ₀ β = 1) → (∀ φ : TestFormOn (univ : Set (Euclid P)) d, ∫ y, ζ₀ (exteriorDerivative (φ : DifferentialForm (Euclid P) d) y) ∂ν = 0) → (∀ R : ℝ, 0 < R → ν (ball 0 R) ≤ unitBallVolume (d + 1) * ENNReal.ofReal (R ^ (d + 1))) → (∀ r : ℝ, 0 < r → 0 < ν (ball 0 r)) → (∀ᵐ y ∂ν, ENNReal.ofReal c ≤ liminf (fun r : ℝ => ν (ball y r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0)) → ∃ (v : Fin (d + 1) → Euclid P) (N : ℕ) (w : Fin N → Euclid P) (α : Fin N → ℝ), Orthonormal ℝ v ∧ (∀ β : Covector (Euclid P) (d + 1), ζ₀ β = β v) ∧ Injective w ∧ (∀ (i : Fin N) (j : Fin (d + 1)), inner ℝ (w i) (v j) = 0) ∧ (∀ i, c ≤ α i) ∧ ∑ i, α i ≤ 1 ∧ (∃ i, w i = 0) ∧ ν = ∑ i, ENNReal.ofReal (α i) • (μHE[(d + 1)]).restrict {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)} := by
  intro P d ν ζ₀ c hc hfin hnorm hone hcyc hgrowth hpos hdens
  -- Steps 0–1: a subspace `V` with `∫ Dφ(y)[v] dν(y) = 0` for `v ∈ V` (`φ ∈ C_c^∞`), and
  -- `ζ₀(w♭ ∧ α) = 0` for `w ∈ V^⊥`
  obtain ⟨V, hVderiv, hVann⟩ :=
    Submission.cbr_ci_cp_wedge_annihilator_subspace P d ν ζ₀ hfin hcyc
  -- Step 2: `ν` is invariant under translation by every vector of `V`
  have hinv : ∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A →
      ν ((fun x => v + x) ⁻¹' A) = ν A := fun v hv =>
    Submission.cbr_ci_cp_translation_invariant_of_fderiv P ν v hfin (hVderiv v hv)
  -- Step 3: `ζ₀` only sees coordinates in `V`: `ζ₀(β) = ζ₀(β ∘ p_V)`
  have hproj := Submission.cbr_ci_cp_eval_comp_starProjection_eq P d ζ₀ V hVann
  -- Step 4: `ωₙ < ∞`, `ν(B_1(0)) > 0` and `ν(B_R(0)) ≤ ωₙRⁿ` force `dim V ≤ n`
  have hωn : unitBallVolume (d + 1) ≠ ∞ := measure_ball_lt_top.ne
  have hdimle : Module.finrank ℝ V ≤ d + 1 :=
    Submission.cbr_ci_cp_finrank_le_of_growth P (d + 1) ν V (unitBallVolume (d + 1)) hωn hinv
      hgrowth (hpos 1 one_pos)
  -- Step 5: normalisation: `dim V = n` and `ζ₀(β) = β(v)` for an orthonormal frame `v` of `V`
  obtain ⟨hdim, v, hv, hspan, hζ₀⟩ :=
    Submission.cbr_ci_cp_eval_eq_orthonormal_frame P d ζ₀ V hdimle hnorm hone hproj
  -- Step 6: product structure `ν = Hⁿ⌞V ⊗ σ`, with `σ` concentrated on `V^⊥`
  obtain ⟨σ, hσV, hσfin, hνσ⟩ :=
    Submission.cbr_ci_cp_invariant_measure_product P (d + 1) ν V hdim hfin hinv
  -- Step 7: `σ` is purely atomic, with atoms `Z ⊆ V^⊥` of mass `≥ c`
  obtain ⟨Z, -, hZV, hZc, hνZ⟩ :=
    Submission.cbr_ci_cp_atomic_transversal P (d + 1) ν σ V c hc hdim hσV hσfin hνσ hdens
  -- Steps 8–9: finitely many planes of total weight `≤ 1`, one of them through `0`
  obtain ⟨N, w, α, hw, hwV, hαc, hαsum, hw0, hν⟩ :=
    Submission.cbr_ci_cp_finite_parallel_planes P (d + 1) ν V Z (fun w => σ {w}) c hc hdim hZV
      hZc hνZ hgrowth hpos
  -- Step 10: the required form, with `span v = V` and `⟨wᵢ, vⱼ⟩ = 0` (`wᵢ ∈ V^⊥`, `vⱼ ∈ V`)
  have hvV : ∀ j, v j ∈ V := fun j => hspan ▸ Submodule.subset_span (Set.mem_range_self j)
  refine ⟨v, N, w, α, hv, hζ₀, hw, fun i j => ?_, hαc, hαsum, hw0, ?_⟩
  · exact Submodule.inner_left_of_mem_orthogonal (hvV j) (hwV i)
  · rw [hspan]
    exact hν

/-- Smooth cutoffs converging pointwise to the indicator of an open set (used to recover the
measure of an open set from the integrals of `C_c^∞` test functions by dominated convergence): for
open `V ⊆ ℝⁿ` there are smooth compactly supported `bⱼ : ℝⁿ → [0, 1]` with `spt bⱼ ⊆ V` and
`bⱼ → 𝟙_V` pointwise.  The compact sets `Kⱼ = {y : dist(y, ℝⁿ \ V) ≥ 1/(j+1)} ∩ B̄(0, j)` lie in
`V` and exhaust it; for `rⱼ > 0` with the closed `2rⱼ`-neighbourhood of `Kⱼ` inside `V`, the
smooth Urysohn lemma gives `bⱼ` with support the open `2rⱼ`-neighbourhood of `Kⱼ` and equal to `1`
exactly on the closed `rⱼ`-neighbourhood. -/
theorem Submission.cbr_ci_pw_noi_smooth_cutoff_seq : ∀ (n : ℕ) (V : Set (Euclid n)), IsOpen V → ∃ b : ℕ → Euclid n → ℝ, (∀ j, ContDiff ℝ (⊤ : ℕ∞) (b j)) ∧ (∀ j, HasCompactSupport (b j)) ∧ (∀ j, tsupport (b j) ⊆ V) ∧ (∀ j y, 0 ≤ b j y ∧ b j y ≤ 1) ∧ ∀ y, Tendsto (fun j => b j y) atTop (𝓝 (V.indicator (fun _ => (1 : ℝ)) y)) := by
  intro n V hV
  -- Step 1: the compact exhaustion `Kⱼ = {y : infEDist y Vᶜ ≥ 1/(j+1)} ∩ B̄(0, j)` of `V`.
  set K : ℕ → Set (Euclid n) := fun j =>
    {y | ((j : ℝ≥0∞) + 1)⁻¹ ≤ infEDist y Vᶜ} ∩ closedBall 0 j
  have hKc : ∀ j, IsCompact (K j) := fun j =>
    (isCompact_closedBall 0 (j : ℝ)).inter_left (isClosed_le continuous_const continuous_infEDist)
  have hKV : ∀ j, K j ⊆ V := by
    intro j y hy
    by_contra hyV
    have h1 : ((j : ℝ≥0∞) + 1)⁻¹ ≤ infEDist y Vᶜ := hy.1
    rw [infEDist_zero_of_mem hyV] at h1
    exact (ENNReal.inv_pos.mpr (by simp)).ne' (le_antisymm h1 bot_le)
  have hKev : ∀ y ∈ V, ∀ᶠ j in atTop, y ∈ K j := by
    intro y hy
    have hpos : 0 < infEDist y Vᶜ := by
      rw [infEDist_pos_iff_notMem_closure, hV.isClosed_compl.closure_eq]
      exact fun h => h hy
    have h1 : ∀ᶠ j : ℕ in atTop, ((j : ℝ≥0∞) + 1)⁻¹ ≤ infEDist y Vᶜ := by
      have ht : Tendsto (fun j : ℕ => ((j : ℝ≥0∞) + 1)⁻¹) atTop (𝓝 0) :=
        (ENNReal.tendsto_inv_nat_nhds_zero.comp (tendsto_add_atTop_nat 1)).congr fun j => by simp
      filter_upwards [ht.eventually (gt_mem_nhds hpos)] with j hj using hj.le
    have h2 : ∀ᶠ j : ℕ in atTop, y ∈ closedBall (0 : Euclid n) j := by
      obtain ⟨N, hN⟩ := exists_nat_ge ‖y‖
      filter_upwards [eventually_ge_atTop N] with j hj
      rw [mem_closedBall, dist_zero_right]
      exact hN.trans (by exact_mod_cast hj)
    filter_upwards [h1, h2] with j hj1 hj2 using ⟨hj1, hj2⟩
  -- Step 2: radii `rⱼ > 0` with `cthickening (2 rⱼ) Kⱼ ⊆ V`.
  have hr : ∀ j, ∃ r : ℝ, 0 < r ∧ cthickening (2 * r) (K j) ⊆ V := by
    intro j
    obtain ⟨δ, hδ, hsub⟩ := (hKc j).exists_cthickening_subset_open hV (hKV j)
    exact ⟨δ / 2, by positivity, by rwa [mul_div_cancel₀ _ two_ne_zero]⟩
  choose r hr0 hrV using hr
  -- Step 3: smooth Urysohn functions, `1` exactly on `cthickening rⱼ Kⱼ`, with support
  -- `thickening (2 rⱼ) Kⱼ`.
  have hb : ∀ j, ∃ f : Euclid n → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f ∧ range f ⊆ Icc 0 1 ∧
      support f = thickening (2 * r j) (K j) ∧ ∀ x, x ∈ cthickening (r j) (K j) ↔ f x = 1 :=
    fun j => exists_contDiff_support_eq_eq_one_iff isOpen_thickening isClosed_cthickening
      (cthickening_subset_thickening' (by linarith [hr0 j]) (by linarith [hr0 j]) _)
  choose b hbsmooth hbrange hbsupp hbone using hb
  have htsupp : ∀ j, tsupport (b j) ⊆ cthickening (2 * r j) (K j) := by
    intro j
    rw [tsupport, hbsupp]
    exact closure_thickening_subset_cthickening _ _
  refine ⟨b, hbsmooth,
    fun j => (hKc j).cthickening.of_isClosed_subset (isClosed_tsupport _) (htsupp j),
    fun j => (htsupp j).trans (hrV j), fun j y => hbrange j ⟨y, rfl⟩, fun y => ?_⟩
  -- Step 4: `bⱼ y = 1` for large `j` if `y ∈ V`, and `bⱼ y = 0` for all `j` if `y ∉ V`.
  by_cases hy : y ∈ V
  · rw [indicator_of_mem hy]
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [hKev y hy] with j hj
    exact ((hbone j y).mp (self_subset_cthickening _ hj)).symm
  · rw [indicator_of_notMem hy]
    refine tendsto_const_nhds.congr' (Eventually.of_forall fun j => ?_)
    by_contra hne
    exact hy ((htsupp j).trans (hrV j) (subset_tsupport _ (Ne.symm hne)))

/-- Finite Borel measures on `ℝⁿ` are determined on an open set `U` by their integrals of smooth
functions with compact support in `U`: if `∫ b dμ = ∫ b dν` for every `C^∞` function `b` with
compact support and `spt b ⊆ U`, then `μ⌞U = ν⌞U`.  For open `O`, smooth cutoffs `bⱼ → 𝟙_{O ∩ U}`
with `0 ≤ bⱼ ≤ 1` and dominated convergence give `μ(O ∩ U) = ν(O ∩ U)`; the open sets form a
π-system generating the Borel σ-algebra. -/
theorem Submission.cbr_ci_pw_noi_restrict_eq_of_smooth_test : ∀ (n : ℕ) (U : Set (Euclid n)) (μ ν : Measure (Euclid n)), IsOpen U → IsFiniteMeasure μ → IsFiniteMeasure ν → (∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U → ∫ y, b y ∂μ = ∫ y, b y ∂ν) → μ.restrict U = ν.restrict U := by
  intro n U μ ν hU hμ hν htest
  -- Step 1: `μ` and `ν` agree on `O ∩ U` for every open `O`, by testing with smooth cutoffs
  -- `bⱼ → 𝟙_{O ∩ U}` and dominated convergence (bound `1`, integrable as the measures are finite).
  have hopen : ∀ O : Set (Euclid n), IsOpen O → μ (O ∩ U) = ν (O ∩ U) := by
    intro O hO
    obtain ⟨b, hbs, hbc, hbt, hb01, hblim⟩ :=
      Submission.cbr_ci_pw_noi_smooth_cutoff_seq n (O ∩ U) (hO.inter hU)
    have hlim : ∀ ρ : Measure (Euclid n), IsFiniteMeasure ρ →
        Tendsto (fun j => ∫ y, b j y ∂ρ) atTop (𝓝 (ρ.real (O ∩ U))) := by
      intro ρ hρ
      rw [← integral_indicator_one (hO.inter hU).measurableSet]
      refine tendsto_integral_of_dominated_convergence (fun _ => (1 : ℝ))
        (fun j => (hbs j).continuous.aestronglyMeasurable) (integrable_const 1)
        (fun j => Eventually.of_forall fun y => ?_) (Eventually.of_forall hblim)
      rw [Real.norm_eq_abs, abs_le]
      constructor <;> linarith [(hb01 j y).1, (hb01 j y).2]
    have heq : ∀ j, ∫ y, b j y ∂μ = ∫ y, b j y ∂ν := fun j =>
      htest (b j) (hbs j) (hbc j) ((hbt j).trans inter_subset_right)
    have h₁ := hlim μ hμ
    have h₂ := hlim ν hν
    simp_rw [heq] at h₁
    exact (ENNReal.toReal_eq_toReal_iff' (measure_ne_top _ _) (measure_ne_top _ _)).mp
      (tendsto_nhds_unique h₁ h₂)
  -- Step 2: `μ⌞U` and `ν⌞U` agree on the π-system of open sets, which generates the Borel
  -- σ-algebra, and on `univ`; finite measures agreeing there are equal.
  refine ext_of_generate_finite {s | IsOpen s} BorelSpace.measurable_eq isPiSystem_isOpen ?_ ?_
  · intro s (hs : IsOpen s)
    rw [Measure.restrict_apply hs.measurableSet, Measure.restrict_apply hs.measurableSet]
    exact hopen s hs
  · rw [Measure.restrict_apply_univ, Measure.restrict_apply_univ]
    simpa using hopen univ isOpen_univ

/-- A smooth-test identity between a density and a push-forward holds on Borel subsets of `U`
(closure theorem argument, Simon Ch. 6, as used for 7.2.4): if `∫_U b u dLⁿ = ∫ (b ∘ q) h dσ` for
every smooth `b` with compact support in `U`, then `∫_B u dLⁿ = ∫_{q⁻¹ B} h dσ` for every Borel
`B ⊆ U`.  The finite measures `μ₁ = u⁺ Lⁿ⌞U + q_♯(h⁻ σ)` and `μ₂ = u⁻ Lⁿ⌞U + q_♯(h⁺ σ)` have the
same integral against every such `b`, hence agree on `U`; evaluating them on `B` and splitting `u`
and `h` into positive and negative parts gives the identity. -/
theorem Submission.cbr_ci_pw_noi_setIntegral_eq_preimage : ∀ (P n : ℕ) (U : Set (Euclid n)) (u : Euclid n → ℝ) (σ : Measure (Euclid P)) (q : Euclid P → Euclid n) (h : Euclid P → ℝ), IsOpen U → Measurable q → IntegrableOn u U → Integrable h σ → (∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U → ∫ y in U, b y * u y = ∫ x, b (q x) * h x ∂σ) → ∀ B : Set (Euclid n), MeasurableSet B → B ⊆ U → ∫ y in B, u y = ∫ x in q ⁻¹' B, h x ∂σ := by
  intro P n U u σ q h hU hq hu hh htest B hB hBU
  -- Step 1: the finite measures `λ± = u± Lⁿ⌞U` and `m± = q_♯(h± σ)`.
  set lp : Measure (Euclid n) := (volume.restrict U).withDensity fun y => ENNReal.ofReal (u y)
    with hlp
  set lm : Measure (Euclid n) := (volume.restrict U).withDensity fun y => ENNReal.ofReal (-u y)
    with hlm
  set mp : Measure (Euclid n) := (σ.withDensity fun x => ENNReal.ofReal (h x)).map q with hmp
  set mm : Measure (Euclid n) := (σ.withDensity fun x => ENNReal.ofReal (-h x)).map q with hmm
  have hlpf : IsFiniteMeasure lp := isFiniteMeasure_withDensity_ofReal hu.2
  have hlmf : IsFiniteMeasure lm := isFiniteMeasure_withDensity_ofReal hu.neg.2
  have hmpf : IsFiniteMeasure mp := by
    have : IsFiniteMeasure (σ.withDensity fun x => ENNReal.ofReal (h x)) :=
      isFiniteMeasure_withDensity_ofReal hh.2
    exact Measure.isFiniteMeasure_map _ _
  have hmmf : IsFiniteMeasure mm := by
    have : IsFiniteMeasure (σ.withDensity fun x => ENNReal.ofReal (-h x)) :=
      isFiniteMeasure_withDensity_ofReal hh.neg.2
    exact Measure.isFiniteMeasure_map _ _
  -- Step 2: integrals of a function `b` against `λ±` and `m±`.
  have hlam : ∀ (f : Euclid n → ℝ) (b : Euclid n → ℝ), IntegrableOn f U →
      ∫ y, b y ∂((volume.restrict U).withDensity fun y => ENNReal.ofReal (f y)) =
        ∫ y in U, max (f y) 0 * b y := by
    intro f b hf
    rw [integral_withDensity_eq_integral_toReal_smul₀ hf.aemeasurable.ennreal_ofReal
      (Eventually.of_forall fun _ => ENNReal.ofReal_lt_top)]
    simp only [ENNReal.toReal_ofReal', smul_eq_mul]
  have hpush : ∀ (g : Euclid P → ℝ) (b : Euclid n → ℝ), Integrable g σ → Continuous b →
      ∫ y, b y ∂((σ.withDensity fun x => ENNReal.ofReal (g x)).map q) =
        ∫ x, max (g x) 0 * b (q x) ∂σ := by
    intro g b hg hb
    rw [integral_map hq.aemeasurable hb.aestronglyMeasurable,
      integral_withDensity_eq_integral_toReal_smul₀ hg.aemeasurable.ennreal_ofReal
        (Eventually.of_forall fun _ => ENNReal.ofReal_lt_top)]
    simp only [ENNReal.toReal_ofReal', smul_eq_mul]
  -- Step 3: `λ₊ + m₋` and `λ₋ + m₊` have the same integral against every test function, since
  -- `u = u⁺ - u⁻`, `h = h⁺ - h⁻` and `∫_U b u = ∫ (b ∘ q) h dσ`.
  have hkey : ∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U →
      ∫ y, b y ∂(lp + mm) = ∫ y, b y ∂(lm + mp) := by
    intro b hb hbc hbU
    have hbcont : Continuous b := hb.continuous
    obtain ⟨C, hC⟩ := hbcont.bounded_above_of_compact_support hbc
    have hbm : AEStronglyMeasurable b (volume.restrict U) := hbcont.aestronglyMeasurable
    have hbqm : AEStronglyMeasurable (fun x => b (q x)) σ :=
      (hbcont.measurable.comp hq).aestronglyMeasurable
    rw [integral_add_measure (hbcont.integrable_of_hasCompactSupport hbc)
        (hbcont.integrable_of_hasCompactSupport hbc),
      integral_add_measure (hbcont.integrable_of_hasCompactSupport hbc)
        (hbcont.integrable_of_hasCompactSupport hbc),
      hlam u b hu, hlam (fun y => -u y) b hu.neg, hpush h b hh hbcont,
      hpush (fun x => -h x) b hh.neg hbcont]
    have I1 : (∫ y in U, max (u y) 0 * b y) - ∫ y in U, max (-u y) 0 * b y =
        ∫ y in U, b y * u y := by
      have hsub := integral_sub (hu.pos_part.mul_bdd hbm (Eventually.of_forall hC))
        (hu.neg_part.mul_bdd hbm (Eventually.of_forall hC))
      refine hsub.symm.trans (integral_congr_ae (Eventually.of_forall fun y => ?_))
      simp only
      rw [← sub_mul, max_zero_sub_max_neg_zero_eq_self, mul_comm]
    have I2 : ∫ x, max (h x) 0 * b (q x) ∂σ - ∫ x, max (-h x) 0 * b (q x) ∂σ =
        ∫ x, b (q x) * h x ∂σ := by
      have hsub := integral_sub (hh.pos_part.mul_bdd hbqm (Eventually.of_forall fun x => hC (q x)))
        (hh.neg_part.mul_bdd hbqm (Eventually.of_forall fun x => hC (q x)))
      refine hsub.symm.trans (integral_congr_ae (Eventually.of_forall fun x => ?_))
      simp only
      rw [← sub_mul, max_zero_sub_max_neg_zero_eq_self, mul_comm]
    have := htest b hb hbc hbU
    linarith
  -- Step 4: uniqueness, so the two measures agree on the measurable subset `B` of `U`.
  have hres := Submission.cbr_ci_pw_noi_restrict_eq_of_smooth_test n U (lp + mm) (lm + mp) hU
    inferInstance inferInstance hkey
  have hBeq : (lp + mm) B = (lm + mp) B := by
    have := congrArg (fun μ : Measure (Euclid n) => μ B) hres
    simpa only [Measure.restrict_apply hB, inter_eq_left.mpr hBU] using this
  -- Step 5: `λ±(B) = ∫⁻_B (±u)⁺` and `m±(B) = ∫⁻_{q⁻¹ B} (±h)⁺ dσ`.
  have hlB : ∀ f : Euclid n → ℝ, ((volume.restrict U).withDensity fun y => ENNReal.ofReal (f y)) B =
      ∫⁻ y in B, ENNReal.ofReal (f y) := by
    intro f
    rw [withDensity_apply _ hB, Measure.restrict_restrict hB, inter_eq_left.mpr hBU]
  have hmB : ∀ g : Euclid P → ℝ, ((σ.withDensity fun x => ENNReal.ofReal (g x)).map q) B =
      ∫⁻ x in q ⁻¹' B, ENNReal.ofReal (g x) ∂σ := by
    intro g
    rw [Measure.map_apply hq hB, withDensity_apply _ (hq hB)]
  -- Step 6: all four values are finite, so the identity of Step 4 passes to real numbers, and
  -- both set integrals are differences of positive and negative parts.
  rw [Measure.add_apply, Measure.add_apply] at hBeq
  have hreal : (lp B).toReal + (mm B).toReal = (lm B).toReal + (mp B).toReal := by
    rw [← ENNReal.toReal_add (measure_ne_top _ _) (measure_ne_top _ _),
      ← ENNReal.toReal_add (measure_ne_top _ _) (measure_ne_top _ _), hBeq]
  have hL : ∫ y in B, u y = (lp B).toReal - (lm B).toReal := by
    rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part (hu.mono_set hBU), hlp, hlm, hlB, hlB]
  have hR : ∫ x in q ⁻¹' B, h x ∂σ = (mp B).toReal - (mm B).toReal := by
    rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hh.integrableOn, hmp, hmm, hmB, hmB]
  rw [hL, hR]
  linarith

/-- Null-off-image bound for the density `u` (step 10 of the weight-at-least-one argument): if
`∫_U b u = ∫ (b ∘ q) h dσ` for every `b ∈ C_c^∞(U)` and `σ` is carried by `A`, then `u = 0`
`Lⁿ`-a.e. on `U \ q(A)`, i.e. `Lⁿ(B ∩ {u ≠ 0}) ≤ Lⁿ(B ∩ q(A))` for measurable `B ⊆ U`.  With
`E` a measurable hull of `q(A)`, every measurable `B' ⊆ U \ E` has `σ`-null preimage `q⁻¹(B')`,
so `∫_{B'} u = ∫_{q⁻¹(B')} h dσ = 0` (`cbr_ci_pw_noi_setIntegral_eq_preimage`); hence `u = 0`
a.e. on `U \ E` and `Lⁿ(B ∩ {u ≠ 0}) ≤ Lⁿ(B ∩ E) = Lⁿ(B ∩ q(A))`. -/
theorem Submission.cbr_ci_pw_density_null_off_image : ∀ (P n : ℕ) (U : Set (Euclid n)) (u : Euclid n → ℝ) (σ : Measure (Euclid P)) (q : Euclid P → Euclid n) (h : Euclid P → ℝ) (A : Set (Euclid P)), IsOpen U → Continuous q → IntegrableOn u U → σ univ < ∞ → Integrable h σ → σ Aᶜ = 0 → (∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U → ∫ y in U, b y * u y = ∫ x, b (q x) * h x ∂σ) → ∀ B : Set (Euclid n), MeasurableSet B → B ⊆ U → volume (B ∩ {y | u y ≠ 0}) ≤ volume (B ∩ q '' A) := by
  intro P n U u σ q h A hU hq hu _hσ hh hA htest B hB hBU
  -- the measurable hull `E` of `q '' A`
  set E : Set (Euclid n) := toMeasurable volume (q '' A) with hE
  have hUE : MeasurableSet (U \ E) := hU.measurableSet.diff (measurableSet_toMeasurable _ _)
  -- `∫_s u = 0` for measurable `s ⊆ U \ E`, because `q ⁻¹' s ⊆ Aᶜ` is `σ`-null
  have hzero : ∀ s : Set (Euclid n), MeasurableSet s → s ⊆ U \ E → ∫ y in s, u y = 0 := by
    intro s hs hsUE
    rw [Submission.cbr_ci_pw_noi_setIntegral_eq_preimage P n U u σ q h hU hq.measurable hu hh
      htest s hs (hsUE.trans sdiff_subset)]
    refine setIntegral_measure_zero _ (measure_mono_null ?_ hA)
    intro x hx hxA
    exact (hsUE hx).2 (subset_toMeasurable _ _ ⟨x, hxA, rfl⟩)
  -- hence `u = 0` a.e. on `U \ E`
  have hae : u =ᵐ[volume.restrict (U \ E)] 0 :=
    (hu.mono_set sdiff_subset).ae_eq_zero_of_forall_setIntegral_eq_zero fun s hs _ => by
      rw [Measure.restrict_restrict hs]
      exact hzero _ (hs.inter hUE) inter_subset_right
  have hnull : volume ({y | u y ≠ 0} ∩ (U \ E)) = 0 := by
    rw [← Measure.restrict_apply' hUE]
    exact hae
  -- `B ∩ {u ≠ 0} ⊆ (B ∩ E) ∪ ({u ≠ 0} ∩ (U \ E))` and `Lⁿ(B ∩ E) = Lⁿ(B ∩ q '' A)`
  calc volume (B ∩ {y | u y ≠ 0})
      ≤ volume (B ∩ E ∪ {y | u y ≠ 0} ∩ (U \ E)) := by
        refine measure_mono fun y hy => ?_
        by_cases hyE : y ∈ E
        · exact Or.inl ⟨hy.1, hyE⟩
        · exact Or.inr ⟨hy.2, hBU hy.1, hyE⟩
    _ ≤ volume (B ∩ E) + volume ({y | u y ≠ 0} ∩ (U \ E)) := measure_union_le _ _
    _ = volume (B ∩ q '' A) := by
        rw [hnull, add_zero, inter_comm, hE,
          Measure.measure_toMeasurable_inter_of_sFinite hB, inter_comm]
/-- **Smooth approximation of a Lipschitz function** (step 4 of the weak continuity of Jacobians):
an `L`-Lipschitz `f : ℝᵏ → ℝ` is the uniform limit of `C^∞`, `L`-Lipschitz functions `f_n` with
`Df_n(x) → Df(x)` in operator norm for a.e. `x`.  Take `f_n = ρ_n ⋆ f`, where `ρ_n = φ_n / ∫ φ_n`
normalizes a bump `φ_n` equal to `1` on `B(0, 1/(n+2))` and supported in `B(0, 2/(n+2))`.  Then
`f_n` is smooth, `L`-Lipschitz (`cmcs_ls_mollify_lipschitz`) and `|f_n - f| ≤ 2L/(n+2)`.  By
`dor_lmb_fcd_jwc_mollify_fderiv_eq`, `Df_n(x) eᵢ = (ρ_n ⋆ Df(·) eᵢ)(x)`; as `∫ φ_n ≥ |B(0, 1/(n+2))|`
gives `0 ≤ ρ_n ≤ 2ᵈ / |B(0, 2/(n+2))|`, this tends to `Df(x) eᵢ` at every Lebesgue point of the
bounded function `Df(·) eᵢ`, and `‖T‖ ≤ ∑ᵢ |T eᵢ|` gives convergence in operator norm. -/
theorem Submission.dor_lmb_fcd_jwc_lipschitz_smooth_approx : ∀ (k : ℕ) (L : NNReal) (f : Euclid k → ℝ), LipschitzWith L f → ∃ fs : ℕ → Euclid k → ℝ, (∀ n, ContDiff ℝ (⊤ : ℕ∞) (fs n)) ∧ (∀ n, LipschitzWith L (fs n)) ∧ TendstoUniformly fs f atTop ∧ ∀ᵐ x ∂(volume : Measure (Euclid k)), Tendsto (fun n => fderiv ℝ (fs n) x) atTop (𝓝 (fderiv ℝ f x)) := by
  intro k L f hf
  -- step 1: bumps `φ n` with `rIn = 1/(n+2)`, `rOut = 2/(n+2)`, normalized to `ρ n = φ n / ∫ φ n`
  have hpos : ∀ n : ℕ, (0 : ℝ) < (n : ℝ) + 2 := fun n => by positivity
  let φ : ℕ → ContDiffBump (0 : Euclid k) := fun n =>
    ⟨1 / ((n : ℝ) + 2), 2 / ((n : ℝ) + 2), by have := hpos n; positivity,
      div_lt_div_of_pos_right (by norm_num) (hpos n)⟩
  have hrOut : ∀ n, (φ n).rOut = 2 * (φ n).rIn := fun n => by
    show 2 / ((n : ℝ) + 2) = 2 * (1 / ((n : ℝ) + 2))
    rw [mul_one_div]
  -- `|B(x, r)| = r ^ d * c` with `c = |B(0, 1)| > 0`
  set d := Module.finrank ℝ (Euclid k)
  set c := (volume : Measure (Euclid k)).real (closedBall 0 1)
  have hcpos : 0 < c := ENNReal.toReal_pos (measure_closedBall_pos _ _ one_pos).ne'
    measure_closedBall_lt_top.ne
  have hvol : ∀ (x : Euclid k) (r : ℝ), 0 ≤ r →
      (volume : Measure (Euclid k)).real (closedBall x r) = r ^ d * c :=
    fun x r hr => Measure.addHaar_real_closedBall' _ x hr
  -- `φ n = 1` on `B(0, rIn)` and `φ n ≥ 0`, so `∫ φ n ≥ |B(0, rIn)| = rIn ^ d * c > 0`
  have hφint : ∀ n, Integrable (φ n) (volume : Measure (Euclid k)) := fun n =>
    (φ n).continuous.integrable_of_hasCompactSupport (φ n).hasCompactSupport
  have hIge : ∀ n, (φ n).rIn ^ d * c ≤ ∫ x, φ n x := by
    intro n
    rw [← hvol 0 _ (φ n).rIn_pos.le]
    calc (volume : Measure (Euclid k)).real (closedBall 0 (φ n).rIn)
        = ∫ x in closedBall (0 : Euclid k) (φ n).rIn, φ n x := by
          rw [setIntegral_congr_fun measurableSet_closedBall
            (fun x hx => (φ n).one_of_mem_closedBall hx), setIntegral_const, smul_eq_mul, mul_one]
      _ ≤ ∫ x, φ n x :=
          setIntegral_le_integral (hφint n) (Eventually.of_forall fun x => (φ n).nonneg)
  have hIpos : ∀ n, 0 < ∫ x, φ n x := fun n =>
    (mul_pos (pow_pos (φ n).rIn_pos d) hcpos).trans_le (hIge n)
  set ρ : ℕ → Euclid k → ℝ := fun n x => φ n x / ∫ y, φ n y with hρ
  have hρc : ∀ n, ContDiff ℝ (⊤ : ℕ∞) (ρ n) := fun n => (φ n).contDiff.div_const _
  have hρc1 : ∀ n, ContDiff ℝ 1 (ρ n) := fun n => (φ n).contDiff.div_const _
  have hρcont : ∀ n, Continuous (ρ n) := fun n => (φ n).continuous.div_const _
  have hρs : ∀ n, HasCompactSupport (ρ n) := fun n =>
    (φ n).hasCompactSupport.comp_left (g := fun t : ℝ => t / ∫ y, φ n y) (zero_div _)
  have hρ0 : ∀ n x, 0 ≤ ρ n x := fun n x => div_nonneg (φ n).nonneg (hIpos n).le
  have hρint : ∀ n, ∫ x, ρ n x = 1 := fun n => by
    show ∫ x, φ n x / ∫ y, φ n y = 1
    rw [integral_div, div_self (hIpos n).ne']
  have hρsupp : ∀ n, support (ρ n) ⊆ ball 0 (φ n).rOut := fun n x hx => by
    rw [← (φ n).support_eq, mem_support]
    intro h0
    exact (mem_support.1 hx) (by simp [hρ, h0])
  have hρle : ∀ n x, ρ n x ≤ 1 / ((φ n).rIn ^ d * c) := fun n x =>
    calc ρ n x = φ n x / ∫ y, φ n y := rfl
      _ ≤ 1 / ∫ y, φ n y := div_le_div_of_nonneg_right (φ n).le_one (hIpos n).le
      _ ≤ 1 / ((φ n).rIn ^ d * c) :=
          one_div_le_one_div_of_le (mul_pos (pow_pos (φ n).rIn_pos d) hcpos) (hIge n)
  -- `f_n = ρ n ⋆ f`
  set fs : ℕ → Euclid k → ℝ := fun n x => ∫ t, ρ n t * f (x - t) with hfs
  have hconv : ∀ n, fs n = convolution (ρ n) f (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    intro n; funext x; simp [hfs, convolution_def]
  have hrOut0 : Tendsto (fun n => (φ n).rOut) atTop (𝓝 0) := by
    have := tendsto_const_nhds (x := (2 : ℝ)) |>.div_atTop
      (tendsto_atTop_add_const_right atTop (2 : ℝ) tendsto_natCast_atTop_atTop)
    simpa [φ] using this
  refine ⟨fs, fun n => ?_, fun n => ?_, ?_, ?_⟩
  · -- step 2: `ρ n ⋆ f` is smooth
    rw [hconv]
    exact (hρs n).contDiff_convolution_left _ (hρc n) hf.continuous.locallyIntegrable
  · -- step 3: `ρ n ⋆ f` is `L`-Lipschitz
    exact Submission.cmcs_ls_mollify_lipschitz k (ρ n) f L (hρcont n) (hρs n) (hρ0 n) (hρint n) hf
  · -- step 4: `|f_n x - f x| ≤ L * rOut` for all `x`, and `rOut → 0`
    rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [(hrOut0.const_mul (L : ℝ)).eventually (gt_mem_nhds (by simpa using hε))]
      with n hn x
    have hdist := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := f x) (g := f)
      (by positivity : (0 : ℝ) ≤ L * (φ n).rOut) (hρsupp n) (hρ0 n) (hρint n)
      hf.continuous.aestronglyMeasurable (fun y hy => by
        calc dist (f y) (f x) ≤ L * dist y x := hf.dist_le_mul y x
          _ ≤ L * (φ n).rOut := by gcongr; exact (mem_ball.1 hy).le)
    rw [← hconv] at hdist
    rw [dist_comm]
    exact lt_of_le_of_lt hdist hn
  · -- step 5: `Df_n(x) v = ∫ ρ n t * Df(x - t) v dt`
    have hB1 : ∀ n x v, fderiv ℝ (fs n) x v = ∫ t, ρ n t * fderiv ℝ f (x - t) v := fun n x v =>
      Submission.dor_lmb_fcd_jwc_mollify_fderiv_eq k L f (ρ n) hf (hρc1 n) (hρs n) x v
    have hδ : Tendsto (fun n => (φ n).rOut) atTop (𝓝[>] 0) :=
      tendsto_nhdsWithin_iff.2 ⟨hrOut0, Eventually.of_forall fun n => (φ n).rOut_pos⟩
    -- steps 6-7: for each basis vector `e_i`, `Df_n(x) e_i → Df(x) e_i` for a.e. `x`
    have hDi : ∀ i : Fin k, ∀ᵐ x ∂(volume : Measure (Euclid k)),
        Tendsto (fun n => fderiv ℝ (fs n) x (EuclideanSpace.single i (1 : ℝ))) atTop
          (𝓝 (fderiv ℝ f x (EuclideanSpace.single i (1 : ℝ)))) := by
      intro i
      set g : Euclid k → ℝ := fun s => fderiv ℝ f s (EuclideanSpace.single i (1 : ℝ)) with hg
      have hloc : LocallyIntegrable g (volume : Measure (Euclid k)) := by
        refine (locallyIntegrable_const ((L : ℝ) * ‖EuclideanSpace.single i (1 : ℝ)‖)).mono
          ((measurable_fderiv_apply_const ℝ f _).aestronglyMeasurable)
          (Eventually.of_forall fun s => ?_)
        rw [Real.norm_eq_abs (_ * _), abs_of_nonneg (by positivity)]
        exact (ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hf) (norm_nonneg _))
      -- Lebesgue differentiation: `⨍_{B(x, r)} |g - g x| → 0` as `r → 0`, for a.e. `x`
      filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub volume hloc 1]
        with x hx
      have havg := hx (fun _ => x) (fun n => (φ n).rOut) hδ
        (Eventually.of_forall fun n => mem_closedBall_self (by simpa using (φ n).rOut_pos.le))
      -- `0 ≤ ρ n (x - ·) ≤ 2 ^ d / |B(x, rOut)|`, supported in `B(x, rOut)`, with integral `1`
      have key := tendsto_integral_smul_of_tendsto_average_norm_sub ((2 : ℝ) ^ d) havg
        (g := fun n y => ρ n (x - y))
        (Eventually.of_forall fun n => hloc.integrableOn_isCompact (isCompact_closedBall _ _))
        (tendsto_const_nhds.congr fun n => by
          rw [integral_sub_left_eq_self (ρ n) volume x, hρint n])
        (Eventually.of_forall fun n y hy => by
          have hy' : x - y ∈ ball (0 : Euclid k) (φ n).rOut := hρsupp n hy
          rw [mem_ball, dist_zero_right] at hy'
          rw [mem_closedBall, dist_eq_norm, ← norm_neg, neg_sub]
          exact hy'.le)
        (Eventually.of_forall fun n y => by
          rw [abs_of_nonneg (hρ0 n _), hvol x _ (φ n).rOut_pos.le, hrOut n]
          calc ρ n (x - y) ≤ 1 / ((φ n).rIn ^ d * c) := hρle n _
            _ = 2 ^ d / ((2 * (φ n).rIn) ^ d * c) := by
              rw [mul_pow]
              field_simp)
      refine key.congr fun n => ?_
      rw [hB1, ← integral_sub_left_eq_self (fun y => ρ n (x - y) • g y) volume x]
      simp only [sub_sub_cancel, smul_eq_mul, hg]
    filter_upwards [ae_all_iff.2 hDi] with x hx
    -- step 8: `‖T‖ ≤ ∑ᵢ |T eᵢ|`, so convergence on the basis gives convergence in norm
    have hbound : ∀ T : Euclid k →L[ℝ] ℝ, ‖T‖ ≤ ∑ i, ‖T (EuclideanSpace.single i (1 : ℝ))‖ := by
      intro T
      refine ContinuousLinearMap.opNorm_le_bound T (Finset.sum_nonneg fun i _ => norm_nonneg _)
        fun w => ?_
      have hw : w = ∑ i, w i • EuclideanSpace.single i (1 : ℝ) := by
        conv_lhs => rw [← (EuclideanSpace.basisFun (Fin k) ℝ).sum_repr w]
        simp
      calc ‖T w‖ = ‖∑ i, w i • T (EuclideanSpace.single i (1 : ℝ))‖ := by
            conv_lhs => rw [hw]
            simp [map_sum, map_smul]
        _ ≤ ∑ i, ‖w i • T (EuclideanSpace.single i (1 : ℝ))‖ := norm_sum_le _ _
        _ = ∑ i, ‖w i‖ * ‖T (EuclideanSpace.single i (1 : ℝ))‖ := by simp
        _ ≤ ∑ i, ‖w‖ * ‖T (EuclideanSpace.single i (1 : ℝ))‖ := by
            gcongr with i
            exact PiLp.norm_apply_le w i
        _ = (∑ i, ‖T (EuclideanSpace.single i (1 : ℝ))‖) * ‖w‖ := by
            rw [Finset.sum_mul]; simp [mul_comm]
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun n => norm_nonneg _) (fun n => hbound _) ?_
    have : Tendsto (fun n => ∑ i : Fin k, ‖(fderiv ℝ (fs n) x - fderiv ℝ f x)
        (EuclideanSpace.single i (1 : ℝ))‖) atTop (𝓝 (∑ i : Fin k, (0 : ℝ))) := by
      refine tendsto_finsetSum _ fun i _ => ?_
      have := tendsto_iff_norm_sub_tendsto_zero.1 (hx i)
      simpa using this
    simpa using this
/-- **Integration by parts for Jacobian minors of Lipschitz maps** (the step "`(∗)` holds for
Lipschitz `v`" in the weak continuity of Jacobian minors): for `L`-Lipschitz `g₀, …, g_r` on `ℝᵏ`,
vectors `V₀, …, V_r` and `ψ ∈ C¹_c(ℝᵏ)`,
`∫ ψ det A = −Σ_b (−1)^b ∫ ∂_{V_b}ψ · g₀ · M_b`, where `A = (Dg_c V_b)_{c,b}` and `M_b` is the minor
`det (Dg_{c+1} V_{s_b(b')})_{c,b'}`, `s_b = b.succAbove`.  Mollify every `g_c`: `C^∞`, `L`-Lipschitz
`g^n_c → g_c` uniformly with `Dg^n_c → Dg_c` a.e.  The identity holds for every `n` (smooth case);
the determinants converge a.e. and are bounded by `(r+1)! (L Σ_b ‖V_b‖)^(r+1)`, resp.
`r! (L Σ_b' ‖V_{s_b(b')}‖)^r`, so both sides converge by dominated convergence (on the right with
`|g^n_0| ≤ |g_0| + 1` for large `n`), and the limits agree. -/
theorem Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp : ∀ (k r : ℕ) (L : NNReal) (g : Fin (r + 1) → Euclid k → ℝ) (V : Fin (r + 1) → Euclid k) (ψ : Euclid k → ℝ), (∀ c, LipschitzWith L (g c)) → ContDiff ℝ 1 ψ → HasCompactSupport ψ → ∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) = -∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * ∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))) := by
  intro k r L g V ψ hg hψ hψs
  -- step 1: smooth `L`-Lipschitz approximants `fs c n` of every component `g c`
  choose fs hfs_smooth hfs_lip hfs_unif hfs_ae using
    fun c => Submission.dor_lmb_fcd_jwc_lipschitz_smooth_approx k L (g c) (hg c)
  -- step 2: the identity for the smooth maps `fs · n`
  have hid := fun n => Submission.dor_lmb_fcd_jwc_smooth_minor_ibp k r (fun c => fs c n) V ψ
    (fun c => (hfs_smooth c n).of_le (by simp)) hψ hψs
  -- step 3: off a null set all derivatives converge, hence so do the entries and determinants
  have hae : ∀ᵐ x ∂(volume : Measure (Euclid k)), ∀ c,
      Tendsto (fun n => fderiv ℝ (fs c n) x) atTop (𝓝 (fderiv ℝ (g c) x)) := ae_all_iff.2 hfs_ae
  have hdet_lim : ∀ {m : ℕ} (σ : Fin m → Fin (r + 1)) (W : Fin m → Euclid k) (x : Euclid k),
      (∀ c, Tendsto (fun n => fderiv ℝ (fs c n) x) atTop (𝓝 (fderiv ℝ (g c) x))) →
      Tendsto (fun n => Matrix.det (Matrix.of fun (c b : Fin m) => fderiv ℝ (fs (σ c) n) x (W b)))
        atTop (𝓝 (Matrix.det (Matrix.of fun (c b : Fin m) => fderiv ℝ (g (σ c)) x (W b)))) := by
    intro m σ W x hx
    have hM : Tendsto (fun n => (Matrix.of fun (c b : Fin m) => fderiv ℝ (fs (σ c) n) x (W b)))
        atTop (𝓝 (Matrix.of fun (c b : Fin m) => fderiv ℝ (g (σ c)) x (W b))) := by
      refine tendsto_pi_nhds.2 fun c => tendsto_pi_nhds.2 fun b => ?_
      exact ((ContinuousLinearMap.apply ℝ ℝ (W b)).continuous.tendsto _).comp (hx (σ c))
    exact ((continuous_id.matrix_det).tendsto _).comp hM
  -- step 4: the bound `B` of the full determinants and the integrability of `ψ`
  set B : ℝ := ((r + 1).factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ (r + 1)
  have hψc : Continuous ψ := hψ.continuous
  have hψi : Integrable ψ := hψc.integrable_of_hasCompactSupport hψs
  -- step 5: the left side converges, dominated by `B |ψ|`
  have hL : Tendsto
      (fun n => ∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (fs c n) x (V b)))
      atTop (𝓝 (∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))) := by
    refine tendsto_integral_of_dominated_convergence (fun x => B * ‖ψ x‖) (fun n => ?_)
      (hψi.norm.const_mul B) (fun n => Eventually.of_forall fun x => ?_) ?_
    · exact hψc.aestronglyMeasurable.mul
        (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L (fun c => fs c n) V
          (fun c => hfs_lip c n)).1.aestronglyMeasurable
    · have h := (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L (fun c => fs c n) V
        (fun c => hfs_lip c n)).2 x
      rw [norm_mul, Real.norm_eq_abs (Matrix.det _), mul_comm]
      exact mul_le_mul_of_nonneg_right h (norm_nonneg _)
    · filter_upwards [hae] with x hx
      exact tendsto_const_nhds.mul (hdet_lim id V x hx)
  -- step 6: each term of the right side converges, dominated by `Br |∂_{V_b}ψ| (|g 0| + 1)`
  have hR : ∀ b : Fin (r + 1), Tendsto (fun n => ∫ x, fderiv ℝ ψ x (V b) * fs 0 n x *
      Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (fs c.succ n) x (V (b.succAbove b'))))
      atTop (𝓝 (∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det
        (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))))) := by
    intro b
    set Br : ℝ := (r.factorial : ℝ) * ((L : ℝ) * ∑ b', ‖V (b.succAbove b')‖) ^ r
    have hdψc : Continuous (fun x => fderiv ℝ ψ x (V b)) :=
      (hψ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdψs : HasCompactSupport (fun x => fderiv ℝ ψ x (V b)) := hψs.fderiv_apply (𝕜 := ℝ) (V b)
    have hwi : Integrable (fun x => Br * (‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1))) := by
      refine Integrable.const_mul ?_ _
      exact Continuous.integrable_of_hasCompactSupport
        (hdψc.norm.mul ((hg 0).continuous.norm.add continuous_const)) hdψs.norm.mul_right
    refine tendsto_integral_filter_of_dominated_convergence
      (fun x => Br * (‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1)))
      (Eventually.of_forall fun n => ?_) ?_ hwi ?_
    · exact (hdψc.mul (hfs_smooth 0 n).continuous).aestronglyMeasurable.mul
        (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L (fun c => fs c.succ n)
          (fun b' => V (b.succAbove b')) (fun c => hfs_lip c.succ n)).1.aestronglyMeasurable
    · -- `|fs 0 n| ≤ |g 0| + 1` once `fs 0 n` is uniformly `1`-close to `g 0`
      obtain ⟨N, hN⟩ :=
        (Metric.tendstoUniformly_iff.1 (hfs_unif 0) 1 one_pos).exists_forall_of_atTop
      refine eventually_atTop.2 ⟨N, fun n hn => Eventually.of_forall fun x => ?_⟩
      have h1 : ‖fs 0 n x‖ ≤ ‖g 0 x‖ + 1 := by
        have := hN n hn x
        rw [dist_comm, dist_eq_norm] at this
        have := norm_le_insert' (fs 0 n x) (g 0 x)
        linarith
      have h2 := (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L (fun c => fs c.succ n)
        (fun b' => V (b.succAbove b')) (fun c => hfs_lip c.succ n)).2 x
      rw [norm_mul, norm_mul, Real.norm_eq_abs (Matrix.det _)]
      calc ‖fderiv ℝ ψ x (V b)‖ * ‖fs 0 n x‖ * |Matrix.det _|
          ≤ ‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1) * Br := by gcongr
        _ = Br * (‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1)) := by ring
    · filter_upwards [hae] with x hx
      refine (tendsto_const_nhds.mul ((hfs_unif 0).tendsto_at x)).mul ?_
      exact hdet_lim Fin.succ (fun b' => V (b.succAbove b')) x hx
  have hRall : Tendsto (fun n => -∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) *
      ∫ x, fderiv ℝ ψ x (V b) * fs 0 n x * Matrix.det
        (Matrix.of fun (c b' : Fin r) => fderiv ℝ (fs c.succ n) x (V (b.succAbove b'))))
      atTop (𝓝 (-∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * ∫ x, fderiv ℝ ψ x (V b) * g 0 x *
        Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))))) :=
    Tendsto.neg (tendsto_finsetSum _ fun b _ => (hR b).const_mul _)
  -- step 7: both sides of step 2 agree for every `n`, so their limits agree
  exact tendsto_nhds_unique hL (hRall.congr fun n => (hid n).symm)

/-- **Weak continuity of Jacobian minors of Lipschitz maps** (the induction `P(r)` of the weak
continuity of minors; Reshetnyak, Ball 1977, Ball–Currie–Olver 1981): if `gʲ_c, g_c` (`c < r`)
are `L`-Lipschitz on `ℝᵏ` with `gʲ_c → g_c` uniformly, `V_b ∈ ℝᵏ` and `φ` is integrable, then
`∫ φ det (Dgʲ_c V_b) → ∫ φ det (Dg_c V_b)`.  Induction on `r`, for all `L`, rows, directions and
weights; `r = 0` is trivial (the empty determinant is `1`).  For `r + 1` the minors are measurable
and bounded by `(r+1)! (L Σ_b ‖V_b‖)^(r+1)`, so by the weak-* upgrade it suffices to test against
`ψ ∈ C^∞_c`, and integration by parts gives `∫ ψ det = −Σ_b (−1)^b ∫ ∂_{V_b}ψ · g₀ · M_b`.  Split
`gʲ₀ = (gʲ₀ − g₀) + g₀`: the error term is at most `sup |gʲ₀ − g₀| · Br ∫ |∂_{V_b}ψ| → 0`, where
`Br` bounds the `r × r` minors `Mʲ_b`, and the main term converges by the induction hypothesis
with the integrable weight `∂_{V_b}ψ · g₀`. -/
theorem Submission.cmcdt_lpi_mwc_coordinate_minor_continuity : ∀ (k r : ℕ) (L : NNReal) (gs : ℕ → Fin r → Euclid k → ℝ) (g : Fin r → Euclid k → ℝ) (V : Fin r → Euclid k) (φ : Euclid k → ℝ), Integrable φ → (∀ j c, LipschitzWith L (gs j c)) → (∀ c, LipschitzWith L (g c)) → (∀ c, TendstoUniformly (fun j => gs j c) (g c) atTop) → Tendsto (fun j => ∫ x, φ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (gs j c) x (V b))) atTop (𝓝 (∫ x, φ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))) := by
  intro k r
  induction r with
  | zero =>
    -- step 1: the empty determinant is `1`, so the sequence is constant
    intro L gs g V φ _ _ _ _
    simp only [Matrix.det_isEmpty, mul_one]
    exact tendsto_const_nhds
  | succ r ih =>
    intro L gs g V φ hφ hgs hg hconv
    -- step 2: the minors are measurable and bounded, so `C^∞_c` weights `ψ` suffice
    have hMs := fun j =>
      Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L (gs j) V (hgs j)
    have hM := Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L g V hg
    refine Submission.dor_lmb_fcd_jwc_weak_star_l1_upgrade k _
      (fun j x => Matrix.det (Matrix.of fun c b => fderiv ℝ (gs j c) x (V b)))
      (fun x => Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))
      (fun j => (hMs j).1.aestronglyMeasurable) hM.1.aestronglyMeasurable (fun j => (hMs j).2)
      hM.2 ?_ φ hφ
    intro ψ hψ hψs
    have hψ1 : ContDiff ℝ 1 ψ := hψ.of_le (by simp)
    -- step 3: integrate by parts (for every `j` and for the limit); it suffices to treat each `b`
    suffices hR : ∀ b : Fin (r + 1), Tendsto (fun j => ∫ x, fderiv ℝ ψ x (V b) * gs j 0 x *
        Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) atTop
        (𝓝 (∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (g c.succ) x (V (b.succAbove b'))))) by
      rw [Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp k r L g V ψ hg hψ1 hψs]
      refine Tendsto.congr (fun j => (Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp k r L (gs j)
        V ψ (hgs j) hψ1 hψs).symm) ?_
      exact Tendsto.neg (tendsto_finsetSum _ fun b _ => (hR b).const_mul _)
    intro b
    -- step 4: `χ = ∂_{V_b}ψ` and `θ = χ · g 0` are continuous with compact support, hence
    -- integrable; the minors `M j` are measurable and bounded by `Br`
    have hχc : Continuous (fun x => fderiv ℝ ψ x (V b)) :=
      (hψ1.continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hχs : HasCompactSupport (fun x => fderiv ℝ ψ x (V b)) :=
      hψs.fderiv_apply (𝕜 := ℝ) (V b)
    have hχi : Integrable (fun x => fderiv ℝ ψ x (V b)) :=
      hχc.integrable_of_hasCompactSupport hχs
    have hθi : Integrable (fun x => fderiv ℝ ψ x (V b) * g 0 x) :=
      (hχc.mul (hg 0).continuous).integrable_of_hasCompactSupport hχs.mul_right
    have hMb := fun j => Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L
      (fun c => gs j c.succ) (fun b' => V (b.succAbove b')) (fun c => hgs j c.succ)
    obtain ⟨Br, hBr0, hBr⟩ : ∃ Br : ℝ, 0 ≤ Br ∧ ∀ j x, ‖Matrix.det (Matrix.of fun (c b' : Fin r) =>
        fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))‖ ≤ Br :=
      ⟨(r.factorial : ℝ) * ((L : ℝ) * ∑ b', ‖V (b.succAbove b')‖) ^ r, by positivity,
        fun j x => by rw [Real.norm_eq_abs]; exact (hMb j).2 x⟩
    have hI1 : ∀ j, Integrable (fun x => fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) *
        Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) := fun j =>
      ((hχc.mul ((hgs j 0).continuous.sub (hg 0).continuous)).integrable_of_hasCompactSupport
        hχs.mul_right).mul_bdd (hMb j).1.aestronglyMeasurable (Eventually.of_forall (hBr j))
    have hI2 : ∀ j, Integrable (fun x => fderiv ℝ ψ x (V b) * g 0 x *
        Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) := fun j =>
      hθi.mul_bdd (hMb j).1.aestronglyMeasurable (Eventually.of_forall (hBr j))
    -- split `gs j 0 = (gs j 0 - g 0) + g 0`
    have hsplit : ∀ j, ∫ x, fderiv ℝ ψ x (V b) * gs j 0 x * Matrix.det (Matrix.of
        fun (c b' : Fin r) => fderiv ℝ (gs j c.succ) x (V (b.succAbove b'))) =
        (∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Matrix.det (Matrix.of
          fun (c b' : Fin r) => fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) +
        ∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of
          fun (c b' : Fin r) => fderiv ℝ (gs j c.succ) x (V (b.succAbove b'))) := by
      intro j
      rw [← integral_add (hI1 j) (hI2 j)]
      congr 1
      funext x
      ring
    -- step 5: the error term tends to `0` by the uniform convergence `gs j 0 → g 0`
    have hT1 : Tendsto (fun j => ∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) *
        Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) atTop (𝓝 0) := by
      obtain ⟨A, hA0, hA⟩ : ∃ A : ℝ, 0 ≤ A ∧ ∫ x, ‖fderiv ℝ ψ x (V b)‖ = A :=
        ⟨∫ x, ‖fderiv ℝ ψ x (V b)‖, integral_nonneg fun x => norm_nonneg _, rfl⟩
      have hBA : 0 ≤ Br * A := mul_nonneg hBr0 hA0
      rw [Metric.tendsto_atTop]
      intro ε hε
      have hδ : 0 < ε / (Br * A + 1) := by positivity
      obtain ⟨N, hN⟩ := (Metric.tendstoUniformly_iff.1 (hconv 0) _ hδ).exists_forall_of_atTop
      refine ⟨N, fun j hj => ?_⟩
      rw [dist_zero_right]
      calc _ ≤ ∫ x, ε / (Br * A + 1) * Br * ‖fderiv ℝ ψ x (V b)‖ := by
            refine norm_integral_le_of_norm_le (hχi.norm.const_mul _)
              (Eventually.of_forall fun x => ?_)
            have h1 : ‖gs j 0 x - g 0 x‖ ≤ ε / (Br * A + 1) := by
              have := hN j hj x
              rw [dist_comm, dist_eq_norm] at this
              exact this.le
            have h2 := hBr j x
            rw [norm_mul, norm_mul]
            calc _ ≤ ‖fderiv ℝ ψ x (V b)‖ * (ε / (Br * A + 1)) * Br := by gcongr
              _ = ε / (Br * A + 1) * Br * ‖fderiv ℝ ψ x (V b)‖ := by ring
        _ = ε / (Br * A + 1) * (Br * A) := by rw [integral_const_mul, hA]; ring
        _ < ε / (Br * A + 1) * (Br * A + 1) := mul_lt_mul_of_pos_left (by linarith) hδ
        _ = ε := div_mul_cancel₀ ε (by positivity)
    -- step 6: the main term converges by the induction hypothesis with the weight `θ`
    have hT2 := ih L (fun j c => gs j c.succ) (fun c => g c.succ) (fun b' => V (b.succAbove b'))
      (fun x => fderiv ℝ ψ x (V b) * g 0 x) hθi (fun j c => hgs j c.succ) (fun c => hg c.succ)
      (fun c => hconv c.succ)
    -- step 7: add the two limits
    have hsum := hT1.add hT2
    rw [zero_add] at hsum
    exact hsum.congr fun j => (hsplit j).symm

/-- **Weak continuity of Jacobian minors of Lipschitz maps** (step 6(v) of the integrality of
Lipschitz push-forwards; Simon Ch. 6, 2.29): if `v_j, v₀ : ℝᵐ → ℝᵖ` are `L`-Lipschitz, `v_j → v₀`
uniformly and `c ∈ L¹`, then `∫ c M^{a,b}(v_j) → ∫ c M^{a,b}(v₀)`, where
`M^{a,b}(v)(u) = det ((Dv(u) e_{b_t})_{a_s})_{s,t}`.  The coordinate projection `p_i y = y_i` is
`1`-Lipschitz, so the rows `v^{a_s} = p_{a_s} ∘ v` are `L`-Lipschitz and `v_j^{a_s} → v₀^{a_s}`
uniformly; the coordinate version `cmcdt_lpi_mwc_coordinate_minor_continuity` (with
`V_t = e_{b_t}`, `φ = c`) gives the convergence for the minors `det (D(v^{a_s}) e_{b_t})_{s,t}`.
At every point where `v` is differentiable, hence a.e. by Rademacher,
`D(v^{a_s})(u) = p_{a_s} ∘ Dv(u)`, so these minors have the same integrals as `M^{a,b}(v)`. -/
theorem Submission.cmcdt_lpi_minor_weak_continuity : ∀ (m p r : ℕ) (L : NNReal) (v : ℕ → Euclid m → Euclid p) (v₀ : Euclid m → Euclid p) (a : Fin r → Fin p) (b : Fin r → Fin m) (c : Euclid m → ℝ), (∀ j, LipschitzWith L (v j)) → LipschitzWith L v₀ → TendstoUniformly v v₀ atTop → Integrable c → Tendsto (fun j => ∫ u, c u * Matrix.det (Matrix.of fun s t => fderiv ℝ (v j) u (EuclideanSpace.single (b t) 1) (a s))) atTop (𝓝 (∫ u, c u * Matrix.det (Matrix.of fun s t => fderiv ℝ v₀ u (EuclideanSpace.single (b t) 1) (a s)))) := by
  intro m p r L v v₀ a b c hv hv₀ hvv₀ hc
  -- step 1: the coordinate projection `y ↦ y i` is `1`-Lipschitz, so the rows
  -- `v^{a_s} = (· (a s)) ∘ v` are `L`-Lipschitz and converge uniformly
  have hproj : ∀ i : Fin p, LipschitzWith 1 (fun y : Euclid p => y i) := fun i =>
    LipschitzWith.of_dist_le_mul fun y y' => by
      rw [NNReal.coe_one, one_mul]
      exact PiLp.dist_apply_le y y' i
  have hrow : ∀ f : Euclid m → Euclid p, LipschitzWith L f → ∀ s,
      LipschitzWith L (fun u => f u (a s)) := fun f hf s => by
    have h := (hproj (a s)).comp hf
    rw [one_mul] at h
    exact h
  -- step 2: by Rademacher, a.e. `D(v^{a_s})(u) e_{b_t} = (Dv(u) e_{b_t})_{a_s}`, so the
  -- coordinate minors have the same integrals as the minors of the statement
  have hcoord : ∀ f : Euclid m → Euclid p, LipschitzWith L f →
      ∫ u, c u * Matrix.det (Matrix.of fun s t =>
        fderiv ℝ (fun y => f y (a s)) u (EuclideanSpace.single (b t) 1)) =
      ∫ u, c u * Matrix.det (Matrix.of fun s t =>
        fderiv ℝ f u (EuclideanSpace.single (b t) 1) (a s)) := by
    intro f hf
    refine integral_congr_ae ?_
    filter_upwards [hf.ae_differentiableAt] with u hu
    have hent : ∀ (i : Fin p) (w : Euclid m),
        fderiv ℝ (fun y => f y i) u w = fderiv ℝ f u w i := by
      intro i w
      have h := (PiLp.hasFDerivAt_apply (𝕜 := ℝ) 2 (f u) i).comp u hu.hasFDerivAt
      rw [show (fun y => f y i) = (fun g : Euclid p => g i) ∘ f from rfl, h.fderiv]
      rfl
    simp only [hent]
  -- step 3: the coordinate statement for `g_s = v^{a_s}`, `V_t = e_{b_t}` and `φ = c`
  have h := Submission.cmcdt_lpi_mwc_coordinate_minor_continuity m r L
    (fun j s u => v j u (a s)) (fun s u => v₀ u (a s)) (fun t => EuclideanSpace.single (b t) 1) c
    hc (fun j => hrow (v j) (hv j)) (hrow v₀ hv₀)
    (fun s => (hproj (a s)).uniformContinuous.comp_tendstoUniformly hvv₀)
  rw [hcoord v₀ hv₀] at h
  exact h.congr fun j => hcoord (v j) (hv j)

/-- **Weak continuity of `f(v_j) · M(v_j)` against `L¹` weights.**  Let `v_j → v₀` uniformly,
all `L`-Lipschitz, `w ∈ L¹(ℝ^m)`, `f` continuous with compact support, and
`M(v)(u) = det((Dv(u) e_{b t})_{a s})_{s,t}`.  Then `∫ w f(v_j) M(v_j) → ∫ w f(v₀) M(v₀)`.  Split
`w f(v_j) M_j = w (f(v_j) - f(v₀)) M_j + c M_j` with `c = w f(v₀) ∈ L¹`.  Since `|M_j| ≤ K = r! Lʳ`
and `f ∘ v_j → f ∘ v₀` uniformly, the first integral is eventually at most `η K ‖w‖₁` for any
`η > 0`; the second converges by the weak continuity of Jacobian minors. -/
theorem Submission.cmcdt_lpi_pc_scalar_weak_continuity : ∀ (m p r : ℕ) (L : NNReal) (v : ℕ → Euclid m → Euclid p) (v₀ : Euclid m → Euclid p) (a : Fin r → Fin p) (b : Fin r → Fin m) (w : Euclid m → ℝ) (f : Euclid p → ℝ), (∀ j, LipschitzWith L (v j)) → LipschitzWith L v₀ → TendstoUniformly v v₀ atTop → Integrable w → Continuous f → HasCompactSupport f → Tendsto (fun j => ∫ u, w u * (f (v j u) * Matrix.det (Matrix.of fun s t => fderiv ℝ (v j) u (EuclideanSpace.single (b t) 1) (a s)))) atTop (𝓝 (∫ u, w u * (f (v₀ u) * Matrix.det (Matrix.of fun s t => fderiv ℝ v₀ u (EuclideanSpace.single (b t) 1) (a s))))) := by
  intro m p r L v v₀ a b w f hv hv₀ hunif hw hf hfc
  -- `f` is bounded by `C`, so the weight `c = w · f(v₀)` is integrable
  obtain ⟨C, hC⟩ := hf.bounded_above_of_compact_support hfc
  have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC 0)
  have hc : Integrable (fun u => w u * f (v₀ u)) :=
    hw.mul_bdd (hf.comp hv₀.continuous).aestronglyMeasurable (Eventually.of_forall fun u => hC (v₀ u))
  -- the minors are measurable and bounded by `r! Lʳ`, and their `c`-integrals converge
  suffices key : ∀ (M : ℕ → Euclid m → ℝ) (M₀ : Euclid m → ℝ) (K : ℝ), (∀ j, Measurable (M j)) →
      (∀ j u, |M j u| ≤ K) →
      Tendsto (fun j => ∫ u, w u * f (v₀ u) * M j u) atTop (𝓝 (∫ u, w u * f (v₀ u) * M₀ u)) →
      Tendsto (fun j => ∫ u, w u * (f (v j u) * M j u)) atTop (𝓝 (∫ u, w u * (f (v₀ u) * M₀ u))) from
    key (fun j u => Matrix.det (Matrix.of fun s t => fderiv ℝ (v j) u (EuclideanSpace.single (b t) 1) (a s)))
      (fun u => Matrix.det (Matrix.of fun s t => fderiv ℝ v₀ u (EuclideanSpace.single (b t) 1) (a s)))
      ((r.factorial : ℝ) * (L : ℝ) ^ r)
      (fun j => (Submission.cmcdt_lpi_pc_minor_measurable_bound m p r L (v j) a b (hv j)).1)
      (fun j => (Submission.cmcdt_lpi_pc_minor_measurable_bound m p r L (v j) a b (hv j)).2)
      (Submission.cmcdt_lpi_minor_weak_continuity m p r L v v₀ a b (fun u => w u * f (v₀ u)) hv hv₀
        hunif hc)
  intro M M₀ K hM hMK hS
  have hK : 0 ≤ K := (abs_nonneg _).trans (hMK 0 0)
  have hfv : ∀ j, Continuous (fun u => f (v j u)) := fun j => hf.comp (hv j).continuous
  have hfv₀ : Continuous (fun u => f (v₀ u)) := hf.comp hv₀.continuous
  -- split `w f(v_j) M_j = w (f(v_j) - f(v₀)) M_j + c M_j`; both pieces are integrable
  have hI₁ : ∀ j, Integrable (fun u => w u * ((f (v j u) - f (v₀ u)) * M j u)) := fun j =>
    hw.mul_bdd (c := (C + C) * K) (((hfv j).sub hfv₀).measurable.mul (hM j)).aestronglyMeasurable
      (Eventually.of_forall fun u => by
        rw [norm_mul, Real.norm_eq_abs (M j u)]
        exact mul_le_mul ((norm_sub_le _ _).trans (add_le_add (hC _) (hC _))) (hMK j u)
          (abs_nonneg _) (by linarith))
  have hI₂ : ∀ j, Integrable (fun u => w u * f (v₀ u) * M j u) := fun j =>
    hc.mul_bdd (c := K) (hM j).aestronglyMeasurable
      (Eventually.of_forall fun u => (Real.norm_eq_abs _).le.trans (hMK j u))
  have hsplit : ∀ j, (∫ u, w u * (f (v j u) * M j u)) =
      (∫ u, w u * ((f (v j u) - f (v₀ u)) * M j u)) + ∫ u, w u * f (v₀ u) * M j u := by
    intro j
    rw [← integral_add (hI₁ j) (hI₂ j)]
    congr 1
    funext u
    ring
  -- the first piece tends to `0`
  have hT : Tendsto (fun j => ∫ u, w u * ((f (v j u) - f (v₀ u)) * M j u)) atTop (𝓝 0) := by
    have hU := (hfc.uniformContinuous_of_continuous hf).comp_tendstoUniformly hunif
    have hW : 0 ≤ ∫ u, ‖w u‖ := integral_nonneg fun u => norm_nonneg (w u)
    have hD : 0 < K * (∫ u, ‖w u‖) + 1 := by nlinarith [mul_nonneg hK hW]
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨η, hη, hηε⟩ : ∃ η : ℝ, 0 < η ∧ η * K * (∫ u, ‖w u‖) < ε := by
      refine ⟨ε / (K * (∫ u, ‖w u‖) + 1), div_pos hε hD, ?_⟩
      rw [mul_assoc, div_mul_eq_mul_div, div_lt_iff₀ hD]
      nlinarith [mul_nonneg hK hW]
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.1 (Metric.tendstoUniformly_iff.1 hU η hη)
    refine ⟨N, fun n hn => ?_⟩
    have hpt : ∀ u, ‖w u * ((f (v n u) - f (v₀ u)) * M n u)‖ ≤ η * K * ‖w u‖ := by
      intro u
      have h₁ : ‖f (v n u) - f (v₀ u)‖ ≤ η := by
        rw [← dist_eq_norm, dist_comm]
        exact (hN n hn u).le
      calc ‖w u * ((f (v n u) - f (v₀ u)) * M n u)‖
          = ‖w u‖ * (‖f (v n u) - f (v₀ u)‖ * |M n u|) := by
            rw [norm_mul, norm_mul, Real.norm_eq_abs (M n u)]
        _ ≤ ‖w u‖ * (η * K) :=
            mul_le_mul_of_nonneg_left (mul_le_mul h₁ (hMK n u) (abs_nonneg _) hη.le) (norm_nonneg _)
        _ = η * K * ‖w u‖ := mul_comm _ _
    rw [dist_zero_right]
    calc ‖∫ u, w u * ((f (v n u) - f (v₀ u)) * M n u)‖ ≤ ∫ u, η * K * ‖w u‖ :=
          norm_integral_le_of_norm_le (hw.norm.const_mul _) (Eventually.of_forall hpt)
      _ = η * K * (∫ u, ‖w u‖) := integral_const_mul _ _
      _ < ε := hηε
  -- the second piece converges to `∫ c M₀`; add the limits
  have hlim := hT.add hS
  rw [zero_add] at hlim
  have e : (∫ u, w u * (f (v₀ u) * M₀ u)) = ∫ u, w u * f (v₀ u) * M₀ u := by
    congr 1
    funext u
    ring
  rw [e]
  exact hlim.congr fun j => (hsplit j).symm

/-- **Simon 6.3.2(1)**, agreement on the overlap (step 3 of the proof that `p₁T₁ + p₂T₂` is
integer multiplicity).  Let `R₁ = (M₁, θ₁, ξ₁)` and `R₂ = (M₂, θ₂, ξ₂)` be integer multiplicity
triples in the open set `U`.  `M₂` is Borel and locally `Hⁿ`-finite in `U`:
`Hⁿ(M₂ ∩ K) ≤ ∫_{M₂ ∩ K} θ₂ dHⁿ < ∞` for compact `K ⊆ U`, as `θ₂ ≥ 1` on `M₂`.  So for `Hⁿ`-a.e.
`x ∈ M₁ ∩ M₂` both `ξ₁(x)` (tangent transfer from `M₁` to `M₂ ⊇ M₁ ∩ M₂`) and `ξ₂(x)` orient
`TₓM₂`, which is unique (Ch. 3, Remark 1.5(1)); two unit orientations of one subspace agree up
to sign. -/
theorem Submission.rsdic_imrep_ae_orient_eq_or_eq_neg_inter : ∀ (P n : ℕ) (U : Set (Euclid P)) (R₁ R₂ : IMRep U n), IsOpen U → ∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)), R₂.orient x = R₁.orient x ∨ R₂.orient x = -R₁.orient x := by
  intro P n U R₁ R₂ hU
  -- `M₂` is locally `Hⁿ`-finite in `U`: `Hⁿ(M₂ ∩ K) = ∫_{M₂ ∩ K} 1 dHⁿ ≤ ∫_{M₂ ∩ K} θ₂ dHⁿ < ∞`
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (R₂.carrier ∩ K) ≠ ∞ := by
    intro K hK hKU
    refine ne_top_of_le_ne_top (R₂.locallyIntegrable_mult K hK hKU) ?_
    rw [← setLIntegral_one]
    exact setLIntegral_mono' (R₂.measurableSet_carrier.inter hK.measurableSet) fun x hx =>
      Nat.one_le_cast.2 (R₂.mult_pos x hx.1)
  -- a.e. on `M₁ ∩ M₂`, `ξ₁` orients `TₓM₂` (tangent transfer with `B = M₁ ∩ M₂`, `C = M₂`) ...
  have h₁ := Submission.rsdic_imrep_ae_tangent_orient_of_subset P n U (R₁.carrier ∩ R₂.carrier)
    R₂.carrier R₁ hU (R₁.measurableSet_carrier.inter R₂.measurableSet_carrier)
    R₂.measurableSet_carrier inter_subset_left inter_subset_right R₂.carrier_subset hfin
  -- ... and so does `ξ₂`, as `R₂.orients` holds a.e. on `M₂ ⊇ M₁ ∩ M₂`
  have h₂ := ae_restrict_of_ae_restrict_of_subset
    (inter_subset_right : R₁.carrier ∩ R₂.carrier ⊆ R₂.carrier) R₂.orients
  filter_upwards [h₁, h₂] with x ⟨Q₁, hT₁, hξ₁⟩ ⟨Q₂, hT₂, hξ₂⟩
  -- `TₓM₂` is unique, and two unit orientations of one subspace agree up to sign
  rw [hT₁.unique hT₂] at hξ₁
  exact Submission.rsdic_unitOrientation_eq_or_eq_neg P n (R₁.orient x) (R₂.orient x) Q₂ hξ₁ hξ₂

/-- **Simon Ch. 6, Remark 3.2(1)** (the construction step): for IMReps `R₁ = (M₁, θ₁, ξ₁)`,
`R₂ = (M₂, θ₂, ξ₂)` in an open `U` and `p₁, p₂ ∈ ℤ` there is an IMRep `R = (M', θ', ξ')` in `U`
with `1_{M'} θ' ξ' = p₁ 1_{M₁} θ₁ ξ₁ + p₂ 1_{M₂} θ₂ ξ₂` `Hⁿ`-a.e.  Take Borel versions `η₁, η₂`
of the orientations and the Borel sign `σ = ±1` according as `η₂ = η₁` or not; as `ξ₂ = ±ξ₁`
a.e. on `M₁ ∩ M₂`, `η₂ = σ η₁` there.  With `c = p₁ θ₁ 1_{M₁} + p₂ θ₂ (σ 1_{M₁ ∩ M₂} + 1_{M₂ \ M₁})`
and `ζ = η₁` on `M₁`, `ζ = η₂` off `M₁`, put `M' = (M₁ ∪ M₂) ∩ {c ≠ 0}`, `θ' = |c|`,
`ξ' = sgn(c) ζ`.  Then `1_{M'} θ' ξ' = c ζ` is the combination a.e., `|c| ≤ |p₁| θ₁ 1_{M₁} +
|p₂| θ₂ 1_{M₂}` gives local integrability, and `ξ' = ±ξᵢ` orients `T_x M'` a.e. on `M' ∩ M₁`
(`i = 1`) and on `M' \ M₁ ⊆ M₂` (`i = 2`). -/
theorem Submission.rsdic_exists_imrep_int_combination : ∀ (P n : ℕ) (U : Set (Euclid P)) (R₁ R₂ : IMRep U n) (p₁ p₂ : ℤ), IsOpen U → ∃ R : IMRep U n, ∀ᵐ x ∂μHE[n], R.carrier.indicator (fun y => (R.mult y : ℝ) • R.orient y) x = (p₁ : ℝ) • R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x + (p₂ : ℝ) • R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x := by
  intro P n U R₁ R₂ p₁ p₂ hU
  classical
  have hM₁ := R₁.measurableSet_carrier
  have hM₂ := R₂.measurableSet_carrier
  -- Step 1: Borel versions `η₁, η₂` of the orientations, equal to them a.e. on the carriers
  obtain ⟨η₁, hη₁, hη₁e⟩ : ∃ η : Euclid P → MultiVector P n, StronglyMeasurable η ∧
      ∀ᵐ x ∂μHE[n], x ∈ R₁.carrier → R₁.orient x = η x :=
    ⟨_, R₁.aestronglyMeasurable_orient.stronglyMeasurable_mk,
      (ae_restrict_iff' hM₁).mp R₁.aestronglyMeasurable_orient.ae_eq_mk⟩
  obtain ⟨η₂, hη₂, hη₂e⟩ : ∃ η : Euclid P → MultiVector P n, StronglyMeasurable η ∧
      ∀ᵐ x ∂μHE[n], x ∈ R₂.carrier → R₂.orient x = η x :=
    ⟨_, R₂.aestronglyMeasurable_orient.stronglyMeasurable_mk,
      (ae_restrict_iff' hM₂).mp R₂.aestronglyMeasurable_orient.ae_eq_mk⟩
  -- Step 2: `ξ₂ = ±ξ₁` a.e. on `M₁ ∩ M₂`
  have hpm : ∀ᵐ x ∂μHE[n], x ∈ R₁.carrier → x ∈ R₂.carrier →
      R₂.orient x = R₁.orient x ∨ R₂.orient x = -R₁.orient x := by
    filter_upwards [(ae_restrict_iff' (hM₁.inter hM₂)).mp
      (Submission.rsdic_imrep_ae_orient_eq_or_eq_neg_inter P n U R₁ R₂ hU)] with x hx h₁ h₂
    exact hx ⟨h₁, h₂⟩
  -- Step 3: the coefficient `c` (with the Borel sign `σ`) and the orientation field `ζ`
  have hE : MeasurableSet {x | η₂ x = η₁ x} := by
    -- `Λₙ(ℝᴾ)` carries the strong operator topology; it is the topology of the operator norm
    have : TopologicalSpace.MetrizableSpace (MultiVector P n) :=
      { toPseudoMetrizableSpace := ⟨⟨PseudoMetricSpace.toUniformSpace, rfl,
          Metric.uniformity_basis_dist_inv_nat_succ.isCountablyGenerated⟩⟩
        toT0Space := inferInstance }
    exact hη₂.measurableSet_eq_fun hη₁
  obtain ⟨c, hc⟩ : ∃ c : Euclid P → ℤ, c = fun x =>
      (if x ∈ R₁.carrier then p₁ * R₁.mult x else 0) +
        (if x ∈ R₂.carrier then
          (if x ∈ R₁.carrier then (if η₂ x = η₁ x then 1 else -1) else 1) * (p₂ * R₂.mult x)
        else 0) := ⟨_, rfl⟩
  have hc_meas : Measurable c := by
    have hθ₁ : Measurable fun x => (R₁.mult x : ℤ) := measurable_from_nat.comp R₁.measurable_mult
    have hθ₂ : Measurable fun x => (R₂.mult x : ℤ) := measurable_from_nat.comp R₂.measurable_mult
    rw [hc]
    exact (Measurable.ite hM₁ (measurable_const.mul hθ₁) measurable_const).add
      (Measurable.ite hM₂ ((Measurable.ite hM₁ (Measurable.ite hE measurable_const measurable_const)
        measurable_const).mul (measurable_const.mul hθ₂)) measurable_const)
  have hc_off : ∀ x, x ∉ R₁.carrier → x ∉ R₂.carrier → c x = 0 := by
    intro x h₁ h₂
    simp [hc, h₁, h₂]
  obtain ⟨ζ, hζ⟩ : ∃ ζ : Euclid P → MultiVector P n,
      ζ = fun x => if x ∈ R₁.carrier then η₁ x else η₂ x := ⟨_, rfl⟩
  have hζ_meas : StronglyMeasurable ζ := by
    rw [hζ]
    exact StronglyMeasurable.ite hM₁ hη₁ hη₂
  have hζ₁ : ∀ x, x ∈ R₁.carrier → ζ x = η₁ x := fun x hx => by simp [hζ, hx]
  have hζ₂ : ∀ x, x ∉ R₁.carrier → ζ x = η₂ x := fun x hx => by simp [hζ, hx]
  -- the new carrier `M' = (M₁ ∪ M₂) ∩ {c ≠ 0}`
  obtain ⟨M', hM'⟩ : ∃ M' : Set (Euclid P),
      M' = (R₁.carrier ∪ R₂.carrier) ∩ {x | c x ≠ 0} := ⟨_, rfl⟩
  have hmem : ∀ x, x ∈ M' ↔ (x ∈ R₁.carrier ∨ x ∈ R₂.carrier) ∧ c x ≠ 0 := by
    intro x
    rw [hM']
    rfl
  have hM'meas : MeasurableSet M' := by
    rw [hM']
    exact (hM₁.union hM₂).inter (hc_meas (measurableSet_singleton 0).compl)
  have hM'U : M' ⊆ U := fun x hx =>
    ((hmem x).mp hx).1.elim (fun h => R₁.carrier_subset h) fun h => R₂.carrier_subset h
  -- Step 5: `1_{M'} |c| sgn(c) ζ = c ζ` everywhere
  have hind : ∀ x, M'.indicator (fun y => ((c y).natAbs : ℝ) • (((c y).sign : ℝ) • ζ y)) x =
      (c x : ℝ) • ζ x := by
    intro x
    by_cases hx : x ∈ M'
    · rw [indicator_of_mem hx, smul_smul]
      congr 1
      have h : (((c x).sign * ((c x).natAbs : ℤ) : ℤ) : ℝ) = (c x : ℝ) := by
        rw [Int.sign_mul_natAbs]
      rw [Int.cast_mul, Int.cast_natCast] at h
      rw [mul_comm]
      exact h
    · rw [indicator_of_notMem hx]
      have hc0 : c x = 0 := by
        by_contra hcx
        by_cases hA : x ∈ R₁.carrier ∨ x ∈ R₂.carrier
        · exact hx ((hmem x).mpr ⟨hA, hcx⟩)
        · exact hcx (hc_off x (fun h => hA (Or.inl h)) fun h => hA (Or.inr h))
      rw [hc0, Int.cast_zero, zero_smul]
  -- Step 6 (d): `|c| ≤ |p₁| θ₁ 1_{M₁} + |p₂| θ₂ 1_{M₂}`, so `θ' = |c|` is locally integrable
  have hθ₁e : Measurable fun x => (R₁.mult x : ℝ≥0∞) := measurable_from_nat.comp R₁.measurable_mult
  have hθ₂e : Measurable fun x => (R₂.mult x : ℝ≥0∞) := measurable_from_nat.comp R₂.measurable_mult
  have hbound : ∀ x, ((c x).natAbs : ℝ≥0∞) ≤
      (p₁.natAbs : ℝ≥0∞) * R₁.carrier.indicator (fun y => (R₁.mult y : ℝ≥0∞)) x +
        (p₂.natAbs : ℝ≥0∞) * R₂.carrier.indicator (fun y => (R₂.mult y : ℝ≥0∞)) x := by
    intro x
    have key : (c x).natAbs ≤ p₁.natAbs * (if x ∈ R₁.carrier then R₁.mult x else 0) +
        p₂.natAbs * (if x ∈ R₂.carrier then R₂.mult x else 0) := by
      rw [hc]
      refine (Int.natAbs_add_le _ _).trans (add_le_add ?_ ?_)
      · split_ifs <;> simp [Int.natAbs_mul]
      · split_ifs <;> simp [Int.natAbs_mul]
    calc ((c x).natAbs : ℝ≥0∞)
        ≤ ((p₁.natAbs * (if x ∈ R₁.carrier then R₁.mult x else 0) +
            p₂.natAbs * (if x ∈ R₂.carrier then R₂.mult x else 0) : ℕ) : ℝ≥0∞) := by
          exact_mod_cast key
      _ = _ := by
          by_cases h₁ : x ∈ R₁.carrier <;> by_cases h₂ : x ∈ R₂.carrier <;> simp [h₁, h₂]
  have hlocint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∫⁻ x in M' ∩ K, ((c x).natAbs : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    intro K hK hKU
    refine ne_top_of_le_ne_top (b := ∫⁻ x in K, ((p₁.natAbs : ℝ≥0∞) *
        R₁.carrier.indicator (fun y => (R₁.mult y : ℝ≥0∞)) x + (p₂.natAbs : ℝ≥0∞) *
        R₂.carrier.indicator (fun y => (R₂.mult y : ℝ≥0∞)) x) ∂μHE[n]) ?_
      ((lintegral_mono hbound).trans (lintegral_mono_set inter_subset_right))
    rw [lintegral_add_left ((hθ₁e.indicator hM₁).const_mul _),
      lintegral_const_mul _ (hθ₁e.indicator hM₁), lintegral_const_mul _ (hθ₂e.indicator hM₂),
      lintegral_indicator hM₁, lintegral_indicator hM₂, Measure.restrict_restrict hM₁,
      Measure.restrict_restrict hM₂]
    exact ENNReal.add_ne_top.mpr
      ⟨ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) (R₁.locallyIntegrable_mult K hK hKU),
        ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) (R₂.locallyIntegrable_mult K hK hKU)⟩
  -- Step 6 (f): `Hⁿ(M' ∩ K) ≤ Hⁿ(M₁ ∩ K) + Hⁿ(M₂ ∩ K) < ∞`, as `θᵢ ≥ 1` on `Mᵢ`
  have hfinR : ∀ (R : IMRep U n) (K : Set (Euclid P)), IsCompact K → K ⊆ U →
      μHE[n] (R.carrier ∩ K) ≠ ∞ := by
    intro R K hK hKU
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK hKU) ?_
    rw [← setLIntegral_one]
    exact setLIntegral_mono (measurable_from_nat.comp R.measurable_mult) fun x hx =>
      Nat.one_le_cast.mpr (R.mult_pos x hx.1)
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞ := by
    intro K hK hKU
    refine ne_top_of_le_ne_top (ENNReal.add_ne_top.mpr ⟨hfinR R₁ K hK hKU, hfinR R₂ K hK hKU⟩)
      ((measure_mono ?_).trans (measure_union_le _ _))
    rintro x ⟨hx, hxK⟩
    exact ((hmem x).mp hx).1.elim (fun h => Or.inl ⟨h, hxK⟩) fun h => Or.inr ⟨h, hxK⟩
  -- `sgn(c) ξ` is a unit orientation of `Q` when `c ≠ 0` and `ξ` is one
  have hsign : ∀ (k : ℤ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), k ≠ 0 →
      IsUnitOrientationOf ξ Q → IsUnitOrientationOf ((k.sign : ℝ) • ξ) Q := by
    rintro k ξ Q hk ⟨τ, hτ, hspan, hξ⟩
    refine ⟨τ, hτ, hspan, ?_⟩
    rcases lt_or_gt_of_ne hk with hk | hk
    · rw [Int.sign_eq_neg_one_of_neg hk]
      rcases hξ with h | h
      · exact Or.inr fun α => by simp [h α]
      · exact Or.inl fun α => by simp [h α]
    · rw [Int.sign_eq_one_of_pos hk]
      simpa using hξ
  -- Step 6 (f): the orientation condition, separately on `M' ∩ M₁` and on `M' \ M₁ ⊆ M₂`
  have horient : ∀ᵐ x ∂(μHE[n].restrict M'), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n M' x Q ∧
        IsUnitOrientationOf (((c x).sign : ℝ) • ζ x) Q := by
    have h₁ : ∀ᵐ x ∂(μHE[n].restrict (M' ∩ R₁.carrier)), ∃ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n M' x Q ∧
          IsUnitOrientationOf (((c x).sign : ℝ) • ζ x) Q := by
      filter_upwards [Submission.rsdic_imrep_ae_tangent_orient_of_subset P n U (M' ∩ R₁.carrier)
          M' R₁ hU (hM'meas.inter hM₁) hM'meas inter_subset_right inter_subset_left hM'U hfin,
        ae_restrict_mem (hM'meas.inter hM₁), ae_restrict_of_ae hη₁e] with x hx hxB hxη
      obtain ⟨Q, hQ, hξQ⟩ := hx
      refine ⟨Q, hQ, ?_⟩
      rw [hζ₁ x hxB.2, ← hxη hxB.2]
      exact hsign (c x) _ Q ((hmem x).mp hxB.1).2 hξQ
    have h₂ : ∀ᵐ x ∂(μHE[n].restrict (M' \ R₁.carrier)), ∃ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n M' x Q ∧
          IsUnitOrientationOf (((c x).sign : ℝ) • ζ x) Q := by
      have hsub : M' \ R₁.carrier ⊆ R₂.carrier := fun x hx =>
        ((hmem x).mp hx.1).1.resolve_left hx.2
      filter_upwards [Submission.rsdic_imrep_ae_tangent_orient_of_subset P n U (M' \ R₁.carrier)
          M' R₂ hU (hM'meas.diff hM₁) hM'meas hsub Set.sdiff_subset hM'U hfin,
        ae_restrict_mem (hM'meas.diff hM₁), ae_restrict_of_ae hη₂e] with x hx hxB hxη
      obtain ⟨Q, hQ, hξQ⟩ := hx
      refine ⟨Q, hQ, ?_⟩
      rw [hζ₂ x hxB.2, ← hxη (hsub hxB)]
      exact hsign (c x) _ Q ((hmem x).mp hxB.1).2 hξQ
    have h := (ae_restrict_union_iff (M' ∩ R₁.carrier) (M' \ R₁.carrier) _).mpr ⟨h₁, h₂⟩
    rwa [Set.inter_union_sdiff] at h
  -- Step 6: `R = (M', |c|, sgn(c) ζ)` is an IMRep in `U`
  refine ⟨{ carrier := M'
            mult := fun x => (c x).natAbs
            orient := fun x => ((c x).sign : ℝ) • ζ x
            measurableSet_carrier := hM'meas
            carrier_subset := hM'U
            rectifiable := ?_
            measurable_mult := (measurable_of_countable Int.natAbs).comp hc_meas
            mult_pos := fun x hx => Int.natAbs_pos.mpr ((hmem x).mp hx).2
            locallyIntegrable_mult := hlocint
            aestronglyMeasurable_orient :=
              (((measurable_of_countable fun k : ℤ => (k.sign : ℝ)).comp
                hc_meas).stronglyMeasurable.smul hζ_meas).aestronglyMeasurable
            orients := horient }, ?_⟩
  · -- `M' ⊆ M₁ ∪ M₂ ⊆ ⋃ᵢ (M₁, M₂, M₂, …)ᵢ`
    refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion
      (fun i : ℕ => if i = 0 then R₁.carrier else R₂.carrier) fun i => ?_).mono ?_
    · split_ifs
      exacts [R₁.rectifiable, R₂.rectifiable]
    · intro x hx
      rcases ((hmem x).mp hx).1 with h | h
      · exact mem_iUnion.mpr ⟨0, by simpa using h⟩
      · exact mem_iUnion.mpr ⟨1, by simpa using h⟩
  -- Steps 4 and 7: `c ζ = p₁ 1_{M₁} θ₁ ξ₁ + p₂ 1_{M₂} θ₂ ξ₂` wherever `ηᵢ = ξᵢ` on `Mᵢ` and
  -- `ξ₂ = ±ξ₁` on `M₁ ∩ M₂`, i.e. `Hⁿ`-a.e.
  filter_upwards [hη₁e, hη₂e, hpm] with x hx₁e hx₂e hx₁₂
  show M'.indicator (fun y => ((c y).natAbs : ℝ) • (((c y).sign : ℝ) • ζ y)) x = _
  rw [hind x]
  by_cases hx₁ : x ∈ R₁.carrier <;> by_cases hx₂ : x ∈ R₂.carrier
  · rw [indicator_of_mem hx₁, indicator_of_mem hx₂, hx₁e hx₁, hx₂e hx₂, hζ₁ x hx₁]
    by_cases hxE : η₂ x = η₁ x
    · have hcx : c x = p₁ * R₁.mult x + p₂ * R₂.mult x := by
        simp [hc, hx₁, hx₂, hxE]
      rw [hcx, hxE]
      push_cast
      module
    · have hcx : c x = p₁ * R₁.mult x - p₂ * R₂.mult x := by
        simp [hc, hx₁, hx₂, hxE, sub_eq_add_neg]
      have hneg : η₂ x = -η₁ x := by
        rcases hx₁₂ hx₁ hx₂ with h | h
        · exact absurd (by rw [← hx₂e hx₂, h, hx₁e hx₁]) hxE
        · rw [← hx₂e hx₂, h, hx₁e hx₁]
      rw [hcx, hneg]
      push_cast
      module
  · rw [indicator_of_mem hx₁, indicator_of_notMem hx₂, hx₁e hx₁, hζ₁ x hx₁]
    have hcx : c x = p₁ * R₁.mult x := by simp [hc, hx₁, hx₂]
    rw [hcx]
    push_cast
    module
  · rw [indicator_of_notMem hx₁, indicator_of_mem hx₂, hx₂e hx₂, hζ₂ x hx₁]
    have hcx : c x = p₂ * R₂.mult x := by simp [hc, hx₁, hx₂]
    rw [hcx]
    push_cast
    module
  · rw [indicator_of_notMem hx₁, indicator_of_notMem hx₂, hc_off x hx₁ hx₂, smul_zero,
      smul_zero, add_zero, Int.cast_zero, zero_smul]
/-- **Simon Ch. 6, Remark 3.2(1)** (the representation step): if `1_M θ ξ = p₁ 1_{M₁} θ₁ ξ₁ +
p₂ 1_{M₂} θ₂ ξ₂` holds `Hⁿ`-a.e., then `τ(M, θ, ξ)(ω) = p₁ τ(M₁, θ₁, ξ₁)(ω) + p₂ τ(M₂, θ₂, ξ₂)(ω)`
for every `ω ∈ 𝒟ⁿ(U)`.  A unit orientation has `|⟨α, ξ⟩| ≤ ‖α‖`, so on each carrier `θ⟨ω, ξ⟩` is
dominated by `sup ‖ω‖ · θ 1_{spt ω}`, integrable by local integrability of `θ`.  Thus each action
is `∫ ⟨ω, 1_M θ ξ⟩ dHⁿ` with an integrable integrand, and the identity integrates linearly. -/
theorem Submission.rsdic_imrep_action_int_combination : ∀ (P n : ℕ) (U : Set (Euclid P)) (R₁ R₂ R : IMRep U n) (p₁ p₂ : ℤ), (∀ᵐ x ∂μHE[n], R.carrier.indicator (fun y => (R.mult y : ℝ) • R.orient y) x = (p₁ : ℝ) • R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x + (p₂ : ℝ) • R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x) → ∀ ω : TestFormOn U n, R.action (ω : DifferentialForm (Euclid P) n) = (p₁ : ℝ) * R₁.action (ω : DifferentialForm (Euclid P) n) + (p₂ : ℝ) * R₂.action (ω : DifferentialForm (Euclid P) n) := by
  intro P n U R₁ R₂ R p₁ p₂ hF ω
  -- `ω` is continuous, bounded by `W`, and supported in the compact `K = spt ω ⊆ U`
  obtain ⟨⟨hsmooth, hcpt⟩, hωU⟩ := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous hsmooth
  obtain ⟨W, hW⟩ := hωc.bounded_above_of_compact_support hcpt
  -- Step 1: a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` has `|ξ(α)| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`
  have hunit : ∀ (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q →
      ∀ α : Covector (Euclid P) n, ‖ξ α‖ ≤ ‖α‖ := by
    rintro ξ Q ⟨τ, hτ, -, hξ⟩ α
    have h : ‖α τ‖ ≤ ‖α‖ := by
      calc ‖α τ‖ ≤ ‖α‖ * ∏ i, ‖τ i‖ := α.le_opNorm τ
        _ = ‖α‖ := by simp [hτ.norm_eq_one]
    rcases hξ with h' | h'
    · rw [h' α]; exact h
    · rw [h' α, norm_neg]; exact h
  -- Steps 2–3: for every `R' = (M', θ', ξ')`, `x ↦ (1_{M'} θ' ξ')(x)(ω(x))` is integrable with
  -- integral `τ(R')(ω)`
  have key : ∀ R' : IMRep U n,
      Integrable (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x
        ((ω : DifferentialForm (Euclid P) n) x)) μHE[n] ∧
      ∫ x, R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x
        ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] =
        R'.action (ω : DifferentialForm (Euclid P) n) := by
    intro R'
    have hfun : (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x
        ((ω : DifferentialForm (Euclid P) n) x)) = R'.carrier.indicator
          (fun y => (R'.mult y : ℝ) * R'.orient y ((ω : DifferentialForm (Euclid P) n) y)) := by
      funext x
      by_cases hx : x ∈ R'.carrier
      · simp [Set.indicator_of_mem hx]
      · simp [Set.indicator_of_notMem hx]
    rw [hfun, integrable_indicator_iff R'.measurableSet_carrier,
      integral_indicator R'.measurableSet_carrier]
    refine ⟨?_, rfl⟩
    -- `θ'⟨ω, ξ'⟩` is a.e. strongly measurable: `(L, α) ↦ L(α)` is continuous
    have hmult : Measurable fun y => (R'.mult y : ℝ) := measurable_from_nat.comp R'.measurable_mult
    have hev : Continuous fun p : MultiVector P n × Covector (Euclid P) n => p.1 p.2 :=
      continuous_fst.clm_apply continuous_snd
    have hmeas : AEStronglyMeasurable
        (fun y => (R'.mult y : ℝ) * R'.orient y ((ω : DifferentialForm (Euclid P) n) y))
        (μHE[n].restrict R'.carrier) :=
      hmult.aestronglyMeasurable.mul (hev.comp_aestronglyMeasurable
        (R'.aestronglyMeasurable_orient.prodMk hωc.aestronglyMeasurable))
    -- the dominating function `W θ' 1_K` is integrable on `M'`, as `∫_{M' ∩ K} θ' dHⁿ < ∞`
    have hKm : MeasurableSet (tsupport (ω : DifferentialForm (Euclid P) n)) :=
      (isClosed_tsupport _).measurableSet
    have hint : Integrable (fun y => W * (tsupport (ω : DifferentialForm (Euclid P) n)).indicator
        (fun y => (R'.mult y : ℝ)) y) (μHE[n].restrict R'.carrier) := by
      refine Integrable.const_mul ?_ W
      rw [integrable_indicator_iff hKm, IntegrableOn, Measure.restrict_restrict hKm]
      have h := integrable_toReal_of_lintegral_ne_top
        (μ := μHE[n].restrict (tsupport (ω : DifferentialForm (Euclid P) n) ∩ R'.carrier))
        (f := fun y => (R'.mult y : ℝ≥0∞))
        (measurable_from_nat.comp R'.measurable_mult).aemeasurable
        (by rw [Set.inter_comm]; exact R'.locallyIntegrable_mult _ hcpt hωU)
      simpa using h
    refine hint.mono' hmeas ?_
    filter_upwards [R'.orients] with y hyQ
    obtain ⟨Q, -, hQ⟩ := hyQ
    by_cases hy : y ∈ tsupport (ω : DifferentialForm (Euclid P) n)
    · rw [Set.indicator_of_mem hy]
      calc ‖(R'.mult y : ℝ) * R'.orient y ((ω : DifferentialForm (Euclid P) n) y)‖
          = (R'.mult y : ℝ) * ‖R'.orient y ((ω : DifferentialForm (Euclid P) n) y)‖ := by
            rw [norm_mul, Real.norm_natCast]
        _ ≤ (R'.mult y : ℝ) * ‖(ω : DifferentialForm (Euclid P) n) y‖ :=
            mul_le_mul_of_nonneg_left (hunit _ _ hQ _) (Nat.cast_nonneg _)
        _ ≤ (R'.mult y : ℝ) * W := mul_le_mul_of_nonneg_left (hW y) (Nat.cast_nonneg _)
        _ = W * (R'.mult y : ℝ) := mul_comm _ _
    · rw [Set.indicator_of_notMem hy, image_eq_zero_of_notMem_tsupport hy, map_zero, mul_zero,
        norm_zero, mul_zero]
  -- Step 4: integrate the a.e. identity evaluated at `ω(x)`, using linearity of the integral
  obtain ⟨-, he⟩ := key R
  obtain ⟨hi₁, he₁⟩ := key R₁
  obtain ⟨hi₂, he₂⟩ := key R₂
  rw [← he, ← he₁, ← he₂, ← integral_const_mul, ← integral_const_mul,
    ← integral_add (hi₁.const_mul _) (hi₂.const_mul _)]
  refine integral_congr_ae ?_
  filter_upwards [hF] with x hx
  rw [hx, add_apply, smul_apply, smul_apply, smul_eq_mul, smul_eq_mul]

/-- **Simon Ch. 6, Remark 3.2(1)**: if `T₁, T₂ ∈ 𝒟ₙ(U)` are integer multiplicity and
`p₁, p₂ ∈ ℤ`, then `S = p₁T₁ + p₂T₂` is integer multiplicity.  Write `Tᵢ = τ(Mᵢ, θᵢ, ξᵢ)`.  The
orientations agree up to sign `Hⁿ`-a.e. on `M₁ ∩ M₂`, which gives a triple `(M', θ', ξ')` in `U`
with `θ'ξ'1_{M'} = p₁θ₁ξ₁1_{M₁} + p₂θ₂ξ₂1_{M₂}` `Hⁿ`-a.e.; integrating `⟨ω, ·⟩` for
`ω ∈ 𝒟ⁿ(U)` then gives `S = τ(M', θ', ξ')`. -/
theorem Submission.rsd_isIntegerMultiplicity_int_combination : ∀ (P n : ℕ) (U : Set (Euclid P)) (T₁ T₂ S : GeometricCurrentOn U n) (p₁ p₂ : ℤ), IsOpen U → IsIntegerMultiplicity T₁ → IsIntegerMultiplicity T₂ → (∀ ω : TestFormOn U n, S ω = (p₁ : ℝ) * T₁ ω + (p₂ : ℝ) * T₂ ω) → IsIntegerMultiplicity S := by
  intro P n U T₁ T₂ S p₁ p₂ hU hT₁ hT₂ hS
  -- Representations `T₁ = τ(M₁, θ₁, ξ₁)` and `T₂ = τ(M₂, θ₂, ξ₂)`.
  obtain ⟨R₁, hR₁⟩ := hT₁
  obtain ⟨R₂, hR₂⟩ := hT₂
  -- A triple `R = (M', θ', ξ')` in `U` with `θ'ξ'1_{M'} = p₁θ₁ξ₁1_{M₁} + p₂θ₂ξ₂1_{M₂}` a.e.
  obtain ⟨R, hR⟩ := Submission.rsdic_exists_imrep_int_combination P n U R₁ R₂ p₁ p₂ hU
  -- Hence `τ(R)(ω) = p₁τ(R₁)(ω) + p₂τ(R₂)(ω) = p₁T₁(ω) + p₂T₂(ω) = S(ω)`.
  refine ⟨R, fun ω => ?_⟩
  rw [hS ω, hR₁ ω, hR₂ ω,
    Submission.rsdic_imrep_action_int_combination P n U R₁ R₂ R p₁ p₂ hR ω]

/-- **Integer multiplicity calculus** (Simon Ch. 3, Remark 1.5(2) and the proof of 1.6 "⇒";
Ch. 6, Remarks 2.6, 2.9 and 3.2(1)).
(a) Locality: for Borel `M ⊆ M' ⊆ U`, `M'` locally `Hⁿ`-finite in the open `U`, `TₓM = TₓM'` for
`Hⁿ`-a.e. `x ∈ M` (tangent locality with the two sides exchanged).
(b) Restriction: for an `IMRep` `R = (M, θ, ξ)` in the open `U` and Borel `E`, `(M ∩ E, θ, ξ)` is
an `IMRep`: `M` is locally `Hⁿ`-finite in `U` (`θ ≥ 1` on `M`), so (a) for `M ∩ E ⊆ M` transfers
`TₓM` to `Tₓ(M ∩ E)` a.e. on `M ∩ E`; it defines a current `τ(M ∩ E, θ, ξ)`.
(c) Differences: `A − B = 1 · A + (−1) · B` is an integer combination.
(d) Orientation bound: `Hⁿ`-a.e. on `M`, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ` orthonormal, so
`|⟨α, ξ(x)⟩| = |α(τ)| ≤ |α|`. -/
theorem Submission.cmc_imRep_locality_restrict_sub : (∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) := by
  -- (a) tangent locality for `M ⊆ M'`, with the two sides of `↔` exchanged
  have ha : ∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M →
      MeasurableSet M' → M ⊆ M' → M' ⊆ U →
      (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) →
      ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q := by
    intro P n U M M' hU hM hM' hMM' hM'U hfin
    filter_upwards [Submission.rsdic_ae_tangent_iff_of_subset P n U M M' hU hM hM' hMM' hM'U
      hfin] with x hx Q
    exact (hx Q).symm
  refine ⟨ha, ?_, ?_, ?_⟩
  · -- (b) the restriction `(M ∩ E, θ, ξ)` of `R = (M, θ, ξ)`
    intro P n U R E hU hE
    have hME : MeasurableSet (R.carrier ∩ E) := R.measurableSet_carrier.inter hE
    -- `TₓM = Tₓ(M ∩ E)` a.e. on `M ∩ E`, `M` being locally `Hⁿ`-finite in `U`
    have htan : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ E)), ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n R.carrier x Q →
          HasApproximateTangentSpaceAt n (R.carrier ∩ E) x Q := by
      filter_upwards [ha P n U (R.carrier ∩ E) R.carrier hU hME R.measurableSet_carrier
        inter_subset_left R.carrier_subset fun K hK hKU =>
          (Submission.rsd_imrep_compact_measure_ne_top P n U R K hK hKU).1] with x hx Q
      exact (hx Q).2
    obtain ⟨R', hcar, hmult, horient⟩ := Submission.regcomp_rim_sub_imrep P n U (R.carrier ∩ E) R
      R.mult hME inter_subset_left R.measurable_mult (fun x hx => R.mult_pos x hx.1)
      (fun x _ => le_rfl) htan
    -- the current `τ(M ∩ E, θ, ξ)`
    obtain ⟨A, hA⟩ := Submission.dtc_imrep_current P n U R'
    exact ⟨A, R', hA, hcar, hmult, horient⟩
  · -- (c) `A − B = 1 · A + (−1) · B`
    intro P n U A B hU hA hB
    refine Submission.rsd_isIntegerMultiplicity_int_combination P n U A B (A - B) 1 (-1) hU hA hB
      fun ω => ?_
    show A ω - B ω = _
    push_cast
    ring
  · -- (d) `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ` orthonormal, a.e. on `M`
    intro P n U R
    filter_upwards [R.orients] with x hx α
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    have hατ := Submission.regcomp_covector_eval_orthonormal_le P n α τ hτ
    rcases hξ with h | h
    · rw [h α]
      exact hατ
    · rw [h α, abs_neg]
      exact hατ

/-- **Weak continuity of pull-backs under uniformly convergent Lipschitz maps** (step 6 (B4) of
the proof that Lipschitz push-forwards of integer multiplicity currents are integer multiplicity;
Simon Ch. 6, 2.29 and 3.6).  Let `Hⱼ, H₀ : ℝᵐ → ℝ^{N'}` be `L`-Lipschitz with `Hⱼ → H₀`
uniformly, `w ∈ L¹(ℝᵐ)` and `ω` a continuous, compactly supported `m`-form on `ℝ^{N'}`.  Then
`∫ w ω(Hⱼ)(DHⱼ e) → ∫ w ω(H₀)(DH₀ e)`.  For `I : Fin m → Fin N'` let
`ω_I(y) = ω(y)(e'_{I 0}, …, e'_{I (m-1)})` and `M_I(H)(u) = det ((DH(u) e_t)_{I s})_{s,t}`.
The coordinate expansion of `m`-covectors gives `w ω(H)(DH e) = (m!)⁻¹ Σ_I w ω_I(H) M_I(H)`
pointwise.  Every summand is integrable (`M_I(H)` is measurable and bounded by `m! Lᵐ`, and `ω_I`
is bounded), so the integral splits over `I`; each summand converges by the scalar weak continuity
with the continuous, compactly supported coefficient `ω_I`. -/
theorem Submission.cmcdt_lpi_pullback_weak_continuity : ∀ (m N' : ℕ) (L : NNReal) (H : ℕ → Euclid m → Euclid N') (H₀ : Euclid m → Euclid N') (w : Euclid m → ℝ) (ω : DifferentialForm (Euclid N') m), (∀ j, LipschitzWith L (H j)) → LipschitzWith L H₀ → TendstoUniformly H H₀ atTop → Integrable w → Continuous ω → HasCompactSupport ω → Tendsto (fun j => ∫ u, w u * ω (H j u) (fun a => fderiv ℝ (H j) u (EuclideanSpace.single a 1))) atTop (𝓝 (∫ u, w u * ω (H₀ u) (fun a => fderiv ℝ H₀ u (EuclideanSpace.single a 1)))) := by
  intro m N' L H H₀ w ω hH hH₀ hHH₀ hw hωc hωs
  -- the coefficients `ω_I(y) = ω(y)(e'_{I 0}, …, e'_{I (m-1)})` are continuous with compact support
  have hωIc : ∀ I : Fin m → Fin N',
      Continuous fun y => ω y (fun c => EuclideanSpace.single (I c) (1 : ℝ)) := fun I =>
    hωc.eval_const _
  have hωIs : ∀ I : Fin m → Fin N',
      HasCompactSupport fun y => ω y (fun c => EuclideanSpace.single (I c) (1 : ℝ)) := fun I =>
    hωs.comp_left (g := fun α : Covector (Euclid N') m =>
      α (fun c => EuclideanSpace.single (I c) (1 : ℝ))) (by simp)
  -- step 1: `w ω(G)(DG e) = (m!)⁻¹ Σ_I w ω_I(G) M_I(G)` pointwise (coordinate expansion)
  have hexp : ∀ (G : Euclid m → Euclid N') (u : Euclid m),
      w u * ω (G u) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)) =
        (m.factorial : ℝ)⁻¹ * ∑ I : Fin m → Fin N',
          w u * (ω (G u) (fun c => EuclideanSpace.single (I c) (1 : ℝ)) *
            Matrix.det (Matrix.of fun s t => fderiv ℝ G u (EuclideanSpace.single t 1) (I s))) := by
    intro G u
    have hm : (m.factorial : ℝ) ≠ 0 := by exact_mod_cast m.factorial_ne_zero
    rw [← Finset.mul_sum, ← Submission.dor_lmb_fcd_jwc_covector_det_expansion N' m (ω (G u))
      (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)), mul_left_comm (w u),
      inv_mul_cancel_left₀ hm]
  -- step 2: the minors are measurable and bounded by `m! Lᵐ` and `ω_I` is bounded, so every
  -- summand is integrable and the integral splits over `I`
  have hint : ∀ G : Euclid m → Euclid N', LipschitzWith L G →
      ∫ u, w u * ω (G u) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)) =
        (m.factorial : ℝ)⁻¹ * ∑ I : Fin m → Fin N', ∫ u,
          w u * (ω (G u) (fun c => EuclideanSpace.single (I c) (1 : ℝ)) *
            Matrix.det (Matrix.of fun s t => fderiv ℝ G u (EuclideanSpace.single t 1) (I s))) := by
    intro G hG
    have hI : ∀ I : Fin m → Fin N', Integrable fun u =>
        w u * (ω (G u) (fun c => EuclideanSpace.single (I c) (1 : ℝ)) *
          Matrix.det (Matrix.of fun s t => fderiv ℝ G u (EuclideanSpace.single t 1) (I s))) := by
      intro I
      obtain ⟨hmeas, hbd⟩ :=
        Submission.cmcdt_lpi_pc_minor_measurable_bound m N' m L G I (fun t => t) hG
      obtain ⟨C, hC⟩ := (hωIc I).bounded_above_of_compact_support (hωIs I)
      refine hw.mul_bdd (c := C * ((m.factorial : ℝ) * (L : ℝ) ^ m))
        (((hωIc I).comp hG.continuous).measurable.mul hmeas).aestronglyMeasurable
        (Eventually.of_forall fun u => ?_)
      rw [norm_mul]
      exact mul_le_mul (hC _) ((Real.norm_eq_abs _).trans_le (hbd u)) (norm_nonneg _)
        ((norm_nonneg _).trans (hC 0))
    rw [← integral_finsetSum _ fun I _ => hI I, ← integral_const_mul]
    exact integral_congr_ae (Eventually.of_forall (hexp G))
  -- step 3: each summand converges by the scalar weak continuity with coefficient `ω_I`
  have hlim := (tendsto_finsetSum (Finset.univ : Finset (Fin m → Fin N')) fun I _ =>
    Submission.cmcdt_lpi_pc_scalar_weak_continuity m N' m L H H₀ I (fun t => t) w
      (fun y => ω y (fun c => EuclideanSpace.single (I c) (1 : ℝ))) hH hH₀ hHH₀ hw (hωIc I)
      (hωIs I)).const_mul ((m.factorial : ℝ)⁻¹)
  rw [hint H₀ hH₀]
  exact hlim.congr fun j => (hint (H j) (hH j)).symm

/-- **Integer density on one injective Lipschitz piece** (Simon Ch. 6, 3.6–3.9: the multiplicity
of `f#T` on a piece where `f` is injective).  Let `H : ℝⁿ → ℝᴾ` be `L`-Lipschitz, injective on the
Borel set `B` with injective `DH(u)` at every `u ∈ B`, and let `g : ℝⁿ → ℤ` be integrable and
nonzero on `B`.  With `h` a Borel inverse of `H|B` (Lusin–Souslin), `m = 1_{H(B)} · (g ∘ h)` is
Borel, integer-valued and `m ∘ H = g` on `B`.  For injective linear `A`, the area formula on the
unit ball and `Hⁿ(A(S)) ≤ ‖A‖ⁿ Hⁿ(S)` give `JA ≤ ‖A‖ⁿ`; as `‖DH‖ ≤ L`, `JH ≤ Lⁿ` on `B`, and the
area formula gives `∫_{H(B)} |m| dHⁿ = ∫_B JH |g| ≤ Lⁿ ∫_B |g|`.  Since `|m| ≥ 1` on `H(B)`, this
bounds `Hⁿ(H(B)) < ∞`. -/
theorem Submission.cmcdt_lpi_pc_piece_multiplicity : ∀ (P n : ℕ) (L : NNReal) (H : Euclid n → Euclid P) (B : Set (Euclid n)) (g : Euclid n → ℤ), LipschitzWith L H → MeasurableSet B → InjOn H B → (∀ a ∈ B, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → Measurable g → IntegrableOn (fun u => (g u : ℝ)) B → (∀ u ∈ B, g u ≠ 0) → ∃ m : Euclid P → ℝ, Measurable m ∧ (∀ y, ∃ z : ℤ, m y = z) ∧ (∀ u ∈ B, m (H u) = g u) ∧ μHE[n] (H '' B) ≠ ∞ ∧ ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] ≤ (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ := by
  intro P n L H B g hH hB hinj hdiff hg hgi hg0
  -- `G A = √det(⟨A eₖ, A eₗ⟩)`, the Gram-determinant Jacobian of a linear `A : ℝⁿ → ℝᴾ`
  obtain ⟨G, hG⟩ : ∃ G : (Euclid n →L[ℝ] Euclid P) → ℝ, ∀ A, G A = Real.sqrt (Matrix.det
      (Matrix.of fun k l : Fin n => inner ℝ (A (EuclideanSpace.single k 1)) (A (EuclideanSpace.single l 1)))) :=
    ⟨_, fun A => rfl⟩
  -- Lusin–Souslin: `H(B)` is Borel and `h ∘ H = id` on `B` for a Borel `h`
  obtain ⟨hN, h, hh, hhH⟩ := Submission.cmcdt_lpi_pc_measurable_inverse P n H B
    hH.continuous.continuousOn hB hinj
  -- the density `m = 1_{H(B)} · (g ∘ h)`
  obtain ⟨m, hm⟩ : ∃ m : Euclid P → ℝ, m = (H '' B).indicator fun y => (g (h y) : ℝ) := ⟨_, rfl⟩
  have hmH : ∀ u ∈ B, m (H u) = g u := fun u hu => by
    simp only [hm, indicator_of_mem (mem_image_of_mem H hu), hhH u hu]
  -- `G A ≤ ‖A‖ⁿ`: the area formula for `A` on the unit ball `B₁` gives `Hⁿ(A(B₁)) = G A · |B₁|`,
  -- while `A` is `‖A‖`-Lipschitz, so `Hⁿ(A(B₁)) ≤ ‖A‖ⁿ Hⁿ(B₁) = ‖A‖ⁿ |B₁|`
  have hGle : ∀ A : Euclid n →L[ℝ] Euclid P, Injective A →
      ENNReal.ofReal (G A) ≤ (‖A‖₊ : ℝ≥0∞) ^ n := by
    intro A hA
    have harea := (Submission.codim1_lura_gram_area_formula n P A).2 (ball 0 1) measurableSet_ball
      (fun x _ => A.differentiableAt) (fun x _ => by rw [A.fderiv]; exact hA) hA.injOn
      (fun _ => 1)
    simp only [A.fderiv, ← hG, mul_one, setLIntegral_one, setLIntegral_const] at harea
    have hlip := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (A.lipschitzWith.lipschitzOnWith (s := ball (0 : Euclid n) 1))
    rw [harea, EuclideanSpace.euclideanHausdorffMeasure_eq_volume n] at hlip
    exact (ENNReal.mul_le_mul_iff_left (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
      measure_ball_lt_top.ne).1 hlip
  -- the Jacobian bound `JH ≤ Lⁿ` on `B`, from `‖DH(u)‖ ≤ L`
  have hJ : ∀ u ∈ B, ENNReal.ofReal (G (fderiv ℝ H u)) ≤ (L : ℝ≥0∞) ^ n := by
    intro u hu
    refine (hGle _ (hdiff u hu).2).trans ?_
    have hle : ‖fderiv ℝ H u‖ ≤ L := norm_fderiv_le_of_lipschitz ℝ hH
    gcongr
    exact_mod_cast hle
  -- the area formula for `H` on `B` with weight `|m|`, and `m ∘ H = g` on `B`
  have hbound : ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] ≤ (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ := by
    have hareaH := (Submission.codim1_lura_gram_area_formula n P H).2 B hB
      (fun u hu => (hdiff u hu).1) (fun u hu => (hdiff u hu).2) hinj fun y => ‖m y‖ₑ
    simp only [← hG] at hareaH
    calc ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n]
        = ∫⁻ u in B, ENNReal.ofReal (G (fderiv ℝ H u)) * ‖m (H u)‖ₑ := hareaH
      _ ≤ ∫⁻ u in B, (L : ℝ≥0∞) ^ n * ‖(g u : ℝ)‖ₑ := by
          refine setLIntegral_mono' hB fun u hu => ?_
          rw [hmH u hu]
          gcongr
          exact hJ u hu
      _ = (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ :=
          lintegral_const_mul' _ _ (ENNReal.pow_ne_top ENNReal.coe_ne_top)
  -- `|m| ≥ 1` on `H(B)` (`g` is a nonzero integer on `B`), so `Hⁿ(H(B)) ≤ ∫_{H(B)} |m| dHⁿ`
  have hmeasN : μHE[n] (H '' B) ≤ ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] := by
    rw [← setLIntegral_one]
    refine setLIntegral_mono' hN ?_
    rintro _ ⟨u, hu, rfl⟩
    rw [hmH u hu, Real.enorm_eq_ofReal_abs, ENNReal.one_le_ofReal, ← Int.cast_abs]
    exact_mod_cast Int.one_le_abs (hg0 u hu)
  refine ⟨m, ?_, fun y => ?_, hmH, ?_, hbound⟩
  · rw [hm]
    exact ((measurable_of_countable fun z : ℤ => (z : ℝ)).comp (hg.comp hh)).indicator hN
  · by_cases hy : y ∈ H '' B
    · exact ⟨g (h y), by rw [hm, indicator_of_mem hy]⟩
    · exact ⟨0, by rw [hm, indicator_of_notMem hy, Int.cast_zero]⟩
  · exact (hmeasN.trans_lt (hbound.trans_lt (ENNReal.mul_lt_top
      (ENNReal.pow_lt_top ENNReal.coe_lt_top) hgi.2))).ne
/-- **Simon Ch. 6, 3.5 and 3.7** (the induced orientation of a bi-Lipschitz piece): let
`H : ℝⁿ → ℝᴾ` be `L`-Lipschitz, `B ⊆ ℝⁿ` Borel and `κ > 0` with `κ|a − a'| ≤ |H a − H a'|` on
`B`, and let `H` be differentiable with injective derivative at every point of `B`.  With
`v(u) = (DH(u)e₁, …, DH(u)eₙ)` and `J(u) = √det(⟨vₐ(u), v_b(u)⟩)`, the field
`η = 1_{H(B)} · ξ ∘ H⁻¹`, `ξ(u) = J(u)⁻¹ (α ↦ α(v(u)))`, is strongly measurable; for `u ∈ B`,
`η(H u)` is a unit orientation of `range DH(u)` with `J(u) η(H u)(α) = α(v(u))`; and `η` orients
the approximate tangent space of `H(B)` at `Hⁿ`-a.e. point of `H(B)`.
For an orthonormal basis `τ` of `range DH(u)` and the coordinate matrix `M` of `v(u)` in `τ`,
`α(v(u)) = det M · α(τ)` and `⟨vₐ, v_b⟩ = (MᵀM)ₐ_b`, so `J(u) = |det M| > 0` and
`η(H u) = ±(α ↦ α(τ))`.  The tangent planes `range DH(u)` exist at `H u` for a.e. `u ∈ B`, and
the area formula sends the exceptional `λ`-null set to an `Hⁿ`-null set. -/
theorem Submission.cmcdt_lpi_pc_piece_orientation : ∀ (P n : ℕ) (L : NNReal) (κ : ℝ) (H : Euclid n → Euclid P) (B : Set (Euclid n)), LipschitzWith L H → MeasurableSet B → 0 < κ → (∀ a ∈ B, ∀ a' ∈ B, κ * ‖a - a'‖ ≤ ‖H a - H a'‖) → (∀ a ∈ B, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → ∃ η : Euclid P → MultiVector P n, StronglyMeasurable η ∧ (∀ u ∈ B, IsUnitOrientationOf (η (H u)) (LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)) ∧ ∀ α : Covector (Euclid P) n, Real.sqrt (Matrix.det (Matrix.of fun a b : Fin n => inner ℝ (fderiv ℝ H u (EuclideanSpace.single a 1)) (fderiv ℝ H u (EuclideanSpace.single b 1)))) * η (H u) α = α (fun a => fderiv ℝ H u (EuclideanSpace.single a 1))) ∧ ∀ᵐ y ∂(μHE[n].restrict (H '' B)), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n (H '' B) y Q ∧ IsUnitOrientationOf (η y) Q := by
  intro P n L κ H B hH hB hκ hcolip hreg
  -- `H` is injective on `B`, so `H(B)` is Borel with a Borel left inverse `h`
  have hinjOn : InjOn H B := by
    intro a ha a' ha' hHa
    have h := hcolip a ha a' ha'
    rw [hHa, sub_self, norm_zero] at h
    have h' : ‖a - a'‖ ≤ 0 := le_of_mul_le_mul_left (by simpa using h) hκ
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
  obtain ⟨hN, h, hh, hhH⟩ := Submission.cmcdt_lpi_pc_measurable_inverse P n H B
    hH.continuous.continuousOn hB hinjOn
  -- `v(u) = (DH(u)eₐ)ₐ`, `J(u) = √det(⟨vₐ(u), v_b(u)⟩)`, `ev z = (α ↦ α(z))`, `ξ(u) = J(u)⁻¹ ev(v(u))`
  let v : Euclid n → Fin n → Euclid P := fun u a => fderiv ℝ H u (EuclideanSpace.single a 1)
  let J : Euclid n → ℝ := fun u =>
    Real.sqrt (Matrix.det (Matrix.of fun a b : Fin n => inner ℝ (v u a) (v u b)))
  let ev : (Fin n → Euclid P) → MultiVector P n := fun z =>
    ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ z
  let ξ : Euclid n → MultiVector P n := fun u => (J u)⁻¹ • ev (v u)
  have hξ : ∀ u (α : Covector (Euclid P) n), ξ u α = (J u)⁻¹ * α (v u) := fun _ _ => rfl
  -- `ev z = ∑_f (∏ₐ z_{a, f(a)}) ev(e_{f(0)}, …, e_{f(n-1)})`, a finite sum of constant vectors
  have hexp : ∀ z : Fin n → Euclid P, ev z = ∑ f : Fin n → Fin P,
      (∏ a, z a (f a)) • ev (fun a => EuclideanSpace.single (f a) (1 : ℝ)) := by
    intro z
    ext α
    have hz : z = fun a => ∑ i, z a i • EuclideanSpace.single i (1 : ℝ) := by
      funext a
      have h := (EuclideanSpace.basisFun (Fin P) ℝ).sum_repr (z a)
      simp only [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply] at h
      exact h.symm
    have hα : α z = α (fun a => ∑ i, z a i • EuclideanSpace.single i (1 : ℝ)) := congrArg α hz
    simp only [ev, ContinuousAlternatingMap.apply_apply, _root_.sum_apply, _root_.smul_apply,
      smul_eq_mul]
    rw [hα, α.map_sum]
    refine Finset.sum_congr rfl fun f _ => ?_
    rw [α.map_smul_univ, smul_eq_mul]
  -- strong measurability: `J` is Borel and every coefficient `∏ₐ (DH(u)eₐ)_{f(a)}` is Borel
  -- (instance search misses `ContinuousAdd (MultiVector P n)`: the `Add` of the `Covector`-domain
  -- operator space does not unify with that of its `AddGroup` at instance transparency)
  have : ContinuousAdd (MultiVector P n) :=
    (inferInstance : IsTopologicalAddGroup (MultiVector P n)).toContinuousAdd
  have hevm : StronglyMeasurable fun u => ev (v u) := by
    have h : (fun u => ev (v u)) = fun u => ∑ f : Fin n → Fin P,
        (∏ a, v u a (f a)) • ev (fun a => EuclideanSpace.single (f a) (1 : ℝ)) :=
      funext fun u => hexp (v u)
    rw [h]
    refine Finset.stronglyMeasurable_fun_sum Finset.univ fun f _ => ?_
    refine (Measurable.stronglyMeasurable ?_).smul_const _
    refine Finset.measurable_prod Finset.univ fun a _ => ?_
    exact (PiLp.continuous_apply 2 (fun _ : Fin P => ℝ) (f a)).measurable.comp
      (measurable_fderiv_apply_const ℝ H (EuclideanSpace.single a 1))
  have hJm : Measurable J := (Submission.codim1_lura_gram_area_formula n P H).1
  have hξm : StronglyMeasurable ξ := hJm.inv.stronglyMeasurable.smul hevm
  -- `η = 1_{H(B)} · ξ ∘ h`
  refine ⟨(H '' B).indicator (fun y => ξ (h y)), (hξm.comp_measurable hh).indicator hN, ?_⟩
  have hηH : ∀ u ∈ B, (H '' B).indicator (fun y => ξ (h y)) (H u) = ξ u := fun u hu =>
    (Set.indicator_of_mem (Set.mem_image_of_mem H hu) _).trans (congrArg ξ (hhH u hu))
  -- `ξ(u)` is a unit orientation of `range DH(u)` and `J(u) ξ(u)(α) = α(v(u))`
  have hi : ∀ u ∈ B, IsUnitOrientationOf (ξ u)
      (LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)) ∧
      ∀ α : Covector (Euclid P) n, J u * ξ u α = α (v u) := by
    intro u hu
    have hinj := (hreg u hu).2
    set W := LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)
    have hWdim : Module.finrank ℝ W = n := by
      rw [LinearMap.finrank_range_of_inj hinj, finrank_euclideanSpace_fin]
    -- an orthonormal basis `τ` of `W` and the coordinate matrix `M` of `v(u)` in it
    let b : OrthonormalBasis (Fin n) ℝ W := (stdOrthonormalBasis ℝ W).reindex (finCongr hWdim)
    let τ : Fin n → Euclid P := fun i => (b i : Euclid P)
    let w : Fin n → W := fun a =>
      ⟨v u a, LinearMap.mem_range_self (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)
        (EuclideanSpace.single a 1)⟩
    let M : Matrix (Fin n) (Fin n) ℝ := b.toBasis.toMatrix w
    have hτ : Orthonormal ℝ τ := b.orthonormal.comp_linearIsometry W.subtypeₗᵢ
    have hτspan : Submodule.span ℝ (Set.range τ) = W := by
      have hr : Set.range τ = W.subtype '' Set.range b := Set.range_comp _ _
      rw [hr, Submodule.span_image, ← OrthonormalBasis.coe_toBasis, b.toBasis.span_eq,
        Submodule.map_subtype_top]
    -- `α(v(u)) = det M · α(τ)`: restrict `α` to `W` and compare with the basis determinant
    have hαv : ∀ α : Covector (Euclid P) n, α (v u) = M.det * α τ := by
      intro α
      have h := (α.toAlternatingMap.compLinearMap W.subtype).eq_smul_basis_det b.toBasis
      calc α (v u) = (α.toAlternatingMap.compLinearMap W.subtype) w := rfl
        _ = ((α.toAlternatingMap.compLinearMap W.subtype) b.toBasis • b.toBasis.det) w := by
          rw [← h]
        _ = M.det * α τ := by
          simp only [AlternatingMap.smul_apply, b.toBasis.det_apply, smul_eq_mul]
          exact mul_comm _ _
    -- `⟨vₐ, v_c⟩ = (MᵀM)ₐ_c` because `τ` is orthonormal, so `J(u) = |det M|`
    have hgram : (Matrix.of fun a c : Fin n => inner ℝ (v u a) (v u c)) = M.transpose * M := by
      ext a c
      have h1 : inner ℝ (v u a) (v u c) = inner ℝ (w a) (w c) :=
        (Submodule.coe_inner W (w a) (w c)).symm
      rw [Matrix.of_apply, Matrix.mul_apply, h1, ← b.sum_inner_mul_inner (w a) (w c)]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Matrix.transpose_apply, real_inner_comm (b i) (w a)]
      simp only [M, b.toBasis.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
        OrthonormalBasis.repr_apply_apply]
    have hJM : J u = |M.det| := by
      show Real.sqrt (Matrix.det (Matrix.of fun a c : Fin n => inner ℝ (v u a) (v u c))) = |M.det|
      rw [hgram, Matrix.det_mul, Matrix.det_transpose, ← sq, Real.sqrt_sq_eq_abs]
    -- `v(u)` is linearly independent (`DH(u)` is injective), so `det M ≠ 0`
    have hw : LinearIndependent ℝ w := by
      have h0 : LinearIndependent ℝ
          (fun a : Fin n => (EuclideanSpace.single a (1 : ℝ) : Euclid n)) := by
        have h := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis.linearIndependent
        have he : ⇑(EuclideanSpace.basisFun (Fin n) ℝ).toBasis =
            fun a : Fin n => (EuclideanSpace.single a (1 : ℝ) : Euclid n) := by
          funext a
          rw [OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply]
        rwa [he] at h
      have h1 : LinearIndependent ℝ (v u) := h0.map' _ (LinearMap.ker_eq_bot.2 hinj)
      exact LinearIndependent.of_comp W.subtype h1
    have hdet : M.det ≠ 0 := by
      have hspan : Submodule.span ℝ (Set.range w) = ⊤ :=
        hw.span_eq_top_of_card_eq_finrank' (by rw [Fintype.card_fin, hWdim])
      exact ((b.toBasis.is_basis_iff_det).1 ⟨hw, hspan⟩).ne_zero
    have hJpos : 0 < J u := by
      rw [hJM]
      exact abs_pos.2 hdet
    refine ⟨⟨τ, hτ, hτspan, ?_⟩, fun α => ?_⟩
    · rcases hdet.lt_or_gt with hneg | hpos
      · right
        intro α
        rw [hξ, hαv, hJM, abs_of_neg hneg, inv_neg, neg_mul, inv_mul_cancel_left₀ hdet]
      · left
        intro α
        rw [hξ, hαv, hJM, abs_of_pos hpos, inv_mul_cancel_left₀ hdet]
    · rw [hξ, mul_inv_cancel_left₀ hJpos.ne']
  refine ⟨fun u hu => ?_, ?_⟩
  · rw [hηH u hu]
    exact hi u hu
  · -- the tangent planes `range DH(u)` exist off a `λ`-null set `E ∩ B`, whose image is `Hⁿ`-null
    have htan := Submission.ptd_piece_image_approxTangent_ae P n H B L κ hH hB hκ hcolip hreg
    rw [ae_iff] at htan
    obtain ⟨E, hEsub, hEmeas, hE0⟩ := exists_measurable_superset_of_null htan
    rw [Measure.restrict_apply hEmeas] at hE0
    have hnull : μHE[n] (H '' (E ∩ B)) = 0 := by
      have harea := (Submission.codim1_lura_gram_area_formula n P H).2 (E ∩ B)
        (hEmeas.inter hB) (fun x hx => (hreg x hx.2).1) (fun x hx => (hreg x hx.2).2)
        (hinjOn.mono inter_subset_right) (fun _ => 1)
      rwa [setLIntegral_one, Measure.restrict_eq_zero.2 hE0, lintegral_zero_measure] at harea
    filter_upwards [ae_restrict_mem hN, ae_restrict_of_ae (measure_eq_zero_iff_ae_notMem.1 hnull)]
      with y hyN hyE
    obtain ⟨u, hu, rfl⟩ := hyN
    refine ⟨LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P), ?_, ?_⟩
    · by_contra hc
      have huE : u ∈ E := hEsub hc
      exact hyE ⟨u, ⟨huE, hu⟩, rfl⟩
    · rw [hηH u hu]
      exact (hi u hu).1

/-- **The Lipschitz image of an integer-weighted bi-Lipschitz piece** (Simon Ch. 6, 3.5–3.9).
Let `H : ℝⁿ → ℝᴾ` be `L`-Lipschitz, let `B ⊆ ℝⁿ` be Borel with `κ |a − a'| ≤ |H a − H a'|` on `B`
(`κ > 0`), `H` differentiable with injective `DH` at every point of `B`, and let `g : ℝⁿ → ℤ` be
measurable, integrable and nonzero on `B`.
Assume (L3) `|α(τ)| ≤ |α|` for orthonormal `τ`, and (IMC)(b): the restriction of an `IMRep` to
a Borel set represents a current.  Then `H_♯(g [[B]])` is an integer multiplicity current `Φ`
with `M(Φ) ≤ Lⁿ ∫_B |g|` and `Φ(ω) = ∫_B g ω(H)(DH e₀, …, DH eₙ₋₁)`.

Proof sketch:
* `H` is injective on `B`, so `N = H(B)` is Borel; `m = g ∘ H⁻¹` is an integer density with
  `∫_N |m| dHⁿ ≤ Lⁿ ∫_B |g|`, and `η` orients `N` `Hⁿ`-a.e. with `J η(H) = DH e₀ ∧ ⋯ ∧ DH eₙ₋₁`
  on `B`, `J` the Gram Jacobian.
* `(N, m, η)` is an `IMRep` acting by `ω ↦ ∫_N m ⟨ω, η⟩ dHⁿ` (`N ⊆ range H` is rectifiable), and
  (IMC)(b) with `E = ℝᴾ` makes it represent a current `Φ`.
* The Gram area formula gives `Φ(ω) = ∫_B J g ⟨ω(H), η(H)⟩ = ∫_B g ω(H)(DH e)`.
* For admissible `ω`, (L3) and the unit orientation give `|⟨ω, η⟩| ≤ 1` on `N`, so
  `M(Φ) ≤ ∫_N |m| dHⁿ ≤ Lⁿ ∫_B |g|`. -/
theorem Submission.cmcdt_lpi_pc_piece_current : (∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α) → (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) → ∀ (P n : ℕ) (L : NNReal) (κ : ℝ) (H : Euclid n → Euclid P) (B : Set (Euclid n)) (g : Euclid n → ℤ), LipschitzWith L H → MeasurableSet B → 0 < κ → (∀ a ∈ B, ∀ a' ∈ B, κ * ‖a - a'‖ ≤ ‖H a - H a'‖) → (∀ a ∈ B, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → Measurable g → IntegrableOn (fun u => (g u : ℝ)) B → (∀ u ∈ B, g u ≠ 0) → ∃ Φ : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity Φ ∧ Φ.mass ≤ (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) n, Φ ω = ∫ u in B, (g u : ℝ) * (ω : DifferentialForm (Euclid P) n) (H u) (fun a => fderiv ℝ H u (EuclideanSpace.single a 1)) := by
  intro hL3 hIMC P n L κ H B g hH hB hκ hbilip hdiff hg hgint hg0
  -- Step 1: `H` is injective on `B`, so `N = H(B)` is Borel
  have hinj : InjOn H B := by
    intro a ha a' ha' haa'
    have h := hbilip a ha a' ha'
    rw [haa', sub_self, norm_zero] at h
    have h0 : ‖a - a'‖ ≤ 0 := by
      by_contra hpos
      exact absurd h (not_le.mpr (mul_pos hκ (not_le.mp hpos)))
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h0)
  have hNmeas : MeasurableSet (H '' B) :=
    (Submission.cmcdt_lpi_pc_measurable_inverse P n H B hH.continuous.continuousOn hB hinj).1
  -- Step 2: the integer density `m = g ∘ H⁻¹` and the orientation `η` of `N`
  obtain ⟨m, hm, hmint, hmH, hNfin, hmle⟩ :=
    Submission.cmcdt_lpi_pc_piece_multiplicity P n L H B g hH hB hinj hdiff hg hgint hg0
  obtain ⟨η, hη, hηH, hηae⟩ :=
    Submission.cmcdt_lpi_pc_piece_orientation P n L κ H B hH hB hκ hbilip hdiff
  have hmfin : ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top)
      (ne_of_lt hgint.hasFiniteIntegral)) hmle
  -- Step 3: the `IMRep` `(N, m, η)` in `ℝᴾ`
  obtain ⟨R, hR⟩ := Submission.cmcdt_ims_imrep_of_int_density P n univ (H '' B) η m isOpen_univ
    hNmeas (subset_univ _)
    ((Poincare.SimonGMT.Chapter03.countablyRectifiable_range hH).mono (image_subset_range H B))
    (fun K _ _ => ne_top_of_le_ne_top hNfin (measure_mono inter_subset_left)) hη hm hmint
    (fun K _ _ => ne_top_of_le_ne_top hmfin (lintegral_mono_set inter_subset_left)) hηae
  -- Step 4: (IMC)(b) with `E = ℝᴾ` gives the current `Φ`, acting by `∫_N m ⟨ω, η⟩ dHⁿ`
  obtain ⟨Φ, R', hR', hcar, hmult, horient⟩ :=
    hIMC P n univ R univ isOpen_univ MeasurableSet.univ
  have hΦ : ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
      Φ ω = ∫ y in H '' B, m y * η y ((ω : DifferentialForm (Euclid P) n) y) ∂μHE[n] := by
    intro ω
    rw [hR' ω, ← hR (ω : DifferentialForm (Euclid P) n)]
    simp only [IMRep.action]
    rw [hcar, inter_univ, hmult, horient]
  -- Step 5: the formula, from the Gram area formula and `J η(H) = DH e₀ ∧ ⋯ ∧ DH eₙ₋₁` on `B`
  have hformula : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, Φ ω = ∫ u in B,
      (g u : ℝ) * (ω : DifferentialForm (Euclid P) n) (H u)
        (fun a => fderiv ℝ H u (EuclideanSpace.single a 1)) := by
    intro ω
    rw [hΦ ω, Submission.codim1_lur_cd_injective_area_formula_gram P n H B hB
      (fun v hv => (hdiff v hv).1) (fun v hv => (hdiff v hv).2) hinj]
    refine setIntegral_congr_fun hB fun u hu => ?_
    have hJ := (hηH u hu).2 ((ω : DifferentialForm (Euclid P) n) (H u))
    rw [hmH u hu, ← hJ]
    ring
  refine ⟨Φ, ⟨R', hR'⟩, ?_, hformula⟩
  -- Step 6: the mass bound, from `|⟨ω, η⟩| ≤ 1` on `N` for admissible `ω`
  rw [GeometricCurrentOn.mass, GeometricCurrentOn.massOn]
  refine sSup_le ?_
  rintro _ ⟨ω, hω, rfl⟩
  have hle : ∀ y ∈ H '' B,
      ‖m y * η y ((ω : DifferentialForm (Euclid P) n) y)‖ₑ ≤ ‖m y‖ₑ := by
    rintro _ ⟨u, hu, rfl⟩
    obtain ⟨τ, hτ, -, hητ⟩ := (hηH u hu).1
    have h1 : |η (H u) ((ω : DifferentialForm (Euclid P) n) (H u))| ≤ 1 := by
      refine le_trans ?_ ((hL3 P n _ τ hτ).trans (hω.2 (H u)))
      rcases hητ with h | h <;> simp [h]
    rw [enorm_mul]
    calc ‖m (H u)‖ₑ * ‖η (H u) ((ω : DifferentialForm (Euclid P) n) (H u))‖ₑ
        ≤ ‖m (H u)‖ₑ * 1 := by
          gcongr
          rw [Real.enorm_eq_ofReal_abs]
          exact ENNReal.ofReal_le_one.mpr h1
      _ = ‖m (H u)‖ₑ := mul_one _
  calc ENNReal.ofReal (Φ ω)
      ≤ ‖Φ ω‖ₑ := by
        rw [Real.enorm_eq_ofReal_abs]
        exact ENNReal.ofReal_le_ofReal (le_abs_self _)
    _ = ‖∫ y in H '' B, m y * η y ((ω : DifferentialForm (Euclid P) n) y) ∂μHE[n]‖ₑ := by
        rw [hΦ ω]
    _ ≤ ∫⁻ y in H '' B, ‖m y * η y ((ω : DifferentialForm (Euclid P) n) y)‖ₑ ∂μHE[n] :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] := setLIntegral_mono' hNmeas hle
    _ ≤ (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ := hmle

/-- **Integer multiplicity push-forward of a weighted Lipschitz piece** (step B3 of the
deformation theorem, Simon 6.5.1; Simon 6.3.5–3.9 for `H_#τ(M, θ, ξ)`).  Let `n = k + 1`,
`H : ℝⁿ → ℝ^{N'}` be `L`-Lipschitz, `A ⊆ ℝⁿ` Borel and `g : ℝⁿ → ℤ` integrable on `A`.  Then
`ω ↦ ∫_A g(u)·ω(H(u))(DH(u)e₀, …, DH(u)eₙ₋₁) du` is an integer multiplicity current.
Write `Ψ_ω` for this integrand.  By `cmcdt_lpi_pc_regular_part_reduction`, `∫_A Ψ_ω = ∫_{A⁺} Ψ_ω`
with `A⁺ = {u ∈ A : DH(u) exists and is injective, g(u) ≠ 0}`.  `cmcdt_lpi_pc_bilipschitz_partition`
splits `A⁺` into disjoint Borel pieces `C_l` on which `H` is bi-Lipschitz, and
`cmcdt_lpi_pc_piece_current` (with (L3) of (CB) and part (b) of (IMC)) gives integer multiplicity
currents `Φ_l` with `M(Φ_l) ≤ Lⁿ ∫_{C_l} |g|` and `Φ_l(ω) = ∫_{C_l} Ψ_ω`.  Hence
`Σ_l M(Φ_l) ≤ Lⁿ ∫_A |g| < ∞`, (IMSc) sums the `Φ_l` to an integer multiplicity `S`, and countable
additivity of the integral over `A⁺ = ⋃_l C_l` gives `S(ω) = ∫_{A⁺} Ψ_ω = ∫_A Ψ_ω`. -/
theorem Submission.cmcdt_lpi_lipschitz_piece_im : ((∀ (N N' k : ℕ) (A : Euclid N →L[ℝ] Euclid N') (β : Covector (Euclid N') k), covectorEuclideanNorm (β.compContinuousLinearMap A) ≤ ‖A‖ ^ k * covectorEuclideanNorm β) ∧ (∀ (N k : ℕ) (v : Euclid N) (β : Covector (Euclid N) (k + 1)), covectorEuclideanNorm (β.curryLeft v) ≤ ‖v‖ * covectorEuclideanNorm β) ∧ ∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S)) → ∀ (N' k : ℕ) (L : NNReal) (H : Euclid (k + 1) → Euclid N') (A : Set (Euclid (k + 1))) (g : Euclid (k + 1) → ℤ), LipschitzWith L H → MeasurableSet A → Measurable g → IntegrableOn (fun u => (g u : ℝ)) A → ∃ S : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1), IsIntegerMultiplicity S ∧ ∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), S ω = ∫ u in A, (g u : ℝ) * (ω : DifferentialForm (Euclid N') (k + 1)) (H u) (fun a => fderiv ℝ H u (EuclideanSpace.single a 1)) := by
  intro hCB hIMC hIMSc N' k L H A g hH hA hg hgi
  -- Steps 1–2: `Ψ_ω` is integrable on `A` and `∫_A Ψ_ω = ∫_{A⁺} Ψ_ω`
  obtain ⟨hAp, hΨ⟩ :=
    Submission.cmcdt_lpi_pc_regular_part_reduction N' (k + 1) L H A g hH hA hg hgi
  set Ap : Set (Euclid (k + 1)) :=
    {u | u ∈ A ∧ DifferentiableAt ℝ H u ∧ Injective (fderiv ℝ H u) ∧ g u ≠ 0}
  -- Step 3: disjoint Borel pieces `C_l` with `⋃_l C_l = A⁺`, on which `H` is bi-Lipschitz
  obtain ⟨C, κ, hCm, hCd, hCU, hκ, hCbil⟩ :=
    Submission.cmcdt_lpi_pc_bilipschitz_partition N' (k + 1) H Ap hAp
      fun a ha => ⟨ha.2.1, ha.2.2.1⟩
  have hCA : ∀ l, C l ⊆ Ap := fun l => (subset_iUnion C l).trans hCU.subset
  -- Steps 5–7: an integer multiplicity current `Φ_l` for each piece, with
  -- `M(Φ_l) ≤ Lⁿ ∫_{C_l} |g|` and `Φ_l(ω) = ∫_{C_l} Ψ_ω`
  choose Φ hΦim hΦmass hΦω using fun l =>
    Submission.cmcdt_lpi_pc_piece_current hCB.2.2 hIMC.2.1 N' (k + 1) L (κ l) H (C l) g hH
      (hCm l) (hκ l) (hCbil l) (fun a ha => ⟨(hCA l ha).2.1, (hCA l ha).2.2.1⟩) hg
      (hgi.mono_set fun u hu => (hCA l hu).1) fun u hu => (hCA l hu).2.2.2
  -- Step 8: `Σ_l M(Φ_l) ≤ Lⁿ Σ_l ∫_{C_l} |g| = Lⁿ ∫_{A⁺} |g| ≤ Lⁿ ∫_A |g| < ∞`
  have hsum : ∑' l, (Φ l).mass < ∞ :=
    calc ∑' l, (Φ l).mass ≤ ∑' l, (L : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in C l, ‖(g u : ℝ)‖ₑ :=
          ENNReal.tsum_le_tsum hΦmass
      _ = (L : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in Ap, ‖(g u : ℝ)‖ₑ := by
          rw [ENNReal.tsum_mul_left, ← lintegral_iUnion hCm hCd, hCU]
      _ ≤ (L : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in A, ‖(g u : ℝ)‖ₑ :=
          mul_le_mul_right (lintegral_mono_set fun u hu => hu.1) _
      _ < ∞ := ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) hgi.2
  -- (IMSc): the series `S = Σ_l Φ_l` is an integer multiplicity current
  obtain ⟨S, hS, -, -, hSim⟩ := hIMSc N' k Φ hsum
  refine ⟨S, hSim hΦim, fun ω => ?_⟩
  -- countable additivity over `A⁺ = ⋃_l C_l` and uniqueness of sums
  obtain ⟨hint, heq⟩ := hΨ ω
  rw [heq]
  refine (hS ω).unique ?_
  simp only [hΦω]
  rw [← hCU]
  exact hasSum_integral_iUnion hCm hCd
    (hint.mono_set (iUnion_subset fun l => (hCA l).trans fun u hu => hu.1))

/-- **Integrality of the Lipschitz push-forward** (Simon Ch. 6, 2.29 and 3.6–3.9; step 7 of the
proof of the Lipschitz push-forward used by the deformation theorem 6.5.1).  Assume (CB), (VO),
(MR), (IMC) and (IMS).  Let `X ∈ 𝒟ₖ₊₁(ℝᴺ)` be integer multiplicity with `M(X) < ∞`, `F`
`Λ`-Lipschitz, and `S ∈ 𝒟ₖ₊₁(ℝᴺ')` with `X(ηⱼ) → S(ω)`, where `ηⱼ = Fⱼ^#ω` near `spt X` for
smooth `Λ`-Lipschitz `Fⱼ → F` uniformly.  Then `S` is integer multiplicity.
* piece_representation: `X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)` with `Σᵢ ∫_{Aᵢ} |wᵢ| cᵢ ≤ M(X)`.
* On `Aᵢ ⊆ Gᵢ⁻¹(spt X)` the chain rule turns the `i`-th term of `X(ηⱼ)` into
  `Tᵢⱼ(ω) = ∫_{Aᵢ} wᵢ ω(Fⱼ ∘ Gᵢ)(D(Fⱼ ∘ Gᵢ) e)`, and (L1) bounds it by `Λⁿ C ∫_{Aᵢ} |wᵢ| cᵢ`
  when `|ω| ≤ C`.
* pullback_continuity gives `Tᵢⱼ(ω) → Tᵢ(ω) = ∫_{Aᵢ} wᵢ ω(F ∘ Gᵢ)(D(F ∘ Gᵢ) e)`, and Tannery's
  theorem gives `S(ω) = Σᵢ Tᵢ(ω)`.
* piece_current makes each `Tᵢ` an integer multiplicity `Sᵢ` with `M(Sᵢ) ≤ Λⁿ ∫_{Aᵢ} |wᵢ| cᵢ`;
  (IMS) sums the `Sᵢ` to an integer multiplicity current, which equals `S`. -/
theorem Submission.cmcdt_lpi_pushforward_im : ((∀ (N N' k : ℕ) (A : Euclid N →L[ℝ] Euclid N') (β : Covector (Euclid N') k), covectorEuclideanNorm (β.compContinuousLinearMap A) ≤ ‖A‖ ^ k * covectorEuclideanNorm β) ∧ (∀ (N k : ℕ) (v : Euclid N) (β : Covector (Euclid N) (k + 1)), covectorEuclideanNorm (β.curryLeft v) ≤ ‖v‖ * covectorEuclideanNorm β) ∧ ∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ((∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S)) → ∀ (N N' k : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)) (S : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1)), LipschitzWith Λ F → IsIntegerMultiplicity X → IsCompact X.support → X.mass < ∞ → (∃ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Fs j)) ∧ (∀ j, LipschitzWith Λ (Fs j)) ∧ TendstoUniformly Fs F atTop ∧ ∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), ∃ ηs : ℕ → TestFormOn (univ : Set (Euclid N)) (k + 1), (∀ j, ∃ W : Set (Euclid N), IsOpen W ∧ X.support ⊆ W ∧ ∀ x ∈ W, (ηs j : DifferentialForm (Euclid N) (k + 1)) x = ((ω : DifferentialForm (Euclid N') (k + 1)) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x)) ∧ Tendsto (fun j => X (ηs j)) atTop (𝓝 (S ω))) → IsIntegerMultiplicity S := by
  intro hCB hVO hMR hIMC hIMS N N' k Λ F X S hF hX _hXc hXm hFs
  obtain ⟨Fs, hFs_smooth, hFs_lip, hFs_tend, hη⟩ := hFs
  -- (IMSc): (IMS) applied to (VO), (MR) and (IMC)
  have hIMSc := hIMS hVO hMR hIMC
  -- Step 1: `X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)`, with `Bᵢ = ∫_{Aᵢ} |wᵢ| cᵢ` and `Σᵢ Bᵢ ≤ M(X) < ∞`
  obtain ⟨G, A, w, c, hG_lip, hA, hw, -, hG_diff, hG_spt, hw_int, hc, hB, hXsum⟩ :=
    Submission.cmcdt_lpi_piece_representation hCB hVO hMR hIMC N k X hX hXm
  choose L hL using hG_lip
  obtain ⟨B, hBeq⟩ : ∃ B : ℕ → ℝ≥0∞,
      ∀ i, B i = ∫⁻ u in A i, ENNReal.ofReal (|(w i u : ℝ)| * c i u) := ⟨_, fun _ => rfl⟩
  have hBsum : ∑' i, B i ≠ ∞ := by
    simp only [hBeq]
    exact (hB.trans_lt hXm).ne
  have hBi : ∀ i, B i ≠ ∞ := fun i => ne_top_of_le_ne_top hBsum (ENNReal.le_tsum i)
  -- Step 2: the `Fⱼ` are differentiable everywhere
  have hFs_diff : ∀ j, Differentiable ℝ (Fs j) := fun j =>
    (hFs_smooth j).differentiable (by simp)
  -- Step 3 (chain rule): on `Aᵢ`, `ω(Fⱼ ∘ Gᵢ)(D(Fⱼ ∘ Gᵢ) e) = βᵢⱼ(DGᵢ e)`,
  -- where `βᵢⱼ = ω(Fⱼ ∘ Gᵢ) ∘ DFⱼ(Gᵢ)`
  have hchain : ∀ i j, ∀ u ∈ A i, ∀ ω : DifferentialForm (Euclid N') (k + 1),
      ω (Fs j (G i u)) (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1)) =
        ((ω (Fs j (G i u))).compContinuousLinearMap (fderiv ℝ (Fs j) (G i u)))
          (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a 1)) := by
    intro i j u hu ω
    rw [ContinuousAlternatingMap.compContinuousLinearMap_apply,
      fderiv_fun_comp u (hFs_diff j (G i u)) (hG_diff i u hu)]
    rfl
  -- Step 6 (pointwise): if `|ω| ≤ C`, then `|ω(Fⱼ ∘ Gᵢ)(D(Fⱼ ∘ Gᵢ) e)| ≤ cᵢ Λⁿ C` on `Aᵢ`, by (L1)
  have hpt : ∀ i j, ∀ u ∈ A i, ∀ (ω : DifferentialForm (Euclid N') (k + 1)) (C : ℝ),
      (∀ y, covectorEuclideanNorm (ω y) ≤ C) →
      |ω (Fs j (G i u)) (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1))|
        ≤ c i u * ((Λ : ℝ) ^ (k + 1) * C) := by
    intro i j u hu ω C hC
    rw [hchain i j u hu ω]
    obtain ⟨hc0, hcα⟩ := hc i u hu
    refine (hcα _).trans (mul_le_mul_of_nonneg_left ?_ hc0)
    refine (hCB.1 N N' (k + 1) (fderiv ℝ (Fs j) (G i u)) (ω (Fs j (G i u)))).trans ?_
    exact mul_le_mul
      (pow_le_pow_left₀ (norm_nonneg _) (norm_fderiv_le_of_lipschitz ℝ (hFs_lip j)) _) (hC _)
      (covectorEuclideanNorm_nonneg _) (by positivity)
  -- Step 6 (integrated): `|Tᵢⱼ(ω)| ≤ Bᵢ Λⁿ C`, uniformly in `j`
  have hTij : ∀ i j (ω : DifferentialForm (Euclid N') (k + 1)) (C : ℝ), 0 ≤ C →
      (∀ y, covectorEuclideanNorm (ω y) ≤ C) →
      ‖∫ u in A i, (w i u : ℝ) * ω (Fs j (G i u))
          (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1))‖ ≤
        (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) := by
    intro i j ω C hC0 hC
    have hK : 0 ≤ (Λ : ℝ) ^ (k + 1) * C := by positivity
    have hfin : B i * ENNReal.ofReal ((Λ : ℝ) ^ (k + 1) * C) ≠ ∞ :=
      ENNReal.mul_ne_top (hBi i) ENNReal.ofReal_ne_top
    have hval : (B i * ENNReal.ofReal ((Λ : ℝ) ^ (k + 1) * C)).toReal =
        (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) := by
      rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hK]
    refine (norm_integral_le_lintegral_norm _).trans ((ENNReal.toReal_mono hfin ?_).trans_eq hval)
    rw [hBeq i, ← lintegral_mul_const' _ _ ENNReal.ofReal_ne_top]
    refine setLIntegral_mono' (hA i) fun u hu => ?_
    rw [← ENNReal.ofReal_mul (mul_nonneg (abs_nonneg _) (hc i u hu).1)]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hpt i j u hu ω C hC) (abs_nonneg _)
  -- Step 7 (termwise limit): `Tᵢⱼ(ω) → Tᵢ(ω)`, by pullback_continuity with the weight `1_{Aᵢ} wᵢ`
  have hlim : ∀ i (ω : TestFormOn (univ : Set (Euclid N')) (k + 1)),
      Tendsto (fun j => ∫ u in A i, (w i u : ℝ) *
          (ω : DifferentialForm (Euclid N') (k + 1)) (Fs j (G i u))
            (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1))) atTop
        (𝓝 (∫ u in A i, (w i u : ℝ) * (ω : DifferentialForm (Euclid N') (k + 1)) (F (G i u))
          (fun a => fderiv ℝ (fun v => F (G i v)) u (EuclideanSpace.single a 1)))) := by
    intro i ω
    have hind : ∀ f : Euclid (k + 1) → ℝ,
        ∫ u, (A i).indicator (fun u => (w i u : ℝ)) u * f u = ∫ u in A i, (w i u : ℝ) * f u := by
      intro f
      rw [← integral_indicator (hA i)]
      congr 1
      funext u
      exact (Set.indicator_mul_left _ _ _).symm
    have h := Submission.cmcdt_lpi_pullback_weak_continuity (k + 1) N' (Λ * L i)
      (fun j v => Fs j (G i v)) (fun v => F (G i v)) ((A i).indicator fun u => (w i u : ℝ))
      (ω : DifferentialForm (Euclid N') (k + 1)) (fun j => (hFs_lip j).comp (hL i))
      (hF.comp (hL i)) (hFs_tend.comp (G i)) ((hw_int i).integrable_indicator (hA i))
      (ContDiff.continuous ω.property.1.1) ω.property.1.2
    simpa only [hind] using h
  -- every test form has bounded coefficient norm: `|·|` is continuous and `ω` has compact support
  have hNcont : Continuous fun α : Covector (Euclid N') (k + 1) => covectorEuclideanNorm α := by
    unfold covectorEuclideanNorm
    refine Continuous.sqrt (continuous_finsetSum _ fun I _ => ?_)
    by_cases hI : StrictMono I
    · simp only [hI, ↓reduceIte]
      exact (continuous_eval_const _).pow 2
    · simp only [hI, ↓reduceIte]
      exact continuous_const
  have hbound : ∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), ∃ C : ℝ, 0 ≤ C ∧
      ∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) y) ≤ C := by
    intro ω
    have hcs : HasCompactSupport fun y =>
        covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) y) :=
      HasCompactSupport.comp_left (g := covectorEuclideanNorm) ω.property.1.2
        (covectorEuclideanNorm_zero N' (k + 1))
    obtain ⟨C, hC⟩ :=
      (hNcont.comp (ContDiff.continuous ω.property.1.1)).bounded_above_of_compact_support hcs
    exact ⟨max C 0, le_max_right _ _, fun y =>
      ((Real.le_norm_self _).trans (hC y)).trans (le_max_left _ _)⟩
  -- Tannery's theorem (dominated convergence for series): if `|fⱼ(i)| ≤ bᵢ` with `Σᵢ bᵢ < ∞`
  -- and `fⱼ(i) → g(i)` for every `i`, then `Σᵢ fⱼ(i) → Σᵢ g(i)`; an `ε/3` argument
  have htannery : ∀ (f : ℕ → ℕ → ℝ) (g bound : ℕ → ℝ), Summable bound →
      (∀ i, Tendsto (fun j => f j i) atTop (𝓝 (g i))) → (∀ j i, ‖f j i‖ ≤ bound i) →
      Tendsto (fun j => ∑' i, f j i) atTop (𝓝 (∑' i, g i)) := by
    intro f g bound h_sum hab h_bound
    have h_g_le : ∀ i, ‖g i‖ ≤ bound i := fun i =>
      le_of_tendsto' (tendsto_norm.comp (hab i)) fun j => h_bound j i
    have h_sumg : Summable fun i => ‖g i‖ :=
      h_sum.of_norm_bounded fun i => (norm_norm (g i)).symm ▸ h_g_le i
    have h_suma : ∀ j, Summable fun i => ‖f j i‖ := fun j =>
      h_sum.of_norm_bounded fun i => by simpa only [norm_norm] using h_bound j i
    rw [Metric.tendsto_nhds]
    intro ε hε
    -- a finite set `T` carrying all but `ε/3` of `Σᵢ bᵢ`
    obtain ⟨T, hT⟩ : ∃ T : Finset ℕ, dist (∑ i ∈ T, bound i) (∑' i, bound i) < ε / 3 := by
      have hS := h_sum.hasSum
      rw [HasSum, Metric.tendsto_nhds] at hS
      exact Eventually.exists <| hS _ (by positivity)
    have h1 : ∑' i : (Tᶜ : Set ℕ), bound i < ε / 3 := by
      calc _ ≤ ‖∑' i : (Tᶜ : Set ℕ), bound i‖ := Real.le_norm_self _
        _ = ‖∑' i, bound i - ∑ i ∈ T, bound i‖ := congrArg _ ?_
        _ < ε / 3 := by rwa [dist_eq_norm, norm_sub_rev] at hT
      rw [eq_sub_iff_add_eq']
      exact h_sum.sum_add_tsum_compl
    have h2 : Tendsto (fun j => ∑ i ∈ T, f j i) atTop (𝓝 (∑ i ∈ T, g i)) :=
      tendsto_finsetSum _ fun i _ => hab i
    rw [Metric.tendsto_nhds] at h2
    filter_upwards [h2 (ε / 3) (by positivity)] with j hj
    rw [dist_eq_norm, ← (h_suma j).of_norm.tsum_sub h_sumg.of_norm,
      ← ((h_suma j).of_norm.sub h_sumg.of_norm).sum_add_tsum_compl (s := T),
      (by ring : ε = ε / 3 + (ε / 3 + ε / 3))]
    refine (norm_add_le _ _).trans_lt (add_lt_add ?_ ?_)
    · simpa only [dist_eq_norm, Finset.sum_sub_distrib] using hj
    · rw [((h_suma j).subtype _).of_norm.tsum_sub (h_sumg.subtype _).of_norm]
      refine (norm_sub_le _ _).trans_lt (add_lt_add ?_ ?_)
      · refine ((norm_tsum_le_tsum_norm ((h_suma j).subtype _)).trans ?_).trans_lt h1
        exact ((h_suma j).subtype _).tsum_le_tsum (fun i => h_bound j i) (h_sum.subtype _)
      · refine ((norm_tsum_le_tsum_norm (h_sumg.subtype _)).trans ?_).trans_lt h1
        exact (h_sumg.subtype _).tsum_le_tsum (fun i => h_g_le i) (h_sum.subtype _)
  -- Step 8 (☆): `S(ω) = Σᵢ Tᵢ(ω)`, and `|Tᵢ(ω)| ≤ Bᵢ Λⁿ C` when `|ω| ≤ C`
  have hstar : ∀ (ω : TestFormOn (univ : Set (Euclid N')) (k + 1)) (C : ℝ), 0 ≤ C →
      (∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) y) ≤ C) →
      HasSum (fun i => ∫ u in A i, (w i u : ℝ) *
          (ω : DifferentialForm (Euclid N') (k + 1)) (F (G i u))
            (fun a => fderiv ℝ (fun v => F (G i v)) u (EuclideanSpace.single a 1))) (S ω) ∧
      ∀ i, ‖∫ u in A i, (w i u : ℝ) * (ω : DifferentialForm (Euclid N') (k + 1)) (F (G i u))
          (fun a => fderiv ℝ (fun v => F (G i v)) u (EuclideanSpace.single a 1))‖ ≤
        (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) := by
    intro ω C hC0 hC
    -- the limits `Tᵢ(ω)` inherit the bound of the `Tᵢⱼ(ω)`
    have hTi : ∀ i, ‖∫ u in A i, (w i u : ℝ) *
        (ω : DifferentialForm (Euclid N') (k + 1)) (F (G i u))
          (fun a => fderiv ℝ (fun v => F (G i v)) u (EuclideanSpace.single a 1))‖ ≤
        (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) := fun i =>
      le_of_tendsto' (hlim i ω).norm fun j => hTij i j ω C hC0 hC
    have hbsum : Summable fun i => (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) :=
      (ENNReal.summable_toReal hBsum).mul_right _
    refine ⟨?_, hTi⟩
    obtain ⟨ηs, hηW, hηlim⟩ := hη ω
    -- Step 5: `X(ηⱼ) = Σᵢ Tᵢⱼ(ω)`, since `ηⱼ = Fⱼ^#ω` on a neighbourhood of `Gᵢ(Aᵢ) ⊆ spt X`
    have hXj : ∀ j, HasSum (fun i => ∫ u in A i, (w i u : ℝ) *
        (ω : DifferentialForm (Euclid N') (k + 1)) (Fs j (G i u))
          (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1)))
        (X (ηs j)) := by
      intro j
      obtain ⟨W, -, hXW, hW⟩ := hηW j
      convert hXsum (ηs j) using 1
      funext i
      refine setIntegral_congr_fun (hA i) fun u hu => ?_
      rw [hW (G i u) (hXW (hG_spt i (mem_image_of_mem (G i) hu))),
        hchain i j u hu (ω : DifferentialForm (Euclid N') (k + 1))]
    -- Step 8: Tannery's theorem, `X(ηⱼ) = Σᵢ Tᵢⱼ(ω) → Σᵢ Tᵢ(ω)`; also `X(ηⱼ) → S(ω)`
    have htan := htannery _ _ _ hbsum (fun i => hlim i ω) fun j i =>
      hTij i j (ω : DifferentialForm (Euclid N') (k + 1)) C hC0 hC
    rw [tendsto_nhds_unique hηlim (Tendsto.congr (fun j => (hXj j).tsum_eq) htan)]
    exact (hbsum.of_norm_bounded hTi).hasSum
  -- Step 9: integer multiplicity pieces `Sᵢ` with `Sᵢ(ω) = Tᵢ(ω)`
  choose Sp hSp_im hSp using fun i => Submission.cmcdt_lpi_lipschitz_piece_im hCB hIMC hIMSc N'
    k (Λ * L i) (fun v => F (G i v)) (A i) (w i) (hF.comp (hL i)) (hA i) (hw i) (hw_int i)
  -- Step 10: `M(Sᵢ) ≤ Λⁿ Bᵢ`, so `Σᵢ M(Sᵢ) < ∞`
  have hSp_mass : ∀ i,
      (Sp i).mass ≤ ENNReal.ofReal ((B i).toReal * ((Λ : ℝ) ^ (k + 1) * 1)) := by
    intro i
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    refine ENNReal.ofReal_le_ofReal ?_
    rw [hSp i ω]
    exact (Real.le_norm_self _).trans ((hstar ω 1 zero_le_one hω.2).2 i)
  have hSp_sum : ∑' i, (Sp i).mass < ∞ := by
    have hbsum1 : Summable fun i => (B i).toReal * ((Λ : ℝ) ^ (k + 1) * 1) :=
      (ENNReal.summable_toReal hBsum).mul_right _
    calc ∑' i, (Sp i).mass
        ≤ ∑' i, ENNReal.ofReal ((B i).toReal * ((Λ : ℝ) ^ (k + 1) * 1)) :=
          ENNReal.tsum_le_tsum hSp_mass
      _ = ENNReal.ofReal (∑' i, (B i).toReal * ((Λ : ℝ) ^ (k + 1) * 1)) :=
          (ENNReal.ofReal_tsum_of_nonneg (fun i => by positivity) hbsum1).symm
      _ < ∞ := ENNReal.ofReal_lt_top
  -- Step 11: `Ŝ = Σᵢ Sᵢ` is integer multiplicity, and `Ŝ(ω) = Σᵢ Tᵢ(ω) = S(ω)`
  obtain ⟨Shat, hShat, -, -, hShat_im⟩ := hIMSc N' k Sp hSp_sum
  obtain ⟨R, hR⟩ := hShat_im hSp_im
  refine ⟨R, fun ω => ?_⟩
  rw [← hR ω]
  obtain ⟨C, hC0, hC⟩ := hbound ω
  refine (hstar ω C hC0 hC).1.unique ?_
  simpa only [hSp] using hShat ω
/-- **The cylinder over an integer multiplicity current is integer multiplicity** (step 8 (B5) of
the proof of the deformation theorem, Simon 6.5.1; Simon Ch. 6, 2.18–2.20 and 3.2(2):
`[[(0,1)]] × τ(M, θ, ξ) = τ((0,1) × M, θ, e₁ ∧ ξ)`).  Write `ι(t, x) = (t, x) ∈ ℝᴺ⁺¹`,
`e₀ = ι(1, 0)` and `Jv = ι(0, v)`.  Let `X ∈ 𝒟ₖ₊₁(ℝᴺ)` be integer multiplicity with `M(X) < ∞`,
and let `C ∈ 𝒟ₖ₊₂(ℝᴺ⁺¹)` satisfy `C(ω) = X(η)` for a test form `η` with
`η(x)(v) = ∫₀¹ ω(ι(t, x))(e₀, Jv) dt`.  By `cmcdt_lpi_piece_representation`,
`X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)` with Lipschitz `Gᵢ` and `Σᵢ ∫_{Aᵢ} |wᵢ| cᵢ ≤ M(X)`.  The product
pieces `Ĝᵢ(z) = ι(z₀, Gᵢ(tail z))` on `Âᵢ = (0, 1) × Aᵢ` with weights `ŵᵢ = wᵢ ∘ tail` turn each
term into `∫_{Âᵢ} ŵᵢ ω(Ĝᵢ)(DĜᵢ ê)` (`cmcdt_lpi_cyl_piece_action`), the action of an integer
multiplicity current `Ŝᵢ` (`cmcdt_lpi_lipschitz_piece_im`) of mass `M(Ŝᵢ) ≤ ∫_{Aᵢ} |wᵢ| cᵢ`
(`cmcdt_lpi_cyl_piece_mass`).  So `Σᵢ M(Ŝᵢ) ≤ M(X) < ∞`, (IMS) sums the `Ŝᵢ` to an integer
multiplicity current `Ĉ`, and `C(ω) = Σᵢ Ŝᵢ(ω) = Ĉ(ω)` for every test form `ω`. -/
theorem Submission.cmcdt_lpi_cylinder_im : ((∀ (N N' k : ℕ) (A : Euclid N →L[ℝ] Euclid N') (β : Covector (Euclid N') k), covectorEuclideanNorm (β.compContinuousLinearMap A) ≤ ‖A‖ ^ k * covectorEuclideanNorm β) ∧ (∀ (N k : ℕ) (v : Euclid N) (β : Covector (Euclid N) (k + 1)), covectorEuclideanNorm (β.curryLeft v) ≤ ‖v‖ * covectorEuclideanNorm β) ∧ ∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ((∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S)) → ∀ (N k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)) (C : GeometricCurrentOn (univ : Set (Euclid (N + 1))) (k + 1 + 1)), IsIntegerMultiplicity X → IsCompact X.support → X.mass < ∞ → (∀ ω : TestFormOn (univ : Set (Euclid (N + 1))) (k + 1 + 1), ∃ η : TestFormOn (univ : Set (Euclid N)) (k + 1), (∀ (x : Euclid N) (v : Fin (k + 1) → Euclid N), (η : DifferentialForm (Euclid N) (k + 1)) x v = ∫ t in (0 : ℝ)..1, (ω : DifferentialForm (Euclid (N + 1)) (k + 1 + 1)) (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) (Fin.cons (EuclideanSpace.single 0 1) (fun i => WithLp.toLp 2 (Fin.cons 0 (WithLp.ofLp (v i)))))) ∧ C ω = X η) → IsIntegerMultiplicity C := by
  intro hCB hVO hMR hIMC hIMS N k X C hX _hXc hXm hslice
  -- (IMSc): (IMS) applied to (VO), (MR), (IMC)
  have hIMSc := hIMS hVO hMR hIMC
  -- Step 1: pieces `(Gᵢ, Aᵢ, wᵢ, cᵢ)` with `X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)`
  obtain ⟨G, A, w, c, hGL, hA, hw, hc, hGd, -, hwi, hcb, hsum, hrep⟩ :=
    Submission.cmcdt_lpi_piece_representation hCB hVO hMR hIMC N k X hX hXm
  choose L hL using hGL
  -- Step 2: the product pieces `Ĝᵢ(z) = ι(z₀, Gᵢ(tail z))`, `Âᵢ = (0, 1) × Aᵢ`, `ŵᵢ = wᵢ ∘ tail`
  obtain ⟨Gh, hGh⟩ : ∃ Gh : ℕ → Euclid (k + 1 + 1) → Euclid (N + 1), ∀ i z,
      Gh i z = WithLp.toLp 2 (Fin.cons (WithLp.ofLp z 0)
        (WithLp.ofLp (G i (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))))) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨Ah, hAh⟩ : ∃ Ah : ℕ → Set (Euclid (k + 1 + 1)), ∀ i,
      Ah i = {z : Euclid (k + 1 + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧
        (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid (k + 1)) ∈ A i} :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨wh, hwh⟩ : ∃ wh : ℕ → Euclid (k + 1 + 1) → ℤ, ∀ i z,
      wh i z = w i (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) :=
    ⟨_, fun _ _ => rfl⟩
  -- Steps 2–3 for each piece: `Ĝᵢ` Lipschitz, `Âᵢ` Borel, `ŵᵢ` integrable, and the slice identity
  -- `∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e) = ∫_{Âᵢ} ŵᵢ ω(Ĝᵢ)(DĜᵢ ê)`
  have hact := fun i => Submission.cmcdt_lpi_cyl_piece_action N (k + 1) (L i) (G i) (A i) (w i)
    (Gh i) (Ah i) (wh i) (hL i) (hA i) (hw i) (hwi i) (hGd i) (hGh i) (hAh i) (hwh i)
  -- Step 4: integer multiplicity pieces `Ŝᵢ(ω) = ∫_{Âᵢ} ŵᵢ ω(Ĝᵢ)(DĜᵢ ê)`
  have hS : ∀ i, ∃ S : GeometricCurrentOn (univ : Set (Euclid (N + 1))) (k + 1 + 1),
      IsIntegerMultiplicity S ∧ ∀ ω : TestFormOn (univ : Set (Euclid (N + 1))) (k + 1 + 1),
        S ω = ∫ z in Ah i, (wh i z : ℝ) *
          (ω : DifferentialForm (Euclid (N + 1)) (k + 1 + 1)) (Gh i z)
            (fun a => fderiv ℝ (Gh i) z (EuclideanSpace.single a 1)) := by
    intro i
    obtain ⟨hGhL, hAhm, hwhm, hwhi, -⟩ := hact i
    exact Submission.cmcdt_lpi_lipschitz_piece_im hCB hIMC hIMSc (N + 1) (k + 1) (max 1 (L i))
      (Gh i) (Ah i) (wh i) hGhL hAhm hwhm hwhi
  choose S hSim hSrep using hS
  -- Step 5: `M(Ŝᵢ) = sup {Ŝᵢ(ω) : |ω| ≤ 1} ≤ ∫_{Aᵢ} |wᵢ| cᵢ`, so `Σᵢ M(Ŝᵢ) ≤ M(X) < ∞`
  have hmass : ∀ i, (S i).mass ≤ ∫⁻ u in A i, ENNReal.ofReal (|(w i u : ℝ)| * c i u) := by
    intro i
    unfold GeometricCurrentOn.mass GeometricCurrentOn.massOn
    apply sSup_le
    rintro _ ⟨ω, hω, rfl⟩
    dsimp only
    rw [hSrep i ω]
    exact Submission.cmcdt_lpi_cyl_piece_mass hCB.1 hCB.2.1 N (k + 1) (G i) (A i) (w i) (c i)
      (Gh i) (Ah i) (wh i) (hA i) (hw i) (hc i) (hGd i) (hcb i) (hGh i) (hAh i) (hwh i) _ hω.2
  have hfin : ∑' i, (S i).mass < ∞ :=
    lt_of_le_of_lt ((ENNReal.tsum_le_tsum hmass).trans hsum) hXm
  -- Step 6: (IMSc) sums the `Ŝᵢ` to an integer multiplicity `Ĉ = τ(R)`
  obtain ⟨Ch, hChsum, -, -, hChim⟩ := hIMSc (N + 1) (k + 1) S hfin
  obtain ⟨R, hR⟩ := hChim hSim
  -- `C(ω) = X(η) = Σᵢ Ŝᵢ(ω) = Ĉ(ω)`, so `R` also represents `C`
  refine ⟨R, fun ω => ?_⟩
  obtain ⟨η, hη, hCω⟩ := hslice ω
  have hSη : (fun i => S i ω) = fun i => ∫ u in A i, (w i u : ℝ) *
      (η : DifferentialForm (Euclid N) (k + 1)) (G i u)
        (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a 1)) := by
    funext i
    rw [hSrep i ω]
    exact ((hact i).2.2.2.2 ω η hη).symm
  have hCsum : HasSum (fun i => S i ω) (C ω) := by
    rw [hSη, hCω]
    exact hrep η
  rw [hCsum.unique (hChsum ω)]
  exact hR ω

/-- **Integrality of Lipschitz push-forwards and of cylinders** (Simon Ch. 6, 2.25, 2.29 and
3.3–3.9; Part B of the Lipschitz push-forward step of the deformation theorem 6.5.1).  Assume
(VO), (MR), (IMC) and (IMS), and let `X ∈ 𝒟ₖ₊₁(ℝᴺ)` be integer multiplicity with compact
support and `M(X) < ∞`.
(I) If `Fⱼ → F` uniformly, the `Fⱼ` smooth and all maps `Λ`-Lipschitz, then a weak limit
`S(ω) = limⱼ X(Fⱼ^#ω)` is integer multiplicity: `X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)` over
integer-weighted Lipschitz pieces, `X(Fⱼ^#ω) → Σᵢ ∫_{Aᵢ} wᵢ ω(F ∘ Gᵢ)(D(F ∘ Gᵢ) e)` by weak
continuity of pull-backs, and the limit is a series of integer multiplicity currents
`(F ∘ Gᵢ)_#(wᵢ [[Aᵢ]])` (`cmcdt_lpi_pushforward_im`).
(II) The cylinder `C = [[0, 1]] × X`, `C(ω) = X(∫₀¹ ω(t, ·)(e₀, ·) dt)`, is integer multiplicity,
by the product pieces `(t, u) ↦ (t, Gᵢ(u))` and Fubini (`cmcdt_lpi_cylinder_im`).
Both use the covector bounds `|A^#β| ≤ ‖A‖ᵏ|β|`, `|ι_vβ| ≤ |v||β|` and `|α(τ)| ≤ |α|` for
orthonormal `τ` (`cmcdt_lp_covector_norm_bounds`). -/
theorem Submission.cmcdt_lp_integer_multiplicity : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ((∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S)) → (∀ (N N' k : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)) (S : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1)), LipschitzWith Λ F → IsIntegerMultiplicity X → IsCompact X.support → X.mass < ∞ → (∃ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Fs j)) ∧ (∀ j, LipschitzWith Λ (Fs j)) ∧ TendstoUniformly Fs F atTop ∧ ∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), ∃ ηs : ℕ → TestFormOn (univ : Set (Euclid N)) (k + 1), (∀ j, ∃ W : Set (Euclid N), IsOpen W ∧ X.support ⊆ W ∧ ∀ x ∈ W, (ηs j : DifferentialForm (Euclid N) (k + 1)) x = ((ω : DifferentialForm (Euclid N') (k + 1)) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x)) ∧ Tendsto (fun j => X (ηs j)) atTop (𝓝 (S ω))) → IsIntegerMultiplicity S) ∧ ∀ (N k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)) (C : GeometricCurrentOn (univ : Set (Euclid (N + 1))) (k + 1 + 1)), IsIntegerMultiplicity X → IsCompact X.support → X.mass < ∞ → (∀ ω : TestFormOn (univ : Set (Euclid (N + 1))) (k + 1 + 1), ∃ η : TestFormOn (univ : Set (Euclid N)) (k + 1), (∀ (x : Euclid N) (v : Fin (k + 1) → Euclid N), (η : DifferentialForm (Euclid N) (k + 1)) x v = ∫ t in (0 : ℝ)..1, (ω : DifferentialForm (Euclid (N + 1)) (k + 1 + 1)) (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) (Fin.cons (EuclideanSpace.single 0 1) (fun i => WithLp.toLp 2 (Fin.cons 0 (WithLp.ofLp (v i)))))) ∧ C ω = X η) → IsIntegerMultiplicity C := by
  intro hVO hMR hIMC hIMS
  -- (I) the limit of the smooth push-forwards `(Fⱼ)_# X`; (II) the cylinder `[[0, 1]] × X`
  exact ⟨Submission.cmcdt_lpi_pushforward_im Submission.cmcdt_lp_covector_norm_bounds hVO hMR
      hIMC hIMS,
    Submission.cmcdt_lpi_cylinder_im Submission.cmcdt_lp_covector_norm_bounds hVO hMR hIMC hIMS⟩
/-- **Lipschitz push-forward and homotopy operators on `ℝᴾ`** (Simon Ch. 6, 2.25–2.29: homotopy
formula, mass estimate and Lipschitz push-forward; 3.3–3.9: integrality of push-forwards; packaged
for the deformation theorem 6.5.1).  `cmcdt_lp_pushforward_operators` gives the Lipschitz
push-forward `lpush` and the cylinder `cyl = [[0, 1]] × ·`.  Put `push := lpush P P` and
`homot k F G X := Ĥ#([[0, 1]] × X)`, where `Ĥ(ι(t, x)) = F(x) + c(t) χ(x) (G(x) − F(x))` is a
cut-off straight-line homotopy: `c(t) = max 0 (min 1 t)`, `χ(x) = max 0 (min 1 (R + 1 − ‖x‖))`
and `spt X ⊆ B̄(0, R)`.  (This radial cut-off replaces the distance cut-off of the proof; any
Lipschitz cut-off equal to `1` on `spt X` works.)  `Ĥ` is Lipschitz, because `χ` is 1-Lipschitz
and vanishes off a ball on which `G − F` is bounded.  It equals `F + t (G − F)` on
`[0, 1] × spt X ⊇ spt([[0, 1]] × X)`, so locality of `lpush` gives
`homot k F G X = H#([[0, 1]] × X)` for every Lipschitz `H` with that property (C1′).  The identity,
linearity, locality, mass and support bounds and the boundary and homotopy formulas follow from
the operator conjuncts and C1′.  They use that normal currents with compact support are closed
under differences and boundaries.
Integrality: `push (k + 1) F X` is integer multiplicity by part (I) of
`cmcdt_lp_integer_multiplicity` (via the approximation interface of `lpush`).  For
`homot (k + 1) F G X`, part (II) makes the cylinder integer multiplicity, and then (I) applies in
`ℝ^{P+1}`.  The series step of the integrality theorem is `cmcdt_im_series`. -/
theorem Submission.cmcdt_lipschitz_pushforward_homotopy : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ P : ℕ, ∃ (push : ∀ k : ℕ, (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) k) (homot : ∀ k : ℕ, (Euclid P → Euclid P) → (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), (∀ (k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → push k (fun x => x) X = X) ∧ (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (X Y : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → IsCompact Y.support → Y.mass < ∞ → boundaryMassOn Y univ < ∞ → push k F (X - Y) = push k F X - push k F Y ∧ homot k F G (X - Y) = homot k F G X - homot k F G Y) ∧ (∀ (k : ℕ) (Λ : NNReal) (F G F' G' : Euclid P → Euclid P) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → LipschitzWith Λ F' → LipschitzWith Λ G' → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → EqOn F F' X.support → EqOn G G' X.support → push k F X = push k F' X ∧ homot k F G X = homot k F' G' X) ∧ (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → (push k F X).mass ≤ (Λ : ℝ≥0∞) ^ k * X.mass ∧ (push k F X).support ⊆ F '' X.support ∧ (∀ δ : ℝ, (∀ x ∈ X.support, dist (F x) (G x) ≤ δ) → (homot k F G X).mass ≤ ENNReal.ofReal δ * (2 * (Λ : ℝ≥0∞)) ^ k * X.mass) ∧ (homot k F G X).support ⊆ {y : Euclid P | ∃ x ∈ X.support, ∃ t ∈ Icc (0 : ℝ) 1, y = F x + t • (G x - F x)}) ∧ (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (X : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact X.support → X.mass < ∞ → X.boundary.mass < ∞ → (push (k + 1) F X).boundary = push k F X.boundary ∧ push (k + 1) G X - push (k + 1) F X - homot k F G X.boundary = (homot (k + 1) F G X).boundary ∧ (IsIntegerMultiplicity X → IsIntegerMultiplicity (push (k + 1) F X) ∧ IsIntegerMultiplicity (homot (k + 1) F G X))) ∧ ∀ (Λ : NNReal) (F G : Euclid P → Euclid P) (X : GeometricCurrentOn (univ : Set (Euclid P)) 0), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact X.support → X.mass < ∞ → push 0 G X - push 0 F X = (homot 0 F G X).boundary := by
  intro hVO hMR hREP hIMC P
  -- Part A (operators): the Lipschitz push-forward `lpush` and the cylinder `cyl = [[0, 1]] × ·`
  obtain ⟨lpush, cyl, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12⟩ :=
    Submission.cmcdt_lp_pushforward_operators hVO hREP
  -- Part B (integrality, B6): its series step is the sibling `cmcdt_im_series`
  obtain ⟨hI, hII⟩ :=
    Submission.cmcdt_lp_integer_multiplicity hVO hMR hIMC Submission.cmcdt_im_series
  -- supports in `ℝᴾ` are closed: `spt T` is the complement of the open zero region
  have hclosed : ∀ (m : ℕ) (A : GeometricCurrentOn (univ : Set (Euclid P)) m),
      IsClosed A.support := by
    intro m A
    rw [GeometricCurrentOn.support, ← compl_eq_univ_sdiff]
    exact A.isOpen_zeroRegion.isClosed_compl
  -- NC is closed under differences: `spt(X − Y) ⊆ spt X ∪ spt Y`, `M(X − Y) ≤ M(X) + M(Y)`
  have hNCsub : ∀ (k : ℕ) (X Y : GeometricCurrentOn (univ : Set (Euclid P)) k),
      IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ →
      IsCompact Y.support → Y.mass < ∞ → boundaryMassOn Y univ < ∞ →
      (X - Y).support ⊆ X.support ∪ Y.support ∧ IsCompact (X - Y).support ∧
        (X - Y).mass < ∞ ∧ boundaryMassOn (X - Y) univ < ∞ := by
    -- `M(A − B) ≤ M(A) + M(B)`: `(A − B)(ω) = A(ω) + B(−ω)` and `−ω` is admissible with `ω`
    have key : ∀ (m : ℕ) (A B : GeometricCurrentOn (univ : Set (Euclid P)) m),
        (A - B).massOn univ ≤ A.massOn univ + B.massOn univ := by
      intro m A B
      refine sSup_le ?_
      rintro r ⟨ω, hω, rfl⟩
      have hneg : -ω ∈ massAdmissibleOn univ m univ :=
        ⟨subset_univ _, fun x => by simpa using hω.2 x⟩
      have hval : (A - B) ω = A ω + B (-ω) := by
        show A ω - B ω = A ω + B (-ω)
        have h := B.toCurrent.map_neg ω
        linarith
      dsimp only
      rw [hval]
      exact ENNReal.ofReal_add_le.trans (add_le_add (A.le_massOn hω) (B.le_massOn hneg))
    intro k X Y hX1 hX2 hX3 hY1 hY2 hY3
    -- `X − Y` vanishes on `W₁ ∩ W₂` when `X` vanishes on `W₁` and `Y` on `W₂`
    have hsupp : (X - Y).support ⊆ X.support ∪ Y.support := by
      rintro x ⟨-, hx⟩
      by_contra hxy
      simp only [mem_union, not_or] at hxy
      obtain ⟨W₁, ⟨hW₁o, hW₁c, -, hW₁v⟩, hxW₁⟩ : x ∈ X.zeroRegion :=
        not_not.1 fun h => hxy.1 ⟨mem_univ x, h⟩
      obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hxW₂⟩ : x ∈ Y.zeroRegion :=
        not_not.1 fun h => hxy.2 ⟨mem_univ x, h⟩
      refine hx ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o, ?_, subset_univ _, fun ω hω => ?_⟩, hxW₁, hxW₂⟩
      · exact hW₁c.of_isClosed_subset isClosed_closure (closure_mono inter_subset_left)
      · show X ω - Y ω = 0
        rw [hW₁v ω (hω.trans inter_subset_left), hW₂v ω (hω.trans inter_subset_right), sub_zero]
    refine ⟨hsupp, (hX1.union hY1).of_isClosed_subset (hclosed k _) hsupp,
      (key k X Y).trans_lt (ENNReal.add_lt_top.2 ⟨hX2, hY2⟩), ?_⟩
    cases k with
    | zero => exact ENNReal.zero_lt_top
    | succ k' =>
      -- `∂(X − Y) = ∂X − ∂Y`
      have hb : (X - Y).boundary = X.boundary - Y.boundary := by
        ext ω
        rfl
      show (X - Y).boundary.massOn univ < ∞
      rw [hb]
      exact (key k' _ _).trans_lt (ENNReal.add_lt_top.2 ⟨hX3, hY3⟩)
  -- NC is closed under `∂`: `spt ∂X ⊆ spt X` and `∂∂X = 0`
  have hNCbd : ∀ (k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)),
      IsCompact X.support → X.boundary.support ⊆ X.support ∧ IsCompact X.boundary.support ∧
        boundaryMassOn X.boundary univ < ∞ := by
    intro k X hX
    -- `∂X` vanishes wherever `X` does, since `spt dω ⊆ spt ω`
    have hsupp : X.boundary.support ⊆ X.support := by
      rintro x ⟨-, hx⟩
      refine ⟨mem_univ x, fun hxX => hx ?_⟩
      obtain ⟨W, ⟨hWo, hWc, hWU, hWv⟩, hxW⟩ := hxX
      exact ⟨W, ⟨hWo, hWc, hWU, fun ω hω =>
        hWv _ ((tsupport_exteriorDerivative_subset _).trans hω)⟩, hxW⟩
    refine ⟨hsupp, hX.of_isClosed_subset (hclosed k _) hsupp, ?_⟩
    cases k with
    | zero => exact ENNReal.zero_lt_top
    | succ k' =>
      -- `∂∂X = 0`, and the zero current has zero mass
      show X.boundary.boundary.massOn univ < ∞
      rw [X.boundary_boundary]
      refine lt_of_le_of_lt (sSup_le ?_) ENNReal.zero_lt_top
      rintro r ⟨ω, -, rfl⟩
      simp
  -- C1: cut-off straight-line homotopies `Ĥ(y) = F(x) + c(t) χ(x) (G(x) − F(x))`, `y = ι(t, x)`,
  -- with `c(t) = max 0 (min 1 t)` and `χ(x) = max 0 (min 1 (R + 1 − ‖x‖))`, `S ⊆ B̄(0, R)`
  obtain ⟨Hc, hHc_lip, hHc_eq⟩ : ∃ Hc : (Euclid P → Euclid P) → (Euclid P → Euclid P) →
      Set (Euclid P) → Euclid (P + 1) → Euclid P,
      (∀ (Λ : NNReal) (F G : Euclid P → Euclid P) (S : Set (Euclid P)), LipschitzWith Λ F →
        LipschitzWith Λ G → IsCompact S → ∃ L : NNReal, LipschitzWith L (Hc F G S)) ∧
      ∀ (F G : Euclid P → Euclid P) (S : Set (Euclid P)), IsCompact S → ∀ x ∈ S,
        ∀ t ∈ Icc (0 : ℝ) 1,
          Hc F G S (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) = F x + t • (G x - F x) := by
    -- a radius `R S` with `S ⊆ B̄(0, R S)` for every compact `S`
    have hR : ∀ S : Set (Euclid P), ∃ R : ℝ, IsCompact S → S ⊆ closedBall 0 R := by
      intro S
      by_cases hS : IsCompact S
      · obtain ⟨R, hR⟩ := hS.isBounded.subset_closedBall 0
        exact ⟨R, fun _ => hR⟩
      · exact ⟨0, fun h => absurd h hS⟩
    choose R hR using hR
    -- the coordinates `y = ι(y₀, tail y)` of `ℝ^{P+1}`; both are 1-Lipschitz
    let tl : Euclid (P + 1) → Euclid P := fun y => WithLp.toLp 2 (Fin.tail (WithLp.ofLp y))
    have htl : ∀ (t : ℝ) (x : Euclid P),
        tl (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) = x := by
      intro t x
      simp [tl]
    have htl_lip : ∀ y y' : Euclid (P + 1), dist (tl y) (tl y') ≤ dist y y' := by
      intro y y'
      rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq]
      refine Real.sqrt_le_sqrt ?_
      rw [Fin.sum_univ_succ]
      exact le_add_of_nonneg_left (sq_nonneg _)
    have hfst_lip : LipschitzWith 1 (fun y : Euclid (P + 1) => y 0) :=
      LipschitzWith.of_dist_le_mul fun y y' => by simpa using PiLp.dist_apply_le y y' 0
    -- `a u − b v = (a − b) u + b (u − v)`
    have hsplit : ∀ (a b : ℝ) (u v : Euclid P), a • u - b • v = (a - b) • u + b • (u - v) := by
      intro a b u v
      rw [sub_smul, smul_sub]
      abel
    refine ⟨fun F G S y => F (tl y) + max 0 (min 1 (y 0)) •
      (max 0 (min 1 (R S + 1 - ‖tl y‖)) • (G (tl y) - F (tl y))), ?_, ?_⟩
    · intro Λ F G S hF hG hS
      -- `χ(x) = max 0 (min 1 (R S + 1 − ‖x‖))` is 1-Lipschitz, `0 ≤ χ ≤ 1`, and `χ(x) ≠ 0` forces
      -- `‖x‖ ≤ |R S| + 1`
      set χ : Euclid P → ℝ := fun x => max 0 (min 1 (R S + 1 - ‖x‖))
      have hχ_lip : ∀ x x', |χ x - χ x'| ≤ dist x x' := by
        have hlin : LipschitzWith 1 (fun x : Euclid P => R S + 1 - ‖x‖) := by
          refine LipschitzWith.of_dist_le_mul fun x x' => ?_
          rw [Real.dist_eq, NNReal.coe_one, one_mul, dist_eq_norm]
          calc |R S + 1 - ‖x‖ - (R S + 1 - ‖x'‖)| = |‖x'‖ - ‖x‖| := by ring_nf
            _ ≤ ‖x' - x‖ := abs_norm_sub_norm_le x' x
            _ = ‖x - x'‖ := norm_sub_rev x' x
        intro x x'
        have h := ((hlin.const_min 1).const_max 0).dist_le_mul x x'
        rwa [NNReal.coe_one, one_mul, Real.dist_eq] at h
      have hχ0 : ∀ x, 0 ≤ χ x := fun x => le_max_left _ _
      have hχ1 : ∀ x, |χ x| ≤ 1 := fun x => by
        rw [abs_of_nonneg (hχ0 x)]
        exact max_le zero_le_one (min_le_left _ _)
      have hχsupp : ∀ x, χ x ≠ 0 → ‖x‖ ≤ |R S| + 1 := by
        intro x hx
        by_contra h
        refine hx (max_eq_left (min_le_of_right_le ?_))
        linarith [le_abs_self (R S)]
      -- `D = G − F` is `2Λ`-Lipschitz, and `‖D(x)‖ ≤ B` where `χ(x) ≠ 0`
      set B : ℝ := ‖G 0 - F 0‖ + 2 * Λ * (|R S| + 1)
      have hΛ : (0 : ℝ) ≤ Λ := Λ.2
      have hB0 : 0 ≤ B := by positivity
      have hD_lip : ∀ x x', ‖(G x - F x) - (G x' - F x')‖ ≤ 2 * Λ * dist x x' := by
        intro x x'
        have hFd := hF.dist_le_mul x x'
        have hGd := hG.dist_le_mul x x'
        rw [dist_eq_norm] at hFd hGd
        calc ‖(G x - F x) - (G x' - F x')‖ = ‖(G x - G x') - (F x - F x')‖ := by
              congr 1
              abel
          _ ≤ ‖G x - G x'‖ + ‖F x - F x'‖ := norm_sub_le _ _
          _ ≤ Λ * dist x x' + Λ * dist x x' := add_le_add hGd hFd
          _ = 2 * Λ * dist x x' := by ring
      have hD_bd : ∀ x, χ x ≠ 0 → ‖G x - F x‖ ≤ B := by
        intro x hx
        have h0 := hD_lip x 0
        rw [dist_zero_right] at h0
        have h3 := norm_sub_norm_le (G x - F x) (G 0 - F 0)
        have h4 : 2 * Λ * ‖x‖ ≤ 2 * Λ * (|R S| + 1) :=
          mul_le_mul_of_nonneg_left (hχsupp x hx) (by positivity)
        linarith
      -- `φ = χ • D` is bounded by `B` and `(B + 2Λ)`-Lipschitz
      have hφ_bd : ∀ x, ‖χ x • (G x - F x)‖ ≤ B := by
        intro x
        by_cases hx : χ x = 0
        · rw [hx, zero_smul, norm_zero]
          exact hB0
        · rw [norm_smul, Real.norm_eq_abs]
          calc |χ x| * ‖G x - F x‖ ≤ 1 * B :=
                mul_le_mul (hχ1 x) (hD_bd x hx) (norm_nonneg _) zero_le_one
            _ = B := one_mul B
      have hφ_one : ∀ x x', χ x ≠ 0 →
          dist (χ x • (G x - F x)) (χ x' • (G x' - F x')) ≤ (B + 2 * Λ) * dist x x' := by
        intro x x' hx
        rw [dist_eq_norm]
        calc ‖χ x • (G x - F x) - χ x' • (G x' - F x')‖ =
              ‖(χ x - χ x') • (G x - F x) + χ x' • ((G x - F x) - (G x' - F x'))‖ := by
              rw [hsplit]
          _ ≤ ‖(χ x - χ x') • (G x - F x)‖ + ‖χ x' • ((G x - F x) - (G x' - F x'))‖ :=
              norm_add_le _ _
          _ = |χ x - χ x'| * ‖G x - F x‖ + |χ x'| * ‖(G x - F x) - (G x' - F x')‖ := by
              rw [norm_smul (χ x - χ x'), norm_smul (χ x'), Real.norm_eq_abs, Real.norm_eq_abs]
          _ ≤ dist x x' * B + 1 * (2 * Λ * dist x x') :=
              add_le_add (mul_le_mul (hχ_lip x x') (hD_bd x hx) (norm_nonneg _) dist_nonneg)
                (mul_le_mul (hχ1 x') (hD_lip x x') (norm_nonneg _) zero_le_one)
          _ = (B + 2 * Λ) * dist x x' := by ring
      have hφ_lip : ∀ x x',
          dist (χ x • (G x - F x)) (χ x' • (G x' - F x')) ≤ (B + 2 * Λ) * dist x x' := by
        intro x x'
        by_cases hx : χ x = 0
        · by_cases hx' : χ x' = 0
          · rw [hx, hx', zero_smul, zero_smul, dist_self]
            positivity
          · rw [dist_comm, dist_comm x x']
            exact hφ_one x' x hx'
        · exact hφ_one x x' hx
      -- `c(y) = max 0 (min 1 y₀)` is 1-Lipschitz with `|c| ≤ 1`
      have hc_lip : ∀ y y' : Euclid (P + 1),
          |max 0 (min 1 (y 0)) - max 0 (min 1 (y' 0))| ≤ dist y y' := by
        intro y y'
        have h := ((hfst_lip.const_min 1).const_max 0).dist_le_mul y y'
        rwa [NNReal.coe_one, one_mul, Real.dist_eq] at h
      have hc1 : ∀ y : Euclid (P + 1), |max 0 (min 1 (y 0))| ≤ 1 := fun y => by
        rw [abs_of_nonneg (le_max_left _ _)]
        exact max_le zero_le_one (min_le_left _ _)
      -- `Ĥ(y) = F(tail y) + c(y) • φ(tail y)` is `(Λ + 2B + 2Λ)`-Lipschitz
      refine ⟨Real.toNNReal (Λ + (B + (B + 2 * Λ))), LipschitzWith.of_dist_le' fun y y' => ?_⟩
      have htd := htl_lip y y'
      have hFd : dist (F (tl y)) (F (tl y')) ≤ Λ * dist y y' :=
        (hF.dist_le_mul _ _).trans (mul_le_mul_of_nonneg_left htd hΛ)
      have hψd : dist (max 0 (min 1 (y 0)) • (χ (tl y) • (G (tl y) - F (tl y))))
          (max 0 (min 1 (y' 0)) • (χ (tl y') • (G (tl y') - F (tl y')))) ≤
            (B + (B + 2 * Λ)) * dist y y' := by
        set c := max 0 (min 1 (y 0))
        set c' := max 0 (min 1 (y' 0))
        set u := χ (tl y) • (G (tl y) - F (tl y))
        set u' := χ (tl y') • (G (tl y') - F (tl y'))
        rw [dist_eq_norm]
        calc ‖c • u - c' • u'‖ = ‖(c - c') • u + c' • (u - u')‖ := by
              rw [hsplit]
          _ ≤ ‖(c - c') • u‖ + ‖c' • (u - u')‖ := norm_add_le _ _
          _ = |c - c'| * ‖u‖ + |c'| * ‖u - u'‖ := by
              rw [norm_smul (c - c') u, norm_smul c' (u - u'), Real.norm_eq_abs, Real.norm_eq_abs]
          _ ≤ dist y y' * B + 1 * ((B + 2 * Λ) * dist y y') := by
              refine add_le_add (mul_le_mul (hc_lip y y') (hφ_bd _) (norm_nonneg _) dist_nonneg)
                (mul_le_mul (hc1 y') ?_ (norm_nonneg _) zero_le_one)
              rw [← dist_eq_norm]
              exact (hφ_lip _ _).trans (mul_le_mul_of_nonneg_left htd (by positivity))
          _ = (B + (B + 2 * Λ)) * dist y y' := by ring
      calc dist (F (tl y) + max 0 (min 1 (y 0)) • (χ (tl y) • (G (tl y) - F (tl y))))
            (F (tl y') + max 0 (min 1 (y' 0)) • (χ (tl y') • (G (tl y') - F (tl y')))) ≤
            dist (F (tl y)) (F (tl y')) +
              dist (max 0 (min 1 (y 0)) • (χ (tl y) • (G (tl y) - F (tl y))))
                (max 0 (min 1 (y' 0)) • (χ (tl y') • (G (tl y') - F (tl y')))) :=
            dist_add_add_le _ _ _ _
        _ ≤ Λ * dist y y' + (B + (B + 2 * Λ)) * dist y y' := add_le_add hFd hψd
        _ = (Λ + (B + (B + 2 * Λ))) * dist y y' := by ring
    · intro F G S hS x hx t ht
      have hxR : ‖x‖ ≤ R S := by simpa using hR S hS hx
      simp only [htl, Fin.cons_zero]
      rw [min_eq_right ht.2, max_eq_right ht.1, min_eq_left (by linarith),
        max_eq_right zero_le_one, one_smul]
  -- the homotopy operator `homot k F G X = Ĥ_X#([[0, 1]] × X)`, `Ĥ_X` cut off near `spt X`
  obtain ⟨homot, hhomot⟩ : ∃ homot : ∀ k : ℕ, (Euclid P → Euclid P) → (Euclid P → Euclid P) →
      GeometricCurrentOn (univ : Set (Euclid P)) k →
        GeometricCurrentOn (univ : Set (Euclid P)) (k + 1),
      ∀ k F G X, homot k F G X = lpush (P + 1) P (k + 1) (Hc F G X.support) (cyl P k X) :=
    ⟨_, fun _ _ _ _ => rfl⟩
  -- C1′: `homot k F G X = H#([[0, 1]] × X)` for every Lipschitz `H` agreeing with
  -- `F + t (G − F)` on `[0, 1] × spt X` (operators (3) in `ℝ^{P+1}`, as `spt cyl X` lies there)
  have hC1 : ∀ (k : ℕ) (Λ L : NNReal) (F G : Euclid P → Euclid P) (H : Euclid (P + 1) → Euclid P)
      (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G →
      LipschitzWith L H → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ →
      (∀ x ∈ X.support, ∀ t ∈ Icc (0 : ℝ) 1,
        H (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) = F x + t • (G x - F x)) →
      homot k F G X = lpush (P + 1) P (k + 1) H (cyl P k X) := by
    intro k Λ L F G H X hF hG hH hX1 hX2 hX3 hHX
    obtain ⟨L₀, hL₀⟩ := hHc_lip Λ F G X.support hF hG hX1
    obtain ⟨hc1, hc2, hc3, hc4⟩ := h7 P k X hX1 hX2 hX3
    rw [hhomot]
    refine h3 (P + 1) P (k + 1) (max L₀ L) _ _ (cyl P k X) (hL₀.weaken (le_max_left _ _))
      (hH.weaken (le_max_right _ _)) hc1 hc2 hc3 ?_
    intro y hy
    obtain ⟨t, ht, x, hx, rfl⟩ := hc4 hy
    rw [hHc_eq F G X.support hX1 x hx t ht, hHX x hx t ht]
  refine ⟨fun k => lpush P P k, homot, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- C2: identity
    intro k X hX1 hX2 hX3
    exact h1 P k X hX1 hX2 hX3
  · -- C3: linearity; one cut-off homotopy serves `X`, `Y` and `X − Y`
    intro k Λ F G X Y hF hG hX1 hX2 hX3 hY1 hY2 hY3
    refine ⟨h2 P P k Λ F X Y hF hX1 hX2 hX3 hY1 hY2 hY3, ?_⟩
    obtain ⟨hsub, hZ1, hZ2, hZ3⟩ := hNCsub k X Y hX1 hX2 hX3 hY1 hY2 hY3
    have hS : IsCompact (X.support ∪ Y.support) := hX1.union hY1
    obtain ⟨L, hL⟩ := hHc_lip Λ F G _ hF hG hS
    have hagree : ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) k,
        Z.support ⊆ X.support ∪ Y.support → ∀ x ∈ Z.support, ∀ t ∈ Icc (0 : ℝ) 1,
          Hc F G (X.support ∪ Y.support) (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) =
            F x + t • (G x - F x) :=
      fun Z hZ x hx t ht => hHc_eq F G _ hS x (hZ hx) t ht
    rw [hC1 k Λ L F G _ (X - Y) hF hG hL hZ1 hZ2 hZ3 (hagree _ hsub),
      hC1 k Λ L F G _ X hF hG hL hX1 hX2 hX3 (hagree _ subset_union_left),
      hC1 k Λ L F G _ Y hF hG hL hY1 hY2 hY3 (hagree _ subset_union_right),
      h8 P k X Y hX1 hX2 hX3 hY1 hY2 hY3]
    obtain ⟨hcX1, hcX2, hcX3, -⟩ := h7 P k X hX1 hX2 hX3
    obtain ⟨hcY1, hcY2, hcY3, -⟩ := h7 P k Y hY1 hY2 hY3
    exact h2 (P + 1) P (k + 1) L _ (cyl P k X) (cyl P k Y) hL hcX1 hcX2 hcX3 hcY1 hcY2 hcY3
  · -- C4: locality
    intro k Λ F G F' G' X hF hG hF' hG' hX1 hX2 hX3 hFF hGG
    refine ⟨h3 P P k Λ F F' X hF hF' hX1 hX2 hX3 hFF, ?_⟩
    obtain ⟨L, hL⟩ := hHc_lip Λ F G X.support hF hG hX1
    rw [hC1 k Λ L F' G' (Hc F G X.support) X hF' hG' hL hX1 hX2 hX3 fun x hx t ht => by
      rw [hHc_eq F G _ hX1 x hx t ht, hFF hx, hGG hx], hhomot]
  · -- C5: mass and support
    intro k Λ F G X hF hG hX1 hX2 hX3
    obtain ⟨hm, hs⟩ := h4 P P k Λ F X hF hX1 hX2 hX3
    obtain ⟨L, hL⟩ := hHc_lip Λ F G X.support hF hG hX1
    obtain ⟨hc1, hc2, hc3, hc4⟩ := h7 P k X hX1 hX2 hX3
    refine ⟨hm, hs, fun δ hδ => ?_, ?_⟩
    · rw [hhomot]
      exact h12 P P k Λ L F G _ X δ hF hG hL hX1 hX2 hX3 (hHc_eq F G _ hX1) hδ
    · rw [hhomot]
      intro y hy
      obtain ⟨z, hz, rfl⟩ := (h4 (P + 1) P (k + 1) L _ (cyl P k X) hL hc1 hc2 hc3).2 hy
      obtain ⟨t, ht, x, hx, rfl⟩ := hc4 hz
      exact ⟨x, hx, t, ht, hHc_eq F G _ hX1 x hx t ht⟩
  · -- C6: boundary, homotopy formula and integrality in degree `k + 1`
    intro k Λ F G X hF hG hX1 hX2 hX3
    obtain ⟨L, hL⟩ := hHc_lip Λ F G X.support hF hG hX1
    obtain ⟨hb1, hb2, hb3⟩ := hNCbd k X hX1
    refine ⟨h5 P P k Λ F X hF hX1 hX2 hX3, ?_, fun hIM => ⟨?_, ?_⟩⟩
    · rw [hC1 k Λ L F G (Hc F G X.support) X.boundary hF hG hL hb2 hX3 hb3
        fun x hx t ht => hHc_eq F G _ hX1 x (hb1 hx) t ht, hhomot]
      exact h11 P P k Λ L F G _ X hF hG hL hX1 hX2 hX3 (hHc_eq F G _ hX1)
    · exact hI P P k Λ F X _ hF hIM hX1 hX2 (h6 P P (k + 1) Λ F X hF hX1 hX2 hX3)
    · rw [hhomot]
      obtain ⟨hc1, hc2, hc3, -⟩ := h7 P (k + 1) X hX1 hX2 hX3
      have hC : IsIntegerMultiplicity (cyl P (k + 1) X) :=
        hII P k X _ hIM hX1 hX2 (h9 P (k + 1) X hX1 hX2 hX3)
      exact hI (P + 1) P (k + 1) L _ (cyl P (k + 1) X) _ hL hC hc1 hc2
        (h6 (P + 1) P (k + 1 + 1) L _ (cyl P (k + 1) X) hL hc1 hc2 hc3)
  · -- C7: degree `0`
    intro Λ F G X hF hG hX1 hX2
    obtain ⟨L, hL⟩ := hHc_lip Λ F G X.support hF hG hX1
    rw [hhomot]
    exact h10 P P Λ L F G _ X hF hG hL hX1 hX2 (hHc_eq F G _ hX1)

/-- **Test forms in `U` restrict to compactly supported continuous maps on `U`** (the maps
`g_ω(x) = c(ω(x))` to which the Riesz representation theorem is applied for
`T(ω) = ∫ ⟨ω, T⃗⟩ dμ_T`, Simon Ch. 6, 2.7–2.8; here for any continuous `f` with `f 0 = 0`).
Let `val : U → ℝᴾ` be the inclusion and `K = tsupport ω`.  The map `G = f ∘ ω ∘ val` is
continuous, since `ω` is smooth.  `K` is compact and `K ⊆ U = range val`, so `val⁻¹(K)` is
compact because `val` is inducing.  Off `val⁻¹(K)`, `ω(val x) = 0` and `G x = f 0 = 0`.  So `G`
has compact support in the Hausdorff space `U`, and `g = G ∈ C_c(U, ℝᵈ)`. -/
theorem Submission.cmrc_testForm_restrict_cc : ∀ (P n d : ℕ) (U : Set (Euclid P)) (f : Covector (Euclid P) n → EuclideanSpace ℝ (Fin d)), Continuous f → f 0 = 0 → ∀ ω : TestFormOn U n, ∃ g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)), ∀ x : U, g x = f ((ω : DifferentialForm (Euclid P) n) x) := by
  intro P n d U f hf hf0 ω
  -- `ω` is smooth with compact support `K = tsupport ω ⊆ U`
  obtain ⟨⟨hωs, hωc⟩, hωU⟩ : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.2
  -- Step 1: `G = f ∘ ω ∘ val` is continuous
  have hGc : Continuous fun x : U => f ((ω : DifferentialForm (Euclid P) n) x) :=
    hf.comp ((ContDiff.continuous hωs).comp continuous_subtype_val)
  -- Step 2: `val⁻¹(K)` is compact, as `val` is inducing and `K ⊆ U = range val`
  have hK : IsCompact ((↑) ⁻¹' tsupport (ω : DifferentialForm (Euclid P) n) : Set U) :=
    Topology.IsInducing.subtypeVal.isCompact_preimage' hωc.isCompact
      (by rwa [Subtype.range_coe])
  -- Step 3: `G x = f 0 = 0` for `x ∉ val⁻¹(K)`, so `G` has compact support
  have hGs : HasCompactSupport fun x : U => f ((ω : DifferentialForm (Euclid P) n) x) :=
    HasCompactSupport.intro hK fun x hx =>
      (congrArg f (image_eq_zero_of_notMem_tsupport
        (show (x : Euclid P) ∉ tsupport (ω : DifferentialForm (Euclid P) n) from hx))).trans hf0
  exact ⟨⟨⟨fun x => f ((ω : DifferentialForm (Euclid P) n) x), hGc⟩, hGs⟩, fun _ => rfl⟩
/-- **Scalar tests of density-represented top-dimensional currents**: if `Y_k(ω) = ∫_U u_k ω(e)`
for every test `n`-form `ω` on `U ⊆ ℝⁿ` and `Y_k ⇀` the current `ω ↦ c ∫ ω(e)`, then
`∫_U u_k b → c ∫ b` for every smooth compactly supported `b` with `spt b ⊆ U`.  Test with
`ω_b = b • δ`, `δ` the determinant covector (`δ(e₁, …, eₙ) = 1`), so that `ω_b(y)(e) = b(y)`. -/
theorem Submission.cbr_ci_pw_l1_scalar_test_tendsto : ∀ (n : ℕ) (U : Set (Euclid n)) (c : ℝ) (Y : ℕ → GeometricCurrentOn U n) (u : ℕ → Euclid n → ℝ), (∀ (k : ℕ) (ω : TestFormOn U n), Y k ω = ∫ y in U, u k y * (ω : DifferentialForm (Euclid n) n) y (fun i => EuclideanSpace.single i (1 : ℝ))) → (∀ ω : TestFormOn U n, Tendsto (fun k => Y k ω) atTop (𝓝 (c * ∫ y, (ω : DifferentialForm (Euclid n) n) y (fun i => EuclideanSpace.single i (1 : ℝ))))) → ∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U → Tendsto (fun k => ∫ y in U, u k y * b y) atTop (𝓝 (c * ∫ y, b y)) := by
  intro n U c Y u hrep hweak b hb hbc hbU
  obtain ⟨δ, hδ⟩ := Submission.dgoj_exists_det_covector n
  have hmem : (fun y => b y • δ : DifferentialForm (Euclid n) n) ∈ testFormOnSubmodule (E := Euclid n) U n :=
    ⟨⟨hb.smul contDiff_const, hbc.smul_right⟩, (tsupport_smul_subset_left b (fun _ => δ)).trans hbU⟩
  let ω : TestFormOn U n := ⟨fun y => b y • δ, hmem⟩
  have hωe : ∀ y, (ω : DifferentialForm (Euclid n) n) y (fun i => EuclideanSpace.single i (1 : ℝ)) = b y := by
    intro y
    simp [ω, hδ]
  have h1 := hweak ω
  simp only [hωe] at h1
  refine h1.congr (fun k => ?_)
  rw [hrep k ω]
  simp only [hωe]
/-- **Variation bound for the `L¹` representative** (Simon 6.2.5 applied to `∂Y`): if
`Y(ω) = ∫_U u ⟨ω, e⟩` for all test `(d+1)`-forms, `M_U(∂Y) < ∞`, `|ε| ≤ ‖z‖`,
`d(f ε)(e) = Df(z)`, and `f` is a smooth compactly supported function in `U` with `|f| ≤ M`, then
`|∫_U u Df(z)| ≤ M_U(∂Y) ‖z‖ M`.  Indeed `γ = f ε` is a test `d`-form with `spt γ ⊆ U` and
`|γ| = |f| |ε| ≤ M ‖z‖`, so `|∂Y(γ)| ≤ M ‖z‖ M_U(∂Y)`, while `∂Y(γ) = Y(dγ) = ∫_U u Df(z)`. -/
theorem Submission.cbr_ci_pw_l1_boundary_variation_bound : ∀ (d : ℕ) (U : Set (Euclid (d + 1))) (Y : GeometricCurrentOn U (d + 1)) (u : Euclid (d + 1) → ℝ) (ε : Covector (Euclid (d + 1)) d) (f : Euclid (d + 1) → ℝ) (z : Euclid (d + 1)) (M : ℝ), (∀ ω : TestFormOn U (d + 1), Y ω = ∫ y in U, u y * (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y (fun i => EuclideanSpace.single i (1 : ℝ))) → Y.boundary.massOn U ≠ ∞ → covectorEuclideanNorm ε ≤ ‖z‖ → (∀ y, exteriorDerivative (fun x => f x • ε) y (fun i => EuclideanSpace.single i (1 : ℝ)) = fderiv ℝ f y z) → ContDiff ℝ (⊤ : ℕ∞) f → HasCompactSupport f → tsupport f ⊆ U → (∀ y, |f y| ≤ M) → |∫ y in U, u y * fderiv ℝ f y z| ≤ (Y.boundary.massOn U).toReal * ‖z‖ * M := by
  intro d U Y u ε f z M hrep hfin hεn hεd hf hfc hfU hM
  -- the test `d`-form `γ = f ε`, with `spt γ ⊆ spt f ⊆ U`
  have hsupp : tsupport (fun x => f x • ε : DifferentialForm (Euclid (d + 1)) d) ⊆ U :=
    (tsupport_smul_subset_left f (fun _ => ε)).trans hfU
  have hmem : (fun x => f x • ε : DifferentialForm (Euclid (d + 1)) d) ∈
      testFormOnSubmodule (E := Euclid (d + 1)) U d :=
    ⟨⟨hf.smul contDiff_const, hfc.smul_right⟩, hsupp⟩
  let γ : TestFormOn U d := ⟨fun x => f x • ε, hmem⟩
  -- `|γ(x)| = |f(x)| |ε| ≤ M ‖z‖`
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hbound : ∀ x, covectorEuclideanNorm ((γ : DifferentialForm (Euclid (d + 1)) d) x) ≤
      M * ‖z‖ := by
    intro x
    change covectorEuclideanNorm (f x • ε) ≤ M * ‖z‖
    rw [(Submission.rsd_mw_tfa_norm_props (d + 1) d).2.1]
    exact mul_le_mul (hM x) hεn (covectorEuclideanNorm_nonneg ε) hM0
  -- `|∂Y(γ)| ≤ M ‖z‖ M_U(∂Y)`
  have key := Submission.cmr_abs_apply_le_massOn (d + 1) d U U Y.boundary γ (M * ‖z‖) hfin hsupp
    hbound
  -- `∂Y(γ) = Y(dγ) = ∫_U u Df(z)`
  have heq : Y.boundary γ = ∫ y in U, u y * fderiv ℝ f y z := by
    rw [GeometricCurrentOn.boundary_apply, hrep]
    congr 1
    funext y
    change u y * exteriorDerivative (fun x => f x • ε) y
      (fun i => EuclideanSpace.single i (1 : ℝ)) = _
    rw [hεd y]
  rw [heq] at key
  calc |∫ y in U, u y * fderiv ℝ f y z| ≤ M * ‖z‖ * (Y.boundary.massOn U).toReal := key
    _ = (Y.boundary.massOn U).toReal * ‖z‖ * M := by ring
/-- **`L¹` squeeze through mollifications**: let `R > 0`, `φ` continuous with compact support,
`u k` integrable on `B_{2R}(0)` and `w k x = ∫_{B_{2R}(0)} u k y φ(x - y) dy`.  If `w k → c`
uniformly on `closedBall 0 R`, `a k → 0` and eventually `∫_{B_R(0)} |u k - w k| ≤ a k`, then
`∫_{B_R(0)} |u k - c| → 0`.  Each `w k` is continuous (dominated continuity with bound
`|u k| sup |φ|`), hence integrable on `B_R(0)`; the triangle inequality gives
`∫_{B_R} |u k - c| ≤ ∫_{B_R} |u k - w k| + ∫_{B_R} |w k - c| ≤ a k + η |B_R|` once
`|w k - c| < η` on `closedBall 0 R`, and `η = ε / (2 (|B_R| + 1))` makes this `< ε`. -/
theorem Submission.cbr_ci_pw_l1_squeeze_of_mollified : ∀ (n : ℕ) (R c : ℝ) (φ : Euclid n → ℝ) (u : ℕ → Euclid n → ℝ) (a : ℕ → ℝ), 0 < R → Continuous φ → HasCompactSupport φ → (∀ k, IntegrableOn (u k) (ball 0 (2 * R))) → TendstoUniformlyOn (fun k x => ∫ y in ball 0 (2 * R), u k y * φ (x - y)) (fun _ => c) atTop (closedBall 0 R) → Tendsto a atTop (𝓝 0) → (∀ᶠ k in atTop, ∫ x in ball 0 R, |u k x - ∫ y in ball 0 (2 * R), u k y * φ (x - y)| ≤ a k) → Tendsto (fun k => ∫ x in ball 0 R, |u k x - c|) atTop (𝓝 0) := by
  intro n R c φ u a hR hφ hφc hint hunif ha hbound
  obtain ⟨C, hC⟩ := hφ.bounded_above_of_compact_support hφc
  -- continuity of the mollifications
  have hwcont : ∀ k, Continuous (fun x => ∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) := by
    intro k
    refine continuous_of_dominated (bound := fun y => ‖u k y‖ * C) (fun x => ?_) (fun x => ?_) ?_ ?_
    · exact (hint k).aestronglyMeasurable.mul
        (hφ.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
    · refine Eventually.of_forall fun y => ?_
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hC _) (norm_nonneg _)
    · exact (hint k).norm.mul_const C
    · exact Eventually.of_forall fun y => continuous_const.mul (hφ.comp (continuous_id.sub continuous_const))
  have hBR : ball (0 : Euclid n) R ⊆ ball 0 (2 * R) := ball_subset_ball (by linarith)
  have hvol : volume (ball (0 : Euclid n) R) < ∞ := measure_ball_lt_top
  have hwint : ∀ k, IntegrableOn (fun x => ∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) (ball 0 R) :=
    fun k => ((hwcont k).continuousOn.integrableOn_compact (isCompact_closedBall 0 R)).mono_set
      ball_subset_closedBall
  have huint : ∀ k, IntegrableOn (u k) (ball 0 R) := fun k => (hint k).mono_set hBR
  have hcint : IntegrableOn (fun _ : Euclid n => c) (ball 0 R) := integrableOn_const hvol.ne
  have htri : ∀ k, ∫ x in ball 0 R, |u k x - c| ≤
      (∫ x in ball 0 R, |u k x - ∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)|) +
        ∫ x in ball 0 R, |(∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) - c| := by
    intro k
    have hA : IntegrableOn (fun x => |u k x - ∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)|)
        (ball 0 R) := ((huint k).sub (hwint k)).abs
    have hB : IntegrableOn (fun x => |(∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) - c|)
        (ball 0 R) := ((hwint k).sub hcint).abs
    rw [← integral_add hA hB]
    exact integral_mono_of_nonneg (Eventually.of_forall fun x => abs_nonneg _) (hA.add hB)
      (Eventually.of_forall fun x => abs_sub_le _ _ _)
  set m := (volume (ball (0 : Euclid n) R)).toReal with hm
  have hm0 : 0 ≤ m := ENNReal.toReal_nonneg
  rw [Metric.tendsto_nhds]
  intro ε hε
  have hη0 : 0 < ε / (2 * (m + 1)) := by positivity
  have h1 := Metric.tendstoUniformlyOn_iff.1 hunif _ hη0
  have h2 := Metric.tendsto_nhds.1 ha (ε / 2) (by positivity)
  filter_upwards [h1, h2, hbound] with k hk1 hk2 hk3
  have hwc : ∫ x in ball 0 R, |(∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) - c| ≤
      ε / (2 * (m + 1)) * m := by
    have := norm_setIntegral_le_of_norm_le_const hvol (C := ε / (2 * (m + 1)))
      (f := fun x => |(∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) - c|) (fun x hx => by
        have := hk1 x (ball_subset_closedBall hx)
        rw [Real.dist_eq] at this
        rw [Real.norm_eq_abs, abs_abs, abs_sub_comm]
        exact this.le)
    exact (le_abs_self _).trans ((Real.norm_eq_abs _).symm ▸ this)
  have hnn : 0 ≤ ∫ x in ball 0 R, |u k x - c| := integral_nonneg fun x => abs_nonneg _
  rw [Real.dist_eq, sub_zero, abs_of_nonneg hnn]
  rw [Real.dist_eq, sub_zero] at hk2
  have hak : a k < ε / 2 := (le_abs_self _).trans_lt hk2
  have hlast : ε / (2 * (m + 1)) * m < ε / 2 := by
    rw [div_mul_eq_mul_div, div_lt_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  have := htri k
  linarith
/-- **The interior-product covector `ι_z(dy)` on `ℝ^{d+1}`** (used for the `d`-form `f · ι_z(dy)`,
whose exterior derivative is `(∂_z f) dy`, in White's projection argument for the closure theorem
behind Simon 7.2.4; cf. the forms `ωⱼ` in the proof of Simon 6.2.34).  For `z ∈ ℝ^{d+1}` there is
a continuous alternating `d`-form `ε` on `ℝ^{d+1}` with `ε(e₀, …, êᵢ, …, e_d) = (−1)ⁱ zᵢ`:
`ε(u₁, …, u_d) = det [z | u₁ | ⋯ | u_d] = δ(z, u₁, …, u_d)` for the standard determinant form `δ`. -/
theorem Submission.cbr_ci_pw_ipf_coord_covector : ∀ (d : ℕ) (z : Euclid (d + 1)), ∃ ε : Covector (Euclid (d + 1)) d, ∀ i : Fin (d + 1), ε (i.removeNth (fun l : Fin (d + 1) => EuclideanSpace.single l (1 : ℝ))) = (-1 : ℝ) ^ (i : ℕ) * z i := by
  intro d z
  classical
  -- The standard basis `b l = e_l` and its determinant `δ₀ c = det (c l r)_{r,l}`.
  let b : Module.Basis (Fin (d + 1)) ℝ (Euclid (d + 1)) :=
    (EuclideanSpace.basisFun (Fin (d + 1)) ℝ).toBasis
  have hdet : ∀ c : Fin (d + 1) → Euclid (d + 1), b.det c = (Matrix.of fun r l => c l r).det := by
    intro c
    rw [Module.Basis.det_apply]
    congr 1
  -- `δ₀` is continuous (entrywise continuous matrix, then `det`), so it is a covector `δ`.
  have hcont : Continuous (fun c : Fin (d + 1) → Euclid (d + 1) => b.det c) := by
    simp only [hdet]
    apply Continuous.matrix_det
    refine continuous_matrix fun r l => ?_
    exact (EuclideanSpace.proj r).continuous.comp (continuous_apply l)
  let δ : Covector (Euclid (d + 1)) (d + 1) := { b.det with cont := hcont }
  have hδ : ∀ c, δ c = b.det c := fun c => rfl
  -- `ε = δ.curryLeft z`, so `ε u = det M(u)` with columns `z, u₀, …, u_{d-1}`; expand along
  -- column `0`: `det M(u) = Σ_r (−1)ʳ z_r det N_r` with minors `N_r`.
  refine ⟨δ.curryLeft z, fun i => ?_⟩
  rw [ContinuousAlternatingMap.curryLeft_apply_apply, hδ, hdet, Matrix.det_succ_column_zero,
    Finset.sum_eq_single i]
  · -- `r = i`: `(N_i)_{a,k} = (e_{i.succAbove k})_{i.succAbove a} = [a = k]`, so `N_i = 1`.
    have h1 : (Matrix.of fun r l => (Matrix.vecCons z (i.removeNth fun l =>
        EuclideanSpace.single l (1 : ℝ)) : Fin (d + 1) → Euclid (d + 1)) l r).submatrix
          i.succAbove Fin.succ = 1 := by
      ext a k
      simp [Matrix.one_apply, Fin.removeNth_apply]
    rw [h1, Matrix.det_one]
    simp
  · -- `r ≠ i`: row `a₀` of `N_r`, where `r.succAbove a₀ = i`, is `(e_{i.succAbove k})_i = 0`.
    intro r _ hri
    obtain ⟨a₀, ha₀⟩ := Fin.exists_succAbove_eq (x := i) (y := r) (Ne.symm hri)
    rw [Matrix.det_eq_zero_of_row_eq_zero a₀, mul_zero]
    intro k
    simp [Fin.removeNth_apply, ha₀]
  · intro h
    exact absurd (Finset.mem_univ i) h
/-- **Coefficient norm of the interior-product covector** (used for `ε = ι_z(dy)` in the closure
and boundary-rectifiability step of the compactness theorem, Simon 7.2.4).  If the `d`-covector `ε`
on `ℝ^{d+1}` takes the value `(−1)ⁱ zᵢ` on `(e₀, …, êᵢ, …, e_d)`, then its Euclidean coefficient
norm (Simon (6.1.15)) is `|z|`: the strictly increasing `I : Fin d → Fin (d + 1)` are exactly the
maps `i.succAbove`, so the coefficients of `ε` are the `(−1)ⁱ zᵢ`. -/
theorem Submission.cbr_ci_pw_ipf_covector_norm_eq : ∀ (d : ℕ) (z : Euclid (d + 1)) (ε : Covector (Euclid (d + 1)) d), (∀ i : Fin (d + 1), ε (i.removeNth (fun l : Fin (d + 1) => EuclideanSpace.single l (1 : ℝ))) = (-1 : ℝ) ^ (i : ℕ) * z i) → covectorEuclideanNorm ε = ‖z‖ := by
  intro d z ε hε
  have hI : ∀ I : Fin d → Fin (d + 1), StrictMono I → ∃ i : Fin (d + 1), i.succAbove = I := by
    intro I hI
    have hns : ¬Surjective I := fun h => by
      simpa using Fintype.card_le_of_surjective I h
    obtain ⟨i, hi⟩ := not_forall.mp hns
    have hcard : (Finset.univ.erase i).card = d := by simp
    refine ⟨i, ?_⟩
    rw [Finset.orderEmbOfFin_unique hcard (f := I)
        (fun k => Finset.mem_erase.2 ⟨fun h => hi ⟨k, h⟩, Finset.mem_univ _⟩) hI,
      Finset.orderEmbOfFin_unique hcard (f := i.succAbove)
        (fun k => Finset.mem_erase.2 ⟨Fin.succAbove_ne i k, Finset.mem_univ _⟩)
        (Fin.strictMono_succAbove i)]
  rw [covectorEuclideanNorm, EuclideanSpace.norm_eq]
  congr 1
  rw [← Finset.sum_subset
      (Finset.subset_univ (Finset.univ.image fun i : Fin (d + 1) => i.succAbove)) ?_,
    Finset.sum_image fun i _ j _ h => Fin.succAbove_left_injective h]
  · refine Finset.sum_congr rfl fun i _ => ?_
    have hb : (fun k => EuclideanSpace.basisFun (Fin (d + 1)) ℝ (i.succAbove k)) =
        i.removeNth (fun l : Fin (d + 1) => EuclideanSpace.single l (1 : ℝ)) := by
      funext k
      simp [Fin.removeNth]
    rw [ite_eq_left (Fin.strictMono_succAbove i), hb, hε i, Real.norm_eq_abs, sq_abs, mul_pow,
      pow_right_comm, neg_one_sq, one_pow, one_mul]
  · intro I _ hIm
    refine ite_eq_right fun hmono => ?_
    obtain ⟨i, rfl⟩ := hI I hmono
    exact hIm (Finset.mem_image_of_mem _ (Finset.mem_univ i))
/-- **The interior product `ι_z(dy)` as a constant `d`-form on `ℝ^{d+1}`** (the forms
`f · Σⱼ zⱼ εⱼ` in the BV estimate of the closure argument for Simon 7.2.4; cf. the forms `ωⱼ` in
the proof of Simon Ch. 6, 2.34).  For `z ∈ ℝ^{d+1}` the covector
`ε(u₁, …, u_d) = det[z | u₁ | ⋯ | u_d]` has `ε(e₀, …, êᵢ, …, e_d) = (−1)ⁱ zᵢ` and `|ε| = |z|`,
and `d(f ε) = df ∧ ε` gives
`d(f ε)(y)(e₀, …, e_d) = Σᵢ (−1)ⁱ Df(y)eᵢ · (−1)ⁱ zᵢ = Df(y)(Σᵢ zᵢ eᵢ) = Df(y) z`. -/
theorem Submission.cbr_ci_pw_interior_product_form : ∀ (d : ℕ) (z : Euclid (d + 1)), ∃ ε : Covector (Euclid (d + 1)) d, covectorEuclideanNorm ε ≤ ‖z‖ ∧ ∀ (f : Euclid (d + 1) → ℝ) (y : Euclid (d + 1)), DifferentiableAt ℝ f y → exteriorDerivative (fun x => f x • ε) y (fun i => EuclideanSpace.single i (1 : ℝ)) = fderiv ℝ f y z := by
  intro d z
  -- steps 1–2: `ε = ι_z(dy)`, with `ε(i.removeNth e) = (−1)ⁱ zᵢ`
  obtain ⟨ε, hε⟩ := Submission.cbr_ci_pw_ipf_coord_covector d z
  -- step 3: `|ε| = ‖z‖`
  refine ⟨ε, (Submission.cbr_ci_pw_ipf_covector_norm_eq d z ε hε).le, fun f y hf => ?_⟩
  -- step 4: `d(f ε)(y)(e) = Σᵢ (−1)ⁱ Df(y)eᵢ · ε(i.removeNth e)`
  rw [Submission.dgcr_bwd_extDeriv_smul_const (d + 1) d f ε y _ hf]
  -- `(−1)ⁱ (−1)ⁱ = 1`, so the `i`-th term is `zᵢ Df(y)eᵢ`
  have hterm : ∀ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ f y (EuclideanSpace.single i (1 : ℝ)) * ε (i.removeNth (fun l : Fin (d + 1) => EuclideanSpace.single l (1 : ℝ)))) = z i * fderiv ℝ f y (EuclideanSpace.single i (1 : ℝ)) := by
    intro i
    have hsq : (-1 : ℝ) ^ (i : ℕ) * (-1 : ℝ) ^ (i : ℕ) = 1 := by
      rw [← mul_pow]
      norm_num
    rw [hε i]
    linear_combination (z i * fderiv ℝ f y (EuclideanSpace.single i (1 : ℝ))) * hsq
  rw [Finset.sum_congr rfl fun i _ => hterm i]
  -- `z = Σᵢ zᵢ eᵢ` and `Df(y)` is linear
  conv_rhs => rw [← (EuclideanSpace.basisFun (Fin (d + 1)) ℝ).sum_repr z]
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul, EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr, smul_eq_mul]
/-- **Translated test functions** (mollified weights in the closure theorem behind Simon 7.2.4):
if `φ` is smooth with `tsupport φ ⊆ B_s(0)`, `s < R` and `x ∈ B̄_R(0)`, then `b(y) = φ(x − y)` is
smooth with compact support in `B_{2R}(0)` and `∫ b = ∫ φ`.  `tsupport φ` is closed in the compact
`B̄_s(0)`; `y ↦ x − y` is the homeomorphism `Homeomorph.subLeft x`, so `tsupport b` is the preimage
of `tsupport φ`, on which `‖y‖ ≤ ‖x‖ + ‖x − y‖ < R + s < 2R`; and Lebesgue measure is invariant
under `y ↦ x − y`. -/
theorem Submission.cbr_ci_pw_mu_translate_admissible : ∀ (n : ℕ) (R s : ℝ) (φ : Euclid n → ℝ) (x : Euclid n), s < R → ContDiff ℝ (⊤ : ℕ∞) φ → tsupport φ ⊆ ball 0 s → x ∈ closedBall 0 R → ContDiff ℝ (⊤ : ℕ∞) (fun y => φ (x - y)) ∧ HasCompactSupport (fun y => φ (x - y)) ∧ tsupport (fun y => φ (x - y)) ⊆ ball 0 (2 * R) ∧ ∫ y, φ (x - y) = ∫ y, φ y := by
  intro n R s φ x hsR hφ hsupp hx
  -- `φ` has compact support: `tsupport φ` is closed in the compact `closedBall 0 s`
  have hφc : HasCompactSupport φ :=
    (isCompact_closedBall (0 : Euclid n) s).of_isClosed_subset (isClosed_tsupport φ)
      (hsupp.trans ball_subset_closedBall)
  -- `b = φ ∘ e` for the homeomorphism `e = (x - ·)`
  have hb : (fun y => φ (x - y)) = φ ∘ Homeomorph.subLeft x := rfl
  refine ⟨hφ.comp (contDiff_const.sub contDiff_id), hb ▸ hφc.comp_homeomorph _, ?_,
    integral_sub_left_eq_self φ volume x⟩
  intro y hy
  have hxy : x - y ∈ tsupport φ := by
    rw [hb, tsupport_comp_eq_preimage] at hy
    exact hy
  have hxy' : ‖x - y‖ < s := mem_ball_zero_iff.mp (hsupp hxy)
  have hxR : ‖x‖ ≤ R := mem_closedBall_zero_iff.mp hx
  rw [mem_ball_zero_iff]
  calc ‖y‖ = ‖x - (x - y)‖ := by rw [sub_sub_cancel]
    _ ≤ ‖x‖ + ‖x - y‖ := norm_sub_le _ _
    _ < 2 * R := by linarith
/-- **Mollification is Lipschitz, with constant `∝ ∫_S |v|`**: for `φ ∈ C^∞_c(ℝⁿ)` there is
`L ≥ 0` such that, for every `S ⊆ ℝⁿ`, every `v` integrable on `S` and all `x, x'`,
`|∫_S v(y)φ(x − y) dy − ∫_S v(y)φ(x' − y) dy| ≤ L (∫_S |v|) |x − x'|`.  `φ` is `C¹` with compact
support, hence `L`-Lipschitz, and bounded, so both integrands are integrable on `S` and the
difference is `|∫_S v(y)(φ(x − y) − φ(x' − y)) dy| ≤ ∫_S |v(y)| L |x − x'| dy`. -/
theorem Submission.cbr_ci_pw_mu_conv_lipschitz : ∀ (n : ℕ) (φ : Euclid n → ℝ), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → ∃ L : ℝ, 0 ≤ L ∧ ∀ (S : Set (Euclid n)) (v : Euclid n → ℝ), IntegrableOn v S → ∀ x x' : Euclid n, |(∫ y in S, v y * φ (x - y)) - ∫ y in S, v y * φ (x' - y)| ≤ L * (∫ y in S, |v y|) * dist x x' := by
  intro n φ hφ hφc
  obtain ⟨C, hC⟩ := hφ.lipschitzWith_of_hasCompactSupport hφc (by simp)
  obtain ⟨M, hM⟩ := hφ.continuous.bounded_above_of_compact_support hφc
  refine ⟨C, C.coe_nonneg, fun S v hv x x' => ?_⟩
  have hint : ∀ z : Euclid n, IntegrableOn (fun y => v y * φ (z - y)) S := fun z =>
    Integrable.mul_bdd hv
      (hφ.continuous.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
      (Eventually.of_forall fun y => hM (z - y))
  rw [← integral_sub (hint x) (hint x'), ← Real.norm_eq_abs]
  calc ‖∫ y in S, v y * φ (x - y) - v y * φ (x' - y)‖
      ≤ ∫ y in S, |v y| * (C * dist x x') := by
        refine norm_integral_le_of_norm_le (hv.abs.mul_const _) (Eventually.of_forall fun y => ?_)
        rw [Real.norm_eq_abs, ← mul_sub, abs_mul]
        gcongr
        rw [← Real.dist_eq]
        simpa [dist_sub_right] using hC.dist_le_mul (x - y) (x' - y)
    _ = C * (∫ y in S, |v y|) * dist x x' := by
        rw [integral_mul_const]
        ring
/-- Pointwise convergence to a constant plus an eventual uniform Lipschitz bound on a compact set
gives uniform convergence (the ε/3 argument): cover `K` by finitely many `η`-balls centred in `K`,
with `max L 0 * η < ε / 3`; eventually every centre is `ε / 3`-close to `a`, and each `x ∈ K` lies
within `η` of a centre. -/
theorem Submission.cbr_ci_pw_mu_uniform_of_equilipschitz : ∀ (n : ℕ) (K : Set (Euclid n)) (F : ℕ → Euclid n → ℝ) (a L : ℝ), IsCompact K → (∀ x ∈ K, Tendsto (fun k => F k x) atTop (𝓝 a)) → (∀ᶠ k in atTop, ∀ x ∈ K, ∀ x' ∈ K, |F k x - F k x'| ≤ L * dist x x') → TendstoUniformlyOn F (fun _ => a) atTop K := by
  intro n K F a L hK hpt hL
  rw [Metric.tendstoUniformlyOn_iff]
  intro ε hε
  have hM0 : 0 ≤ max L 0 := le_max_right L 0
  have hη : 0 < ε / (3 * (max L 0 + 1)) := by positivity
  have hMη : max L 0 * (ε / (3 * (max L 0 + 1))) < ε / 3 := by
    rw [mul_div_assoc', div_lt_div_iff₀ (by positivity) (by norm_num)]
    nlinarith
  obtain ⟨t, htK, ht, hcover⟩ := hK.finite_cover_balls hη
  have hnet : ∀ᶠ k in atTop, ∀ z ∈ t, |F k z - a| < ε / 3 :=
    ht.eventually_all.2 fun z hz => by
      simpa only [Real.dist_eq] using Metric.tendsto_nhds.1 (hpt z (htK hz)) (ε / 3) (by positivity)
  filter_upwards [hnet, hL] with k hk hkL x hx
  obtain ⟨z, hz, hxz⟩ := mem_iUnion₂.1 (hcover hx)
  have hzx : |F k z - F k x| < ε / 3 :=
    calc |F k z - F k x| ≤ L * dist z x := hkL z (htK hz) x hx
      _ ≤ max L 0 * dist z x := mul_le_mul_of_nonneg_right (le_max_left L 0) dist_nonneg
      _ ≤ max L 0 * (ε / (3 * (max L 0 + 1))) :=
        mul_le_mul_of_nonneg_left (mem_ball'.1 hxz).le hM0
      _ < ε / 3 := hMη
  rw [Real.dist_eq]
  have htri := abs_sub_le a (F k z) (F k x)
  rw [abs_sub_comm a (F k z)] at htri
  linarith [hk z hz]
/-- **Inner-annulus quotients and the derivative of `r ↦ μ(B_r(x₁))`** (Simon Ch. 6: the
quotients `h⁻¹ M(T⌞{t − h < |x − ξ| < t})` of 4.9 are bounded by the derivative of
`r ↦ M(T⌞B_r(ξ))`, as used in the proof of 8.2, (2)).  If `μ(B_ρ(x₁)) < ∞` and
`F(r) = μ(B_r(x₁))` has derivative `d` at `ρ`, then
`liminf_{h ↓ 0} h⁻¹ μ{ρ − h < |x − x₁| < ρ} ≤ d`: for `h > 0` the annulus lies in
`B_ρ(x₁) \ B_{ρ−h}(x₁)`, of measure `F(ρ) − F(ρ − h)`, and the backward difference quotients
`h⁻¹ (F(ρ) − F(ρ − h))` tend to `d`. -/
theorem Submission.cbrld_radius_liminf_annulus_le_of_hasDerivAt : ∀ (P : ℕ) (μ : Measure (Euclid P)) (x₁ : Euclid P) (ρ d : ℝ), μ (ball x₁ ρ) ≠ ∞ → HasDerivAt (fun r : ℝ => (μ (ball x₁ r)).toReal) d ρ → liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ}) (𝓝[>] 0) ≤ ENNReal.ofReal d := by
  intro P μ x₁ ρ d hμ hd
  -- the backward difference quotients `h⁻¹ (F(ρ) − F(ρ − h))` tend to `d` as `h ↓ 0`
  have hq : Tendsto (fun h : ℝ => h⁻¹ * ((μ (ball x₁ ρ)).toReal - (μ (ball x₁ (ρ - h))).toReal))
      (𝓝[>] 0) (𝓝 d) := by
    have hneg : Tendsto (fun h : ℝ => -h) (𝓝[>] 0) (𝓝[<] 0) := by
      simpa using tendsto_neg_nhdsGT (a := (0 : ℝ))
    refine (hd.tendsto_slope_zero_left.comp hneg).congr' (Eventually.of_forall fun h => ?_)
    simp only [Function.comp_apply, smul_eq_mul]
    rw [inv_neg, ← sub_eq_add_neg]
    ring
  have hlim : liminf (fun h : ℝ => ENNReal.ofReal
      (h⁻¹ * ((μ (ball x₁ ρ)).toReal - (μ (ball x₁ (ρ - h))).toReal))) (𝓝[>] 0) =
      ENNReal.ofReal d :=
    ((ENNReal.continuous_ofReal.tendsto d).comp hq).liminf_eq
  refine (liminf_le_liminf ?_).trans_eq hlim
  -- for `h > 0`, the annulus lies in `B_ρ(x₁) \ B_{ρ−h}(x₁)`, of measure `F(ρ) − F(ρ − h)`
  filter_upwards [self_mem_nhdsWithin] with h (hh : 0 < h)
  have hsub : ball x₁ (ρ - h) ⊆ ball x₁ ρ := ball_subset_ball (by linarith)
  have hfin : μ (ball x₁ (ρ - h)) ≠ ∞ := ne_top_of_le_ne_top hμ (measure_mono hsub)
  have hA : {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ} ⊆ ball x₁ ρ \ ball x₁ (ρ - h) :=
    fun x hx => ⟨mem_ball.mpr hx.2, fun hx' => lt_asymm hx.1 (mem_ball.mp hx')⟩
  calc ENNReal.ofReal h⁻¹ * μ {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ}
      ≤ ENNReal.ofReal h⁻¹ * μ (ball x₁ ρ \ ball x₁ (ρ - h)) := by gcongr
    _ = ENNReal.ofReal h⁻¹ * ENNReal.ofReal
          ((μ (ball x₁ ρ)).toReal - (μ (ball x₁ (ρ - h))).toReal) := by
        rw [measure_sdiff hsub measurableSet_ball.nullMeasurableSet hfin,
          ENNReal.ofReal_sub _ ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hμ,
          ENNReal.ofReal_toReal hfin]
    _ = ENNReal.ofReal (h⁻¹ * ((μ (ball x₁ ρ)).toReal - (μ (ball x₁ (ρ - h))).toReal)) :=
        (ENNReal.ofReal_mul (inv_nonneg.mpr hh.le)).symm
/-- **Simon Ch. 6, 6.1 (Isoperimetric Theorem)**, from the scaled deformation theorem 5.3 in the
frozen form (DT), with constant `c ≥ 1` for `(P, m)`.  Let `Z ∈ 𝒟_{m+1}(ℝᴾ)` be integer
multiplicity with `spt Z` compact, `∂Z = 0` and `z = M(Z) < ∞`.  Apply (DT) to `T = Z` with
`K = spt Z`, `Λ = z` and `ρ = (2cz)^{1/(m+1)}` (`ρ = 1` if `z = 0`).  A current of zero mass is
zero (test `±sω` with `s‖ω‖_∞ ≤ 1`), so `M(S) ≤ cρ M(∂Z) = 0` gives `S = 0`, and
`M(Q) ≤ cz < ρ^{m+1}` excludes the second alternative, so `Q = 0` and `Z = ∂R`.  Then `Y = R` has
the mass and support bounds of (DT); if `z = 0`, also `M(R) = 0`, so `spt R = ∅`. -/
theorem Submission.cbr_isoperimetric_filling : (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → ∀ (P m : ℕ), ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support := by
  intro hDT P m
  obtain ⟨c, hc1, hDT⟩ := hDT P m
  refine ⟨(c : ℝ), by exact_mod_cast hc1, ?_⟩
  intro Z hZ hZc hZb hZm
  -- `M(0) = 0` and `spt 0 = ∅`
  have hmass0 : ∀ k : ℕ, (0 : GeometricCurrentOn (univ : Set (Euclid P)) k).mass = 0 := by
    intro k
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  have hsupp0 : ∀ k : ℕ, (0 : GeometricCurrentOn (univ : Set (Euclid P)) k).support = ∅ := by
    intro k
    refine eq_empty_of_forall_notMem fun x hx => hx.2 ?_
    exact ⟨ball x 1, ⟨isOpen_ball, isBounded_ball.isCompact_closure, subset_univ _,
      fun ω _ => rfl⟩, mem_ball_self one_pos⟩
  -- the Euclidean coefficient norm is absolutely homogeneous
  have hhom : ∀ (k : ℕ) (t : ℝ) (α : Covector (Euclid P) k),
      covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := by
    intro k t α
    simp only [covectorEuclideanNorm]
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg t), Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs <;> simp [mul_pow]
  -- a current of zero mass is zero: test `±sω` with `s‖ω‖_∞ ≤ 1`
  have hzero : ∀ (k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), X.mass = 0 →
      X = 0 := by
    intro k X hX
    ext ω
    have hω : Continuous (ω : DifferentialForm (Euclid P) k) := ω.property.1.1.continuous
    have hfc : Continuous (covectorEuclideanNorm ∘ (ω : DifferentialForm (Euclid P) k)) := by
      simp only [Function.comp_def, covectorEuclideanNorm]
      refine Continuous.sqrt (continuous_finsetSum _ fun I _ => ?_)
      exact continuous_if_const _ (fun _ => ((continuous_eval_const _).comp hω).pow 2)
        fun _ => continuous_const
    have hcs : HasCompactSupport (covectorEuclideanNorm ∘ (ω : DifferentialForm (Euclid P) k)) :=
      ω.property.1.2.comp_left (covectorEuclideanNorm_zero P k)
    obtain ⟨C, hC⟩ := hfc.bounded_above_of_compact_support hcs
    obtain ⟨s, hs, hsC⟩ : ∃ s : ℝ, 0 < s ∧ s * (|C| + 1) = 1 :=
      ⟨(|C| + 1)⁻¹, by positivity, inv_mul_cancel₀ (by positivity)⟩
    have hadm : ∀ t : ℝ, |t| ≤ s → t • ω ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      intro t ht
      refine ⟨subset_univ _, fun x => ?_⟩
      show covectorEuclideanNorm (t • (ω : DifferentialForm (Euclid P) k) x) ≤ 1
      rw [hhom]
      have h0 := covectorEuclideanNorm_nonneg ((ω : DifferentialForm (Euclid P) k) x)
      have h1 : covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x) ≤ |C| + 1 := by
        have := hC x
        rw [Function.comp_apply, Real.norm_of_nonneg h0] at this
        linarith [le_abs_self C]
      calc |t| * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x)
          ≤ s * (|C| + 1) := mul_le_mul ht h1 h0 hs.le
        _ = 1 := hsC
    have hX' : X.massOn univ = 0 := hX
    have h1 := X.le_massOn (hadm s (abs_of_pos hs).le)
    have h2 := X.le_massOn (hadm (-s) (by rw [abs_neg, abs_of_pos hs]))
    rw [hX', nonpos_iff_eq_zero, ENNReal.ofReal_eq_zero] at h1 h2
    have e1 : X (s • ω) = s * X ω := map_smul X.toCurrent s ω
    have e2 : X ((-s) • ω) = -(s * X ω) := by
      rw [show X ((-s) • ω) = -s * X ω from map_smul X.toCurrent (-s) ω]
      ring
    rw [e1] at h1
    rw [e2] at h2
    have h3 : s * X ω = 0 := by linarith
    rw [GeometricCurrentOn.zero_apply]
    exact (mul_eq_zero.1 h3).resolve_left hs.ne'
  -- the scale `ρ`
  set z : ℝ := Z.mass.toReal
  have hz0 : 0 ≤ z := ENNReal.toReal_nonneg
  have hZmz : Z.mass = ENNReal.ofReal z := (ENNReal.ofReal_toReal hZm.ne).symm
  have hc0 : (0 : ℝ) ≤ c := c.coe_nonneg
  have hc0' : (0 : ℝ) < c := by exact_mod_cast zero_lt_one.trans_le hc1
  have hcz0 : 0 ≤ (c : ℝ) * z := mul_nonneg hc0 hz0
  obtain ⟨ρ, hρ0, hρlt, hρ⟩ : ∃ ρ : ℝ, 0 < ρ ∧ (c : ℝ) * z < ρ ^ (m + 1) ∧
      (z = 0 ∨ ρ = (2 * (c : ℝ) * z) ^ ((1 : ℝ) / (m + 1))) := by
    rcases hz0.eq_or_lt with h | h
    · exact ⟨1, one_pos, by rw [← h]; simp, Or.inl h.symm⟩
    · have hcz : 0 < 2 * (c : ℝ) * z := mul_pos (mul_pos two_pos hc0') h
      refine ⟨_, Real.rpow_pos_of_pos hcz _, ?_, Or.inr rfl⟩
      have hpow : ((2 * (c : ℝ) * z) ^ ((1 : ℝ) / (m + 1))) ^ (m + 1) = 2 * (c : ℝ) * z := by
        rw [one_div, ← Nat.cast_succ]
        exact Real.rpow_inv_natCast_pow hcz.le (Nat.succ_ne_zero m)
      rw [hpow]
      have : 0 < (c : ℝ) * z := mul_pos hc0' h
      linarith
  have hcρ : 0 ≤ (c : ℝ) * ρ := mul_nonneg hc0 hρ0.le
  -- apply (DT) to `T = Z`
  obtain ⟨𝒬, -, hDT⟩ := hDT ρ Z.support Z.mass.toNNReal hρ0 hZc
  obtain ⟨Q, -, R, S, -, -, hR, hZQS, hQ, hQm, -, hRm, hSm, hQR, -⟩ :=
    hDT Z hZ subset_rfl (ENNReal.coe_toNNReal hZm.ne).ge
      (by rw [hZb, hmass0]; exact ENNReal.zero_lt_top)
  -- `M(S) ≤ cρ M(∂Z) = 0`, so `S = 0`
  rw [hZb, hmass0, mul_zero, nonpos_iff_eq_zero] at hSm
  obtain rfl : S = 0 := hzero _ S hSm
  -- `M(Q) ≤ cz < ρ^{m+1}`, so `Q = 0`
  obtain rfl : Q = 0 := by
    refine hQ.resolve_right fun h => ?_
    have h' := h.trans hQm
    rw [hZmz, ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul hc0,
      ENNReal.ofReal_le_ofReal_iff hcz0] at h'
    linarith
  -- hence `Z = ∂R`
  have hRZ : R.boundary = Z := by
    rw [← hZQS]
    ext ω
    show Z ω - 0 - 0 = Z ω
    ring
  rcases hρ with h | rfl
  · -- `z = 0`: `M(R) ≤ cρ · 0 = 0`, so `R = 0`
    rw [hZmz, h, ENNReal.ofReal_zero, mul_zero, nonpos_iff_eq_zero] at hRm
    refine ⟨R, hR, hRZ, hRm.trans_le zero_le, ?_⟩
    rw [hzero _ R hRm, hsupp0]
    exact empty_subset _
  · refine ⟨R, hR, hRZ, hRm.trans (le_of_eq ?_), subset_union_right.trans hQR⟩
    rw [ENNReal.ofReal_mul hcρ, ENNReal.ofReal_mul hc0, ENNReal.ofReal_coe_nnreal, hZmz]
/-- **Good slicing radius** (Simon Ch. 6, 8.2 (2)–(3): radii where `(F^{1/n})′` is controlled,
and `F′ = nF^{(n−1)/n}(F^{1/n})′`).  If `μ` is finite on compact sets, `n ≥ 1`, `a, s > 0`,
`μ(B_s(x₁)) < (as)ⁿ` and `L¹(N) = 0`, then some `ρ ∈ (0, s) \ N` has `μ(∂B_ρ(x₁)) = 0` and
`liminf_{h ↓ 0} h⁻¹ μ{ρ − h < |x − x₁| < ρ} ≤ 2na μ(B_ρ(x₁))^{(n−1)/n}`.  Let `F(r) = μ(B_r(x₁))`
and `G = F^{1/n}`: both are nondecreasing, `G(0) = 0` and `G(s) ≤ as`, so `∫_{(0,s)} G′ ≤ as`
(Lebesgue's inequality).  The good-radius lemma applied to `1_{(0,s)} G′` avoids `N`, the
non-differentiability points of `G` and the spheres charged by `μ`, with `G′(ρ) ≤ (2/s)·as = 2a`.
Then `F = Gⁿ` has derivative `nG(ρ)^{n−1}G′(ρ) ≤ 2na F(ρ)^{(n−1)/n}` at `ρ`, which bounds the
inner-annulus liminf. -/
theorem Submission.cbrld_exists_good_slice_radius : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (x₁ : Euclid P) (a s : ℝ) (N : Set ℝ), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → 1 ≤ n → 0 < a → 0 < s → μ (ball x₁ s) < ENNReal.ofReal ((a * s) ^ n) → volume N = 0 → ∃ ρ : ℝ, 0 < ρ ∧ ρ < s ∧ ρ ∉ N ∧ μ (sphere x₁ ρ) = 0 ∧ liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ}) (𝓝[>] 0) ≤ ENNReal.ofReal (2 * n * a * (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n)) := by
  intro P n μ x₁ a s N hμ hn ha hs hμs hN
  have hn0 : n ≠ 0 := Nat.one_le_iff_ne_zero.mp hn
  have hn0' : (0 : ℝ) < n := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn0)
  have hinv : (0 : ℝ) ≤ (n : ℝ)⁻¹ := inv_nonneg.mpr hn0'.le
  -- `μ` is finite on balls (closed balls are compact)
  have hball : ∀ r : ℝ, μ (ball x₁ r) ≠ ∞ := fun r =>
    ne_top_of_le_ne_top (hμ _ (isCompact_closedBall x₁ r)).ne (measure_mono ball_subset_closedBall)
  -- `F(r) = μ(B_r(x₁))` and `G = F^{1/n}` are nondecreasing, `G(0) = 0`, `Gⁿ = F`, `G(s) ≤ as`
  set F : ℝ → ℝ := fun r => (μ (ball x₁ r)).toReal with hF_def
  set G : ℝ → ℝ := fun r => F r ^ (n : ℝ)⁻¹ with hG_def
  have hF0 : ∀ r, 0 ≤ F r := fun r => ENNReal.toReal_nonneg
  have hFmono : Monotone F := fun r r' hrr' =>
    ENNReal.toReal_mono (hball r') (measure_mono (ball_subset_ball hrr'))
  have hGmono : Monotone G := fun r r' hrr' => Real.rpow_le_rpow (hF0 r) (hFmono hrr') hinv
  have hFG : ∀ r, G r ^ n = F r := fun r => Real.rpow_inv_natCast_pow (hF0 r) hn0
  have hG0 : G 0 = 0 := by
    simp only [hG_def, hF_def, ball_zero, measure_empty, ENNReal.toReal_zero]
    exact Real.zero_rpow (inv_ne_zero hn0'.ne')
  have hGs : G s ≤ a * s :=
    calc G s ≤ ((a * s) ^ n) ^ (n : ℝ)⁻¹ :=
          Real.rpow_le_rpow (hF0 s) (ENNReal.toReal_lt_of_lt_ofReal hμs).le hinv
      _ = a * s := Real.pow_rpow_inv_natCast (mul_pos ha hs).le hn0
  -- Lebesgue's inequality: `∫⁻_{(0,s)} G′ ≤ G(s) − G(0) ≤ as`
  have hgm : AEMeasurable ((Ioo 0 s).indicator fun t => ENNReal.ofReal (deriv G t)) :=
    ((ENNReal.measurable_ofReal.comp (measurable_deriv G)).indicator measurableSet_Ioo).aemeasurable
  have hgI : ∫⁻ t, (Ioo 0 s).indicator (fun t => ENNReal.ofReal (deriv G t)) t ≤
      ENNReal.ofReal (a * s) := by
    rw [lintegral_indicator measurableSet_Ioo]
    refine (Submission.cmcs_smi_lintegral_ofReal_deriv_le G 0 s hGmono).trans ?_
    rw [hG0, sub_zero]
    exact ENNReal.ofReal_le_ofReal hGs
  -- the exceptional radii: `N` and the points where `G` is not differentiable
  have hp : ∀ᵐ t, t ∉ N ∧ DifferentiableAt ℝ G t :=
    (measure_eq_zero_iff_ae_notMem.mp hN).and hGmono.ae_differentiableAt
  obtain ⟨ρ, hρ0, hρs, ⟨hρN, hρd⟩, hρsph, hρg⟩ :=
    Submission.dor_lmb_glc_good_radius P μ x₁ 0 s _ _ _ hs (hμ _ (isCompact_closedBall x₁ s)).ne
      hgm hgI hp
  -- `G′(ρ) ≤ (2/s) · as = 2a`
  have hGd : deriv G ρ ≤ 2 * a := by
    rw [indicator_of_mem (mem_Ioo.mpr ⟨hρ0, hρs⟩), sub_zero,
      ← ENNReal.ofReal_mul (div_nonneg zero_le_two hs.le),
      show 2 / s * (a * s) = 2 * a by field_simp,
      ENNReal.ofReal_le_ofReal_iff (mul_pos two_pos ha).le] at hρg
    exact hρg
  refine ⟨ρ, hρ0, hρs, hρN, hρsph, ?_⟩
  -- `F = Gⁿ` has derivative `nG(ρ)^{n−1}G′(ρ)` at `ρ`
  have hFd : HasDerivAt F (n * G ρ ^ (n - 1) * deriv G ρ) ρ := by
    have h := hρd.hasDerivAt.fun_pow n
    rwa [show (fun r => G r ^ n) = F from funext hFG] at h
  refine (Submission.cbrld_radius_liminf_annulus_le_of_hasDerivAt P μ x₁ ρ _ (hball ρ) hFd).trans
    (ENNReal.ofReal_le_ofReal ?_)
  -- `G(ρ)^{n−1} = F(ρ)^{(n−1)/n}`, and `G′(ρ) ≤ 2a`
  have hpow : G ρ ^ (n - 1) = (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) := by
    rw [hG_def, hF_def]
    dsimp only
    rw [← Real.rpow_natCast, ← Real.rpow_mul ENNReal.toReal_nonneg, Nat.cast_sub hn,
      Nat.cast_one, inv_mul_eq_div]
  rw [hpow]
  have hX : 0 ≤ (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) :=
    Real.rpow_nonneg ENNReal.toReal_nonneg _
  calc (n : ℝ) * (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) * deriv G ρ
      ≤ n * (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) * (2 * a) := by gcongr
    _ = 2 * n * a * (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) := by ring

/-- **Cone inequality for small cycles** (Simon Ch. 6, 2.27/2.30, as used in 8.2(4)–(6)).  Assume
(VO) and let `c ≥ 0` be a Lipschitz constant of `ω` in the Euclidean coefficient norm.  If
`∂X = 0`, `M(X) < ∞` and `spt X ⊆ B̄_ϱ(x₀)`, fix `ε > 0`, a bump `ζ` with `ζ = 1` on
`B̄_{ϱ+ε/2}(x₀)` and `ζ = 0` off `B_{ϱ+ε}(x₀)`, `α := ω(x₀)` and `φ := ζ (ω - α)`.  Then
`ω - φ = α` on `B_{ϱ+ε/2}(x₀) ⊇ spt X`, so `X(ω - φ) = 0` (a constant form is exact near `spt X`
and `∂X = 0`), while `|φ(x)| = ζ(x) |ω(x) - ω(x₀)| ≤ c (ϱ + ε)`.  Hence
`|X(ω)| = |X(φ)| ≤ c (ϱ + ε) M(X)`, and `ε ↓ 0` gives the claim. -/
theorem Submission.cbrld_cycle_eval_le_radius_mul_mass : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P n : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (n + 1)), ∃ c : ℝ, 0 ≤ c ∧ ∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) (n + 1)) (x₀ : Euclid P) (ϱ : ℝ), 0 < ϱ → X.boundary = 0 → X.mass < ∞ → X.support ⊆ closedBall x₀ ϱ → |X ω| ≤ c * ϱ * X.mass.toReal := by
  intro VO P n ω
  -- the constant depends only on `ω`: a Lipschitz constant in the coefficient norm
  obtain ⟨c, hc0, hc⟩ := Submission.cbrld_cone_testForm_coeff_lipschitz P (n + 1) univ ω
  refine ⟨c, hc0, fun X x₀ ϱ hϱ hbd hM hspt => ?_⟩
  have hsmul := (Submission.rsd_mw_tfa_norm_props P (n + 1)).2.1
  let α : Covector (Euclid P) (n + 1) := (ω : DifferentialForm (Euclid P) (n + 1)) x₀
  -- `|X(ω)| ≤ c (ϱ + ε) M(X)` for every `ε > 0`
  have hbound : ∀ ε : ℝ, 0 < ε → |X ω| ≤ c * (ϱ + ε) * X.mass.toReal := by
    intro ε hε
    -- the cut-off: `ζ = 1` on `B̄_{ϱ+ε/2}(x₀)` and `ζ = 0` off `B_{ϱ+ε}(x₀)`
    let ζ : ContDiffBump x₀ := ⟨ϱ + ε / 2, ϱ + ε, by linarith, by linarith⟩
    -- the test form `φ = ζ (ω - α)`
    let φ : TestFormOn (univ : Set (Euclid P)) (n + 1) :=
      ⟨fun x => ζ x • ((ω : DifferentialForm (Euclid P) (n + 1)) x - α),
        ⟨ζ.contDiff.smul (ContDiff.sub ω.property.1.1 contDiff_const),
          ζ.hasCompactSupport.smul_right⟩, subset_univ _⟩
    -- `ω - φ = α` on `B_{ϱ+ε/2}(x₀) ⊇ spt X`, so the cycle `X` kills `ω - φ`
    have hconst : ∀ x ∈ ball x₀ (ϱ + ε / 2),
        ((ω - φ : TestFormOn (univ : Set (Euclid P)) (n + 1)) :
          DifferentialForm (Euclid P) (n + 1)) x = α := by
      intro x hx
      change (ω : DifferentialForm (Euclid P) (n + 1)) x -
        ζ x • ((ω : DifferentialForm (Euclid P) (n + 1)) x - α) = α
      rw [ζ.one_of_mem_closedBall (ball_subset_closedBall hx), one_smul, sub_sub_cancel]
    have h0 : X (ω - φ) = 0 :=
      Submission.cbrld_cone_cycle_eval_eq_zero_of_const_on_ball VO P n X x₀ (ϱ + ε / 2) α
        (ω - φ) (by linarith) hbd (hspt.trans (closedBall_subset_ball (by linarith))) hconst
    have hXφ : X ω = X φ := by
      have h := map_sub X.toCurrent ω φ
      change X (ω - φ) = X ω - X φ at h
      linarith
    -- `|φ(x)| = ζ(x) |ω(x) - ω(x₀)| ≤ c (ϱ + ε)`
    have hφ : ∀ x, covectorEuclideanNorm ((φ : DifferentialForm (Euclid P) (n + 1)) x) ≤
        c * (ϱ + ε) := by
      intro x
      change covectorEuclideanNorm (ζ x • ((ω : DifferentialForm (Euclid P) (n + 1)) x - α)) ≤
        c * (ϱ + ε)
      rw [hsmul, abs_of_nonneg (ζ.nonneg' x)]
      by_cases hx : dist x x₀ < ϱ + ε
      · calc ζ x * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (n + 1)) x - α)
            ≤ 1 * (c * (ϱ + ε)) :=
              mul_le_mul ζ.le_one ((hc x x₀).trans (mul_le_mul_of_nonneg_left hx.le hc0))
                (covectorEuclideanNorm_nonneg _) zero_le_one
          _ = c * (ϱ + ε) := one_mul _
      · rw [ζ.zero_of_le_dist (not_lt.1 hx), zero_mul]
        exact mul_nonneg hc0 (by linarith)
    rw [hXφ]
    exact Submission.cmr_abs_apply_le_massOn P (n + 1) univ univ X φ (c * (ϱ + ε)) hM.ne
      (subset_univ _) hφ
  -- let `ε ↓ 0`
  have hlim : Tendsto (fun ε : ℝ => c * (ϱ + ε) * X.mass.toReal) (𝓝[>] 0)
      (𝓝 (c * ϱ * X.mass.toReal)) := by
    have h := (show Continuous fun ε : ℝ => c * (ϱ + ε) * X.mass.toReal by fun_prop).tendsto 0
    rw [add_zero] at h
    exact h.mono_left nhdsWithin_le_nhds
  exact ge_of_tendsto hlim (eventually_nhdsWithin_of_forall fun ε hε => hbound ε hε)
/-- **Simon Ch. 1, Remark 3.11(3)** (via the Besicovitch Covering Lemma 3.12), with the balls
chosen inside an open set as in the proof of Theorem 3.13: let `μ` be finite on compact subsets of
`ℝᴾ`, `W` open and `E ⊆ W` (not necessarily measurable).  If every `x ∈ E` admits arbitrarily small
radii `ρ > 0` with `Q x ρ`, then countably many pairwise disjoint closed balls
`B̄_{r(x)}(x) ⊆ W`, `x ∈ t ⊆ E`, with `Q x (r x)`, cover `μ`-almost all of `E`.  Apply the
measurable Besicovitch covering theorem to the admissible radii `{ρ | B̄_ρ(x) ⊆ W ∧ Q x ρ}`. -/
theorem Submission.cbrldvc_exists_disjoint_closedBall_cover : ∀ (P : ℕ) (μ : Measure (Euclid P)) (Q : Euclid P → ℝ → Prop) (E W : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → IsOpen W → E ⊆ W → (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ Q x ρ) → ∃ (t : Set (Euclid P)) (r : Euclid P → ℝ), t.Countable ∧ t ⊆ E ∧ (∀ x ∈ t, 0 < r x ∧ closedBall x (r x) ⊆ W ∧ Q x (r x)) ∧ t.PairwiseDisjoint (fun x => closedBall x (r x)) ∧ μ (E \ ⋃ x ∈ t, closedBall x (r x)) = 0 := by
  intro P μ Q E W hK hW hEW hQ
  -- finite on compacts, hence s-finite on the proper space `ℝᴾ`
  have : IsFiniteMeasureOnCompacts μ := ⟨hK⟩
  -- admissible radii: shrink below the radius `R` of an open ball `B_R(x) ⊆ W`
  have hf : ∀ x ∈ E, ∀ δ > 0, ({ρ | closedBall x ρ ⊆ W ∧ Q x ρ} ∩ Ioo 0 δ).Nonempty := by
    intro x hx δ hδ
    obtain ⟨R, hR, hRW⟩ := Metric.isOpen_iff.1 hW x (hEW hx)
    obtain ⟨ρ, hρ, hρδ, hQρ⟩ := hQ x hx (min δ R) (lt_min hδ hR)
    exact ⟨ρ, ⟨(closedBall_subset_ball (hρδ.trans_le (min_le_right _ _))).trans hRW, hQρ⟩, hρ,
      hρδ.trans_le (min_le_left _ _)⟩
  obtain ⟨t, r, ht, htE, hr, hμ, hdisj⟩ := Besicovitch.exists_disjoint_closedBall_covering_ae μ
    (fun x => {ρ | closedBall x ρ ⊆ W ∧ Q x ρ}) E hf (fun _ => 1) fun _ _ => zero_lt_one
  exact ⟨t, r, ht, htE, fun x hx => ⟨(hr x hx).2.1, (hr x hx).1.1, (hr x hx).1.2⟩, hdisj, hμ⟩
/-- **Summation over disjoint sets** (step 5 of the lower density bound used for Simon 7.2.4):
if `B(x)`, `x ∈ t`, are countably many disjoint measurable sets with `V = ⋃_{x ∈ t} B(x)` of finite
measure, `g` is integrable on `V` and `∫_{B(x)} g dμ ≤ θ μ(B(x))` for every `x ∈ t`, then
`∫_V g dμ ≤ θ μ(V)`.  Reindex by the countable subtype `↥t`; countable additivity gives
`∑ᵢ ∫_{B(i)} g dμ = ∫_V g dμ` and `∑ᵢ μ(B(i)) = μ(V) < ∞`, so the real series `∑ᵢ θ μ(B(i))`
converges to `θ μ(V)`, and the two series compare term by term (no sign condition on `θ`). -/
theorem Submission.cbrldvc_setIntegral_biUnion_le_mul_measure : ∀ (P : ℕ) (μ : Measure (Euclid P)) (g : Euclid P → ℝ) (θ : ℝ) (t : Set (Euclid P)) (B : Euclid P → Set (Euclid P)), t.Countable → (∀ x ∈ t, MeasurableSet (B x)) → t.PairwiseDisjoint B → μ (⋃ x ∈ t, B x) < ∞ → IntegrableOn g (⋃ x ∈ t, B x) μ → (∀ x ∈ t, ∫ y in B x, g y ∂μ ≤ θ * (μ (B x)).toReal) → ∫ y in ⋃ x ∈ t, B x, g y ∂μ ≤ θ * (μ (⋃ x ∈ t, B x)).toReal := by
  intro P μ g θ t B ht hB hd hfin hg hle
  -- reindex `⋃ x ∈ t, B x` as `⋃ i : t, B i` over the countable subtype
  have : Countable t := ht.to_subtype
  have hBi : ∀ i : t, MeasurableSet (B i) := fun i => hB i i.2
  have hdi : Pairwise (Disjoint on fun i : t => B i) :=
    fun i j hij => hd i.2 j.2 (Subtype.coe_injective.ne hij)
  rw [biUnion_eq_iUnion] at hfin hg ⊢
  -- countable additivity of the integral
  have hint : HasSum (fun i : t => ∫ y in B i, g y ∂μ) (∫ y in ⋃ i : t, B i, g y ∂μ) :=
    hasSum_integral_iUnion hBi hdi hg
  -- countable additivity of the measure, read in `ℝ`
  have hμ : μ (⋃ i : t, B i) = ∑' i : t, μ (B i) := measure_iUnion hdi hBi
  have hfin' : ∑' i : t, μ (B i) ≠ ∞ := hμ ▸ hfin.ne
  have hmeas : HasSum (fun i : t => (μ (B i)).toReal) (μ (⋃ i : t, B i)).toReal := by
    rw [hμ, ENNReal.tsum_toReal_eq fun i => ENNReal.ne_top_of_tsum_ne_top hfin' i]
    exact ENNReal.hasSum_toReal hfin'
  -- compare the two series term by term
  exact hasSum_le (fun i : t => hle i i.2) hint (hmeas.mul_left θ)
/-- Complement bound in the covering step of the lower density estimate (cf. Simon Ch. 6, 8.2): if
`|g| ≤ 1` `μ`-a.e., `V ⊆ W` with `V` measurable, `μ W < ∞` and `∫_V g dμ ≤ θ μ(V)`, then
`∫_W g dμ = ∫_{W∖V} g dμ + ∫_V g dμ ≤ (μ(W) − μ(V)) + θ μ(V) = μ(W) − (1 − θ) μ(V)`. -/
theorem Submission.cbrldvc_setIntegral_le_sub_of_subset : ∀ (P : ℕ) (μ : Measure (Euclid P)) (g : Euclid P → ℝ) (θ : ℝ) (V W : Set (Euclid P)), AEStronglyMeasurable g μ → (∀ᵐ x ∂μ, |g x| ≤ 1) → MeasurableSet V → V ⊆ W → μ W < ∞ → ∫ y in V, g y ∂μ ≤ θ * (μ V).toReal → ∫ y in W, g y ∂μ ≤ (μ W).toReal - (1 - θ) * (μ V).toReal := by
  intro P μ g θ V W hg hbd hV hVW hW hθ
  -- `μ V ≤ μ W < ∞` and `μ (W \ V) ≤ μ W < ∞`
  have hVW_le : μ V ≤ μ W := measure_mono hVW
  have hVfin : μ V ≠ ∞ := (hVW_le.trans_lt hW).ne
  have hWVfin : μ (W \ V) ≠ ∞ := ((measure_mono sdiff_subset).trans_lt hW).ne
  -- `|g| ≤ 1` a.e. makes `g` integrable on every set of finite measure
  have hgS : ∀ S : Set (Euclid P), μ S ≠ ∞ → IntegrableOn g S μ := fun S hS =>
    Measure.integrableOn_of_bounded (M := 1) hS hg
      (by filter_upwards [ae_restrict_of_ae hbd] with x hx; rwa [Real.norm_eq_abs])
  have hgV : IntegrableOn g V μ := hgS V hVfin
  have hgWV : IntegrableOn g (W \ V) μ := hgS (W \ V) hWVfin
  -- `∫_W g = ∫_{W∖V} g + ∫_V g`
  have hsplit : ∫ y in W, g y ∂μ = ∫ y in W \ V, g y ∂μ + ∫ y in V, g y ∂μ := by
    conv_lhs => rw [← sdiff_union_of_subset hVW]
    exact setIntegral_union disjoint_sdiff_left hV hgWV hgV
  -- `∫_{W∖V} g ≤ ∫_{W∖V} 1 = μ(W ∖ V)`
  have hcomp : ∫ y in W \ V, g y ∂μ ≤ (μ (W \ V)).toReal := by
    calc ∫ y in W \ V, g y ∂μ ≤ ∫ _ in W \ V, (1 : ℝ) ∂μ :=
          integral_mono_ae hgWV (integrableOn_const hWVfin)
            (by filter_upwards [ae_restrict_of_ae hbd] with x hx; exact (le_abs_self _).trans hx)
      _ = (μ (W \ V)).toReal := by rw [setIntegral_const, smul_eq_mul, mul_one, measureReal_def]
  -- `μ(W ∖ V) = μ(W) − μ(V)`
  have hdiff : (μ (W \ V)).toReal = (μ W).toReal - (μ V).toReal := by
    rw [measure_sdiff hVW hV.nullMeasurableSet hVfin, ENNReal.toReal_sub_of_le hVW_le hW.ne]
  rw [hsplit]
  linarith

/-- **Covering inequality for the set integral of a bounded density** (the covering in the proof
of Simon Ch. 6, 8.2 after (4): pairwise disjoint closed balls covering almost all of the low
density set, with total measure at most `μ(W)`).  Let `μ` be finite on compact subsets of `ℝᴾ`,
`|g| ≤ 1` `μ`-a.e., `θ ≤ 1`, `W` open with `μ(W) < ∞`, and let every point of `E ⊆ W` be the
centre of arbitrarily small closed balls `B̄_ρ(x)` with `∫_{B̄_ρ(x)} g dμ ≤ θ μ(B̄_ρ(x))`.
Besicovitch gives countably many such balls, pairwise disjoint and contained in `W`, whose
union `V` covers `μ`-almost all of `E`.  By countable additivity `∫_V g dμ ≤ θ μ(V)`, and `g ≤ 1`
on `W \ V`, so `∫_W g dμ ≤ μ(W) − (1 − θ) μ(V) ≤ μ(W) − (1 − θ) μ(E)`. -/
theorem Submission.cbrld_vitali_setIntegral_le : ∀ (P : ℕ) (μ : Measure (Euclid P)) (g : Euclid P → ℝ) (θ : ℝ) (E W : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → AEStronglyMeasurable g μ → (∀ᵐ x ∂μ, |g x| ≤ 1) → θ ≤ 1 → IsOpen W → E ⊆ W → μ W < ∞ → (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ ∫ y in closedBall x ρ, g y ∂μ ≤ θ * (μ (closedBall x ρ)).toReal) → ∫ y in W, g y ∂μ ≤ (μ W).toReal - (1 - θ) * (μ E).toReal := by
  intro P μ g θ E W hK hg hg1 hθ hW hEW hWfin hsmall
  -- steps 1–3: countably many pairwise disjoint admissible balls `B̄_{r(x)}(x) ⊆ W`, `x ∈ t`,
  -- covering `μ`-almost all of `E`
  obtain ⟨t, r, htc, -, hr, hdisj, hnull⟩ :=
    Submission.cbrldvc_exists_disjoint_closedBall_cover P μ
      (fun x ρ => ∫ y in closedBall x ρ, g y ∂μ ≤ θ * (μ (closedBall x ρ)).toReal) E W hK hW hEW
      hsmall
  -- step 4: their union `V` is measurable, `V ⊆ W`, `μ(V) < ∞` and `μ(E) ≤ μ(V)`
  have hVmeas : MeasurableSet (⋃ x ∈ t, closedBall x (r x)) :=
    MeasurableSet.biUnion htc fun _ _ => measurableSet_closedBall
  have hVW : ⋃ x ∈ t, closedBall x (r x) ⊆ W := iUnion₂_subset fun x hx => (hr x hx).2.1
  have hVfin : μ (⋃ x ∈ t, closedBall x (r x)) < ∞ := (measure_mono hVW).trans_lt hWfin
  have hEV : μ E ≤ μ (⋃ x ∈ t, closedBall x (r x)) := measure_mono_ae (ae_le_set.2 hnull)
  -- step 5: `∫_V g dμ ≤ θ μ(V)`, summing over the disjoint balls
  have hgV : IntegrableOn g (⋃ x ∈ t, closedBall x (r x)) μ :=
    Measure.integrableOn_of_bounded hVfin.ne hg (M := 1)
      (ae_restrict_of_ae (hg1.mono fun x hx => by rwa [Real.norm_eq_abs]))
  have hV : ∫ y in ⋃ x ∈ t, closedBall x (r x), g y ∂μ ≤
      θ * (μ (⋃ x ∈ t, closedBall x (r x))).toReal :=
    Submission.cbrldvc_setIntegral_biUnion_le_mul_measure P μ g θ t (fun x => closedBall x (r x))
      htc (fun _ _ => measurableSet_closedBall) hdisj hVfin hgV fun x hx => (hr x hx).2.2
  -- steps 6–7: `g ≤ 1` on `W \ V`; then `μ(E) ≤ μ(V)` and `1 − θ ≥ 0`
  calc ∫ y in W, g y ∂μ
      ≤ (μ W).toReal - (1 - θ) * (μ (⋃ x ∈ t, closedBall x (r x))).toReal :=
        Submission.cbrldvc_setIntegral_le_sub_of_subset P μ g θ _ W hg hg1 hVmeas hVW hWfin hV
    _ ≤ (μ W).toReal - (1 - θ) * (μ E).toReal :=
        sub_le_sub_left (mul_le_mul_of_nonneg_left (ENNReal.toReal_mono hVfin.ne hEV)
          (sub_nonneg.2 hθ)) _
/-- **Degree-zero mass gap** (Simon Ch. 6, footnote 5 to 8.2, the case `n = 1`), assuming the
mass representation `(MR)` `M_W(T) = μ_T(W)` for open `U`, `W`: an integer multiplicity
`0`-current `Z` in `ℝᴾ` with `M(Z) < 1` is zero.  If `Z = τ(M, θ, ξ)` and `x ∈ M`, then
`M(Z) = μ_Z(ℝᴾ) ≥ μ_Z({x}) = θ(x) H⁰({x}) = θ(x) ≥ 1`; hence `M = ∅` and every `Z(ω)` is an
integral over `∅`. -/
theorem Submission.cbrld_im_degree_zero_eq_zero_of_mass_lt_one : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ∀ (P : ℕ) (Z : GeometricCurrentOn (univ : Set (Euclid P)) 0), IsIntegerMultiplicity Z → Z.mass < 1 → Z = 0 := by
  rintro hMR P Z ⟨R, hR⟩ hZ
  -- `(MR)` with `U = W = ℝᴾ`: `M(Z) = μ_Z(ℝᴾ)`
  have hmass : Z.mass = R.measure univ := hMR P 0 univ Z R isOpen_univ hR univ isOpen_univ
  -- a point `x ∈ M` would carry `μ_Z({x}) = θ(x) H⁰({x}) = θ(x) ≥ 1 > M(Z)`
  have hempty : R.carrier = ∅ := by
    refine eq_empty_of_forall_notMem fun x hx => ?_
    have hx1 : R.measure {x} = (R.mult x : ℝ≥0∞) := by
      rw [IMRep.measure, withDensity_apply _ (measurableSet_singleton x), lintegral_singleton,
        Measure.restrict_apply (measurableSet_singleton x), singleton_inter_of_mem hx,
        Measure.euclideanHausdorffMeasure_zero, Measure.hausdorffMeasure_zero_singleton, mul_one]
    have h1 : (1 : ℝ≥0∞) ≤ R.measure {x} := hx1 ▸ Nat.one_le_cast.2 (R.mult_pos x hx)
    exact not_le.2 hZ (h1.trans ((measure_mono (subset_univ _)).trans hmass.ge))
  -- every `Z(ω)` is an integral over `M = ∅`
  ext ω
  rw [hR ω, GeometricCurrentOn.zero_apply, IMRep.action, hempty, setIntegral_empty]
/-- **Simon Ch. 6, proof of 8.2, (2)–(4)**, with the lower density in place of `Θ^{*n}`: small
fillings of sphere slices at points of small lower density.  For `n = d + 1` fix `a > 0` (`a = 1/4`
if `n = 1`; for `n = m + 2`, `cbrldlf_exists_filling_constant` for the constant `c` of (ISO)) and
put `η₀ = aⁿ/ωₙ`.  A scale `s ∈ (0, δ)` with `μ(B_s(x₁)) < (as)ⁿ`
(`cbrldlf_exists_small_scale_of_lower_density`) and the null set of
`cbrld_sphere_slice_isIntegerMultiplicity` give a good radius `ρ ∈ (0, s)`
(`cbrld_exists_good_slice_radius`): `A = C⌞B_ρ(x₁)` has an integer multiplicity boundary `Z = ∂A`
with `spt Z ⊆ ∂B_ρ(x₁)` and `M(Z) ≤ 2naF^{(n−1)/n}`, `F = μ(B_ρ(x₁))`.  If `n = 1`, then
`M(Z) ≤ 1/2`, so `Z = 0` (`cbrld_im_degree_zero_eq_zero_of_mass_lt_one`) and `S = 0`; if `n ≥ 2`,
`S` is the filling of `Z` given by (ISO), with `M(S) ≤ F/2` and `spt S` within `3√P·s` of
`∂B_ρ(x₁)`. -/
theorem Submission.cbrld_exists_small_filling_of_low_density : (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P m : ℕ), ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∀ x₁ : Euclid P, liminf (fun r : ℝ => μ (ball x₁ r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0) < ENNReal.ofReal η₀ → ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ μ (sphere x₁ ρ) = 0 ∧ ∃ (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in ball x₁ ρ, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) ∧ S.boundary = A.boundary ∧ S.mass ≤ ENNReal.ofReal (1 / 2) * μ (ball x₁ ρ) ∧ S.support ⊆ closedBall x₁ ((1 + 3 * Real.sqrt P) * δ) := by
  intro hSL hMR hISO P d
  -- Steps 1, 4 and 5: the choice of `a` and the filling of the sphere slice
  suffices H : ∃ a : ℝ, 0 < a ∧ ∀ (x₁ : Euclid P) (δ s ρ F : ℝ)
      (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), 0 < s → ρ < s → s < δ → 0 ≤ F →
      F ≤ (a * s) ^ (d + 1) → IsIntegerMultiplicity A.boundary →
      A.boundary.support ⊆ sphere x₁ ρ →
      A.boundary.mass ≤ ENNReal.ofReal (2 * ((d + 1 : ℕ) : ℝ) * a *
        F ^ ((((d + 1 : ℕ) : ℝ) - 1) / ((d + 1 : ℕ) : ℝ))) →
      ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1), S.boundary = A.boundary ∧
        S.mass ≤ ENNReal.ofReal (F / 2) ∧ S.support ⊆ closedBall x₁ ((1 + 3 * Real.sqrt P) * δ) by
    obtain ⟨a, ha, H⟩ := H
    -- Step 0: `ωₙ > 0`; Step 1: `η₀ = aⁿ/ωₙ`
    obtain ⟨hw, hsmall⟩ := Submission.cbrldlf_exists_small_scale_of_lower_density (d + 1)
    refine ⟨a ^ (d + 1) / (unitBallVolume (d + 1)).toReal, div_pos (pow_pos ha _) hw, ?_⟩
    intro C μ ξ hCb hμ hξm hξb hC hISP x₁ hlim δ hδ
    -- Step 2: a scale `s ∈ (0, δ)` with `μ(B_s(x₁)) < η₀ωₙsⁿ = (as)ⁿ`
    obtain ⟨s, hs, hsδ, hμs⟩ := hsmall P μ x₁ _ δ hδ hlim
    rw [div_mul_cancel₀ _ hw.ne', ← mul_pow] at hμs
    -- Step 3: a good radius `ρ ∈ (0, s)` off the null set of the slices, and `A = C⌞B_ρ(x₁)`
    obtain ⟨N, hN, hslice⟩ :=
      Submission.cbrld_sphere_slice_isIntegerMultiplicity hSL P d C μ ξ x₁ hCb hμ hξm hξb hC hISP
    obtain ⟨ρ, hρ, hρs, hρN, hsph, hlimρ⟩ :=
      Submission.cbrld_exists_good_slice_radius P (d + 1) μ x₁ a s N hμ (by omega) ha hs hμs hN
    obtain ⟨A, hA, hAim, hAspt, hAmass⟩ := hslice ρ hρ hρN
    -- `F = μ(B_ρ(x₁)) ≤ μ(B_s(x₁)) < (as)ⁿ`
    have hμρ : μ (ball x₁ ρ) ≤ μ (ball x₁ s) := measure_mono (ball_subset_ball hρs.le)
    have hμρ_ne : μ (ball x₁ ρ) ≠ ∞ := (hμρ.trans_lt (hμs.trans ENNReal.ofReal_lt_top)).ne
    have hF : (μ (ball x₁ ρ)).toReal ≤ (a * s) ^ (d + 1) :=
      ENNReal.toReal_le_of_le_ofReal (by positivity) (hμρ.trans hμs.le)
    obtain ⟨S, hSb, hSmass, hSspt⟩ := H x₁ δ s ρ (μ (ball x₁ ρ)).toReal A hs hρs hsδ
      ENNReal.toReal_nonneg hF hAim hAspt (hAmass.trans hlimρ)
    -- Step 6
    refine ⟨ρ, hρ, hρs.trans hsδ, hsph, A, S, hA, hSb, ?_, hSspt⟩
    calc S.mass ≤ ENNReal.ofReal ((μ (ball x₁ ρ)).toReal / 2) := hSmass
      _ = ENNReal.ofReal (1 / 2) * μ (ball x₁ ρ) := by
        rw [show (μ (ball x₁ ρ)).toReal / 2 = 1 / 2 * (μ (ball x₁ ρ)).toReal by ring,
          ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 1 / 2), ENNReal.ofReal_toReal hμρ_ne]
  cases d with
  | zero =>
    -- Step 4 (`n = 1`, `a = 1/4`): `M(∂A) ≤ 2a = 1/2 < 1`, so `∂A = 0` and `S = 0`
    refine ⟨1 / 4, by norm_num, fun x₁ δ s ρ F A _ _ _ _ _ hAim _ hAmass => ?_⟩
    have hZ : A.boundary = 0 := by
      refine Submission.cbrld_im_degree_zero_eq_zero_of_mass_lt_one hMR P _ hAim
        (hAmass.trans_lt ?_)
      rw [ENNReal.ofReal_lt_one]
      norm_num
    refine ⟨0, ?_, ?_, ?_⟩
    · rw [hZ]
      exact GeometricCurrentOn.ext fun ω => rfl
    · -- every value of the zero current is `0`
      refine sSup_le ?_
      rintro _ ⟨ω, -, rfl⟩
      simp
    · -- the zero current vanishes on every ball `B₁(y)`
      intro y hy
      exfalso
      apply hy.2
      exact Set.mem_sUnion_of_mem (mem_ball_self one_pos) ⟨isOpen_ball,
        (isCompact_closedBall y 1).of_isClosed_subset isClosed_closure
          closure_ball_subset_closedBall, subset_univ _, fun ω _ => rfl⟩
  | succ m =>
    -- Step 5 (`n = m + 2`): `S` is the filling of `Z = ∂A` given by (ISO)
    obtain ⟨c, hc, hiso⟩ := hISO P m
    obtain ⟨a, ha, hconst⟩ := Submission.cbrldlf_exists_filling_constant m c hc
    refine ⟨a, ha, fun x₁ δ s ρ F A hs hρs hsδ hF0 hF hAim hAspt hAmass => ?_⟩
    -- `∂Z = ∂∂A = 0`, `spt Z` is a closed subset of the sphere `∂B_ρ(x₁)` and `M(Z) < ∞`
    have hZb : A.boundary.boundary = 0 := GeometricCurrentOn.boundary_boundary A
    have hZcpt : IsCompact A.boundary.support := by
      refine (isCompact_sphere x₁ ρ).of_isClosed_subset ?_ hAspt
      rw [GeometricCurrentOn.support, ← Set.compl_eq_univ_sdiff]
      exact A.boundary.isOpen_zeroRegion.isClosed_compl
    obtain ⟨Y, -, hYb, hYmass, hYspt⟩ :=
      hiso A.boundary hAim hZcpt hZb (hAmass.trans_lt ENNReal.ofReal_lt_top)
    -- (a) `M(Y) ≤ F/2` and (b) `(2cM(Z))^{1/(m+1)} ≤ s`
    have hM := ENNReal.toReal_le_of_le_ofReal (by positivity) hAmass
    obtain ⟨hmass, hrad⟩ := hconst s F _ hs.le hF0 hF ENNReal.toReal_nonneg hM
    refine ⟨Y, hYb, hYmass.trans (ENNReal.ofReal_le_ofReal hmass), fun y hy => ?_⟩
    -- `y` lies within `3√P·s` of a point `z` of `spt Z ⊆ ∂B_ρ(x₁)`, and `ρ < s < δ`
    obtain ⟨z, hz, hyz⟩ := Metric.mem_thickening_iff.mp (hYspt hy)
    have hzx : dist z x₁ = ρ := hAspt hz
    have h3 := mul_le_mul_of_nonneg_left (hrad.trans hsδ.le)
      (by positivity : (0 : ℝ) ≤ 3 * Real.sqrt P)
    rw [Metric.mem_closedBall]
    linarith [dist_triangle y z x₁]

/-- **Uniform approximation by test forms** (extension of a current of locally finite mass to
continuous fields, approximating sequences).  Let `|α| = covectorEuclideanNorm α = ‖c α‖` for a
continuous linear equivalence `c` onto a Euclidean space.  A continuous, compactly supported
`n`-covector field `G` with `tsupport G ⊆ V` (`V` open) is uniformly `ε`-approximated in `|·|` by a
test form `ω` with `tsupport ω ⊆ V`.

Since `c` is linear, `|t • α| = |t| |α|`.  The field `c ∘ G` is continuous with compact support,
hence bounded, so `|G| ≤ s` for some `s > 0`.  Mollifying the unit field `g = s⁻¹ • G` with error
`ε / s` (`dor_ims_sua_mollify_unit_field`) gives a test form `ω₀` with `tsupport ω₀ ⊆ V`; then
`ω = s • ω₀` is a test form with `tsupport ω ⊆ V` and `|ω x − G x| = s |ω₀ x − g x| ≤ ε`. -/
theorem Submission.cmr_tfe_uniform_testForm_approx : ∀ (P n d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (V : Set (Euclid P)) (G : Euclid P → Covector (Euclid P) n) (ε : ℝ), (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → IsOpen V → Continuous G → HasCompactSupport G → tsupport G ⊆ V → 0 < ε → ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧ ∀ x, covectorEuclideanNorm (ω x - G x) ≤ ε := by
  intro P n d c V G ε hc hV hG hGs hGV hε
  -- (1) homogeneity: `|t • α| = ‖c (t • α)‖ = |t| ‖c α‖ = |t| |α|`
  have hsm : ∀ (t : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := fun t α => by
    rw [hc, hc, map_smul, norm_smul, Real.norm_eq_abs]
  -- (2) `c ∘ G` is continuous with compact support, so `|G| ≤ s` for some `s > 0`
  obtain ⟨C, hC⟩ := (hGs.comp_left (map_zero c)).exists_bound_of_continuous (c.continuous.comp hG)
  obtain ⟨s, hs, hGs'⟩ : ∃ s : ℝ, 0 < s ∧ ∀ x, covectorEuclideanNorm (G x) ≤ s :=
    ⟨max C 0 + 1, by positivity, fun x => by
      rw [hc]
      exact (hC x).trans ((le_max_left C 0).trans (le_add_of_nonneg_right zero_le_one))⟩
  -- (3) the normalized field `g = s⁻¹ • G` has `|g| ≤ 1`
  have hg1 : ∀ x, covectorEuclideanNorm (s⁻¹ • G x) ≤ 1 := fun x => by
    rw [hsm, abs_of_pos (inv_pos.mpr hs), inv_mul_le_iff₀ hs, mul_one]
    exact hGs' x
  -- (4) mollify `g` with error `ε / s`
  obtain ⟨ω₀, hω₀, hω₀V, -, hω₀g⟩ := Submission.dor_ims_sua_mollify_unit_field P n V
    (s⁻¹ • G) (ε / s) hV (hG.const_smul s⁻¹) (hGs.comp_left (smul_zero s⁻¹))
    ((tsupport_smul_subset_right (fun _ => s⁻¹) G).trans hGV) hg1 (div_pos hε hs)
  -- (5) `ω = s • ω₀` is a test form with `tsupport ω ⊆ V`
  refine ⟨s • ω₀, (testFormSubmodule n).smul_mem s hω₀,
    (tsupport_smul_subset_right (fun _ => s) ω₀).trans hω₀V, fun x => ?_⟩
  -- (6) `ω x - G x = s • (ω₀ x - g x)`, so `|ω x - G x| = s |ω₀ x - g x| ≤ s (ε / s) = ε`
  have hω : (s • ω₀) x - G x = s • (ω₀ x - s⁻¹ • G x) := by
    rw [Pi.smul_apply, smul_sub, smul_inv_smul₀ hs.ne']
  rw [hω, hsm, abs_of_pos hs]
  exact (le_div_iff₀' hs).mp (hω₀g x)
/-- **Limit functional along uniformly convergent test forms** (test-form extension, steps 4–5).
Let `|α| = ‖c α‖` for a continuous linear equivalence `c`, and let `|T ω| ≤ r m(W)` whenever
`W ⊂⊂ U` is open, `spt ω ⊆ W` and `|ω(x)| ≤ r` for all `x`.  Then there is `Φ` with
`T(ωₖ) → Φ(G)` whenever `spt ωₖ ⊆ W` for one open `W ⊂⊂ U` and all `k`, and
`|ωₖ(x) − G(x)| ≤ εₖ` for all `k`, `x`, with `εₖ → 0`.

For two such data `(W, ωₖ, εₖ)`, `(W', ω'ₗ, ε'ₗ)` of the same `G`, `ωₖ − ω'ₗ` is a test form with
`spt ⊆ W ∪ W' ⊂⊂ U` and `|ωₖ − ω'ₗ| ≤ εₖ + ε'ₗ`, so `|T(ωₖ) − T(ω'ₗ)| ≤ (εₖ + ε'ₗ) m(W ∪ W')`.
With equal data, `(T(ωₖ))` is Cauchy, hence convergent.  `Φ(G)` is the limit along chosen data
(`0` if there are none), and the estimate with `l = k` shows that every approximating sequence
of `G` tends to `Φ(G)`. -/
theorem Submission.cmr_tfe_exists_limit_functional : ∀ (P n d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (m : Set (Euclid P) → ℝ), (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → (∀ (W : Set (Euclid P)) (ω : TestFormOn U n) (r : ℝ), IsOpen W → CompactlyContained W U → tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ r) → |T ω| ≤ r * m W) → ∃ Φ : (Euclid P → Covector (Euclid P) n) → ℝ, ∀ (G : Euclid P → Covector (Euclid P) n) (W : Set (Euclid P)) (ωs : ℕ → TestFormOn U n) (εs : ℕ → ℝ), IsOpen W → CompactlyContained W U → (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) → (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) → Tendsto εs atTop (𝓝 0) → Tendsto (fun k => T (ωs k)) atTop (𝓝 (Φ G)) := by
  intro P n d c U T m hc hm
  classical
  -- (1) `|α − β| ≤ |α| + |β|`, since `|·| = ‖c ·‖` with `c` linear
  have htri : ∀ α β : Covector (Euclid P) n,
      covectorEuclideanNorm (α - β) ≤ covectorEuclideanNorm α + covectorEuclideanNorm β := by
    intro α β
    rw [hc, hc, hc, map_sub]
    exact norm_sub_le _ _
  -- (2)–(3) the key estimate for two approximating data of the same `G`
  have hkey : ∀ (G : Euclid P → Covector (Euclid P) n) (W W' : Set (Euclid P))
      (ωs ωs' : ℕ → TestFormOn U n) (εs εs' : ℕ → ℝ), IsOpen W → CompactlyContained W U →
      (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) →
      (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) →
      IsOpen W' → CompactlyContained W' U →
      (∀ k, tsupport (ωs' k : DifferentialForm (Euclid P) n) ⊆ W') →
      (∀ k x, covectorEuclideanNorm ((ωs' k : DifferentialForm (Euclid P) n) x - G x) ≤ εs' k) →
      ∀ k l, |T (ωs k) - T (ωs' l)| ≤ (εs k + εs' l) * m (W ∪ W') := by
    intro G W W' ωs ωs' εs εs' hW hWU hωW hωG hW' hW'U hω'W hω'G k l
    -- `W ∪ W'` is open and `W ∪ W' ⊂⊂ U`
    have hWW'U : CompactlyContained (W ∪ W') U := by
      rw [CompactlyContained, closure_union]
      exact ⟨hWU.1.union hW'U.1, union_subset hWU.2 hW'U.2⟩
    -- the bound for `δ = ωs k − ωs' l`, and `T δ = T (ωs k) − T (ωs' l)` by linearity
    have h := hm (W ∪ W') (ωs k - ωs' l) (εs k + εs' l) (hW.union hW') hWW'U ?_ ?_
    · rwa [map_sub T.toCurrent] at h
    · rw [Submodule.coe_sub]
      exact (tsupport_sub _ _).trans (union_subset_union (hωW k) (hω'W l))
    · intro x
      rw [Submodule.coe_sub, Pi.sub_apply,
        ← sub_sub_sub_cancel_right ((ωs k : DifferentialForm (Euclid P) n) x) _ (G x)]
      exact (htri _ _).trans (add_le_add (hωG k x) (hω'G l x))
  -- (4) along approximating data, `(T (ωs k))` is Cauchy, hence convergent
  have hconv : ∀ (G : Euclid P → Covector (Euclid P) n) (W : Set (Euclid P))
      (ωs : ℕ → TestFormOn U n) (εs : ℕ → ℝ), IsOpen W → CompactlyContained W U →
      (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) →
      (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) →
      Tendsto εs atTop (𝓝 0) → ∃ L, Tendsto (fun k => T (ωs k)) atTop (𝓝 L) := by
    intro G W ωs εs hW hWU hωW hωG hε
    refine cauchySeq_tendsto_of_complete (cauchySeq_iff_tendsto_dist_atTop_0.mpr ?_)
    have h0 := ((hε.comp tendsto_fst).add (hε.comp tendsto_snd)).mul_const (m (W ∪ W))
    rw [add_zero, zero_mul, prod_atTop_atTop_eq] at h0
    refine squeeze_zero (fun _ => dist_nonneg) (fun p => ?_) h0
    rw [Real.dist_eq]
    exact hkey G W W ωs ωs εs εs hW hWU hωW hωG hW hWU hωW hωG p.1 p.2
  -- (5) `Φ G` is the limit along chosen approximating data of `G` (`0` if there are none)
  refine ⟨fun G => if h : ∃ (L : ℝ) (W : Set (Euclid P)) (ωs : ℕ → TestFormOn U n)
      (εs : ℕ → ℝ), IsOpen W ∧ CompactlyContained W U ∧
      (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) ∧
      (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) ∧
      Tendsto εs atTop (𝓝 0) ∧ Tendsto (fun k => T (ωs k)) atTop (𝓝 L) then h.choose else 0, ?_⟩
  -- (6) every approximating sequence of `G` tends to `Φ G`
  intro G W ωs εs hW hWU hωW hωG hε
  obtain ⟨L, hL⟩ := hconv G W ωs εs hW hWU hωW hωG hε
  have h : ∃ (L : ℝ) (W : Set (Euclid P)) (ωs : ℕ → TestFormOn U n) (εs : ℕ → ℝ),
      IsOpen W ∧ CompactlyContained W U ∧
      (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) ∧
      (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) ∧
      Tendsto εs atTop (𝓝 0) ∧ Tendsto (fun k => T (ωs k)) atTop (𝓝 L) :=
    ⟨L, W, ωs, εs, hW, hWU, hωW, hωG, hε, hL⟩
  dsimp only
  rw [dite_eq_left h]
  obtain ⟨W', ωs', εs', hW', hW'U, hω'W, hω'G, hε', hL'⟩ := h.choose_spec
  have h0 := (hε.add hε').mul_const (m (W ∪ W'))
  rw [add_zero, zero_mul] at h0
  have hdiff : Tendsto (fun k => T (ωs k) - T (ωs' k)) atTop (𝓝 0) :=
    squeeze_zero_norm (fun k => (Real.norm_eq_abs _).trans_le
      (hkey G W W' ωs ωs' εs εs' hW hWU hωW hωG hW' hW'U hω'W hω'G k k)) h0
  have hlim := hL'.add hdiff
  rw [add_zero] at hlim
  exact hlim.congr fun k => add_sub_cancel _ _

/-- **Extending a locally bounded current to continuous covector fields.**  Let `|α| = ‖c α‖` for
a continuous linear equivalence `c` onto `ℝᵈ`, and let `m` bound `T` locally: `|T(ω)| ≤ r m(W)`
whenever `W ⊂⊂ U` is open, `spt ω ⊆ W` and `|ω| ≤ r`.  Take `Φ` with `T(ωₖ) → Φ(G)` along test
forms `ωₖ` supported in one open `W ⊂⊂ U` with `|ωₖ − G| ≤ εₖ → 0`
(`cmr_tfe_exists_limit_functional`).  A compact subset of `U` lies in an open `W ⊂⊂ U`, and a
continuous `G` with compact support in `W` has such approximants with `εₖ = 1/(k+1)`
(`cmr_tfe_uniform_testForm_approx`).  Sums and multiples of approximants approximate `G₁ + G₂`
(in `W₁ ∪ W₂`) and `t G`, so additivity and homogeneity follow from the linearity of `T` and
uniqueness of limits; the constant sequence `ω` gives `Φ(ω) = T(ω)`; and `|ωₖ| ≤ r + 1/(k+1)`
gives `|T(ωₖ)| ≤ (r + 1/(k+1)) m(W)`, whence `|Φ(G)| ≤ r m(W)`. -/
theorem Submission.cmr_tfe_ambient_extension : ∀ (P n d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (m : Set (Euclid P) → ℝ), IsOpen U → (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → (∀ (W : Set (Euclid P)) (ω : TestFormOn U n) (r : ℝ), IsOpen W → CompactlyContained W U → tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ r) → |T ω| ≤ r * m W) → ∃ Φ : (Euclid P → Covector (Euclid P) n) → ℝ, (∀ G₁ G₂ : Euclid P → Covector (Euclid P) n, Continuous G₁ → HasCompactSupport G₁ → tsupport G₁ ⊆ U → Continuous G₂ → HasCompactSupport G₂ → tsupport G₂ ⊆ U → Φ (G₁ + G₂) = Φ G₁ + Φ G₂) ∧ (∀ (t : ℝ) (G : Euclid P → Covector (Euclid P) n), Continuous G → HasCompactSupport G → tsupport G ⊆ U → Φ (t • G) = t * Φ G) ∧ (∀ ω : TestFormOn U n, Φ (ω : DifferentialForm (Euclid P) n) = T ω) ∧ ∀ (W : Set (Euclid P)) (G : Euclid P → Covector (Euclid P) n) (r : ℝ), IsOpen W → CompactlyContained W U → Continuous G → HasCompactSupport G → tsupport G ⊆ W → (∀ x, covectorEuclideanNorm (G x) ≤ r) → |Φ G| ≤ r * m W := by
  intro P n d c U T m hU hc hm
  -- (1) the limit functional `Φ`
  obtain ⟨Φ, hΦ⟩ := Submission.cmr_tfe_exists_limit_functional P n d c U T m hc hm
  -- `|α + β| ≤ |α| + |β|` and `|t • α| = |t| |α|`, read through `c`
  have hadd : ∀ α β : Covector (Euclid P) n,
      covectorEuclideanNorm (α + β) ≤ covectorEuclideanNorm α + covectorEuclideanNorm β := by
    intro α β
    rw [hc, hc, hc, map_add]
    exact norm_add_le _ _
  have hsmul : ∀ (t : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := by
    intro t α
    rw [hc, hc, map_smul, norm_smul, Real.norm_eq_abs]
  -- (2) a compact subset of `U` lies in an open `W ⊂⊂ U`; and `W ⊂⊂ U` gives `W ⊆ U`
  have hnbhd : ∀ S : Set (Euclid P), IsCompact S → S ⊆ U →
      ∃ W, IsOpen W ∧ S ⊆ W ∧ CompactlyContained W U := by
    intro S hS hSU
    obtain ⟨W, hWo, hSW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hS hU hSU
    exact ⟨W, hWo, hSW, hWc, hWU⟩
  have hsub : ∀ W, CompactlyContained W U → W ⊆ U := fun W hW => subset_closure.trans hW.2
  -- (3) approximants `ωₖ ∈ 𝒟ⁿ(U)` with `spt ωₖ ⊆ W` and `|ωₖ − G| ≤ 1/(k+1)`
  have happrox : ∀ (W : Set (Euclid P)) (G : Euclid P → Covector (Euclid P) n), IsOpen W →
      CompactlyContained W U → Continuous G → HasCompactSupport G → tsupport G ⊆ W →
      ∃ ωs : ℕ → TestFormOn U n, (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) ∧
        ∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤
          1 / ((k : ℝ) + 1) := by
    intro W G hW hWU hG hGc hGW
    have hk : ∀ k : ℕ, ∃ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W ∧
        ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x - G x) ≤
          1 / ((k : ℝ) + 1) := by
      intro k
      obtain ⟨ω, hωt, hωW, hωe⟩ := Submission.cmr_tfe_uniform_testForm_approx P n d c
        W G (1 / ((k : ℝ) + 1)) hc hW hG hGc hGW (by positivity)
      exact ⟨⟨ω, hωt, hωW.trans (hsub W hWU)⟩, hωW, hωe⟩
    choose ωs hωW hωe using hk
    exact ⟨ωs, hωW, hωe⟩
  have hlim : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  refine ⟨Φ, ?_, ?_, ?_, ?_⟩
  · -- (4) additivity: `ω¹ₖ + ω²ₖ` approximates `G₁ + G₂` in `W₁ ∪ W₂ ⊂⊂ U`
    intro G₁ G₂ hG₁ hG₁c hG₁U hG₂ hG₂c hG₂U
    obtain ⟨W₁, hW₁o, hG₁W₁, hW₁U⟩ := hnbhd _ hG₁c hG₁U
    obtain ⟨W₂, hW₂o, hG₂W₂, hW₂U⟩ := hnbhd _ hG₂c hG₂U
    obtain ⟨ω₁, hω₁W, hω₁e⟩ := happrox W₁ G₁ hW₁o hW₁U hG₁ hG₁c hG₁W₁
    obtain ⟨ω₂, hω₂W, hω₂e⟩ := happrox W₂ G₂ hW₂o hW₂U hG₂ hG₂c hG₂W₂
    have hWU : CompactlyContained (W₁ ∪ W₂) U := by
      refine ⟨?_, ?_⟩ <;> rw [closure_union]
      exacts [hW₁U.1.union hW₂U.1, union_subset hW₁U.2 hW₂U.2]
    have h := hΦ (G₁ + G₂) (W₁ ∪ W₂) (fun k => ω₁ k + ω₂ k)
      (fun k => 1 / ((k : ℝ) + 1) + 1 / ((k : ℝ) + 1)) (hW₁o.union hW₂o) hWU
      (fun k => by
        simp only [Submodule.coe_add]
        exact (tsupport_add _ _).trans (union_subset_union (hω₁W k) (hω₂W k)))
      (fun k x => by
        simp only [Submodule.coe_add, Pi.add_apply]
        rw [add_sub_add_comm]
        exact (hadd _ _).trans (add_le_add (hω₁e k x) (hω₂e k x)))
      (by simpa only [add_zero] using hlim.add hlim)
    have h' : Tendsto (fun k => T (ω₁ k + ω₂ k)) atTop (𝓝 (Φ G₁ + Φ G₂)) :=
      ((hΦ G₁ W₁ ω₁ _ hW₁o hW₁U hω₁W hω₁e hlim).add
        (hΦ G₂ W₂ ω₂ _ hW₂o hW₂U hω₂W hω₂e hlim)).congr fun k =>
          (T.toCurrent.map_add (ω₁ k) (ω₂ k)).symm
    exact tendsto_nhds_unique h h'
  · -- (5) homogeneity: `t ωₖ` approximates `t G` with errors `|t|/(k+1)`
    intro t G hG hGc hGU
    obtain ⟨W, hWo, hGW, hWU⟩ := hnbhd _ hGc hGU
    obtain ⟨ωs, hωW, hωe⟩ := happrox W G hWo hWU hG hGc hGW
    have h := hΦ (t • G) W (fun k => t • ωs k) (fun k => |t| * (1 / ((k : ℝ) + 1))) hWo hWU
      (fun k => by
        simp only [Submodule.coe_smul]
        exact (tsupport_smul_subset_right (fun _ => t) _).trans (hωW k))
      (fun k x => by
        simp only [Submodule.coe_smul, Pi.smul_apply]
        have e : t • (ωs k : DifferentialForm (Euclid P) n) x - t • G x =
            t • ((ωs k : DifferentialForm (Euclid P) n) x - G x) := (smul_sub t _ _).symm
        rw [e, hsmul]
        exact mul_le_mul_of_nonneg_left (hωe k x) (abs_nonneg t))
      (by simpa only [mul_zero] using hlim.const_mul |t|)
    have h' : Tendsto (fun k => T (t • ωs k)) atTop (𝓝 (t * Φ G)) :=
      ((hΦ G W ωs _ hWo hWU hωW hωe hlim).const_mul t).congr fun k => by
        rw [T.toCurrent.map_smul, smul_eq_mul]
    exact tendsto_nhds_unique h h'
  · -- (6) agreement: the constant sequence `ω`, with errors `0`
    intro ω
    obtain ⟨W, hWo, hωW, hWU⟩ := hnbhd _ ω.property.1.2 ω.property.2
    exact tendsto_nhds_unique (hΦ (ω : DifferentialForm (Euclid P) n) W (fun _ => ω) (fun _ => 0)
      hWo hWU (fun _ => hωW) (fun _ x => by simp) tendsto_const_nhds) tendsto_const_nhds
  · -- (7) bound: `|ωₖ| ≤ r + 1/(k+1)`, so `|T(ωₖ)| ≤ (r + 1/(k+1)) m(W)`; let `k → ∞`
    intro W G r hWo hWU hG hGc hGW hr
    obtain ⟨ωs, hωW, hωe⟩ := happrox W G hWo hWU hG hGc hGW
    have hb : ∀ k : ℕ, |T (ωs k)| ≤ (r + 1 / ((k : ℝ) + 1)) * m W := by
      intro k
      refine hm W (ωs k) _ hWo hWU (hωW k) fun x => ?_
      calc covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x)
          = covectorEuclideanNorm (((ωs k : DifferentialForm (Euclid P) n) x - G x) + G x) := by
            rw [sub_add_cancel]
        _ ≤ 1 / ((k : ℝ) + 1) + r := (hadd _ _).trans (add_le_add (hωe k x) (hr x))
        _ = r + 1 / ((k : ℝ) + 1) := add_comm _ _
    have hmW : Tendsto (fun k : ℕ => (r + 1 / ((k : ℝ) + 1)) * m W) atTop (𝓝 (r * m W)) := by
      simpa only [add_zero] using ((tendsto_const_nhds (x := r)).add hlim).mul_const (m W)
    exact le_of_tendsto_of_tendsto' (hΦ G W ωs _ hWo hWU hωW hωe hlim).abs hmW hb
/-- **Simon 6.1.2, 6.1.5, 6.1.15** (the coefficient norm is Euclidean): `n`-covectors on `ℝᴾ`
with `|α|_E = (Σ_I α(e_I)²)^{1/2}`, `I` strictly increasing, form a Euclidean space `ℝᵈ`.  The
coefficient map `A α = (α(e_I))_I` (zero off the increasing `I`) into `ℝ^{Fin n → Fin P}` has
`‖A α‖ = |α|_E`, and it is injective by the Gram bound `|α v| ≤ |α|_E · det(⟨vᵢ, vⱼ⟩)^{1/2}`.
An orthonormal basis of `range A` identifies it isometrically with `ℝᵈ`; then covectors are
finite-dimensional, so this linear equivalence is continuous. -/
theorem Submission.cmr_covector_euclidean_equiv : ∀ (P n : ℕ), ∃ (d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)), ∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖ := by
  intro P n
  -- the coefficient map `A α = (α(e_I))_I`, zero off the strictly increasing `I`
  let A : Covector (Euclid P) n →ₗ[ℝ] EuclideanSpace ℝ (Fin n → Fin P) :=
    { toFun := fun α => WithLp.toLp 2 (fun I => if StrictMono I then
        α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i)) else 0)
      map_add' := fun α β => by
        ext I
        simp only [PiLp.add_apply, ContinuousAlternatingMap.add_apply]
        split_ifs <;> simp
      map_smul' := fun t α => by
        ext I
        simp only [PiLp.smul_apply, ContinuousAlternatingMap.smul_apply, RingHom.id_apply,
          smul_eq_mul]
        split_ifs <;> simp }
  -- `‖A α‖ = |α|_E`
  have hnorm : ∀ α, ‖A α‖ = covectorEuclideanNorm α := by
    intro α
    rw [EuclideanSpace.norm_eq]
    unfold covectorEuclideanNorm
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    simp only [A, LinearMap.coe_mk, AddHom.coe_mk, PiLp.toLp_apply, Real.norm_eq_abs, sq_abs]
    split_ifs <;> simp
  -- `A` is injective: `|α|_E = 0` forces `α v = 0` by the Gram bound
  have hinj : Function.Injective A := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro α hα
    have h0 : covectorEuclideanNorm α = 0 := by rw [← hnorm, hα, norm_zero]
    ext v
    have hv := (Submission.covectorEuclideanNorm_gram_bounds P n).1 α v
    rw [h0, zero_mul] at hv
    simpa using abs_nonpos_iff.mp hv
  -- identify `range A` isometrically with `ℝᵈ` through an orthonormal basis
  let S := LinearMap.range A
  let b := stdOrthonormalBasis ℝ S
  let e₀ : Covector (Euclid P) n ≃ₗ[ℝ] S := LinearEquiv.ofInjective A hinj
  let c₀ : Covector (Euclid P) n ≃ₗ[ℝ] EuclideanSpace ℝ (Fin (Module.finrank ℝ S)) :=
    e₀.trans b.repr.toLinearEquiv
  have hc₀ : ∀ α, ‖c₀ α‖ = covectorEuclideanNorm α := by
    intro α
    have h1 : c₀ α = b.repr (e₀ α) := rfl
    rw [h1, LinearIsometryEquiv.norm_map, ← Submodule.norm_coe, LinearEquiv.ofInjective_apply,
      hnorm]
  -- covectors are finite-dimensional, so `c₀` is continuous
  have : FiniteDimensional ℝ (Covector (Euclid P) n) := LinearEquiv.finiteDimensional c₀.symm
  refine ⟨Module.finrank ℝ S, c₀.toContinuousLinearEquiv, fun α => ?_⟩
  rw [LinearEquiv.coe_toContinuousLinearEquiv', hc₀]
/-- **Simon 6.1.1–1.2** (coordinate covectors): (a) for every `I` the coordinate covector
`dx^I(v) = det(v_j(I k))_{k,j}` exists; (b) an `n`-vector vanishing on `dx^I` for every strictly
increasing `I` vanishes.  Every `n`-covector expands as `α = Σ_I α(e_I) dx^I` over strictly
increasing `I`: by `dx^I(e_J) = δ_IJ` the remainder vanishes on every `e_J`, so its coefficient
norm `|·|_E` is `0`, and `|·|_E` is the norm of a linear isomorphism onto `ℝᵈ`. -/
theorem Submission.cmr_coordinate_covectors_span : ∀ (P n : ℕ), (∀ I : Fin n → Fin P, ∃ θ : Covector (Euclid P) n, ∀ v : Fin n → Euclid P, θ v = Matrix.det (Matrix.of fun k j => v j (I k))) ∧ ∀ ζ : MultiVector P n, (∀ (I : Fin n → Fin P) (θ : Covector (Euclid P) n), StrictMono I → (∀ v : Fin n → Euclid P, θ v = Matrix.det (Matrix.of fun k j => v j (I k))) → ζ θ = 0) → ζ = 0 := by
  intro P n
  refine ⟨Submission.cmr_cc_det_covector_exists P n, fun ζ hζ => ?_⟩
  classical
  -- `θ I = dx^I` for every `I`
  choose θ hθ using Submission.cmr_cc_det_covector_exists P n
  -- `dx^I(e_J) = δ_IJ` for strictly increasing `I`, `J`
  have hδ : ∀ I J : Fin n → Fin P, StrictMono I → StrictMono J →
      θ I (fun j => EuclideanSpace.basisFun (Fin P) ℝ (J j)) = if I = J then 1 else 0 :=
    fun I J hI hJ => Submission.cmr_cc_det_covector_basis_kronecker P n I J (θ I) hI hJ (hθ I)
  -- `α = Σ_I α(e_I) dx^I` over strictly increasing `I`
  have hexp : ∀ α : Covector (Euclid P) n, α = ∑ I : Fin n → Fin P,
      if StrictMono I then α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i)) • θ I
      else 0 := by
    intro α
    obtain ⟨α', hα'⟩ : ∃ α', α' = α - ∑ I : Fin n → Fin P,
        if StrictMono I then α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i)) • θ I
        else 0 := ⟨_, rfl⟩
    -- `α'(e_J) = α(e_J) - Σ_I α(e_I) δ_IJ = 0` for strictly increasing `J`
    have hJ : ∀ J : Fin n → Fin P, StrictMono J →
        α' (fun j => EuclideanSpace.basisFun (Fin P) ℝ (J j)) = 0 := by
      intro J hJ
      rw [hα', ContinuousAlternatingMap.sub_apply, ContinuousAlternatingMap.sum_apply,
        Finset.sum_eq_single J, ite_eq_left hJ, ContinuousAlternatingMap.smul_apply,
        hδ J J hJ hJ, ite_eq_left rfl, smul_eq_mul, mul_one, sub_self]
      · intro I _ hIJ
        split_ifs with hI
        · rw [ContinuousAlternatingMap.smul_apply, hδ I J hI hJ, ite_eq_right hIJ, smul_zero]
        · rfl
      · intro h
        exact absurd (Finset.mem_univ J) h
    -- so `|α'|_E = 0`, and `α' = 0` as `|·|_E` is the norm of a linear isomorphism onto `ℝᵈ`
    have hnorm : covectorEuclideanNorm α' = 0 := by
      unfold covectorEuclideanNorm
      rw [Finset.sum_eq_zero fun I _ => ?_, Real.sqrt_zero]
      split_ifs with hI
      · rw [hJ I hI, sq, mul_zero]
      · rfl
    obtain ⟨d, c, hc⟩ := Submission.cmr_covector_euclidean_equiv P n
    have hc0 : c α' = 0 := norm_eq_zero.mp ((hc α').symm.trans hnorm)
    rw [c.map_eq_zero_iff, hα'] at hc0
    exact sub_eq_zero.mp hc0
  -- `ζ` vanishes on every `dx^I`, hence on every covector
  refine ContinuousLinearMap.ext fun α => ?_
  rw [zero_apply, hexp α, map_sum]
  refine Finset.sum_eq_zero fun I _ => ?_
  split_ifs with hI
  · rw [map_smul, hζ I (θ I) hI (hθ I), smul_zero]
  · exact map_zero ζ
/-- **Extension of a current of locally finite mass to `C_c(U, ℝᵈ)`** (Simon Ch. 6, the remark
after 2.6 applying the Riesz representation theorem, Ch. 1, 4.14).  By hypothesis
`M_W(T) < ∞` for open `W ⊂⊂ U`, so `cmr_abs_apply_le_massOn` gives `|T(ω)| ≤ r M_W(T)` when
`spt ω ⊆ W` and `|ω| ≤ r`.  Hence `cmr_tfe_ambient_extension` extends `T` to a functional `Φ` on
continuous compactly supported covector fields in `U`, additive and homogeneous on them, with
`|Φ(G)| ≤ r M_W(T)` when `spt G ⊆ W` and `|G| ≤ r`.  For `g ∈ C_c(U, ℝᵈ)` let `g̃ = c⁻¹ ∘ g` on
`U` and `g̃ = 0` off `U` (`Function.extend`).  Then `g̃` is continuous with compact support,
`spt g̃ ⊆ spt g ⊆ U`, and `g ↦ g̃` is linear, so `L(g) = Φ(g̃)` is linear.  If `g = c ∘ ω` on `U`,
then `g̃ = ω`, so `L(g) = T(ω)`.  If `spt g ⊆ K` and `‖g‖ ≤ 1`, then `|g̃| = ‖c g̃‖ ≤ 1` and
`spt g̃ ⊆ W` for a fixed open `W ⊂⊂ U` containing `K`, so `|L(g)| ≤ M_W(T)`. -/
theorem Submission.cmr_testForm_extension_functional : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → ∃ L : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ, (∀ (ω : TestFormOn U n) (g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d))), (∀ x : U, g x = c ((ω : DifferentialForm (Euclid P) n) x)) → L g = T ω) ∧ ∀ K : Set U, IsCompact K → ∃ M : ℝ, ∀ g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)), tsupport g ⊆ K → (∀ x, ‖g x‖ ≤ 1) → |L g| ≤ M := by
  intro P n U T d c hU hfin hc
  -- (1) `Φ`, for the local mass bound `m W = M_W(T)` (finite for open `W ⊂⊂ U`)
  obtain ⟨Φ, hΦadd, hΦsmul, hΦT, hΦle⟩ := Submission.cmr_tfe_ambient_extension P n d c U T
    (fun W => (T.massOn W).toReal) hU hc fun W ω r hW hWU hωW hωr =>
      Submission.cmr_abs_apply_le_massOn P n U W T ω r (hfin W hW hWU).ne hωW hωr
  -- (2) the zero extension `g̃`: `c⁻¹ ∘ g` on `U`, `0` off `U`
  let G : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)) →
      Euclid P → Covector (Euclid P) n := fun g =>
    Function.extend Subtype.val (fun x : U => c.symm (g x)) 0
  have hGU : ∀ g (x : U), G g x = c.symm (g x) := fun g x =>
    Subtype.val_injective.extend_apply _ _ x
  have hGnU : ∀ g (y : Euclid P), y ∉ U → G g y = 0 := fun g y hy =>
    Function.extend_apply' _ _ y fun ⟨x, hx⟩ => hy (hx ▸ x.2)
  have hgc : ∀ g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)),
      HasCompactSupport fun x : U => c.symm (g x) := fun g =>
    g.hasCompactSupport.comp_left (map_zero c.symm)
  have hGcont : ∀ g, Continuous (G g) := fun g =>
    HasCompactSupport.continuous_extend_zero hU (c.symm.continuous.comp g.continuous) (hgc g)
  have hGcs : ∀ g, HasCompactSupport (G g) := fun g =>
    (hgc g).extend_zero continuous_subtype_val
  have hGsupp : ∀ g, tsupport (G g) ⊆ Subtype.val '' tsupport g := fun g =>
    ((hgc g).tsupport_extend_zero_subset continuous_subtype_val).trans
      (image_mono (tsupport_comp_subset (map_zero c.symm) g))
  have hGsU : ∀ g, tsupport (G g) ⊆ U := fun g =>
    (hGsupp g).trans (Subtype.coe_image_subset U _)
  have hGadd : ∀ g₁ g₂, G (g₁ + g₂) = G g₁ + G g₂ := by
    intro g₁ g₂
    funext y
    by_cases hy : y ∈ U
    · obtain ⟨x, rfl⟩ : ∃ x : U, (x : Euclid P) = y := ⟨⟨y, hy⟩, rfl⟩
      rw [Pi.add_apply, hGU, hGU, hGU, CompactlySupportedContinuousMap.add_apply, map_add]
    · rw [Pi.add_apply, hGnU _ y hy, hGnU _ y hy, hGnU _ y hy, add_zero]
  have hGsmul : ∀ (t : ℝ) g, G (t • g) = t • G g := by
    intro t g
    funext y
    by_cases hy : y ∈ U
    · obtain ⟨x, rfl⟩ : ∃ x : U, (x : Euclid P) = y := ⟨⟨y, hy⟩, rfl⟩
      rw [Pi.smul_apply, hGU, hGU, CompactlySupportedContinuousMap.smul_apply, map_smul]
    · rw [Pi.smul_apply, hGnU _ y hy, hGnU _ y hy, smul_zero]
  -- (3) `L g = Φ g̃` is linear
  refine ⟨{ toFun := fun g => Φ (G g)
            map_add' := fun g₁ g₂ => by
              show Φ (G (g₁ + g₂)) = Φ (G g₁) + Φ (G g₂)
              rw [hGadd, hΦadd _ _ (hGcont g₁) (hGcs g₁) (hGsU g₁) (hGcont g₂) (hGcs g₂)
                (hGsU g₂)]
            map_smul' := fun t g => by
              show Φ (G (t • g)) = t • Φ (G g)
              rw [hGsmul, hΦsmul t _ (hGcont g) (hGcs g) (hGsU g), smul_eq_mul] }, ?_, ?_⟩
  · -- (i) `g = c ∘ ω` on `U` forces `g̃ = ω`
    intro ω g hg
    have hωU : tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.property.2
    have hGω : G g = (ω : DifferentialForm (Euclid P) n) := by
      funext y
      by_cases hy : y ∈ U
      · obtain ⟨x, rfl⟩ : ∃ x : U, (x : Euclid P) = y := ⟨⟨y, hy⟩, rfl⟩
        rw [hGU, hg, c.symm_apply_apply]
      · have hy' : y ∉ tsupport (ω : DifferentialForm (Euclid P) n) := fun h => hy (hωU h)
        rw [hGnU g y hy, image_eq_zero_of_notMem_tsupport hy']
    show Φ (G g) = T ω
    rw [hGω, hΦT]
  · -- (ii) an open `W ⊂⊂ U` containing `K`, and `|Φ g̃| ≤ 1 · M_W(T)` for unit fields `g`
    intro K hK
    obtain ⟨W, hW, hKW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure
      (hK.image continuous_subtype_val) hU (Subtype.coe_image_subset U K)
    refine ⟨1 * (T.massOn W).toReal, fun g hgK hg1 => ?_⟩
    show |Φ (G g)| ≤ 1 * (T.massOn W).toReal
    refine hΦle W (G g) 1 hW ⟨hWc, hWU⟩ (hGcont g) (hGcs g)
      ((hGsupp g).trans ((image_mono hgK).trans hKW)) fun y => ?_
    rw [hc]
    by_cases hy : y ∈ U
    · obtain ⟨x, rfl⟩ : ∃ x : U, (x : Euclid P) = y := ⟨⟨y, hy⟩, rfl⟩
      rw [hGU, c.apply_symm_apply]
      exact hg1 x
    · rw [hGnU g y hy, map_zero, norm_zero]
      exact zero_le_one
/-- Coordinate functionals of a locally bounded `L : C_c(X, ℝᵈ) → ℝ`: `Λᵢ(f) = L(f • eᵢ)` is
linear and locally bounded with the same constants.  `T f := f.compLeft (t ↦ t • eᵢ)` is linear
with `(T f)(x) = f(x) • eᵢ`, `tsupport (T f) ⊆ tsupport f` and `‖(T f)(x)‖ = |f(x)|`;
take `Λᵢ := L ∘ T`. -/
theorem Submission.cmr_vr_coordinate_functional : ∀ (X : Type) [TopologicalSpace X] (d : ℕ) (L : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ), (∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), tsupport g ⊆ K → (∀ x, ‖g x‖ ≤ 1) → |L g| ≤ M) → ∀ i : Fin d, ∃ Λ : CompactlySupportedContinuousMap X ℝ →ₗ[ℝ] ℝ, (∀ (f : CompactlySupportedContinuousMap X ℝ) (g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d))), (∀ x, g x = f x • EuclideanSpace.single i (1 : ℝ)) → L g = Λ f) ∧ ∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ f : CompactlySupportedContinuousMap X ℝ, tsupport f ⊆ K → (∀ x, |f x| ≤ 1) → |Λ f| ≤ M := by
  intro X _ d L hL i
  -- `c t = t • eᵢ` is continuous and `c 0 = 0`, so `T f := f.compLeft c` has `(T f) x = f x • eᵢ`
  let c : C(ℝ, EuclideanSpace ℝ (Fin d)) :=
    ⟨fun t => t • EuclideanSpace.single i (1 : ℝ), continuous_id.smul continuous_const⟩
  have hc0 : c 0 = 0 := zero_smul ℝ _
  have hT : ∀ (f : CompactlySupportedContinuousMap X ℝ) (x : X),
      f.compLeft c x = f x • EuclideanSpace.single i (1 : ℝ) :=
    fun f x => CompactlySupportedContinuousMap.compLeft_apply hc0 f x
  -- `T` is linear (pointwise, then extensionality); `Λ := L ∘ T`
  let T : CompactlySupportedContinuousMap X ℝ →ₗ[ℝ]
      CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)) :=
    { toFun := fun f => f.compLeft c
      map_add' := fun f₁ f₂ => CompactlySupportedContinuousMap.ext fun x => by
        simp only [hT, CompactlySupportedContinuousMap.add_apply, add_smul]
      map_smul' := fun r f => CompactlySupportedContinuousMap.ext fun x => by
        simp only [hT, CompactlySupportedContinuousMap.smul_apply, RingHom.id_apply, smul_eq_mul,
          mul_smul] }
  refine ⟨L ∘ₗ T, fun f g hg => ?_, fun K hK => ?_⟩
  · -- `g = T f` by extensionality
    exact congrArg L (CompactlySupportedContinuousMap.ext fun x => (hg x).trans (hT f x).symm)
  · -- `tsupport (T f) ⊆ tsupport f ⊆ K` and `‖(T f) x‖ = |f x| ≤ 1`: same constant `M`
    obtain ⟨M, hM⟩ := hL K hK
    refine ⟨M, fun f hf hf1 => hM (T f) ?_ fun x => ?_⟩
    · have hTf : ⇑(T f) = fun x => f x • EuclideanSpace.single i (1 : ℝ) := funext (hT f)
      rw [hTf]
      exact (tsupport_smul_subset_left _ _).trans hf
    · show ‖f.compLeft c x‖ ≤ 1
      rw [hT, norm_smul, PiLp.norm_single, norm_one, mul_one, Real.norm_eq_abs]
      exact hf1 x
/-- Jordan decomposition of a locally bounded `Λ : C_c(X, ℝ) → ℝ`.  For `f : C_c(X, ℝ≥0)` put
`V f := sup {Λ h : |h| ≤ f}` (bounded above by rescaling the local bound on `tsupport f`).  `V` is
additive (clamp `h₁ := (h ⊓ f) ⊔ (-f)`) and `ℝ≥0`-homogeneous, so `V̂ := toRealPositiveLinear V`
is positive; `V̂ + Λ` is positive since `-k` is admissible for `k ≥ 0`, and `Λ = (V̂ + Λ) - V̂`. -/
theorem Submission.cmr_vr_jordan_decomposition : ∀ (X : Type) [TopologicalSpace X] (Λ : CompactlySupportedContinuousMap X ℝ →ₗ[ℝ] ℝ), (∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ f : CompactlySupportedContinuousMap X ℝ, tsupport f ⊆ K → (∀ x, |f x| ≤ 1) → |Λ f| ≤ M) → ∃ Λ₁ Λ₂ : CompactlySupportedContinuousMap X ℝ →ₚ[ℝ] ℝ, ∀ f : CompactlySupportedContinuousMap X ℝ, Λ f = Λ₁ f - Λ₂ f := by
  intro X _ Λ hΛ
  -- scaled bound: `tsupport f ⊆ K`, `|f| ≤ s` give `|Λ f| ≤ s * M_K` (`s = 0`, else rescale)
  have hscale : ∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ (f : CompactlySupportedContinuousMap X ℝ)
      (s : ℝ), tsupport f ⊆ K → 0 ≤ s → (∀ x, |f x| ≤ s) → |Λ f| ≤ s * M := by
    intro K hK
    obtain ⟨M, hM⟩ := hΛ K hK
    refine ⟨M, fun f s hfK hs hfs => ?_⟩
    rcases hs.eq_or_lt with rfl | hspos
    · have hf0 : f = 0 := by
        ext x
        simpa using hfs x
      simp [hf0]
    · have hsub : tsupport (s⁻¹ • f) ⊆ K :=
        (tsupport_smul_subset_right (fun _ : X => s⁻¹) f).trans hfK
      have hbd : ∀ x, |(s⁻¹ • f) x| ≤ 1 := by
        intro x
        rw [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul, abs_mul,
          abs_of_pos (inv_pos.mpr hspos)]
        calc s⁻¹ * |f x| ≤ s⁻¹ * s := mul_le_mul_of_nonneg_left (hfs x) (inv_pos.mpr hspos).le
          _ = 1 := inv_mul_cancel₀ hspos.ne'
      have h1 := hM _ hsub hbd
      rw [map_smul, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hspos)] at h1
      have := (inv_mul_le_iff₀ hspos).mp h1
      linarith
  -- `A f = {h : |h| ≤ f}` contains `0`, and `Λ '' A f` is bounded above: members of `A f` have
  -- `tsupport h ⊆ tsupport f` and `|h| ≤ max C 0` with `C` a bound for `f`
  let A : CompactlySupportedContinuousMap X NNReal → Set (CompactlySupportedContinuousMap X ℝ) :=
    fun f => {h | ∀ x, |h x| ≤ (f x : ℝ)}
  have hA0 : ∀ f, (0 : CompactlySupportedContinuousMap X ℝ) ∈ A f := by
    intro f x
    simp
  have hbdd : ∀ f, BddAbove (Λ '' A f) := by
    intro f
    obtain ⟨M, hM⟩ := hscale (tsupport f) f.hasCompactSupport.isCompact
    obtain ⟨C, hC⟩ := f.toReal.continuous.bounded_above_of_compact_support
      f.toReal.hasCompactSupport
    refine ⟨max C 0 * M, ?_⟩
    rintro _ ⟨h, hh, rfl⟩
    have hsupp : tsupport h ⊆ tsupport f := by
      apply closure_mono
      intro x hx hfx
      apply hx
      have := hh x
      rw [hfx] at this
      simpa using this
    have hbd : ∀ x, |h x| ≤ max C 0 := by
      intro x
      refine (hh x).trans ((le_abs_self _).trans ?_)
      have h' : ‖f.toReal x‖ ≤ C := hC x
      rw [CompactlySupportedContinuousMap.toReal_apply, Real.norm_eq_abs] at h'
      exact h'.trans (le_max_left _ _)
    exact (le_abs_self _).trans (hM h _ hsupp (le_max_right _ _) hbd)
  -- the variation `V f = sup (Λ '' A f) ≥ Λ 0 = 0`
  let V : CompactlySupportedContinuousMap X NNReal → ℝ := fun f => sSup (Λ '' A f)
  have hle : ∀ f, ∀ h ∈ A f, Λ h ≤ V f := fun f h hh => le_csSup (hbdd f) ⟨h, hh, rfl⟩
  have hVle : ∀ f (c : ℝ), (∀ h ∈ A f, Λ h ≤ c) → V f ≤ c := by
    intro f c hc
    exact csSup_le ⟨0, 0, hA0 f, map_zero Λ⟩ (by rintro _ ⟨h, hh, rfl⟩; exact hc h hh)
  have hV0 : ∀ f, 0 ≤ V f := fun f => by simpa using hle f 0 (hA0 f)
  -- additivity: `≤` by the clamp `h₁ = (h ⊓ f) ⊔ (-f)`, `h - h₁ ∈ A g`; `≥` by `h₁ + h₂ ∈ A (f + g)`
  have hadd : ∀ f g, V (f + g) = V f + V g := by
    intro f g
    apply le_antisymm
    · apply hVle
      intro h hh
      let h₁ : CompactlySupportedContinuousMap X ℝ := (h ⊓ f.toReal) ⊔ (-f.toReal)
      have hpt : ∀ x, |h₁ x| ≤ (f x : ℝ) ∧ |(h - h₁) x| ≤ (g x : ℝ) := by
        intro x
        have hx := hh x
        have hf0 : (0 : ℝ) ≤ f x := (f x).2
        have hg0 : (0 : ℝ) ≤ g x := (g x).2
        simp only [CompactlySupportedContinuousMap.add_apply, NNReal.coe_add] at hx
        simp only [h₁, CompactlySupportedContinuousMap.sub_apply,
          CompactlySupportedContinuousMap.sup_apply, CompactlySupportedContinuousMap.inf_apply,
          CompactlySupportedContinuousMap.neg_apply, CompactlySupportedContinuousMap.toReal_apply]
        rw [abs_le] at hx ⊢
        rw [abs_le]
        rcases le_total (h x) (f x) with h1 | h1
        · rw [min_eq_left h1]
          rcases le_total (h x) (-(f x : ℝ)) with h2 | h2
          · rw [max_eq_right h2]
            constructor <;> constructor <;> linarith
          · rw [max_eq_left h2]
            constructor <;> constructor <;> linarith
        · rw [min_eq_right h1, max_eq_left (by linarith)]
          constructor <;> constructor <;> linarith
      have h1mem : h₁ ∈ A f := fun x => (hpt x).1
      have h2mem : h - h₁ ∈ A g := fun x => (hpt x).2
      have e : Λ h = Λ h₁ + Λ (h - h₁) := by rw [map_sub]; ring
      rw [e]
      exact add_le_add (hle f h₁ h1mem) (hle g _ h2mem)
    · have key : V f ≤ V (f + g) - V g := by
        apply hVle
        intro h₁ hh₁
        have : V g ≤ V (f + g) - Λ h₁ := by
          apply hVle
          intro h₂ hh₂
          have hmem : h₁ + h₂ ∈ A (f + g) := by
            intro x
            simp only [CompactlySupportedContinuousMap.add_apply, NNReal.coe_add]
            exact (abs_add_le _ _).trans (add_le_add (hh₁ x) (hh₂ x))
          have := hle _ _ hmem
          rw [map_add] at this
          linarith
        linarith
      linarith
  -- homogeneity: `A 0 = {0}`; for `c > 0`, `h ↦ c⁻¹ • h` maps `A (c • f)` into `A f`
  have hzero : V 0 = 0 := by
    apply le_antisymm _ (hV0 0)
    apply hVle
    intro h hh
    have : h = 0 := by
      ext x
      simpa using hh x
    simp [this]
  have hsmul_le : ∀ (c : NNReal) f, V (c • f) ≤ c * V f := by
    intro c f
    rcases eq_or_ne c 0 with rfl | hc
    · simp [hzero]
    have hcpos : (0 : ℝ) < c := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hc)
    apply hVle
    intro h hh
    have hmem : (c : ℝ)⁻¹ • h ∈ A f := by
      intro x
      have := hh x
      simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul, NNReal.coe_mul] at this
      rw [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul, abs_mul,
        abs_of_pos (inv_pos.mpr hcpos)]
      rw [inv_mul_le_iff₀ hcpos]
      exact this
    have := hle f _ hmem
    rw [map_smul, smul_eq_mul] at this
    exact (inv_mul_le_iff₀ hcpos).mp this
  have hsmul : ∀ (c : NNReal) f, V (c • f) = c * V f := by
    intro c f
    rcases eq_or_ne c 0 with rfl | hc
    · simp [hzero]
    have hcpos : (0 : ℝ) < c := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hc)
    apply le_antisymm (hsmul_le c f)
    have h := hsmul_le c⁻¹ (c • f)
    rw [inv_smul_smul₀ hc, NNReal.coe_inv] at h
    exact (le_inv_mul_iff₀ hcpos).mp h
  -- `V` is `ℝ≥0`-linear; `V̂ := toRealPositiveLinear V` is a positive functional on `C_c(X, ℝ)`
  let W : CompactlySupportedContinuousMap X NNReal →ₗ[NNReal] NNReal :=
    { toFun := fun f => ⟨V f, hV0 f⟩
      map_add' := fun f g => NNReal.eq (hadd f g)
      map_smul' := fun c f => NNReal.eq (hsmul c f) }
  let Vh := CompactlySupportedContinuousMap.toRealPositiveLinear W
  -- `V̂ + Λ` is positive: for `k ≥ 0`, `V̂ k = V k⁺` and `-k ∈ A k⁺`, so `-Λ k ≤ V̂ k`
  have hdom : ∀ k : CompactlySupportedContinuousMap X ℝ, 0 ≤ k → 0 ≤ Vh k + Λ k := by
    intro k hk
    have hkeq : k.nnrealPart.toReal = k := by
      ext x
      rw [CompactlySupportedContinuousMap.toReal_apply,
        CompactlySupportedContinuousMap.nnrealPart_apply]
      exact Real.coe_toNNReal _ (hk x)
    have hVk : Vh k = V k.nnrealPart := by
      have := CompactlySupportedContinuousMap.eq_toRealPositiveLinear_toReal W k.nnrealPart
      rw [hkeq] at this
      exact this
    have hmem : -k ∈ A k.nnrealPart := by
      intro x
      rw [CompactlySupportedContinuousMap.neg_apply, abs_neg,
        CompactlySupportedContinuousMap.nnrealPart_apply, Real.coe_toNNReal _ (hk x)]
      exact (abs_of_nonneg (hk x)).le
    have := hle _ _ hmem
    rw [map_neg] at this
    rw [hVk]
    linarith
  refine ⟨PositiveLinearMap.mk₀ (Vh.toLinearMap + Λ) hdom, Vh, fun f => ?_⟩
  show Λ f = (Vh f + Λ f) - Vh f
  ring
/-- Common dominating measure (the common density step of the vector Riesz representation behind
the mass representation of currents, Simon Ch. 6, 2.7–2.8, used for Simon 7.2.4): if every `aᵢ`
and `bᵢ` (`i ∈ Fin m`) is finite on compact sets, then so is `μ₀ := ∑ᵢ (aᵢ + bᵢ)`, and
`aᵢ ≪ μ₀`, `bᵢ ≪ μ₀`.  Indeed `μ₀(s) = ∑ᵢ (aᵢ(s) + bᵢ(s))` for every set `s`, so `μ₀(K)` is a
finite sum of finite terms for compact `K`, and `μ₀(s) = 0` forces `aᵢ(s) = bᵢ(s) = 0`. -/
theorem Submission.cmr_vr_cd_dominating_measure : ∀ (X : Type) [TopologicalSpace X] [MeasurableSpace X] (m : ℕ) (a b : Fin m → Measure X), (∀ i, IsFiniteMeasureOnCompacts (a i)) → (∀ i, IsFiniteMeasureOnCompacts (b i)) → ∃ μ₀ : Measure X, IsFiniteMeasureOnCompacts μ₀ ∧ (∀ i, a i ≪ μ₀) ∧ ∀ i, b i ≪ μ₀ := by
  intro X _ _ m a b ha hb
  -- Step 1: `μ₀ := ∑ᵢ (aᵢ + bᵢ)` has `μ₀(s) = ∑ᵢ (aᵢ(s) + bᵢ(s))` for every set `s`
  have hμ₀ : ∀ s : Set X, (∑ i, (a i + b i)) s = ∑ i, (a i s + b i s) := fun s => by
    simp only [Measure.finsetSum_apply, Measure.add_apply]
  refine ⟨∑ i, (a i + b i), ⟨fun K hK => ?_⟩, fun i s hs => ?_, fun i s hs => ?_⟩
  -- Step 2: for compact `K`, `μ₀(K)` is a finite sum of finite terms
  · rw [hμ₀, ENNReal.sum_lt_top]
    exact fun i _ =>
      ENNReal.add_lt_top.2 ⟨(ha i).lt_top_of_isCompact hK, (hb i).lt_top_of_isCompact hK⟩
  -- Step 3: if `μ₀(s) = 0`, every summand `aᵢ(s) + bᵢ(s)` vanishes
  · rw [hμ₀, Finset.sum_eq_zero_iff] at hs
    exact (add_eq_zero.1 (hs i (Finset.mem_univ i))).1
  · rw [hμ₀, Finset.sum_eq_zero_iff] at hs
    exact (add_eq_zero.1 (hs i (Finset.mem_univ i))).2
/-- **Radon–Nikodym density on `C_c`.**  If `μ₀`, `ξ` are finite on compact subsets of a locally
compact second countable space and `ξ ≪ μ₀`, then `ξ` has a measurable density `g`, `μ₀`-integrable
on compact sets, with `f·g` `μ₀`-integrable and `∫ f dξ = ∫ f g dμ₀` for every `f ∈ C_c(X, ℝ)`.
`X` is σ-compact, so `μ₀`, `ξ` are σ-finite and `ξ = μ₀.withDensity δ` for `δ = ξ.rnDeriv μ₀`
(the singular part vanishes since `ξ ≪ μ₀`), with `δ < ∞` `μ₀`-a.e.  Take `g = δ.toReal`: on a
compact `K`, `∫⁻_K δ dμ₀ < ∞` because `ξ(K) < ∞`.  A bounded `f` with compact support times `g` is
integrable on `tsupport f` and vanishes outside it.  The `T2Space` hypothesis is not used. -/
theorem Submission.cmr_vr_cd_density_representation : ∀ (X : Type) [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X] [SecondCountableTopology X] [MeasurableSpace X] [BorelSpace X] (μ₀ ξ : Measure X), IsFiniteMeasureOnCompacts μ₀ → IsFiniteMeasureOnCompacts ξ → ξ ≪ μ₀ → ∃ g : X → ℝ, Measurable g ∧ (∀ K : Set X, IsCompact K → IntegrableOn g K μ₀) ∧ ∀ f : CompactlySupportedContinuousMap X ℝ, Integrable (fun x => f x * g x) μ₀ ∧ ∫ x, f x ∂ξ = ∫ x, f x * g x ∂μ₀ := by
  intro X _ _ _ _ _ _ μ₀ ξ hμ₀ hξ hac
  -- `X` is σ-compact, so both measures are σ-finite and `(ξ, μ₀)` has a Lebesgue decomposition
  have : SigmaCompactSpace X := sigmaCompactSpace_of_locallyCompact_secondCountable
  have : SigmaFinite μ₀ := SigmaFinite.of_isFiniteMeasureOnCompacts μ₀
  have : SigmaFinite ξ := SigmaFinite.of_isFiniteMeasureOnCompacts ξ
  -- `ξ = μ₀.withDensity δ` with `δ = dξ/dμ₀` measurable and `μ₀`-a.e. finite
  set δ : X → ℝ≥0∞ := ξ.rnDeriv μ₀
  have hδm : Measurable δ := Measure.measurable_rnDeriv ξ μ₀
  have hξδ : ξ = μ₀.withDensity δ := by
    have h := Measure.haveLebesgueDecomposition_add ξ μ₀
    rwa [Measure.singularPart_eq_zero_of_ac hac, zero_add] at h
  have hδlt : ∀ᵐ x ∂μ₀, δ x < ∞ := Measure.rnDeriv_lt_top ξ μ₀
  -- `g = δ.toReal` is integrable on compact sets: `∫⁻_K δ dμ₀ < ∞` since `ξ(K) < ∞`
  have hgK : ∀ K : Set X, IsCompact K → IntegrableOn (fun x => (δ x).toReal) K μ₀ := by
    intro K hK
    have hlin : ∫⁻ x in K, δ x ∂μ₀ < ∞ :=
      Measure.lintegral_rnDeriv_lt_top_of_measure_ne_top μ₀ hK.measure_lt_top.ne
    exact integrable_toReal_of_lintegral_ne_top hδm.aemeasurable hlin.ne
  refine ⟨fun x => (δ x).toReal, hδm.ennreal_toReal, hgK, fun f => ⟨?_, ?_⟩⟩
  -- `f` is bounded, so `f·g` is integrable on `tsupport f`, and it vanishes outside
  · obtain ⟨C, hC⟩ := (map_continuous f).bounded_above_of_compact_support f.hasCompactSupport
    have hon : IntegrableOn (fun x => f x * (δ x).toReal) (tsupport f) μ₀ :=
      Integrable.bdd_mul (c := C) (hgK _ f.hasCompactSupport.isCompact)
        (map_continuous f).measurable.aestronglyMeasurable (Eventually.of_forall hC)
    refine hon.integrable_of_forall_notMem_eq_zero fun x hx => ?_
    simp [image_eq_zero_of_notMem_tsupport hx]
  -- `∫ f dξ = ∫ δ.toReal • f dμ₀`
  · rw [hξδ, integral_withDensity_eq_integral_toReal_smul hδm hδlt]
    congr 1
    funext x
    exact (smul_eq_mul _ _).trans (mul_comm _ _)

/-- Common dominating measure and densities for finitely many pairs of positive functionals
(Riesz–Markov–Kakutani; Rudin, *Real and Complex Analysis*, Thm 2.14 and 6.10).  Let `X` be
locally compact, Hausdorff and second countable with its Borel σ-algebra, and let `Λ₁ᵢ, Λ₂ᵢ`
(`i ∈ Fin m`) be positive linear functionals on `C_c(X, ℝ)`.  Then there are a measure `μ₀`,
finite on compact sets, and measurable `ρᵢ`, `μ₀`-integrable on compact sets, with
`Λ₁ᵢ f - Λ₂ᵢ f = ∫ f ρᵢ dμ₀` for all `f ∈ C_c(X, ℝ)`.

Proof sketch:
* `bᵢ := rieszMeasure Λ₁ᵢ` and `aᵢ := rieszMeasure Λ₂ᵢ` are regular, hence finite on compact
  sets, and `∫ f dbᵢ = Λ₁ᵢ f`, `∫ f daᵢ = Λ₂ᵢ f`.
* `cmr_vr_cd_dominating_measure` gives a compact-finite `μ₀` with `aᵢ ≪ μ₀` and `bᵢ ≪ μ₀`.
* `cmr_vr_cd_density_representation` gives locally integrable densities `gaᵢ`, `gbᵢ` with
  `∫ f daᵢ = ∫ f gaᵢ dμ₀`, `∫ f dbᵢ = ∫ f gbᵢ dμ₀`, both integrands integrable.
* With `ρᵢ := gbᵢ - gaᵢ`, linearity of the integral gives the representation. -/
theorem Submission.cmr_vr_common_density : ∀ (X : Type) [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X] [SecondCountableTopology X] [MeasurableSpace X] [BorelSpace X] (m : ℕ) (Λ₁ Λ₂ : Fin m → (CompactlySupportedContinuousMap X ℝ →ₚ[ℝ] ℝ)), ∃ (μ₀ : Measure X) (ρ : Fin m → X → ℝ), IsFiniteMeasureOnCompacts μ₀ ∧ (∀ i, Measurable (ρ i)) ∧ (∀ i, ∀ K : Set X, IsCompact K → IntegrableOn (ρ i) K μ₀) ∧ ∀ (i : Fin m) (f : CompactlySupportedContinuousMap X ℝ), Λ₁ i f - Λ₂ i f = ∫ x, f x * ρ i x ∂μ₀ := by
  intro X _ _ _ _ _ _ m Λ₁ Λ₂
  -- Step 1 (RMK): the Riesz measures are regular, hence finite on compact sets
  have ha : ∀ i, IsFiniteMeasureOnCompacts (RealRMK.rieszMeasure (Λ₂ i)) :=
    fun _ => inferInstance
  have hb : ∀ i, IsFiniteMeasureOnCompacts (RealRMK.rieszMeasure (Λ₁ i)) :=
    fun _ => inferInstance
  -- Step 2: a common compact-finite measure `μ₀` with `aᵢ ≪ μ₀` and `bᵢ ≪ μ₀`
  obtain ⟨μ₀, hμ₀, hac_a, hac_b⟩ := Submission.cmr_vr_cd_dominating_measure X m
    (fun i => RealRMK.rieszMeasure (Λ₂ i)) (fun i => RealRMK.rieszMeasure (Λ₁ i)) ha hb
  -- Step 3: locally integrable densities `gaᵢ`, `gbᵢ` of `aᵢ`, `bᵢ` with respect to `μ₀`
  choose ga hga_meas hga_int hga_rep using fun i =>
    Submission.cmr_vr_cd_density_representation X μ₀ (RealRMK.rieszMeasure (Λ₂ i)) hμ₀ (ha i)
      (hac_a i)
  choose gb hgb_meas hgb_int hgb_rep using fun i =>
    Submission.cmr_vr_cd_density_representation X μ₀ (RealRMK.rieszMeasure (Λ₁ i)) hμ₀ (hb i)
      (hac_b i)
  -- Step 4: `ρᵢ := gbᵢ - gaᵢ` and linearity of the integral
  refine ⟨μ₀, fun i => gb i - ga i, hμ₀, fun i => (hgb_meas i).sub (hga_meas i),
    fun i K hK => (hgb_int i K hK).sub (hga_int i K hK), fun i f => ?_⟩
  obtain ⟨hgb_f, hgb_eq⟩ := hgb_rep i f
  obtain ⟨hga_f, hga_eq⟩ := hga_rep i f
  calc Λ₁ i f - Λ₂ i f
      = ∫ x, f x ∂(RealRMK.rieszMeasure (Λ₁ i)) - ∫ x, f x ∂(RealRMK.rieszMeasure (Λ₂ i)) := by
        rw [RealRMK.integral_rieszMeasure, RealRMK.integral_rieszMeasure]
    _ = ∫ x, f x * gb i x ∂μ₀ - ∫ x, f x * ga i x ∂μ₀ := by rw [hgb_eq, hga_eq]
    _ = ∫ x, (f x * gb i x - f x * ga i x) ∂μ₀ := (integral_sub hgb_f hga_f).symm
    _ = ∫ x, f x * (gb i - ga i) x ∂μ₀ := by simp only [Pi.sub_apply, mul_sub]
/-- Assembly of coordinate densities (vector Riesz representation, coordinate step): if the
`i`-th coordinate functional `f ↦ L(f eᵢ)` has density `ρᵢ` w.r.t. `μ₀` for each `i`, then `L` has
the vector density `ν = Σᵢ ρᵢ eᵢ`, i.e. `L g = ∫ ⟨g, ν⟩ dμ₀`.  Write `g = Σᵢ gᵢ eᵢ` with
`gᵢ = ⟨g, eᵢ⟩ ∈ C_c(X)`; each `gᵢ ρᵢ` is integrable (bounded continuous times integrable on the
compact `tsupport gᵢ`, zero outside it), so the finite sum and the integral commute. -/
theorem Submission.cmr_vr_coordinate_assembly : ∀ (X : Type) [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X] (d : ℕ) (L : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ) (μ₀ : Measure X) (ρ : Fin d → X → ℝ), (∀ i, Measurable (ρ i)) → (∀ i, ∀ K : Set X, IsCompact K → IntegrableOn (ρ i) K μ₀) → (∀ (i : Fin d) (f : CompactlySupportedContinuousMap X ℝ) (g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d))), (∀ x, g x = f x • EuclideanSpace.single i (1 : ℝ)) → L g = ∫ x, f x * ρ i x ∂μ₀) → ∃ ν : X → EuclideanSpace ℝ (Fin d), Measurable ν ∧ (∀ K : Set X, IsCompact K → IntegrableOn ν K μ₀) ∧ ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), L g = ∫ x, inner ℝ (g x) (ν x) ∂μ₀ := by
  intro X _ _ _ d L μ₀ ρ hρm hρi hL
  -- `ν = Σᵢ ρᵢ eᵢ`
  refine ⟨fun x => ∑ i, ρ i x • EuclideanSpace.single i (1 : ℝ),
    Finset.measurable_sum _ fun i _ => (hρm i).smul_const _,
    fun K hK => integrable_finsetSum _ fun i _ => (hρi i K hK).smul_const _, fun g => ?_⟩
  -- the coordinates `gᵢ = g(·)ᵢ ∈ C_c(X, ℝ)` and `Gᵢ = gᵢ eᵢ ∈ C_c(X, H)`
  obtain ⟨gc, hgc⟩ : ∃ gc : Fin d → CompactlySupportedContinuousMap X ℝ, ∀ i x, gc i x = g x i :=
    ⟨fun i => g.compLeft (EuclideanSpace.proj i : EuclideanSpace ℝ (Fin d) →L[ℝ] ℝ),
      fun i x => CompactlySupportedContinuousMap.compLeft_apply (by simp) g x⟩
  obtain ⟨G, hG⟩ : ∃ G : Fin d → CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)),
      ∀ i x, G i x = gc i x • EuclideanSpace.single i (1 : ℝ) :=
    ⟨fun i => (gc i).compLeft ⟨fun t => t • EuclideanSpace.single i (1 : ℝ), by fun_prop⟩,
      fun i x => CompactlySupportedContinuousMap.compLeft_apply (zero_smul ℝ _) (gc i) x⟩
  -- `g = Σᵢ Gᵢ`
  have hsum : g = ∑ i, G i := by
    ext x j
    simp [hG, hgc, Pi.single_apply]
  -- each `gᵢ ρᵢ` is integrable: bounded continuous times integrable on the compact `tsupport gᵢ`
  have hint : ∀ i, Integrable (fun x => gc i x * ρ i x) μ₀ := by
    intro i
    obtain ⟨C, hC⟩ := (gc i).continuous.bounded_above_of_compact_support (gc i).hasCompactSupport
    have hK : IntegrableOn (fun x => gc i x * ρ i x) (tsupport (gc i)) μ₀ :=
      Integrable.bdd_mul (hρi i _ (gc i).hasCompactSupport.isCompact)
        (gc i).continuous.aestronglyMeasurable (Eventually.of_forall hC)
    exact hK.integrable_of_forall_notMem_eq_zero fun x hx => by
      rw [image_eq_zero_of_notMem_tsupport hx, zero_mul]
  calc L g = ∑ i, L (G i) := (congrArg L hsum).trans (map_sum L G Finset.univ)
    _ = ∑ i, ∫ x, gc i x * ρ i x ∂μ₀ := Finset.sum_congr rfl fun i _ => hL i (gc i) (G i) (hG i)
    _ = ∫ x, ∑ i, gc i x * ρ i x ∂μ₀ := (integral_finsetSum _ fun i _ => hint i).symm
    _ = ∫ x, inner ℝ (g x) (∑ i, ρ i x • EuclideanSpace.single i (1 : ℝ)) ∂μ₀ := by
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      dsimp only
      rw [inner_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [inner_smul_right, EuclideanSpace.inner_single_right, hgc, conj_trivial, one_mul, mul_comm]

/-- **Riesz representation of locally bounded functionals on `C_c(X, ℝ^d)`** (Simon Ch. 1, 4.14,
in the form used for currents in Ch. 6, 2.7).  If `X` is locally compact Hausdorff and second
countable and `L : C_c(X, ℝ^d) → ℝ` is linear with `|L g| ≤ M_K` whenever `spt g ⊆ K` and
`|g| ≤ 1`, then `L g = ∫ ⟨g, ν⟩ dμ₀` for a Borel measure `μ₀` finite on compact sets and a
measurable `ν : X → ℝ^d` integrable on compact sets.  The coordinate functionals
`Λᵢ f = L(f eᵢ)` are locally bounded, each splits as a difference `Pᵢ − Nᵢ` of positive
functionals (total variation), the Riesz–Markov–Kakutani measures of all `Pᵢ, Nᵢ` have densities
`ρᵢ` against one common `μ₀`, and `ν = Σᵢ ρᵢ eᵢ`. -/
theorem Submission.cmr_vector_riesz_representation : ∀ (X : Type) [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X] [SecondCountableTopology X] [MeasurableSpace X] [BorelSpace X] (d : ℕ) (L : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ), (∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), tsupport g ⊆ K → (∀ x, ‖g x‖ ≤ 1) → |L g| ≤ M) → ∃ (μ₀ : Measure X) (ν : X → EuclideanSpace ℝ (Fin d)), IsFiniteMeasureOnCompacts μ₀ ∧ Measurable ν ∧ (∀ K : Set X, IsCompact K → IntegrableOn ν K μ₀) ∧ ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), L g = ∫ x, inner ℝ (g x) (ν x) ∂μ₀ := by
  intro X _ _ _ _ _ _ d L hL
  -- step 1: the coordinate functionals `Λᵢ f = L(f eᵢ)`, locally bounded
  choose Λ hΛL hΛbd using Submission.cmr_vr_coordinate_functional X d L hL
  -- steps 2–3: Jordan decomposition `Λᵢ = Pᵢ − Nᵢ` into positive functionals
  choose Pos Neg hΛ using fun i => Submission.cmr_vr_jordan_decomposition X (Λ i) (hΛbd i)
  -- steps 4–6 and 8: one measure `μ₀` with `Pᵢ f − Nᵢ f = ∫ f ρᵢ dμ₀`
  obtain ⟨μ₀, ρ, hμ₀, hρm, hρint, hρ⟩ := Submission.cmr_vr_common_density X d Pos Neg
  -- steps 7 and 9: `ν = Σᵢ ρᵢ eᵢ` and `L g = Σᵢ ∫ gᵢ ρᵢ dμ₀ = ∫ ⟨g, ν⟩ dμ₀`
  obtain ⟨ν, hνm, hνint, hν⟩ := Submission.cmr_vr_coordinate_assembly X d L μ₀ ρ hρm hρint
    fun i f g hg => by rw [hΛL i f g hg, hΛ i f, hρ i f]
  exact ⟨μ₀, ν, hμ₀, hνm, hνint, hν⟩

/-- **Simon Ch. 6, 2.7–2.8** (Riesz representation of a current of locally finite mass): if
`M_W(T) < ∞` for every open `W ⊂⊂ U`, then `T(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|⟨α, ξ⟩| ≤ |α|_E`,
`μ(ℝᴾ \ U) = 0`, `μ` finite on compact subsets of `U` and `M_W(T) = μ(W)` for open `W`.
Euclidean coordinates `c` on covectors (`|α|_E = ‖c α‖`) make `T` a locally bounded linear
functional `L` on `C_c(U, ℝᵈ)` with `L(c ∘ ω) = T ω`.  The vector Riesz theorem on the locally
compact space `U` gives `L g = ∫ ⟨g, ν⟩ dμ₀`.  Normalizing `ν` polarly and pushing `|ν| μ₀`
forward to `ℝᴾ` gives `μ`, the field `ξ = ⟨ν/|ν|, c(·)⟩` and a norming field `β` with
`ξ(β) = 1` `μ`-a.e.  Then `M_W(T) ≤ μ(W)` because `|ξ(ω)| ≤ |ω|_E ≤ 1`, while `μ(W') ≤ M_W(T)`
for open `W' ⊂⊂ U` inside `W` (test `T` on forms approximating `β`), and these `W'` exhaust
`W ∩ U`. -/
theorem Submission.cmr_exists_massRepresentation_core : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) := by
  intro P n U T hU hfin
  -- Step 1: Euclidean coordinates `c` on covectors, `|α|_E = ‖c α‖`
  obtain ⟨d, c, hc⟩ := Submission.cmr_covector_euclidean_equiv P n
  -- Step 2: `T` extends to a locally bounded linear functional `L` on `C_c(U, ℝᵈ)`
  obtain ⟨L, hLT, hLb⟩ := Submission.cmr_testForm_extension_functional P n U T d c hU hfin hc
  -- Step 3: vector Riesz representation `L g = ∫ ⟨g, ν⟩ dμ₀` on the locally compact space `U`
  have : LocallyCompactSpace U := hU.locallyCompactSpace
  obtain ⟨μ₀, ν, -, hνm, hνi, hLν⟩ := Submission.cmr_vector_riesz_representation U d L hLb
  -- Steps 4–9: `μ = val_*(|ν| μ₀)`, `ξ = ⟨ν/|ν|, c(·)⟩` and the norming field `β`
  obtain ⟨μ, ξ, β, hμU, hμK, hξm, hξ1, hβm, hβb, hβ1, hξβ, hμν⟩ :=
    Submission.cmrc_polar_pushforward P n d U c μ₀ ν hU hc hνm hνi
  -- Step 8: `T ω = L(c ∘ ω) = ∫ ⟨c ∘ ω, ν⟩ dμ₀ = ∫ ξ(ω) dμ`
  have hT : ∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ := by
    intro ω
    obtain ⟨g, hg⟩ := Submission.cmrc_testForm_restrict_cc P n d U c c.continuous c.map_zero ω
    rw [← hLT ω g hg, hLν g, ← hμν (ω : DifferentialForm (Euclid P) n)]
    simp only [hg]
  -- Steps 10–12: `M_W(T) ≤ μ(W)`, and `μ(W) ≤ M_W(T)` by exhausting `W ∩ U` with `W' ⊂⊂ U`
  refine ⟨μ, ξ, hμU, hμK, fun W hW => le_antisymm
    (Submission.cmrc_massOn_le_of_repr P n U T μ ξ hξ1 hT W) ?_, hξm, hξ1, hT⟩
  exact Submission.cmrc_measure_le_of_compactlyContained P μ U W (T.massOn W) hU hW hμU
    fun W' hW' hW'U hW'W => Submission.cmrc_measure_le_massOn_of_norming P n U T μ ξ β hμK hξm
      hξ1 hT hβm hβb hβ1 hξβ W W' hW' hW'U hW'W
/-- **Directional difference estimate from the divergence bound** (steps 1–2 of the parent proof).
For `‖w‖ ≤ 1` the field `g(y) = a(y + v) • w` is admissible and `div g(y) = Da(y + v)(w)` (trace
of a rank-one map), so `|∫ h·Da(q + v)(w) dν| ≤ Λ`.  The fundamental theorem of calculus along
`s ↦ q x + s • z` and Fubini on `(0, 1] × X` (majorant `M‖z‖|h|`, `‖Da‖ ≤ M`) give
`∫ h·(a(q + z) − a(q)) dν = ∫₀¹ ∫ h·Da(q + s • z)(z) dν ds`, and `Da(p)(z) = ‖z‖·Da(p)(w)` with
`w = ‖z‖⁻¹ • z` bounds the inner integral by `Λ‖z‖`. -/
theorem Submission.cmr_tdn_directional_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ) (Λ : ℝ), IsFiniteMeasure ν → Measurable q → Integrable h ν → (∀ g : Euclid n → Euclid n, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → (∀ y, ‖g y‖ ≤ 1) → |∫ x, h x * LinearMap.trace ℝ (Euclid n) (fderiv ℝ g (q x)).toLinearMap ∂ν| ≤ Λ) → ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → (∀ y, |a y| ≤ 1) → ∀ z : Euclid n, |∫ x, h x * (a (q x + z) - a (q x)) ∂ν| ≤ Λ * ‖z‖ := by
  intro n X _ ν q h Λ hν hq hh hdiv a ha hsupp hbd z
  -- Step 1: `a` is differentiable, `Da` is continuous with compact support, so `‖Da‖ ≤ M`
  have h0 : ((⊤ : ℕ∞) : WithTop ℕ∞) ≠ 0 := by simp
  have hdiff : Differentiable ℝ a := ha.differentiable h0
  have hcont : Continuous (fderiv ℝ a) := ha.continuous_fderiv h0
  obtain ⟨M, hM⟩ := hcont.bounded_above_of_compact_support (hsupp.fderiv ℝ)
  -- Step 3: for `‖w‖ ≤ 1` the field `g(y) = a(y + v) • w` is admissible, with
  -- `div g(y) = Da(y + v)(w)`; this gives `(∗)`
  have key : ∀ v w : Euclid n, ‖w‖ ≤ 1 → |∫ x, h x * fderiv ℝ a (q x + v) w ∂ν| ≤ Λ := by
    intro v w hw
    set g : Euclid n → Euclid n := fun y => a (y + v) • w with hg_def
    have hg_smooth : ContDiff ℝ (⊤ : ℕ∞) g :=
      (ha.comp (contDiff_id.add contDiff_const)).smul contDiff_const
    have hg_supp : HasCompactSupport g :=
      (hsupp.comp_homeomorph (Homeomorph.addRight v)).smul_right (f' := fun _ => w)
    have hg_bd : ∀ y, ‖g y‖ ≤ 1 := by
      intro y
      simp only [hg_def, norm_smul, Real.norm_eq_abs]
      calc |a (y + v)| * ‖w‖ ≤ 1 * 1 := mul_le_mul (hbd _) hw (norm_nonneg _) zero_le_one
        _ = 1 := one_mul 1
    have htrace : ∀ y, LinearMap.trace ℝ (Euclid n) (fderiv ℝ g y).toLinearMap
        = fderiv ℝ a (y + v) w := by
      intro y
      have h1 : HasFDerivAt (fun y => a (y + v)) (fderiv ℝ a (y + v)) y :=
        (hasFDerivAt_comp_add_right v).2 (hdiff (y + v)).hasFDerivAt
      rw [(h1.smul_const w).fderiv, ContinuousLinearMap.coe_smulRight,
        LinearMap.trace_smulRight]
      rfl
    simpa only [htrace] using hdiv g hg_smooth hg_supp hg_bd
  -- Step 4: fundamental theorem of calculus along `s ↦ q x + s • z`
  have hftc : ∀ x, ∫ s in (0 : ℝ)..1, h x * fderiv ℝ a (q x + s • z) z
      = h x * (a (q x + z) - a (q x)) := by
    intro x
    have hderiv : ∀ s ∈ uIcc (0 : ℝ) 1,
        HasDerivAt (fun s : ℝ => a (q x + s • z)) (fderiv ℝ a (q x + s • z) z) s := by
      intro s _
      have hline : HasDerivAt (fun s : ℝ => q x + s • z) z s := by
        simpa using ((hasDerivAt_id s).smul_const z).const_add (q x)
      exact (hdiff (q x + s • z)).hasFDerivAt.comp_hasDerivAt s hline
    have hcontS : Continuous (fun s : ℝ => fderiv ℝ a (q x + s • z) z) :=
      (hcont.comp (continuous_const.add (continuous_id.smul continuous_const))).clm_apply
        continuous_const
    rw [intervalIntegral.integral_const_mul,
      intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcontS.intervalIntegrable 0 1)]
    simp
  -- Step 5: Fubini on `Leb|(0, 1] ⊗ ν`, with integrable majorant `M‖z‖|h|`
  have hGint : Integrable (uncurry fun (s : ℝ) (x : X) => h x * fderiv ℝ a (q x + s • z) z)
      ((volume.restrict (uIoc (0 : ℝ) 1)).prod ν) := by
    have : IsFiniteMeasure (volume.restrict (uIoc (0 : ℝ) 1)) := by
      rw [uIoc_of_le zero_le_one]; infer_instance
    have hmaj : Integrable (fun p : ℝ × X => (M * ‖z‖) * |h p.2|)
        ((volume.restrict (uIoc (0 : ℝ) 1)).prod ν) :=
      (hh.abs.comp_snd _).const_mul _
    refine hmaj.mono' ?_ ?_
    · have h1 : AEStronglyMeasurable (fun p : ℝ × X => h p.2)
          ((volume.restrict (uIoc (0 : ℝ) 1)).prod ν) := hh.aestronglyMeasurable.comp_snd
      have h2 : Continuous (fun p : ℝ × Euclid n => fderiv ℝ a (p.2 + p.1 • z) z) :=
        (hcont.comp (continuous_snd.add (continuous_fst.smul continuous_const))).clm_apply
          continuous_const
      have h3 : Measurable (fun p : ℝ × X => (p.1, q p.2)) :=
        measurable_fst.prodMk (hq.comp measurable_snd)
      exact h1.mul (h2.measurable.comp h3).aestronglyMeasurable
    · filter_upwards with p
      simp only [uncurry, Real.norm_eq_abs, abs_mul]
      have hp : |fderiv ℝ a (q p.2 + p.1 • z) z| ≤ M * ‖z‖ :=
        calc |fderiv ℝ a (q p.2 + p.1 • z) z| = ‖fderiv ℝ a (q p.2 + p.1 • z) z‖ :=
              (Real.norm_eq_abs _).symm
          _ ≤ ‖fderiv ℝ a (q p.2 + p.1 • z)‖ * ‖z‖ := ContinuousLinearMap.le_opNorm _ _
          _ ≤ M * ‖z‖ := by gcongr; exact hM _
      calc |h p.2| * |fderiv ℝ a (q p.2 + p.1 • z) z| ≤ |h p.2| * (M * ‖z‖) := by gcongr
        _ = M * ‖z‖ * |h p.2| := by ring
  have heq : ∫ x, h x * (a (q x + z) - a (q x)) ∂ν
      = ∫ s in (0 : ℝ)..1, ∫ x, h x * fderiv ℝ a (q x + s • z) z ∂ν := by
    rw [intervalIntegral_integral_swap hGint]
    exact integral_congr_ae (Eventually.of_forall fun x => (hftc x).symm)
  -- Step 6: with `w = ‖z‖⁻¹ • z` (so `‖w‖ ≤ 1`, `z = ‖z‖ • w`, also for `z = 0`),
  -- `(∗)` bounds the inner integral by `Λ‖z‖` for every `s`
  set w : Euclid n := ‖z‖⁻¹ • z with hw_def
  have hw : ‖w‖ ≤ 1 := by
    by_cases hz : z = 0
    · simp [hw_def, hz]
    · rw [hw_def, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.2 hz)]
  have hzw : z = ‖z‖ • w := by
    by_cases hz : z = 0
    · simp [hz]
    · rw [hw_def, smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.2 hz), one_smul]
  have hlin : ∀ p : Euclid n, fderiv ℝ a p z = ‖z‖ * fderiv ℝ a p w := by
    intro p
    conv_lhs => rw [hzw]
    rw [map_smul, smul_eq_mul]
  have hbound : ∀ s ∈ uIoc (0 : ℝ) 1,
      ‖∫ x, h x * fderiv ℝ a (q x + s • z) z ∂ν‖ ≤ Λ * ‖z‖ := by
    intro s _
    have hrw : ∫ x, h x * fderiv ℝ a (q x + s • z) z ∂ν
        = ‖z‖ * ∫ x, h x * fderiv ℝ a (q x + s • z) w ∂ν := by
      rw [← integral_const_mul]
      congr 1
      ext x
      rw [hlin]
      ring
    rw [hrw, Real.norm_eq_abs, abs_mul, abs_norm, mul_comm Λ]
    exact mul_le_mul_of_nonneg_left (key (s • z) w hw) (norm_nonneg _)
  rw [heq]
  simpa using intervalIntegral.norm_integral_le_of_norm_le_const hbound
/-- **Ball-averaging estimate** (step 3 of the parent proof).  With `B = B_r(0)` and
`V = λ(B) ∈ (0, ∞)`, Fubini on `ν ⊗ λ⌞B` gives
`V ∫ h(x) a(q x) dν = ∫∫ h(x) a(q x + z) − ∫∫ h(x) (a(q x + z) − a(q x))`.  The second double
integral is at most `V Λ r` by the directional bound (`‖z‖ < r` on `B`), and the first at most
`(∫ |h| dν) ∫ a` since `0 ≤ ∫_B a(q x + z) dz ≤ ∫ a` by translation invariance.  Divide by `V`. -/
theorem Submission.cmr_tdn_ball_average_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ) (Λ : ℝ) (a : Euclid n → ℝ) (r : ℝ), IsFiniteMeasure ν → Measurable q → Integrable h ν → 0 ≤ Λ → Continuous a → HasCompactSupport a → (∀ y, 0 ≤ a y) → (∀ y, a y ≤ 1) → (∀ z : Euclid n, |∫ x, h x * (a (q x + z) - a (q x)) ∂ν| ≤ Λ * ‖z‖) → 0 < r → |∫ x, h x * a (q x) ∂ν| ≤ r * Λ + (volume (ball (0 : Euclid n) r)).toReal⁻¹ * (∫ x, |h x| ∂ν) * ∫ y, a y := by
  intro n X mX ν q h Λ a r hν hq hh hΛ ha ha_supp ha0 ha1 hdir hr
  -- the ball `B = B_r(0)`: measurable, inside `‖z‖ ≤ r`, of measure `λ(B) ∈ (0, ∞)`
  have hBm : MeasurableSet (ball (0 : Euclid n) r) := measurableSet_ball
  have hBr : ∀ z ∈ ball (0 : Euclid n) r, ‖z‖ ≤ r := fun z hz => (mem_ball_zero_iff.1 hz).le
  have hBpos : 0 < volume (ball (0 : Euclid n) r) := measure_ball_pos volume 0 hr
  have hBfin : volume (ball (0 : Euclid n) r) < ∞ := measure_ball_lt_top
  generalize ball (0 : Euclid n) r = B at hBm hBr hBpos hBfin ⊢
  have hV : 0 < (volume B).toReal := ENNReal.toReal_pos hBpos.ne' hBfin.ne
  have : IsFiniteMeasure (volume.restrict B) := isFiniteMeasure_restrict.2 hBfin.ne
  have hμB : (volume.restrict B).real univ = (volume B).toReal := by
    rw [measureReal_def, Measure.restrict_apply_univ]
  generalize (volume B).toReal = V at hV hμB ⊢
  -- `a` is integrable, and so are its translates
  have ha_int : Integrable a volume := ha.integrable_of_hasCompactSupport ha_supp
  -- the integrands on `ν ⊗ λ⌞B`, dominated by `|h x|`
  have hm₁ : Measurable fun p : X × Euclid n => a (q p.1 + p.2) :=
    ha.measurable.comp ((hq.comp measurable_fst).add measurable_snd)
  have hm₀ : Measurable fun p : X × Euclid n => a (q p.1) :=
    ha.measurable.comp (hq.comp measurable_fst)
  have hh₁ : AEStronglyMeasurable (fun p : X × Euclid n => h p.1) (ν.prod (volume.restrict B)) :=
    hh.aestronglyMeasurable.comp_fst
  have hdom : Integrable (fun p : X × Euclid n => |h p.1|) (ν.prod (volume.restrict B)) :=
    hh.abs.comp_fst _
  have hG₂ : Integrable (fun p : X × Euclid n => h p.1 * a (q p.1 + p.2))
      (ν.prod (volume.restrict B)) := by
    refine hdom.mono' (hh₁.mul hm₁.aestronglyMeasurable) (Eventually.of_forall fun p => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (ha0 _)]
    exact mul_le_of_le_one_right (abs_nonneg _) (ha1 _)
  have hG₁ : Integrable (fun p : X × Euclid n => h p.1 * (a (q p.1 + p.2) - a (q p.1)))
      (ν.prod (volume.restrict B)) := by
    refine hdom.mono' (hh₁.mul (hm₁.sub hm₀).aestronglyMeasurable)
      (Eventually.of_forall fun p => ?_)
    rw [Real.norm_eq_abs, abs_mul]
    refine mul_le_of_le_one_right (abs_nonneg _) (abs_sub_le_iff.2 ⟨?_, ?_⟩)
    · linarith [ha0 (q p.1), ha1 (q p.1 + p.2)]
    · linarith [ha0 (q p.1 + p.2), ha1 (q p.1)]
  -- `V F = ∫∫ h(x) a(q x + z) - ∫∫ h(x) (a(q x + z) - a(q x))` over `ν ⊗ λ⌞B`
  have hsplit : V * ∫ x, h x * a (q x) ∂ν =
      (∫ p, h p.1 * a (q p.1 + p.2) ∂(ν.prod (volume.restrict B))) -
        ∫ p, h p.1 * (a (q p.1 + p.2) - a (q p.1)) ∂(ν.prod (volume.restrict B)) := by
    rw [← integral_sub hG₂ hG₁]
    have hfun : (fun p : X × Euclid n =>
        h p.1 * a (q p.1 + p.2) - h p.1 * (a (q p.1 + p.2) - a (q p.1))) =
        fun p => h p.1 * a (q p.1) := by
      funext p
      ring
    rw [hfun, integral_fun_fst (fun x => h x * a (q x)), hμB, smul_eq_mul]
  -- Fubini and the directional bound: `|∫∫ h(x) (a(q x + z) - a(q x))| ≤ V Λ r`
  have hJ : |∫ p, h p.1 * (a (q p.1 + p.2) - a (q p.1)) ∂(ν.prod (volume.restrict B))| ≤
      V * (Λ * r) := by
    rw [integral_prod_symm _ hG₁]
    have hb : ∀ᵐ z ∂(volume.restrict B), ‖∫ x, h x * (a (q x + z) - a (q x)) ∂ν‖ ≤ Λ * r := by
      filter_upwards [ae_restrict_mem hBm] with z hz
      rw [Real.norm_eq_abs]
      exact (hdir z).trans (mul_le_mul_of_nonneg_left (hBr z hz) hΛ)
    have := norm_integral_le_of_norm_le (integrable_const (Λ * r)) hb
    rw [integral_const, hμB, smul_eq_mul, Real.norm_eq_abs] at this
    exact this
  -- translation invariance: `|∫∫ h(x) a(q x + z)| ≤ (∫ |h|) ∫ a`
  have hM : |∫ p, h p.1 * a (q p.1 + p.2) ∂(ν.prod (volume.restrict B))| ≤
      (∫ x, |h x| ∂ν) * ∫ y, a y := by
    rw [integral_prod _ hG₂]
    have hb : ∀ x, ‖∫ z, h x * a (q x + z) ∂(volume.restrict B)‖ ≤ |h x| * ∫ y, a y := by
      intro x
      rw [integral_const_mul, Real.norm_eq_abs, abs_mul]
      refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
      have h0 : 0 ≤ ∫ z, a (q x + z) ∂(volume.restrict B) := integral_nonneg fun z => ha0 _
      rw [abs_of_nonneg h0]
      exact (setIntegral_le_integral (ha_int.comp_add_left (q x))
        (Eventually.of_forall fun z => ha0 _)).trans_eq (integral_add_left_eq_self a (q x))
    have := norm_integral_le_of_norm_le (hh.abs.mul_const (∫ y, a y)) (Eventually.of_forall hb)
    rw [integral_mul_const, Real.norm_eq_abs] at this
    exact this
  -- conclusion: `V |F| ≤ (∫ |h|) ∫ a + V Λ r`, then divide by `V > 0`
  have key : V * |∫ x, h x * a (q x) ∂ν| ≤ (∫ x, |h x| ∂ν) * (∫ y, a y) + V * (Λ * r) := by
    rw [← abs_of_pos hV, ← abs_mul, abs_of_pos hV, hsplit]
    exact (abs_sub _ _).trans (add_le_add hM hJ)
  generalize ∫ x, h x * a (q x) ∂ν = F at key ⊢
  generalize ∫ x, |h x| ∂ν = H at key ⊢
  generalize ∫ y, a y = A at key ⊢
  have hV0 : V ≠ 0 := hV.ne'
  calc |F| ≤ (H * A + V * (Λ * r)) / V := by
        rw [le_div_iff₀ hV]
        linarith
    _ = r * Λ + V⁻¹ * H * A := by
        field_simp
        ring
/-- **Smooth cut-offs of a compact Lebesgue-null set** (steps 4 and 5(ii) of the parent proof).
With `δₖ = 1/(k+1)`, take `aₖ` smooth with values in `[0, 1]`, support `thickening δₖ K`, and
`aₖ = 1` exactly on `K` (`exists_contDiff_support_eq_eq_one_iff`).  Then `aₖ` vanishes off the
compact `cthickening δₖ K`; a point `y ∉ K = ⋂_{δ>0} cthickening δ K` misses some
`cthickening δ K`, so `aₖ(y) = 0` once `δₖ < δ`; and `0 ≤ ∫ aₖ ≤ λ(cthickening δₖ K) → λ(K) = 0`. -/
theorem Submission.cmr_tdn_null_set_cutoffs : ∀ (n : ℕ) (K : Set (Euclid n)), IsCompact K → volume K = 0 → ∃ a : ℕ → Euclid n → ℝ, (∀ k, ContDiff ℝ (⊤ : ℕ∞) (a k)) ∧ (∀ k, HasCompactSupport (a k)) ∧ (∀ k y, 0 ≤ a k y) ∧ (∀ k y, a k y ≤ 1) ∧ (∀ k, ∀ y ∈ K, a k y = 1) ∧ (∀ y, y ∉ K → ∀ᶠ k in atTop, a k y = 0) ∧ Tendsto (fun k => ∫ y, a k y) atTop (𝓝 0) := by
  intro n K hK hK0
  -- `aₖ`: smooth, `[0, 1]`-valued, with support `thickening δₖ K` and `aₖ = 1` exactly on `K`
  have hδ : ∀ k : ℕ, (0 : ℝ) < 1 / ((k : ℝ) + 1) := fun k => by positivity
  have hex : ∀ k : ℕ, ∃ f : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) f ∧ range f ⊆ Icc 0 1 ∧
      support f = thickening (1 / ((k : ℝ) + 1)) K ∧ ∀ x, x ∈ K ↔ f x = 1 := fun k =>
    exists_contDiff_support_eq_eq_one_iff isOpen_thickening hK.isClosed
      (self_subset_thickening (hδ k) K)
  choose a ha_smooth ha_range ha_supp ha_one using hex
  have hnonneg : ∀ k y, 0 ≤ a k y := fun k y => (ha_range k (mem_range_self y)).1
  have hle : ∀ k y, a k y ≤ 1 := fun k y => (ha_range k (mem_range_self y)).2
  -- `aₖ` vanishes off the compact `cthickening δₖ K`
  have hzero : ∀ (k : ℕ) y, y ∉ cthickening (1 / ((k : ℝ) + 1)) K → a k y = 0 := by
    intro k y hy
    by_contra h
    have hy' : y ∈ support (a k) := h
    rw [ha_supp k] at hy'
    exact hy (thickening_subset_cthickening _ _ hy')
  refine ⟨a, ha_smooth, fun k => HasCompactSupport.intro hK.cthickening (hzero k), hnonneg, hle,
    fun k y hy => (ha_one k y).1 hy, ?_, ?_⟩
  · -- `y ∉ K = ⋂_{δ>0} cthickening δ K`, so `y ∉ cthickening δ K ⊇ cthickening δₖ K` for some
    -- `δ > 0` and all `k` with `δₖ < δ`
    intro y hy
    rw [← hK.isClosed.closure_eq, closure_eq_iInter_cthickening] at hy
    simp only [mem_iInter, not_forall] at hy
    obtain ⟨δ, hδpos, hyδ⟩ := hy
    obtain ⟨k₀, hk₀⟩ := exists_nat_one_div_lt hδpos
    filter_upwards [eventually_ge_atTop k₀] with k hk
    refine hzero k y fun hmem => hyδ (cthickening_mono ?_ K hmem)
    have hkk₀ : 1 / ((k : ℝ) + 1) ≤ 1 / ((k₀ : ℝ) + 1) :=
      one_div_le_one_div_of_le (by positivity) (by exact_mod_cast Nat.add_le_add_right hk 1)
    linarith
  · -- `0 ≤ ∫ aₖ ≤ λ(cthickening δₖ K)`, and `λ(cthickening δₖ K) → λ(K) = 0`
    have hmeas : Tendsto (fun k : ℕ => (volume (cthickening (1 / ((k : ℝ) + 1)) K)).toReal)
        atTop (𝓝 0) := by
      have h := (tendsto_measure_cthickening_of_isCompact (μ := (volume : Measure (Euclid n)))
        hK).comp tendsto_one_div_add_atTop_nhds_zero_nat
      rw [hK0] at h
      simpa [Function.comp_def] using (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hmeas
      (fun k => integral_nonneg (hnonneg k)) fun k => ?_
    set C := cthickening (1 / ((k : ℝ) + 1)) K
    have hCm : MeasurableSet C := isClosed_cthickening.measurableSet
    have hint : Integrable (C.indicator fun _ => (1 : ℝ)) volume :=
      (integrable_indicator_iff hCm).2 (integrableOn_const hK.cthickening.measure_lt_top.ne)
    have hind : ∀ y, a k y ≤ C.indicator (fun _ => (1 : ℝ)) y := by
      intro y
      by_cases hy : y ∈ C
      · rw [indicator_of_mem hy]
        exact hle k y
      · rw [indicator_of_notMem hy, hzero k y hy]
    calc ∫ y, a k y ≤ ∫ y, C.indicator (fun _ => (1 : ℝ)) y :=
          integral_mono_of_nonneg (Eventually.of_forall (hnonneg k)) hint
            (Eventually.of_forall hind)
      _ = (volume C).toReal := by
          rw [integral_indicator_const _ hCm]
          simp [measureReal_def]

/-- **Vanishing on compact null sets from an `ε + C ∫ a` bound** (steps 5(i) and 6 of the
top-dimensional null-set argument): let `q : X → ℝⁿ` be measurable and `h ∈ L¹(ν)` (`ν` need not
be finite), and suppose that for every `ε > 0` there is `C` with `|∫ h · a(q) dν| ≤ ε + C ∫ a`
for all smooth compactly supported `0 ≤ a ≤ 1`.  Then `∫_{q⁻¹K} h dν = 0` for every compact
Lebesgue-null `K ⊆ ℝⁿ`.  Along the cut-offs `a_k` of `K` given by
`Submission.cmr_tdn_null_set_cutoffs`, dominated convergence (majorant `|h|`) gives
`∫ h · a_k(q) dν → ∫_{q⁻¹K} h dν`, while `ε + C ∫ a_k → ε`; so `|∫_{q⁻¹K} h dν| ≤ ε` for every
`ε > 0`. -/
theorem Submission.cmr_tdn_null_of_average_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ), Measurable q → Integrable h ν → (∀ ε : ℝ, 0 < ε → ∃ C : ℝ, ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → (∀ y, 0 ≤ a y) → (∀ y, a y ≤ 1) → |∫ x, h x * a (q x) ∂ν| ≤ ε + C * ∫ y, a y) → ∀ K : Set (Euclid n), IsCompact K → volume K = 0 → ∫ x in q ⁻¹' K, h x ∂ν = 0 := by
  intro n X _ ν q h hq hh hbd K hK hK0
  -- smooth cut-offs `a k` of `K`: `a k = 1` on `K`, `a k → 0` pointwise off `K`, `∫ a k → 0`
  obtain ⟨a, ha, hac, ha0, ha1, haK, haoff, haint⟩ :=
    Submission.cmr_tdn_null_set_cutoffs n K hK hK0
  -- dominated convergence with majorant `|h|`: `∫ h (a k ∘ q) dν → ∫ 1_{q⁻¹K} h dν`
  have hE : MeasurableSet (q ⁻¹' K) := hq hK.isClosed.measurableSet
  have hlim : Tendsto (fun k => ∫ x, h x * a k (q x) ∂ν) atTop
      (𝓝 (∫ x in q ⁻¹' K, h x ∂ν)) := by
    rw [← integral_indicator hE]
    refine tendsto_integral_of_dominated_convergence (fun x => |h x|)
      (fun k => hh.aestronglyMeasurable.mul
        ((ha k).continuous.measurable.comp hq).aestronglyMeasurable)
      hh.abs (fun k => Eventually.of_forall fun x => ?_) (Eventually.of_forall fun x => ?_)
    · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (ha0 k (q x))]
      exact mul_le_of_le_one_right (abs_nonneg _) (ha1 k (q x))
    · by_cases hx : q x ∈ K
      · have h1 : ∀ k, a k (q x) = 1 := fun k => haK k (q x) hx
        simp only [indicator_of_mem (show x ∈ q ⁻¹' K from hx), h1, mul_one]
        exact tendsto_const_nhds
      · rw [indicator_of_notMem (show x ∉ q ⁻¹' K from hx)]
        refine tendsto_nhds_of_eventually_eq ?_
        filter_upwards [haoff (q x) hx] with k hk
        rw [hk, mul_zero]
  -- for `ε > 0`: `|∫ h (a k ∘ q) dν| ≤ ε + C ∫ a k → ε`, so `|∫_{q⁻¹K} h dν| ≤ ε`
  refine abs_nonpos_iff.1 (le_of_forall_pos_le_add fun ε hε => ?_)
  obtain ⟨C, hC⟩ := hbd ε hε
  have hR : Tendsto (fun k => ε + C * ∫ y, a k y) atTop (𝓝 (ε + C * 0)) :=
    tendsto_const_nhds.add (haint.const_mul C)
  rw [mul_zero, add_zero] at hR
  rw [zero_add]
  exact le_of_tendsto_of_tendsto' hlim.abs hR fun k => hC (a k) (ha k) (hac k) (ha0 k) (ha1 k)

/-- **Lemma TD for `m = q_#(h ν)`** (top-dimensional step of the absolute continuity of normal
currents, Simon Ch. 6, 2.36): if `|∫ h · div g(q) dν| ≤ Λ` for all smooth compactly supported
fields `g` with `‖g‖ ≤ 1`, then `∫_{q⁻¹K} h dν = 0` for every compact Lebesgue-null `K ⊆ ℝⁿ`.
Testing with `g = 0` gives `Λ ≥ 0`, and `Submission.cmr_tdn_directional_bound` gives
`|∫ h (a(q + z) − a(q)) dν| ≤ Λ‖z‖` for smooth compactly supported `|a| ≤ 1`.  For `ε > 0`,
averaging over `B_r` with `rΛ ≤ ε` (`Submission.cmr_tdn_ball_average_bound`) gives
`|∫ h a(q) dν| ≤ ε + |B_r|⁻¹ ‖h‖₁ ∫ a` for smooth compactly supported `0 ≤ a ≤ 1`, and
`Submission.cmr_tdn_null_of_average_bound` turns these bounds into the claim. -/
theorem Submission.cmr_null_of_div_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ) (Λ : ℝ), IsFiniteMeasure ν → Measurable q → Integrable h ν → (∀ g : Euclid n → Euclid n, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → (∀ y, ‖g y‖ ≤ 1) → |∫ x, h x * LinearMap.trace ℝ (Euclid n) (fderiv ℝ g (q x)).toLinearMap ∂ν| ≤ Λ) → ∀ K : Set (Euclid n), IsCompact K → volume K = 0 → ∫ x in q ⁻¹' K, h x ∂ν = 0 := by
  intro n X _ ν q h Λ hν hq hh hdiv
  -- `Λ ≥ 0`: the field `g = 0` has divergence `0`
  have hΛ : 0 ≤ Λ := by
    simpa using hdiv (fun _ => 0) contDiff_const HasCompactSupport.zero fun _ => by simp
  -- the translation estimate `|∫ h (a(q + z) − a(q)) dν| ≤ Λ‖z‖`
  have hdir := Submission.cmr_tdn_directional_bound n X ν q h Λ hν hq hh hdiv
  refine Submission.cmr_tdn_null_of_average_bound n X ν q h hq hh fun ε hε => ?_
  -- average over `B_r` with `r = ε / (Λ + 1)`, so that `rΛ ≤ ε`
  obtain ⟨r, hr, hrΛ⟩ : ∃ r : ℝ, 0 < r ∧ r * Λ ≤ ε := by
    refine ⟨ε / (Λ + 1), div_pos hε (by linarith), ?_⟩
    rw [div_mul_eq_mul_div, div_le_iff₀ (by linarith)]
    nlinarith
  refine ⟨(volume (ball (0 : Euclid n) r)).toReal⁻¹ * ∫ x, |h x| ∂ν, fun a ha hac ha0 ha1 => ?_⟩
  have hB := Submission.cmr_tdn_ball_average_bound n X ν q h Λ a r hν hq hh hΛ ha.continuous hac
    ha0 ha1 (hdir a ha hac fun y => abs_le.2 ⟨by linarith [ha0 y], ha1 y⟩) hr
  linarith

/-- **Simon 6.2.36** (`μ_T` charges no `Hⁿ`-null set when `M_W(∂T) < ∞` for `W ⊂⊂ U`): if
`T(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|⟨α, ξ⟩| ≤ |α|`, `M_W(T) = μ(W)` and `μ` lives on `U`, then
`Hⁿ(E) = 0` implies `μ(E) = 0`.  For `n = 0`, `H⁰` is counting measure, so `E = ∅`.  For
`n = m + 1` it suffices to treat a compact `Hⁿ`-null `C ⊆ U`; take an open `W ⊂⊂ U` around `C`.
For each strictly increasing `I`, the coordinate projection `q_I` maps `C` onto a compact
Lebesgue-null `N ⊆ ℝⁿ`, and the coordinate divergence forms give
`|∫ b ⟨θ_I, ξ⟩ div g(q_I) dμ⌞W| ≤ K_b (M_W(∂T) + M_W(T))` uniformly in `‖g‖ ≤ 1`.  Hence
`⟨θ_I, ξ⟩ = 0` `μ`-a.e. on `W ∩ q_I⁻¹(N) ⊇ C`; the coordinate covectors `θ_I` determine `ξ`, so
`ξ = 0` `μ`-a.e. on `C`, and `M_W(T) = μ(W)` forces `μ(C) = 0`. -/
theorem Submission.cmr_null_of_representation : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → μ Uᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0 := by
  intro P n U T μ ξ hU hB hUc hK hmass hξm hξ hT
  -- Step 9: it suffices to treat compact `Hⁿ`-null subsets of `U`
  refine Submission.cmr_null_of_compact_null P U μ μHE[n] hU hUc hK ?_
  intro C hC hCU hC0
  cases n with
  | zero =>
    -- Step 1: `H⁰` is counting measure, so `C = ∅`
    rw [Measure.euclideanHausdorffMeasure_zero] at hC0
    have hCe : C = ∅ := eq_empty_of_forall_notMem fun x hx => by
      simpa [hC0] using measure_mono (μ := (μH[0] : Measure (Euclid P))) (singleton_subset_iff.2 hx)
    rw [hCe, measure_empty]
  | succ m =>
    -- Step 2: an open `W ⊂⊂ U` around `C`, of finite mass and boundary mass
    obtain ⟨δ, hδ, hδU⟩ := hC.exists_cthickening_subset_open hU hCU
    have hWo : IsOpen (thickening δ C) := isOpen_thickening
    have hCW : C ⊆ thickening δ C := self_subset_thickening hδ C
    have hWcl : closure (thickening δ C) ⊆ cthickening δ C :=
      closure_thickening_subset_cthickening δ C
    have hWc : CompactlyContained (thickening δ C) U :=
      ⟨hC.cthickening.of_isClosed_subset isClosed_closure hWcl, hWcl.trans hδU⟩
    have hWU : thickening δ C ⊆ U := subset_closure.trans hWc.2
    have hμW : μ (thickening δ C) < ∞ :=
      (measure_mono subset_closure).trans_lt (hK _ hWc.1 hWc.2)
    have hTW : T.massOn (thickening δ C) = μ (thickening δ C) := hmass _ hWo
    have hTW' : T.massOn (thickening δ C) ≠ ∞ := by rw [hTW]; exact hμW.ne
    have hbd : T.boundary.massOn (thickening δ C) ≠ ∞ := (hB _ hWo hWc).ne
    -- Steps 3–6: `⟨θ_I, ξ⟩ = 0` `μ`-a.e. on `C` for each coordinate covector `θ_I`
    obtain ⟨hθex, hspan⟩ := Submission.cmr_coordinate_covectors_span P (m + 1)
    choose θI hθI using hθex
    have hcoord : ∀ I : Fin (m + 1) → Fin P, StrictMono I →
        ∀ᵐ x ∂μ, x ∈ C → ξ x (θI I) = 0 := by
      intro I hI
      set q : Euclid P → Euclid (m + 1) := fun x => WithLp.toLp 2 (fun k => x (I k))
      have hqc : Continuous q := by fun_prop
      have hN : IsCompact (q '' C) := hC.image hqc
      have hNv : volume (q '' C) = 0 :=
        Submission.cmr_volume_coordProj_image_null P (m + 1) I C hI.injective hC0
      have h := Submission.cmr_ae_zero_of_div_bounds P (m + 1) (thickening δ C) μ
        (fun x => ξ x (θI I)) q (q '' C) (covectorEuclideanNorm (θI I)) hWo hμW
        (hξm.apply_continuousLinearMap _) (fun x => hξ x _) hqc.measurable hN.measurableSet
        (fun ν h Λ hν hh hΛ => Submission.cmr_null_of_div_bound (m + 1) (Euclid P) ν q h Λ hν
          hqc.measurable hh hΛ (q '' C) hN hNv) ?_
      · filter_upwards [h] with x hx hxC
        exact hx (hCW hxC) (mem_image_of_mem q hxC)
      · -- Step 4: the divergence bound, uniformly in `g`
        intro b hb hbc hbW
        obtain ⟨K, hK⟩ :=
          Submission.cmr_coordinate_divergence_form P m I (θI I) b hI (hθI I) hb hbc
        refine ⟨K * ((T.boundary.massOn (thickening δ C)).toReal +
          (T.massOn (thickening δ C)).toReal), fun g hg _ hg1 => ?_⟩
        obtain ⟨η, ζ, hη, hζ, hηb, hζb, hηK, hζK, hd⟩ := hK g hg hg1
        exact Submission.cmr_abs_integral_div_le_mass P m U (thickening δ C) T μ ξ (θI I) b
          (fun x => LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g (q x)).toLinearMap) η ζ K
          hWU hTW' hbd hT (fun k S ω r => Submission.cmr_abs_apply_le_massOn P k U _ S ω r)
          hbW hη hζ hηb hζb hηK hζK hd
    -- Step 7: the coordinate covectors determine `ξ`, so `ξ = 0` `μ`-a.e. on `C`
    have hξC : ∀ᵐ x ∂μ, x ∈ C → ξ x = 0 := by
      have hall : ∀ᵐ x ∂μ, ∀ I : Fin (m + 1) → Fin P, StrictMono I → x ∈ C →
          ξ x (θI I) = 0 := by
        rw [ae_all_iff]
        intro I
        by_cases hI : StrictMono I
        · filter_upwards [hcoord I hI] with x hx _ using hx
        · exact ae_of_all _ fun x h => absurd h hI
      filter_upwards [hall] with x hx hxC
      refine hspan (ξ x) fun I θ hI hθ => ?_
      rw [show θ = θI I from ContinuousAlternatingMap.ext fun v => by rw [hθ, hθI]]
      exact hx I hI hxC
    -- Step 8: `M_W(T) = μ(W)` and `ξ = 0` a.e. on `C` force `μ(C) = 0`
    exact Submission.cmr_measure_null_of_orient_ae_zero P (m + 1) U (thickening δ C) C T μ ξ
      hWo.measurableSet hC.measurableSet hCW hμW hTW hξ hT hξC

/-- **The mass measure and orientation of a current of locally finite mass** (Simon Ch. 6,
2.7–2.8, with the absolute continuity 2.36; `|·|` is `covectorEuclideanNorm`).  Part I is the
Riesz representation `Submission.cmr_exists_massRepresentation_core`.  It gives a Borel measure
`μ = μ_T` with `μ(ℝᴾ ∖ U) = 0`, `μ` finite on compact subsets of `U` and `μ(W) = M_W(T)` for open
`W`, and an a.e. strongly measurable field `ξ` of `n`-vectors with `|⟨α, ξ(x)⟩| ≤ |α|` and
`T(ω) = ∫ ⟨ω, ξ⟩ dμ`.  Part II is `Submission.cmr_null_of_representation`, Simon's projection
argument.  If moreover `M_W(∂T) < ∞` for every open `W ⊂⊂ U`, every such pair `(μ, ξ)` satisfies
`μ(E) = 0` whenever `Hⁿ(E) = 0`. -/
theorem Submission.cmc_exists_massRepresentation : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0) := by
  intro P n U T hU hmass
  -- Part I (Simon 6.2.7–2.8): `T = ξ μ` with `μ(W) = M_W(T)` for every open `W`
  obtain ⟨μ, ξ, hμU, hμK, hμW, hξm, hξ1, hTξ⟩ :=
    Submission.cmr_exists_massRepresentation_core P n U T hU hmass
  refine ⟨μ, ξ, hμU, hμK, hμW, hξm, hξ1, hTξ, fun hbd => ?_⟩
  -- Part II (Simon 6.2.36): if also `M_W(∂T) < ∞` for all open `W ⊂⊂ U`, then `μ ≪ Hⁿ`
  exact Submission.cmr_null_of_representation P n U T μ ξ hU hbd hμU hμK hμW hξm hξ1 hTξ

/-- A `0`-current minimizing in `U` vanishes (Simon 7.1.1 with `n = 0`, where `∂S = ∂T` is
vacuous).  Write `T = τ(M, θ, ξ)` and suppose `p ∈ M`; choose `B̄_r(p) ⊆ U` and `W = B_r(p)`.
Deleting `p` gives the integer multiplicity competitor
`S = T − θ(p) ⟨·(p), ξ(p)⟩ = τ(M ∖ {p}, θ, ξ)` with `spt(S − T) ⊆ {p}`.  By
`cmc_massOn_eq_imRep_measure`, `M_W(T) = M_W(S) + θ(p)` with `M_W(S) ≤ ∫_{M ∩ B̄_r(p)} θ dH⁰ < ∞`,
so `θ(p) ≥ 1` contradicts minimality.  Hence `M = ∅` and `T = 0`. -/
theorem Submission.cmc_zeroDim_minimizing_eq_zero : ∀ (P : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U 0), IsOpen U → IsMinimizingIn T U → T = 0 := by
  intro P U T hU hmin
  obtain ⟨R, hR⟩ := hmin.1
  -- deleting any `p ∈ M` would decrease `M_W(T)`, so `M = ∅`
  have hempty : R.carrier = ∅ := by
    refine Set.eq_empty_iff_forall_notMem.2 fun p hp => ?_
    -- `W = B_r(p)` with `B̄_r(p) ⊆ U`, so `W ⊂⊂ U`
    obtain ⟨r, hr, hrU⟩ :=
      Metric.nhds_basis_closedBall.mem_iff.1 (hU.mem_nhds (R.carrier_subset hp))
    have hW : CompactlyContained (ball p r) U :=
      ⟨(isCompact_closedBall p r).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall, closure_ball_subset_closedBall.trans hrU⟩
    -- `R' = (M ∖ {p}, θ, ξ)`: `μ_R = μ_{R'} + θ(p) δ_p` and `τ_R = τ_{R'} + θ(p) ⟨·(p), ξ(p)⟩`
    obtain ⟨R', -, -, -, hmeas, hact⟩ := Submission.dtc_dim_zero_erase_point P U R p hp
    -- the point current `X(ω) = θ(p) ⟨ω(p), ξ(p)⟩`, with `spt X ⊆ {p}`
    obtain ⟨X, hX, hXspt⟩ :=
      Submission.dtc_point_current P 0 U p ((R.mult p : ℝ) • R.orient p) hU
    -- the competitor `S = T − X` is represented by `R'`
    have hS : R'.Represents (T - X) := fun ω => by
      show T ω - X ω = _
      rw [hR ω, hX ω, hact ω, smul_apply, smul_eq_mul, add_sub_cancel_right]
    -- `S − T = −X` vanishes wherever `X` does, so `spt(S − T) ⊆ spt X ⊆ {p}`
    have hspt : (T - X - T).support ⊆ {p} := by
      refine fun x hx => hXspt ⟨hx.1, fun hxX => hx.2 ?_⟩
      obtain ⟨V, ⟨hVo, hVc, hVU, hXV⟩, hxV⟩ := hxX
      refine ⟨V, ⟨hVo, hVc, hVU, fun ω hω => ?_⟩, hxV⟩
      show T ω - X ω - T ω = 0
      rw [hXV ω hω, sub_zero, sub_self]
    have hle := hmin.2 (ball p r) (T - X) isOpen_ball hW ⟨R', hS⟩ trivial
      ((Set.finite_singleton p).subset hspt).isCompact
      (hspt.trans (Set.singleton_subset_iff.2 ⟨R.carrier_subset hp, mem_ball_self hr⟩))
    -- `μ_{R'}(W) ≤ μ_R(B̄_r(p)) = ∫_{M ∩ B̄_r(p)} θ dH⁰ < ∞`
    have hfin : R'.measure (ball p r) ≠ ∞ := by
      refine ne_top_of_le_ne_top ?_ (calc
        R'.measure (ball p r) ≤ R'.measure (closedBall p r) := measure_mono ball_subset_closedBall
        _ ≤ R'.measure (closedBall p r) + ((R.mult p : ℝ≥0∞) • Measure.dirac p) (closedBall p r) :=
          le_self_add
        _ = R.measure (closedBall p r) := by rw [hmeas, Measure.add_apply])
      rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
        Measure.restrict_restrict measurableSet_closedBall, Set.inter_comm]
      exact R.locallyIntegrable_mult _ (isCompact_closedBall p r) hrU
    -- `M_W(T) = μ_{R'}(W) + θ(p)` and `M_W(S) = μ_{R'}(W)`, so `θ(p) = 0`
    rw [Submission.cmc_massOn_eq_imRep_measure P 0 U T R hU hR (ball p r) isOpen_ball,
      Submission.cmc_massOn_eq_imRep_measure P 0 U (T - X) R' hU hS (ball p r) isOpen_ball,
      hmeas, Measure.add_apply, Measure.smul_apply, Measure.dirac_apply_of_mem (mem_ball_self hr),
      smul_eq_mul, mul_one] at hle
    have h0 : (R.mult p : ℝ≥0∞) ≤ 0 := ENNReal.le_of_add_le_add_left hfin (by rwa [add_zero])
    exact (R.mult_pos p hp).ne' (by exact_mod_cast nonpos_iff_eq_zero.1 h0)
  -- `T(ω) = ∫_∅ θ ⟨ω, ξ⟩ dH⁰ = 0`
  ext ω
  rw [hR ω, GeometricCurrentOn.zero_apply, IMRep.action, hempty, Measure.restrict_empty,
    integral_zero_measure]
/-- **Convergence of superlevel-set measures at almost every level** (the "standard
approximation argument" ending Simon's proof of 7.2.4, from (13) and (14)).  Let `μ` be finite
on compact subsets of `U`, with `limsup μⱼ(K) ≤ μ(K)` for compact `K ⊆ U` and
`μ(G) ≤ liminf μⱼ(G)` for open `G ⊆ U`.  If `g` is continuous with compact support in `U`,
then `μⱼ{g > t} → μ{g > t}` for a.e. `t > 0`.  Only countably many levels `{g = t}` carry
positive mass for the finite measure `μ⌞tsupport g`.  For any other `t > 0`, `{g > t}` is open,
`{g ≥ t}` is compact, both lie in `tsupport g ⊆ U`, and they have the same `μ`-measure. -/
theorem Submission.cmc_rcc_ae_tendsto_measure_superlevel : ∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs j G) atTop) → ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → tsupport g ⊆ U → ∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), Tendsto (fun j => μs j {x | t < g x}) atTop (𝓝 (μ {x | t < g x})) := by
  intro P U μs μ hfin hsup hinf g hg hgc hgU
  -- step 1: `μ⌞tsupport g` is a finite measure
  have : IsFiniteMeasure (μ.restrict (tsupport g)) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hfin _ hgc.isCompact hgU⟩
  -- step 2: only countably many levels `{g = s}` have positive `μ⌞tsupport g`-measure
  have hD := Measure.countable_meas_level_set_pos (μ := μ.restrict (tsupport g)) hg.measurable
  -- step 3: a.e. `t` is positive and outside that countable set
  filter_upwards [hD.ae_notMem _, ae_restrict_mem measurableSet_Ioi] with t htD ht
  have ht0 : (0 : ℝ) < t := ht
  -- step 4: `G = {g > t}` is open, `K = {g ≥ t}` is compact, `G ⊆ K ⊆ tsupport g ⊆ U`
  have hKC : {x | t ≤ g x} ⊆ tsupport g := fun x (hx : t ≤ g x) =>
    subset_tsupport g (show g x ≠ 0 from (ht0.trans_le hx).ne')
  have hGK : {x | t < g x} ⊆ {x | t ≤ g x} := fun x (hx : t < g x) => hx.le
  have hGo : IsOpen {x | t < g x} := isOpen_lt continuous_const hg
  have hKc : IsCompact {x | t ≤ g x} :=
    hgc.isCompact.of_isClosed_subset (isClosed_le continuous_const hg) hKC
  -- step 5: `μ K = μ G`, because `K \ G = {g = t}` is `μ`-null
  have hLC : {x | g x = t} ⊆ tsupport g := fun x (hx : g x = t) =>
    subset_tsupport g (show g x ≠ 0 by rw [hx]; exact ht0.ne')
  have hlev : μ {x | g x = t} = 0 := by
    rw [← Measure.restrict_eq_self μ hLC]
    exact nonpos_iff_eq_zero.1 (not_lt.1 htD)
  have hKG : μ {x | t ≤ g x} = μ {x | t < g x} := by
    refine le_antisymm ?_ (measure_mono hGK)
    calc μ {x | t ≤ g x} ≤ μ ({x | t < g x} ∪ {x | g x = t}) :=
          measure_mono fun x (hx : t ≤ g x) => hx.lt_or_eq.imp id Eq.symm
      _ ≤ μ {x | t < g x} + μ {x | g x = t} := measure_union_le _ _
      _ = μ {x | t < g x} := by rw [hlev, add_zero]
  -- step 6: squeeze `limsup μⱼ G ≤ limsup μⱼ K ≤ μ K = μ G ≤ liminf μⱼ G`
  refine tendsto_of_le_liminf_of_limsup_le (hinf _ hGo (hGK.trans (hKC.trans hgU))) ?_
  calc limsup (fun j => μs j {x | t < g x}) atTop
      ≤ limsup (fun j => μs j {x | t ≤ g x}) atTop :=
        limsup_le_limsup (Eventually.of_forall fun j => measure_mono hGK)
    _ ≤ μ {x | t ≤ g x} := hsup _ hKc (hKC.trans hgU)
    _ = μ {x | t < g x} := hKG
/-- **Layer-cake convergence** (the "standard approximation argument" ending Simon's proof of
7.2.4, chapter-07.txt lines 284–289).  Let `g ≥ 0` be continuous with compact support,
`C = tsupport g`, `μ(C) < ∞` and `limsup_j μ_j(C) < ∞`.  If `μ_j{g > t} → μ{g > t}` for a.e.
`t > 0`, then `∫ g dμ_j → ∫ g dμ`.  For `ν(C) < ∞`, `g` is `ν`-integrable and
`∫ g dν = ∫_{(0,∞)} ν{g > t} dt` (layer cake).  Pick `Λ` with `limsup_j μ_j(C) < Λ < ∞`; for
large `j` the distribution functions are dominated by `Λ·1_{t ≤ b}` (`g ≤ b`), so dominated
convergence applies. -/
theorem Submission.cmc_rcc_tendsto_integral_of_ae_tendsto_superlevel : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)) (g : Euclid P → ℝ), Continuous g → HasCompactSupport g → (∀ x, 0 ≤ g x) → μ (tsupport g) < ∞ → limsup (fun j => μs j (tsupport g)) atTop < ∞ → (∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), Tendsto (fun j => μs j {x | t < g x}) atTop (𝓝 (μ {x | t < g x}))) → Tendsto (fun j => ∫ x, g x ∂(μs j)) atTop (𝓝 (∫ x, g x ∂μ)) := by
  intro P μs μ g hg hgc hg0 hμ hlim hae
  -- `g ≤ ‖g‖ ≤ b`
  obtain ⟨b, hb⟩ := hg.bounded_above_of_compact_support hgc
  -- `μ_j(C) < Λ < ∞` for all large `j`
  obtain ⟨Λ, hΛ, hΛtop⟩ := exists_between hlim
  have hev : ∀ᶠ j in atTop, μs j (tsupport g) < Λ := eventually_lt_of_limsup_lt hΛ
  -- layer cake for every `ν` with `ν(C) < ∞`, for which `g` is integrable
  have hlc : ∀ ν : Measure (Euclid P), ν (tsupport g) < ∞ →
      ∫ x, g x ∂ν = ∫ t in Ioi 0, ν.real {x | t < g x} := fun ν hν =>
    ((integrableOn_iff_integrable_of_support_subset (subset_tsupport g)).mp
      (hg.continuousOn.integrableOn_of_subset_isCompact hgc (isClosed_tsupport g).measurableSet
        subset_rfl hν.ne)).integral_eq_integral_meas_lt (Eventually.of_forall hg0)
  -- `{g > t} ⊆ C` for `t > 0`
  have hsub : ∀ t : ℝ, 0 < t → {x | t < g x} ⊆ tsupport g := fun t ht x hx =>
    subset_tsupport g (ht.trans (show t < g x from hx)).ne'
  rw [hlc μ hμ]
  refine Tendsto.congr' (f₁ := fun j => ∫ t in Ioi 0, (μs j).real {x | t < g x}) ?_ ?_
  · filter_upwards [hev] with j hj
    exact (hlc (μs j) (hj.trans hΛtop)).symm
  -- dominated convergence with the bound `Λ·1_{(-∞, b]}`
  refine tendsto_integral_filter_of_dominated_convergence (indicator (Iic b) fun _ => Λ.toReal)
    ?_ ?_ ?_ ?_
  · refine Eventually.of_forall fun j => ?_
    have hanti : Antitone fun t : ℝ => μs j {x | t < g x} := fun s t hst =>
      measure_mono fun x hx => lt_of_le_of_lt hst hx
    exact hanti.measurable.ennreal_toReal.aestronglyMeasurable
  · filter_upwards [hev] with j hj
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    rw [Real.norm_eq_abs, abs_of_nonneg measureReal_nonneg]
    by_cases htb : t ≤ b
    · rw [indicator_of_mem (show t ∈ Iic b from htb)]
      exact ENNReal.toReal_mono hΛtop.ne ((measure_mono (hsub t ht)).trans hj.le)
    · have hempty : {x | t < g x} = ∅ := eq_empty_of_forall_notMem fun x hx =>
        htb (((show t < g x from hx).le.trans (Real.le_norm_self _)).trans (hb x))
      rw [hempty, measureReal_empty, indicator_of_notMem (show t ∉ Iic b from htb)]
  · rw [integrable_indicator_iff measurableSet_Iic]
    refine integrableOn_const ?_
    rw [Measure.restrict_apply measurableSet_Iic]
    exact ((measure_mono fun t ht => ⟨ht.2, ht.1⟩ :
      volume (Iic b ∩ Ioi 0) ≤ volume (Ioc 0 b)).trans_lt measure_Ioc_lt_top).ne
  · filter_upwards [hae, ae_restrict_mem measurableSet_Ioi] with t ht htpos
    exact (ENNReal.tendsto_toReal ((measure_mono (hsub t htpos)).trans_lt hμ).ne).comp ht

/-- **Simon 7.2.4** (proof, last sentence: from (13) and (14) "it now easily follows (by a
standard approximation argument) that `∫ f dμ_{Tⱼ} → ∫ f dμ_T`"): if `μ(K) < ∞` and
`limsup_j μ_j(K) ≤ μ(K)` for compact `K ⊆ U`, and `μ(G) ≤ liminf_j μ_j(G)` for open `G ⊆ U`, then
`∫ f dμ_j → ∫ f dμ` for every continuous `f` with compact support in `U`.  Split `f = f⁺ − f⁻`;
for each part the superlevel-set measures converge at a.e. level
(`cmc_rcc_ae_tendsto_measure_superlevel`), hence so do the integrals (layer cake and dominated
convergence, `cmc_rcc_tendsto_integral_of_ae_tendsto_superlevel`). -/
theorem Submission.cmc_tendsto_integral_of_limsup_liminf : ∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs j G) atTop) → ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(μs j)) atTop (𝓝 (∫ x, f x ∂μ)) := by
  intro P U μs μ hfin hsup hinf f hf hfc hfU
  -- Step 1: `C = spt f` is compact and `C ⊆ U`, so `μ(C) < ∞` and `limsup_j μ_j(C) < ∞`;
  -- hence `μ_j(C) < ∞` for all large `j`
  have hμC : μ (tsupport f) < ∞ := hfin _ hfc hfU
  have hlimC : limsup (fun j => μs j (tsupport f)) atTop < ∞ := (hsup _ hfc hfU).trans_lt hμC
  have hμsC : ∀ᶠ j in atTop, μs j (tsupport f) < ∞ := eventually_lt_of_limsup_lt hlimC
  -- a continuous function vanishing outside `C` is `ν`-integrable whenever `ν(C) < ∞`
  have hint : ∀ (ν : Measure (Euclid P)) (g : Euclid P → ℝ), ν (tsupport f) < ∞ → Continuous g →
      support g ⊆ support f → Integrable g ν := by
    intro ν g hν hg hgf
    have : IsFiniteMeasure (ν.restrict (tsupport f)) := ⟨by rwa [Measure.restrict_apply_univ]⟩
    exact (integrableOn_iff_integrable_of_support_subset (hgf.trans (subset_tsupport f))).1
      (hg.integrable_of_hasCompactSupport (hfc.mono hgf))
  -- Steps 3–5: for continuous `g ≥ 0` vanishing outside `C`, `∫ g dμ_j → ∫ g dμ`
  have hpos : ∀ g : Euclid P → ℝ, Continuous g → (∀ x, 0 ≤ g x) → support g ⊆ support f →
      Tendsto (fun j => ∫ x, g x ∂(μs j)) atTop (𝓝 (∫ x, g x ∂μ)) := by
    intro g hg hg0 hgf
    have hgC : tsupport g ⊆ tsupport f := closure_mono hgf
    have hgc : HasCompactSupport g := hfc.mono hgf
    exact Submission.cmc_rcc_tendsto_integral_of_ae_tendsto_superlevel P μs μ g hg hgc hg0
      ((measure_mono hgC).trans_lt hμC)
      ((limsup_le_limsup (Eventually.of_forall fun j => measure_mono hgC)).trans_lt hlimC)
      (Submission.cmc_rcc_ae_tendsto_measure_superlevel P U μs μ hfin hsup hinf g hg hgc
        (hgC.trans hfU))
  -- Steps 2 and 6: `f = f⁺ − f⁻`, with `∫ f dν = ∫ f⁺ dν − ∫ f⁻ dν` whenever `ν(C) < ∞`
  have hfp : Continuous fun x => max (f x) 0 := hf.max continuous_const
  have hfm : Continuous fun x => max (-f x) 0 := hf.neg.max continuous_const
  have hsupp_pos : support (fun x => max (f x) 0) ⊆ support f :=
    support_comp_subset (g := fun y : ℝ => max y 0) (max_self 0) f
  have hsupp_neg : support (fun x => max (-f x) 0) ⊆ support f :=
    support_comp_subset (g := fun y : ℝ => max (-y) 0) (by simp) f
  have hsplit : ∀ ν : Measure (Euclid P), ν (tsupport f) < ∞ →
      ∫ x, max (f x) 0 ∂ν - ∫ x, max (-f x) 0 ∂ν = ∫ x, f x ∂ν := by
    intro ν hν
    rw [← integral_sub (hint ν _ hν hfp hsupp_pos) (hint ν _ hν hfm hsupp_neg)]
    simp only [max_zero_sub_max_neg_zero_eq_self]
  have hlim := (hpos _ hfp (fun x => le_max_right _ _) hsupp_pos).sub
    (hpos _ hfm (fun x => le_max_right _ _) hsupp_neg)
  rw [hsplit μ hμC] at hlim
  exact hlim.congr' (hμsC.mono fun j hj => hsplit (μs j) hj)
/-- **Simon 7.2.4, proof, remark after (8)** (p. 186): minimality localizes.  Let `S, T` be
integer multiplicity in the open set `U`, `spt(S − T) ⊆ K` with `K` compact, `K ⊆ W ⊆ W'` open
and `W' ⊂⊂ U`.  If `M_W(T) ≤ M_W(S)` then `M_{W'}(T) ≤ M_{W'}(S)`.  With `T = τ(M, θ, ξ)` and
`S = τ(M', θ', ξ')`, masses on open sets are the measures `μ_T`, `μ_S`
(`cmc_massOn_eq_imRep_measure`).  `S = T` on test forms supported in `O = U \ K`, so
`μ_S = μ_T` on open subsets of `O`, hence (as `μ_S` is finite on compact subsets of `O`) on the
Borel set `W' \ W ⊆ O`, and `μ_T(W') = μ_T(W) + μ_T(W' \ W) ≤ μ_S(W) + μ_S(W' \ W) = μ_S(W')`. -/
theorem Submission.cmc_massOn_le_of_le_near_support : ∀ (P n : ℕ) (U : Set (Euclid P)) (S T : GeometricCurrentOn U n) (K W W' : Set (Euclid P)), IsOpen U → IsIntegerMultiplicity S → IsIntegerMultiplicity T → IsCompact K → (S - T).support ⊆ K → IsOpen W → IsOpen W' → K ⊆ W → W ⊆ W' → CompactlyContained W' U → T.massOn W ≤ S.massOn W → T.massOn W' ≤ S.massOn W' := by
  intro P n U S T K W W' hU hS hT hK hSTK hW hW' hKW hWW' hW'U hle
  obtain ⟨RS, hRS⟩ := hS
  obtain ⟨RT, hRT⟩ := hT
  -- masses on open sets are the representation measures `μ_S`, `μ_T`
  have hμS : ∀ G : Set (Euclid P), IsOpen G → S.massOn G = RS.measure G :=
    Submission.cmc_massOn_eq_imRep_measure P n U S RS hU hRS
  have hμT : ∀ G : Set (Euclid P), IsOpen G → T.massOn G = RT.measure G :=
    Submission.cmc_massOn_eq_imRep_measure P n U T RT hU hRT
  -- `O = U \ K` is open, and `μ_S(C) = ∫_{M' ∩ C} θ' dHⁿ < ∞` for compact `C ⊆ O ⊆ U`
  have hO : IsOpen (U \ K) := hU.sdiff hK.isClosed
  have hfin : ∀ C : Set (Euclid P), IsCompact C → C ⊆ U \ K → RS.measure C ≠ ∞ := by
    intro C hC hCO
    rw [IMRep.measure, withDensity_apply _ hC.measurableSet,
      Measure.restrict_restrict hC.measurableSet, inter_comm]
    exact RS.locallyIntegrable_mult C hC (hCO.trans sdiff_subset)
  -- `μ_S(G) = M_G(S) = M_G(T) = μ_T(G)` for open `G ⊆ O`, as `G` misses `spt(S − T) ⊆ K`
  have hopen : ∀ G : Set (Euclid P), IsOpen G → G ⊆ U \ K → RS.measure G = RT.measure G := by
    intro G hG hGO
    rw [← hμS G hG, ← hμT G hG]
    exact Submission.cmc_ml_massOn_eq_of_disjoint_sub_support P n U S T K G hSTK
      (Set.disjoint_left.2 fun x hx => (hGO hx).2)
  -- hence `μ_S = μ_T` on the Borel set `W' \ W ⊆ O` (`W' ⊆ closure W' ⊆ U` and `K ⊆ W`)
  have hdiff : RS.measure (W' \ W) = RT.measure (W' \ W) :=
    Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P (U \ K) RS.measure RT.measure hO hfin
      hopen (W' \ W) (hW'.measurableSet.diff hW.measurableSet)
      fun x hx => ⟨hW'U.2 (subset_closure hx.1), fun hxK => hx.2 (hKW hxK)⟩
  -- `μ_T(W') = μ_T(W) + μ_T(W' \ W) ≤ μ_S(W) + μ_S(W' \ W) = μ_S(W')`
  have hsplit : ∀ μ : Measure (Euclid P), μ W' = μ W + μ (W' \ W) := fun μ => by
    rw [← measure_inter_add_sdiff W' hW.measurableSet, inter_eq_right.2 hWW']
  rw [hμT W hW, hμS W hW] at hle
  rw [hμT W' hW', hμS W' hW', hsplit RT.measure, hsplit RS.measure, ← hdiff]
  exact add_le_add hle le_rfl
/-- **Smooth uniform approximation keeping the unit bound** (smoothing step in the proof of
`M_W(T) = ∫_{M ∩ W} θ dHⁿ`, Simon 6.3.2(3); `|·|_E` is `covectorEuclideanNorm`).  Let
`η := δ/(2C + 1)`, where `|·|_E ≤ C‖·‖` (`Submission.rsd_mw_tfa_norm_props`).  A continuous
compactly supported covector field `g` with `|g|_E ≤ 1` is uniformly continuous, so
`‖g y − g x‖ < η` when `dist y x < r`.  Mollifying, `h' = ψ ⋆ g` with `ψ = φ / ∫ φ` for a smooth
bump `φ ≥ 0` with `support φ = B_r(0)` is a `C^∞` field with `‖h' − g‖ ≤ η`; then
`|h' − g|_E ≤ Cη` and `|h'|_E ≤ 1 + Cη`.  The rescaled field `h = (1 + Cη)⁻¹h'` has `|h|_E ≤ 1`
and `|h − h'|_E = Cη(1 + Cη)⁻¹|h'|_E ≤ Cη`, hence `|h − g|_E ≤ 2Cη ≤ δ`. -/
theorem Submission.rsd_mw_tfa_smooth_uniform_approx : ∀ (P n : ℕ) (g : Euclid P → Covector (Euclid P) n), Continuous g → HasCompactSupport g → (∀ x, covectorEuclideanNorm (g x) ≤ 1) → ∀ δ : ℝ, 0 < δ → ∃ h : Euclid P → Covector (Euclid P) n, ContDiff ℝ (⊤ : ℕ∞) h ∧ (∀ x, covectorEuclideanNorm (h x) ≤ 1) ∧ ∀ x, covectorEuclideanNorm (h x - g x) ≤ δ := by
  intro P n g hgc hgs hg1 δ hδ
  -- `N := covectorEuclideanNorm` is subadditive, absolutely homogeneous and `N ≤ C ‖·‖`
  obtain ⟨htri, hsmul, ⟨C, hC0, hCle⟩, -⟩ := Submission.rsd_mw_tfa_norm_props P n
  -- Step 1: the tolerance `η = δ / (2C + 1)`
  set η : ℝ := δ / (2 * C + 1) with hη
  have hη0 : 0 < η := div_pos hδ (by linarith)
  have hCη : 0 ≤ C * η := mul_nonneg hC0 hη0.le
  -- Step 2: `g` is uniformly continuous: `‖g y - g x‖ < η` whenever `dist y x < r`
  obtain ⟨r, hr, hgr⟩ := Metric.uniformContinuous_iff.mp
    (hgs.uniformContinuous_of_continuous hgc) η hη0
  -- Step 3: mollify, `h' = ψ ⋆ g` with `ψ = φ / ∫ φ` for a smooth bump `φ`, `support φ = B_r(0)`
  let φ : ContDiffBump (0 : Euclid P) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
  have hφ : 0 < ∫ y, φ y := by
    refine (integral_pos_iff_support_of_nonneg φ.nonneg'
      (φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport)).mpr ?_
    rw [φ.support_eq]
    exact measure_ball_pos volume 0 hr
  let ψ : Euclid P → ℝ := fun y => φ y / ∫ y, φ y
  have hψφ : support ψ ⊆ support φ := fun y hy h => hy (by simp [ψ, h])
  have hψs : support ψ ⊆ ball 0 r := hψφ.trans φ.support_eq.subset
  have hψ0 : ∀ y, 0 ≤ ψ y := fun y => div_nonneg φ.nonneg hφ.le
  have hψ1 : ∫ y, ψ y = 1 := by rw [integral_div, div_self hφ.ne']
  obtain ⟨h', hh's, hh'g⟩ : ∃ h' : Euclid P → Covector (Euclid P) n,
      ContDiff ℝ (⊤ : ℕ∞) h' ∧ ∀ x, dist (h' x) (g x) ≤ η :=
    ⟨convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume,
      (φ.hasCompactSupport.mono hψφ).contDiff_convolution_left _ (φ.contDiff.div_const _)
        hgc.locallyIntegrable,
      fun x => dist_convolution_le hη0.le hψs hψ0 hψ1 hgc.aestronglyMeasurable fun y hy =>
        (hgr (mem_ball.mp hy)).le⟩
  -- Step 4: `N(h' - g) ≤ Cη` and `N(h') ≤ 1 + Cη`
  have hdiff : ∀ x, covectorEuclideanNorm (h' x - g x) ≤ C * η := fun x =>
    (hCle _).trans (mul_le_mul_of_nonneg_left (by rw [← dist_eq_norm]; exact hh'g x) hC0)
  have hh'1 : ∀ x, covectorEuclideanNorm (h' x) ≤ 1 + C * η := fun x =>
    calc covectorEuclideanNorm (h' x) = covectorEuclideanNorm ((h' x - g x) + g x) := by
          rw [sub_add_cancel]
      _ ≤ covectorEuclideanNorm (h' x - g x) + covectorEuclideanNorm (g x) := htri _ _
      _ ≤ C * η + 1 := add_le_add (hdiff x) (hg1 x)
      _ = 1 + C * η := add_comm _ _
  -- Step 5: rescale by `s = (1 + Cη)⁻¹ ∈ (0, 1]`
  have hpos : 0 < 1 + C * η := by linarith
  have hne : 1 + C * η ≠ 0 := hpos.ne'
  set s : ℝ := (1 + C * η)⁻¹ with hs
  have hs0 : 0 < s := inv_pos.mpr hpos
  refine ⟨fun x => s • h' x, hh's.const_smul s, fun x => ?_, fun x => ?_⟩
  · show covectorEuclideanNorm (s • h' x) ≤ 1
    rw [hsmul, abs_of_pos hs0, hs, inv_mul_le_iff₀ hpos, mul_one]
    exact hh'1 x
  · show covectorEuclideanNorm (s • h' x - g x) ≤ δ
    -- Step 6: `N(s h' - h') = |s - 1| N(h') = Cη s N(h') ≤ Cη`
    have hsh : s • h' x - h' x = (s - 1) • h' x := by module
    have hs1 : |s - 1| = C * η * s := by
      have hle : s ≤ 1 := inv_le_one_of_one_le₀ (by linarith)
      rw [abs_of_nonpos (by linarith), hs]
      field_simp
      ring
    have h6 : covectorEuclideanNorm (s • h' x - h' x) ≤ C * η := by
      rw [hsh, hsmul, hs1]
      calc C * η * s * covectorEuclideanNorm (h' x) ≤ C * η * s * (1 + C * η) :=
            mul_le_mul_of_nonneg_left (hh'1 x) (mul_nonneg hCη hs0.le)
        _ = C * η := by rw [hs]; field_simp
    -- Step 7: `N(s h' - g) ≤ N(s h' - h') + N(h' - g) ≤ 2Cη ≤ δ`
    calc covectorEuclideanNorm (s • h' x - g x)
        = covectorEuclideanNorm ((s • h' x - h' x) + (h' x - g x)) := by
          rw [sub_add_sub_cancel]
      _ ≤ covectorEuclideanNorm (s • h' x - h' x) + covectorEuclideanNorm (h' x - g x) :=
          htri _ _
      _ ≤ C * η + C * η := add_le_add h6 (hdiff x)
      _ ≤ δ := by
          have h2 : 0 < 2 * C + 1 := by linarith
          have h2C : C * η + C * η = 2 * C * δ / (2 * C + 1) := by rw [hη]; ring
          rw [h2C, div_le_iff₀ h2]
          nlinarith
/-- **Polar normalization of a vector Riesz density and push-forward to `ℝᴾ`** (the normalization
`|T⃗| = 1` `μ_T`-a.e. in `T(ω) = ∫ ⟨ω, T⃗⟩ dμ_T`, Simon Ch. 6, 2.7, via the Riesz Representation
Theorem, Ch. 1, 4.14).  Write `ρ = ‖ν‖` and `ν̂ = ρ⁻¹ν` (with `0⁻¹ = 0`), so `ν = ρν̂`,
`‖ν̂‖ ≤ 1`, and `‖ν̂‖ = 1` where `ρ ≠ 0`.  Let `u` be `ν̂` extended by `0` off `U`,
`μ = val_*(ρμ₀)`, `ξ(y) = ⟨u(y), c(·)⟩` and `β = c⁻¹ ∘ u`.  Then `μ(Uᶜ) = 0`;
`μ(K) = ∫_{val⁻¹K} ‖ν‖ dμ₀ < ∞` for compact `K ⊆ U`; `|ξ(y)(α)| ≤ ‖c α‖ = |α|` by
Cauchy–Schwarz; `|β(y)| = ‖u(y)‖ ≤ 1`; `ξ(β) = ‖u‖² = 1` wherever the density `ρ` is nonzero;
and `∫ ξ(ω) dμ = ∫ ρ⟨ν̂, c(ω)⟩ dμ₀ = ∫ ⟨c(ω), ν⟩ dμ₀` for every `ω`. -/
theorem Submission.cmrc_polar_pushforward : ∀ (P n d : ℕ) (U : Set (Euclid P)) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (μ₀ : Measure U) (ν : U → EuclideanSpace ℝ (Fin d)), IsOpen U → (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → Measurable ν → (∀ K : Set U, IsCompact K → IntegrableOn ν K μ₀) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n) (β : Euclid P → Covector (Euclid P) n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ AEStronglyMeasurable β μ ∧ (∃ C : ℝ, ∀ x, ‖β x‖ ≤ C) ∧ (∀ x, covectorEuclideanNorm (β x) ≤ 1) ∧ (∀ᵐ x ∂μ, ξ x (β x) = 1) ∧ ∀ ω : DifferentialForm (Euclid P) n, ∫ x, inner ℝ (c (ω x)) (ν x) ∂μ₀ = ∫ x, ξ x (ω x) ∂μ := by
  intro P n d U c μ₀ ν hU hc hν hloc
  -- Step 1: polar decomposition `ν = ρ • ν̂` with `ρ = ‖ν‖`
  set ρ : U → ℝ := fun x => ‖ν x‖ with hρ_def
  set νh : U → EuclideanSpace ℝ (Fin d) := fun x => (ρ x)⁻¹ • ν x with hνh_def
  have hρm : Measurable ρ := hν.norm
  have hνhm : Measurable νh := hρm.inv.smul hν
  have hρ0 : ∀ x, 0 ≤ ρ x := fun x => norm_nonneg _
  have hdecomp : ∀ x, ν x = ρ x • νh x := by
    intro x
    by_cases h : ρ x = 0
    · have h0 : ν x = 0 := norm_eq_zero.mp h
      simp [hνh_def, h0]
    · simp [hνh_def, smul_smul, mul_inv_cancel₀ h]
  have hνh_one : ∀ x, ρ x ≠ 0 → ‖νh x‖ = 1 := by
    intro x h
    simp only [hνh_def]
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_nonneg (hρ0 x), inv_mul_cancel₀ h]
  have hνh_le : ∀ x, ‖νh x‖ ≤ 1 := by
    intro x
    by_cases h : ρ x = 0
    · have h0 : ν x = 0 := norm_eq_zero.mp h
      simp [hνh_def, h0]
    · exact (hνh_one x h).le
  -- Step 2: `val` is a measurable embedding (`U` is open) and the density `ρ` is measurable
  have hval : MeasurableEmbedding (Subtype.val : U → Euclid P) :=
    MeasurableEmbedding.subtype_coe hU.measurableSet
  have hdens : Measurable fun x => ENNReal.ofReal (ρ x) := hρm.ennreal_ofReal
  -- Step 3: the unit field `u`, i.e. `ν̂` extended by `0` off `U`
  set u : Euclid P → EuclideanSpace ℝ (Fin d) := Function.extend Subtype.val νh 0 with hu_def
  have hu_val : ∀ x : U, u x = νh x := fun x => Subtype.val_injective.extend_apply _ _ x
  have hu_notin : ∀ y, y ∉ U → u y = 0 := by
    intro y hy
    rw [hu_def, Function.extend_apply']
    · rfl
    · rintro ⟨x, rfl⟩
      exact hy x.2
  have hum : Measurable u := hval.measurable_extend hνhm measurable_const
  have hu_le : ∀ y, ‖u y‖ ≤ 1 := by
    intro y
    by_cases hy : y ∈ U
    · have := hu_val ⟨y, hy⟩
      simp only at this
      rw [this]
      exact hνh_le _
    · rw [hu_notin y hy, norm_zero]
      exact zero_le_one
  -- Step 4: `μ = val_*(ρ μ₀)`, `ξ(y) = ⟨u(y), c(·)⟩` and `β = c⁻¹ ∘ u`
  refine ⟨(μ₀.withDensity fun x => ENNReal.ofReal (ρ x)).map Subtype.val,
    fun y => (innerSL ℝ (u y)).comp (c : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin d)),
    fun y => c.symm (u y), ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- (a) `val⁻¹(Uᶜ) = ∅`
    rw [hval.map_apply]
    have hpre : (Subtype.val : U → Euclid P) ⁻¹' Uᶜ = ∅ := by
      ext x
      simp
    rw [hpre, measure_empty]
  · -- (b) `μ(K) = ∫⁻_{val⁻¹K} ‖ν‖ₑ dμ₀ < ∞`, as `val⁻¹K` is compact
    intro K hK hKU
    rw [hval.map_apply,
      withDensity_apply _ (hK.isClosed.measurableSet.preimage measurable_subtype_coe)]
    have hKc : IsCompact ((Subtype.val : U → Euclid P) ⁻¹' K) := by
      rw [Topology.IsInducing.subtypeVal.isCompact_preimage_iff]
      · exact hK
      · simpa using hKU
    have hint := hloc _ hKc
    have heq : ∫⁻ x in Subtype.val ⁻¹' K, ENNReal.ofReal (ρ x) ∂μ₀ =
        ∫⁻ x in Subtype.val ⁻¹' K, ‖ν x‖ₑ ∂μ₀ := by
      congr 1
      funext x
      simp [hρ_def]
    rw [heq]
    exact hint.2
  · -- (c) `ξ` is a continuous function of the measurable `u`
    have hcont : Continuous (fun v : EuclideanSpace ℝ (Fin d) =>
        (innerSL ℝ v).comp (c : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin d))) :=
      (innerSL ℝ).continuous.clm_comp continuous_const
    exact (hcont.comp_stronglyMeasurable hum.stronglyMeasurable).aestronglyMeasurable
  · -- (d) Cauchy–Schwarz and `‖u‖ ≤ 1`
    intro y α
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, innerSL_apply_apply]
    rw [hc]
    calc |inner ℝ (u y) (c α)| ≤ ‖u y‖ * ‖c α‖ := abs_real_inner_le_norm _ _
      _ ≤ 1 * ‖c α‖ := by gcongr; exact hu_le y
      _ = ‖c α‖ := one_mul _
  · -- (e) `β` is a continuous function of the measurable `u`
    exact (c.symm.continuous.comp_stronglyMeasurable hum.stronglyMeasurable).aestronglyMeasurable
  · -- (f) `‖β(y)‖ ≤ ‖c⁻¹‖ ‖u(y)‖ ≤ ‖c⁻¹‖`
    refine ⟨‖(c.symm : EuclideanSpace ℝ (Fin d) →L[ℝ] Covector (Euclid P) n)‖, fun y => ?_⟩
    calc ‖c.symm (u y)‖
        ≤ ‖(c.symm : EuclideanSpace ℝ (Fin d) →L[ℝ] Covector (Euclid P) n)‖ * ‖u y‖ :=
          (c.symm : EuclideanSpace ℝ (Fin d) →L[ℝ] Covector (Euclid P) n).le_opNorm _
      _ ≤ ‖(c.symm : EuclideanSpace ℝ (Fin d) →L[ℝ] Covector (Euclid P) n)‖ * 1 := by
          gcongr
          exact hu_le y
      _ = _ := mul_one _
  · -- (g) `|β(y)| = ‖c(c⁻¹(u y))‖ = ‖u y‖ ≤ 1`
    intro y
    rw [hc, c.apply_symm_apply]
    exact hu_le y
  · -- (h) `ξ(β) = ‖u‖² = 1` wherever the density `ρ` is nonzero
    rw [hval.ae_map_iff, ae_withDensity_iff hdens]
    refine ae_of_all _ (fun x hx => ?_)
    have hρx : ρ x ≠ 0 := by
      intro h
      apply hx
      simp [h]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe,
      ContinuousLinearEquiv.apply_symm_apply, innerSL_apply_apply]
    rw [real_inner_self_eq_norm_sq, hu_val, hνh_one x hρx]
    norm_num
  · -- (i) push-forward, then the density, then `⟨c ω, ρ ν̂⟩ = ρ ⟨ν̂, c ω⟩` pointwise
    intro ω
    rw [hval.integral_map,
      integral_withDensity_eq_integral_toReal_smul hdens
        (ae_of_all _ (fun x => ENNReal.ofReal_lt_top))]
    congr 1
    funext x
    rw [ENNReal.toReal_ofReal (hρ0 x), smul_eq_mul]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, innerSL_apply_apply,
      hu_val]
    rw [hdecomp x, inner_smul_right, real_inner_comm]
/-- **Divergence form of `b · (div g) ∘ p_I` against `θ = dx^I`** (the projection step
`p_I^#((div g) dy) = d(p_I^#γ)` of the mass representation used for Simon 7.2.4).  Let
`p_I x = (x_{I k})_k`, `ι y = ∑ₖ y_k e_{I k}` and `G = ι ∘ g ∘ p_I`, so that
`(DG(x) v)_{I k} = (Dg(p_I x)(p_I v))_k`.  Put `η = b • θ.curryLeft ∘ G` and
`ζ = dη − (b · tr Dg ∘ p_I) • θ`.  The formula for `dη` (`cmr_df_extDeriv_smul_curryLeft`) and
Jacobi's trace identity in coordinates (`cmr_df_cons_sum_trace`) give
`ζ(x)(w) = ∑ᵢ (−1)ⁱ Db(x)(wᵢ) θ(G x, w without wᵢ)`.  Hence `‖η‖ ≤ sup|b| ‖θ‖ ‖ι‖` and
`‖ζ‖ ≤ (m + 1) sup‖Db‖ ‖θ‖ ‖ι‖`, both forms vanish off `tsupport b`, and part (iii) of
`rsd_mw_tfa_norm_props` turns these operator-norm bounds into a coefficient-norm bound `K`
that does not depend on `g`. -/
theorem Submission.cmr_coordinate_divergence_form : ∀ (P m : ℕ) (I : Fin (m + 1) → Fin P) (θ : Covector (Euclid P) (m + 1)) (b : Euclid P → ℝ), StrictMono I → (∀ v : Fin (m + 1) → Euclid P, θ v = Matrix.det (Matrix.of fun k j => v j (I k))) → ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → ∃ K : ℝ, ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → (∀ y, ‖g y‖ ≤ 1) → ∃ (η : DifferentialForm (Euclid P) m) (ζ : DifferentialForm (Euclid P) (m + 1)), IsTestForm η ∧ IsTestForm ζ ∧ tsupport η ⊆ tsupport b ∧ tsupport ζ ⊆ tsupport b ∧ (∀ x, covectorEuclideanNorm (η x) ≤ K) ∧ (∀ x, covectorEuclideanNorm (ζ x) ≤ K) ∧ ∀ x, exteriorDerivative η x = (b x * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap) • θ + ζ x := by
  intro P m I θ b hI hθ hb hbc
  -- the coordinate projection `p = p_I` and the coordinate embedding `ι`, `(ι y)_{I k} = y_k`
  let p : Euclid P →L[ℝ] Euclid (m + 1) := LinearMap.toContinuousLinearMap
    { toFun := fun x => WithLp.toLp 2 (fun k => x (I k))
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  let ι : Euclid (m + 1) →L[ℝ] Euclid P := LinearMap.toContinuousLinearMap
    { toFun := fun y => WithLp.toLp 2 (fun j => ∑ k, if I k = j then y k else 0)
      map_add' := fun y z => by
        ext j
        simp only [PiLp.add_apply, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun k _ => by split_ifs <;> simp
      map_smul' := fun c y => by
        ext j
        simp only [PiLp.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
        exact Finset.sum_congr rfl fun k _ => by split_ifs <;> simp }
  have hι : ∀ y k, ι y (I k) = y k := by
    intro y k
    change (∑ k', if I k' = I k then y k' else 0) = y k
    simp [hI.injective.eq_iff]
  -- the constant `K`: (F1) from `rsd_mw_tfa_norm_props` (iii), `β₀ = sup |b|`, `β₁ = sup ‖Db‖`
  obtain ⟨Cm, hCm0, hCm⟩ := (Submission.rsd_mw_tfa_norm_props P m).2.2.1
  obtain ⟨Cn, hCn0, hCn⟩ := (Submission.rsd_mw_tfa_norm_props P (m + 1)).2.2.1
  obtain ⟨β₀, hβ₀⟩ := hb.continuous.bounded_above_of_compact_support hbc
  obtain ⟨β₁, hβ₁⟩ :=
    (hb.continuous_fderiv (by simp)).bounded_above_of_compact_support (hbc.fderiv ℝ)
  have hβ₀0 : 0 ≤ β₀ := (norm_nonneg _).trans (hβ₀ 0)
  have hβ₁0 : 0 ≤ β₁ := (norm_nonneg _).trans (hβ₁ 0)
  refine ⟨Cm * (β₀ * (‖θ‖ * ‖ι‖)) + Cn * (((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖))), ?_⟩
  intro g hg hg1
  -- the vector field `G = ι ∘ g ∘ p`: smooth, `‖G‖ ≤ ‖ι‖`, `DG(x) = ι ∘ Dg(p x) ∘ p`
  obtain ⟨G, hG⟩ : ∃ G : Euclid P → Euclid P, G = fun x => ι (g (p x)) := ⟨_, rfl⟩
  have hGs : ContDiff ℝ (⊤ : ℕ∞) G := hG ▸ ι.contDiff.comp (hg.comp p.contDiff)
  have hGb : ∀ x, ‖G x‖ ≤ ‖ι‖ := by
    intro x
    rw [hG]
    calc ‖ι (g (p x))‖ ≤ ‖ι‖ * ‖g (p x)‖ := ι.le_opNorm _
      _ ≤ ‖ι‖ * 1 := mul_le_mul_of_nonneg_left (hg1 _) (norm_nonneg _)
      _ = ‖ι‖ := mul_one _
  have hDG : ∀ x v, fderiv ℝ G x v = ι (fderiv ℝ g (p x) (p v)) := by
    intro x v
    have hgd : DifferentiableAt ℝ g (p x) := hg.differentiable (by simp) _
    have h : HasFDerivAt G (ι.comp ((fderiv ℝ g (p x)).comp p)) x := by
      rw [hG]
      exact ι.hasFDerivAt.comp x (hgd.hasFDerivAt.comp x p.hasFDerivAt)
    rw [h.fderiv]
    rfl
  -- `(DG(x) v)_{I k} = (Dg(p x)(p v))_k`, the hypothesis of `cmr_df_cons_sum_trace`
  have hL : ∀ x (v : Euclid P) (k : Fin (m + 1)), fderiv ℝ G x v (I k) =
      (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap
        (WithLp.toLp 2 (fun k' => v (I k'))) k := by
    intro x v k
    rw [hDG, hι]
    rfl
  -- the forms `η = b • θ.curryLeft ∘ G` and `ζ = dη − (b · tr Dg ∘ p) • θ`
  obtain ⟨η, hη⟩ : ∃ η : DifferentialForm (Euclid P) m,
      η = fun y => b y • ContinuousAlternatingMap.curryLeft θ (G y) := ⟨_, rfl⟩
  obtain ⟨ζ, hζ⟩ : ∃ ζ : DifferentialForm (Euclid P) (m + 1),
      ζ = fun x => exteriorDerivative η x - (b x * LinearMap.trace ℝ (Euclid (m + 1))
        (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap) • θ := ⟨_, rfl⟩
  -- Step 1: `η` is a test form with `tsupport η ⊆ tsupport b`
  have hηs : tsupport η ⊆ tsupport b := by
    rw [hη]
    exact tsupport_smul_subset_left b _
  have hηT : IsTestForm η := by
    refine ⟨?_, hbc.mono' ((subset_tsupport η).trans hηs)⟩
    rw [hη]
    exact hb.smul ((ContinuousAlternatingMap.curryLeft θ).contDiff.comp hGs)
  -- Steps 2-4: `dη(x)(w) = Z_x(w) + b(x) S_x(w)` and `S_x(w) = tr Dg(p x) · θ(w)`,
  -- so `ζ(x)(w) = Z_x(w) = ∑ᵢ (−1)ⁱ Db(x)(wᵢ) θ(G x, w without wᵢ)`
  have hζZ : ∀ x (w : Fin (m + 1) → Euclid P), ζ x w = ∑ i : Fin (m + 1),
      (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) * θ (Fin.cons (G x) (i.removeNth w))) := by
    intro x w
    have hbx : DifferentiableAt ℝ b x := hb.differentiable (by simp) x
    have hGx : DifferentiableAt ℝ G x := hGs.differentiable (by simp) x
    have h1 := Submission.cmr_df_extDeriv_smul_curryLeft P m θ b G x hbx hGx w
    have h2 := Submission.cmr_df_cons_sum_trace P m I θ
      (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap (fderiv ℝ G x) hθ (hL x) w
    have h3 : ∑ i : Fin (m + 1), (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
        θ (Fin.cons (G x) (i.removeNth w)) + b x * θ (Fin.cons (fderiv ℝ G x (w i))
          (i.removeNth w))) = ∑ i : Fin (m + 1), (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
        θ (Fin.cons (G x) (i.removeNth w))) + b x * ∑ i : Fin (m + 1), (-1 : ℝ) ^ (i : ℕ) *
          θ (Fin.cons (fderiv ℝ G x (w i)) (i.removeNth w)) := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [hζ]
    simp only [ContinuousAlternatingMap.sub_apply, ContinuousAlternatingMap.smul_apply,
      smul_eq_mul]
    rw [hη, h1, h3, h2]
    ring
  -- Step 4: `ζ` is a test form with `tsupport ζ ⊆ tsupport b`
  have hζsupp : support ζ ⊆ tsupport b := by
    intro x hx
    by_contra hxb
    have hbx : b x = 0 := image_eq_zero_of_notMem_tsupport hxb
    have hdη : exteriorDerivative η x = 0 := image_eq_zero_of_notMem_tsupport fun h =>
      hxb (hηs (tsupport_exteriorDerivative_subset η h))
    exact hx (by rw [hζ]; simp [hbx, hdη])
  have hζs : tsupport ζ ⊆ tsupport b := closure_minimal hζsupp (isClosed_tsupport b)
  have hζT : IsTestForm ζ := by
    refine ⟨?_, hbc.mono' hζsupp⟩
    let tr : (Euclid (m + 1) →L[ℝ] Euclid (m + 1)) →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
      (LinearMap.trace ℝ (Euclid (m + 1)) ∘ₗ ContinuousLinearMap.coeLM ℝ)
    have htr : ContDiff ℝ (⊤ : ℕ∞) fun x : Euclid P => LinearMap.trace ℝ (Euclid (m + 1))
        (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap :=
      tr.contDiff.comp ((hg.fderiv_right (m := (⊤ : ℕ∞)) (by simp)).comp p.contDiff)
    rw [hζ]
    exact (exteriorDerivative_isTestForm hηT).1.sub ((hb.mul htr).smul contDiff_const)
  -- Step 5: operator-norm bounds, independent of `g`
  have hη_op : ∀ x, ‖η x‖ ≤ β₀ * (‖θ‖ * ‖ι‖) := by
    intro x
    rw [hη, norm_smul]
    refine mul_le_mul (hβ₀ x) ?_ (norm_nonneg _) hβ₀0
    calc ‖ContinuousAlternatingMap.curryLeft θ (G x)‖
        ≤ ‖ContinuousAlternatingMap.curryLeft θ‖ * ‖G x‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ ‖θ‖ * ‖ι‖ := by
        rw [ContinuousAlternatingMap.norm_curryLeft]
        exact mul_le_mul_of_nonneg_left (hGb x) (norm_nonneg _)
  have hζ_op : ∀ x, ‖ζ x‖ ≤ ((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖)) := by
    intro x
    refine ContinuousAlternatingMap.opNorm_le_bound _ (by positivity) fun w => ?_
    rw [hζZ x w]
    have hterm : ∀ i : Fin (m + 1), ‖(-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
        θ (Fin.cons (G x) (i.removeNth w)))‖ ≤ β₁ * (‖θ‖ * ‖ι‖) * ∏ j, ‖w j‖ := by
      intro i
      have h1 : ‖fderiv ℝ b x (w i)‖ ≤ β₁ * ‖w i‖ :=
        ((fderiv ℝ b x).le_opNorm _).trans (mul_le_mul_of_nonneg_right (hβ₁ x) (norm_nonneg _))
      have h2 : ‖θ (Fin.cons (G x) (i.removeNth w))‖ ≤
          ‖θ‖ * ‖ι‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖ := by
        calc ‖θ (Fin.cons (G x) (i.removeNth w))‖
            ≤ ‖θ‖ * ∏ j : Fin (m + 1),
                ‖(Fin.cons (G x) (i.removeNth w) : Fin (m + 1) → Euclid P) j‖ :=
              θ.le_opNorm _
          _ = ‖θ‖ * (‖G x‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖) := by
              rw [Fin.prod_univ_succ]
              simp [Fin.removeNth_apply]
          _ ≤ ‖θ‖ * (‖ι‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖) := by
              gcongr
              exact hGb x
          _ = ‖θ‖ * ‖ι‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖ := by ring
      calc ‖(-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) * θ (Fin.cons (G x) (i.removeNth w)))‖
          = ‖fderiv ℝ b x (w i)‖ * ‖θ (Fin.cons (G x) (i.removeNth w))‖ := by
            simp [norm_mul]
        _ ≤ (β₁ * ‖w i‖) * (‖θ‖ * ‖ι‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖) :=
            mul_le_mul h1 h2 (norm_nonneg _) (by positivity)
        _ = β₁ * (‖θ‖ * ‖ι‖) * (‖w i‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖) := by ring
        _ = β₁ * (‖θ‖ * ‖ι‖) * ∏ j, ‖w j‖ := by
            rw [Fin.prod_univ_succAbove (fun j => ‖w j‖) i]
    calc ‖∑ i : Fin (m + 1), (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
          θ (Fin.cons (G x) (i.removeNth w)))‖
        ≤ ∑ i : Fin (m + 1), ‖(-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
          θ (Fin.cons (G x) (i.removeNth w)))‖ := norm_sum_le _ _
      _ ≤ ∑ _i : Fin (m + 1), β₁ * (‖θ‖ * ‖ι‖) * ∏ j, ‖w j‖ :=
          Finset.sum_le_sum fun i _ => hterm i
      _ = ((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖)) * ∏ j, ‖w j‖ := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        push_cast
        ring
  -- Steps 5-6: coefficient-norm bounds by (F1), and the identity, by definition of `ζ`
  have hK1 : 0 ≤ Cm * (β₀ * (‖θ‖ * ‖ι‖)) := by positivity
  have hK2 : 0 ≤ Cn * (((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖))) := by positivity
  refine ⟨η, ζ, hηT, hζT, hηs, hζs, fun x => ?_, fun x => ?_, fun x => ?_⟩
  · calc covectorEuclideanNorm (η x) ≤ Cm * ‖η x‖ := hCm _
      _ ≤ Cm * (β₀ * (‖θ‖ * ‖ι‖)) := mul_le_mul_of_nonneg_left (hη_op x) hCm0
      _ ≤ _ := le_add_of_nonneg_right hK2
  · calc covectorEuclideanNorm (ζ x) ≤ Cn * ‖ζ x‖ := hCn _
      _ ≤ Cn * (((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖))) := mul_le_mul_of_nonneg_left (hζ_op x) hCn0
      _ ≤ _ := le_add_of_nonneg_left hK1
  · rw [hζ]
    exact (add_sub_cancel _ _).symm

/-- **Extension by zero** (steps 6.2–6.6 of the localization in the proof of Simon 7.3.1).  Let
`V ⊆ U` be open, `K ⊆ V` compact and `X = τ(M, θ, ξ) ∈ 𝒟ₙ(V)` with `Hⁿ(M \ K) = 0`.  Move the
representation to `U` with carrier in `K` and let `Y ∈ 𝒟ₙ(U)` be the current it defines.  Then
`Y⌞V = X`; `Y` kills every form whose support misses `K`, so `spt Y = K \ Z_Y` is a compact subset
of `K`; and if `∂X = 0`, then for a cutoff `χ ∈ C^∞_c(V)` equal to `1` near `K` we get
`∂Y(ω) = Y(dω) = X(d(χω)) = ∂X(χω) = 0`, since `d(χω) = dω` near the carrier. -/
theorem Submission.dtc_extend_by_zero : ∀ (P n : ℕ) (U V K : Set (Euclid P)) (hVU : V ⊆ U) (X : GeometricCurrentOn V n) (R : IMRep V n), IsOpen U → IsOpen V → IsCompact K → K ⊆ V → R.Represents X → μHE[n] (R.carrier \ K) = 0 → ∃ Y : GeometricCurrentOn U n, Y.restrictDomain hVU = X ∧ Y.support ⊆ K ∧ IsCompact Y.support ∧ (BoundaryVanishes X → BoundaryVanishes Y) ∧ IsIntegerMultiplicity Y := by
  intro P n U V K hVU X R hU hV hK hKV hRX hnull
  -- Step 1: move `R` to `U`, with carrier in `K` and the same action
  obtain ⟨R', hR'K, hR'R⟩ :=
    Submission.dtc_imrep_of_null_off_compact P n U V K R hK hKV (hKV.trans hVU) hnull
  -- Step 2: `Y = τ(R')`, which is integer multiplicity
  obtain ⟨Y, hY⟩ := Submission.dtc_imrep_current P n U R'
  -- Step 4: `Y` vanishes on forms whose support misses `K`
  have hvan : ∀ ω : TestFormOn U n,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) K → Y ω = 0 := by
    intro ω hω
    rw [hY ω, IMRep.action]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [image_eq_zero_of_notMem_tsupport (Set.disjoint_right.mp hω (hR'K hx)), map_zero,
      mul_zero]
  -- Step 5: `spt Y ⊆ K`; a point of `U \ K` has a ball `W ⊂⊂ U \ K` on which `Y` vanishes
  have hspt : Y.support ⊆ K := by
    rintro q ⟨hqU, hqZ⟩
    by_contra hqK
    obtain ⟨r, hr, hrUK⟩ := Metric.isOpen_iff.mp (hU.sdiff hK.isClosed) q ⟨hqU, hqK⟩
    have hcl : closure (ball q (r / 2)) ⊆ ball q r :=
      closure_ball_subset_closedBall.trans (closedBall_subset_ball (half_lt_self hr))
    refine hqZ (mem_sUnion.mpr ⟨ball q (r / 2), ⟨isOpen_ball,
      (isCompact_closedBall q (r / 2)).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall,
      hcl.trans (hrUK.trans sdiff_subset), fun ω hω => hvan ω ?_⟩, mem_ball_self (half_pos hr)⟩)
    exact disjoint_sdiff_left.mono_left (hω.trans (subset_closure.trans (hcl.trans hrUK)))
  -- Step 6: `spt Y = K \ Z_Y` is compact
  have hcpt : IsCompact Y.support := by
    have heq : Y.support = K \ Y.zeroRegion :=
      Subset.antisymm (fun x hx => ⟨hspt hx, hx.2⟩) fun x hx => ⟨hVU (hKV hx.1), hx.2⟩
    rw [heq]
    exact hK.diff Y.isOpen_zeroRegion
  -- Step 3: `Y⌞V = X`, since `R'` and `R` have the same action
  have hres : Y.restrictDomain hVU = X := by
    ext ω
    rw [GeometricCurrentOn.restrictDomain_apply, hY (testFormOnInclusion hVU n ω),
      testFormOnInclusion_coe, hR'R, hRX ω]
  refine ⟨Y, hres, hspt, hcpt, ?_, ⟨R', hY⟩⟩
  -- Step 7: `∂X = 0 → ∂Y = 0` (trivial in degree `0`)
  rcases n with _ | m
  · exact fun _ => trivial
  intro hX
  change X.boundary = 0 at hX
  change Y.boundary = 0
  -- Step 7.1: a cutoff `χ ∈ C^∞_c(V)` equal to `1` on an open set `O ⊇ K`
  obtain ⟨δ, hδ, hδV⟩ := hK.exists_cthickening_subset_open hV hKV
  obtain ⟨χ, hχ1, hχ0, -⟩ := exists_contMDiffMap_one_nhds_of_subset_interior
    (modelWithCornersSelf ℝ (Euclid P)) (n := ⊤) hK.isClosed
    ((self_subset_thickening hδ K).trans (thickening_subset_interior_cthickening δ K))
  have hχs : ContDiff ℝ (⊤ : ℕ∞) χ := contMDiff_iff_contDiff.mp χ.contMDiff
  have hχsupp : tsupport χ ⊆ cthickening δ K :=
    closure_minimal (fun x hx => by_contra fun h => hx (hχ0 x h)) isClosed_cthickening
  have hχc : HasCompactSupport χ :=
    hK.cthickening.of_isClosed_subset (isClosed_tsupport _) hχsupp
  obtain ⟨O, hO, hKO, hOχ⟩ := mem_nhdsSet_iff_exists.mp hχ1
  -- Step 7.2: `χω ∈ 𝒟^m(V)` for `ω ∈ 𝒟^m(U)`
  have hcut : ∀ ω : TestFormOn U m,
      (fun x => χ x • (ω : DifferentialForm (Euclid P) m) x) ∈ testFormOnSubmodule V m :=
    fun ω => ⟨⟨hχs.smul ω.property.1.1, hχc.smul_right⟩,
      (tsupport_smul_subset_left _ _).trans (hχsupp.trans hδV)⟩
  -- Step 7.4: `∂Y(ω) = R'(dω) = R'(d(χω)) = R(d(χω)) = X(d(χω)) = ∂X(χω) = 0`
  ext ω
  rw [GeometricCurrentOn.zero_apply, GeometricCurrentOn.boundary_apply,
    hY (exteriorDerivativeTestOn U m ω)]
  have hd : R'.action (exteriorDerivativeTestOn U m ω : DifferentialForm (Euclid P) (m + 1)) =
      R'.action (exteriorDerivativeTestOn V m ⟨_, hcut ω⟩ :
        DifferentialForm (Euclid P) (m + 1)) := by
    unfold IMRep.action
    refine setIntegral_congr_fun R'.measurableSet_carrier fun x hx => ?_
    -- Step 7.3: `χω = ω` near `x ∈ M' ⊆ K ⊆ O`, so `d(χω)(x) = dω(x)`
    have hloc : (fun y => χ y • (ω : DifferentialForm (Euclid P) m) y) =ᶠ[𝓝 x]
        (ω : DifferentialForm (Euclid P) m) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds (hKO (hR'K hx))) fun y hy => by
        rw [show χ y = 1 from hOχ hy, one_smul]
    show (R'.mult x : ℝ) * R'.orient x (extDeriv (ω : DifferentialForm (Euclid P) m) x) =
      (R'.mult x : ℝ) * R'.orient x
        (extDeriv (fun y => χ y • (ω : DifferentialForm (Euclid P) m) y) x)
    rw [hloc.extDeriv_eq]
  rw [hd, hR'R, ← hRX, ← GeometricCurrentOn.boundary_apply, hX, GeometricCurrentOn.zero_apply]
/-- **Comparison with a small filling** (Simon Ch. 6, proof of Theorem 8.2, (4)–(6), pp. 177–178,
for a single test form).  Suppose `∂S = ∂A` in `ℝᴾ`, `M(A) ≤ m < ∞`, `M(S) ≤ κm`,
`spt A, spt S ⊆ B̄_R(x)`, `|ω| ≤ 1`, and `ω` satisfies the cone inequality `|X(ω)| ≤ cϱM(X)` for
every cycle `X` of finite mass supported in a closed ball of radius `ϱ`.  Then `X = S − A` is such
a cycle, with `M(X) ≤ M(S) + M(A) ≤ (1 + κ)m` and `spt X ⊆ spt S ∪ spt A ⊆ B̄_R(x)`, so
`|X(ω)| ≤ cR(1 + κ)m`; and `S(ω) ≤ M(S) ≤ κm` because `ω` is admissible.  Hence
`A(ω) = S(ω) − X(ω) ≤ (κ + cR(1 + κ))m`. -/
theorem Submission.cbrld_ns_eval_le_of_small_filling : ∀ (P d : ℕ) (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (ω : TestFormOn (univ : Set (Euclid P)) (d + 1)) (m : ℝ≥0∞) (x : Euclid P) (c κ R : ℝ), 0 ≤ c → 0 ≤ κ → 0 < R → m < ∞ → (∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (d + 1)) y) ≤ 1) → (∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (x₀ : Euclid P) (ϱ : ℝ), 0 < ϱ → X.boundary = 0 → X.mass < ∞ → X.support ⊆ closedBall x₀ ϱ → |X ω| ≤ c * ϱ * X.mass.toReal) → S.boundary = A.boundary → A.mass ≤ m → S.mass ≤ ENNReal.ofReal κ * m → A.support ⊆ closedBall x R → S.support ⊆ closedBall x R → A ω ≤ (κ + c * R * (1 + κ)) * m.toReal := by
  intro P d A S ω m x c κ R hc hκ hR hm hω hcone hbd hA hS hsptA hsptS
  -- Step 1: the comparison current `X = S − A`, with `X(η) = S(η) − A(η)`.
  set X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1) := S - A
  have hXapp : ∀ η, X η = S η - A η := fun _ => rfl
  -- Step 2: `∂X(η) = S(dη) − A(dη) = ∂S(η) − ∂A(η) = 0`.
  have hXbd : X.boundary = 0 := by
    ext η
    rw [GeometricCurrentOn.boundary_apply, hXapp, ← GeometricCurrentOn.boundary_apply,
      ← GeometricCurrentOn.boundary_apply, hbd, sub_self, GeometricCurrentOn.zero_apply]
  -- Step 3: `M(X) ≤ M(S) + M(A) ≤ κm + m < ∞`, hence `M(X) ≤ (1 + κ)m` as real numbers.
  have hκm : ENNReal.ofReal κ * m < ∞ := ENNReal.mul_lt_top ENNReal.ofReal_lt_top hm
  have hsum : ENNReal.ofReal κ * m + m < ∞ := ENNReal.add_lt_top.2 ⟨hκm, hm⟩
  have hXmass : X.mass ≤ ENNReal.ofReal κ * m + m :=
    (Submission.cbrld_ns_massOn_sub_le P (d + 1) univ univ S A).trans (add_le_add hS hA)
  have hXfin : X.mass < ∞ := hXmass.trans_lt hsum
  have hXreal : X.mass.toReal ≤ (1 + κ) * m.toReal := by
    have h := ENNReal.toReal_mono hsum.ne hXmass
    rw [ENNReal.toReal_add hκm.ne hm.ne, ENNReal.toReal_mul, ENNReal.toReal_ofReal hκ] at h
    linarith
  -- Step 4: `spt X ⊆ spt S ∪ spt A ⊆ B̄_R(x)`.
  have hXspt : X.support ⊆ closedBall x R :=
    (Submission.cbrld_ns_support_sub_subset P (d + 1) univ S A).trans (union_subset hsptS hsptA)
  -- Step 5: the cone inequality at `(x, R)`: `|X(ω)| ≤ cR·M(X) ≤ cR(1 + κ)m`.
  have hXω : |X ω| ≤ c * R * ((1 + κ) * m.toReal) :=
    (hcone X x R hR hXbd hXfin hXspt).trans
      (mul_le_mul_of_nonneg_left hXreal (mul_nonneg hc hR.le))
  -- Step 6: `ω` is `ℝᴾ`-admissible, so `S(ω) ≤ M(S) ≤ κm`.
  have hSω : S ω ≤ κ * m.toReal := by
    have hadm : ω ∈ massAdmissibleOn (univ : Set (Euclid P)) (d + 1) univ :=
      ⟨subset_univ _, hω⟩
    have h := (ENNReal.ofReal_le_iff_le_toReal hκm.ne).1 ((S.le_massOn hadm).trans hS)
    rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal hκ] at h
  -- Step 7: `A(ω) = S(ω) − X(ω) ≤ S(ω) + |X(ω)| ≤ κm + cR(1 + κ)m`.
  have hAω : A ω = S ω - X ω := by rw [hXapp]; ring
  rw [hAω]
  linarith [neg_le_abs (X ω)]
/-- **Simon 6.3.1, 6.2.16, 8.3(1)**: integer multiplicity is a local property and passes to open
subdomains.  The hypotheses are the mass representation of currents of locally finite mass
(REP), `M_W(τ(M, θ, ξ)) = θHᵏ⌞M(W)` (MR) and four facts about integer multiplicity triples (IMC).
(1) Let `X ∈ 𝒟ₖ(U)` have locally finite mass, and let each `x ∈ U` have a ball
`B = B_r(x) ⊆ U` with `X|_B = τ(M, θ, ξ_B)`.  (REP) gives `X(ω) = ∫ ξ(ω) dμ`.  For open
`G ⊆ B`, `μ(G) = M_G(X) = M_G(X|_B) = θHᵏ⌞M(G)` by (MR), so `μ⌞B = θHᵏ⌞M`.  Both
representations compute `X(ω)` for `ω ∈ 𝒟ᵏ(B)`, so their set integrals agree and `ξ = ξ_B`
`μ`-a.e. on `B`.  The local triples then glue to a representation of `X` in `U`.
(2) `X|_V = τ(M ∩ V, θ, ξ)` (`dtc_restrictDomain_isIntegerMultiplicity`). -/
theorem Submission.cbr_isIntegerMultiplicity_of_local : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (U : Set (Euclid P)) (X : GeometricCurrentOn U k), IsOpen U → ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → X.massOn W < ∞) → (∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ ∃ h : ball x r ⊆ U, IsIntegerMultiplicity (X.restrictDomain h)) → IsIntegerMultiplicity X) ∧ (∀ (V : Set (Euclid P)) (h : V ⊆ U), IsOpen V → IsIntegerMultiplicity X → IsIntegerMultiplicity (X.restrictDomain h)) := by
  intro hREP hMR hIMC P k U X hU
  refine ⟨fun hmass hloc => ?_, fun V hVU hV hX =>
    Submission.dtc_restrictDomain_isIntegerMultiplicity P k U V hVU X hV hX⟩
  -- Step 4: the mass representation `X(ω) = ∫ ξ(ω) dμ` of (REP)
  obtain ⟨μ, ξ, hμU, hμK, hμmass, hξmeas, hξbound, hXrep, -⟩ := hREP P k U X hU hmass
  -- Steps 7–9: it suffices that `(μ, ξ)` agrees near each `x ∈ U` with an IMRep
  refine Submission.cbr_isIntegerMultiplicity_of_local_reps hIMC.1 P k U X μ ξ hU hμU hμK hξmeas
    hXrep fun x hx => ?_
  obtain ⟨r, hr, hB, R, hR⟩ := hloc x hx
  obtain ⟨hRac, -, -, hRcompl, hRK, hRmeas, hRaction⟩ :=
    Submission.cbr_imRep_measure_basic P k (ball x r) R
  have hμKB : ∀ K : Set (Euclid P), IsCompact K → K ⊆ ball x r → μ K < ∞ :=
    fun K hK hKB => hμK K hK (hKB.trans hB)
  -- (IMC)(d) holds `Hᵏ⌞M`-a.e., hence `θHᵏ⌞M`-a.e. as `θHᵏ⌞M ≪ Hᵏ⌞M`
  have hRbound : ∀ᵐ y ∂R.measure, ∀ α : Covector (Euclid P) k,
      |R.orient y α| ≤ covectorEuclideanNorm α :=
    hRac.ae_le (hIMC.2.2.2 P k (ball x r) R)
  -- Step 5: `μ(G) = M_G(X) = M_G(X|_B) = θHᵏ⌞M(G)` for open `G ⊆ B`, so `μ⌞B = θHᵏ⌞M`
  have hopen : ∀ G : Set (Euclid P), IsOpen G → G ⊆ ball x r → μ G = R.measure G := by
    intro G hG hGB
    rw [← hμmass G hG, Submission.dtc_massOn_eq_of_agreeOn P k U (ball x r) G hB X
      (X.restrictDomain hB) hGB fun ω _ => rfl]
    exact hMR P k (ball x r) (X.restrictDomain hB) R isOpen_ball hR G hG
  have hborel := Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P (ball x r) μ R.measure
    isOpen_ball (fun C hC hCB => (hμKB C hC hCB).ne) hopen
  have hrestr : μ.restrict (ball x r) = R.measure.restrict (ball x r) :=
    (Measure.restrict_congr_meas measurableSet_ball).2 fun A hAB hA => hborel A hA hAB
  -- `θHᵏ⌞M` lives on `M ⊆ B`
  have hRB : R.measure.restrict (ball x r) = R.measure :=
    Measure.restrict_eq_self_of_ae_mem
      (Filter.mem_of_superset (mem_ae_iff.2 hRcompl) R.carrier_subset)
  -- Step 6: for `ω ∈ 𝒟ᵏ(B)`, `∫ ξ(ω) dμ = X(ω) = X|_B(ω) = ∫ ξ_B(ω) d(θHᵏ⌞M)`, so the set
  -- integrals agree (with `(μ₃, ξ₃) = (0, 0)`) and `ξ = ξ_B` `μ`-a.e. on `B`
  have hset := Submission.cbr_setIntegral_eq_of_integral_eq P k (ball x r) μ R.measure 0 ξ
    R.orient 0 isOpen_ball hμKB hRK (fun K _ _ => by simp) hξmeas hRmeas
    (aestronglyMeasurable_zero_measure _) (ae_of_all μ hξbound) hRbound
    (ae_of_all _ fun y α => by simpa using covectorEuclideanNorm_nonneg α) fun ω => by
      rw [integral_zero_measure, add_zero, ← hRaction (ω : DifferentialForm (Euclid P) k),
        ← hR ω, GeometricCurrentOn.restrictDomain_apply, hXrep, testFormOnInclusion_coe]
  have hae := Submission.cbr_orient_ae_eq_of_setIntegral_eq P k (ball x r) μ R.measure ξ R.orient
    isOpen_ball hμKB hrestr hξmeas hRmeas (ae_of_all μ hξbound) hRbound fun E ω hE => by
      rw [hset E ω hE, Measure.restrict_zero, integral_zero_measure, add_zero]
  exact ⟨ball x r, R, isOpen_ball, mem_ball_self hr, hB, hrestr.trans hRB, hae⟩
/-- **Slicing localization** (Simon Ch. 6, 4.5(1)–(2) and 6.2, general case, as used in the proof
of 7.2.4).  Assume (REP) `cmc_exists_massRepresentation`, (IMC)(b), (IMC)(d) and (SL)
`cmc_slice_mass_bounds`.  Let `R ∈ 𝒟_{d+1}(U)` be integer multiplicity with `M_W(∂R) < ∞` for
`W ⋐ U`, and `x₀ ∈ U`.  Then for some `r > 0` with `closedBall x₀ r ⊆ U`, the current
`R' = R⌞B_r(x₀)` is represented by an `IMRep` with carrier in `B_r(x₀)`, `M(R') < ∞`,
`M(∂R') < ∞`, and `∂R' = ∂R` on forms supported in `B_r(x₀)`.  Represent `R` by its weight
`μ = θ Hᵈ⁺¹⌞M` and `∂R` by `(μ', ξ')`, and slice by `f = |· − x₀|`.  The integrated bound of
(SL) on `(0, r₀)` gives `r ∈ (0, r₀)` with `M_{B_{r₀}(x₀)}(∂A_r − B_r) < ∞`.  This current
vanishes away from the compact sphere `{f = r}`, so its total mass is finite, and
`M(∂A_r) ≤ M(B_r) + M(∂A_r − B_r) < ∞`. -/
theorem Submission.cbr_bim_slice_localization : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) → (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P d : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)) (x₀ : Euclid P), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → x₀ ∈ U → ∃ r : ℝ, 0 < r ∧ closedBall x₀ r ⊆ U ∧ ∃ (R' : GeometricCurrentOn U (d + 1)) (Rr : IMRep U (d + 1)), Rr.Represents R' ∧ Rr.carrier ⊆ ball x₀ r ∧ R'.mass < ∞ ∧ R'.boundary.mass < ∞ ∧ ∀ η : TestFormOn U d, tsupport (η : DifferentialForm (Euclid P) d) ⊆ ball x₀ r → R'.boundary η = R.boundary η := by
  intro hREP hIMCb hIMCd hSL P d U R x₀ hU hRim hbd hx₀
  -- Step 0: the local mass of a current is bounded by any representing measure
  have hmassle : ∀ {k : ℕ} (X : GeometricCurrentOn U k) (ν : Measure (Euclid P))
      (ζ : Euclid P → MultiVector P k),
      (∀ᵐ x ∂ν, ∀ α : Covector (Euclid P) k, |ζ x α| ≤ covectorEuclideanNorm α) →
      (∀ ω : TestFormOn U k, X ω = ∫ x, ζ x ((ω : DifferentialForm (Euclid P) k) x) ∂ν) →
      ∀ W : Set (Euclid P), X.massOn W ≤ ν W := by
    intro k X ν ζ hζ hrep W
    apply sSup_le
    rintro _ ⟨ω, ⟨hsupp, hnorm⟩, rfl⟩
    change ENNReal.ofReal (X ω) ≤ ν W
    rw [hrep ω]
    calc ENNReal.ofReal (∫ x, ζ x ((ω : DifferentialForm (Euclid P) k) x) ∂ν)
        ≤ ‖∫ x, ζ x ((ω : DifferentialForm (Euclid P) k) x) ∂ν‖ₑ := by
          rw [Real.enorm_eq_ofReal_abs]; exact ENNReal.ofReal_le_ofReal (le_abs_self _)
      _ ≤ ∫⁻ x, ‖ζ x ((ω : DifferentialForm (Euclid P) k) x)‖ₑ ∂ν :=
          enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ x, W.indicator 1 x ∂ν := by
          apply lintegral_mono_ae
          filter_upwards [hζ] with x hx
          by_cases hxW : x ∈ W
          · rw [indicator_of_mem hxW, Pi.one_apply, Real.enorm_eq_ofReal_abs]
            exact ENNReal.ofReal_le_one.mpr ((hx _).trans (hnorm x))
          · have : (ω : DifferentialForm (Euclid P) k) x = 0 :=
              image_eq_zero_of_notMem_tsupport (fun h => hxW (hsupp h))
            simp [this]
      _ ≤ ν W := lintegral_indicator_one_le W
  -- Step 1: `R` is represented by the weight `μ = θ Hᵈ⁺¹⌞M` of an `IMRep` `R₀ = (M, θ, ξ)`
  obtain ⟨R₀, hR₀⟩ := hRim
  obtain ⟨hac, haesm, hrestr⟩ := Submission.lcmp_imRep_measure_restrict P (d + 1) U R₀
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → R₀.measure K < ∞ := by
    intro K hK hKU
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact lt_top_iff_ne_top.mpr (R₀.locallyIntegrable_mult K hK hKU)
  have hξb : ∀ᵐ x ∂R₀.measure, ∀ α : Covector (Euclid P) (d + 1),
      |R₀.orient x α| ≤ covectorEuclideanNorm α :=
    hac.ae_le (hIMCd P (d + 1) U R₀)
  have hRrep : ∀ ω : TestFormOn U (d + 1),
      R ω = ∫ x, R₀.orient x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂R₀.measure := by
    intro ω
    have h := (hrestr univ R₀ MeasurableSet.univ (inter_univ _).symm rfl rfl).2
      (ω : DifferentialForm (Euclid P) (d + 1))
    rw [Measure.restrict_univ] at h
    rw [hR₀ ω, h]
  -- Step 2: `∂R` is represented by `(μ', ξ')`
  obtain ⟨μ', ξ', -, hfin', -, haesm', hξ'b, hbrep, -⟩ := hREP P d U R.boundary hU hbd
  -- Step 3: a radius `r₀ = ε / 2` with `closedBall x₀ r₀ ⊆ U`
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.mp hU x₀ hx₀
  have hr₀pos : 0 < ε / 2 := by positivity
  have hcb₀ : closedBall x₀ (ε / 2) ⊆ U := (closedBall_subset_ball (by linarith)).trans hεU
  have hfL : LipschitzWith 1 (fun x : Euclid P => dist x x₀) := LipschitzWith.dist_left x₀
  -- Step 4: slicing by the distance from `x₀`
  obtain ⟨A, B, hA, hB, hAB, -, hint5⟩ := hSL P d U R R₀.measure μ' R₀.orient ξ'
    (fun x => dist x x₀) 1 hU hfin hfin' haesm haesm' hξb (Eventually.of_forall hξ'b) hRrep hbrep hfL
  have hfinball : R₀.measure (closedBall x₀ (ε / 2)) < ∞ := hfin _ (isCompact_closedBall _ _) hcb₀
  have hfinball' : μ' (closedBall x₀ (ε / 2)) < ∞ := hfin' _ (isCompact_closedBall _ _) hcb₀
  -- Step 5: a good radius `r ∈ (0, r₀)`, from the integrated slice bound on `(0, r₀)`
  obtain ⟨r, hr, hZr⟩ : ∃ r ∈ Ioo 0 (ε / 2),
      ((A r).boundary - B r).massOn (ball x₀ (ε / 2)) < ∞ := by
    by_contra hcon
    push Not at hcon
    have hlint := hint5 (ball x₀ (ε / 2)) 0 (ε / 2) isOpen_ball
    have htop : ∫⁻ t in Ioo 0 (ε / 2), ((A t).boundary - B t).massOn (ball x₀ (ε / 2)) = ∞ := by
      rw [setLIntegral_congr_fun measurableSet_Ioo (fun t ht => top_le_iff.mp (hcon t ht))]
      rw [lintegral_const, Measure.restrict_apply_univ, Real.volume_Ioo, sub_zero]
      exact ENNReal.top_mul (by simpa using hr₀pos)
    rw [htop, ENNReal.coe_one, one_mul] at hlint
    have hle : R₀.measure (ball x₀ (ε / 2) ∩ {x | 0 < dist x x₀ ∧ dist x x₀ < ε / 2}) < ∞ :=
      lt_of_le_of_lt (measure_mono (inter_subset_left.trans ball_subset_closedBall)) hfinball
    exact absurd (lt_of_le_of_lt hlint hle) (lt_irrefl _)
  -- Step 6: `Z = ∂A_r − B_r` vanishes off the sphere, so its total mass is finite
  set Z := (A r).boundary - B r with hZ
  have hZvan : ∀ η : TestFormOn U d,
      Disjoint (tsupport (η : DifferentialForm (Euclid P) d)) (sphere x₀ r) → Z η = 0 := by
    intro η hη
    have := hAB r η hη
    change (A r).boundary η - B r η = 0
    rw [this, sub_self]
  have hsph : sphere x₀ r ⊆ ball x₀ (ε / 2) := fun y hy => by
    rw [mem_sphere] at hy; rw [mem_ball, hy]; exact hr.2
  have hZU : Z.massOn U < ∞ :=
    lt_of_le_of_lt (Submission.lcmp_massOn_le_of_vanish_off_compact P d U (ball x₀ (ε / 2))
      (sphere x₀ r) Z (isCompact_sphere _ _) isOpen_ball hsph hZvan U) hZr
  -- Step 7: `M(B_r) ≤ μ'(B_r(x₀)) < ∞`
  have hBU : (B r).massOn U < ∞ := by
    refine lt_of_le_of_lt (hmassle (B r) (μ'.restrict (ball x₀ r)) ξ'
      (ae_restrict_of_ae (Eventually.of_forall hξ'b)) (fun η => hB r η) U) ?_
    refine lt_of_le_of_lt ?_ hfinball'
    calc μ'.restrict (ball x₀ r) U ≤ μ'.restrict (ball x₀ r) univ := measure_mono (subset_univ _)
      _ = μ' (ball x₀ r) := Measure.restrict_apply_univ _
      _ ≤ μ' (closedBall x₀ (ε / 2)) :=
          measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall hr.2.le))
  -- Step 8: `M(∂A_r) ≤ M(B_r) + M(Z) < ∞`
  have hAbU : (A r).boundary.massOn U < ∞ := by
    refine lt_of_le_of_lt (b := (B r).massOn U + Z.massOn U) ?_ (ENNReal.add_lt_top.mpr ⟨hBU, hZU⟩)
    apply sSup_le
    rintro _ ⟨η, hη, rfl⟩
    have hsplit : (A r).boundary η = B r η + Z η := by
      change (A r).boundary η = B r η + ((A r).boundary η - B r η); ring
    change ENNReal.ofReal ((A r).boundary η) ≤ _
    rw [hsplit]
    exact ENNReal.ofReal_add_le.trans (add_le_add ((B r).le_massOn hη) (Z.le_massOn hη))
  -- Step 9: `R' := A_r = R⌞B_r(x₀)` is represented by the restricted `IMRep`
  obtain ⟨A', Rr, -, hcar, hmult, hor⟩ := hIMCb P (d + 1) U R₀ (ball x₀ r) hU measurableSet_ball
  have hRrA : Rr.Represents (A r) := by
    intro ω
    rw [hA r ω]
    exact ((hrestr (ball x₀ r) Rr measurableSet_ball hcar hmult hor).2 _).symm
  -- Step 10: `M(R') ≤ μ(B_r(x₀)) < ∞`
  have hAU : (A r).massOn U < ∞ := by
    refine lt_of_le_of_lt (hmassle (A r) (R₀.measure.restrict (ball x₀ r)) R₀.orient
      (ae_restrict_of_ae hξb) (fun ω => hA r ω) U) ?_
    refine lt_of_le_of_lt ?_ hfinball
    calc R₀.measure.restrict (ball x₀ r) U ≤ R₀.measure.restrict (ball x₀ r) univ :=
          measure_mono (subset_univ _)
      _ = R₀.measure (ball x₀ r) := Measure.restrict_apply_univ _
      _ ≤ R₀.measure (closedBall x₀ (ε / 2)) :=
          measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall hr.2.le))
  -- Steps 11–12: conclusion; `∂R' = ∂R` on forms supported in `B_r(x₀)`
  refine ⟨r, hr.1, (closedBall_subset_closedBall hr.2.le).trans hcb₀, A r, Rr, hRrA, ?_, hAU, hAbU, ?_⟩
  · rw [hcar]; exact inter_subset_right
  · intro η hη
    have hdisj : Disjoint (tsupport (η : DifferentialForm (Euclid P) d)) (sphere x₀ r) := by
      refine Set.disjoint_left.mpr fun y hy hys => ?_
      have h1 := hη hy
      rw [mem_ball] at h1; rw [mem_sphere] at hys
      linarith
    rw [hAB r η hdisj, hB r η, hbrep η]
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro x hx
    have : (η : DifferentialForm (Euclid P) d) x = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => hx (hη h))
    rw [this, map_zero]

/-- **Mass and boundary mass of a compactly supported current under restriction** (Simon 7.2.4,
proof; Simon Ch. 6, 2.4–2.5 and 2.11).  Assume that every current kills the test forms whose
support misses its support.  Let `U` be open, `C ⊆ U` compact and `Y ∈ 𝒟ₖ₊₁(ℝᴾ)` with
`spt Y ⊆ C`.  Then `M(Y) ≤ M(Y|_U)` and `M(∂Y) ≤ M(∂(Y|_U))`.  `Y` and `∂Y` kill the forms
whose support misses `C` (`d` does not enlarge supports), so mass localization gives
`M(Y) ≤ M_U(Y)` and `M(∂Y) ≤ M_U(∂Y)`.  A form on `ℝᴾ` admissible for `M_U` is an admissible
form of `U` with the same value, so `M_U(Y) ≤ M(Y|_U)` and `M_U(∂Y) ≤ M(∂(Y|_U))`. -/
theorem Submission.cbr_bim_extension_mass_bounds : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P k : ℕ) (U C : Set (Euclid P)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), IsOpen U → IsCompact C → C ⊆ U → Y.support ⊆ C → Y.mass ≤ (Y.restrictDomain (subset_univ U)).mass ∧ Y.boundary.mass ≤ (Y.restrictDomain (subset_univ U)).boundary.mass := by
  intro hVO P k U C Y hU hC hCU hYC
  -- Step 1: `Y` kills the forms whose support misses `C ⊇ spt Y`
  have hvY : ∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (k + 1))) C → Y ω = 0 :=
    fun ω hω => hVO P (k + 1) univ Y ω (hω.mono_right hYC)
  -- Step 2: so does `∂Y`, since `∂Y(η) = Y(dη)` and `spt dη ⊆ spt η`
  have hvB : ∀ η : TestFormOn (univ : Set (Euclid P)) k,
      Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) C → Y.boundary η = 0 := by
    intro η hη
    rw [GeometricCurrentOn.boundary_apply]
    exact hvY _ (hη.mono_left (tsupport_exteriorDerivative_subset _))
  -- Step 4: `M_U(Z) ≤ M_U(Z')` when `Z' ∈ 𝒟ₘ(U)` agrees with `Z ∈ 𝒟ₘ(ℝᴾ)` on `𝒟ᵐ(U)`
  have hres : ∀ {m : ℕ} (Z : GeometricCurrentOn (univ : Set (Euclid P)) m)
      (Z' : GeometricCurrentOn U m),
      (∀ ω : TestFormOn U m, Z (testFormOnInclusion (subset_univ U) m ω) = Z' ω) →
      Z.massOn U ≤ Z'.massOn U := by
    intro m Z Z' hZ
    apply sSup_le
    rintro _ ⟨ω, ⟨hsupp, hnorm⟩, rfl⟩
    let ω' : TestFormOn U m := ⟨ω, ω.property.1, hsupp⟩
    have h1 : Z ω = Z' ω' := by
      rw [← hZ ω']
      rfl
    change ENNReal.ofReal (Z ω) ≤ Z'.massOn U
    rw [h1]
    exact Z'.le_massOn ⟨hsupp, hnorm⟩
  -- Steps 3, 5, 6: localize with `V = U`, then compare with the restriction
  refine ⟨?_, ?_⟩
  · calc Y.mass = Y.massOn univ := rfl
      _ ≤ Y.massOn U :=
        Submission.lcmp_massOn_le_of_vanish_off_compact P (k + 1) univ U C Y hC hU hCU hvY univ
      _ ≤ (Y.restrictDomain (subset_univ U)).massOn U := hres Y _ fun ω => rfl
  · calc Y.boundary.mass = Y.boundary.massOn univ := rfl
      _ ≤ Y.boundary.massOn U :=
        Submission.lcmp_massOn_le_of_vanish_off_compact P k univ U C Y.boundary hC hU hCU hvB univ
      _ ≤ (Y.restrictDomain (subset_univ U)).boundary.massOn U := hres Y.boundary _ fun ω => rfl

/-- **Simon Ch. 6, 6.2 (first case) and 6.3**: if `T ∈ 𝒟_{d+1}(ℝᴾ)` is integer multiplicity with
compact support and `M(T), M(∂T) < ∞`, then `∂T` is integer multiplicity, given the
deformation theorem (DT) and the closure theorem (CL) in degree `d`.  (DT) with `ρ_k = 2⁻ᵏ` and
`Λ = M(T)` gives `T - Q_k - S_k = ∂R_k` with `∂Q_k` integer multiplicity, `M(∂Q_k) ≤ c M(∂T)`,
`M(R_k) ≤ c ρ_k M(T)` and `M(S_k) ≤ c ρ_k M(∂T)`.  With `|ω(x)| ≤ C_ω`, the evaluation bound gives
`|Q_k(ω) - T(ω)| ≤ |S_k(ω)| + |R_k(dω)| ≤ ρ_k c (C_ω M(∂T) + C_{dω} M(T)) → 0`, so `Q_k ⇀ T` and
`∂Q_k ⇀ ∂T`.  Since `∂∂Q_k = 0`, `M_W(∂Q_k) + M_W(∂∂Q_k) ≤ c M(∂T)` for every `W`, and (CL) in
`U = ℝᴾ` shows that `∂T` is integer multiplicity. -/
theorem Submission.cbr_bim_boundary_im_of_compact_support : (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → ∀ (P : ℕ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (K : Set (Euclid P)), IsCompact K → IsIntegerMultiplicity T → T.support ⊆ K → T.mass < ∞ → T.boundary.mass < ∞ → IsIntegerMultiplicity T.boundary := by
  -- `M_W(0) = 0`, and `boundaryMassOn (∂Z) W = 0` because `∂∂Z = 0` (or `∂ = 0` in degree `0`)
  have massOn_zero_aux : ∀ {P m : ℕ} {U : Set (Euclid P)} (W : Set (Euclid P)),
      (0 : GeometricCurrentOn U m).massOn W = 0 := by
    intro P m U W
    apply le_antisymm _ bot_le
    apply sSup_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  have boundaryMassOn_boundary_aux : ∀ {P : ℕ} {U : Set (Euclid P)} (k : ℕ)
      (Z : GeometricCurrentOn U (k + 1)) (W : Set (Euclid P)), boundaryMassOn Z.boundary W = 0 := by
    intro P U k Z W
    cases k with
    | zero => rfl
    | succ m =>
      change Z.boundary.boundary.massOn W = 0
      rw [GeometricCurrentOn.boundary_boundary]
      exact massOn_zero_aux W
  intro hDT d hCL P T K hK hT hTK hm hbm
  -- Step 1: constants, `Λ = M(T)`
  obtain ⟨c, -, hc⟩ := hDT P d
  set Λ : NNReal := T.mass.toNNReal with hΛdef
  have hΛ : T.mass ≤ Λ := by rw [hΛdef, ENNReal.coe_toNNReal hm.ne]
  -- Step 2: the deformation theorem with `ρ_k = 2⁻ᵏ`
  have hρ : ∀ k : ℕ, (0 : ℝ) < (1 / 2 : ℝ) ^ k := fun k => by positivity
  choose 𝒬 _ h𝒬 using fun k : ℕ => hc ((1 / 2 : ℝ) ^ k) K Λ (hρ k) hK
  choose Q _ R S _ hQb _ hEq _ _ hQbm hRm hSm _ _ using fun k => h𝒬 k T hT hTK hΛ hbm
  -- Step 3: a uniform bound for the Euclidean coefficient norm of a test form
  have hbound : ∀ {m : ℕ} (ω : TestFormOn (univ : Set (Euclid P)) m), ∃ C : ℝ, 0 < C ∧
      ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) ≤ C := by
    intro m ω
    have hω1 : IsSmoothForm (ω : DifferentialForm (Euclid P) m) := ω.property.1.1
    have hω2 : HasCompactSupport (ω : DifferentialForm (Euclid P) m) := ω.property.1.2
    have hωc : Continuous (ω : DifferentialForm (Euclid P) m) := hω1.continuous
    have hcont :
        Continuous fun x => covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) :=
      (Submission.rsd_mw_tfa_norm_props P m).2.2.2.comp hωc
    have hcs :
        HasCompactSupport fun x => covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) :=
      hω2.comp_left (g := fun α : Covector (Euclid P) m => covectorEuclideanNorm α)
        (covectorEuclideanNorm_zero P m)
    obtain ⟨C, hC⟩ := hcs.exists_bound_of_continuous hcont
    refine ⟨max C 1, lt_max_of_lt_right one_pos, fun x => ?_⟩
    exact (le_abs_self _).trans ((Real.norm_eq_abs _ ▸ hC x).trans (le_max_left _ _))
  -- Step 4: `Q_k ⇀ T`, from `|Q_k(ω) - T(ω)| ≤ |S_k(ω)| + |R_k(dω)| ≤ ρ_k A`
  have hconv : WeaklyConvergesOn Q T := by
    intro ω
    obtain ⟨C₁, hC₁, hb₁⟩ := hbound ω
    obtain ⟨C₂, hC₂, hb₂⟩ := hbound (exteriorDerivativeTestOn univ (d + 1) ω)
    set A : ℝ≥0∞ := ENNReal.ofReal C₁ * ((c : ℝ≥0∞) * T.boundary.mass) +
      ENNReal.ofReal C₂ * ((c : ℝ≥0∞) * T.mass) with hA
    have hAfin : A ≠ ∞ := by
      rw [hA]
      exact ENNReal.add_ne_top.mpr ⟨ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.mul_ne_top ENNReal.coe_ne_top hbm.ne), ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.mul_ne_top ENNReal.coe_ne_top hm.ne)⟩
    have hkey : ∀ k, |Q k ω - T ω| ≤ (1 / 2 : ℝ) ^ k * A.toReal := by
      intro k
      have e : T ω - Q k ω - S k ω = R k (exteriorDerivativeTestOn univ (d + 1) ω) := by
        have := congrArg (fun Z : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1) => Z ω) (hEq k)
        exact this
      have hS : (S k).massOn univ ≤
          (c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.boundary.mass := hSm k
      have hR : (R k).massOn univ ≤ (c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.mass := hRm k
      have hSfin : (S k).massOn univ ≠ ∞ := ne_top_of_le_ne_top
        (ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top) hbm.ne) hS
      have hRfin : (R k).massOn univ ≠ ∞ := ne_top_of_le_ne_top
        (ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top) hm.ne) hR
      -- evaluation bound `|X(φ)| ≤ C · M(X)` (`cmr_abs_apply_le_massOn`), in `ℝ≥0∞`
      have h1 : ENNReal.ofReal |S k ω| ≤ ENNReal.ofReal C₁ * (S k).massOn univ := by
        have h := Submission.cmr_abs_apply_le_massOn P (d + 1) univ univ (S k) ω C₁ hSfin
          (subset_univ _) hb₁
        calc ENNReal.ofReal |S k ω| ≤ ENNReal.ofReal (C₁ * ((S k).massOn univ).toReal) :=
              ENNReal.ofReal_le_ofReal h
          _ = ENNReal.ofReal C₁ * (S k).massOn univ := by
              rw [ENNReal.ofReal_mul hC₁.le, ENNReal.ofReal_toReal hSfin]
      have h2 : ENNReal.ofReal |R k (exteriorDerivativeTestOn univ (d + 1) ω)| ≤
          ENNReal.ofReal C₂ * (R k).massOn univ := by
        have h := Submission.cmr_abs_apply_le_massOn P (d + 2) univ univ (R k)
          (exteriorDerivativeTestOn univ (d + 1) ω) C₂ hRfin (subset_univ _) hb₂
        calc ENNReal.ofReal |R k (exteriorDerivativeTestOn univ (d + 1) ω)| ≤
              ENNReal.ofReal (C₂ * ((R k).massOn univ).toReal) := ENNReal.ofReal_le_ofReal h
          _ = ENNReal.ofReal C₂ * (R k).massOn univ := by
              rw [ENNReal.ofReal_mul hC₂.le, ENNReal.ofReal_toReal hRfin]
      have hle : ENNReal.ofReal |Q k ω - T ω| ≤ ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * A := by
        have habs : |Q k ω - T ω| ≤ |S k ω| + |R k (exteriorDerivativeTestOn univ (d + 1) ω)| := by
          rw [← e]
          calc |Q k ω - T ω| = |-(S k ω) - (T ω - Q k ω - S k ω)| := by ring_nf
            _ ≤ |-(S k ω)| + |T ω - Q k ω - S k ω| := abs_sub _ _
            _ = |S k ω| + |T ω - Q k ω - S k ω| := by rw [abs_neg]
        calc ENNReal.ofReal |Q k ω - T ω|
            ≤ ENNReal.ofReal |S k ω| +
                ENNReal.ofReal |R k (exteriorDerivativeTestOn univ (d + 1) ω)| :=
              (ENNReal.ofReal_le_ofReal habs).trans ENNReal.ofReal_add_le
          _ ≤ ENNReal.ofReal C₁ *
                ((c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.boundary.mass) +
              ENNReal.ofReal C₂ * ((c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.mass) := by
              gcongr
              · exact h1.trans (by gcongr)
              · exact h2.trans (by gcongr)
          _ = ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * A := by rw [hA]; ring
      have := ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hAfin) hle
      rwa [ENNReal.toReal_ofReal (abs_nonneg _), ENNReal.toReal_mul,
        ENNReal.toReal_ofReal (hρ k).le] at this
    rw [tendsto_iff_dist_tendsto_zero]
    have hlim : Tendsto (fun k : ℕ => (1 / 2 : ℝ) ^ k * A.toReal) atTop (𝓝 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
        (by norm_num : (1 / 2 : ℝ) < 1)).mul_const A.toReal
    exact squeeze_zero (fun k => dist_nonneg) (fun k => by rw [Real.dist_eq]; exact hkey k) hlim
  -- Steps 5–7: `∂Q_k ⇀ ∂T`, `M_W(∂Q_k) + M_W(∂∂Q_k) ≤ c M(∂T)`, and the closure theorem
  refine hCL P univ (fun k => (Q k).boundary) T.boundary isOpen_univ hQb ?_ hconv.boundary
  intro W _ _
  refine lt_of_le_of_lt (b := (c : ℝ≥0∞) * T.boundary.mass) (iSup_le fun k => ?_)
    (ENNReal.mul_lt_top ENNReal.coe_lt_top hbm)
  rw [boundaryMassOn_boundary_aux d (Q k) W, add_zero]
  exact ((Q k).boundary.massOn_mono (subset_univ W)).trans (hQbm k)
/-- **Simon Ch. 6, 8.2 for `n = 0`** (the case the book calls trivial): a weak limit of integer
multiplicity `0`-currents with `supⱼ M_W(Tⱼ) < ∞` for `W ⊂⊂ U` is integer multiplicity.  The
hypotheses are (REP), (MR) and (IMC) of `Submission.cbr_isIntegerMultiplicity_of_local`.  By lower
semicontinuity of mass `T` has locally finite mass.  For `x₀ ∈ U` and `B = B_{2r}(x₀) ⊂⊂ U`, each
`Tⱼ` is a point sum `Σₗ w_{j,l}⟨ω(x_{j,l})⟩` on `B` with `Σₗ |w_{j,l}| ≤ M_B(Tⱼ) < C`
(`Submission.cbrz_imrep_zero_local_point_sum` and (MR)).  On `B_r(x₀)` the weak limit is again
a finite integer point sum (`Submission.cbrz_point_sum_limit`), hence integer multiplicity
(`Submission.cbrz_isIntegerMultiplicity_point_sum`), and these local representations glue. -/
theorem Submission.cbr_closure_degree_zero : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U 0) (T : GeometricCurrentOn U 0), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
  intro hREP hMR hIMC P U Ts T hU hTs hbound hconv
  -- Step 7: by part (1) of `cbr_isIntegerMultiplicity_of_local` it suffices that `T` has
  -- locally finite mass and is integer multiplicity near each point of `U`
  refine (Submission.cbr_isIntegerMultiplicity_of_local hREP hMR hIMC P 0 U T hU).1 ?_ ?_
  · -- Step 2: `M_W(T) ≤ liminf_j M_W(T_j) ≤ sup_j (M_W(T_j) + M_W(∂T_j)) < ∞`
    intro W hW hWU
    refine lt_of_le_of_lt ?_ (hbound W hW hWU)
    calc T.massOn W ≤ liminf (fun j => (Ts j).massOn W) atTop := hconv.massOn_le_liminf W
      _ ≤ limsup (fun j => (Ts j).massOn W) atTop := liminf_le_limsup
      _ ≤ ⨆ j, (Ts j).massOn W := limsup_le_iSup
      _ ≤ ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) := iSup_mono fun j => le_self_add
  · -- Step 3: `B_r(x₀) ⊆ U` and `B = B_{2r}(x₀) ⊂⊂ U` for `r = ε/3`, `B_ε(x₀) ⊆ U`
    intro x₀ hx₀
