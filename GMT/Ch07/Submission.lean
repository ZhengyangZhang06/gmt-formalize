  have hE : ∀ j, (homot m (fun x => x) (φ (j + 1)) (D (j + 1))).mass ≤
      ENNReal.ofReal (Real.sqrt P * (2 * c₄) ^ m * C * (1 / 2) ^ j) * T.boundary.mass := fun j =>
    ((hhD (j + 1)).2.2.2.2.2 (Real.sqrt P) (hδ (j + 1))).trans (key (Real.sqrt P) (2 * c₄) C _ _
