    intro a ha
    have hu : HasFDerivAt u (fderiv ℝ u a) a :=
      ((hgood a ha).2.2.1.differentiableAt one_ne_zero).hasFDerivAt
    exact (ι.toContinuousLinearMap.hasFDerivAt.const_add y).add
