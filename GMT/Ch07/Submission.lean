    · -- the wedge `β(w) = det(⟨τ'ᵢ, w_k⟩)`
      obtain ⟨β, hβ⟩ : ∃ β : Covector (Euclid P) (m + 1), ∀ w : Fin (m + 1) → Euclid P,
