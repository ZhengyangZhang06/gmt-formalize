          rw [harea, ← lintegral_indicator hΩt]
          refine lintegral_congr_ae (ht.mono fun s hs => ?_)
          show f (Θ.symm (WithLp.toLp 2 (t, s))) = _
          by_cases hsΩ : Θ.symm (WithLp.toLp 2 (t, s)) ∈ Ω k
