  obtain ⟨S₀, hS₀⟩ := Submission.dtc_imrep_current P m univ R₀
  have hR₀L : R₀.carrier ⊆ (Lᗮ : Set (Euclid P)) := by
    intro z hz
    rw [hR₀C, mem_preimage, hRt₀C] at hz
    have h := hz.2
    simp only [mem_ofPred_eq, sub_neg_eq_add, map_add, hpfix t₀ ht₀L] at h
