          a ^ 2 - 2 * H ^ 2 ≤ 2 * c' * d) ∧
        (∀ X H c' I Ψ' C' P V Vr C₆' : ℝ, 0 < V → Vr = V →
          C₆' = 2 * H ^ 2 + 2 * c' * C' * P / V → (X - 2 * H ^ 2) * Vr ≤ I → I = 2 * c' * Ψ' →
          Ψ' ≤ C' * P → 0 ≤ c' → X ≤ C₆') ∧
        (∀ c A T B t b C' : ℝ, 0 ≤ t → 0 < T → C' = c * (A / T ^ b + B) →
