    obtain ⟨h₅', -⟩ := hhom m (Λ j) (φ j) (φ j) (E j) X (hφ j) (hφ j) (hEc j) hX hbdIM hXE
    rw [hid (m + 1) (E j) X (hEc j) hX hXE] at h₅
    refine ⟨fun η => ?_, fun ω => ?_⟩
    · have h := congrArg (fun T => T η) h₅
