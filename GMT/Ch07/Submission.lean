        intro z
        refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ?_ fun w hw => ?_
        · rw [hspan_eq]; exact ⟨_, rfl⟩
        · rw [hspan_eq] at hw
          obtain ⟨x, rfl⟩ := hw
          rw [ContinuousLinearMap.coe_coe, ← ContinuousLinearMap.adjoint_inner_left, map_sub, hAAR,
