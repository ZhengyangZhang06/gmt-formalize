  have : SigmaFinite (μHE[m].restrict (R.carrier ∩ {x | L.starProjection x = t₀})) := by
    rw [← hRt₀C]; exact hsf m Rt₀
  have hF1 : ∀ᵐ v ∂(μHE[d].restrict (L : Set (Euclid P))),
