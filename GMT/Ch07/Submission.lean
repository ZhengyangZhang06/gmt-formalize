    refine setIntegral_congr_fun hηM fun y hy => ?_
    obtain ⟨x, hx, rfl⟩ := hy
    simp only [hηinv x, ENNReal.toReal_ofReal (hθpos x hx).le, _root_.smul_apply]
  exact ⟨hP0, hP7, hP1, hP2, (hζ.comp_measurable hAmeas).aestronglyMeasurable, hP5, hP6, hP8⟩


