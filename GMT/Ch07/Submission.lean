              (W.starProjection (EuclideanSpace.single i 1))) (τ d : Euclid P) ^ 2 :=
            Finset.sum_comm
        _ = ∑ c, ∑ d, ∑ i : Fin P, inner ℝ (Φ (τ c : Euclid P)
              (W.starProjection (EuclideanSpace.single i 1))) (τ d : Euclid P) ^ 2 :=
            Finset.sum_congr rfl fun c _ => Finset.sum_comm
