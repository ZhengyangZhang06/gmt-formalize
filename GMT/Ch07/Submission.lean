    exact ⟨{ θ₀ with
      cont := (Continuous.matrix_det (A := fun v : Fin n → Euclid P => Matrix.of fun k j => v j (I k))
        (continuous_matrix fun k j => (PiLp.continuous_apply 2 _ (I k)).comp (continuous_apply j))).congr
          fun v => (hθ₀ v).symm }, hθ₀⟩
