    classical
    exact ⟨fun f => if hf : MemLp f 2 μ then hf.toLp f else 0, fun f hf => by simp [hf]⟩
  set H := PiLp 2 (fun _ : Fin m => Lp (Euclid k) 2 μ) with hH
  let toH : (Fin m → Euclid m → Euclid k) → H := fun u => WithLp.toLp 2 fun j => toH₀ (u j)
