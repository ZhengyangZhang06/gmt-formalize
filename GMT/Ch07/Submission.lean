  -- 5A: `μ(B_{σ₀/2}(ξ) ∖ F) ≤ μ(B_{3σ₀/4}(ξ) ∖ G)`, plus the hole estimate
  have h5A : R.measure (closedBall ξ (σ₀ / 2) \ F) +
      μHE[n] ((F \ R.measure.support) ∩ closedBall ξ (σ₀ / 4)) ≤
