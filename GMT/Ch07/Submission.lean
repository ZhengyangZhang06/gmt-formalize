/-- **Face representation** (Simon Ch. 6, proof of 5.1, (26)–(28) and (33)).  Let
`Q ∈ 𝒟ₙ(ℝᴾ)`, `n = m + 1`, be integer multiplicity and vanish off the closed set `E`, `Hⁿ`-almost
all of which lies in the open unit faces `A_p = Φ_p(Q₁)`, `p ∈ s`.  Then
`Q(ω) = Σ_p ∫_{Q₁} u_p(y) ω(Φ_p(y))(e_p) dy` with integer-valued `u_p` integrable on `Q₁` and
`Σ_p ∫_{Q₁} |u_p| ≤ M(Q)`.  For an `IMRep` `(M, θ, ξ)` of `Q`, `μ_Q(ℝᴾ ∖ E) = M_{ℝᴾ∖E}(Q) = 0`, so
`M` lies `Hⁿ`-a.e. in the pairwise disjoint `A_p`.  On `M_p = M ∩ A_p ⊆ z + V_ι`, `TₓM_p = TₓM`
a.e., so `ξ = σ_p e_p^*` a.e. for a Borel sign `σ_p`, read off from `ξ(dx^ι)`.  Then
`u_p = (θ σ_p 1_{M_p}) ∘ Φ_p`, and `Hⁿ⌞F_p = Φ_p#(volume⌞Q₁)` transports the integrals. -/
theorem Submission.dor_lmb_fcd_fr_face_representation : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (E : Set (Euclid P)) (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) → IsClosed E → (∀ᵐ x ∂(μHE[m + 1].restrict E), ∃ p ∈ s, ∃ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) ∧ WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) = x) → IsIntegerMultiplicity Q → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) E → Q ω = 0) → ∃ u : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → ℝ, (∀ p ∈ s, ∀ y, ∃ z : ℤ, u p y = z) ∧ (∀ p ∈ s, IntegrableOn (u p) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) ∧ ENNReal.ofReal (∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y|) ≤ Q.mass ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Q ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
  intro P m s E Q hs hE hcov hQ hvan
  classical
  obtain ⟨R, hR⟩ := hQ
  -- `Φ_p(y) = z + Σ_j y_j e_{ι(j)}`, the open cube `Q₁ = (0, 1)ⁿ` and the closed face `F_p`
  set Φ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → Euclid P := fun p y =>
    WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  set Q₁ : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}
  set F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P) := fun p =>
    {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
      (i ∉ Set.range p.2 → x i = p.1 i)}
  /- Step 1 (face geometry): `Hⁿ⌞F_p = Φ_p#(volume⌞Q₁)`, `∫_{F_p} h dHⁿ = ∫_{Q₁} h ∘ Φ_p`,
  `Φ_p(Q̄₁) ⊆ F_p`, `Φ_p` is an isometry, `F_p` is closed and bounded, and the open face
  `A_p = Φ_p(Q₁)` misses every other face `F_q`. -/
  have hF3 : ∀ p ∈ s, (μHE[m + 1] : Measure (Euclid P)).restrict (F p) =
      Measure.map (Φ p) (volume.restrict Q₁) := fun p hp =>
    (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.1
  have hF4 : ∀ p ∈ s, ∀ h : Euclid P → ℝ,
      ∫ x in F p, h x ∂μHE[m + 1] = ∫ y in Q₁, h (Φ p y) := fun p hp =>
    (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.1
  have hF5 : ∀ p ∈ s, ∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ p y ∈ F p :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.1
  have hF6 : ∀ p ∈ s, ∀ y y' : Euclid (m + 1), dist (Φ p y) (Φ p y') = dist y y' :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.1
  have hF7 : ∀ p ∈ s, ∀ x ∈ F p, ∀ x' ∈ F p, dist x x' ≤ Real.sqrt P :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.2.1
  have hF8 : ∀ p ∈ s, IsClosed (F p) :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.2.2.1
  have hF9 : ∀ p ∈ s, ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P), StrictMono q.2 → q ≠ p →
      ∀ y ∈ Q₁, Φ p y ∉ F q :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.2.2.2
  have hFc : ∀ p ∈ s, IsCompact (F p) := fun p hp =>
    isCompact_of_isClosed_isBounded (hF8 p hp) (isBounded_iff.mpr ⟨_, hF7 p hp⟩)
  have hΦemb : ∀ p ∈ s, MeasurableEmbedding (Φ p) := fun p hp =>
    (Isometry.of_dist_eq (hF6 p hp)).isClosedEmbedding.measurableEmbedding
  have hQ₁m : MeasurableSet Q₁ := by
    have hQ₁' : Q₁ = ⋂ i, {y : Euclid (m + 1) | 0 < y i} ∩ {y | y i < 1} := by
      ext y
      simp only [Q₁, Set.mem_ofPred_eq, mem_iInter, mem_inter_iff]
    rw [hQ₁']
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const (PiLp.continuous_apply 2 _ i).measurable).inter
        (measurableSet_lt (PiLp.continuous_apply 2 _ i).measurable measurable_const)
  have hAm : ∀ p ∈ s, MeasurableSet (Φ p '' Q₁) := fun p hp =>
    (hΦemb p hp).measurableSet_image.mpr hQ₁m
  have hAF : ∀ p ∈ s, Φ p '' Q₁ ⊆ F p := by
    rintro p hp _ ⟨y, hy, rfl⟩
    exact hF5 p hp y fun i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hAdisj : (s : Set ((Fin P → ℤ) × (Fin (m + 1) → Fin P))).PairwiseDisjoint
      fun p => Φ p '' Q₁ := by
    intro p hp q hq hpq
    refine Set.disjoint_left.mpr ?_
    rintro _ ⟨y, hy, rfl⟩ hyq
    exact hF9 p hp q (hs q hq) (Ne.symm hpq) y hy (hAF q hq hyq)
  /- Step 2: an integer multiplicity representation `R = (M, θ, ξ)` of `Q`, its measure
  `μ_R = θ Hⁿ⌞M`, and `M_W(Q) = μ_R(W)` for open `W` (C1). -/
  have hMm : MeasurableSet R.carrier := R.measurableSet_carrier
  have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  have hθm' : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hfinθ : ∀ K : Set (Euclid P), IsCompact K →
      ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ :=
    fun K hK => R.locallyIntegrable_mult K hK (subset_univ K)
  -- `Hⁿ(M ∩ B) ≤ ∫_{M ∩ B} θ dHⁿ`, as `θ ≥ 1` on `M`
  have hHle : ∀ B : Set (Euclid P),
      μHE[m + 1] (R.carrier ∩ B) ≤ ∫⁻ x in R.carrier ∩ B, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] := by
    intro B
    calc μHE[m + 1] (R.carrier ∩ B) = ∫⁻ _ in R.carrier ∩ B, (1 : ℝ≥0∞) ∂μHE[m + 1] := by
          rw [setLIntegral_one]
      _ ≤ ∫⁻ x in R.carrier ∩ B, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] := by
          refine setLIntegral_mono hθm' ?_
          intro x hx
          exact_mod_cast R.mult_pos x hx.1
  have hfinM : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ → μHE[m + 1] (R.carrier ∩ K) ≠ ∞ :=
    fun K hK _ => ne_top_of_le_ne_top (hfinθ K hK) (hHle K)
  have hμR : ∀ B : Set (Euclid P), MeasurableSet B →
      R.measure B = ∫⁻ x in R.carrier ∩ B, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] := by
    intro B hB
    rw [IMRep.measure, withDensity_apply _ hB, Measure.restrict_restrict hB, inter_comm]
  have hC1 := (Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ Q R isOpen_univ
    hR).1
  /- Step 3: `M` is carried by the open faces.  `M_{ℝᴾ∖E}(Q) = 0` since every admissible form is
  supported off `E`, so `Hⁿ(M ∖ E) = 0`; and `Hⁿ(E ∖ ⋃_p A_p) = 0` by hypothesis. -/
  have hmassEc : Q.massOn Eᶜ = 0 := by
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, ⟨hωE, -⟩, rfl⟩
    show ENNReal.ofReal (Q ω) ≤ 0
    rw [hvan ω (subset_compl_iff_disjoint_right.mp hωE), ENNReal.ofReal_zero]
  have hMEc : μHE[m + 1] (R.carrier ∩ Eᶜ) = 0 := by
    refine le_antisymm ((hHle Eᶜ).trans (le_of_eq ?_)) zero_le
    rw [← hμR Eᶜ hE.isOpen_compl.measurableSet, ← hC1 Eᶜ hE.isOpen_compl, hmassEc]
  have hEcov : μHE[m + 1] (E \ ⋃ p ∈ s, Φ p '' Q₁) = 0 := by
    have h := ae_iff.mp hcov
    rw [Measure.restrict_apply' hE.measurableSet] at h
    refine measure_mono_null ?_ h
    rintro x ⟨hxE, hxA⟩
    refine ⟨?_, hxE⟩
    rintro ⟨p, hp, y, hy, hxy⟩
    exact hxA (mem_iUnion₂.mpr ⟨p, hp, y, hy, hxy⟩)
  -- the pieces `M_p = M ∩ A_p`
  obtain ⟨Mp, hMp⟩ : ∃ Mp : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P),
      ∀ p, Mp p = R.carrier ∩ Φ p '' Q₁ := ⟨_, fun _ => rfl⟩
  have hMpm : ∀ p ∈ s, MeasurableSet (Mp p) := fun p hp => by
    rw [hMp p]
    exact hMm.inter (hAm p hp)
  have hMpM : ∀ p, Mp p ⊆ R.carrier := fun p => by
    rw [hMp p]
    exact inter_subset_left
  have hMpF : ∀ p ∈ s, Mp p ⊆ F p := fun p hp => by
    rw [hMp p]
    exact inter_subset_right.trans (hAF p hp)
  have hMpdisj : (s : Set ((Fin P → ℤ) × (Fin (m + 1) → Fin P))).PairwiseDisjoint Mp :=
    hAdisj.mono fun p => by
      rw [hMp p]
      exact inter_subset_right
  have hMae : R.carrier =ᵐ[μHE[m + 1]] ⋃ p ∈ s, Mp p := by
    refine ae_eq_set.mpr ⟨measure_mono_null ?_ (measure_union_null hMEc hEcov), ?_⟩
    · rintro x ⟨hxM, hx⟩
      by_cases hxE : x ∈ E
      · refine mem_union_right _ ⟨hxE, fun hxA => hx ?_⟩
        obtain ⟨p, hp, hxp⟩ := mem_iUnion₂.mp hxA
        refine mem_iUnion₂.mpr ⟨p, hp, ?_⟩
        rw [hMp p]
        exact ⟨hxM, hxp⟩
      · exact mem_union_left _ ⟨hxM, hxE⟩
    · rw [sdiff_eq_empty.mpr (iUnion₂_subset fun p _ => hMpM p)]
      exact measure_empty
  /- Steps 4–5: on `M_p`, `ξ = σ_p e_p^*` a.e. for a Borel sign `σ_p`.  The orientation `ξ(x)`
  orients `TₓM = TₓM_p` (IMC(a)); `M_p ⊆ z + V_ι`, so `ξ(x) = ±e_p^*` (plane orientation); the
  sign is read off from `ξ'(x)(dx^ι)` with `dx^ι(e_p) = 1` and `ξ'` a Borel version of `ξ`. -/
  obtain ⟨dx, hdx, -⟩ := Submission.dor_lmb_fcd_fr_coordinate_covectors P (m + 1)
  have hdxe : ∀ p ∈ s, dx p.2 (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) = 1 :=
    fun p hp => (hdx p.2 p.2 (hs p hp) (hs p hp)).trans (ite_eq_left rfl)
  obtain ⟨ξ', hξ'm, hξξ'⟩ : ∃ ξ' : Euclid P → MultiVector P (m + 1), StronglyMeasurable ξ' ∧
      R.orient =ᵐ[μHE[m + 1].restrict R.carrier] ξ' :=
    ⟨_, R.aestronglyMeasurable_orient.stronglyMeasurable_mk,
      R.aestronglyMeasurable_orient.ae_eq_mk⟩
  obtain ⟨σ, hσ⟩ : ∃ σ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid P → ℝ,
      ∀ p x, σ p x = if 0 ≤ ξ' x (dx p.2) then 1 else -1 := ⟨_, fun _ _ => rfl⟩
  have hσm : ∀ p, Measurable (σ p) := by
    intro p
    have hev : Measurable fun x => ξ' x (dx p.2) :=
      ((continuous_eval_const (dx p.2)).comp_stronglyMeasurable hξ'm).measurable
    rw [show σ p = fun x => if 0 ≤ ξ' x (dx p.2) then (1 : ℝ) else -1 from funext (hσ p)]
    exact Measurable.ite (measurableSet_le measurable_const hev) measurable_const measurable_const
  have hσabs : ∀ p x, |σ p x| = 1 := by
    intro p x
    rw [hσ p x]
    split_ifs <;> simp
  have hor : ∀ p ∈ s, ∀ᵐ x ∂(μHE[m + 1].restrict (Mp p)), ∀ α : Covector (Euclid P) (m + 1),
      R.orient x α = σ p x * α (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
    intro p hp
    -- (b) `TₓM_p = TₓM` a.e. on `M_p` (IMC(a))
    have hIMC := Submission.cmc_imRep_locality_restrict_sub.1 P (m + 1) univ (Mp p) R.carrier
      isOpen_univ (hMpm p hp) hMm (hMpM p) (subset_univ _) hfinM
    -- (a) `ξ(x)` orients `TₓM` a.e. on `M ⊇ M_p`
    have hori : ∀ᵐ x ∂(μHE[m + 1].restrict (Mp p)), ∃ Q' : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt (m + 1) R.carrier x Q' ∧
          IsUnitOrientationOf (R.orient x) Q' :=
      ae_restrict_of_ae_restrict_of_subset (hMpM p) R.orients
    have hξ'p : ∀ᵐ x ∂(μHE[m + 1].restrict (Mp p)), R.orient x = ξ' x :=
      ae_restrict_of_ae_restrict_of_subset (hMpM p) hξξ'
    filter_upwards [hIMC, hori, hξ'p, ae_restrict_mem (hMpm p hp)] with x hxT hxo hxξ hxM
    obtain ⟨Q', hQ'M, hQ'ξ⟩ := hxo
    -- (c) `M_p ⊆ F_p` lies in the plane `x_i = z_i` (`i ∉ range ι`)
    have hcoord : ∀ a ∈ Mp p, ∀ i, (∀ j, p.2 j ≠ i) → a i = x i := by
      intro a ha i hi
      have hi' : i ∉ Set.range p.2 := by
        rintro ⟨j, hj⟩
        exact hi j hj
      have haF : ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ a i ∧ a i ≤ p.1 i + 1) ∧
          (i ∉ Set.range p.2 → a i = p.1 i) := hMpF p hp ha
      have hxF : ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
          (i ∉ Set.range p.2 → x i = p.1 i) := hMpF p hp hxM
      rw [(haF i).2 hi', (hxF i).2 hi']
    rcases Submission.dor_lmb_fcd_fr_plane_orientation P (m + 1) p.2 (Mp p) x Q' (R.orient x)
        (hs p hp) hcoord ((hxT Q').mpr hQ'M) hQ'ξ with h | h
    · -- `ξ(x) = e_p^*`, so `ξ'(x)(dx^ι) = 1` and `σ_p(x) = 1`
      have hv : ξ' x (dx p.2) = 1 := by
        rw [← hxξ, h, hdxe p hp]
      intro α
      rw [h α, hσ p x, ite_eq_left (by rw [hv]; exact zero_le_one), one_mul]
    · -- `ξ(x) = -e_p^*`, so `ξ'(x)(dx^ι) = -1` and `σ_p(x) = -1`
      have hv : ξ' x (dx p.2) = -1 := by
        rw [← hxξ, h, hdxe p hp]
      intro α
      rw [h α, hσ p x, ite_eq_right (by rw [hv]; norm_num), neg_one_mul]
  /- Step 6: the densities `f_p = θ σ_p 1_{M_p}` on `ℝᴾ` and `u_p = f_p ∘ Φ_p` on `ℝⁿ`. -/
  obtain ⟨f, hf⟩ : ∃ f : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid P → ℝ,
      ∀ p, f p = (Mp p).indicator fun x => (R.mult x : ℝ) * σ p x := ⟨_, fun _ => rfl⟩
  have hfm : ∀ p ∈ s, Measurable (f p) := fun p hp => by
    rw [hf p]
    exact (hθm.mul (hσm p)).indicator (hMpm p hp)
  have hfabs : ∀ p x, |f p x| = (Mp p).indicator (fun x => (R.mult x : ℝ)) x := by
    intro p x
    rw [hf p]
    by_cases hx : x ∈ Mp p
    · rw [indicator_of_mem hx, indicator_of_mem hx, abs_mul, hσabs, mul_one, Nat.abs_cast]
    · rw [indicator_of_notMem hx, indicator_of_notMem hx, abs_zero]
  /- Step 7: integrability and the mass bound.  `∫_{M_p} θ dHⁿ ≤ ∫_{M ∩ F_p} θ dHⁿ < ∞`. -/
  have hlin : ∀ p ∈ s, ∫⁻ x in Mp p, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ := fun p hp =>
    ne_top_of_le_ne_top (hfinθ (F p) (hFc p hp))
      (lintegral_mono_set (subset_inter (hMpM p) (hMpF p hp)))
  have hθint : ∀ p ∈ s, IntegrableOn (fun x => (R.mult x : ℝ)) (Mp p) μHE[m + 1] := by
    intro p hp
    have h := integrable_toReal_of_lintegral_ne_top hθm'.aemeasurable (hlin p hp)
    simp only [ENNReal.toReal_natCast] at h
    exact h
  have hfint : ∀ p ∈ s, IntegrableOn (f p) (F p) μHE[m + 1] := by
    intro p hp
    have hb : IntegrableOn ((Mp p).indicator fun x => (R.mult x : ℝ)) (F p) μHE[m + 1] := by
      refine (integrable_indicator_iff (hMpm p hp)).mpr ?_
      show Integrable _ ((μHE[m + 1].restrict (F p)).restrict (Mp p))
      rw [Measure.restrict_restrict (hMpm p hp), inter_eq_left.mpr (hMpF p hp)]
      exact hθint p hp
    exact hb.mono' (hfm p hp).aestronglyMeasurable
      (ae_of_all _ fun x => (Real.norm_eq_abs _).trans_le (hfabs p x).le)
  -- `∫_{Q₁} |u_p| = ∫_{F_p} |f_p| dHⁿ = ∫_{M_p} θ dHⁿ = μ_R(A_p)`
  have hint_eq : ∀ p ∈ s, ∫ y in Q₁, |f p (Φ p y)| = (R.measure (Φ p '' Q₁)).toReal := by
    intro p hp
    calc ∫ y in Q₁, |f p (Φ p y)| = ∫ x in F p, |f p x| ∂μHE[m + 1] :=
          (hF4 p hp fun x => |f p x|).symm
      _ = ∫ x in F p, (Mp p).indicator (fun x => (R.mult x : ℝ)) x ∂μHE[m + 1] :=
          integral_congr_ae (ae_of_all _ fun x => hfabs p x)
      _ = ∫ x in Mp p, (R.mult x : ℝ) ∂μHE[m + 1] := by
          rw [setIntegral_indicator (hMpm p hp), inter_eq_right.mpr (hMpF p hp)]
      _ = (∫⁻ x in Mp p, ENNReal.ofReal (R.mult x : ℝ) ∂μHE[m + 1]).toReal :=
          integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun x => Nat.cast_nonneg _)
            hθm.aestronglyMeasurable
      _ = (R.measure (Φ p '' Q₁)).toReal := by
          rw [hμR _ (hAm p hp), ← hMp p]
          simp only [ENNReal.ofReal_natCast]
  have hAfin : ∀ p ∈ s, R.measure (Φ p '' Q₁) ≠ ∞ := by
    intro p hp
    refine ne_top_of_le_ne_top ?_ (measure_mono (hAF p hp))
    rw [hμR (F p) (hF8 p hp).measurableSet]
    exact hfinθ (F p) (hFc p hp)
  refine ⟨fun p y => f p (Φ p y), ?_, ?_, ?_, ?_⟩
  · -- `u_p` is integer-valued: `θ ∈ ℕ`, `σ_p ∈ {1, -1}`
    intro p _ y
    show ∃ z : ℤ, f p (Φ p y) = z
    rw [hf p]
    by_cases hy : Φ p y ∈ Mp p
    · rw [indicator_of_mem hy, hσ p]
      split_ifs
      · exact ⟨R.mult (Φ p y), by push_cast; ring⟩
      · exact ⟨-(R.mult (Φ p y) : ℤ), by push_cast; ring⟩
    · exact ⟨0, by rw [indicator_of_notMem hy, Int.cast_zero]⟩
  · -- `u_p = f_p ∘ Φ_p` is integrable on `Q₁`, since `Hⁿ⌞F_p = Φ_p#(volume⌞Q₁)`
    intro p hp
    have h1 : Integrable (f p) (Measure.map (Φ p) (volume.restrict Q₁)) := by
      rw [← hF3 p hp]
      exact hfint p hp
    exact (hΦemb p hp).integrable_map_iff.mp h1
  · -- `Σ_p ∫_{Q₁} |u_p| = Σ_p μ_R(A_p) = μ_R(⋃_p A_p) ≤ μ_R(ℝᴾ) = M(Q)`
    calc ENNReal.ofReal (∑ p ∈ s, ∫ y in Q₁, |f p (Φ p y)|)
        = ∑ p ∈ s, ENNReal.ofReal (∫ y in Q₁, |f p (Φ p y)|) :=
          ENNReal.ofReal_sum_of_nonneg fun p _ => integral_nonneg fun y => abs_nonneg _
      _ = ∑ p ∈ s, R.measure (Φ p '' Q₁) := Finset.sum_congr rfl fun p hp => by
          rw [hint_eq p hp, ENNReal.ofReal_toReal (hAfin p hp)]
      _ = R.measure (⋃ p ∈ s, Φ p '' Q₁) := (measure_biUnion_finset hAdisj hAm).symm
      _ ≤ R.measure univ := measure_mono (subset_univ _)
      _ = Q.mass := (hC1 univ isOpen_univ).symm
  · /- Step 8: `Q(ω) = ∫_M θ ξ(ω) dHⁿ = Σ_p ∫_{M_p} θ σ_p ω(e_p) dHⁿ
    = Σ_p ∫_{F_p} f_p ω(e_p) dHⁿ = Σ_p ∫_{Q₁} u_p ω(Φ_p(·))(e_p)`. -/
    intro ω
    show Q ω = ∑ p ∈ s, ∫ y in Q₁, f p (Φ p y) * (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y)
      (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))
    obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
    -- `x ↦ ω(x)(e_p)` is continuous with compact support, hence bounded
    have hωe : ∀ p : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
        Continuous (fun x => (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) ∧
        ∃ C, ∀ x, ‖(ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))‖ ≤ C := by
      intro p
      have hc := hsmooth.continuous.eval_const (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))
      refine ⟨hc, hc.bounded_above_of_compact_support ?_⟩
      exact hcpt.comp_left (g := fun α : Covector (Euclid P) (m + 1) =>
        α (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) rfl
    -- the integrand `g = θ ξ(ω)` of `Q(ω)` is `θ σ_p ω(e_p)` a.e. on `M_p`
    obtain ⟨g, hg⟩ : ∃ g : Euclid P → ℝ, ∀ x,
        g x = (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) :=
      ⟨_, fun _ => rfl⟩
    have hk : ∀ p ∈ s, g =ᵐ[μHE[m + 1].restrict (Mp p)] fun x => (R.mult x : ℝ) * σ p x *
        (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
      intro p hp
      filter_upwards [hor p hp] with x hx
      rw [hg x, hx, mul_assoc]
    have hkint : ∀ p ∈ s, IntegrableOn (fun x => (R.mult x : ℝ) * σ p x *
        (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) (Mp p) μHE[m + 1] := by
      intro p hp
      have hθσ : IntegrableOn (fun x => (R.mult x : ℝ) * σ p x) (Mp p) μHE[m + 1] := by
        refine (hθint p hp).mono' (hθm.mul (hσm p)).aestronglyMeasurable (ae_of_all _ fun x => ?_)
        rw [Real.norm_eq_abs, abs_mul, hσabs, mul_one, Nat.abs_cast]
      obtain ⟨hc, C, hC⟩ := hωe p
      exact hθσ.mul_bdd hc.aestronglyMeasurable (ae_of_all _ hC)
    have hgint : ∀ p ∈ s, IntegrableOn g (Mp p) μHE[m + 1] := fun p hp =>
      (hkint p hp).congr (hk p hp).symm
    -- each piece transported to the cube
    have hpiece : ∀ p ∈ s, ∫ x in Mp p, g x ∂μHE[m + 1] = ∫ y in Q₁, f p (Φ p y) *
        (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y)
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
      intro p hp
      have hfun : (fun x => f p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) = fun x => (Mp p).indicator
            (fun x => (R.mult x : ℝ) * σ p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
              (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) x := by
        funext x
        rw [hf p]
        exact (indicator_mul_left (Mp p) (fun x => (R.mult x : ℝ) * σ p x) fun x =>
          (ω : DifferentialForm (Euclid P) (m + 1)) x
            (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))).symm
      calc ∫ x in Mp p, g x ∂μHE[m + 1]
          = ∫ x in Mp p, (R.mult x : ℝ) * σ p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
              (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1] :=
            integral_congr_ae (hk p hp)
        _ = ∫ x in F p, f p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
              (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1] := by
            rw [hfun, setIntegral_indicator (hMpm p hp), inter_eq_right.mpr (hMpF p hp)]
        _ = _ := hF4 p hp _
    calc Q ω = ∫ x in R.carrier, g x ∂μHE[m + 1] := by
          rw [hR ω, IMRep.action]
          exact integral_congr_ae (ae_of_all _ fun x => (hg x).symm)
      _ = ∫ x in ⋃ p ∈ s, Mp p, g x ∂μHE[m + 1] := setIntegral_congr_set hMae
      _ = ∑ p ∈ s, ∫ x in Mp p, g x ∂μHE[m + 1] := integral_biUnion_finset s hMpm hMpdisj hgint
      _ = _ := Finset.sum_congr rfl hpiece

/-- **Divergence-form test forms near a face** (Simon Ch. 6, (28), by the arguments of 2.34–2.35).
For the face `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}` and `g : ℝⁿ → ℝⁿ` smooth with compact support and
`|g| ≤ 1`, put `ω = χ Σ_l (-1)^l (g_l ∘ π) dx^{J_l}` with `J_l = ι ∘ succAbove l`, the face
coordinates `π(x)_k = x_{ι(k)} - z_{ι(k)}` and the normal cut-off `χ = η(|x - Φ_p(π x)|²)`, `η = 1`
on `[0, δ²/2]` and `η = 0` on `[δ², ∞)`.  The `dx^{J_l}` are orthonormal, so `|ω| = χ |g ∘ π| ≤ 1`;
`spt ω` lies in `{|x - Φ_p(π x)| ≤ δ} ∩ π⁻¹(spt g)`; and near the face
`ω(x)(e_{J_i}) = (-1)^i gᵢ(π x)`, so the alternating-sum formula for `d` gives
`dω(Φ_p y)(e_p) = Σᵢ ∂ᵢgᵢ(y) = trace Dg(y)`. -/
theorem Submission.dor_lmb_fcd_fr_divergence_form : ∀ (P m : ℕ) (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) (g : Euclid (m + 1) → Euclid (m + 1)) (δ : ℝ), StrictMono p.2 → ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → (∀ y, ‖g y‖ ≤ 1) → 0 < δ → ∃ ω : TestFormOn (univ : Set (Euclid P)) m, (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) ≤ 1) ∧ (∀ x ∈ tsupport (ω : DifferentialForm (Euclid P) m), ∃ y ∈ tsupport g, dist x (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) ≤ δ) ∧ ∀ y : Euclid (m + 1), exteriorDerivative (ω : DifferentialForm (Euclid P) m) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) = LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) := by
  intro P m p g δ hι hg hgc hg1 hδ
  -- 1. coordinate covectors `dx^J`
  obtain ⟨dx, hdx, hdxn⟩ := Submission.dor_lmb_fcd_fr_coordinate_covectors P m
  -- 2. the frames `J l = ι ∘ succAbove l`: strictly increasing and pairwise distinct
  let J : Fin (m + 1) → Fin m → Fin P := fun l r => p.2 (l.succAbove r)
  have hJ : ∀ l, StrictMono (J l) := fun l => hι.comp (Fin.strictMono_succAbove l)
  have hJinj : Injective J := by
    intro l l' h
    apply Fin.succAbove_left_injective
    funext r
    exact hι.injective (congrFun h r)
  -- the face map `Φ` and the face coordinates `π x = πL x - πL z`, with `π ∘ Φ = id`
  let z : Euclid P := WithLp.toLp 2 (fun i => (p.1 i : ℝ))
  let Φ : Euclid (m + 1) → Euclid P := fun y =>
    z + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  let πL : Euclid P →L[ℝ] Euclid (m + 1) :=
    (EuclideanSpace.equiv (Fin (m + 1)) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi fun k => EuclideanSpace.proj (p.2 k))
  have hπL : ∀ x k, πL x k = x (p.2 k) := fun x k => rfl
  have hπLe : ∀ j, πL (EuclideanSpace.single (p.2 j) (1 : ℝ)) = EuclideanSpace.single j 1 := by
    intro j
    ext k
    simp [hπL, PiLp.single_apply, hι.injective.eq_iff]
  let π : Euclid P → Euclid (m + 1) := fun x => πL x - πL z
  have hπΦ : ∀ y, π (Φ y) = y := by
    intro y
    simp only [π, Φ, map_add, add_sub_cancel_left, map_sum, map_smul, hπLe]
    ext k
    simp [Pi.single_apply]
  -- the squared normal distance `ν x = |x - Φ(π x)|²` and the cut-off `χ = η ∘ ν`
  let ν : Euclid P → ℝ := fun x => ‖x - Φ (π x)‖ ^ 2
  let χ : Euclid P → ℝ := fun x => Real.smoothTransition (2 - 2 * ν x / δ ^ 2)
  -- 3. the form `ω = Σ_l (-1)^l χ (g_l ∘ π) dx^{J l}`
  let c : Fin (m + 1) → Euclid P → ℝ := fun l x => (-1) ^ (l : ℕ) * χ x * g (π x) l
  let ω : DifferentialForm (Euclid P) m := fun x => ∑ l, c l x • dx (J l)
  have hcoord : ∀ j : Fin (m + 1), ContDiff ℝ (⊤ : ℕ∞) fun y : Euclid (m + 1) => y j :=
    fun j => (EuclideanSpace.proj j : Euclid (m + 1) →L[ℝ] ℝ).contDiff
  have hπ : ContDiff ℝ (⊤ : ℕ∞) π := πL.contDiff.sub contDiff_const
  have hΦ : ContDiff ℝ (⊤ : ℕ∞) Φ :=
    contDiff_const.add (ContDiff.sum fun j _ => (hcoord j).smul contDiff_const)
  have hν : ContDiff ℝ (⊤ : ℕ∞) ν := (contDiff_norm_sq ℝ).comp (contDiff_id.sub (hΦ.comp hπ))
  have hχ : ContDiff ℝ (⊤ : ℕ∞) χ :=
    Real.smoothTransition.contDiff.comp (contDiff_const.sub ((contDiff_const.mul hν).div_const _))
  have hgπ : ∀ l, ContDiff ℝ (⊤ : ℕ∞) fun x => g (π x) l := fun l =>
    (hcoord l).comp (hg.comp hπ)
  have hω : ContDiff ℝ (⊤ : ℕ∞) ω :=
    ContDiff.sum fun l _ => ((contDiff_const.mul hχ).mul (hgπ l)).smul contDiff_const
  -- `χ = 0` where `ν ≥ δ²` and `χ = 1` where `2ν ≤ δ²`
  have hχ0 : ∀ x, δ ^ 2 ≤ ν x → χ x = 0 := by
    intro x hx
    apply Real.smoothTransition.zero_of_nonpos
    have : 2 ≤ 2 * ν x / δ ^ 2 := by
      rw [le_div_iff₀ (by positivity)]
      linarith
    linarith
  have hχ1 : ∀ x, 2 * ν x ≤ δ ^ 2 → χ x = 1 := by
    intro x hx
    apply Real.smoothTransition.one_of_one_le
    have : 2 * ν x / δ ^ 2 ≤ 1 := by
      rw [div_le_one₀ (by positivity)]
      exact hx
    linarith
  -- `spt ω ⊆ Z = {ν ≤ δ²} ∩ π⁻¹(spt g)`, and `|x - Φ(π x)| ≤ δ` on `Z`
  have hω0 : ∀ x, (χ x = 0 ∨ g (π x) = 0) → ω x = 0 := by
    intro x hx
    refine Finset.sum_eq_zero fun l _ => ?_
    rcases hx with h | h <;> simp [c, h]
  have hsuppZ : tsupport ω ⊆ {x | ν x ≤ δ ^ 2} ∩ π ⁻¹' tsupport g := by
    refine closure_minimal (fun x hx => ⟨?_, ?_⟩)
      ((isClosed_le hν.continuous continuous_const).inter
        ((isClosed_tsupport g).preimage hπ.continuous))
    · by_contra h
      exact hx (hω0 x (Or.inl (hχ0 x (le_of_not_ge h))))
    · by_contra h
      exact hx (hω0 x (Or.inr (image_eq_zero_of_notMem_tsupport h)))
  have hZδ : ∀ x, ν x ≤ δ ^ 2 → dist x (Φ (π x)) ≤ δ := fun x hx => by
    rw [dist_eq_norm]
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) hδ.le two_ne_zero).mp hx
  -- compact support: `Z ⊆ cthickening δ (Φ(spt g))`
  have hcpt : HasCompactSupport ω :=
    ((hgc.isCompact.image hΦ.continuous).cthickening (r := δ)).of_isClosed_subset
      (isClosed_tsupport ω) (hsuppZ.trans fun x hx =>
        Metric.mem_cthickening_of_dist_le x (Φ (π x)) δ _ (mem_image_of_mem Φ hx.2)
          (hZδ x hx.1))
  refine ⟨⟨ω, ⟨hω, hcpt⟩, subset_univ _⟩, fun x => ?_, fun x hx => ?_, fun y => ?_⟩
  · -- 4. (i) `|ω(x)| = χ(x) |g(π x)| ≤ 1`
    show covectorEuclideanNorm (∑ l, c l x • dx (J l)) ≤ 1
    rw [hdxn (m + 1) J (fun l => c l x) hJinj hJ]
    refine (Real.sqrt_le_sqrt ?_).trans_eq Real.sqrt_one
    calc ∑ l, c l x ^ 2 = χ x ^ 2 * ‖g (π x)‖ ^ 2 := by
          rw [EuclideanSpace.real_norm_sq_eq, Finset.mul_sum]
          refine Finset.sum_congr rfl fun l _ => ?_
          simp only [c]
          rw [mul_pow, mul_pow, ← pow_mul, mul_comm (l : ℕ) 2, pow_mul, neg_one_sq, one_pow,
            one_mul]
      _ ≤ 1 * 1 := mul_le_mul (pow_le_one₀ (Real.smoothTransition.nonneg _)
          (Real.smoothTransition.le_one _)) (pow_le_one₀ (norm_nonneg _) (hg1 _)) (sq_nonneg _)
          zero_le_one
      _ = 1 := one_mul 1
  · -- 5. (ii) `x` is within `δ` of `Φ(π x)`, `π x ∈ spt g`
    obtain ⟨hxν, hxg⟩ := hsuppZ hx
    exact ⟨π x, hxg, hZδ x hxν⟩
  · -- 6. (iii) near `Φ y`, `χ = 1`, so `ω` agrees with `ω₀ = Σ_l (-1)^l (g_l ∘ π) dx^{J l}`
    let ω₀ : DifferentialForm (Euclid P) m := fun x =>
      ∑ l : Fin (m + 1), ((-1) ^ (l : ℕ) * g (π x) l) • dx (J l)
    have hω₀ : ContDiff ℝ (⊤ : ℕ∞) ω₀ :=
      ContDiff.sum fun l _ => (contDiff_const.mul (hgπ l)).smul contDiff_const
    have hνΦ : 2 * ν (Φ y) < δ ^ 2 := by
      simp only [ν, hπΦ, sub_self, norm_zero]
      simpa using pow_pos hδ 2
    have hloc : ω =ᶠ[𝓝 (Φ y)] ω₀ := by
      filter_upwards [(isOpen_lt (continuous_const.mul hν.continuous) continuous_const).mem_nhds
        hνΦ] with x hx
      simp only [ω, ω₀, c, hχ1 x (le_of_lt hx), mul_one]
    have hd : exteriorDerivative ω (Φ y) = exteriorDerivative ω₀ (Φ y) := hloc.extDeriv_eq
    -- `ω₀(x)(e_{J i}) = (-1)^i g_i(π x)`
    have hω₀e : ∀ i : Fin (m + 1),
        (fun x => ω₀ x (i.removeNth fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) =
          fun x => (-1) ^ (i : ℕ) * g (π x) i := by
      intro i
      funext x
      show (∑ l : Fin (m + 1), ((-1) ^ (l : ℕ) * g (π x) l) • dx (J l))
          (fun r => EuclideanSpace.single (J i r) (1 : ℝ)) = _
      rw [ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single i]
      · rw [ContinuousAlternatingMap.smul_apply, hdx _ _ (hJ i) (hJ i), ite_eq_left rfl,
          smul_eq_mul, mul_one]
      · intro l _ hl
        rw [ContinuousAlternatingMap.smul_apply, hdx _ _ (hJ i) (hJ l),
          ite_eq_right fun h => hl (hJinj h).symm, smul_zero]
      · exact fun h => absurd (Finset.mem_univ i) h
    -- `D[(-1)^i g_i ∘ π](Φ y)(e_{ι i}) = (-1)^i (Dg(y) ê_i)_i`
    have hderiv : ∀ i : Fin (m + 1),
        fderiv ℝ (fun x => (-1) ^ (i : ℕ) * g (π x) i) (Φ y)
          (EuclideanSpace.single (p.2 i) (1 : ℝ)) =
          (-1) ^ (i : ℕ) * fderiv ℝ g y (EuclideanSpace.single i (1 : ℝ)) i := by
      intro i
      have hπd : HasFDerivAt π πL (Φ y) := πL.hasFDerivAt.sub_const (πL z)
      have hgd : HasFDerivAt g (fderiv ℝ g y) (π (Φ y)) := by
        rw [hπΦ]
        exact (hg.differentiable (by simp) y).hasFDerivAt
      have h2 : fderiv ℝ (fun x => (-1) ^ (i : ℕ) * g (π x) i) (Φ y) =
          ((-1 : ℝ) ^ (i : ℕ)) • ((EuclideanSpace.proj i).comp ((fderiv ℝ g y).comp πL)) :=
        (((EuclideanSpace.proj i).hasFDerivAt.comp (Φ y) (hgd.comp (Φ y) hπd)).const_mul
          ((-1 : ℝ) ^ (i : ℕ))).fderiv
      rw [h2, smul_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.comp_apply, hπLe, smul_eq_mul]
      rfl
    show exteriorDerivative ω (Φ y) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) = _
    rw [hd, exteriorDerivative_apply (hω₀.differentiable (by simp)).differentiableAt,
      LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin (m + 1)) ℝ)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hω₀e i, hderiv i, EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left,
      map_one, one_mul, ContinuousLinearMap.coe_coe, zsmul_eq_mul]
    push_cast
    rw [← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul]

/-- **Boundary variation on the faces** (Simon Ch. 6, proof of 5.1, (28), second part, by the
arguments of the Constancy Theorem 2.34 and of 2.35).  Let `Q(ω) = Σ_{p∈s} ∫_{Q₁} u_p ω(Φ_p)(e_p)`
with `M(∂Q) < ∞`.  The sets `W_p = {x : dist(x, F_p) < dist(x, F_q) for q ∈ s ∖ {p}}` are
pairwise disjoint, so disjointly supported admissible forms add up to an admissible form and
`Σ_{p∈s} M_{W_p}(∂Q) ≤ M(∂Q)`; put `V_p = M_{W_p}(∂Q)`.  For an admissible `g`, the compact
`Φ_p(spt g)` has positive distance from the other faces, so the divergence form `ω` of `g` is
supported in `W_p`, and `∂Q(ω) = Q(dω) = ∫_{Q₁} u_p div g` since `dω` vanishes on the other faces;
hence `∫_{Q₁} u_p div g ≤ M_{W_p}(∂Q) = V_p`. -/
theorem Submission.dor_lmb_fcd_fr_boundary_variation : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (u : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → ℝ) (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Q ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) → Q.boundary.mass ≠ ∞ → ∃ V : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℝ, (∀ p ∈ s, 0 ≤ V p) ∧ ENNReal.ofReal (∑ p ∈ s, V p) ≤ Q.boundary.mass ∧ ∀ p ∈ s, ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u p y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V p := by
  intro P m s u Q hs hQ hmass
  classical
  -- the parametrizations `Φ_p`, the closed faces `F_p` and the sets `W_p`
  let Φ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → Euclid P := fun p y =>
    WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  let F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P) := fun p =>
    {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
      (i ∉ Set.range p.2 → x i = p.1 i)}
  let W : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P) := fun p =>
    {x | ∀ q ∈ s, q ≠ p → infDist x (F p) < infDist x (F q)}
  -- face geometry: `Φ_p` maps the closed cube into `F_p`, is continuous, `F_p` is closed, and
  -- `Φ_p` maps the open cube off every other face
  have hFG : ∀ p ∈ s, (∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ p y ∈ F p) ∧
      Continuous (Φ p) ∧ IsClosed (F p) ∧ ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
        StrictMono q.2 → q ≠ p → ∀ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) → Φ p y ∉ F q := by
    intro p hp
    obtain ⟨-, -, -, -, h5, h6, -, h8, h9⟩ :=
      Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)
    exact ⟨h5, (Isometry.of_dist_eq h6).continuous, h8, h9⟩
  have hFne : ∀ p ∈ s, (F p).Nonempty := fun p hp =>
    ⟨Φ p 0, (hFG p hp).1 0 fun i => by simp⟩
  -- Step 1: the `W_p`, `p ∈ s`, are pairwise disjoint
  have hWdisj : ∀ p ∈ s, ∀ q ∈ s, p ≠ q → ∀ x, x ∈ W p → x ∉ W q := by
    intro p hp q hq hpq x hxp hxq
    exact lt_asymm (hxp q hq (Ne.symm hpq)) (hxq p hp hpq)
  -- Step 2: `Σ_{p∈s} M_{W_p}(∂Q) ≤ M(∂Q)`
  set T := Q.boundary with hT
  have hadm0 : ∀ V : Set (Euclid P),
      (0 : TestFormOn (univ : Set (Euclid P)) m) ∈ massAdmissibleOn univ m V := by
    intro V
    refine ⟨?_, fun x => ?_⟩ <;> simp
  -- (a) a family of admissible forms, one in each `W_p`
  have hfam : ∀ ω : (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W p),
      ∑ p ∈ s, ENNReal.ofReal (T (ω p)) ≤ T.mass := by
    intro ω
    -- drop the forms with negative value
    let ω' : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → TestFormOn (univ : Set (Euclid P)) m :=
      fun p => if 0 ≤ T (ω p) then (ω p : TestFormOn (univ : Set (Euclid P)) m) else 0
    have hω' : ∀ p, ENNReal.ofReal (T (ω p)) = ENNReal.ofReal (T (ω' p)) ∧ 0 ≤ T (ω' p) ∧
        ω' p ∈ massAdmissibleOn univ m (W p) := by
      intro p
      by_cases h : 0 ≤ T (ω p)
      · have h0 : ω' p = ω p := ite_eq_left h
        rw [h0]
        exact ⟨rfl, h, (ω p).2⟩
      · have h0 : ω' p = 0 := ite_eq_right h
        rw [h0, map_zero, ENNReal.ofReal_zero, ENNReal.ofReal_eq_zero]
        exact ⟨(not_le.1 h).le, le_rfl, hadm0 (W p)⟩
    -- the sum is admissible in `ℝ^P`: at each point at most one summand is nonzero
    have hsum_adm : (∑ p ∈ s, ω' p) ∈ massAdmissibleOn univ m univ := by
      refine ⟨subset_univ _, fun x => ?_⟩
      have hx : ((∑ p ∈ s, ω' p : TestFormOn (univ : Set (Euclid P)) m) :
          DifferentialForm (Euclid P) m) x =
          ∑ p ∈ s, ((ω' p : TestFormOn (univ : Set (Euclid P)) m) :
            DifferentialForm (Euclid P) m) x := by
        rw [Submodule.coe_sum, Finset.sum_apply]
      rw [hx]
      by_cases hex : ∃ p ∈ s, ((ω' p : TestFormOn (univ : Set (Euclid P)) m) :
          DifferentialForm (Euclid P) m) x ≠ 0
      · obtain ⟨p, hp, hpx⟩ := hex
        have hzero : ∀ q ∈ s, q ≠ p → ((ω' q : TestFormOn (univ : Set (Euclid P)) m) :
            DifferentialForm (Euclid P) m) x = 0 := by
          intro q hq hqp
          by_contra hqx
          exact hWdisj p hp q hq (Ne.symm hqp) x ((hω' p).2.2.1 (subset_tsupport _ hpx))
            ((hω' q).2.2.1 (subset_tsupport _ hqx))
        rw [Finset.sum_eq_single p hzero fun h => absurd hp h]
        exact (hω' p).2.2.2 x
      · have hzero : ∀ p ∈ s, ((ω' p : TestFormOn (univ : Set (Euclid P)) m) :
            DifferentialForm (Euclid P) m) x = 0 := fun p hp =>
          not_not.1 fun hpx => hex ⟨p, hp, hpx⟩
        rw [Finset.sum_eq_zero hzero, covectorEuclideanNorm_zero]
        exact zero_le_one
    calc ∑ p ∈ s, ENNReal.ofReal (T (ω p)) = ∑ p ∈ s, ENNReal.ofReal (T (ω' p)) :=
          Finset.sum_congr rfl fun p _ => (hω' p).1
      _ = ENNReal.ofReal (∑ p ∈ s, T (ω' p)) :=
          (ENNReal.ofReal_sum_of_nonneg fun p _ => (hω' p).2.1).symm
      _ = ENNReal.ofReal (T (∑ p ∈ s, ω' p)) := by rw [map_sum]
      _ ≤ T.mass := T.le_massOn hsum_adm
  -- (b) `M_{W_p}(∂Q)` as a supremum over families, which are directed
  have hsupW : ∀ p, T.massOn (W p) =
      ⨆ ω : (q : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W q),
        ENNReal.ofReal (T (ω p)) := by
    intro p
    rw [GeometricCurrentOn.massOn, sSup_image']
    refine le_antisymm (iSup_le fun ω => ?_) (iSup_le fun ω => le_iSup_of_le (ω p) le_rfl)
    let z : (q : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W q) :=
      fun q => ⟨0, hadm0 (W q)⟩
    exact le_iSup_of_le (Function.update z p ω) (by simp only [Function.update_self, le_refl])
  have hdir : ∀ i j : (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W p),
      ∃ k : (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W p), ∀ p,
        ENNReal.ofReal (T (i p)) ≤ ENNReal.ofReal (T (k p)) ∧
          ENNReal.ofReal (T (j p)) ≤ ENNReal.ofReal (T (k p)) := by
    intro i j
    refine ⟨fun p => if ENNReal.ofReal (T (i p)) ≤ ENNReal.ofReal (T (j p)) then j p else i p,
      fun p => ?_⟩
    by_cases h : ENNReal.ofReal (T (i p)) ≤ ENNReal.ofReal (T (j p))
    · simp only [ite_eq_left h]
      exact ⟨h, le_rfl⟩
    · simp only [ite_eq_right h]
      exact ⟨le_rfl, (not_le.1 h).le⟩
  have hsum : ∑ p ∈ s, T.massOn (W p) ≤ T.mass := by
    rw [Finset.sum_congr rfl fun p _ => hsupW p, ENNReal.finsetSum_iSup hdir]
    exact iSup_le hfam
  -- Step 3: `V_p = M_{W_p}(∂Q)`
  have hne : ∀ p, T.massOn (W p) ≠ ∞ := fun p =>
    ne_top_of_le_ne_top hmass (T.massOn_mono (subset_univ (W p)))
  refine ⟨fun p => (T.massOn (W p)).toReal, fun p _ => ENNReal.toReal_nonneg, ?_, ?_⟩
  · rw [ENNReal.ofReal_sum_of_nonneg fun p _ => ENNReal.toReal_nonneg]
    calc ∑ p ∈ s, ENNReal.ofReal (T.massOn (W p)).toReal = ∑ p ∈ s, T.massOn (W p) :=
          Finset.sum_congr rfl fun p _ => ENNReal.ofReal_toReal (hne p)
      _ ≤ T.mass := hsum
  intro p hp g hg hgc hgC hg1
  -- Step 4: `Φ_p(spt g)` is compact and has positive distance from the other faces
  have hGc : IsCompact (Φ p '' tsupport g) := IsCompact.image hgc (hFG p hp).2.1
  have hBc : IsClosed (⋃ q ∈ s.erase p, F q) :=
    isClosed_biUnion_finset fun q hq => (hFG q (Finset.mem_of_mem_erase hq)).2.2.1
  have hGB : Disjoint (Φ p '' tsupport g) (⋃ q ∈ s.erase p, F q) := by
    refine Set.disjoint_left.2 ?_
    rintro _ ⟨y, hy, rfl⟩ hyB
    obtain ⟨q, hq, hyq⟩ := Set.mem_iUnion₂.1 hyB
    exact (hFG p hp).2.2.2 q (hs q (Finset.mem_of_mem_erase hq)) (Finset.ne_of_mem_erase hq) y
      (hgC hy) hyq
  obtain ⟨r, hr0, hr⟩ := exists_pos_forall_lt_edist hGc hBc hGB
  set δ : ℝ := (r : ℝ) / 3 with hδ
  have hδ0 : 0 < δ := div_pos (NNReal.coe_pos.2 hr0) three_pos
  -- Step 5: the divergence form of `g`
  obtain ⟨ω, hω1, hωspt, hωd⟩ :=
    Submission.dor_lmb_fcd_fr_divergence_form P m p g δ (hs p hp) hg hgc hg1 hδ0
  -- Step 6: `spt ω ⊆ W_p`, so `ω` is admissible for `M_{W_p}(∂Q)`
  have hωW : tsupport (ω : DifferentialForm (Euclid P) m) ⊆ W p := by
    intro x hx q hq hqp
    obtain ⟨y, hy, hxy⟩ := hωspt x hx
    have hyC : ∀ i, 0 < y i ∧ y i < 1 := hgC hy
    have hxy' : dist (Φ p y) x ≤ δ := by
      rw [dist_comm]
      exact hxy
    have h1 : infDist x (F p) ≤ δ :=
      (infDist_le_dist_of_mem ((hFG p hp).1 y fun i => ⟨(hyC i).1.le, (hyC i).2.le⟩)).trans
        (by rw [dist_comm]; exact hxy')
    have h2 : 2 * δ ≤ infDist x (F q) := by
      refine (le_infDist (hFne q hq)).2 fun b hb => ?_
      have hb' : (r : ℝ≥0∞) < edist (Φ p y) b :=
        hr _ ⟨y, hy, rfl⟩ b (Set.mem_iUnion₂.2 ⟨q, Finset.mem_erase.2 ⟨hqp, hq⟩, hb⟩)
      have hrb : (r : ℝ) < dist (Φ p y) b := by
        rw [dist_edist]
        exact ENNReal.toReal_strict_mono (edist_ne_top _ _) hb'
      have htri := dist_triangle (Φ p y) x b
      linarith
    linarith
  have hωadm : ω ∈ massAdmissibleOn univ m (W p) := ⟨hωW, hω1⟩
  -- Step 7: `∂Q(ω) = Q(dω) = ∫_{Q₁} u_p div g`, `dω` vanishing on the other faces
  have hval : T ω = ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
      u p y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) := by
    rw [hT, GeometricCurrentOn.boundary_apply, hQ, Finset.sum_eq_single p]
    · congr 1
      funext y
      exact congrArg (fun t => u p y * t) (hωd y)
    · intro q hq hqp
      refine setIntegral_eq_zero_of_forall_eq_zero fun y hy => ?_
      have hyF : Φ q y ∈ F q := (hFG q hq).1 y fun i => ⟨(hy i).1.le, (hy i).2.le⟩
      have hnot : Φ q y ∉ tsupport (exteriorDerivative (ω : DifferentialForm (Euclid P) m)) := by
        intro hmem
        have hlt := hωW (tsupport_exteriorDerivative_subset _ hmem) q hq hqp
        rw [infDist_zero_of_mem hyF] at hlt
        exact absurd hlt (not_lt.2 infDist_nonneg)
      have h0 : exteriorDerivative (ω : DifferentialForm (Euclid P) m) (Φ q y)
          (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) = 0 := by
        rw [image_eq_zero_of_notMem_tsupport hnot]
        rfl
      exact (congrArg (fun t => u q y * t) h0).trans (mul_zero _)
    · intro h
      exact absurd hp h
  -- Step 8: `∫_{Q₁} u_p div g = ∂Q(ω) ≤ M_{W_p}(∂Q)`
  have hle : ENNReal.ofReal (T ω) ≤ T.massOn (W p) := T.le_massOn hωadm
  rw [hval] at hle
  exact (ENNReal.ofReal_le_iff_le_toReal (hne p)).1 hle
/-- **Currents given by `L¹` densities on unit faces** (Simon Ch. 6, proof of the deformation
theorem 5.1, (29), and the mass estimate (34) via 2.35).  For pairs `p = (z, ι)` with `ι` strictly
increasing, `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}` and `e_p = (e_{ι(0)}, …, e_{ι(m)})`:
(I) `y ↦ w_p(y) ω(Φ_p(y))(e_p)` is integrable on `Q₁ = (0, 1)^{m+1}`, since `ω` is continuous with
compact support and `|ω(x)(e_p)| ≤ ‖ω(x)‖`; (II) `ω ↦ Σ_p ∫_{Q₁} w_p ω(Φ_p)(e_p)` is linear and
bounded by `(Σ_p ∫_{Q₁} |w_p|) · sup ‖ω‖`, hence a current; (III) `|ω(x)(e_p)|` is bounded by the
Euclidean coefficient norm of `ω(x)`, so every such current has `M ≤ Σ_p ∫_{Q₁} |w_p|`. -/
theorem Submission.dor_lmb_fcd_fr_chain_current : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (w : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → ℝ), (∀ p ∈ s, StrictMono p.2) → (∀ p ∈ s, IntegrableOn (w p) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), ∀ p ∈ s, IntegrableOn (fun y => w p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) ∧ (∃ D : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), D ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) ∧ ∀ D : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), D ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) → D.mass ≤ ENNReal.ofReal (∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |w p y|) := by
  intro P m s w hmono hw
  -- Step 1: the frame `e_ι = (e_{ι 0}, …, e_{ι m})` consists of unit vectors, so `|α(e_ι)| ≤ ‖α‖`
  have hframe : ∀ (α : Covector (Euclid P) (m + 1)) (ι : Fin (m + 1) → Fin P),
      |α (fun k => EuclideanSpace.single (ι k) (1 : ℝ))| ≤ ‖α‖ := by
    intro α ι
    simpa using α.le_opNorm (fun k => EuclideanSpace.single (ι k) (1 : ℝ))
  -- for strictly increasing `ι`, `α(e_ι)` is one of the coefficients in the Euclidean norm of `α`
  have hcoeff : ∀ (α : Covector (Euclid P) (m + 1)) (ι : Fin (m + 1) → Fin P), StrictMono ι →
      |α (fun k => EuclideanSpace.single (ι k) (1 : ℝ))| ≤ covectorEuclideanNorm α := by
    intro α ι hι
    refine Real.abs_le_sqrt ?_
    have hle := Finset.single_le_sum (s := Finset.univ)
      (f := fun I : Fin (m + 1) → Fin P => if StrictMono I then
        (α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
      (fun I _ => by split_ifs <;> positivity) (Finset.mem_univ ι)
    simpa [hι, EuclideanSpace.basisFun_apply] using hle
  -- Step 2: `y ↦ ω(Φ_p(y))(e_p)` is continuous, and test forms are bounded
  have hcont : ∀ (ω : TestFormOn (univ : Set (Euclid P)) (m + 1))
      (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)),
      Continuous fun y : Euclid (m + 1) => (ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
    intro ω p
    have hω : Continuous (ω : DifferentialForm (Euclid P) (m + 1)) := ω.property.1.1.continuous
    have hΦ : Continuous fun y : Euclid (m + 1) =>
        WithLp.toLp 2 (fun i => (p.1 i : ℝ)) +
          ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) := by
      fun_prop
    exact (hω.comp hΦ).eval_const _
  have hbdd : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      ∃ C, ∀ x, ‖(ω : DifferentialForm (Euclid P) (m + 1)) x‖ ≤ C := fun ω =>
    ω.property.1.1.continuous.bounded_above_of_compact_support ω.property.1.2
  -- (I): an integrable density times a bounded continuous function is integrable
  have hint : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), ∀ p ∈ s,
      IntegrableOn (fun y => w p y * (ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)))
        {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    intro ω p hp
    obtain ⟨C, hC⟩ := hbdd ω
    exact (hw p hp).mul_bdd (hcont ω p).aestronglyMeasurable (Filter.Eventually.of_forall fun y =>
      (Real.norm_eq_abs _).trans_le ((hframe _ _).trans (hC _)))
  -- Step 3: `|Σ_p ∫ w_p ω(Φ_p)(e_p)| ≤ c · Σ_p ∫ |w_p|` whenever `|ω(Φ_p)(e_p)| ≤ c`
  have hbound : ∀ (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) (c : ℝ),
      (∀ p ∈ s, ∀ y : Euclid (m + 1), |(ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))| ≤ c) →
      |∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w p y *
        (ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))| ≤
      c * ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |w p y| := by
    intro ω c hc
    rw [Finset.mul_sum]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun p hp => ?_)
    rw [← integral_const_mul, ← Real.norm_eq_abs]
    refine norm_integral_le_of_norm_le ((hw p hp).abs.const_mul c)
      (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_mul, mul_comm c]
    exact mul_le_mul_of_nonneg_left (hc p hp y) (abs_nonneg _)
  -- (II): the formula is a linear functional on test forms ...
  let L : TestFormOn (univ : Set (Euclid P)) (m + 1) →ₗ[ℝ] ℝ :=
    { toFun := fun ω => ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        w p y * (ω : DifferentialForm (Euclid P) (m + 1))
          (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))
      map_add' := fun ω η => by
        have h : ∀ x v, ((ω + η : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
            DifferentialForm (Euclid P) (m + 1)) x v =
            (ω : DifferentialForm (Euclid P) (m + 1)) x v +
              (η : DifferentialForm (Euclid P) (m + 1)) x v := fun x v => rfl
        simp only [h, mul_add]
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun p hp => integral_add (hint ω p hp) (hint η p hp)
      map_smul' := fun c ω => by
        have h : ∀ x v, ((c • ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
            DifferentialForm (Euclid P) (m + 1)) x v =
            c * (ω : DifferentialForm (Euclid P) (m + 1)) x v := fun x v => rfl
        simp only [h, RingHom.id_apply, smul_eq_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl fun p _ => ?_
        rw [← integral_const_mul]
        congr 1
        funext y
        ring }
  -- ... and it is sequentially continuous: `ωⱼ → 0` forces `sup ‖ωⱼ‖ → 0`
  have hLcont : ∀ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) (m + 1),
      TestFormOnConverges ωs 0 → Tendsto (fun j => L (ωs j)) atTop (𝓝 0) := by
    intro ωs hωs
    obtain ⟨K, -, -, hsupp, -, hunif⟩ := hωs
    have h0 := Metric.tendstoUniformlyOn_iff.1 (hunif 0)
    obtain ⟨S, hS⟩ : ∃ S, S = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        |w p y| := ⟨_, rfl⟩
    have hS0 : 0 ≤ S := hS ▸ Finset.sum_nonneg fun p _ => integral_nonneg fun y => abs_nonneg _
    refine Metric.tendsto_nhds.2 fun ε hε => ?_
    have hδ : 0 < ε / (S + 1) := div_pos hε (by linarith)
    filter_upwards [h0 _ hδ] with j hj
    have hsup : ∀ x, ‖(ωs j : DifferentialForm (Euclid P) (m + 1)) x‖ ≤ ε / (S + 1) := by
      intro x
      by_cases hx : x ∈ K
      · have hjx := hj x hx
        have h00 : iteratedFDeriv ℝ 0 ((0 : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
            DifferentialForm (Euclid P) (m + 1)) x = 0 := by
          rw [← norm_eq_zero, norm_iteratedFDeriv_zero]
          simp
        rw [h00, dist_zero_left, norm_iteratedFDeriv_zero] at hjx
        exact hjx.le
      · rw [image_eq_zero_of_notMem_tsupport fun h => hx (hsupp j h), norm_zero]
        exact hδ.le
    have hb := hbound (ωs j) (ε / (S + 1)) fun p _ y => (hframe _ _).trans (hsup _)
    rw [← hS] at hb
    rw [Real.dist_eq, sub_zero]
    calc |L (ωs j)| ≤ ε / (S + 1) * S := hb
      _ < ε / (S + 1) * (S + 1) := mul_lt_mul_of_pos_left (lt_add_one S) hδ
      _ = ε := div_mul_cancel₀ ε (by linarith : (0 : ℝ) < S + 1).ne'
  refine ⟨hint, ⟨⟨L, hLcont⟩, fun ω => rfl⟩, fun D hD => ?_⟩
  -- (III): admissible forms have `|ω(Φ_p)(e_p)| ≤ 1`, so every admissible value is `≤ Σ_p ∫ |w_p|`
  unfold GeometricCurrentOn.mass GeometricCurrentOn.massOn
  refine sSup_le ?_
  rintro _ ⟨ω, hω, rfl⟩
  dsimp only
  rw [hD ω]
  refine ENNReal.ofReal_le_ofReal ((le_abs_self _).trans ?_)
  have hb := hbound ω 1 fun p hp y => (hcoeff _ _ (hmono p hp)).trans (hω.2 _)
  rwa [one_mul] at hb
/-- **A set that coincides near `x` with the plane `x + V` has approximate tangent space `V` at
`x`** (Simon Ch. 3, Definition 1.4).  A test function `f ∈ C_c(ℝᴾ)` vanishes off a ball `B_R(0)`,
so `∫_S f dHⁿ = ∫_{B_R(0) ∩ S} f dHⁿ` for every `S`.  For `0 < λ < r/R` the blow-up
`η_{x,λ}(N) = λ⁻¹(N − x)` coincides with `V` inside `B_R(0)`, hence the blow-up integrals equal
`∫_V f dHⁿ` for all small `λ > 0` and converge to it. -/
theorem Submission.dor_lmb_fcd_fr_local_plane_tangent : ∀ (P n : ℕ) (N : Set (Euclid P)) (x : Euclid P) (V : Submodule ℝ (Euclid P)) (r : ℝ), Module.finrank ℝ V = n → 0 < r → (∀ y ∈ Metric.ball x r, y ∈ N ↔ y - x ∈ V) → HasApproximateTangentSpaceAt n N x V := by
  intro P n N x V r hV hr hN
  refine ⟨hV, fun f => ?_⟩
  -- Step 1: `f` vanishes off a ball `B_R(0)`
  obtain ⟨R, hR, hfR⟩ : ∃ R : ℝ, 0 < R ∧ ∀ w, w ∉ ball (0 : Euclid P) R → f w = 0 := by
    obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.1 f.hasCompactSupport.isCompact.isBounded
    refine ⟨max C 0 + 1, add_pos_of_nonneg_of_pos (le_max_right C 0) one_pos,
      fun w hw => image_eq_zero_of_notMem_tsupport fun hwt => hw ?_⟩
    rw [mem_ball_zero_iff]
    exact (hC w hwt).trans_lt ((le_max_left C 0).trans_lt (lt_add_one _))
  -- Step 2: the integral of `f` over any `S` only sees `B_R(0) ∩ S`
  have hB : MeasurableSet (ball (0 : Euclid P) R) := measurableSet_ball
  have hloc : ∀ S : Set (Euclid P),
      ∫ y in S, f y ∂μHE[n] = ∫ y in ball (0 : Euclid P) R ∩ S, f y ∂μHE[n] := by
    intro S
    rw [← Measure.restrict_restrict hB, setIntegral_eq_integral_of_forall_compl_eq_zero hfR]
  -- Step 3: for `0 < λ < r/R` the blow-up of `N` coincides with `V` inside `B_R(0)`
  have hblow : ∀ lam ∈ Ioo 0 (r / R), ball (0 : Euclid P) R ∩
      Poincare.SimonGMT.Chapter03.blowUpMap x lam '' N =
        ball (0 : Euclid P) R ∩ (V : Set (Euclid P)) := by
    rintro lam ⟨hlam0, hlamR⟩
    have hsmall : ∀ w : Euclid P, ‖w‖ < R → ‖lam • w‖ < r := fun w hw => by
      rw [norm_smul, Real.norm_of_nonneg hlam0.le]
      exact (mul_lt_mul_of_pos_left hw hlam0).trans ((lt_div_iff₀ hR).1 hlamR)
    ext w
    constructor
    · rintro ⟨hw, y, hy, rfl⟩
      have hyx : y - x = lam • Poincare.SimonGMT.Chapter03.blowUpMap x lam y := by
        rw [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, mul_inv_cancel₀ hlam0.ne',
          one_smul]
      have hy' : y ∈ ball x r := by
        rw [Metric.mem_ball, dist_eq_norm, hyx]
        exact hsmall _ (mem_ball_zero_iff.1 hw)
      exact ⟨hw, V.smul_mem lam⁻¹ ((hN y hy').1 hy)⟩
    · rintro ⟨hw, hwV⟩
      have hy : x + lam • w ∈ ball x r := by
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
        exact hsmall w (mem_ball_zero_iff.1 hw)
      refine ⟨hw, x + lam • w, (hN _ hy).2 ?_, ?_⟩
      · rw [add_sub_cancel_left]
        exact V.smul_mem lam hwV
      · rw [Poincare.SimonGMT.Chapter03.blowUpMap, add_sub_cancel_left, smul_smul,
          inv_mul_cancel₀ hlam0.ne', one_smul]
  -- Step 4: the blow-up integrals are eventually equal to `∫_V f dHⁿ`
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hr hR)] with lam hlam
  rw [hloc (V : Set (Euclid P)), hloc (Poincare.SimonGMT.Chapter03.blowUpMap x lam '' N),
    hblow lam hlam]

/-- **Lattice chains are integer multiplicity** (Simon Ch. 6, proof of 5.1: "the fact that `P`,
`R` are integer multiplicity … should be evident").  Let `T(ω) = Σ_{p ∈ s} ∫_{Q₁} β_p
ω(Φ_p(y))(e_p) dy`, where `p = (z, ι)` has `ι` strictly increasing, `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}`,
`e_p = (e_{ι(0)}, …, e_{ι(m)})` and `Q₁ = (0, 1)ⁿ`.  Then `T = τ(N, θ, ξ)`, where `N` is the union
of the open faces `A_p = Φ_p(Q₁)` with `β_p ≠ 0`, `θ = |β_p|` and `ξ = sgn(β_p) e_p^*` on `A_p`
(`e_p^*(α) = α(e_p)`).  The face facts (`Φ_p` an isometry, `A_p ⊆ F_p` closed with `Hⁿ(F_p) = 1`,
`∫_{F_p} f dHⁿ = ∫_{Q₁} f ∘ Φ_p`, `A_p ∩ F_q = ∅` for `q ≠ p`) make the `A_p` disjoint Borel sets
of measure `≤ 1`, so `(N, θ, ξ)` is Borel, countably `n`-rectifiable and locally integrable; near
`x ∈ A_p`, `N` coincides with `x + V_p`, `V_p = span e_p` (the other faces are closed and miss
`x`), so `TₓN = V_p`, oriented by `±e_p`; and face by face its action is `T(ω)`. -/
theorem Submission.dor_lmb_fcd_fr_lattice_chain_im : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) → IsIntegerMultiplicity T := by
  intro P m s β T hmono hT
  classical
  -- Step 1: the face facts, in the notation `Q₁`, `Φ_p`, `F_p`, `e_p`
  obtain ⟨Q₁, hQ₁⟩ : ∃ Q : Set (Euclid (m + 1)), Q = {y | ∀ i, 0 < y i ∧ y i < 1} := ⟨_, rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → Euclid P,
      Φ = fun p y => WithLp.toLp 2 (fun i => (p.1 i : ℝ)) +
        ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P),
      F = fun p => {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧
        x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} := ⟨_, rfl⟩
  obtain ⟨e, he⟩ : ∃ e : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Fin (m + 1) → Euclid P,
      e = fun p k => EuclideanSpace.single (p.2 k) (1 : ℝ) := ⟨_, rfl⟩
  have hFG := fun p (hp : p ∈ s) => Submission.dor_lmb_fcd_fr_face_geometry P m p (hmono p hp)
  have hFmeas : ∀ p ∈ s, μHE[m + 1] (F p) = 1 := fun p hp => by
    rw [hF]; exact (hFG p hp).2.1
  have hFint : ∀ p ∈ s, ∀ f : Euclid P → ℝ,
      ∫ x in F p, f x ∂μHE[m + 1] = ∫ y in Q₁, f (Φ p y) := fun p hp f => by
    rw [hF, hQ₁, hΦ]; exact (hFG p hp).2.2.2.1 f
  have hΦF : ∀ p ∈ s, ∀ y ∈ Q₁, Φ p y ∈ F p := fun p hp y hy => by
    rw [hQ₁] at hy
    rw [hF, hΦ]
    exact (hFG p hp).2.2.2.2.1 y fun i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hiso : ∀ p ∈ s, Isometry (Φ p) := fun p hp => Isometry.of_dist_eq fun y y' => by
    rw [hΦ]; exact (hFG p hp).2.2.2.2.2.1 y y'
  have hFclosed : ∀ p ∈ s, IsClosed (F p) := fun p hp => by
    rw [hF]; exact (hFG p hp).2.2.2.2.2.2.2.1
  have hΦnotF : ∀ p ∈ s, ∀ q ∈ s, q ≠ p → ∀ y ∈ Q₁, Φ p y ∉ F q :=
    fun p hp q hq hqp y hy => by
      rw [hQ₁] at hy
      rw [hF, hΦ]
      exact (hFG p hp).2.2.2.2.2.2.2.2 q (hmono q hq) hqp y hy
  have hQ₁open : IsOpen Q₁ := by
    rw [hQ₁, ofPred_forall]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (PiLp.continuous_apply 2 _ i)).inter
        (isOpen_lt (PiLp.continuous_apply 2 _ i) continuous_const)
  -- the open faces `A_p = Φ_p(Q₁) ⊆ F_p`: Borel, pairwise disjoint, `Hⁿ(A_p) ≤ 1`
  obtain ⟨A, hA⟩ : ∃ A : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P),
      A = fun p => Φ p '' Q₁ := ⟨_, rfl⟩
  have hAmem : ∀ p x, x ∈ A p ↔ ∃ y ∈ Q₁, Φ p y = x := fun p x => by
    rw [hA]; exact Iff.rfl
  have hAmeas : ∀ p ∈ s, MeasurableSet (A p) := fun p hp => by
    rw [hA]
    exact (hiso p hp).isClosedEmbedding.measurableEmbedding.measurableSet_image.mpr
      hQ₁open.measurableSet
  have hAF : ∀ p ∈ s, A p ⊆ F p := fun p hp x hx => by
    obtain ⟨y, hy, rfl⟩ := (hAmem p x).mp hx
    exact hΦF p hp y hy
  have hAdisj : ∀ p ∈ s, ∀ q ∈ s, p ≠ q → Disjoint (A p) (A q) := fun p hp q hq hpq => by
    refine Set.disjoint_left.mpr fun x hxp hxq => ?_
    obtain ⟨y, hy, rfl⟩ := (hAmem p x).mp hxp
    exact hΦnotF p hp q hq (Ne.symm hpq) y hy (hAF q hq hxq)
  have hAfin : ∀ p ∈ s, μHE[m + 1] (A p) ≤ 1 := fun p hp =>
    (measure_mono (hAF p hp)).trans (hFmeas p hp).le
  -- Step 2: the triple `N = ⋃_{β_p ≠ 0} A_p`, `θ = Σ_p |β_p| 1_{A_p}`,
  -- `ξ = Σ_p sgn(β_p) 1_{A_p} e_p^*`
  obtain ⟨s', hs'⟩ : ∃ s' : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P)),
      s' = s.filter fun p => β p ≠ 0 := ⟨_, rfl⟩
  have hs's : ∀ p ∈ s', p ∈ s := fun p hp => by
    rw [hs'] at hp; exact (Finset.mem_filter.mp hp).1
  have hs'β : ∀ p ∈ s', β p ≠ 0 := fun p hp => by
    rw [hs'] at hp; exact (Finset.mem_filter.mp hp).2
  obtain ⟨N, hN⟩ : ∃ N : Set (Euclid P), N = ⋃ p ∈ s', A p := ⟨_, rfl⟩
  have hNmem : ∀ x, x ∈ N ↔ ∃ p ∈ s', x ∈ A p := fun x => by
    rw [hN]; simp only [mem_iUnion, exists_prop]
  have hNmeas : MeasurableSet N := by
    rw [hN]; exact Finset.measurableSet_biUnion s' fun p hp => hAmeas p (hs's p hp)
  obtain ⟨θ, hθ⟩ : ∃ θ : Euclid P → ℕ,
      θ = fun x => ∑ p ∈ s', (A p).indicator (fun _ => (β p).natAbs) x := ⟨_, rfl⟩
  obtain ⟨ξ, hξ⟩ : ∃ ξ : Euclid P → MultiVector P (m + 1),
      ξ = fun x => ∑ p ∈ s', (A p).indicator
        (fun _ => ((β p).sign : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p)) x :=
    ⟨_, rfl⟩
  -- on `A_p` (`β_p ≠ 0`), by disjointness, `θ = |β_p|` and `ξ = sgn(β_p) e_p^*`
  have hθA : ∀ p ∈ s', ∀ x ∈ A p, θ x = (β p).natAbs := fun p hp x hx => by
    rw [hθ]
    beta_reduce
    rw [Finset.sum_eq_single_of_mem p hp, indicator_of_mem hx]
    intro q hq hqp
    exact indicator_of_notMem (fun hxq => Set.disjoint_left.mp
      (hAdisj p (hs's p hp) q (hs's q hq) (Ne.symm hqp)) hx hxq) _
  have hξA : ∀ p ∈ s', ∀ x ∈ A p,
      ξ x = ((β p).sign : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p) :=
    fun p hp x hx => by
      rw [hξ]
      beta_reduce
      rw [Finset.sum_eq_single_of_mem p hp, indicator_of_mem hx]
      intro q hq hqp
      exact indicator_of_notMem (fun hxq => Set.disjoint_left.mp
        (hAdisj p (hs's p hp) q (hs's q hq) (Ne.symm hqp)) hx hxq) _
  -- Step 3: measurability, positivity, rectifiability, local integrability
  have hθmeas : Measurable θ := by
    rw [hθ]
    exact Finset.measurable_sum s' fun p hp => measurable_const.indicator (hAmeas p (hs's p hp))
  have hξmeas : StronglyMeasurable ξ := by
    -- `Λₙ(ℝᴾ)` is a topological additive group; its `ContinuousAdd` is not found by inference
    have : ContinuousAdd (MultiVector P (m + 1)) :=
      (inferInstance : IsTopologicalAddGroup (MultiVector P (m + 1))).toContinuousAdd
    rw [hξ]
    exact Finset.stronglyMeasurable_fun_sum s' fun p hp =>
      stronglyMeasurable_const.indicator (hAmeas p (hs's p hp))
  have hθpos : ∀ x ∈ N, 0 < θ x := fun x hx => by
    obtain ⟨p, hp, hxp⟩ := (hNmem x).mp hx
    rw [hθA p hp x hxp]
    exact Int.natAbs_pos.mpr (hs'β p hp)
  -- `N ⊆ ⋃_{j < |s'|} Φ_{p_j}(ℝⁿ)`, each `Φ_p` being `1`-Lipschitz
  have hrect : CountablyRectifiable (m + 1) N := by
    refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion
      (fun j : ℕ => if h : j < s'.card then range (Φ (s'.equivFin.symm ⟨j, h⟩)) else ∅)
      fun j => ?_).mono fun x hx => ?_
    · beta_reduce
      split_ifs with h
      · exact Poincare.SimonGMT.Chapter03.countablyRectifiable_range
          (hiso _ (hs's _ (s'.equivFin.symm ⟨j, h⟩).2)).lipschitzWith
      · exact Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
    · obtain ⟨p, hp, hxp⟩ := (hNmem x).mp hx
      obtain ⟨y, -, rfl⟩ := (hAmem p x).mp hxp
      refine mem_iUnion.mpr ⟨s'.equivFin ⟨p, hp⟩, ?_⟩
      rw [dite_eq_left (s'.equivFin ⟨p, hp⟩).2]
      simp only [Fin.eta, Equiv.symm_apply_apply]
      exact mem_range_self y
  -- `∫_{N ∩ K} θ dHⁿ ≤ Σ_p |β_p| Hⁿ(A_p) < ∞`
  have hθint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ∫⁻ x in N ∩ K, (θ x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ := by
    intro K _ _
    refine ne_top_of_le_ne_top ?_ (lintegral_mono_set inter_subset_left)
    rw [hN, lintegral_biUnion_finset
      (fun p hp q hq hpq => hAdisj p (hs's p hp) q (hs's q hq) hpq)
      fun p hp => hAmeas p (hs's p hp)]
    refine ENNReal.sum_ne_top.mpr fun p hp => ?_
    rw [setLIntegral_congr_fun (g := fun _ => ((β p).natAbs : ℝ≥0∞)) (hAmeas p (hs's p hp))
      fun x hx => by rw [hθA p hp x hx], setLIntegral_const]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ne_top_of_le_ne_top ENNReal.one_ne_top (hAfin p (hs's p hp)))
  -- Step 4: at `x ∈ A_p`, `TₓN = V_p = span e_p`, unit-oriented by `ξ(x) = ±e_p^*`
  have horth : ∀ p ∈ s, Orthonormal ℝ (e p) := fun p hp => by
    have h : e p = (EuclideanSpace.basisFun (Fin P) ℝ) ∘ p.2 := by
      funext k
      rw [he]
      simp only [Function.comp_apply, EuclideanSpace.basisFun_apply]
    rw [h]
    exact (EuclideanSpace.basisFun (Fin P) ℝ).orthonormal.comp p.2 (hmono p hp).injective
  have hunit : ∀ p ∈ s', IsUnitOrientationOf
      (((β p).sign : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p))
      (Submodule.span ℝ (range (e p))) := fun p hp => by
    refine ⟨e p, horth p (hs's p hp), rfl, ?_⟩
    rcases lt_or_gt_of_ne (hs'β p hp) with h | h
    · refine Or.inr fun α => ?_
      rw [Int.sign_eq_neg_one_of_neg h]
      simp
    · refine Or.inl fun α => ?_
      rw [Int.sign_eq_one_of_pos h]
      simp
  have htan : ∀ p ∈ s', ∀ x ∈ A p,
      HasApproximateTangentSpaceAt (m + 1) N x (Submodule.span ℝ (range (e p))) := by
    intro p hp x hx
    have hps := hs's p hp
    obtain ⟨y₀, hy₀, rfl⟩ := (hAmem p x).mp hx
    -- `B_{r₁}(y₀) ⊆ Q₁`
    obtain ⟨r₁, hr₁, hball₁⟩ := Metric.isOpen_iff.mp hQ₁open y₀ hy₀
    -- `B_{r₂}(x)` misses the closed faces `F_q`, `q ∈ s' \ {p}`
    have hGclosed : IsClosed (⋃ q ∈ s'.erase p, F q) :=
      isClosed_biUnion_finset fun q hq => hFclosed q (hs's q (Finset.mem_of_mem_erase hq))
    have hxG : Φ p y₀ ∉ ⋃ q ∈ s'.erase p, F q := by
      simp only [mem_iUnion, exists_prop, not_exists, not_and]
      intro q hq
      exact hΦnotF p hps q (hs's q (Finset.mem_of_mem_erase hq)) (Finset.ne_of_mem_erase hq)
        y₀ hy₀
    obtain ⟨r₂, hr₂, hball₂⟩ := Metric.isOpen_iff.mp hGclosed.isOpen_compl _ hxG
    refine Submission.dor_lmb_fcd_fr_local_plane_tangent P (m + 1) N (Φ p y₀) _ (min r₁ r₂)
      ?_ (lt_min hr₁ hr₂) fun y hy => ?_
    · rw [finrank_span_eq_card (horth p hps).linearIndependent, Fintype.card_fin]
    have hy₁ : dist y (Φ p y₀) < r₁ := (mem_ball.mp hy).trans_le (min_le_left _ _)
    have hy₂ : y ∉ ⋃ q ∈ s'.erase p, F q :=
      hball₂ (mem_ball.mpr ((mem_ball.mp hy).trans_le (min_le_right _ _)))
    constructor
    · -- `y ∈ N` forces `y ∈ A_p`, so `y − x = Σ_k (y₁ − y₀)_k e_{ι(k)} ∈ V_p`
      intro hyN
      obtain ⟨q, hq, hyq⟩ := (hNmem y).mp hyN
      have hqp : q = p := by
        by_contra hqp
        exact hy₂ (mem_iUnion₂.mpr ⟨q, Finset.mem_erase.mpr ⟨hqp, hq⟩, hAF q (hs's q hq) hyq⟩)
      rw [hqp] at hyq
      obtain ⟨y₁, -, rfl⟩ := (hAmem p y).mp hyq
      have hdiff : Φ p y₁ - Φ p y₀ = ∑ k, (y₁ k - y₀ k) • e p k := by
        rw [hΦ, he]
        simp only [sub_smul, Finset.sum_sub_distrib, add_sub_add_left_eq_sub]
      rw [hdiff]
      exact sum_mem fun k _ => Submodule.smul_mem _ _ (Submodule.subset_span (mem_range_self k))
    · -- `y − x = Σ_k c_k e_{ι(k)}` with `|c| = |y − x| < r₁`, so `y = Φ_p(y₀ + c) ∈ A_p`
      intro hyV
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hyV
      have hΦc : Φ p (y₀ + WithLp.toLp 2 c) = y := by
        have h : Φ p (y₀ + WithLp.toLp 2 c) = Φ p y₀ + ∑ k, c k • e p k := by
          rw [hΦ, he]
          simp only [PiLp.add_apply, add_smul, Finset.sum_add_distrib, add_assoc]
        rw [h, hc, add_sub_cancel]
      have hc₁ : y₀ + WithLp.toLp 2 c ∈ Q₁ := by
        apply hball₁
        rw [mem_ball, ← (hiso p hps).dist_eq, hΦc]
        exact hy₁
      exact (hNmem y).mpr ⟨p, hp, (hAmem p y).mpr ⟨_, hc₁, hΦc⟩⟩
  have horients : ∀ x ∈ N, ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt (m + 1) N x Q ∧ IsUnitOrientationOf (ξ x) Q := by
    intro x hx
    obtain ⟨p, hp, hxp⟩ := (hNmem x).mp hx
    exact ⟨_, htan p hp x hxp, by rw [hξA p hp x hxp]; exact hunit p hp⟩
  -- `R = (N, θ, ξ)` is an `IMRep` in `ℝ^P`
  refine ⟨⟨N, θ, ξ, hNmeas, subset_univ N, hrect, hθmeas, hθpos, hθint,
    hξmeas.aestronglyMeasurable, ae_restrict_of_forall_mem hNmeas horients⟩, fun ω => ?_⟩
  -- Step 5: `R` represents `T`, face by face
  show T ω = ∫ x in N, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1]
  obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid P) (m + 1)) := ContDiff.continuous hsmooth
  obtain ⟨C, hC⟩ := hcpt.exists_bound_of_continuous hωc
  -- on `A_p`: `θ ⟨ω, ξ⟩ = |β_p| sgn(β_p) ω(e_p) = β_p ω(e_p)`
  have hpt : ∀ p ∈ s', ∀ x ∈ A p, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) =
      (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p) := fun p hp x hx => by
    rw [hθA p hp x hx, hξA p hp x hx, smul_apply,
      ContinuousAlternatingMap.apply_apply, smul_eq_mul, ← mul_assoc]
    congr 1
    have h : (((β p).sign * ((β p).natAbs : ℤ) : ℤ) : ℝ) = (β p : ℝ) := by
      rw [Int.sign_mul_natAbs]
    rw [Int.cast_mul, Int.cast_natCast] at h
    rw [mul_comm]
    exact h
  -- integrability on each face: `|β_p ω(x)(e_p)| ≤ |β_p| sup ‖ω‖ ∏_k ‖e_{ι(k)}‖`, `Hⁿ(A_p) ≤ 1`
  have hintA : ∀ p ∈ s', IntegrableOn
      (fun x => (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x)) (A p)
      μHE[m + 1] := by
    intro p hp
    have hps := hs's p hp
    have hcont : Continuous fun x =>
        (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p) :=
      continuous_const.mul
        ((ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p)).continuous.comp hωc)
    refine IntegrableOn.congr_fun ?_ (fun x hx => (hpt p hp x hx).symm) (hAmeas p hps)
    refine Measure.integrableOn_of_bounded (M := |(β p : ℝ)| * (C * ∏ k, ‖e p k‖))
      (ne_top_of_le_ne_top ENNReal.one_ne_top (hAfin p hps)) hcont.aestronglyMeasurable
      (Eventually.of_forall fun x => ?_)
    rw [norm_mul, Real.norm_eq_abs]
    gcongr
    exact ((((ω : DifferentialForm (Euclid P) (m + 1)) x).le_opNorm (e p)).trans
      (by gcongr; exact hC x))
  -- on each face, `∫_{A_p} β_p ω(e_p) dHⁿ = ∫_{F_p} 1_{A_p} β_p ω(e_p) dHⁿ`
  -- `= ∫_{Q₁} β_p ω(Φ_p y)(e_p) dy`
  have hface : ∀ p ∈ s', ∫ x in A p, (θ x : ℝ) *
      ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] =
      ∫ y in Q₁, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y) (e p) := by
    intro p hp
    have hps := hs's p hp
    calc ∫ x in A p, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1]
        = ∫ x in A p, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p)
            ∂μHE[m + 1] := setIntegral_congr_fun (hAmeas p hps) fun x hx => hpt p hp x hx
      _ = ∫ x in F p, (A p).indicator
            (fun x => (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p)) x
            ∂μHE[m + 1] := by
          rw [integral_indicator (hAmeas p hps), Measure.restrict_restrict (hAmeas p hps),
            inter_eq_left.mpr (hAF p hps)]
      _ = ∫ y in Q₁, (A p).indicator
            (fun x => (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p)) (Φ p y) :=
          hFint p hps _
      _ = ∫ y in Q₁, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y) (e p) :=
          setIntegral_congr_fun hQ₁open.measurableSet fun y hy =>
            indicator_of_mem ((hAmem p _).mpr ⟨y, hy, rfl⟩) _
  -- sum over the disjoint faces; the faces with `β_p = 0` contribute nothing
  rw [hT ω, hN, integral_biUnion_finset s' (fun p hp => hAmeas p (hs's p hp))
    (fun p hp q hq hpq => hAdisj p (hs's p hp) q (hs's q hq) hpq) hintA,
    Finset.sum_congr rfl hface, hs', Finset.sum_filter_of_ne]
  · subst hQ₁ hΦ he
    rfl
  · intro p _ hp0 hβ
    exact hp0 (by simp [hβ])
/-- **Total variation of a smooth function by duality with smooth test fields** (parent step 5:
`∫_W |Dw|` is bounded by the supremum of `∫ Dw · g` over `C^∞` fields `g` with compact support in
`W` and `|g| ≤ 1`).  Let `F = (Dw(·) eᵢ)ᵢ` be the gradient field of `w`, so `⟪F, h⟫ = Dw · h` and
`|F| = ‖Dw‖`; `F` is `C^∞`, and bounded by `M` on the compact set `closure W`.  Given `ε > 0`, the
smooth cut-off `rsd_mw_tfa_smooth_cutoff` (for `vol⌞W`) gives `χ ∈ C_c^∞(W)` with `0 ≤ χ ≤ 1` and
`vol (W ∩ {χ ≠ 1}) < ε`.  The field `g = χ F / √(|F|² + ε²)` is admissible, and
`Dw · g = ψ := χ |F|² / √(|F|² + ε²)`, which vanishes off `W`, so `∫_W ψ ≤ V`.  On `W`,
`|F| ≤ ψ + |M| 1_{χ ≠ 1} + ε` (if `χ = 1`, use `a ≤ a² / √(a² + ε²) + ε`; otherwise `|F| ≤ M`).
Integrating, `∫_W |F| ≤ V + (|M| + vol W) ε`, and `ε → 0` gives the claim. -/
theorem Submission.dor_lmb_fcd_cp_smooth_duality : ∀ (P : ℕ) (w : Euclid P → ℝ) (W : Set (Euclid P)) (V : ℝ), IsOpen W → Bornology.IsBounded W → ContDiff ℝ (⊤ : ℕ∞) w → (∀ g : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ W → (∀ y, ‖g y‖ ≤ 1) → ∫ y, fderiv ℝ w y (g y) ≤ V) → ∫ y in W, ‖fderiv ℝ w y‖ ≤ V := by
  intro P w W V hWo hWb hw hV
  -- Step 1: the gradient field `F y = (Dw(y) eᵢ)ᵢ`, with `⟪F y, h⟫ = Dw(y) h` and `‖F y‖ = ‖Dw(y)‖`
  set F : Euclid P → Euclid P :=
    fun y => WithLp.toLp 2 (fun i => fderiv ℝ w y (EuclideanSpace.single i 1))
  have hinner : ∀ y h, inner ℝ (F y) h = fderiv ℝ w y h := by
    intro y h
    have hh : h = ∑ i, h i • EuclideanSpace.single i (1 : ℝ) := by
      ext j
      simp [Finset.sum_apply, Pi.single_apply]
    conv_rhs => rw [hh]
    simp [F, PiLp.inner_apply, map_sum, map_smul]
  have hFc : ContDiff ℝ (⊤ : ℕ∞) F := by
    have hD : ContDiff ℝ (⊤ : ℕ∞) (fun y => fderiv ℝ w y) :=
      hw.fderiv_right (by exact_mod_cast le_top)
    have : ContDiff ℝ (⊤ : ℕ∞) (fun y => (WithLp.linearEquiv 2 ℝ (Fin P → ℝ)).symm
        (fun i => fderiv ℝ w y (EuclideanSpace.single i 1))) := by
      apply (LinearEquiv.toContinuousLinearEquiv
        (WithLp.linearEquiv 2 ℝ (Fin P → ℝ)).symm).contDiff.comp
      exact contDiff_pi.2 fun i => hD.clm_apply contDiff_const
    simpa [F] using this
  have hFn : ∀ y, ‖F y‖ = ‖fderiv ℝ w y‖ := by
    intro y
    have hdual : InnerProductSpace.toDual ℝ (Euclid P) (F y) = fderiv ℝ w y := by
      ext h
      simp [InnerProductSpace.toDual_apply_apply, hinner]
    rw [← hdual, LinearIsometryEquiv.norm_map]
  simp_rw [← hFn]
  -- Step 2: `vol W < ∞`, `closure W` is compact, `‖F‖ ≤ M` on `closure W`, `‖F‖` integrable on `W`
  have hWm : volume W < ∞ := hWb.measure_lt_top
  have hWc : IsCompact (closure W) := hWb.isCompact_closure
  obtain ⟨M, hM⟩ := hWc.exists_bound_of_continuousOn hFc.continuous.continuousOn
  have hFi : IntegrableOn (fun y => ‖F y‖) W :=
    (hFc.continuous.norm.continuousOn.integrableOn_compact hWc).mono_set subset_closure
  -- the scalar inequality `a ≤ a² / S + ε` for `a ≤ S ≤ a + ε`
  have alg : ∀ ε a S : ℝ, 0 < S → a ≤ S → S ≤ a + ε → a ≤ S⁻¹ * a ^ 2 + ε := by
    intro ε a S hS haS hSa
    rw [inv_mul_eq_div, ← sub_le_iff_le_add, le_div_iff₀ hS]
    nlinarith [sq_nonneg (S - a), mul_nonneg hS.le (sub_nonneg.2 hSa)]
  -- Step 3: for every `ε > 0`, `∫_W ‖F‖ ≤ V + (|M| + vol W) ε`
  have key : ∀ ε : ℝ, 0 < ε → ∫ y in W, ‖F y‖ ≤ V + (|M| + volume.real W) * ε := by
    intro ε hε
    -- the smooth cut-off `χ` with compact support in `W` and `vol (W ∩ {χ ≠ 1}) < ε`
    have hfin : IsFiniteMeasure (volume.restrict W) := isFiniteMeasure_restrict.2 hWm.ne
    obtain ⟨χ, hχ, hχc, hχW, hχ01, hχm⟩ :=
      Submission.rsd_mw_tfa_smooth_cutoff P (volume.restrict W) W hfin hWo
        (by rw [Measure.restrict_apply' hWo.measurableSet, compl_inter_self, measure_empty]) ε hε
    -- the regularised length `s = √(‖F‖² + ε²)` and the test field `g = χ s⁻¹ F`
    set s : Euclid P → ℝ := fun y => √(‖F y‖ ^ 2 + ε ^ 2)
    have hspos : ∀ y, 0 < s y := by
      intro y
      show 0 < √(‖F y‖ ^ 2 + ε ^ 2)
      positivity
    have hsc : ContDiff ℝ (⊤ : ℕ∞) s :=
      ((hFc.norm_sq ℝ).add contDiff_const).sqrt fun y =>
        (by positivity : (0 : ℝ) < ‖F y‖ ^ 2 + ε ^ 2).ne'
    have hFs : ∀ y, ‖F y‖ ≤ s y := by
      intro y
      show ‖F y‖ ≤ √(‖F y‖ ^ 2 + ε ^ 2)
      exact (Real.le_sqrt (norm_nonneg _) (by positivity)).2 (le_add_of_nonneg_right (sq_nonneg ε))
    have hsF : ∀ y, s y ≤ ‖F y‖ + ε := by
      intro y
      show √(‖F y‖ ^ 2 + ε ^ 2) ≤ ‖F y‖ + ε
      rw [Real.sqrt_le_left (by positivity)]
      nlinarith [mul_nonneg (norm_nonneg (F y)) hε.le]
    have hgc : ContDiff ℝ (⊤ : ℕ∞) (fun y => χ y • ((s y)⁻¹ • F y)) :=
      hχ.smul ((hsc.inv fun y => (hspos y).ne').smul hFc)
    have hgcs : HasCompactSupport (fun y => χ y • ((s y)⁻¹ • F y)) :=
      hχc.smul_right (f' := fun y => (s y)⁻¹ • F y)
    have hgt : tsupport (fun y => χ y • ((s y)⁻¹ • F y)) ⊆ W :=
      (tsupport_smul_subset_left χ fun y => (s y)⁻¹ • F y).trans hχW
    have hg1 : ∀ y, ‖χ y • ((s y)⁻¹ • F y)‖ ≤ 1 := by
      intro y
      have hc0 : 0 ≤ (s y)⁻¹ * ‖F y‖ := mul_nonneg (inv_nonneg.2 (hspos y).le) (norm_nonneg _)
      have hc1 : (s y)⁻¹ * ‖F y‖ ≤ 1 := by
        rw [inv_mul_le_iff₀ (hspos y), mul_one]
        exact hFs y
      rw [norm_smul, norm_smul, Real.norm_of_nonneg (hχ01 y).1,
        Real.norm_of_nonneg (inv_nonneg.2 (hspos y).le)]
      exact (mul_le_of_le_one_left hc0 (hχ01 y).2).trans hc1
    -- `Dw(y) (g y) = ψ y := χ y s(y)⁻¹ ‖F y‖²`; `ψ` vanishes off `W`, so `∫_W ψ ≤ V`
    set ψ : Euclid P → ℝ := fun y => χ y * ((s y)⁻¹ * ‖F y‖ ^ 2)
    have hDg : ∀ y, fderiv ℝ w y (χ y • ((s y)⁻¹ • F y)) = ψ y := by
      intro y
      show fderiv ℝ w y (χ y • ((s y)⁻¹ • F y)) = χ y * ((s y)⁻¹ * ‖F y‖ ^ 2)
      rw [← hinner, inner_smul_right, inner_smul_right, real_inner_self_eq_norm_sq]
    have hψ0W : ∀ y ∉ W, ψ y = 0 := by
      intro y hy
      have h0 : χ y = 0 := image_eq_zero_of_notMem_tsupport fun h => hy (hχW h)
      show χ y * ((s y)⁻¹ * ‖F y‖ ^ 2) = 0
      rw [h0, zero_mul]
    have hψV : ∫ y in W, ψ y ≤ V := by
      rw [setIntegral_eq_integral_of_forall_compl_eq_zero hψ0W]
      calc ∫ y, ψ y = ∫ y, fderiv ℝ w y (χ y • ((s y)⁻¹ • F y)) := by simp_rw [hDg]
        _ ≤ V := hV (fun y => χ y • ((s y)⁻¹ • F y)) hgc hgcs hgt hg1
    -- pointwise on `W`: `‖F‖ ≤ ψ + |M| 1_{χ ≠ 1} + ε`
    have hEm : MeasurableSet {x | χ x ≠ 1} :=
      (isOpen_ne_fun hχ.continuous continuous_const).measurableSet
    have hpt : ∀ y ∈ W,
        ‖F y‖ ≤ ψ y + Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y + ε := by
      intro y hy
      by_cases hy1 : χ y = 1
      · have hyE : y ∉ {x | χ x ≠ 1} := fun h => h hy1
        rw [indicator_of_notMem hyE, add_zero]
        show ‖F y‖ ≤ χ y * ((s y)⁻¹ * ‖F y‖ ^ 2) + ε
        rw [hy1, one_mul]
        exact alg ε _ _ (hspos y) (hFs y) (hsF y)
      · have hyE : y ∈ {x | χ x ≠ 1} := hy1
        rw [indicator_of_mem hyE]
        have hψ0 : 0 ≤ ψ y :=
          mul_nonneg (hχ01 y).1 (mul_nonneg (inv_nonneg.2 (hspos y).le) (sq_nonneg _))
        have h1 := hM y (subset_closure hy)
        have h2 := le_abs_self M
        show ‖F y‖ ≤ ψ y + |M| + ε
        linarith
    -- integrate over `W`
    have hψc : Continuous ψ :=
      hχ.continuous.mul ((hsc.continuous.inv₀ fun y => (hspos y).ne').mul
        (hFc.continuous.norm.pow 2))
    have hψi : IntegrableOn ψ W :=
      (hψc.continuousOn.integrableOn_compact hWc).mono_set subset_closure
    have hEi : IntegrableOn (Set.indicator {x | χ x ≠ 1} fun _ => |M|) W :=
      (integrableOn_const hWm.ne).indicator hEm
    have hψEi : IntegrableOn (fun y => ψ y + Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y) W :=
      hψi.add hEi
    have hεi : IntegrableOn (fun _ => ε) W := integrableOn_const hWm.ne
    have hEε : (volume.restrict W).real {x | χ x ≠ 1} ≤ ε :=
      (ENNReal.toReal_lt_of_lt_ofReal hχm).le
    calc ∫ y in W, ‖F y‖
        ≤ ∫ y in W, (ψ y + Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y + ε) :=
          setIntegral_mono_on hFi (hψEi.add hεi) hWo.measurableSet hpt
      _ = (∫ y in W, ψ y) + (∫ y in W, Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y) +
            ∫ y in W, ε := by
          rw [integral_add hψEi hεi, integral_add hψi hEi]
      _ = (∫ y in W, ψ y) + (volume.restrict W).real {x | χ x ≠ 1} * |M| +
            volume.real W * ε := by
          rw [integral_indicator_const _ hEm, setIntegral_const, smul_eq_mul, smul_eq_mul]
      _ ≤ V + (|M| + volume.real W) * ε := by
          nlinarith [mul_le_mul_of_nonneg_right hEε (abs_nonneg M)]
  -- Step 4: let `ε → 0`
  refine le_of_forall_pos_le_add fun η hη => ?_
  have hL : 0 ≤ volume.real W := measureReal_nonneg
  have hpos : 0 < |M| + volume.real W + 1 := by positivity
  have h1 := key (η / (|M| + volume.real W + 1)) (div_pos hη hpos)
  have h2 : (|M| + volume.real W) * (η / (|M| + volume.real W + 1)) ≤ η := by
    rw [← mul_div_assoc, div_le_iff₀ hpos]
    nlinarith
  linarith
/-- **Dilation pull-back of a test form** (Simon 6.2.23 for `f = δ_λ`, `δ_λ(x) = λx`, `λ ≠ 0`):
`δ_λ^#ω = affinePullbackForm (λ·id) 0 ω` is again a test form on `ℝᴾ`, and
`(δ_λ^#ω)(x) = λᵏ ω(λx)` as `k`-covectors.  `x ↦ λx` is a homeomorphism, hence proper, so the
pull-back preserves compactly supported smooth forms; multilinearity of the covector `ω(λx)`
pulls `λ` out of each of its `k` slots. -/
theorem Submission.cmcdt_dil_pullback_testForm : ∀ (P k : ℕ) (lam : ℝ), lam ≠ 0 → ∀ ω : TestFormOn (univ : Set (Euclid P)) k, ∃ η : TestFormOn (univ : Set (Euclid P)) k, (η : DifferentialForm (Euclid P) k) = affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) ∧ ∀ x : Euclid P, (η : DifferentialForm (Euclid P) k) x = lam ^ k • (ω : DifferentialForm (Euclid P) k) (lam • x) := by
  intro P k lam hlam ω
  -- Step 1: `x ↦ 0 + (λ·id)x = λx` is a homeomorphism, hence a proper map.
  have hproper : IsProperMap
      (fun x : Euclid P => (0 : Euclid P) + (lam • ContinuousLinearMap.id ℝ (Euclid P)) x) := by
    convert (Homeomorph.smulOfNeZero (α := Euclid P) lam hlam).isProperMap using 1
    funext x
    simp
  -- Step 2: the pull-back along the proper map is a test form, trivially supported in `univ`.
  refine ⟨⟨affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0
      (ω : DifferentialForm (Euclid P) k),
    affinePullbackForm_isTestForm _ _ hproper ω.property.1, subset_univ _⟩, rfl, fun x => ?_⟩
  -- Steps 3–4: `η(x)(v) = ω(λx)(λv₁, …, λvₖ) = (∏ᵢ λ) ω(λx)(v) = λᵏ ω(λx)(v)` for every `v`.
  have hx : (0 : Euclid P) + (lam • ContinuousLinearMap.id ℝ (Euclid P)) x = lam • x := by
    simp
  ext v
  have hv : (lam • ContinuousLinearMap.id ℝ (Euclid P)) ∘ v = fun i => lam • v i := by
    funext i
    simp
  simp only [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply, hx, hv,
    ContinuousAlternatingMap.map_smul_univ, Fin.prod_const, ContinuousAlternatingMap.smul_apply]
/-- Approximate tangent spaces are invariant under the dilation `η = η_{x,λ}`, `λ > 0`
(Simon Ch. 3, 1.4).  As `η(w) − η(y) = λ⁻¹(w − y)`, the rescaled set `η_{η(y),r}(η(M))` is
`η_{y,λr}(M)`, and `r ↦ λr` maps `r ↓ 0` into `s ↓ 0`; `dim Q = n` is unchanged. -/
theorem Submission.dtc_approxTangent_dilation : ∀ (P n : ℕ) (M : Set (Euclid P)) (x y : Euclid P) (lam : ℝ) (Q : Submodule ℝ (Euclid P)), 0 < lam → HasApproximateTangentSpaceAt n M y Q → HasApproximateTangentSpaceAt n (dilation x lam '' M) (dilation x lam y) Q := by
  intro P n M x y lam Q hlam hT
  refine ⟨hT.1, fun f => ?_⟩
  -- `η_{η(y),r}(η(M)) = η_{y,λr}(M)`, since `η(w) − η(y) = λ⁻¹(w − y)`
  have hset : ∀ r : ℝ, Poincare.SimonGMT.Chapter03.blowUpMap (dilation x lam y) r ''
      (dilation x lam '' M) = Poincare.SimonGMT.Chapter03.blowUpMap y (lam * r) '' M := by
    intro r
    rw [image_image]
    congr 1
    funext w
    simp only [Poincare.SimonGMT.Chapter03.blowUpMap, dilation, dilationCLM,
      smul_apply, ContinuousLinearMap.id_apply, add_sub_add_left_eq_sub]
    rw [← smul_sub, smul_smul, mul_inv, mul_comm]
  simp_rw [hset]
  -- `r ↦ λr` maps `r ↓ 0` into `s ↓ 0`
  have hlim : Tendsto (fun r : ℝ => lam * r) (𝓝[>] 0) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · simpa using (tendsto_id.const_mul lam).mono_left (nhdsWithin_le_nhds (a := (0 : ℝ)))
    · filter_upwards [self_mem_nhdsWithin] with r hr
      exact mul_pos hlam hr
  exact (hT.2 f).comp hlim

/-- **Simon Ch. 6, 3.3–3.9 for the similarity `η = η_{x,λ}`** (used in the proof of 7.3.1(2)):
if `R = (M, θ, ξ)` represents `T` in `U`, then `R' = (η(M), θ ∘ η⁻¹, ξ ∘ η⁻¹)` represents
`η_{x,λ#}T` in `η(U)` and `μ_{R'}(B) = λ⁻ⁿ μ_R(η⁻¹(B))` for Borel `B`.  The Jacobian of `η` is
the constant `λ⁻ⁿ`, so the area formula reduces to `Hⁿ⌞η(s) = λ⁻ⁿ η_#(Hⁿ⌞s)`
(`dtc_hausdorff_dilation`); `η(M)` is rectifiable as `η` is Lipschitz, `ξ ∘ η⁻¹` orients
`T_{η(y)}η(M) = T_yM` (`dtc_approxTangent_dilation`), and `η_{x,λ#}T(ω) = λ⁻ⁿ T(ω ∘ η)`
(`dtc_blowUp_testForm_corr`). -/
theorem Submission.dtc_blowUp_imrep : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (x : Euclid P) (lam : ℝ) (hlam : 0 < lam) (R : IMRep U n), R.Represents T → ∃ R' : IMRep (dilation x lam '' U) n, R'.Represents (blowUp T x lam hlam.ne') ∧ ∀ s : Set (Euclid P), MeasurableSet s → R'.measure s = ENNReal.ofReal (lam⁻¹ ^ n) * R.measure (dilation x lam ⁻¹' s) := by
  intro P n U T x lam hlam R hR
  obtain ⟨hpull, -, hblow⟩ := Submission.dtc_blowUp_testForm_corr P n U x lam hlam
  obtain ⟨himage, hmap⟩ := Submission.dtc_hausdorff_dilation P n x lam hlam
  have htan : ∀ (y : Euclid P) (Q : Submodule ℝ (Euclid P)),
      HasApproximateTangentSpaceAt n R.carrier y Q →
        HasApproximateTangentSpaceAt n (dilation x lam '' R.carrier) (dilation x lam y) Q :=
    fun y Q => Submission.dtc_approxTangent_dilation P n R.carrier x y lam Q hlam
  -- `η = dilation x λ` is an affine homeomorphism with inverse `z ↦ x + λ • z`
  have hηc : (((Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hlam.ne')).trans
      (Homeomorph.addLeft (-(lam⁻¹ • x)))) : Euclid P → Euclid P) = dilation x lam := by
    funext y
    simp [dilation, dilationCLM]
  have hme : MeasurableEmbedding (dilation x lam) := by
    rw [← hηc]
    exact Homeomorph.measurableEmbedding _
  have hιη : ∀ y, x + lam • dilation x lam y = y := fun y => by
    simp [dilation, dilationCLM, smul_add, smul_smul, mul_inv_cancel₀ hlam.ne']
  have hc0 : 0 ≤ lam⁻¹ ^ n := by positivity
  set c : ℝ≥0∞ := ENNReal.ofReal (lam⁻¹ ^ n) with hc
  -- `Hⁿ⌞η(s) = c • η_#(Hⁿ⌞s)`, hence change of variables along `η`
  have hkey : ∀ s : Set (Euclid P),
      μHE[n].restrict (dilation x lam '' s) = c • (μHE[n].restrict s).map (dilation x lam) := by
    intro s
    have h1 : (μHE[n].restrict s).map (dilation x lam) =
        ENNReal.ofReal (lam ^ n) • μHE[n].restrict (dilation x lam '' s) := by
      rw [← hme.injective.preimage_image s, ← hme.restrict_map, hmap, Measure.restrict_smul,
        hme.injective.preimage_image]
    rw [h1, smul_smul, hc, ← ENNReal.ofReal_mul hc0, ← mul_pow, inv_mul_cancel₀ hlam.ne',
      one_pow, ENNReal.ofReal_one, one_smul]
  have hlint : ∀ (s : Set (Euclid P)) (g : Euclid P → ℝ≥0∞),
      ∫⁻ z in dilation x lam '' s, g z ∂μHE[n] = c * ∫⁻ y in s, g (dilation x lam y) ∂μHE[n] := by
    intro s g
    rw [hkey s, lintegral_smul_measure, hme.lintegral_map, smul_eq_mul]
  have hint : ∀ (s : Set (Euclid P)) (g : Euclid P → ℝ),
      ∫ z in dilation x lam '' s, g z ∂μHE[n] =
        lam⁻¹ ^ n * ∫ y in s, g (dilation x lam y) ∂μHE[n] := by
    intro s g
    rw [hkey s, integral_smul_measure, hme.integral_map, hc, ENNReal.toReal_ofReal hc0,
      smul_eq_mul]
  refine ⟨{ carrier := dilation x lam '' R.carrier
            mult := fun z => R.mult (x + lam • z)
            orient := fun z => R.orient (x + lam • z)
            measurableSet_carrier := hme.measurableSet_image.mpr R.measurableSet_carrier
            carrier_subset := image_mono R.carrier_subset
            rectifiable := ?_
            measurable_mult := R.measurable_mult.comp (by fun_prop)
            mult_pos := ?_
            locallyIntegrable_mult := ?_
            aestronglyMeasurable_orient := ?_
            orients := ?_ }, ?_, ?_⟩
  · -- `η(M) ⊆ η(M₀) ∪ ⋃ⱼ range (η ∘ Fⱼ)` with `Hⁿ(η(M₀)) = 0` and `η ∘ Fⱼ` Lipschitz
    obtain ⟨M₀, hM₀, F, hF, hcover⟩ := R.rectifiable
    refine ⟨dilation x lam '' M₀, by rw [himage, hM₀, mul_zero], fun j => dilation x lam ∘ F j,
      fun j => ?_, ?_⟩
    · obtain ⟨K, hK⟩ := hF j
      exact ⟨_, ((isometry_add_left (-(lam⁻¹ • x))).lipschitzWith.comp
        (dilationCLM P lam).lipschitzWith).comp hK⟩
    · rintro _ ⟨y, hy, rfl⟩
      rcases hcover hy with h0 | h1
      · exact Or.inl ⟨y, h0, rfl⟩
      · obtain ⟨j, v, rfl⟩ := mem_iUnion.mp h1
        exact Or.inr (mem_iUnion.mpr ⟨j, v, rfl⟩)
  · rintro _ ⟨y, hy, rfl⟩
    show 0 < R.mult (x + lam • dilation x lam y)
    rw [hιη]
    exact R.mult_pos y hy
  · -- `η(M) ∩ K = η(M ∩ η⁻¹(K))`, and `η⁻¹(K)` is a compact subset of `U`
    intro K hK hKU
    rw [← image_inter_preimage, hlint]
    simp only [hιη]
    refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top (R.locallyIntegrable_mult _ ?_ ?_)
    · rw [← hηc]
      exact (Homeomorph.isCompact_preimage _).mpr hK
    · rw [← hme.injective.preimage_image U]
      exact preimage_mono hKU
  · rw [hkey]
    refine (hme.aestronglyMeasurable_map_iff.mpr ?_).smul_measure c
    simpa [Function.comp_def, hιη] using R.aestronglyMeasurable_orient
  · rw [hkey]
    refine Measure.ae_smul_measure (hme.ae_map_iff.mpr (R.orients.mono fun y hy => ?_)) c
    obtain ⟨Q, hQ, hξ⟩ := hy
    exact ⟨Q, htan y Q hQ, by simpa [hιη] using hξ⟩
  · -- `η_{x,λ#}T(ω) = λ⁻ⁿ T(ω ∘ η) = λ⁻ⁿ ∫_M θ ⟨ω ∘ η, ξ⟩ dHⁿ = ∫_{η(M)} θ' ⟨ω, ξ'⟩ dHⁿ`
    intro ω
    obtain ⟨ω', hω'⟩ := hpull ω
    rw [hblow T ω ω' hω', hR ω']
    simp only [IMRep.action]
    rw [hint]
    congr 1
    refine setIntegral_congr_fun R.measurableSet_carrier fun y _ => ?_
    simp [hιη, hω']
  · -- `μ_{R'}(B) = c ∫_{η⁻¹(B)} θ d(Hⁿ⌞M) = c μ_R(η⁻¹(B))`
    intro s hs
    simp only [IMRep.measure]
    rw [withDensity_apply _ hs, withDensity_apply _ (hme.measurable hs), hkey,
      Measure.restrict_smul, hme.restrict_map, lintegral_smul_measure, hme.lintegral_map]
    simp [hιη]

/-- **Mass scaling of blow-ups: `M_{η(W)}(η_{x,λ#}T) = λ⁻ⁿ M_W(T)`** for `λ > 0` and every
`W ⊆ ℝᴾ` (scaling identity (1) in the proof of Simon 7.3.1, chapter-07.txt lines 329–331; mass
`M_W` of 6.2.5 with the Euclidean coefficient norm).  By `Submission.dtc_blowUp_testForm_corr`,
`ω ↦ ω ∘ η` and `ω' ↦ ω' ∘ ι` (`ι(z) = x + λz`) exchange the admissible forms for
`M_{η(W)}(η_{x,λ#}T)` and `M_W(T)`, preserving the coefficient norm pointwise, and
`η_{x,λ#}T(ω) = λ⁻ⁿ T(ω ∘ η)`; multiplication by `λ⁻ⁿ ≥ 0` commutes with the suprema. -/
theorem Submission.dtc_blowUp_massOn_image : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (x : Euclid P) (lam : ℝ) (hlam : 0 < lam) (W : Set (Euclid P)), (blowUp T x lam hlam.ne').massOn (dilation x lam '' W) = ENNReal.ofReal (lam⁻¹ ^ n) * T.massOn W := by
  intro P n U T x lam hlam W
  obtain ⟨hA, hB, hC⟩ := Submission.dtc_blowUp_testForm_corr P n U x lam hlam
  have hne : lam ≠ 0 := hlam.ne'
  have hc : 0 ≤ lam⁻¹ ^ n := pow_nonneg (inv_nonneg.mpr hlam.le) n
  -- `η = η_{x,λ}` and `ι(z) = x + λz` are continuous and mutually inverse; so `η` is injective.
  have hηι : ∀ z, dilation x lam (x + lam • z) = z := by
    intro z
    simp [dilation, dilationCLM, smul_add, smul_smul, hne]
  have hιη : ∀ y, x + lam • dilation x lam y = y := by
    intro y
    simp [dilation, dilationCLM, smul_add, smul_smul, hne]
  have hηinj : Injective (dilation x lam) := fun y y' h => by
    rw [← hιη y, ← hιη y', h]
  have hηcont : Continuous (dilation x lam) :=
    continuous_const.add (dilationCLM P lam).continuous
  have hιcont : Continuous (fun z : Euclid P => x + lam • z) :=
    continuous_const.add (continuous_const_smul lam)
  unfold GeometricCurrentOn.massOn
  apply le_antisymm
  · -- Upper bound: an admissible `ω` for `η_{x,λ#}T` on `η(W)` gives the admissible
    -- `ω' = ω ∘ η` for `T` on `W` (`tsupport ω' ⊆ η⁻¹(η(W)) = W`), and
    -- `η_{x,λ#}T(ω) = λ⁻ⁿ T(ω')`.
    refine sSup_le ?_
    rintro _ ⟨ω, ⟨hωs, hωn⟩, rfl⟩
    obtain ⟨ω', hω'⟩ := hA ω
    dsimp only
    rw [hC T ω ω' hω', ENNReal.ofReal_mul hc]
    gcongr
    refine le_sSup ⟨ω', ⟨?_, fun y => ?_⟩, rfl⟩
    · have hcomp : (ω' : DifferentialForm (Euclid P) n) =
          (ω : DifferentialForm (Euclid P) n) ∘ dilation x lam := funext hω'
      rw [hcomp]
      refine (tsupport_comp_subset_preimage _ hηcont).trans ((preimage_mono hωs).trans ?_)
      rw [preimage_image_eq W hηinj]
    · rw [hω' y]
      exact hωn _
  · -- Lower bound: an admissible `ω'` for `T` on `W` gives the admissible `ω = ω' ∘ ι` for
    -- `η_{x,λ#}T` on `η(W)` (`tsupport ω ⊆ ι⁻¹(W) ⊆ η(W)`), and `λ⁻ⁿ T(ω') = η_{x,λ#}T(ω)`.
    rw [ENNReal.mul_sSup]
    refine iSup₂_le ?_
    rintro _ ⟨ω', ⟨hωs, hωn⟩, rfl⟩
    obtain ⟨ω, hω⟩ := hB ω'
    dsimp only
    rw [← ENNReal.ofReal_mul hc, ← hC T ω ω' hω]
    refine le_sSup ⟨ω, ⟨?_, fun z => ?_⟩, rfl⟩
    · have hcomp : (ω : DifferentialForm (Euclid P) n) =
          (ω' : DifferentialForm (Euclid P) n) ∘ fun z => x + lam • z := by
        funext z
        rw [Function.comp_apply, hω, hηι]
      rw [hcomp]
      refine (tsupport_comp_subset_preimage _ hιcont).trans fun z hz => ?_
      exact ⟨x + lam • z, hωs hz, hηι z⟩
    · have h := hωn (x + lam • z)
      rwa [hω, hηι] at h

/-- **Blow-ups commute with the current operations** (Simon 6.2.11, 6.2.23–6.2.24(1) for
`η = η_{x,λ}`, `λ > 0`): `η_#(S − T) = η_#S − η_#T`, `η_#` is injective,
`spt(η_#T) = η(spt T)` and `∂(η_#T) = η_#(∂T)`.

(i) Both sides evaluate `S − T` on the same pulled-back form.  (ii) Every `ω' ∈ 𝒟ⁿ(U)` is
`ω ∘ η` for some `ω ∈ 𝒟ⁿ(η(U))`, and `η_#Y(ω) = λ⁻ⁿ Y(ω')` (`dtc_blowUp_testForm_corr`).
(iii) `η` is an affine homeomorphism, and `η_#T` vanishes on `W₀ ⊂⊂ η(U)` iff `T` vanishes on
`η⁻¹(W₀) ⊂⊂ U`; so the zero regions correspond, and `spt(η_#T) = η(spt T)` as `η` is injective.
(iv) `d` commutes with affine pull-back (`GeometricCurrentOn.boundary_affinePushforward`). -/
theorem Submission.dtc_blowUp_algebra : ∀ (P : ℕ) (U : Set (Euclid P)) (x : Euclid P) (lam : ℝ) (hlam : 0 < lam), (∀ (n : ℕ) (S T : GeometricCurrentOn U n), blowUp (S - T) x lam hlam.ne' = blowUp S x lam hlam.ne' - blowUp T x lam hlam.ne') ∧ (∀ (n : ℕ) (S T : GeometricCurrentOn U n), blowUp S x lam hlam.ne' = blowUp T x lam hlam.ne' → S = T) ∧ (∀ (n : ℕ) (T : GeometricCurrentOn U n), (blowUp T x lam hlam.ne').support = dilation x lam '' T.support) ∧ ∀ (m : ℕ) (T : GeometricCurrentOn U (m + 1)), (blowUp T x lam hlam.ne').boundary = blowUp T.boundary x lam hlam.ne' := by
  intro P U x lam hlam
  have hc (n : ℕ) : lam⁻¹ ^ n ≠ 0 := pow_ne_zero n (inv_ne_zero hlam.ne')
  -- `η = η_{x,λ}` as a homeomorphism
  obtain ⟨e, he⟩ : ∃ e : Euclid P ≃ₜ Euclid P, ⇑e = dilation x lam :=
    ⟨(Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hlam.ne')).trans
      (Homeomorph.addLeft (-(lam⁻¹ • x))), by
        funext y
        simp [dilation, dilationCLM]⟩
  refine ⟨fun n S T => GeometricCurrentOn.ext fun ω => rfl, fun n S T h => ?_, fun n T => ?_,
    fun m T => ?_⟩
  · -- (ii) `λ⁻ⁿ S(ω') = η_#S(ω) = η_#T(ω) = λ⁻ⁿ T(ω')`
    obtain ⟨-, hb, hval⟩ := Submission.dtc_blowUp_testForm_corr P n U x lam hlam
    refine GeometricCurrentOn.ext fun ω' => ?_
    obtain ⟨ω, hω⟩ := hb ω'
    have hS := hval S ω ω' hω
    rw [h, hval T ω ω' hω] at hS
    exact mul_left_cancel₀ (hc n) hS.symm
  · -- (iii) the zero regions correspond under `η`
    obtain ⟨ha, hb, hval⟩ := Submission.dtc_blowUp_testForm_corr P n U x lam hlam
    have hzero : (blowUp T x lam hlam.ne').zeroRegion = dilation x lam '' T.zeroRegion := by
      ext z
      constructor
      · rintro ⟨W₀, ⟨hW₀o, hW₀c, hW₀U, hW₀v⟩, hz⟩
        rw [← he] at hW₀U
        have hW : closure (e ⁻¹' W₀) = e ⁻¹' closure W₀ := (e.preimage_closure W₀).symm
        refine ⟨e.symm z, ⟨e ⁻¹' W₀, ⟨hW₀o.preimage e.continuous, ?_, ?_, ?_⟩, ?_⟩, ?_⟩
        · rw [hW]
          exact e.isCompact_preimage.2 hW₀c
        · rw [hW]
          exact (preimage_mono hW₀U).trans (e.preimage_image U).subset
        · intro ω' hω'
          obtain ⟨ω, hω⟩ := hb ω'
          have hsupp : tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W₀ := by
            have hfun : (ω : DifferentialForm (Euclid P) n) =
                (ω' : DifferentialForm (Euclid P) n) ∘ e.symm := by
              funext y
              rw [Function.comp_apply, hω, ← congrFun he (e.symm y), e.apply_symm_apply]
            rw [hfun]
            refine (tsupport_comp_subset_preimage _ e.symm.continuous).trans fun y hy => ?_
            have hy' := hω' (mem_preimage.1 hy)
            rwa [mem_preimage, e.apply_symm_apply] at hy'
          have h0 := hW₀v ω hsupp
          rw [hval T ω ω' hω] at h0
          exact (mul_eq_zero.1 h0).resolve_left (hc n)
        · rwa [mem_preimage, e.apply_symm_apply]
        · rw [← he]
          exact e.apply_symm_apply z
      · rintro ⟨w, ⟨W, ⟨hWo, hWc, hWU, hWv⟩, hw⟩, rfl⟩
        have hW : closure (e '' W) = e '' closure W := (e.image_closure W).symm
        refine ⟨e '' W, ⟨e.isOpenMap W hWo, ?_, ?_, ?_⟩, ?_⟩
        · rw [hW]
          exact hWc.image e.continuous
        · rw [hW, ← he]
          exact image_mono hWU
        · intro ω hω
          obtain ⟨ω', hω'⟩ := ha ω
          have hsupp : tsupport (ω' : DifferentialForm (Euclid P) n) ⊆ W := by
            have hfun : (ω' : DifferentialForm (Euclid P) n) =
                (ω : DifferentialForm (Euclid P) n) ∘ e := by
              funext y
              rw [Function.comp_apply, hω', ← congrFun he y]
            rw [hfun, ← e.preimage_image W]
            exact (tsupport_comp_subset_preimage _ e.continuous).trans (preimage_mono hω)
          rw [hval T ω ω' hω', hWv ω' hsupp, mul_zero]
        · rw [← he]
          exact mem_image_of_mem e hw
    have hinj : Function.Injective (dilation x lam) := he ▸ e.injective
    simp only [GeometricCurrentOn.support]
    rw [hzero, image_sdiff hinj]
  · -- (iv) `d` commutes with the affine pull-back
    unfold blowUp
    rw [GeometricCurrentOn.boundary_affinePushforward]
    rfl
/-- **Every current in `η(U)` is a blow-up**, `η = η_{x,λ}`, `λ > 0` (Simon Ch. 6, 2.23 and 3.9
for `η⁻¹`; used for the minimality of `η_{x,λⱼ#}T` in the proof of 7.3.1, chapter-07.txt
lines 326–338): every `S' ∈ 𝒟ₙ(η(U))` is `η_{x,λ#}S''` for some `S'' ∈ 𝒟ₙ(U)`, integer
multiplicity whenever `S'` is.  `κ = η_{−λ⁻¹x,λ⁻¹}` inverts `η`, so `κ(η(U)) = U`, and `S''` is
`κ_#S'` restricted to `U`: `dtc_blowUp_testForm_corr` for `η` and for `κ` gives
`η_#S''(ω) = λ⁻ⁿ κ_#S'(ω ∘ η) = λ⁻ⁿ λⁿ S'(ω)`, and a representation of `κ_#S'` in
`κ(η(U)) = U` (`dtc_blowUp_imrep`) represents `S''`. -/
theorem Submission.dtc_blowUp_preimage : ∀ (P n : ℕ) (U : Set (Euclid P)) (x : Euclid P) (lam : ℝ) (hlam : 0 < lam) (S' : GeometricCurrentOn (dilation x lam '' U) n), ∃ S'' : GeometricCurrentOn U n, blowUp S'' x lam hlam.ne' = S' ∧ (IsIntegerMultiplicity S' → IsIntegerMultiplicity S'') := by
  intro P n U x lam hlam S'
  have hlam' : 0 < lam⁻¹ := inv_pos.mpr hlam
  -- `κ = η_{−λ⁻¹x,λ⁻¹}`, `κ(z) = x + λz`, is a two-sided inverse of `η = η_{x,λ}`
  have hκη : ∀ y, dilation (-(lam⁻¹ • x)) lam⁻¹ (dilation x lam y) = y := fun y => by
    simp [dilation, dilationCLM, smul_smul, hlam.ne']
  have hηκ : ∀ z, dilation x lam (dilation (-(lam⁻¹ • x)) lam⁻¹ z) = z := fun z => by
    simp [dilation, dilationCLM, smul_smul, hlam.ne']
  have hdom : dilation (-(lam⁻¹ • x)) lam⁻¹ '' (dilation x lam '' U) = U := by
    rw [image_image]
    simp only [hκη, image_id']
  have hUV : U ⊆ dilation (-(lam⁻¹ • x)) lam⁻¹ '' (dilation x lam '' U) := hdom.superset
  obtain ⟨hpull, -, hblow⟩ := Submission.dtc_blowUp_testForm_corr P n U x lam hlam
  have hblow' := (Submission.dtc_blowUp_testForm_corr P n (dilation x lam '' U)
    (-(lam⁻¹ • x)) lam⁻¹ hlam').2.2
  -- `S'' := κ_#S'`, restricted from `κ(η(U)) = U` to `U`
  refine ⟨(blowUp S' (-(lam⁻¹ • x)) lam⁻¹ hlam'.ne').restrictDomain hUV, ?_, ?_⟩
  · -- `η_#S''(ω) = λ⁻ⁿ S''(ω ∘ η)` and `κ_#S'(ω ∘ η) = λⁿ S'(ω)`, as `ω ∘ η ∘ κ = ω`
    ext ω
    obtain ⟨ω', hω'⟩ := hpull ω
    rw [hblow _ ω ω' hω', GeometricCurrentOn.restrictDomain_apply,
      hblow' S' (testFormOnInclusion hUV n ω') ω fun z => by
        rw [testFormOnInclusion_coe, hω', hηκ],
      ← mul_assoc, ← mul_pow, inv_inv, inv_mul_cancel₀ hlam.ne', one_pow, one_mul]
  · -- a representation of `κ_#S'` in `κ(η(U)) = U` is one in `U`, and it represents `S''`
    rintro ⟨R₁, hR₁⟩
    obtain ⟨R₂, hR₂, -⟩ := Submission.dtc_blowUp_imrep P n (dilation x lam '' U) S'
      (-(lam⁻¹ • x)) lam⁻¹ hlam' R₁ hR₁
    exact ⟨{ R₂ with
        carrier_subset := R₂.carrier_subset.trans hdom.subset
        locallyIntegrable_mult := fun K hK hKU =>
          R₂.locallyIntegrable_mult K hK (hKU.trans hUV) },
      fun ω => hR₂ (testFormOnInclusion hUV n ω)⟩

/-- **Blow-ups preserve minimality** (Simon 7.1.1, chapter-07.txt lines 12–18, for `η = η_{x,λ}`,
`λ > 0`; used for `η_{x,λⱼ#}T` in the proof of 7.3.1, chapter-07.txt lines 329–337): if `T` is
minimizing in `A`, then `η_#T` is minimizing in `η(A)`.

`η_#T` is integer multiplicity (`dtc_blowUp_imrep`).  A competitor `S'` for `η_#T` on
`W' ⊂⊂ η(U)` is `η_#S''` with `S''` integer multiplicity (`dtc_blowUp_preimage`), and `S''` is a
competitor for `T` on `W = η⁻¹(W') ⊂⊂ U`: `∂S'' = ∂T` and
`spt(S'' − T) = η⁻¹(spt(S' − η_#T)) ⊆ A ∩ W` (`dtc_blowUp_algebra`).  So
`M_{W'}(η_#T) = λ⁻ⁿ M_W(T) ≤ λ⁻ⁿ M_W(S'') = M_{W'}(S')` (`dtc_blowUp_massOn_image`). -/
theorem Submission.dtc_blowUp_isMinimizingIn : ∀ (P n : ℕ) (U A : Set (Euclid P)) (T : GeometricCurrentOn U n) (x : Euclid P) (lam : ℝ) (hlam : 0 < lam), IsMinimizingIn T A → IsMinimizingIn (blowUp T x lam hlam.ne') (dilation x lam '' A) := by
  intro P n U A T x lam hlam hT
  obtain ⟨⟨R, hR⟩, hmin⟩ := hT
  obtain ⟨hsub, hinj, hspt, hbdry⟩ := Submission.dtc_blowUp_algebra P U x lam hlam
  -- `η = η_{x,λ}` as a homeomorphism
  obtain ⟨e, he⟩ : ∃ e : Euclid P ≃ₜ Euclid P, ⇑e = dilation x lam :=
    ⟨(Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hlam.ne')).trans
      (Homeomorph.addLeft (-(lam⁻¹ • x))), by
        funext y
        simp [dilation, dilationCLM]⟩
  refine ⟨?_, fun W' S' hW'o hW'c hS'im hS'bd hS'c hS'A => ?_⟩
  · -- `η_#T` is integer multiplicity
    obtain ⟨R', hR', -⟩ := Submission.dtc_blowUp_imrep P n U T x lam hlam R hR
    exact ⟨R', hR'⟩
  -- `S' = η_#S''` with `S''` integer multiplicity
  obtain ⟨S'', rfl, hS''im⟩ := Submission.dtc_blowUp_preimage P n U x lam hlam S'
  -- `W = η⁻¹(W')` is open and `W ⊂⊂ U`, since `closure W = η⁻¹(closure W')` and `η⁻¹(η(U)) = U`
  have hWo : IsOpen (dilation x lam ⁻¹' W') := by
    rw [← he]
    exact hW'o.preimage e.continuous
  have hWc : CompactlyContained (dilation x lam ⁻¹' W') U := by
    obtain ⟨hc, hsub'⟩ := hW'c
    rw [← he] at hsub' ⊢
    refine ⟨?_, ?_⟩ <;> rw [← e.preimage_closure]
    · exact e.isCompact_preimage.2 hc
    · exact (preimage_mono hsub').trans (e.preimage_image U).subset
  -- `∂S'' = ∂T`: `η_#(∂S'') = ∂S' = ∂(η_#T) = η_#(∂T)` and `η_#` is injective
  have hbd : SameBoundary S'' T := by
    cases n with
    | zero => trivial
    | succ m =>
      show S''.boundary = T.boundary
      apply hinj
      rw [← hbdry, ← hbdry]
      exact hS'bd
  -- `spt(S' − η_#T) = η(spt(S'' − T))`, so `spt(S'' − T)` is compact and lies in `A ∩ W`
  have hspt' : (blowUp S'' x lam hlam.ne' - blowUp T x lam hlam.ne').support =
      dilation x lam '' (S'' - T).support := by
    rw [← hsub, hspt]
  rw [hspt', ← he] at hS'c hS'A
  have hc : IsCompact (S'' - T).support := e.isCompact_image.1 hS'c
  have hA : (S'' - T).support ⊆ A ∩ dilation x lam ⁻¹' W' := by
    intro y hy
    obtain ⟨⟨a, ha, hay⟩, hyW'⟩ := hS'A (mem_image_of_mem e hy)
    rw [← he]
    exact ⟨e.injective hay ▸ ha, hyW'⟩
  -- `M_{W'}(η_#T) = λ⁻ⁿ M_W(T) ≤ λ⁻ⁿ M_W(S'') = M_{W'}(S')`, as `η(W) = W'`
  have hle := hmin _ S'' hWo hWc (hS''im hS'im) hbd hc hA
  have hW' : dilation x lam '' (dilation x lam ⁻¹' W') = W' := by
    rw [← he]
    exact e.image_preimage W'
  have hmT := Submission.dtc_blowUp_massOn_image P n U T x lam hlam (dilation x lam ⁻¹' W')
  have hmS := Submission.dtc_blowUp_massOn_image P n U S'' x lam hlam (dilation x lam ⁻¹' W')
  rw [hW'] at hmT hmS
  rw [hmT, hmS]
  gcongr

/-- **Scaling of blow-ups** `η_{x,λ#}T`, `η = η_{x,λ}`, `λ > 0` (proof of Simon 7.3.1,
chapter-07.txt lines 326–338; push-forward 6.2.23 and 6.3.3–6.3.9): (1) the mass scaling
`M_{η(W)}(η_#T) = λ⁻ⁿ M_W(T)` of (1) there (`dtc_blowUp_massOn_image`); (2) a representation
`(M, θ, ξ)` of `T` pushes forward to one of `η_#T` with `μ_{η_#T}(B) = λ⁻ⁿ μ_T(η⁻¹(B))`
(`dtc_blowUp_imrep`); (3) `η_#T` is minimizing in `η(A)` if `T` is minimizing in `A`
(`dtc_blowUp_isMinimizingIn`).  The hypotheses `U` open and `n > 0` are not needed. -/
theorem Submission.dtc_blowUp_scaling : ∀ (P n : ℕ) (U A : Set (Euclid P)) (T : GeometricCurrentOn U n) (x : Euclid P) (lam : ℝ) (hlam : 0 < lam), IsOpen U → 0 < n → (∀ W : Set (Euclid P), (blowUp T x lam hlam.ne').massOn (dilation x lam '' W) = ENNReal.ofReal (lam⁻¹ ^ n) * T.massOn W) ∧ (∀ R : IMRep U n, R.Represents T → ∃ R' : IMRep (dilation x lam '' U) n, R'.Represents (blowUp T x lam hlam.ne') ∧ ∀ s : Set (Euclid P), MeasurableSet s → R'.measure s = ENNReal.ofReal (lam⁻¹ ^ n) * R.measure (dilation x lam ⁻¹' s)) ∧ (IsMinimizingIn T A → IsMinimizingIn (blowUp T x lam hlam.ne') (dilation x lam '' A)) := by
  intro P n U A T x lam hlam _ _
  exact ⟨Submission.dtc_blowUp_massOn_image P n U T x lam hlam,
    Submission.dtc_blowUp_imrep P n U T x lam hlam,
    Submission.dtc_blowUp_isMinimizingIn P n U A T x lam hlam⟩

/-- **Simon 7.3.1** (proof, display (1), display (4) and "for each `ρ > 0`"): let `T`, `C` be
integer multiplicity, `Θⁿ(μ_T, x) = θ`, `λⱼ > 0`, `λⱼ → 0` and `μ_{η_{x,λⱼ#}T} → μ_C`.  Then
`M_{B_ρ(0)}(C) = ωₙρⁿθ` for every `ρ > 0`, hence `Θⁿ(μ_C, 0) = θ`.  Representations `Rⱼ` of the
blow-ups (`dtc_blowUp_scaling`) have `μ_{Rⱼ}(B_ρ(0)) → ωₙρⁿθ` (`μ_T = μ_R` on small balls by
`dtc_mass_eq_measure`) and, when `μ_C(∂B_ρ(0)) = 0`, `μ_{Rⱼ}(B_ρ(0)) → μ_C(B_ρ(0))`; the identity
at these radii extends to every `ρ > 0`. -/
theorem Submission.dtc_blowUp_density : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (x : Euclid P) (θ : ℝ) (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), IsOpen U → 0 < n → x ∈ U → IsIntegerMultiplicity T → IsIntegerMultiplicity C → Tendsto lams atTop (𝓝 0) → HasMassDensity T x θ → MassMeasuresConverge (fun j => blowUp T x (lams j) (hlams j).ne') C → (∀ ρ : ℝ, 0 < ρ → C.massOn (ball 0 ρ) = unitBallVolume n * ENNReal.ofReal (ρ ^ n) * ENNReal.ofReal θ) ∧ HasMassDensity C 0 θ := by
  intro P n U T C x θ lams hlams hU hn hxU hT hC hlim hdens hconv
  obtain ⟨R, hR⟩ := hT
  obtain ⟨RC, hRC⟩ := hC
  have hω0 : unitBallVolume n ≠ 0 :=
    (measure_ball_pos volume (0 : Euclid n) zero_lt_one).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  -- Step 1: representations `Rⱼ` of `η_{x,λⱼ#}T` with `μ_{Rⱼ}(s) = λⱼ⁻ⁿ μ_R(η_{x,λⱼ}⁻¹(s))`
  choose Rs hRs hRsm using fun j =>
    (Submission.dtc_blowUp_scaling P n U U T x (lams j) (hlams j) hU hn).2.1 R hR
  -- Step 2 (book (1)): `μ_T = μ_R` on the balls `B_r(x) ⊆ U`, so `μ_{Rⱼ}(B_ρ(0)) → ωₙρⁿθ`
  obtain ⟨δ, hδ, hδU⟩ := Metric.isOpen_iff.1 hU x hxU
  have hdensR : Tendsto (fun r : ℝ => R.measure (ball x r) /
      (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) (𝓝 (ENNReal.ofReal θ)) := by
    refine hdens.2.congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hδ] with r hr
    rw [Submission.dtc_mass_eq_measure P n U (ball x r) T R hU isOpen_ball
      ((ball_subset_ball hr.2.le).trans hδU) hR]
  have hlimRs : ∀ ρ : ℝ, 0 < ρ → Tendsto (fun j => (Rs j).measure (ball 0 ρ)) atTop
      (𝓝 (unitBallVolume n * ENNReal.ofReal (ρ ^ n) * ENNReal.ofReal θ)) :=
    Submission.dtc_rescaled_ball_measure_tendsto P n R.measure (fun j => (Rs j).measure) x θ lams
      hlams hlim hdensR hRsm
  -- Step 3: `μ_C` is finite on balls (`θ_C` is locally integrable), and so is `μ_{Rⱼ}` for large
  -- `j`, its limit being finite
  have hfinC : ∀ r : ℝ, 0 < r → RC.measure (ball 0 r) ≠ ∞ := by
    intro r _
    refine ne_top_of_le_ne_top ?_ (measure_mono ball_subset_closedBall)
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact RC.locallyIntegrable_mult _ (isCompact_closedBall 0 r) (subset_univ _)
  have hfinRs : ∀ r : ℝ, 0 < r → ∀ᶠ j in atTop, (Rs j).measure (ball 0 r) ≠ ∞ := fun r hr =>
    (hlimRs r hr).eventually (eventually_ne_nhds (ENNReal.mul_ne_top
      (ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top) ENNReal.ofReal_ne_top))
  -- Step 4 (book (4)): if `μ_C(∂B_ρ(0)) = 0` then `μ_{Rⱼ}(B_ρ(0)) → μ_C(B_ρ(0))`, so
  -- `μ_C(B_ρ(0)) = ωₙρⁿθ`; this extends to every `ρ > 0`
  have hgood : ∀ ρ : ℝ, 0 < ρ → RC.measure (sphere 0 ρ) = 0 →
      RC.measure (ball 0 ρ) = unitBallVolume n * ENNReal.ofReal θ * ENNReal.ofReal (ρ ^ n) := by
    intro ρ hρ hsph
    rw [mul_right_comm]
    exact tendsto_nhds_unique (Submission.dtc_tendsto_measure_ball_of_vague P
      (fun j => (Rs j).measure) RC.measure ρ hρ hfinC hfinRs
      (fun f hf hfc => hconv Rs hRs RC hRC f hf hfc (subset_univ _)) hsph) (hlimRs ρ hρ)
  have hball := Submission.dtc_measure_ball_eq_of_null_sphere P n RC.measure
    (unitBallVolume n * ENNReal.ofReal θ) (ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top) hfinC
    hgood
  -- Step 5: `M_{B_ρ(0)}(C) = μ_C(B_ρ(0)) = ωₙρⁿθ`
  have hmass : ∀ ρ : ℝ, 0 < ρ → C.massOn (ball 0 ρ) =
      unitBallVolume n * ENNReal.ofReal (ρ ^ n) * ENNReal.ofReal θ := fun ρ hρ => by
    rw [Submission.dtc_mass_eq_measure P n univ (ball 0 ρ) C RC isOpen_univ isOpen_ball
      (subset_univ _) hRC, hball ρ hρ, mul_right_comm]
  -- Step 6: the density quotient of `C` at `0` is `θ` on all of `(0, ∞)`
  refine ⟨hmass, hdens.1, tendsto_const_nhds.congr' ?_⟩
  filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
  rw [hmass ρ hρ, mul_comm (unitBallVolume n * ENNReal.ofReal (ρ ^ n)),
    ENNReal.mul_div_cancel_right (mul_ne_zero hω0 (ENNReal.ofReal_pos.2 (pow_pos hρ n)).ne')
      (ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top)]

/-- **Simon 7.2.4, local comparison: `f` fixes `T` near `spt T`.**  Let `T = τ(M, θ, ξ)` in `U`,
`O` open and `f` differentiable on `O` with `f = id` on `spt T ∩ O`.  Then for `Hⁿ`-a.e.
`x ∈ M ∩ O`, `f(x) = x` and `⟨α ∘ ΛⁿDf(x), ξ(x)⟩ = ⟨α, ξ(x)⟩` for every `n`-covector `α`.
Since `Hⁿ(M ∖ spt T) = 0`, a.e. `x ∈ M ∩ O` lies in `A = M ∩ (spt T ∩ O)`, and `ξ(x)` orients an
approximate tangent plane `Q` of `M` at `x` (Simon 6.3.1).  As `(M ∖ A) ∩ O` is `Hⁿ`-null and
`x ∈ O`, `Q` is also one of `A` (Ch. 3, 1.4).  `f` fixes `A` and is differentiable at `x`, so
`Df(x)` fixes `Q`, and hence `ΛⁿDf(x)` fixes `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ`. -/
theorem Submission.dtc_bc_lc_orient_fixed : ∀ (P n : ℕ) (U O : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n) (f : Euclid P → Euclid P), IsOpen U → IsOpen O → R.Represents T → DifferentiableOn ℝ f O → (∀ y ∈ T.support ∩ O, f y = y) → ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ O)), f x = x ∧ ∀ α : Covector (Euclid P) n, R.orient x (α.compContinuousLinearMap (fderiv ℝ f x)) = R.orient x α := by
  intro P n U O T R f hU hO hRT hf hfix
  -- `Hⁿ(M ∖ spt T) = 0`, so the good set `A = M ∩ (spt T ∩ O)` has `Hⁿ((M ∖ A) ∩ O) = 0`
  have hnull : μHE[n] (R.carrier \ T.support) = 0 :=
    Submission.imrep_carrier_sdiff_support_null P n U T R hU hRT
  have hAnull : μHE[n] ((R.carrier \ (R.carrier ∩ (T.support ∩ O))) ∩ O) = 0 := by
    refine measure_mono_null (fun y hy => ?_) hnull
    exact ⟨hy.1.1, fun hyS => hy.1.2 ⟨hy.1.1, hyS, hy.2⟩⟩
  have hMO : MeasurableSet (R.carrier ∩ O) := R.measurableSet_carrier.inter hO.measurableSet
  -- `Hⁿ`-a.e. `x ∈ M ∩ O` lies in `spt T`, and `ξ(x)` orients an approximate tangent plane of `M`
  have hS : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ O)), x ∈ T.support := by
    rw [ae_iff, Measure.restrict_apply' hMO]
    refine measure_mono_null (fun y hy => ?_) hnull
    exact ⟨hy.2.1, hy.1⟩
  have hor : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ O)), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n R.carrier x Q ∧ IsUnitOrientationOf (R.orient x) Q :=
    ae_restrict_of_ae_restrict_of_subset inter_subset_left R.orients
  filter_upwards [ae_restrict_mem hMO, hS, hor] with x hx hxS ⟨Q, hQ, hξ⟩
  have hfx : f x = x := hfix x ⟨hxS, hx.2⟩
  -- `Q` is an approximate tangent plane of `A` at `x ∈ O`, and `Df(x)` fixes it
  have hQA : HasApproximateTangentSpaceAt n (R.carrier ∩ (T.support ∩ O)) x Q :=
    Submission.dtc_approxTangent_of_null_diff P n R.carrier _ O x Q inter_subset_left hO hx.2
      hAnull hQ
  have hDf : ∀ v ∈ Q, fderiv ℝ f x v = v :=
    Submission.dtc_bc_lc_fderiv_apply_eq_of_approxTangent P n _ f x Q hQA
      (hf.differentiableAt (hO.mem_nhds hx.2)) hfx fun y hy => hfix y hy.2
  -- so `ΛⁿDf(x)` fixes the unit orientation `ξ(x)` of `Q`
  exact ⟨hfx, Submission.dtc_bc_lc_unitOrientation_comp_eq P n (R.orient x) Q (fderiv ℝ f x) hξ hDf⟩

/-- **A covector vanishing on all increasing tuples of standard basis vectors is zero**
(definiteness of the Euclidean coefficient norm).  With `e` the standard basis of `ℝᴾ`, an
alternating map is determined by its values `α(e_{J(0)}, …, e_{J(n-1)})` on injective
`J : Fin n → Fin P`.  For such `J`, `σ = Tuple.sort J` makes `J ∘ σ` monotone and injective, hence
strictly increasing, so `0 = α(e_{J ∘ σ}) = sign σ • α(e_J)` with `sign σ = ±1`. -/
theorem Submission.cbr_ci_dr_dn_covector_eq_zero_of_coords : ∀ (P n : ℕ) (α : Covector (Euclid P) n), (∀ I : Fin n → Fin P, StrictMono I → α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i)) = 0) → α = 0 := by
  intro P n α h
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- Step 1: it suffices to check `α(e_J) = 0` for injective `J`
  apply ContinuousAlternatingMap.toAlternatingMap_injective
  refine e.ext_alternating fun J hJ => ?_
  show α (fun i => e (J i)) = (0 : ℝ)
  -- Step 2: sorting `J` gives a strictly increasing `J ∘ σ`
  have hmono : StrictMono (J ∘ Tuple.sort J) :=
    (Tuple.monotone_sort J).strictMono_of_injective (hJ.comp (Tuple.sort J).injective)
  -- Step 3: `0 = α(e_J ∘ σ) = sign σ • α(e_J)`, and `sign σ = ±1`
  have h1 : α.toAlternatingMap ((fun i => e (J i)) ∘ Tuple.sort J) = 0 := h _ hmono
  rw [AlternatingMap.map_perm] at h1
  rcases Int.units_eq_one_or (Equiv.Perm.sign (Tuple.sort J)) with hs | hs <;> simpa [hs] using h1
/-- **`C¹` approximation** (Simon Ch. 2, Theorem 1.5).  If `f : ℝⁿ → ℝ` is `K`-Lipschitz and
`ε > 0`, there is `g ∈ C¹(ℝⁿ)` with `Lⁿ({f ≠ g} ∪ {Df ≠ Dg}) < ε`.  By Rademacher (1.4) `f` is
differentiable on a Borel set `B` of full measure.  Lusin gives a closed `C ⊆ B` with `Df|C`
continuous and `Lⁿ(B \ C) < ε/2`; the remainder estimate gives a closed `A ⊆ C` with
`Lⁿ(C \ A) < ε/2` on which `f, Df` satisfy Whitney's condition 1.6(∗); Whitney's extension
theorem (1.6) gives `g ∈ C¹` with `g = f` and `Dg = Df` on `A`.  The exceptional set lies in
`Aᶜ ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`. -/
theorem Submission.codim1_rdo_c1_approximation : ∀ (n : ℕ) (f : Euclid n → ℝ) (K : NNReal), LipschitzWith K f → ∀ ε : ℝ≥0∞, 0 < ε → ∃ g : Euclid n → ℝ, ContDiff ℝ 1 g ∧ volume {x | f x ≠ g x ∨ fderiv ℝ f x ≠ fderiv ℝ g x} < ε := by
  intro n f K hf ε hε
  -- Rademacher: `f` is differentiable on the Borel set `B`, whose complement is null
  set B : Set (Euclid n) := {x | DifferentiableAt ℝ f x}
  have hBm : MeasurableSet B := measurableSet_of_differentiableAt ℝ f
  have hBc : volume Bᶜ = 0 := ae_iff.mp hf.ae_differentiableAt
  -- Lusin: a closed `C ⊆ B` with `Df` continuous on `C` and `Lⁿ(B \ C) < ε/2`
  obtain ⟨C, hCB, hC, hDC, hBC⟩ := Submission.codim1_rdo_c1a_lusin_isClosed n (fderiv ℝ f) B
    (measurable_fderiv ℝ f) hBm (ε / 2) (ENNReal.half_pos hε.ne')
  -- a closed `A ⊆ C` with `Lⁿ(C \ A) < ε/2` on which Whitney's condition 1.6(∗) holds
  obtain ⟨A, hAC, hA, hCA, hR⟩ := Submission.codim1_rdo_c1a_whitney_remainder n f K C hf hC
    (fun x hx => hCB hx) hDC (ε / 2) (ENNReal.half_pos hε.ne')
  -- Whitney: `g ∈ C¹` with `g = f` and `Dg = Df` on `A`
  obtain ⟨g, hg, hgf, hDg⟩ := Submission.codim1_rdo_c1a_whitney_extension n A f (fderiv ℝ f) hA
    hf.continuous.continuousOn (hDC.mono hAC) hR
  refine ⟨g, hg, ?_⟩
  -- the exceptional set misses `A`, and `Aᶜ ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`
  calc volume {x | f x ≠ g x ∨ fderiv ℝ f x ≠ fderiv ℝ g x}
      ≤ volume (Bᶜ ∪ (B \ C) ∪ (C \ A)) := by
        refine measure_mono fun x hx => ?_
        by_cases hxA : x ∈ A
        · rcases hx with hfg | hfg
          · exact absurd (hgf hxA).symm hfg
          · exact absurd (hDg x hxA).fderiv.symm hfg
        by_cases hxC : x ∈ C
        · exact Or.inr ⟨hxC, hxA⟩
        by_cases hxB : x ∈ B
        · exact Or.inl (Or.inr ⟨hxB, hxC⟩)
        · exact Or.inl (Or.inl hxB)
    _ ≤ volume (Bᶜ ∪ (B \ C)) + volume (C \ A) := measure_union_le _ _
    _ ≤ volume Bᶜ + volume (B \ C) + volume (C \ A) := by gcongr; exact measure_union_le _ _
    _ < ε / 2 + ε / 2 := by
        rw [hBc, zero_add]
        exact ENNReal.add_lt_add hBC hCA
    _ = ε := ENNReal.add_halves ε

/-- **Simon Ch. 3, Lemma 1.2, "only if"** (chapter-03.txt lines 39–65, in the lemma at lines
25–66), in quantitative form: a countably `n`-rectifiable `M ⊆ ℝᴾ` is covered, up to an
`Hⁿ`-null set, by countably many images `Nₖ = gₖ(B_{rₖ}(cₖ))` of open balls under C¹ maps
`gₖ : ℝⁿ → ℝᴾ` with lower Lipschitz bounds `mₖ|a − b| ≤ |gₖ(a) − gₖ(b)|` on the balls, each `Nₖ`
Borel with `Hⁿ(Nₖ) < ∞`.  By Definition 1.1, `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ)` with `Hⁿ(M₀) = 0` and `Fⱼ`
Lipschitz.  The C¹ approximation theorem (Simon Ch. 2, 1.5) covers `Fⱼ(ℝⁿ)` by C¹ images
`Gⱼᵢ(ℝⁿ)` up to a null set, and `Gⱼᵢ(ℝⁿ)` is covered, up to its null critical image, by images of
balls carrying lower Lipschitz bounds.  The triples `(j, i, q)` are enumerated by applying
`Nat.unpair` twice. -/
theorem Submission.codim1_rdo_rectifiable_c1_cover : ∀ (P n : ℕ) (M : Set (Euclid P)), CountablyRectifiable n M → ∃ (g : ℕ → Euclid n → Euclid P) (c : ℕ → Euclid n) (r m : ℕ → ℝ), (∀ k, ContDiff ℝ 1 (g k)) ∧ (∀ k, 0 < m k) ∧ (∀ k, ∀ a ∈ ball (c k) (r k), ∀ b ∈ ball (c k) (r k), m k * ‖a - b‖ ≤ ‖g k a - g k b‖) ∧ (∀ k, MeasurableSet (g k '' ball (c k) (r k))) ∧ (∀ k, μHE[n] (g k '' ball (c k) (r k)) ≠ ∞) ∧ μHE[n] (M \ ⋃ k, g k '' ball (c k) (r k)) = 0 := by
  intro P n M hM
  -- Step 1 (Definition 1.1): `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ)` with `Hⁿ(M₀) = 0` and `Fⱼ` `Kⱼ`-Lipschitz.
  obtain ⟨M₀, hM₀, F, hF, hcover⟩ := hM
  choose K hK using hF
  -- Steps 2–3: C¹ maps `Gⱼᵢ` with `Hⁿ(Fⱼ(ℝⁿ) ∖ ⋃ᵢ Gⱼᵢ(ℝⁿ)) = 0`, by the C¹ approximation theorem.
  choose G hG hFG using fun j => Submission.codim1_rdo_c1cov_lipschitz_range_c1_cover P n
    (Submission.codim1_rdo_c1_approximation n) (F j) (K j) (hK j)
  -- Steps 4–6: balls `B_{rⱼᵢq}(cⱼᵢq)` on which `Gⱼᵢ` has lower Lipschitz constant `mⱼᵢq > 0`,
  -- whose images cover `Gⱼᵢ(ℝⁿ)` up to an `Hⁿ`-null set.
  choose c r m hm hlow hGB using fun j i => Submission.codim1_rdo_c1cov_regular_ball_cover P n
    (G j i) (hG j i)
  -- Step 7: `k ↦ (J k, I k, Q k)` maps `ℕ` onto `ℕ³` (`Nat.unpair` applied twice).
  obtain ⟨J, I, Q, hJIQ⟩ : ∃ J I Q : ℕ → ℕ, ∀ j i q, ∃ k, J k = j ∧ I k = i ∧ Q k = q :=
    ⟨fun k => k.unpair.1, fun k => k.unpair.2.unpair.1, fun k => k.unpair.2.unpair.2,
      fun j i q => ⟨Nat.pair j (Nat.pair i q), by simp⟩⟩
  -- Step 8: the pieces `Nₖ` are Borel with finite `Hⁿ`-measure.
  have hN k := Submission.codim1_rdo_c1cov_image_ball_borel_finite P n (G (J k) (I k))
    (c (J k) (I k) (Q k)) (r (J k) (I k) (Q k)) (hG (J k) (I k))
  refine ⟨fun k => G (J k) (I k), fun k => c (J k) (I k) (Q k), fun k => r (J k) (I k) (Q k),
    fun k => m (J k) (I k) (Q k), fun k => hG _ _, fun k => hm _ _ _, fun k => hlow _ _ _,
    fun k => (hN k).1, fun k => (hN k).2, ?_⟩
  -- Step 9: `M ∖ ⋃ₖ Nₖ` lies in the countable union of `Hⁿ`-null sets
  -- `M₀ ∪ ⋃ⱼ (Fⱼ(ℝⁿ) ∖ ⋃ᵢ Gⱼᵢ(ℝⁿ)) ∪ ⋃ⱼ ⋃ᵢ (Gⱼᵢ(ℝⁿ) ∖ ⋃_q Gⱼᵢ(B_{rⱼᵢq}(cⱼᵢq)))`.
  refine measure_mono_null ?_ (measure_union_null hM₀ (measure_union_null (measure_iUnion_null hFG)
    (measure_iUnion_null fun j => measure_iUnion_null (hGB j))))
  rintro y ⟨hyM, hyN⟩
  rcases hcover hyM with hy₀ | hyF
  · exact Or.inl hy₀
  obtain ⟨j, hyj⟩ := mem_iUnion.1 hyF
  by_cases hyG : y ∈ ⋃ i, range (G j i)
  · obtain ⟨i, hyi⟩ := mem_iUnion.1 hyG
    by_cases hyB : y ∈ ⋃ q, G j i '' ball (c j i q) (r j i q)
    · obtain ⟨q, hyq⟩ := mem_iUnion.1 hyB
      obtain ⟨k, rfl, rfl, rfl⟩ := hJIQ j i q
      exact absurd (mem_iUnion.2 ⟨k, hyq⟩) hyN
    · exact Or.inr (Or.inr (mem_iUnion.2 ⟨j, mem_iUnion.2 ⟨i, hyi, hyB⟩⟩))
  · exact Or.inr (Or.inl (mem_iUnion.2 ⟨j, hyj, hyG⟩))
/-- **Area formula for an injective immersion, Gram form** (Simon Ch. 2, 3.1–3.5; step (1b)
of the chart divergence formula in the proof of Simon 7.5.2).  Let `G : ℝᵐ → ℝᴾ` be
differentiable with injective derivative at every point of the Borel set `F` and injective on `F`.
With `eᵢ` the standard basis of `ℝᵐ`, every `h : ℝᴾ → ℝ` has
`∫_{G(F)} h dHᵐ = ∫_F √det(⟨DG(v)eᵢ, DG(v)eⱼ⟩) h(G(v)) dv`.

Linear case (Simon 3.1): an injective linear `B` factors as `ι ∘ C` with `ι` an isometry of `ℝᵐ`
onto `range B`, so `Hᵐ(B S) = |det C| Lᵐ(S)`, and the Gram matrix of `B` is `CᵀC`.  The
approximation argument for 3.2: on countably many Borel pieces of `F`, `G` and (a.e.) `DG` are
`η`-close to an injective linear map, so the Lipschitz bound for `Hᵐ` puts `Hᵐ(G t)` and `∫_t J`
within a factor `(1 + 2η)^{2m}` of each other for Borel `t ⊆ F`.  Letting `η → 0` gives
`Hᵐ(G t) = ∫_t J`, and the integral identity follows as for
`integral_image_eq_integral_abs_det_fderiv_smul`. -/
theorem Submission.codim1_lur_cd_injective_area_formula_gram : ∀ (P m : ℕ) (G : Euclid m → Euclid P) (F : Set (Euclid m)), MeasurableSet F → (∀ v ∈ F, DifferentiableAt ℝ G v) → (∀ v ∈ F, Function.Injective (fderiv ℝ G v)) → InjOn G F → ∀ h : Euclid P → ℝ, ∫ w in G '' F, h w ∂μHE[m] = ∫ v in F, Real.sqrt (Matrix.det (Matrix.of fun i j : Fin m => inner ℝ (fderiv ℝ G v (EuclideanSpace.single i 1)) (fderiv ℝ G v (EuclideanSpace.single j 1)))) * h (G v) := by
  intro P m G F hF hG hreg hinj h
  -- `Jf B = √det(⟨B eᵢ, B eⱼ⟩)`, the Gram Jacobian of a linear map `B : ℝᵐ → ℝᴾ`
  set Jf : (Euclid m →L[ℝ] Euclid P) → ℝ := fun B => Real.sqrt (Matrix.det (Matrix.of
    fun i j : Fin m => inner ℝ (B (EuclideanSpace.single i 1)) (B (EuclideanSpace.single j 1))))
  -- (1) Linear area formula: `B = ι ∘ C` with `ι` an isometry onto `range B`, so
  -- `Hᵐ(B S) = Lᵐ(C S) = |det C| Lᵐ(S)`, and `⟨B eᵢ, B eⱼ⟩ = ⟨C eᵢ, C eⱼ⟩ = (CᵀC)ᵢⱼ`.
  have hlin : ∀ B : Euclid m →L[ℝ] Euclid P, Injective B → ∀ S : Set (Euclid m),
      μHE[m] (B '' S) = ENNReal.ofReal (Jf B) * volume S := by
    intro B hB S
    have hW : Module.finrank ℝ (LinearMap.range (B : Euclid m →ₗ[ℝ] Euclid P)) = m := by
      rw [LinearMap.finrank_range_of_inj hB, finrank_euclideanSpace_fin]
    set b := (stdOrthonormalBasis ℝ (LinearMap.range (B : Euclid m →ₗ[ℝ] Euclid P))).reindex
      (finCongr hW)
    set C : Euclid m →ₗ[ℝ] Euclid m :=
      b.repr.toLinearMap ∘ₗ (B : Euclid m →ₗ[ℝ] Euclid P).rangeRestrict
    have hBC : ∀ x, B x = (b.repr.symm (C x) : Euclid P) := fun x => by simp [C]
    have hι : Isometry fun y => (b.repr.symm y : Euclid P) :=
      isometry_subtype_coe.comp b.repr.symm.isometry
    have hgram : Jf B = |LinearMap.det C| := by
      set e := (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
      have hM : (Matrix.of fun i j : Fin m => inner ℝ (B (EuclideanSpace.single i 1))
          (B (EuclideanSpace.single j 1))) =
          (LinearMap.toMatrix e e C).transpose * LinearMap.toMatrix e e C := by
        ext i j
        rw [Matrix.of_apply, hBC, hBC, ← Submodule.coe_inner, LinearIsometryEquiv.inner_map_map,
          Matrix.mul_apply]
        simp only [Matrix.transpose_apply, LinearMap.toMatrix_apply, e,
          OrthonormalBasis.coe_toBasis, OrthonormalBasis.coe_toBasis_repr_apply,
          EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr, PiLp.inner_apply,
          RCLike.inner_apply, conj_trivial]
        exact Finset.sum_congr rfl fun k _ => mul_comm _ _
      show Real.sqrt _ = _
      rw [hM, Matrix.det_mul, Matrix.det_transpose, LinearMap.det_toMatrix, ← sq,
        Real.sqrt_sq_eq_abs]
    rw [show B '' S = (fun y => (b.repr.symm y : Euclid P)) '' (C '' S) by
        rw [image_image]; exact image_congr fun x _ => hBC x,
      hι.euclideanHausdorffMeasure_image, EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
      Measure.addHaar_image_linearMap, hgram]
  -- (2) Lipschitz comparison: if `‖f x - f y‖ ≤ K ‖g x - g y‖` on `S` and `g` is injective
  -- there, then `Hᵐ(f S) ≤ Kᵐ Hᵐ(g S)` (the Lipschitz bound for `f ∘ g⁻¹` on `g S`).
  have hcmp : ∀ (f g : Euclid m → Euclid P) (S : Set (Euclid m)) (K : NNReal), InjOn g S →
      (∀ x ∈ S, ∀ y ∈ S, ‖f x - f y‖ ≤ K * ‖g x - g y‖) →
      μHE[m] (f '' S) ≤ (K : ℝ≥0∞) ^ m * μHE[m] (g '' S) := by
    intro f g S K hg hfg
    have hθ : ∀ x ∈ S, f (invFunOn g S (g x)) = f x := fun x hx => by
      rw [hg.leftInvOn_invFunOn hx]
    have hlip : LipschitzOnWith K (f ∘ invFunOn g S) (g '' S) := by
      refine LipschitzOnWith.of_dist_le_mul fun a ha b hb => ?_
      obtain ⟨x, hx, rfl⟩ := ha
      obtain ⟨y, hy, rfl⟩ := hb
      rw [comp_apply, comp_apply, hθ x hx, hθ y hy, dist_eq_norm, dist_eq_norm]
      exact hfg x hx y hy
    have himg : f '' S = (f ∘ invFunOn g S) '' (g '' S) := by
      rw [image_image]; exact image_congr fun x hx => (hθ x hx).symm
    have key := hlip.hausdorffMeasure_image_le (d := (m : ℝ)) m.cast_nonneg
    rw [ENNReal.rpow_natCast] at key
    rw [himg, Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, Measure.smul_apply,
      ENNReal.smul_def, ENNReal.smul_def, smul_eq_mul, smul_eq_mul, mul_left_comm]
    exact mul_le_mul_right key _
  -- (3) Jacobian comparison for injective linear maps: (1) and (2) on the unit ball.
  have hjcmp : ∀ (B₁ B₂ : Euclid m →L[ℝ] Euclid P) (K : NNReal), Injective B₁ → Injective B₂ →
      (∀ z, ‖B₁ z‖ ≤ K * ‖B₂ z‖) →
      ENNReal.ofReal (Jf B₁) ≤ (K : ℝ≥0∞) ^ m * ENNReal.ofReal (Jf B₂) := by
    intro B₁ B₂ K h₁ h₂ hB
    have key := hcmp B₁ B₂ (ball 0 1) K h₂.injOn fun x _ y _ => by
      rw [← map_sub, ← map_sub]; exact hB _
    rw [hlin B₁ h₁, hlin B₂ h₂, ← mul_assoc] at key
    exact (ENNReal.mul_le_mul_iff_left (measure_ball_pos volume 0 one_pos).ne'
      measure_ball_lt_top.ne).1 key
  -- (4) If `G` is `δ`-approximated by `A` on `S`, then `‖DG(v) - A‖ ≤ δ` at a.e. `v ∈ S`
  -- (at Lebesgue density points; the argument of `ApproximatesLinearOn.norm_fderiv_sub_le`).
  have hdcl : ∀ (A : Euclid m →L[ℝ] Euclid P) (δ : NNReal) (S : Set (Euclid m)), S ⊆ F →
      MeasurableSet S → ApproximatesLinearOn G A S δ →
      ∀ᵐ v ∂(volume.restrict S), ‖fderiv ℝ G v - A‖ ≤ δ := by
    open scoped Pointwise in
    intro A δ S hSF hS hA
    filter_upwards [Besicovitch.ae_tendsto_measure_inter_div (volume : Measure (Euclid m)) S,
      ae_restrict_mem hS] with x hx xs
    refine ContinuousLinearMap.opNorm_le_bound _ δ.2 fun z => ?_
    suffices H : ∀ ε, 0 < ε → ‖(fderiv ℝ G x - A) z‖ ≤
        (δ + ε) * (‖z‖ + ε) + ‖fderiv ℝ G x - A‖ * ε by
      have : Tendsto (fun ε : ℝ => ((δ : ℝ) + ε) * (‖z‖ + ε) + ‖fderiv ℝ G x - A‖ * ε)
          (𝓝[>] 0) (𝓝 ((δ + 0) * (‖z‖ + 0) + ‖fderiv ℝ G x - A‖ * 0)) :=
        Tendsto.mono_left (Continuous.tendsto (by fun_prop) 0) nhdsWithin_le_nhds
      simp only [add_zero, mul_zero] at this
      apply le_of_tendsto_of_tendsto tendsto_const_nhds this
      filter_upwards [self_mem_nhdsWithin]
      exact H
    intro ε εpos
    have B₁ : ∀ᶠ r in 𝓝[>] (0 : ℝ), (S ∩ ({x} + r • closedBall z ε)).Nonempty :=
      Measure.eventually_nonempty_inter_smul_of_density_one volume S x hx _
        measurableSet_closedBall (measure_closedBall_pos volume z εpos).ne'
    obtain ⟨ρ, ρpos, hρ⟩ : ∃ ρ > 0, ball x ρ ∩ S ⊆
        {y | ‖G y - G x - (fderiv ℝ G x) (y - x)‖ ≤ ε * ‖y - x‖} :=
      mem_nhdsWithin_iff.1 (Asymptotics.isLittleO_iff.1
        ((hG x (hSF xs)).hasFDerivAt.hasFDerivWithinAt (s := S)).isLittleO εpos)
    have B₂ : ∀ᶠ r in 𝓝[>] (0 : ℝ), {x} + r • closedBall z ε ⊆ ball x ρ :=
      nhdsWithin_le_nhds
        (eventually_singleton_add_smul_subset isBounded_closedBall (ball_mem_nhds x ρpos))
    obtain ⟨r, ⟨y, ⟨ys, hy⟩⟩, rρ, rpos⟩ : ∃ r : ℝ, (S ∩ ({x} + r • closedBall z ε)).Nonempty ∧
        {x} + r • closedBall z ε ⊆ ball x ρ ∧ 0 < r :=
      (B₁.and (B₂.and self_mem_nhdsWithin)).exists
    obtain ⟨a, az, ya⟩ : ∃ a, a ∈ closedBall z ε ∧ y = x + r • a := by
      simp only [mem_smul_set, image_add_left, mem_preimage, singleton_add] at hy
      rcases hy with ⟨a, az, ha⟩
      exact ⟨a, az, by simp only [ha, add_neg_cancel_left]⟩
    have norm_a : ‖a‖ ≤ ‖z‖ + ε :=
      calc ‖a‖ = ‖z + (a - z)‖ := by simp only [add_sub_cancel]
        _ ≤ ‖z‖ + ‖a - z‖ := norm_add_le _ _
        _ ≤ ‖z‖ + ε := by grw [mem_closedBall_iff_norm.1 az]
    have I : r * ‖(fderiv ℝ G x - A) a‖ ≤ r * (δ + ε) * (‖z‖ + ε) :=
      calc r * ‖(fderiv ℝ G x - A) a‖ = ‖(fderiv ℝ G x - A) (r • a)‖ := by
            simp only [map_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
        _ = ‖G y - G x - A (y - x) - (G y - G x - (fderiv ℝ G x) (y - x))‖ := by
            simp only [ya, add_sub_cancel_left, sub_sub_sub_cancel_left, FunLike.coe_sub,
              Pi.sub_apply, map_smul, smul_sub]
        _ ≤ ‖G y - G x - A (y - x)‖ + ‖G y - G x - (fderiv ℝ G x) (y - x)‖ := norm_sub_le _ _
        _ ≤ δ * ‖y - x‖ + ε * ‖y - x‖ := add_le_add (hA _ ys _ xs) (hρ ⟨rρ hy, ys⟩)
        _ = r * (δ + ε) * ‖a‖ := by
            simp only [ya, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
              abs_of_nonneg rpos.le]
            ring
        _ ≤ r * (δ + ε) * (‖z‖ + ε) := by gcongr
    calc ‖(fderiv ℝ G x - A) z‖ = ‖(fderiv ℝ G x - A) a + (fderiv ℝ G x - A) (z - a)‖ := by
          congr 1
          simp only [FunLike.coe_sub, map_sub, Pi.sub_apply]
          abel
      _ ≤ ‖(fderiv ℝ G x - A) a‖ + ‖(fderiv ℝ G x - A) (z - a)‖ := norm_add_le _ _
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖fderiv ℝ G x - A‖ * ‖z - a‖ := by
          apply add_le_add
          · rw [mul_assoc] at I; exact (mul_le_mul_iff_right₀ rpos).1 I
          · apply ContinuousLinearMap.le_opNorm
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖fderiv ℝ G x - A‖ * ε := by
          rw [mem_closedBall_iff_norm'] at az
          gcongr
  -- (5) A lower bound `‖z‖ ≤ c(A) ‖A z‖` for injective `A`.
  have hmod : ∀ A : Euclid m →L[ℝ] Euclid P, ∃ c : NNReal, 0 < c ∧
      (Injective A → ∀ z, ‖z‖ ≤ c * ‖A z‖) := by
    intro A
    by_cases hA : Injective A
    · obtain ⟨c, cpos, hc⟩ := (A : Euclid m →ₗ[ℝ] Euclid P).exists_antilipschitzWith
        (LinearMap.ker_eq_bot.2 hA)
      exact ⟨c, cpos, fun _ z => by simpa using hc.le_mul_dist z 0⟩
    · exact ⟨1, one_pos, fun h' => absurd h' hA⟩
  choose c cpos hc using hmod
  have hcont : ContinuousOn G F := fun v hv => (hG v hv).continuousAt.continuousWithinAt
  -- (6) For `0 < η ≤ 1/2` and `K = 1 + 2η`, partition a Borel `t ⊆ F` into pieces on which `G`
  -- and (a.e.) `DG` are `η`-close to an injective `A`; then (1)–(3) give two-sided bounds.
  have hpiece : ∀ η : ℝ, 0 < η → η ≤ 1 / 2 → ∀ t ⊆ F, MeasurableSet t →
      μHE[m] (G '' t) ≤ (((1 + 2 * η).toNNReal : ℝ≥0∞) ^ m) ^ 2 *
        ∫⁻ v in t, ENNReal.ofReal (Jf (fderiv ℝ G v)) ∧
      ∫⁻ v in t, ENNReal.ofReal (Jf (fderiv ℝ G v)) ≤
        (((1 + 2 * η).toNNReal : ℝ≥0∞) ^ m) ^ 2 * μHE[m] (G '' t) := by
    intro η ηpos ηle t htF ht
    set K : NNReal := (1 + 2 * η).toNNReal
    have hKr : (K : ℝ) = 1 + 2 * η := Real.coe_toNNReal _ (by linarith)
    have hrel : ∀ u w : Euclid P, ‖u - w‖ ≤ η * ‖w‖ → ‖u‖ ≤ K * ‖w‖ ∧ ‖w‖ ≤ K * ‖u‖ := by
      intro u w huw
      have h1 : ‖u‖ ≤ ‖w‖ + ‖u - w‖ := norm_le_insert' u w
      have h2 : ‖w‖ ≤ ‖u‖ + ‖u - w‖ := by simpa [norm_sub_rev] using norm_le_insert' w u
      have h3 : (1 - η) * ‖w‖ ≤ ‖u‖ := by linarith
      have h4 := mul_le_mul_of_nonneg_left h3 (by linarith : (0 : ℝ) ≤ 1 + 2 * η)
      have h5 : 0 ≤ η * (1 - 2 * η) * ‖w‖ :=
        mul_nonneg (mul_nonneg ηpos.le (by linarith)) (norm_nonneg w)
      rw [hKr]
      constructor <;> nlinarith [norm_nonneg u, norm_nonneg w, mul_nonneg ηpos.le (norm_nonneg w)]
    rcases t.eq_empty_or_nonempty with rfl | tne
    · simp
    obtain ⟨T, A, Tdisj, Tmeas, tT, Tappr, TA⟩ :=
      exists_partition_approximatesLinearOn_of_hasFDerivWithinAt G t (fderiv ℝ G)
        (fun v hv => (hG v (htF hv)).hasFDerivAt.hasFDerivWithinAt)
        (fun B => η.toNNReal / c B) (fun B => (div_pos (Real.toNNReal_pos.2 ηpos) (cpos B)).ne')
    have Ainj : ∀ n, Injective (A n) := fun n => by
      obtain ⟨y, yt, hy⟩ := TA tne n
      rw [hy]; exact hreg y (htF yt)
    have hpc : ∀ n, μHE[m] (G '' (t ∩ T n)) ≤ ((K : ℝ≥0∞) ^ m) ^ 2 *
          ∫⁻ v in t ∩ T n, ENNReal.ofReal (Jf (fderiv ℝ G v)) ∧
        ∫⁻ v in t ∩ T n, ENNReal.ofReal (Jf (fderiv ℝ G v)) ≤
          ((K : ℝ≥0∞) ^ m) ^ 2 * μHE[m] (G '' (t ∩ T n)) := by
      intro n
      have hSF : t ∩ T n ⊆ F := inter_subset_left.trans htF
      have hS : MeasurableSet (t ∩ T n) := ht.inter (Tmeas n)
      have hcpos : (0 : ℝ) < c (A n) := cpos (A n)
      have hc0 : (c (A n) : ℝ) ≠ 0 := hcpos.ne'
      have happ : ∀ x ∈ t ∩ T n, ∀ y ∈ t ∩ T n,
          ‖(G x - G y) - (A n x - A n y)‖ ≤ η * ‖A n x - A n y‖ := by
        intro x hx y hy
        have h1 := Tappr n x hx y hy
        rw [NNReal.coe_div, Real.coe_toNNReal _ ηpos.le] at h1
        have h2 := hc (A n) (Ainj n) (x - y)
        rw [← map_sub]
        calc ‖G x - G y - A n (x - y)‖ ≤ η / c (A n) * ‖x - y‖ := h1
          _ ≤ η / c (A n) * (c (A n) * ‖A n (x - y)‖) := by gcongr
          _ = η * ‖A n (x - y)‖ := by field_simp
      have hder : ∀ᵐ v ∂(volume.restrict (t ∩ T n)), ∀ z,
          ‖fderiv ℝ G v z - A n z‖ ≤ η * ‖A n z‖ := by
        filter_upwards [hdcl (A n) _ (t ∩ T n) hSF hS (Tappr n)] with v hv z
        rw [NNReal.coe_div, Real.coe_toNNReal _ ηpos.le] at hv
        have h2 := hc (A n) (Ainj n) z
        calc ‖fderiv ℝ G v z - A n z‖ = ‖(fderiv ℝ G v - A n) z‖ := rfl
          _ ≤ ‖fderiv ℝ G v - A n‖ * ‖z‖ := (fderiv ℝ G v - A n).le_opNorm z
          _ ≤ η / c (A n) * ‖z‖ := by gcongr
          _ ≤ η / c (A n) * (c (A n) * ‖A n z‖) := by gcongr
          _ = η * ‖A n z‖ := by field_simp
      have hJ : ∀ᵐ v ∂(volume.restrict (t ∩ T n)),
          ENNReal.ofReal (Jf (fderiv ℝ G v)) ≤ (K : ℝ≥0∞) ^ m * ENNReal.ofReal (Jf (A n)) ∧
          ENNReal.ofReal (Jf (A n)) ≤ (K : ℝ≥0∞) ^ m * ENNReal.ofReal (Jf (fderiv ℝ G v)) := by
        filter_upwards [hder, ae_restrict_mem hS] with v hv hvS
        exact ⟨hjcmp _ _ K (hreg v (hSF hvS)) (Ainj n) fun z => (hrel _ _ (hv z)).1,
          hjcmp _ _ K (Ainj n) (hreg v (hSF hvS)) fun z => (hrel _ _ (hv z)).2⟩
      have hup := hcmp G (A n) (t ∩ T n) K (Ainj n).injOn
        fun x hx y hy => (hrel _ _ (happ x hx y hy)).1
      have hlo := hcmp (A n) G (t ∩ T n) K (hinj.mono hSF)
        fun x hx y hy => (hrel _ _ (happ x hx y hy)).2
      rw [hlin (A n) (Ainj n), ← setLIntegral_const] at hup hlo
      have hKtop : (K : ℝ≥0∞) ^ m ≠ ⊤ := ENNReal.pow_ne_top ENNReal.coe_ne_top
      constructor
      · calc μHE[m] (G '' (t ∩ T n))
            ≤ (K : ℝ≥0∞) ^ m * ∫⁻ _ in t ∩ T n, ENNReal.ofReal (Jf (A n)) := hup
          _ ≤ (K : ℝ≥0∞) ^ m * ∫⁻ v in t ∩ T n, (K : ℝ≥0∞) ^ m *
                ENNReal.ofReal (Jf (fderiv ℝ G v)) :=
            mul_le_mul_right (lintegral_mono_ae (hJ.mono fun v hv => hv.2)) _
          _ = _ := by rw [lintegral_const_mul' _ _ hKtop, ← mul_assoc, sq]
      · calc ∫⁻ v in t ∩ T n, ENNReal.ofReal (Jf (fderiv ℝ G v))
            ≤ ∫⁻ _ in t ∩ T n, (K : ℝ≥0∞) ^ m * ENNReal.ofReal (Jf (A n)) :=
            lintegral_mono_ae (hJ.mono fun v hv => hv.1)
          _ = (K : ℝ≥0∞) ^ m * ∫⁻ _ in t ∩ T n, ENNReal.ofReal (Jf (A n)) :=
            lintegral_const_mul' _ _ hKtop
          _ ≤ (K : ℝ≥0∞) ^ m * ((K : ℝ≥0∞) ^ m * μHE[m] (G '' (t ∩ T n))) :=
            mul_le_mul_right hlo _
          _ = _ := by rw [← mul_assoc, sq]
    have hdisj : Pairwise (Disjoint on fun n => t ∩ T n) := fun i j hij =>
      Disjoint.mono inter_subset_right inter_subset_right (Tdisj hij)
    have hunion : t = ⋃ n, t ∩ T n := by rw [← inter_iUnion, inter_eq_left.2 tT]
    have hX : μHE[m] (G '' t) = ∑' n, μHE[m] (G '' (t ∩ T n)) := by
      rw [show G '' t = ⋃ n, G '' (t ∩ T n) by rw [← image_iUnion, ← hunion]]
      exact measure_iUnion (fun i j hij => Disjoint.image (hdisj hij) (hinj.mono htF)
          inter_subset_left inter_subset_left)
        fun n => (ht.inter (Tmeas n)).image_of_continuousOn_injOn
          (hcont.mono (inter_subset_left.trans htF)) (hinj.mono (inter_subset_left.trans htF))
    have hY : ∫⁻ v in t, ENNReal.ofReal (Jf (fderiv ℝ G v)) =
        ∑' n, ∫⁻ v in t ∩ T n, ENNReal.ofReal (Jf (fderiv ℝ G v)) := by
      conv_lhs => rw [hunion]
      exact lintegral_iUnion (fun n => ht.inter (Tmeas n)) hdisj _
    rw [hX, hY, ← ENNReal.tsum_mul_left, ← ENNReal.tsum_mul_left]
    exact ⟨ENNReal.tsum_le_tsum fun n => (hpc n).1, ENNReal.tsum_le_tsum fun n => (hpc n).2⟩
  -- (7) Letting `η → 0`: `Hᵐ(G t) = ∫_t J` for every Borel `t ⊆ F`.
  have hmeas : ∀ t ⊆ F, MeasurableSet t →
      μHE[m] (G '' t) = ∫⁻ v in t, ENNReal.ofReal (Jf (fderiv ℝ G v)) := by
    intro t htF ht
    have hlim : Tendsto (fun η : ℝ => (((1 + 2 * η).toNNReal : ℝ≥0∞) ^ m) ^ 2) (𝓝[>] 0)
        (𝓝 1) := by
      have hc : Continuous fun η : ℝ => ((1 + 2 * η).toNNReal ^ m) ^ 2 :=
        ((continuous_real_toNNReal.comp (by fun_prop)).pow m).pow 2
      simpa using ENNReal.tendsto_coe.2 ((hc.tendsto 0).mono_left nhdsWithin_le_nhds)
    have hev : ∀ᶠ η in 𝓝[>] (0 : ℝ), 0 < η ∧ η ≤ 1 / 2 :=
      Ioc_mem_nhdsGT (by norm_num : (0 : ℝ) < 1 / 2)
    have hlim' : ∀ X : ℝ≥0∞, Tendsto (fun η : ℝ => (((1 + 2 * η).toNNReal : ℝ≥0∞) ^ m) ^ 2 * X)
        (𝓝[>] 0) (𝓝 X) := fun X => by
      simpa using ENNReal.Tendsto.mul_const hlim (Or.inl one_ne_zero)
    apply le_antisymm
    · refine ge_of_tendsto (hlim' _) ?_
      filter_upwards [hev] with η hη
      exact (hpiece η hη.1 hη.2 t htF ht).1
    · refine ge_of_tendsto (hlim' _) ?_
      filter_upwards [hev] with η hη
      exact (hpiece η hη.1 hη.2 t htF ht).2
  -- (8) From the measure identity to the integral identity, as in
  -- `integral_image_eq_integral_abs_det_fderiv_smul`: `G|_F` is a measurable embedding.
  have hJm : Measurable fun v => Jf (fderiv ℝ G v) := by
    have : Continuous Jf := by
      refine Real.continuous_sqrt.comp (Continuous.matrix_det (continuous_matrix fun i j => ?_))
      exact (continuous_id.clm_apply continuous_const).inner
        (continuous_id.clm_apply continuous_const)
    exact this.measurable.comp (measurable_fderiv ℝ G)
  have hemb : MeasurableEmbedding (F.domRestrict G) :=
    { injective := injOn_iff_injective.1 hinj
      measurable := (continuousOn_iff_continuous_domRestrict.1 hcont).measurable
      measurableSet_image' := fun s hs => by
        rw [domRestrict_eq, image_comp]
        exact (hF.subtype_image hs).image_of_continuousOn_injOn
          (hcont.mono (Subtype.coe_image_subset F s)) (hinj.mono (Subtype.coe_image_subset F s)) }
  have hmap : Measure.map (F.domRestrict G) (Measure.comap Subtype.val
      (volume.withDensity fun v => ENNReal.ofReal (Jf (fderiv ℝ G v)))) =
      μHE[m].restrict (G '' F) := by
    ext u hu
    have hpre : MeasurableSet (F.domRestrict G ⁻¹' u) := hemb.measurable hu
    have hset : Subtype.val '' (F.domRestrict G ⁻¹' u) = F ∩ G ⁻¹' u :=
      Subtype.image_preimage_coe F (G ⁻¹' u)
    have htm : MeasurableSet (F ∩ G ⁻¹' u) := hset ▸ hF.subtype_image hpre
    rw [Measure.map_apply hemb.measurable hu,
      Measure.comap_apply _ Subtype.val_injective (fun _ hs => hF.subtype_image hs) _ hpre, hset,
      withDensity_apply _ htm, Measure.restrict_apply hu, ← hmeas _ inter_subset_left htm,
      image_inter_preimage, inter_comm]
  rw [← hmap, hemb.integral_map]
  simp only [domRestrict_apply, ← comp_apply (f := h), ENNReal.ofReal]
  rw [← (MeasurableEmbedding.subtype_coe hF).integral_map, map_comap_subtype_coe hF,
    setIntegral_withDensity_eq_setIntegral_smul₀ hJm.real_toNNReal.aemeasurable _ hF]
  refine setIntegral_congr_fun hF fun v _ => ?_
  rw [NNReal.smul_def, Real.coe_toNNReal _ (Real.sqrt_nonneg _)]
  rfl
/-- **A countably `n`-rectifiable set has approximate tangent planes `Hⁿ`-a.e.** (Simon Ch. 3,
Theorem 1.6 "⇒", chapter-03.txt lines 109–143, with Lemma 1.2 and Remark 1.3, lines 25–76).  Let
`M ⊆ ℝᴾ` be Borel and countably `n`-rectifiable with `Hⁿ(M ∩ K) < ∞` for every compact `K`.  Up to
an `Hⁿ`-null set, `M` is covered by Borel pieces `N_k = g_k(B_{r_k}(c_k))` of finite measure, with
`g_k` of class `C¹` and `m_k|a − b| ≤ |g_k(a) − g_k(b)|` on the ball (Lemma 1.2).  `N_k` has the
approximate tangent plane `Dg_k(z)(ℝⁿ)` at each `g_k(z)`, and by the upper density theorem `M` and
`N_k` have the same approximate tangent planes at `Hⁿ`-a.e. point of `M ∩ N_k`.  The countably many
exceptional null sets combine, so `T_w M` exists for `Hⁿ`-a.e. `w ∈ M`.  The pieces need not be
disjoint (Remark 1.3). -/
theorem Submission.codim1_rdo_rectifiable_ae_approxTangent : ∀ (P n : ℕ) (M : Set (Euclid P)), MeasurableSet M → CountablyRectifiable n M → (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → ∀ᵐ w ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M w Q := by
  intro P n M hM hrect hloc
  -- Step 1, `M` is covered up to an `Hⁿ`-null set by the `C¹` pieces `N_k = g_k(B_{r_k}(c_k))`.
  obtain ⟨g, c, r, m, hg, hm, hlow, hmeas, hfin, hnull⟩ :=
    Submission.codim1_rdo_rectifiable_c1_cover P n M hrect
  -- Step 2, `M` and `N_k` have the same approximate tangent planes `Hⁿ`-a.e. on `M ∩ N_k`.
  have hpiece : ∀ k, ∀ᵐ w ∂(μHE[n] : Measure (Euclid P)), w ∈ (univ : Set (Euclid P)) → w ∈ M →
      w ∈ g k '' ball (c k) (r k) → ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n M w Q ↔
          HasApproximateTangentSpaceAt n (g k '' ball (c k) (r k)) w Q :=
    fun k => Submission.doraggt_ae_approxTangent_transfer P n univ M (g k '' ball (c k) (r k))
      isOpen_univ hM (hmeas k) (fun K hK _ => hloc K hK)
      (fun K _ _ => ne_top_of_le_ne_top (hfin k) (measure_mono inter_subset_left))
  -- Step 3, the exceptional sets of Steps 1 and 2 form countably many `Hⁿ`-null sets.
  have hall := ae_all_iff.2 hpiece
  have hcov : ∀ᵐ w ∂(μHE[n] : Measure (Euclid P)), w ∉ M \ ⋃ k, g k '' ball (c k) (r k) :=
    measure_eq_zero_iff_ae_notMem.1 hnull
  -- Step 4, off them, `w = g_k(z) ∈ M ∩ N_k` for some `k`, and `T_w M = T_w N_k = Dg_k(z)(ℝⁿ)`.
  rw [ae_restrict_iff' hM]
  filter_upwards [hall, hcov] with w hw hw' hwM
  have hU : w ∈ ⋃ k, g k '' ball (c k) (r k) := by
    by_contra h
    exact hw' ⟨hwM, h⟩
  obtain ⟨k, z, hz, rfl⟩ := mem_iUnion.1 hU
  exact ⟨_, (hw k (mem_univ _) hwM ⟨z, hz, rfl⟩ _).2
    (Submission.codim1_rdo_c1_piece_approxTangent P n (g k) (c k) (r k) (m k) (hg k) (hm k)
      (hlow k) z hz)⟩
/-- **Step 1 of Corollary 7.5.11** (`k ≥ 1`, Simon 7.5; Ch. 2, §4, (4.1)).  A nonempty embedded
`d`-dimensional `Cʳ` submanifold `M` of `ℝᴾ` has `d ≤ P`: for `y ∈ M` and a chart `ψ : V → W` at
`y`, `y ∈ W ∩ M = ψ(V)` gives `z ∈ V`, and the injective linear map `Dψ(z) : ℝᵈ → ℝᴾ` gives
`d = dim ℝᵈ ≤ dim ℝᴾ = P`. -/
theorem Submission.regcomp_cop_dim_le_of_embedded : ∀ (P d r : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold r d M → M.Nonempty → d ≤ P := by
  intro P d r M hM ⟨y, hy⟩
  -- a chart `ψ : V → W` of `M` at `y`
  obtain ⟨V, W, ψ, -, -, hyW, -, -, hψV, -, hDψ⟩ := hM y hy
  -- `y ∈ W ∩ M = ψ(V)`, so `y = ψ(z)` for some `z ∈ V`
  obtain ⟨z, hz, -⟩ : y ∈ ψ '' V := hψV ▸ ⟨hyW, hy⟩
  -- `Dψ(z) : ℝᵈ → ℝᴾ` is injective, so `d = dim ℝᵈ ≤ dim ℝᴾ = P`
  simpa using LinearMap.finrank_le_finrank_of_injective
    (f := (fderiv ℝ ψ z : Euclid d →ₗ[ℝ] Euclid P)) (hDψ z hz)
/-- **Simon 7.5** (`T = ∂[[E]]` with `E ⊆ N`): if `(N̄ \ N) ∩ U = ∅`, `E ⊆ N` and
`T(ω) = ∫_E ⟨dω, ξN⟩ dH^{n+1}` for `ω ∈ 𝒟ⁿ(U)`, then `spt T ⊆ N`.  A point `x ∈ spt T \ N` lies
outside `N̄`, so `B_ε(x) ⊆ U \ N̄` for some `ε > 0`.  `W = B_{ε/2}(x)` is open with `W̄` compact
in `U`, and every `ω` with `spt ω ⊆ W` has `spt dω ⊆ spt ω` disjoint from `E`.  So the integrand
vanishes on `E`, `T(ω) = 0`, and `x ∈ W` lies in the zero region of `T`. -/
theorem Submission.regcomp_cop_region_support_subset : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n), IsOpen U → (closure N \ N) ∩ U = ∅ → E ⊆ N → IsBoundaryOfRegion T E ξN → T.support ⊆ N := by
  intro P n U N E ξN T hU hN hEN hT x hx
  obtain ⟨hxU, hxZ⟩ := hx
  by_contra hxN
  -- `x ∉ N̄`, since `(N̄ \ N) ∩ U = ∅`
  have hxN' : x ∉ closure N := fun h => hN.subset ⟨⟨h, hxN⟩, hxU⟩
  -- a ball `B_ε(x) ⊆ U \ N̄`
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp (hU.sdiff isClosed_closure) x ⟨hxU, hxN'⟩
  -- `W = B_{ε/2}(x)` is open, and `W̄ ⊆ B̄_{ε/2}(x)` is compact and contained in `B_ε(x) ⊆ U`
  have hcl : closure (ball x (ε / 2)) ⊆ ball x ε :=
    closure_ball_subset_closedBall.trans (closedBall_subset_ball (by linarith))
  refine hxZ ⟨ball x (ε / 2), ⟨isOpen_ball,
    (isCompact_closedBall x (ε / 2)).of_isClosed_subset isClosed_closure
      closure_ball_subset_closedBall, hcl.trans (hball.trans sdiff_subset), ?_⟩,
    mem_ball_self (half_pos hε)⟩
  -- `T` vanishes on `W`: for `spt ω ⊆ W`, `dω = 0` on `E ⊆ N`, so the integrand vanishes on `E`
  intro ω hω
  rw [hT ω]
  refine setIntegral_eq_zero_of_forall_eq_zero fun z hz => ?_
  have hzω : z ∉ tsupport (exteriorDerivative (ω : DifferentialForm (Euclid P) n)) := fun h =>
    (hball (ball_subset_ball (by linarith) (hω (tsupport_exteriorDerivative_subset _ h)))).2
      (subset_closure (hEN hz))
  rw [image_eq_zero_of_notMem_tsupport hzω, map_zero]
/-- **`∂[[E]]` is a cycle**: Simon 7.5.1 (`T = ∂[[E]]`, chapter-07.txt line 752) with (6.1.12)
`d²ω = 0` (chapter-06.txt line 150) and the boundary (6.2.3) `∂T(ω) = T(dω)`, `∂T = 0` if `n = 0`
(chapter-06.txt lines 216–220).  If `T(ω) = ∫_E ⟨dω, ξ_N⟩ dH^{n+1}` for every `ω ∈ 𝒟ⁿ(U)`, then
`∂T = 0` in `U`: for `n = m + 1` and `φ ∈ 𝒟ᵐ(U)`, `∂T(φ) = T(dφ) = ∫_E ⟨d(dφ), ξ_N⟩ dH^{m+2} = 0`,
since `d(dφ) = 0` for the smooth form `φ`.  No hypothesis on `U`, `E` or `ξ_N` is needed. -/
theorem Submission.regcomp_cop_region_boundary_vanishes : ∀ (P n : ℕ) (U E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n), IsBoundaryOfRegion T E ξN → BoundaryVanishes T := by
  intro P n
  cases n with
  | zero =>
    -- Degree `0`: `BoundaryVanishes T` is `True` (Simon's convention `∂T = 0`, 6.2.3).
    intro U E ξN T _
    trivial
  | succ m =>
    -- Degree `m + 1`: show `∂T = 0` by testing on every `φ ∈ 𝒟ᵐ(U)`.
    intro U E ξN T hT
    show T.boundary = 0
    apply GeometricCurrentOn.ext
    intro φ
    -- `∂T(φ) = T(dφ) = ∫_E ⟨d(dφ), ξ_N⟩ dH^{m+2}`: (6.2.3) and the hypothesis at `dφ ∈ 𝒟^{m+1}(U)`.
    rw [GeometricCurrentOn.boundary_apply, hT (exteriorDerivativeTestOn U m φ),
      GeometricCurrentOn.zero_apply]
    -- `d(dφ) = 0` for the smooth form `φ` (6.1.12), so the integrand is `ξ_N(x)(0) = 0`.
    have hdd : exteriorDerivative ((exteriorDerivativeTestOn U m φ : TestFormOn U (m + 1)) :
        DifferentialForm (Euclid P) (m + 1)) = 0 :=
      exteriorDerivative_sq φ.property.1.1
    simp only [hdd, Pi.zero_apply, map_zero, integral_zero]

/-- **Simon 7.5.1** (`T = ∂[[E]]` in `U`, `N ∈ 𝒪`, `E ⊆ N ∩ U`; Ch. 6, 2.3 and 2.11; Ch. 2, §4).
If `U` is open, `N ∈ 𝒪` is oriented by `ξN`, `E ⊆ N ∩ U` and `T(ω) = ∫_E ⟨dω, ξN⟩ dH^{n+1}` for
`ω ∈ 𝒟ⁿ(U)`, then `n + 1 ≤ P`, `spt T ⊆ U ∩ N` and `∂T = 0` in `U`.  A chart of `N` at a point
of `N ∩ U ≠ ∅` has injective derivative `ℝ^{n+1} → ℝᴾ`, so `n + 1 ≤ P`; `spt T ⊆ U` by
definition and `spt T ⊆ N` because `(N̄ \ N) ∩ U = ∅` and `E ⊆ N`; and
`∂T(φ) = T(dφ) = ∫_E ⟨d(dφ), ξN⟩ dH^{n+1} = 0`.  Minimality of `T` is not needed. -/
theorem Submission.codim1_region_support_cycle : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n), IsOpen U → InClassO n U N ξN → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN → n + 1 ≤ P ∧ T.support ⊆ U ∩ N ∧ BoundaryVanishes T := by
  intro P n U N E ξN T hU hO hE hT
  obtain ⟨hN, -, hNU, hne⟩ := hO
  refine ⟨?_, fun x hx => ⟨T.support_subset_domain hx, ?_⟩, ?_⟩
  · -- `n + 1 ≤ P`: `N` is a nonempty embedded `(n + 1)`-dimensional submanifold of `ℝᴾ`
    exact Submission.regcomp_cop_dim_le_of_embedded P (n + 1) 2 N hN (hne.mono inter_subset_left)
  · -- `spt T ⊆ N`, since `(N̄ \ N) ∩ U = ∅` and `E ⊆ N`
    exact Submission.regcomp_cop_region_support_subset P n U N E ξN T hU hNU
      (hE.trans inter_subset_left) hT hx
  · -- `∂T = 0`: `∂T(φ) = T(dφ) = ∫_E ⟨d(dφ), ξN⟩ dH^{n+1} = 0`
    exact Submission.regcomp_cop_region_boundary_vanishes P n U E ξN T hT
/-- Level sets of a measure finite on compact sets are null at almost every level: if `ν` is a
measure on `ℝᴾ` with `ν(K) < ∞` for every compact `K` and `f : ℝᴾ → ℝ` is measurable, then
`ν{f = t} = 0` for `L¹`-a.e. `t ∈ ℝ`.  `ν` is locally finite, hence σ-finite (`ℝᴾ` is second
countable), so only countably many of the disjoint level sets `{f = t}` have positive measure,
and a countable subset of `ℝ` is Lebesgue-null. -/
theorem Submission.dtc_bc_tc_cl_sl_ae_level_set_null : ∀ (P : ℕ) (ν : Measure (Euclid P)) (f : Euclid P → ℝ), Measurable f → (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → ∀ᵐ t ∂(volume : Measure ℝ), ν {x | f x = t} = 0 := by
  intro P ν f hf hν
  -- `ν` is finite on compact sets, hence locally finite and σ-finite (so s-finite) on `ℝᴾ`
  have : IsFiniteMeasureOnCompacts ν := ⟨fun K hK => hν K hK⟩
  -- `{t | ν{f = t} ≠ 0} = {t | 0 < ν{f = t}}` is countable, hence Lebesgue-null
  rw [ae_iff]
  exact measure_mono_null (fun t ht => pos_iff_ne_zero.2 ht)
    ((Measure.countable_meas_level_set_pos hf).measure_zero volume)
/-- **Slice-mass majorants are finite for a.e. level** (Simon 7.2.4, slicing step via 6.4).
Assume the majorant lemma (MM).  Let `μᵢ` be measures on `ℝᴾ` with `supᵢ μᵢ(W_k) < ∞`,
`W_k = B_{k+1}(0)`, for every `k`, let `f` be continuous and
`Z_{i,k}(t) ≤ L · liminf_{h ↓ 0} h⁻¹ μᵢ(W_k ∩ {t − h < f < t})`.  Then for `L¹`-a.e. `t`,
`liminf_i Z_{i,k}(t) < ∞` for every `k`.  For fixed `k, m`, (MM) with `G = W_k` and
`(a, b) = (−m, m)` gives a measurable `g` with `liminf_i Z_{i,k} ≤ g` a.e. on `(−m, m)` and
`∫_{(−m,m)} g ≤ L · liminf_i μᵢ(W_k ∩ {−m < f < m}) ≤ L · supᵢ μᵢ(W_k) < ∞`, so `g < ∞` a.e. on
`(−m, m)`; intersect over `m ∈ ℕ` (the intervals exhaust `ℝ`) and then over `k ∈ ℕ`. -/
theorem Submission.dtc_bc_tc_cl_sl_ae_liminf_lt_top : (∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (G : Set (Euclid P)) (a b : ℝ) (L : NNReal) (Z : ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ j, μs j (G ∩ {x | a < f x ∧ f x < b}) < ∞) → (∀ (j : ℕ) (t : ℝ), t ∈ Ioo a b → Z j t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs j (G ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∃ g : ℝ → ℝ≥0∞, Measurable g ∧ (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => Z j t) atTop ≤ g t) ∧ ∫⁻ t in Ioo a b, g t ≤ (L : ℝ≥0∞) * liminf (fun j => μs j (G ∩ {x | a < f x ∧ f x < b})) atTop) → ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (L : NNReal) (Z : ℕ → ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ k : ℕ, ⨆ i, μs i (ball (0 : Euclid P) ((k : ℝ) + 1)) < ∞) → (∀ (i k : ℕ) (t : ℝ), Z i k t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs i (ball (0 : Euclid P) ((k : ℝ) + 1) ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∀ᵐ t ∂(volume : Measure ℝ), ∀ k : ℕ, liminf (fun i => Z i k t) atTop < ∞ := by
  intro MM P μs f L Z hf hbd hZ
  rw [ae_all_iff]
  intro k
  /- Steps 1–3, for each `m`: (MM) on `E = W_k ∩ {−m < f < m}` gives, for a.e. `t ∈ (−m, m)`,
  `liminf_i Z_{i,k}(t) ≤ g(t) < ∞`. -/
  have hm : ∀ m : ℕ, ∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo (-(m : ℝ)) m →
      liminf (fun i => Z i k t) atTop < ∞ := by
    intro m
    -- Step 1: `μ_j(E) ≤ μ_j(W_k) ≤ Λ_k = supᵢ μᵢ(W_k)`
    have hE : ∀ j, μs j (ball (0 : Euclid P) ((k : ℝ) + 1) ∩ {x | -(m : ℝ) < f x ∧ f x < m}) ≤
        ⨆ i, μs i (ball (0 : Euclid P) ((k : ℝ) + 1)) := fun j =>
      (measure_mono inter_subset_left).trans
        (le_iSup (fun i => μs i (ball (0 : Euclid P) ((k : ℝ) + 1))) j)
    obtain ⟨g, hgm, hae, hint⟩ := MM P μs f (ball (0 : Euclid P) ((k : ℝ) + 1)) (-(m : ℝ)) m L
      (fun j t => Z j k t) hf (fun j => (hE j).trans_lt (hbd k)) (fun j t _ => hZ j k t)
    -- Step 2: `∫_{(−m,m)} g ≤ L · liminf_j μ_j(E) ≤ L · Λ_k < ∞`, so `g < ∞` a.e. on `(−m, m)`
    have hlim : liminf (fun j => μs j (ball (0 : Euclid P) ((k : ℝ) + 1) ∩
        {x | -(m : ℝ) < f x ∧ f x < m})) atTop ≤ ⨆ i, μs i (ball (0 : Euclid P) ((k : ℝ) + 1)) :=
      liminf_le_of_frequently_le' (Frequently.of_forall hE)
    have hint_ne : ∫⁻ t in Ioo (-(m : ℝ)) m, g t ≠ ∞ :=
      ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.coe_ne_top
        (ne_top_of_le_ne_top (hbd k).ne hlim)) hint
    have hgfin := ae_lt_top hgm hint_ne
    rw [ae_restrict_iff' measurableSet_Ioo] at hgfin
    -- Step 3: intersect the two full-measure sets
    filter_upwards [hae, hgfin] with t ht1 ht2 htm
    exact (ht1 htm).trans_lt (ht2 htm)
  /- Step 4: intersect over `m ∈ ℕ`; every `t` lies in `(−m, m)` for some `m > |t|`. -/
  rw [← ae_all_iff] at hm
  filter_upwards [hm] with t ht
  obtain ⟨m, hmt⟩ := exists_nat_gt |t|
  exact ht m ⟨by linarith [neg_abs_le t], by linarith [le_abs_self t]⟩
/-- **Boundary mass of a slice of a represented boundary** (Simon Ch. 6, (4.6)–(4.10)).  Assume
the slicing bounds (SL) for represented currents.  If `∂T` is represented by `(μ, ξ)` with
`|ξ(x)(α)| ≤ |α|` `μ`-a.e., `f` is `L`-Lipschitz and `B(η) = ∫_{f<t} ξ(η) dμ`, then
`M_W(∂B) ≤ L · liminf_{h ↓ 0} h⁻¹ μ(W ∩ {t − h < f < t})` for open `W`.  For `m = 0` the left side
is `0`.  Otherwise apply (SL) to `∂T`, whose boundary `∂∂T = 0` is represented by the zero measure
and the zero field: its slices satisfy `A_t = B` and `B'_t = 0`, so `∂A_t − B'_t = ∂B`. -/
theorem Submission.dmcbr_sl_sb_boundaryMassOn_slice_le : (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P m : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P m) (f : Euclid P → ℝ) (L : NNReal) (t : ℝ) (B : GeometricCurrentOn U m) (W : Set (Euclid P)), IsOpen U → IsOpen W → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) m, |ξ x α| ≤ covectorEuclideanNorm α) → (∀ η : TestFormOn U m, T.boundary η = ∫ x, ξ x ((η : DifferentialForm (Euclid P) m) x) ∂μ) → LipschitzWith L f → (∀ η : TestFormOn U m, B η = ∫ x in {x | f x < t}, ξ x ((η : DifferentialForm (Euclid P) m) x) ∂μ) → boundaryMassOn B W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0) := by
  intro SL P m U T μ ξ f L t B W hU hW hμ hξ hξb hT hf hB
  cases m with
  | zero => exact zero_le
  | succ m =>
    -- (SL) for `∂T`, represented by `(μ, ξ)`; `∂∂T = 0` is represented by the zero measure
    obtain ⟨A, B', hA, hB', -, hmass, -⟩ := SL P m U T.boundary μ 0 ξ 0 f L hU hμ
      (fun K _ _ => by simp) hξ (aestronglyMeasurable_zero_measure _) hξb (by simp) hT
      (fun η => by simp) hf
    -- `A_t = B` and `B'_t = 0`, hence `∂A_t − B'_t = ∂B`
    have hAt : A t = B := GeometricCurrentOn.ext fun ω => (hA t ω).trans (hB ω).symm
    have hslice : (A t).boundary - B' t = B.boundary := by
      ext ζ
      change (A t).boundary ζ - B' t ζ = B.boundary ζ
      rw [hB' t ζ, Measure.restrict_zero, integral_zero_measure, sub_zero, hAt]
    have h := hmass W t hW
    rw [hslice] at h
    exact h
/-- Local mass is invariant under negation of a current: if `T₁(ω) = -T₂(ω)` for every
`ω ∈ 𝒟ⁿ(U)`, then `M_W(T₁) = M_W(T₂)`.  The admissible forms of `M_W` are closed under negation
(`tsupport_neg`, `covectorEuclideanNorm_neg`) and `T₁(ω) = T₂(-ω)` by linearity, so every
admissible value of `T₁` is one of `T₂`; by symmetry and antisymmetry the suprema agree. -/
theorem Submission.dmcbr_sl_sb_massOn_eq_of_apply_eq_neg : ∀ (P n : ℕ) (U : Set (Euclid P)) (T₁ T₂ : GeometricCurrentOn U n) (W : Set (Euclid P)), (∀ ω : TestFormOn U n, T₁ ω = -T₂ ω) → T₁.massOn W = T₂.massOn W := by
  intro P n U T₁ T₂ W h
  have key : ∀ S₁ S₂ : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, S₁ ω = -S₂ ω) →
      S₁.massOn W ≤ S₂.massOn W := by
    intro S₁ S₂ hS
    refine sSup_le ?_
    rintro r ⟨ω, ⟨hsupp, hnorm⟩, rfl⟩
    have hadm : -ω ∈ massAdmissibleOn U n W :=
      ⟨by simpa only [Submodule.coe_neg, tsupport_neg] using hsupp, fun x => by
        simpa only [Submodule.coe_neg, Pi.neg_apply, covectorEuclideanNorm_neg] using hnorm x⟩
    calc ENNReal.ofReal (S₁ ω) = ENNReal.ofReal (S₂ (-ω)) := by
          rw [hS ω]; exact congrArg ENNReal.ofReal (map_neg S₂.toCurrent ω).symm
      _ ≤ S₂.massOn W := S₂.le_massOn hadm
  exact le_antisymm (key T₁ T₂ h) (key T₂ T₁ fun ω => by rw [h ω, neg_neg])
/-- Superadditivity of `liminf` in `[0, ∞]`: `liminf_F u + liminf_F v ≤ liminf_F (u + v)` for every
filter `F`, with no finiteness or boundedness hypothesis.  In the complete lattice `ℝ≥0∞`,
`liminf_F w = sup_{s ∈ F} inf_{i ∈ s} w(i)`; for `s, t ∈ F`,
`inf_s u + inf_t v ≤ inf_{s ∩ t} (u + v)` and `s ∩ t ∈ F`.  Both index families are nonempty
(`univ ∈ F`), so `ENNReal.biSup_add_biSup_le'` turns these pairwise bounds into the claim. -/
theorem Submission.dmcbr_sl_sb_ennreal_liminf_add_le : ∀ (ι : Type) (F : Filter ι) (u v : ι → ℝ≥0∞), liminf u F + liminf v F ≤ liminf (fun i => u i + v i) F := by
  intro ι F u v
  simp only [liminf_eq_iSup_iInf]
  refine ENNReal.biSup_add_biSup_le' ⟨univ, univ_mem⟩ ⟨univ, univ_mem⟩ fun s hs t ht => ?_
  exact le_iSup₂_of_le (s ∩ t) (inter_mem hs ht) <|
    le_iInf₂ fun i hi => add_le_add (iInf₂_le i hi.1) (iInf₂_le i hi.2)

/-- **Combined mass majorant for the slices of a represented current and of its boundary**
(Simon Ch. 6, (4.6)–(4.10)).  Assume the slicing bounds (SL) for represented currents.  If `X` and
`∂X` are represented by `(μ, ξ)` and `(μ', ξ')` and `f` is `L`-Lipschitz, the slices `A_t` of `X`
and `B_t` of `∂X` given by (SL) satisfy, with `Z_t = ∂A_t − B_t`, the bound
`M_W(Z_t) + M_W(∂Z_t) ≤ L · liminf_{h ↓ 0} h⁻¹ (μ + μ')(W ∩ {t − h < f < t})` for open `W`.  (SL)
bounds `M_W(Z_t)` by the `μ`-term.  Since `∂∂A_t = 0`, `∂Z_t = −∂B_t`, so `M_W(∂Z_t) = M_W(∂B_t)`
(both are `0` in degree `0`), which the boundary-slice bound controls by the `μ'`-term; the
superadditivity of `liminf` in `[0, ∞]` combines the two terms. -/
theorem Submission.dtc_bc_tc_cl_sl_slice_sum_mass_bound : (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P d : ℕ) (U : Set (Euclid P)) (X : GeometricCurrentOn U (d + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (d + 1), X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn U d, X.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (d + 1)) (B : ℝ → GeometricCurrentOn U d), (∀ (t : ℝ) (ω : TestFormOn U (d + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U d), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W + boundaryMassOn ((A t).boundary - B t) W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * (μ + μ') (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) := by
  intro SL P d U X μ μ' ξ ξ' f L hU hμ hμ' hξ hξ' hξb hξb' hX hXb hf
  obtain ⟨A, B, hA, hB, -, hmass, -⟩ :=
    SL P d U X μ μ' ξ ξ' f L hU hμ hμ' hξ hξ' hξb hξb' hX hXb hf
  refine ⟨A, B, hA, hB, fun W t hW => ?_⟩
  -- `∂(∂A' − B') = −∂B'` because `∂∂A' = 0`, so the boundary masses agree in every degree
  have hbd : ∀ (m : ℕ) (A' : GeometricCurrentOn U (m + 1)) (B' : GeometricCurrentOn U m),
      boundaryMassOn (A'.boundary - B') W = boundaryMassOn B' W := by
    intro m A' B'
    cases m with
    | zero => rfl
    | succ e =>
      show (A'.boundary - B').boundary.massOn W = B'.boundary.massOn W
      refine Submission.dmcbr_sl_sb_massOn_eq_of_apply_eq_neg P e U _ _ W fun ζ => ?_
      change A'.boundary.boundary ζ - B'.boundary ζ = -B'.boundary ζ
      rw [GeometricCurrentOn.boundary_boundary, GeometricCurrentOn.zero_apply, zero_sub]
  -- `M_W(∂B_t)` is bounded by the `μ'`-term ((SL) for `∂X`, whose boundary is represented by `0`)
  have hB' := Submission.dmcbr_sl_sb_boundaryMassOn_slice_le SL P d U X μ' ξ' f L t (B t) W hU hW
    hμ' hξ' hξb' hXb hf (hB t)
  have hsum := Submission.dmcbr_sl_sb_ennreal_liminf_add_le ℝ (𝓝[>] 0)
    (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t}))
    (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ' (W ∩ {x | t - h < f x ∧ f x < t}))
  rw [hbd d (A t) (B t)]
  refine (add_le_add (hmass W t hW) hB').trans ?_
  rw [← mul_add]
  gcongr
  refine hsum.trans_eq ?_
  simp only [Measure.add_apply, mul_add]
/-- Slices of weakly convergent represented currents converge weakly (Simon 7.2.4, slicing step).
Given the sublevel-restriction convergence (T2), applying it to `Xⱼ ⇀ X` in degree `d + 1` with
limit measure `ν` gives `Aⱼ(ω) → A(ω)`, and applying it to `∂Xⱼ ⇀ ∂X` in degree `d` with limit
measure `ν'` gives `Bⱼ(η) → B(η)`; testing the first on `dη` and subtracting gives
`(∂Aⱼ − Bⱼ)(η) = Aⱼ(dη) − Bⱼ(η) → A(dη) − B(η) = (∂A − B)(η)`. -/
theorem Submission.dtc_bc_tc_cl_sl_slices_weakly_converge : (∀ (P k : ℕ) (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U k) (X : GeometricCurrentOn U k) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P k) (μX μ : Measure (Euclid P)) (ξX : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (t : ℝ), IsOpen U → Continuous f → WeaklyConvergesOn Xs X → (∀ j, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μs j K < ∞) → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) k, |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ j, ∀ ω : TestFormOn U k, Xs j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μX K < ∞) → AEStronglyMeasurable ξX μX → (∀ᵐ x ∂μX, ∀ α : Covector (Euclid P) k, |ξX x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, X ω = ∫ x, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → μ {x | f x = t} = 0 → ∀ ω : TestFormOn U k, Tendsto (fun j => ∫ x in {x | f x < t}, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) atTop (𝓝 (∫ x in {x | f x < t}, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX))) → ∀ (P d : ℕ) (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U (d + 1)) (X : GeometricCurrentOn U (d + 1)) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P (d + 1)) (μs' : ℕ → Measure (Euclid P)) (ξs' : ℕ → Euclid P → MultiVector P d) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (μ' : Measure (Euclid P)) (ξ' : Euclid P → MultiVector P d) (ν ν' : Measure (Euclid P)) (f : Euclid P → ℝ) (t : ℝ) (As : ℕ → GeometricCurrentOn U (d + 1)) (Bs : ℕ → GeometricCurrentOn U d) (A : GeometricCurrentOn U (d + 1)) (B : GeometricCurrentOn U d), IsOpen U → Continuous f → WeaklyConvergesOn Xs X → (∀ j, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μs j K < ∞) → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) (d + 1), |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ j, ∀ ω : TestFormOn U (d + 1), Xs j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂(μs j)) → (∀ j, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μs' j K < ∞) → (∀ j, AEStronglyMeasurable (ξs' j) (μs' j)) → (∀ j, ∀ᵐ x ∂(μs' j), ∀ α : Covector (Euclid P) d, |ξs' j x α| ≤ covectorEuclideanNorm α) → (∀ j, ∀ η : TestFormOn U d, (Xs j).boundary η = ∫ x, ξs' j x ((η : DifferentialForm (Euclid P) d) x) ∂(μs' j)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (d + 1), X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ η : TestFormOn U d, X.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ν K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ ν K) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ν' K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs' j K) atTop ≤ ν' K) → ν {x | f x = t} = 0 → ν' {x | f x = t} = 0 → (∀ (j : ℕ) (ω : TestFormOn U (d + 1)), As j ω = ∫ x in {x | f x < t}, ξs j x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂(μs j)) → (∀ (j : ℕ) (η : TestFormOn U d), Bs j η = ∫ x in {x | f x < t}, ξs' j x ((η : DifferentialForm (Euclid P) d) x) ∂(μs' j)) → (∀ ω : TestFormOn U (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn U d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → WeaklyConvergesOn (fun j => (As j).boundary - Bs j) (A.boundary - B) := by
  intro hT2 P d U Xs X μs ξs μs' ξs' μ ξ μ' ξ' ν ν' f t As Bs A B hU hf hX hμs hξs hξsb hXs
    hμs' hξs' hξs'b hbXs hμ hξ hξb hXrep hμ' hξ' hξ'b hbX hν hνs hν' hν's hνt hν't hAs hBs hA hB
  -- Step 1: (T2) in degree `d + 1` for `Xⱼ ⇀ X`, representations `(μⱼ, ξⱼ)`, `(μ, ξ)`, limit `ν`.
  have hslice := hT2 P (d + 1) U Xs X μs ξs μ ν ξ f t hU hf hX hμs hξs hξsb hXs hμ hξ hξb hXrep
    hν hνs hνt
  -- Steps 2–3: `∂Xⱼ ⇀ ∂X`; (T2) in degree `d`, representations `(μ'ⱼ, ξ'ⱼ)`, `(μ', ξ')`, limit `ν'`.
  have hslice' := hT2 P d U (fun j => (Xs j).boundary) X.boundary μs' ξs' μ' ν' ξ' f t hU hf
    hX.boundary hμs' hξs' hξs'b hbXs hμ' hξ' hξ'b hbX hν' hν's hν't
  -- Step 4: test `Aⱼ ⇀ A` on `dη`, then subtract `Bⱼ(η) → B(η)`.
  intro η
  have hAη : Tendsto (fun j => As j (exteriorDerivativeTestOn U d η)) atTop
      (𝓝 (A (exteriorDerivativeTestOn U d η))) := by
    rw [hA]
    exact (hslice _).congr fun j => (hAs j _).symm
  have hBη : Tendsto (fun j => Bs j η) atTop (𝓝 (B η)) := by
    rw [hB]
    exact (hslice' η).congr fun j => (hBs j η).symm
  exact hAη.sub hBη
/-- Weak limits in `ℝᴾ` of integer multiplicity `d`-currents `Zᵢ ⇀ Z` with
`liminfᵢ (M_{W_k}(Zᵢ) + M_{W_k}(∂Zᵢ)) < ∞` on every ball `W_k = B_{k+1}(0)` are integer
multiplicity, given the closure property `CL_P(d)` in open sets and the locality `IML_P(d)`.
`Z` has locally finite mass by lower semicontinuity.  For `x ∈ ℝᴾ` take `k ≥ |x|`, so
`B_1(x) ⊆ W_k`, and a subsequence with `M_{W_k}(Z_{ψ l}) + M_{W_k}(∂Z_{ψ l}) ≤ C`; the restrictions
to `B_1(x)` are integer multiplicity, converge weakly to `Z⌞B_1(x)` and have bounded mass and
boundary mass (restriction does not increase either), so `CL_P(d)` in `B_1(x)` makes `Z⌞B_1(x)`
integer multiplicity, and `IML_P(d)` glues. -/
theorem Submission.dtc_bc_tc_cl_sl_isIntegerMultiplicity_of_liminf_bounds : ∀ (P d : ℕ), (∀ (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → (∀ (U : Set (Euclid P)) (X : GeometricCurrentOn U d), IsOpen U → ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → X.massOn W < ∞) → (∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ ∃ h : ball x r ⊆ U, IsIntegerMultiplicity (X.restrictDomain h)) → IsIntegerMultiplicity X) ∧ (∀ (V : Set (Euclid P)) (h : V ⊆ U), IsOpen V → IsIntegerMultiplicity X → IsIntegerMultiplicity (X.restrictDomain h))) → ∀ (Zs : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) d) (Z : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ i, IsIntegerMultiplicity (Zs i)) → WeaklyConvergesOn Zs Z → (∀ k : ℕ, liminf (fun i => (Zs i).massOn (ball (0 : Euclid P) ((k : ℝ) + 1)) + boundaryMassOn (Zs i) (ball (0 : Euclid P) ((k : ℝ) + 1))) atTop < ∞) → IsIntegerMultiplicity Z := by
  intro P d hCL hIML Zs Z hZs hconv hlim
  -- restriction to `V ⊆ ℝᴾ` does not increase `M_W` (in a fresh degree `m`)
  have hmass : ∀ (m : ℕ) (V : Set (Euclid P)) (hV : V ⊆ univ)
      (S : GeometricCurrentOn (univ : Set (Euclid P)) m) (W W' : Set (Euclid P)), W ⊆ W' →
      (S.restrictDomain hV).massOn W ≤ S.massOn W' := by
    intro m V hV S W W' hWW'
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    exact S.le_massOn (omega := testFormOnInclusion hV m ω) ⟨hω.1.trans hWW', hω.2⟩
  -- nor `M_W(∂ ·)`, since `∂(S⌞V) = (∂S)⌞V`
  have hbdry : ∀ (m : ℕ) (V : Set (Euclid P)) (hV : V ⊆ univ)
      (S : GeometricCurrentOn (univ : Set (Euclid P)) m) (W W' : Set (Euclid P)), W ⊆ W' →
      boundaryMassOn (S.restrictDomain hV) W ≤ boundaryMassOn S W' := by
    intro m V hV S W W' hWW'
    cases m with
    | zero => exact le_rfl
    | succ e =>
      have hcomm : (S.restrictDomain hV).boundary = S.boundary.restrictDomain hV :=
        GeometricCurrentOn.ext fun _ => rfl
      change (S.restrictDomain hV).boundary.massOn W ≤ S.boundary.massOn W'
      rw [hcomm]
      exact hmass e V hV S.boundary W W' hWW'
  -- `Z` has locally finite mass, by lower semicontinuity of mass
  have hZmass : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → Z.massOn W < ∞ := by
    intro W _ hW
    obtain ⟨r, hr⟩ := hW.1.isBounded.subset_ball (0 : Euclid P)
    obtain ⟨k, hk⟩ := exists_nat_ge r
    calc Z.massOn W ≤ Z.massOn (ball (0 : Euclid P) ((k : ℝ) + 1)) :=
          Z.massOn_mono (subset_closure.trans (hr.trans (ball_subset_ball (by linarith))))
      _ ≤ liminf (fun i => (Zs i).massOn (ball (0 : Euclid P) ((k : ℝ) + 1))) atTop :=
          hconv.massOn_le_liminf _
      _ ≤ liminf (fun i => (Zs i).massOn (ball (0 : Euclid P) ((k : ℝ) + 1)) +
            boundaryMassOn (Zs i) (ball (0 : Euclid P) ((k : ℝ) + 1))) atTop :=
          liminf_le_liminf (Eventually.of_forall fun _ => le_self_add)
      _ < ∞ := hlim k
  refine (hIML univ Z isOpen_univ).1 hZmass fun x _ => ⟨1, one_pos, subset_univ _, ?_⟩
  -- `B_1(x) ⊆ W_k` for `k ≥ |x|`
  obtain ⟨k, hk⟩ := exists_nat_ge ‖x‖
  have hball : ball x 1 ⊆ ball (0 : Euclid P) ((k : ℝ) + 1) := by
    refine ball_subset_ball' ?_
    rw [dist_zero_right]
    linarith
  -- a subsequence with `M_{W_k}(Z_{ψ l}) + M_{W_k}(∂Z_{ψ l}) ≤ C < ∞`
  obtain ⟨C, hC, hC'⟩ := exists_between (hlim k)
  obtain ⟨ψ, hψ, hψC⟩ :=
    extraction_of_frequently_atTop (frequently_lt_of_liminf_lt (by isBoundedDefault) hC)
  -- `CL_P(d)` in `B_1(x)` for the restrictions `Z_{ψ l}⌞B_1(x) ⇀ Z⌞B_1(x)`
  refine hCL (ball x 1) (fun l => (Zs (ψ l)).restrictDomain (subset_univ _))
    (Z.restrictDomain (subset_univ _)) isOpen_ball
    (fun l => (hIML univ (Zs (ψ l)) isOpen_univ).2 _ _ isOpen_ball (hZs (ψ l))) ?_
    fun ω => (hconv (testFormOnInclusion (subset_univ _) d ω)).comp hψ.tendsto_atTop
  intro W _ hW
  have hWk : W ⊆ ball (0 : Euclid P) ((k : ℝ) + 1) := subset_closure.trans (hW.2.trans hball)
  exact (iSup_le fun l =>
    (add_le_add (hmass d (ball x 1) (subset_univ _) (Zs (ψ l)) W _ hWk)
      (hbdry d (ball x 1) (subset_univ _) (Zs (ψ l)) W _ hWk)).trans (hψC l).le).trans_lt hC'
/-- **Simon Ch. 6, proof of 8.2, (1)–(2)** (slices 4.6–4.9 by `f = |· − x₁|`, `Lip f = 1`): for a
cycle `C`, represent `∂C = 0` by the zero measure.  (SL) gives `A_ρ = C⌞B_ρ(x₁)` and `B_ρ = 0`,
`∂A_ρ` vanishes off `∂B_ρ(x₁)` (4.8) and `M(∂A_ρ) ≤ liminf_{h↓0} h⁻¹μ{ρ − h < |x − x₁| < ρ}` (4.9);
(ISP) makes `∂A_ρ` integer multiplicity for `ρ` outside a Lebesgue-null set. -/
theorem Submission.cbrld_sphere_slice_isIntegerMultiplicity : (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P d : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (x₁ : Euclid P), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∃ N : Set ℝ, volume N = 0 ∧ ∀ ρ : ℝ, 0 < ρ → ρ ∉ N → ∃ A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in ball x₁ ρ, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) ∧ IsIntegerMultiplicity A.boundary ∧ A.boundary.support ⊆ sphere x₁ ρ ∧ A.boundary.mass ≤ liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ}) (𝓝[>] 0) := by
  intro hSL P d C μ ξ x₁ hCb hμ hξm hξb hC hISP
  -- step 1: `∂C = 0` is represented by the zero measure and the zero field of `d`-vectors
  have hμ0 : ∀ K : Set (Euclid P), IsCompact K → (0 : Measure (Euclid P)) K < ∞ :=
    fun K _ => by simp
  have hξ0m : AEStronglyMeasurable (0 : Euclid P → MultiVector P d) (0 : Measure (Euclid P)) :=
    aestronglyMeasurable_zero_measure _
  have hξ0b : ∀ᵐ x ∂(0 : Measure (Euclid P)), ∀ α : Covector (Euclid P) d,
      |(0 : Euclid P → MultiVector P d) x α| ≤ covectorEuclideanNorm α := by
    simp [ae_zero]
  have hCb0 : ∀ η : TestFormOn (univ : Set (Euclid P)) d,
      C.boundary η = ∫ x, (0 : Euclid P → MultiVector P d) x
        ((η : DifferentialForm (Euclid P) d) x) ∂(0 : Measure (Euclid P)) := by
    intro η
    rw [hCb, integral_zero_measure]
    rfl
  -- the slicing function `f = |· − x₁|` is `1`-Lipschitz
  have hf : LipschitzWith 1 (fun x : Euclid P => dist x x₁) := LipschitzWith.dist_left x₁
  -- step 3: (SL) for `C`, `f` and `L = 1`
  obtain ⟨A, B, hA, hB, hAB, hmass, -⟩ := hSL P d univ C μ 0 ξ 0 (fun x => dist x x₁) 1
    isOpen_univ (fun K hK _ => hμ K hK) (fun K hK _ => hμ0 K hK) hξm hξ0m hξb hξ0b hC hCb0 hf
  -- step 2: the exceptional set of (ISP) is Lebesgue-null
  have hISP' := hISP μ 0 ξ 0 hμ hμ0 hξm hξ0m hξb hξ0b hC hCb0 (fun x => dist x x₁) 1 hf
  refine ⟨_, ae_iff.mp hISP', fun ρ _ hρN => ?_⟩
  simp only [Set.mem_ofPred_eq, not_not] at hρN
  -- step 4: `B_ρ = 0`, so `∂A_ρ − B_ρ = ∂A_ρ`
  have hB0 : ∀ η, B ρ η = 0 := by
    intro η
    rw [hB ρ η, Measure.restrict_zero, integral_zero_measure]
  have hsub : (A ρ).boundary - B ρ = (A ρ).boundary := by
    ext η
    show (A ρ).boundary η - B ρ η = (A ρ).boundary η
    rw [hB0, sub_zero]
  refine ⟨A ρ, fun ω => hA ρ ω, ?_, ?_, ?_⟩
  · -- step 5: integer multiplicity
    rw [← hsub]
    exact hρN (A ρ) (B ρ) (hA ρ) (hB ρ)
  · -- step 6: `∂A_ρ` vanishes on a ball around every point off `∂B_ρ(x₁)`
    intro y hy
    by_contra hy'
    rw [Metric.mem_sphere] at hy'
    have hr : 0 < |dist y x₁ - ρ| / 2 := half_pos (abs_pos.mpr (sub_ne_zero.mpr hy'))
    apply hy.2
    refine Set.mem_sUnion_of_mem (mem_ball_self hr) ⟨isOpen_ball, ?_, subset_univ _, ?_⟩
    · exact (isCompact_closedBall y _).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall
    · intro η hη
      rw [hAB ρ η ?_, hB0]
      refine Set.disjoint_left.mpr fun z hz hz' => ?_
      have h1 : dist z y < |dist y x₁ - ρ| / 2 := hη hz
      have h2 : dist z x₁ = ρ := hz'
      have h3 := abs_dist_sub_le z y x₁
      rw [h2, abs_sub_comm] at h3
      linarith
  · -- step 7: the mass bound with `W = ℝᴾ`
    have h := hmass univ ρ isOpen_univ
    rw [hsub] at h
    simp only [ENNReal.coe_one, one_mul, univ_inter] at h
    exact h
/-- **Restriction of an integer multiplicity representation** (Simon Ch. 6, 3.1).  For
`R = (M, θ, ξ)` with weight `μ_R = θ Hⁿ⌞M`: (a) `μ_R ≪ Hⁿ⌞M`; (b) `ξ` is `μ_R`-a.e. strongly
measurable; (c) for Borel `E` and `R' = (M ∩ E, θ, ξ)`, `μ_{R'} = μ_R⌞E` and
`R'(ω) = ∫_E ⟨ω, ξ⟩ dμ_R` for every `n`-form `ω`. -/
theorem Submission.lcmp_imRep_measure_restrict : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), R.measure ≪ μHE[n].restrict R.carrier ∧ AEStronglyMeasurable R.orient R.measure ∧ ∀ (E : Set (Euclid P)) (R' : IMRep U n), MeasurableSet E → R'.carrier = R.carrier ∩ E → R'.mult = R.mult → R'.orient = R.orient → R'.measure = R.measure.restrict E ∧ ∀ ω : DifferentialForm (Euclid P) n, R'.action ω = ∫ x in E, R.orient x (ω x) ∂R.measure := by
  intro P n U R
  -- (a) a measure with a density is absolutely continuous; (b) so `ξ` is `μ_R`-measurable
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  refine ⟨hac, R.aestronglyMeasurable_orient.mono_ac hac, ?_⟩
  intro E R' hE hc hm ho
  -- (c), weights: `((Hⁿ⌞M).withDensity θ)⌞E = (Hⁿ⌞(E ∩ M)).withDensity θ = μ_{R'}`
  have hmeasEq : R'.measure = R.measure.restrict E := by
    unfold IMRep.measure
    rw [restrict_withDensity hE, Measure.restrict_restrict hE, hc, hm, inter_comm]
  refine ⟨hmeasEq, fun ω => ?_⟩
  -- (c), actions: `∫ h d(λ.withDensity θ) = ∫ θ h dλ` for the Borel density `θ : ℝᴾ → [0, ∞)`
  have hmult : (fun x => (R'.mult x : ℝ≥0∞)) = fun x => (((R'.mult x : NNReal)) : ℝ≥0∞) := by
    funext x
    simp
  have hmeas : Measurable fun x => ((R'.mult x : ℕ) : NNReal) :=
    (measurable_from_nat (f := fun k : ℕ => (k : NNReal))).comp R'.measurable_mult
  rw [← hmeasEq]
  unfold IMRep.action IMRep.measure
  rw [hmult, integral_withDensity_eq_integral_smul hmeas]
  congr 1
  funext x
  rw [ho, NNReal.smul_def, smul_eq_mul]
  norm_cast
/-- `spt(S − T) ⊆ spt S ∪ spt T`.  A point `y ∈ U` outside `spt S ∪ spt T` lies in zero-region
sets `W₁` of `S` and `W₂` of `T`; then `W₁ ∩ W₂` is open, contains `y`, has compact closure in `U`
(a closed subset of `closure W₁`), and `S − T` vanishes on it, so `y ∉ spt(S − T)`. -/
theorem Submission.cbrld_ns_support_sub_subset : ∀ (P n : ℕ) (U : Set (Euclid P)) (S T : GeometricCurrentOn U n), (S - T).support ⊆ S.support ∪ T.support := by
  intro P n U S T y hy
  obtain ⟨hyU, hyZ⟩ := hy
  by_contra hST
  -- `y ∈ Z(S)` and `y ∈ Z(T)`, since `y ∈ U` lies in neither support
  have hS : y ∈ S.zeroRegion := not_not.mp fun h => hST (Or.inl ⟨hyU, h⟩)
  have hT : y ∈ T.zeroRegion := not_not.mp fun h => hST (Or.inr ⟨hyU, h⟩)
  obtain ⟨W₁, ⟨hW₁o, hW₁c, hW₁U, hW₁v⟩, hyW₁⟩ := mem_sUnion.mp hS
  obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hyW₂⟩ := mem_sUnion.mp hT
  -- `W₁ ∩ W₂` belongs to the family whose union is `Z(S − T)`
  have hcl : closure (W₁ ∩ W₂) ⊆ closure W₁ := closure_mono inter_subset_left
  refine hyZ (mem_sUnion.mpr ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o,
    hW₁c.of_isClosed_subset isClosed_closure hcl, hcl.trans hW₁U, ?_⟩, hyW₁, hyW₂⟩)
  -- `(S − T)(ω) = S(ω) − T(ω) = 0 − 0`
  intro ω hω
  change S ω - T ω = 0
  rw [hW₁v ω (hω.trans inter_subset_left), hW₂v ω (hω.trans inter_subset_right), sub_zero]
/-- `M_W(S − T) ≤ M_W(S) + M_W(T)`.  For every `W`-admissible `ω`, `−ω` is `W`-admissible as well
(`tsupport (−ω) = tsupport ω`, `|−ω(x)| = |ω(x)|`) and `(S − T)(ω) = S(ω) + T(−ω)`, so
`ofReal((S − T)(ω)) ≤ ofReal(S(ω)) + ofReal(T(−ω)) ≤ M_W(S) + M_W(T)`; take the supremum
over `ω`. -/
theorem Submission.cbrld_ns_massOn_sub_le : ∀ (P n : ℕ) (U W : Set (Euclid P)) (S T : GeometricCurrentOn U n), (S - T).massOn W ≤ S.massOn W + T.massOn W := by
  intro P n U W S T
  refine sSup_le ?_
  rintro r ⟨ω, hω, rfl⟩
  -- `−ω` is `W`-admissible
  have hneg : -ω ∈ massAdmissibleOn U n W := by
    refine ⟨?_, fun x => ?_⟩
    · show tsupport (-(ω : DifferentialForm (Euclid P) n)) ⊆ W
      rw [tsupport_neg]
      exact hω.1
    · show covectorEuclideanNorm (-(ω : DifferentialForm (Euclid P) n) x) ≤ 1
      rw [covectorEuclideanNorm_neg]
      exact hω.2 x
  -- `(S − T)(ω) = S(ω) + T(−ω)`
  have heq : (S - T) ω = S ω + T (-ω) := by
    rw [show T (-ω) = -T ω from map_neg T.toCurrent ω]
    exact sub_eq_add_neg (S ω) (T ω)
  calc ENNReal.ofReal ((S - T) ω) = ENNReal.ofReal (S ω + T (-ω)) := by rw [heq]
    _ ≤ ENNReal.ofReal (S ω) + ENNReal.ofReal (T (-ω)) := ENNReal.ofReal_add_le
    _ ≤ S.massOn W + T.massOn W := add_le_add (S.le_massOn hω) (T.le_massOn hneg)
/-- **Mass of a current integrating over a ball** (first half of fact 1(e) in the null-set step
of the lower density bound used for Simon 7.2.4): if `|⟨α, ξ(y)⟩| ≤ |α|` for `μ`-a.e. `y` and
`A(ω) = ∫_{B_ρ(x)} ⟨ω(y), ξ(y)⟩ dμ(y)` for all `ω ∈ 𝒟ⁿ(ℝᴾ)`, then `M(A) ≤ μ(B_ρ(x))`.  The bound
is trivial if `μ(B_ρ(x)) = ∞`; otherwise each admissible `ω` (`|ω| ≤ 1`) has
`A(ω) ≤ |∫_{B_ρ(x)} ⟨ω, ξ⟩ dμ| ≤ μ(B_ρ(x))`, and `M(A)` is the supremum of these values. -/
theorem Submission.cbrld_ns_ball_current_mass_le : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n) (A : GeometricCurrentOn (univ : Set (Euclid P)) n) (x : Euclid P) (ρ : ℝ), (∀ᵐ y ∂μ, ∀ α : Covector (Euclid P) n, |ξ y α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, A ω = ∫ y in ball x ρ, ξ y ((ω : DifferentialForm (Euclid P) n) y) ∂μ) → A.mass ≤ μ (ball x ρ) := by
  intro P n μ ξ A x ρ hξ hA
  -- the bound is trivial if `μ(B_ρ(x)) = ∞`
  rcases eq_top_or_lt_top (μ (ball x ρ)) with htop | hfin
  · exact htop ▸ le_top
  -- `M(A)` is the supremum of `A(ω)` over admissible `ω`
  refine sSup_le ?_
  rintro r ⟨ω, hω, rfl⟩
  -- `|⟨ω(y), ξ(y)⟩| ≤ |ω(y)| ≤ 1` for `μ⌞B_ρ(x)`-a.e. `y`
  have hbound : ∀ᵐ y ∂μ.restrict (ball x ρ),
      ‖ξ y ((ω : DifferentialForm (Euclid P) n) y)‖ ≤ 1 :=
    ae_restrict_of_ae (hξ.mono fun y hy => (Real.norm_eq_abs _).trans_le ((hy _).trans (hω.2 y)))
  have hle : A ω ≤ (μ (ball x ρ)).toReal := by
    rw [hA ω]
    calc ∫ y in ball x ρ, ξ y ((ω : DifferentialForm (Euclid P) n) y) ∂μ
        ≤ ‖∫ y in ball x ρ, ξ y ((ω : DifferentialForm (Euclid P) n) y) ∂μ‖ := Real.le_norm_self _
      _ ≤ 1 * μ.real (ball x ρ) := norm_setIntegral_le_of_norm_le_const_ae hfin hbound
      _ = (μ (ball x ρ)).toReal := by rw [one_mul, measureReal_def]
  exact (ENNReal.ofReal_le_iff_le_toReal hfin.ne).2 hle
/-- `spt A ⊆ B̄_ρ(x)` when `A(ω) = ∫_{B_ρ(x)} ⟨ω(y), ξ(y)⟩ dμ(y)` for every test form `ω`.  If
`|y − x| > ρ`, then `W = B_r(y)`, `r = (|y − x| − ρ)/2 > 0`, is open with compact closure and
misses `B_ρ(x)`, so every test form supported in `W` vanishes on `B_ρ(x)` and `A` vanishes on `W`;
hence `y` lies in the zero region of `A` (Simon 6.2.11). -/
theorem Submission.cbrld_ns_ball_current_support_subset : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n) (A : GeometricCurrentOn (univ : Set (Euclid P)) n) (x : Euclid P) (ρ : ℝ), (∀ ω : TestFormOn (univ : Set (Euclid P)) n, A ω = ∫ y in ball x ρ, ξ y ((ω : DifferentialForm (Euclid P) n) y) ∂μ) → A.support ⊆ closedBall x ρ := by
  intro P n μ ξ A x ρ hA y hy
  by_contra hyx
  rw [mem_closedBall, not_le] at hyx
  -- `A` vanishes on `B_r(y)`, `r = (|y − x| − ρ)/2 > 0`, so `y` lies in the zero region of `A`
  have hr : 0 < (dist y x - ρ) / 2 := by linarith
  refine hy.2 (mem_sUnion_of_mem (mem_ball_self hr) ⟨isOpen_ball, ?_, subset_univ _, ?_⟩)
  · -- `closure B_r(y) ⊆ B̄_r(y)`, which is compact in the proper space `ℝᴾ`
    exact (isCompact_closedBall y _).of_isClosed_subset isClosed_closure
      closure_ball_subset_closedBall
  · -- a test form supported in `B_r(y)` vanishes at every `z ∈ B_ρ(x)`, since `|z − y| > r`
    intro ω hω
    rw [hA ω]
    refine setIntegral_eq_zero_of_forall_eq_zero fun z hz => ?_
    have hzω : z ∉ tsupport (ω : DifferentialForm (Euclid P) n) := by
      intro hz'
      have hzy := hω hz'
      rw [mem_ball] at hz hzy
      linarith [dist_triangle y z x, dist_comm z y]
    rw [image_eq_zero_of_notMem_tsupport hzω, map_zero]
/-- **Dilations of currents in `ℝᴾ` exist and agree with the blow-up `η_{a,λ#}`** (Simon Ch. 3,
1.4, chapter-03.txt line 85; push-forward 6.2.23, chapter-06.txt lines 403–413).  Call
`X' ∈ 𝒟ₘ(ℝᴾ)` a dilation of `X` if `X'(ω) = λ⁻ᵐ X(ω')` whenever `ω' = ω ∘ η`, `η = η_{a,λ}`.
Since `η(a + λy) = y`, `η(ℝᴾ) = ℝᴾ`, so `η_{a,λ#}X ∈ 𝒟ₘ(η(ℝᴾ))` restricts to `ℝᴾ`.  (i) This
restriction is a dilation of `X`; (ii) every dilation `X'` of `X` agrees with `η_{a,λ#}X`:
`X'(ω) = η_{a,λ#}X(ω₁)` whenever `ω₁ ∈ 𝒟ᵐ(η(ℝᴾ))` has the underlying form of `ω`.  Both follow
from `Submission.dtc_blowUp_testForm_corr` with `U = ℝᴾ`. -/
theorem Submission.cbr_cidc_dilation_exists_eq_blowUp : ∀ (P m : ℕ) (a : Euclid P) (lam : ℝ) (hlam : 0 < lam), (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) m, ∃ X' : GeometricCurrentOn (univ : Set (Euclid P)) m, (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X' ω = lam⁻¹ ^ m * X ω')) ∧ ∀ X X' : GeometricCurrentOn (univ : Set (Euclid P)) m, (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X' ω = lam⁻¹ ^ m * X ω') → ∀ (ω : TestFormOn (univ : Set (Euclid P)) m) (ω₁ : TestFormOn (dilation a lam '' (univ : Set (Euclid P))) m), (ω₁ : DifferentialForm (Euclid P) m) = (ω : DifferentialForm (Euclid P) m) → X' ω = blowUp X a lam hlam.ne' ω₁ := by
  intro P m a lam hlam
  obtain ⟨hA, -, hC⟩ := Submission.dtc_blowUp_testForm_corr P m univ a lam hlam
  -- Step 1: `η` maps `ℝᴾ` onto `ℝᴾ`, since `η(a + λy) = y`.
  have hsurj : (univ : Set (Euclid P)) ⊆ dilation a lam '' univ := fun y _ =>
    ⟨a + lam • y, mem_univ _, by
      simp [dilation, dilationCLM, smul_add, smul_smul, inv_mul_cancel₀ hlam.ne']⟩
  refine ⟨fun X => ?_, fun X X' hX' ω ω₁ hω => ?_⟩
  · -- Step 2, (i): the restriction of `η_{a,λ#}X` to `ℝᴾ` is a dilation of `X`, by part (c).
    refine ⟨(blowUp X a lam hlam.ne').restrictDomain hsurj, fun ω ω' hωω' => ?_⟩
    rw [GeometricCurrentOn.restrictDomain_apply]
    exact hC X _ ω' (by simpa using hωω')
  · -- Steps 3–4, (ii): part (a) gives `ω' = ω₁ ∘ η = ω ∘ η`, and part (c) and the dilation
    -- property give `η_{a,λ#}X(ω₁) = λ⁻ᵐ X(ω') = X'(ω)`.
    obtain ⟨ω', hω'⟩ := hA ω₁
    rw [hC X ω₁ ω' hω', hX' ω ω' (fun y => by rw [hω', hω])]
/-- **Dilations commute with the boundary** (Simon 6.2.3, chapter-06.txt line 216, and
6.2.24(1), line 414, for `η = η_{a,λ}`, `λ > 0`; the dilations of the closure theorem 6.8.2):
if `X'(ω) = λ^{-(m+1)} X(ω ∘ η)` on `𝒟^{m+1}(ℝᴾ)`, then `∂X'(ω) = λ⁻ᵐ ∂X(ω ∘ η)` on `𝒟ᵐ(ℝᴾ)`.

`η` maps `ℝᴾ` onto itself, so `ω` is also a test form `ω₁` in `η(ℝᴾ)`, and `dω`, `dω₁` have the
same underlying form.  Hence
`∂X'(ω) = X'(dω) = η_#X(dω₁) = ∂(η_#X)(ω₁) = η_#(∂X)(ω₁) = λ⁻ᵐ ∂X(ω')`
(`cbr_cidc_dilation_exists_eq_blowUp`, `dtc_blowUp_algebra` (iv), `dtc_blowUp_testForm_corr` (c)). -/
theorem Submission.cbr_cidc_dilation_boundary : ∀ (P m : ℕ) (a : Euclid P) (lam : ℝ), 0 < lam → ∀ X X' : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) (m + 1), (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) (m + 1)) y = (ω : DifferentialForm (Euclid P) (m + 1)) (dilation a lam y)) → X' ω = lam⁻¹ ^ (m + 1) * X ω') → ∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X'.boundary ω = lam⁻¹ ^ m * X.boundary ω' := by
  intro P m a lam hlam X X' hX ω ω' hω
  -- Step 1: `η(a + λy) = y`, so `η(ℝᴾ) = ℝᴾ` and `ω` is a test form `ω₁` in `η(ℝᴾ)`.
  have hsurj : (univ : Set (Euclid P)) ⊆ dilation a lam '' univ := fun y _ =>
    ⟨a + lam • y, mem_univ _, by simp [dilation, dilationCLM, smul_add, smul_smul, hlam.ne']⟩
  let ω₁ : TestFormOn (dilation a lam '' univ) m := testFormOnInclusion hsurj m ω
  -- Step 2: `X'(dω) = η_#X(dω₁)`, as `dω₁` and `dω` are the same form.
  have h1 := (Submission.cbr_cidc_dilation_exists_eq_blowUp P (m + 1) a lam hlam).2 X X' hX
    (exteriorDerivativeTestOn univ m ω) (exteriorDerivativeTestOn _ m ω₁) rfl
  -- Steps 2–3: `∂X'(ω) = X'(dω) = η_#X(dω₁) = ∂(η_#X)(ω₁) = η_#(∂X)(ω₁)`.
  rw [GeometricCurrentOn.boundary_apply, h1, ← GeometricCurrentOn.boundary_apply,
    (Submission.dtc_blowUp_algebra P univ a lam hlam).2.2.2 m X]
  -- Step 4: `η_#(∂X)(ω₁) = λ⁻ᵐ ∂X(ω')`, as `ω' = ω ∘ η = ω₁ ∘ η`.
  exact (Submission.dtc_blowUp_testForm_corr P m univ a lam hlam).2.2 X.boundary ω₁ ω' hω

/-- **A dilation of an integer multiplicity current is integer multiplicity** (item (3) of the
dilation calculus for `η = η_{a,λ}`, `λ > 0`: Simon Ch. 6, 3.3–3.9 for the push-forward 6.2.23,
as used for `η_{x,λⱼ#}T` in the proof of 7.3.1, chapter-07.txt lines 329–337).  If `R = (M, θ, ξ)`
represents `X` in `ℝᴾ`, then `R' = (η(M), θ ∘ η⁻¹, ξ ∘ η⁻¹)` represents `η_{a,λ#}X` in `η(ℝᴾ)`
(`dtc_blowUp_imrep`).  As `η(a + λy) = y`, `η(ℝᴾ) = ℝᴾ`: `R'` is also a triple in `ℝᴾ` (a compact
`K ⊆ ℝᴾ` lies in `η(ℝᴾ)`), and `X'(ω) = η_{a,λ#}X(ω) = R'(ω)` for every test form `ω` on `ℝᴾ`
(`cbr_cidc_dilation_exists_eq_blowUp`). -/
theorem Submission.cbr_cidc_dilation_isIntegerMultiplicity : ∀ (P m : ℕ) (a : Euclid P) (lam : ℝ), 0 < lam → ∀ X X' : GeometricCurrentOn (univ : Set (Euclid P)) m, (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X' ω = lam⁻¹ ^ m * X ω') → IsIntegerMultiplicity X → IsIntegerMultiplicity X' := by
  intro P m a lam hlam X X' hX hXim
  obtain ⟨R, hR⟩ := hXim
  -- `η = η_{a,λ}` is onto, `η(a + λy) = y`, so `ℝᴾ ⊆ η(ℝᴾ)`
  have hsurj : (univ : Set (Euclid P)) ⊆ dilation a lam '' univ := fun y _ =>
    ⟨a + lam • y, mem_univ _, by simp [dilation, dilationCLM, smul_add, smul_smul, hlam.ne']⟩
  -- `R' = (η(M), θ ∘ η⁻¹, ξ ∘ η⁻¹)` represents `η_{a,λ#}X` in `η(ℝᴾ)`
  obtain ⟨R', hR', -⟩ := Submission.dtc_blowUp_imrep P m univ X a lam hlam R hR
  -- the same triple in `ℝᴾ`: of its conditions only local integrability involves the domain
  refine ⟨{ carrier := R'.carrier
            mult := R'.mult
            orient := R'.orient
            measurableSet_carrier := R'.measurableSet_carrier
            carrier_subset := subset_univ _
            rectifiable := R'.rectifiable
            measurable_mult := R'.measurable_mult
            mult_pos := R'.mult_pos
            locallyIntegrable_mult := fun K hK _ =>
              R'.locallyIntegrable_mult K hK ((subset_univ K).trans hsurj)
            aestronglyMeasurable_orient := R'.aestronglyMeasurable_orient
            orients := R'.orients }, ?_⟩
  -- `X'(ω) = η_{a,λ#}X(ω) = R'(ω)`, with `ω` regarded as a test form in `η(ℝᴾ)`
  intro ω
  rw [(Submission.cbr_cidc_dilation_exists_eq_blowUp P m a lam hlam).2 X X' hX ω
    (testFormOnInclusion hsurj m ω) rfl, hR' (testFormOnInclusion hsurj m ω)]
  rfl

/-- **Integral representations under the dilation `η = η_{a,λ}`, `λ > 0`** (Simon 6.2.7 and
Remark 6.2.24(2), chapter-06.txt lines 271 and 414–419, for `f = η`; `η` as in Ch. 3, 1.4,
chapter-03.txt line 85).  If `X'` is a dilation of `X` (`X'(ω) = λ⁻ᵐ X(ω')` whenever
`ω' = ω ∘ η`) and `X(ω) = ∫ ⟨ω(x), ξ(x)⟩ dμ(x)`, then
`X'(ω) = ∫ ⟨ω(y), ξ(a + λy)⟩ d(λ⁻ᵐ η_*μ)(y)`: take `ω' = ω ∘ η`, change variables `y = η(x)`
(`η` is a homeomorphism, hence a measurable embedding) and use `a + λη(x) = x`. -/
theorem Submission.cbr_cidc_dilation_integral_rep : ∀ (P m : ℕ) (a : Euclid P) (lam : ℝ), 0 < lam → ∀ (X X' : GeometricCurrentOn (univ : Set (Euclid P)) m) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P m), (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X' ω = lam⁻¹ ^ m * X ω') → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μ) → ∀ ω : TestFormOn (univ : Set (Euclid P)) m, X' ω = ∫ y, ξ (a + lam • y) ((ω : DifferentialForm (Euclid P) m) y) ∂(ENNReal.ofReal (lam⁻¹ ^ m) • Measure.map (dilation a lam) μ) := by
  intro P m a lam hlam X X' μ ξ hX hrep ω
  have hne : lam ≠ 0 := hlam.ne'
  -- `η = η_{a,λ}` (`y ↦ −λ⁻¹a + λ⁻¹y`) and `ι(z) = a + λz` are mutually inverse.
  have hηι : ∀ y, dilation a lam (a + lam • y) = y := by
    intro y
    simp [dilation, dilationCLM, smul_add, smul_smul, hne]
  have hιη : ∀ x, a + lam • dilation a lam x = x := by
    intro x
    simp [dilation, dilationCLM, smul_add, smul_smul, hne]
  -- Step 1: `η` maps `ℝᴾ` onto itself, so `ω ∈ 𝒟ᵐ(η(ℝᴾ))`, and the accepted
  -- `dtc_blowUp_testForm_corr` (a) gives `ω' ∈ 𝒟ᵐ(ℝᴾ)` with `ω' = ω ∘ η`.
  have hsurj : (univ : Set (Euclid P)) ⊆ dilation a lam '' univ :=
    fun y _ => ⟨a + lam • y, mem_univ _, hηι y⟩
  obtain ⟨ω', hω'⟩ :=
    (Submission.dtc_blowUp_testForm_corr P m univ a lam hlam).1 (testFormOnInclusion hsurj m ω)
  -- Step 2: `X'(ω) = λ⁻ᵐ X(ω') = λ⁻ᵐ ∫ ⟨ω'(x), ξ(x)⟩ dμ(x)`.
  rw [hX ω ω' (fun y => by simpa using hω' y), hrep ω']
  -- Step 3: `η` is a homeomorphism, hence a measurable embedding, so
  -- `∫ g d(η_*μ) = ∫ g ∘ η dμ` for every `g` (no integrability needed).
  let η : Euclid P ≃ₜ Euclid P := (Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hne)).trans
    (Homeomorph.addLeft (-(lam⁻¹ • a)))
  have hη : ⇑η = dilation a lam := by
    funext y
    simp [η, dilation, dilationCLM]
  have hemb : MeasurableEmbedding (dilation a lam) := hη ▸ η.measurableEmbedding
  -- Steps 4–5: `∫ g d(c • ν) = c.toReal * ∫ g dν` with `(ofReal λ⁻ᵐ).toReal = λ⁻ᵐ`; for
  -- `g(y) = ⟨ω(y), ξ(a + λy)⟩`, `g(η(x)) = ⟨ω'(x), ξ(x)⟩` because `a + λη(x) = x`.
  rw [integral_smul_measure, hemb.integral_map, ENNReal.toReal_ofReal (by positivity), smul_eq_mul]
  congr 1
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  dsimp only
  rw [hιη x, hω' x, testFormOnInclusion_coe]
/-- **Mass scaling for dilations: `M_{η(W)}(X') = λ⁻ᵐ M_W(X)`** for `η = η_{a,λ}`, `λ > 0`, a
dilation `X' ∈ 𝒟ₘ(ℝᴾ)` of `X ∈ 𝒟ₘ(ℝᴾ)` (`X'(ω) = λ⁻ᵐ X(ω')` whenever `ω' = ω ∘ η`) and every
`W ⊆ ℝᴾ` (item (5) of the dilation calculus for the integer-multiplicity criterion for cycles;
`η_{x,λ}` of Simon Ch. 3, 1.4, chapter-03.txt line 85; mass `M_W` of 6.2.5, chapter-06.txt
lines 221–233, with the Euclidean coefficient norm).  `η(a + λy) = y`, so `η(ℝᴾ) = ℝᴾ` and
`𝒟ᵐ(ℝᴾ)`, `𝒟ᵐ(η(ℝᴾ))` consist of the same forms, with the same admissible forms for `M_{η(W)}`.
By `Submission.cbr_cidc_dilation_exists_eq_blowUp`, `X'(ω) = η_{a,λ#}X(ω)` on equal forms, so
`M_{η(W)}(X') = M_{η(W)}(η_{a,λ#}X)`, which is `λ⁻ᵐ M_W(X)` by
`Submission.dtc_blowUp_massOn_image`. -/
theorem Submission.cbr_cidc_dilation_massOn_image : ∀ (P m : ℕ) (a : Euclid P) (lam : ℝ), 0 < lam → ∀ X X' : GeometricCurrentOn (univ : Set (Euclid P)) m, (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X' ω = lam⁻¹ ^ m * X ω') → ∀ W : Set (Euclid P), X'.massOn (dilation a lam '' W) = ENNReal.ofReal (lam⁻¹ ^ m) * X.massOn W := by
  intro P m a lam hlam X X' hX W
  -- `η = η_{a,λ}` is onto (`η(a + λy) = y`), so `ℝᴾ` and `η(ℝᴾ)` have the same test forms.
  have hsurj : (univ : Set (Euclid P)) ⊆ dilation a lam '' univ := fun y _ =>
    ⟨a + lam • y, mem_univ _, by simp [dilation, dilationCLM, smul_add, smul_smul, hlam.ne']⟩
  have hsub : dilation a lam '' (univ : Set (Euclid P)) ⊆ univ := subset_univ _
  -- `X'(ω) = η_{a,λ#}X(ω₁)` whenever `ω` and `ω₁` have the same underlying form.
  have hblow := (Submission.cbr_cidc_dilation_exists_eq_blowUp P m a lam hlam).2 X X' hX
  refine Eq.trans ?_ (Submission.dtc_blowUp_massOn_image P m univ X a lam hlam W)
  -- The admissible forms for `M_{η(W)}(X')` and `M_{η(W)}(η_{a,λ#}X)` are the same forms, on
  -- which `X'` and `η_{a,λ#}X` agree.
  unfold GeometricCurrentOn.massOn
  congr 1
  ext r
  constructor
  · rintro ⟨φ, hφ, rfl⟩
    exact ⟨testFormOnInclusion hsurj m φ, hφ,
      congrArg ENNReal.ofReal (hblow φ (testFormOnInclusion hsurj m φ) rfl).symm⟩
  · rintro ⟨φ₁, hφ₁, rfl⟩
    exact ⟨testFormOnInclusion hsub m φ₁, hφ₁,
      congrArg ENNReal.ofReal (hblow (testFormOnInclusion hsub m φ₁) φ₁ rfl)⟩

/-- **Dilation calculus for currents in `ℝᴾ`** (Simon Ch. 6, 2.23 for the similarity
`η = η_{a,λ}`, `η(y) = λ⁻¹(y − a)`, `λ > 0`; used to rescale cycles in the proof that cycles with
the integer slice property are integer multiplicity).  Call `X' ∈ 𝒟ₘ(ℝᴾ)` a dilation of `X` if
`X'(ω) = λ⁻ᵐ X(ω')` whenever `ω' = ω ∘ η`.  (1) Since `η(a + λy) = y`, `η(ℝᴾ) = ℝᴾ`, and the
restriction of `η_{a,λ#}X ∈ 𝒟ₘ(η(ℝᴾ))` to `ℝᴾ` is a dilation of `X` by part (c) of
`Submission.dtc_blowUp_testForm_corr`.  (2)–(5) are `Submission.cbr_cidc_dilation_boundary`,
`Submission.cbr_cidc_dilation_isIntegerMultiplicity`, `Submission.cbr_cidc_dilation_integral_rep`
and `Submission.cbr_cidc_dilation_massOn_image`; (6) is part (i) of
`Submission.dtc_hausdorff_dilation`. -/
theorem Submission.cbr_ci_dilation_calculus : ∀ (P m : ℕ) (a : Euclid P) (lam : ℝ), 0 < lam → (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) m, ∃ X' : GeometricCurrentOn (univ : Set (Euclid P)) m, (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X' ω = lam⁻¹ ^ m * X ω')) ∧ (∀ X X' : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) (m + 1), (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) (m + 1)) y = (ω : DifferentialForm (Euclid P) (m + 1)) (dilation a lam y)) → X' ω = lam⁻¹ ^ (m + 1) * X ω') → ∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X'.boundary ω = lam⁻¹ ^ m * X.boundary ω') ∧ (∀ X X' : GeometricCurrentOn (univ : Set (Euclid P)) m, (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X' ω = lam⁻¹ ^ m * X ω') → IsIntegerMultiplicity X → IsIntegerMultiplicity X') ∧ (∀ (X X' : GeometricCurrentOn (univ : Set (Euclid P)) m) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P m), (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X' ω = lam⁻¹ ^ m * X ω') → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μ) → ∀ ω : TestFormOn (univ : Set (Euclid P)) m, X' ω = ∫ y, ξ (a + lam • y) ((ω : DifferentialForm (Euclid P) m) y) ∂(ENNReal.ofReal (lam⁻¹ ^ m) • Measure.map (dilation a lam) μ)) ∧ (∀ X X' : GeometricCurrentOn (univ : Set (Euclid P)) m, (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) m, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) m) y = (ω : DifferentialForm (Euclid P) m) (dilation a lam y)) → X' ω = lam⁻¹ ^ m * X ω') → ∀ W : Set (Euclid P), X'.massOn (dilation a lam '' W) = ENNReal.ofReal (lam⁻¹ ^ m) * X.massOn W) ∧ (∀ A : Set (Euclid P), μHE[m] (dilation a lam '' A) = ENNReal.ofReal (lam⁻¹ ^ m) * μHE[m] A) := by
  intro P m a lam hlam
  refine ⟨fun X => ?_, Submission.cbr_cidc_dilation_boundary P m a lam hlam,
    Submission.cbr_cidc_dilation_isIntegerMultiplicity P m a lam hlam,
    Submission.cbr_cidc_dilation_integral_rep P m a lam hlam,
    Submission.cbr_cidc_dilation_massOn_image P m a lam hlam,
    (Submission.dtc_hausdorff_dilation P m a lam hlam).1⟩
  -- (1) `η` maps `ℝᴾ` onto `ℝᴾ`, as `η(a + λy) = y`; so `η_{a,λ#}X` restricts to `ℝᴾ`, and the
  -- restriction is a dilation of `X` by part (c) of the test-form correspondence.
  obtain ⟨-, -, hC⟩ := Submission.dtc_blowUp_testForm_corr P m univ a lam hlam
  have hsurj : (univ : Set (Euclid P)) ⊆ dilation a lam '' univ := fun y _ =>
    ⟨a + lam • y, mem_univ _, by
      simp [dilation, dilationCLM, smul_add, smul_smul, inv_mul_cancel₀ hlam.ne']⟩
  refine ⟨(blowUp X a lam hlam.ne').restrictDomain hsurj, fun ω ω' hωω' => ?_⟩
  rw [GeometricCurrentOn.restrictDomain_apply]
  exact hC X _ ω' (by simpa using hωω')
/-- Restricted representing integrals are determined by the represented current (closure theorem,
Simon Ch. 6, 8.2–8.3, as used for 7.2.4): if `∫ ⟨ω, ξ₁⟩ dμ₁ = ∫ ⟨ω, ξ₂⟩ dμ₂ + ∫ ⟨ω, ξ₃⟩ dμ₃` for
every `ω ∈ 𝒟ᵏ(U)`, the same identity holds for the integrals over every Borel set `B`.  For fixed
`ω` the integrands are integrable (bounded by `|ω|`, which vanishes off the compact `spt ω ⊆ U`).
Testing the hypothesis with `gω`, `g` smooth, and letting `g = (1 - f)ʲ ↓ 𝟙_F` (`f` smooth,
`0 ≤ f ≤ 1`, with support `ℝᴾ \ F`) gives the identity on closed sets `F` by dominated
convergence; Dynkin's π-λ theorem extends it to all Borel sets. -/
theorem Submission.cbr_setIntegral_eq_of_integral_eq : ∀ (P k : ℕ) (U : Set (Euclid P)) (μ₁ μ₂ μ₃ : Measure (Euclid P)) (ξ₁ ξ₂ ξ₃ : Euclid P → MultiVector P k), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₁ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₂ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₃ K < ∞) → AEStronglyMeasurable ξ₁ μ₁ → AEStronglyMeasurable ξ₂ μ₂ → AEStronglyMeasurable ξ₃ μ₃ → (∀ᵐ x ∂μ₁, ∀ α : Covector (Euclid P) k, |ξ₁ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₂, ∀ α : Covector (Euclid P) k, |ξ₂ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₃, ∀ α : Covector (Euclid P) k, |ξ₃ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, ∫ x, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂ + ∫ x, ξ₃ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₃) → ∀ (B : Set (Euclid P)) (ω : TestFormOn U k), MeasurableSet B → ∫ x in B, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x in B, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂ + ∫ x in B, ξ₃ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₃ := by
  intro P k U μ₁ μ₂ μ₃ ξ₁ ξ₂ ξ₃ _hU hμ₁ hμ₂ hμ₃ hξ₁ hξ₂ hξ₃ hb₁ hb₂ hb₃ heq B ω hB
  set w : DifferentialForm (Euclid P) k := (ω : DifferentialForm (Euclid P) k)
  have hws : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) w := ω.property.1.1
  have hwc : HasCompactSupport w := ω.property.1.2
  have hwU : tsupport w ⊆ U := ω.property.2
  -- Step 1: `x ↦ ξ x (w x)` is integrable: it vanishes off the compact set `tsupport w ⊆ U` and
  -- is bounded by `sup |w|`.
  obtain ⟨C, hC⟩ : ∃ C, ∀ x, ‖covectorEuclideanNorm (w x)‖ ≤ C := by
    refine Continuous.bounded_above_of_compact_support ?_
      (hwc.comp_left (g := fun α : Covector (Euclid P) k => covectorEuclideanNorm α)
        (covectorEuclideanNorm_zero P k))
    unfold covectorEuclideanNorm
    refine Real.continuous_sqrt.comp (continuous_finsetSum _ fun I _ => ?_)
    exact Continuous.if_const _ ((hws.continuous.eval_const _).pow 2) continuous_const
  have hint : ∀ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P k),
      (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → AEStronglyMeasurable ξ μ →
      (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) k, |ξ x α| ≤ covectorEuclideanNorm α) →
      Integrable (fun x => ξ x (w x)) μ := by
    intro μ ξ hμ hξ hb
    have hsupp : support (fun x => ξ x (w x)) ⊆ tsupport w := by
      intro x hx
      by_contra hxw
      exact hx (by simp [image_eq_zero_of_notMem_tsupport hxw])
    rw [← integrableOn_iff_integrable_of_support_subset hsupp]
    refine Measure.integrableOn_of_bounded (M := C) (hμ _ hwc hwU).ne
      (isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable₂ hξ
        hws.continuous.aestronglyMeasurable) ?_
    filter_upwards [ae_restrict_of_ae hb] with x hx
    rw [Real.norm_eq_abs]
    exact (hx (w x)).trans ((le_abs_self _).trans ((Real.norm_eq_abs _) ▸ hC x))
  have hi₁ := hint μ₁ ξ₁ hμ₁ hξ₁ hb₁
  have hi₂ := hint μ₂ ξ₂ hμ₂ hξ₂ hb₂
  have hi₃ := hint μ₃ ξ₃ hμ₃ hξ₃ hb₃
  -- Step 2: testing the hypothesis with the test form `g • w`, `g` smooth.
  have hmul : ∀ g : Euclid P → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g →
      ∫ x, g x * ξ₁ x (w x) ∂μ₁ = ∫ x, g x * ξ₂ x (w x) ∂μ₂ + ∫ x, g x * ξ₃ x (w x) ∂μ₃ := by
    intro g hg
    have hmem : (fun x => g x • w x) ∈ testFormOnSubmodule U k :=
      ⟨⟨hg.smul hws, hwc.mono' ((subset_tsupport _).trans (tsupport_smul_subset_right g w))⟩,
        (tsupport_smul_subset_right g w).trans hwU⟩
    simpa only [Submodule.coe_mk, map_smul, smul_eq_mul] using heq ⟨fun x => g x • w x, hmem⟩
  -- Step 3: closed sets, by smooth approximation of the indicator and dominated convergence.
  have hclosed : ∀ F : Set (Euclid P), IsClosed F →
      ∫ x in F, ξ₁ x (w x) ∂μ₁ = ∫ x in F, ξ₂ x (w x) ∂μ₂ + ∫ x in F, ξ₃ x (w x) ∂μ₃ := by
    intro F hF
    obtain ⟨f, hfs, hfd, hfr⟩ := hF.isOpen_compl.exists_contDiff_support_eq (n := ⊤)
    have hgd : ∀ n : ℕ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x => (1 - f x) ^ n) :=
      fun n => (contDiff_const.sub hfd).pow n
    have hf01 : ∀ x, 0 ≤ f x ∧ f x ≤ 1 := fun x => hfr ⟨x, rfl⟩
    have hgb : ∀ (n : ℕ) x, ‖(1 - f x) ^ n‖ ≤ 1 := by
      intro n x
      rw [norm_pow, Real.norm_eq_abs, abs_of_nonneg (by linarith [(hf01 x).2])]
      exact pow_le_one₀ (by linarith [(hf01 x).2]) (by linarith [(hf01 x).1])
    have hlim : ∀ (μ : Measure (Euclid P)) (h : Euclid P → ℝ), Integrable h μ →
        Tendsto (fun n : ℕ => ∫ x, (1 - f x) ^ n * h x ∂μ) atTop (𝓝 (∫ x in F, h x ∂μ)) := by
      intro μ h hh
      rw [← integral_indicator hF.measurableSet]
      refine tendsto_integral_of_dominated_convergence (fun x => ‖h x‖) (fun n => ?_) hh.norm
        (fun n => Eventually.of_forall fun x => ?_) (Eventually.of_forall fun x => ?_)
      · exact (hgd n).continuous.aestronglyMeasurable.mul hh.aestronglyMeasurable
      · rw [norm_mul]
        exact mul_le_of_le_one_left (norm_nonneg _) (hgb n x)
      · by_cases hx : x ∈ F
        · have hfx : f x = 0 := Function.notMem_support.mp (by rw [hfs]; exact fun h => h hx)
          simp [hfx, hx]
        · have hfx : f x ≠ 0 := Function.mem_support.mp (by rw [hfs]; exact hx)
          have hpos : 0 < f x := lt_of_le_of_ne (hf01 x).1 (Ne.symm hfx)
          have := (tendsto_pow_atTop_nhds_zero_of_lt_one (r := 1 - f x)
            (by linarith [(hf01 x).2]) (by linarith)).mul_const (h x)
          simpa [hx] using this
    exact tendsto_nhds_unique (hlim μ₁ _ hi₁)
      (((hlim μ₂ _ hi₂).add (hlim μ₃ _ hi₃)).congr fun n => (hmul _ (hgd n)).symm)
  -- Step 4: Dynkin's π-λ theorem extends the identity from closed sets to all Borel sets.
  have hall : ∀ (t : Set (Euclid P)) (_ : MeasurableSet t),
      ∫ x in t, ξ₁ x (w x) ∂μ₁ = ∫ x in t, ξ₂ x (w x) ∂μ₂ + ∫ x in t, ξ₃ x (w x) ∂μ₃ := by
    refine MeasurableSpace.induction_on_inter (s := {s | IsClosed s})
      (C := fun t _ =>
        ∫ x in t, ξ₁ x (w x) ∂μ₁ = ∫ x in t, ξ₂ x (w x) ∂μ₂ + ∫ x in t, ξ₃ x (w x) ∂μ₃)
      ((BorelSpace.measurable_eq).trans borel_eq_generateFrom_isClosed) isPiSystem_isClosed
      (by simp) (fun t ht => hclosed t ht) (fun t htm ht => ?_) (fun f hfd hfm hf => ?_)
    · have e₁ := integral_add_compl htm hi₁
      have e₂ := integral_add_compl htm hi₂
      have e₃ := integral_add_compl htm hi₃
      have e := heq ω
      linarith
    · exact (hasSum_integral_iUnion hfm hfd hi₁.integrableOn).unique
        (((hasSum_integral_iUnion hfm hfd hi₂.integrableOn).add
          (hasSum_integral_iUnion hfm hfd hi₃.integrableOn)).congr_fun fun n => hf n)
  exact hall B hB
/-- **Mass upper bound from a representation by a unit-bounded multivector field** (Simon
6.2.5; step 10 of the representation `T = μ_T ∧ ξ⃗`).  Suppose `|⟨α, ξ(x)⟩| ≤ |α|_E` for all `x`
and all covectors `α` (`|·|_E` is `covectorEuclideanNorm`), and `T(ω) = ∫ ⟨ω(x), ξ(x)⟩ dμ(x)`
for every test form `ω`.  Then `M_W(T) ≤ μ(W)` for every set `W`.  Fix an admissible `ω`, i.e.
`tsupport ω ⊆ W` and `|ω|_E ≤ 1`, and let `K = tsupport ω` (closed, hence Borel) and
`f(x) = ⟨ω(x), ξ(x)⟩`.  Then `|f| ≤ |ω|_E ≤ 1` on `K` and `f = 0` off `K`, so
`T(ω) ≤ ‖∫ f dμ‖ₑ ≤ ∫⁻ ‖f‖ₑ dμ ≤ ∫⁻ 1_K dμ = μ(K) ≤ μ(W)`; the middle inequality holds whether
or not `f` is integrable.  Taking the supremum over admissible `ω` gives `M_W(T) ≤ μ(W)`. -/
theorem Submission.cmrc_massOn_le_of_repr : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) → ∀ W : Set (Euclid P), T.massOn W ≤ μ W := by
  intro P n U T μ ξ hξ hT W
  -- Step 1: it suffices to bound `ofReal (T ω)` for each admissible `ω`
  refine sSup_le ?_
  rintro r ⟨ω, hω, rfl⟩
  set K : Set (Euclid P) := tsupport (ω : DifferentialForm (Euclid P) n)
  have hKm : MeasurableSet K := (isClosed_tsupport _).measurableSet
  -- Step 2: `‖⟨ω(x), ξ(x)⟩‖ₑ ≤ 1_K(x)` for every `x`
  have hpt : ∀ x, ‖ξ x ((ω : DifferentialForm (Euclid P) n) x)‖ₑ ≤ K.indicator 1 x := by
    intro x
    by_cases hx : x ∈ K
    · rw [indicator_of_mem hx, Pi.one_apply, Real.enorm_eq_ofReal_abs, ← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal ((hξ x _).trans (hω.2 x))
    · rw [indicator_of_notMem hx, image_eq_zero_of_notMem_tsupport hx, map_zero, enorm_zero]
  -- Step 3: `T(ω) ≤ ‖∫ f dμ‖ₑ ≤ ∫⁻ ‖f‖ₑ dμ ≤ μ(K) ≤ μ(W)`
  calc ENNReal.ofReal (T ω)
      = ENNReal.ofReal (∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) := by rw [hT ω]
    _ ≤ ‖∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ‖ₑ := by
        rw [Real.enorm_eq_ofReal_abs]
        exact ENNReal.ofReal_le_ofReal (le_abs_self _)
    _ ≤ ∫⁻ x, ‖ξ x ((ω : DifferentialForm (Euclid P) n) x)‖ₑ ∂μ :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ x, K.indicator 1 x ∂μ := lintegral_mono hpt
    _ = μ K := lintegral_indicator_one hKm
    _ ≤ μ W := measure_mono hω.1

/-- **Localization at a point** (Simon Ch. 6, Remark 8.3(1), with the slicing of 4.5(1), (2) and
the averaging of Ch. 2, 6.7(2)).  Given the representation (REP), mass (MR), integer multiplicity
(IMC), slicing (SL) and convergence (TOOLS) facts as hypotheses: if `Tⱼ ∈ 𝒟_{d+1}(U)` are integer
multiplicity with `supⱼ (M_W(Tⱼ) + M_W(∂Tⱼ)) < ∞` for `W ⊂⊂ U`, `Tⱼ ⇀ T` and `x₀ ∈ U`, then there
are `r > 0` with `B̄_r(x₀) ⊆ U` and a subsequence `j'` such that `Sⱼ := T_{j'}⌞B_r(x₀)` are integer
multiplicity, carried by and vanishing off `B̄_r(x₀)`, with `supⱼ (M(Sⱼ) + M(∂Sⱼ)) < ∞`, and
`Sⱼ ⇀ A`, where `A = T` on forms supported in `B_r(x₀)`.  The radius `r` is a slicing level of
`dist(·, x₀)` where the limit of the weights does not charge `∂B_r(x₀)` and the slice defects
`M(∂(Tⱼ⌞B_r) − (∂Tⱼ)⌞B_r)` have a finite `liminf`; the mass bounds use the sublevel-set integral
formula, vanishing off the compact sphere and the mass triangle inequality. -/
theorem Submission.cbrcs_localize_at_point : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ((∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ⨆ j, μs j K < ∞) → ∃ (φ : ℕ → ℕ) (μ : Measure (Euclid P)), StrictMono φ ∧ μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(μs (φ j))) atTop (𝓝 (∫ x, f x ∂μ))) ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs (φ j) K) atTop ≤ μ K) ∧ (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs (φ j) G) atTop)) ∧ (∀ (P k : ℕ) (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U k) (X : GeometricCurrentOn U k) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P k) (μX μ : Measure (Euclid P)) (ξX : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (t : ℝ), IsOpen U → Continuous f → WeaklyConvergesOn Xs X → (∀ j, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μs j K < ∞) → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) k, |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ j, ∀ ω : TestFormOn U k, Xs j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μX K < ∞) → AEStronglyMeasurable ξX μX → (∀ᵐ x ∂μX, ∀ α : Covector (Euclid P) k, |ξX x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, X ω = ∫ x, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → μ {x | f x = t} = 0 → ∀ ω : TestFormOn U k, Tendsto (fun j => ∫ x in {x | f x < t}, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) atTop (𝓝 (∫ x in {x | f x < t}, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX))) ∧ (∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (G : Set (Euclid P)) (a b : ℝ) (L : NNReal) (Z : ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ j, μs j (G ∩ {x | a < f x ∧ f x < b}) < ∞) → (∀ (j : ℕ) (t : ℝ), t ∈ Ioo a b → Z j t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs j (G ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∃ g : ℝ → ℝ≥0∞, Measurable g ∧ (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => Z j t) atTop ≤ g t) ∧ ∫⁻ t in Ioo a b, g t ≤ (L : ℝ≥0∞) * liminf (fun j => μs j (G ∩ {x | a < f x ∧ f x < b})) atTop)) → ∀ (d P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U (d + 1)) (T : GeometricCurrentOn U (d + 1)) (x₀ : Euclid P), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → x₀ ∈ U → ∃ (r : ℝ) (Ss : ℕ → GeometricCurrentOn U (d + 1)) (Rs : ℕ → IMRep U (d + 1)) (A : GeometricCurrentOn U (d + 1)), 0 < r ∧ closedBall x₀ r ⊆ U ∧ (∀ j, (Rs j).Represents (Ss j) ∧ (Rs j).carrier ⊆ closedBall x₀ r) ∧ (∀ (j : ℕ) (ω : TestFormOn U (d + 1)), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (d + 1))) (closedBall x₀ r) → Ss j ω = 0) ∧ ⨆ j, ((Ss j).mass + (Ss j).boundary.mass) < ∞ ∧ WeaklyConvergesOn Ss A ∧ ∀ ω : TestFormOn U (d + 1), tsupport (ω : DifferentialForm (Euclid P) (d + 1)) ⊆ ball x₀ r → A ω = T ω := by
  have hVOM := Submission.lcmp_massOn_le_of_vanish_off_compact
  have hTRI := Submission.lcmp_massOn_le_add_of_eval_eq
  have hIR := Submission.lcmp_imRep_measure_restrict
  have hICF := Submission.rsd_imrep_compact_measure_ne_top
  have hIAI := Submission.dor_ims_action_eq_integral
  have hGR := Submission.dor_lmb_glc_good_radius
  have hMSI : (∀ (P k : ℕ) (U s : Set (Euclid P)) (X : GeometricCurrentOn U k) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P k), (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) k, |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, X ω = ∫ x in s, ξ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ) → X.mass ≤ μ s) := by
    intro P k U s X μ ξ hbd hrep
    unfold GeometricCurrentOn.mass GeometricCurrentOn.massOn
    apply sSup_le
    rintro _ ⟨ω, ⟨-, hω⟩, rfl⟩
    show ENNReal.ofReal (X ω) ≤ μ s
    rw [hrep ω]
    have hae : ∀ᵐ x ∂(μ.restrict s), ‖ξ x ((ω : DifferentialForm (Euclid P) k) x)‖ₑ ≤ 1 := by
      filter_upwards [ae_restrict_of_ae hbd] with x hx
      rw [Real.enorm_eq_ofReal_abs]
      exact ENNReal.ofReal_le_one.2 ((hx _).trans (hω x))
    calc ENNReal.ofReal (∫ x in s, ξ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ)
        ≤ ‖∫ x in s, ξ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ‖ₑ := by
          rw [Real.enorm_eq_ofReal_abs]
          exact ENNReal.ofReal_le_ofReal (le_abs_self _)
      _ ≤ ∫⁻ x in s, ‖ξ x ((ω : DifferentialForm (Euclid P) k) x)‖ₑ ∂μ := enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ x in s, 1 ∂μ := lintegral_mono_ae hae
      _ = μ s := by rw [setLIntegral_const, one_mul]
  intro hREP hMR hIMC hSL hTOOLS d P U Ts T x₀ hU hIM hbd hconv hx₀
  obtain ⟨_, hIMCb, _, hIMCd⟩ := hIMC
  obtain ⟨hT1, hT2, hMM⟩ := hTOOLS
  -- the slicing function
  set f : Euclid P → ℝ := fun x => dist x x₀ with hf_def
  have hf_cont : Continuous f := continuous_id.dist continuous_const
  have hf_lip : LipschitzWith 1 f := LipschitzWith.dist_left x₀
  -- Step 1: r₀ and G
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU x₀ hx₀
  have hr₀ : 0 < ε / 2 := half_pos hε
  have hcb₀ : closedBall x₀ (ε / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hε)).trans hεU
