    · intro a b c H c' d ha h1 h2 h3
      have h4 : a ≤ H + b := by linarith only [h1, h2]
      linarith only [pow_le_pow_left₀ ha h4 2, sq_nonneg (H - b), h3]
    · intro X H c' I Ψ' C' P V Vr C₆' hV hVr hC h1 hI h2 hc
      rw [hVr, hI] at h1
      rw [hC]
