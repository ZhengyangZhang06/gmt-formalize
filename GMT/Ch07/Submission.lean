  have hc1 : C₁₆ * θ' ^ 2 ≤ θ' / 128 := by
    calc C₁₆ * θ' ^ 2 = (θ' * C₁₆) * θ' := by ring
      _ ≤ 1 / 128 * θ' := by gcongr
      _ = θ' / 128 := by ring
  have hc2 : C₁₆ * (ε' / θ' ^ (n + 2)) ≤ θ' / 128 := by
    rw [mul_div_assoc', div_le_iff₀ (by positivity)]
    calc C₁₆ * ε' = ε' * C₁₆ := by ring
      _ ≤ θ' ^ (n + 3) / 128 := hε'C
      _ = θ' / 128 * θ' ^ (n + 2) := by ring
