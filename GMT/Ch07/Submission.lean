    rw [hws, ENNReal.ofReal_mul hCG0, ENNReal.ofReal_coe_nnreal]
    exact ⟨(measure_mono hsub).trans hGC8.1, (measure_mono hsub).trans hGC8.2⟩
  have hWw : ∀ j, (O j - O (j + 1)).mass ≤ ENNReal.ofReal (w j) * T.mass := by
    intro j
    cases j with
