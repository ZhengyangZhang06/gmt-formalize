  -- multiplicity
  have hdAIM : IsIntegerMultiplicity (At t).boundary := by
    refine hBR P univ (At t) isOpen_univ hAIM fun W _ hWU => ?_
    have hZ : ((At t).boundary - Bt t).massOn W < ∞ :=
