  -- `0 < sⱼ < rⱼ` and `sⱼ₊₁ < rⱼ`, so `φⱼ = ψ` on `{d ≥ rⱼ}`; `ψ` moves points by `≤ √P` (RET)
  have hr0 : ∀ j, 0 < r j := fun j => lt_trans (div_pos (he0 j) h16) (hr j).1
  have hrs : ∀ j, (1 / 2 : ℝ) ^ j / 32 ≤ r j := fun j =>
    (div_le_div_of_nonneg_left (he0 j).le h16 h16le32).trans (hr j).1.le
  have hrs' : ∀ j, (1 / 2 : ℝ) ^ (j + 1) / 32 ≤ r j := fun j =>
    (div_le_div_of_nonneg_right (pow_le_pow_of_le_one one_half_pos.le
      (one_half_lt_one (α := ℝ)).le (Nat.le_succ j)) h32.le).trans (hrs j)
  have hφψ : ∀ j x, r j ≤ d x → φ j x = ψ x := fun j x hx => hφeq j (le_trans (hrs j) hx)
  have hψd : ∀ x, 0 < d x → dist (ψ x) x ≤ Real.sqrt P := fun x hx => (hψ1 x hx).2
  have hEqZ : ∀ j, EqOn (φ j) (φ (j + 1)) (Z (j + 1)).support := by
    intro j x hx
    have hx' : d x = r j := hsuppZs j hx
    rw [hφψ j x hx'.ge, hφeq (j + 1)
      (show (1 / 2 : ℝ) ^ (j + 1) / 32 ≤ d x by rw [hx']; exact hrs' j)]
  have hdistW : ∀ j, ∀ x ∈ (O j - O (j + 1)).support,
      dist (φ j x) ((fun x : Euclid P => x) x) ≤ Real.sqrt P := by
    intro j x hx
    have hx' := (hsuppW j hx).2
    rw [hφψ j x hx']
    exact hψd x (lt_of_lt_of_le (hr0 j) hx')
  have hdistD : ∀ j, ∀ x ∈ (D j).support,
      dist (φ j x) ((fun x : Euclid P => x) x) ≤ Real.sqrt P := by
    intro j x hx
    have hx' := (hsuppD j hx).2
    rw [hφψ j x hx']
    exact hψd x (lt_of_lt_of_le (hr0 j) hx')
  have hdistZ : ∀ j, ∀ x ∈ (Z j).support,
      dist (φ j x) ((fun x : Euclid P => x) x) ≤ Real.sqrt P := by
    intro j x hx
    cases j with
    | zero =>
      rw [hZ0supp] at hx
      exact absurd hx (Set.notMem_empty x)
    | succ i =>
      have hx' : d x = r i := hsuppZs i hx
      rw [hφeq (i + 1) (show (1 / 2 : ℝ) ^ (i + 1) / 32 ≤ d x by rw [hx']; exact hrs' i)]
      exact hψd x (by rw [hx']; exact hr0 i)
  -- Step 7: the deformation and homotopy identities of PF for each shell; by locality the
  -- slice terms `Zⱼ₊₁` are deformed by `φⱼ` and `φⱼ₊₁` alike
  have hZZ : ∀ j, IsCompact (Z (j + 1) - Z j).support ∧ (Z (j + 1) - Z j).mass < ∞ ∧
      boundaryMassOn (Z (j + 1) - Z j) univ < ∞ := fun j =>
    sk_normal_sub m _ _ (hZn (j + 1)).1 (hZn (j + 1)).2.1 (hZn (j + 1)).2.2 (hZn j).1 (hZn j).2.1
      (hZn j).2.2
  have hpushZ : ∀ j, push m (φ j) (Z (j + 1)) = push m (φ (j + 1)) (Z (j + 1)) ∧
      homot m (φ j) (fun x => x) (Z (j + 1)) = homot m (φ (j + 1)) (fun x => x) (Z (j + 1)) :=
    fun j => hloc m (Λ (j + 1)) (φ j) (fun x => x) (φ (j + 1)) (fun x => x) (Z (j + 1)) (hφL' j)
      (hidL (j + 1)) (hφL (j + 1)) (hidL (j + 1)) (hZn (j + 1)).1 (hZn (j + 1)).2.1
      (hZn (j + 1)).2.2 (hEqZ j) (fun x _ => rfl)
  have hlinD : ∀ j, push m (φ j) (O j - O (j + 1)).boundary =
      push m (φ j) (D j) - (push m (φ (j + 1)) (Z (j + 1)) - push m (φ j) (Z j)) ∧
      homot m (φ j) (fun x => x) (O j - O (j + 1)).boundary = homot m (φ j) (fun x => x) (D j) -
        (homot m (φ (j + 1)) (fun x => x) (Z (j + 1)) - homot m (φ j) (fun x => x) (Z j)) := by
    intro j
    have h1 := hlin m (Λ j) (φ j) (fun x => x) (D j) (Z (j + 1) - Z j) (hφL j) (hidL j)
      (hDn j).1 (hDn j).2.1 (hDn j).2.2 (hZZ j).1 (hZZ j).2.1 (hZZ j).2.2
    have h2 := hlin m (Λ j) (φ j) (fun x => x) (Z (j + 1)) (Z j) (hφL j) (hidL j)
      (hZn (j + 1)).1 (hZn (j + 1)).2.1 (hZn (j + 1)).2.2 (hZn j).1 (hZn j).2.1 (hZn j).2.2
    rw [hbdW j, h1.1, h1.2, h2.1, h2.2, (hpushZ j).1, (hpushZ j).2]
    exact ⟨rfl, rfl⟩
  have hbdj := fun j => hbd m (Λ j) (φ j) (fun x => x) (O j - O (j + 1)) (hφL j) (hidL j)
    (hWn j).1 (hWn j).2.1 (hWn j).2.2
  have hhomW : ∀ j, (O j - O (j + 1)) - push (m + 1) (φ j) (O j - O (j + 1)) -
      (homot m (φ j) (fun x => x) (D j) -
        (homot m (φ (j + 1)) (fun x => x) (Z (j + 1)) - homot m (φ j) (fun x => x) (Z j))) =
      (homot (m + 1) (φ j) (fun x => x) (O j - O (j + 1))).boundary := by
    intro j
    have h := (hbdj j).2.1
    rw [hid (m + 1) (O j - O (j + 1)) (hWn j).1 (hWn j).2.1 (hWn j).2.2, (hlinD j).2] at h
    exact h
  have hpushW : ∀ j, (push (m + 1) (φ j) (O j - O (j + 1))).boundary =
      push m (φ j) (D j) - (push m (φ (j + 1)) (Z (j + 1)) - push m (φ j) (Z j)) := fun j => by
    rw [(hbdj j).1, (hlinD j).1]
  have hT1 : ∀ (j : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)),
      (O j - O (j + 1)) ω - push (m + 1) (φ j) (O j - O (j + 1)) ω -
        (homot m (φ j) (fun x => x) (D j) ω -
          (homot m (φ (j + 1)) (fun x => x) (Z (j + 1)) ω - homot m (φ j) (fun x => x) (Z j) ω)) =
        homot (m + 1) (φ j) (fun x => x) (O j - O (j + 1))
          (exteriorDerivativeTestOn univ (m + 1) ω) := fun j ω =>
    congrArg (fun X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => X ω) (hhomW j)
  -- the first slice terms vanish: `H(φ₀, id)Z₀ = 0` and `φ₀#Z₀ = 0`, as `Z₀ = 0`
  have hZ00 : Z 0 - Z 0 = Z 0 := by rw [hZ0]; exact GeometricCurrentOn.ext fun η => sub_self _
  have hlin0 := hlin m (Λ 0) (φ 0) (fun x => x) (Z 0) (Z 0) (hφL 0) (hidL 0) (hZn 0).1
    (hZn 0).2.1 (hZn 0).2.2 (hZn 0).1 (hZn 0).2.1 (hZn 0).2.2
  rw [hZ00] at hlin0
  have hK0 : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      homot m (φ 0) (fun x => x) (Z 0) ω = 0 := fun ω => by
    have h := congrArg (fun X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => X ω) hlin0.2
    exact (sub_eq_self.mp h.symm)
  have hL0 : ∀ η : TestFormOn (univ : Set (Euclid P)) m, push m (φ 0) (Z 0) η = 0 := fun η => by
    have h := congrArg (fun X : GeometricCurrentOn (univ : Set (Euclid P)) m => X η) hlin0.1
    exact (sub_eq_self.mp h.symm)
  -- Step 7, estimates: `Λⱼᵏ, √P(2Λⱼ)ᵏ ≤ (2c₅/sⱼ)ⁿ` (`k ≤ n`), the weights `w₀ = 1`,
  -- `wᵢ₊₁ = C_G(2⁻ⁱ/8)^{n+1}` with `(2c₅/sⱼ)ⁿwⱼ ≤ K2⁻ʲ`, and `M(Wⱼ) ≤ wⱼM(T)`, `M(Dⱼ) ≤ wⱼM(∂T)`
  have hΛpow : ∀ j k : ℕ, k ≤ m + 1 →
      (Λ j : ℝ≥0∞) ^ k ≤ ENNReal.ofReal ((2 * (c₅ / ((1 / 2 : ℝ) ^ j / 32))) ^ (m + 1)) := by
    intro j k hk
    rw [hΛ j]
    show ENNReal.ofReal (c₅ / ((1 / 2 : ℝ) ^ j / 32)) ^ k ≤ _
    rw [← ENNReal.ofReal_pow (hx0 j)]
    exact ENNReal.ofReal_le_ofReal ((pow_le_pow_left₀ (hx0 j) (le_mul_of_one_le_left (hx0 j) one_le_two) k).trans
      (pow_le_pow_right₀ (h2x j) hk))
  have hΛpow2 : ∀ j k : ℕ, k ≤ m + 1 →
      ENNReal.ofReal (Real.sqrt P) * (2 * (Λ j : ℝ≥0∞)) ^ k ≤
        ENNReal.ofReal (Real.sqrt P * (2 * (c₅ / ((1 / 2 : ℝ) ^ j / 32))) ^ (m + 1)) := by
    intro j k hk
    rw [hΛ j, sk_two_mul_pow _ _ (hx0 j), ← ENNReal.ofReal_mul hsqrt]
    exact ENNReal.ofReal_le_ofReal
      (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (h2x j) hk) hsqrt)
  obtain ⟨w, hw0, hws⟩ : ∃ w : ℕ → ℝ, w 0 = 1 ∧
      ∀ i, w (i + 1) = CG * ((1 / 2 : ℝ) ^ i / 8) ^ (m + 2) :=
    ⟨fun j => Nat.casesOn j 1 fun i => CG * ((1 / 2 : ℝ) ^ i / 8) ^ (m + 2), rfl, fun i => rfl⟩
  have hw_nonneg : ∀ j, 0 ≤ w j := by
    intro j
    cases j with
    | zero => rw [hw0]; exact zero_le_one
    | succ i => rw [hws]; exact mul_nonneg hCG0 (pow_nonneg (div_nonneg (he0 i).le h8.le) _)
  have hwK : ∀ j, (2 * (c₅ / ((1 / 2 : ℝ) ^ j / 32))) ^ (m + 1) * w j ≤ K * (1 / 2 : ℝ) ^ j := by
    intro j
    cases j with
    | zero =>
      rw [hw0, hK, pow_zero, mul_one, mul_one,
        show 2 * (c₅ / ((1 : ℝ) / 32)) = 64 * c₅ by ring]
      exact le_mul_of_one_le_right (pow_nonneg (mul_nonneg h64.le hc₅0) _)
        (le_add_of_nonneg_right hCG0)
    | succ i =>
      rw [hws, hK]
      exact sk_weight_succ i c₅ CG hc₅0 hCG0
  have hKe : ∀ j : ℕ, 0 ≤ K * (1 / 2 : ℝ) ^ j := fun j =>
    mul_nonneg (zero_le_one.trans hK1) (he0 j).le
  have hwK1 : ∀ j, (2 * (c₅ / ((1 / 2 : ℝ) ^ j / 32))) ^ (m + 1) * w j ≤
      (1 + Real.sqrt P) * K * (1 / 2 : ℝ) ^ j := fun j => (hwK j).trans (by
    rw [mul_assoc]
    exact le_mul_of_one_le_left (hKe j) (le_add_of_nonneg_right hsqrt))
  have hwK2 : ∀ j, Real.sqrt P * (2 * (c₅ / ((1 / 2 : ℝ) ^ j / 32))) ^ (m + 1) * w j ≤
      (1 + Real.sqrt P) * K * (1 / 2 : ℝ) ^ j := fun j => by
    rw [mul_assoc, mul_assoc]
    exact (mul_le_mul_of_nonneg_left (hwK j) hsqrt).trans
      (mul_le_mul_of_nonneg_right (le_add_of_nonneg_left zero_le_one) (hKe j))
  have hp0 : ∀ j : ℕ, 0 ≤ (2 * (c₅ / ((1 / 2 : ℝ) ^ j / 32))) ^ (m + 1) := fun j =>
    pow_nonneg (mul_nonneg zero_le_two (hx0 j)) _
  have hμr : ∀ i, μ {x | d x < r i} ≤ ENNReal.ofReal (w (i + 1)) * T.mass ∧
      μ' {x | d x < r i} ≤ ENNReal.ofReal (w (i + 1)) * T.boundary.mass := by
    intro i
    have h8' : 0 < (1 / 2 : ℝ) ^ i / 8 := div_pos (he0 i) h8
    have hsub : {x | d x < r i} ⊆ {x | d x < (1 / 2 : ℝ) ^ i / 8} := fun x (hx : d x < r i) =>
      show d x < (1 / 2 : ℝ) ^ i / 8 from lt_trans hx (hr i).2
    have hGC8 := hGCd _ h8' ((div_le_div_of_nonneg_right (he1 i) h8.le).trans hq8)
    rw [hws, ENNReal.ofReal_mul hCG0, ENNReal.ofReal_coe_nnreal]
    exact ⟨(measure_mono hsub).trans hGC8.1, (measure_mono hsub).trans hGC8.2⟩
  have hWw : ∀ j, (O j - O (j + 1)).mass ≤ ENNReal.ofReal (w j) * T.mass := by
    intro j
    cases j with
    | zero =>
      rw [hw0, ENNReal.ofReal_one, one_mul, ← hμuniv]
      exact (hWmass 0).trans (measure_mono (subset_univ _))
    | succ i =>
      exact (hWmass (i + 1)).trans ((measure_mono (by rw [← hUs i]; exact sdiff_subset)).trans
        (hμr i).1)
  have hDw : ∀ j, (D j).mass ≤ ENNReal.ofReal (w j) * T.boundary.mass := by
    intro j
    cases j with
    | zero =>
      rw [hw0, ENNReal.ofReal_one, one_mul, ← hμ'univ]
      exact (hDmass 0).trans (measure_mono (subset_univ _))
    | succ i =>
      exact (hDmass (i + 1)).trans ((measure_mono (by rw [← hUs i]; exact sdiff_subset)).trans
        (hμr i).2)
  -- the deformed pieces: `M ≤ (1 + √P)K2⁻ʲM(T)` resp. `M(∂T)` (PF mass bounds)
  have hmassW := fun j => hmass (m + 1) (Λ j) (φ j) (fun x => x) (O j - O (j + 1)) (hφL j)
    (hidL j) (hWn j).1 (hWn j).2.1 (hWn j).2.2
  have hmassD := fun j => hmass m (Λ j) (φ j) (fun x => x) (D j) (hφL j) (hidL j) (hDn j).1
    (hDn j).2.1 (hDn j).2.2
  have hVb : ∀ j, (push (m + 1) (φ j) (O j - O (j + 1))).mass ≤
      ENNReal.ofReal ((1 + Real.sqrt P) * K * (1 / 2 : ℝ) ^ j) * T.mass := fun j =>
    (hmassW j).1.trans (sk_mul_le _ _ _ _ _ _ (hp0 j) (hw_nonneg j) (hΛpow j (m + 1) le_rfl)
      (hWw j) (hwK1 j))
  have hHb : ∀ j, (homot (m + 1) (φ j) (fun x => x) (O j - O (j + 1))).mass ≤
      ENNReal.ofReal ((1 + Real.sqrt P) * K * (1 / 2 : ℝ) ^ j) * T.mass := fun j =>
    ((hmassW j).2.2.1 (Real.sqrt P) (hdistW j)).trans (sk_mul_le _ _ _ _ _ _
      (mul_nonneg hsqrt (hp0 j)) (hw_nonneg j) (hΛpow2 j (m + 1) le_rfl) (hWw j) (hwK2 j))
  have hYb : ∀ j, (push m (φ j) (D j)).mass ≤
      ENNReal.ofReal ((1 + Real.sqrt P) * K * (1 / 2 : ℝ) ^ j) * T.boundary.mass := fun j =>
    (hmassD j).1.trans (sk_mul_le _ _ _ _ _ _ (hp0 j) (hw_nonneg j)
      (hΛpow j m (Nat.le_succ m)) (hDw j) (hwK1 j))
  have hEb : ∀ j, (homot m (φ j) (fun x => x) (D j)).mass ≤
      ENNReal.ofReal ((1 + Real.sqrt P) * K * (1 / 2 : ℝ) ^ j) * T.boundary.mass := fun j =>
    ((hmassD j).2.2.1 (Real.sqrt P) (hdistD j)).trans (sk_mul_le _ _ _ _ _ _
      (mul_nonneg hsqrt (hp0 j)) (hw_nonneg j) (hΛpow2 j m (Nat.le_succ m)) (hDw j) (hwK2 j))
  have hVsum : ∑' j, (push (m + 1) (φ j) (O j - O (j + 1))).mass ≤
      ENNReal.ofReal (2 * ((1 + Real.sqrt P) * K)) * T.mass := by
    rw [← sk_tsum_geometric _ _ hc0]
    exact ENNReal.tsum_le_tsum hVb
  have hHsum : ∑' j, (homot (m + 1) (φ j) (fun x => x) (O j - O (j + 1))).mass ≤
      ENNReal.ofReal (2 * ((1 + Real.sqrt P) * K)) * T.mass := by
    rw [← sk_tsum_geometric _ _ hc0]
    exact ENNReal.tsum_le_tsum hHb
  have hYsum : ∑' j, (push m (φ j) (D j)).mass ≤
      ENNReal.ofReal (2 * ((1 + Real.sqrt P) * K)) * T.boundary.mass := by
    rw [← sk_tsum_geometric _ _ hc0]
    exact ENNReal.tsum_le_tsum hYb
  have hEsum : ∑' j, (homot m (φ j) (fun x => x) (D j)).mass ≤
      ENNReal.ofReal (2 * ((1 + Real.sqrt P) * K)) * T.boundary.mass := by
    rw [← sk_tsum_geometric _ _ hc0]
    exact ENNReal.tsum_le_tsum hEb
  -- the remainders tend to `0`: `M(Oₙ) → 0`, `M(H(φₙ, id)Zₙ) → 0`, `M(φₙ#Zₙ) → 0`
  have hOlim : Tendsto (fun N => (O N).mass) atTop (𝓝 0) := by
    refine (tendsto_add_atTop_iff_nat 1).mp (sk_tendsto_zero _ (CG * T.mass) hfinT fun i => ?_)
    refine (hOm i).trans ((hμr i).1.trans ?_)
    calc ENNReal.ofReal (w (i + 1)) * T.mass ≤ ENNReal.ofReal (CG * (1 / 2 : ℝ) ^ i) * T.mass := by
          rw [hws]
          refine mul_le_mul' (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left ?_ hCG0)) le_rfl
          exact (pow_le_of_le_one (div_nonneg (he0 i).le h8.le)
            ((div_le_self (he0 i).le h1le8).trans (he1 i)) (Nat.succ_ne_zero _)).trans
            (div_le_self (he0 i).le h1le8)
      _ = CG * T.mass * ENNReal.ofReal ((1 / 2 : ℝ) ^ i) := by
          rw [ENNReal.ofReal_mul hCG0, ENNReal.ofReal_coe_nnreal, mul_right_comm]
  obtain ⟨CZ, hCZ⟩ : ∃ CZ : ℝ≥0∞, CZ =
      ENNReal.ofReal ((1 + Real.sqrt P) * (8 * (32 * c₅) ^ m)) * (CG * T.mass + 1) := ⟨_, rfl⟩
  have hCZtop : CZ ≠ ∞ := by
    rw [hCZ]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (ENNReal.add_ne_top.mpr ⟨hfinT, ENNReal.one_ne_top⟩)
  have hZlam : ∀ i, ENNReal.ofReal ((1 + Real.sqrt P) *
      (2 * (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32))) ^ m) * lam i =
      CZ * ENNReal.ofReal ((1 / 2 : ℝ) ^ i) := by
    intro i
    have hq : 0 ≤ (1 + Real.sqrt P) * (2 * (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32))) ^ m :=
      mul_nonneg h1P (pow_nonneg (mul_nonneg zero_le_two (hx0 (i + 1))) _)
    have hc8 : 0 ≤ (1 + Real.sqrt P) * (8 * (32 * c₅) ^ m) :=
      mul_nonneg h1P (mul_nonneg h8.le (pow_nonneg (mul_nonneg h32.le hc₅0) _))
    have hreal : (1 + Real.sqrt P) * (2 * (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32))) ^ m *
        (32 * ((1 / 2 : ℝ) ^ i / 4) ^ (m + 1)) =
        (1 + Real.sqrt P) * (8 * (32 * c₅) ^ m) * (1 / 2 : ℝ) ^ i := by
      rw [mul_assoc, sk_weight_slice, ← mul_assoc]
    calc ENNReal.ofReal ((1 + Real.sqrt P) * (2 * (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32))) ^ m) *
          lam i = ENNReal.ofReal ((1 + Real.sqrt P) *
            (2 * (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32))) ^ m) *
          ENNReal.ofReal (32 * ((1 / 2 : ℝ) ^ i / 4) ^ (m + 1)) * (CG * T.mass + 1) := by
          rw [hlamdef, mul_assoc]
      _ = ENNReal.ofReal ((1 + Real.sqrt P) * (8 * (32 * c₅) ^ m) * (1 / 2 : ℝ) ^ i) *
          (CG * T.mass + 1) := by rw [← ENNReal.ofReal_mul hq, hreal]
      _ = CZ * ENNReal.ofReal ((1 / 2 : ℝ) ^ i) := by
          rw [ENNReal.ofReal_mul hc8, hCZ, mul_right_comm]
  have hΛz1 : ∀ i, ENNReal.ofReal (Real.sqrt P) * (2 * (Λ (i + 1) : ℝ≥0∞)) ^ m ≤
      ENNReal.ofReal ((1 + Real.sqrt P) * (2 * (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32))) ^ m) := by
    intro i
    rw [hΛ (i + 1), sk_two_mul_pow _ _ (hx0 (i + 1)), ← ENNReal.ofReal_mul hsqrt]
    exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right
      (le_add_of_nonneg_left zero_le_one) (pow_nonneg (mul_nonneg zero_le_two (hx0 (i + 1))) _))
  have hΛz2 : ∀ i, (Λ (i + 1) : ℝ≥0∞) ^ m ≤
      ENNReal.ofReal ((1 + Real.sqrt P) * (2 * (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32))) ^ m) := by
    intro i
    rw [hΛ (i + 1)]
    show ENNReal.ofReal (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32)) ^ m ≤ _
    rw [← ENNReal.ofReal_pow (hx0 (i + 1))]
    exact ENNReal.ofReal_le_ofReal ((pow_le_pow_left₀ (hx0 (i + 1))
      (le_mul_of_one_le_left (hx0 (i + 1)) one_le_two) m).trans (le_mul_of_one_le_left
        (pow_nonneg (mul_nonneg zero_le_two (hx0 (i + 1))) _) (le_add_of_nonneg_right hsqrt)))
  have hmassZ := fun i => hmass m (Λ (i + 1)) (φ (i + 1)) (fun x => x) (Z (i + 1)) (hφL (i + 1))
    (hidL (i + 1)) (hZn (i + 1)).1 (hZn (i + 1)).2.1 (hZn (i + 1)).2.2
  have hKlim : Tendsto (fun N => (homot m (φ N) (fun x => x) (Z N)).mass) atTop (𝓝 0) :=
    (tendsto_add_atTop_iff_nat 1).mp (sk_tendsto_zero _ CZ hCZtop fun i =>
      ((hmassZ i).2.2.1 _ (hdistZ (i + 1))).trans ((mul_le_mul' (hΛz1 i) (hZm i).le).trans
        (hZlam i).le))
  have hLlim : Tendsto (fun N => (push m (φ N) (Z N)).mass) atTop (𝓝 0) :=
    (tendsto_add_atTop_iff_nat 1).mp (sk_tendsto_zero _ CZ hCZtop fun i =>
      (hmassZ i).1.trans ((mul_le_mul' (hΛz2 i) (hZm i).le).trans (hZlam i).le))
  -- Step 8: the series `Q₀ = Σ φⱼ#Wⱼ`, `R₁ = Σ H(φⱼ, id)Wⱼ`, `S₁ = Σ H(φⱼ, id)Dⱼ` (IMS)
  have hctop : ENNReal.ofReal (2 * ((1 + Real.sqrt P) * K)) * T.mass < ∞ :=
    ENNReal.mul_lt_top ENNReal.ofReal_lt_top hTm
  have hctop' : ENNReal.ofReal (2 * ((1 + Real.sqrt P) * K)) * T.boundary.mass < ∞ :=
    ENNReal.mul_lt_top ENNReal.ofReal_lt_top hTbm
  obtain ⟨Q₀, hQsum, hQm, hQs, hQIM⟩ := Submission.cmcdt_im_series hVO hMR hIMC P m
    (fun j => push (m + 1) (φ j) (O j - O (j + 1))) (lt_of_le_of_lt hVsum hctop)
  obtain ⟨R₁, hRsum, hRm, hRs, hRIM⟩ := Submission.cmcdt_im_series hVO hMR hIMC P (m + 1)
    (fun j => homot (m + 1) (φ j) (fun x => x) (O j - O (j + 1))) (lt_of_le_of_lt hHsum hctop)
  obtain ⟨S₁, hSsum, hSm, hSs, -⟩ := Submission.cmcdt_im_series hVO hMR hIMC P m
    (fun j => homot m (φ j) (fun x => x) (D j)) (lt_of_le_of_lt hEsum hctop')
  -- Step 9: supports
  have hsuppV : ∀ j, (push (m + 1) (φ j) (O j - O (j + 1))).support ⊆
      {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩
        cthickening (Real.sqrt P) T.support := by
    intro j y hy
    obtain ⟨x, hx, rfl⟩ := (hmassW j).2.1 hy
    have hx' := hsuppW j hx
    have hd0 : 0 < d x := lt_of_lt_of_le (hr0 j) hx'.2
    rw [hφψ j x hx'.2]
    exact ⟨(hψ1 x hd0).1, mem_cthickening_of_dist_le _ x _ _ hx'.1 (hψ1 x hd0).2⟩
  have hsuppH : ∀ j, (homot (m + 1) (φ j) (fun x => x) (O j - O (j + 1))).support ⊆
      cthickening (Real.sqrt P) T.support := by
    intro j y hy
    obtain ⟨x, hx, t, ht, rfl⟩ := (hmassW j).2.2.2 hy
    exact mem_cthickening_of_dist_le _ x _ _ (hsuppW j hx).1
      (sk_segment_dist _ x t _ ht (hdistW j x hx))
  have hsuppE : ∀ j, (homot m (φ j) (fun x => x) (D j)).support ⊆
      cthickening (Real.sqrt P) T.boundary.support := by
    intro j y hy
    obtain ⟨x, hx, t, ht, rfl⟩ := (hmassD j).2.2.2 hy
    exact mem_cthickening_of_dist_le _ x _ _ (hsuppD j hx).1
      (sk_segment_dist _ x t _ ht (hdistD j x hx))
  have hsuppY : ∀ j, (push m (φ j) (D j)).support ⊆
      cthickening (Real.sqrt P) T.boundary.support := by
    intro j y hy
    obtain ⟨x, hx, rfl⟩ := (hmassD j).2.1 hy
    exact mem_cthickening_of_dist_le _ x _ _ (hsuppD j hx).1 (hdistD j x hx)
  have hsuppQ := hQs.trans (closure_minimal (iUnion_subset hsuppV)
    (sk_isClosed_skeleton.inter isClosed_cthickening))
  have hsuppR := hRs.trans (closure_minimal (iUnion_subset hsuppH) isClosed_cthickening)
  have hsuppS := hSs.trans (closure_minimal (iUnion_subset hsuppE) isClosed_cthickening)
  -- Step 8, boundary (24)–(25): `Σ_{j<N} φⱼ#Dⱼ(η) → ∂Q₀(η)`
  have hT2 : ∀ η : TestFormOn (univ : Set (Euclid P)) m,
      Tendsto (fun N => ∑ j ∈ Finset.range N, push m (φ j) (D j) η) atTop
        (𝓝 (Q₀.boundary η)) := fun η =>
    sk_telescope_boundary Q₀ (fun j => push (m + 1) (φ j) (O j - O (j + 1)))
      (fun j => push m (φ j) (D j)) (fun j => push m (φ j) (Z j)) η
      (fun j => congrArg (fun X : GeometricCurrentOn (univ : Set (Euclid P)) m => X η) (hpushW j))
      (hL0 η) (sk_tendsto_of_mass m _ η hLlim) (hQsum _)
  have hbQ : Q₀.boundary.mass ≤ ENNReal.ofReal (2 * ((1 + Real.sqrt P) * K)) * T.boundary.mass := by
    refine le_trans (sSup_le ?_) hYsum
    rintro _ ⟨η, hη, rfl⟩
    refine le_of_tendsto' (ENNReal.tendsto_ofReal (hT2 η)) fun N => ?_
    refine (Finset.le_sum_of_subadditive ENNReal.ofReal ENNReal.ofReal_zero.le
      (fun x y => ENNReal.ofReal_add_le) _ _).trans
      ((Finset.sum_le_sum fun j _ => ?_).trans (ENNReal.sum_le_tsum _))
    refine (ENNReal.ofReal_le_ofReal (le_abs_self _)).trans ?_
    have h := sk_abs_le_mass m (push m (φ j) (D j)) η 1 one_pos hη.2
    rwa [ENNReal.ofReal_one, one_mul] at h
  have hsuppbQ : Q₀.boundary.support ⊆ cthickening (Real.sqrt P) T.boundary.support := by
    refine sk_support_subset m _ _ isClosed_cthickening fun η hη => ?_
    have h := hT2 η
    simp only [fun j => hVO P m univ _ η (hη.mono_right (hsuppY j)), Finset.sum_const_zero] at h
    exact tendsto_nhds_unique h tendsto_const_nhds
  -- Step 10: conclusion; the identity (21) `T − Q₀ − S₁ = ∂R₁` by telescoping
  refine ⟨Q₀, R₁, S₁, hQIM fun i => ((hbdj i).2.2 (hIMW i)).1,
    hRIM fun i => ((hbdj i).2.2 (hIMW i)).2,
    sk_telescope T Q₀ S₁ R₁ O (fun j => push (m + 1) (φ j) (O j - O (j + 1)))
      (fun j => homot m (φ j) (fun x => x) (D j)) (fun j => homot m (φ j) (fun x => x) (Z j))
      (fun j => homot (m + 1) (φ j) (fun x => x) (O j - O (j + 1))) hO0 hT1 hK0
      (fun ω => sk_tendsto_of_mass (m + 1) O ω hOlim)
      (fun ω => sk_tendsto_of_mass (m + 1) _ ω hKlim) hQsum hSsum hRsum,
    fun x hx => (hsuppQ hx).1, hQm.trans hVsum, hbQ, hRm.trans hHsum, hSm.trans hEsum,
    union_subset (fun x hx => (hsuppQ hx).2) hsuppR, union_subset hsuppbQ hsuppS⟩
/-- **Finite nets from the scaled deformation theorem** (Simon Ch. 6, 5.1–5.4 and the proof of
7.2, (1)–(3)).  Let `n = m + 1`, `c_s` the constant of the unit-scale deformation onto the
`n`-skeleton (`dtc_bc_lc_fd_dfm_skeleton_deformation`), `c_f` that of the face replacement
(`dtc_bc_lc_fd_dfm_face_replacement`) and `c = c_s(1 + c_f)`.  Given `K`, `Λ` and `ε`, pick
`η ∈ (0, ε]` and a scale `ρ > 0` with `ρ√P ≤ 1` and `2cΛρ ≤ η`, and conjugate by the dilations
`δ_ρ` of `cmcdt_dilation_pushforward`.  For `A` as in the statement, `T = δ_{ρ⁻¹#}A` is integer
multiplicity with compact support `ρ⁻¹ spt A`, `M(T) = ρ⁻ⁿM(A)` and `M(∂T) = ρ¹⁻ⁿM(∂A)`.  The
skeleton deformation gives `T − Q₀ − S₁ = ∂R₁`, and the face replacement, applied with the compact
set `cthickening(√P, ρ⁻¹K) ⊇ spt Q₀` and the bound `c_sρ⁻ⁿΛ ≥ M(Q₀)`, gives `P_c` in a finite
family `𝒬₀` fixed in advance with `M(Q₀ − P_c) ≤ c_f M(∂Q₀)` and `M(∂P_c) ≤ c_f M(∂Q₀)`.  Then
`Q = δ_{ρ#}P_c ∈ δ_{ρ#}𝒬₀`, `R = δ_{ρ#}R₁` and `S = δ_{ρ#}(S₁ + Q₀ − P_c)` satisfy
`A − Q − S = ∂R`, `M(R) ≤ c_sρM(A)`, `M(S) ≤ cρM(∂A)`, `M(∂Q) ≤ c_f c_s M(∂A)` and
`spt R ⊆ cthickening(ρ√P, spt A) ⊆ cthickening(1, K)`.  The antecedent `M_W(T) = μ_T(W)` of the
two children is `dtc_mass_eq_measure` applied to `W ∩ U`. -/
theorem Submission.dtc_bc_lc_fd_deformation : ∀ (P m : ℕ), m + 1 < P → ∃ c : NNReal, ∀ (K : Set (Euclid P)) (Λ : NNReal) (ε : ℝ≥0∞), IsCompact K → 0 < ε → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ A : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity A → A.support ⊆ K → A.mass ≤ Λ → A.boundary.mass ≤ Λ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧ IsIntegerMultiplicity Q.boundary ∧ A - Q - S = R.boundary ∧ R.mass + S.mass ≤ ε ∧ Q.boundary.mass ≤ c * A.boundary.mass ∧ R.support ⊆ cthickening 1 K := by
  intro P m _
  -- `M_W(T) = μ_T(W)` for open `W`: `dtc_mass_eq_measure` gives it for `W ∩ U`, and neither side
  -- changes when `W` is replaced by `W ∩ U` (test forms in `U` and `θHⁿ⌞M` live in `U`)
  have hMR : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n),
      IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W →
        T.massOn W = R.measure W := by
    intro P n U T R hU hR W hW
    have h₁ : T.massOn W = T.massOn (W ∩ U) :=
      le_antisymm (sSup_le_sSup (image_mono fun ω hω => ⟨subset_inter hω.1 ω.2.2, hω.2⟩))
        (T.massOn_mono inter_subset_left)
    have h₂ : R.measure (W \ U) = 0 := by
      refine withDensity_absolutelyContinuous _ _ ?_
      rw [Measure.restrict_apply' R.measurableSet_carrier]
      exact measure_mono_null (fun x hx => (hx.1.2 (R.carrier_subset hx.2)).elim) measure_empty
    rw [h₁, ← measure_inter_add_sdiff W hU.measurableSet, h₂, add_zero]
    exact Submission.dtc_mass_eq_measure P n U (W ∩ U) T R hU (hW.inter hU) inter_subset_right hR
  -- the unit-scale deformation onto the `n`-skeleton, the face replacement and the dilations
  obtain ⟨cs, -, hskel⟩ := Submission.dtc_bc_lc_fd_dfm_skeleton_deformation
    Submission.dtc_vanish_off_support hMR Submission.dtc_bc_lc_fd_dfm_mass_representation_core
    Submission.cmc_imRep_locality_restrict_sub Submission.cmc_slice_mass_bounds P m
  obtain ⟨cf, -, hface⟩ := Submission.dtc_bc_lc_fd_dfm_face_replacement
    Submission.dtc_vanish_off_support hMR Submission.cmc_imRep_locality_restrict_sub P m
  obtain ⟨dil, hdil⟩ := Submission.cmcdt_dilation_pushforward P
  -- `c = c_s(1 + c_f)`, so `c_s ≤ c` and `c_s + c_f c_s = c`
  obtain ⟨c, hcs, hcfs⟩ : ∃ c : NNReal, (cs : ℝ≥0∞) ≤ c ∧ (cs : ℝ≥0∞) + cf * cs = c :=
    ⟨cs * (1 + cf), by exact_mod_cast le_mul_of_one_le_right zero_le le_self_add,
      by push_cast; ring⟩
  refine ⟨c, fun K Λ ε hK hε => ?_⟩
  -- a real `η ∈ (0, ε]` and a scale `ρ > 0` with `ρ√P ≤ 1` and `2cΛρ ≤ η`
  obtain ⟨η, hη, hηε⟩ : ∃ η : ℝ, 0 < η ∧ ENNReal.ofReal η ≤ ε := by
    obtain ⟨r, -, hr, hrε⟩ := ENNReal.lt_iff_exists_real_btwn.1 hε
    exact ⟨r, ENNReal.ofReal_pos.1 hr, hrε.le⟩
  obtain ⟨ρ, hρ, hρP, hρη⟩ :
      ∃ ρ : ℝ, 0 < ρ ∧ ρ * Real.sqrt P ≤ 1 ∧ ρ * (2 * c * Λ) ≤ η := by
    refine ⟨min (1 / (Real.sqrt P + 1)) (η / (2 * c * Λ + 1)),
      lt_min (by positivity) (by positivity), ?_, ?_⟩
    · calc min (1 / (Real.sqrt P + 1)) (η / (2 * c * Λ + 1)) * Real.sqrt P
          ≤ 1 / (Real.sqrt P + 1) * Real.sqrt P :=
            mul_le_mul_of_nonneg_right (min_le_left _ _) (Real.sqrt_nonneg _)
        _ ≤ 1 := by
            rw [div_mul_eq_mul_div, one_mul, div_le_one (by positivity)]
            linarith
    · calc min (1 / (Real.sqrt P + 1)) (η / (2 * c * Λ + 1)) * (2 * c * Λ)
          ≤ η / (2 * c * Λ + 1) * (2 * c * Λ) :=
            mul_le_mul_of_nonneg_right (min_le_right _ _) (by positivity)
        _ ≤ η := by
            rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
            exact mul_le_mul_of_nonneg_left (by linarith) hη.le
  have hpow : ∀ j : ℕ, ρ ^ (j + 1) * ρ⁻¹ ^ j = ρ := fun j => by
    rw [inv_pow, ← div_eq_mul_inv, div_eq_iff (pow_ne_zero _ hρ.ne')]
    ring
  -- `δ_{ρ⁻¹#}` and `δ_{ρ#}` in the degrees used below
  have hρi : 0 < ρ⁻¹ := inv_pos.2 hρ
  obtain ⟨-, hinv, hmT, hsT, hiT, -⟩ := hdil (m + 1) ρ⁻¹ hρi
  obtain ⟨-, -, hmT', -, -, hbT⟩ := hdil m ρ⁻¹ hρi
  obtain ⟨hlin, -, hm1, -, -, hb1⟩ := hdil (m + 1) ρ hρ
  obtain ⟨-, -, hm0, -, hi0, hb0⟩ := hdil m ρ hρ
  obtain ⟨-, -, hm2, hs2, hi2, -⟩ := hdil (m + 2) ρ hρ
  -- the finite family: `δ_{ρ#}𝒬₀`, with `𝒬₀` the face family for the compact set
  -- `cthickening(√P, ρ⁻¹K)` and the mass bound `c_sρ⁻ⁿΛ`
  obtain ⟨𝒬₀, h𝒬₀, hface'⟩ := hface (cthickening (Real.sqrt P) ((fun x => ρ⁻¹ • x) '' K))
    (cs * (ρ⁻¹ ^ (m + 1)).toNNReal * Λ) (hK.image (continuous_const_smul ρ⁻¹)).cthickening
  refine ⟨dil (m + 1) ρ '' 𝒬₀, h𝒬₀.image _, fun A hA hAK hAM hAbM => ?_⟩
  -- `T = δ_{ρ⁻¹#}A`: `δ_{ρ#}T = A`, `spt T = ρ⁻¹ spt A`, `M(T) = ρ⁻ⁿM(A)`, `M(∂T) = ρ¹⁻ⁿM(∂A)`
  obtain ⟨T, hAT, hTi, hTs, hTM, hTbM⟩ : ∃ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
      dil (m + 1) ρ T = A ∧ IsIntegerMultiplicity T ∧
        T.support = (fun x => ρ⁻¹ • x) '' A.support ∧
        T.mass = ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * A.mass ∧
        T.boundary.mass = ENNReal.ofReal (ρ⁻¹ ^ m) * A.boundary.mass :=
    ⟨dil (m + 1) ρ⁻¹ A, by simpa only [inv_inv] using hinv A, hiT A hA, hsT A, hmT A,
      by rw [hbT A]; exact hmT' _⟩
  have hTc : IsCompact T.support := by
    rw [hTs]
    exact (hK.of_isClosed_subset (isClosed_univ.sdiff A.isOpen_zeroRegion) hAK).image
      (continuous_const_smul ρ⁻¹)
  have hTMf : T.mass < ∞ := by
    rw [hTM]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hAM.trans_lt ENNReal.coe_lt_top)
  have hTbMf : T.boundary.mass < ∞ := by
    rw [hTbM]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hAbM.trans_lt ENNReal.coe_lt_top)
  -- the unit-scale deformation `T − Q₀ − S₁ = ∂R₁`
  obtain ⟨Q₀, R₁, S₁, hQ₀, hR₁, hTQRS, hQ₀sk, hQ₀M, hQ₀bM, hR₁M, hS₁M, hspt, -⟩ :=
    hskel T hTi hTc hTMf hTbMf
  -- the face replacement `P_c ∈ 𝒬₀` of `Q₀`
  have hQ₀K : Q₀.support ⊆ cthickening (Real.sqrt P) ((fun x => ρ⁻¹ • x) '' K) := by
    refine subset_union_left.trans (hspt.trans (cthickening_subset_of_subset _ ?_))
    rw [hTs]
    exact image_mono hAK
  have hQ₀Λ : Q₀.mass ≤ ((cs * (ρ⁻¹ ^ (m + 1)).toNNReal * Λ : NNReal) : ℝ≥0∞) := by
    calc Q₀.mass ≤ cs * T.mass := hQ₀M
      _ ≤ cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * Λ) := by
          rw [hTM]
          gcongr
      _ = ((cs * (ρ⁻¹ ^ (m + 1)).toNNReal * Λ : NNReal) : ℝ≥0∞) := by
          rw [ENNReal.coe_mul, ENNReal.coe_mul, mul_assoc]
          rfl
  obtain ⟨Pc, hPc, -, hPcb, -, -, hPcbM, hDM, -, -⟩ := hface' Q₀ hQ₀ hQ₀K hQ₀sk hQ₀Λ
    (hQ₀bM.trans_lt (ENNReal.mul_lt_top ENNReal.coe_lt_top hTbMf))
  -- `M(Z) ≤ M(X) + M(Y)` whenever `Z = X + Y` (mass is a supremum of evaluations)
  have hmass_add : ∀ (X Y Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)),
      (∀ ω, Z ω = X ω + Y ω) → Z.mass ≤ X.mass + Y.mass := by
    intro X Y Z hZ
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (Z ω) ≤ _
    rw [hZ]
    exact ENNReal.ofReal_add_le.trans (add_le_add (X.le_massOn hω) (Y.le_massOn hω))
  have hsub : ∀ (X Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), (X - Y) ω = X ω - Y ω :=
    fun _ _ _ => rfl
  -- `Q = δ_{ρ#}P_c`, `R = δ_{ρ#}R₁` and `S = δ_{ρ#}(S₁ + Q₀ − P_c)`
  refine ⟨dil (m + 1) ρ Pc, ⟨Pc, hPc, rfl⟩, dil (m + 2) ρ R₁, dil (m + 1) ρ (S₁ - (Pc - Q₀)),
    hi2 R₁ hR₁, by rw [hb0]; exact hi0 _ hPcb, ?_, ?_, ?_, ?_⟩
  -- `A − Q − S = δ_{ρ#}(T − P_c − (S₁ + Q₀ − P_c)) = δ_{ρ#}(T − Q₀ − S₁) = δ_{ρ#}∂R₁ = ∂R`
  · have hRb : (dil (m + 2) ρ R₁).boundary = dil (m + 1) ρ R₁.boundary := hb1 R₁
    rw [← hAT, ← hlin, ← hlin, hRb, ← hTQRS]
    congr 1
    ext ω
    simp only [hsub]
    ring
  -- `M(R) + M(S) ≤ cρΛ + cρΛ ≤ η ≤ ε`
  · have hR : (dil (m + 2) ρ R₁).mass ≤ ENNReal.ofReal ρ * (c * Λ) := by
      have hpow₂ : ρ ^ (m + 2) * ρ⁻¹ ^ (m + 1) = ρ := hpow (m + 1)
      calc (dil (m + 2) ρ R₁).mass = ENNReal.ofReal (ρ ^ (m + 2)) * R₁.mass := hm2 R₁
        _ ≤ ENNReal.ofReal (ρ ^ (m + 2)) * (cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * Λ)) := by
            gcongr
            calc R₁.mass ≤ cs * T.mass := hR₁M
              _ ≤ cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * Λ) := by
                  rw [hTM]
                  gcongr
        _ = ENNReal.ofReal (ρ ^ (m + 2) * ρ⁻¹ ^ (m + 1)) * (cs * Λ) := by
            rw [ENNReal.ofReal_mul (pow_nonneg hρ.le _)]
            ring
        _ ≤ ENNReal.ofReal ρ * (c * Λ) := by
            rw [hpow₂]
            gcongr
    have hS : (dil (m + 1) ρ (S₁ - (Pc - Q₀))).mass ≤ ENNReal.ofReal ρ * (c * Λ) := by
      have hS' : (S₁ - (Pc - Q₀)).mass ≤ c * T.boundary.mass := by
        calc (S₁ - (Pc - Q₀)).mass ≤ S₁.mass + (Q₀ - Pc).mass :=
              hmass_add _ _ _ fun ω => by simp only [hsub]; ring
          _ ≤ cs * T.boundary.mass + cf * (cs * T.boundary.mass) := by
              gcongr
              exact hDM.trans (by gcongr)
          _ = c * T.boundary.mass := by
              rw [← hcfs]
              ring
      calc (dil (m + 1) ρ (S₁ - (Pc - Q₀))).mass
          = ENNReal.ofReal (ρ ^ (m + 1)) * (S₁ - (Pc - Q₀)).mass := hm1 _
        _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) * (c * (ENNReal.ofReal (ρ⁻¹ ^ m) * Λ)) := by
            gcongr
            calc (S₁ - (Pc - Q₀)).mass ≤ c * T.boundary.mass := hS'
              _ ≤ c * (ENNReal.ofReal (ρ⁻¹ ^ m) * Λ) := by
                  rw [hTbM]
                  gcongr
        _ = ENNReal.ofReal (ρ ^ (m + 1) * ρ⁻¹ ^ m) * (c * Λ) := by
            rw [ENNReal.ofReal_mul (pow_nonneg hρ.le _)]
            ring
        _ = ENNReal.ofReal ρ * (c * Λ) := by rw [hpow]
    have h2cΛ : ENNReal.ofReal (2 * c * Λ) = 2 * c * Λ := by
      rw [show (2 * c * Λ : ℝ) = ((2 * c * Λ : NNReal) : ℝ) by push_cast; ring,
        ENNReal.ofReal_coe_nnreal]
      push_cast
      ring
    calc (dil (m + 2) ρ R₁).mass + (dil (m + 1) ρ (S₁ - (Pc - Q₀))).mass
        ≤ ENNReal.ofReal ρ * (c * Λ) + ENNReal.ofReal ρ * (c * Λ) := add_le_add hR hS
      _ = ENNReal.ofReal (ρ * (2 * c * Λ)) := by
          rw [ENNReal.ofReal_mul hρ.le, h2cΛ]
          ring
      _ ≤ ENNReal.ofReal η := ENNReal.ofReal_le_ofReal hρη
      _ ≤ ε := hηε
  -- `M(∂Q) = ρᵐM(∂P_c) ≤ ρᵐc_f c_s M(∂T) = c_f c_s M(∂A) ≤ c M(∂A)`
  · rw [hb0, hm0]
    calc ENNReal.ofReal (ρ ^ m) * Pc.boundary.mass
        ≤ ENNReal.ofReal (ρ ^ m) * (cf * (cs * (ENNReal.ofReal (ρ⁻¹ ^ m) * A.boundary.mass))) := by
          gcongr
          calc Pc.boundary.mass ≤ cf * Q₀.boundary.mass := hPcbM
            _ ≤ cf * (cs * (ENNReal.ofReal (ρ⁻¹ ^ m) * A.boundary.mass)) := by
                rw [← hTbM]
                gcongr
      _ = ENNReal.ofReal (ρ ^ m * ρ⁻¹ ^ m) * (cf * cs) * A.boundary.mass := by
          rw [ENNReal.ofReal_mul (pow_nonneg hρ.le _)]
          ring
      _ ≤ c * A.boundary.mass := by
          rw [← mul_pow, mul_inv_cancel₀ hρ.ne', one_pow, ENNReal.ofReal_one, one_mul, ← hcfs]
          gcongr
          exact le_add_self
  -- `spt R = ρ spt R₁ ⊆ ρ cthickening(√P, ρ⁻¹ spt A) ⊆ cthickening(ρ√P, K) ⊆ cthickening(1, K)`
  · rw [hs2]
    rintro _ ⟨x, hx, rfl⟩
    have hx' := hspt (mem_union_right _ hx)
    rw [hTc.cthickening_eq_biUnion_closedBall (Real.sqrt_nonneg _), hTs] at hx'
    obtain ⟨_, ⟨a, ha, rfl⟩, hxa⟩ := mem_iUnion₂.1 hx'
    refine mem_cthickening_of_dist_le _ a 1 K (hAK ha) ?_
    calc dist (ρ • x) a = dist (ρ • x) (ρ • ρ⁻¹ • a) := by rw [smul_inv_smul₀ hρ.ne']
      _ = ρ * dist x (ρ⁻¹ • a) := by rw [dist_smul₀, Real.norm_of_nonneg hρ.le]
      _ ≤ ρ * Real.sqrt P := mul_le_mul_of_nonneg_left (mem_closedBall.1 hxa) hρ.le
      _ ≤ 1 := hρP
/-- **Cauchy subsequence for the flat decomposition** (Simon Ch. 6, proof of 7.2,
chapter-06.txt lines 2101–2118: "apply (1) with `ε = 1, 1/2, 1/4` etc. to extract a subsequence
`{T_{j_r}}` … `T_{j_{r+1}} − T_{j_r} = ∂R_r + S_r` … `M(R_r) + M(S_r) ≤ 1/2^r`"; the errors `S`
need not be integer multiplicity).  If for every `ε > 0` a finite `𝒬` gives decompositions
`X_j − Q − S = ∂R` with `Q ∈ 𝒬`, `R` integer multiplicity, `spt R ⊆ L` and `M(R) + M(S) ≤ ε`,
then some subsequence has `X_{φ(r+1)} − X_{φ(r)} − S = ∂R` of the same kind with
`M(R) + M(S) ≤ 2^{-r}`.  For the `2^{-(r+1)}`-net `𝒬_r` every infinite index set contains an
infinite fibre of `j ↦ Q_r(j)`; for `j, l` in it, `R_{r,j} − R_{r,l}` and `S_{r,j} − S_{r,l}`
decompose `X_j − X_l` (`M(A − B) ≤ M(A) + M(B)`, `spt (R_{r,j} − R_{r,l}) ⊆ L`).  The diagonal
lemma `cmc_fc_cs_diagonal_subseq` then extracts `φ`. -/
theorem Submission.dtc_bc_lc_fd_cauchy_subseq : ∀ (P m : ℕ) (L : Set (Euclid P)) (X : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact L → (∀ ε : ℝ≥0∞, 0 < ε → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ j, ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧ R.support ⊆ L ∧ X j - Q - S = R.boundary ∧ R.mass + S.mass ≤ ε) → ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ r, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧ R.support ⊆ L ∧ X (φ (r + 1)) - X (φ r) - S = R.boundary ∧ R.mass + S.mass ≤ (2⁻¹ : ℝ≥0∞) ^ r := by
  intro P m L X hL hnet
  -- the contract's difference acts pointwise
  have hsub : ∀ {k : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) k)
      (ω : TestFormOn (univ : Set (Euclid P)) k), (A - B) ω = A ω - B ω := fun _ _ _ => rfl
  -- Step 4(d): `M(A − B) ≤ M(A) + M(B)`, since `−ω` is admissible along with `ω`
  have hmass : ∀ {k : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) k),
      (A - B).mass ≤ A.mass + B.mass := by
    intro k A B
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    have hω' : -ω ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      refine ⟨subset_univ _, fun x => ?_⟩
      change covectorEuclideanNorm (-(ω : DifferentialForm (Euclid P) k) x) ≤ 1
      rw [covectorEuclideanNorm_neg]
      exact hω.2 x
    calc ENNReal.ofReal ((A - B) ω) = ENNReal.ofReal (A ω + B (-ω)) := by
          rw [hsub, sub_eq_add_neg]
          congr 2
          exact (map_neg B.toCurrent ω).symm
      _ ≤ ENNReal.ofReal (A ω) + ENNReal.ofReal (B (-ω)) := ENNReal.ofReal_add_le
      _ ≤ A.mass + B.mass := add_le_add (A.le_massOn hω) (B.le_massOn hω')
  -- Step 1: `2^{-(r+1)}`-nets `𝒬_r` and decompositions `X_j − Q_r(j) − S_{r,j} = ∂R_{r,j}`
  choose 𝒬 h𝒬 hdec using fun r : ℕ =>
    hnet ((2⁻¹ : ℝ≥0∞) ^ (r + 1)) (ENNReal.pow_pos (ENNReal.inv_pos.2 ENNReal.ofNat_ne_top) _)
  choose Q hQ R S hR hRL hXRS hRS using hdec
  -- Step 5: the diagonal lemma for the relation `C(r, j, l)` of step 2
  refine Submission.cmc_fc_cs_diagonal_subseq (fun r j l =>
    ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
      (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)),
      IsIntegerMultiplicity R ∧ R.support ⊆ L ∧ X j - X l - S = R.boundary ∧
        R.mass + S.mass ≤ (2⁻¹ : ℝ≥0∞) ^ r) fun r I hI => ?_
  -- Step 3: some fibre `J = {j ∈ I | Q_r(j) = Q₀}` over the finite net `𝒬_r` is infinite
  obtain ⟨Q₀, -, hJ⟩ : ∃ Q₀ ∈ 𝒬 r, {j ∈ I | Q r j = Q₀}.Infinite := by
    by_contra hcon
    exact hI (((h𝒬 r).biUnion fun Q₀ hQ₀ =>
      Set.not_infinite.1 fun h => hcon ⟨Q₀, hQ₀, h⟩).subset
        fun j hj => Set.mem_biUnion (hQ r j) ⟨hj, rfl⟩)
  refine ⟨{j ∈ I | Q r j = Q₀}, sep_subset _ _, hJ, ?_⟩
  -- Step 4: for `j, l ∈ J` take `R_{r,j} − R_{r,l}` and `S_{r,j} − S_{r,l}`
  rintro j ⟨-, hj⟩ l ⟨-, hl⟩
  refine ⟨R r j - R r l, S r j - S r l, ?_, ?_, ?_, ?_⟩
  · -- (a) integer multiplicity, by (IC)(c)
    exact Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 2) univ (R r j) (R r l)
      isOpen_univ (hR r j) (hR r l)
  · -- (c) `spt (R_{r,j} − R_{r,l}) ⊆ L`: both vanish on forms supported away from `L`
    refine (Submission.rsd_cmr_support_subset_of_vanish P (m + 2) univ L (R r j - R r l)
      isOpen_univ hL (subset_univ L) fun ω hω => ?_).1
    rw [hsub, Submission.dtc_vanish_off_support P (m + 2) univ (R r j) ω
      (hω.mono_right (hRL r j)), Submission.dtc_vanish_off_support P (m + 2) univ (R r l) ω
      (hω.mono_right (hRL r l)), sub_zero]
  · -- (b) subtract the two decompositions, using `Q_r(j) = Q₀ = Q_r(l)`
    ext ω
    have h₁ := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => T ω)
      (hXRS r j)
    have h₂ := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => T ω)
      (hXRS r l)
    simp only [hsub, GeometricCurrentOn.boundary_apply, hj, hl] at h₁ h₂ ⊢
    linarith
  · -- (d) `M(R) + M(S) ≤ 2 · 2^{-(r+1)} = 2^{-r}`
    calc (R r j - R r l).mass + (S r j - S r l).mass
        ≤ ((R r j).mass + (R r l).mass) + ((S r j).mass + (S r l).mass) :=
          add_le_add (hmass _ _) (hmass _ _)
      _ = ((R r j).mass + (S r j).mass) + ((R r l).mass + (S r l).mass) :=
          add_add_add_comm _ _ _ _
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ (r + 1) + (2⁻¹ : ℝ≥0∞) ^ (r + 1) := add_le_add (hRS r j) (hRS r l)
      _ = (2⁻¹ : ℝ≥0∞) ^ r := by
          rw [pow_succ, ← mul_add, ENNReal.inv_two_add_inv_two, mul_one]
/-- **Carrier, mass and support of integer multiplicity currents in `ℝᴾ`** (Simon Ch. 6, 2.11 and
Remark 3.2(3)).  (1) If `Y = τ(M, θ, ξ)` in `ℝᴾ`, then `Hⁿ(M \ spt Y) = 0`, `M(Y) = μ_R(ℝᴾ)`, and
`μ_R(ℝᴾ) < ∞` if `spt Y` is compact.  (2) `spt Y₁` is closed and `spt(Y₁ - Y₂) ⊆ spt Y₁ ∪ spt Y₂`.
`Y` kills every form supported in the open set `W = ℝᴾ \ spt Y` (`dtc_vanish_off_support`), so
`μ_R(W) = M_W(Y) = 0` (`dtc_mass_eq_measure`) and, as `θ ≥ 1` on `M`, `Hⁿ(M ∩ W) = 0`; for compact
`spt Y`, `μ_R(ℝᴾ) ≤ μ_R(spt Y) + μ_R(W) = ∫_{M ∩ spt Y} θ dHⁿ < ∞`.  A common relatively compact
neighbourhood on which `Y₁` and `Y₂` vanish lies in the zero region of `Y₁ - Y₂`. -/
theorem Submission.dtc_bc_lc_pf_imrep_carrier_mass_support : ∀ (P n : ℕ), (∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), R.Represents Y → μHE[n] (R.carrier \ Y.support) = 0 ∧ Y.mass = R.measure univ ∧ (IsCompact Y.support → R.measure univ ≠ ∞)) ∧ ∀ Y₁ Y₂ : GeometricCurrentOn (univ : Set (Euclid P)) n, IsClosed Y₁.support ∧ (Y₁ - Y₂).support ⊆ Y₁.support ∪ Y₂.support := by
  intro P n
  -- Step 1: `spt Y = ℝᴾ \ Z(Y)` is closed, the zero region `Z(Y)` being open
  have hclosed : ∀ Y : GeometricCurrentOn (univ : Set (Euclid P)) n, IsClosed Y.support := by
    intro Y
    rw [GeometricCurrentOn.support, ← compl_eq_univ_sdiff]
    exact Y.isOpen_zeroRegion.isClosed_compl
  refine ⟨fun Y R hRY => ?_, fun Y₁ Y₂ => ⟨hclosed Y₁, ?_⟩⟩
  · -- Step 2: `M_W(Y) = 0` on the open set `W = ℝᴾ \ spt Y` (`dtc_vanish_off_support`)
    have hWo : IsOpen (Y.support)ᶜ := (hclosed Y).isOpen_compl
    have hmass : Y.massOn (Y.support)ᶜ = 0 := by
      refine le_antisymm (sSup_le ?_) zero_le
      rintro r ⟨ω, hω, rfl⟩
      dsimp only
      rw [Submission.dtc_vanish_off_support P n univ Y ω
        (subset_compl_iff_disjoint_right.mp hω.1), ENNReal.ofReal_zero]
    -- Step 3: `μ_R(W) = M_W(Y) = 0` (`dtc_mass_eq_measure`); as `θ ≥ 1` on `M`, `Hⁿ(M ∩ W) = 0`
    have hμW : R.measure (Y.support)ᶜ = 0 := by
      rw [← Submission.dtc_mass_eq_measure P n univ _ Y R isOpen_univ hWo (subset_univ _) hRY]
      exact hmass
    have hnull : μHE[n] (R.carrier \ Y.support) = 0 := by
      have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
        measurable_from_nat.comp R.measurable_mult
      have h := (withDensity_apply_eq_zero' (μ := μHE[n].restrict R.carrier)
        hθ.aemeasurable).1 hμW
      rw [Measure.restrict_apply' R.measurableSet_carrier] at h
      refine measure_mono_null ?_ h
      intro x hx
      exact ⟨⟨Nat.cast_ne_zero.2 (R.mult_pos x hx.1).ne', hx.2⟩, hx.1⟩
    -- Step 4: `M(Y) = M_{ℝᴾ}(Y) = μ_R(ℝᴾ)`
    refine ⟨hnull, Submission.dtc_mass_eq_measure P n univ univ Y R isOpen_univ isOpen_univ
      subset_rfl hRY, fun hK => ?_⟩
    -- Step 5: `μ_R(ℝᴾ) ≤ μ_R(spt Y) + μ_R(W) = ∫_{M ∩ spt Y} θ dHⁿ < ∞`
    have hKm : R.measure Y.support =
        ∫⁻ x in R.carrier ∩ Y.support, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
      rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
        Measure.restrict_restrict hK.measurableSet, inter_comm]
    refine ne_top_of_le_ne_top ?_ ((measure_mono (union_compl_self Y.support).ge).trans
      ((measure_union_le _ _).trans_eq (by rw [hμW, add_zero])))
    rw [hKm]
    exact R.locallyIntegrable_mult _ hK (subset_univ _)
  · -- Step 6: `x ∉ spt Y₁ ∪ spt Y₂` lies in open `W₁`, `W₂` with compact closures on which
    -- `Y₁`, `Y₂` vanish; then `W₁ ∩ W₂` witnesses `x ∈ Z(Y₁ - Y₂)`
    intro x hx
    by_contra hxs
    rw [mem_union, not_or] at hxs
    have hZ : ∀ Y : GeometricCurrentOn (univ : Set (Euclid P)) n, x ∉ Y.support →
        x ∈ Y.zeroRegion := fun Y h => not_not.mp fun h' => h ⟨mem_univ x, h'⟩
    obtain ⟨W₁, ⟨hW₁o, hW₁c, -, hW₁v⟩, hxW₁⟩ := mem_sUnion.mp (hZ Y₁ hxs.1)
    obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hxW₂⟩ := mem_sUnion.mp (hZ Y₂ hxs.2)
    -- `closure (W₁ ∩ W₂) ⊆ closure W₁` is compact, and `(Y₁ - Y₂)(ω) = Y₁(ω) - Y₂(ω) = 0`
    refine hx.2 ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o, hW₁c.of_isClosed_subset isClosed_closure
      (closure_mono inter_subset_left), subset_univ _, fun ω hω => ?_⟩, hxW₁, hxW₂⟩
    show Y₁ ω - Y₂ ω = 0
    rw [hW₁v ω (hω.trans inter_subset_left), hW₂v ω (hω.trans inter_subset_right), sub_zero]

/-- **Simon Ch. 6, 2.27 and 2.29** (pointwise estimate behind the push-forward; step 1(a) of the
local comparison in the proof of 7.3.1): let `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` be a unit orientation of `Q`
(`τ` orthonormal, `span τ = Q`) and `L` a continuous linear map.  (a) `⟨α ∘ ΛⁿL, ξ⟩ = ±α(L ∘ τ)`,
and `|α(v)| ≤ |α|_E det(⟨vᵢ, vⱼ⟩)^{1/2}` (Cauchy–Binet and Cauchy–Schwarz,
`covectorEuclideanNorm_gram_bounds`), `det(⟨vᵢ, vⱼ⟩) ≤ ∏ᵢ |vᵢ|²` (Hadamard) and
`|Lτᵢ| ≤ ‖L‖ |τᵢ| = ‖L‖` give `|⟨α ∘ ΛⁿL, ξ⟩| ≤ |α|_E ‖L‖ⁿ`.  (b) If `L` fixes `Q` pointwise,
then `L ∘ τ = τ` since each `τᵢ ∈ Q`, so `⟨α ∘ ΛⁿL, ξ⟩ = ±α(τ) = ⟨α, ξ⟩`. -/
theorem Submission.dtc_bc_lc_pf_unitOrientation_comp : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ (α.compContinuousLinearMap L)| ≤ covectorEuclideanNorm α * ‖L‖ ^ n) ∧ ((∀ v ∈ Q, L v = v) → ∀ α : Covector (Euclid P) n, ξ (α.compContinuousLinearMap L) = ξ α) := by
  rintro P n ξ Q L ⟨τ, hτ, hspan, hsign⟩
  -- `(α ∘ ΛⁿL)(τ) = α(L ∘ τ)`
  have hcomp : ∀ α : Covector (Euclid P) n, α.compContinuousLinearMap L τ = α (⇑L ∘ τ) :=
    fun α => ContinuousAlternatingMap.compContinuousLinearMap_apply α L τ
  refine ⟨fun α => ?_, fun hL α => ?_⟩
  · -- (a) `|⟨α ∘ ΛⁿL, ξ⟩| = |α(L ∘ τ)|` for either sign
    have habs : |ξ (α.compContinuousLinearMap L)| = |α (⇑L ∘ τ)| := by
      rcases hsign with h | h
      · rw [h, hcomp]
      · rw [h, hcomp, abs_neg]
    -- `|Lτᵢ| ≤ ‖L‖ |τᵢ| = ‖L‖`
    have hLτ : ∀ i, ‖(⇑L ∘ τ) i‖ ≤ ‖L‖ := fun i => by
      simpa only [Function.comp_apply, hτ.norm_eq_one i, mul_one] using L.le_opNorm (τ i)
    have hα := covectorEuclideanNorm_nonneg α
    rw [habs]
    calc |α (⇑L ∘ τ)|
        ≤ covectorEuclideanNorm α * Real.sqrt (Matrix.det (Matrix.of fun i j =>
            inner ℝ ((⇑L ∘ τ) i) ((⇑L ∘ τ) j))) :=
          (Submission.covectorEuclideanNorm_gram_bounds P n).1 α (⇑L ∘ τ)
      _ ≤ covectorEuclideanNorm α * Real.sqrt (∏ i, ‖(⇑L ∘ τ) i‖ ^ 2) :=
          mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt
            (Submission.dtc_bc_lc_pf_gram_det_le_prod_norm_sq P n (⇑L ∘ τ))) hα
      _ = covectorEuclideanNorm α * ∏ i, ‖(⇑L ∘ τ) i‖ := by
          rw [Finset.prod_pow, Real.sqrt_sq (Finset.prod_nonneg fun i _ => norm_nonneg _)]
      _ ≤ covectorEuclideanNorm α * ‖L‖ ^ n := by
          rw [← Fin.prod_const]
          exact mul_le_mul_of_nonneg_left
            (Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) fun i _ => hLτ i) hα
  · -- (b) each `τᵢ` lies in `Q = span (range τ)`, so `L ∘ τ = τ`
    have hLτ : ⇑L ∘ τ = τ := by
      funext i
      exact hL (τ i) (hspan ▸ Submodule.subset_span (mem_range_self i))
    rcases hsign with h | h <;> rw [h, h, hcomp, hLτ]

/-- **Cut-off of the pulled-back form** (Simon Ch. 6, 2.23 and Remark 2.24(2)).  Let `O ⊆ ℝᴾ` be
open, `K ⊆ O` compact, `f : ℝᴾ → ℝ^Q` of class `C¹` on `O` and `ω` a continuous `n`-form on `ℝ^Q`.
Some continuous, compactly supported `h : ℝᴾ → Λⁿ(ℝᴾ)` equals `ω(f(x)) ∘ Df(x)` on `K`.

Proof sketch:
* `f` and `Df` are continuous on `O`, and `(β, A) ↦ β ∘ A` is continuous (it has a strict
  derivative everywhere), so `γ(x) = ω(f(x)) ∘ Df(x)` is continuous on `O`.
* Take `ρ > 0` with `cthickening ρ K ⊆ O`, and a Urysohn cut-off `χ` with
  `support χ = thickening ρ K` and `χ = 1` on `cthickening (ρ/2) K ⊇ K`.
* `h = χ • γ` has `tsupport h ⊆ tsupport χ ⊆ cthickening ρ K`, a compact subset of `O`: so `h` has
  compact support, is continuous (being continuous on the open `O ⊇ tsupport h`), and `h = γ`
  on `K`. -/
theorem Submission.dtc_bc_lc_pf_ext_pullback_cutoff : ∀ (P Q n : ℕ) (O K : Set (Euclid P)) (f : Euclid P → Euclid Q) (ω : DifferentialForm (Euclid Q) n), IsOpen O → ContDiffOn ℝ 1 f O → IsCompact K → K ⊆ O → Continuous ω → ∃ h : Euclid P → Covector (Euclid P) n, Continuous h ∧ HasCompactSupport h ∧ ∀ x ∈ K, h x = (ω (f x)).compContinuousLinearMap (fderiv ℝ f x) := by
  intro P Q n O K f ω hO hf hK hKO hω
  -- `f` and `Df` are continuous on `O`
  have hfc : ContinuousOn f O := hf.continuousOn
  have hDf : ContinuousOn (fderiv ℝ f) O := hf.continuousOn_fderiv_of_isOpen hO le_rfl
  -- `(β, A) ↦ β ∘ A` is continuous, having a strict derivative everywhere
  have hΦ : Continuous fun βA : Covector (Euclid Q) n × (Euclid P →L[ℝ] Euclid Q) =>
      βA.1.compContinuousLinearMap βA.2 :=
    continuous_iff_continuousAt.2 fun βA =>
      (ContinuousAlternatingMap.hasStrictFDerivAt_compContinuousLinearMap βA).continuousAt
  -- `γ(x) = ω(f(x)) ∘ Df(x)` is continuous on `O`
  have hγ : ContinuousOn (fun x => (ω (f x)).compContinuousLinearMap (fderiv ℝ f x)) O :=
    hΦ.comp_continuousOn ((hω.comp_continuousOn hfc).prodMk hDf)
  -- a margin `cthickening ρ K ⊆ O`, a compact set
  obtain ⟨ρ, hρ, hρO⟩ := hK.exists_cthickening_subset_open hO hKO
  have hρK : IsCompact (cthickening ρ K) := hK.cthickening
  -- a cut-off `χ` with `support χ = thickening ρ K` and `χ = 1` on `cthickening (ρ/2) K`
  obtain ⟨χ, hχ, -, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := 0)
    (isOpen_thickening (δ := ρ) (E := K)) (isClosed_cthickening (δ := ρ / 2) (E := K))
    (cthickening_subset_thickening' hρ (half_lt_self hρ) K)
  have hχK : ∀ x ∈ K, χ x = 1 := fun x hx => (hχ1 x).1 (self_subset_cthickening K hx)
  have hχt : tsupport χ ⊆ cthickening ρ K := by
    rw [tsupport, hχs]
    exact closure_thickening_subset_cthickening ρ K
  -- `h = χ • γ`, whose support lies in `tsupport χ`
  have hts := tsupport_smul_subset_left χ
    fun x => (ω (f x)).compContinuousLinearMap (fderiv ℝ f x)
  refine ⟨fun x => χ x • (ω (f x)).compContinuousLinearMap (fderiv ℝ f x), ?_, ?_, ?_⟩
  · -- continuous on the open `O ⊇ tsupport h`, hence continuous
    exact (hχ.continuous.continuousOn.smul hγ).continuous_of_tsupport_subset hO
      (hts.trans (hχt.trans hρO))
  · -- `tsupport h ⊆ tsupport χ ⊆ cthickening ρ K`, a compact set
    exact hρK.of_isClosed_subset (isClosed_tsupport _) (hts.trans hχt)
  · -- `χ = 1` on `K`
    intro x hx
    simp only [hχK x hx, one_smul]
/-- **Mollification** (behind Simon Ch. 6, Remark 2.24(2)): a continuous, compactly supported
`n`-covector field `h` on `ℝᴾ` is the uniform limit of test forms `ωⱼ ∈ 𝒟ⁿ(ℝᴾ)`.

Let `ψⱼ = φⱼ / ∫ φⱼ`, where `φⱼ ≥ 0` is a smooth bump with `support φⱼ = B_{1/(j+1)}(0)`, so
`ψⱼ ≥ 0` and `∫ ψⱼ = 1`.  Then `ωⱼ = ψⱼ ⋆ h` is `C^∞` with compact support, and
`‖ωⱼ(x) − h(x)‖ ≤ sup_{‖t‖ < 1/(j+1)} ‖h(x − t) − h(x)‖`, which tends to `0` uniformly in `x`
because `h` is uniformly continuous. -/
theorem Submission.dtc_bc_lc_pf_ext_mollify_tendstoUniformly : ∀ (P n : ℕ) (h : Euclid P → Covector (Euclid P) n), Continuous h → HasCompactSupport h → ∃ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) n, TendstoUniformly (fun j x => (ωs j : DifferentialForm (Euclid P) n) x) h atTop := by
  intro P n h hhc hhs
  -- (1) `h` is locally integrable
  have hhi : LocallyIntegrable h volume := hhc.locallyIntegrable
  -- (2) smooth bumps `φ j ≥ 0` with `support (φ j) = B_{1/(j+1)}(0)`, and the normalized kernels
  -- `ψ j = φ j / ∫ φ j`: `ψ j ≥ 0`, `∫ ψ j = 1`
  have hr : ∀ j : ℕ, 0 < 1 / ((j : ℝ) + 1) := fun j => Nat.one_div_pos_of_nat
  let φ : ℕ → ContDiffBump (0 : Euclid P) := fun j =>
    ⟨1 / ((j : ℝ) + 1) / 2, 1 / ((j : ℝ) + 1), half_pos (hr j), half_lt_self (hr j)⟩
  have hφ : ∀ j, 0 < ∫ y, φ j y := fun j => by
    refine (integral_pos_iff_support_of_nonneg (φ j).nonneg'
      ((φ j).continuous.integrable_of_hasCompactSupport (φ j).hasCompactSupport)).mpr ?_
    rw [(φ j).support_eq]
    exact measure_ball_pos volume 0 (hr j)
  let ψ : ℕ → Euclid P → ℝ := fun j y => φ j y / ∫ y, φ j y
  have hψφ : ∀ j, support (ψ j) ⊆ support (φ j) := fun j y hy h0 => hy (by simp [ψ, h0])
  have hψs : ∀ j, support (ψ j) ⊆ ball 0 (1 / ((j : ℝ) + 1)) := fun j =>
    (hψφ j).trans (φ j).support_eq.subset
  have hψc : ∀ j, HasCompactSupport (ψ j) := fun j => (φ j).hasCompactSupport.mono (hψφ j)
  have hψ0 : ∀ j y, 0 ≤ ψ j y := fun j y => div_nonneg (φ j).nonneg (hφ j).le
  have hψ1 : ∀ j, ∫ y, ψ j y = 1 := fun j => by rw [integral_div, div_self (hφ j).ne']
  -- (3) `ω j = ψ j ⋆ h`
  let ω : ℕ → DifferentialForm (Euclid P) n := fun j =>
    convolution (ψ j) h (ContinuousLinearMap.lsmul ℝ ℝ) volume
  -- (4) `ω j` is `C^∞` with compact support, so it is a test form on `ℝᴾ`
  have hω : ∀ j, ω j ∈ TestFormOn (univ : Set (Euclid P)) n := fun j =>
    ⟨⟨(hψc j).contDiff_convolution_left _ ((φ j).contDiff.div_const _) hhi,
      (hψc j).convolution _ hhs⟩, subset_univ _⟩
  refine ⟨fun j => ⟨ω j, hω j⟩, Metric.tendstoUniformly_iff.mpr fun ε hε => ?_⟩
  -- (6) uniform continuity of `h` gives `δ` for `ε/2`; take `J` with `1/(J+1) < δ`
  obtain ⟨δ, hδ, hhδ⟩ := Metric.uniformContinuous_iff.mp
    (hhs.uniformContinuous_of_continuous hhc) (ε / 2) (half_pos hε)
  obtain ⟨J, hJ⟩ := exists_nat_one_div_lt hδ
  refine eventually_atTop.mpr ⟨J, fun j hj x => ?_⟩
  -- (5) for `j ≥ J`, `‖h(y) − h(x)‖ < ε/2` on `B_{1/(j+1)}(x)`, so `‖ω j x − h x‖ ≤ ε/2 < ε`
  rw [dist_comm]
  refine lt_of_le_of_lt ?_ (half_lt_self hε)
  exact dist_convolution_le (half_pos hε).le (hψs j) (hψ0 j) (hψ1 j) hhc.aestronglyMeasurable
    fun y hy => (hhδ ((mem_ball.mp hy).trans_le ((Nat.one_div_le_one_div hj).trans hJ.le))).le
/-- **Limit of `IMRep` integrals under uniform convergence on a compact carrier set** (Simon
Ch. 6, 2.24(2) with the integral representation 6.3.1 (‡); chapter-06.txt lines 415–424, 271).
Let `R = (M, θ, ξ)` be an `IMRep` in `U`, `K ⊆ U` compact with `Hⁿ(M \ K) = 0`, and `gⱼ`, `g`
continuous `n`-covector fields with `gⱼ → g` uniformly on `K`.  Then
`∫_M θ ⟨gⱼ, ξ⟩ dHⁿ → ∫_M θ ⟨g, ξ⟩ dHⁿ`.

Write `μ = Hⁿ⌞M`.  `μ`-a.e. `x` lies in `K`, and `M =ᵐ M ∩ K`, so `θ` is `μ`-integrable by the
local integrability of `θ` on `K`.  A unit orientation has `|ξ(x)(β)| = |β(τ)| ≤ ‖β‖` (`τ`
orthonormal), so for continuous `G` the integrand `θ ξ(G)` is a.e. strongly measurable and
dominated by `(sup_K ‖G‖) θ`, hence integrable.  Finally
`|∫ θ ξ(gⱼ) dμ − ∫ θ ξ(g) dμ| ≤ ∫ θ ‖gⱼ − g‖ dμ ≤ Θ ε/(Θ + 1) < ε` for large `j`,
where `Θ = ∫ θ dμ`. -/
theorem Submission.dtc_bc_lc_pf_ext_imrep_integral_tendsto : ∀ (P n : ℕ) (U K : Set (Euclid P)) (R : IMRep U n) (gs : ℕ → Euclid P → Covector (Euclid P) n) (g : Euclid P → Covector (Euclid P) n), IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → (∀ j, Continuous (gs j)) → Continuous g → TendstoUniformlyOn gs g atTop K → Tendsto (fun j => ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (gs j x) ∂μHE[n]) atTop (𝓝 (∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (g x) ∂μHE[n])) := by
  intro P n U K R gs g hK hKU hnull hgs hg hunif
  set μ := μHE[n].restrict R.carrier with hμ
  -- (1) `μ`-a.e. point lies in `K`, as `Hⁿ(M \ K) = 0`
  have hae : ∀ᵐ x ∂μ, x ∈ K := by
    rw [hμ, ae_restrict_iff' R.measurableSet_carrier, ae_iff]
    refine measure_mono_null (fun x hx => ?_) hnull
    simp only [mem_ofPred_eq, not_imp] at hx
    exact hx
  -- (2) a unit orientation has norm at most one
  have hbound : ∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ ‖α‖ := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    intro α
    have hτn : ∀ i, ‖τ i‖ = 1 := fun i => hτ.1 i
    have hατ : |α τ| ≤ ‖α‖ := by
      have h := α.le_opNorm τ
      simp only [hτn, Finset.prod_const_one, mul_one, Real.norm_eq_abs] at h
      exact h
    rcases hξ with h | h
    · rw [h]; exact hατ
    · rw [h, abs_neg]; exact hατ
  -- (3) `θ` is `μ`-integrable: `μ = Hⁿ⌞(M ∩ K)` and `∫_{M ∩ K} θ dHⁿ < ∞`
  have hθmeas : AEStronglyMeasurable (fun x => (R.mult x : ℝ)) μ :=
    ((measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult).aestronglyMeasurable
  have hμK : μ = μHE[n].restrict (R.carrier ∩ K) := by
    rw [hμ]
    refine Measure.restrict_congr_set (ae_eq_set.2 ⟨?_, ?_⟩)
    · rw [sdiff_self_inter]
      exact hnull
    · rw [sdiff_eq_empty.2 inter_subset_left]
      exact measure_empty
  have hθint : Integrable (fun x => (R.mult x : ℝ)) μ := by
    refine ⟨hθmeas, ?_⟩
    show ∫⁻ x, ‖(R.mult x : ℝ)‖ₑ ∂μ < ∞
    rw [hμK]
    simp only [Real.enorm_natCast]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult K hK hKU)
  -- (4) measurability of the integrand for continuous `G`
  have hmeas : ∀ G : Euclid P → Covector (Euclid P) n, Continuous G →
      AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (G x)) μ := by
    intro G hG
    have h2 : AEStronglyMeasurable (fun x => R.orient x (G x)) μ :=
      Continuous.comp_aestronglyMeasurable₂
        (g := fun (L : MultiVector P n) (α : Covector (Euclid P) n) => L α)
        (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid P) n) (F := ℝ)).continuous
        R.aestronglyMeasurable_orient hG.aestronglyMeasurable
    exact hθmeas.mul h2
  -- (5) integrability of the integrand for continuous `G`: it is dominated by `(sup_K ‖G‖) θ`
  have hint : ∀ G : Euclid P → Covector (Euclid P) n, Continuous G →
      Integrable (fun x => (R.mult x : ℝ) * R.orient x (G x)) μ := by
    intro G hG
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hG.continuousOn
    refine Integrable.mono' (hθint.const_mul C) (hmeas G hG) ?_
    filter_upwards [hbound, hae] with x hx hxK
    rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs]
    calc (R.mult x : ℝ) * |R.orient x (G x)| ≤ (R.mult x : ℝ) * ‖G x‖ := by
          gcongr; exact hx _
      _ ≤ (R.mult x : ℝ) * C := by gcongr; exact hC x hxK
      _ = C * (R.mult x : ℝ) := mul_comm _ _
  -- (6) the estimate `|∫ θ ξ(gⱼ) dμ − ∫ θ ξ(g) dμ| ≤ Θ ε/(Θ + 1) < ε` for large `j`
  set Θ := ∫ x, (R.mult x : ℝ) ∂μ with hΘdef
  have hΘ : 0 ≤ Θ := integral_nonneg fun x => Nat.cast_nonneg _
  rw [Metric.tendstoUniformlyOn_iff] at hunif
  rw [Metric.tendsto_atTop]
  intro ε hε
  have hε' : 0 < ε / (Θ + 1) := div_pos hε (by linarith)
  obtain ⟨N, hN⟩ := eventually_atTop.mp (hunif (ε / (Θ + 1)) hε')
  refine ⟨N, fun j hj => ?_⟩
  rw [Real.dist_eq, ← integral_sub (hint _ (hgs j)) (hint _ hg), ← Real.norm_eq_abs]
  have hle : ‖∫ x, ((R.mult x : ℝ) * R.orient x (gs j x) - (R.mult x : ℝ) * R.orient x (g x)) ∂μ‖
      ≤ ∫ x, ε / (Θ + 1) * (R.mult x : ℝ) ∂μ := by
    refine norm_integral_le_of_norm_le (hθint.const_mul _) ?_
    filter_upwards [hbound, hae] with x hx hxK
    rw [← mul_sub, ← (R.orient x).map_sub, norm_mul, Real.norm_natCast, Real.norm_eq_abs]
    calc (R.mult x : ℝ) * |R.orient x (gs j x - g x)| ≤ (R.mult x : ℝ) * ‖gs j x - g x‖ := by
          gcongr; exact hx _
      _ ≤ (R.mult x : ℝ) * (ε / (Θ + 1)) := by
          gcongr
          have h := hN j hj x hxK
          rw [dist_comm, dist_eq_norm] at h
          exact h.le
      _ = ε / (Θ + 1) * (R.mult x : ℝ) := mul_comm _ _
  rw [integral_const_mul, ← hΘdef] at hle
  refine hle.trans_lt ?_
  rw [div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
  nlinarith

/-- **Integral form of the push-forward along one fixed sequence of test forms** (Simon Ch. 6,
2.23–2.24(2)).  For `f` of class `C¹` on an open `O ⊇ K` (`K` compact) and `ω ∈ 𝒟ⁿ(ℝᴾ)` there
are `ω_j ∈ 𝒟ⁿ(ℝᴾ)`, chosen before any current, with `Y(ω_j) → ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ⟩ dHⁿ`
for every `Y = τ(M, θ, ξ)` with `spt Y ⊆ K`.  A cut-off of `ω(f(·)) ∘ Df(·)` is a continuous,
compactly supported `h` equal to it on `K` (`dtc_bc_lc_pf_ext_pullback_cutoff`), and mollified
test forms converge to `h` uniformly (`dtc_bc_lc_pf_ext_mollify_tendstoUniformly`).  As
`Hⁿ(M \ K) ≤ Hⁿ(M \ spt Y) = 0` (`dtc_bc_lc_pf_imrep_carrier_mass_support`),
`Y(ω_j) = ∫_M θ ξ(ω_j) → ∫_M θ ξ(h)` (`dtc_bc_lc_pf_ext_imrep_integral_tendsto`), and
`∫_M θ ξ(h)` is the stated integral because `h = ω(f) ∘ Df` on `K`. -/
theorem Submission.dtc_bc_lc_pf_pullback_integral_extension : ∀ (P n : ℕ) (O K : Set (Euclid P)) (f : Euclid P → Euclid P) (ω : TestFormOn (univ : Set (Euclid P)) n), IsOpen O → ContDiffOn ℝ 1 f O → IsCompact K → K ⊆ O → ∃ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) n, ∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), R.Represents Y → Y.support ⊆ K → Tendsto (fun j => Y (ωs j)) atTop (𝓝 (∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n])) := by
  intro P n O K f ω hO hf hK hKO
  -- Steps 1–2: a continuous, compactly supported `h` with `h = ω(f(·)) ∘ Df(·)` on `K`
  obtain ⟨h, hhc, hhs, hhK⟩ := Submission.dtc_bc_lc_pf_ext_pullback_cutoff P P n O K f
    (ω : DifferentialForm (Euclid P) n) hO hf hK hKO ω.property.1.1.continuous
  -- Step 3: test forms `ω_j → h` uniformly; they depend only on `f`, `ω`, `O` and `K`
  obtain ⟨ωs, hωs⟩ := Submission.dtc_bc_lc_pf_ext_mollify_tendstoUniformly P n h hhc hhs
  refine ⟨ωs, fun Y R hRY hYK => ?_⟩
  -- Step 4(a): `Hⁿ(M \ K) ≤ Hⁿ(M \ spt Y) = 0`
  have hnull : μHE[n] (R.carrier \ K) = 0 :=
    measure_mono_null (Set.sdiff_subset_sdiff_right hYK)
      ((Submission.dtc_bc_lc_pf_imrep_carrier_mass_support P n).1 Y R hRY).1
  -- Step 5: `h = ω(f) ∘ Df` on `K`, which contains `Hⁿ`-a.e. point of `M`, so the limits agree
  have hae : (fun x => (R.mult x : ℝ) * R.orient x (h x)) =ᵐ[μHE[n].restrict R.carrier]
      fun x => (R.mult x : ℝ) * R.orient x
        (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) := by
    have hMK : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ K := by
      rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
      refine measure_mono_null (fun x hx => ?_) hnull
      exact ⟨hx.2, hx.1⟩
    filter_upwards [hMK] with x hx
    rw [hhK x hx]
  rw [← integral_congr_ae hae]
  -- Step 6: `Y(ω_j) = ∫_M θ ξ(ω_j) → ∫_M θ ξ(h)`
  exact (Submission.dtc_bc_lc_pf_ext_imrep_integral_tendsto P n univ K R
    (fun j x => (ωs j : DifferentialForm (Euclid P) n) x) h hK (subset_univ K) hnull
    (fun j => (ωs j).property.1.1.continuous) hhc hωs.tendstoUniformlyOn).congr
    fun j => (hRY (ωs j)).symm
/-- **Mass bound for the push-forward formula** (Simon Ch. 6, 2.27 and 2.29:
`M(f_#T) ≤ (ess sup |Df|)ⁿ M(T)`).  Let `‖Df‖ ≤ L` on `O`, let `R = (M, θ, ξ)` represent `Y` with
`spt Y ⊆ O`, and let `Z(ω) = ∫_M θ ⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩ dHⁿ`.  Then `M(Z) ≤ Lⁿ M(Y)`.
* `Hⁿ(M ∖ spt Y) = 0` and `M(Y) = μ_R(ℝᴾ) = ∫_M θ dHⁿ`.
* For `|ω| ≤ 1` and `Hⁿ`-a.e. `x ∈ M`: `x ∈ spt Y ⊆ O`, so `0 ≤ ‖Df(x)‖ ≤ L` (in particular
  `L ≥ 0` whenever `M` is not `Hⁿ`-null), and `ξ(x)` is a unit orientation of a plane, so
  `|⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩| ≤ |ω(f(x))| ‖Df(x)‖ⁿ ≤ Lⁿ`.
* Hence `Z(ω) ≤ ∫_M |θ ⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩| dHⁿ ≤ Lⁿ ∫_M θ dHⁿ = Lⁿ M(Y)`; take the
  supremum over `ω`. -/
theorem Submission.dtc_bc_lc_pf_pushforward_mass_le : ∀ (P n : ℕ) (O : Set (Euclid P)) (f : Euclid P → Euclid P) (L : ℝ) (Y Z : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), (∀ y ∈ O, ‖fderiv ℝ f y‖ ≤ L) → R.Represents Y → IsCompact Y.support → Y.support ⊆ O → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Z ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → Z.mass ≤ ENNReal.ofReal (L ^ n) * Y.mass := by
  intro P n O f L Y Z R hL hRY _ hKO hZ
  -- Step 1: `Hⁿ(M ∖ spt Y) = 0` and `M(Y) = μ_R(ℝᴾ) = ∫_M θ dHⁿ`
  obtain ⟨hnull, hmass, -⟩ := (Submission.dtc_bc_lc_pf_imrep_carrier_mass_support P n).1 Y R hRY
  have hspt : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ Y.support := by
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    refine measure_mono_null (fun x hx => ?_) hnull
    exact ⟨hx.2, hx.1⟩
  have hθ : ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] = Y.mass := by
    rw [hmass, IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  -- Step 2: fix an admissible `ω`, i.e. `|ω(z)| ≤ 1` for every `z`
  apply sSup_le
  rintro _ ⟨ω, ⟨-, hω⟩, rfl⟩
  dsimp only
  -- Step 3: `|θ ⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩| ≤ Lⁿ θ` at `Hⁿ`-a.e. `x ∈ M`
  have hbound : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      ‖(R.mult x : ℝ) * R.orient x
        (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x))‖ₑ ≤
          ENNReal.ofReal (L ^ n) * (R.mult x : ℝ≥0∞) := by
    filter_upwards [hspt, R.orients] with x hx hor
    obtain ⟨Q, -, hQ⟩ := hor
    have hDf : ‖fderiv ℝ f x‖ ≤ L := hL x (hKO hx)
    have hLn : 0 ≤ L ^ n := pow_nonneg ((norm_nonneg _).trans hDf) n
    have hξ : |R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
        (fderiv ℝ f x))| ≤ L ^ n :=
      calc _ ≤ covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) (f x)) *
            ‖fderiv ℝ f x‖ ^ n :=
          (Submission.dtc_bc_lc_pf_unitOrientation_comp P n (R.orient x) Q (fderiv ℝ f x) hQ).1 _
        _ ≤ 1 * L ^ n := mul_le_mul (hω (f x)) (pow_le_pow_left₀ (norm_nonneg _) hDf n)
            (pow_nonneg (norm_nonneg _) n) zero_le_one
        _ = L ^ n := one_mul _
    rw [Real.enorm_eq_ofReal_abs, abs_mul, Nat.abs_cast, ← ENNReal.ofReal_natCast,
      ← ENNReal.ofReal_mul hLn, mul_comm (L ^ n)]
    exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hξ (Nat.cast_nonneg _))
  -- Step 4: `Z(ω) ≤ ∫_M |θ ⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩| dHⁿ ≤ Lⁿ ∫_M θ dHⁿ = Lⁿ M(Y)`
  rw [hZ ω]
  refine (Real.ofReal_le_enorm _).trans ((enorm_integral_le_lintegral_enorm _).trans
    ((lintegral_mono_ae hbound).trans_eq ?_))
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hθ]

/-- **Push-forward of an integer multiplicity current by a `C¹` map** (Simon Ch. 6, 3.3–3.9, with
the area formula of Ch. 3, 2.4–2.6).  Let `R = (M, θ, ξ)` be an integer multiplicity triple in the
open `U` with `Hⁿ(M ∖ K) = 0` for a compact `K ⊆ U`, let `f` be `C¹` on an open `O ⊇ K` with
`f(K) ⊆ U`, and let `Q(ω) = ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ(x)⟩ dHⁿ(x)` for `ω ∈ 𝒟ⁿ(U)`.  Replace `f`
by a globally `Λ`-Lipschitz `C¹` map `φ` with `φ = f` and `Dφ = Df` on `K`, and cut
`M₁ = M ∩ K` (with `∫_{M₁} θ < ∞`), up to an `Hⁿ`-null set, into disjoint bi-Lipschitz pieces
`Gⱼ(Aⱼ)` on which `φ ∘ Gⱼ` either is bi-Lipschitz with injective derivative or has nowhere
injective derivative.  On each piece `ξ ∘ Gⱼ = ±DGⱼ#e / J_{Gⱼ}` a.e., and the area formula turns
the contribution of `Gⱼ(Aⱼ)` to `Q(ω)` into `∫_{Nⱼ} gⱼ ⟨ω, ηⱼ⟩ dHⁿ`, with
`Nⱼ ⊆ φ(Gⱼ(Aⱼ)) ⊆ f(K) ⊆ U`, an integer `gⱼ ≠ 0` on `Nⱼ`, an orientation `ηⱼ` of `TNⱼ`, and
`∫_{Nⱼ} |gⱼ| ≤ Λⁿ ∫_{Gⱼ(Aⱼ)} θ`.  As `|⟨β, ξ⟩| ≤ ‖β‖` a.e. on `M` and `‖Dφ‖ ≤ Λ`, the integrand
`θ ⟨ω(φ) ∘ Dφ, ξ⟩` is `Hⁿ⌞M₁`-integrable, so `Q(ω) = Σⱼ ∫_{Nⱼ} gⱼ ⟨ω, ηⱼ⟩ dHⁿ` with
`Σⱼ ∫_{Nⱼ} |gⱼ| ≤ Λⁿ ∫_{M₁} θ < ∞`; gluing the pieces gives an integer multiplicity triple
representing `Q`. -/
theorem Submission.dtc_bc_lc_pf_pushforward_isIntegerMultiplicity : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U K O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P) (Q : GeometricCurrentOn U n), IsOpen U → 0 < n → IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → IsOpen O → K ⊆ O → ContDiffOn ℝ 1 f O → f '' K ⊆ U → (∀ ω : TestFormOn U n, Q ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → IsIntegerMultiplicity Q := by
  intro hTL P n U K O R f Q hU _hn hK hKU hMK hO hKO hf hfK hQ
  -- Step 1(b): a globally Lipschitz `C¹` map `φ` with `φ = f` and `Dφ = Df` on `K`
  obtain ⟨φ, Λ, hφ, hφL, hφK⟩ :=
    Submission.dtc_bc_lc_pfi_c1_cutoff_lipschitz P O K f hO hK hKO hf
  have hφd : Differentiable ℝ φ := hφ.differentiable one_ne_zero
  -- Step 1(a): `M₁ = M ∩ K` is Borel with `∫_{M₁} θ dHⁿ < ∞`
  have hM₁ : MeasurableSet (R.carrier ∩ K) :=
    R.measurableSet_carrier.inter hK.isClosed.measurableSet
  have hθM₁ : ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞ :=
    R.locallyIntegrable_mult K hK hKU
  -- Step 2: disjoint bi-Lipschitz pieces `Gⱼ(Aⱼ)` covering `M₁` up to a null set, on which
  -- `φ ∘ Gⱼ` is bi-Lipschitz with injective derivative or has nowhere injective derivative
  obtain ⟨G, A, κ, hGL, hA, hκ, hGκ, hGd, hGA, hGAM, hdisj, hnull, hφG⟩ :=
    Submission.dtc_bc_lc_pfi_refined_bilipschitz_pieces P n (R.carrier ∩ K) φ hM₁
      (R.rectifiable.mono inter_subset_left) hφd
  choose L hL using hGL
  have hGAR : ∀ j, G j '' A j ⊆ R.carrier := fun j => (hGAM j).trans inter_subset_left
  -- Step 4: `ξ ∘ Gⱼ = ±DGⱼ#e / J_{Gⱼ}` a.e. on `Aⱼ`; Steps 5–8: the image pieces
  -- `Nⱼ ⊆ φ(Gⱼ(Aⱼ))` with integer multiplicities `gⱼ` and orientations `ηⱼ`
  have hpiece := fun j =>
    Submission.dtc_bc_lc_pfi_piece_pushforward_image P n U R (G j) (A j) (L j) (κ j) φ Λ
      (hL j) (hA j) (hκ j) (hGκ j) (hGd j) (hGAR j)
      (ne_top_of_le_ne_top hθM₁ (lintegral_mono_set (hGAM j)))
      (Submission.dtc_bc_lc_pfi_piece_orientation_sign P n U R (G j) (A j) (L j) (κ j) hU
        (hL j) (hA j) (hκ j) (hGκ j) (hGd j) (hGAR j))
      hφd hφL (hφG j)
  choose N g η hN hNφ hNr hg hg0 hη hηT hgθ hNint using hpiece
  -- Steps 9–11: glue the image pieces into one integer multiplicity triple in `U`
  refine Submission.dtc_bc_lc_pfi_isIntegerMultiplicity_of_pieces hTL P n U N g η Q hU hN ?_
    hNr hg hg0 hη hηT ?_ ?_
  · -- `Nⱼ ⊆ φ(Gⱼ(Aⱼ)) ⊆ φ(K) = f(K) ⊆ U`
    intro j y hy
    obtain ⟨x, hx, rfl⟩ := hNφ j hy
    have hxK : x ∈ K := (hGAM j hx).2
    rw [(hφK x hxK).1]
    exact hfK (mem_image_of_mem f hxK)
  · -- `Σⱼ ∫_{Nⱼ} |gⱼ| ≤ Λⁿ Σⱼ ∫_{Gⱼ(Aⱼ)} θ = Λⁿ ∫_{⋃ⱼ Gⱼ(Aⱼ)} θ ≤ Λⁿ ∫_{M₁} θ < ∞`
    have hle : ∑' j, ∫⁻ y in N j, ((g j y).natAbs : ℝ≥0∞) ∂μHE[n] ≤
        (Λ : ℝ≥0∞) ^ n * ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
      calc ∑' j, ∫⁻ y in N j, ((g j y).natAbs : ℝ≥0∞) ∂μHE[n]
          ≤ ∑' j, (Λ : ℝ≥0∞) ^ n * ∫⁻ x in G j '' A j, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
            ENNReal.tsum_le_tsum hgθ
        _ = (Λ : ℝ≥0∞) ^ n * ∫⁻ x in ⋃ j, G j '' A j, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
            rw [ENNReal.tsum_mul_left, lintegral_iUnion hGA hdisj]
        _ ≤ (Λ : ℝ≥0∞) ^ n * ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
            gcongr
            exact iUnion_subset hGAM
    exact ne_top_of_le_ne_top
      (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) hθM₁) hle
  · -- `Q(ω) = ∫_{M₁} θ ⟨ω(φ) ∘ Dφ, ξ⟩ = Σⱼ ∫_{Gⱼ(Aⱼ)} θ ⟨ω(φ) ∘ Dφ, ξ⟩ = Σⱼ ∫_{Nⱼ} gⱼ ⟨ω, ηⱼ⟩`
    intro ω
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ω.property.1.1.continuous
    obtain ⟨C, hC⟩ := HasCompactSupport.exists_bound_of_continuous ω.property.1.2 hωc
    have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC 0)
    -- Step 1(c): `x ↦ θ(x) ⟨ω(φ(x)) ∘ Dφ(x), ξ(x)⟩` is `Hⁿ⌞M₁`-integrable, being bounded by
    -- `C Λⁿ θ` (`|⟨β, ξ⟩| ≤ ‖β‖` a.e. on `M`, `‖β ∘ Dφ‖ ≤ ‖β‖ ‖Dφ‖ⁿ`, `‖Dφ‖ ≤ Λ`)
    have hβ : Continuous fun x =>
        ((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x) := by
      have h := (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp
        (hφ.continuous_fderiv one_ne_zero)).clm_apply (hωc.comp hφ.continuous)
      simpa only [Function.comp_apply,
        ContinuousAlternatingMap.compContinuousLinearMapCLM_apply] using h
    have hθ : Measurable fun x => (R.mult x : ℝ) :=
      (measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult
    have hθi : Integrable (fun x => (R.mult x : ℝ)) (μHE[n].restrict (R.carrier ∩ K)) := by
      refine ⟨hθ.aestronglyMeasurable, ?_⟩
      show ∫⁻ x, ‖(R.mult x : ℝ)‖ₑ ∂(μHE[n].restrict (R.carrier ∩ K)) < ∞
      simp only [Real.enorm_natCast]
      exact lt_top_iff_ne_top.mpr hθM₁
    have hint : IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x
        (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)))
        (R.carrier ∩ K) μHE[n] := by
      refine Integrable.mono' (hθi.const_mul (C * (Λ : ℝ) ^ n))
        (hθ.aestronglyMeasurable.mul ?_) ?_
      · exact Continuous.comp_aestronglyMeasurable₂
          (g := fun (L : MultiVector P n) (α : Covector (Euclid P) n) => L α)
          (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid P) n) (F := ℝ)).continuous
          (R.aestronglyMeasurable_orient.mono_set inter_subset_left) hβ.aestronglyMeasurable
      · filter_upwards [ae_restrict_of_ae_restrict_of_subset inter_subset_left R.orients]
          with x hx
        obtain ⟨T, -, hT⟩ := hx
        have h1 := (Submission.dtc_bc_lc_pfi_unitOrientation_algebra P n).2.1 _ T hT
          (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x))
        have h2 := ContinuousAlternatingMap.norm_compContinuousLinearMap_le
          ((ω : DifferentialForm (Euclid P) n) (φ x)) (fderiv ℝ φ x)
        rw [Fintype.card_fin] at h2
        have h3 : ‖fderiv ℝ φ x‖ ^ n ≤ (Λ : ℝ) ^ n :=
          pow_le_pow_left₀ (norm_nonneg _) (norm_fderiv_le_of_lipschitz ℝ hφL) n
        rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs, mul_comm (C * (Λ : ℝ) ^ n)]
        gcongr
        exact h1.trans (h2.trans (mul_le_mul (hC _) h3 (by positivity) hC0))
    calc Q ω = ∫ x in R.carrier ∩ K, (R.mult x : ℝ) * R.orient x
          (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap
            (fderiv ℝ φ x)) ∂μHE[n] := by
          -- `Hⁿ(M ∖ K) = 0`, and `φ = f`, `Dφ = Df` on `M₁ ⊆ K`
          rw [hQ ω, setIntegral_congr_set (ae_eq_set.mpr
            ⟨by rw [sdiff_self_inter]; exact hMK,
              by rw [sdiff_eq_empty.mpr inter_subset_left, measure_empty]⟩)]
          refine setIntegral_congr_fun hM₁ fun x hx => ?_
          simp only [(hφK x hx.2).1, (hφK x hx.2).2]
      _ = ∫ x in ⋃ j, G j '' A j, (R.mult x : ℝ) * R.orient x
          (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap
            (fderiv ℝ φ x)) ∂μHE[n] :=
          -- the pieces cover `M₁` up to an `Hⁿ`-null set
          setIntegral_congr_set (ae_eq_set.mpr ⟨hnull,
            by rw [sdiff_eq_empty.mpr (iUnion_subset hGAM), measure_empty]⟩)
      _ = ∑' j, ∫ x in G j '' A j, (R.mult x : ℝ) * R.orient x
          (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap
            (fderiv ℝ φ x)) ∂μHE[n] :=
          integral_iUnion hGA hdisj (hint.mono_set (iUnion_subset hGAM))
      _ = ∑' j, ∫ y in N j, (g j y : ℝ) * η j y ((ω : DifferentialForm (Euclid P) n) y)
          ∂μHE[n] :=
          tsum_congr fun j => hNint j _ hωc.stronglyMeasurable

/-- **Push-forward by a map that is `C¹` near the support** (Simon Ch. 6, 2.23–2.24(2), 2.29 and
3.3–3.9).  Let `O` be open, `f` be `C¹` on `O` and `n = m + 1`.  For integer multiplicity
`Y ∈ 𝒟ₙ(ℝᴾ)` with `spt Y` compact and `⊆ O`, choose a representation `(M₀, θ₀, ξ₀)` and a `C¹` map
`φ`, the identity off a compact set, with `φ = f` and `Dφ = Df` on an open `V ⊇ spt Y`; put
`push Y(ω) = ∫_{M₀} θ₀ ⟨ω(φ(x)) ∘ ΛⁿDφ(x), ξ₀⟩ dHⁿ`, a current.  For every other `Y`,
`push Y = 0`.  As `Hⁿ(M₀ ∖ spt Y) = 0`, `f` may replace `φ` in the integrand.
(i) Every representation `(M, θ, ξ)` of `Y` gives the same integral: it is the limit of `Y(ωⱼ)`
for one sequence of test forms `ωⱼ`, chosen before the representation.
(ii) `push Y` is integer multiplicity by the area formula (Simon 3.5–3.9).
(iii) If `spt ω` misses the compact set `f(spt Y)`, the integrand vanishes `Hⁿ`-a.e. on `M`.
(iv) `|⟨ω(f(x)) ∘ ΛⁿDf(x), ξ⟩| ≤ |ω(f(x))|·‖Df(x)‖ⁿ` gives `M(push Y) ≤ Lⁿ M(Y)`.
(v) The formula with `φ` sends cycles to cycles (Simon 2.24(1)).
(B) `Y₁ − Y₂` is integer multiplicity with compact support in `spt Y₁ ∪ spt Y₂ ⊆ O`, and the three
integrals are the limits of `(Y₁ − Y₂)(ωⱼ) = Y₁(ωⱼ) − Y₂(ωⱼ)`, `Y₁(ωⱼ)` and `Y₂(ωⱼ)`. -/
theorem Submission.dtc_bc_lc_pushforward : ∀ (P m : ℕ) (O : Set (Euclid P)) (f : Euclid P → Euclid P), IsOpen O → ContDiffOn ℝ 1 f O → ∃ push : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents Y → IsCompact Y.support → Y.support ⊆ O → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), push Y ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity (push Y) ∧ (push Y).support ⊆ f '' Y.support ∧ (∀ L : ℝ, (∀ y ∈ O, ‖fderiv ℝ f y‖ ≤ L) → (push Y).mass ≤ ENNReal.ofReal (L ^ (m + 1)) * Y.mass) ∧ (Y.boundary = 0 → (push Y).boundary = 0)) ∧ ∀ Y₁ Y₂ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Y₁ → IsIntegerMultiplicity Y₂ → IsCompact Y₁.support → Y₁.support ⊆ O → IsCompact Y₂.support → Y₂.support ⊆ O → push (Y₁ - Y₂) = push Y₁ - push Y₂ := by
  intro P m O f hO hf
  -- Step 1: `Hⁿ(M ∖ spt Y) = 0`, so `Hⁿ`-a.e. point of the carrier lies in `spt Y`
  have hcf := Submission.dtc_bc_lc_pf_imrep_carrier_mass_support P (m + 1)
  have hspt : ∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents Y →
      ∀ᵐ x ∂(μHE[m + 1].restrict R.carrier), x ∈ Y.support := by
    intro Y R hR
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    refine measure_mono_null (fun x hx => ?_) (hcf.1 Y R hR).1
    exact ⟨hx.2, hx.1⟩
  -- Step 2: for `Y ∈ 𝒴`, a representation `R₀` and a cut-off `φ` of `f` near `spt Y` define
  -- `push Y` by the formula with `φ` (a current); `push Y = 0` otherwise
  have key : ∀ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
      ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
        IsIntegerMultiplicity Y → IsCompact Y.support → Y.support ⊆ O →
          ∃ (R₀ : IMRep (univ : Set (Euclid P)) (m + 1)) (φ : Euclid P → Euclid P)
            (V K' : Set (Euclid P)), R₀.Represents Y ∧ Y.support ⊆ V ∧ IsCompact K' ∧
            ContDiff ℝ 1 φ ∧ (∀ x ∈ V, φ x = f x ∧ fderiv ℝ φ x = fderiv ℝ f x) ∧
            (∀ x, x ∉ K' → φ x = x) ∧
            ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), S ω = ∫ x in R₀.carrier,
              (R₀.mult x : ℝ) * R₀.orient x (((ω : DifferentialForm (Euclid P) (m + 1))
                (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[m + 1] := by
    intro Y
    by_cases hY : IsIntegerMultiplicity Y ∧ IsCompact Y.support ∧ Y.support ⊆ O
    · obtain ⟨⟨R₀, hR₀⟩, hK, hKO⟩ := hY
      obtain ⟨φ, V, K', -, hKV, hK', hφ, hφf, hφK'⟩ :=
        Submission.dtc_bc_lc_pf_c1_compact_perturbation P O Y.support f hO hK hKO hf
      obtain ⟨S, hS⟩ := Submission.dpf_pushforward_formula_current_exists P (m + 1) univ K' R₀ φ
        hK' (subset_univ _) hφ hφK'
      exact ⟨S, fun _ _ _ => ⟨R₀, φ, V, K', hR₀, hKV, hK', hφ, hφf, hφK', hS⟩⟩
    · exact ⟨0, fun h₁ h₂ h₃ => absurd ⟨h₁, h₂, h₃⟩ hY⟩
  choose push hpush using key
  -- Step 3 (i): the formula with `f`, for every representation of `Y`
  have hform : ∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents Y → IsCompact Y.support →
      Y.support ⊆ O → ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), push Y ω =
        ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) (m + 1))
          (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[m + 1] := by
    intro Y R hR hK hKO ω
    obtain ⟨R₀, φ, V, K', hR₀, hKV, -, -, hφf, -, hS⟩ := hpush Y ⟨R, hR⟩ hK hKO
    -- `φ = f` and `Dφ = Df` on `V ⊇ spt Y`, which contains `Hⁿ`-a.e. point of `M₀`
    have h₀ : push Y ω = ∫ x in R₀.carrier, (R₀.mult x : ℝ) * R₀.orient x
        (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap
          (fderiv ℝ f x)) ∂μHE[m + 1] := by
      rw [hS ω]
      refine integral_congr_ae ?_
      filter_upwards [hspt Y R₀ hR₀] with x hx
      rw [(hφf x (hKV hx)).1, (hφf x (hKV hx)).2]
    -- both integrals are limits of `Y(ωⱼ)` for one sequence `ωⱼ`
    obtain ⟨ωs, hωs⟩ := Submission.dtc_bc_lc_pf_pullback_integral_extension P (m + 1) O Y.support
      f ω hO hf hK hKO
    rw [h₀]
    exact tendsto_nhds_unique (hωs Y R₀ hR₀ subset_rfl) (hωs Y R hR subset_rfl)
  refine ⟨push, fun Y R hR hK hKO => ⟨hform Y R hR hK hKO, ?_, ?_, ?_, ?_⟩, ?_⟩
  · -- Step 4 (ii): integer multiplicity by the area formula, with tangent locality from the
    -- integer multiplicity calculus (`↔` reversed)
    exact Submission.dtc_bc_lc_pf_pushforward_isIntegerMultiplicity
      (fun P n U A B hU hA hB hAB hBU hfin =>
        (Submission.cmc_imRep_locality_restrict_sub.1 P n U A B hU hA hB hAB hBU hfin).mono
          fun x hx Q => (hx Q).symm)
      P (m + 1) univ Y.support O R f (push Y) isOpen_univ (Nat.succ_pos m) hK (subset_univ _)
      (hcf.1 Y R hR).1 hO hKO hf (subset_univ _) (hform Y R hR hK hKO)
  · -- Step 5 (iii): if `spt ω` misses the compact set `f(spt Y)`, then `ω(f(x)) = 0` for
    -- `Hⁿ`-a.e. `x ∈ M`, so `push Y(ω) = 0`
    have hfK : IsCompact (f '' Y.support) := hK.image_of_continuousOn (hf.continuousOn.mono hKO)
    refine (Submission.rsd_cmr_support_subset_of_vanish P (m + 1) univ (f '' Y.support) (push Y)
      isOpen_univ hfK (subset_univ _) fun ω hω => ?_).1
    rw [hform Y R hR hK hKO ω]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [hspt Y R hR] with x hx
    have h0 : (ω : DifferentialForm (Euclid P) (m + 1)) (f x) = 0 :=
      image_eq_zero_of_notMem_tsupport (Set.disjoint_right.1 hω (mem_image_of_mem f hx))
    have h0' : ((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap
        (fderiv ℝ f x) = 0 := by
      ext v
      simp [h0]
    simp [h0']
  · -- Step 6 (iv): the mass bound
    intro L hL
    exact Submission.dtc_bc_lc_pf_pushforward_mass_le P (m + 1) O f L Y (push Y) R hL hR hK hKO
      (hform Y R hR hK hKO)
  · -- Step 7 (v): `push Y` is given by the formula with `φ`, which preserves cycles
    intro hYb
    obtain ⟨R₀, φ, V, K', hR₀, -, hK', hφ, -, hφK', hS⟩ := hpush Y ⟨R, hR⟩ hK hKO
    exact Submission.dpf_pushforward_formula_boundaryVanishes P (m + 1) univ K' Y (push Y) R₀ φ
      isOpen_univ hR₀ hK' (subset_univ _) hφ hφK' hS hYb
  · -- Step 8 (B): `Y₁ − Y₂ ∈ 𝒴`, and all three formulas are limits along one sequence `ωⱼ`
    intro Y₁ Y₂ hY₁ hY₂ hK₁ hKO₁ hK₂ hKO₂
    obtain ⟨R₁₂, hR₁₂⟩ := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ Y₁ Y₂
      isOpen_univ hY₁ hY₂
    obtain ⟨R₁, hR₁⟩ := hY₁
    obtain ⟨R₂, hR₂⟩ := hY₂
    have hsub : (Y₁ - Y₂).support ⊆ Y₁.support ∪ Y₂.support := (hcf.2 Y₁ Y₂).2
    have hK₁₂ : IsCompact (Y₁ - Y₂).support :=
      (hK₁.union hK₂).of_isClosed_subset (hcf.2 (Y₁ - Y₂) Y₂).1 hsub
    have hKO₁₂ : (Y₁ - Y₂).support ⊆ O := hsub.trans (union_subset hKO₁ hKO₂)
    ext ω
    obtain ⟨ωs, hωs⟩ := Submission.dtc_bc_lc_pf_pullback_integral_extension P (m + 1) O
      (Y₁.support ∪ Y₂.support) f ω hO hf (hK₁.union hK₂) (union_subset hKO₁ hKO₂)
    have h₁ := hωs Y₁ R₁ hR₁ subset_union_left
    have h₂ := hωs Y₂ R₂ hR₂ subset_union_right
    have h₁₂ := hωs (Y₁ - Y₂) R₁₂ hR₁₂ hsub
    rw [← hform Y₁ R₁ hR₁ hK₁ hKO₁ ω] at h₁
    rw [← hform Y₂ R₂ hR₂ hK₂ hKO₂ ω] at h₂
    rw [← hform (Y₁ - Y₂) R₁₂ hR₁₂ hK₁₂ hKO₁₂ ω] at h₁₂
    exact tendsto_nhds_unique h₁₂ (h₁.sub h₂)
/-- Comparison of measures from open subsets, by outer regularity (Simon 1.15(1)): if
`μ(ℝᴾ \ U) = 0`, `ν` is finite on compact subsets of the open set `U`, and `μ(V) ≤ ν(V)` for every
open `V ⊆ U`, then `μ ≤ ν`.  `U` is exhausted by the open sets
`V_k = {‖x‖ < k, 1/k < d(x, ℝᴾ \ U)}`, each inside the compact `K_k ⊆ U`; `ν⌞V_k` is finite,
hence outer regular, which gives `μ(E ∩ V_k) ≤ ν(E ∩ V_k)`; continuity from below finishes. -/
theorem Submission.dtc_bc_lc_measure_le_of_le_on_open : ∀ (P : ℕ) (U : Set (Euclid P)) (μ ν : Measure (Euclid P)), IsOpen U → μ Uᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ν K < ∞) → (∀ V : Set (Euclid P), IsOpen V → V ⊆ U → μ V ≤ ν V) → μ ≤ ν := by
  intro P U μ ν hU hμU hν hle
  -- Steps 1–3: the exhaustion `V k ⊆ K k ⊆ U`, `V` increasing with union `U`
  set V : ℕ → Set (Euclid P) :=
    fun k => {x | ‖x‖ < k ∧ (k : ℝ≥0∞)⁻¹ < infEDist x Uᶜ}
  set K : ℕ → Set (Euclid P) :=
    fun k => {x | ‖x‖ ≤ k ∧ (k : ℝ≥0∞)⁻¹ ≤ infEDist x Uᶜ}
  have hVopen : ∀ k, IsOpen (V k) := fun k =>
    (isOpen_lt continuous_norm continuous_const).inter
      (isOpen_lt continuous_const continuous_infEDist)
  have hKcpt : ∀ k, IsCompact (K k) := fun k => by
    refine isCompact_of_isClosed_isBounded ?_ ?_
    · exact (isClosed_le continuous_norm continuous_const).inter
        (isClosed_le continuous_const continuous_infEDist)
    · refine (isBounded_closedBall (x := (0 : Euclid P)) (r := (k : ℝ))).subset ?_
      intro x hx
      simpa [mem_closedBall, dist_zero_right] using hx.1
  have hKU : ∀ k, K k ⊆ U := fun k x hx => by
    by_contra hxU
    have h0 : infEDist x Uᶜ = 0 := infEDist_zero_of_mem hxU
    have h1 : (k : ℝ≥0∞)⁻¹ ≤ 0 := h0 ▸ hx.2
    exact (ENNReal.inv_ne_zero.mpr (ENNReal.natCast_ne_top k)) (nonpos_iff_eq_zero.mp h1)
  have hVK : ∀ k, V k ⊆ K k := fun k x hx => ⟨hx.1.le, hx.2.le⟩
  have hVmono : Monotone V := fun k m hkm x hx =>
    ⟨lt_of_lt_of_le hx.1 (by exact_mod_cast hkm),
      lt_of_le_of_lt (ENNReal.inv_le_inv.mpr (by exact_mod_cast hkm)) hx.2⟩
  have hVU : ⋃ k, V k = U := by
    apply subset_antisymm
    · exact iUnion_subset fun k => (hVK k).trans (hKU k)
    · intro x hx
      have hpos : 0 < infEDist x Uᶜ := by
        rw [infEDist_pos_iff_notMem_closure, hU.isClosed_compl.closure_eq]
        exact fun h => h hx
      obtain ⟨a, ha⟩ := ENNReal.exists_inv_nat_lt hpos.ne'
      obtain ⟨b, hb⟩ := exists_nat_gt ‖x‖
      refine mem_iUnion.mpr ⟨max a b, ?_, ?_⟩
      · exact lt_of_lt_of_le hb (by exact_mod_cast le_max_right a b)
      · exact lt_of_le_of_lt (ENNReal.inv_le_inv.mpr (by exact_mod_cast le_max_left a b)) ha
  -- Step 4: `ν (V k) < ∞`
  have hνV : ∀ k, ν (V k) ≠ ∞ := fun k =>
    ne_of_lt (lt_of_le_of_lt (measure_mono (hVK k)) (hν _ (hKcpt k) (hKU k)))
  -- Step 5: comparison inside `V k`, by outer regularity of the finite measure `ν⌞V k`
  have hcomp : ∀ k (E : Set (Euclid P)), μ (E ∩ V k) ≤ ν (E ∩ V k) := by
    intro k E
    have : IsFiniteMeasure (ν.restrict (V k)) := isFiniteMeasure_restrict.mpr (hνV k)
    refine le_of_forall_gt fun r hr => ?_
    rw [← Measure.restrict_apply' (hVopen k).measurableSet] at hr
    obtain ⟨O, hEO, hO, hOr⟩ := Set.exists_isOpen_lt_of_lt E r hr
    rw [Measure.restrict_apply' (hVopen k).measurableSet] at hOr
    calc μ (E ∩ V k) ≤ μ (O ∩ V k) := measure_mono (inter_subset_inter_left _ hEO)
      _ ≤ ν (O ∩ V k) := hle _ (hO.inter (hVopen k))
          (inter_subset_right.trans ((hVK k).trans (hKU k)))
      _ < r := hOr
  -- Steps 6–8: concentration on `U`, continuity from below, `Measure.le_iff`
  rw [Measure.le_iff]
  intro E hE
  calc μ E = μ (E ∩ U) := by
        have h := measure_inter_add_sdiff E hU.measurableSet (μ := μ)
        have h2 : μ (E \ U) = 0 := measure_mono_null (fun x hx => hx.2) hμU
        rw [h2, add_zero] at h
        exact h.symm
    _ = ⨆ k, μ (E ∩ V k) := by
        rw [← hVU, inter_iUnion]
        exact Monotone.measure_iUnion fun k m hkm => inter_subset_inter_right E (hVmono hkm)
    _ ≤ ν E := iSup_le fun k => (hcomp k E).trans (measure_mono inter_subset_left)

/-- **Subadditivity of weights** (Simon 6.2.5 and 6.3.2(3), as used in the proof of 7.2.4).  If
`|c| ≤ 1` and `Z(ω) = X(ω) + c Y(ω)` for every `ω ∈ 𝒟ⁿ(U)`, then `μ_Z ≤ μ_X + μ_Y`.  For open
`V ⊆ U`, `μ_Z(V) = M_V(Z) ≤ M_V(X) + M_V(Y) = μ_X(V) + μ_Y(V)` by the mass triangle inequality
and `M_V = μ(V)`.  As `M_Z ⊆ U`, `μ_Z` is concentrated on `U`, and `μ_X + μ_Y` is finite on
compact subsets of `U`; so the inequality extends from open subsets of `U` to all sets. -/
theorem Submission.dtc_bc_lc_measure_le_add : ∀ (P n : ℕ) (U : Set (Euclid P)) (X Y Z : GeometricCurrentOn U n) (RX RY RZ : IMRep U n) (c : ℝ), IsOpen U → |c| ≤ 1 → RX.Represents X → RY.Represents Y → RZ.Represents Z → (∀ ω : TestFormOn U n, Z ω = X ω + c * Y ω) → RZ.measure ≤ RX.measure + RY.measure := by
  intro P n U X Y Z RX RY RZ c hU hc hRX hRY hRZ hZ
  obtain ⟨-, -, -, -, hXK, -, -⟩ := Submission.cbr_imRep_measure_basic P n U RX
  obtain ⟨-, -, -, -, hYK, -, -⟩ := Submission.cbr_imRep_measure_basic P n U RY
  obtain ⟨-, -, -, hZM, -, -, -⟩ := Submission.cbr_imRep_measure_basic P n U RZ
  refine Submission.dtc_bc_lc_measure_le_of_le_on_open P U RZ.measure (RX.measure + RY.measure)
    hU ?_ ?_ ?_
  -- Step 3: `μ_Z(ℝᴾ \ U) ≤ μ_Z(ℝᴾ \ M_Z) = 0`, as `M_Z ⊆ U`
  · exact measure_mono_null (compl_subset_compl.2 RZ.carrier_subset) hZM
  -- Step 4: `μ_X(K) + μ_Y(K) < ∞` for compact `K ⊆ U`
  · intro K hK hKU
    rw [Measure.add_apply]
    exact ENNReal.add_lt_top.2 ⟨hXK K hK hKU, hYK K hK hKU⟩
  -- Steps 1–2: `μ_Z(V) = M_V(Z) ≤ M_V(X) + M_V(Y) = μ_X(V) + μ_Y(V)` for open `V ⊆ U`
  · intro V hV hVU
    calc RZ.measure V = Z.massOn V :=
          (Submission.dtc_mass_eq_measure P n U V Z RZ hU hV hVU hRZ).symm
      _ ≤ X.massOn V + Y.massOn V :=
          Submission.lcmp_massOn_le_add_of_eval_eq P n U V X Y Z c hc fun ω _ => hZ ω
      _ = (RX.measure + RY.measure) V := by
          rw [Measure.add_apply, Submission.dtc_mass_eq_measure P n U V X RX hU hV hVU hRX,
            Submission.dtc_mass_eq_measure P n U V Y RY hU hV hVU hRY]

/-- **Simon 7.2.4, local comparison: retraction estimate.**  Let `n = m + 1`, `S ∈ 𝒟ₙ(U)` be
minimizing in `A` with `spt S ⊆ A`, `B̄_G ⊆ U`, and let `π` be `C¹` and `L`-Lipschitz on `B_{2G}`,
with `π(B_{2G}) ⊆ A`, `π = id` on `A ∩ B_{2G}` and `|π(y)| ≤ 2|y|`.  If `Y ∈ 𝒟ₙ(ℝᴾ)` is an integer
multiplicity cycle with compact support in `B_{G/2}`, then `M_{B_G}(S) ≤ Lⁿ M_{B_G}(S + Y)`.
Here `‖Dπ‖ ≤ L` on `B_{2G}`, and `Q = S⌞B_G` is an integer multiplicity current in `ℝᴾ` with
compact support in `B̄_G ∩ spt S ⊆ A`.  `π` fixes `spt Q`, so `π_#Q = Q` and
`π_#(Q + Y) = Q + π_#Y`.  `π_#Y` is an integer multiplicity cycle supported in the compact set
`π(spt Y) ⊆ A ∩ B_G`, so minimality (7.2.4 (9)) gives `M_{B_G}(S) ≤ M_{B_G}(S + π_#Y)`, and
`M_{B_G}(S + π_#Y) = M_{B_G}(π_#(Q + Y)) ≤ Lⁿ M(Q + Y)`.  Finally `μ_{Q+Y} ≤ μ_Q + μ_Y` vanishes
off `B_G`, so `M(Q + Y) = M_{B_G}(Q + Y) = M_{B_G}(S + Y)`. -/
theorem Submission.dtc_bc_lc_retraction_comparison : ∀ (P m : ℕ) (U A : Set (Euclid P)) (S : GeometricCurrentOn U (m + 1)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (π : Euclid P → Euclid P) (G L : ℝ), IsOpen U → IsMinimizingIn S A → S.support ⊆ A → 0 < G → closedBall (0 : Euclid P) G ⊆ U → 0 ≤ L → ContDiffOn ℝ 1 π (ball 0 (2 * G)) → MapsTo π (ball 0 (2 * G)) A → (∀ y ∈ A ∩ ball 0 (2 * G), π y = y) → (∀ y ∈ ball 0 (2 * G), ‖π y‖ ≤ 2 * ‖y‖) → (∀ y ∈ ball 0 (2 * G), ∀ z ∈ ball 0 (2 * G), ‖π y - π z‖ ≤ L * ‖y - z‖) → IsIntegerMultiplicity Y → Y.boundary = 0 → IsCompact Y.support → Y.support ⊆ ball 0 (G / 2) → S.massOn (ball 0 G) ≤ ENNReal.ofReal (L ^ (m + 1)) * (S - (0 - Y.restrictDomain (subset_univ U))).massOn (ball 0 G) := by
  -- the children and the sibling prerequisites used below
  have hPF := Submission.dtc_bc_lc_pushforward
  have hRestr := Submission.dtc_bc_lc_rc_ambient_restriction
  have hComp := Submission.dtc_bc_lc_rc_cycle_competitor
  have hOF := Submission.dtc_bc_lc_orient_fixed
  have hF4 := Submission.dtc_bc_lc_measure_le_add
  have hM := Submission.dtc_mass_eq_measure
  have hV := Submission.dtc_vanish_off_support
  have hIM := Submission.cmc_imRep_locality_restrict_sub
  have hSV := Submission.rsd_cmr_support_subset_of_vanish
  have hAG := Submission.dtc_massOn_eq_of_agreeOn
  intro P m U A S Y π G L hU hmin hsptS hG hGU hL hπC hπA hπfix hπ2 hπLip hYim hYbd hYcpt hYsub
  -- `B_G` is open with `closure B_G = B̄_G ⊆ U` compact; `B̄_G ⊆ B_{2G}`
  have hBopen : IsOpen (ball (0 : Euclid P) G) := isOpen_ball
  have hclos : closure (ball (0 : Euclid P) G) = closedBall 0 G := closure_ball 0 hG.ne'
  have hBcc : CompactlyContained (ball (0 : Euclid P) G) U := by
    refine ⟨?_, ?_⟩
    · rw [hclos]; exact isCompact_closedBall 0 G
    · rw [hclos]; exact hGU
  have hBU : ball (0 : Euclid P) G ⊆ U := ball_subset_closedBall.trans hGU
  have hO : IsOpen (ball (0 : Euclid P) (2 * G)) := isOpen_ball
  have hcb2 : closedBall (0 : Euclid P) G ⊆ ball 0 (2 * G) := closedBall_subset_ball (by linarith)
  have hBB2 : ball (0 : Euclid P) G ⊆ ball 0 (2 * G) := ball_subset_ball (by linarith)
  -- Step 1: `‖Dπ(y)‖ ≤ L` on `B_{2G}`, as `π` is `L`-Lipschitz on this open ball
  have hDπ : ∀ y ∈ ball (0 : Euclid P) (2 * G), ‖fderiv ℝ π y‖ ≤ L := by
    intro y hy
    have hlip : LipschitzOnWith (Real.toNNReal L) π (ball (0 : Euclid P) (2 * G)) := by
      apply LipschitzOnWith.of_dist_le_mul
      intro a ha b hb
      rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ hL]
      exact hπLip a ha b hb
    have := norm_fderiv_le_of_lipschitzOn ℝ (hO.mem_nhds hy) hlip
    simpa [Real.coe_toNNReal _ hL] using this
  -- Step 2: `Q = S⌞B_G` in `ℝᴾ`, represented by `(M ∩ B_G, θ, ξ)`, agreeing with `S` on forms
  -- supported in `B_G`, with compact support in `B̄_G ∩ spt S ⊆ A ∩ B_{2G}`
  obtain ⟨R, hR⟩ := hmin.1
  obtain ⟨Q, RQ, hRQ, hRQc, -, -, hQ1, hQsupp, hQcpt⟩ :=
    hRestr P (m + 1) U (ball 0 G) S R hU hBopen hBcc hR
  have hQsub : Q.support ⊆ ball (0 : Euclid P) (2 * G) := by
    intro y hy
    have h1 := (hQsupp hy).1
    rw [hclos] at h1
    exact hcb2 h1
  have hQA : Q.support ⊆ A := fun y hy => hsptS (hQsupp hy).2
  -- Step 3: the push-forward `π_#` on currents with compact support in `B_{2G}`; `π_#Q = Q`,
  -- since `π x = x` and `ΛⁿDπ(x)` fixes `ξ(x)` for a.e. `x ∈ M ∩ B_G`
  obtain ⟨push, hpushA, hpushB⟩ := hPF P m (ball 0 (2 * G)) π hO hπC
  have hYsub2 : Y.support ⊆ ball (0 : Euclid P) (2 * G) :=
    hYsub.trans (ball_subset_ball (by linarith))
  have hpQ : push Q = Q := by
    have hfix := hOF P (m + 1) univ (ball 0 (2 * G)) Q RQ π isOpen_univ hO hRQ
      (hπC.differentiableOn one_ne_zero) (fun y hy => hπfix y ⟨hQA hy.1, hy.2⟩)
    have hcar : RQ.carrier ∩ ball 0 (2 * G) = RQ.carrier := by
      rw [hRQc]
      exact inter_eq_left.mpr (fun x hx => hBB2 hx.2)
    rw [hcar] at hfix
    obtain ⟨hformula, -⟩ := hpushA Q RQ hRQ hQcpt hQsub
    ext ω
    rw [hformula ω, hRQ ω]
    unfold IMRep.action
    apply integral_congr_ae
    filter_upwards [hfix] with x hx
    rw [hx.1, hx.2]
  -- Step 4: additivity, `π_#0 = 0`, `π_#(0 − Y) = 0 − π_#Y` and `π_#(Q + Y) = Q + π_#Y`
  have h0im : IsIntegerMultiplicity (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) := by
    have h := hIM.2.2.1 P (m + 1) univ Y Y isOpen_univ hYim hYim
    have h' : Y - Y = 0 := by
      ext ω
      show Y ω - Y ω = 0
      ring
    rwa [h'] at h
  have h0spt := hSV P (m + 1) univ ∅ (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
    isOpen_univ isCompact_empty (empty_subset _) (fun ω _ => rfl)
  have h0sub : (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)).support ⊆
      ball 0 (2 * G) := h0spt.1.trans (empty_subset _)
  have hp0 : push 0 = 0 := by
    have h := hpushB 0 0 h0im h0im h0spt.2 h0sub h0spt.2 h0sub
    have h00 : (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) - 0 = 0 := by
      ext ω
      show (0 : ℝ) - 0 = 0
      ring
    rw [h00] at h
    ext ω
    have hω := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => T ω) h
    change push 0 ω = push 0 ω - push 0 ω at hω
    show push 0 ω = 0
    linarith
  have hnYim : IsIntegerMultiplicity (0 - Y) := hIM.2.2.1 P (m + 1) univ 0 Y isOpen_univ h0im hYim
  have hnYspt := hSV P (m + 1) univ Y.support (0 - Y) isOpen_univ hYcpt (subset_univ _)
    (fun ω hω => by
      show (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) ω - Y ω = 0
      rw [hV P (m + 1) univ Y ω hω, sub_zero]
      rfl)
  have hpnY : push (0 - Y) = 0 - push Y := by
    rw [hpushB 0 Y h0im hYim h0spt.2 h0sub hYcpt hYsub2, hp0]
  have hQYim : IsIntegerMultiplicity (Q - (0 - Y)) :=
    hIM.2.2.1 P (m + 1) univ Q (0 - Y) isOpen_univ ⟨RQ, hRQ⟩ hnYim
  have hQYspt := hSV P (m + 1) univ (Q.support ∪ Y.support) (Q - (0 - Y)) isOpen_univ
    (hQcpt.union hYcpt) (subset_univ _) (fun ω hω => by
      have h1 := hV P (m + 1) univ Q ω (Disjoint.mono_right subset_union_left hω)
      have h2 := hV P (m + 1) univ Y ω (Disjoint.mono_right subset_union_right hω)
      show Q ω - ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) ω - Y ω) = 0
      rw [h1, h2]
      show (0 : ℝ) - (0 - 0) = 0
      ring)
  have hQYsub : (Q - (0 - Y)).support ⊆ ball 0 (2 * G) :=
    hQYspt.1.trans (union_subset hQsub hYsub2)
  have hpQY : push (Q - (0 - Y)) = Q - (0 - push Y) := by
    rw [hpushB Q (0 - Y) ⟨RQ, hRQ⟩ hnYim hQcpt hQsub hnYspt.2 (hnYspt.1.trans hYsub2), hpQ, hpnY]
  -- Step 5: `π_#Y` is an integer multiplicity cycle supported in the compact set
  -- `π(spt Y) ⊆ A ∩ B_G`, so minimality gives `M_{B_G}(S) ≤ M_{B_G}(S + (π_#Y)|_U)`
  obtain ⟨RY, hRY⟩ := hYim
  obtain ⟨-, hpYim, hpYspt, -, hpYbd⟩ := hpushA Y RY hRY hYcpt hYsub2
  have hKcpt : IsCompact (π '' Y.support) :=
    hYcpt.image_of_continuousOn (hπC.continuousOn.mono hYsub2)
  have hKsub : π '' Y.support ⊆ A ∩ ball 0 G := by
    rintro _ ⟨y, hy, rfl⟩
    have hy2 := hYsub2 hy
    refine ⟨hπA hy2, ?_⟩
    have h1 := hπ2 y hy2
    have h2 : ‖y‖ < G / 2 := by simpa using hYsub hy
    rw [mem_ball_zero_iff]
    linarith
  have hcomp := hComp P m U A (ball 0 G) (π '' Y.support) S (push Y) hU hmin hBopen hBcc hpYim
    (hpYbd hYbd) hKcpt hpYspt hKsub
  -- Step 6(a): `M_{B_G}(S + (π_#Y)|_U) = M_{B_G}(π_#(Q + Y))`, by (Q1)
  have h6a : (S - (0 - (push Y).restrictDomain (subset_univ U))).massOn (ball 0 G) =
      (push (Q - (0 - Y))).massOn (ball 0 G) := by
    symm
    apply hAG P (m + 1) univ U (ball 0 G) (subset_univ U) (push (Q - (0 - Y))) _ hBU
    intro ω hω
    rw [hpQY]
    show Q (testFormOnInclusion (subset_univ U) (m + 1) ω) -
        ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
          (testFormOnInclusion (subset_univ U) (m + 1) ω) -
          push Y (testFormOnInclusion (subset_univ U) (m + 1) ω)) =
      S ω - ((0 : GeometricCurrentOn U (m + 1)) ω -
        push Y (testFormOnInclusion (subset_univ U) (m + 1) ω))
    rw [hQ1 ω hω]
    rfl
  -- Step 6(b): `M(π_#(Q + Y)) ≤ Lⁿ M(Q + Y)`
  obtain ⟨RQY, hRQY⟩ := hQYim
  obtain ⟨-, -, -, hpmass, -⟩ := hpushA (Q - (0 - Y)) RQY hRQY hQYspt.2 hQYsub
  have h6b := hpmass L hDπ
  -- Step 6(c): `μ_{Q+Y} ≤ μ_Q + μ_Y` vanishes off `B_G`, so `M(Q + Y) = M_{B_G}(Q + Y)`
  have hF := hF4 P (m + 1) univ Q Y (Q - (0 - Y)) RQ RY RQY 1 isOpen_univ (by simp) hRQ hRY hRQY
    (fun ω => by
      show Q ω - ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) ω - Y ω) = Q ω + 1 * Y ω
      rw [GeometricCurrentOn.zero_apply]
      ring)
  have hQc : RQ.measure (ball (0 : Euclid P) G)ᶜ = 0 := by
    unfold IMRep.measure
    apply withDensity_absolutelyContinuous
    rw [Measure.restrict_apply measurableSet_ball.compl, hRQc]
    have : (ball (0 : Euclid P) G)ᶜ ∩ (R.carrier ∩ ball 0 G) = ∅ := by
      ext x
      simp only [mem_inter_iff, mem_compl_iff, mem_empty_iff_false, iff_false, not_and]
      intro h1 _ h2
      exact h1 h2
    rw [this, measure_empty]
  have hYc : RY.measure (ball (0 : Euclid P) G)ᶜ = 0 := by
    have h1 : RY.measure (Y.support)ᶜ = 0 := by
      rw [← hM P (m + 1) univ (Y.support)ᶜ Y RY isOpen_univ hYcpt.isClosed.isOpen_compl
        (subset_univ _) hRY]
      apply le_zero_iff.mp
      apply sSup_le
      rintro r ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (Y ω) ≤ 0
      rw [hV P (m + 1) univ Y ω (Set.subset_compl_iff_disjoint_right.mp hω.1),
        ENNReal.ofReal_zero]
    apply measure_mono_null _ h1
    exact compl_subset_compl.mpr (hYsub.trans (ball_subset_ball (by linarith)))
  have hQYc : RQY.measure (ball (0 : Euclid P) G)ᶜ = 0 := by
    have h := Measure.le_iff'.mp hF (ball (0 : Euclid P) G)ᶜ
    rw [Measure.add_apply, hQc, hYc, add_zero] at h
    exact le_zero_iff.mp h
  have h6c : (Q - (0 - Y)).mass = (Q - (0 - Y)).massOn (ball 0 G) := by
    show (Q - (0 - Y)).massOn univ = (Q - (0 - Y)).massOn (ball 0 G)
    rw [hM P (m + 1) univ univ (Q - (0 - Y)) RQY isOpen_univ isOpen_univ subset_rfl hRQY,
      hM P (m + 1) univ (ball 0 G) (Q - (0 - Y)) RQY isOpen_univ hBopen (subset_univ _) hRQY,
      ← measure_add_measure_compl (measurableSet_ball : MeasurableSet (ball (0 : Euclid P) G)),
      hQYc, add_zero]
  -- Step 6(d): `M_{B_G}(Q + Y) = M_{B_G}(S + Y|_U)`, by (Q1)
  have h6d : (Q - (0 - Y)).massOn (ball 0 G) =
      (S - (0 - Y.restrictDomain (subset_univ U))).massOn (ball 0 G) := by
    apply hAG P (m + 1) univ U (ball 0 G) (subset_univ U) (Q - (0 - Y)) _ hBU
    intro ω hω
    show Q (testFormOnInclusion (subset_univ U) (m + 1) ω) -
        ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
          (testFormOnInclusion (subset_univ U) (m + 1) ω) -
          Y (testFormOnInclusion (subset_univ U) (m + 1) ω)) =
      S ω - ((0 : GeometricCurrentOn U (m + 1)) ω -
        Y (testFormOnInclusion (subset_univ U) (m + 1) ω))
    rw [hQ1 ω hω]
    rfl
  -- Step 7: the chain of inequalities
  calc S.massOn (ball 0 G)
      ≤ (S - (0 - (push Y).restrictDomain (subset_univ U))).massOn (ball 0 G) := hcomp
    _ = (push (Q - (0 - Y))).massOn (ball 0 G) := h6a
    _ ≤ (push (Q - (0 - Y))).mass := GeometricCurrentOn.massOn_mono _ (subset_univ _)
    _ ≤ ENNReal.ofReal (L ^ (m + 1)) * (Q - (0 - Y)).mass := h6b
    _ = ENNReal.ofReal (L ^ (m + 1)) * (Q - (0 - Y)).massOn (ball 0 G) := by rw [h6c]
    _ = ENNReal.ofReal (L ^ (m + 1)) *
        (S - (0 - Y.restrictDomain (subset_univ U))).massOn (ball 0 G) := by rw [h6d]
/-- **Simon 7.2.4, proof (3)–(5)** (choice of the level `α`): given countably many properties of
`t ∈ ℝ`, each holding for `L¹`-a.e. `t`, functions `gᵢ ≥ 0` on `(a, b)` with
`Σᵢ ∫_{(a,b)} gᵢ < ∞`, and measures `μᵢ` with `μᵢ{a < h < b} < ∞`, some `t ∈ (a, b)` satisfies
every property, has `Σᵢ gᵢ(t) < ∞` and `μᵢ{h = t} = 0` for all `i`.  The failures of the
properties form a null set; `Σᵢ gᵢ` has finite integral over `(a, b)`, hence is finite a.e.;
the disjoint level sets `{h = t}` carry mass of the finite measure `μᵢ⌞{a < h < b}` for at most
countably many `t`; and `(a, b)` has positive measure. -/
theorem Submission.dtc_bc_lc_good_level : ∀ (P : ℕ) (g : ℕ → ℝ → ℝ≥0∞) (μ : ℕ → Measure (Euclid P)) (h : Euclid P → ℝ) (good : ℕ → ℝ → Prop) (a b : ℝ), a < b → Measurable h → (∀ i, AEMeasurable (g i) (volume.restrict (Ioo a b))) → (∑' i, ∫⁻ t in Ioo a b, g i t) ≠ ∞ → (∀ i, μ i {x | a < h x ∧ h x < b} ≠ ∞) → (∀ i, ∀ᵐ t, good i t) → ∃ t ∈ Ioo a b, (∀ i, good i t) ∧ (∑' i, g i t) ≠ ∞ ∧ ∀ i, μ i {x | h x = t} = 0 := by
  intro P g μ h good a b hab hh hg hsum hμ hgood
  set S : Set (Euclid P) := {x | a < h x ∧ h x < b}
  -- for each `i`, only countably many levels `t` have `μᵢ⌞S {h = t} > 0`
  have hC : ∀ i, {t : ℝ | 0 < (μ i).restrict S {x | h x = t}}.Countable := by
    intro i
    have : IsFiniteMeasure ((μ i).restrict S) := isFiniteMeasure_restrict.2 (hμ i)
    exact Measure.countable_meas_level_set_pos hh
  -- `∫_{(a,b)} Σᵢ gᵢ = Σᵢ ∫_{(a,b)} gᵢ < ∞`, so `Σᵢ gᵢ < ∞` a.e. on `(a, b)`
  have hfin : ∀ᵐ t ∂(volume.restrict (Ioo a b)), ∑' i, g i t < ∞ := by
    refine ae_lt_top' (AEMeasurable.tsum hg) ?_
    rwa [lintegral_tsum hg]
  have hall : ∀ᵐ t ∂(volume.restrict (Ioo a b)), t ∈ Ioo a b ∧ (∀ i, good i t) ∧
      ∑' i, g i t < ∞ ∧ t ∉ ⋃ i, {t : ℝ | 0 < (μ i).restrict S {x | h x = t}} := by
    filter_upwards [ae_restrict_mem measurableSet_Ioo, ae_restrict_of_ae (ae_all_iff.2 hgood),
      hfin, ae_restrict_of_ae ((countable_iUnion hC).ae_notMem volume)] with t h₁ h₂ h₃ h₄
    exact ⟨h₁, h₂, h₃, h₄⟩
  -- `(a, b)` has positive measure
  have : (ae (volume.restrict (Ioo a b))).NeBot := by
    refine ae_neBot.2 fun h₀ => ?_
    rw [Measure.restrict_eq_zero, Real.volume_Ioo] at h₀
    exact (ENNReal.ofReal_pos.2 (sub_pos.2 hab)).ne' h₀
  obtain ⟨t, ht, hgt, hst, hCt⟩ := hall.exists
  refine ⟨t, ht, hgt, hst.ne, fun i => ?_⟩
  have hS : {x | h x = t} ⊆ S := fun x (hx : h x = t) => show a < h x ∧ h x < b from hx ▸ ht
  rw [← Measure.restrict_eq_self (μ i) hS]
  exact nonpos_iff_eq_zero.1 (not_lt.1 fun hpos => hCt (mem_iUnion.2 ⟨i, hpos⟩))
/-- **Simon 7.2.4, (12)–(13)** (upper bound on compact sets): let `μ` be finite on compact
subsets of `ℝᴾ`, and suppose that for every compact `K`, `ε > 0` and subsequence `ψ` there are
`K ⊆ W ⊆ thickening ε K` and a further subsequence `φ'` with `limsup_i μ_{ψ(φ'(i))}(W) ≤ μ(W)`.
Then `limsup_j μ_j(K) ≤ μ(K)` for every compact `K`.  If `μ(thickening ε K) < b < limsup_j μ_j(K)`,
then `μ_{ψ(i)}(K) > b` along a subsequence `ψ`, and
`b ≤ limsup_i μ_{ψ(φ'(i))}(W) ≤ μ(W) ≤ μ(thickening ε K) < b`.  Hence
`limsup_j μ_j(K) ≤ μ(thickening ε K)` for every `ε > 0`, and `μ(thickening ε K) → μ(K)` as
`ε ↓ 0` by continuity from above (`K` is closed and `μ(thickening 1 K) ≤ μ(cthickening 1 K) < ∞`).
-/
theorem Submission.dtc_bc_mm_limsup_le_of_subseq : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ limsup (fun i => μs (ψ (φ' i)) W) atTop ≤ μ W) → ∀ K : Set (Euclid P), IsCompact K → limsup (fun j => μs j K) atTop ≤ μ K := by
  intro P μs μ hfin hsub K hK
  -- `limsup_j μ_j(K) ≤ μ(thickening ε K)` for every `ε > 0`.
  have hthick : ∀ ε : ℝ, 0 < ε → limsup (fun j => μs j K) atTop ≤ μ (thickening ε K) := by
    intro ε hε
    by_contra hlt
    obtain ⟨b, hab, hbL⟩ := exists_between (not_le.mp hlt)
    obtain ⟨ψ, hψ, hψb⟩ := extraction_of_frequently_atTop (frequently_lt_of_lt_limsup (h := hbL))
    obtain ⟨W, hKW, hWε, φ', -, hW⟩ := hsub K ε hK hε ψ hψ
    have hb : b ≤ limsup (fun i => μs (ψ (φ' i)) W) atTop :=
      le_limsup_of_frequently_le (Frequently.of_forall fun i =>
        (hψb (φ' i)).le.trans (measure_mono hKW))
    exact (hb.trans (hW.trans (measure_mono hWε))).not_gt hab
  -- Continuity from above: `μ(thickening r K) → μ(K)` as `r ↓ 0`.
  have hT : Tendsto (fun r => μ (thickening r K)) (𝓝[>] 0) (𝓝 (μ K)) :=
    tendsto_measure_thickening_of_isClosed ⟨1, one_pos, ((measure_mono
      (thickening_subset_cthickening 1 K)).trans_lt (hfin _ hK.cthickening)).ne⟩ hK.isClosed
  exact ge_of_tendsto hT (eventually_nhdsWithin_of_forall hthick)

/-- **Simon 7.2.4, (8)**, localized (minimality of the limit `C`).  For a competitor `S` with
`K = spt(S − C)` compact and `K ⊆ W`, pick `ε > 0` with `thickening ε K ⊆ W`; the local comparison
with `ψ = id` gives an open `W'`, `K ⊆ W' ⊆ W`, and `φ'` with `limsup M_{W'}(S_{φ'(i)}) ≤ M_{W'}(S)`,
so `M_{W'}(C) ≤ liminf M_{W'}(S_{φ'(i)}) ≤ M_{W'}(S)` by lower semicontinuity of mass.  Off `K` the
currents `S` and `C` agree, so their weights `μ_S, μ_C` agree on the Borel set `W \ W' ⊆ ℝᴾ \ K`,
and `M_W(C) = μ_C(W') + μ_C(W \ W') ≤ μ_S(W') + μ_S(W \ W') = M_W(S)`. -/
theorem Submission.dtc_bc_mm_isMinimizingIn_univ : ∀ (P n : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → IsIntegerMultiplicity C → ConvergesWeakly Ss C → (∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ ∀ S : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity S → SameBoundary S C → (S - C).support ⊆ K → limsup (fun j => (Ss (ψ (φ' j))).massOn W) atTop ≤ S.massOn W) → IsMinimizingIn C univ := by
  intro P n Us Ss C hUs hC hconv hcomp
  refine ⟨hC, fun W S hW _ hS hbd hKc hsub => ?_⟩
  -- `K = spt(S − C)` is a compact subset of `W`; pick `ε > 0` with `thickening ε K ⊆ W`
  set K := (S - C).support
  have hKW : K ⊆ W := fun x hx => (hsub hx).2
  obtain ⟨ε, hε, hεW⟩ := hKc.exists_thickening_subset_open hW hKW
  -- the local comparison with `ψ = id`: `K ⊆ W' ⊆ W`, `limsup M_{W'}(S_{φ'(i)}) ≤ M_{W'}(S)`
  obtain ⟨W', hW'o, hKW', hW'ε, φ', hφ', hcmp⟩ := hcomp K ε hKc hε id strictMono_id
  have hW'W : W' ⊆ W := hW'ε.trans hεW
  -- lower semicontinuity: `M_{W'}(C) ≤ liminf M_{W'}(S_{φ'(i)}) ≤ limsup ≤ M_{W'}(S)`
  have hCS : C.massOn W' ≤ S.massOn W' :=
    le_trans (Submission.dtc_bc_mm_massOn_le_liminf P n Us Ss C hUs hconv φ' hφ' W')
      (le_trans liminf_le_limsup (hcmp S hS hbd subset_rfl))
  -- on open sets the masses are the weights `μ_C = μ_{R_C}` and `μ_S = μ_{R_S}`
  obtain ⟨RC, hRC⟩ := hC
  obtain ⟨RS, hRS⟩ := hS
  have hmC := Submission.cmc_massOn_eq_imRep_measure P n univ C RC isOpen_univ hRC
  have hmS := Submission.cmc_massOn_eq_imRep_measure P n univ S RS isOpen_univ hRS
  -- `μ_S = μ_C` on the open subsets of `ℝᴾ \ K` (there `S = C`), hence on its Borel subsets
  have hagree : ∀ A : Set (Euclid P), MeasurableSet A → A ⊆ Kᶜ → RS.measure A = RC.measure A :=
    Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P Kᶜ RS.measure RC.measure
      hKc.isClosed.isOpen_compl
      (fun K' hK' _ =>
        (Submission.rsd_imrep_compact_measure_ne_top P n univ RS K' hK' (subset_univ _)).2)
      (fun G hG hGK => by
        rw [← hmS G hG, ← hmC G hG]
        exact Submission.cmc_ml_massOn_eq_of_disjoint_sub_support P n univ S C K G subset_rfl
          (subset_compl_iff_disjoint_right.mp hGK))
  have hdiff : RS.measure (W \ W') = RC.measure (W \ W') :=
    hagree _ (hW.measurableSet.diff hW'o.measurableSet) fun x hx hxK => hx.2 (hKW' hxK)
  -- additivity: `M_W(C) = μ_C(W') + μ_C(W \ W') ≤ μ_S(W') + μ_S(W \ W') = M_W(S)`
  have hsplit : ∀ μ : Measure (Euclid P), μ W' + μ (W \ W') = μ W := fun μ => by
    rw [← measure_inter_add_sdiff W hW'o.measurableSet, inter_eq_right.mpr hW'W]
  calc C.massOn W = RC.measure W' + RC.measure (W \ W') := by rw [hmC W hW, hsplit]
    _ ≤ RS.measure W' + RS.measure (W \ W') := by
        rw [← hmC W' hW'o, ← hmS W' hW'o, hdiff]
        exact add_le_add hCS le_rfl
    _ = S.massOn W := by rw [hmS W hW, hsplit]
/-- **Simon 7.2.4 (12)–(14)** (chapter-07.txt lines 260–288): for the weights `μⱼ = θⱼ Hⁿ⌞Mⱼ`
of `Sⱼ = τ(Mⱼ, θⱼ, ξⱼ)` and `μ = θ Hⁿ⌞M` of `C = τ(M, θ, ξ)`, (a) `μ(K) < ∞` and (b)
`limsup_j μⱼ(K) ≤ μ(K)` for compact `K`, and (c) `μ(G) ≤ liminf_j μⱼ(G)` for bounded open `G`.
On open sets mass is the weight (Simon 6.3.2(3)); (c) is the lower semicontinuity of mass, and
(b) is the local comparison with the admissible competitor `S = C`, passed to the whole sequence
by the subsequence-of-subsequence criterion (lines 278–280). -/
theorem Submission.dtc_bc_mm_measure_bounds : ∀ (P n : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ j, IsOpen (Us j)) → (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → ConvergesWeakly Ss C → (∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ ∀ S : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity S → SameBoundary S C → (S - C).support ⊆ K → limsup (fun j => (Ss (ψ (φ' j))).massOn W) atTop ≤ S.massOn W) → ∀ Rs : (j : ℕ) → IMRep (Us j) n, (∀ j, (Rs j).Represents (Ss j)) → ∀ R : IMRep (univ : Set (Euclid P)) n, R.Represents C → (∀ K : Set (Euclid P), IsCompact K → R.measure K < ∞) ∧ (∀ K : Set (Euclid P), IsCompact K → limsup (fun j => (Rs j).measure K) atTop ≤ R.measure K) ∧ (∀ G : Set (Euclid P), IsOpen G → Bornology.IsBounded G → R.measure G ≤ liminf (fun j => (Rs j).measure G) atTop) := by
  intro P n Us Ss C hUs hexh hconv hloc Rs hRs R hR
  -- on open sets mass is the weight: `M_G(C) = μ(G)` and `M_G(Sⱼ) = μⱼ(G)`
  have hC : ∀ G : Set (Euclid P), IsOpen G → C.massOn G = R.measure G := fun G hG =>
    Submission.cmc_massOn_eq_imRep_measure P n univ C R isOpen_univ hR G hG
  have hS : ∀ G : Set (Euclid P), IsOpen G → ∀ j, (Ss j).massOn G = (Rs j).measure G :=
    fun G hG j =>
      Submission.cmc_massOn_eq_imRep_measure P n (Us j) (Ss j) (Rs j) (hUs j) (hRs j) G hG
  -- (a): `μ(K) = ∫_{M ∩ K} θ dHⁿ < ∞`
  have ha : ∀ K : Set (Euclid P), IsCompact K → R.measure K < ∞ := fun K hK =>
    lt_top_iff_ne_top.2
      (Submission.rsd_imrep_compact_measure_ne_top P n univ R K hK (subset_univ K)).2
  -- `C` is an admissible competitor for itself: `∂C = ∂C`, and `spt(C − C) = ∅` since `C − C`
  -- vanishes on every ball `B₁(x)`, whose closure is compact
  have hsame : SameBoundary C C := by
    cases n
    · trivial
    · rfl
  have hspt : ∀ K : Set (Euclid P), (C - C).support ⊆ K := by
    intro K x hx
    have hx' : x ∈ univ \ (C - C).zeroRegion := hx
    refine absurd (mem_sUnion.2 ⟨ball x 1, ?_, mem_ball_self one_pos⟩) hx'.2
    refine ⟨isOpen_ball, isBounded_ball.isCompact_closure, subset_univ _, fun ω _ => ?_⟩
    exact sub_self (C ω)
  refine ⟨ha, ?_, ?_⟩
  · -- (b): the comparison with `S = C` gives `limsup_i μ_{ψ(φ'(i))}(W) ≤ μ(W)` on the open
    -- `W ⊇ K` it provides, the hypothesis of the subsequence criterion
    refine Submission.dtc_bc_mm_limsup_le_of_subseq P (fun j => (Rs j).measure) R.measure ha ?_
    intro K ε hK hε ψ hψ
    obtain ⟨W, hW, hKW, hWK, φ', hφ', hcmp⟩ := hloc K ε hK hε ψ hψ
    refine ⟨W, hKW, hWK, φ', hφ', ?_⟩
    calc limsup (fun i => (Rs (ψ (φ' i))).measure W) atTop
        = limsup (fun i => (Ss (ψ (φ' i))).massOn W) atTop := by
          congr 1; funext i; exact (hS W hW _).symm
      _ ≤ C.massOn W := hcmp C ⟨R, hR⟩ hsame (hspt K)
      _ = R.measure W := hC W hW
  · -- (c): lower semicontinuity of mass along the whole sequence (`φ = id`)
    intro G hG _
    calc R.measure G = C.massOn G := (hC G hG).symm
      _ ≤ liminf (fun i => (Ss (id i)).massOn G) atTop :=
          Submission.dtc_bc_mm_massOn_le_liminf P n Us Ss C hexh hconv id strictMono_id G
      _ = liminf (fun j => (Rs j).measure G) atTop := by
          congr 1; funext j; exact hS G hG j

/-- **Simon 6.3.2(3), 6.2.16** (locality of the weight measure).  If `R₁, R₂` represent
`T₁ ∈ 𝒟ₙ(U₁)`, `T₂ ∈ 𝒟ₙ(U₂)` and `T₁ = T₂` in the open set `W ⊆ U₁ ∩ U₂`, then
`μ_{R₁}⌞W = μ_{R₂}⌞W`.  For open `G ⊆ W` the admissible forms for `M_G(Tᵢ)` are forms in
`𝒟ⁿ(W)`, on which `T₁, T₂` agree, so `μ_{R₁}(G) = M_G(T₁) = M_G(T₂) = μ_{R₂}(G)`; as `μ_{R₁}` is
finite on compact subsets of `W`, the two measures agree on every Borel subset of `W`. -/
theorem Submission.dtc_bc_measure_restrict_eq_of_eqOn : ∀ (P n : ℕ) (U₁ U₂ W : Set (Euclid P)) (T₁ : GeometricCurrentOn U₁ n) (T₂ : GeometricCurrentOn U₂ n) (R₁ : IMRep U₁ n) (R₂ : IMRep U₂ n), IsOpen U₁ → IsOpen U₂ → IsOpen W → W ⊆ U₁ → W ⊆ U₂ → R₁.Represents T₁ → R₂.Represents T₂ → (∀ ω : TestFormOn W n, currentEval T₁ (ω : DifferentialForm (Euclid P) n) = currentEval T₂ (ω : DifferentialForm (Euclid P) n)) → R₁.measure.restrict W = R₂.measure.restrict W := by
  intro P n U₁ U₂ W T₁ T₂ R₁ R₂ hU₁ hU₂ hW hWU₁ hWU₂ hR₁ hR₂ hT
  -- `ω ∈ 𝒟ⁿ(W)` regarded in `𝒟ⁿ(Uᵢ)`: `Tᵢ(ω) = currentEval Tᵢ ω`
  have hev₁ : ∀ ω : TestFormOn W n,
      T₁ (testFormOnInclusion hWU₁ n ω) = currentEval T₁ (ω : DifferentialForm (Euclid P) n) := by
    intro ω
    rw [currentEval, dite_eq_left ⟨ω.property.1, ω.property.2.trans hWU₁⟩]
    rfl
  have hev₂ : ∀ ω : TestFormOn W n,
      T₂ (testFormOnInclusion hWU₂ n ω) = currentEval T₂ (ω : DifferentialForm (Euclid P) n) := by
    intro ω
    rw [currentEval, dite_eq_left ⟨ω.property.1, ω.property.2.trans hWU₂⟩]
    rfl
  -- 1. `M_G(T₁) = M_G(T₂⌞W) = M_G(T₂)` for `G ⊆ W`
  have hmass : ∀ G : Set (Euclid P), G ⊆ W → T₁.massOn G = T₂.massOn G := by
    intro G hGW
    rw [Submission.dtc_massOn_eq_of_agreeOn P n U₁ W G hWU₁ T₁ (T₂.restrictDomain hWU₂) hGW
        fun ω _ => by rw [GeometricCurrentOn.restrictDomain_apply, hev₁, hev₂, hT],
      Submission.dtc_massOn_eq_of_agreeOn P n U₂ W G hWU₂ T₂ (T₂.restrictDomain hWU₂) hGW
        fun ω _ => rfl]
  -- 2. `μ_{R₁}(G) = M_G(T₁) = M_G(T₂) = μ_{R₂}(G)` for open `G ⊆ W`
  have hopen : ∀ G : Set (Euclid P), IsOpen G → G ⊆ W → R₁.measure G = R₂.measure G := by
    intro G hG hGW
    rw [← Submission.dtc_mass_eq_measure P n U₁ G T₁ R₁ hU₁ hG (hGW.trans hWU₁) hR₁,
      ← Submission.dtc_mass_eq_measure P n U₂ G T₂ R₂ hU₂ hG (hGW.trans hWU₂) hR₂, hmass G hGW]
  -- 3. `μ_{R₁}(C) < ∞` for compact `C ⊆ W ⊆ U₁`
  have hfin : ∀ C : Set (Euclid P), IsCompact C → C ⊆ W → R₁.measure C ≠ ∞ := fun C hC hCW =>
    (Submission.rsd_imrep_compact_measure_ne_top P n U₁ R₁ C hC (hCW.trans hWU₁)).2
  -- 4. hence `μ_{R₁}(B ∩ W) = μ_{R₂}(B ∩ W)` for Borel `B`
  ext B hB
  rw [Measure.restrict_apply hB, Measure.restrict_apply hB]
  exact Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P W R₁.measure R₂.measure hW hfin
    hopen (B ∩ W) (hB.inter hW.measurableSet) inter_subset_right
/-- A constant multiple `X = c[[ℝⁿ]]` (`n ≥ 1`) with compact support is zero (step 6 of
`dtc_bc_cz_isMinimizingIn`): if `X(ω) = c ∫ ω(y)(e₁, …, eₙ) dy` for every `ω ∈ 𝒟ⁿ(ℝⁿ)` and
`spt X` is compact, then `c = 0`.  Take `r₀` with `spt X ⊆ B̄_{r₀}(0)` and `p = (|r₀| + 2)e₁`,
so `‖p‖ = |r₀| + 2`.  A test form `ω` with `spt ω ⊆ B̄₁(p)` and `∫ ω(y)(e₁, …, eₙ) dy > 0` has
`spt ω ∩ spt X = ∅`, since `‖p‖ ≤ ‖y‖ + ‖y − p‖ ≤ r₀ + 1` for `y` in both.  Hence `X(ω) = 0`
(Simon 6.2.11), so `c ∫ ω(y)(e₁, …, eₙ) dy = 0` and `c = 0`. -/
theorem Submission.dtc_bc_cz_isMinimizingIn_const_eq_zero : ∀ (n : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid n)) n) (c : ℝ), 0 < n → IsCompact X.support → (∀ ω : TestFormOn (univ : Set (Euclid n)) n, X ω = c * ∫ y, (ω : DifferentialForm (Euclid n) n) y ⇑(EuclideanSpace.basisFun (Fin n) ℝ)) → c = 0 := by
  intro n X c hn hX hXc
  -- Step 1: `spt X ⊆ B̄(0, r₀)`, `spt X` being compact
  obtain ⟨r₀, hr₀⟩ := hX.isBounded.subset_closedBall (0 : Euclid n)
  -- Step 2: `p = (|r₀| + 2) e₁` (`n ≥ 1`) has `‖p‖ = |r₀| + 2`
  obtain ⟨p, hpn⟩ : ∃ p : Euclid n, ‖p‖ = |r₀| + 2 :=
    ⟨(|r₀| + 2) • EuclideanSpace.single (⟨0, hn⟩ : Fin n) (1 : ℝ), by
      rw [norm_smul, PiLp.norm_single, norm_one, mul_one, Real.norm_eq_abs,
        abs_of_pos (by positivity)]⟩
  -- Step 3 (child `bump_form`): `ω` with `spt ω ⊆ B̄(p, 1)` and `∫ ω(y)(e) dy > 0`
  obtain ⟨ω, hωs, hωI⟩ := Submission.dtc_bc_cz_isMinimizingIn_bump_form n p 1 one_pos
  -- Step 4: `spt ω ∩ spt X = ∅`, as `‖p‖ ≤ ‖y‖ + ‖y − p‖ ≤ r₀ + 1 < |r₀| + 2` on it
  have hdisj : Disjoint (tsupport (ω : DifferentialForm (Euclid n) n)) X.support := by
    refine Set.disjoint_left.mpr fun y hyω hyX => ?_
    have h1 : ‖y - p‖ ≤ 1 := mem_closedBall_iff_norm.mp (hωs hyω)
    have h2 : ‖y‖ ≤ r₀ := mem_closedBall_zero_iff.mp (hr₀ hyX)
    have h3 : ‖p‖ ≤ ‖y‖ + ‖y - p‖ := by
      simpa only [sub_sub_cancel] using norm_sub_le y (y - p)
    linarith [le_abs_self r₀]
  -- Step 5 (`dtc_vanish_off_support`): `X(ω) = 0`
  have hX0 : X ω = 0 := Submission.dtc_vanish_off_support n n univ X ω hdisj
  -- Step 6: `c ∫ ω(y)(e) dy = 0` with a positive integral, so `c = 0`
  rw [hXc ω] at hX0
  exact (mul_eq_zero.mp hX0).resolve_right hωI.ne'

/-- **Simon 6.2.13, 6.2.16, 7.2.4 and Remark 7.2.5(1)** (eventual local agreement with a limit
current).  Assume measure locality (the type of `dtc_bc_measure_restrict_eq_of_eqOn`).  Let
`Sⱼ ∈ 𝒟ₙ(Uⱼ)`, `n = m + 1`, `Uⱼ` open, and `C ∈ 𝒟ₙ(ℝᴾ)`, and suppose that for every `R`, for all
large `j`: `B_R(0) ⊆ Uⱼ`, `Sⱼ(ω) = C(ω)` if `spt ω ⊆ B_R(0)`, and `∂Sⱼ(β) = 0` if
`spt β ⊆ B_R(0)`.  Then `Sⱼ ⇀ C`, `μ_{Sⱼ} → μ_C` and `∂C = 0`.  Every compact set lies in some
ball `B_R(0)`: so `Sⱼ(ω) = C(ω)` for large `j`; for `spt f ⊆ B_R(0)` measure locality gives
`μ_{Sⱼ}⌞B_R(0) = μ_C⌞B_R(0)`, hence `∫ f dμ_{Sⱼ} = ∫ f dμ_C`, for large `j`; and
`∂C(β) = C(dβ) = Sⱼ(dβ) = ∂Sⱼ(β) = 0`. -/
theorem Submission.dtc_bc_cz_local_agreement : (∀ (P n : ℕ) (U₁ U₂ W : Set (Euclid P)) (T₁ : GeometricCurrentOn U₁ n) (T₂ : GeometricCurrentOn U₂ n) (R₁ : IMRep U₁ n) (R₂ : IMRep U₂ n), IsOpen U₁ → IsOpen U₂ → IsOpen W → W ⊆ U₁ → W ⊆ U₂ → R₁.Represents T₁ → R₂.Represents T₂ → (∀ ω : TestFormOn W n, currentEval T₁ (ω : DifferentialForm (Euclid P) n) = currentEval T₂ (ω : DifferentialForm (Euclid P) n)) → R₁.measure.restrict W = R₂.measure.restrict W) → ∀ (P m : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) (m + 1)) (C : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ j, IsOpen (Us j)) → (∀ R : ℝ, ∀ᶠ j in atTop, ball (0 : Euclid P) R ⊆ Us j ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 R → currentEval (Ss j) (ω : DifferentialForm (Euclid P) (m + 1)) = C ω) ∧ ∀ β : TestFormOn (Us j) m, tsupport (β : DifferentialForm (Euclid P) m) ⊆ ball 0 R → (Ss j).boundary β = 0) → ConvergesWeakly Ss C ∧ MassMeasuresConverge Ss C ∧ C.boundary = 0 := by
  intro hmeas P m Us Ss C hUs hagree
  refine ⟨?_, ?_, ?_⟩
  · -- 1. `spt ω ⊆ B_r(0)` for some `r`, so `Sⱼ(ω) = C(ω)` for all large `j`
    intro ω
    obtain ⟨r, hr⟩ := ω.property.1.2.isCompact.isBounded.subset_ball (0 : Euclid P)
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [hagree r] with j hj
    exact (hj.2.1 ω hr).symm
  · -- 2. `spt f ⊆ B_r(0)` for some `r`, so `f = 0` off `B_r(0)`
    intro Rs hRs R hR f _ hfc _
    obtain ⟨r, hr⟩ := hfc.isCompact.isBounded.subset_ball (0 : Euclid P)
    have hf0 : ∀ x, x ∉ ball (0 : Euclid P) r → f x = 0 := fun x hx =>
      image_eq_zero_of_notMem_tsupport fun h => hx (hr h)
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [hagree r] with j hj
    -- `Sⱼ = C` on `𝒟ⁿ(B_r(0))`, read through `currentEval`
    have hloc : ∀ ω : TestFormOn (ball (0 : Euclid P) r) (m + 1),
        currentEval (Ss j) (ω : DifferentialForm (Euclid P) (m + 1)) =
          currentEval C (ω : DifferentialForm (Euclid P) (m + 1)) := by
      intro ω
      have h := hj.2.1 (testFormOnInclusion (subset_univ _) (m + 1) ω) ω.property.2
      rw [testFormOnInclusion_coe] at h
      rw [h, currentEval, dite_eq_left ⟨ω.property.1, subset_univ _⟩]
      rfl
    -- measure locality on `B_r(0) ⊆ Uⱼ`: `μ_{Sⱼ}⌞B_r(0) = μ_C⌞B_r(0)`
    have hrestr := hmeas P (m + 1) (Us j) univ (ball 0 r) (Ss j) C (Rs j) R (hUs j) isOpen_univ
      isOpen_ball hj.1 (subset_univ _) (hRs j) hR hloc
    calc ∫ x, f x ∂R.measure = ∫ x in ball (0 : Euclid P) r, f x ∂R.measure :=
          (setIntegral_eq_integral_of_forall_compl_eq_zero hf0).symm
      _ = ∫ x in ball (0 : Euclid P) r, f x ∂(Rs j).measure := by rw [hrestr]
      _ = ∫ x, f x ∂(Rs j).measure := setIntegral_eq_integral_of_forall_compl_eq_zero hf0
  · -- 3. `spt β ⊆ B_r(0) ⊆ Uⱼ` for some `r`, `j`, and `C(dβ) = Sⱼ(dβ) = ∂Sⱼ(β) = 0`
    ext β
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply]
    obtain ⟨r, hr⟩ := β.property.1.2.isCompact.isBounded.subset_ball (0 : Euclid P)
    obtain ⟨j, hj⟩ := (hagree r).exists
    have hdβ : tsupport ((exteriorDerivativeTestOn univ m β : TestFormOn (univ : Set (Euclid P))
        (m + 1)) : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 r :=
      (tsupport_exteriorDerivative_subset (β : DifferentialForm (Euclid P) m)).trans hr
    rw [← hj.2.1 _ hdβ, currentEval,
      dite_eq_left ⟨(exteriorDerivativeTestOn univ m β).property.1, hdβ.trans hj.1⟩]
    exact hj.2.2 ⟨β, β.property.1, hr.trans hj.1⟩ hr
/-- **Simon 7.2.4** (the "standard approximation argument" at the end of its proof, p. 187,
lower half): if `μ(G) ≤ liminf_j μ_j(G)` for every bounded open `G`, then
`∫ g dμ ≤ liminf_j ∫ g dμ_j` in `[0, ∞]` for every continuous `g ≥ 0` with compact support.
By the layer cake formula both sides integrate `t ↦ ν{g > t}` over `t > 0`; for `t > 0` the set
`{g > t}` is open and lies in the compact `tsupport g`, and Fatou's lemma finishes. -/
theorem Submission.dtc_bc_rc_lintegral_le_liminf : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ G : Set (Euclid P), IsOpen G → Bornology.IsBounded G → μ G ≤ liminf (fun j => μs j G) atTop) → ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → (∀ x, 0 ≤ g x) → ∫⁻ x, ENNReal.ofReal (g x) ∂μ ≤ liminf (fun j => ∫⁻ x, ENNReal.ofReal (g x) ∂(μs j)) atTop := by
  intro P μs μ hG g hg hgc hg0
  -- step 1: `tsupport g` is compact, hence bounded
  have hK : Bornology.IsBounded (tsupport g) := hgc.isCompact.isBounded
  -- step 2: layer cake, `∫⁻ ofReal (g x) ∂ν = ∫⁻ t in Ioi 0, ν {x | t < g x}`
  simp_rw [lintegral_eq_lintegral_meas_lt _ (ae_of_all _ hg0) hg.measurable.aemeasurable]
  calc ∫⁻ t in Ioi 0, μ {x | t < g x}
      ≤ ∫⁻ t in Ioi 0, liminf (fun j => μs j {x | t < g x}) atTop := by
        -- steps 3 and 5: for `t > 0`, `{x | t < g x}` is open and contained in `tsupport g`
        refine setLIntegral_mono' measurableSet_Ioi fun t ht =>
          hG _ (isOpen_lt continuous_const hg) ?_
        exact hK.subset fun x hx => subset_tsupport g (lt_trans ht hx).ne'
    _ ≤ liminf (fun j => ∫⁻ t in Ioi 0, μs j {x | t < g x}) atTop :=
        -- steps 4 and 6: `t ↦ μs j {x | t < g x}` is antitone, hence measurable; Fatou
        lintegral_liminf_le fun j => Antitone.measurable fun s t hst =>
          measure_mono fun x hx => lt_of_le_of_lt hst hx
/-- **Simon 7.2.4** (proof, the "standard approximation argument", upper bound): if `μ` is finite
on compact sets and `limsup_j μⱼ(K) ≤ μ(K)` for every compact `K`, then
`limsup_j ∫ g dμⱼ ≤ ∫ g dμ` for every continuous compactly supported `g ≥ 0`.  By the layer cake
formula `∫ g dν = ∫₀^∞ ν{g ≥ t} dt`; for `t > 0` the sets `{g ≥ t}` are compact subsets of
`tsupport g`, so after an index shift the integrands are dominated by
`(μ(tsupport g) + 1) · 1_{t ≤ M}` (`g ≤ M`), and the reverse Fatou lemma applies. -/
theorem Submission.dtc_bc_rc_limsup_lintegral_le : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun j => μs j K) atTop ≤ μ K) → ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → (∀ x, 0 ≤ g x) → limsup (fun j => ∫⁻ x, ENNReal.ofReal (g x) ∂(μs j)) atTop ≤ ∫⁻ x, ENNReal.ofReal (g x) ∂μ := by
  intro P μs μ hfin hlim g hg hgc hg0
  -- `g ≤ M`
  obtain ⟨M, hM⟩ := hg.bounded_above_of_compact_support hgc
  have hgM : ∀ x, g x ≤ M := fun x => (Real.le_norm_self (g x)).trans (hM x)
  -- `μⱼ(tsupport g) < A := μ(tsupport g) + 1 < ∞` for `j ≥ j₁`
  have hK₀ : IsCompact (tsupport g) := hgc.isCompact
  have hAtop : μ (tsupport g) + 1 ≠ ∞ :=
    ENNReal.add_ne_top.2 ⟨(hfin _ hK₀).ne, ENNReal.one_ne_top⟩
  obtain ⟨j₁, hj₁⟩ := eventually_atTop.1 (eventually_lt_of_limsup_lt
    ((hlim _ hK₀).trans_lt (ENNReal.lt_add_right (hfin _ hK₀).ne one_ne_zero)))
  -- for `t > 0`, `{g ≥ t}` is a compact subset of `tsupport g`
  have hsub : ∀ t : ℝ, 0 < t → {x | t ≤ g x} ⊆ tsupport g := fun t ht x hx =>
    subset_tsupport g (ht.trans_le hx).ne'
  have hcpt : ∀ t : ℝ, 0 < t → IsCompact {x | t ≤ g x} := fun t ht =>
    hK₀.of_isClosed_subset (isClosed_le continuous_const hg) (hsub t ht)
  -- layer cake: `∫ g dν = ∫₀^∞ ν{g ≥ t} dt`
  have hlc : ∀ ν : Measure (Euclid P),
      ∫⁻ x, ENNReal.ofReal (g x) ∂ν = ∫⁻ t in Ioi 0, ν {x | t ≤ g x} := fun ν =>
    lintegral_eq_lintegral_meas_le ν (ae_of_all _ hg0) hg.measurable.aemeasurable
  simp_rw [hlc]
  rw [← limsup_nat_add _ j₁]
  calc limsup (fun i => ∫⁻ t in Ioi 0, μs (i + j₁) {x | t ≤ g x}) atTop
      ≤ ∫⁻ t in Ioi 0, limsup (fun i => μs (i + j₁) {x | t ≤ g x}) atTop := by
        -- reverse Fatou, dominated by `A · 1_{(-∞, M]}`
        refine limsup_lintegral_le (f := fun i t => μs (i + j₁) {x | t ≤ g x})
          ((Iic M).indicator fun _ => μ (tsupport g) + 1) (fun i => ?_) (fun i => ?_) ?_
        · exact Antitone.measurable fun s t hst => measure_mono fun x hx => hst.trans hx
        · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
          by_cases htM : t ≤ M
          · rw [indicator_of_mem (mem_Iic.2 htM)]
            exact (measure_mono (hsub t ht)).trans (hj₁ _ (Nat.le_add_left _ _)).le
          · have he : {x | t ≤ g x} = (∅ : Set (Euclid P)) :=
              eq_empty_iff_forall_notMem.2 fun x hx => htM (le_trans hx (hgM x))
            simp [he]
        · rw [lintegral_indicator_const measurableSet_Iic, Measure.restrict_apply measurableSet_Iic,
            Iic_inter_Ioi, Real.volume_Ioc]
          exact ENNReal.mul_ne_top hAtop ENNReal.ofReal_ne_top
    _ ≤ ∫⁻ t in Ioi 0, μ {x | t ≤ g x} := by
        refine setLIntegral_mono' measurableSet_Ioi fun t ht => ?_
        rw [limsup_nat_add (fun j => μs j {x | t ≤ g x}) j₁]
        exact hlim _ (hcpt t ht)

/-- **Radon convergence from the compact/open semicontinuity bounds** (the "standard approximation
argument" ending Simon's proof of 7.2.4, p. 187).  Let `μ`, `μⱼ` be Borel measures on `ℝᴾ` with
(a) `μ(K) < ∞` and (b) `limsup_j μⱼ(K) ≤ μ(K)` for compact `K`, and (c) `μ(G) ≤ liminf_j μⱼ(G)`
for bounded open `G`.  Then `∫ f dμⱼ → ∫ f dμ` for continuous `f` with compact support.  For
such `g ≥ 0`, `∫⁻ g dμⱼ → ∫⁻ g dμ < ∞` by the Fatou bound `dtc_bc_rc_lintegral_le_liminf` (from
(c)) and the reverse Fatou bound `dtc_bc_rc_limsup_lintegral_le` (from (a), (b)), so the Bochner
integrals `∫ g = (∫⁻ g).toReal` converge.  By (a), (b), `μⱼ(spt f) < ∞` for large `j`; then
`f⁺ = max(f, 0)` and `f⁻ = max(−f, 0)` are `μⱼ`-integrable and `∫ f = ∫ f⁺ − ∫ f⁻`. -/
theorem Submission.dtc_bc_tendsto_integral_of_limsup_liminf : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun j => μs j K) atTop ≤ μ K) → (∀ G : Set (Euclid P), IsOpen G → Bornology.IsBounded G → μ G ≤ liminf (fun j => μs j G) atTop) → ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun j => ∫ x, f x ∂(μs j)) atTop (𝓝 (∫ x, f x ∂μ)) := by
  intro P μs μ ha hb hc f hf hfc
  -- `K₀ = spt f` is compact, and `μⱼ(K₀) < ∞` for `j ≥ j₁` by (a) and (b)
  have hK₀ : IsCompact (tsupport f) := hfc.isCompact
  obtain ⟨j₁, hj₁⟩ : ∃ j₁, ∀ j ≥ j₁, μs j (tsupport f) < ∞ :=
    eventually_atTop.1 (eventually_lt_of_limsup_lt ((hb _ hK₀).trans_lt (ha _ hK₀)))
  -- a continuous function vanishing off `K₀` is `ν`-integrable whenever `ν(K₀) < ∞`
  have hint : ∀ ν : Measure (Euclid P), ν (tsupport f) < ∞ → ∀ g : Euclid P → ℝ,
      Continuous g → support g ⊆ tsupport f → Integrable g ν := by
    intro ν hν g hg hgs
    have : IsFiniteMeasure (ν.restrict (tsupport f)) := isFiniteMeasure_restrict.2 hν.ne
    exact (integrableOn_iff_integrable_of_support_subset hgs).1
      (hg.integrable_of_hasCompactSupport (hfc.mono' hgs))
  -- continuous `g ≥ 0` with compact support: `∫⁻ g dμⱼ → ∫⁻ g dμ < ∞`, then take `toReal`
  have key : ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → (∀ x, 0 ≤ g x) →
      Tendsto (fun j => ∫ x, g x ∂(μs j)) atTop (𝓝 (∫ x, g x ∂μ)) := by
    intro g hg hgc hg0
    have hT : Tendsto (fun j => ∫⁻ x, ENNReal.ofReal (g x) ∂(μs j)) atTop
        (𝓝 (∫⁻ x, ENNReal.ofReal (g x) ∂μ)) :=
      tendsto_of_le_liminf_of_limsup_le
        (Submission.dtc_bc_rc_lintegral_le_liminf P μs μ hc g hg hgc hg0)
        (Submission.dtc_bc_rc_limsup_lintegral_le P μs μ ha hb g hg hgc hg0)
    have hfin : ∫⁻ x, ENNReal.ofReal (g x) ∂μ ≠ ∞ := by
      have : IsFiniteMeasureOnCompacts μ := ⟨ha⟩
      exact (hg.integrable_of_hasCompactSupport hgc).lintegral_lt_top.ne
    have hconv : ∀ ν : Measure (Euclid P),
        ∫ x, g x ∂ν = (∫⁻ x, ENNReal.ofReal (g x) ∂ν).toReal := fun ν =>
      integral_eq_lintegral_of_nonneg_ae (ae_of_all _ hg0) hg.aestronglyMeasurable
    rw [hconv μ]
    exact ((ENNReal.tendsto_toReal hfin).comp hT).congr fun j => (hconv (μs j)).symm
  -- `f = f⁺ − f⁻` with `f⁺ = max(f, 0)`, `f⁻ = max(−f, 0)` continuous, `≥ 0`, supported in `K₀`
  have hcp : Continuous fun x => max (f x) 0 := hf.max continuous_const
  have hcn : Continuous fun x => max (-f x) 0 := hf.neg.max continuous_const
  have hsp : support (fun x => max (f x) 0) ⊆ support f := by
    intro x hx
    rw [mem_support] at hx ⊢
    contrapose! hx
    simp [hx]
  have hsn : support (fun x => max (-f x) 0) ⊆ support f := by
    intro x hx
    rw [mem_support] at hx ⊢
    contrapose! hx
    simp [hx]
  have hsplit : ∀ ν : Measure (Euclid P), ν (tsupport f) < ∞ →
      ∫ x, f x ∂ν = ∫ x, max (f x) 0 ∂ν - ∫ x, max (-f x) 0 ∂ν := by
    intro ν hν
    rw [← integral_sub (hint ν hν _ hcp (hsp.trans (subset_tsupport f)))
      (hint ν hν _ hcn (hsn.trans (subset_tsupport f)))]
    simp only [max_zero_sub_max_neg_zero_eq_self]
  rw [hsplit μ (ha _ hK₀)]
  refine ((key _ hcp (hfc.mono hsp) fun x => le_max_right _ _).sub
    (key _ hcn (hfc.mono hsn) fun x => le_max_right _ _)).congr' ?_
  filter_upwards [eventually_ge_atTop j₁] with j hj
  exact (hsplit (μs j) (hj₁ j hj)).symm

/-- **Blow-ups at a point of finite density have locally bounded mass** (proof of Simon 7.3.1,
display (1), chapter-07.txt lines 329–335): if `Θⁿ(μ_T, x) = θ` and `λⱼ > 0`, `λⱼ → 0`, then
for each `R` there is `c < ∞` with `M_{B_R(0)}(η_{x,λⱼ#}T) ≤ c` for all large `j`.  For `R ≤ 0`
the ball is empty and the mass is `0`.  For `R > 0`, `M_{B_ρ(x)}(T) ≤ (θ + 1) ωₙ ρⁿ` for small
`ρ > 0`; since `η_{x,λ}(B_{λR}(x)) = B_R(0)`, the scaling `Submission.dtc_blowUp_scaling` gives
`M_{B_R(0)}(η_{x,λⱼ#}T) = λⱼ⁻ⁿ M_{B_{λⱼR}(x)}(T) ≤ (θ + 1) ωₙ Rⁿ` once `λⱼR` is small. -/
theorem Submission.dtc_bc_bh_blowUp_massOn_ball_bounded : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (x : Euclid P) (θ : ℝ), IsOpen U → 0 < n → HasMassDensity T x θ → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (blowUp T x (lams j) (hlams j).ne').massOn (ball 0 R) ≤ c := by
  intro P n U T x θ hU hn hθ lams hlams hlim R
  obtain ⟨hθ0, hlimθ⟩ := hθ
  by_cases hR : 0 < R
  swap
  · -- `R ≤ 0`: `B_R(0) = ∅`, the only admissible form is `0`, so the mass is `0`
    refine ⟨0, ENNReal.zero_ne_top, Eventually.of_forall fun j => ?_⟩
    have hempty : ball (0 : Euclid P) R = ∅ := ball_eq_empty.2 (not_lt.1 hR)
    rw [hempty]
    apply sSup_le
    rintro r ⟨ω, hω, rfl⟩
    have hω0 : ω = 0 := by
      apply Subtype.ext
      funext y
      by_contra hy
      have : y ∈ tsupport (ω : DifferentialForm (Euclid P) n) := subset_tsupport _ hy
      exact (hω.1 this).elim
    simp only [hω0, map_zero, ENNReal.ofReal_zero, le_refl]
  -- `ωₙ ∈ (0, ∞)`
  have hω0 : unitBallVolume n ≠ 0 :=
    (Metric.measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  -- the density ratio is eventually `< ofReal (θ + 1)` as `ρ ↓ 0`
  have hlt : ENNReal.ofReal θ < ENNReal.ofReal (θ + 1) :=
    (ENNReal.ofReal_lt_ofReal_iff (by linarith)).2 (by linarith)
  obtain ⟨s₀, hs₀, hs₀ev⟩ := (nhdsGT_basis (0 : ℝ)).eventually_iff.1
    ((tendsto_order.1 hlimθ).2 _ hlt)
  -- hence `M_{B_ρ(x)}(T) ≤ ofReal (θ + 1) ωₙ ρⁿ` for `0 < ρ < s₀`
  have hmass : ∀ ρ : ℝ, 0 < ρ → ρ < s₀ →
      T.massOn (ball x ρ) ≤ ENNReal.ofReal (θ + 1) * (unitBallVolume n * ENNReal.ofReal (ρ ^ n)) := by
    intro ρ hρ hρs
    have h := hs₀ev ⟨hρ, hρs⟩
    have hb0 : unitBallVolume n * ENNReal.ofReal (ρ ^ n) ≠ 0 :=
      mul_ne_zero hω0 (ENNReal.ofReal_pos.2 (pow_pos hρ n)).ne'
    have hbtop : unitBallVolume n * ENNReal.ofReal (ρ ^ n) ≠ ∞ :=
      ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
    exact ((ENNReal.div_lt_iff (Or.inl hb0) (Or.inl hbtop)).1 h).le
  refine ⟨ENNReal.ofReal (θ + 1) * (unitBallVolume n * ENNReal.ofReal (R ^ n)),
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top), ?_⟩
  have hsmall : ∀ᶠ j in atTop, lams j * R < s₀ := by
    have h0 : Tendsto (fun j => lams j * R) atTop (𝓝 0) := by
      simpa using hlim.mul_const R
    exact (tendsto_order.1 h0).2 s₀ hs₀
  filter_upwards [hsmall] with j hj
  have hlam := hlams j
  -- `η_j(B_{λⱼR}(x)) = B_R(0)`
  have himg : dilation x (lams j) '' ball x (lams j * R) = ball 0 R := by
    have hdil : ∀ y : Euclid P, dilation x (lams j) y = (lams j)⁻¹ • (y - x) := by
      intro y
      simp only [dilation, dilationCLM, FunLike.coe_smul, Pi.smul_apply,
        ContinuousLinearMap.coe_id', id_eq, smul_sub]
      abel
    ext z
    constructor
    · rintro ⟨y, hy, rfl⟩
      rw [mem_ball, dist_eq_norm] at hy
      rw [mem_ball, dist_zero_right, hdil, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam.le)]
      calc (lams j)⁻¹ * ‖y - x‖ < (lams j)⁻¹ * (lams j * R) :=
            mul_lt_mul_of_pos_left hy (inv_pos.2 hlam)
        _ = R := by field_simp
    · intro hz
      rw [mem_ball, dist_zero_right] at hz
      refine ⟨x + lams j • z, ?_, ?_⟩
      · rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
        exact mul_lt_mul_of_pos_left hz hlam
      · rw [hdil, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hlam.ne', one_smul]
  rw [← himg, (Submission.dtc_blowUp_scaling P n U U T x (lams j) hlam hU hn).1 (ball x (lams j * R))]
  calc ENNReal.ofReal ((lams j)⁻¹ ^ n) * T.massOn (ball x (lams j * R))
      ≤ ENNReal.ofReal ((lams j)⁻¹ ^ n) *
          (ENNReal.ofReal (θ + 1) * (unitBallVolume n * ENNReal.ofReal ((lams j * R) ^ n))) := by
        gcongr
        exact hmass _ (mul_pos hlam hR) hj
    _ = ENNReal.ofReal (θ + 1) * (unitBallVolume n * ENNReal.ofReal (R ^ n)) := by
        rw [mul_left_comm]
        congr 1
        rw [mul_left_comm, ← ENNReal.ofReal_mul (by positivity)]
        congr 2
        rw [mul_pow, ← mul_assoc, ← mul_pow, inv_mul_cancel₀ hlam.ne', one_pow, one_mul]

/-- **Blow-up domains and boundaries near `x ∉ spt ∂T`** (Simon 7.3.1, proof, chapter-07.txt
lines 334–335: "`∂η_{x,λⱼ#}T = 0` in `B_R(0)` for sufficiently large `j` (because
`x ∉ spt ∂T`)").  `ηⱼ = η_{x,λⱼ}` is an affine homeomorphism with `ηⱼ(x + λⱼz) = z`, so (1) `ηⱼ(U)`
is open.  As `x ∈ U ∩ Z(∂T)` (`Z` the zero region, `spt ∂T = U \ Z(∂T)`), some `B_r(x)` lies in
`U ∩ Z(∂T)`, and `λⱼR < r` for all large `j`; then (2) `B̄_R(0) ⊆ ηⱼ(B_r(x)) ⊆ ηⱼ(U)`, and (3)
`∂(ηⱼ#T) = ηⱼ#(∂T)` has support `ηⱼ(spt ∂T)`, which misses `B_R(0) ⊆ ηⱼ(B_r(x))`, so `∂(ηⱼ#T)`
annihilates every test form supported in `B_R(0)` (`dtc_blowUp_algebra`,
`dtc_vanish_off_support`). -/
theorem Submission.dtc_bc_bh_blowUp_domain_boundary : ∀ (P m : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)) (x : Euclid P), IsOpen U → x ∈ U → x ∉ boundarySupport T → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → (∀ j, IsOpen (dilation x (lams j) '' U)) ∧ (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ dilation x (lams j) '' U) ∧ (∀ R : ℝ, ∀ᶠ j in atTop, ∀ ω : TestFormOn (dilation x (lams j) '' U) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball 0 R → (blowUp T x (lams j) (hlams j).ne').boundary ω = 0) := by
  intro P m U T x hU hxU hxb lams hlams hlim
  -- `η_{x,λ}(y) = λ⁻¹ • (y - x)`
  have hdil : ∀ (lam : ℝ) (y : Euclid P), dilation x lam y = lam⁻¹ • (y - x) := by
    intro lam y
    simp only [dilation, dilationCLM, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.coe_id', id_eq, smul_sub]
    abel
  -- `η_{x,λ}(x + λz) = z`, and `η_{x,λ}(y) = z` forces `y = x + λz`
  have hdil_inv : ∀ (lam : ℝ) (z : Euclid P), lam ≠ 0 → dilation x lam (x + lam • z) = z := by
    intro lam z hlam
    rw [hdil, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hlam, one_smul]
  have hdil_eq : ∀ (lam : ℝ) (y z : Euclid P), lam ≠ 0 → dilation x lam y = z →
      y = x + lam • z := by
    intro lam y z hlam h
    rw [← h, hdil, smul_smul, mul_inv_cancel₀ hlam, one_smul, add_sub_cancel]
  -- `λⱼR` is eventually below any positive bound
  have hsmall : ∀ (R t : ℝ), 0 < t → ∀ᶠ j in atTop, lams j * R < t := by
    intro R t ht
    have h0 : Tendsto (fun j => lams j * R) atTop (𝓝 0) := by
      simpa using hlim.mul_const R
    exact (tendsto_order.1 h0).2 t ht
  -- (1) `ηⱼ(U)` is the image of the open `U` under a homeomorphism
  have hopen : ∀ j, IsOpen (dilation x (lams j) '' U) := by
    intro j
    have hlam : lams j ≠ 0 := (hlams j).ne'
    have hfun : dilation x (lams j) =
        ((Homeomorph.subRight x).trans (Homeomorph.smulOfNeZero (lams j)⁻¹ (inv_ne_zero hlam)) :
          Euclid P → Euclid P) := by
      funext y
      rw [hdil]
      rfl
    rw [hfun]
    exact ((Homeomorph.subRight x).trans
      (Homeomorph.smulOfNeZero (lams j)⁻¹ (inv_ne_zero hlam))).isOpenMap U hU
  -- a ball `B_r(x)` inside `U` and inside the zero region of `∂T`
  have hxZ : x ∈ T.boundary.zeroRegion := by
    by_contra h
    exact hxb ⟨hxU, h⟩
  obtain ⟨r, hr, hrU⟩ :=
    Metric.isOpen_iff.1 (hU.inter T.boundary.isOpen_zeroRegion) x ⟨hxU, hxZ⟩
  refine ⟨hopen, ?_, ?_⟩
  · -- (2) `B̄_R(0) ⊆ ηⱼ(U)` once `λⱼR < r`
    intro R
    filter_upwards [hsmall R r hr] with j hj
    intro z hz
    have hlam := hlams j
    refine ⟨x + lams j • z, (hrU ?_).1, hdil_inv (lams j) z hlam.ne'⟩
    rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
    rw [mem_closedBall, dist_zero_right] at hz
    calc lams j * ‖z‖ ≤ lams j * R := mul_le_mul_of_nonneg_left hz hlam.le
      _ < r := hj
  · -- (3) `∂(ηⱼ#T)(ω) = 0` for `spt ω ⊆ B_R(0)` once `λⱼR < r`
    intro R
    filter_upwards [hsmall R r hr] with j hj ω hω
    have hlam := hlams j
    have hALG := Submission.dtc_blowUp_algebra P U x (lams j) hlam
    rw [hALG.2.2.2 m T]
    apply Submission.dtc_vanish_off_support
    rw [hALG.2.2.1 m T.boundary, Set.disjoint_left]
    rintro z hz ⟨y, hy, hyz⟩
    have hyx : y = x + lams j • z := hdil_eq (lams j) y z hlam.ne' hyz
    have hzR := hω hz
    rw [mem_ball, dist_zero_right] at hzR
    have hyball : y ∈ ball x r := by
      rw [hyx, mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul,
        Real.norm_of_nonneg hlam.le]
      calc lams j * ‖z‖ ≤ lams j * R := mul_le_mul_of_nonneg_left hzR.le hlam.le
        _ < r := hj
    exact hy.2 (hrU hyball).2
/-- **Rescaled retractions** (Simon 7.2.4 and Remark 7.2.5(2), rescaled for the blow-ups of
7.3.1).  Let `π` be a `C¹` retraction of `B_δ(x)` onto `N` (`π(B_δ(x)) ⊆ N`, `π = id` on
`N ∩ B_δ(x)`) whose Lipschitz constant on `B_s(x)` is at most `1 + η` for small `s`.  Then
`πⱼ(z) = η_{x,λⱼ}(π(x + λⱼz)) = λⱼ⁻¹(π(x + λⱼz) − x)` is, for all large `j`, a `C¹` map of
`B_G(0)` into `η_{x,λⱼ}(U ∩ N)` which is the identity on `η_{x,λⱼ}(U ∩ N) ∩ B_G(0)` and satisfies
`|πⱼ(z)| ≤ 2|z|`; and for every `η > 0`, eventually `πⱼ` is `(1 + η)`-Lipschitz on `B_G(0)`.
Once `λⱼG` is below a radius `s₁` on which `π` is `2`-Lipschitz and below half the radius of a
ball `B_{r₀}(x) ⊆ U`, `x + λⱼz ∈ B_{s₁}(x)` and `|π(x + λⱼz) − x| ≤ 2λⱼ|z| < r₀` (`π(x) = x`). -/
theorem Submission.dtc_bc_bh_rescaled_retraction : ∀ (P : ℕ) (U N : Set (Euclid P)) (x : Euclid P) (δ : ℝ) (π : Euclid P → Euclid P), IsOpen U → x ∈ U → x ∈ N → 0 < δ → ContDiffOn ℝ 1 π (ball x δ) → MapsTo π (ball x δ) N → (∀ y ∈ N ∩ ball x δ, π y = y) → (∀ η : ℝ, 0 < η → ∃ s : ℝ, 0 < s ∧ s ≤ δ ∧ ∀ y ∈ ball x s, ∀ z ∈ ball x s, ‖π y - π z‖ ≤ (1 + η) * ‖y - z‖) → ∀ lams : ℕ → ℝ, (∀ j, 0 < lams j) → Tendsto lams atTop (𝓝 0) → ∀ G : ℝ, 0 < G → ∃ πs : ℕ → Euclid P → Euclid P, (∀ᶠ j in atTop, ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧ MapsTo (πs j) (ball 0 G) (dilation x (lams j) '' (U ∩ N)) ∧ (∀ y ∈ dilation x (lams j) '' (U ∩ N) ∩ ball 0 G, πs j y = y) ∧ ∀ y ∈ ball 0 G, ‖πs j y‖ ≤ 2 * ‖y‖) ∧ ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G, ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖ := by
  intro P U N x δ π hU hxU hxN hδ hC hmaps hid hlip lams hlams hlim G hG
  -- a ball `B_{r₀}(x) ⊆ U`
  obtain ⟨r₀, hr₀, hr₀U⟩ := Metric.isOpen_iff.1 hU x hxU
  -- `π` is `2`-Lipschitz on `B_{s₁}(x)`
  obtain ⟨s₁, hs₁, hs₁δ, hlip1⟩ := hlip 1 one_pos
  have hπx : π x = x := hid x ⟨hxN, mem_ball_self hδ⟩
  -- `η_{x,λ}(y) = λ⁻¹ • (y - x)`
  have hdil : ∀ (lam : ℝ) (y : Euclid P), dilation x lam y = lam⁻¹ • (y - x) := by
    intro lam y
    simp only [dilation, dilationCLM, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.coe_id', id_eq, smul_sub]
    abel
  -- `x + λ • z ∈ B_t(x)` when `z ∈ B_G(0)` and `λ G ≤ t`
  have hmem : ∀ (lam t : ℝ) (z : Euclid P), 0 < lam → lam * G ≤ t → z ∈ ball (0 : Euclid P) G →
      x + lam • z ∈ ball x t := by
    intro lam t z hlam hlt hz
    rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
    rw [mem_ball, dist_zero_right] at hz
    calc lam * ‖z‖ < lam * G := mul_lt_mul_of_pos_left hz hlam
      _ ≤ t := hlt
  -- `λⱼ G < t` for all large `j`
  have hsmall : ∀ t : ℝ, 0 < t → ∀ᶠ j in atTop, lams j * G < t := by
    intro t ht
    have h0 : Tendsto (fun j => lams j * G) atTop (𝓝 0) := by
      simpa using hlim.mul_const G
    exact (tendsto_order.1 h0).2 t ht
  refine ⟨fun j z => dilation x (lams j) (π (x + lams j • z)), ?_, ?_⟩
  · filter_upwards [hsmall (min s₁ (r₀ / 2)) (lt_min hs₁ (half_pos hr₀))] with j hj
    have hlam := hlams j
    have hj₁ : lams j * G ≤ s₁ := hj.le.trans (min_le_left _ _)
    have hj₂ : lams j * G ≤ r₀ / 2 := hj.le.trans (min_le_right _ _)
    have hjδ : lams j * G ≤ δ := hj₁.trans hs₁δ
    -- the affine map `z ↦ x + λⱼ z` maps `B_G(0)` into `B_δ(x)`
    have hmapsδ : MapsTo (fun z : Euclid P => x + lams j • z) (ball 0 G) (ball x δ) :=
      fun z hz => hmem (lams j) δ z hlam hjδ hz
    -- `π(x + λⱼ z) ∈ U ∩ N` and `|π(x + λⱼ z) - x| ≤ 2 λⱼ |z|`
    have hkey : ∀ z ∈ ball (0 : Euclid P) G, π (x + lams j • z) ∈ U ∩ N ∧
        ‖π (x + lams j • z) - x‖ ≤ 2 * (lams j * ‖z‖) := by
      intro z hz
      have hy : x + lams j • z ∈ ball x s₁ := hmem (lams j) s₁ z hlam hj₁ hz
      have hbd : ‖π (x + lams j • z) - x‖ ≤ 2 * (lams j * ‖z‖) := by
        have := hlip1 _ hy x (mem_ball_self hs₁)
        rw [hπx] at this
        calc ‖π (x + lams j • z) - x‖ ≤ (1 + 1) * ‖x + lams j • z - x‖ := this
          _ = 2 * (lams j * ‖z‖) := by
            rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]; norm_num
      refine ⟨⟨hr₀U ?_, hmaps (hmapsδ hz)⟩, hbd⟩
      rw [mem_ball, dist_eq_norm]
      rw [mem_ball, dist_zero_right] at hz
      calc ‖π (x + lams j • z) - x‖ ≤ 2 * (lams j * ‖z‖) := hbd
        _ < 2 * (lams j * G) := by
          have := mul_lt_mul_of_pos_left hz hlam
          linarith
        _ ≤ r₀ := by linarith
    refine ⟨?_, ?_, ?_, ?_⟩
    · -- `C¹` on `B_G(0)`
      have hdilC : ContDiff ℝ 1 (dilation x (lams j)) := by
        unfold dilation
        exact contDiff_const.add (dilationCLM P (lams j)).contDiff
      have haff : ContDiff ℝ 1 (fun z : Euclid P => x + lams j • z) :=
        contDiff_const.add (contDiff_id.const_smul (lams j))
      exact hdilC.comp_contDiffOn (hC.comp haff.contDiffOn hmapsδ)
    · -- maps `B_G(0)` into `η_j(U ∩ N)`
      intro z hz
      exact ⟨π (x + lams j • z), (hkey z hz).1, rfl⟩
    · -- identity on `η_j(U ∩ N) ∩ B_G(0)`
      rintro z ⟨⟨y', hy', rfl⟩, hz⟩
      have hinv : x + lams j • dilation x (lams j) y' = y' := by
        rw [hdil, smul_smul, mul_inv_cancel₀ hlam.ne', one_smul, add_sub_cancel]
      show dilation x (lams j) (π (x + lams j • dilation x (lams j) y')) = dilation x (lams j) y'
      rw [hinv, hid y' ⟨hy'.2, ?_⟩]
      rw [← hinv]
      exact hmapsδ hz
    · -- `|π_j(z)| ≤ 2|z|`
      intro z hz
      show ‖dilation x (lams j) (π (x + lams j • z))‖ ≤ 2 * ‖z‖
      rw [hdil, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam.le)]
      calc (lams j)⁻¹ * ‖π (x + lams j • z) - x‖ ≤ (lams j)⁻¹ * (2 * (lams j * ‖z‖)) :=
            mul_le_mul_of_nonneg_left (hkey z hz).2 (inv_nonneg.2 hlam.le)
        _ = 2 * ‖z‖ := by field_simp
  · intro η hη
    obtain ⟨s, hs, hsδ, hlipη⟩ := hlip η hη
    filter_upwards [hsmall s hs] with j hj y hy z hz
    have hlam := hlams j
    have hy' := hmem (lams j) s y hlam hj.le hy
    have hz' := hmem (lams j) s z hlam hj.le hz
    show ‖dilation x (lams j) (π (x + lams j • y)) - dilation x (lams j) (π (x + lams j • z))‖ ≤
      (1 + η) * ‖y - z‖
    rw [hdil, hdil, ← smul_sub, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam.le)]
    have h1 := hlipη _ hy' _ hz'
    have h2 : ‖x + lams j • y - (x + lams j • z)‖ = lams j * ‖y - z‖ := by
      rw [add_sub_add_left_eq_sub, ← smul_sub, norm_smul, Real.norm_of_nonneg hlam.le]
    have h3 : π (x + lams j • y) - x - (π (x + lams j • z) - x) =
        π (x + lams j • y) - π (x + lams j • z) := by abel
    rw [h3]
    calc (lams j)⁻¹ * ‖π (x + lams j • y) - π (x + lams j • z)‖
        ≤ (lams j)⁻¹ * ((1 + η) * (lams j * ‖y - z‖)) := by
          rw [← h2]; exact mul_le_mul_of_nonneg_left h1 (inv_nonneg.2 hlam.le)
      _ = (1 + η) * ‖y - z‖ := by field_simp
/-- Local `C¹` retraction onto `N` (proof of Simon 7.3.1), Lipschitz bound near a point: if `f` is
`C¹` on `B_δ(x)` and `‖Df(x)‖ ≤ c`, then for every `η > 0`, `f` is `(c + η)`-Lipschitz on some
`B_s(x)`, `0 < s ≤ δ`.  `Df` is continuous at `x`, so `‖Df(y)‖ ≤ ‖Df(x)‖ + η ≤ c + η` on a small
ball `B_s(x)`; the mean value inequality on the convex ball `B_s(x)` gives the bound. -/
theorem Submission.dtc_bc_lr_lipschitz_near_point : ∀ (P : ℕ) (f : Euclid P → Euclid P) (x : Euclid P) (δ c : ℝ), 0 < δ → ContDiffOn ℝ 1 f (ball x δ) → ‖fderiv ℝ f x‖ ≤ c → ∀ η : ℝ, 0 < η → ∃ s : ℝ, 0 < s ∧ s ≤ δ ∧ ∀ y ∈ ball x s, ∀ z ∈ ball x s, ‖f y - f z‖ ≤ (c + η) * ‖y - z‖ := by
  intro P f x δ c hδ hf hc η hη
  -- `f` is differentiable at every point of the open ball `B_δ(x)`, and `Df` is continuous there
  have hdiff : ∀ y ∈ ball x δ, DifferentiableAt ℝ f y := fun y hy =>
    (hf.differentiableOn one_ne_zero y hy).differentiableAt (isOpen_ball.mem_nhds hy)
  have hcont : ContinuousOn (fderiv ℝ f) (ball x δ) :=
    hf.continuousOn_fderiv_of_isOpen isOpen_ball le_rfl
  -- continuity of `Df` at `x`: `‖Df(y) - Df(x)‖ < η` for `|y - x| < s₁`; take `s = min s₁ δ`
  obtain ⟨s₁, hs₁, hDf⟩ := Metric.continuousAt_iff.1
    (hcont.continuousAt (isOpen_ball.mem_nhds (mem_ball_self hδ))) η hη
  refine ⟨min s₁ δ, lt_min hs₁ hδ, min_le_right _ _, ?_⟩
  -- `‖Df(y)‖ ≤ ‖Df(x)‖ + ‖Df(y) - Df(x)‖ ≤ c + η` on `B_s(x)`
  have hbound : ∀ y ∈ ball x (min s₁ δ), ‖fderiv ℝ f y‖ ≤ c + η := by
    intro y hy
    have hy₁ : ‖fderiv ℝ f y - fderiv ℝ f x‖ < η := by
      rw [← dist_eq_norm]
      exact hDf ((mem_ball.1 hy).trans_le (min_le_left _ _))
    exact (norm_le_norm_add_norm_sub' _ _).trans (add_le_add hc hy₁.le)
  -- mean value inequality on the convex ball `B_s(x)`
  intro y hy z hz
  exact (convex_ball x (min s₁ δ)).norm_image_sub_le_of_norm_fderiv_le
    (fun w hw => hdiff w (ball_subset_ball (min_le_right _ _) hw)) hbound hz hy
/-- **Simon 7.3.1** (proof; local retraction onto `N`, step 1): an injective linear map
`L : ℝᵈ → ℝᴾ` has a left inverse `A` with `‖L ∘ A‖ ≤ 1`.  With `Q = L(ℝᵈ)`, `p` the orthogonal
projection of `ℝᴾ` onto `Q` and `e : ℝᵈ ≃ Q`, `e w = L w`, take `A = e⁻¹ ∘ p`: then `A ∘ L = id`,
and `L ∘ A` is the orthogonal projection of `ℝᴾ` onto `Q`, of norm `≤ 1`. -/
theorem Submission.dtc_bc_lr_left_inverse_projection : ∀ (P d : ℕ) (L : Euclid d →L[ℝ] Euclid P), Injective L → ∃ A : Euclid P →L[ℝ] Euclid d, A.comp L = ContinuousLinearMap.id ℝ (Euclid d) ∧ ‖L.comp A‖ ≤ 1 := by
  intro P d L hL
  -- `Q = L(ℝᵈ)` and the isomorphism `e : ℝᵈ ≃ Q`, `e w = L w`
  let Q : Submodule ℝ (Euclid P) := LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)
  let e : Euclid d ≃L[ℝ] Q :=
    (LinearEquiv.ofInjective (L : Euclid d →ₗ[ℝ] Euclid P) hL).toContinuousLinearEquiv
  have he : ∀ w, (e w : Euclid P) = L w := fun w => rfl
  -- `A = e⁻¹ ∘ p`, `p` the orthogonal projection onto `Q`
  refine ⟨(e.symm : Q →L[ℝ] Euclid d).comp Q.orthogonalProjectionOnto, ?_, ?_⟩
  · -- `p (L w) = e w`, so `A (L w) = w`
    refine ContinuousLinearMap.ext fun w => ?_
    have hp : Q.orthogonalProjectionOnto (L w) = e w := by
      rw [← he]
      exact Q.orthogonalProjectionOnto_mem_subspace_eq_self (e w)
    simp [hp]
  · -- `L ∘ A = ι ∘ p` is the orthogonal projection of `ℝᴾ` onto `Q`
    have hLA : L.comp ((e.symm : Q →L[ℝ] Euclid d).comp Q.orthogonalProjectionOnto) =
        Q.starProjection := by
      refine ContinuousLinearMap.ext fun y => ?_
      rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearEquiv.coe_coe, ← he, ContinuousLinearEquiv.apply_symm_apply,
        Submodule.starProjection_apply]
    rw [hLA]
    exact Q.starProjection_norm_le
/-- **Local `C¹` inverse** (inverse function theorem, step 2 of the local retraction in the proof
of Simon 7.3.1).  If `h` is `C¹` on the open set `V ∋ v₀` with `Dh(v₀) = id`, there are open
`V₀ ⊆ V` with `v₀ ∈ V₀` and `O`, and `k`, `C¹` on `O`, such that `h : V₀ → O` and `k : O → V₀` are
mutually inverse, and `Dk(h(v₀)) = id`.  The inverse function theorem gives a partial
homeomorphism `e` with `⇑e = h`, source `S ∋ v₀` and target `T`; on the open set
`G = {v ∈ V : ‖Dh(v) − 1‖ < 1}` (which contains `v₀`) `Dh(v)` is invertible (Neumann series).  Take
`V₀ = S ∩ G`, `O = T ∩ e.symm⁻¹(V₀)`, `k = e.symm`; the `C¹` inverse rule at each `u ∈ O` makes
`k` `C¹` on `O`, and `k` has derivative `id⁻¹ = id` at `h(v₀)`. -/
theorem Submission.dtc_bc_lr_local_inverse : ∀ (d : ℕ) (h : Euclid d → Euclid d) (V : Set (Euclid d)) (v₀ : Euclid d), IsOpen V → v₀ ∈ V → ContDiffOn ℝ 1 h V → fderiv ℝ h v₀ = ContinuousLinearMap.id ℝ (Euclid d) → ∃ (V₀ O : Set (Euclid d)) (k : Euclid d → Euclid d), IsOpen V₀ ∧ IsOpen O ∧ V₀ ⊆ V ∧ v₀ ∈ V₀ ∧ MapsTo h V₀ O ∧ MapsTo k O V₀ ∧ (∀ v ∈ V₀, k (h v) = v) ∧ (∀ u ∈ O, h (k u) = u) ∧ ContDiffOn ℝ 1 k O ∧ fderiv ℝ k (h v₀) = ContinuousLinearMap.id ℝ (Euclid d) := by
  intro d h V v₀ hV hv₀ hh hd
  -- Step 1: `h` is `C¹` at every point of `V`, `Dh` is continuous on `V`, and `h` has strict
  -- derivative `id` at `v₀`
  have hca : ∀ v ∈ V, ContDiffAt ℝ 1 h v := fun v hv => hh.contDiffAt (hV.mem_nhds hv)
  have hcont : ContinuousOn (fderiv ℝ h) V := hh.continuousOn_fderiv_of_isOpen hV le_rfl
  have hfd : HasFDerivAt h
      ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
        Euclid d →L[ℝ] Euclid d) v₀ := by
    rw [ContinuousLinearEquiv.coe_refl, ← hd]
    exact ((hca v₀ hv₀).differentiableAt one_ne_zero).hasFDerivAt
  have hs := (hca v₀ hv₀).hasStrictFDerivAt' hfd one_ne_zero
  -- Step 2: the inverse function theorem gives a partial homeomorphism `e` with `⇑e = h`, and
  -- its inverse has derivative `id⁻¹ = id` at `h(v₀)`
  obtain ⟨e, he⟩ : ∃ e : OpenPartialHomeomorph (Euclid d) (Euclid d),
      e = hs.toOpenPartialHomeomorph h := ⟨_, rfl⟩
  have hecoe : (e : Euclid d → Euclid d) = h := by
    rw [he]; exact hs.toOpenPartialHomeomorph_coe
  have hv₀e : v₀ ∈ e.source := by
    rw [he]; exact hs.mem_toOpenPartialHomeomorph_source
  have hk : HasFDerivAt (e.symm : Euclid d → Euclid d) (ContinuousLinearMap.id ℝ (Euclid d))
      (h v₀) := by
    have h7 := hs.to_localInverse
    rw [hs.localInverse_def, ← he, ContinuousLinearEquiv.refl_symm,
      ContinuousLinearEquiv.coe_refl] at h7
    exact h7.hasFDerivAt
  -- Step 3: `G = {v ∈ V : ‖Dh(v) − 1‖ < 1}` is open, contains `v₀`, and `Dh(v)` is invertible
  -- for `v ∈ G`
  obtain ⟨G, hG⟩ : ∃ G : Set (Euclid d), G = V ∩ fderiv ℝ h ⁻¹' ball 1 1 := ⟨_, rfl⟩
  have hGo : IsOpen G := hG ▸ hcont.isOpen_inter_preimage hV isOpen_ball
  have hGV : G ⊆ V := hG ▸ inter_subset_left
  have hv₀G : v₀ ∈ G := by
    rw [hG]
    refine ⟨hv₀, ?_⟩
    show fderiv ℝ h v₀ ∈ ball 1 1
    rw [hd, ← ContinuousLinearMap.one_def]
    exact mem_ball_self one_pos
  have hGu : ∀ v ∈ G, ∃ L : Euclid d ≃L[ℝ] Euclid d,
      (L : Euclid d →L[ℝ] Euclid d) = fderiv ℝ h v := by
    intro v hv
    rw [hG] at hv
    have hu : IsUnit (fderiv ℝ h v) := by
      by_contra hnu
      exact nonunits.subset_compl_ball (mem_nonunits_iff.mpr hnu) hv.2
    obtain ⟨u, hu⟩ := hu
    refine ⟨ContinuousLinearEquiv.unitsEquiv ℝ (Euclid d) u, ?_⟩
    ext x
    simp [ContinuousLinearEquiv.unitsEquiv_apply, ← hu]
  -- Step 4: `V₀ = S ∩ G`, `O = T ∩ e.symm⁻¹(V₀)`, `k = e.symm`
  refine ⟨e.source ∩ G, e.target ∩ e.symm ⁻¹' (e.source ∩ G), e.symm,
    e.open_source.inter hGo, e.isOpen_inter_preimage_symm (e.open_source.inter hGo),
    fun v hv => hGV hv.2, ⟨hv₀e, hv₀G⟩, ?_, fun u hu => hu.2, fun v hv => ?_, fun u hu => ?_,
    ?_, ?_⟩
  -- Step 5: mapping and inverse identities
  · intro v hv
    have h1 := e.map_source hv.1
    have h2 := e.left_inv hv.1
    rw [hecoe] at h1 h2
    exact ⟨h1, by rw [mem_preimage, h2]; exact hv⟩
  · have h2 := e.left_inv hv.1
    rwa [hecoe] at h2
  · have h2 := e.right_inv hu.1
    rwa [hecoe] at h2
  -- Step 6: `k` is `C¹` on `O`, by the `C¹` inverse rule at each `u ∈ O`
  · intro u hu
    obtain ⟨L, hL⟩ := hGu _ hu.2.2
    have ha : e.symm u ∈ V := hGV hu.2.2
    have hfa : HasFDerivAt (e : Euclid d → Euclid d) (L : Euclid d →L[ℝ] Euclid d)
        (e.symm u) := by
      rw [hL, hecoe]
      exact ((hca _ ha).differentiableAt one_ne_zero).hasFDerivAt
    have hca' : ContDiffAt ℝ 1 (e : Euclid d → Euclid d) (e.symm u) := by
      rw [hecoe]; exact hca _ ha
    exact (e.contDiffAt_symm hu.1 hfa hca').contDiffWithinAt
  -- Step 7: `Dk(h(v₀)) = id`
  · exact hk.fderiv
/-- **Simon 7.3.1** (proof of (2), local retraction onto `N`, chart step): if `W` is open, `ψ` is
continuous and injective on `V`, `ψ(V) = W ∩ N` and `ψ` is proper over `W` (`V ∩ ψ⁻¹(K)` is
compact for compact `K ⊆ W`), then `N ∩ B_ρ(ψ(v₀)) ⊆ ψ(V₀)` for some `ρ > 0`, whenever `V₀ ⊆ V`
is open and `v₀ ∈ V₀`.  Otherwise there are `yᵢ = ψ(fᵢ) ∈ N` with `fᵢ ∈ V \ V₀` and
`yᵢ → ψ(v₀)`; the `fᵢ` lie in the compact set `V ∩ ψ⁻¹({ψ(v₀)} ∪ {yᵢ})`, so a subsequence
converges to some `a ∈ V \ V₀` with `ψ(a) = ψ(v₀)`, contradicting injectivity. -/
theorem Submission.dtc_bc_lr_chart_image_nhds : ∀ (P d : ℕ) (N W : Set (Euclid P)) (V V₀ : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen W → ContinuousOn ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → IsOpen V₀ → V₀ ⊆ V → v₀ ∈ V₀ → ∃ ρ : ℝ, 0 < ρ ∧ N ∩ ball (ψ v₀) ρ ⊆ ψ '' V₀ := by
  intro P d N W V V₀ ψ v₀ hW hψc hψi hψV hprop hV₀ hV₀V hv₀
  -- Step 1: `x := ψ v₀ ∈ W` and `B_{r_W}(x) ⊆ W`
  have hv₀V : v₀ ∈ V := hV₀V hv₀
  have hxW : ψ v₀ ∈ W := (hψV ▸ mem_image_of_mem ψ hv₀V : ψ v₀ ∈ W ∩ N).1
  obtain ⟨rW, hrW, hballW⟩ := Metric.isOpen_iff.1 hW _ hxW
  -- Step 2: otherwise pick `yᵢ ∈ N ∩ B_{min(r_W, 1/(i+1))}(x) \ ψ(V₀)`, so `yᵢ ∈ W` and `yᵢ → x`
  by_contra hcon
  have hseq : ∀ i : ℕ, ∃ y, y ∈ N ∧ dist y (ψ v₀) < min rW (1 / ((i : ℝ) + 1)) ∧ y ∉ ψ '' V₀ := by
    intro i
    obtain ⟨y, ⟨hyN, hyb⟩, hy⟩ := not_subset.1 fun h =>
      hcon ⟨min rW (1 / ((i : ℝ) + 1)), lt_min hrW (by positivity), h⟩
    exact ⟨y, hyN, hyb, hy⟩
  choose y hyN hyd hyV₀ using hseq
  have hyW : ∀ i, y i ∈ W := fun i => hballW ((hyd i).trans_le (min_le_left _ _))
  have hylim : Tendsto y atTop (𝓝 (ψ v₀)) :=
    tendsto_iff_dist_tendsto_zero.2 (squeeze_zero (fun i => dist_nonneg)
      (fun i => ((hyd i).trans_le (min_le_right _ _)).le) tendsto_one_div_add_atTop_nhds_zero_nat)
  -- Step 3: `yᵢ = ψ(fᵢ)` with `fᵢ ∈ V \ V₀`
  have hf : ∀ i, ∃ f, f ∈ V ∧ ψ f = y i := fun i => (hψV.symm ▸ ⟨hyW i, hyN i⟩ : y i ∈ ψ '' V)
  choose f hfV hfy using hf
  have hfV₀ : ∀ i, f i ∉ V₀ := fun i hi => hyV₀ i ⟨f i, hi, hfy i⟩
  -- Step 4: `K := {x} ∪ {yᵢ}` is a compact subset of `W`, so `V ∩ ψ⁻¹(K) ∋ fᵢ` is compact
  have hKW : insert (ψ v₀) (range y) ⊆ W := by
    rintro z (rfl | ⟨i, rfl⟩)
    exacts [hxW, hyW i]
  have hfK : ∀ i, f i ∈ V ∩ ψ ⁻¹' insert (ψ v₀) (range y) := fun i =>
    ⟨hfV i, Or.inr ⟨i, (hfy i).symm⟩⟩
  -- Step 5: a subsequence `f_{φ(i)} → a ∈ V`
  obtain ⟨a, ⟨haV, -⟩, φ, hφ, hfa⟩ :=
    (hprop _ hKW hylim.isCompact_insert_range).tendsto_subseq hfK
  -- Step 6: `a ∉ V₀`, as `V₀ᶜ` is closed
  have haV₀ : a ∉ V₀ :=
    hV₀.isClosed_compl.mem_of_tendsto hfa (Eventually.of_forall fun i => hfV₀ (φ i))
  -- Step 7: `ψ(a) = x` by continuity of `ψ` on `V` and uniqueness of limits
  have h₁ : Tendsto (ψ ∘ (f ∘ φ)) atTop (𝓝 (ψ a)) :=
    (hψc a haV).tendsto.comp
      (tendsto_nhdsWithin_iff.2 ⟨hfa, Eventually.of_forall fun i => hfV (φ i)⟩)
  have h₂ : Tendsto (ψ ∘ (f ∘ φ)) atTop (𝓝 (ψ v₀)) := by
    have hcomp : ψ ∘ (f ∘ φ) = y ∘ φ := funext fun i => hfy (φ i)
    rw [hcomp]
    exact hylim.comp hφ.tendsto_atTop
  -- Step 8: injectivity gives `a = v₀ ∈ V₀`, a contradiction
  exact haV₀ (hψi haV hv₀V (tendsto_nhds_unique h₁ h₂) ▸ hv₀)
/-- **Local `C¹` retraction onto `N`** (moving blow-ups in the dimension reduction results; it
replaces the nearest-point projection of Simon 7.2.5(2)): near `x ∈ N` there is a `C¹` map `π`
of `B_δ(x)` into `N` fixing `N ∩ B_δ(x)` that is `(1 + η)`-Lipschitz on small balls `B_s(x)` for
every `η > 0`.  Take a chart `ψ` with `ψ(v₀) = x`, `L = Dψ(v₀)` and a left inverse `A` of `L`
with `‖L ∘ A‖ ≤ 1`; invert `h = A(ψ − x)` near `v₀` by `k`, `C¹` on `O ∋ 0`, and put
`π(y) = ψ(k(A(y − x)))`.  Properness of the chart gives `N ∩ B_ρ(x) ⊆ ψ(V₀)`, so `π` fixes
`N ∩ B_δ(x)`, and `Dπ(x) = L ∘ A` has norm `≤ 1`. -/
theorem Submission.dimred_mbl_bh_local_retraction : ∀ (P d : ℕ) (N : Set (Euclid P)) (x : Euclid P), IsEmbeddedSubmanifold 2 d N → x ∈ N → ∃ (δ : ℝ) (π : Euclid P → Euclid P), 0 < δ ∧ ContDiffOn ℝ 1 π (ball x δ) ∧ MapsTo π (ball x δ) N ∧ (∀ y ∈ N ∩ ball x δ, π y = y) ∧ ∀ η : ℝ, 0 < η → ∃ s : ℝ, 0 < s ∧ s ≤ δ ∧ ∀ y ∈ ball x s, ∀ z ∈ ball x s, ‖π y - π z‖ ≤ (1 + η) * ‖y - z‖ := by
  intro P d N x hN hx
  -- Step 1: a chart `ψ` at `x = ψ(v₀)`; `L = Dψ(v₀)` has a left inverse `A` with `‖L ∘ A‖ ≤ 1`
  obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hψi, hψV, hprop, hDψ⟩ := hN x hx
  have hxV : x ∈ ψ '' V := by
    rw [hψV]
    exact ⟨hxW, hx⟩
  obtain ⟨v₀, hv₀V, hψv₀⟩ := hxV
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by norm_num)
  have hψd : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ :=
    ((hψ1.contDiffAt (hV.mem_nhds hv₀V)).differentiableAt one_ne_zero).hasFDerivAt
  obtain ⟨A, hAL, hLA⟩ :=
    Submission.dimred_mbl_bh_lr_left_inverse_projection P d (fderiv ℝ ψ v₀) (hDψ v₀ hv₀V)
  -- Step 2: `h(v) = A(ψ(v) − x)` is `C¹` on `V` with `Dh(v₀) = A ∘ L = id`; it has a `C¹`
  -- inverse `k : O → V₀` near `v₀`, and `h(v₀) = 0`, `k(0) = v₀`
  obtain ⟨h, hh_def⟩ : ∃ h : Euclid d → Euclid d, h = fun v => A (ψ v - x) := ⟨_, rfl⟩
  have hhC : ContDiffOn ℝ 1 h V := by
    rw [hh_def]
    exact A.contDiff.comp_contDiffOn (hψ1.sub contDiffOn_const)
  have hDh : fderiv ℝ h v₀ = ContinuousLinearMap.id ℝ (Euclid d) := by
    rw [← hAL, hh_def]
    exact (A.hasFDerivAt.comp v₀ (hψd.sub_const x)).fderiv
  obtain ⟨V₀, O, k, hV₀, hO, hV₀V, hv₀V₀, hhV₀, hkO, hkh, -, hk, hDk⟩ :=
    Submission.dtc_bc_lr_local_inverse d h V v₀ hV hv₀V hhC hDh
  have hhv₀ : h v₀ = 0 := by simp only [hh_def, hψv₀, sub_self, map_zero]
  have h0O : (0 : Euclid d) ∈ O := by
    rw [← hhv₀]
    exact hhV₀ hv₀V₀
  have hk0 : k 0 = v₀ := by
    rw [← hhv₀]
    exact hkh v₀ hv₀V₀
  -- Step 3: properness of the chart: `N ∩ B_ρ(x) ⊆ ψ(V₀)`
  obtain ⟨ρ, hρ, hNρ⟩ := Submission.dtc_bc_lr_chart_image_nhds P d N W V V₀ ψ v₀ hW
    hψ1.continuousOn hψi hψV hprop hV₀ hV₀V hv₀V₀
  rw [hψv₀] at hNρ
  -- Step 4: `B_{r₀}(0) ⊆ O` and `δ = min(ρ, r₀/(‖A‖ + 1))`, so `A(y − x) ∈ O` for `y ∈ B_δ(x)`
  obtain ⟨r₀, hr₀, hr₀O⟩ := Metric.isOpen_iff.1 hO 0 h0O
  have hA1 : 0 < ‖A‖ + 1 := by positivity
  obtain ⟨δ, hδ_def⟩ : ∃ δ : ℝ, δ = min ρ (r₀ / (‖A‖ + 1)) := ⟨_, rfl⟩
  have hδ : 0 < δ := by
    rw [hδ_def]
    exact lt_min hρ (div_pos hr₀ hA1)
  have hδρ : δ ≤ ρ := by
    rw [hδ_def]
    exact min_le_left _ _
  have hδr : (‖A‖ + 1) * δ ≤ r₀ := by
    calc (‖A‖ + 1) * δ ≤ (‖A‖ + 1) * (r₀ / (‖A‖ + 1)) := by
          rw [hδ_def]
          exact mul_le_mul_of_nonneg_left (min_le_right _ _) hA1.le
      _ = r₀ := mul_div_cancel₀ r₀ hA1.ne'
  have haO : MapsTo (fun y => A (y - x)) (ball x δ) O := by
    intro y hy
    apply hr₀O
    rw [mem_ball, dist_zero_right]
    rw [mem_ball, dist_eq_norm] at hy
    calc ‖A (y - x)‖ ≤ ‖A‖ * ‖y - x‖ := A.le_opNorm _
      _ ≤ ‖A‖ * δ := mul_le_mul_of_nonneg_left hy.le (norm_nonneg A)
      _ < (‖A‖ + 1) * δ := by linarith
      _ ≤ r₀ := hδr
  -- Step 5: `π(y) = ψ(k(A(y − x)))` is `C¹` on `B_δ(x)`, maps `B_δ(x)` into `N` and fixes
  -- `N ∩ B_δ(x)`
  have hπC : ContDiffOn ℝ 1 (fun y => ψ (k (A (y - x)))) (ball x δ) :=
    (hψ1.comp hk fun u hu => hV₀V (hkO hu)).comp
      (A.contDiff.comp (contDiff_id.sub contDiff_const)).contDiffOn haO
  have hπN : MapsTo (fun y => ψ (k (A (y - x)))) (ball x δ) N := by
    intro y hy
    have hy' : ψ (k (A (y - x))) ∈ ψ '' V := mem_image_of_mem ψ (hV₀V (hkO (haO hy)))
    rw [hψV] at hy'
    exact hy'.2
  have hπfix : ∀ y ∈ N ∩ ball x δ, ψ (k (A (y - x))) = y := by
    rintro y ⟨hyN, hyδ⟩
    obtain ⟨v, hv, rfl⟩ := hNρ ⟨hyN, ball_subset_ball hδρ hyδ⟩
    have hAv : A (ψ v - x) = h v := by rw [hh_def]
    rw [hAv, hkh v hv]
  -- Step 6: `Dπ(x) = L ∘ A` by the chain rule (`A(x − x) = 0`, `Dk(0) = id`, `k(0) = v₀`), so
  -- `‖Dπ(x)‖ ≤ 1`, and `π` is `(1 + η)`-Lipschitz near `x`
  have hkd : HasFDerivAt k (ContinuousLinearMap.id ℝ (Euclid d)) (A (x - x)) := by
    have h1 : HasFDerivAt k (fderiv ℝ k (h v₀)) (h v₀) :=
      ((hk.contDiffAt (hO.mem_nhds (hhV₀ hv₀V₀))).differentiableAt one_ne_zero).hasFDerivAt
    rwa [hDk, hhv₀, ← map_zero A, ← sub_self x] at h1
  have hψd' : HasFDerivAt ψ (fderiv ℝ ψ v₀) (k (A (x - x))) := by
    rwa [sub_self, map_zero, hk0]
  have hπd : HasFDerivAt (fun y => ψ (k (A (y - x))))
      ((fderiv ℝ ψ v₀).comp ((ContinuousLinearMap.id ℝ (Euclid d)).comp
        (A.comp (ContinuousLinearMap.id ℝ (Euclid P))))) x :=
    hψd'.comp x (hkd.comp x (A.hasFDerivAt.comp x ((hasFDerivAt_id x).sub_const x)))
  have hDπ : ‖fderiv ℝ (fun y => ψ (k (A (y - x)))) x‖ ≤ 1 := by
    rw [hπd.fderiv, ContinuousLinearMap.id_comp, ContinuousLinearMap.comp_id]
    exact hLA
  exact ⟨δ, fun y => ψ (k (A (y - x))), hδ, hπC, hπN, hπfix, fun η hη =>
    Submission.dtc_bc_lr_lipschitz_near_point P _ x δ 1 hδ hπC hDπ η hη⟩

/-- **The moving blow-ups `S_j = η_{x_j,λ_j#}T`** (Simon 7.2.5(2), chapter-07.txt lines 166–173,
and the proof of 7.3.1, lines 326–337; Ch. 6, 2.23–2.24, 3.3–3.9), for `x_j → x ∈ U` and
`λ_j > 0`, `λ_j → 0`.  (1) `η_j = η_{x_j,λ_j}` is an affine homeomorphism, so `U_j = η_j(U)` is
open.  (2) If `B_r(x) ⊆ U`, eventually `|x_j − x| + λ_j R < r`; then every `z ∈ B̄_R(0)` is
`η_j(x_j + λ_j z)` with `x_j + λ_j z ∈ B_r(x)`.  (3), (4), (6): minimality, support and boundary
transport along one dilation (`dtc_blowUp_isMinimizingIn`, `dtc_blowUp_algebra`), and
`η_{j#}0 = 0`.  (5) is the mass bound for moving centres from the monotonicity hypothesis, and
(7) rescales along `η_j` the local retraction onto `N` at `x`, needed only when `x ∈ N`. -/
theorem Submission.dimred_mbl_blowUp_hypotheses : ∀ (m k ℓ : ℕ), ℓ ≤ k → ∀ (U N : Set (Euclid (m + 1 + k))) (T : GeometricCurrentOn U (m + 1)), IsOpen U → IsEmbeddedSubmanifold 2 (m + 1 + ℓ) N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T → (∀ K : Set (Euclid (m + 1 + k)), IsCompact K → K ⊆ U → ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ (y : Euclid (m + 1 + k)) (R : ℝ), closedBall y R ⊆ K → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ (m + 1)) * T.massOn (ball y ρ)) (Ioo 0 R)) → ∀ (x : Euclid (m + 1 + k)) (xs : ℕ → Euclid (m + 1 + k)) (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), x ∈ U → Tendsto xs atTop (𝓝 x) → Tendsto lams atTop (𝓝 0) → (∀ j, IsOpen (dilation (xs j) (lams j) '' U)) ∧ (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid (m + 1 + k)) R ⊆ dilation (xs j) (lams j) '' U) ∧ (∀ j, IsMinimizingIn (blowUp T (xs j) (lams j) (hlams j).ne') (dilation (xs j) (lams j) '' (U ∩ N))) ∧ (∀ j, (blowUp T (xs j) (lams j) (hlams j).ne').support ⊆ dilation (xs j) (lams j) '' (U ∩ N)) ∧ (∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (blowUp T (xs j) (lams j) (hlams j).ne').massOn (ball 0 R) ≤ c) ∧ (∀ j, (blowUp T (xs j) (lams j) (hlams j).ne').boundary = 0) ∧ ∀ G : ℝ, 0 < G → ∃ (πs : ℕ → Euclid (m + 1 + k) → Euclid (m + 1 + k)) (G' : ℝ), (∀ᶠ j in atTop, dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G = ∅ ∨ (ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧ MapsTo (πs j) (ball 0 G) (dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G') ∧ ∀ y ∈ dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G, πs j y = y)) ∧ ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G = ∅ ∨ ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G, ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖ := by
  intro m k ℓ _ U N T hU hN hcl hmin hspt hbv hmon x xs lams hlams hxU hxs hlam0
  refine ⟨fun j => ?_, fun R => ?_, fun j => ?_, fun j => ?_, ?_, fun j => ?_, ?_⟩
  · -- (1) `η_j` is a homeomorphism, so `U_j = η_j(U)` is open
    obtain ⟨e, he⟩ : ∃ e : Euclid (m + 1 + k) ≃ₜ Euclid (m + 1 + k),
        ⇑e = dilation (xs j) (lams j) :=
      ⟨(Homeomorph.smulOfNeZero (lams j)⁻¹ (inv_ne_zero (hlams j).ne')).trans
        (Homeomorph.addLeft (-((lams j)⁻¹ • xs j))), by
          funext y
          simp [dilation, dilationCLM]⟩
    rw [← he]
    exact e.isOpenMap U hU
  · -- (2) `B_r(x) ⊆ U`; eventually `|x_j − x| + λ_j R < r`, and then `z ∈ B̄_R(0)` is
    -- `η_j(x_j + λ_j z)` with `|x_j + λ_j z − x| ≤ λ_j R + |x_j − x| < r`
    obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hU x hxU
    have h0 : Tendsto (fun j => dist (xs j) x + lams j * R) atTop (𝓝 0) := by
      have h1 : Tendsto (fun j => dist (xs j) x) atTop (𝓝 0) :=
        tendsto_iff_dist_tendsto_zero.1 hxs
      have h2 : Tendsto (fun j => lams j * R) atTop (𝓝 0) := by
        simpa using hlam0.mul_const R
      simpa using h1.add h2
    filter_upwards [(tendsto_order.1 h0).2 r hr] with j hj
    intro z hz
    have hlam := hlams j
    rw [mem_closedBall, dist_zero_right] at hz
    refine ⟨xs j + lams j • z, hrU ?_, ?_⟩
    · rw [mem_ball]
      calc dist (xs j + lams j • z) x ≤ dist (xs j + lams j • z) (xs j) + dist (xs j) x :=
            dist_triangle _ _ _
        _ = lams j * ‖z‖ + dist (xs j) x := by
            rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
        _ ≤ lams j * R + dist (xs j) x := by gcongr
        _ < r := by linarith
    · simp [dilation, dilationCLM, smul_add, smul_smul, hlam.ne']
  · -- (3) minimality in `A_j = η_j(U ∩ N)`
    exact Submission.dtc_blowUp_isMinimizingIn _ _ U (U ∩ N) T (xs j) (lams j) (hlams j) hmin
  · -- (4) `spt S_j = η_j(spt T) ⊆ η_j(U ∩ N)`
    rw [(Submission.dtc_blowUp_algebra _ U (xs j) (lams j) (hlams j)).2.2.1 (m + 1) T]
    exact image_mono hspt
  · -- (5) the mass bound for moving centres
    exact Submission.dimred_mbl_bh_moving_blowUp_mass_bound _ _ U T hU hmin.1 hmon x xs lams
      hlams hxU hxs hlam0
  · -- (6) `∂S_j = η_{j#}(∂T) = η_{j#}0 = 0`
    rw [(Submission.dtc_blowUp_algebra _ U (xs j) (lams j) (hlams j)).2.2.2 m T]
    have hb : T.boundary = 0 := hbv
    rw [hb]
    ext ω
    simp [blowUp]
  · -- (7) the local retraction onto `N` at `x` (if `x ∈ N`), rescaled along `η_j`
    exact Submission.dimred_mbl_bh_moving_rescaled_retractions _ U N x xs lams hU hcl hxU
      (fun hxN => Submission.dimred_mbl_bh_local_retraction _ _ N x hN hxN) hlams hxs hlam0
/-- **Simon 7.2.4 along blow-up sequences** (minimality and convergence of the mass measures).
Let `Sⱼ ∈ 𝒟ₙ(Uⱼ)`, `Uⱼ` open and eventually containing every ball, `Sⱼ ⇀ C` in `ℝᴾ` with `C`
integer multiplicity, and suppose the local comparison (3) holds.  Then `C` is minimizing in `ℝᴾ`
(`dimred_mbl_mm_isMinimizingIn_univ`, Simon (8)–(12)).  For representations `Rⱼ` of `Sⱼ` and `R`
of `C`, `μ_R` is finite on compact sets, `limsup μ_{Rⱼ}(K) ≤ μ_R(K)` for compact `K` and
`μ_R(G) ≤ liminf μ_{Rⱼ}(G)` for open `G` (`dimred_mbl_mm_measure_bounds`, Simon (13), (14)); the
Radon criterion `cmc_tendsto_integral_of_limsup_liminf` with `U = ℝᴾ` then gives
`∫ f dμ_{Rⱼ} → ∫ f dμ_R`. -/
theorem Submission.dimred_mbl_minimizing_and_measures : ∀ (P n : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ j, IsOpen (Us j)) → (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → IsIntegerMultiplicity C → ConvergesWeakly Ss C → (∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ ∀ S : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity S → SameBoundary S C → (S - C).support ⊆ K → limsup (fun j => (Ss (ψ (φ' j))).massOn W) atTop ≤ S.massOn W) → IsMinimizingIn C univ ∧ MassMeasuresConverge Ss C := by
  intro P n Us Ss C hUs hball hC hconv hloc
  -- step 1: `C` is minimizing in `ℝᴾ`
  refine ⟨Submission.dimred_mbl_mm_isMinimizingIn_univ P n Us Ss C hball hC hconv hloc, ?_⟩
  -- step 3: the weights `μ_{Rⱼ}`, `μ_R` satisfy the hypotheses of the Radon criterion
  intro Rs hRs R hR f hf hfc hfU
  obtain ⟨hfin, hsup, hinf⟩ :=
    Submission.dimred_mbl_mm_measure_bounds P n Us Ss C hUs hball hconv hloc Rs hRs R hR
  -- step 2: the Radon criterion with `U = ℝᴾ`
  exact Submission.cmc_tendsto_integral_of_limsup_liminf P univ (fun j => (Rs j).measure)
    R.measure (fun K hK _ => hfin K hK) (fun K hK _ => hsup K hK) (fun G hG _ => hinf G hG)
    f hf hfc hfU

/-- **Local `C¹` retraction onto an embedded `C²` submanifold** (proof of Simon 7.3.1; it stands
in for the nearest-point projection onto `N`, cf. Simon 7.5).  For `x ∈ N` there are `δ > 0` and
`π`, `C¹` on `B_δ(x)`, with `π(B_δ(x)) ⊆ N`, `π = id` on `N ∩ B_δ(x)`, and, for every `η > 0`,
`π` is `(1 + η)`-Lipschitz on some `B_s(x)`, `0 < s ≤ δ`.

* A chart `ψ` with `ψ(v₀) = x`, and a left inverse `A` of `L = Dψ(v₀)` with `‖L ∘ A‖ ≤ 1`.
* Inverse function theorem for `h = A(ψ − x)`, `Dh(v₀) = A ∘ L = id`: a `C¹` inverse
  `k : O → V₀` with `Dk(h(v₀)) = id`.
* Properness of the chart: `N ∩ B_ρ(x) ⊆ ψ(V₀)`.
* `π(y) = ψ(k(A(y − x)))`, `δ = min(ρ, r₀/(‖A‖ + 1))` with `B_{r₀}(0) ⊆ O`; `π` fixes
  `N ∩ B_δ(x)` because `A(ψ(v) − x) = h(v)`, and `Dπ(x) = L ∘ A` has norm `≤ 1`. -/
theorem Submission.dtc_bc_local_retraction : ∀ (P d : ℕ) (N : Set (Euclid P)) (x : Euclid P), IsEmbeddedSubmanifold 2 d N → x ∈ N → ∃ (δ : ℝ) (π : Euclid P → Euclid P), 0 < δ ∧ ContDiffOn ℝ 1 π (ball x δ) ∧ MapsTo π (ball x δ) N ∧ (∀ y ∈ N ∩ ball x δ, π y = y) ∧ ∀ η : ℝ, 0 < η → ∃ s : ℝ, 0 < s ∧ s ≤ δ ∧ ∀ y ∈ ball x s, ∀ z ∈ ball x s, ‖π y - π z‖ ≤ (1 + η) * ‖y - z‖ := by
  intro P d N x hN hx
  -- Step 1: a chart `ψ` at `x = ψ v₀`, `L = Dψ(v₀)` and a left inverse `A` of `L`
  obtain ⟨V, W, ψ, hVo, hWo, hxW, hψ2, hψinj, hψV, hψK, hψD⟩ := hN x hx
  obtain ⟨v₀, hv₀V, hψv₀⟩ : x ∈ ψ '' V := hψV ▸ ⟨hxW, hx⟩
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ2.of_le (by norm_num)
  have hψv₀D : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ :=
    ((hψ1.contDiffAt (hVo.mem_nhds hv₀V)).differentiableAt one_ne_zero).hasFDerivAt
  obtain ⟨A, hAL, hLA⟩ :=
    Submission.dtc_bc_lr_left_inverse_projection P d (fderiv ℝ ψ v₀) (hψD v₀ hv₀V)
  -- Step 2: the local inverse `k` of `h = A (ψ - x)` near `v₀`
  set h : Euclid d → Euclid d := fun v => A (ψ v - x) with hh_def
  have hh1 : ContDiffOn ℝ 1 h V := A.contDiff.comp_contDiffOn (hψ1.sub contDiffOn_const)
  have hhD : fderiv ℝ h v₀ = ContinuousLinearMap.id ℝ (Euclid d) := by
    rw [← hAL]
    exact (A.hasFDerivAt.comp v₀ (hψv₀D.sub_const x)).fderiv
  obtain ⟨V₀, O, k, hV₀o, hOo, hV₀V, hv₀V₀, hhV₀, hkO, hkh, -, hk1, hkD⟩ :=
    Submission.dtc_bc_lr_local_inverse d h V v₀ hVo hv₀V hh1 hhD
  have hh0 : h v₀ = 0 := by simp [hh_def, hψv₀]
  -- Step 3: `ψ(V₀)` is a neighbourhood of `x` in `N`
  obtain ⟨ρ, hρ, hρV₀⟩ := Submission.dtc_bc_lr_chart_image_nhds P d N W V V₀ ψ v₀ hWo
    hψ1.continuousOn hψinj hψV hψK hV₀o hV₀V hv₀V₀
  rw [hψv₀] at hρV₀
  -- Step 4: `δ` and `π(y) = ψ (k (A (y - x)))`
  obtain ⟨r₀, hr₀, hr₀O⟩ := Metric.isOpen_iff.1 hOo 0 (by rw [← hh0]; exact hhV₀ hv₀V₀)
  have hA1 : 0 < ‖A‖ + 1 := by positivity
  set δ : ℝ := min ρ (r₀ / (‖A‖ + 1))
  have hδ : 0 < δ := lt_min hρ (div_pos hr₀ hA1)
  have hAO : MapsTo (fun y => A (y - x)) (ball x δ) O := by
    intro y hy
    apply hr₀O
    rw [mem_ball_zero_iff]
    have hy' : ‖y - x‖ < r₀ / (‖A‖ + 1) := (mem_ball_iff_norm.1 hy).trans_le (min_le_right _ _)
    calc ‖A (y - x)‖ ≤ ‖A‖ * ‖y - x‖ := A.le_opNorm _
      _ ≤ (‖A‖ + 1) * ‖y - x‖ := mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _)
      _ < (‖A‖ + 1) * (r₀ / (‖A‖ + 1)) := mul_lt_mul_of_pos_left hy' hA1
      _ = r₀ := by field_simp
  -- (i) `π` is `C¹` on `B_δ(x)`
  have hπ1 : ContDiffOn ℝ 1 (fun y => ψ (k (A (y - x)))) (ball x δ) :=
    hψ1.comp (hk1.comp (A.contDiff.comp (contDiff_id.sub contDiff_const)).contDiffOn hAO)
      ((hkO.comp hAO).mono_right hV₀V)
  -- (ii) `π(B_δ(x)) ⊆ N`
  have hπN : MapsTo (fun y => ψ (k (A (y - x)))) (ball x δ) N := by
    intro y hy
    have hy' : ψ (k (A (y - x))) ∈ ψ '' V := mem_image_of_mem ψ (hV₀V (hkO (hAO hy)))
    rw [hψV] at hy'
    exact hy'.2
  -- (iii) `π` fixes `N ∩ B_δ(x)`
  have hπfix : ∀ y ∈ N ∩ ball x δ, ψ (k (A (y - x))) = y := by
    rintro y ⟨hyN, hy⟩
    obtain ⟨v, hv, rfl⟩ := hρV₀ ⟨hyN, ball_subset_ball (min_le_left _ _) hy⟩
    exact congrArg ψ (hkh v hv)
  -- `Dπ(x) = L ∘ Dk(h(v₀)) ∘ A = L ∘ A` has norm `≤ 1`
  have hπD : ‖fderiv ℝ (fun y => ψ (k (A (y - x)))) x‖ ≤ 1 := by
    have hg : HasFDerivAt (fun y => A (y - x)) A x := by
      have := A.hasFDerivAt.comp x ((hasFDerivAt_id x).sub_const x)
      rw [ContinuousLinearMap.comp_id] at this
      exact this
    have hgx : A (x - x) = h v₀ := by rw [hh0, sub_self, map_zero]
    have hk : HasFDerivAt k (ContinuousLinearMap.id ℝ (Euclid d)) (A (x - x)) := by
      rw [hgx, ← hkD]
      exact ((hk1.contDiffAt (hOo.mem_nhds (hhV₀ hv₀V₀))).differentiableAt
        one_ne_zero).hasFDerivAt
    have hψ' : HasFDerivAt ψ (fderiv ℝ ψ v₀) (k (A (x - x))) := by
      rw [hgx, hkh v₀ hv₀V₀]
      exact hψv₀D
    have hπx : HasFDerivAt (fun y => ψ (k (A (y - x))))
        ((fderiv ℝ ψ v₀).comp ((ContinuousLinearMap.id ℝ (Euclid d)).comp A)) x :=
      hψ'.comp x (hk.comp x hg)
    rw [hπx.fderiv, ContinuousLinearMap.id_comp]
    exact hLA
  -- (iv) Lipschitz constant `1 + η` near `x`
  exact ⟨δ, fun y => ψ (k (A (y - x))), hδ, hπ1, hπN, hπfix,
    fun η hη => Submission.dtc_bc_lr_lipschitz_near_point P _ x δ 1 hδ hπ1 hπD η hη⟩

/-- **The blow-ups satisfy the hypotheses of the compactness theorem** (proof of Simon 7.3.1,
display (1), chapter-07.txt lines 326–337; compactness theorem 7.2.4 in the form of
Remark 7.2.5(2)).  Let `T` be minimizing in `U ∩ N`, `spt T ⊆ U ∩ N`, `x ∈ spt T \ spt ∂T`,
`Θⁿ(μ_T, x) = θ`, and `λⱼ > 0`, `λⱼ → 0`; put `ηⱼ = η_{x,λⱼ}` and `Sⱼ = η_{x,λⱼ#}T`.  Then
(1) `ηⱼ(U)` is open; (2) `B̄_R(0) ⊆ ηⱼ(U)` for large `j`; (3) `Sⱼ` is minimizing in
`ηⱼ(U ∩ N)`; (4) `spt Sⱼ ⊆ ηⱼ(U ∩ N)`; (5) `M_{B_R(0)}(Sⱼ)` is bounded for large `j`;
(6) `∂Sⱼ = 0` in `B_R(0)` for large `j`; (7) there are `C¹` retractions `πⱼ` of `B_G(0)` onto
`ηⱼ(U ∩ N)` with `|πⱼ(y)| ≤ 2|y|` and Lipschitz constants tending to `1`.

* (1), (2), (6): `dtc_bc_bh_blowUp_domain_boundary`, as `x ∈ U` and `x ∉ spt ∂T`.
* (3): `dtc_blowUp_scaling` with `A = U ∩ N`.
* (4): `spt Sⱼ = ηⱼ(spt T)` (`dtc_blowUp_algebra`) and `spt T ⊆ U ∩ N`.
* (5): `dtc_bc_bh_blowUp_massOn_ball_bounded`, from the finite density at `x`.
* (7): a local retraction `π` onto `N` at `x ∈ N` (`dtc_bc_local_retraction`), rescaled to
  `πⱼ = ηⱼ ∘ π ∘ ηⱼ⁻¹` by `dtc_bc_bh_rescaled_retraction`. -/
theorem Submission.dtc_bc_blowUp_hypotheses : ∀ (m k ℓ : ℕ) (U N : Set (Euclid (m + 1 + k))) (T : GeometricCurrentOn U (m + 1)) (x : Euclid (m + 1 + k)) (θ : ℝ), IsOpen U → IsEmbeddedSubmanifold 2 (m + 1 + ℓ) N → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → x ∈ T.support \ boundarySupport T → HasMassDensity T x θ → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → (∀ j, IsOpen (dilation x (lams j) '' U)) ∧ (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid (m + 1 + k)) R ⊆ dilation x (lams j) '' U) ∧ (∀ j, IsMinimizingIn (blowUp T x (lams j) (hlams j).ne') (dilation x (lams j) '' (U ∩ N))) ∧ (∀ j, (blowUp T x (lams j) (hlams j).ne').support ⊆ dilation x (lams j) '' (U ∩ N)) ∧ (∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (blowUp T x (lams j) (hlams j).ne').massOn (ball 0 R) ≤ c) ∧ (∀ R : ℝ, ∀ᶠ j in atTop, ∀ ω : TestFormOn (dilation x (lams j) '' U) m, tsupport (ω : DifferentialForm (Euclid (m + 1 + k)) m) ⊆ ball 0 R → (blowUp T x (lams j) (hlams j).ne').boundary ω = 0) ∧ (∀ G : ℝ, 0 < G → ∃ πs : ℕ → Euclid (m + 1 + k) → Euclid (m + 1 + k), (∀ᶠ j in atTop, ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧ MapsTo (πs j) (ball 0 G) (dilation x (lams j) '' (U ∩ N)) ∧ (∀ y ∈ dilation x (lams j) '' (U ∩ N) ∩ ball 0 G, πs j y = y) ∧ ∀ y ∈ ball 0 G, ‖πs j y‖ ≤ 2 * ‖y‖) ∧ ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G, ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖) := by
  intro m k ℓ U N T x θ hU hN hmin hspt hx hθ lams hlams hlim
  -- `x ∈ spt T ⊆ U ∩ N`
  have hxU : x ∈ U := (hspt hx.1).1
  have hxN : x ∈ N := (hspt hx.1).2
  -- (1), (2), (6): the blown-up domains exhaust `ℝᴾ`, and `∂Sⱼ = 0` on growing balls
  obtain ⟨h1, h2, h6⟩ := Submission.dtc_bc_bh_blowUp_domain_boundary (m + 1 + k) m U T x hU hxU
    hx.2 lams hlams hlim
  refine ⟨h1, h2, ?_, ?_, ?_, h6, ?_⟩
  · -- (3) minimality in `U ∩ N` is carried to `ηⱼ(U ∩ N)`
    intro j
    exact (Submission.dtc_blowUp_scaling (m + 1 + k) (m + 1) U (U ∩ N) T x (lams j) (hlams j) hU
      (Nat.succ_pos m)).2.2 hmin
  · -- (4) `spt Sⱼ = ηⱼ(spt T) ⊆ ηⱼ(U ∩ N)`
    intro j
    rw [(Submission.dtc_blowUp_algebra (m + 1 + k) U x (lams j) (hlams j)).2.2.1 (m + 1) T]
    exact image_mono hspt
  · -- (5) local mass bounds from `Θⁿ(μ_T, x) = θ`
    exact Submission.dtc_bc_bh_blowUp_massOn_ball_bounded (m + 1 + k) (m + 1) U T x θ hU
      (Nat.succ_pos m) hθ lams hlams hlim
  · -- (7) rescale a local `C¹` retraction onto `N` at `x`
    intro G hG
    obtain ⟨δ, π, hδ, hC, hmaps, hid, hlip⟩ :=
      Submission.dtc_bc_local_retraction (m + 1 + k) (m + 1 + ℓ) N x hN hxN
    exact Submission.dtc_bc_bh_rescaled_retraction (m + 1 + k) U N x δ π hU hxU hxN hδ hC hmaps
      hid hlip lams hlams hlim G hG

/-- **Simon 7.2.4** (proof, pp. 186–187: (8) and its localization, (12)–(14) and the closing
"standard approximation argument").  Let `Sⱼ ∈ 𝒟ₙ(Uⱼ)`, the open `Uⱼ` exhausting `ℝᴾ`, converge
weakly to the integer multiplicity `C ∈ 𝒟ₙ(ℝᴾ)`, and assume the local comparison: for compact `K`,
`ε > 0` and every subsequence `ψ` there are an open `W`, `K ⊆ W ⊆ K_ε`, and a further subsequence
`φ'` with `limsup_i M_W(S_{ψ(φ'(i))}) ≤ M_W(S)` for every integer multiplicity `S` with `∂S = ∂C`
and `spt(S − C) ⊆ K`.  Then `C` is minimizing in `ℝᴾ` (`dtc_bc_mm_isMinimizingIn_univ`), and
`μ_{Sⱼ} → μ_C` for all representations: the weights satisfy the compact/open semicontinuity
bounds (`dtc_bc_mm_measure_bounds`), so the Radon criterion
`dtc_bc_tendsto_integral_of_limsup_liminf` gives `∫ f dμ_{Sⱼ} → ∫ f dμ_C`. -/
theorem Submission.dtc_bc_minimizing_of_local_comparison : ∀ (P n : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ j, IsOpen (Us j)) → (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → IsIntegerMultiplicity C → ConvergesWeakly Ss C → (∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ ∀ S : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity S → SameBoundary S C → (S - C).support ⊆ K → limsup (fun j => (Ss (ψ (φ' j))).massOn W) atTop ≤ S.massOn W) → IsMinimizingIn C univ ∧ MassMeasuresConverge Ss C := by
  intro P n Us Ss C hU hex hC hconv hloc
  -- step 1: `C` is minimizing in `ℝᴾ` (book (8) and its localization)
  refine ⟨Submission.dtc_bc_mm_isMinimizingIn_univ P n Us Ss C hex hC hconv hloc, ?_⟩
  -- step 2: for representations `Rⱼ` of `Sⱼ` and `R` of `C`, `μ = μ_R` is finite on compacts,
  -- `limsup_j μⱼ(K) ≤ μ(K)` for compact `K` (13) and `μ(G) ≤ liminf_j μⱼ(G)` for bounded open
  -- `G` (14); the condition `tsupport f ⊆ ℝᴾ` is vacuous
  intro Rs hRs R hR f hf hfc _
  obtain ⟨ha, hb, hc⟩ :=
    Submission.dtc_bc_mm_measure_bounds P n Us Ss C hU hex hconv hloc Rs hRs R hR
  exact Submission.dtc_bc_tendsto_integral_of_limsup_liminf P (fun j => (Rs j).measure)
    R.measure ha hb hc f hf hfc

/-- Orientation of the push-forward by an injective linear map (Simon Ch. 6, 3.4–3.5 and 3.7:
`L_#ξ = J η`): if `ξ` is a unit orientation of `Q`, `ζ(β) = ξ(β ∘ L)` and
`J = (det(Leₐ · Le_b))^{1/2}` for the orthonormal basis `e` of `Q`, then `0 < J ≤ ‖L‖ⁿ` and `J⁻¹ζ`
is a unit orientation of `L(Q)`.  With `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` and `σ` an orthonormal frame of
`span (Lτ) = L(Q)`, `β(Lτ) = det A · β(σ)` for `A = (⟨σᵢ, Lτⱼ⟩)`, and `J = |det A|`. -/
theorem Submission.dpf_unitOrientation_map_gramNormalized : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P n) (L : Euclid P →L[ℝ] Euclid P) (J : ℝ), IsUnitOrientationOf ξ Q → Injective L → J = Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ Q) => inner ℝ (L (stdOrthonormalBasis ℝ Q i)) (L (stdOrthonormalBasis ℝ Q j)))) → 0 < J ∧ J ≤ ‖L‖ ^ n ∧ IsUnitOrientationOf (J⁻¹ • ξ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L)) (Submodule.map (L : Euclid P →ₗ[ℝ] Euclid P) Q) := by
  intro P n Q ξ L J hξ hL hJ
  -- `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of `Q`
  obtain ⟨τ, hτ, hτQ, hξτ⟩ := hξ
  -- `Lτ` is linearly independent; let `σ` be an orthonormal frame of `span (Lτ)` (Gram–Schmidt)
  have hv : LinearIndependent ℝ fun i => L (τ i) :=
    hτ.linearIndependent.map' (L : Euclid P →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.mpr hL)
  obtain ⟨σ, hσ, hσv, hdet, hA0, hAle⟩ :=
    Submission.dpf_exists_orthonormal_frame_det_gram P n (fun i => L (τ i)) hv
  -- `α(Lτ) = det A · α(σ)` for every `n`-covector `α`, where `A = (⟨σᵢ, Lτⱼ⟩)`: the restriction
  -- of `α` to `span σ` is `α(σ) det_σ`, and the coordinates of `Lτⱼ` in the basis `σ` are `Aᵢⱼ`
  have hcov : ∀ α : Covector (Euclid P) n, α (fun j => L (τ j)) =
      (Matrix.of fun i j => inner ℝ (σ i) (L (τ j))).det * α σ := by
    intro α
    set S := Submodule.span ℝ (Set.range σ)
    have hvS : ∀ j, L (τ j) ∈ S := fun j => by
      rw [hσv]
      exact Submodule.subset_span (Set.mem_range_self j)
    let e : Module.Basis (Fin n) ℝ S := Module.Basis.span hσ.linearIndependent
    have he : ∀ i, (e i : Euclid P) = σ i := fun i => by
      rw [Module.Basis.span_apply hσ.linearIndependent i]
    let αS : S [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap S.subtype
    let w : Fin n → S := fun j => ⟨L (τ j), hvS j⟩
    have h1 : α (fun j => L (τ j)) = αS w := rfl
    have h2 : α σ = αS e := by
      show α σ = α (fun i => (e i : Euclid P))
      congr 1
      funext i
      exact (he i).symm
    have hrepr : ∀ i j, e.repr (w j) i = inner ℝ (σ i) (L (τ j)) := by
      intro i j
      have hs : L (τ j) = ∑ l, e.repr (w j) l • σ l := by
        have := congrArg Subtype.val (e.sum_repr (w j))
        simp only [Submodule.coe_sum, Submodule.coe_smul, he] at this
        exact this.symm
      rw [hs, hσ.inner_right_fintype]
    have hmat : e.toMatrix w = Matrix.of fun i j => inner ℝ (σ i) (L (τ j)) := by
      ext i j
      rw [Module.Basis.toMatrix_apply, hrepr, Matrix.of_apply]
    have h3 : αS w = αS e * e.det w := by
      conv_lhs => rw [AlternatingMap.eq_smul_basis_det e αS]
      rfl
    rw [h1, h2, h3, Module.Basis.det_apply, hmat, mul_comm]
  generalize (Matrix.of fun i j => inner ℝ (σ i) (L (τ j))).det = d at hdet hA0 hAle hcov
  -- `J = √(det G(Le)) = √(det G(Lτ)) = √((det A)²) = |det A|`
  have hJd : J = |d| := by
    rw [hJ, Submission.dpf_det_gram_stdOrthonormalBasis_eq P n Q L τ hτ hτQ, hdet,
      Real.sqrt_sq_eq_abs]
  refine ⟨by rw [hJd]; exact abs_pos.mpr hA0, ?_, σ, hσ, ?_, ?_⟩
  · -- `J = |det A| ≤ ∏ᵢ ‖Lτᵢ‖ ≤ ‖L‖ⁿ`
    rw [hJd]
    refine hAle.trans ?_
    calc ∏ i, ‖L (τ i)‖ ≤ ∏ _i : Fin n, ‖L‖ :=
          Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) fun i _ => by
            simpa [hτ.1 i] using L.le_opNorm (τ i)
      _ = ‖L‖ ^ n := by simp
  · -- `span σ = span (Lτ) = L(span τ) = L(Q)`
    rw [hσv, ← hτQ, Submodule.map_span, ← Set.range_comp]
    rfl
  · -- `(J⁻¹ζ)(α) = J⁻¹ ξ(α ∘ L) = ±J⁻¹ α(Lτ) = ±(J⁻¹ det A) α(σ)` with `J⁻¹ det A = ±1`
    have hζ : ∀ α : Covector (Euclid P) n,
        (J⁻¹ • ξ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L)) α =
          J⁻¹ * ξ (α.compContinuousLinearMap L) := fun α => rfl
    have hατ : ∀ α : Covector (Euclid P) n, α.compContinuousLinearMap L τ = d * α σ :=
      fun α => hcov α
    have hsign : J⁻¹ * d = 1 ∨ J⁻¹ * d = -1 := by
      rw [hJd]
      rcases hA0.lt_or_gt with h | h
      · exact Or.inr (by rw [abs_of_neg h, inv_neg, neg_mul, inv_mul_cancel₀ hA0])
      · exact Or.inl (by rw [abs_of_pos h, inv_mul_cancel₀ hA0])
    rcases hξτ with hξτ | hξτ <;> rcases hsign with hs | hs
    · exact Or.inl fun α => by rw [hζ, hξτ, hατ]; linear_combination α σ * hs
    · exact Or.inr fun α => by rw [hζ, hξτ, hατ]; linear_combination α σ * hs
    · exact Or.inr fun α => by rw [hζ, hξτ, hατ]; linear_combination -α σ * hs
    · exact Or.inl fun α => by rw [hζ, hξτ, hατ]; linear_combination -α σ * hs

/-- Simon 6.3.6–3.9 and 6.2.24(3) for a `C¹` bi-Lipschitz bijection `φ` with `φ⁻¹(U) = U`
(step 9 of the push-forward proof): `ω ↦ ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ⟩ dHⁿ` is the action of the
integer multiplicity triple `R' = (φ(M), θ ∘ φ⁻¹, η ∘ φ⁻¹)`, where `η = J⁻¹ ξ(· ∘ Dφ)` and `J` is
the Gram Jacobian of `Dφ` on `TₓM`.  A.e. on `M`, `0 < J` and `η(x)` orients
`Dφ(x)TₓM = T_{φ(x)}φ(M)`; the area formula then transfers the action from `φ(M)` to `M`. -/
theorem Submission.dpf_imrep_bilipschitz_image_rep : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (φ : Euclid P → Euclid P) (Λ : NNReal), IsOpen U → ContDiff ℝ 1 φ → Bijective φ → (∀ x, Injective (fderiv ℝ φ x)) → LipschitzWith Λ φ → AntilipschitzWith Λ φ → φ ⁻¹' U = U → AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) (μHE[n].restrict R.carrier) → ∃ R' : IMRep U n, ∀ ω : TestFormOn U n, R'.action (ω : DifferentialForm (Euclid P) n) = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n] := by
  intro P n U R φ Λ hU hφ hbij hinj hlip hanti hpre hproj
  -- Step 2: `θ ≥ 1` on `M`, so `M` has locally finite `Hⁿ`-measure in `U`
  have hfin : ∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (R.carrier ∩ C) ≠ ∞ := by
    intro C hC hCU
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult C hC hCU) ?_
    calc μHE[n] (R.carrier ∩ C) = ∫⁻ _ in R.carrier ∩ C, 1 ∂μHE[n] := (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in R.carrier ∩ C, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
        setLIntegral_mono' (R.measurableSet_carrier.inter hC.isClosed.measurableSet)
          fun x hx => Nat.one_le_cast.2 (R.mult_pos x hx.1)
  have hφc : Continuous φ := hφ.continuous
  have hDφ : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  -- Step 3 (I): the Gram Jacobian `J` of `Dφ` on `TₓM` is a.e. strongly measurable
  obtain ⟨J, hJ⟩ : ∃ J : Euclid P → ℝ, J = fun x => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (approxTangentPlane n R.carrier x)) => inner ℝ (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n R.carrier x) i)) (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n R.carrier x) j)))) :=
    ⟨_, rfl⟩
  have hJm : AEStronglyMeasurable J (μHE[n].restrict R.carrier) := by
    rw [hJ]
    exact Submission.dpf_aestronglyMeasurable_gramJacobian P (μHE[n].restrict R.carrier)
      (approxTangentPlane n R.carrier) (fderiv ℝ φ) hproj hDφ.aestronglyMeasurable
  -- Step 4: the orientation `η = J⁻¹ ζ`, `ζ(x)(β) = ξ(x)(β ∘ Dφ(x))`, in source coordinates
  set η : Euclid P → MultiVector P n := fun x => (J x)⁻¹ •
    (R.orient x).comp (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ φ x))
  have hηm : AEStronglyMeasurable η (μHE[n].restrict R.carrier) := by
    have hζ : AEStronglyMeasurable (fun x => (R.orient x).comp
        (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ φ x)))
        (μHE[n].restrict R.carrier) :=
      (continuous_fst.clm_comp continuous_snd).comp_aestronglyMeasurable
        (R.aestronglyMeasurable_orient.prodMk
          (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp_aestronglyMeasurable
            hDφ.aestronglyMeasurable))
    exact hJm.aemeasurable.inv.aestronglyMeasurable.smul hζ
  -- Step 3: a.e. on `M`, `0 < J` and `η` orients `Dφ(x)TₓM`, the approximate tangent plane of
  -- `φ(M)` at `φ(x)` (`ξ(x)` orients `TₓM` by uniqueness of approximate tangent planes)
  have hgood : ∀ᵐ x ∂(μHE[n].restrict R.carrier), 0 < J x ∧ ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (φ '' R.carrier) (φ x) Q ∧ IsUnitOrientationOf (η x) Q := by
    filter_upwards [Submission.dpf_approxTangent_bilipschitz_image_ae P n U R.carrier φ Λ hU
      R.measurableSet_carrier R.carrier_subset R.rectifiable hfin hφ hinj hlip hanti hpre,
      R.orients] with x hx hξ
    obtain ⟨Q, hQ, hξQ⟩ := hξ
    rw [hQ.unique hx.1] at hξQ
    obtain ⟨hJpos, -, hηQ⟩ := Submission.dpf_unitOrientation_map_gramNormalized P n
      (approxTangentPlane n R.carrier x) (R.orient x) (fderiv ℝ φ x) (J x) hξQ (hinj x)
      (by rw [hJ])
    exact ⟨hJpos, _, hx.2, hηQ⟩
  -- Step 5: `R' = (φ(M), θ ∘ φ⁻¹, η ∘ φ⁻¹)` is an integer multiplicity triple in `U`
  obtain ⟨R', hR'c, hR'⟩ := Submission.dpfir_bilipschitz_image_imrep_exists P n U R φ Λ η hbij
    hlip hanti hpre hηm (hgood.mono fun x hx => hx.2)
  refine ⟨R', fun ω => ?_⟩
  obtain ⟨w, ⟨hws, hwc⟩, hwU⟩ := ω
  show R'.action w = ∫ x in R.carrier,
    (R.mult x : ℝ) * R.orient x ((w (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n]
  have hwcont : Continuous w := ContDiff.continuous hws
  -- Step 6(b): `β(x) = ω(φ(x)) ∘ Dφ(x)` is continuous with compact support `⊆ φ⁻¹(spt ω) ⊆ U`
  set β : Euclid P → Covector (Euclid P) n :=
    fun x => (w (φ x)).compContinuousLinearMap (fderiv ℝ φ x) with hβ
  have hβc : Continuous β :=
    (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp hDφ).clm_apply
      (hwcont.comp hφc)
  have hβsupp : tsupport β ⊆ φ ⁻¹' tsupport w := by
    refine closure_minimal (fun x hx => subset_tsupport w fun h0 => hx ?_)
      ((isClosed_tsupport w).preimage hφc)
    ext v
    simp [hβ, h0]
  have hβcs : HasCompactSupport β :=
    (Metric.isCompact_of_isClosed_isBounded ((isClosed_tsupport w).preimage hφc)
      (hanti.isBounded_preimage hwc.isCompact.isBounded)).of_isClosed_subset
      (isClosed_tsupport β) hβsupp
  have hβU : tsupport β ⊆ U := hβsupp.trans ((preimage_mono hwU).trans hpre.subset)
  -- Step 6(a): `J(x) h(φ(x)) = g_ω(x)` a.e. on `M`, where `h = θ'⟨ω, ξ'⟩` and `g_ω = θ⟨β, ξ⟩`
  have hJh : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      J x * ((R'.mult (φ x) : ℝ) * R'.orient (φ x) (w (φ x))) =
        (R.mult x : ℝ) * R.orient x (β x) := by
    filter_upwards [hgood] with x hx
    obtain ⟨hmult, horient⟩ := hR' x
    have hηx : η x (w (φ x)) = (J x)⁻¹ * R.orient x (β x) := rfl
    rw [hmult, horient, hηx, mul_left_comm, mul_inv_cancel_left₀ hx.1.ne']
  -- Step 6(c)–(d): the area formula on `φ(M)` transfers integrability and the integral
  have harea : ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y, g y ∂(μHE[n].restrict R'.carrier) =
      ∫⁻ x, ENNReal.ofReal (J x) * g (φ x) ∂(μHE[n].restrict R.carrier) := by
    intro g
    rw [hR'c, hJ]
    exact Submission.dpf_area_formula_bilipschitz_rectifiable P n U R.carrier φ Λ hU
      R.measurableSet_carrier R.carrier_subset R.rectifiable hfin hφ hlip hbij.1 g
  exact (Submission.dpfir_integral_eq_of_area_lintegral P (μHE[n].restrict R.carrier)
    (μHE[n].restrict R'.carrier) φ J (fun y => (R'.mult y : ℝ) * R'.orient y (w y))
    (fun x => (R.mult x : ℝ) * R.orient x (β x)) (fun x => by rw [hJ]; exact Real.sqrt_nonneg _)
    harea (Submission.dpfir_imrep_pairing_continuous_integrable P n U R' w hwcont hwc
      hwU).aestronglyMeasurable
    (Submission.dpfir_imrep_pairing_continuous_integrable P n U R β hβc hβcs hβU) hJh).2
/-- **Push-forward of an integer multiplicity current by a `C¹` diffeomorphism** (Simon Ch. 6,
2.23–2.24 and 3.3–3.9; the current `φ_#T` in the proof of 7.1.2).  Let `T = τ(M, θ, ξ)` and let
`φ` be a `C¹` bijection of `ℝᴾ` with `Dφ(x)` injective for every `x` and `φ = id` off a compact
`K ⊆ U`.  Then `S(ω) = ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ(x)⟩ dHⁿ` defines a current `S = φ_#T`
(`Submission.dpf_pushforward_formula_current_exists`).  `φ` is bi-Lipschitz with `φ⁻¹(U) = U`
(`Submission.dpf_c1_compact_perturbation_bilipschitz`), so by the area formula and the
transport `T_{φ(x)}φ(M) = Dφ(x) TₓM` of approximate tangent planes, `S = τ(φ(M), θ ∘ φ⁻¹, ξ')`
with the induced orientation `ξ'` of 3.5/3.7 (`Submission.dpf_imrep_bilipschitz_image_rep`, which
needs `x ↦ p_{TₓM}` measurable: `Submission.imrep_approxTangent_starProjection_aesm`).  Hence `S`
is integer multiplicity.  Finally `∂S = 0` if `∂T = 0` (2.24(1), by smooth approximation of `φ`:
`Submission.dpf_pushforward_formula_boundaryVanishes`). -/
theorem Submission.imrep_c1_diffeo_pushforward_im : ∀ (P n : ℕ) (U K : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n) (φ : Euclid P → Euclid P), IsOpen U → R.Represents T → IsCompact K → K ⊆ U → ContDiff ℝ 1 φ → Bijective φ → (∀ x, Injective (fderiv ℝ φ x)) → (∀ x, x ∉ K → φ x = x) → ∃ S : GeometricCurrentOn U n, IsIntegerMultiplicity S ∧ (BoundaryVanishes T → BoundaryVanishes S) ∧ ∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n] := by
  intro P n U K T R φ hU hR hK hKU hφ hbij hinj hid
  -- `φ` is bi-Lipschitz and `φ⁻¹(U) = U`
  obtain ⟨Λ, hLip, hAnti, hpre⟩ :=
    Submission.dpf_c1_compact_perturbation_bilipschitz P U K φ hK hKU hφ hbij hinj hid
  -- the push-forward integral is the action of a current `S`
  obtain ⟨S, hS⟩ := Submission.dpf_pushforward_formula_current_exists P n U K R φ hK hKU hφ hid
  -- an integer multiplicity triple `R'` on `φ(M)` has the same action
  obtain ⟨R', hR'⟩ := Submission.dpf_imrep_bilipschitz_image_rep P n U R φ Λ hU hφ hbij hinj
    hLip hAnti hpre (Submission.imrep_approxTangent_starProjection_aesm P n U R)
  exact ⟨S, ⟨R', fun ω => (hS ω).trans (hR' ω).symm⟩,
    Submission.dpf_pushforward_formula_boundaryVanishes P n U K T S R φ hU hR hK hKU hφ hid hS, hS⟩
/-- Tangential `C¹` deformations (Simon Ch. 2, before 5.8; Ch. 4, 2.5–2.6; step 3 of the proof
of 7.1.2).  A partition of unity splits `X = X₀ + Σᵢ χᵢX`: `X₀` vanishes on `N`, and `χᵢX` is
supported where `N` is straightened by `Ψ x = ψ(vₚ + g x) + (x - A g x)` (`A = Dψ(vₚ)`, `g A = id`,
so `DΨ(0) = I`; inverse function theorem, `Φ = Ψ⁻¹`).  `X₀` is deformed by `id + tX₀`, `Y = χᵢX`
by `Ψ (Φ y + t DΦ(y) Y(y))`, which keeps `N` since `DΦ Y` is tangent to the slice `{A g x = x}`
(`T_zN = range Dψ`) and has `Dφ_t = I + tDY + o(t)` uniformly (mean value inequality, symmetry of
`D²Ψ`).  Composition adds the expansions; for small `t` the result is a bijection with injective
derivative (`‖Dφ_t - I‖ ≤ 1/2`), and `φ_t = id` otherwise. -/
theorem Submission.tangential_c1_deformation_exists : ∀ (P d : ℕ) (U N : Set (Euclid P)) (X : Euclid P → Euclid P), IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → (∀ x ∈ N ∩ U, X x ∈ tangentSpace N x) → ∃ φ : ℝ → Euclid P → Euclid P, (∀ t, ContDiff ℝ 1 (φ t) ∧ Bijective (φ t) ∧ (∀ x, Injective (fderiv ℝ (φ t) x)) ∧ (∀ x, x ∉ tsupport X → φ t x = x) ∧ MapsTo (φ t) (N ∩ U) (N ∩ U)) ∧ ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ x, ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P) - t • fderiv ℝ X x‖ ≤ ε * |t| := by
  intro P d U N X hU hN hNU hX hXc hXU hXT
  classical
  -- small `t`: `|t| c < r` eventually as `t → 0`
  have hev : ∀ c r : ℝ, 0 < r → ∀ᶠ t in 𝓝 (0:ℝ), |t| * c < r := fun c r hr => by
    have h : ContinuousAt (fun t : ℝ => |t| * c) 0 :=
      (continuous_abs.mul continuous_const).continuousAt
    exact h.eventually_lt continuousAt_const
      (by show |(0:ℝ)| * c < r; rw [abs_zero, zero_mul]; exact hr)
  -- nonnegative bounds of continuous functions on compact sets
  have hbd : ∀ {F G : Type} [TopologicalSpace F] [SeminormedAddCommGroup G] (s : Set F) (f : F → G),
      IsCompact s → ContinuousOn f s → ∃ M, 0 ≤ M ∧ ∀ x ∈ s, ‖f x‖ ≤ M := fun s f hs hf =>
    let ⟨M, hM⟩ := hs.exists_bound_of_continuousOn hf
    ⟨max M 0, le_max_right _ _, fun x hx => (hM x hx).trans (le_max_left _ _)⟩
  -- the algebra of the two expansions (`D²Ψ` symmetric)
  have halg : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (L1 L0 G DV : E →L[ℝ] E)
      (D2 : E →L[ℝ] E →L[ℝ] E) (w : E) (t : ℝ), (∀ u v, D2 u v = D2 v u) →
      L1.comp (G + t • DV) - L0.comp G - t • (L0.comp DV + (D2.comp G).flip w) =
        (L1 - L0 - t • D2 w).comp G + t • ((L1 - L0).comp DV) := by
    intro E _ _ L1 L0 G DV D2 w t hs
    ext v
    simp only [sub_apply, add_apply, ContinuousLinearMap.comp_apply, smul_apply,
      ContinuousLinearMap.flip_apply, map_add, map_smul, smul_sub, smul_add, hs (G v) w]
    abel
  have halg2 : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (Pm Q a a' b : E →L[ℝ] E)
      (t : ℝ), Pm.comp Q - ContinuousLinearMap.id ℝ E - t • (a + b) =
        (Pm - ContinuousLinearMap.id ℝ E - t • a').comp Q +
          (Q - ContinuousLinearMap.id ℝ E - t • b) + t • a'.comp (Q - ContinuousLinearMap.id ℝ E) +
          t • (a' - a) := by
    intro E _ _ Pm Q a a' b t
    ext v
    simp only [sub_apply, add_apply, ContinuousLinearMap.comp_apply, smul_apply,
      ContinuousLinearMap.id_apply, map_sub, smul_sub, smul_add]
    abel
  -- conjugated deformations `φ_t y = Ψ (Φ y + t DΦ(y) Y(y))` near `spt Y`, `φ_t y = y` elsewhere
  have gconj : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
      (Ψ Φ Y Vf : E → E) (φ : ℝ → E → E) (B O : Set E), IsOpen B → IsOpen O →
      (∀ b ∈ B, ContDiffAt ℝ 2 Ψ b) → (∀ y ∈ O, ContDiffAt ℝ 2 Φ y ∧ Φ y ∈ B ∧ Ψ (Φ y) = y) →
      ContDiff ℝ 1 Y → HasCompactSupport Y → tsupport Y ⊆ O →
      (∀ y, Vf y = fderiv ℝ Φ y (Y y)) →
      (∀ t y, φ t y = if y ∈ O then Ψ (Φ y + t • Vf y) else y) →
      (∀ t y, y ∉ tsupport Y → φ t y = y) ∧
      ∃ C : ℝ, (∀ᶠ t in 𝓝 (0:ℝ), ContDiff ℝ 1 (φ t) ∧ (∀ y ∈ tsupport Y, Φ y + t • Vf y ∈ B) ∧
          ∀ y, ‖φ t y - y‖ ≤ C * |t|) ∧
        ∀ ε : ℝ, 0 < ε → ∀ᶠ t in 𝓝 (0:ℝ), ∀ y,
          ‖fderiv ℝ (φ t) y - ContinuousLinearMap.id ℝ E - t • fderiv ℝ Y y‖ ≤ ε * |t| := by
    intro E _ _ _ Ψ Φ Y Vf φ B O hB hO hΨ hΦ hY hYc hYO hVf hφ
    -- derivatives of `Ψ`, `DΨ`, `Φ` and `Vf = DΦ · Y`
    have hΦd : ∀ y ∈ O, HasFDerivAt Φ (fderiv ℝ Φ y) y := fun y hy =>
      ((hΦ y hy).1.differentiableAt two_ne_zero).hasFDerivAt
    have hΨ1 : ∀ b ∈ B, ContDiffAt ℝ 1 (fderiv ℝ Ψ) b := fun b hb =>
      (hΨ b hb).fderiv_right (by norm_num)
    have hΨd : ∀ b ∈ B, HasFDerivAt Ψ (fderiv ℝ Ψ b) b := fun b hb =>
      ((hΨ b hb).differentiableAt two_ne_zero).hasFDerivAt
    have hΨ2d : ∀ b ∈ B, HasFDerivAt (fderiv ℝ Ψ) (fderiv ℝ (fderiv ℝ Ψ) b) b := fun b hb =>
      ((hΨ1 b hb).differentiableAt one_ne_zero).hasFDerivAt
    have hVfC : ∀ y ∈ O, ContDiffAt ℝ 1 Vf y := fun y hy =>
      (((hΦ y hy).1.fderiv_right (by norm_num)).clm_apply hY.contDiffAt).congr_of_eventuallyEq
        (Eventually.of_forall hVf)
    have hVfd : ∀ y ∈ O, HasFDerivAt Vf (fderiv ℝ Vf y) y := fun y hy =>
      ((hVfC y hy).differentiableAt one_ne_zero).hasFDerivAt
    -- `DΨ(Φ y) ∘ DΦ(y) = id` on `O`, so `Y = DΨ(Φ) · Vf` there
    have hinv : ∀ y ∈ O, (fderiv ℝ Ψ (Φ y)).comp (fderiv ℝ Φ y) = ContinuousLinearMap.id ℝ E :=
      fun y hy => ((hΨd _ (hΦ y hy).2.1).comp y (hΦd y hy)).unique
        ((hasFDerivAt_id y).congr_of_eventuallyEq
          (eventually_of_mem (hO.mem_nhds hy) fun z hz => (hΦ z hz).2.2))
    have hYΨ : ∀ y ∈ O, fderiv ℝ Ψ (Φ y) (Vf y) = Y y := fun y hy => by
      rw [hVf, ← ContinuousLinearMap.comp_apply, hinv y hy, ContinuousLinearMap.id_apply]
    have hid : ∀ t y, y ∉ tsupport Y → φ t y = y := fun t y hy => by
      rw [hφ]
      split_ifs with h
      · rw [hVf, image_eq_zero_of_notMem_tsupport hy, map_zero, smul_zero, add_zero,
          (hΦ y h).2.2]
      · rfl
    refine ⟨hid, ?_⟩
    -- compact sets and bounds
    have hK : IsCompact (tsupport Y) := hYc
    have hΦK : IsCompact (Φ '' tsupport Y) :=
      hK.image_of_continuousOn fun y hy => (hΦd y (hYO hy)).continuousAt.continuousWithinAt
    obtain ⟨η, hη, hηB⟩ := hΦK.exists_cthickening_subset_open hB
      (image_subset_iff.2 fun y hy => (hΦ y (hYO hy)).2.1)
    have hK₂ : IsCompact (cthickening η (Φ '' tsupport Y)) := hΦK.cthickening
    have hD2c : ContinuousOn (fderiv ℝ (fderiv ℝ Ψ)) (cthickening η (Φ '' tsupport Y)) :=
      fun c hc => ((hΨ1 c (hηB hc)).continuousAt_fderiv one_ne_zero).continuousWithinAt
    obtain ⟨M1, hM10, hM1⟩ := hbd _ (fderiv ℝ Ψ) hK₂ fun c hc =>
      (hΨ1 c (hηB hc)).continuousAt.continuousWithinAt
    obtain ⟨M2, hM20, hM2⟩ := hbd _ _ hK₂ hD2c
    obtain ⟨MΦ, hMΦ0, hMΦ⟩ := hbd _ (fderiv ℝ Φ) hK fun y hy =>
      ((hΦ y (hYO hy)).1.continuousAt_fderiv two_ne_zero).continuousWithinAt
    obtain ⟨MV, hMV0, hMV⟩ := hbd _ Vf hK fun y hy =>
      (hVfC y (hYO hy)).continuousAt.continuousWithinAt
    obtain ⟨MDV, hMDV0, hMDV⟩ := hbd _ (fderiv ℝ Vf) hK fun y hy =>
      ((hVfC y (hYO hy)).continuousAt_fderiv one_ne_zero).continuousWithinAt
    -- for small `t`, the segment `[Φ y, Φ y + t Vf y]` lies in a ball inside `cthickening η (Φ K)`
    have hball : ∀ y ∈ tsupport Y, ∀ t : ℝ, |t| * MV < η →
        closedBall (Φ y) (|t| * MV) ⊆ cthickening η (Φ '' tsupport Y) ∧
          Φ y + t • Vf y ∈ closedBall (Φ y) (|t| * MV) := fun y hy t ht =>
      ⟨(closedBall_subset_closedBall ht.le).trans
        (closedBall_subset_cthickening (mem_image_of_mem Φ hy) η), by
        rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs]
        exact mul_le_mul_of_nonneg_left (hMV y hy) (abs_nonneg t)⟩
    have hev0 : ∀ t, ∀ y ∈ O, φ t =ᶠ[𝓝 y] fun z => Ψ (Φ z + t • Vf z) := fun t y hy =>
      eventually_of_mem (hO.mem_nhds hy) fun z hz => by rw [hφ, ite_eq_left hz]
    have hev1 : ∀ t, ∀ y ∉ tsupport Y, φ t =ᶠ[𝓝 y] id := fun t y hy =>
      eventually_of_mem ((isClosed_tsupport Y).isOpen_compl.mem_nhds hy) fun z hz => hid t z hz
    refine ⟨M1 * MV, ?_, fun ε hε => ?_⟩
    · -- `C¹`, the deformed points stay in `B`, displacement `≤ M1 MV |t|`
      filter_upwards [hev MV η hη] with t ht
      have hmem : ∀ y ∈ tsupport Y, Φ y + t • Vf y ∈ B := fun y hy =>
        hηB ((hball y hy t ht).1 (hball y hy t ht).2)
      refine ⟨contDiff_iff_contDiffAt.2 fun y => ?_, hmem, fun y => ?_⟩
      · by_cases hy : y ∈ tsupport Y
        · have hyO := hYO hy
          exact (((hΨ _ (hmem y hy)).of_le (by norm_num)).comp y (((hΦ y hyO).1.of_le
            (by norm_num)).add ((hVfC y hyO).const_smul t))).congr_of_eventuallyEq (hev0 t y hyO)
        · exact contDiffAt_id.congr_of_eventuallyEq (hev1 t y hy)
      · by_cases hy : y ∈ tsupport Y
        · have hyO := hYO hy
          have h :=
            (convex_closedBall (Φ y) (|t| * MV)).norm_image_sub_le_of_norm_hasFDerivWithin_le
              (f := Ψ) (fun c hc => (hΨd c (hηB ((hball y hy t ht).1 hc))).hasFDerivWithinAt)
              (fun c hc => hM1 c ((hball y hy t ht).1 hc))
              (mem_closedBall_self (mul_nonneg (abs_nonneg t) hMV0)) (hball y hy t ht).2
          rw [(hΦ y hyO).2.2, add_sub_cancel_left, norm_smul, Real.norm_eq_abs] at h
          rw [hφ, ite_eq_left hyO, mul_assoc, mul_comm MV]
          exact h.trans (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (hMV y hy)
            (abs_nonneg t)) hM10)
        · rw [hid t y hy, sub_self, norm_zero]
          exact mul_nonneg (mul_nonneg hM10 hMV0) (abs_nonneg t)
    -- the expansion `Dφ_t = I + t DY + o(t)`
    obtain ⟨ε₁, hε₁, hε₁b⟩ : ∃ ε₁ : ℝ, 0 < ε₁ ∧ ε₁ * (MV * MΦ) ≤ ε / 2 := by
      have h1 : 0 < MV * MΦ + 1 := add_pos_of_nonneg_of_pos (mul_nonneg hMV0 hMΦ0) one_pos
      refine ⟨ε / 2 / (MV * MΦ + 1), div_pos (half_pos hε) h1, ?_⟩
      rw [div_mul_eq_mul_div, div_le_iff₀ h1]
      exact mul_le_mul_of_nonneg_left (le_add_of_nonneg_right zero_le_one) (half_pos hε).le
    obtain ⟨δ₂, hδ₂, hUC⟩ := Metric.uniformContinuousOn_iff_le.1
      (hK₂.uniformContinuousOn_of_continuous hD2c) ε₁ hε₁
    filter_upwards [hev MV η hη, hev MV δ₂ hδ₂,
      hev ((ε₁ * MV + M2 * MV) * MDV) (ε / 2) (half_pos hε)] with t ht1 ht2 ht3 y
    by_cases hy : y ∈ tsupport Y
    · have hyO := hYO hy
      have hΦyB := (hΦ y hyO).2.1
      obtain ⟨hsub, hmem⟩ := hball y hy t ht1
      have hΦyK : Φ y ∈ cthickening η (Φ '' tsupport Y) :=
        hsub (mem_closedBall_self (mul_nonneg (abs_nonneg t) hMV0))
      have hbtw : Φ y + t • Vf y ∈ B := hηB (hsub hmem)
      have hDφ : fderiv ℝ (φ t) y = (fderiv ℝ Ψ (Φ y + t • Vf y)).comp
          (fderiv ℝ Φ y + t • fderiv ℝ Vf y) :=
        (((hΨd _ hbtw).comp y ((hΦd y hyO).add ((hVfd y hyO).const_smul t))).congr_of_eventuallyEq
          (hev0 t y hyO)).fderiv
      have hDY : fderiv ℝ Y y = (fderiv ℝ Ψ (Φ y)).comp (fderiv ℝ Vf y) +
          ((fderiv ℝ (fderiv ℝ Ψ) (Φ y)).comp (fderiv ℝ Φ y)).flip (Vf y) :=
        ((((hΨ2d _ hΦyB).comp y (hΦd y hyO)).clm_apply (hVfd y hyO)).congr_of_eventuallyEq
          (eventually_of_mem (hO.mem_nhds hyO) fun z hz => (hYΨ z hz).symm)).fderiv
      have hsymm := (hΨ _ hΦyB).isSymmSndFDerivAt (by rw [minSmoothness_of_isRCLikeNormedField])
      rw [hDφ, hDY, ← hinv y hyO, halg _ _ _ _ _ _ t hsymm]
      -- mean value inequality for `DΨ` on the ball
      have hm1 := (convex_closedBall (Φ y) (|t| * MV)).norm_image_sub_le_of_norm_hasFDerivWithin_le'
        (f := fderiv ℝ Ψ) (φ := fderiv ℝ (fderiv ℝ Ψ) (Φ y))
        (fun c hc => (hΨ2d c (hηB (hsub hc))).hasFDerivWithinAt)
        (fun c hc => by
          rw [← dist_eq_norm]
          exact hUC c (hsub hc) _ hΦyK ((mem_closedBall.1 hc).trans ht2.le))
        (mem_closedBall_self (mul_nonneg (abs_nonneg t) hMV0)) hmem
      rw [add_sub_cancel_left, map_smul] at hm1
      have hw : ‖t • Vf y‖ ≤ |t| * MV := by
        rw [norm_smul, Real.norm_eq_abs]; exact mul_le_mul_of_nonneg_left (hMV y hy) (abs_nonneg t)
      have hA1 := hm1.trans (mul_le_mul_of_nonneg_left hw hε₁.le)
      have hA2 : ‖t • fderiv ℝ (fderiv ℝ Ψ) (Φ y) (Vf y)‖ ≤ |t| * (M2 * MV) := by
        rw [norm_smul, Real.norm_eq_abs]
        exact mul_le_mul_of_nonneg_left ((ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul (hM2 _ hΦyK) (hMV y hy) (norm_nonneg _) hM20)) (abs_nonneg t)
      have hA3 := (norm_le_norm_add_norm_sub' _ _).trans (add_le_add hA2 hA1)
      have hT1 := (ContinuousLinearMap.opNorm_comp_le _ _).trans
        (mul_le_mul hA1 (hMΦ y hy) (norm_nonneg _)
          (mul_nonneg hε₁.le (mul_nonneg (abs_nonneg t) hMV0)))
      have hT2 : ‖t • ((fderiv ℝ Ψ (Φ y + t • Vf y) - fderiv ℝ Ψ (Φ y)).comp (fderiv ℝ Vf y))‖ ≤
          |t| * ((|t| * (M2 * MV) + ε₁ * (|t| * MV)) * MDV) := by
        rw [norm_smul, Real.norm_eq_abs]
        exact mul_le_mul_of_nonneg_left ((ContinuousLinearMap.opNorm_comp_le _ _).trans
          (mul_le_mul hA3 (hMDV y hy) (norm_nonneg _) (by positivity))) (abs_nonneg t)
      have h1 := mul_le_mul_of_nonneg_left hε₁b (abs_nonneg t)
      have h2 := mul_le_mul_of_nonneg_left ht3.le (abs_nonneg t)
      linarith only [norm_add_le ((fderiv ℝ Ψ (Φ y + t • Vf y) - fderiv ℝ Ψ (Φ y) -
        t • fderiv ℝ (fderiv ℝ Ψ) (Φ y) (Vf y)).comp (fderiv ℝ Φ y))
        (t • ((fderiv ℝ Ψ (Φ y + t • Vf y) - fderiv ℝ Ψ (Φ y)).comp (fderiv ℝ Vf y))), hT1, hT2,
        h1, h2]
    · rw [(hev1 t y hy).fderiv_eq, fderiv_id,
        image_eq_zero_of_notMem_tsupport fun h => hy (tsupport_fderiv_subset ℝ h), smul_zero,
        sub_self, sub_zero, norm_zero]
      exact mul_nonneg hε.le (abs_nonneg t)
  -- `Good A`: a `C¹` family fixing `N` and `K = spt X` with `Dφ_t = I + t DA + o(t)` uniformly
  obtain ⟨Good, hGood⟩ : ∃ Good : (Euclid P → Euclid P) → Prop, ∀ A, Good A ↔
      ∃ φ : ℝ → Euclid P → Euclid P, ∃ C : ℝ, (∀ᶠ t in 𝓝 (0:ℝ), ContDiff ℝ 1 (φ t) ∧
        (∀ x, x ∉ tsupport X → φ t x = x) ∧ MapsTo (φ t) N N ∧ ∀ x, ‖φ t x - x‖ ≤ C * |t|) ∧
      ∀ ε : ℝ, 0 < ε → ∀ᶠ t in 𝓝 (0:ℝ), ∀ x,
        ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P) - t • fderiv ℝ A x‖ ≤ ε * |t| :=
    ⟨_, fun _ => Iff.rfl⟩
  -- composition: `Good A`, `Good B` give `Good (A + B)` (`DA` uniformly continuous)
  have gadd : ∀ A B : Euclid P → Euclid P, ContDiff ℝ 1 A → HasCompactSupport A →
      ContDiff ℝ 1 B → HasCompactSupport B → Good A → Good B → Good (A + B) := by
    intro A B hA hAc hB hBc hGA hGB
    obtain ⟨φ, C₁, hφ, eφ⟩ := (hGood A).1 hGA
    obtain ⟨ψ, C₂, hψ, eψ⟩ := (hGood B).1 hGB
    refine (hGood _).2 ⟨fun t => φ t ∘ ψ t, C₁ + C₂, ?_, fun ε hε => ?_⟩
    · filter_upwards [hφ, hψ] with t h g
      obtain ⟨h1, h2, h3, h4⟩ := h
      obtain ⟨g1, g2, g3, g4⟩ := g
      refine ⟨h1.comp g1, fun x hx => ?_, h3.comp g3, fun x => ?_⟩
      · rw [Function.comp_apply, g2 x hx, h2 x hx]
      · rw [Function.comp_apply, add_mul]
        exact (norm_sub_le_norm_sub_add_norm_sub _ (ψ t x) _).trans (add_le_add (h4 _) (g4 _))
    · obtain ⟨MA, hMA⟩ :=
        (hAc.fderiv ℝ).exists_bound_of_continuous (hA.continuous_fderiv one_ne_zero)
      obtain ⟨MB, hMB⟩ :=
        (hBc.fderiv ℝ).exists_bound_of_continuous (hB.continuous_fderiv one_ne_zero)
      have hMA0 : 0 ≤ MA := (norm_nonneg _).trans (hMA 0)
      have hMB0 : 0 ≤ MB := (norm_nonneg _).trans (hMB 0)
      have hε4 : 0 < ε / 4 := by positivity
      obtain ⟨η, hη, hUC⟩ := Metric.uniformContinuous_iff.1
        ((hAc.fderiv ℝ).uniformContinuous_of_continuous (hA.continuous_fderiv one_ne_zero)) _ hε4
      filter_upwards [hφ, hψ, eφ (ε / 8) (by positivity), eψ (ε / 4) hε4,
        hev (ε / 4 + MB) 1 one_pos, hev ((ε / 4 + MB) * MA) (ε / 4) hε4, hev C₂ η hη]
        with t h g e1 e2 k1 k2 k3 x
      obtain ⟨h1, -, -, -⟩ := h
      obtain ⟨g1, -, -, g4⟩ := g
      rw [fderiv_comp x ((h1.differentiable one_ne_zero) _) ((g1.differentiable one_ne_zero) _),
        ((hA.differentiable one_ne_zero x).hasFDerivAt.add
          (hB.differentiable one_ne_zero x).hasFDerivAt).fderiv, halg2 _ _ _ (fderiv ℝ A (ψ t x))]
      have e1' := e1 (ψ t x)
      have e2' := e2 x
      have htb : ‖t • fderiv ℝ B x‖ ≤ |t| * MB := by
        rw [norm_smul, Real.norm_eq_abs]; exact mul_le_mul_of_nonneg_left (hMB x) (abs_nonneg t)
      have hQI := (norm_le_norm_add_norm_sub' (fderiv ℝ (ψ t) x - ContinuousLinearMap.id ℝ _)
        (t • fderiv ℝ B x)).trans (add_le_add htb e2')
      have hQ2 : ‖fderiv ℝ (ψ t) x‖ ≤ 2 := by
        have := (norm_le_norm_add_norm_sub' (fderiv ℝ (ψ t) x) (ContinuousLinearMap.id ℝ _)).trans
          (add_le_add ContinuousLinearMap.norm_id_le hQI)
        linarith only [this, k1]
      have hT1 := (ContinuousLinearMap.opNorm_comp_le _ _).trans
        (mul_le_mul e1' hQ2 (norm_nonneg _) (mul_nonneg (by positivity) (abs_nonneg t)))
      have hT3 : ‖t • (fderiv ℝ A (ψ t x)).comp (fderiv ℝ (ψ t) x - ContinuousLinearMap.id ℝ _)‖ ≤
          |t| * (MA * (|t| * MB + ε / 4 * |t|)) := by
        rw [norm_smul, Real.norm_eq_abs]
        exact mul_le_mul_of_nonneg_left ((ContinuousLinearMap.opNorm_comp_le _ _).trans
          (mul_le_mul (hMA _) hQI (norm_nonneg _) hMA0)) (abs_nonneg t)
      have hT4 : ‖t • (fderiv ℝ A (ψ t x) - fderiv ℝ A x)‖ ≤ |t| * (ε / 4) := by
        rw [norm_smul, Real.norm_eq_abs, ← dist_eq_norm]
        refine mul_le_mul_of_nonneg_left (hUC ?_).le (abs_nonneg t)
        rw [dist_eq_norm]
        calc ‖χ x • (G x - F x) - χ x' • (G x' - F x')‖ =
              ‖(χ x - χ x') • (G x - F x) + χ x' • ((G x - F x) - (G x' - F x'))‖ := by
              rw [hsplit]
          _ ≤ ‖(χ x - χ x') • (G x - F x)‖ + ‖χ x' • ((G x - F x) - (G x' - F x'))‖ :=
              norm_add_le _ _
          _ = |χ x - χ x'| * ‖G x - F x‖ + |χ x'| * ‖(G x - F x) - (G x' - F x')‖ := by
              rw [norm_smul (χ x - χ x'), norm_smul (χ x'), Real.norm_eq_abs, Real.norm_eq_abs]
          _ ≤ dist x x' * B + 1 * (2 * Λ * dist x x') :=
              add_le_add (mul_le_mul (hχ_lip x x') (hD_bd x hx) (norm_nonneg _) dist_nonneg)
                (mul_le_mul (hχ1 x') (hD_lip x x') (norm_nonneg _) zero_le_one)
          _ = (B + 2 * Λ) * dist x x' := by ring
      have hφ_lip : ∀ x x',
          dist (χ x • (G x - F x)) (χ x' • (G x' - F x')) ≤ (B + 2 * Λ) * dist x x' := by
        intro x x'
        by_cases hx : χ x = 0
        · by_cases hx' : χ x' = 0
          · rw [hx, hx', zero_smul, zero_smul, dist_self]
            positivity
          · rw [dist_comm, dist_comm x x']
            exact hφ_one x' x hx'
        · exact hφ_one x x' hx
      -- `c(y) = max 0 (min 1 y₀)` is 1-Lipschitz with `|c| ≤ 1`
      have hc_lip : ∀ y y' : Euclid (P + 1),
          |max 0 (min 1 (y 0)) - max 0 (min 1 (y' 0))| ≤ dist y y' := by
        intro y y'
        have h := ((hfst_lip.const_min 1).const_max 0).dist_le_mul y y'
        rwa [NNReal.coe_one, one_mul, Real.dist_eq] at h
      have hc1 : ∀ y : Euclid (P + 1), |max 0 (min 1 (y 0))| ≤ 1 := fun y => by
        rw [abs_of_nonneg (le_max_left _ _)]
        exact max_le zero_le_one (min_le_left _ _)
      -- `Ĥ(y) = F(tail y) + c(y) • φ(tail y)` is `(Λ + 2B + 2Λ)`-Lipschitz
      refine ⟨Real.toNNReal (Λ + (B + (B + 2 * Λ))), LipschitzWith.of_dist_le' fun y y' => ?_⟩
      have htd := htl_lip y y'
      have hFd : dist (F (tl y)) (F (tl y')) ≤ Λ * dist y y' :=
        (hF.dist_le_mul _ _).trans (mul_le_mul_of_nonneg_left htd hΛ)
      have hψd : dist (max 0 (min 1 (y 0)) • (χ (tl y) • (G (tl y) - F (tl y))))
          (max 0 (min 1 (y' 0)) • (χ (tl y') • (G (tl y') - F (tl y')))) ≤
            (B + (B + 2 * Λ)) * dist y y' := by
        set c := max 0 (min 1 (y 0))
        set c' := max 0 (min 1 (y' 0))
        set u := χ (tl y) • (G (tl y) - F (tl y))
        set u' := χ (tl y') • (G (tl y') - F (tl y'))
        rw [dist_eq_norm]
        calc ‖c • u - c' • u'‖ = ‖(c - c') • u + c' • (u - u')‖ := by
              rw [hsplit]
          _ ≤ ‖(c - c') • u‖ + ‖c' • (u - u')‖ := norm_add_le _ _
          _ = |c - c'| * ‖u‖ + |c'| * ‖u - u'‖ := by
              rw [norm_smul (c - c') u, norm_smul c' (u - u'), Real.norm_eq_abs, Real.norm_eq_abs]
          _ ≤ dist y y' * B + 1 * ((B + 2 * Λ) * dist y y') := by
              refine add_le_add (mul_le_mul (hc_lip y y') (hφ_bd _) (norm_nonneg _) dist_nonneg)
                (mul_le_mul (hc1 y') ?_ (norm_nonneg _) zero_le_one)
              rw [← dist_eq_norm]
              exact (hφ_lip _ _).trans (mul_le_mul_of_nonneg_left htd (by positivity))
          _ = (B + (B + 2 * Λ)) * dist y y' := by ring
      calc dist (F (tl y) + max 0 (min 1 (y 0)) • (χ (tl y) • (G (tl y) - F (tl y))))
            (F (tl y') + max 0 (min 1 (y' 0)) • (χ (tl y') • (G (tl y') - F (tl y')))) ≤
            dist (F (tl y)) (F (tl y')) +
              dist (max 0 (min 1 (y 0)) • (χ (tl y) • (G (tl y) - F (tl y))))
                (max 0 (min 1 (y' 0)) • (χ (tl y') • (G (tl y') - F (tl y')))) :=
            dist_add_add_le _ _ _ _
        _ ≤ Λ * dist y y' + (B + (B + 2 * Λ)) * dist y y' := add_le_add hFd hψd
        _ = (Λ + (B + (B + 2 * Λ))) * dist y y' := by ring
    · intro F G S hS x hx t ht
      have hxR : ‖x‖ ≤ R S := by simpa using hR S hS hx
      simp only [htl, Fin.cons_zero]
      rw [min_eq_right ht.2, max_eq_right ht.1, min_eq_left (by linarith),
        max_eq_right zero_le_one, one_smul]
  -- the homotopy operator `homot k F G X = Ĥ_X#([[0, 1]] × X)`, `Ĥ_X` cut off near `spt X`
  obtain ⟨homot, hhomot⟩ : ∃ homot : ∀ k : ℕ, (Euclid P → Euclid P) → (Euclid P → Euclid P) →
      GeometricCurrentOn (univ : Set (Euclid P)) k →
        GeometricCurrentOn (univ : Set (Euclid P)) (k + 1),
      ∀ k F G X, homot k F G X = lpush (P + 1) P (k + 1) (Hc F G X.support) (cyl P k X) :=
    ⟨_, fun _ _ _ _ => rfl⟩
  -- C1′: `homot k F G X = H#([[0, 1]] × X)` for every Lipschitz `H` agreeing with
  -- `F + t (G − F)` on `[0, 1] × spt X` (operators (3) in `ℝ^{P+1}`, as `spt cyl X` lies there)
  have hC1 : ∀ (k : ℕ) (Λ L : NNReal) (F G : Euclid P → Euclid P) (H : Euclid (P + 1) → Euclid P)
      (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G →
      LipschitzWith L H → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ →
      (∀ x ∈ X.support, ∀ t ∈ Icc (0 : ℝ) 1,
        H (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) = F x + t • (G x - F x)) →
      homot k F G X = lpush (P + 1) P (k + 1) H (cyl P k X) := by
    intro k Λ L F G H X hF hG hH hX1 hX2 hX3 hHX
    obtain ⟨L₀, hL₀⟩ := hHc_lip Λ F G X.support hF hG hX1
    obtain ⟨hc1, hc2, hc3, hc4⟩ := h7 P k X hX1 hX2 hX3
    rw [hhomot]
    refine h3 (P + 1) P (k + 1) (max L₀ L) _ _ (cyl P k X) (hL₀.weaken (le_max_left _ _))
      (hH.weaken (le_max_right _ _)) hc1 hc2 hc3 ?_
    intro y hy
    obtain ⟨t, ht, x, hx, rfl⟩ := hc4 hy
    rw [hHc_eq F G X.support hX1 x hx t ht, hHX x hx t ht]
  refine ⟨fun k => lpush P P k, homot, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- C2: identity
    intro k X hX1 hX2 hX3
    exact h1 P k X hX1 hX2 hX3
  · -- C3: linearity; one cut-off homotopy serves `X`, `Y` and `X − Y`
    intro k Λ F G X Y hF hG hX1 hX2 hX3 hY1 hY2 hY3
    refine ⟨h2 P P k Λ F X Y hF hX1 hX2 hX3 hY1 hY2 hY3, ?_⟩
    obtain ⟨hsub, hZ1, hZ2, hZ3⟩ := hNCsub k X Y hX1 hX2 hX3 hY1 hY2 hY3
    have hS : IsCompact (X.support ∪ Y.support) := hX1.union hY1
    obtain ⟨L, hL⟩ := hHc_lip Λ F G _ hF hG hS
    have hagree : ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) k,
        Z.support ⊆ X.support ∪ Y.support → ∀ x ∈ Z.support, ∀ t ∈ Icc (0 : ℝ) 1,
          Hc F G (X.support ∪ Y.support) (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) =
            F x + t • (G x - F x) :=
      fun Z hZ x hx t ht => hHc_eq F G _ hS x (hZ hx) t ht
    rw [hC1 k Λ L F G _ (X - Y) hF hG hL hZ1 hZ2 hZ3 (hagree _ hsub),
      hC1 k Λ L F G _ X hF hG hL hX1 hX2 hX3 (hagree _ subset_union_left),
      hC1 k Λ L F G _ Y hF hG hL hY1 hY2 hY3 (hagree _ subset_union_right),
      h8 P k X Y hX1 hX2 hX3 hY1 hY2 hY3]
    obtain ⟨hcX1, hcX2, hcX3, -⟩ := h7 P k X hX1 hX2 hX3
    obtain ⟨hcY1, hcY2, hcY3, -⟩ := h7 P k Y hY1 hY2 hY3
    exact h2 (P + 1) P (k + 1) L _ (cyl P k X) (cyl P k Y) hL hcX1 hcX2 hcX3 hcY1 hcY2 hcY3
  · -- C4: locality
    intro k Λ F G F' G' X hF hG hF' hG' hX1 hX2 hX3 hFF hGG
    refine ⟨h3 P P k Λ F F' X hF hF' hX1 hX2 hX3 hFF, ?_⟩
    obtain ⟨L, hL⟩ := hHc_lip Λ F G X.support hF hG hX1
    rw [hC1 k Λ L F' G' (Hc F G X.support) X hF' hG' hL hX1 hX2 hX3 fun x hx t ht => by
      rw [hHc_eq F G _ hX1 x hx t ht, hFF hx, hGG hx], hhomot]
  · -- C5: mass and support
    intro k Λ F G X hF hG hX1 hX2 hX3
    obtain ⟨hm, hs⟩ := h4 P P k Λ F X hF hX1 hX2 hX3
    obtain ⟨L, hL⟩ := hHc_lip Λ F G X.support hF hG hX1
    obtain ⟨hc1, hc2, hc3, hc4⟩ := h7 P k X hX1 hX2 hX3
    refine ⟨hm, hs, fun δ hδ => ?_, ?_⟩
    · rw [hhomot]
      exact h12 P P k Λ L F G _ X δ hF hG hL hX1 hX2 hX3 (hHc_eq F G _ hX1) hδ
    · rw [hhomot]
      intro y hy
      obtain ⟨z, hz, rfl⟩ := (h4 (P + 1) P (k + 1) L _ (cyl P k X) hL hc1 hc2 hc3).2 hy
      obtain ⟨t, ht, x, hx, rfl⟩ := hc4 hz
      exact ⟨x, hx, t, ht, hHc_eq F G _ hX1 x hx t ht⟩
  · -- C6: boundary, homotopy formula and integrality in degree `k + 1`
    intro k Λ F G X hF hG hX1 hX2 hX3
    obtain ⟨L, hL⟩ := hHc_lip Λ F G X.support hF hG hX1
    obtain ⟨hb1, hb2, hb3⟩ := hNCbd k X hX1
    refine ⟨h5 P P k Λ F X hF hX1 hX2 hX3, ?_, fun hIM => ⟨?_, ?_⟩⟩
    · rw [hC1 k Λ L F G (Hc F G X.support) X.boundary hF hG hL hb2 hX3 hb3
        fun x hx t ht => hHc_eq F G _ hX1 x (hb1 hx) t ht, hhomot]
      exact h11 P P k Λ L F G _ X hF hG hL hX1 hX2 hX3 (hHc_eq F G _ hX1)
    · exact hI P P k Λ F X _ hF hIM hX1 hX2 (h6 P P (k + 1) Λ F X hF hX1 hX2 hX3)
    · rw [hhomot]
      obtain ⟨hc1, hc2, hc3, -⟩ := h7 P (k + 1) X hX1 hX2 hX3
      have hC : IsIntegerMultiplicity (cyl P (k + 1) X) :=
        hII P k X _ hIM hX1 hX2 (h9 P (k + 1) X hX1 hX2 hX3)
      exact hI (P + 1) P (k + 1) L _ (cyl P (k + 1) X) _ hL hC hc1 hc2
        (h6 (P + 1) P (k + 1 + 1) L _ (cyl P (k + 1) X) hL hc1 hc2 hc3)
  · -- C7: degree `0`
    intro Λ F G X hF hG hX1 hX2
    obtain ⟨L, hL⟩ := hHc_lip Λ F G X.support hF hG hX1
    rw [hhomot]
    exact h10 P P Λ L F G _ X hF hG hL hX1 hX2 (hHc_eq F G _ hX1)

/-- **Test forms in `U` restrict to compactly supported continuous maps on `U`** (the maps
`g_ω(x) = c(ω(x))` to which the Riesz representation theorem is applied for
`T(ω) = ∫ ⟨ω, T⃗⟩ dμ_T`, Simon Ch. 6, 2.7–2.8; here for any continuous `f` with `f 0 = 0`).
Let `val : U → ℝᴾ` be the inclusion and `K = tsupport ω`.  The map `G = f ∘ ω ∘ val` is
continuous, since `ω` is smooth.  `K` is compact and `K ⊆ U = range val`, so `val⁻¹(K)` is
compact because `val` is inducing.  Off `val⁻¹(K)`, `ω(val x) = 0` and `G x = f 0 = 0`.  So `G`
has compact support in the Hausdorff space `U`, and `g = G ∈ C_c(U, ℝᵈ)`. -/
theorem Submission.cmrc_testForm_restrict_cc : ∀ (P n d : ℕ) (U : Set (Euclid P)) (f : Covector (Euclid P) n → EuclideanSpace ℝ (Fin d)), Continuous f → f 0 = 0 → ∀ ω : TestFormOn U n, ∃ g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)), ∀ x : U, g x = f ((ω : DifferentialForm (Euclid P) n) x) := by
  intro P n d U f hf hf0 ω
  -- `ω` is smooth with compact support `K = tsupport ω ⊆ U`
  obtain ⟨⟨hωs, hωc⟩, hωU⟩ : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.2
  -- Step 1: `G = f ∘ ω ∘ val` is continuous
  have hGc : Continuous fun x : U => f ((ω : DifferentialForm (Euclid P) n) x) :=
    hf.comp ((ContDiff.continuous hωs).comp continuous_subtype_val)
  -- Step 2: `val⁻¹(K)` is compact, as `val` is inducing and `K ⊆ U = range val`
  have hK : IsCompact ((↑) ⁻¹' tsupport (ω : DifferentialForm (Euclid P) n) : Set U) :=
    Topology.IsInducing.subtypeVal.isCompact_preimage' hωc.isCompact
      (by rwa [Subtype.range_coe])
  -- Step 3: `G x = f 0 = 0` for `x ∉ val⁻¹(K)`, so `G` has compact support
  have hGs : HasCompactSupport fun x : U => f ((ω : DifferentialForm (Euclid P) n) x) :=
    HasCompactSupport.intro hK fun x hx =>
      (congrArg f (image_eq_zero_of_notMem_tsupport
        (show (x : Euclid P) ∉ tsupport (ω : DifferentialForm (Euclid P) n) from hx))).trans hf0
  exact ⟨⟨⟨fun x => f ((ω : DifferentialForm (Euclid P) n) x), hGc⟩, hGs⟩, fun _ => rfl⟩
/-- **Polar normalization of a vector Riesz density and push-forward to `ℝᴾ`** (the normalization
`|T⃗| = 1` `μ_T`-a.e. in `T(ω) = ∫ ⟨ω, T⃗⟩ dμ_T`, Simon Ch. 6, 2.7, via the Riesz Representation
Theorem, Ch. 1, 4.14).  Write `ρ = ‖ν‖` and `ν̂ = ρ⁻¹ν` (with `0⁻¹ = 0`), so `ν = ρν̂`,
`‖ν̂‖ ≤ 1`, and `‖ν̂‖ = 1` where `ρ ≠ 0`.  Let `u` be `ν̂` extended by `0` off `U`,
`μ = val_*(ρμ₀)`, `ξ(y) = ⟨u(y), c(·)⟩` and `β = c⁻¹ ∘ u`.  Then `μ(Uᶜ) = 0`;
`μ(K) = ∫_{val⁻¹K} ‖ν‖ dμ₀ < ∞` for compact `K ⊆ U`; `|ξ(y)(α)| ≤ ‖c α‖ = |α|` by
Cauchy–Schwarz; `|β(y)| = ‖u(y)‖ ≤ 1`; `ξ(β) = ‖u‖² = 1` wherever the density `ρ` is nonzero;
and `∫ ξ(ω) dμ = ∫ ρ⟨ν̂, c(ω)⟩ dμ₀ = ∫ ⟨c(ω), ν⟩ dμ₀` for every `ω`. -/
theorem Submission.cmrc_polar_pushforward : ∀ (P n d : ℕ) (U : Set (Euclid P)) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (μ₀ : Measure U) (ν : U → EuclideanSpace ℝ (Fin d)), IsOpen U → (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → Measurable ν → (∀ K : Set U, IsCompact K → IntegrableOn ν K μ₀) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n) (β : Euclid P → Covector (Euclid P) n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ AEStronglyMeasurable β μ ∧ (∃ C : ℝ, ∀ x, ‖β x‖ ≤ C) ∧ (∀ x, covectorEuclideanNorm (β x) ≤ 1) ∧ (∀ᵐ x ∂μ, ξ x (β x) = 1) ∧ ∀ ω : DifferentialForm (Euclid P) n, ∫ x, inner ℝ (c (ω x)) (ν x) ∂μ₀ = ∫ x, ξ x (ω x) ∂μ := by
  intro P n d U c μ₀ ν hU hc hν hloc
  -- Step 1: polar decomposition `ν = ρ • ν̂` with `ρ = ‖ν‖`
  set ρ : U → ℝ := fun x => ‖ν x‖ with hρ_def
  set νh : U → EuclideanSpace ℝ (Fin d) := fun x => (ρ x)⁻¹ • ν x with hνh_def
  have hρm : Measurable ρ := hν.norm
  have hνhm : Measurable νh := hρm.inv.smul hν
  have hρ0 : ∀ x, 0 ≤ ρ x := fun x => norm_nonneg _
  have hdecomp : ∀ x, ν x = ρ x • νh x := by
    intro x
    by_cases h : ρ x = 0
    · have h0 : ν x = 0 := norm_eq_zero.mp h
      simp [hνh_def, h0]
    · simp [hνh_def, smul_smul, mul_inv_cancel₀ h]
  have hνh_one : ∀ x, ρ x ≠ 0 → ‖νh x‖ = 1 := by
    intro x h
    simp only [hνh_def]
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_nonneg (hρ0 x), inv_mul_cancel₀ h]
  have hνh_le : ∀ x, ‖νh x‖ ≤ 1 := by
    intro x
    by_cases h : ρ x = 0
    · have h0 : ν x = 0 := norm_eq_zero.mp h
      simp [hνh_def, h0]
    · exact (hνh_one x h).le
  -- Step 2: `val` is a measurable embedding (`U` is open) and the density `ρ` is measurable
  have hval : MeasurableEmbedding (Subtype.val : U → Euclid P) :=
    MeasurableEmbedding.subtype_coe hU.measurableSet
  have hdens : Measurable fun x => ENNReal.ofReal (ρ x) := hρm.ennreal_ofReal
  -- Step 3: the unit field `u`, i.e. `ν̂` extended by `0` off `U`
  set u : Euclid P → EuclideanSpace ℝ (Fin d) := Function.extend Subtype.val νh 0 with hu_def
  have hu_val : ∀ x : U, u x = νh x := fun x => Subtype.val_injective.extend_apply _ _ x
  have hu_notin : ∀ y, y ∉ U → u y = 0 := by
    intro y hy
    rw [hu_def, Function.extend_apply']
    · rfl
    · rintro ⟨x, rfl⟩
      exact hy x.2
  have hum : Measurable u := hval.measurable_extend hνhm measurable_const
  have hu_le : ∀ y, ‖u y‖ ≤ 1 := by
    intro y
    by_cases hy : y ∈ U
    · have := hu_val ⟨y, hy⟩
      simp only at this
      rw [this]
      exact hνh_le _
    · rw [hu_notin y hy, norm_zero]
      exact zero_le_one
  -- Step 4: `μ = val_*(ρ μ₀)`, `ξ(y) = ⟨u(y), c(·)⟩` and `β = c⁻¹ ∘ u`
  refine ⟨(μ₀.withDensity fun x => ENNReal.ofReal (ρ x)).map Subtype.val,
    fun y => (innerSL ℝ (u y)).comp (c : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin d)),
    fun y => c.symm (u y), ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- (a) `val⁻¹(Uᶜ) = ∅`
    rw [hval.map_apply]
    have hpre : (Subtype.val : U → Euclid P) ⁻¹' Uᶜ = ∅ := by
      ext x
      simp
    rw [hpre, measure_empty]
  · -- (b) `μ(K) = ∫⁻_{val⁻¹K} ‖ν‖ₑ dμ₀ < ∞`, as `val⁻¹K` is compact
    intro K hK hKU
    rw [hval.map_apply,
      withDensity_apply _ (hK.isClosed.measurableSet.preimage measurable_subtype_coe)]
    have hKc : IsCompact ((Subtype.val : U → Euclid P) ⁻¹' K) := by
      rw [Topology.IsInducing.subtypeVal.isCompact_preimage_iff]
      · exact hK
      · simpa using hKU
    have hint := hloc _ hKc
    have heq : ∫⁻ x in Subtype.val ⁻¹' K, ENNReal.ofReal (ρ x) ∂μ₀ =
        ∫⁻ x in Subtype.val ⁻¹' K, ‖ν x‖ₑ ∂μ₀ := by
      congr 1
      funext x
      simp [hρ_def]
    rw [heq]
    exact hint.2
  · -- (c) `ξ` is a continuous function of the measurable `u`
    have hcont : Continuous (fun v : EuclideanSpace ℝ (Fin d) =>
        (innerSL ℝ v).comp (c : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin d))) :=
      (innerSL ℝ).continuous.clm_comp continuous_const
    exact (hcont.comp_stronglyMeasurable hum.stronglyMeasurable).aestronglyMeasurable
  · -- (d) Cauchy–Schwarz and `‖u‖ ≤ 1`
    intro y α
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, innerSL_apply_apply]
    rw [hc]
    calc |inner ℝ (u y) (c α)| ≤ ‖u y‖ * ‖c α‖ := abs_real_inner_le_norm _ _
      _ ≤ 1 * ‖c α‖ := by gcongr; exact hu_le y
      _ = ‖c α‖ := one_mul _
  · -- (e) `β` is a continuous function of the measurable `u`
    exact (c.symm.continuous.comp_stronglyMeasurable hum.stronglyMeasurable).aestronglyMeasurable
  · -- (f) `‖β(y)‖ ≤ ‖c⁻¹‖ ‖u(y)‖ ≤ ‖c⁻¹‖`
    refine ⟨‖(c.symm : EuclideanSpace ℝ (Fin d) →L[ℝ] Covector (Euclid P) n)‖, fun y => ?_⟩
    calc ‖c.symm (u y)‖
        ≤ ‖(c.symm : EuclideanSpace ℝ (Fin d) →L[ℝ] Covector (Euclid P) n)‖ * ‖u y‖ :=
          (c.symm : EuclideanSpace ℝ (Fin d) →L[ℝ] Covector (Euclid P) n).le_opNorm _
      _ ≤ ‖(c.symm : EuclideanSpace ℝ (Fin d) →L[ℝ] Covector (Euclid P) n)‖ * 1 := by
          gcongr
          exact hu_le y
      _ = _ := mul_one _
  · -- (g) `|β(y)| = ‖c(c⁻¹(u y))‖ = ‖u y‖ ≤ 1`
    intro y
    rw [hc, c.apply_symm_apply]
    exact hu_le y
  · -- (h) `ξ(β) = ‖u‖² = 1` wherever the density `ρ` is nonzero
    rw [hval.ae_map_iff, ae_withDensity_iff hdens]
    refine ae_of_all _ (fun x hx => ?_)
    have hρx : ρ x ≠ 0 := by
      intro h
      apply hx
      simp [h]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe,
      ContinuousLinearEquiv.apply_symm_apply, innerSL_apply_apply]
    rw [real_inner_self_eq_norm_sq, hu_val, hνh_one x hρx]
    norm_num
  · -- (i) push-forward, then the density, then `⟨c ω, ρ ν̂⟩ = ρ ⟨ν̂, c ω⟩` pointwise
    intro ω
    rw [hval.integral_map,
      integral_withDensity_eq_integral_toReal_smul hdens
        (ae_of_all _ (fun x => ENNReal.ofReal_lt_top))]
    congr 1
    funext x
    rw [ENNReal.toReal_ofReal (hρ0 x), smul_eq_mul]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, innerSL_apply_apply,
      hu_val]
    rw [hdecomp x, inner_smul_right, real_inner_comm]

/-- **Scalar tests of density-represented top-dimensional currents**: if `Y_k(ω) = ∫_U u_k ω(e)`
for every test `n`-form `ω` on `U ⊆ ℝⁿ` and `Y_k ⇀` the current `ω ↦ c ∫ ω(e)`, then
`∫_U u_k b → c ∫ b` for every smooth compactly supported `b` with `spt b ⊆ U`.  Test with
`ω_b = b • δ`, `δ` the determinant covector (`δ(e₁, …, eₙ) = 1`), so that `ω_b(y)(e) = b(y)`. -/
theorem Submission.cbr_ci_pw_l1_scalar_test_tendsto : ∀ (n : ℕ) (U : Set (Euclid n)) (c : ℝ) (Y : ℕ → GeometricCurrentOn U n) (u : ℕ → Euclid n → ℝ), (∀ (k : ℕ) (ω : TestFormOn U n), Y k ω = ∫ y in U, u k y * (ω : DifferentialForm (Euclid n) n) y (fun i => EuclideanSpace.single i (1 : ℝ))) → (∀ ω : TestFormOn U n, Tendsto (fun k => Y k ω) atTop (𝓝 (c * ∫ y, (ω : DifferentialForm (Euclid n) n) y (fun i => EuclideanSpace.single i (1 : ℝ))))) → ∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U → Tendsto (fun k => ∫ y in U, u k y * b y) atTop (𝓝 (c * ∫ y, b y)) := by
  intro n U c Y u hrep hweak b hb hbc hbU
  obtain ⟨δ, hδ⟩ := Submission.dgoj_exists_det_covector n
  have hmem : (fun y => b y • δ : DifferentialForm (Euclid n) n) ∈ testFormOnSubmodule (E := Euclid n) U n :=
    ⟨⟨hb.smul contDiff_const, hbc.smul_right⟩, (tsupport_smul_subset_left b (fun _ => δ)).trans hbU⟩
  let ω : TestFormOn U n := ⟨fun y => b y • δ, hmem⟩
  have hωe : ∀ y, (ω : DifferentialForm (Euclid n) n) y (fun i => EuclideanSpace.single i (1 : ℝ)) = b y := by
    intro y
    simp [ω, hδ]
  have h1 := hweak ω
  simp only [hωe] at h1
  refine h1.congr (fun k => ?_)
  rw [hrep k ω]
  simp only [hωe]
/-- **Variation bound for the `L¹` representative** (Simon 6.2.5 applied to `∂Y`): if
`Y(ω) = ∫_U u ⟨ω, e⟩` for all test `(d+1)`-forms, `M_U(∂Y) < ∞`, `|ε| ≤ ‖z‖`,
`d(f ε)(e) = Df(z)`, and `f` is a smooth compactly supported function in `U` with `|f| ≤ M`, then
`|∫_U u Df(z)| ≤ M_U(∂Y) ‖z‖ M`.  Indeed `γ = f ε` is a test `d`-form with `spt γ ⊆ U` and
`|γ| = |f| |ε| ≤ M ‖z‖`, so `|∂Y(γ)| ≤ M ‖z‖ M_U(∂Y)`, while `∂Y(γ) = Y(dγ) = ∫_U u Df(z)`. -/
theorem Submission.cbr_ci_pw_l1_boundary_variation_bound : ∀ (d : ℕ) (U : Set (Euclid (d + 1))) (Y : GeometricCurrentOn U (d + 1)) (u : Euclid (d + 1) → ℝ) (ε : Covector (Euclid (d + 1)) d) (f : Euclid (d + 1) → ℝ) (z : Euclid (d + 1)) (M : ℝ), (∀ ω : TestFormOn U (d + 1), Y ω = ∫ y in U, u y * (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y (fun i => EuclideanSpace.single i (1 : ℝ))) → Y.boundary.massOn U ≠ ∞ → covectorEuclideanNorm ε ≤ ‖z‖ → (∀ y, exteriorDerivative (fun x => f x • ε) y (fun i => EuclideanSpace.single i (1 : ℝ)) = fderiv ℝ f y z) → ContDiff ℝ (⊤ : ℕ∞) f → HasCompactSupport f → tsupport f ⊆ U → (∀ y, |f y| ≤ M) → |∫ y in U, u y * fderiv ℝ f y z| ≤ (Y.boundary.massOn U).toReal * ‖z‖ * M := by
  intro d U Y u ε f z M hrep hfin hεn hεd hf hfc hfU hM
  -- the test `d`-form `γ = f ε`, with `spt γ ⊆ spt f ⊆ U`
  have hsupp : tsupport (fun x => f x • ε : DifferentialForm (Euclid (d + 1)) d) ⊆ U :=
    (tsupport_smul_subset_left f (fun _ => ε)).trans hfU
  have hmem : (fun x => f x • ε : DifferentialForm (Euclid (d + 1)) d) ∈
      testFormOnSubmodule (E := Euclid (d + 1)) U d :=
    ⟨⟨hf.smul contDiff_const, hfc.smul_right⟩, hsupp⟩
  let γ : TestFormOn U d := ⟨fun x => f x • ε, hmem⟩
  -- `|γ(x)| = |f(x)| |ε| ≤ M ‖z‖`
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hbound : ∀ x, covectorEuclideanNorm ((γ : DifferentialForm (Euclid (d + 1)) d) x) ≤
      M * ‖z‖ := by
    intro x
    change covectorEuclideanNorm (f x • ε) ≤ M * ‖z‖
    rw [(Submission.rsd_mw_tfa_norm_props (d + 1) d).2.1]
    exact mul_le_mul (hM x) hεn (covectorEuclideanNorm_nonneg ε) hM0
  -- `|∂Y(γ)| ≤ M ‖z‖ M_U(∂Y)`
  have key := Submission.cmr_abs_apply_le_massOn (d + 1) d U U Y.boundary γ (M * ‖z‖) hfin hsupp
    hbound
  -- `∂Y(γ) = Y(dγ) = ∫_U u Df(z)`
  have heq : Y.boundary γ = ∫ y in U, u y * fderiv ℝ f y z := by
    rw [GeometricCurrentOn.boundary_apply, hrep]
    congr 1
    funext y
    change u y * exteriorDerivative (fun x => f x • ε) y
      (fun i => EuclideanSpace.single i (1 : ℝ)) = _
    rw [hεd y]
  rw [heq] at key
  calc |∫ y in U, u y * fderiv ℝ f y z| ≤ M * ‖z‖ * (Y.boundary.massOn U).toReal := key
    _ = (Y.boundary.massOn U).toReal * ‖z‖ * M := by ring
/-- **`L¹` squeeze through mollifications**: let `R > 0`, `φ` continuous with compact support,
`u k` integrable on `B_{2R}(0)` and `w k x = ∫_{B_{2R}(0)} u k y φ(x - y) dy`.  If `w k → c`
uniformly on `closedBall 0 R`, `a k → 0` and eventually `∫_{B_R(0)} |u k - w k| ≤ a k`, then
`∫_{B_R(0)} |u k - c| → 0`.  Each `w k` is continuous (dominated continuity with bound
`|u k| sup |φ|`), hence integrable on `B_R(0)`; the triangle inequality gives
`∫_{B_R} |u k - c| ≤ ∫_{B_R} |u k - w k| + ∫_{B_R} |w k - c| ≤ a k + η |B_R|` once
`|w k - c| < η` on `closedBall 0 R`, and `η = ε / (2 (|B_R| + 1))` makes this `< ε`. -/
theorem Submission.cbr_ci_pw_l1_squeeze_of_mollified : ∀ (n : ℕ) (R c : ℝ) (φ : Euclid n → ℝ) (u : ℕ → Euclid n → ℝ) (a : ℕ → ℝ), 0 < R → Continuous φ → HasCompactSupport φ → (∀ k, IntegrableOn (u k) (ball 0 (2 * R))) → TendstoUniformlyOn (fun k x => ∫ y in ball 0 (2 * R), u k y * φ (x - y)) (fun _ => c) atTop (closedBall 0 R) → Tendsto a atTop (𝓝 0) → (∀ᶠ k in atTop, ∫ x in ball 0 R, |u k x - ∫ y in ball 0 (2 * R), u k y * φ (x - y)| ≤ a k) → Tendsto (fun k => ∫ x in ball 0 R, |u k x - c|) atTop (𝓝 0) := by
  intro n R c φ u a hR hφ hφc hint hunif ha hbound
  obtain ⟨C, hC⟩ := hφ.bounded_above_of_compact_support hφc
  -- continuity of the mollifications
  have hwcont : ∀ k, Continuous (fun x => ∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) := by
    intro k
    refine continuous_of_dominated (bound := fun y => ‖u k y‖ * C) (fun x => ?_) (fun x => ?_) ?_ ?_
    · exact (hint k).aestronglyMeasurable.mul
        (hφ.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
    · refine Eventually.of_forall fun y => ?_
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hC _) (norm_nonneg _)
    · exact (hint k).norm.mul_const C
    · exact Eventually.of_forall fun y => continuous_const.mul (hφ.comp (continuous_id.sub continuous_const))
  have hBR : ball (0 : Euclid n) R ⊆ ball 0 (2 * R) := ball_subset_ball (by linarith)
  have hvol : volume (ball (0 : Euclid n) R) < ∞ := measure_ball_lt_top
  have hwint : ∀ k, IntegrableOn (fun x => ∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) (ball 0 R) :=
    fun k => ((hwcont k).continuousOn.integrableOn_compact (isCompact_closedBall 0 R)).mono_set
      ball_subset_closedBall
  have huint : ∀ k, IntegrableOn (u k) (ball 0 R) := fun k => (hint k).mono_set hBR
  have hcint : IntegrableOn (fun _ : Euclid n => c) (ball 0 R) := integrableOn_const hvol.ne
  have htri : ∀ k, ∫ x in ball 0 R, |u k x - c| ≤
      (∫ x in ball 0 R, |u k x - ∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)|) +
        ∫ x in ball 0 R, |(∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) - c| := by
    intro k
    have hA : IntegrableOn (fun x => |u k x - ∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)|)
        (ball 0 R) := ((huint k).sub (hwint k)).abs
    have hB : IntegrableOn (fun x => |(∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) - c|)
        (ball 0 R) := ((hwint k).sub hcint).abs
    rw [← integral_add hA hB]
    exact integral_mono_of_nonneg (Eventually.of_forall fun x => abs_nonneg _) (hA.add hB)
      (Eventually.of_forall fun x => abs_sub_le _ _ _)
  set m := (volume (ball (0 : Euclid n) R)).toReal with hm
    rw [Finset.sum_apply]
    by_cases hx : x ∈ tsupport X
    · rw [← Finset.sum_smul, ← finsum_eq_sum_of_fintype, f.sum_eq_one hx, one_smul]
    · simp only [image_eq_zero_of_notMem_tsupport hx, smul_zero, Finset.sum_const_zero]
  have hpieces : ∀ j ∈ (Finset.univ : Finset (Option ↥s)), ContDiff ℝ 1 (fun x => f j x • X x) ∧
      HasCompactSupport (fun x => f j x • X x) ∧ Good (fun x => f j x • X x) := by
    rintro (_ | i) -
    · -- away from `N`: `id + t f₀ X`, as `f₀ X = 0` on `N`
      have hAC : ContDiff ℝ 1 (fun x => f none x • X x) := (hfC _).smul hX
      have hAc : HasCompactSupport (fun x => f none x • X x) :=
        hXc.mono (support_smul_subset_right (f none) X)
      refine ⟨hAC, hAc, (hGood _).2 ?_⟩
      obtain ⟨MA, hMA⟩ := hAc.exists_bound_of_continuous hAC.continuous
      refine ⟨fun t x => x + t • (f none x • X x), MA, Eventually.of_forall fun t =>
        ⟨contDiff_id.add (hAC.const_smul t), fun x hx => ?_, fun z hz => ?_, fun x => ?_⟩,
        fun ε hε => Eventually.of_forall fun t x => ?_⟩
      · beta_reduce
        rw [image_eq_zero_of_notMem_tsupport hx, smul_zero, smul_zero, add_zero]
      · have hz0 : f none z = 0 :=
          image_eq_zero_of_notMem_tsupport fun h => (hf none h).2 (subset_closure hz)
        beta_reduce
        rw [hz0, zero_smul, smul_zero, add_zero]; exact hz
      · beta_reduce
        rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs, mul_comm]
        exact mul_le_mul_of_nonneg_right (hMA x) (abs_nonneg t)
      · have hd : HasFDerivAt (fun x => x + t • (f none x • X x)) (ContinuousLinearMap.id ℝ _ +
            t • fderiv ℝ (fun x => f none x • X x) x) x :=
          (hasFDerivAt_id x).add ((hAC.differentiable one_ne_zero x).hasFDerivAt.const_smul t)
        beta_reduce
        rw [hd.fderiv, add_sub_cancel_left, sub_self, norm_zero]
        exact mul_nonneg hε.le (abs_nonneg t)
    · exact ⟨(hfC _).smul hX, hXc.mono (support_smul_subset_right (f (some i)) X),
        hOgood i.1 (f (some i)) (hfC _) (hf (some i))⟩
  obtain ⟨-, -, hGX⟩ := Finset.sum_induction_nonempty (fun j x => f j x • X x)
    (fun A => ContDiff ℝ 1 A ∧ HasCompactSupport A ∧ Good A)
    (fun A B hA hB => ⟨hA.1.add hB.1, hA.2.1.add hB.2.1,
      gadd A B hA.1 hA.2.1 hB.1 hB.2.1 hA.2.2 hB.2.2⟩)
    Finset.univ_nonempty hpieces
  rw [hdecomp] at hGX
  -- final family: `φ_t` for good small `t` (where `‖Dφ_t - I‖ ≤ 1/2`), `id` otherwise
  obtain ⟨φ, C, hφ, hexp⟩ := (hGood X).1 hGX
  obtain ⟨MX, hMX⟩ := (hXc.fderiv ℝ).exists_bound_of_continuous (hX.continuous_fderiv one_ne_zero)
  obtain ⟨η, hη, hηU⟩ := hXc.isCompact.exists_cthickening_subset_open hU hXU
  obtain ⟨G, hG⟩ : ∃ G : ℝ → Prop, ∀ t, G t ↔ (ContDiff ℝ 1 (φ t) ∧
      (∀ x, x ∉ tsupport X → φ t x = x) ∧ MapsTo (φ t) N N ∧ ∀ x, ‖φ t x - x‖ ≤ C * |t|) ∧
      (∀ x, ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P) - t • fderiv ℝ X x‖ ≤
        1 / 4 * |t|) ∧ |t| * 1 < 1 ∧ |t| * MX < 1 / 4 ∧ |t| * C < η := ⟨_, fun _ => Iff.rfl⟩
  have hGev : ∀ᶠ t in 𝓝 (0:ℝ), G t := by
    filter_upwards [hφ, hexp (1 / 4) (by norm_num), hev 1 1 one_pos, hev MX (1 / 4) (by norm_num),
      hev C η hη] with t h1 h2 h3 h4 h5
    exact (hG t).2 ⟨h1, h2, h3, h4, h5⟩
  refine ⟨fun t => if G t then φ t else id, fun t => ?_, fun ε hε => ?_⟩
  · by_cases ht : G t
    · simp only [ht, ↓reduceIte]
      obtain ⟨⟨h1, h2, h3, h4⟩, h5, h6, h7, h8⟩ := (hG t).1 ht
      have hD : ∀ x, ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P)‖ ≤ 1 / 2 := by
        intro x
        have hx := (norm_le_norm_add_norm_sub' (fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ _)
          (t • fderiv ℝ X x)).trans (add_le_add le_rfl (h5 x))
        rw [norm_smul, Real.norm_eq_abs] at hx
        have := mul_le_mul_of_nonneg_left (hMX x) (abs_nonneg t)
        linarith only [hx, this, h6, h7]
      have hdiff : Differentiable ℝ (φ t) := h1.differentiable one_ne_zero
      have happrox : ApproximatesLinearOn (φ t)
          ((ContinuousLinearEquiv.refl ℝ (Euclid P) : Euclid P ≃L[ℝ] Euclid P) :
            Euclid P →L[ℝ] Euclid P) univ (1 / 2 : NNReal) := by
        intro x _ y _
        have := Convex.norm_image_sub_le_of_norm_hasFDerivWithin_le' (f := φ t)
          (φ := ContinuousLinearMap.id ℝ (Euclid P)) (s := univ)
          (fun z _ => (hdiff z).hasFDerivAt.hasFDerivWithinAt) (fun z _ => hD z) convex_univ
          (mem_univ y) (mem_univ x)
        simpa using this
      have hc : Subsingleton (Euclid P) ∨ (1 / 2 : NNReal) <
          ‖(((ContinuousLinearEquiv.refl ℝ (Euclid P)).symm : Euclid P ≃L[ℝ] Euclid P) :
            Euclid P →L[ℝ] Euclid P)‖₊⁻¹ := by
        rcases subsingleton_or_nontrivial (Euclid P) with h | h
        · exact Or.inl h
        · right; simp; norm_num
      refine ⟨h1, ⟨injOn_univ.1 (happrox.injOn hc), happrox.surjective hc⟩, fun x v w hvw => ?_,
        h2, fun x hx => ⟨h3 hx.1, ?_⟩⟩
      · have h0 := (fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ _).le_of_opNorm_le (hD x) (v - w)
        rw [sub_apply, map_sub, hvw, sub_self, zero_sub, norm_neg,
          ContinuousLinearMap.id_apply] at h0
        exact sub_eq_zero.1 (norm_le_zero_iff.1 (by linarith only [h0, norm_nonneg (v - w)]))
      · by_cases hxK : x ∈ tsupport X
        · refine hηU (mem_cthickening_of_dist_le _ x _ _ hxK ?_)
          rw [dist_eq_norm]
          exact (h4 x).trans (by rw [mul_comm]; exact h8.le)
        · rw [h2 x hxK]; exact hx.2
    · simp only [ht, ↓reduceIte]
      refine ⟨contDiff_id, bijective_id, fun x => ?_, fun x _ => rfl, fun x hx => hx⟩
      rw [fderiv_id]; exact injective_id
  · obtain ⟨δ, hδ, h⟩ := Metric.eventually_nhds_iff.1 (hGev.and (hexp ε hε))
    refine ⟨δ, hδ, fun t ht x => ?_⟩
    obtain ⟨hGt, h2⟩ := h (show dist t 0 < δ by rwa [Real.dist_eq, sub_zero])
    simp only [hGt, ↓reduceIte]
    exact h2 x
/-- **First variation bound for the mass of a deformation** (Simon Ch. 4, 2.2; Ch. 2, 5.2–5.3).
Let `R = (M, θ, ξ)`, `μ_V(W) = ∫_{M ∩ W} θ dHⁿ < ∞`, `X ∈ C¹_c` with `spt X ⊆ W`, and let `φₜ` be
`C¹` maps with `φₜ = id` off `spt X` and `‖Dφₜ − I − t DX‖ ≤ ε|t|` for small `|t|`.  If `S` acts by
`S(ω) = ∫_M θ ⟨ω(φₜx) ∘ Dφₜ(x), ξ(x)⟩ dHⁿ`, then `M_W(S) ≤ μ_V(W) + t δV(X) + ε|t|` for small `|t|`.
At a.e. `x ∈ M`, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of `TₓM` and
`div_M X(x) = Σₐ τₐ · DX(x)τₐ`, so on `W` the integrand is at most
`θ |ω|_E det(Dφₜτᵢ · Dφₜτⱼ)^{1/2} ≤ θ (1 + t div_M X + ε'|t|)`, `ε' = ε/(μ_V(W) + 1)`; off `W`,
`φₜ x = x ∉ spt ω` and the integrand vanishes.  Integrate (a non-integrable integrand has integral
`0` and the bound is nonnegative) and take the supremum over admissible `ω`. -/
theorem Submission.pushforward_action_massOn_le_first_variation : ∀ (P n : ℕ) (U W : Set (Euclid P)) (R : IMRep U n) (X : Euclid P → Euclid P) (φ : ℝ → Euclid P → Euclid P), IsOpen W → R.measure W ≠ ∞ → ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → (∀ t, ContDiff ℝ 1 (φ t)) → (∀ t x, x ∉ tsupport X → φ t x = x) → (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ x, ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P) - t • fderiv ℝ X x‖ ≤ ε * |t|) → ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ S : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap (fderiv ℝ (φ t) x)) ∂μHE[n]) → S.massOn W ≤ ENNReal.ofReal ((R.measure W).toReal + t * R.firstVariation X + ε * |t|) := by
  intro P n U W R X φ hWo hRW hX hXc hXW _hφ hφid hφD ε hε
  classical
  have hDXc : Continuous (fderiv ℝ X) := hX.continuous_fderiv one_ne_zero
  -- `div_M X = trace(p_{TₓM} ∘ DX)` is a.e. strongly measurable: `p_{TₓM}` is (TM) and the trace
  -- of a composition is continuous
  have hdvm : AEStronglyMeasurable (tangentialDivergence n R.carrier X)
      (μHE[n].restrict R.carrier) := by
    have h1 : Continuous fun L : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) L.toLinearMap :=
      ((LinearMap.trace ℝ (Euclid P)).comp
        (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional
    have h2 : Continuous fun pL : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
        LinearMap.trace ℝ (Euclid P) (pL.1.comp pL.2).toLinearMap :=
      h1.comp (continuous_fst.clm_comp continuous_snd)
    have h3 : Continuous fun pL : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
        LinearMap.trace ℝ (Euclid P) (pL.1.toLinearMap ∘ₗ pL.2.toLinearMap) := by
      simpa only [ContinuousLinearMap.toLinearMap_comp] using h2
    have hq := (Submission.imrep_approxTangent_starProjection_aesm P n U R).prodMk
      hDXc.aestronglyMeasurable
    have hr := h3.comp_aestronglyMeasurable hq
    exact hr
  set μ : Measure (Euclid P) := μHE[n].restrict R.carrier
  set θ : Euclid P → ℝ := fun x => (R.mult x : ℝ) with hθ
  set dv : Euclid P → ℝ := tangentialDivergence n R.carrier X
  set m : ℝ := (R.measure W).toReal with hm
  have hθ0 : ∀ x, 0 ≤ θ x := fun x => Nat.cast_nonneg _
  have hm0 : 0 ≤ m := ENNReal.toReal_nonneg
  rw [Metric.tendsto_nhds]
  intro ε hε
  have hη0 : 0 < ε / (2 * (m + 1)) := by positivity
  have h1 := Metric.tendstoUniformlyOn_iff.1 hunif _ hη0
  have h2 := Metric.tendsto_nhds.1 ha (ε / 2) (by positivity)
  filter_upwards [h1, h2, hbound] with k hk1 hk2 hk3
  have hwc : ∫ x in ball 0 R, |(∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) - c| ≤
      ε / (2 * (m + 1)) * m := by
    have := norm_setIntegral_le_of_norm_le_const hvol (C := ε / (2 * (m + 1)))
      (f := fun x => |(∫ y in ball (0 : Euclid n) (2 * R), u k y * φ (x - y)) - c|) (fun x hx => by
        have := hk1 x (ball_subset_closedBall hx)
        rw [Real.dist_eq] at this
        rw [Real.norm_eq_abs, abs_abs, abs_sub_comm]
        exact this.le)
    exact (le_abs_self _).trans ((Real.norm_eq_abs _).symm ▸ this)
  have hnn : 0 ≤ ∫ x in ball 0 R, |u k x - c| := integral_nonneg fun x => abs_nonneg _
  rw [Real.dist_eq, sub_zero, abs_of_nonneg hnn]
  rw [Real.dist_eq, sub_zero] at hk2
  have hak : a k < ε / 2 := (le_abs_self _).trans_lt hk2
  have hlast : ε / (2 * (m + 1)) * m < ε / 2 := by
    rw [div_mul_eq_mul_div, div_lt_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  have := htri k
  linarith
/-- **The interior-product covector `ι_z(dy)` on `ℝ^{d+1}`** (used for the `d`-form `f · ι_z(dy)`,
whose exterior derivative is `(∂_z f) dy`, in White's projection argument for the closure theorem
behind Simon 7.2.4; cf. the forms `ωⱼ` in the proof of Simon 6.2.34).  For `z ∈ ℝ^{d+1}` there is
a continuous alternating `d`-form `ε` on `ℝ^{d+1}` with `ε(e₀, …, êᵢ, …, e_d) = (−1)ⁱ zᵢ`:
`ε(u₁, …, u_d) = det [z | u₁ | ⋯ | u_d] = δ(z, u₁, …, u_d)` for the standard determinant form `δ`. -/
theorem Submission.cbr_ci_pw_ipf_coord_covector : ∀ (d : ℕ) (z : Euclid (d + 1)), ∃ ε : Covector (Euclid (d + 1)) d, ∀ i : Fin (d + 1), ε (i.removeNth (fun l : Fin (d + 1) => EuclideanSpace.single l (1 : ℝ))) = (-1 : ℝ) ^ (i : ℕ) * z i := by
  intro d z
  classical
  -- The standard basis `b l = e_l` and its determinant `δ₀ c = det (c l r)_{r,l}`.
  let b : Module.Basis (Fin (d + 1)) ℝ (Euclid (d + 1)) :=
    (EuclideanSpace.basisFun (Fin (d + 1)) ℝ).toBasis
  have hdet : ∀ c : Fin (d + 1) → Euclid (d + 1), b.det c = (Matrix.of fun r l => c l r).det := by
    intro c
    rw [Module.Basis.det_apply]
    congr 1
  -- `δ₀` is continuous (entrywise continuous matrix, then `det`), so it is a covector `δ`.
  have hcont : Continuous (fun c : Fin (d + 1) → Euclid (d + 1) => b.det c) := by
    simp only [hdet]
    apply Continuous.matrix_det
    refine continuous_matrix fun r l => ?_
    exact (EuclideanSpace.proj r).continuous.comp (continuous_apply l)
  let δ : Covector (Euclid (d + 1)) (d + 1) := { b.det with cont := hcont }
  have hδ : ∀ c, δ c = b.det c := fun c => rfl
  -- `ε = δ.curryLeft z`, so `ε u = det M(u)` with columns `z, u₀, …, u_{d-1}`; expand along
  -- column `0`: `det M(u) = Σ_r (−1)ʳ z_r det N_r` with minors `N_r`.
  refine ⟨δ.curryLeft z, fun i => ?_⟩
  rw [ContinuousAlternatingMap.curryLeft_apply_apply, hδ, hdet, Matrix.det_succ_column_zero,
    Finset.sum_eq_single i]
  · -- `r = i`: `(N_i)_{a,k} = (e_{i.succAbove k})_{i.succAbove a} = [a = k]`, so `N_i = 1`.
    have h1 : (Matrix.of fun r l => (Matrix.vecCons z (i.removeNth fun l =>
        EuclideanSpace.single l (1 : ℝ)) : Fin (d + 1) → Euclid (d + 1)) l r).submatrix
          i.succAbove Fin.succ = 1 := by
      ext a k
      simp [Matrix.one_apply, Fin.removeNth_apply]
    rw [h1, Matrix.det_one]
    simp
  · -- `r ≠ i`: row `a₀` of `N_r`, where `r.succAbove a₀ = i`, is `(e_{i.succAbove k})_i = 0`.
    intro r _ hri
    obtain ⟨a₀, ha₀⟩ := Fin.exists_succAbove_eq (x := i) (y := r) (Ne.symm hri)
    rw [Matrix.det_eq_zero_of_row_eq_zero a₀, mul_zero]
    intro k
    simp [Fin.removeNth_apply, ha₀]
  · intro h
    exact absurd (Finset.mem_univ i) h
/-- **Coefficient norm of the interior-product covector** (used for `ε = ι_z(dy)` in the closure
and boundary-rectifiability step of the compactness theorem, Simon 7.2.4).  If the `d`-covector `ε`
on `ℝ^{d+1}` takes the value `(−1)ⁱ zᵢ` on `(e₀, …, êᵢ, …, e_d)`, then its Euclidean coefficient
norm (Simon (6.1.15)) is `|z|`: the strictly increasing `I : Fin d → Fin (d + 1)` are exactly the
maps `i.succAbove`, so the coefficients of `ε` are the `(−1)ⁱ zᵢ`. -/
theorem Submission.cbr_ci_pw_ipf_covector_norm_eq : ∀ (d : ℕ) (z : Euclid (d + 1)) (ε : Covector (Euclid (d + 1)) d), (∀ i : Fin (d + 1), ε (i.removeNth (fun l : Fin (d + 1) => EuclideanSpace.single l (1 : ℝ))) = (-1 : ℝ) ^ (i : ℕ) * z i) → covectorEuclideanNorm ε = ‖z‖ := by
  intro d z ε hε
  have hI : ∀ I : Fin d → Fin (d + 1), StrictMono I → ∃ i : Fin (d + 1), i.succAbove = I := by
    intro I hI
    have hns : ¬Surjective I := fun h => by
      simpa using Fintype.card_le_of_surjective I h
    obtain ⟨i, hi⟩ := not_forall.mp hns
    have hcard : (Finset.univ.erase i).card = d := by simp
    refine ⟨i, ?_⟩
    rw [Finset.orderEmbOfFin_unique hcard (f := I)
        (fun k => Finset.mem_erase.2 ⟨fun h => hi ⟨k, h⟩, Finset.mem_univ _⟩) hI,
      Finset.orderEmbOfFin_unique hcard (f := i.succAbove)
        (fun k => Finset.mem_erase.2 ⟨Fin.succAbove_ne i k, Finset.mem_univ _⟩)
        (Fin.strictMono_succAbove i)]
  rw [covectorEuclideanNorm, EuclideanSpace.norm_eq]
  congr 1
  rw [← Finset.sum_subset
      (Finset.subset_univ (Finset.univ.image fun i : Fin (d + 1) => i.succAbove)) ?_,
    Finset.sum_image fun i _ j _ h => Fin.succAbove_left_injective h]
  · refine Finset.sum_congr rfl fun i _ => ?_
    have hb : (fun k => EuclideanSpace.basisFun (Fin (d + 1)) ℝ (i.succAbove k)) =
        i.removeNth (fun l : Fin (d + 1) => EuclideanSpace.single l (1 : ℝ)) := by
      funext k
      simp [Fin.removeNth]
    rw [ite_eq_left (Fin.strictMono_succAbove i), hb, hε i, Real.norm_eq_abs, sq_abs, mul_pow,
      pow_right_comm, neg_one_sq, one_pow, one_mul]
  · intro I _ hIm
    refine ite_eq_right fun hmono => ?_
    obtain ⟨i, rfl⟩ := hI I hmono
    exact hIm (Finset.mem_image_of_mem _ (Finset.mem_univ i))
/-- **The interior product `ι_z(dy)` as a constant `d`-form on `ℝ^{d+1}`** (the forms
`f · Σⱼ zⱼ εⱼ` in the BV estimate of the closure argument for Simon 7.2.4; cf. the forms `ωⱼ` in
the proof of Simon Ch. 6, 2.34).  For `z ∈ ℝ^{d+1}` the covector
`ε(u₁, …, u_d) = det[z | u₁ | ⋯ | u_d]` has `ε(e₀, …, êᵢ, …, e_d) = (−1)ⁱ zᵢ` and `|ε| = |z|`,
and `d(f ε) = df ∧ ε` gives
`d(f ε)(y)(e₀, …, e_d) = Σᵢ (−1)ⁱ Df(y)eᵢ · (−1)ⁱ zᵢ = Df(y)(Σᵢ zᵢ eᵢ) = Df(y) z`. -/
theorem Submission.cbr_ci_pw_interior_product_form : ∀ (d : ℕ) (z : Euclid (d + 1)), ∃ ε : Covector (Euclid (d + 1)) d, covectorEuclideanNorm ε ≤ ‖z‖ ∧ ∀ (f : Euclid (d + 1) → ℝ) (y : Euclid (d + 1)), DifferentiableAt ℝ f y → exteriorDerivative (fun x => f x • ε) y (fun i => EuclideanSpace.single i (1 : ℝ)) = fderiv ℝ f y z := by
  intro d z
  -- steps 1–2: `ε = ι_z(dy)`, with `ε(i.removeNth e) = (−1)ⁱ zᵢ`
  obtain ⟨ε, hε⟩ := Submission.cbr_ci_pw_ipf_coord_covector d z
  -- step 3: `|ε| = ‖z‖`
  refine ⟨ε, (Submission.cbr_ci_pw_ipf_covector_norm_eq d z ε hε).le, fun f y hf => ?_⟩
  -- step 4: `d(f ε)(y)(e) = Σᵢ (−1)ⁱ Df(y)eᵢ · ε(i.removeNth e)`
  rw [Submission.dgcr_bwd_extDeriv_smul_const (d + 1) d f ε y _ hf]
  -- `(−1)ⁱ (−1)ⁱ = 1`, so the `i`-th term is `zᵢ Df(y)eᵢ`
  have hterm : ∀ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ f y (EuclideanSpace.single i (1 : ℝ)) * ε (i.removeNth (fun l : Fin (d + 1) => EuclideanSpace.single l (1 : ℝ)))) = z i * fderiv ℝ f y (EuclideanSpace.single i (1 : ℝ)) := by
    intro i
    have hsq : (-1 : ℝ) ^ (i : ℕ) * (-1 : ℝ) ^ (i : ℕ) = 1 := by
      rw [← mul_pow]
      norm_num
    rw [hε i]
    linear_combination (z i * fderiv ℝ f y (EuclideanSpace.single i (1 : ℝ))) * hsq
  rw [Finset.sum_congr rfl fun i _ => hterm i]
  -- `z = Σᵢ zᵢ eᵢ` and `Df(y)` is linear
  conv_rhs => rw [← (EuclideanSpace.basisFun (Fin (d + 1)) ℝ).sum_repr z]
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul, EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr, smul_eq_mul]
/-- **Translated test functions** (mollified weights in the closure theorem behind Simon 7.2.4):
if `φ` is smooth with `tsupport φ ⊆ B_s(0)`, `s < R` and `x ∈ B̄_R(0)`, then `b(y) = φ(x − y)` is
smooth with compact support in `B_{2R}(0)` and `∫ b = ∫ φ`.  `tsupport φ` is closed in the compact
`B̄_s(0)`; `y ↦ x − y` is the homeomorphism `Homeomorph.subLeft x`, so `tsupport b` is the preimage
of `tsupport φ`, on which `‖y‖ ≤ ‖x‖ + ‖x − y‖ < R + s < 2R`; and Lebesgue measure is invariant
under `y ↦ x − y`. -/
theorem Submission.cbr_ci_pw_mu_translate_admissible : ∀ (n : ℕ) (R s : ℝ) (φ : Euclid n → ℝ) (x : Euclid n), s < R → ContDiff ℝ (⊤ : ℕ∞) φ → tsupport φ ⊆ ball 0 s → x ∈ closedBall 0 R → ContDiff ℝ (⊤ : ℕ∞) (fun y => φ (x - y)) ∧ HasCompactSupport (fun y => φ (x - y)) ∧ tsupport (fun y => φ (x - y)) ⊆ ball 0 (2 * R) ∧ ∫ y, φ (x - y) = ∫ y, φ y := by
  intro n R s φ x hsR hφ hsupp hx
  -- `φ` has compact support: `tsupport φ` is closed in the compact `closedBall 0 s`
  have hφc : HasCompactSupport φ :=
    (isCompact_closedBall (0 : Euclid n) s).of_isClosed_subset (isClosed_tsupport φ)
      (hsupp.trans ball_subset_closedBall)
  -- `b = φ ∘ e` for the homeomorphism `e = (x - ·)`
  have hb : (fun y => φ (x - y)) = φ ∘ Homeomorph.subLeft x := rfl
  refine ⟨hφ.comp (contDiff_const.sub contDiff_id), hb ▸ hφc.comp_homeomorph _, ?_,
    integral_sub_left_eq_self φ volume x⟩
  intro y hy
  have hxy : x - y ∈ tsupport φ := by
    rw [hb, tsupport_comp_eq_preimage] at hy
    exact hy
  have hxy' : ‖x - y‖ < s := mem_ball_zero_iff.mp (hsupp hxy)
  have hxR : ‖x‖ ≤ R := mem_closedBall_zero_iff.mp hx
  rw [mem_ball_zero_iff]
  calc ‖y‖ = ‖x - (x - y)‖ := by rw [sub_sub_cancel]
    _ ≤ ‖x‖ + ‖x - y‖ := norm_sub_le _ _
    _ < 2 * R := by linarith
/-- **Mollification is Lipschitz, with constant `∝ ∫_S |v|`**: for `φ ∈ C^∞_c(ℝⁿ)` there is
`L ≥ 0` such that, for every `S ⊆ ℝⁿ`, every `v` integrable on `S` and all `x, x'`,
`|∫_S v(y)φ(x − y) dy − ∫_S v(y)φ(x' − y) dy| ≤ L (∫_S |v|) |x − x'|`.  `φ` is `C¹` with compact
support, hence `L`-Lipschitz, and bounded, so both integrands are integrable on `S` and the
difference is `|∫_S v(y)(φ(x − y) − φ(x' − y)) dy| ≤ ∫_S |v(y)| L |x − x'| dy`. -/
theorem Submission.cbr_ci_pw_mu_conv_lipschitz : ∀ (n : ℕ) (φ : Euclid n → ℝ), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → ∃ L : ℝ, 0 ≤ L ∧ ∀ (S : Set (Euclid n)) (v : Euclid n → ℝ), IntegrableOn v S → ∀ x x' : Euclid n, |(∫ y in S, v y * φ (x - y)) - ∫ y in S, v y * φ (x' - y)| ≤ L * (∫ y in S, |v y|) * dist x x' := by
  intro n φ hφ hφc
  obtain ⟨C, hC⟩ := hφ.lipschitzWith_of_hasCompactSupport hφc (by simp)
  obtain ⟨M, hM⟩ := hφ.continuous.bounded_above_of_compact_support hφc
  refine ⟨C, C.coe_nonneg, fun S v hv x x' => ?_⟩
  have hint : ∀ z : Euclid n, IntegrableOn (fun y => v y * φ (z - y)) S := fun z =>
    Integrable.mul_bdd hv
      (hφ.continuous.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
      (Eventually.of_forall fun y => hM (z - y))
  rw [← integral_sub (hint x) (hint x'), ← Real.norm_eq_abs]
  calc ‖∫ y in S, v y * φ (x - y) - v y * φ (x' - y)‖
      ≤ ∫ y in S, |v y| * (C * dist x x') := by
        refine norm_integral_le_of_norm_le (hv.abs.mul_const _) (Eventually.of_forall fun y => ?_)
        rw [Real.norm_eq_abs, ← mul_sub, abs_mul]
        gcongr
        rw [← Real.dist_eq]
        simpa [dist_sub_right] using hC.dist_le_mul (x - y) (x' - y)
    _ = C * (∫ y in S, |v y|) * dist x x' := by
        rw [integral_mul_const]
        ring
/-- Pointwise convergence to a constant plus an eventual uniform Lipschitz bound on a compact set
gives uniform convergence (the ε/3 argument): cover `K` by finitely many `η`-balls centred in `K`,
with `max L 0 * η < ε / 3`; eventually every centre is `ε / 3`-close to `a`, and each `x ∈ K` lies
within `η` of a centre. -/
theorem Submission.cbr_ci_pw_mu_uniform_of_equilipschitz : ∀ (n : ℕ) (K : Set (Euclid n)) (F : ℕ → Euclid n → ℝ) (a L : ℝ), IsCompact K → (∀ x ∈ K, Tendsto (fun k => F k x) atTop (𝓝 a)) → (∀ᶠ k in atTop, ∀ x ∈ K, ∀ x' ∈ K, |F k x - F k x'| ≤ L * dist x x') → TendstoUniformlyOn F (fun _ => a) atTop K := by
  intro n K F a L hK hpt hL
  rw [Metric.tendstoUniformlyOn_iff]
  intro ε hε
  have hM0 : 0 ≤ max L 0 := le_max_right L 0
  have hη : 0 < ε / (3 * (max L 0 + 1)) := by positivity
  have hMη : max L 0 * (ε / (3 * (max L 0 + 1))) < ε / 3 := by
    rw [mul_div_assoc', div_lt_div_iff₀ (by positivity) (by norm_num)]
    nlinarith
  obtain ⟨t, htK, ht, hcover⟩ := hK.finite_cover_balls hη
  have hnet : ∀ᶠ k in atTop, ∀ z ∈ t, |F k z - a| < ε / 3 :=
    ht.eventually_all.2 fun z hz => by
      simpa only [Real.dist_eq] using Metric.tendsto_nhds.1 (hpt z (htK hz)) (ε / 3) (by positivity)
  filter_upwards [hnet, hL] with k hk hkL x hx
  obtain ⟨z, hz, hxz⟩ := mem_iUnion₂.1 (hcover hx)
  have hzx : |F k z - F k x| < ε / 3 :=
    calc |F k z - F k x| ≤ L * dist z x := hkL z (htK hz) x hx
      _ ≤ max L 0 * dist z x := mul_le_mul_of_nonneg_right (le_max_left L 0) dist_nonneg
      _ ≤ max L 0 * (ε / (3 * (max L 0 + 1))) :=
        mul_le_mul_of_nonneg_left (mem_ball'.1 hxz).le hM0
      _ < ε / 3 := hMη
  rw [Real.dist_eq]
  have htri := abs_sub_le a (F k z) (F k x)
  rw [abs_sub_comm a (F k z)] at htri
  linarith [hk z hz]
/-- **Inner-annulus quotients and the derivative of `r ↦ μ(B_r(x₁))`** (Simon Ch. 6: the
quotients `h⁻¹ M(T⌞{t − h < |x − ξ| < t})` of 4.9 are bounded by the derivative of
`r ↦ M(T⌞B_r(ξ))`, as used in the proof of 8.2, (2)).  If `μ(B_ρ(x₁)) < ∞` and
`F(r) = μ(B_r(x₁))` has derivative `d` at `ρ`, then
`liminf_{h ↓ 0} h⁻¹ μ{ρ − h < |x − x₁| < ρ} ≤ d`: for `h > 0` the annulus lies in
`B_ρ(x₁) \ B_{ρ−h}(x₁)`, of measure `F(ρ) − F(ρ − h)`, and the backward difference quotients
`h⁻¹ (F(ρ) − F(ρ − h))` tend to `d`. -/
theorem Submission.cbrld_radius_liminf_annulus_le_of_hasDerivAt : ∀ (P : ℕ) (μ : Measure (Euclid P)) (x₁ : Euclid P) (ρ d : ℝ), μ (ball x₁ ρ) ≠ ∞ → HasDerivAt (fun r : ℝ => (μ (ball x₁ r)).toReal) d ρ → liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ}) (𝓝[>] 0) ≤ ENNReal.ofReal d := by
  intro P μ x₁ ρ d hμ hd
  -- the backward difference quotients `h⁻¹ (F(ρ) − F(ρ − h))` tend to `d` as `h ↓ 0`
  have hq : Tendsto (fun h : ℝ => h⁻¹ * ((μ (ball x₁ ρ)).toReal - (μ (ball x₁ (ρ - h))).toReal))
      (𝓝[>] 0) (𝓝 d) := by
    have hneg : Tendsto (fun h : ℝ => -h) (𝓝[>] 0) (𝓝[<] 0) := by
      simpa using tendsto_neg_nhdsGT (a := (0 : ℝ))
    refine (hd.tendsto_slope_zero_left.comp hneg).congr' (Eventually.of_forall fun h => ?_)
    simp only [Function.comp_apply, smul_eq_mul]
    rw [inv_neg, ← sub_eq_add_neg]
    ring
  have hlim : liminf (fun h : ℝ => ENNReal.ofReal
      (h⁻¹ * ((μ (ball x₁ ρ)).toReal - (μ (ball x₁ (ρ - h))).toReal))) (𝓝[>] 0) =
      ENNReal.ofReal d :=
    ((ENNReal.continuous_ofReal.tendsto d).comp hq).liminf_eq
  refine (liminf_le_liminf ?_).trans_eq hlim
  -- for `h > 0`, the annulus lies in `B_ρ(x₁) \ B_{ρ−h}(x₁)`, of measure `F(ρ) − F(ρ − h)`
  filter_upwards [self_mem_nhdsWithin] with h (hh : 0 < h)
  have hsub : ball x₁ (ρ - h) ⊆ ball x₁ ρ := ball_subset_ball (by linarith)
  have hfin : μ (ball x₁ (ρ - h)) ≠ ∞ := ne_top_of_le_ne_top hμ (measure_mono hsub)
  have hA : {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ} ⊆ ball x₁ ρ \ ball x₁ (ρ - h) :=
    fun x hx => ⟨mem_ball.mpr hx.2, fun hx' => lt_asymm hx.1 (mem_ball.mp hx')⟩
  calc ENNReal.ofReal h⁻¹ * μ {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ}
      ≤ ENNReal.ofReal h⁻¹ * μ (ball x₁ ρ \ ball x₁ (ρ - h)) := by gcongr
    _ = ENNReal.ofReal h⁻¹ * ENNReal.ofReal
          ((μ (ball x₁ ρ)).toReal - (μ (ball x₁ (ρ - h))).toReal) := by
        rw [measure_sdiff hsub measurableSet_ball.nullMeasurableSet hfin,
          ENNReal.ofReal_sub _ ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hμ,
          ENNReal.ofReal_toReal hfin]
    _ = ENNReal.ofReal (h⁻¹ * ((μ (ball x₁ ρ)).toReal - (μ (ball x₁ (ρ - h))).toReal)) :=
        (ENNReal.ofReal_mul (inv_nonneg.mpr hh.le)).symm
/-- **Simon Ch. 6, 6.1 (Isoperimetric Theorem)**, from the scaled deformation theorem 5.3 in the
frozen form (DT), with constant `c ≥ 1` for `(P, m)`.  Let `Z ∈ 𝒟_{m+1}(ℝᴾ)` be integer
multiplicity with `spt Z` compact, `∂Z = 0` and `z = M(Z) < ∞`.  Apply (DT) to `T = Z` with
`K = spt Z`, `Λ = z` and `ρ = (2cz)^{1/(m+1)}` (`ρ = 1` if `z = 0`).  A current of zero mass is
zero (test `±sω` with `s‖ω‖_∞ ≤ 1`), so `M(S) ≤ cρ M(∂Z) = 0` gives `S = 0`, and
`M(Q) ≤ cz < ρ^{m+1}` excludes the second alternative, so `Q = 0` and `Z = ∂R`.  Then `Y = R` has
the mass and support bounds of (DT); if `z = 0`, also `M(R) = 0`, so `spt R = ∅`. -/
theorem Submission.cbr_isoperimetric_filling : (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → ∀ (P m : ℕ), ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support := by
  intro hDT P m
  obtain ⟨c, hc1, hDT⟩ := hDT P m
  refine ⟨(c : ℝ), by exact_mod_cast hc1, ?_⟩
  intro Z hZ hZc hZb hZm
  -- `M(0) = 0` and `spt 0 = ∅`
  have hmass0 : ∀ k : ℕ, (0 : GeometricCurrentOn (univ : Set (Euclid P)) k).mass = 0 := by
    intro k
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  have hsupp0 : ∀ k : ℕ, (0 : GeometricCurrentOn (univ : Set (Euclid P)) k).support = ∅ := by
    intro k
    refine eq_empty_of_forall_notMem fun x hx => hx.2 ?_
    exact ⟨ball x 1, ⟨isOpen_ball, isBounded_ball.isCompact_closure, subset_univ _,
      fun ω _ => rfl⟩, mem_ball_self one_pos⟩
  -- the Euclidean coefficient norm is absolutely homogeneous
  have hhom : ∀ (k : ℕ) (t : ℝ) (α : Covector (Euclid P) k),
      covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := by
    intro k t α
    simp only [covectorEuclideanNorm]
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg t), Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs <;> simp [mul_pow]
  -- a current of zero mass is zero: test `±sω` with `s‖ω‖_∞ ≤ 1`
  have hzero : ∀ (k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), X.mass = 0 →
      X = 0 := by
    intro k X hX
    ext ω
    have hω : Continuous (ω : DifferentialForm (Euclid P) k) := ω.property.1.1.continuous
    have hfc : Continuous (covectorEuclideanNorm ∘ (ω : DifferentialForm (Euclid P) k)) := by
      simp only [Function.comp_def, covectorEuclideanNorm]
      refine Continuous.sqrt (continuous_finsetSum _ fun I _ => ?_)
      exact continuous_if_const _ (fun _ => ((continuous_eval_const _).comp hω).pow 2)
        fun _ => continuous_const
    have hcs : HasCompactSupport (covectorEuclideanNorm ∘ (ω : DifferentialForm (Euclid P) k)) :=
      ω.property.1.2.comp_left (covectorEuclideanNorm_zero P k)
    obtain ⟨C, hC⟩ := hfc.bounded_above_of_compact_support hcs
    obtain ⟨s, hs, hsC⟩ : ∃ s : ℝ, 0 < s ∧ s * (|C| + 1) = 1 :=
      ⟨(|C| + 1)⁻¹, by positivity, inv_mul_cancel₀ (by positivity)⟩
    have hadm : ∀ t : ℝ, |t| ≤ s → t • ω ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      intro t ht
      refine ⟨subset_univ _, fun x => ?_⟩
      show covectorEuclideanNorm (t • (ω : DifferentialForm (Euclid P) k) x) ≤ 1
      rw [hhom]
      have h0 := covectorEuclideanNorm_nonneg ((ω : DifferentialForm (Euclid P) k) x)
      have h1 : covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x) ≤ |C| + 1 := by
        have := hC x
        rw [Function.comp_apply, Real.norm_of_nonneg h0] at this
        linarith [le_abs_self C]
      calc |t| * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x)
          ≤ s * (|C| + 1) := mul_le_mul ht h1 h0 hs.le
        _ = 1 := hsC
    have hX' : X.massOn univ = 0 := hX
    have h1 := X.le_massOn (hadm s (abs_of_pos hs).le)
    have h2 := X.le_massOn (hadm (-s) (by rw [abs_neg, abs_of_pos hs]))
    rw [hX', nonpos_iff_eq_zero, ENNReal.ofReal_eq_zero] at h1 h2
    have e1 : X (s • ω) = s * X ω := map_smul X.toCurrent s ω
    have e2 : X ((-s) • ω) = -(s * X ω) := by
      rw [show X ((-s) • ω) = -s * X ω from map_smul X.toCurrent (-s) ω]
      ring
    rw [e1] at h1
    rw [e2] at h2
    have h3 : s * X ω = 0 := by linarith
    rw [GeometricCurrentOn.zero_apply]
    exact (mul_eq_zero.1 h3).resolve_left hs.ne'
  -- the scale `ρ`
  set z : ℝ := Z.mass.toReal
  have hz0 : 0 ≤ z := ENNReal.toReal_nonneg
  have hZmz : Z.mass = ENNReal.ofReal z := (ENNReal.ofReal_toReal hZm.ne).symm
  have hc0 : (0 : ℝ) ≤ c := c.coe_nonneg
  have hc0' : (0 : ℝ) < c := by exact_mod_cast zero_lt_one.trans_le hc1
  have hcz0 : 0 ≤ (c : ℝ) * z := mul_nonneg hc0 hz0
  obtain ⟨ρ, hρ0, hρlt, hρ⟩ : ∃ ρ : ℝ, 0 < ρ ∧ (c : ℝ) * z < ρ ^ (m + 1) ∧
      (z = 0 ∨ ρ = (2 * (c : ℝ) * z) ^ ((1 : ℝ) / (m + 1))) := by
    rcases hz0.eq_or_lt with h | h
    · exact ⟨1, one_pos, by rw [← h]; simp, Or.inl h.symm⟩
    · have hcz : 0 < 2 * (c : ℝ) * z := mul_pos (mul_pos two_pos hc0') h
      refine ⟨_, Real.rpow_pos_of_pos hcz _, ?_, Or.inr rfl⟩
      have hpow : ((2 * (c : ℝ) * z) ^ ((1 : ℝ) / (m + 1))) ^ (m + 1) = 2 * (c : ℝ) * z := by
        rw [one_div, ← Nat.cast_succ]
        exact Real.rpow_inv_natCast_pow hcz.le (Nat.succ_ne_zero m)
      rw [hpow]
      have : 0 < (c : ℝ) * z := mul_pos hc0' h
      linarith
  have hcρ : 0 ≤ (c : ℝ) * ρ := mul_nonneg hc0 hρ0.le
  -- apply (DT) to `T = Z`
  obtain ⟨𝒬, -, hDT⟩ := hDT ρ Z.support Z.mass.toNNReal hρ0 hZc
  obtain ⟨Q, -, R, S, -, -, hR, hZQS, hQ, hQm, -, hRm, hSm, hQR, -⟩ :=
    hDT Z hZ subset_rfl (ENNReal.coe_toNNReal hZm.ne).ge
      (by rw [hZb, hmass0]; exact ENNReal.zero_lt_top)
  -- `M(S) ≤ cρ M(∂Z) = 0`, so `S = 0`
  rw [hZb, hmass0, mul_zero, nonpos_iff_eq_zero] at hSm
  obtain rfl : S = 0 := hzero _ S hSm
  -- `M(Q) ≤ cz < ρ^{m+1}`, so `Q = 0`
  obtain rfl : Q = 0 := by
    refine hQ.resolve_right fun h => ?_
    have h' := h.trans hQm
    rw [hZmz, ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul hc0,
      ENNReal.ofReal_le_ofReal_iff hcz0] at h'
    linarith
  -- hence `Z = ∂R`
  have hRZ : R.boundary = Z := by
    rw [← hZQS]
    ext ω
    show Z ω - 0 - 0 = Z ω
    ring
  rcases hρ with h | rfl
  · -- `z = 0`: `M(R) ≤ cρ · 0 = 0`, so `R = 0`
    rw [hZmz, h, ENNReal.ofReal_zero, mul_zero, nonpos_iff_eq_zero] at hRm
    refine ⟨R, hR, hRZ, hRm.trans_le zero_le, ?_⟩
    rw [hzero _ R hRm, hsupp0]
    exact empty_subset _
  · refine ⟨R, hR, hRZ, hRm.trans (le_of_eq ?_), subset_union_right.trans hQR⟩
    rw [ENNReal.ofReal_mul hcρ, ENNReal.ofReal_mul hc0, ENNReal.ofReal_coe_nnreal, hZmz]
/-- **Good slicing radius** (Simon Ch. 6, 8.2 (2)–(3): radii where `(F^{1/n})′` is controlled,
and `F′ = nF^{(n−1)/n}(F^{1/n})′`).  If `μ` is finite on compact sets, `n ≥ 1`, `a, s > 0`,
`μ(B_s(x₁)) < (as)ⁿ` and `L¹(N) = 0`, then some `ρ ∈ (0, s) \ N` has `μ(∂B_ρ(x₁)) = 0` and
`liminf_{h ↓ 0} h⁻¹ μ{ρ − h < |x − x₁| < ρ} ≤ 2na μ(B_ρ(x₁))^{(n−1)/n}`.  Let `F(r) = μ(B_r(x₁))`
and `G = F^{1/n}`: both are nondecreasing, `G(0) = 0` and `G(s) ≤ as`, so `∫_{(0,s)} G′ ≤ as`
(Lebesgue's inequality).  The good-radius lemma applied to `1_{(0,s)} G′` avoids `N`, the
non-differentiability points of `G` and the spheres charged by `μ`, with `G′(ρ) ≤ (2/s)·as = 2a`.
Then `F = Gⁿ` has derivative `nG(ρ)^{n−1}G′(ρ) ≤ 2na F(ρ)^{(n−1)/n}` at `ρ`, which bounds the
inner-annulus liminf. -/
theorem Submission.cbrld_exists_good_slice_radius : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (x₁ : Euclid P) (a s : ℝ) (N : Set ℝ), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → 1 ≤ n → 0 < a → 0 < s → μ (ball x₁ s) < ENNReal.ofReal ((a * s) ^ n) → volume N = 0 → ∃ ρ : ℝ, 0 < ρ ∧ ρ < s ∧ ρ ∉ N ∧ μ (sphere x₁ ρ) = 0 ∧ liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ}) (𝓝[>] 0) ≤ ENNReal.ofReal (2 * n * a * (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n)) := by
  intro P n μ x₁ a s N hμ hn ha hs hμs hN
  have hn0 : n ≠ 0 := Nat.one_le_iff_ne_zero.mp hn
  have hn0' : (0 : ℝ) < n := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn0)
  have hinv : (0 : ℝ) ≤ (n : ℝ)⁻¹ := inv_nonneg.mpr hn0'.le
  -- `μ` is finite on balls (closed balls are compact)
  have hball : ∀ r : ℝ, μ (ball x₁ r) ≠ ∞ := fun r =>
    ne_top_of_le_ne_top (hμ _ (isCompact_closedBall x₁ r)).ne (measure_mono ball_subset_closedBall)
  -- `F(r) = μ(B_r(x₁))` and `G = F^{1/n}` are nondecreasing, `G(0) = 0`, `Gⁿ = F`, `G(s) ≤ as`
  set F : ℝ → ℝ := fun r => (μ (ball x₁ r)).toReal with hF_def
  set G : ℝ → ℝ := fun r => F r ^ (n : ℝ)⁻¹ with hG_def
  have hF0 : ∀ r, 0 ≤ F r := fun r => ENNReal.toReal_nonneg
  have hFmono : Monotone F := fun r r' hrr' =>
    ENNReal.toReal_mono (hball r') (measure_mono (ball_subset_ball hrr'))
  have hGmono : Monotone G := fun r r' hrr' => Real.rpow_le_rpow (hF0 r) (hFmono hrr') hinv
  have hFG : ∀ r, G r ^ n = F r := fun r => Real.rpow_inv_natCast_pow (hF0 r) hn0
  have hG0 : G 0 = 0 := by
    simp only [hG_def, hF_def, ball_zero, measure_empty, ENNReal.toReal_zero]
    exact Real.zero_rpow (inv_ne_zero hn0'.ne')
  have hGs : G s ≤ a * s :=
    calc G s ≤ ((a * s) ^ n) ^ (n : ℝ)⁻¹ :=
          Real.rpow_le_rpow (hF0 s) (ENNReal.toReal_lt_of_lt_ofReal hμs).le hinv
      _ = a * s := Real.pow_rpow_inv_natCast (mul_pos ha hs).le hn0
  -- Lebesgue's inequality: `∫⁻_{(0,s)} G′ ≤ G(s) − G(0) ≤ as`
  have hgm : AEMeasurable ((Ioo 0 s).indicator fun t => ENNReal.ofReal (deriv G t)) :=
    ((ENNReal.measurable_ofReal.comp (measurable_deriv G)).indicator measurableSet_Ioo).aemeasurable
  have hgI : ∫⁻ t, (Ioo 0 s).indicator (fun t => ENNReal.ofReal (deriv G t)) t ≤
      ENNReal.ofReal (a * s) := by
    rw [lintegral_indicator measurableSet_Ioo]
    refine (Submission.cmcs_smi_lintegral_ofReal_deriv_le G 0 s hGmono).trans ?_
    rw [hG0, sub_zero]
    exact ENNReal.ofReal_le_ofReal hGs
  -- the exceptional radii: `N` and the points where `G` is not differentiable
  have hp : ∀ᵐ t, t ∉ N ∧ DifferentiableAt ℝ G t :=
    (measure_eq_zero_iff_ae_notMem.mp hN).and hGmono.ae_differentiableAt
  obtain ⟨ρ, hρ0, hρs, ⟨hρN, hρd⟩, hρsph, hρg⟩ :=
    Submission.dor_lmb_glc_good_radius P μ x₁ 0 s _ _ _ hs (hμ _ (isCompact_closedBall x₁ s)).ne
      hgm hgI hp
  -- `G′(ρ) ≤ (2/s) · as = 2a`
  have hGd : deriv G ρ ≤ 2 * a := by
    rw [indicator_of_mem (mem_Ioo.mpr ⟨hρ0, hρs⟩), sub_zero,
      ← ENNReal.ofReal_mul (div_nonneg zero_le_two hs.le),
      show 2 / s * (a * s) = 2 * a by field_simp,
      ENNReal.ofReal_le_ofReal_iff (mul_pos two_pos ha).le] at hρg
    exact hρg
  refine ⟨ρ, hρ0, hρs, hρN, hρsph, ?_⟩
  -- `F = Gⁿ` has derivative `nG(ρ)^{n−1}G′(ρ)` at `ρ`
  have hFd : HasDerivAt F (n * G ρ ^ (n - 1) * deriv G ρ) ρ := by
    have h := hρd.hasDerivAt.fun_pow n
    rwa [show (fun r => G r ^ n) = F from funext hFG] at h
  refine (Submission.cbrld_radius_liminf_annulus_le_of_hasDerivAt P μ x₁ ρ _ (hball ρ) hFd).trans
    (ENNReal.ofReal_le_ofReal ?_)
  -- `G(ρ)^{n−1} = F(ρ)^{(n−1)/n}`, and `G′(ρ) ≤ 2a`
  have hpow : G ρ ^ (n - 1) = (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) := by
    rw [hG_def, hF_def]
    dsimp only
    rw [← Real.rpow_natCast, ← Real.rpow_mul ENNReal.toReal_nonneg, Nat.cast_sub hn,
      Nat.cast_one, inv_mul_eq_div]
  rw [hpow]
  have hX : 0 ≤ (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) :=
    Real.rpow_nonneg ENNReal.toReal_nonneg _
  calc (n : ℝ) * (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) * deriv G ρ
      ≤ n * (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) * (2 * a) := by gcongr
    _ = 2 * n * a * (μ (ball x₁ ρ)).toReal ^ (((n : ℝ) - 1) / n) := by ring
      obtain ⟨S, hSi, hSb, hSω⟩ := Submission.imrep_c1_diffeo_pushforward_im P n U
        (tsupport X) T R (φ t) hU hR hXc hXU (hφ t).1 (hφ t).2.1 (hφ t).2.2.1 (hφ t).2.2.2.1
      have h := (ENNReal.ofReal_toReal hRWfin).le.trans
        ((hcomp t S hSi (hSb hT) hSω).trans (hδS t ht S hSω))
      by_contra hneg
      exact not_lt.2 h ((ENNReal.ofReal_lt_ofReal_iff hm).2 (by linarith [not_le.1 hneg]))
    have h₁ := key (δ / 2) (by rw [abs_of_pos (half_pos hδ)]; exact half_lt_self hδ)
    have h₂ := key (-(δ / 2)) (by rw [abs_neg, abs_of_pos (half_pos hδ)]; exact half_lt_self hδ)
    rw [abs_of_pos (half_pos hδ)] at h₁
    rw [abs_neg, abs_of_pos (half_pos hδ)] at h₂
    rw [abs_le]
    constructor <;> nlinarith
  by_contra ha
  have h := hbound (|R.firstVariation X| / 2) (half_pos (abs_pos.2 ha))
  linarith [abs_pos.2 ha]
/-- **A constant mass ratio about `0` makes `C` a cone** (proof of Simon 7.3.1, chapter-07.txt
lines 336–360, with Ch. 4, 3.6 and Ch. 6, 2.33).  Let `C = τ(M, θ, ξ)` have `∂C = 0`, let
`V = v(M, θ)` be stationary in `ℝᴾ` and `M_{B_ρ(0)}(C) = ωₙρⁿθ₀` for all `ρ > 0`.  Stationarity
along `ℝᴾ` imposes no tangency condition (`γ(t) = y + tv` shows `v ∈ T_y ℝᴾ`), so `δV(X) = 0`
for every `C¹` compactly supported `X`; and `M_{B_ρ(0)}(C) = μ_V(B_ρ(0))` turns the hypothesis
into `μ_V(B_ρ(0)) = aρⁿ` with `a = ωₙθ₀`.  The monotonicity identity then gives `x ∈ TₓM` for
`μ_V`-a.e. `x`, hence `x ∧ C⃗ = 0` `μ_C`-a.e., and Lemma 6.2.33 gives `η_{0,λ#}C = C`. -/
theorem Submission.dtc_cone_of_constant_density : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (θ : ℝ), 0 < n → IsIntegerMultiplicity C → BoundaryVanishes C → (∀ R : IMRep (univ : Set (Euclid P)) n, R.Represents C → R.IsStationaryAlong univ) → (∀ ρ : ℝ, 0 < ρ → C.massOn (ball 0 ρ) = unitBallVolume n * ENNReal.ofReal (ρ ^ n) * ENNReal.ofReal θ) → IsConeCurrent C := by
  intro P n C θ hn hC hbdry hstat hmass
  obtain ⟨R, hR⟩ := hC
  -- `T_y ℝᴾ` contains every `v` (`γ(t) = y + tv`), so `δV(X) = 0` for every `X ∈ C¹_c(ℝᴾ; ℝᴾ)`
  have hvar : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
      R.firstVariation X = 0 := by
    intro X hX hXc
    refine hstat R hR X hX hXc (subset_univ _) fun y _ => ?_
    refine ⟨fun t => y + t • X y, (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffOn,
      mapsTo_univ _ _, by simp, ?_⟩
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (X y)).const_add y
  -- `μ_V(B_ρ(0)) = M_{B_ρ(0)}(C) = (ωₙθ₀)ρⁿ`
  have hball : ∀ ρ : ℝ, 0 < ρ →
      R.measure (ball 0 ρ) = unitBallVolume n * ENNReal.ofReal θ * ENNReal.ofReal (ρ ^ n) := by
    intro ρ hρ
    rw [← Submission.dtc_mass_eq_measure P n univ (ball 0 ρ) C R isOpen_univ isOpen_ball
      (subset_univ _) hR, hmass ρ hρ, mul_right_comm]
  -- `x ∈ TₓM` for `μ_V`-a.e. `x`, so `x ∧ C⃗ = 0` `μ_C`-a.e., so `C` is a cone (Lemma 6.2.33)
  exact Submission.dtc_cone_of_wedge_vanishing P n C R hn hR hbdry
    (Submission.dtc_cone_wedge_vanishes P n univ R
      (Submission.dtc_cone_radial_tangency P n R (unitBallVolume n * ENNReal.ofReal θ) hvar hball))

/-- **Tangent limits of minimizing cycles have `n`-homogeneous weights** (Simon 7.3.1(2),
chapter-07.txt lines 302–309 and 325–360, with the homogeneity of cone weights in the proof of
7.4.5, lines 697–699), assuming (MON) (`dimred_minimizing_monotonicity`) and (MB)
(`dimred_blowup_limit_moving_centres`).  `x ∈ spt T ⊆ U`.  (MB) with the constant centres
`xⱼ = x` gives `φ` and `C`, minimizing in `ℝ^{n+k}` with `∂C = 0`, `η_{x,λ_{φ(j)}#}T ⇀ C` and
`μ_{η_{x,λ_{φ(j)}#}T} → μ_C`.  (MON)(iii) with `d = n + ℓ` gives `Θⁿ(μ_T, x) = Θ(x)`, so
`M_{B_ρ(0)}(C) = ωₙρⁿΘ(x)` for every `ρ > 0` (`dtc_blowUp_density`, book (1), (4)).  Every
representation of `C` is stationary in `ℝ^{n+k}` (7.1.2 with `U = N = ℝ^{n+k}` and the identity
chart), so `C` is a cone (`dtc_cone_of_constant_density`), and the weight of every representation
of `C` satisfies `μ(λA) = λⁿ μ(A)` (`cone_current_imrep_measure_smul_image`). -/
theorem Submission.dimred_tr_tangent_measure_homogeneous : (∀ (P n d : ℕ) (U N : Set (Euclid P)) (T : GeometricCurrentOn U n), 1 ≤ n → n ≤ d → d ≤ P → IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ (y : Euclid P) (R : ℝ), closedBall y R ⊆ K → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 R)) ∧ (N = univ → ∀ (y : Euclid P) (R : ℝ), ball y R ⊆ U → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (1 / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 R)) ∧ (∃ Θ : Euclid P → ℝ, (∀ y ∈ U, HasMassDensity T y (Θ y)) ∧ UpperSemicontinuousOn Θ U) ∧ ∀ y ∈ T.support, ∀ θ : ℝ, HasMassDensity T y θ → 1 ≤ θ) → (∀ (n k ℓ : ℕ), ℓ ≤ k → ∀ (U N : Set (Euclid (n + k))) (T : GeometricCurrentOn U n), 1 ≤ n → IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T → ∀ (x : Euclid (n + k)) (xs : ℕ → Euclid (n + k)) (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), x ∈ U → Tendsto xs atTop (𝓝 x) → Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C : GeometricCurrentOn (univ : Set (Euclid (n + k))) n), StrictMono φ ∧ ConvergesWeakly (fun j => blowUp T (xs (φ j)) (lams (φ j)) (hlams (φ j)).ne') C ∧ MassMeasuresConverge (fun j => blowUp T (xs (φ j)) (lams (φ j)) (hlams (φ j)).ne') C ∧ IsMinimizingIn C univ ∧ BoundaryVanishes C) → ∀ (n k ℓ : ℕ), ℓ ≤ k → ∀ (U N : Set (Euclid (n + k))) (T : GeometricCurrentOn U n), 1 ≤ n → IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T → ∀ x ∈ T.support, ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C : GeometricCurrentOn (univ : Set (Euclid (n + k))) n), StrictMono φ ∧ ConvergesWeakly (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') C ∧ MassMeasuresConverge (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') C ∧ IsMinimizingIn C univ ∧ ∀ R : IMRep (univ : Set (Euclid (n + k))) n, R.Represents C → ∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid (n + k)), MeasurableSet A → R.measure ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * R.measure A := by
  intro hMON hMB n k ℓ hℓ U N T hn hU hN hNU hmin hspt hbd x hx lams hlams hlim
  -- Step 1: `x ∈ spt T ⊆ U ∩ N`
  have hxU : x ∈ U := (hspt hx).1
  -- Step 2: (MB) with the constant centres `xⱼ = x` gives `φ` and `C`, minimizing in `ℝ^{n+k}`
  obtain ⟨φ, C, hφ, hconv, hmeas, hCmin, hCbd⟩ := hMB n k ℓ hℓ U N T hn hU hN hNU hmin hspt hbd
    x (fun _ => x) lams hlams hxU tendsto_const_nhds hlim
  -- Step 3: (MON)(iii) with `d = n + ℓ` gives the density `Θ(x)` of `T` at `x`
  obtain ⟨Θ, hΘ, -⟩ := (hMON (n + k) n (n + ℓ) U N T hn (Nat.le_add_right n ℓ)
    (Nat.add_le_add_left hℓ n) hU hN hNU hmin hspt hbd).2.2.1
  -- Step 4: `M_{B_ρ(0)}(C) = ωₙρⁿΘ(x)` for every `ρ > 0` (book (1), (4))
  obtain ⟨hCball, -⟩ := Submission.dtc_blowUp_density (n + k) n U T C x (Θ x)
    (fun j => lams (φ j)) (fun j => hlams (φ j)) hU hn hxU hmin.1 hCmin.1
    (hlim.comp hφ.tendsto_atTop) (hΘ x hxU) hmeas
  -- Step 5: every representation of `C` is stationary in `ℝ^{n+k}` (7.1.2 with `U = N = ℝ^{n+k}`
  -- and the identity chart)
  have huniv : IsEmbeddedSubmanifold 2 (n + k) (univ : Set (Euclid (n + k))) := by
    intro y _
    refine ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiff_id.contDiffOn,
      injOn_id _, by simp, fun K _ hK => by simpa using hK, fun z _ => ?_⟩
    rw [fderiv_id]
    exact fun a b h => h
  have hCstat : ∀ R : IMRep (univ : Set (Euclid (n + k))) n, R.Represents C →
      R.IsStationaryAlong univ := fun R hR =>
    Submission.stationaryAlong_of_minimizing_in_submanifold (n + k) n (n + k) univ univ C R
      isOpen_univ huniv (by simp) (by rwa [inter_self]) hCbd hR (by simp)
  -- Step 6: `C` has constant density ratio, so it is a cone
  have hcone : IsConeCurrent C :=
    Submission.dtc_cone_of_constant_density (n + k) n C (Θ x) hn hCmin.1 hCbd hCstat hCball
  -- Steps 7–8: the weights of the cone `C` are `n`-homogeneous
  exact ⟨φ, C, hφ, hconv, hmeas, hCmin, fun R hR lam hlam A hA =>
    Submission.cone_current_imrep_measure_smul_image (n + k) n C R hcone hR lam hlam A hA⟩

/-- **Cone inequality for small cycles** (Simon Ch. 6, 2.27/2.30, as used in 8.2(4)–(6)).  Assume
(VO) and let `c ≥ 0` be a Lipschitz constant of `ω` in the Euclidean coefficient norm.  If
`∂X = 0`, `M(X) < ∞` and `spt X ⊆ B̄_ϱ(x₀)`, fix `ε > 0`, a bump `ζ` with `ζ = 1` on
`B̄_{ϱ+ε/2}(x₀)` and `ζ = 0` off `B_{ϱ+ε}(x₀)`, `α := ω(x₀)` and `φ := ζ (ω - α)`.  Then
`ω - φ = α` on `B_{ϱ+ε/2}(x₀) ⊇ spt X`, so `X(ω - φ) = 0` (a constant form is exact near `spt X`
and `∂X = 0`), while `|φ(x)| = ζ(x) |ω(x) - ω(x₀)| ≤ c (ϱ + ε)`.  Hence
`|X(ω)| = |X(φ)| ≤ c (ϱ + ε) M(X)`, and `ε ↓ 0` gives the claim. -/
theorem Submission.cbrld_cycle_eval_le_radius_mul_mass : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P n : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (n + 1)), ∃ c : ℝ, 0 ≤ c ∧ ∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) (n + 1)) (x₀ : Euclid P) (ϱ : ℝ), 0 < ϱ → X.boundary = 0 → X.mass < ∞ → X.support ⊆ closedBall x₀ ϱ → |X ω| ≤ c * ϱ * X.mass.toReal := by
  intro VO P n ω
  -- the constant depends only on `ω`: a Lipschitz constant in the coefficient norm
  obtain ⟨c, hc0, hc⟩ := Submission.cbrld_cone_testForm_coeff_lipschitz P (n + 1) univ ω
  refine ⟨c, hc0, fun X x₀ ϱ hϱ hbd hM hspt => ?_⟩
  have hsmul := (Submission.rsd_mw_tfa_norm_props P (n + 1)).2.1
  let α : Covector (Euclid P) (n + 1) := (ω : DifferentialForm (Euclid P) (n + 1)) x₀
  -- `|X(ω)| ≤ c (ϱ + ε) M(X)` for every `ε > 0`
  have hbound : ∀ ε : ℝ, 0 < ε → |X ω| ≤ c * (ϱ + ε) * X.mass.toReal := by
    intro ε hε
    -- the cut-off: `ζ = 1` on `B̄_{ϱ+ε/2}(x₀)` and `ζ = 0` off `B_{ϱ+ε}(x₀)`
    let ζ : ContDiffBump x₀ := ⟨ϱ + ε / 2, ϱ + ε, by linarith, by linarith⟩
    -- the test form `φ = ζ (ω - α)`
    let φ : TestFormOn (univ : Set (Euclid P)) (n + 1) :=
      ⟨fun x => ζ x • ((ω : DifferentialForm (Euclid P) (n + 1)) x - α),
        ⟨ζ.contDiff.smul (ContDiff.sub ω.property.1.1 contDiff_const),
          ζ.hasCompactSupport.smul_right⟩, subset_univ _⟩
    -- `ω - φ = α` on `B_{ϱ+ε/2}(x₀) ⊇ spt X`, so the cycle `X` kills `ω - φ`
    have hconst : ∀ x ∈ ball x₀ (ϱ + ε / 2),
        ((ω - φ : TestFormOn (univ : Set (Euclid P)) (n + 1)) :
          DifferentialForm (Euclid P) (n + 1)) x = α := by
      intro x hx
      change (ω : DifferentialForm (Euclid P) (n + 1)) x -
        ζ x • ((ω : DifferentialForm (Euclid P) (n + 1)) x - α) = α
      rw [ζ.one_of_mem_closedBall (ball_subset_closedBall hx), one_smul, sub_sub_cancel]
    have h0 : X (ω - φ) = 0 :=
      Submission.cbrld_cone_cycle_eval_eq_zero_of_const_on_ball VO P n X x₀ (ϱ + ε / 2) α
        (ω - φ) (by linarith) hbd (hspt.trans (closedBall_subset_ball (by linarith))) hconst
    have hXφ : X ω = X φ := by
      have h := map_sub X.toCurrent ω φ
      change X (ω - φ) = X ω - X φ at h
      linarith
    -- `|φ(x)| = ζ(x) |ω(x) - ω(x₀)| ≤ c (ϱ + ε)`
    have hφ : ∀ x, covectorEuclideanNorm ((φ : DifferentialForm (Euclid P) (n + 1)) x) ≤
        c * (ϱ + ε) := by
      intro x
      change covectorEuclideanNorm (ζ x • ((ω : DifferentialForm (Euclid P) (n + 1)) x - α)) ≤
        c * (ϱ + ε)
      rw [hsmul, abs_of_nonneg (ζ.nonneg' x)]
      by_cases hx : dist x x₀ < ϱ + ε
      · calc ζ x * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (n + 1)) x - α)
            ≤ 1 * (c * (ϱ + ε)) :=
              mul_le_mul ζ.le_one ((hc x x₀).trans (mul_le_mul_of_nonneg_left hx.le hc0))
                (covectorEuclideanNorm_nonneg _) zero_le_one
          _ = c * (ϱ + ε) := one_mul _
      · rw [ζ.zero_of_le_dist (not_lt.1 hx), zero_mul]
        exact mul_nonneg hc0 (by linarith)
    rw [hXφ]
    exact Submission.cmr_abs_apply_le_massOn P (n + 1) univ univ X φ (c * (ϱ + ε)) hM.ne
      (subset_univ _) hφ
  -- let `ε ↓ 0`
  have hlim : Tendsto (fun ε : ℝ => c * (ϱ + ε) * X.mass.toReal) (𝓝[>] 0)
      (𝓝 (c * ϱ * X.mass.toReal)) := by
    have h := (show Continuous fun ε : ℝ => c * (ϱ + ε) * X.mass.toReal by fun_prop).tendsto 0
    rw [add_zero] at h
    exact h.mono_left nhdsWithin_le_nhds
  exact ge_of_tendsto hlim (eventually_nhdsWithin_of_forall fun ε hε => hbound ε hε)
/-- **Simon Ch. 1, Remark 3.11(3)** (via the Besicovitch Covering Lemma 3.12), with the balls
chosen inside an open set as in the proof of Theorem 3.13: let `μ` be finite on compact subsets of
`ℝᴾ`, `W` open and `E ⊆ W` (not necessarily measurable).  If every `x ∈ E` admits arbitrarily small
radii `ρ > 0` with `Q x ρ`, then countably many pairwise disjoint closed balls
`B̄_{r(x)}(x) ⊆ W`, `x ∈ t ⊆ E`, with `Q x (r x)`, cover `μ`-almost all of `E`.  Apply the
measurable Besicovitch covering theorem to the admissible radii `{ρ | B̄_ρ(x) ⊆ W ∧ Q x ρ}`. -/
theorem Submission.cbrldvc_exists_disjoint_closedBall_cover : ∀ (P : ℕ) (μ : Measure (Euclid P)) (Q : Euclid P → ℝ → Prop) (E W : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → IsOpen W → E ⊆ W → (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ Q x ρ) → ∃ (t : Set (Euclid P)) (r : Euclid P → ℝ), t.Countable ∧ t ⊆ E ∧ (∀ x ∈ t, 0 < r x ∧ closedBall x (r x) ⊆ W ∧ Q x (r x)) ∧ t.PairwiseDisjoint (fun x => closedBall x (r x)) ∧ μ (E \ ⋃ x ∈ t, closedBall x (r x)) = 0 := by
  intro P μ Q E W hK hW hEW hQ
  -- finite on compacts, hence s-finite on the proper space `ℝᴾ`
  have : IsFiniteMeasureOnCompacts μ := ⟨hK⟩
  -- admissible radii: shrink below the radius `R` of an open ball `B_R(x) ⊆ W`
  have hf : ∀ x ∈ E, ∀ δ > 0, ({ρ | closedBall x ρ ⊆ W ∧ Q x ρ} ∩ Ioo 0 δ).Nonempty := by
    intro x hx δ hδ
    obtain ⟨R, hR, hRW⟩ := Metric.isOpen_iff.1 hW x (hEW hx)
    obtain ⟨ρ, hρ, hρδ, hQρ⟩ := hQ x hx (min δ R) (lt_min hδ hR)
    exact ⟨ρ, ⟨(closedBall_subset_ball (hρδ.trans_le (min_le_right _ _))).trans hRW, hQρ⟩, hρ,
      hρδ.trans_le (min_le_left _ _)⟩
  obtain ⟨t, r, ht, htE, hr, hμ, hdisj⟩ := Besicovitch.exists_disjoint_closedBall_covering_ae μ
    (fun x => {ρ | closedBall x ρ ⊆ W ∧ Q x ρ}) E hf (fun _ => 1) fun _ _ => zero_lt_one
  exact ⟨t, r, ht, htE, fun x hx => ⟨(hr x hx).2.1, (hr x hx).1.1, (hr x hx).1.2⟩, hdisj, hμ⟩
/-- **Summation over disjoint sets** (step 5 of the lower density bound used for Simon 7.2.4):
if `B(x)`, `x ∈ t`, are countably many disjoint measurable sets with `V = ⋃_{x ∈ t} B(x)` of finite
measure, `g` is integrable on `V` and `∫_{B(x)} g dμ ≤ θ μ(B(x))` for every `x ∈ t`, then
`∫_V g dμ ≤ θ μ(V)`.  Reindex by the countable subtype `↥t`; countable additivity gives
`∑ᵢ ∫_{B(i)} g dμ = ∫_V g dμ` and `∑ᵢ μ(B(i)) = μ(V) < ∞`, so the real series `∑ᵢ θ μ(B(i))`
converges to `θ μ(V)`, and the two series compare term by term (no sign condition on `θ`). -/
theorem Submission.cbrldvc_setIntegral_biUnion_le_mul_measure : ∀ (P : ℕ) (μ : Measure (Euclid P)) (g : Euclid P → ℝ) (θ : ℝ) (t : Set (Euclid P)) (B : Euclid P → Set (Euclid P)), t.Countable → (∀ x ∈ t, MeasurableSet (B x)) → t.PairwiseDisjoint B → μ (⋃ x ∈ t, B x) < ∞ → IntegrableOn g (⋃ x ∈ t, B x) μ → (∀ x ∈ t, ∫ y in B x, g y ∂μ ≤ θ * (μ (B x)).toReal) → ∫ y in ⋃ x ∈ t, B x, g y ∂μ ≤ θ * (μ (⋃ x ∈ t, B x)).toReal := by
  intro P μ g θ t B ht hB hd hfin hg hle
  -- reindex `⋃ x ∈ t, B x` as `⋃ i : t, B i` over the countable subtype
  have : Countable t := ht.to_subtype
  have hBi : ∀ i : t, MeasurableSet (B i) := fun i => hB i i.2
  have hdi : Pairwise (Disjoint on fun i : t => B i) :=
    fun i j hij => hd i.2 j.2 (Subtype.coe_injective.ne hij)
  rw [biUnion_eq_iUnion] at hfin hg ⊢
  -- countable additivity of the integral
  have hint : HasSum (fun i : t => ∫ y in B i, g y ∂μ) (∫ y in ⋃ i : t, B i, g y ∂μ) :=
    hasSum_integral_iUnion hBi hdi hg
  -- countable additivity of the measure, read in `ℝ`
  have hμ : μ (⋃ i : t, B i) = ∑' i : t, μ (B i) := measure_iUnion hdi hBi
  have hfin' : ∑' i : t, μ (B i) ≠ ∞ := hμ ▸ hfin.ne
  have hmeas : HasSum (fun i : t => (μ (B i)).toReal) (μ (⋃ i : t, B i)).toReal := by
    rw [hμ, ENNReal.tsum_toReal_eq fun i => ENNReal.ne_top_of_tsum_ne_top hfin' i]
    exact ENNReal.hasSum_toReal hfin'
  -- compare the two series term by term
  exact hasSum_le (fun i : t => hle i i.2) hint (hmeas.mul_left θ)
/-- Complement bound in the covering step of the lower density estimate (cf. Simon Ch. 6, 8.2): if
`|g| ≤ 1` `μ`-a.e., `V ⊆ W` with `V` measurable, `μ W < ∞` and `∫_V g dμ ≤ θ μ(V)`, then
`∫_W g dμ = ∫_{W∖V} g dμ + ∫_V g dμ ≤ (μ(W) − μ(V)) + θ μ(V) = μ(W) − (1 − θ) μ(V)`. -/
theorem Submission.cbrldvc_setIntegral_le_sub_of_subset : ∀ (P : ℕ) (μ : Measure (Euclid P)) (g : Euclid P → ℝ) (θ : ℝ) (V W : Set (Euclid P)), AEStronglyMeasurable g μ → (∀ᵐ x ∂μ, |g x| ≤ 1) → MeasurableSet V → V ⊆ W → μ W < ∞ → ∫ y in V, g y ∂μ ≤ θ * (μ V).toReal → ∫ y in W, g y ∂μ ≤ (μ W).toReal - (1 - θ) * (μ V).toReal := by
  intro P μ g θ V W hg hbd hV hVW hW hθ
  -- `μ V ≤ μ W < ∞` and `μ (W \ V) ≤ μ W < ∞`
  have hVW_le : μ V ≤ μ W := measure_mono hVW
  have hVfin : μ V ≠ ∞ := (hVW_le.trans_lt hW).ne
  have hWVfin : μ (W \ V) ≠ ∞ := ((measure_mono sdiff_subset).trans_lt hW).ne
  -- `|g| ≤ 1` a.e. makes `g` integrable on every set of finite measure
  have hgS : ∀ S : Set (Euclid P), μ S ≠ ∞ → IntegrableOn g S μ := fun S hS =>
    Measure.integrableOn_of_bounded (M := 1) hS hg
      (by filter_upwards [ae_restrict_of_ae hbd] with x hx; rwa [Real.norm_eq_abs])
  have hgV : IntegrableOn g V μ := hgS V hVfin
  have hgWV : IntegrableOn g (W \ V) μ := hgS (W \ V) hWVfin
  -- `∫_W g = ∫_{W∖V} g + ∫_V g`
  have hsplit : ∫ y in W, g y ∂μ = ∫ y in W \ V, g y ∂μ + ∫ y in V, g y ∂μ := by
    conv_lhs => rw [← sdiff_union_of_subset hVW]
    exact setIntegral_union disjoint_sdiff_left hV hgWV hgV
  -- `∫_{W∖V} g ≤ ∫_{W∖V} 1 = μ(W ∖ V)`
  have hcomp : ∫ y in W \ V, g y ∂μ ≤ (μ (W \ V)).toReal := by
    calc ∫ y in W \ V, g y ∂μ ≤ ∫ _ in W \ V, (1 : ℝ) ∂μ :=
          integral_mono_ae hgWV (integrableOn_const hWVfin)
            (by filter_upwards [ae_restrict_of_ae hbd] with x hx; exact (le_abs_self _).trans hx)
      _ = (μ (W \ V)).toReal := by rw [setIntegral_const, smul_eq_mul, mul_one, measureReal_def]
  -- `μ(W ∖ V) = μ(W) − μ(V)`
  have hdiff : (μ (W \ V)).toReal = (μ W).toReal - (μ V).toReal := by
    rw [measure_sdiff hVW hV.nullMeasurableSet hVfin, ENNReal.toReal_sub_of_le hVW_le hW.ne]
  rw [hsplit]
  linarith

/-- **Covering inequality for the set integral of a bounded density** (the covering in the proof
of Simon Ch. 6, 8.2 after (4): pairwise disjoint closed balls covering almost all of the low
density set, with total measure at most `μ(W)`).  Let `μ` be finite on compact subsets of `ℝᴾ`,
`|g| ≤ 1` `μ`-a.e., `θ ≤ 1`, `W` open with `μ(W) < ∞`, and let every point of `E ⊆ W` be the
centre of arbitrarily small closed balls `B̄_ρ(x)` with `∫_{B̄_ρ(x)} g dμ ≤ θ μ(B̄_ρ(x))`.
Besicovitch gives countably many such balls, pairwise disjoint and contained in `W`, whose
union `V` covers `μ`-almost all of `E`.  By countable additivity `∫_V g dμ ≤ θ μ(V)`, and `g ≤ 1`
on `W \ V`, so `∫_W g dμ ≤ μ(W) − (1 − θ) μ(V) ≤ μ(W) − (1 − θ) μ(E)`. -/
theorem Submission.cbrld_vitali_setIntegral_le : ∀ (P : ℕ) (μ : Measure (Euclid P)) (g : Euclid P → ℝ) (θ : ℝ) (E W : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → AEStronglyMeasurable g μ → (∀ᵐ x ∂μ, |g x| ≤ 1) → θ ≤ 1 → IsOpen W → E ⊆ W → μ W < ∞ → (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ ∫ y in closedBall x ρ, g y ∂μ ≤ θ * (μ (closedBall x ρ)).toReal) → ∫ y in W, g y ∂μ ≤ (μ W).toReal - (1 - θ) * (μ E).toReal := by
  intro P μ g θ E W hK hg hg1 hθ hW hEW hWfin hsmall
  -- steps 1–3: countably many pairwise disjoint admissible balls `B̄_{r(x)}(x) ⊆ W`, `x ∈ t`,
  -- covering `μ`-almost all of `E`
  obtain ⟨t, r, htc, -, hr, hdisj, hnull⟩ :=
    Submission.cbrldvc_exists_disjoint_closedBall_cover P μ
      (fun x ρ => ∫ y in closedBall x ρ, g y ∂μ ≤ θ * (μ (closedBall x ρ)).toReal) E W hK hW hEW
      hsmall
  -- step 4: their union `V` is measurable, `V ⊆ W`, `μ(V) < ∞` and `μ(E) ≤ μ(V)`
  have hVmeas : MeasurableSet (⋃ x ∈ t, closedBall x (r x)) :=
    MeasurableSet.biUnion htc fun _ _ => measurableSet_closedBall
  have hVW : ⋃ x ∈ t, closedBall x (r x) ⊆ W := iUnion₂_subset fun x hx => (hr x hx).2.1
  have hVfin : μ (⋃ x ∈ t, closedBall x (r x)) < ∞ := (measure_mono hVW).trans_lt hWfin
  have hEV : μ E ≤ μ (⋃ x ∈ t, closedBall x (r x)) := measure_mono_ae (ae_le_set.2 hnull)
  -- step 5: `∫_V g dμ ≤ θ μ(V)`, summing over the disjoint balls
  have hgV : IntegrableOn g (⋃ x ∈ t, closedBall x (r x)) μ :=
    Measure.integrableOn_of_bounded hVfin.ne hg (M := 1)
      (ae_restrict_of_ae (hg1.mono fun x hx => by rwa [Real.norm_eq_abs]))
  have hV : ∫ y in ⋃ x ∈ t, closedBall x (r x), g y ∂μ ≤
      θ * (μ (⋃ x ∈ t, closedBall x (r x))).toReal :=
    Submission.cbrldvc_setIntegral_biUnion_le_mul_measure P μ g θ t (fun x => closedBall x (r x))
      htc (fun _ _ => measurableSet_closedBall) hdisj hVfin hgV fun x hx => (hr x hx).2.2
  -- steps 6–7: `g ≤ 1` on `W \ V`; then `μ(E) ≤ μ(V)` and `1 − θ ≥ 0`
  calc ∫ y in W, g y ∂μ
      ≤ (μ W).toReal - (1 - θ) * (μ (⋃ x ∈ t, closedBall x (r x))).toReal :=
        Submission.cbrldvc_setIntegral_le_sub_of_subset P μ g θ _ W hg hg1 hVmeas hVW hWfin hV
    _ ≤ (μ W).toReal - (1 - θ) * (μ E).toReal :=
        sub_le_sub_left (mul_le_mul_of_nonneg_left (ENNReal.toReal_mono hVfin.ne hEV)
          (sub_nonneg.2 hθ)) _
/-- **Degree-zero mass gap** (Simon Ch. 6, footnote 5 to 8.2, the case `n = 1`), assuming the
mass representation `(MR)` `M_W(T) = μ_T(W)` for open `U`, `W`: an integer multiplicity
`0`-current `Z` in `ℝᴾ` with `M(Z) < 1` is zero.  If `Z = τ(M, θ, ξ)` and `x ∈ M`, then
`M(Z) = μ_Z(ℝᴾ) ≥ μ_Z({x}) = θ(x) H⁰({x}) = θ(x) ≥ 1`; hence `M = ∅` and every `Z(ω)` is an
integral over `∅`. -/
theorem Submission.cbrld_im_degree_zero_eq_zero_of_mass_lt_one : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ∀ (P : ℕ) (Z : GeometricCurrentOn (univ : Set (Euclid P)) 0), IsIntegerMultiplicity Z → Z.mass < 1 → Z = 0 := by
  rintro hMR P Z ⟨R, hR⟩ hZ
  -- `(MR)` with `U = W = ℝᴾ`: `M(Z) = μ_Z(ℝᴾ)`
  have hmass : Z.mass = R.measure univ := hMR P 0 univ Z R isOpen_univ hR univ isOpen_univ
  -- a point `x ∈ M` would carry `μ_Z({x}) = θ(x) H⁰({x}) = θ(x) ≥ 1 > M(Z)`
  have hempty : R.carrier = ∅ := by
    refine eq_empty_of_forall_notMem fun x hx => ?_
    have hx1 : R.measure {x} = (R.mult x : ℝ≥0∞) := by
      rw [IMRep.measure, withDensity_apply _ (measurableSet_singleton x), lintegral_singleton,
        Measure.restrict_apply (measurableSet_singleton x), singleton_inter_of_mem hx,
        Measure.euclideanHausdorffMeasure_zero, Measure.hausdorffMeasure_zero_singleton, mul_one]
    have h1 : (1 : ℝ≥0∞) ≤ R.measure {x} := hx1 ▸ Nat.one_le_cast.2 (R.mult_pos x hx)
    exact not_le.2 hZ (h1.trans ((measure_mono (subset_univ _)).trans hmass.ge))
  -- every `Z(ω)` is an integral over `M = ∅`
  ext ω
  rw [hR ω, GeometricCurrentOn.zero_apply, IMRep.action, hempty, setIntegral_empty]
/-- **Simon Ch. 6, proof of 8.2, (2)–(4)**, with the lower density in place of `Θ^{*n}`: small
fillings of sphere slices at points of small lower density.  For `n = d + 1` fix `a > 0` (`a = 1/4`
if `n = 1`; for `n = m + 2`, `cbrldlf_exists_filling_constant` for the constant `c` of (ISO)) and
put `η₀ = aⁿ/ωₙ`.  A scale `s ∈ (0, δ)` with `μ(B_s(x₁)) < (as)ⁿ`
(`cbrldlf_exists_small_scale_of_lower_density`) and the null set of
`cbrld_sphere_slice_isIntegerMultiplicity` give a good radius `ρ ∈ (0, s)`
(`cbrld_exists_good_slice_radius`): `A = C⌞B_ρ(x₁)` has an integer multiplicity boundary `Z = ∂A`
with `spt Z ⊆ ∂B_ρ(x₁)` and `M(Z) ≤ 2naF^{(n−1)/n}`, `F = μ(B_ρ(x₁))`.  If `n = 1`, then
`M(Z) ≤ 1/2`, so `Z = 0` (`cbrld_im_degree_zero_eq_zero_of_mass_lt_one`) and `S = 0`; if `n ≥ 2`,
`S` is the filling of `Z` given by (ISO), with `M(S) ≤ F/2` and `spt S` within `3√P·s` of
`∂B_ρ(x₁)`. -/
theorem Submission.cbrld_exists_small_filling_of_low_density : (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P m : ℕ), ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∀ x₁ : Euclid P, liminf (fun r : ℝ => μ (ball x₁ r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0) < ENNReal.ofReal η₀ → ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ μ (sphere x₁ ρ) = 0 ∧ ∃ (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in ball x₁ ρ, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) ∧ S.boundary = A.boundary ∧ S.mass ≤ ENNReal.ofReal (1 / 2) * μ (ball x₁ ρ) ∧ S.support ⊆ closedBall x₁ ((1 + 3 * Real.sqrt P) * δ) := by
  intro hSL hMR hISO P d
  -- Steps 1, 4 and 5: the choice of `a` and the filling of the sphere slice
  suffices H : ∃ a : ℝ, 0 < a ∧ ∀ (x₁ : Euclid P) (δ s ρ F : ℝ)
      (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), 0 < s → ρ < s → s < δ → 0 ≤ F →
      F ≤ (a * s) ^ (d + 1) → IsIntegerMultiplicity A.boundary →
      A.boundary.support ⊆ sphere x₁ ρ →
      A.boundary.mass ≤ ENNReal.ofReal (2 * ((d + 1 : ℕ) : ℝ) * a *
        F ^ ((((d + 1 : ℕ) : ℝ) - 1) / ((d + 1 : ℕ) : ℝ))) →
      ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1), S.boundary = A.boundary ∧
        S.mass ≤ ENNReal.ofReal (F / 2) ∧ S.support ⊆ closedBall x₁ ((1 + 3 * Real.sqrt P) * δ) by
    obtain ⟨a, ha, H⟩ := H
    -- Step 0: `ωₙ > 0`; Step 1: `η₀ = aⁿ/ωₙ`
    obtain ⟨hw, hsmall⟩ := Submission.cbrldlf_exists_small_scale_of_lower_density (d + 1)
    refine ⟨a ^ (d + 1) / (unitBallVolume (d + 1)).toReal, div_pos (pow_pos ha _) hw, ?_⟩
    intro C μ ξ hCb hμ hξm hξb hC hISP x₁ hlim δ hδ
    -- Step 2: a scale `s ∈ (0, δ)` with `μ(B_s(x₁)) < η₀ωₙsⁿ = (as)ⁿ`
    obtain ⟨s, hs, hsδ, hμs⟩ := hsmall P μ x₁ _ δ hδ hlim
    rw [div_mul_cancel₀ _ hw.ne', ← mul_pow] at hμs
    -- Step 3: a good radius `ρ ∈ (0, s)` off the null set of the slices, and `A = C⌞B_ρ(x₁)`
    obtain ⟨N, hN, hslice⟩ :=
      Submission.cbrld_sphere_slice_isIntegerMultiplicity hSL P d C μ ξ x₁ hCb hμ hξm hξb hC hISP
    obtain ⟨ρ, hρ, hρs, hρN, hsph, hlimρ⟩ :=
      Submission.cbrld_exists_good_slice_radius P (d + 1) μ x₁ a s N hμ (by omega) ha hs hμs hN
    obtain ⟨A, hA, hAim, hAspt, hAmass⟩ := hslice ρ hρ hρN
    -- `F = μ(B_ρ(x₁)) ≤ μ(B_s(x₁)) < (as)ⁿ`
    have hμρ : μ (ball x₁ ρ) ≤ μ (ball x₁ s) := measure_mono (ball_subset_ball hρs.le)
    have hμρ_ne : μ (ball x₁ ρ) ≠ ∞ := (hμρ.trans_lt (hμs.trans ENNReal.ofReal_lt_top)).ne
    have hF : (μ (ball x₁ ρ)).toReal ≤ (a * s) ^ (d + 1) :=
      ENNReal.toReal_le_of_le_ofReal (by positivity) (hμρ.trans hμs.le)
    obtain ⟨S, hSb, hSmass, hSspt⟩ := H x₁ δ s ρ (μ (ball x₁ ρ)).toReal A hs hρs hsδ
      ENNReal.toReal_nonneg hF hAim hAspt (hAmass.trans hlimρ)
    -- Step 6
    refine ⟨ρ, hρ, hρs.trans hsδ, hsph, A, S, hA, hSb, ?_, hSspt⟩
    calc S.mass ≤ ENNReal.ofReal ((μ (ball x₁ ρ)).toReal / 2) := hSmass
      _ = ENNReal.ofReal (1 / 2) * μ (ball x₁ ρ) := by
        rw [show (μ (ball x₁ ρ)).toReal / 2 = 1 / 2 * (μ (ball x₁ ρ)).toReal by ring,
          ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 1 / 2), ENNReal.ofReal_toReal hμρ_ne]
  cases d with
  | zero =>
    -- Step 4 (`n = 1`, `a = 1/4`): `M(∂A) ≤ 2a = 1/2 < 1`, so `∂A = 0` and `S = 0`
    refine ⟨1 / 4, by norm_num, fun x₁ δ s ρ F A _ _ _ _ _ hAim _ hAmass => ?_⟩
    have hZ : A.boundary = 0 := by
      refine Submission.cbrld_im_degree_zero_eq_zero_of_mass_lt_one hMR P _ hAim
        (hAmass.trans_lt ?_)
      rw [ENNReal.ofReal_lt_one]
      norm_num
    refine ⟨0, ?_, ?_, ?_⟩
    · rw [hZ]
      exact GeometricCurrentOn.ext fun ω => rfl
    · -- every value of the zero current is `0`
      refine sSup_le ?_
      rintro _ ⟨ω, -, rfl⟩
      simp
    · -- the zero current vanishes on every ball `B₁(y)`
      intro y hy
      exfalso
      apply hy.2
      exact Set.mem_sUnion_of_mem (mem_ball_self one_pos) ⟨isOpen_ball,
        (isCompact_closedBall y 1).of_isClosed_subset isClosed_closure
          closure_ball_subset_closedBall, subset_univ _, fun ω _ => rfl⟩
  | succ m =>
    -- Step 5 (`n = m + 2`): `S` is the filling of `Z = ∂A` given by (ISO)
    obtain ⟨c, hc, hiso⟩ := hISO P m
    obtain ⟨a, ha, hconst⟩ := Submission.cbrldlf_exists_filling_constant m c hc
    refine ⟨a, ha, fun x₁ δ s ρ F A hs hρs hsδ hF0 hF hAim hAspt hAmass => ?_⟩
    -- `∂Z = ∂∂A = 0`, `spt Z` is a closed subset of the sphere `∂B_ρ(x₁)` and `M(Z) < ∞`
    have hZb : A.boundary.boundary = 0 := GeometricCurrentOn.boundary_boundary A
    have hZcpt : IsCompact A.boundary.support := by
      refine (isCompact_sphere x₁ ρ).of_isClosed_subset ?_ hAspt
      rw [GeometricCurrentOn.support, ← Set.compl_eq_univ_sdiff]
      exact A.boundary.isOpen_zeroRegion.isClosed_compl
    obtain ⟨Y, -, hYb, hYmass, hYspt⟩ :=
      hiso A.boundary hAim hZcpt hZb (hAmass.trans_lt ENNReal.ofReal_lt_top)
    -- (a) `M(Y) ≤ F/2` and (b) `(2cM(Z))^{1/(m+1)} ≤ s`
    have hM := ENNReal.toReal_le_of_le_ofReal (by positivity) hAmass
    obtain ⟨hmass, hrad⟩ := hconst s F _ hs.le hF0 hF ENNReal.toReal_nonneg hM
    refine ⟨Y, hYb, hYmass.trans (ENNReal.ofReal_le_ofReal hmass), fun y hy => ?_⟩
    -- `y` lies within `3√P·s` of a point `z` of `spt Z ⊆ ∂B_ρ(x₁)`, and `ρ < s < δ`
    obtain ⟨z, hz, hyz⟩ := Metric.mem_thickening_iff.mp (hYspt hy)
    have hzx : dist z x₁ = ρ := hAspt hz
    have h3 := mul_le_mul_of_nonneg_left (hrad.trans hsδ.le)
      (by positivity : (0 : ℝ) ≤ 3 * Real.sqrt P)
    rw [Metric.mem_closedBall]
    linarith [dist_triangle y z x₁]

/-- **Uniform approximation by test forms** (extension of a current of locally finite mass to
continuous fields, approximating sequences).  Let `|α| = covectorEuclideanNorm α = ‖c α‖` for a
continuous linear equivalence `c` onto a Euclidean space.  A continuous, compactly supported
`n`-covector field `G` with `tsupport G ⊆ V` (`V` open) is uniformly `ε`-approximated in `|·|` by a
test form `ω` with `tsupport ω ⊆ V`.

Since `c` is linear, `|t • α| = |t| |α|`.  The field `c ∘ G` is continuous with compact support,
hence bounded, so `|G| ≤ s` for some `s > 0`.  Mollifying the unit field `g = s⁻¹ • G` with error
`ε / s` (`dor_ims_sua_mollify_unit_field`) gives a test form `ω₀` with `tsupport ω₀ ⊆ V`; then
`ω = s • ω₀` is a test form with `tsupport ω ⊆ V` and `|ω x − G x| = s |ω₀ x − g x| ≤ ε`. -/
theorem Submission.cmr_tfe_uniform_testForm_approx : ∀ (P n d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (V : Set (Euclid P)) (G : Euclid P → Covector (Euclid P) n) (ε : ℝ), (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → IsOpen V → Continuous G → HasCompactSupport G → tsupport G ⊆ V → 0 < ε → ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧ ∀ x, covectorEuclideanNorm (ω x - G x) ≤ ε := by
  intro P n d c V G ε hc hV hG hGs hGV hε
  -- (1) homogeneity: `|t • α| = ‖c (t • α)‖ = |t| ‖c α‖ = |t| |α|`
  have hsm : ∀ (t : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := fun t α => by
    rw [hc, hc, map_smul, norm_smul, Real.norm_eq_abs]
  -- (2) `c ∘ G` is continuous with compact support, so `|G| ≤ s` for some `s > 0`
  obtain ⟨C, hC⟩ := (hGs.comp_left (map_zero c)).exists_bound_of_continuous (c.continuous.comp hG)
  obtain ⟨s, hs, hGs'⟩ : ∃ s : ℝ, 0 < s ∧ ∀ x, covectorEuclideanNorm (G x) ≤ s :=
    ⟨max C 0 + 1, by positivity, fun x => by
      rw [hc]
      exact (hC x).trans ((le_max_left C 0).trans (le_add_of_nonneg_right zero_le_one))⟩
  -- (3) the normalized field `g = s⁻¹ • G` has `|g| ≤ 1`
  have hg1 : ∀ x, covectorEuclideanNorm (s⁻¹ • G x) ≤ 1 := fun x => by
    rw [hsm, abs_of_pos (inv_pos.mpr hs), inv_mul_le_iff₀ hs, mul_one]
    exact hGs' x
  -- (4) mollify `g` with error `ε / s`
  obtain ⟨ω₀, hω₀, hω₀V, -, hω₀g⟩ := Submission.dor_ims_sua_mollify_unit_field P n V
    (s⁻¹ • G) (ε / s) hV (hG.const_smul s⁻¹) (hGs.comp_left (smul_zero s⁻¹))
    ((tsupport_smul_subset_right (fun _ => s⁻¹) G).trans hGV) hg1 (div_pos hε hs)
  -- (5) `ω = s • ω₀` is a test form with `tsupport ω ⊆ V`
  refine ⟨s • ω₀, (testFormSubmodule n).smul_mem s hω₀,
    (tsupport_smul_subset_right (fun _ => s) ω₀).trans hω₀V, fun x => ?_⟩
  -- (6) `ω x - G x = s • (ω₀ x - g x)`, so `|ω x - G x| = s |ω₀ x - g x| ≤ s (ε / s) = ε`
  have hω : (s • ω₀) x - G x = s • (ω₀ x - s⁻¹ • G x) := by
    rw [Pi.smul_apply, smul_sub, smul_inv_smul₀ hs.ne']
  rw [hω, hsm, abs_of_pos hs]
  exact (le_div_iff₀' hs).mp (hω₀g x)
/-- **Limit functional along uniformly convergent test forms** (test-form extension, steps 4–5).
Let `|α| = ‖c α‖` for a continuous linear equivalence `c`, and let `|T ω| ≤ r m(W)` whenever
`W ⊂⊂ U` is open, `spt ω ⊆ W` and `|ω(x)| ≤ r` for all `x`.  Then there is `Φ` with
`T(ωₖ) → Φ(G)` whenever `spt ωₖ ⊆ W` for one open `W ⊂⊂ U` and all `k`, and
`|ωₖ(x) − G(x)| ≤ εₖ` for all `k`, `x`, with `εₖ → 0`.

For two such data `(W, ωₖ, εₖ)`, `(W', ω'ₗ, ε'ₗ)` of the same `G`, `ωₖ − ω'ₗ` is a test form with
`spt ⊆ W ∪ W' ⊂⊂ U` and `|ωₖ − ω'ₗ| ≤ εₖ + ε'ₗ`, so `|T(ωₖ) − T(ω'ₗ)| ≤ (εₖ + ε'ₗ) m(W ∪ W')`.
With equal data, `(T(ωₖ))` is Cauchy, hence convergent.  `Φ(G)` is the limit along chosen data
(`0` if there are none), and the estimate with `l = k` shows that every approximating sequence
of `G` tends to `Φ(G)`. -/
theorem Submission.cmr_tfe_exists_limit_functional : ∀ (P n d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (m : Set (Euclid P) → ℝ), (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → (∀ (W : Set (Euclid P)) (ω : TestFormOn U n) (r : ℝ), IsOpen W → CompactlyContained W U → tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ r) → |T ω| ≤ r * m W) → ∃ Φ : (Euclid P → Covector (Euclid P) n) → ℝ, ∀ (G : Euclid P → Covector (Euclid P) n) (W : Set (Euclid P)) (ωs : ℕ → TestFormOn U n) (εs : ℕ → ℝ), IsOpen W → CompactlyContained W U → (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) → (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) → Tendsto εs atTop (𝓝 0) → Tendsto (fun k => T (ωs k)) atTop (𝓝 (Φ G)) := by
  intro P n d c U T m hc hm
  classical
  -- (1) `|α − β| ≤ |α| + |β|`, since `|·| = ‖c ·‖` with `c` linear
  have htri : ∀ α β : Covector (Euclid P) n,
      covectorEuclideanNorm (α - β) ≤ covectorEuclideanNorm α + covectorEuclideanNorm β := by
    intro α β
    rw [hc, hc, hc, map_sub]
    exact norm_sub_le _ _
  -- (2)–(3) the key estimate for two approximating data of the same `G`
  have hkey : ∀ (G : Euclid P → Covector (Euclid P) n) (W W' : Set (Euclid P))
      (ωs ωs' : ℕ → TestFormOn U n) (εs εs' : ℕ → ℝ), IsOpen W → CompactlyContained W U →
      (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) →
      (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) →
      IsOpen W' → CompactlyContained W' U →
      (∀ k, tsupport (ωs' k : DifferentialForm (Euclid P) n) ⊆ W') →
      (∀ k x, covectorEuclideanNorm ((ωs' k : DifferentialForm (Euclid P) n) x - G x) ≤ εs' k) →
      ∀ k l, |T (ωs k) - T (ωs' l)| ≤ (εs k + εs' l) * m (W ∪ W') := by
    intro G W W' ωs ωs' εs εs' hW hWU hωW hωG hW' hW'U hω'W hω'G k l
    -- `W ∪ W'` is open and `W ∪ W' ⊂⊂ U`
    have hWW'U : CompactlyContained (W ∪ W') U := by
      rw [CompactlyContained, closure_union]
      exact ⟨hWU.1.union hW'U.1, union_subset hWU.2 hW'U.2⟩
    -- the bound for `δ = ωs k − ωs' l`, and `T δ = T (ωs k) − T (ωs' l)` by linearity
    have h := hm (W ∪ W') (ωs k - ωs' l) (εs k + εs' l) (hW.union hW') hWW'U ?_ ?_
    · rwa [map_sub T.toCurrent] at h
    · rw [Submodule.coe_sub]
      exact (tsupport_sub _ _).trans (union_subset_union (hωW k) (hω'W l))
    · intro x
      rw [Submodule.coe_sub, Pi.sub_apply,
        ← sub_sub_sub_cancel_right ((ωs k : DifferentialForm (Euclid P) n) x) _ (G x)]
      exact (htri _ _).trans (add_le_add (hωG k x) (hω'G l x))
  -- (4) along approximating data, `(T (ωs k))` is Cauchy, hence convergent
  have hconv : ∀ (G : Euclid P → Covector (Euclid P) n) (W : Set (Euclid P))
      (ωs : ℕ → TestFormOn U n) (εs : ℕ → ℝ), IsOpen W → CompactlyContained W U →
      (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) →
      (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) →
      Tendsto εs atTop (𝓝 0) → ∃ L, Tendsto (fun k => T (ωs k)) atTop (𝓝 L) := by
    intro G W ωs εs hW hWU hωW hωG hε
    refine cauchySeq_tendsto_of_complete (cauchySeq_iff_tendsto_dist_atTop_0.mpr ?_)
    have h0 := ((hε.comp tendsto_fst).add (hε.comp tendsto_snd)).mul_const (m (W ∪ W))
    rw [add_zero, zero_mul, prod_atTop_atTop_eq] at h0
    refine squeeze_zero (fun _ => dist_nonneg) (fun p => ?_) h0
    rw [Real.dist_eq]
    exact hkey G W W ωs ωs εs εs hW hWU hωW hωG hW hWU hωW hωG p.1 p.2
  -- (5) `Φ G` is the limit along chosen approximating data of `G` (`0` if there are none)
  refine ⟨fun G => if h : ∃ (L : ℝ) (W : Set (Euclid P)) (ωs : ℕ → TestFormOn U n)
      (εs : ℕ → ℝ), IsOpen W ∧ CompactlyContained W U ∧
      (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) ∧
      (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) ∧
      Tendsto εs atTop (𝓝 0) ∧ Tendsto (fun k => T (ωs k)) atTop (𝓝 L) then h.choose else 0, ?_⟩
  -- (6) every approximating sequence of `G` tends to `Φ G`
  intro G W ωs εs hW hWU hωW hωG hε
  obtain ⟨L, hL⟩ := hconv G W ωs εs hW hWU hωW hωG hε
  have h : ∃ (L : ℝ) (W : Set (Euclid P)) (ωs : ℕ → TestFormOn U n) (εs : ℕ → ℝ),
      IsOpen W ∧ CompactlyContained W U ∧
      (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) ∧
      (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) ∧
      Tendsto εs atTop (𝓝 0) ∧ Tendsto (fun k => T (ωs k)) atTop (𝓝 L) :=
    ⟨L, W, ωs, εs, hW, hWU, hωW, hωG, hε, hL⟩
  dsimp only
  rw [dite_eq_left h]
  obtain ⟨W', ωs', εs', hW', hW'U, hω'W, hω'G, hε', hL'⟩ := h.choose_spec
  have h0 := (hε.add hε').mul_const (m (W ∪ W'))
  rw [add_zero, zero_mul] at h0
  have hdiff : Tendsto (fun k => T (ωs k) - T (ωs' k)) atTop (𝓝 0) :=
    squeeze_zero_norm (fun k => (Real.norm_eq_abs _).trans_le
      (hkey G W W' ωs ωs' εs εs' hW hWU hωW hωG hW' hW'U hω'W hω'G k k)) h0
  have hlim := hL'.add hdiff
  rw [add_zero] at hlim
  exact hlim.congr fun k => add_sub_cancel _ _

/-- **Extending a locally bounded current to continuous covector fields.**  Let `|α| = ‖c α‖` for
a continuous linear equivalence `c` onto `ℝᵈ`, and let `m` bound `T` locally: `|T(ω)| ≤ r m(W)`
whenever `W ⊂⊂ U` is open, `spt ω ⊆ W` and `|ω| ≤ r`.  Take `Φ` with `T(ωₖ) → Φ(G)` along test
forms `ωₖ` supported in one open `W ⊂⊂ U` with `|ωₖ − G| ≤ εₖ → 0`
(`cmr_tfe_exists_limit_functional`).  A compact subset of `U` lies in an open `W ⊂⊂ U`, and a
continuous `G` with compact support in `W` has such approximants with `εₖ = 1/(k+1)`
(`cmr_tfe_uniform_testForm_approx`).  Sums and multiples of approximants approximate `G₁ + G₂`
(in `W₁ ∪ W₂`) and `t G`, so additivity and homogeneity follow from the linearity of `T` and
uniqueness of limits; the constant sequence `ω` gives `Φ(ω) = T(ω)`; and `|ωₖ| ≤ r + 1/(k+1)`
gives `|T(ωₖ)| ≤ (r + 1/(k+1)) m(W)`, whence `|Φ(G)| ≤ r m(W)`. -/
theorem Submission.cmr_tfe_ambient_extension : ∀ (P n d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (m : Set (Euclid P) → ℝ), IsOpen U → (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → (∀ (W : Set (Euclid P)) (ω : TestFormOn U n) (r : ℝ), IsOpen W → CompactlyContained W U → tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ r) → |T ω| ≤ r * m W) → ∃ Φ : (Euclid P → Covector (Euclid P) n) → ℝ, (∀ G₁ G₂ : Euclid P → Covector (Euclid P) n, Continuous G₁ → HasCompactSupport G₁ → tsupport G₁ ⊆ U → Continuous G₂ → HasCompactSupport G₂ → tsupport G₂ ⊆ U → Φ (G₁ + G₂) = Φ G₁ + Φ G₂) ∧ (∀ (t : ℝ) (G : Euclid P → Covector (Euclid P) n), Continuous G → HasCompactSupport G → tsupport G ⊆ U → Φ (t • G) = t * Φ G) ∧ (∀ ω : TestFormOn U n, Φ (ω : DifferentialForm (Euclid P) n) = T ω) ∧ ∀ (W : Set (Euclid P)) (G : Euclid P → Covector (Euclid P) n) (r : ℝ), IsOpen W → CompactlyContained W U → Continuous G → HasCompactSupport G → tsupport G ⊆ W → (∀ x, covectorEuclideanNorm (G x) ≤ r) → |Φ G| ≤ r * m W := by
  intro P n d c U T m hU hc hm
  -- (1) the limit functional `Φ`
  obtain ⟨Φ, hΦ⟩ := Submission.cmr_tfe_exists_limit_functional P n d c U T m hc hm
  -- `|α + β| ≤ |α| + |β|` and `|t • α| = |t| |α|`, read through `c`
  have hadd : ∀ α β : Covector (Euclid P) n,
      covectorEuclideanNorm (α + β) ≤ covectorEuclideanNorm α + covectorEuclideanNorm β := by
    intro α β
    rw [hc, hc, hc, map_add]
    exact norm_add_le _ _
  have hsmul : ∀ (t : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := by
    intro t α
    rw [hc, hc, map_smul, norm_smul, Real.norm_eq_abs]
  -- (2) a compact subset of `U` lies in an open `W ⊂⊂ U`; and `W ⊂⊂ U` gives `W ⊆ U`
  have hnbhd : ∀ S : Set (Euclid P), IsCompact S → S ⊆ U →
      ∃ W, IsOpen W ∧ S ⊆ W ∧ CompactlyContained W U := by
    intro S hS hSU
    obtain ⟨W, hWo, hSW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hS hU hSU
    exact ⟨W, hWo, hSW, hWc, hWU⟩
  have hsub : ∀ W, CompactlyContained W U → W ⊆ U := fun W hW => subset_closure.trans hW.2
  -- (3) approximants `ωₖ ∈ 𝒟ⁿ(U)` with `spt ωₖ ⊆ W` and `|ωₖ − G| ≤ 1/(k+1)`
  have happrox : ∀ (W : Set (Euclid P)) (G : Euclid P → Covector (Euclid P) n), IsOpen W →
      CompactlyContained W U → Continuous G → HasCompactSupport G → tsupport G ⊆ W →
      ∃ ωs : ℕ → TestFormOn U n, (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) ∧
        ∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤
          1 / ((k : ℝ) + 1) := by
    intro W G hW hWU hG hGc hGW
    have hk : ∀ k : ℕ, ∃ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W ∧
        ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x - G x) ≤
          1 / ((k : ℝ) + 1) := by
      intro k
      obtain ⟨ω, hωt, hωW, hωe⟩ := Submission.cmr_tfe_uniform_testForm_approx P n d c
        W G (1 / ((k : ℝ) + 1)) hc hW hG hGc hGW (by positivity)
      exact ⟨⟨ω, hωt, hωW.trans (hsub W hWU)⟩, hωW, hωe⟩
    choose ωs hωW hωe using hk
    exact ⟨ωs, hωW, hωe⟩
  have hlim : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  refine ⟨Φ, ?_, ?_, ?_, ?_⟩
  · -- (4) additivity: `ω¹ₖ + ω²ₖ` approximates `G₁ + G₂` in `W₁ ∪ W₂ ⊂⊂ U`
    intro G₁ G₂ hG₁ hG₁c hG₁U hG₂ hG₂c hG₂U
    obtain ⟨W₁, hW₁o, hG₁W₁, hW₁U⟩ := hnbhd _ hG₁c hG₁U
    obtain ⟨W₂, hW₂o, hG₂W₂, hW₂U⟩ := hnbhd _ hG₂c hG₂U
    obtain ⟨ω₁, hω₁W, hω₁e⟩ := happrox W₁ G₁ hW₁o hW₁U hG₁ hG₁c hG₁W₁
    obtain ⟨ω₂, hω₂W, hω₂e⟩ := happrox W₂ G₂ hW₂o hW₂U hG₂ hG₂c hG₂W₂
    have hWU : CompactlyContained (W₁ ∪ W₂) U := by
      refine ⟨?_, ?_⟩ <;> rw [closure_union]
      exacts [hW₁U.1.union hW₂U.1, union_subset hW₁U.2 hW₂U.2]
    have h := hΦ (G₁ + G₂) (W₁ ∪ W₂) (fun k => ω₁ k + ω₂ k)
      (fun k => 1 / ((k : ℝ) + 1) + 1 / ((k : ℝ) + 1)) (hW₁o.union hW₂o) hWU
      (fun k => by
        simp only [Submodule.coe_add]
        exact (tsupport_add _ _).trans (union_subset_union (hω₁W k) (hω₂W k)))
      (fun k x => by
        simp only [Submodule.coe_add, Pi.add_apply]
        rw [add_sub_add_comm]
        exact (hadd _ _).trans (add_le_add (hω₁e k x) (hω₂e k x)))
      (by simpa only [add_zero] using hlim.add hlim)
    have h' : Tendsto (fun k => T (ω₁ k + ω₂ k)) atTop (𝓝 (Φ G₁ + Φ G₂)) :=
      ((hΦ G₁ W₁ ω₁ _ hW₁o hW₁U hω₁W hω₁e hlim).add
        (hΦ G₂ W₂ ω₂ _ hW₂o hW₂U hω₂W hω₂e hlim)).congr fun k =>
          (T.toCurrent.map_add (ω₁ k) (ω₂ k)).symm
    exact tendsto_nhds_unique h h'
  · -- (5) homogeneity: `t ωₖ` approximates `t G` with errors `|t|/(k+1)`
    intro t G hG hGc hGU
    obtain ⟨W, hWo, hGW, hWU⟩ := hnbhd _ hGc hGU
    obtain ⟨ωs, hωW, hωe⟩ := happrox W G hWo hWU hG hGc hGW
    have h := hΦ (t • G) W (fun k => t • ωs k) (fun k => |t| * (1 / ((k : ℝ) + 1))) hWo hWU
      (fun k => by
        simp only [Submodule.coe_smul]
        exact (tsupport_smul_subset_right (fun _ => t) _).trans (hωW k))
      (fun k x => by
        simp only [Submodule.coe_smul, Pi.smul_apply]
        have e : t • (ωs k : DifferentialForm (Euclid P) n) x - t • G x =
            t • ((ωs k : DifferentialForm (Euclid P) n) x - G x) := (smul_sub t _ _).symm
        rw [e, hsmul]
        exact mul_le_mul_of_nonneg_left (hωe k x) (abs_nonneg t))
      (by simpa only [mul_zero] using hlim.const_mul |t|)
    have h' : Tendsto (fun k => T (t • ωs k)) atTop (𝓝 (t * Φ G)) :=
      ((hΦ G W ωs _ hWo hWU hωW hωe hlim).const_mul t).congr fun k => by
        rw [T.toCurrent.map_smul, smul_eq_mul]
    exact tendsto_nhds_unique h h'
  · -- (6) agreement: the constant sequence `ω`, with errors `0`
    intro ω
    obtain ⟨W, hWo, hωW, hWU⟩ := hnbhd _ ω.property.1.2 ω.property.2
    exact tendsto_nhds_unique (hΦ (ω : DifferentialForm (Euclid P) n) W (fun _ => ω) (fun _ => 0)
      hWo hWU (fun _ => hωW) (fun _ x => by simp) tendsto_const_nhds) tendsto_const_nhds
  · -- (7) bound: `|ωₖ| ≤ r + 1/(k+1)`, so `|T(ωₖ)| ≤ (r + 1/(k+1)) m(W)`; let `k → ∞`
    intro W G r hWo hWU hG hGc hGW hr
    obtain ⟨ωs, hωW, hωe⟩ := happrox W G hWo hWU hG hGc hGW
    have hb : ∀ k : ℕ, |T (ωs k)| ≤ (r + 1 / ((k : ℝ) + 1)) * m W := by
      intro k
      refine hm W (ωs k) _ hWo hWU (hωW k) fun x => ?_
      calc covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x)
          = covectorEuclideanNorm (((ωs k : DifferentialForm (Euclid P) n) x - G x) + G x) := by
            rw [sub_add_cancel]
        _ ≤ 1 / ((k : ℝ) + 1) + r := (hadd _ _).trans (add_le_add (hωe k x) (hr x))
        _ = r + 1 / ((k : ℝ) + 1) := add_comm _ _
    have hmW : Tendsto (fun k : ℕ => (r + 1 / ((k : ℝ) + 1)) * m W) atTop (𝓝 (r * m W)) := by
      simpa only [add_zero] using ((tendsto_const_nhds (x := r)).add hlim).mul_const (m W)
    exact le_of_tendsto_of_tendsto' (hΦ G W ωs _ hWo hWU hωW hωe hlim).abs hmW hb
/-- **Simon 6.1.2, 6.1.5, 6.1.15** (the coefficient norm is Euclidean): `n`-covectors on `ℝᴾ`
with `|α|_E = (Σ_I α(e_I)²)^{1/2}`, `I` strictly increasing, form a Euclidean space `ℝᵈ`.  The
coefficient map `A α = (α(e_I))_I` (zero off the increasing `I`) into `ℝ^{Fin n → Fin P}` has
`‖A α‖ = |α|_E`, and it is injective by the Gram bound `|α v| ≤ |α|_E · det(⟨vᵢ, vⱼ⟩)^{1/2}`.
An orthonormal basis of `range A` identifies it isometrically with `ℝᵈ`; then covectors are
finite-dimensional, so this linear equivalence is continuous. -/
theorem Submission.cmr_covector_euclidean_equiv : ∀ (P n : ℕ), ∃ (d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)), ∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖ := by
  intro P n
  -- the coefficient map `A α = (α(e_I))_I`, zero off the strictly increasing `I`
  let A : Covector (Euclid P) n →ₗ[ℝ] EuclideanSpace ℝ (Fin n → Fin P) :=
    { toFun := fun α => WithLp.toLp 2 (fun I => if StrictMono I then
        α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i)) else 0)
      map_add' := fun α β => by
        ext I
        simp only [PiLp.add_apply, ContinuousAlternatingMap.add_apply]
        split_ifs <;> simp
      map_smul' := fun t α => by
        ext I
        simp only [PiLp.smul_apply, ContinuousAlternatingMap.smul_apply, RingHom.id_apply,
          smul_eq_mul]
        split_ifs <;> simp }
  -- `‖A α‖ = |α|_E`
  have hnorm : ∀ α, ‖A α‖ = covectorEuclideanNorm α := by
    intro α
    rw [EuclideanSpace.norm_eq]
    unfold covectorEuclideanNorm
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    simp only [A, LinearMap.coe_mk, AddHom.coe_mk, PiLp.toLp_apply, Real.norm_eq_abs, sq_abs]
    split_ifs <;> simp
  -- `A` is injective: `|α|_E = 0` forces `α v = 0` by the Gram bound
  have hinj : Function.Injective A := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro α hα
    have h0 : covectorEuclideanNorm α = 0 := by rw [← hnorm, hα, norm_zero]
    ext v
    have hv := (Submission.covectorEuclideanNorm_gram_bounds P n).1 α v
    rw [h0, zero_mul] at hv
    simpa using abs_nonpos_iff.mp hv
  -- identify `range A` isometrically with `ℝᵈ` through an orthonormal basis
  let S := LinearMap.range A
  let b := stdOrthonormalBasis ℝ S
  let e₀ : Covector (Euclid P) n ≃ₗ[ℝ] S := LinearEquiv.ofInjective A hinj
  let c₀ : Covector (Euclid P) n ≃ₗ[ℝ] EuclideanSpace ℝ (Fin (Module.finrank ℝ S)) :=
    e₀.trans b.repr.toLinearEquiv
  have hc₀ : ∀ α, ‖c₀ α‖ = covectorEuclideanNorm α := by
    intro α
    have h1 : c₀ α = b.repr (e₀ α) := rfl
    rw [h1, LinearIsometryEquiv.norm_map, ← Submodule.norm_coe, LinearEquiv.ofInjective_apply,
      hnorm]
  -- covectors are finite-dimensional, so `c₀` is continuous
  have : FiniteDimensional ℝ (Covector (Euclid P) n) := LinearEquiv.finiteDimensional c₀.symm
  refine ⟨Module.finrank ℝ S, c₀.toContinuousLinearEquiv, fun α => ?_⟩
  rw [LinearEquiv.coe_toContinuousLinearEquiv', hc₀]
/-- **Simon 6.1.1–1.2** (coordinate covectors): (a) for every `I` the coordinate covector
`dx^I(v) = det(v_j(I k))_{k,j}` exists; (b) an `n`-vector vanishing on `dx^I` for every strictly
increasing `I` vanishes.  Every `n`-covector expands as `α = Σ_I α(e_I) dx^I` over strictly
increasing `I`: by `dx^I(e_J) = δ_IJ` the remainder vanishes on every `e_J`, so its coefficient
norm `|·|_E` is `0`, and `|·|_E` is the norm of a linear isomorphism onto `ℝᵈ`. -/
theorem Submission.cmr_coordinate_covectors_span : ∀ (P n : ℕ), (∀ I : Fin n → Fin P, ∃ θ : Covector (Euclid P) n, ∀ v : Fin n → Euclid P, θ v = Matrix.det (Matrix.of fun k j => v j (I k))) ∧ ∀ ζ : MultiVector P n, (∀ (I : Fin n → Fin P) (θ : Covector (Euclid P) n), StrictMono I → (∀ v : Fin n → Euclid P, θ v = Matrix.det (Matrix.of fun k j => v j (I k))) → ζ θ = 0) → ζ = 0 := by
  intro P n
  refine ⟨Submission.cmr_cc_det_covector_exists P n, fun ζ hζ => ?_⟩
  classical
  -- `θ I = dx^I` for every `I`
  choose θ hθ using Submission.cmr_cc_det_covector_exists P n
  -- `dx^I(e_J) = δ_IJ` for strictly increasing `I`, `J`
  have hδ : ∀ I J : Fin n → Fin P, StrictMono I → StrictMono J →
      θ I (fun j => EuclideanSpace.basisFun (Fin P) ℝ (J j)) = if I = J then 1 else 0 :=
    fun I J hI hJ => Submission.cmr_cc_det_covector_basis_kronecker P n I J (θ I) hI hJ (hθ I)
  -- `α = Σ_I α(e_I) dx^I` over strictly increasing `I`
  have hexp : ∀ α : Covector (Euclid P) n, α = ∑ I : Fin n → Fin P,
      if StrictMono I then α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i)) • θ I
      else 0 := by
    intro α
    obtain ⟨α', hα'⟩ : ∃ α', α' = α - ∑ I : Fin n → Fin P,
        if StrictMono I then α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i)) • θ I
        else 0 := ⟨_, rfl⟩
    -- `α'(e_J) = α(e_J) - Σ_I α(e_I) δ_IJ = 0` for strictly increasing `J`
    have hJ : ∀ J : Fin n → Fin P, StrictMono J →
        α' (fun j => EuclideanSpace.basisFun (Fin P) ℝ (J j)) = 0 := by
      intro J hJ
      rw [hα', ContinuousAlternatingMap.sub_apply, ContinuousAlternatingMap.sum_apply,
        Finset.sum_eq_single J, ite_eq_left hJ, ContinuousAlternatingMap.smul_apply,
        hδ J J hJ hJ, ite_eq_left rfl, smul_eq_mul, mul_one, sub_self]
      · intro I _ hIJ
        split_ifs with hI
        · rw [ContinuousAlternatingMap.smul_apply, hδ I J hI hJ, ite_eq_right hIJ, smul_zero]
        · rfl
      · intro h
        exact absurd (Finset.mem_univ J) h
    -- so `|α'|_E = 0`, and `α' = 0` as `|·|_E` is the norm of a linear isomorphism onto `ℝᵈ`
    have hnorm : covectorEuclideanNorm α' = 0 := by
      unfold covectorEuclideanNorm
      rw [Finset.sum_eq_zero fun I _ => ?_, Real.sqrt_zero]
      split_ifs with hI
      · rw [hJ I hI, sq, mul_zero]
      · rfl
    obtain ⟨d, c, hc⟩ := Submission.cmr_covector_euclidean_equiv P n
    have hc0 : c α' = 0 := norm_eq_zero.mp ((hc α').symm.trans hnorm)
    rw [c.map_eq_zero_iff, hα'] at hc0
    exact sub_eq_zero.mp hc0
  -- `ζ` vanishes on every `dx^I`, hence on every covector
  refine ContinuousLinearMap.ext fun α => ?_
  rw [zero_apply, hexp α, map_sum]
  refine Finset.sum_eq_zero fun I _ => ?_
  split_ifs with hI
  · rw [map_smul, hζ I (θ I) hI (hθ I), smul_zero]
  · exact map_zero ζ
/-- **Extension of a current of locally finite mass to `C_c(U, ℝᵈ)`** (Simon Ch. 6, the remark
after 2.6 applying the Riesz representation theorem, Ch. 1, 4.14).  By hypothesis
`M_W(T) < ∞` for open `W ⊂⊂ U`, so `cmr_abs_apply_le_massOn` gives `|T(ω)| ≤ r M_W(T)` when
`spt ω ⊆ W` and `|ω| ≤ r`.  Hence `cmr_tfe_ambient_extension` extends `T` to a functional `Φ` on
continuous compactly supported covector fields in `U`, additive and homogeneous on them, with
`|Φ(G)| ≤ r M_W(T)` when `spt G ⊆ W` and `|G| ≤ r`.  For `g ∈ C_c(U, ℝᵈ)` let `g̃ = c⁻¹ ∘ g` on
`U` and `g̃ = 0` off `U` (`Function.extend`).  Then `g̃` is continuous with compact support,
`spt g̃ ⊆ spt g ⊆ U`, and `g ↦ g̃` is linear, so `L(g) = Φ(g̃)` is linear.  If `g = c ∘ ω` on `U`,
then `g̃ = ω`, so `L(g) = T(ω)`.  If `spt g ⊆ K` and `‖g‖ ≤ 1`, then `|g̃| = ‖c g̃‖ ≤ 1` and
`spt g̃ ⊆ W` for a fixed open `W ⊂⊂ U` containing `K`, so `|L(g)| ≤ M_W(T)`. -/
theorem Submission.cmr_testForm_extension_functional : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → (∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖) → ∃ L : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ, (∀ (ω : TestFormOn U n) (g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d))), (∀ x : U, g x = c ((ω : DifferentialForm (Euclid P) n) x)) → L g = T ω) ∧ ∀ K : Set U, IsCompact K → ∃ M : ℝ, ∀ g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)), tsupport g ⊆ K → (∀ x, ‖g x‖ ≤ 1) → |L g| ≤ M := by
  intro P n U T d c hU hfin hc
  -- (1) `Φ`, for the local mass bound `m W = M_W(T)` (finite for open `W ⊂⊂ U`)
  obtain ⟨Φ, hΦadd, hΦsmul, hΦT, hΦle⟩ := Submission.cmr_tfe_ambient_extension P n d c U T
    (fun W => (T.massOn W).toReal) hU hc fun W ω r hW hWU hωW hωr =>
      Submission.cmr_abs_apply_le_massOn P n U W T ω r (hfin W hW hWU).ne hωW hωr
  -- (2) the zero extension `g̃`: `c⁻¹ ∘ g` on `U`, `0` off `U`
  let G : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)) →
      Euclid P → Covector (Euclid P) n := fun g =>
    Function.extend Subtype.val (fun x : U => c.symm (g x)) 0
  have hGU : ∀ g (x : U), G g x = c.symm (g x) := fun g x =>
    Subtype.val_injective.extend_apply _ _ x
  have hGnU : ∀ g (y : Euclid P), y ∉ U → G g y = 0 := fun g y hy =>
    Function.extend_apply' _ _ y fun ⟨x, hx⟩ => hy (hx ▸ x.2)
  have hgc : ∀ g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)),
      HasCompactSupport fun x : U => c.symm (g x) := fun g =>
    g.hasCompactSupport.comp_left (map_zero c.symm)
  have hGcont : ∀ g, Continuous (G g) := fun g =>
    HasCompactSupport.continuous_extend_zero hU (c.symm.continuous.comp g.continuous) (hgc g)
  have hGcs : ∀ g, HasCompactSupport (G g) := fun g =>
    (hgc g).extend_zero continuous_subtype_val
  have hGsupp : ∀ g, tsupport (G g) ⊆ Subtype.val '' tsupport g := fun g =>
    ((hgc g).tsupport_extend_zero_subset continuous_subtype_val).trans
      (image_mono (tsupport_comp_subset (map_zero c.symm) g))
  have hGsU : ∀ g, tsupport (G g) ⊆ U := fun g =>
    (hGsupp g).trans (Subtype.coe_image_subset U _)
  have hGadd : ∀ g₁ g₂, G (g₁ + g₂) = G g₁ + G g₂ := by
    intro g₁ g₂
    funext y
    by_cases hy : y ∈ U
    · obtain ⟨x, rfl⟩ : ∃ x : U, (x : Euclid P) = y := ⟨⟨y, hy⟩, rfl⟩
      rw [Pi.add_apply, hGU, hGU, hGU, CompactlySupportedContinuousMap.add_apply, map_add]
    · rw [Pi.add_apply, hGnU _ y hy, hGnU _ y hy, hGnU _ y hy, add_zero]
  have hGsmul : ∀ (t : ℝ) g, G (t • g) = t • G g := by
    intro t g
    funext y
    by_cases hy : y ∈ U
    · obtain ⟨x, rfl⟩ : ∃ x : U, (x : Euclid P) = y := ⟨⟨y, hy⟩, rfl⟩
      rw [Pi.smul_apply, hGU, hGU, CompactlySupportedContinuousMap.smul_apply, map_smul]
    · rw [Pi.smul_apply, hGnU _ y hy, hGnU _ y hy, smul_zero]
  -- (3) `L g = Φ g̃` is linear
  refine ⟨{ toFun := fun g => Φ (G g)
            map_add' := fun g₁ g₂ => by
              show Φ (G (g₁ + g₂)) = Φ (G g₁) + Φ (G g₂)
              rw [hGadd, hΦadd _ _ (hGcont g₁) (hGcs g₁) (hGsU g₁) (hGcont g₂) (hGcs g₂)
                (hGsU g₂)]
            map_smul' := fun t g => by
              show Φ (G (t • g)) = t • Φ (G g)
              rw [hGsmul, hΦsmul t _ (hGcont g) (hGcs g) (hGsU g), smul_eq_mul] }, ?_, ?_⟩
  · -- (i) `g = c ∘ ω` on `U` forces `g̃ = ω`
    intro ω g hg
    have hωU : tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.property.2
    have hGω : G g = (ω : DifferentialForm (Euclid P) n) := by
      funext y
      by_cases hy : y ∈ U
      · obtain ⟨x, rfl⟩ : ∃ x : U, (x : Euclid P) = y := ⟨⟨y, hy⟩, rfl⟩
        rw [hGU, hg, c.symm_apply_apply]
      · have hy' : y ∉ tsupport (ω : DifferentialForm (Euclid P) n) := fun h => hy (hωU h)
        rw [hGnU g y hy, image_eq_zero_of_notMem_tsupport hy']
    show Φ (G g) = T ω
    rw [hGω, hΦT]
  · -- (ii) an open `W ⊂⊂ U` containing `K`, and `|Φ g̃| ≤ 1 · M_W(T)` for unit fields `g`
    intro K hK
    obtain ⟨W, hW, hKW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure
      (hK.image continuous_subtype_val) hU (Subtype.coe_image_subset U K)
    refine ⟨1 * (T.massOn W).toReal, fun g hgK hg1 => ?_⟩
    show |Φ (G g)| ≤ 1 * (T.massOn W).toReal
    refine hΦle W (G g) 1 hW ⟨hWc, hWU⟩ (hGcont g) (hGcs g)
      ((hGsupp g).trans ((image_mono hgK).trans hKW)) fun y => ?_
    rw [hc]
    by_cases hy : y ∈ U
    · obtain ⟨x, rfl⟩ : ∃ x : U, (x : Euclid P) = y := ⟨⟨y, hy⟩, rfl⟩
      rw [hGU, c.apply_symm_apply]
      exact hg1 x
    · rw [hGnU g y hy, map_zero, norm_zero]
      exact zero_le_one
/-- Coordinate functionals of a locally bounded `L : C_c(X, ℝᵈ) → ℝ`: `Λᵢ(f) = L(f • eᵢ)` is
linear and locally bounded with the same constants.  `T f := f.compLeft (t ↦ t • eᵢ)` is linear
with `(T f)(x) = f(x) • eᵢ`, `tsupport (T f) ⊆ tsupport f` and `‖(T f)(x)‖ = |f(x)|`;
take `Λᵢ := L ∘ T`. -/
theorem Submission.cmr_vr_coordinate_functional : ∀ (X : Type) [TopologicalSpace X] (d : ℕ) (L : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ), (∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), tsupport g ⊆ K → (∀ x, ‖g x‖ ≤ 1) → |L g| ≤ M) → ∀ i : Fin d, ∃ Λ : CompactlySupportedContinuousMap X ℝ →ₗ[ℝ] ℝ, (∀ (f : CompactlySupportedContinuousMap X ℝ) (g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d))), (∀ x, g x = f x • EuclideanSpace.single i (1 : ℝ)) → L g = Λ f) ∧ ∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ f : CompactlySupportedContinuousMap X ℝ, tsupport f ⊆ K → (∀ x, |f x| ≤ 1) → |Λ f| ≤ M := by
  intro X _ d L hL i
  -- `c t = t • eᵢ` is continuous and `c 0 = 0`, so `T f := f.compLeft c` has `(T f) x = f x • eᵢ`
  let c : C(ℝ, EuclideanSpace ℝ (Fin d)) :=
    ⟨fun t => t • EuclideanSpace.single i (1 : ℝ), continuous_id.smul continuous_const⟩
  have hc0 : c 0 = 0 := zero_smul ℝ _
  have hT : ∀ (f : CompactlySupportedContinuousMap X ℝ) (x : X),
      f.compLeft c x = f x • EuclideanSpace.single i (1 : ℝ) :=
    fun f x => CompactlySupportedContinuousMap.compLeft_apply hc0 f x
  -- `T` is linear (pointwise, then extensionality); `Λ := L ∘ T`
  let T : CompactlySupportedContinuousMap X ℝ →ₗ[ℝ]
      CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)) :=
    { toFun := fun f => f.compLeft c
      map_add' := fun f₁ f₂ => CompactlySupportedContinuousMap.ext fun x => by
        simp only [hT, CompactlySupportedContinuousMap.add_apply, add_smul]
      map_smul' := fun r f => CompactlySupportedContinuousMap.ext fun x => by
        simp only [hT, CompactlySupportedContinuousMap.smul_apply, RingHom.id_apply, smul_eq_mul,
          mul_smul] }
  refine ⟨L ∘ₗ T, fun f g hg => ?_, fun K hK => ?_⟩
  · -- `g = T f` by extensionality
    exact congrArg L (CompactlySupportedContinuousMap.ext fun x => (hg x).trans (hT f x).symm)
  · -- `tsupport (T f) ⊆ tsupport f ⊆ K` and `‖(T f) x‖ = |f x| ≤ 1`: same constant `M`
    obtain ⟨M, hM⟩ := hL K hK
    refine ⟨M, fun f hf hf1 => hM (T f) ?_ fun x => ?_⟩
    · have hTf : ⇑(T f) = fun x => f x • EuclideanSpace.single i (1 : ℝ) := funext (hT f)
      rw [hTf]
      exact (tsupport_smul_subset_left _ _).trans hf
    · show ‖f.compLeft c x‖ ≤ 1
      rw [hT, norm_smul, PiLp.norm_single, norm_one, mul_one, Real.norm_eq_abs]
      exact hf1 x
/-- Jordan decomposition of a locally bounded `Λ : C_c(X, ℝ) → ℝ`.  For `f : C_c(X, ℝ≥0)` put
`V f := sup {Λ h : |h| ≤ f}` (bounded above by rescaling the local bound on `tsupport f`).  `V` is
additive (clamp `h₁ := (h ⊓ f) ⊔ (-f)`) and `ℝ≥0`-homogeneous, so `V̂ := toRealPositiveLinear V`
is positive; `V̂ + Λ` is positive since `-k` is admissible for `k ≥ 0`, and `Λ = (V̂ + Λ) - V̂`. -/
theorem Submission.cmr_vr_jordan_decomposition : ∀ (X : Type) [TopologicalSpace X] (Λ : CompactlySupportedContinuousMap X ℝ →ₗ[ℝ] ℝ), (∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ f : CompactlySupportedContinuousMap X ℝ, tsupport f ⊆ K → (∀ x, |f x| ≤ 1) → |Λ f| ≤ M) → ∃ Λ₁ Λ₂ : CompactlySupportedContinuousMap X ℝ →ₚ[ℝ] ℝ, ∀ f : CompactlySupportedContinuousMap X ℝ, Λ f = Λ₁ f - Λ₂ f := by
  intro X _ Λ hΛ
  -- scaled bound: `tsupport f ⊆ K`, `|f| ≤ s` give `|Λ f| ≤ s * M_K` (`s = 0`, else rescale)
  have hscale : ∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ (f : CompactlySupportedContinuousMap X ℝ)
      (s : ℝ), tsupport f ⊆ K → 0 ≤ s → (∀ x, |f x| ≤ s) → |Λ f| ≤ s * M := by
    intro K hK
    obtain ⟨M, hM⟩ := hΛ K hK
    refine ⟨M, fun f s hfK hs hfs => ?_⟩
    rcases hs.eq_or_lt with rfl | hspos
    · have hf0 : f = 0 := by
        ext x
        simpa using hfs x
      simp [hf0]
    · have hsub : tsupport (s⁻¹ • f) ⊆ K :=
        (tsupport_smul_subset_right (fun _ : X => s⁻¹) f).trans hfK
      have hbd : ∀ x, |(s⁻¹ • f) x| ≤ 1 := by
        intro x
        rw [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul, abs_mul,
          abs_of_pos (inv_pos.mpr hspos)]
        calc s⁻¹ * |f x| ≤ s⁻¹ * s := mul_le_mul_of_nonneg_left (hfs x) (inv_pos.mpr hspos).le
          _ = 1 := inv_mul_cancel₀ hspos.ne'
      have h1 := hM _ hsub hbd
      rw [map_smul, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hspos)] at h1
      have := (inv_mul_le_iff₀ hspos).mp h1
      linarith
  -- `A f = {h : |h| ≤ f}` contains `0`, and `Λ '' A f` is bounded above: members of `A f` have
  -- `tsupport h ⊆ tsupport f` and `|h| ≤ max C 0` with `C` a bound for `f`
  let A : CompactlySupportedContinuousMap X NNReal → Set (CompactlySupportedContinuousMap X ℝ) :=
    fun f => {h | ∀ x, |h x| ≤ (f x : ℝ)}
  have hA0 : ∀ f, (0 : CompactlySupportedContinuousMap X ℝ) ∈ A f := by
    intro f x
    simp
  have hbdd : ∀ f, BddAbove (Λ '' A f) := by
    intro f
    obtain ⟨M, hM⟩ := hscale (tsupport f) f.hasCompactSupport.isCompact
    obtain ⟨C, hC⟩ := f.toReal.continuous.bounded_above_of_compact_support
      f.toReal.hasCompactSupport
    refine ⟨max C 0 * M, ?_⟩
    rintro _ ⟨h, hh, rfl⟩
    have hsupp : tsupport h ⊆ tsupport f := by
      apply closure_mono
      intro x hx hfx
      apply hx
      have := hh x
      rw [hfx] at this
      simpa using this
    have hbd : ∀ x, |h x| ≤ max C 0 := by
      intro x
      refine (hh x).trans ((le_abs_self _).trans ?_)
      have h' : ‖f.toReal x‖ ≤ C := hC x
      rw [CompactlySupportedContinuousMap.toReal_apply, Real.norm_eq_abs] at h'
      exact h'.trans (le_max_left _ _)
    exact (le_abs_self _).trans (hM h _ hsupp (le_max_right _ _) hbd)
  -- the variation `V f = sup (Λ '' A f) ≥ Λ 0 = 0`
  let V : CompactlySupportedContinuousMap X NNReal → ℝ := fun f => sSup (Λ '' A f)
  have hle : ∀ f, ∀ h ∈ A f, Λ h ≤ V f := fun f h hh => le_csSup (hbdd f) ⟨h, hh, rfl⟩
  have hVle : ∀ f (c : ℝ), (∀ h ∈ A f, Λ h ≤ c) → V f ≤ c := by
    intro f c hc
    exact csSup_le ⟨0, 0, hA0 f, map_zero Λ⟩ (by rintro _ ⟨h, hh, rfl⟩; exact hc h hh)
  have hV0 : ∀ f, 0 ≤ V f := fun f => by simpa using hle f 0 (hA0 f)
  -- additivity: `≤` by the clamp `h₁ = (h ⊓ f) ⊔ (-f)`, `h - h₁ ∈ A g`; `≥` by `h₁ + h₂ ∈ A (f + g)`
  have hadd : ∀ f g, V (f + g) = V f + V g := by
    intro f g
    apply le_antisymm
    · apply hVle
      intro h hh
      let h₁ : CompactlySupportedContinuousMap X ℝ := (h ⊓ f.toReal) ⊔ (-f.toReal)
      have hpt : ∀ x, |h₁ x| ≤ (f x : ℝ) ∧ |(h - h₁) x| ≤ (g x : ℝ) := by
        intro x
        have hx := hh x
        have hf0 : (0 : ℝ) ≤ f x := (f x).2
        have hg0 : (0 : ℝ) ≤ g x := (g x).2
        simp only [CompactlySupportedContinuousMap.add_apply, NNReal.coe_add] at hx
        simp only [h₁, CompactlySupportedContinuousMap.sub_apply,
          CompactlySupportedContinuousMap.sup_apply, CompactlySupportedContinuousMap.inf_apply,
          CompactlySupportedContinuousMap.neg_apply, CompactlySupportedContinuousMap.toReal_apply]
        rw [abs_le] at hx ⊢
        rw [abs_le]
        rcases le_total (h x) (f x) with h1 | h1
        · rw [min_eq_left h1]
          rcases le_total (h x) (-(f x : ℝ)) with h2 | h2
          · rw [max_eq_right h2]
            constructor <;> constructor <;> linarith
          · rw [max_eq_left h2]
            constructor <;> constructor <;> linarith
        · rw [min_eq_right h1, max_eq_left (by linarith)]
          constructor <;> constructor <;> linarith
      have h1mem : h₁ ∈ A f := fun x => (hpt x).1
      have h2mem : h - h₁ ∈ A g := fun x => (hpt x).2
      have e : Λ h = Λ h₁ + Λ (h - h₁) := by rw [map_sub]; ring
      rw [e]
      exact add_le_add (hle f h₁ h1mem) (hle g _ h2mem)
    · have key : V f ≤ V (f + g) - V g := by
        apply hVle
        intro h₁ hh₁
        have : V g ≤ V (f + g) - Λ h₁ := by
          apply hVle
          intro h₂ hh₂
          have hmem : h₁ + h₂ ∈ A (f + g) := by
            intro x
            simp only [CompactlySupportedContinuousMap.add_apply, NNReal.coe_add]
            exact (abs_add_le _ _).trans (add_le_add (hh₁ x) (hh₂ x))
          have := hle _ _ hmem
          rw [map_add] at this
          linarith
        linarith
      linarith
  -- homogeneity: `A 0 = {0}`; for `c > 0`, `h ↦ c⁻¹ • h` maps `A (c • f)` into `A f`
  have hzero : V 0 = 0 := by
    apply le_antisymm _ (hV0 0)
    apply hVle
    intro h hh
    have : h = 0 := by
      ext x
      simpa using hh x
    simp [this]
  have hsmul_le : ∀ (c : NNReal) f, V (c • f) ≤ c * V f := by
    intro c f
    rcases eq_or_ne c 0 with rfl | hc
    · simp [hzero]
    have hcpos : (0 : ℝ) < c := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hc)
    apply hVle
    intro h hh
    have hmem : (c : ℝ)⁻¹ • h ∈ A f := by
      intro x
      have := hh x
      simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul, NNReal.coe_mul] at this
      rw [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul, abs_mul,
        abs_of_pos (inv_pos.mpr hcpos)]
      rw [inv_mul_le_iff₀ hcpos]
      exact this
    have := hle f _ hmem
    rw [map_smul, smul_eq_mul] at this
    exact (inv_mul_le_iff₀ hcpos).mp this
  have hsmul : ∀ (c : NNReal) f, V (c • f) = c * V f := by
    intro c f
    rcases eq_or_ne c 0 with rfl | hc
    · simp [hzero]
    have hcpos : (0 : ℝ) < c := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hc)
    apply le_antisymm (hsmul_le c f)
    have h := hsmul_le c⁻¹ (c • f)
    rw [inv_smul_smul₀ hc, NNReal.coe_inv] at h
    exact (le_inv_mul_iff₀ hcpos).mp h
  -- `V` is `ℝ≥0`-linear; `V̂ := toRealPositiveLinear V` is a positive functional on `C_c(X, ℝ)`
  let W : CompactlySupportedContinuousMap X NNReal →ₗ[NNReal] NNReal :=
    { toFun := fun f => ⟨V f, hV0 f⟩
      map_add' := fun f g => NNReal.eq (hadd f g)
      map_smul' := fun c f => NNReal.eq (hsmul c f) }
  let Vh := CompactlySupportedContinuousMap.toRealPositiveLinear W
  -- `V̂ + Λ` is positive: for `k ≥ 0`, `V̂ k = V k⁺` and `-k ∈ A k⁺`, so `-Λ k ≤ V̂ k`
  have hdom : ∀ k : CompactlySupportedContinuousMap X ℝ, 0 ≤ k → 0 ≤ Vh k + Λ k := by
    intro k hk
    have hkeq : k.nnrealPart.toReal = k := by
      ext x
      rw [CompactlySupportedContinuousMap.toReal_apply,
        CompactlySupportedContinuousMap.nnrealPart_apply]
      exact Real.coe_toNNReal _ (hk x)
    have hVk : Vh k = V k.nnrealPart := by
      have := CompactlySupportedContinuousMap.eq_toRealPositiveLinear_toReal W k.nnrealPart
      rw [hkeq] at this
      exact this
    have hmem : -k ∈ A k.nnrealPart := by
      intro x
      rw [CompactlySupportedContinuousMap.neg_apply, abs_neg,
        CompactlySupportedContinuousMap.nnrealPart_apply, Real.coe_toNNReal _ (hk x)]
      exact (abs_of_nonneg (hk x)).le
    have := hle _ _ hmem
    rw [map_neg] at this
    rw [hVk]
    linarith
  refine ⟨PositiveLinearMap.mk₀ (Vh.toLinearMap + Λ) hdom, Vh, fun f => ?_⟩
  show Λ f = (Vh f + Λ f) - Vh f
  ring
/-- Common dominating measure (the common density step of the vector Riesz representation behind
the mass representation of currents, Simon Ch. 6, 2.7–2.8, used for Simon 7.2.4): if every `aᵢ`
and `bᵢ` (`i ∈ Fin m`) is finite on compact sets, then so is `μ₀ := ∑ᵢ (aᵢ + bᵢ)`, and
`aᵢ ≪ μ₀`, `bᵢ ≪ μ₀`.  Indeed `μ₀(s) = ∑ᵢ (aᵢ(s) + bᵢ(s))` for every set `s`, so `μ₀(K)` is a
finite sum of finite terms for compact `K`, and `μ₀(s) = 0` forces `aᵢ(s) = bᵢ(s) = 0`. -/
theorem Submission.cmr_vr_cd_dominating_measure : ∀ (X : Type) [TopologicalSpace X] [MeasurableSpace X] (m : ℕ) (a b : Fin m → Measure X), (∀ i, IsFiniteMeasureOnCompacts (a i)) → (∀ i, IsFiniteMeasureOnCompacts (b i)) → ∃ μ₀ : Measure X, IsFiniteMeasureOnCompacts μ₀ ∧ (∀ i, a i ≪ μ₀) ∧ ∀ i, b i ≪ μ₀ := by
  intro X _ _ m a b ha hb
  -- Step 1: `μ₀ := ∑ᵢ (aᵢ + bᵢ)` has `μ₀(s) = ∑ᵢ (aᵢ(s) + bᵢ(s))` for every set `s`
  have hμ₀ : ∀ s : Set X, (∑ i, (a i + b i)) s = ∑ i, (a i s + b i s) := fun s => by
    simp only [Measure.finsetSum_apply, Measure.add_apply]
  refine ⟨∑ i, (a i + b i), ⟨fun K hK => ?_⟩, fun i s hs => ?_, fun i s hs => ?_⟩
  -- Step 2: for compact `K`, `μ₀(K)` is a finite sum of finite terms
  · rw [hμ₀, ENNReal.sum_lt_top]
    exact fun i _ =>
      ENNReal.add_lt_top.2 ⟨(ha i).lt_top_of_isCompact hK, (hb i).lt_top_of_isCompact hK⟩
  -- Step 3: if `μ₀(s) = 0`, every summand `aᵢ(s) + bᵢ(s)` vanishes
  · rw [hμ₀, Finset.sum_eq_zero_iff] at hs
    exact (add_eq_zero.1 (hs i (Finset.mem_univ i))).1
  · rw [hμ₀, Finset.sum_eq_zero_iff] at hs
    exact (add_eq_zero.1 (hs i (Finset.mem_univ i))).2
/-- **Radon–Nikodym density on `C_c`.**  If `μ₀`, `ξ` are finite on compact subsets of a locally
compact second countable space and `ξ ≪ μ₀`, then `ξ` has a measurable density `g`, `μ₀`-integrable
on compact sets, with `f·g` `μ₀`-integrable and `∫ f dξ = ∫ f g dμ₀` for every `f ∈ C_c(X, ℝ)`.
`X` is σ-compact, so `μ₀`, `ξ` are σ-finite and `ξ = μ₀.withDensity δ` for `δ = ξ.rnDeriv μ₀`
(the singular part vanishes since `ξ ≪ μ₀`), with `δ < ∞` `μ₀`-a.e.  Take `g = δ.toReal`: on a
compact `K`, `∫⁻_K δ dμ₀ < ∞` because `ξ(K) < ∞`.  A bounded `f` with compact support times `g` is
integrable on `tsupport f` and vanishes outside it.  The `T2Space` hypothesis is not used. -/
theorem Submission.cmr_vr_cd_density_representation : ∀ (X : Type) [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X] [SecondCountableTopology X] [MeasurableSpace X] [BorelSpace X] (μ₀ ξ : Measure X), IsFiniteMeasureOnCompacts μ₀ → IsFiniteMeasureOnCompacts ξ → ξ ≪ μ₀ → ∃ g : X → ℝ, Measurable g ∧ (∀ K : Set X, IsCompact K → IntegrableOn g K μ₀) ∧ ∀ f : CompactlySupportedContinuousMap X ℝ, Integrable (fun x => f x * g x) μ₀ ∧ ∫ x, f x ∂ξ = ∫ x, f x * g x ∂μ₀ := by
  intro X _ _ _ _ _ _ μ₀ ξ hμ₀ hξ hac
  -- `X` is σ-compact, so both measures are σ-finite and `(ξ, μ₀)` has a Lebesgue decomposition
  have : SigmaCompactSpace X := sigmaCompactSpace_of_locallyCompact_secondCountable
  have : SigmaFinite μ₀ := SigmaFinite.of_isFiniteMeasureOnCompacts μ₀
  have : SigmaFinite ξ := SigmaFinite.of_isFiniteMeasureOnCompacts ξ
  -- `ξ = μ₀.withDensity δ` with `δ = dξ/dμ₀` measurable and `μ₀`-a.e. finite
  set δ : X → ℝ≥0∞ := ξ.rnDeriv μ₀
  have hδm : Measurable δ := Measure.measurable_rnDeriv ξ μ₀
  have hξδ : ξ = μ₀.withDensity δ := by
    have h := Measure.haveLebesgueDecomposition_add ξ μ₀
    rwa [Measure.singularPart_eq_zero_of_ac hac, zero_add] at h
  have hδlt : ∀ᵐ x ∂μ₀, δ x < ∞ := Measure.rnDeriv_lt_top ξ μ₀
  -- `g = δ.toReal` is integrable on compact sets: `∫⁻_K δ dμ₀ < ∞` since `ξ(K) < ∞`
  have hgK : ∀ K : Set X, IsCompact K → IntegrableOn (fun x => (δ x).toReal) K μ₀ := by
    intro K hK
    have hlin : ∫⁻ x in K, δ x ∂μ₀ < ∞ :=
      Measure.lintegral_rnDeriv_lt_top_of_measure_ne_top μ₀ hK.measure_lt_top.ne
    exact integrable_toReal_of_lintegral_ne_top hδm.aemeasurable hlin.ne
  refine ⟨fun x => (δ x).toReal, hδm.ennreal_toReal, hgK, fun f => ⟨?_, ?_⟩⟩
  -- `f` is bounded, so `f·g` is integrable on `tsupport f`, and it vanishes outside
  · obtain ⟨C, hC⟩ := (map_continuous f).bounded_above_of_compact_support f.hasCompactSupport
    have hon : IntegrableOn (fun x => f x * (δ x).toReal) (tsupport f) μ₀ :=
      Integrable.bdd_mul (c := C) (hgK _ f.hasCompactSupport.isCompact)
        (map_continuous f).measurable.aestronglyMeasurable (Eventually.of_forall hC)
    refine hon.integrable_of_forall_notMem_eq_zero fun x hx => ?_
    simp [image_eq_zero_of_notMem_tsupport hx]
  -- `∫ f dξ = ∫ δ.toReal • f dμ₀`
  · rw [hξδ, integral_withDensity_eq_integral_toReal_smul hδm hδlt]
    congr 1
    funext x
    exact (smul_eq_mul _ _).trans (mul_comm _ _)

/-- Common dominating measure and densities for finitely many pairs of positive functionals
(Riesz–Markov–Kakutani; Rudin, *Real and Complex Analysis*, Thm 2.14 and 6.10).  Let `X` be
locally compact, Hausdorff and second countable with its Borel σ-algebra, and let `Λ₁ᵢ, Λ₂ᵢ`
(`i ∈ Fin m`) be positive linear functionals on `C_c(X, ℝ)`.  Then there are a measure `μ₀`,
finite on compact sets, and measurable `ρᵢ`, `μ₀`-integrable on compact sets, with
`Λ₁ᵢ f - Λ₂ᵢ f = ∫ f ρᵢ dμ₀` for all `f ∈ C_c(X, ℝ)`.

Proof sketch:
* `bᵢ := rieszMeasure Λ₁ᵢ` and `aᵢ := rieszMeasure Λ₂ᵢ` are regular, hence finite on compact
  sets, and `∫ f dbᵢ = Λ₁ᵢ f`, `∫ f daᵢ = Λ₂ᵢ f`.
* `cmr_vr_cd_dominating_measure` gives a compact-finite `μ₀` with `aᵢ ≪ μ₀` and `bᵢ ≪ μ₀`.
* `cmr_vr_cd_density_representation` gives locally integrable densities `gaᵢ`, `gbᵢ` with
  `∫ f daᵢ = ∫ f gaᵢ dμ₀`, `∫ f dbᵢ = ∫ f gbᵢ dμ₀`, both integrands integrable.
* With `ρᵢ := gbᵢ - gaᵢ`, linearity of the integral gives the representation. -/
theorem Submission.cmr_vr_common_density : ∀ (X : Type) [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X] [SecondCountableTopology X] [MeasurableSpace X] [BorelSpace X] (m : ℕ) (Λ₁ Λ₂ : Fin m → (CompactlySupportedContinuousMap X ℝ →ₚ[ℝ] ℝ)), ∃ (μ₀ : Measure X) (ρ : Fin m → X → ℝ), IsFiniteMeasureOnCompacts μ₀ ∧ (∀ i, Measurable (ρ i)) ∧ (∀ i, ∀ K : Set X, IsCompact K → IntegrableOn (ρ i) K μ₀) ∧ ∀ (i : Fin m) (f : CompactlySupportedContinuousMap X ℝ), Λ₁ i f - Λ₂ i f = ∫ x, f x * ρ i x ∂μ₀ := by
  intro X _ _ _ _ _ _ m Λ₁ Λ₂
  -- Step 1 (RMK): the Riesz measures are regular, hence finite on compact sets
  have ha : ∀ i, IsFiniteMeasureOnCompacts (RealRMK.rieszMeasure (Λ₂ i)) :=
    fun _ => inferInstance
  have hb : ∀ i, IsFiniteMeasureOnCompacts (RealRMK.rieszMeasure (Λ₁ i)) :=
    fun _ => inferInstance
  -- Step 2: a common compact-finite measure `μ₀` with `aᵢ ≪ μ₀` and `bᵢ ≪ μ₀`
  obtain ⟨μ₀, hμ₀, hac_a, hac_b⟩ := Submission.cmr_vr_cd_dominating_measure X m
    (fun i => RealRMK.rieszMeasure (Λ₂ i)) (fun i => RealRMK.rieszMeasure (Λ₁ i)) ha hb
  -- Step 3: locally integrable densities `gaᵢ`, `gbᵢ` of `aᵢ`, `bᵢ` with respect to `μ₀`
  choose ga hga_meas hga_int hga_rep using fun i =>
    Submission.cmr_vr_cd_density_representation X μ₀ (RealRMK.rieszMeasure (Λ₂ i)) hμ₀ (ha i)
      (hac_a i)
  choose gb hgb_meas hgb_int hgb_rep using fun i =>
    Submission.cmr_vr_cd_density_representation X μ₀ (RealRMK.rieszMeasure (Λ₁ i)) hμ₀ (hb i)
      (hac_b i)
  -- Step 4: `ρᵢ := gbᵢ - gaᵢ` and linearity of the integral
  refine ⟨μ₀, fun i => gb i - ga i, hμ₀, fun i => (hgb_meas i).sub (hga_meas i),
    fun i K hK => (hgb_int i K hK).sub (hga_int i K hK), fun i f => ?_⟩
  obtain ⟨hgb_f, hgb_eq⟩ := hgb_rep i f
  obtain ⟨hga_f, hga_eq⟩ := hga_rep i f
  calc Λ₁ i f - Λ₂ i f
      = ∫ x, f x ∂(RealRMK.rieszMeasure (Λ₁ i)) - ∫ x, f x ∂(RealRMK.rieszMeasure (Λ₂ i)) := by
        rw [RealRMK.integral_rieszMeasure, RealRMK.integral_rieszMeasure]
    _ = ∫ x, f x * gb i x ∂μ₀ - ∫ x, f x * ga i x ∂μ₀ := by rw [hgb_eq, hga_eq]
    _ = ∫ x, (f x * gb i x - f x * ga i x) ∂μ₀ := (integral_sub hgb_f hga_f).symm
    _ = ∫ x, f x * (gb i - ga i) x ∂μ₀ := by simp only [Pi.sub_apply, mul_sub]
/-- Assembly of coordinate densities (vector Riesz representation, coordinate step): if the
`i`-th coordinate functional `f ↦ L(f eᵢ)` has density `ρᵢ` w.r.t. `μ₀` for each `i`, then `L` has
the vector density `ν = Σᵢ ρᵢ eᵢ`, i.e. `L g = ∫ ⟨g, ν⟩ dμ₀`.  Write `g = Σᵢ gᵢ eᵢ` with
`gᵢ = ⟨g, eᵢ⟩ ∈ C_c(X)`; each `gᵢ ρᵢ` is integrable (bounded continuous times integrable on the
compact `tsupport gᵢ`, zero outside it), so the finite sum and the integral commute. -/
theorem Submission.cmr_vr_coordinate_assembly : ∀ (X : Type) [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X] (d : ℕ) (L : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ) (μ₀ : Measure X) (ρ : Fin d → X → ℝ), (∀ i, Measurable (ρ i)) → (∀ i, ∀ K : Set X, IsCompact K → IntegrableOn (ρ i) K μ₀) → (∀ (i : Fin d) (f : CompactlySupportedContinuousMap X ℝ) (g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d))), (∀ x, g x = f x • EuclideanSpace.single i (1 : ℝ)) → L g = ∫ x, f x * ρ i x ∂μ₀) → ∃ ν : X → EuclideanSpace ℝ (Fin d), Measurable ν ∧ (∀ K : Set X, IsCompact K → IntegrableOn ν K μ₀) ∧ ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), L g = ∫ x, inner ℝ (g x) (ν x) ∂μ₀ := by
  intro X _ _ _ d L μ₀ ρ hρm hρi hL
  -- `ν = Σᵢ ρᵢ eᵢ`
  refine ⟨fun x => ∑ i, ρ i x • EuclideanSpace.single i (1 : ℝ),
    Finset.measurable_sum _ fun i _ => (hρm i).smul_const _,
    fun K hK => integrable_finsetSum _ fun i _ => (hρi i K hK).smul_const _, fun g => ?_⟩
  -- the coordinates `gᵢ = g(·)ᵢ ∈ C_c(X, ℝ)` and `Gᵢ = gᵢ eᵢ ∈ C_c(X, H)`
  obtain ⟨gc, hgc⟩ : ∃ gc : Fin d → CompactlySupportedContinuousMap X ℝ, ∀ i x, gc i x = g x i :=
    ⟨fun i => g.compLeft (EuclideanSpace.proj i : EuclideanSpace ℝ (Fin d) →L[ℝ] ℝ),
      fun i x => CompactlySupportedContinuousMap.compLeft_apply (by simp) g x⟩
  obtain ⟨G, hG⟩ : ∃ G : Fin d → CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)),
      ∀ i x, G i x = gc i x • EuclideanSpace.single i (1 : ℝ) :=
    ⟨fun i => (gc i).compLeft ⟨fun t => t • EuclideanSpace.single i (1 : ℝ), by fun_prop⟩,
      fun i x => CompactlySupportedContinuousMap.compLeft_apply (zero_smul ℝ _) (gc i) x⟩
  -- `g = Σᵢ Gᵢ`
  have hsum : g = ∑ i, G i := by
    ext x j
    simp [hG, hgc, Pi.single_apply]
  -- each `gᵢ ρᵢ` is integrable: bounded continuous times integrable on the compact `tsupport gᵢ`
  have hint : ∀ i, Integrable (fun x => gc i x * ρ i x) μ₀ := by
    intro i
    obtain ⟨C, hC⟩ := (gc i).continuous.bounded_above_of_compact_support (gc i).hasCompactSupport
    have hK : IntegrableOn (fun x => gc i x * ρ i x) (tsupport (gc i)) μ₀ :=
      Integrable.bdd_mul (hρi i _ (gc i).hasCompactSupport.isCompact)
        (gc i).continuous.aestronglyMeasurable (Eventually.of_forall hC)
    exact hK.integrable_of_forall_notMem_eq_zero fun x hx => by
      rw [image_eq_zero_of_notMem_tsupport hx, zero_mul]
  calc L g = ∑ i, L (G i) := (congrArg L hsum).trans (map_sum L G Finset.univ)
    _ = ∑ i, ∫ x, gc i x * ρ i x ∂μ₀ := Finset.sum_congr rfl fun i _ => hL i (gc i) (G i) (hG i)
    _ = ∫ x, ∑ i, gc i x * ρ i x ∂μ₀ := (integral_finsetSum _ fun i _ => hint i).symm
    _ = ∫ x, inner ℝ (g x) (∑ i, ρ i x • EuclideanSpace.single i (1 : ℝ)) ∂μ₀ := by
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      dsimp only
      rw [inner_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [inner_smul_right, EuclideanSpace.inner_single_right, hgc, conj_trivial, one_mul, mul_comm]

/-- **Riesz representation of locally bounded functionals on `C_c(X, ℝ^d)`** (Simon Ch. 1, 4.14,
in the form used for currents in Ch. 6, 2.7).  If `X` is locally compact Hausdorff and second
countable and `L : C_c(X, ℝ^d) → ℝ` is linear with `|L g| ≤ M_K` whenever `spt g ⊆ K` and
`|g| ≤ 1`, then `L g = ∫ ⟨g, ν⟩ dμ₀` for a Borel measure `μ₀` finite on compact sets and a
measurable `ν : X → ℝ^d` integrable on compact sets.  The coordinate functionals
`Λᵢ f = L(f eᵢ)` are locally bounded, each splits as a difference `Pᵢ − Nᵢ` of positive
functionals (total variation), the Riesz–Markov–Kakutani measures of all `Pᵢ, Nᵢ` have densities
`ρᵢ` against one common `μ₀`, and `ν = Σᵢ ρᵢ eᵢ`. -/
theorem Submission.cmr_vector_riesz_representation : ∀ (X : Type) [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X] [SecondCountableTopology X] [MeasurableSpace X] [BorelSpace X] (d : ℕ) (L : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ), (∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), tsupport g ⊆ K → (∀ x, ‖g x‖ ≤ 1) → |L g| ≤ M) → ∃ (μ₀ : Measure X) (ν : X → EuclideanSpace ℝ (Fin d)), IsFiniteMeasureOnCompacts μ₀ ∧ Measurable ν ∧ (∀ K : Set X, IsCompact K → IntegrableOn ν K μ₀) ∧ ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), L g = ∫ x, inner ℝ (g x) (ν x) ∂μ₀ := by
  intro X _ _ _ _ _ _ d L hL
  -- step 1: the coordinate functionals `Λᵢ f = L(f eᵢ)`, locally bounded
  choose Λ hΛL hΛbd using Submission.cmr_vr_coordinate_functional X d L hL
  -- steps 2–3: Jordan decomposition `Λᵢ = Pᵢ − Nᵢ` into positive functionals
  choose Pos Neg hΛ using fun i => Submission.cmr_vr_jordan_decomposition X (Λ i) (hΛbd i)
  -- steps 4–6 and 8: one measure `μ₀` with `Pᵢ f − Nᵢ f = ∫ f ρᵢ dμ₀`
  obtain ⟨μ₀, ρ, hμ₀, hρm, hρint, hρ⟩ := Submission.cmr_vr_common_density X d Pos Neg
  -- steps 7 and 9: `ν = Σᵢ ρᵢ eᵢ` and `L g = Σᵢ ∫ gᵢ ρᵢ dμ₀ = ∫ ⟨g, ν⟩ dμ₀`
  obtain ⟨ν, hνm, hνint, hν⟩ := Submission.cmr_vr_coordinate_assembly X d L μ₀ ρ hρm hρint
    fun i f g hg => by rw [hΛL i f g hg, hΛ i f, hρ i f]
  exact ⟨μ₀, ν, hμ₀, hνm, hνint, hν⟩

/-- **Simon Ch. 6, 2.7–2.8** (Riesz representation of a current of locally finite mass): if
`M_W(T) < ∞` for every open `W ⊂⊂ U`, then `T(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|⟨α, ξ⟩| ≤ |α|_E`,
`μ(ℝᴾ \ U) = 0`, `μ` finite on compact subsets of `U` and `M_W(T) = μ(W)` for open `W`.
Euclidean coordinates `c` on covectors (`|α|_E = ‖c α‖`) make `T` a locally bounded linear
functional `L` on `C_c(U, ℝᵈ)` with `L(c ∘ ω) = T ω`.  The vector Riesz theorem on the locally
compact space `U` gives `L g = ∫ ⟨g, ν⟩ dμ₀`.  Normalizing `ν` polarly and pushing `|ν| μ₀`
forward to `ℝᴾ` gives `μ`, the field `ξ = ⟨ν/|ν|, c(·)⟩` and a norming field `β` with
`ξ(β) = 1` `μ`-a.e.  Then `M_W(T) ≤ μ(W)` because `|ξ(ω)| ≤ |ω|_E ≤ 1`, while `μ(W') ≤ M_W(T)`
for open `W' ⊂⊂ U` inside `W` (test `T` on forms approximating `β`), and these `W'` exhaust
`W ∩ U`. -/
theorem Submission.cmr_exists_massRepresentation_core : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) := by
  intro P n U T hU hfin
  -- Step 1: Euclidean coordinates `c` on covectors, `|α|_E = ‖c α‖`
  obtain ⟨d, c, hc⟩ := Submission.cmr_covector_euclidean_equiv P n
  -- Step 2: `T` extends to a locally bounded linear functional `L` on `C_c(U, ℝᵈ)`
  obtain ⟨L, hLT, hLb⟩ := Submission.cmr_testForm_extension_functional P n U T d c hU hfin hc
  -- Step 3: vector Riesz representation `L g = ∫ ⟨g, ν⟩ dμ₀` on the locally compact space `U`
  have : LocallyCompactSpace U := hU.locallyCompactSpace
  obtain ⟨μ₀, ν, -, hνm, hνi, hLν⟩ := Submission.cmr_vector_riesz_representation U d L hLb
  -- Steps 4–9: `μ = val_*(|ν| μ₀)`, `ξ = ⟨ν/|ν|, c(·)⟩` and the norming field `β`
  obtain ⟨μ, ξ, β, hμU, hμK, hξm, hξ1, hβm, hβb, hβ1, hξβ, hμν⟩ :=
    Submission.cmrc_polar_pushforward P n d U c μ₀ ν hU hc hνm hνi
  -- Step 8: `T ω = L(c ∘ ω) = ∫ ⟨c ∘ ω, ν⟩ dμ₀ = ∫ ξ(ω) dμ`
  have hT : ∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ := by
    intro ω
    obtain ⟨g, hg⟩ := Submission.cmrc_testForm_restrict_cc P n d U c c.continuous c.map_zero ω
    rw [← hLT ω g hg, hLν g, ← hμν (ω : DifferentialForm (Euclid P) n)]
    simp only [hg]
  -- Steps 10–12: `M_W(T) ≤ μ(W)`, and `μ(W) ≤ M_W(T)` by exhausting `W ∩ U` with `W' ⊂⊂ U`
  refine ⟨μ, ξ, hμU, hμK, fun W hW => le_antisymm
    (Submission.cmrc_massOn_le_of_repr P n U T μ ξ hξ1 hT W) ?_, hξm, hξ1, hT⟩
  exact Submission.cmrc_measure_le_of_compactlyContained P μ U W (T.massOn W) hU hW hμU
    fun W' hW' hW'U hW'W => Submission.cmrc_measure_le_massOn_of_norming P n U T μ ξ β hμK hξm
      hξ1 hT hβm hβb hβ1 hξβ W W' hW' hW'U hW'W
/-- **Directional difference estimate from the divergence bound** (steps 1–2 of the parent proof).
For `‖w‖ ≤ 1` the field `g(y) = a(y + v) • w` is admissible and `div g(y) = Da(y + v)(w)` (trace
of a rank-one map), so `|∫ h·Da(q + v)(w) dν| ≤ Λ`.  The fundamental theorem of calculus along
`s ↦ q x + s • z` and Fubini on `(0, 1] × X` (majorant `M‖z‖|h|`, `‖Da‖ ≤ M`) give
`∫ h·(a(q + z) − a(q)) dν = ∫₀¹ ∫ h·Da(q + s • z)(z) dν ds`, and `Da(p)(z) = ‖z‖·Da(p)(w)` with
`w = ‖z‖⁻¹ • z` bounds the inner integral by `Λ‖z‖`. -/
theorem Submission.cmr_tdn_directional_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ) (Λ : ℝ), IsFiniteMeasure ν → Measurable q → Integrable h ν → (∀ g : Euclid n → Euclid n, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → (∀ y, ‖g y‖ ≤ 1) → |∫ x, h x * LinearMap.trace ℝ (Euclid n) (fderiv ℝ g (q x)).toLinearMap ∂ν| ≤ Λ) → ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → (∀ y, |a y| ≤ 1) → ∀ z : Euclid n, |∫ x, h x * (a (q x + z) - a (q x)) ∂ν| ≤ Λ * ‖z‖ := by
  intro n X _ ν q h Λ hν hq hh hdiv a ha hsupp hbd z
  -- Step 1: `a` is differentiable, `Da` is continuous with compact support, so `‖Da‖ ≤ M`
  have h0 : ((⊤ : ℕ∞) : WithTop ℕ∞) ≠ 0 := by simp
  have hdiff : Differentiable ℝ a := ha.differentiable h0
  have hcont : Continuous (fderiv ℝ a) := ha.continuous_fderiv h0
  obtain ⟨M, hM⟩ := hcont.bounded_above_of_compact_support (hsupp.fderiv ℝ)
  -- Step 3: for `‖w‖ ≤ 1` the field `g(y) = a(y + v) • w` is admissible, with
  -- `div g(y) = Da(y + v)(w)`; this gives `(∗)`
  have key : ∀ v w : Euclid n, ‖w‖ ≤ 1 → |∫ x, h x * fderiv ℝ a (q x + v) w ∂ν| ≤ Λ := by
    intro v w hw
    set g : Euclid n → Euclid n := fun y => a (y + v) • w with hg_def
    have hg_smooth : ContDiff ℝ (⊤ : ℕ∞) g :=
      (ha.comp (contDiff_id.add contDiff_const)).smul contDiff_const
    have hg_supp : HasCompactSupport g :=
      (hsupp.comp_homeomorph (Homeomorph.addRight v)).smul_right (f' := fun _ => w)
    have hg_bd : ∀ y, ‖g y‖ ≤ 1 := by
      intro y
      simp only [hg_def, norm_smul, Real.norm_eq_abs]
      calc |a (y + v)| * ‖w‖ ≤ 1 * 1 := mul_le_mul (hbd _) hw (norm_nonneg _) zero_le_one
        _ = 1 := one_mul 1
    have htrace : ∀ y, LinearMap.trace ℝ (Euclid n) (fderiv ℝ g y).toLinearMap
        = fderiv ℝ a (y + v) w := by
      intro y
      have h1 : HasFDerivAt (fun y => a (y + v)) (fderiv ℝ a (y + v)) y :=
        (hasFDerivAt_comp_add_right v).2 (hdiff (y + v)).hasFDerivAt
      rw [(h1.smul_const w).fderiv, ContinuousLinearMap.coe_smulRight,
        LinearMap.trace_smulRight]
      rfl
    simpa only [htrace] using hdiv g hg_smooth hg_supp hg_bd
  -- Step 4: fundamental theorem of calculus along `s ↦ q x + s • z`
  have hftc : ∀ x, ∫ s in (0 : ℝ)..1, h x * fderiv ℝ a (q x + s • z) z
      = h x * (a (q x + z) - a (q x)) := by
    intro x
    have hderiv : ∀ s ∈ uIcc (0 : ℝ) 1,
        HasDerivAt (fun s : ℝ => a (q x + s • z)) (fderiv ℝ a (q x + s • z) z) s := by
      intro s _
      have hline : HasDerivAt (fun s : ℝ => q x + s • z) z s := by
        simpa using ((hasDerivAt_id s).smul_const z).const_add (q x)
      exact (hdiff (q x + s • z)).hasFDerivAt.comp_hasDerivAt s hline
    have hcontS : Continuous (fun s : ℝ => fderiv ℝ a (q x + s • z) z) :=
      (hcont.comp (continuous_const.add (continuous_id.smul continuous_const))).clm_apply
        continuous_const
    rw [intervalIntegral.integral_const_mul,
      intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcontS.intervalIntegrable 0 1)]
    simp
  -- Step 5: Fubini on `Leb|(0, 1] ⊗ ν`, with integrable majorant `M‖z‖|h|`
  have hGint : Integrable (uncurry fun (s : ℝ) (x : X) => h x * fderiv ℝ a (q x + s • z) z)
      ((volume.restrict (uIoc (0 : ℝ) 1)).prod ν) := by
    have : IsFiniteMeasure (volume.restrict (uIoc (0 : ℝ) 1)) := by
      rw [uIoc_of_le zero_le_one]; infer_instance
    have hmaj : Integrable (fun p : ℝ × X => (M * ‖z‖) * |h p.2|)
        ((volume.restrict (uIoc (0 : ℝ) 1)).prod ν) :=
      (hh.abs.comp_snd _).const_mul _
    refine hmaj.mono' ?_ ?_
    · have h1 : AEStronglyMeasurable (fun p : ℝ × X => h p.2)
          ((volume.restrict (uIoc (0 : ℝ) 1)).prod ν) := hh.aestronglyMeasurable.comp_snd
      have h2 : Continuous (fun p : ℝ × Euclid n => fderiv ℝ a (p.2 + p.1 • z) z) :=
        (hcont.comp (continuous_snd.add (continuous_fst.smul continuous_const))).clm_apply
          continuous_const
      have h3 : Measurable (fun p : ℝ × X => (p.1, q p.2)) :=
        measurable_fst.prodMk (hq.comp measurable_snd)
      exact h1.mul (h2.measurable.comp h3).aestronglyMeasurable
    · filter_upwards with p
      simp only [uncurry, Real.norm_eq_abs, abs_mul]
      have hp : |fderiv ℝ a (q p.2 + p.1 • z) z| ≤ M * ‖z‖ :=
        calc |fderiv ℝ a (q p.2 + p.1 • z) z| = ‖fderiv ℝ a (q p.2 + p.1 • z) z‖ :=
              (Real.norm_eq_abs _).symm
          _ ≤ ‖fderiv ℝ a (q p.2 + p.1 • z)‖ * ‖z‖ := ContinuousLinearMap.le_opNorm _ _
          _ ≤ M * ‖z‖ := by gcongr; exact hM _
      calc |h p.2| * |fderiv ℝ a (q p.2 + p.1 • z) z| ≤ |h p.2| * (M * ‖z‖) := by gcongr
        _ = M * ‖z‖ * |h p.2| := by ring
  have heq : ∫ x, h x * (a (q x + z) - a (q x)) ∂ν
      = ∫ s in (0 : ℝ)..1, ∫ x, h x * fderiv ℝ a (q x + s • z) z ∂ν := by
    rw [intervalIntegral_integral_swap hGint]
    exact integral_congr_ae (Eventually.of_forall fun x => (hftc x).symm)
  -- Step 6: with `w = ‖z‖⁻¹ • z` (so `‖w‖ ≤ 1`, `z = ‖z‖ • w`, also for `z = 0`),
  -- `(∗)` bounds the inner integral by `Λ‖z‖` for every `s`
  set w : Euclid n := ‖z‖⁻¹ • z with hw_def
  have hw : ‖w‖ ≤ 1 := by
    by_cases hz : z = 0
    · simp [hw_def, hz]
    · rw [hw_def, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.2 hz)]
  have hzw : z = ‖z‖ • w := by
    by_cases hz : z = 0
    · simp [hz]
    · rw [hw_def, smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.2 hz), one_smul]
  have hlin : ∀ p : Euclid n, fderiv ℝ a p z = ‖z‖ * fderiv ℝ a p w := by
    intro p
    conv_lhs => rw [hzw]
    rw [map_smul, smul_eq_mul]
  have hbound : ∀ s ∈ uIoc (0 : ℝ) 1,
      ‖∫ x, h x * fderiv ℝ a (q x + s • z) z ∂ν‖ ≤ Λ * ‖z‖ := by
    intro s _
    have hrw : ∫ x, h x * fderiv ℝ a (q x + s • z) z ∂ν
        = ‖z‖ * ∫ x, h x * fderiv ℝ a (q x + s • z) w ∂ν := by
      rw [← integral_const_mul]
      congr 1
      ext x
      rw [hlin]
      ring
    rw [hrw, Real.norm_eq_abs, abs_mul, abs_norm, mul_comm Λ]
    exact mul_le_mul_of_nonneg_left (key (s • z) w hw) (norm_nonneg _)
  rw [heq]
  simpa using intervalIntegral.norm_integral_le_of_norm_le_const hbound
/-- **Ball-averaging estimate** (step 3 of the parent proof).  With `B = B_r(0)` and
`V = λ(B) ∈ (0, ∞)`, Fubini on `ν ⊗ λ⌞B` gives
`V ∫ h(x) a(q x) dν = ∫∫ h(x) a(q x + z) − ∫∫ h(x) (a(q x + z) − a(q x))`.  The second double
integral is at most `V Λ r` by the directional bound (`‖z‖ < r` on `B`), and the first at most
`(∫ |h| dν) ∫ a` since `0 ≤ ∫_B a(q x + z) dz ≤ ∫ a` by translation invariance.  Divide by `V`. -/
theorem Submission.cmr_tdn_ball_average_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ) (Λ : ℝ) (a : Euclid n → ℝ) (r : ℝ), IsFiniteMeasure ν → Measurable q → Integrable h ν → 0 ≤ Λ → Continuous a → HasCompactSupport a → (∀ y, 0 ≤ a y) → (∀ y, a y ≤ 1) → (∀ z : Euclid n, |∫ x, h x * (a (q x + z) - a (q x)) ∂ν| ≤ Λ * ‖z‖) → 0 < r → |∫ x, h x * a (q x) ∂ν| ≤ r * Λ + (volume (ball (0 : Euclid n) r)).toReal⁻¹ * (∫ x, |h x| ∂ν) * ∫ y, a y := by
  intro n X mX ν q h Λ a r hν hq hh hΛ ha ha_supp ha0 ha1 hdir hr
  -- the ball `B = B_r(0)`: measurable, inside `‖z‖ ≤ r`, of measure `λ(B) ∈ (0, ∞)`
  have hBm : MeasurableSet (ball (0 : Euclid n) r) := measurableSet_ball
  have hBr : ∀ z ∈ ball (0 : Euclid n) r, ‖z‖ ≤ r := fun z hz => (mem_ball_zero_iff.1 hz).le
  have hBpos : 0 < volume (ball (0 : Euclid n) r) := measure_ball_pos volume 0 hr
  have hBfin : volume (ball (0 : Euclid n) r) < ∞ := measure_ball_lt_top
  generalize ball (0 : Euclid n) r = B at hBm hBr hBpos hBfin ⊢
  have hV : 0 < (volume B).toReal := ENNReal.toReal_pos hBpos.ne' hBfin.ne
  have : IsFiniteMeasure (volume.restrict B) := isFiniteMeasure_restrict.2 hBfin.ne
  have hμB : (volume.restrict B).real univ = (volume B).toReal := by
    rw [measureReal_def, Measure.restrict_apply_univ]
  generalize (volume B).toReal = V at hV hμB ⊢
  -- `a` is integrable, and so are its translates
  have ha_int : Integrable a volume := ha.integrable_of_hasCompactSupport ha_supp
  -- the integrands on `ν ⊗ λ⌞B`, dominated by `|h x|`
  have hm₁ : Measurable fun p : X × Euclid n => a (q p.1 + p.2) :=
    ha.measurable.comp ((hq.comp measurable_fst).add measurable_snd)
  have hm₀ : Measurable fun p : X × Euclid n => a (q p.1) :=
    ha.measurable.comp (hq.comp measurable_fst)
  have hh₁ : AEStronglyMeasurable (fun p : X × Euclid n => h p.1) (ν.prod (volume.restrict B)) :=
    hh.aestronglyMeasurable.comp_fst
  have hdom : Integrable (fun p : X × Euclid n => |h p.1|) (ν.prod (volume.restrict B)) :=
    hh.abs.comp_fst _
  have hG₂ : Integrable (fun p : X × Euclid n => h p.1 * a (q p.1 + p.2))
      (ν.prod (volume.restrict B)) := by
    refine hdom.mono' (hh₁.mul hm₁.aestronglyMeasurable) (Eventually.of_forall fun p => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (ha0 _)]
    exact mul_le_of_le_one_right (abs_nonneg _) (ha1 _)
  have hG₁ : Integrable (fun p : X × Euclid n => h p.1 * (a (q p.1 + p.2) - a (q p.1)))
      (ν.prod (volume.restrict B)) := by
    refine hdom.mono' (hh₁.mul (hm₁.sub hm₀).aestronglyMeasurable)
      (Eventually.of_forall fun p => ?_)
    rw [Real.norm_eq_abs, abs_mul]
    refine mul_le_of_le_one_right (abs_nonneg _) (abs_sub_le_iff.2 ⟨?_, ?_⟩)
    · linarith [ha0 (q p.1), ha1 (q p.1 + p.2)]
    · linarith [ha0 (q p.1 + p.2), ha1 (q p.1)]
  -- `V F = ∫∫ h(x) a(q x + z) - ∫∫ h(x) (a(q x + z) - a(q x))` over `ν ⊗ λ⌞B`
  have hsplit : V * ∫ x, h x * a (q x) ∂ν =
      (∫ p, h p.1 * a (q p.1 + p.2) ∂(ν.prod (volume.restrict B))) -
        ∫ p, h p.1 * (a (q p.1 + p.2) - a (q p.1)) ∂(ν.prod (volume.restrict B)) := by
    rw [← integral_sub hG₂ hG₁]
    have hfun : (fun p : X × Euclid n =>
        h p.1 * a (q p.1 + p.2) - h p.1 * (a (q p.1 + p.2) - a (q p.1))) =
        fun p => h p.1 * a (q p.1) := by
      funext p
      ring
    rw [hfun, integral_fun_fst (fun x => h x * a (q x)), hμB, smul_eq_mul]
  -- Fubini and the directional bound: `|∫∫ h(x) (a(q x + z) - a(q x))| ≤ V Λ r`
  have hJ : |∫ p, h p.1 * (a (q p.1 + p.2) - a (q p.1)) ∂(ν.prod (volume.restrict B))| ≤
      V * (Λ * r) := by
    rw [integral_prod_symm _ hG₁]
    have hb : ∀ᵐ z ∂(volume.restrict B), ‖∫ x, h x * (a (q x + z) - a (q x)) ∂ν‖ ≤ Λ * r := by
      filter_upwards [ae_restrict_mem hBm] with z hz
      rw [Real.norm_eq_abs]
      exact (hdir z).trans (mul_le_mul_of_nonneg_left (hBr z hz) hΛ)
    have := norm_integral_le_of_norm_le (integrable_const (Λ * r)) hb
    rw [integral_const, hμB, smul_eq_mul, Real.norm_eq_abs] at this
    exact this
  -- translation invariance: `|∫∫ h(x) a(q x + z)| ≤ (∫ |h|) ∫ a`
  have hM : |∫ p, h p.1 * a (q p.1 + p.2) ∂(ν.prod (volume.restrict B))| ≤
      (∫ x, |h x| ∂ν) * ∫ y, a y := by
    rw [integral_prod _ hG₂]
    have hb : ∀ x, ‖∫ z, h x * a (q x + z) ∂(volume.restrict B)‖ ≤ |h x| * ∫ y, a y := by
      intro x
      rw [integral_const_mul, Real.norm_eq_abs, abs_mul]
      refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
      have h0 : 0 ≤ ∫ z, a (q x + z) ∂(volume.restrict B) := integral_nonneg fun z => ha0 _
      rw [abs_of_nonneg h0]
      exact (setIntegral_le_integral (ha_int.comp_add_left (q x))
        (Eventually.of_forall fun z => ha0 _)).trans_eq (integral_add_left_eq_self a (q x))
    have := norm_integral_le_of_norm_le (hh.abs.mul_const (∫ y, a y)) (Eventually.of_forall hb)
    rw [integral_mul_const, Real.norm_eq_abs] at this
    exact this
  -- conclusion: `V |F| ≤ (∫ |h|) ∫ a + V Λ r`, then divide by `V > 0`
  have key : V * |∫ x, h x * a (q x) ∂ν| ≤ (∫ x, |h x| ∂ν) * (∫ y, a y) + V * (Λ * r) := by
    rw [← abs_of_pos hV, ← abs_mul, abs_of_pos hV, hsplit]
    exact (abs_sub _ _).trans (add_le_add hM hJ)
  generalize ∫ x, h x * a (q x) ∂ν = F at key ⊢
  generalize ∫ x, |h x| ∂ν = H at key ⊢
  generalize ∫ y, a y = A at key ⊢
  have hV0 : V ≠ 0 := hV.ne'
  calc |F| ≤ (H * A + V * (Λ * r)) / V := by
        rw [le_div_iff₀ hV]
        linarith
    _ = r * Λ + V⁻¹ * H * A := by
        field_simp
        ring
/-- **Smooth cut-offs of a compact Lebesgue-null set** (steps 4 and 5(ii) of the parent proof).
With `δₖ = 1/(k+1)`, take `aₖ` smooth with values in `[0, 1]`, support `thickening δₖ K`, and
`aₖ = 1` exactly on `K` (`exists_contDiff_support_eq_eq_one_iff`).  Then `aₖ` vanishes off the
compact `cthickening δₖ K`; a point `y ∉ K = ⋂_{δ>0} cthickening δ K` misses some
`cthickening δ K`, so `aₖ(y) = 0` once `δₖ < δ`; and `0 ≤ ∫ aₖ ≤ λ(cthickening δₖ K) → λ(K) = 0`. -/
theorem Submission.cmr_tdn_null_set_cutoffs : ∀ (n : ℕ) (K : Set (Euclid n)), IsCompact K → volume K = 0 → ∃ a : ℕ → Euclid n → ℝ, (∀ k, ContDiff ℝ (⊤ : ℕ∞) (a k)) ∧ (∀ k, HasCompactSupport (a k)) ∧ (∀ k y, 0 ≤ a k y) ∧ (∀ k y, a k y ≤ 1) ∧ (∀ k, ∀ y ∈ K, a k y = 1) ∧ (∀ y, y ∉ K → ∀ᶠ k in atTop, a k y = 0) ∧ Tendsto (fun k => ∫ y, a k y) atTop (𝓝 0) := by
  intro n K hK hK0
  -- `aₖ`: smooth, `[0, 1]`-valued, with support `thickening δₖ K` and `aₖ = 1` exactly on `K`
  have hδ : ∀ k : ℕ, (0 : ℝ) < 1 / ((k : ℝ) + 1) := fun k => by positivity
  have hex : ∀ k : ℕ, ∃ f : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) f ∧ range f ⊆ Icc 0 1 ∧
      support f = thickening (1 / ((k : ℝ) + 1)) K ∧ ∀ x, x ∈ K ↔ f x = 1 := fun k =>
    exists_contDiff_support_eq_eq_one_iff isOpen_thickening hK.isClosed
      (self_subset_thickening (hδ k) K)
  choose a ha_smooth ha_range ha_supp ha_one using hex
  have hnonneg : ∀ k y, 0 ≤ a k y := fun k y => (ha_range k (mem_range_self y)).1
  have hle : ∀ k y, a k y ≤ 1 := fun k y => (ha_range k (mem_range_self y)).2
  -- `aₖ` vanishes off the compact `cthickening δₖ K`
  have hzero : ∀ (k : ℕ) y, y ∉ cthickening (1 / ((k : ℝ) + 1)) K → a k y = 0 := by
    intro k y hy
    by_contra h
    have hy' : y ∈ support (a k) := h
    rw [ha_supp k] at hy'
    exact hy (thickening_subset_cthickening _ _ hy')
  refine ⟨a, ha_smooth, fun k => HasCompactSupport.intro hK.cthickening (hzero k), hnonneg, hle,
    fun k y hy => (ha_one k y).1 hy, ?_, ?_⟩
  · -- `y ∉ K = ⋂_{δ>0} cthickening δ K`, so `y ∉ cthickening δ K ⊇ cthickening δₖ K` for some
    -- `δ > 0` and all `k` with `δₖ < δ`
    intro y hy
    rw [← hK.isClosed.closure_eq, closure_eq_iInter_cthickening] at hy
    simp only [mem_iInter, not_forall] at hy
    obtain ⟨δ, hδpos, hyδ⟩ := hy
    obtain ⟨k₀, hk₀⟩ := exists_nat_one_div_lt hδpos
    filter_upwards [eventually_ge_atTop k₀] with k hk
    refine hzero k y fun hmem => hyδ (cthickening_mono ?_ K hmem)
    have hkk₀ : 1 / ((k : ℝ) + 1) ≤ 1 / ((k₀ : ℝ) + 1) :=
      one_div_le_one_div_of_le (by positivity) (by exact_mod_cast Nat.add_le_add_right hk 1)
    linarith
  · -- `0 ≤ ∫ aₖ ≤ λ(cthickening δₖ K)`, and `λ(cthickening δₖ K) → λ(K) = 0`
    have hmeas : Tendsto (fun k : ℕ => (volume (cthickening (1 / ((k : ℝ) + 1)) K)).toReal)
        atTop (𝓝 0) := by
      have h := (tendsto_measure_cthickening_of_isCompact (μ := (volume : Measure (Euclid n)))
        hK).comp tendsto_one_div_add_atTop_nhds_zero_nat
      rw [hK0] at h
      simpa [Function.comp_def] using (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hmeas
      (fun k => integral_nonneg (hnonneg k)) fun k => ?_
    set C := cthickening (1 / ((k : ℝ) + 1)) K
    have hCm : MeasurableSet C := isClosed_cthickening.measurableSet
    have hint : Integrable (C.indicator fun _ => (1 : ℝ)) volume :=
      (integrable_indicator_iff hCm).2 (integrableOn_const hK.cthickening.measure_lt_top.ne)
    have hind : ∀ y, a k y ≤ C.indicator (fun _ => (1 : ℝ)) y := by
      intro y
      by_cases hy : y ∈ C
      · rw [indicator_of_mem hy]
        exact hle k y
      · rw [indicator_of_notMem hy, hzero k y hy]
    calc ∫ y, a k y ≤ ∫ y, C.indicator (fun _ => (1 : ℝ)) y :=
          integral_mono_of_nonneg (Eventually.of_forall (hnonneg k)) hint
            (Eventually.of_forall hind)
      _ = (volume C).toReal := by
          rw [integral_indicator_const _ hCm]
          simp [measureReal_def]

/-- **Vanishing on compact null sets from an `ε + C ∫ a` bound** (steps 5(i) and 6 of the
top-dimensional null-set argument): let `q : X → ℝⁿ` be measurable and `h ∈ L¹(ν)` (`ν` need not
be finite), and suppose that for every `ε > 0` there is `C` with `|∫ h · a(q) dν| ≤ ε + C ∫ a`
for all smooth compactly supported `0 ≤ a ≤ 1`.  Then `∫_{q⁻¹K} h dν = 0` for every compact
Lebesgue-null `K ⊆ ℝⁿ`.  Along the cut-offs `a_k` of `K` given by
`Submission.cmr_tdn_null_set_cutoffs`, dominated convergence (majorant `|h|`) gives
`∫ h · a_k(q) dν → ∫_{q⁻¹K} h dν`, while `ε + C ∫ a_k → ε`; so `|∫_{q⁻¹K} h dν| ≤ ε` for every
`ε > 0`. -/
theorem Submission.cmr_tdn_null_of_average_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ), Measurable q → Integrable h ν → (∀ ε : ℝ, 0 < ε → ∃ C : ℝ, ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → (∀ y, 0 ≤ a y) → (∀ y, a y ≤ 1) → |∫ x, h x * a (q x) ∂ν| ≤ ε + C * ∫ y, a y) → ∀ K : Set (Euclid n), IsCompact K → volume K = 0 → ∫ x in q ⁻¹' K, h x ∂ν = 0 := by
  intro n X _ ν q h hq hh hbd K hK hK0
  -- smooth cut-offs `a k` of `K`: `a k = 1` on `K`, `a k → 0` pointwise off `K`, `∫ a k → 0`
  obtain ⟨a, ha, hac, ha0, ha1, haK, haoff, haint⟩ :=
    Submission.cmr_tdn_null_set_cutoffs n K hK hK0
  -- dominated convergence with majorant `|h|`: `∫ h (a k ∘ q) dν → ∫ 1_{q⁻¹K} h dν`
  have hE : MeasurableSet (q ⁻¹' K) := hq hK.isClosed.measurableSet
  have hlim : Tendsto (fun k => ∫ x, h x * a k (q x) ∂ν) atTop
      (𝓝 (∫ x in q ⁻¹' K, h x ∂ν)) := by
    rw [← integral_indicator hE]
    refine tendsto_integral_of_dominated_convergence (fun x => |h x|)
      (fun k => hh.aestronglyMeasurable.mul
        ((ha k).continuous.measurable.comp hq).aestronglyMeasurable)
      hh.abs (fun k => Eventually.of_forall fun x => ?_) (Eventually.of_forall fun x => ?_)
    · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (ha0 k (q x))]
      exact mul_le_of_le_one_right (abs_nonneg _) (ha1 k (q x))
    · by_cases hx : q x ∈ K
      · have h1 : ∀ k, a k (q x) = 1 := fun k => haK k (q x) hx
        simp only [indicator_of_mem (show x ∈ q ⁻¹' K from hx), h1, mul_one]
        exact tendsto_const_nhds
      · rw [indicator_of_notMem (show x ∉ q ⁻¹' K from hx)]
        refine tendsto_nhds_of_eventually_eq ?_
        filter_upwards [haoff (q x) hx] with k hk
        rw [hk, mul_zero]
  -- for `ε > 0`: `|∫ h (a k ∘ q) dν| ≤ ε + C ∫ a k → ε`, so `|∫_{q⁻¹K} h dν| ≤ ε`
  refine abs_nonpos_iff.1 (le_of_forall_pos_le_add fun ε hε => ?_)
  obtain ⟨C, hC⟩ := hbd ε hε
  have hR : Tendsto (fun k => ε + C * ∫ y, a k y) atTop (𝓝 (ε + C * 0)) :=
    tendsto_const_nhds.add (haint.const_mul C)
  rw [mul_zero, add_zero] at hR
  rw [zero_add]
  exact le_of_tendsto_of_tendsto' hlim.abs hR fun k => hC (a k) (ha k) (hac k) (ha0 k) (ha1 k)

/-- **Lemma TD for `m = q_#(h ν)`** (top-dimensional step of the absolute continuity of normal
currents, Simon Ch. 6, 2.36): if `|∫ h · div g(q) dν| ≤ Λ` for all smooth compactly supported
fields `g` with `‖g‖ ≤ 1`, then `∫_{q⁻¹K} h dν = 0` for every compact Lebesgue-null `K ⊆ ℝⁿ`.
Testing with `g = 0` gives `Λ ≥ 0`, and `Submission.cmr_tdn_directional_bound` gives
`|∫ h (a(q + z) − a(q)) dν| ≤ Λ‖z‖` for smooth compactly supported `|a| ≤ 1`.  For `ε > 0`,
averaging over `B_r` with `rΛ ≤ ε` (`Submission.cmr_tdn_ball_average_bound`) gives
`|∫ h a(q) dν| ≤ ε + |B_r|⁻¹ ‖h‖₁ ∫ a` for smooth compactly supported `0 ≤ a ≤ 1`, and
`Submission.cmr_tdn_null_of_average_bound` turns these bounds into the claim. -/
theorem Submission.cmr_null_of_div_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ) (Λ : ℝ), IsFiniteMeasure ν → Measurable q → Integrable h ν → (∀ g : Euclid n → Euclid n, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → (∀ y, ‖g y‖ ≤ 1) → |∫ x, h x * LinearMap.trace ℝ (Euclid n) (fderiv ℝ g (q x)).toLinearMap ∂ν| ≤ Λ) → ∀ K : Set (Euclid n), IsCompact K → volume K = 0 → ∫ x in q ⁻¹' K, h x ∂ν = 0 := by
  intro n X _ ν q h Λ hν hq hh hdiv
  -- `Λ ≥ 0`: the field `g = 0` has divergence `0`
  have hΛ : 0 ≤ Λ := by
    simpa using hdiv (fun _ => 0) contDiff_const HasCompactSupport.zero fun _ => by simp
  -- the translation estimate `|∫ h (a(q + z) − a(q)) dν| ≤ Λ‖z‖`
  have hdir := Submission.cmr_tdn_directional_bound n X ν q h Λ hν hq hh hdiv
  refine Submission.cmr_tdn_null_of_average_bound n X ν q h hq hh fun ε hε => ?_
  -- average over `B_r` with `r = ε / (Λ + 1)`, so that `rΛ ≤ ε`
  obtain ⟨r, hr, hrΛ⟩ : ∃ r : ℝ, 0 < r ∧ r * Λ ≤ ε := by
    refine ⟨ε / (Λ + 1), div_pos hε (by linarith), ?_⟩
    rw [div_mul_eq_mul_div, div_le_iff₀ (by linarith)]
    nlinarith
  refine ⟨(volume (ball (0 : Euclid n) r)).toReal⁻¹ * ∫ x, |h x| ∂ν, fun a ha hac ha0 ha1 => ?_⟩
  have hB := Submission.cmr_tdn_ball_average_bound n X ν q h Λ a r hν hq hh hΛ ha.continuous hac
    ha0 ha1 (hdir a ha hac fun y => abs_le.2 ⟨by linarith [ha0 y], ha1 y⟩) hr
  linarith

/-- **Divergence form of `b · (div g) ∘ p_I` against `θ = dx^I`** (the projection step
`p_I^#((div g) dy) = d(p_I^#γ)` of the mass representation used for Simon 7.2.4).  Let
`p_I x = (x_{I k})_k`, `ι y = ∑ₖ y_k e_{I k}` and `G = ι ∘ g ∘ p_I`, so that
`(DG(x) v)_{I k} = (Dg(p_I x)(p_I v))_k`.  Put `η = b • θ.curryLeft ∘ G` and
`ζ = dη − (b · tr Dg ∘ p_I) • θ`.  The formula for `dη` (`cmr_df_extDeriv_smul_curryLeft`) and
Jacobi's trace identity in coordinates (`cmr_df_cons_sum_trace`) give
`ζ(x)(w) = ∑ᵢ (−1)ⁱ Db(x)(wᵢ) θ(G x, w without wᵢ)`.  Hence `‖η‖ ≤ sup|b| ‖θ‖ ‖ι‖` and
`‖ζ‖ ≤ (m + 1) sup‖Db‖ ‖θ‖ ‖ι‖`, both forms vanish off `tsupport b`, and part (iii) of
`rsd_mw_tfa_norm_props` turns these operator-norm bounds into a coefficient-norm bound `K`
that does not depend on `g`. -/
theorem Submission.cmr_coordinate_divergence_form : ∀ (P m : ℕ) (I : Fin (m + 1) → Fin P) (θ : Covector (Euclid P) (m + 1)) (b : Euclid P → ℝ), StrictMono I → (∀ v : Fin (m + 1) → Euclid P, θ v = Matrix.det (Matrix.of fun k j => v j (I k))) → ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → ∃ K : ℝ, ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → (∀ y, ‖g y‖ ≤ 1) → ∃ (η : DifferentialForm (Euclid P) m) (ζ : DifferentialForm (Euclid P) (m + 1)), IsTestForm η ∧ IsTestForm ζ ∧ tsupport η ⊆ tsupport b ∧ tsupport ζ ⊆ tsupport b ∧ (∀ x, covectorEuclideanNorm (η x) ≤ K) ∧ (∀ x, covectorEuclideanNorm (ζ x) ≤ K) ∧ ∀ x, exteriorDerivative η x = (b x * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap) • θ + ζ x := by
  intro P m I θ b hI hθ hb hbc
  -- the coordinate projection `p = p_I` and the coordinate embedding `ι`, `(ι y)_{I k} = y_k`
  let p : Euclid P →L[ℝ] Euclid (m + 1) := LinearMap.toContinuousLinearMap
    { toFun := fun x => WithLp.toLp 2 (fun k => x (I k))
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  let ι : Euclid (m + 1) →L[ℝ] Euclid P := LinearMap.toContinuousLinearMap
    { toFun := fun y => WithLp.toLp 2 (fun j => ∑ k, if I k = j then y k else 0)
      map_add' := fun y z => by
        ext j
        simp only [PiLp.add_apply, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun k _ => by split_ifs <;> simp
      map_smul' := fun c y => by
        ext j
        simp only [PiLp.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
        exact Finset.sum_congr rfl fun k _ => by split_ifs <;> simp }
  have hι : ∀ y k, ι y (I k) = y k := by
    intro y k
    change (∑ k', if I k' = I k then y k' else 0) = y k
    simp [hI.injective.eq_iff]
  -- the constant `K`: (F1) from `rsd_mw_tfa_norm_props` (iii), `β₀ = sup |b|`, `β₁ = sup ‖Db‖`
  obtain ⟨Cm, hCm0, hCm⟩ := (Submission.rsd_mw_tfa_norm_props P m).2.2.1
  obtain ⟨Cn, hCn0, hCn⟩ := (Submission.rsd_mw_tfa_norm_props P (m + 1)).2.2.1
  obtain ⟨β₀, hβ₀⟩ := hb.continuous.bounded_above_of_compact_support hbc
  obtain ⟨β₁, hβ₁⟩ :=
    (hb.continuous_fderiv (by simp)).bounded_above_of_compact_support (hbc.fderiv ℝ)
  have hβ₀0 : 0 ≤ β₀ := (norm_nonneg _).trans (hβ₀ 0)
  have hβ₁0 : 0 ≤ β₁ := (norm_nonneg _).trans (hβ₁ 0)
  refine ⟨Cm * (β₀ * (‖θ‖ * ‖ι‖)) + Cn * (((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖))), ?_⟩
  intro g hg hg1
  -- the vector field `G = ι ∘ g ∘ p`: smooth, `‖G‖ ≤ ‖ι‖`, `DG(x) = ι ∘ Dg(p x) ∘ p`
  obtain ⟨G, hG⟩ : ∃ G : Euclid P → Euclid P, G = fun x => ι (g (p x)) := ⟨_, rfl⟩
  have hGs : ContDiff ℝ (⊤ : ℕ∞) G := hG ▸ ι.contDiff.comp (hg.comp p.contDiff)
  have hGb : ∀ x, ‖G x‖ ≤ ‖ι‖ := by
    intro x
    rw [hG]
    calc ‖ι (g (p x))‖ ≤ ‖ι‖ * ‖g (p x)‖ := ι.le_opNorm _
      _ ≤ ‖ι‖ * 1 := mul_le_mul_of_nonneg_left (hg1 _) (norm_nonneg _)
      _ = ‖ι‖ := mul_one _
  have hDG : ∀ x v, fderiv ℝ G x v = ι (fderiv ℝ g (p x) (p v)) := by
    intro x v
    have hgd : DifferentiableAt ℝ g (p x) := hg.differentiable (by simp) _
    have h : HasFDerivAt G (ι.comp ((fderiv ℝ g (p x)).comp p)) x := by
      rw [hG]
      exact ι.hasFDerivAt.comp x (hgd.hasFDerivAt.comp x p.hasFDerivAt)
    rw [h.fderiv]
    rfl
  -- `(DG(x) v)_{I k} = (Dg(p x)(p v))_k`, the hypothesis of `cmr_df_cons_sum_trace`
  have hL : ∀ x (v : Euclid P) (k : Fin (m + 1)), fderiv ℝ G x v (I k) =
      (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap
        (WithLp.toLp 2 (fun k' => v (I k'))) k := by
    intro x v k
    rw [hDG, hι]
    rfl
  -- the forms `η = b • θ.curryLeft ∘ G` and `ζ = dη − (b · tr Dg ∘ p) • θ`
  obtain ⟨η, hη⟩ : ∃ η : DifferentialForm (Euclid P) m,
      η = fun y => b y • ContinuousAlternatingMap.curryLeft θ (G y) := ⟨_, rfl⟩
  obtain ⟨ζ, hζ⟩ : ∃ ζ : DifferentialForm (Euclid P) (m + 1),
      ζ = fun x => exteriorDerivative η x - (b x * LinearMap.trace ℝ (Euclid (m + 1))
        (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap) • θ := ⟨_, rfl⟩
  -- Step 1: `η` is a test form with `tsupport η ⊆ tsupport b`
  have hηs : tsupport η ⊆ tsupport b := by
    rw [hη]
    exact tsupport_smul_subset_left b _
  have hηT : IsTestForm η := by
    refine ⟨?_, hbc.mono' ((subset_tsupport η).trans hηs)⟩
    rw [hη]
    exact hb.smul ((ContinuousAlternatingMap.curryLeft θ).contDiff.comp hGs)
  -- Steps 2-4: `dη(x)(w) = Z_x(w) + b(x) S_x(w)` and `S_x(w) = tr Dg(p x) · θ(w)`,
  -- so `ζ(x)(w) = Z_x(w) = ∑ᵢ (−1)ⁱ Db(x)(wᵢ) θ(G x, w without wᵢ)`
  have hζZ : ∀ x (w : Fin (m + 1) → Euclid P), ζ x w = ∑ i : Fin (m + 1),
      (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) * θ (Fin.cons (G x) (i.removeNth w))) := by
    intro x w
    have hbx : DifferentiableAt ℝ b x := hb.differentiable (by simp) x
    have hGx : DifferentiableAt ℝ G x := hGs.differentiable (by simp) x
    have h1 := Submission.cmr_df_extDeriv_smul_curryLeft P m θ b G x hbx hGx w
    have h2 := Submission.cmr_df_cons_sum_trace P m I θ
      (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap (fderiv ℝ G x) hθ (hL x) w
    have h3 : ∑ i : Fin (m + 1), (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
        θ (Fin.cons (G x) (i.removeNth w)) + b x * θ (Fin.cons (fderiv ℝ G x (w i))
          (i.removeNth w))) = ∑ i : Fin (m + 1), (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
        θ (Fin.cons (G x) (i.removeNth w))) + b x * ∑ i : Fin (m + 1), (-1 : ℝ) ^ (i : ℕ) *
          θ (Fin.cons (fderiv ℝ G x (w i)) (i.removeNth w)) := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [hζ]
    simp only [ContinuousAlternatingMap.sub_apply, ContinuousAlternatingMap.smul_apply,
      smul_eq_mul]
    rw [hη, h1, h3, h2]
    ring
  -- Step 4: `ζ` is a test form with `tsupport ζ ⊆ tsupport b`
  have hζsupp : support ζ ⊆ tsupport b := by
    intro x hx
    by_contra hxb
    have hbx : b x = 0 := image_eq_zero_of_notMem_tsupport hxb
    have hdη : exteriorDerivative η x = 0 := image_eq_zero_of_notMem_tsupport fun h =>
      hxb (hηs (tsupport_exteriorDerivative_subset η h))
    exact hx (by rw [hζ]; simp [hbx, hdη])
  have hζs : tsupport ζ ⊆ tsupport b := closure_minimal hζsupp (isClosed_tsupport b)
  have hζT : IsTestForm ζ := by
    refine ⟨?_, hbc.mono' hζsupp⟩
    let tr : (Euclid (m + 1) →L[ℝ] Euclid (m + 1)) →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
      (LinearMap.trace ℝ (Euclid (m + 1)) ∘ₗ ContinuousLinearMap.coeLM ℝ)
    have htr : ContDiff ℝ (⊤ : ℕ∞) fun x : Euclid P => LinearMap.trace ℝ (Euclid (m + 1))
        (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap :=
      tr.contDiff.comp ((hg.fderiv_right (m := (⊤ : ℕ∞)) (by simp)).comp p.contDiff)
    rw [hζ]
    exact (exteriorDerivative_isTestForm hηT).1.sub ((hb.mul htr).smul contDiff_const)
  -- Step 5: operator-norm bounds, independent of `g`
  have hη_op : ∀ x, ‖η x‖ ≤ β₀ * (‖θ‖ * ‖ι‖) := by
    intro x
    rw [hη, norm_smul]
    refine mul_le_mul (hβ₀ x) ?_ (norm_nonneg _) hβ₀0
    calc ‖ContinuousAlternatingMap.curryLeft θ (G x)‖
        ≤ ‖ContinuousAlternatingMap.curryLeft θ‖ * ‖G x‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ ‖θ‖ * ‖ι‖ := by
        rw [ContinuousAlternatingMap.norm_curryLeft]
        exact mul_le_mul_of_nonneg_left (hGb x) (norm_nonneg _)
  have hζ_op : ∀ x, ‖ζ x‖ ≤ ((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖)) := by
    intro x
    refine ContinuousAlternatingMap.opNorm_le_bound _ (by positivity) fun w => ?_
    rw [hζZ x w]
    have hterm : ∀ i : Fin (m + 1), ‖(-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
        θ (Fin.cons (G x) (i.removeNth w)))‖ ≤ β₁ * (‖θ‖ * ‖ι‖) * ∏ j, ‖w j‖ := by
      intro i
      have h1 : ‖fderiv ℝ b x (w i)‖ ≤ β₁ * ‖w i‖ :=
        ((fderiv ℝ b x).le_opNorm _).trans (mul_le_mul_of_nonneg_right (hβ₁ x) (norm_nonneg _))
      have h2 : ‖θ (Fin.cons (G x) (i.removeNth w))‖ ≤
          ‖θ‖ * ‖ι‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖ := by
        calc ‖θ (Fin.cons (G x) (i.removeNth w))‖
            ≤ ‖θ‖ * ∏ j : Fin (m + 1),
                ‖(Fin.cons (G x) (i.removeNth w) : Fin (m + 1) → Euclid P) j‖ :=
              θ.le_opNorm _
          _ = ‖θ‖ * (‖G x‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖) := by
              rw [Fin.prod_univ_succ]
              simp [Fin.removeNth_apply]
          _ ≤ ‖θ‖ * (‖ι‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖) := by
              gcongr
              exact hGb x
          _ = ‖θ‖ * ‖ι‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖ := by ring
      calc ‖(-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) * θ (Fin.cons (G x) (i.removeNth w)))‖
          = ‖fderiv ℝ b x (w i)‖ * ‖θ (Fin.cons (G x) (i.removeNth w))‖ := by
            simp [norm_mul]
        _ ≤ (β₁ * ‖w i‖) * (‖θ‖ * ‖ι‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖) :=
            mul_le_mul h1 h2 (norm_nonneg _) (by positivity)
        _ = β₁ * (‖θ‖ * ‖ι‖) * (‖w i‖ * ∏ j : Fin m, ‖w (i.succAbove j)‖) := by ring
        _ = β₁ * (‖θ‖ * ‖ι‖) * ∏ j, ‖w j‖ := by
            rw [Fin.prod_univ_succAbove (fun j => ‖w j‖) i]
    calc ‖∑ i : Fin (m + 1), (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
          θ (Fin.cons (G x) (i.removeNth w)))‖
        ≤ ∑ i : Fin (m + 1), ‖(-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) *
          θ (Fin.cons (G x) (i.removeNth w)))‖ := norm_sum_le _ _
      _ ≤ ∑ _i : Fin (m + 1), β₁ * (‖θ‖ * ‖ι‖) * ∏ j, ‖w j‖ :=
          Finset.sum_le_sum fun i _ => hterm i
      _ = ((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖)) * ∏ j, ‖w j‖ := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        push_cast
        ring
  -- Steps 5-6: coefficient-norm bounds by (F1), and the identity, by definition of `ζ`
  have hK1 : 0 ≤ Cm * (β₀ * (‖θ‖ * ‖ι‖)) := by positivity
  have hK2 : 0 ≤ Cn * (((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖))) := by positivity
  refine ⟨η, ζ, hηT, hζT, hηs, hζs, fun x => ?_, fun x => ?_, fun x => ?_⟩
  · calc covectorEuclideanNorm (η x) ≤ Cm * ‖η x‖ := hCm _
      _ ≤ Cm * (β₀ * (‖θ‖ * ‖ι‖)) := mul_le_mul_of_nonneg_left (hη_op x) hCm0
      _ ≤ _ := le_add_of_nonneg_right hK2
  · calc covectorEuclideanNorm (ζ x) ≤ Cn * ‖ζ x‖ := hCn _
      _ ≤ Cn * (((m : ℝ) + 1) * (β₁ * (‖θ‖ * ‖ι‖))) := mul_le_mul_of_nonneg_left (hζ_op x) hCn0
      _ ≤ _ := le_add_of_nonneg_left hK1
  · rw [hζ]
    exact (add_sub_cancel _ _).symm

/-- **Simon 6.2.36** (`μ_T` charges no `Hⁿ`-null set when `M_W(∂T) < ∞` for `W ⊂⊂ U`): if
`T(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|⟨α, ξ⟩| ≤ |α|`, `M_W(T) = μ(W)` and `μ` lives on `U`, then
`Hⁿ(E) = 0` implies `μ(E) = 0`.  For `n = 0`, `H⁰` is counting measure, so `E = ∅`.  For
`n = m + 1` it suffices to treat a compact `Hⁿ`-null `C ⊆ U`; take an open `W ⊂⊂ U` around `C`.
For each strictly increasing `I`, the coordinate projection `q_I` maps `C` onto a compact
Lebesgue-null `N ⊆ ℝⁿ`, and the coordinate divergence forms give
`|∫ b ⟨θ_I, ξ⟩ div g(q_I) dμ⌞W| ≤ K_b (M_W(∂T) + M_W(T))` uniformly in `‖g‖ ≤ 1`.  Hence
`⟨θ_I, ξ⟩ = 0` `μ`-a.e. on `W ∩ q_I⁻¹(N) ⊇ C`; the coordinate covectors `θ_I` determine `ξ`, so
`ξ = 0` `μ`-a.e. on `C`, and `M_W(T) = μ(W)` forces `μ(C) = 0`. -/
theorem Submission.cmr_null_of_representation : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → μ Uᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0 := by
  intro P n U T μ ξ hU hB hUc hK hmass hξm hξ hT
  -- Step 9: it suffices to treat compact `Hⁿ`-null subsets of `U`
  refine Submission.cmr_null_of_compact_null P U μ μHE[n] hU hUc hK ?_
  intro C hC hCU hC0
  cases n with
  | zero =>
    -- Step 1: `H⁰` is counting measure, so `C = ∅`
    rw [Measure.euclideanHausdorffMeasure_zero] at hC0
    have hCe : C = ∅ := eq_empty_of_forall_notMem fun x hx => by
      simpa [hC0] using measure_mono (μ := (μH[0] : Measure (Euclid P))) (singleton_subset_iff.2 hx)
    rw [hCe, measure_empty]
  | succ m =>
    -- Step 2: an open `W ⊂⊂ U` around `C`, of finite mass and boundary mass
    obtain ⟨δ, hδ, hδU⟩ := hC.exists_cthickening_subset_open hU hCU
    have hWo : IsOpen (thickening δ C) := isOpen_thickening
    have hCW : C ⊆ thickening δ C := self_subset_thickening hδ C
    have hWcl : closure (thickening δ C) ⊆ cthickening δ C :=
      closure_thickening_subset_cthickening δ C
    have hWc : CompactlyContained (thickening δ C) U :=
      ⟨hC.cthickening.of_isClosed_subset isClosed_closure hWcl, hWcl.trans hδU⟩
    have hWU : thickening δ C ⊆ U := subset_closure.trans hWc.2
    have hμW : μ (thickening δ C) < ∞ :=
      (measure_mono subset_closure).trans_lt (hK _ hWc.1 hWc.2)
    have hTW : T.massOn (thickening δ C) = μ (thickening δ C) := hmass _ hWo
    have hTW' : T.massOn (thickening δ C) ≠ ∞ := by rw [hTW]; exact hμW.ne
    have hbd : T.boundary.massOn (thickening δ C) ≠ ∞ := (hB _ hWo hWc).ne
    -- Steps 3–6: `⟨θ_I, ξ⟩ = 0` `μ`-a.e. on `C` for each coordinate covector `θ_I`
    obtain ⟨hθex, hspan⟩ := Submission.cmr_coordinate_covectors_span P (m + 1)
    choose θI hθI using hθex
    have hcoord : ∀ I : Fin (m + 1) → Fin P, StrictMono I →
        ∀ᵐ x ∂μ, x ∈ C → ξ x (θI I) = 0 := by
      intro I hI
      set q : Euclid P → Euclid (m + 1) := fun x => WithLp.toLp 2 (fun k => x (I k))
      have hqc : Continuous q := by fun_prop
      have hN : IsCompact (q '' C) := hC.image hqc
      have hNv : volume (q '' C) = 0 :=
        Submission.cmr_volume_coordProj_image_null P (m + 1) I C hI.injective hC0
      have h := Submission.cmr_ae_zero_of_div_bounds P (m + 1) (thickening δ C) μ
        (fun x => ξ x (θI I)) q (q '' C) (covectorEuclideanNorm (θI I)) hWo hμW
        (hξm.apply_continuousLinearMap _) (fun x => hξ x _) hqc.measurable hN.measurableSet
        (fun ν h Λ hν hh hΛ => Submission.cmr_null_of_div_bound (m + 1) (Euclid P) ν q h Λ hν
          hqc.measurable hh hΛ (q '' C) hN hNv) ?_
      · filter_upwards [h] with x hx hxC
        exact hx (hCW hxC) (mem_image_of_mem q hxC)
      · -- Step 4: the divergence bound, uniformly in `g`
        intro b hb hbc hbW
        obtain ⟨K, hK⟩ :=
          Submission.cmr_coordinate_divergence_form P m I (θI I) b hI (hθI I) hb hbc
        refine ⟨K * ((T.boundary.massOn (thickening δ C)).toReal +
          (T.massOn (thickening δ C)).toReal), fun g hg _ hg1 => ?_⟩
        obtain ⟨η, ζ, hη, hζ, hηb, hζb, hηK, hζK, hd⟩ := hK g hg hg1
        exact Submission.cmr_abs_integral_div_le_mass P m U (thickening δ C) T μ ξ (θI I) b
          (fun x => LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g (q x)).toLinearMap) η ζ K
          hWU hTW' hbd hT (fun k S ω r => Submission.cmr_abs_apply_le_massOn P k U _ S ω r)
          hbW hη hζ hηb hζb hηK hζK hd
    -- Step 7: the coordinate covectors determine `ξ`, so `ξ = 0` `μ`-a.e. on `C`
    have hξC : ∀ᵐ x ∂μ, x ∈ C → ξ x = 0 := by
      have hall : ∀ᵐ x ∂μ, ∀ I : Fin (m + 1) → Fin P, StrictMono I → x ∈ C →
          ξ x (θI I) = 0 := by
        rw [ae_all_iff]
        intro I
        by_cases hI : StrictMono I
        · filter_upwards [hcoord I hI] with x hx _ using hx
        · exact ae_of_all _ fun x h => absurd h hI
      filter_upwards [hall] with x hx hxC
      refine hspan (ξ x) fun I θ hI hθ => ?_
      rw [show θ = θI I from ContinuousAlternatingMap.ext fun v => by rw [hθ, hθI]]
      exact hx I hI hxC
    -- Step 8: `M_W(T) = μ(W)` and `ξ = 0` a.e. on `C` force `μ(C) = 0`
    exact Submission.cmr_measure_null_of_orient_ae_zero P (m + 1) U (thickening δ C) C T μ ξ
      hWo.measurableSet hC.measurableSet hCW hμW hTW hξ hT hξC

/-- **The mass measure and orientation of a current of locally finite mass** (Simon Ch. 6,
2.7–2.8, with the absolute continuity 2.36; `|·|` is `covectorEuclideanNorm`).  Part I is the
Riesz representation `Submission.cmr_exists_massRepresentation_core`.  It gives a Borel measure
`μ = μ_T` with `μ(ℝᴾ ∖ U) = 0`, `μ` finite on compact subsets of `U` and `μ(W) = M_W(T)` for open
`W`, and an a.e. strongly measurable field `ξ` of `n`-vectors with `|⟨α, ξ(x)⟩| ≤ |α|` and
`T(ω) = ∫ ⟨ω, ξ⟩ dμ`.  Part II is `Submission.cmr_null_of_representation`, Simon's projection
argument.  If moreover `M_W(∂T) < ∞` for every open `W ⊂⊂ U`, every such pair `(μ, ξ)` satisfies
`μ(E) = 0` whenever `Hⁿ(E) = 0`. -/
theorem Submission.cmc_exists_massRepresentation : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0) := by
  intro P n U T hU hmass
  -- Part I (Simon 6.2.7–2.8): `T = ξ μ` with `μ(W) = M_W(T)` for every open `W`
  obtain ⟨μ, ξ, hμU, hμK, hμW, hξm, hξ1, hTξ⟩ :=
    Submission.cmr_exists_massRepresentation_core P n U T hU hmass
  refine ⟨μ, ξ, hμU, hμK, hμW, hξm, hξ1, hTξ, fun hbd => ?_⟩
  -- Part II (Simon 6.2.36): if also `M_W(∂T) < ∞` for all open `W ⊂⊂ U`, then `μ ≪ Hⁿ`
  exact Submission.cmr_null_of_representation P n U T μ ξ hU hbd hμU hμK hμW hξm hξ1 hTξ

/-- A `0`-current minimizing in `U` vanishes (Simon 7.1.1 with `n = 0`, where `∂S = ∂T` is
vacuous).  Write `T = τ(M, θ, ξ)` and suppose `p ∈ M`; choose `B̄_r(p) ⊆ U` and `W = B_r(p)`.
Deleting `p` gives the integer multiplicity competitor
`S = T − θ(p) ⟨·(p), ξ(p)⟩ = τ(M ∖ {p}, θ, ξ)` with `spt(S − T) ⊆ {p}`.  By
`cmc_massOn_eq_imRep_measure`, `M_W(T) = M_W(S) + θ(p)` with `M_W(S) ≤ ∫_{M ∩ B̄_r(p)} θ dH⁰ < ∞`,
so `θ(p) ≥ 1` contradicts minimality.  Hence `M = ∅` and `T = 0`. -/
theorem Submission.cmc_zeroDim_minimizing_eq_zero : ∀ (P : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U 0), IsOpen U → IsMinimizingIn T U → T = 0 := by
  intro P U T hU hmin
  obtain ⟨R, hR⟩ := hmin.1
  -- deleting any `p ∈ M` would decrease `M_W(T)`, so `M = ∅`
  have hempty : R.carrier = ∅ := by
    refine Set.eq_empty_iff_forall_notMem.2 fun p hp => ?_
    -- `W = B_r(p)` with `B̄_r(p) ⊆ U`, so `W ⊂⊂ U`
    obtain ⟨r, hr, hrU⟩ :=
      Metric.nhds_basis_closedBall.mem_iff.1 (hU.mem_nhds (R.carrier_subset hp))
    have hW : CompactlyContained (ball p r) U :=
      ⟨(isCompact_closedBall p r).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall, closure_ball_subset_closedBall.trans hrU⟩
    -- `R' = (M ∖ {p}, θ, ξ)`: `μ_R = μ_{R'} + θ(p) δ_p` and `τ_R = τ_{R'} + θ(p) ⟨·(p), ξ(p)⟩`
    obtain ⟨R', -, -, -, hmeas, hact⟩ := Submission.dtc_dim_zero_erase_point P U R p hp
    -- the point current `X(ω) = θ(p) ⟨ω(p), ξ(p)⟩`, with `spt X ⊆ {p}`
    obtain ⟨X, hX, hXspt⟩ :=
      Submission.dtc_point_current P 0 U p ((R.mult p : ℝ) • R.orient p) hU
    -- the competitor `S = T − X` is represented by `R'`
    have hS : R'.Represents (T - X) := fun ω => by
      show T ω - X ω = _
      rw [hR ω, hX ω, hact ω, smul_apply, smul_eq_mul, add_sub_cancel_right]
    -- `S − T = −X` vanishes wherever `X` does, so `spt(S − T) ⊆ spt X ⊆ {p}`
    have hspt : (T - X - T).support ⊆ {p} := by
      refine fun x hx => hXspt ⟨hx.1, fun hxX => hx.2 ?_⟩
      obtain ⟨V, ⟨hVo, hVc, hVU, hXV⟩, hxV⟩ := hxX
      refine ⟨V, ⟨hVo, hVc, hVU, fun ω hω => ?_⟩, hxV⟩
      show T ω - X ω - T ω = 0
      rw [hXV ω hω, sub_zero, sub_self]
    have hle := hmin.2 (ball p r) (T - X) isOpen_ball hW ⟨R', hS⟩ trivial
      ((Set.finite_singleton p).subset hspt).isCompact
      (hspt.trans (Set.singleton_subset_iff.2 ⟨R.carrier_subset hp, mem_ball_self hr⟩))
    -- `μ_{R'}(W) ≤ μ_R(B̄_r(p)) = ∫_{M ∩ B̄_r(p)} θ dH⁰ < ∞`
    have hfin : R'.measure (ball p r) ≠ ∞ := by
      refine ne_top_of_le_ne_top ?_ (calc
        R'.measure (ball p r) ≤ R'.measure (closedBall p r) := measure_mono ball_subset_closedBall
        _ ≤ R'.measure (closedBall p r) + ((R.mult p : ℝ≥0∞) • Measure.dirac p) (closedBall p r) :=
          le_self_add
        _ = R.measure (closedBall p r) := by rw [hmeas, Measure.add_apply])
      rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
        Measure.restrict_restrict measurableSet_closedBall, Set.inter_comm]
      exact R.locallyIntegrable_mult _ (isCompact_closedBall p r) hrU
    -- `M_W(T) = μ_{R'}(W) + θ(p)` and `M_W(S) = μ_{R'}(W)`, so `θ(p) = 0`
    rw [Submission.cmc_massOn_eq_imRep_measure P 0 U T R hU hR (ball p r) isOpen_ball,
      Submission.cmc_massOn_eq_imRep_measure P 0 U (T - X) R' hU hS (ball p r) isOpen_ball,
      hmeas, Measure.add_apply, Measure.smul_apply, Measure.dirac_apply_of_mem (mem_ball_self hr),
      smul_eq_mul, mul_one] at hle
    have h0 : (R.mult p : ℝ≥0∞) ≤ 0 := ENNReal.le_of_add_le_add_left hfin (by rwa [add_zero])
    exact (R.mult_pos p hp).ne' (by exact_mod_cast nonpos_iff_eq_zero.1 h0)
  -- `T(ω) = ∫_∅ θ ⟨ω, ξ⟩ dH⁰ = 0`
  ext ω
  rw [hR ω, GeometricCurrentOn.zero_apply, IMRep.action, hempty, Measure.restrict_empty,
    integral_zero_measure]
/-- **Convergence of superlevel-set measures at almost every level** (the "standard
approximation argument" ending Simon's proof of 7.2.4, from (13) and (14)).  Let `μ` be finite
on compact subsets of `U`, with `limsup μⱼ(K) ≤ μ(K)` for compact `K ⊆ U` and
`μ(G) ≤ liminf μⱼ(G)` for open `G ⊆ U`.  If `g` is continuous with compact support in `U`,
then `μⱼ{g > t} → μ{g > t}` for a.e. `t > 0`.  Only countably many levels `{g = t}` carry
positive mass for the finite measure `μ⌞tsupport g`.  For any other `t > 0`, `{g > t}` is open,
`{g ≥ t}` is compact, both lie in `tsupport g ⊆ U`, and they have the same `μ`-measure. -/
theorem Submission.cmc_rcc_ae_tendsto_measure_superlevel : ∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs j G) atTop) → ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → tsupport g ⊆ U → ∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), Tendsto (fun j => μs j {x | t < g x}) atTop (𝓝 (μ {x | t < g x})) := by
  intro P U μs μ hfin hsup hinf g hg hgc hgU
  -- step 1: `μ⌞tsupport g` is a finite measure
  have : IsFiniteMeasure (μ.restrict (tsupport g)) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hfin _ hgc.isCompact hgU⟩
  -- step 2: only countably many levels `{g = s}` have positive `μ⌞tsupport g`-measure
  have hD := Measure.countable_meas_level_set_pos (μ := μ.restrict (tsupport g)) hg.measurable
  -- step 3: a.e. `t` is positive and outside that countable set
  filter_upwards [hD.ae_notMem _, ae_restrict_mem measurableSet_Ioi] with t htD ht
  have ht0 : (0 : ℝ) < t := ht
  -- step 4: `G = {g > t}` is open, `K = {g ≥ t}` is compact, `G ⊆ K ⊆ tsupport g ⊆ U`
  have hKC : {x | t ≤ g x} ⊆ tsupport g := fun x (hx : t ≤ g x) =>
    subset_tsupport g (show g x ≠ 0 from (ht0.trans_le hx).ne')
  have hGK : {x | t < g x} ⊆ {x | t ≤ g x} := fun x (hx : t < g x) => hx.le
  have hGo : IsOpen {x | t < g x} := isOpen_lt continuous_const hg
  have hKc : IsCompact {x | t ≤ g x} :=
    hgc.isCompact.of_isClosed_subset (isClosed_le continuous_const hg) hKC
  -- step 5: `μ K = μ G`, because `K \ G = {g = t}` is `μ`-null
  have hLC : {x | g x = t} ⊆ tsupport g := fun x (hx : g x = t) =>
    subset_tsupport g (show g x ≠ 0 by rw [hx]; exact ht0.ne')
  have hlev : μ {x | g x = t} = 0 := by
    rw [← Measure.restrict_eq_self μ hLC]
    exact nonpos_iff_eq_zero.1 (not_lt.1 htD)
  have hKG : μ {x | t ≤ g x} = μ {x | t < g x} := by
    refine le_antisymm ?_ (measure_mono hGK)
    calc μ {x | t ≤ g x} ≤ μ ({x | t < g x} ∪ {x | g x = t}) :=
          measure_mono fun x (hx : t ≤ g x) => hx.lt_or_eq.imp id Eq.symm
      _ ≤ μ {x | t < g x} + μ {x | g x = t} := measure_union_le _ _
      _ = μ {x | t < g x} := by rw [hlev, add_zero]
  -- step 6: squeeze `limsup μⱼ G ≤ limsup μⱼ K ≤ μ K = μ G ≤ liminf μⱼ G`
  refine tendsto_of_le_liminf_of_limsup_le (hinf _ hGo (hGK.trans (hKC.trans hgU))) ?_
  calc limsup (fun j => μs j {x | t < g x}) atTop
      ≤ limsup (fun j => μs j {x | t ≤ g x}) atTop :=
        limsup_le_limsup (Eventually.of_forall fun j => measure_mono hGK)
    _ ≤ μ {x | t ≤ g x} := hsup _ hKc (hKC.trans hgU)
    _ = μ {x | t < g x} := hKG
/-- **Layer-cake convergence** (the "standard approximation argument" ending Simon's proof of
7.2.4, chapter-07.txt lines 284–289).  Let `g ≥ 0` be continuous with compact support,
`C = tsupport g`, `μ(C) < ∞` and `limsup_j μ_j(C) < ∞`.  If `μ_j{g > t} → μ{g > t}` for a.e.
`t > 0`, then `∫ g dμ_j → ∫ g dμ`.  For `ν(C) < ∞`, `g` is `ν`-integrable and
`∫ g dν = ∫_{(0,∞)} ν{g > t} dt` (layer cake).  Pick `Λ` with `limsup_j μ_j(C) < Λ < ∞`; for
large `j` the distribution functions are dominated by `Λ·1_{t ≤ b}` (`g ≤ b`), so dominated
convergence applies. -/
theorem Submission.cmc_rcc_tendsto_integral_of_ae_tendsto_superlevel : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)) (g : Euclid P → ℝ), Continuous g → HasCompactSupport g → (∀ x, 0 ≤ g x) → μ (tsupport g) < ∞ → limsup (fun j => μs j (tsupport g)) atTop < ∞ → (∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), Tendsto (fun j => μs j {x | t < g x}) atTop (𝓝 (μ {x | t < g x}))) → Tendsto (fun j => ∫ x, g x ∂(μs j)) atTop (𝓝 (∫ x, g x ∂μ)) := by
  intro P μs μ g hg hgc hg0 hμ hlim hae
  -- `g ≤ ‖g‖ ≤ b`
  obtain ⟨b, hb⟩ := hg.bounded_above_of_compact_support hgc
  -- `μ_j(C) < Λ < ∞` for all large `j`
  obtain ⟨Λ, hΛ, hΛtop⟩ := exists_between hlim
  have hev : ∀ᶠ j in atTop, μs j (tsupport g) < Λ := eventually_lt_of_limsup_lt hΛ
  -- layer cake for every `ν` with `ν(C) < ∞`, for which `g` is integrable
  have hlc : ∀ ν : Measure (Euclid P), ν (tsupport g) < ∞ →
      ∫ x, g x ∂ν = ∫ t in Ioi 0, ν.real {x | t < g x} := fun ν hν =>
    ((integrableOn_iff_integrable_of_support_subset (subset_tsupport g)).mp
      (hg.continuousOn.integrableOn_of_subset_isCompact hgc (isClosed_tsupport g).measurableSet
        subset_rfl hν.ne)).integral_eq_integral_meas_lt (Eventually.of_forall hg0)
  -- `{g > t} ⊆ C` for `t > 0`
  have hsub : ∀ t : ℝ, 0 < t → {x | t < g x} ⊆ tsupport g := fun t ht x hx =>
    subset_tsupport g (ht.trans (show t < g x from hx)).ne'
  rw [hlc μ hμ]
  refine Tendsto.congr' (f₁ := fun j => ∫ t in Ioi 0, (μs j).real {x | t < g x}) ?_ ?_
  · filter_upwards [hev] with j hj
    exact (hlc (μs j) (hj.trans hΛtop)).symm
  -- dominated convergence with the bound `Λ·1_{(-∞, b]}`
  refine tendsto_integral_filter_of_dominated_convergence (indicator (Iic b) fun _ => Λ.toReal)
    ?_ ?_ ?_ ?_
  · refine Eventually.of_forall fun j => ?_
    have hanti : Antitone fun t : ℝ => μs j {x | t < g x} := fun s t hst =>
      measure_mono fun x hx => lt_of_le_of_lt hst hx
    exact hanti.measurable.ennreal_toReal.aestronglyMeasurable
  · filter_upwards [hev] with j hj
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    rw [Real.norm_eq_abs, abs_of_nonneg measureReal_nonneg]
    by_cases htb : t ≤ b
    · rw [indicator_of_mem (show t ∈ Iic b from htb)]
      exact ENNReal.toReal_mono hΛtop.ne ((measure_mono (hsub t ht)).trans hj.le)
    · have hempty : {x | t < g x} = ∅ := eq_empty_of_forall_notMem fun x hx =>
        htb (((show t < g x from hx).le.trans (Real.le_norm_self _)).trans (hb x))
      rw [hempty, measureReal_empty, indicator_of_notMem (show t ∉ Iic b from htb)]
  · rw [integrable_indicator_iff measurableSet_Iic]
    refine integrableOn_const ?_
    rw [Measure.restrict_apply measurableSet_Iic]
    exact ((measure_mono fun t ht => ⟨ht.2, ht.1⟩ :
      volume (Iic b ∩ Ioi 0) ≤ volume (Ioc 0 b)).trans_lt measure_Ioc_lt_top).ne
  · filter_upwards [hae, ae_restrict_mem measurableSet_Ioi] with t ht htpos
    exact (ENNReal.tendsto_toReal ((measure_mono (hsub t htpos)).trans_lt hμ).ne).comp ht

/-- **Simon 7.2.4** (proof, last sentence: from (13) and (14) "it now easily follows (by a
standard approximation argument) that `∫ f dμ_{Tⱼ} → ∫ f dμ_T`"): if `μ(K) < ∞` and
`limsup_j μ_j(K) ≤ μ(K)` for compact `K ⊆ U`, and `μ(G) ≤ liminf_j μ_j(G)` for open `G ⊆ U`, then
`∫ f dμ_j → ∫ f dμ` for every continuous `f` with compact support in `U`.  Split `f = f⁺ − f⁻`;
for each part the superlevel-set measures converge at a.e. level
(`cmc_rcc_ae_tendsto_measure_superlevel`), hence so do the integrals (layer cake and dominated
convergence, `cmc_rcc_tendsto_integral_of_ae_tendsto_superlevel`). -/
theorem Submission.cmc_tendsto_integral_of_limsup_liminf : ∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs j G) atTop) → ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(μs j)) atTop (𝓝 (∫ x, f x ∂μ)) := by
  intro P U μs μ hfin hsup hinf f hf hfc hfU
  -- Step 1: `C = spt f` is compact and `C ⊆ U`, so `μ(C) < ∞` and `limsup_j μ_j(C) < ∞`;
  -- hence `μ_j(C) < ∞` for all large `j`
  have hμC : μ (tsupport f) < ∞ := hfin _ hfc hfU
  have hlimC : limsup (fun j => μs j (tsupport f)) atTop < ∞ := (hsup _ hfc hfU).trans_lt hμC
  have hμsC : ∀ᶠ j in atTop, μs j (tsupport f) < ∞ := eventually_lt_of_limsup_lt hlimC
  -- a continuous function vanishing outside `C` is `ν`-integrable whenever `ν(C) < ∞`
  have hint : ∀ (ν : Measure (Euclid P)) (g : Euclid P → ℝ), ν (tsupport f) < ∞ → Continuous g →
      support g ⊆ support f → Integrable g ν := by
    intro ν g hν hg hgf
    have : IsFiniteMeasure (ν.restrict (tsupport f)) := ⟨by rwa [Measure.restrict_apply_univ]⟩
    exact (integrableOn_iff_integrable_of_support_subset (hgf.trans (subset_tsupport f))).1
      (hg.integrable_of_hasCompactSupport (hfc.mono hgf))
  -- Steps 3–5: for continuous `g ≥ 0` vanishing outside `C`, `∫ g dμ_j → ∫ g dμ`
  have hpos : ∀ g : Euclid P → ℝ, Continuous g → (∀ x, 0 ≤ g x) → support g ⊆ support f →
      Tendsto (fun j => ∫ x, g x ∂(μs j)) atTop (𝓝 (∫ x, g x ∂μ)) := by
    intro g hg hg0 hgf
    have hgC : tsupport g ⊆ tsupport f := closure_mono hgf
    have hgc : HasCompactSupport g := hfc.mono hgf
    exact Submission.cmc_rcc_tendsto_integral_of_ae_tendsto_superlevel P μs μ g hg hgc hg0
      ((measure_mono hgC).trans_lt hμC)
      ((limsup_le_limsup (Eventually.of_forall fun j => measure_mono hgC)).trans_lt hlimC)
      (Submission.cmc_rcc_ae_tendsto_measure_superlevel P U μs μ hfin hsup hinf g hg hgc
        (hgC.trans hfU))
  -- Steps 2 and 6: `f = f⁺ − f⁻`, with `∫ f dν = ∫ f⁺ dν − ∫ f⁻ dν` whenever `ν(C) < ∞`
  have hfp : Continuous fun x => max (f x) 0 := hf.max continuous_const
  have hfm : Continuous fun x => max (-f x) 0 := hf.neg.max continuous_const
  have hsupp_pos : support (fun x => max (f x) 0) ⊆ support f :=
    support_comp_subset (g := fun y : ℝ => max y 0) (max_self 0) f
  have hsupp_neg : support (fun x => max (-f x) 0) ⊆ support f :=
    support_comp_subset (g := fun y : ℝ => max (-y) 0) (by simp) f
  have hsplit : ∀ ν : Measure (Euclid P), ν (tsupport f) < ∞ →
      ∫ x, max (f x) 0 ∂ν - ∫ x, max (-f x) 0 ∂ν = ∫ x, f x ∂ν := by
    intro ν hν
    rw [← integral_sub (hint ν _ hν hfp hsupp_pos) (hint ν _ hν hfm hsupp_neg)]
    simp only [max_zero_sub_max_neg_zero_eq_self]
  have hlim := (hpos _ hfp (fun x => le_max_right _ _) hsupp_pos).sub
    (hpos _ hfm (fun x => le_max_right _ _) hsupp_neg)
  rw [hsplit μ hμC] at hlim
  exact hlim.congr' (hμsC.mono fun j hj => hsplit (μs j) hj)
/-- **Simon 7.2.4, proof, remark after (8)** (p. 186): minimality localizes.  Let `S, T` be
integer multiplicity in the open set `U`, `spt(S − T) ⊆ K` with `K` compact, `K ⊆ W ⊆ W'` open
and `W' ⊂⊂ U`.  If `M_W(T) ≤ M_W(S)` then `M_{W'}(T) ≤ M_{W'}(S)`.  With `T = τ(M, θ, ξ)` and
`S = τ(M', θ', ξ')`, masses on open sets are the measures `μ_T`, `μ_S`
(`cmc_massOn_eq_imRep_measure`).  `S = T` on test forms supported in `O = U \ K`, so
`μ_S = μ_T` on open subsets of `O`, hence (as `μ_S` is finite on compact subsets of `O`) on the
Borel set `W' \ W ⊆ O`, and `μ_T(W') = μ_T(W) + μ_T(W' \ W) ≤ μ_S(W) + μ_S(W' \ W) = μ_S(W')`. -/
theorem Submission.cmc_massOn_le_of_le_near_support : ∀ (P n : ℕ) (U : Set (Euclid P)) (S T : GeometricCurrentOn U n) (K W W' : Set (Euclid P)), IsOpen U → IsIntegerMultiplicity S → IsIntegerMultiplicity T → IsCompact K → (S - T).support ⊆ K → IsOpen W → IsOpen W' → K ⊆ W → W ⊆ W' → CompactlyContained W' U → T.massOn W ≤ S.massOn W → T.massOn W' ≤ S.massOn W' := by
  intro P n U S T K W W' hU hS hT hK hSTK hW hW' hKW hWW' hW'U hle
  obtain ⟨RS, hRS⟩ := hS
  obtain ⟨RT, hRT⟩ := hT
  -- masses on open sets are the representation measures `μ_S`, `μ_T`
  have hμS : ∀ G : Set (Euclid P), IsOpen G → S.massOn G = RS.measure G :=
    Submission.cmc_massOn_eq_imRep_measure P n U S RS hU hRS
  have hμT : ∀ G : Set (Euclid P), IsOpen G → T.massOn G = RT.measure G :=
    Submission.cmc_massOn_eq_imRep_measure P n U T RT hU hRT
  -- `O = U \ K` is open, and `μ_S(C) = ∫_{M' ∩ C} θ' dHⁿ < ∞` for compact `C ⊆ O ⊆ U`
  have hO : IsOpen (U \ K) := hU.sdiff hK.isClosed
  have hfin : ∀ C : Set (Euclid P), IsCompact C → C ⊆ U \ K → RS.measure C ≠ ∞ := by
    intro C hC hCO
    rw [IMRep.measure, withDensity_apply _ hC.measurableSet,
      Measure.restrict_restrict hC.measurableSet, inter_comm]
    exact RS.locallyIntegrable_mult C hC (hCO.trans sdiff_subset)
  -- `μ_S(G) = M_G(S) = M_G(T) = μ_T(G)` for open `G ⊆ O`, as `G` misses `spt(S − T) ⊆ K`
  have hopen : ∀ G : Set (Euclid P), IsOpen G → G ⊆ U \ K → RS.measure G = RT.measure G := by
    intro G hG hGO
    rw [← hμS G hG, ← hμT G hG]
    exact Submission.cmc_ml_massOn_eq_of_disjoint_sub_support P n U S T K G hSTK
      (Set.disjoint_left.2 fun x hx => (hGO hx).2)
  -- hence `μ_S = μ_T` on the Borel set `W' \ W ⊆ O` (`W' ⊆ closure W' ⊆ U` and `K ⊆ W`)
  have hdiff : RS.measure (W' \ W) = RT.measure (W' \ W) :=
    Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P (U \ K) RS.measure RT.measure hO hfin
      hopen (W' \ W) (hW'.measurableSet.diff hW.measurableSet)
      fun x hx => ⟨hW'U.2 (subset_closure hx.1), fun hxK => hx.2 (hKW hxK)⟩
  -- `μ_T(W') = μ_T(W) + μ_T(W' \ W) ≤ μ_S(W) + μ_S(W' \ W) = μ_S(W')`
  have hsplit : ∀ μ : Measure (Euclid P), μ W' = μ W + μ (W' \ W) := fun μ => by
    rw [← measure_inter_add_sdiff W' hW.measurableSet, inter_eq_right.2 hWW']
  rw [hμT W hW, hμS W hW] at hle
  rw [hμT W' hW', hμS W' hW', hsplit RT.measure, hsplit RS.measure, ← hdiff]
  exact add_le_add hle le_rfl
/-- **Comparison with a small filling** (Simon Ch. 6, proof of Theorem 8.2, (4)–(6), pp. 177–178,
for a single test form).  Suppose `∂S = ∂A` in `ℝᴾ`, `M(A) ≤ m < ∞`, `M(S) ≤ κm`,
`spt A, spt S ⊆ B̄_R(x)`, `|ω| ≤ 1`, and `ω` satisfies the cone inequality `|X(ω)| ≤ cϱM(X)` for
every cycle `X` of finite mass supported in a closed ball of radius `ϱ`.  Then `X = S − A` is such
a cycle, with `M(X) ≤ M(S) + M(A) ≤ (1 + κ)m` and `spt X ⊆ spt S ∪ spt A ⊆ B̄_R(x)`, so
`|X(ω)| ≤ cR(1 + κ)m`; and `S(ω) ≤ M(S) ≤ κm` because `ω` is admissible.  Hence
`A(ω) = S(ω) − X(ω) ≤ (κ + cR(1 + κ))m`. -/
theorem Submission.cbrld_ns_eval_le_of_small_filling : ∀ (P d : ℕ) (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (ω : TestFormOn (univ : Set (Euclid P)) (d + 1)) (m : ℝ≥0∞) (x : Euclid P) (c κ R : ℝ), 0 ≤ c → 0 ≤ κ → 0 < R → m < ∞ → (∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (d + 1)) y) ≤ 1) → (∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (x₀ : Euclid P) (ϱ : ℝ), 0 < ϱ → X.boundary = 0 → X.mass < ∞ → X.support ⊆ closedBall x₀ ϱ → |X ω| ≤ c * ϱ * X.mass.toReal) → S.boundary = A.boundary → A.mass ≤ m → S.mass ≤ ENNReal.ofReal κ * m → A.support ⊆ closedBall x R → S.support ⊆ closedBall x R → A ω ≤ (κ + c * R * (1 + κ)) * m.toReal := by
  intro P d A S ω m x c κ R hc hκ hR hm hω hcone hbd hA hS hsptA hsptS
  -- Step 1: the comparison current `X = S − A`, with `X(η) = S(η) − A(η)`.
  set X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1) := S - A
  have hXapp : ∀ η, X η = S η - A η := fun _ => rfl
  -- Step 2: `∂X(η) = S(dη) − A(dη) = ∂S(η) − ∂A(η) = 0`.
  have hXbd : X.boundary = 0 := by
    ext η
    rw [GeometricCurrentOn.boundary_apply, hXapp, ← GeometricCurrentOn.boundary_apply,
      ← GeometricCurrentOn.boundary_apply, hbd, sub_self, GeometricCurrentOn.zero_apply]
  -- Step 3: `M(X) ≤ M(S) + M(A) ≤ κm + m < ∞`, hence `M(X) ≤ (1 + κ)m` as real numbers.
  have hκm : ENNReal.ofReal κ * m < ∞ := ENNReal.mul_lt_top ENNReal.ofReal_lt_top hm
  have hsum : ENNReal.ofReal κ * m + m < ∞ := ENNReal.add_lt_top.2 ⟨hκm, hm⟩
  have hXmass : X.mass ≤ ENNReal.ofReal κ * m + m :=
    (Submission.cbrld_ns_massOn_sub_le P (d + 1) univ univ S A).trans (add_le_add hS hA)
  have hXfin : X.mass < ∞ := hXmass.trans_lt hsum
  have hXreal : X.mass.toReal ≤ (1 + κ) * m.toReal := by
    have h := ENNReal.toReal_mono hsum.ne hXmass
    rw [ENNReal.toReal_add hκm.ne hm.ne, ENNReal.toReal_mul, ENNReal.toReal_ofReal hκ] at h
    linarith
  -- Step 4: `spt X ⊆ spt S ∪ spt A ⊆ B̄_R(x)`.
  have hXspt : X.support ⊆ closedBall x R :=
    (Submission.cbrld_ns_support_sub_subset P (d + 1) univ S A).trans (union_subset hsptS hsptA)
  -- Step 5: the cone inequality at `(x, R)`: `|X(ω)| ≤ cR·M(X) ≤ cR(1 + κ)m`.
  have hXω : |X ω| ≤ c * R * ((1 + κ) * m.toReal) :=
    (hcone X x R hR hXbd hXfin hXspt).trans
      (mul_le_mul_of_nonneg_left hXreal (mul_nonneg hc hR.le))
  -- Step 6: `ω` is `ℝᴾ`-admissible, so `S(ω) ≤ M(S) ≤ κm`.
  have hSω : S ω ≤ κ * m.toReal := by
    have hadm : ω ∈ massAdmissibleOn (univ : Set (Euclid P)) (d + 1) univ :=
      ⟨subset_univ _, hω⟩
    have h := (ENNReal.ofReal_le_iff_le_toReal hκm.ne).1 ((S.le_massOn hadm).trans hS)
    rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal hκ] at h
  -- Step 7: `A(ω) = S(ω) − X(ω) ≤ S(ω) + |X(ω)| ≤ κm + cR(1 + κ)m`.
  have hAω : A ω = S ω - X ω := by rw [hXapp]; ring
  rw [hAω]
  linarith [neg_le_abs (X ω)]
/-- **Simon 6.3.1, 6.2.16, 8.3(1)**: integer multiplicity is a local property and passes to open
subdomains.  The hypotheses are the mass representation of currents of locally finite mass
(REP), `M_W(τ(M, θ, ξ)) = θHᵏ⌞M(W)` (MR) and four facts about integer multiplicity triples (IMC).
(1) Let `X ∈ 𝒟ₖ(U)` have locally finite mass, and let each `x ∈ U` have a ball
`B = B_r(x) ⊆ U` with `X|_B = τ(M, θ, ξ_B)`.  (REP) gives `X(ω) = ∫ ξ(ω) dμ`.  For open
`G ⊆ B`, `μ(G) = M_G(X) = M_G(X|_B) = θHᵏ⌞M(G)` by (MR), so `μ⌞B = θHᵏ⌞M`.  Both
representations compute `X(ω)` for `ω ∈ 𝒟ᵏ(B)`, so their set integrals agree and `ξ = ξ_B`
`μ`-a.e. on `B`.  The local triples then glue to a representation of `X` in `U`.
(2) `X|_V = τ(M ∩ V, θ, ξ)` (`dtc_restrictDomain_isIntegerMultiplicity`). -/
theorem Submission.cbr_isIntegerMultiplicity_of_local : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (U : Set (Euclid P)) (X : GeometricCurrentOn U k), IsOpen U → ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → X.massOn W < ∞) → (∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ ∃ h : ball x r ⊆ U, IsIntegerMultiplicity (X.restrictDomain h)) → IsIntegerMultiplicity X) ∧ (∀ (V : Set (Euclid P)) (h : V ⊆ U), IsOpen V → IsIntegerMultiplicity X → IsIntegerMultiplicity (X.restrictDomain h)) := by
  intro hREP hMR hIMC P k U X hU
  refine ⟨fun hmass hloc => ?_, fun V hVU hV hX =>
    Submission.dtc_restrictDomain_isIntegerMultiplicity P k U V hVU X hV hX⟩
  -- Step 4: the mass representation `X(ω) = ∫ ξ(ω) dμ` of (REP)
  obtain ⟨μ, ξ, hμU, hμK, hμmass, hξmeas, hξbound, hXrep, -⟩ := hREP P k U X hU hmass
  -- Steps 7–9: it suffices that `(μ, ξ)` agrees near each `x ∈ U` with an IMRep
  refine Submission.cbr_isIntegerMultiplicity_of_local_reps hIMC.1 P k U X μ ξ hU hμU hμK hξmeas
    hXrep fun x hx => ?_
  obtain ⟨r, hr, hB, R, hR⟩ := hloc x hx
  obtain ⟨hRac, -, -, hRcompl, hRK, hRmeas, hRaction⟩ :=
    Submission.cbr_imRep_measure_basic P k (ball x r) R
  have hμKB : ∀ K : Set (Euclid P), IsCompact K → K ⊆ ball x r → μ K < ∞ :=
    fun K hK hKB => hμK K hK (hKB.trans hB)
  -- (IMC)(d) holds `Hᵏ⌞M`-a.e., hence `θHᵏ⌞M`-a.e. as `θHᵏ⌞M ≪ Hᵏ⌞M`
  have hRbound : ∀ᵐ y ∂R.measure, ∀ α : Covector (Euclid P) k,
      |R.orient y α| ≤ covectorEuclideanNorm α :=
    hRac.ae_le (hIMC.2.2.2 P k (ball x r) R)
  -- Step 5: `μ(G) = M_G(X) = M_G(X|_B) = θHᵏ⌞M(G)` for open `G ⊆ B`, so `μ⌞B = θHᵏ⌞M`
  have hopen : ∀ G : Set (Euclid P), IsOpen G → G ⊆ ball x r → μ G = R.measure G := by
    intro G hG hGB
    rw [← hμmass G hG, Submission.dtc_massOn_eq_of_agreeOn P k U (ball x r) G hB X
      (X.restrictDomain hB) hGB fun ω _ => rfl]
    exact hMR P k (ball x r) (X.restrictDomain hB) R isOpen_ball hR G hG
  have hborel := Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P (ball x r) μ R.measure
    isOpen_ball (fun C hC hCB => (hμKB C hC hCB).ne) hopen
  have hrestr : μ.restrict (ball x r) = R.measure.restrict (ball x r) :=
    (Measure.restrict_congr_meas measurableSet_ball).2 fun A hAB hA => hborel A hA hAB
  -- `θHᵏ⌞M` lives on `M ⊆ B`
  have hRB : R.measure.restrict (ball x r) = R.measure :=
    Measure.restrict_eq_self_of_ae_mem
      (Filter.mem_of_superset (mem_ae_iff.2 hRcompl) R.carrier_subset)
  -- Step 6: for `ω ∈ 𝒟ᵏ(B)`, `∫ ξ(ω) dμ = X(ω) = X|_B(ω) = ∫ ξ_B(ω) d(θHᵏ⌞M)`, so the set
  -- integrals agree (with `(μ₃, ξ₃) = (0, 0)`) and `ξ = ξ_B` `μ`-a.e. on `B`
  have hset := Submission.cbr_setIntegral_eq_of_integral_eq P k (ball x r) μ R.measure 0 ξ
    R.orient 0 isOpen_ball hμKB hRK (fun K _ _ => by simp) hξmeas hRmeas
    (aestronglyMeasurable_zero_measure _) (ae_of_all μ hξbound) hRbound
    (ae_of_all _ fun y α => by simpa using covectorEuclideanNorm_nonneg α) fun ω => by
      rw [integral_zero_measure, add_zero, ← hRaction (ω : DifferentialForm (Euclid P) k),
        ← hR ω, GeometricCurrentOn.restrictDomain_apply, hXrep, testFormOnInclusion_coe]
  have hae := Submission.cbr_orient_ae_eq_of_setIntegral_eq P k (ball x r) μ R.measure ξ R.orient
    isOpen_ball hμKB hrestr hξmeas hRmeas (ae_of_all μ hξbound) hRbound fun E ω hE => by
      rw [hset E ω hE, Measure.restrict_zero, integral_zero_measure, add_zero]
  exact ⟨ball x r, R, isOpen_ball, mem_ball_self hr, hB, hrestr.trans hRB, hae⟩
/-- **Slicing localization** (Simon Ch. 6, 4.5(1)–(2) and 6.2, general case, as used in the proof
of 7.2.4).  Assume (REP) `cmc_exists_massRepresentation`, (IMC)(b), (IMC)(d) and (SL)
`cmc_slice_mass_bounds`.  Let `R ∈ 𝒟_{d+1}(U)` be integer multiplicity with `M_W(∂R) < ∞` for
`W ⋐ U`, and `x₀ ∈ U`.  Then for some `r > 0` with `closedBall x₀ r ⊆ U`, the current
`R' = R⌞B_r(x₀)` is represented by an `IMRep` with carrier in `B_r(x₀)`, `M(R') < ∞`,
`M(∂R') < ∞`, and `∂R' = ∂R` on forms supported in `B_r(x₀)`.  Represent `R` by its weight
`μ = θ Hᵈ⁺¹⌞M` and `∂R` by `(μ', ξ')`, and slice by `f = |· − x₀|`.  The integrated bound of
(SL) on `(0, r₀)` gives `r ∈ (0, r₀)` with `M_{B_{r₀}(x₀)}(∂A_r − B_r) < ∞`.  This current
vanishes away from the compact sphere `{f = r}`, so its total mass is finite, and
`M(∂A_r) ≤ M(B_r) + M(∂A_r − B_r) < ∞`. -/
theorem Submission.cbr_bim_slice_localization : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) → (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P d : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)) (x₀ : Euclid P), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → x₀ ∈ U → ∃ r : ℝ, 0 < r ∧ closedBall x₀ r ⊆ U ∧ ∃ (R' : GeometricCurrentOn U (d + 1)) (Rr : IMRep U (d + 1)), Rr.Represents R' ∧ Rr.carrier ⊆ ball x₀ r ∧ R'.mass < ∞ ∧ R'.boundary.mass < ∞ ∧ ∀ η : TestFormOn U d, tsupport (η : DifferentialForm (Euclid P) d) ⊆ ball x₀ r → R'.boundary η = R.boundary η := by
  intro hREP hIMCb hIMCd hSL P d U R x₀ hU hRim hbd hx₀
  -- Step 0: the local mass of a current is bounded by any representing measure
  have hmassle : ∀ {k : ℕ} (X : GeometricCurrentOn U k) (ν : Measure (Euclid P))
      (ζ : Euclid P → MultiVector P k),
      (∀ᵐ x ∂ν, ∀ α : Covector (Euclid P) k, |ζ x α| ≤ covectorEuclideanNorm α) →
      (∀ ω : TestFormOn U k, X ω = ∫ x, ζ x ((ω : DifferentialForm (Euclid P) k) x) ∂ν) →
      ∀ W : Set (Euclid P), X.massOn W ≤ ν W := by
    intro k X ν ζ hζ hrep W
    apply sSup_le
    rintro _ ⟨ω, ⟨hsupp, hnorm⟩, rfl⟩
    change ENNReal.ofReal (X ω) ≤ ν W
    rw [hrep ω]
    calc ENNReal.ofReal (∫ x, ζ x ((ω : DifferentialForm (Euclid P) k) x) ∂ν)
        ≤ ‖∫ x, ζ x ((ω : DifferentialForm (Euclid P) k) x) ∂ν‖ₑ := by
          rw [Real.enorm_eq_ofReal_abs]; exact ENNReal.ofReal_le_ofReal (le_abs_self _)
      _ ≤ ∫⁻ x, ‖ζ x ((ω : DifferentialForm (Euclid P) k) x)‖ₑ ∂ν :=
          enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ x, W.indicator 1 x ∂ν := by
          apply lintegral_mono_ae
          filter_upwards [hζ] with x hx
          by_cases hxW : x ∈ W
          · rw [indicator_of_mem hxW, Pi.one_apply, Real.enorm_eq_ofReal_abs]
            exact ENNReal.ofReal_le_one.mpr ((hx _).trans (hnorm x))
          · have : (ω : DifferentialForm (Euclid P) k) x = 0 :=
              image_eq_zero_of_notMem_tsupport (fun h => hxW (hsupp h))
            simp [this]
      _ ≤ ν W := lintegral_indicator_one_le W
  -- Step 1: `R` is represented by the weight `μ = θ Hᵈ⁺¹⌞M` of an `IMRep` `R₀ = (M, θ, ξ)`
  obtain ⟨R₀, hR₀⟩ := hRim
  obtain ⟨hac, haesm, hrestr⟩ := Submission.lcmp_imRep_measure_restrict P (d + 1) U R₀
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → R₀.measure K < ∞ := by
    intro K hK hKU
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact lt_top_iff_ne_top.mpr (R₀.locallyIntegrable_mult K hK hKU)
  have hξb : ∀ᵐ x ∂R₀.measure, ∀ α : Covector (Euclid P) (d + 1),
      |R₀.orient x α| ≤ covectorEuclideanNorm α :=
    hac.ae_le (hIMCd P (d + 1) U R₀)
  have hRrep : ∀ ω : TestFormOn U (d + 1),
      R ω = ∫ x, R₀.orient x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂R₀.measure := by
    intro ω
    have h := (hrestr univ R₀ MeasurableSet.univ (inter_univ _).symm rfl rfl).2
      (ω : DifferentialForm (Euclid P) (d + 1))
    rw [Measure.restrict_univ] at h
    rw [hR₀ ω, h]
  -- Step 2: `∂R` is represented by `(μ', ξ')`
  obtain ⟨μ', ξ', -, hfin', -, haesm', hξ'b, hbrep, -⟩ := hREP P d U R.boundary hU hbd
  -- Step 3: a radius `r₀ = ε / 2` with `closedBall x₀ r₀ ⊆ U`
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.mp hU x₀ hx₀
  have hr₀pos : 0 < ε / 2 := by positivity
  have hcb₀ : closedBall x₀ (ε / 2) ⊆ U := (closedBall_subset_ball (by linarith)).trans hεU
  have hfL : LipschitzWith 1 (fun x : Euclid P => dist x x₀) := LipschitzWith.dist_left x₀
  -- Step 4: slicing by the distance from `x₀`
  obtain ⟨A, B, hA, hB, hAB, -, hint5⟩ := hSL P d U R R₀.measure μ' R₀.orient ξ'
    (fun x => dist x x₀) 1 hU hfin hfin' haesm haesm' hξb (Eventually.of_forall hξ'b) hRrep hbrep hfL
  have hfinball : R₀.measure (closedBall x₀ (ε / 2)) < ∞ := hfin _ (isCompact_closedBall _ _) hcb₀
  have hfinball' : μ' (closedBall x₀ (ε / 2)) < ∞ := hfin' _ (isCompact_closedBall _ _) hcb₀
  -- Step 5: a good radius `r ∈ (0, r₀)`, from the integrated slice bound on `(0, r₀)`
  obtain ⟨r, hr, hZr⟩ : ∃ r ∈ Ioo 0 (ε / 2),
      ((A r).boundary - B r).massOn (ball x₀ (ε / 2)) < ∞ := by
    by_contra hcon
    push Not at hcon
    have hlint := hint5 (ball x₀ (ε / 2)) 0 (ε / 2) isOpen_ball
    have htop : ∫⁻ t in Ioo 0 (ε / 2), ((A t).boundary - B t).massOn (ball x₀ (ε / 2)) = ∞ := by
      rw [setLIntegral_congr_fun measurableSet_Ioo (fun t ht => top_le_iff.mp (hcon t ht))]
      rw [lintegral_const, Measure.restrict_apply_univ, Real.volume_Ioo, sub_zero]
      exact ENNReal.top_mul (by simpa using hr₀pos)
    rw [htop, ENNReal.coe_one, one_mul] at hlint
    have hle : R₀.measure (ball x₀ (ε / 2) ∩ {x | 0 < dist x x₀ ∧ dist x x₀ < ε / 2}) < ∞ :=
      lt_of_le_of_lt (measure_mono (inter_subset_left.trans ball_subset_closedBall)) hfinball
    exact absurd (lt_of_le_of_lt hlint hle) (lt_irrefl _)
  -- Step 6: `Z = ∂A_r − B_r` vanishes off the sphere, so its total mass is finite
  set Z := (A r).boundary - B r with hZ
  have hZvan : ∀ η : TestFormOn U d,
      Disjoint (tsupport (η : DifferentialForm (Euclid P) d)) (sphere x₀ r) → Z η = 0 := by
    intro η hη
    have := hAB r η hη
    change (A r).boundary η - B r η = 0
    rw [this, sub_self]
  have hsph : sphere x₀ r ⊆ ball x₀ (ε / 2) := fun y hy => by
    rw [mem_sphere] at hy; rw [mem_ball, hy]; exact hr.2
  have hZU : Z.massOn U < ∞ :=
    lt_of_le_of_lt (Submission.lcmp_massOn_le_of_vanish_off_compact P d U (ball x₀ (ε / 2))
      (sphere x₀ r) Z (isCompact_sphere _ _) isOpen_ball hsph hZvan U) hZr
  -- Step 7: `M(B_r) ≤ μ'(B_r(x₀)) < ∞`
  have hBU : (B r).massOn U < ∞ := by
    refine lt_of_le_of_lt (hmassle (B r) (μ'.restrict (ball x₀ r)) ξ'
      (ae_restrict_of_ae (Eventually.of_forall hξ'b)) (fun η => hB r η) U) ?_
    refine lt_of_le_of_lt ?_ hfinball'
    calc μ'.restrict (ball x₀ r) U ≤ μ'.restrict (ball x₀ r) univ := measure_mono (subset_univ _)
      _ = μ' (ball x₀ r) := Measure.restrict_apply_univ _
      _ ≤ μ' (closedBall x₀ (ε / 2)) :=
          measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall hr.2.le))
  -- Step 8: `M(∂A_r) ≤ M(B_r) + M(Z) < ∞`
  have hAbU : (A r).boundary.massOn U < ∞ := by
    refine lt_of_le_of_lt (b := (B r).massOn U + Z.massOn U) ?_ (ENNReal.add_lt_top.mpr ⟨hBU, hZU⟩)
    apply sSup_le
    rintro _ ⟨η, hη, rfl⟩
    have hsplit : (A r).boundary η = B r η + Z η := by
      change (A r).boundary η = B r η + ((A r).boundary η - B r η); ring
    change ENNReal.ofReal ((A r).boundary η) ≤ _
    rw [hsplit]
    exact ENNReal.ofReal_add_le.trans (add_le_add ((B r).le_massOn hη) (Z.le_massOn hη))
  -- Step 9: `R' := A_r = R⌞B_r(x₀)` is represented by the restricted `IMRep`
  obtain ⟨A', Rr, -, hcar, hmult, hor⟩ := hIMCb P (d + 1) U R₀ (ball x₀ r) hU measurableSet_ball
  have hRrA : Rr.Represents (A r) := by
    intro ω
    rw [hA r ω]
    exact ((hrestr (ball x₀ r) Rr measurableSet_ball hcar hmult hor).2 _).symm
  -- Step 10: `M(R') ≤ μ(B_r(x₀)) < ∞`
  have hAU : (A r).massOn U < ∞ := by
    refine lt_of_le_of_lt (hmassle (A r) (R₀.measure.restrict (ball x₀ r)) R₀.orient
      (ae_restrict_of_ae hξb) (fun ω => hA r ω) U) ?_
    refine lt_of_le_of_lt ?_ hfinball
    calc R₀.measure.restrict (ball x₀ r) U ≤ R₀.measure.restrict (ball x₀ r) univ :=
          measure_mono (subset_univ _)
      _ = R₀.measure (ball x₀ r) := Measure.restrict_apply_univ _
      _ ≤ R₀.measure (closedBall x₀ (ε / 2)) :=
          measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall hr.2.le))
  -- Steps 11–12: conclusion; `∂R' = ∂R` on forms supported in `B_r(x₀)`
  refine ⟨r, hr.1, (closedBall_subset_closedBall hr.2.le).trans hcb₀, A r, Rr, hRrA, ?_, hAU, hAbU, ?_⟩
  · rw [hcar]; exact inter_subset_right
  · intro η hη
    have hdisj : Disjoint (tsupport (η : DifferentialForm (Euclid P) d)) (sphere x₀ r) := by
      refine Set.disjoint_left.mpr fun y hy hys => ?_
      have h1 := hη hy
      rw [mem_ball] at h1; rw [mem_sphere] at hys
      linarith
    rw [hAB r η hdisj, hB r η, hbrep η]
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro x hx
    have : (η : DifferentialForm (Euclid P) d) x = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => hx (hη h))
    rw [this, map_zero]

/-- **Mass and boundary mass of a compactly supported current under restriction** (Simon 7.2.4,
proof; Simon Ch. 6, 2.4–2.5 and 2.11).  Assume that every current kills the test forms whose
support misses its support.  Let `U` be open, `C ⊆ U` compact and `Y ∈ 𝒟ₖ₊₁(ℝᴾ)` with
`spt Y ⊆ C`.  Then `M(Y) ≤ M(Y|_U)` and `M(∂Y) ≤ M(∂(Y|_U))`.  `Y` and `∂Y` kill the forms
whose support misses `C` (`d` does not enlarge supports), so mass localization gives
`M(Y) ≤ M_U(Y)` and `M(∂Y) ≤ M_U(∂Y)`.  A form on `ℝᴾ` admissible for `M_U` is an admissible
form of `U` with the same value, so `M_U(Y) ≤ M(Y|_U)` and `M_U(∂Y) ≤ M(∂(Y|_U))`. -/
theorem Submission.cbr_bim_extension_mass_bounds : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P k : ℕ) (U C : Set (Euclid P)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), IsOpen U → IsCompact C → C ⊆ U → Y.support ⊆ C → Y.mass ≤ (Y.restrictDomain (subset_univ U)).mass ∧ Y.boundary.mass ≤ (Y.restrictDomain (subset_univ U)).boundary.mass := by
  intro hVO P k U C Y hU hC hCU hYC
  -- Step 1: `Y` kills the forms whose support misses `C ⊇ spt Y`
  have hvY : ∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (k + 1))) C → Y ω = 0 :=
    fun ω hω => hVO P (k + 1) univ Y ω (hω.mono_right hYC)
  -- Step 2: so does `∂Y`, since `∂Y(η) = Y(dη)` and `spt dη ⊆ spt η`
  have hvB : ∀ η : TestFormOn (univ : Set (Euclid P)) k,
      Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) C → Y.boundary η = 0 := by
    intro η hη
    rw [GeometricCurrentOn.boundary_apply]
    exact hvY _ (hη.mono_left (tsupport_exteriorDerivative_subset _))
  -- Step 4: `M_U(Z) ≤ M_U(Z')` when `Z' ∈ 𝒟ₘ(U)` agrees with `Z ∈ 𝒟ₘ(ℝᴾ)` on `𝒟ᵐ(U)`
  have hres : ∀ {m : ℕ} (Z : GeometricCurrentOn (univ : Set (Euclid P)) m)
      (Z' : GeometricCurrentOn U m),
      (∀ ω : TestFormOn U m, Z (testFormOnInclusion (subset_univ U) m ω) = Z' ω) →
      Z.massOn U ≤ Z'.massOn U := by
    intro m Z Z' hZ
    apply sSup_le
    rintro _ ⟨ω, ⟨hsupp, hnorm⟩, rfl⟩
    let ω' : TestFormOn U m := ⟨ω, ω.property.1, hsupp⟩
    have h1 : Z ω = Z' ω' := by
      rw [← hZ ω']
      rfl
    change ENNReal.ofReal (Z ω) ≤ Z'.massOn U
    rw [h1]
    exact Z'.le_massOn ⟨hsupp, hnorm⟩
  -- Steps 3, 5, 6: localize with `V = U`, then compare with the restriction
  refine ⟨?_, ?_⟩
  · calc Y.mass = Y.massOn univ := rfl
      _ ≤ Y.massOn U :=
        Submission.lcmp_massOn_le_of_vanish_off_compact P (k + 1) univ U C Y hC hU hCU hvY univ
      _ ≤ (Y.restrictDomain (subset_univ U)).massOn U := hres Y _ fun ω => rfl
  · calc Y.boundary.mass = Y.boundary.massOn univ := rfl
      _ ≤ Y.boundary.massOn U :=
        Submission.lcmp_massOn_le_of_vanish_off_compact P k univ U C Y.boundary hC hU hCU hvB univ
      _ ≤ (Y.restrictDomain (subset_univ U)).boundary.massOn U := hres Y.boundary _ fun ω => rfl

/-- **Simon Ch. 6, 6.2 (first case) and 6.3**: if `T ∈ 𝒟_{d+1}(ℝᴾ)` is integer multiplicity with
compact support and `M(T), M(∂T) < ∞`, then `∂T` is integer multiplicity, given the
deformation theorem (DT) and the closure theorem (CL) in degree `d`.  (DT) with `ρ_k = 2⁻ᵏ` and
`Λ = M(T)` gives `T - Q_k - S_k = ∂R_k` with `∂Q_k` integer multiplicity, `M(∂Q_k) ≤ c M(∂T)`,
`M(R_k) ≤ c ρ_k M(T)` and `M(S_k) ≤ c ρ_k M(∂T)`.  With `|ω(x)| ≤ C_ω`, the evaluation bound gives
`|Q_k(ω) - T(ω)| ≤ |S_k(ω)| + |R_k(dω)| ≤ ρ_k c (C_ω M(∂T) + C_{dω} M(T)) → 0`, so `Q_k ⇀ T` and
`∂Q_k ⇀ ∂T`.  Since `∂∂Q_k = 0`, `M_W(∂Q_k) + M_W(∂∂Q_k) ≤ c M(∂T)` for every `W`, and (CL) in
`U = ℝᴾ` shows that `∂T` is integer multiplicity. -/
theorem Submission.cbr_bim_boundary_im_of_compact_support : (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → ∀ (P : ℕ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (K : Set (Euclid P)), IsCompact K → IsIntegerMultiplicity T → T.support ⊆ K → T.mass < ∞ → T.boundary.mass < ∞ → IsIntegerMultiplicity T.boundary := by
  -- `M_W(0) = 0`, and `boundaryMassOn (∂Z) W = 0` because `∂∂Z = 0` (or `∂ = 0` in degree `0`)
  have massOn_zero_aux : ∀ {P m : ℕ} {U : Set (Euclid P)} (W : Set (Euclid P)),
      (0 : GeometricCurrentOn U m).massOn W = 0 := by
    intro P m U W
    apply le_antisymm _ bot_le
    apply sSup_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  have boundaryMassOn_boundary_aux : ∀ {P : ℕ} {U : Set (Euclid P)} (k : ℕ)
      (Z : GeometricCurrentOn U (k + 1)) (W : Set (Euclid P)), boundaryMassOn Z.boundary W = 0 := by
    intro P U k Z W
    cases k with
    | zero => rfl
    | succ m =>
      change Z.boundary.boundary.massOn W = 0
      rw [GeometricCurrentOn.boundary_boundary]
      exact massOn_zero_aux W
  intro hDT d hCL P T K hK hT hTK hm hbm
  -- Step 1: constants, `Λ = M(T)`
  obtain ⟨c, -, hc⟩ := hDT P d
  set Λ : NNReal := T.mass.toNNReal with hΛdef
  have hΛ : T.mass ≤ Λ := by rw [hΛdef, ENNReal.coe_toNNReal hm.ne]
  -- Step 2: the deformation theorem with `ρ_k = 2⁻ᵏ`
  have hρ : ∀ k : ℕ, (0 : ℝ) < (1 / 2 : ℝ) ^ k := fun k => by positivity
  choose 𝒬 _ h𝒬 using fun k : ℕ => hc ((1 / 2 : ℝ) ^ k) K Λ (hρ k) hK
  choose Q _ R S _ hQb _ hEq _ _ hQbm hRm hSm _ _ using fun k => h𝒬 k T hT hTK hΛ hbm
  -- Step 3: a uniform bound for the Euclidean coefficient norm of a test form
  have hbound : ∀ {m : ℕ} (ω : TestFormOn (univ : Set (Euclid P)) m), ∃ C : ℝ, 0 < C ∧
      ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) ≤ C := by
    intro m ω
    have hω1 : IsSmoothForm (ω : DifferentialForm (Euclid P) m) := ω.property.1.1
    have hω2 : HasCompactSupport (ω : DifferentialForm (Euclid P) m) := ω.property.1.2
    have hωc : Continuous (ω : DifferentialForm (Euclid P) m) := hω1.continuous
    have hcont :
        Continuous fun x => covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) :=
      (Submission.rsd_mw_tfa_norm_props P m).2.2.2.comp hωc
    have hcs :
        HasCompactSupport fun x => covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) :=
      hω2.comp_left (g := fun α : Covector (Euclid P) m => covectorEuclideanNorm α)
        (covectorEuclideanNorm_zero P m)
    obtain ⟨C, hC⟩ := hcs.exists_bound_of_continuous hcont
    refine ⟨max C 1, lt_max_of_lt_right one_pos, fun x => ?_⟩
    exact (le_abs_self _).trans ((Real.norm_eq_abs _ ▸ hC x).trans (le_max_left _ _))
  -- Step 4: `Q_k ⇀ T`, from `|Q_k(ω) - T(ω)| ≤ |S_k(ω)| + |R_k(dω)| ≤ ρ_k A`
  have hconv : WeaklyConvergesOn Q T := by
    intro ω
    obtain ⟨C₁, hC₁, hb₁⟩ := hbound ω
    obtain ⟨C₂, hC₂, hb₂⟩ := hbound (exteriorDerivativeTestOn univ (d + 1) ω)
    set A : ℝ≥0∞ := ENNReal.ofReal C₁ * ((c : ℝ≥0∞) * T.boundary.mass) +
      ENNReal.ofReal C₂ * ((c : ℝ≥0∞) * T.mass) with hA
    have hAfin : A ≠ ∞ := by
      rw [hA]
      exact ENNReal.add_ne_top.mpr ⟨ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.mul_ne_top ENNReal.coe_ne_top hbm.ne), ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.mul_ne_top ENNReal.coe_ne_top hm.ne)⟩
    have hkey : ∀ k, |Q k ω - T ω| ≤ (1 / 2 : ℝ) ^ k * A.toReal := by
      intro k
      have e : T ω - Q k ω - S k ω = R k (exteriorDerivativeTestOn univ (d + 1) ω) := by
        have := congrArg (fun Z : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1) => Z ω) (hEq k)
        exact this
      have hS : (S k).massOn univ ≤
          (c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.boundary.mass := hSm k
      have hR : (R k).massOn univ ≤ (c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.mass := hRm k
      have hSfin : (S k).massOn univ ≠ ∞ := ne_top_of_le_ne_top
        (ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top) hbm.ne) hS
      have hRfin : (R k).massOn univ ≠ ∞ := ne_top_of_le_ne_top
        (ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top) hm.ne) hR
      -- evaluation bound `|X(φ)| ≤ C · M(X)` (`cmr_abs_apply_le_massOn`), in `ℝ≥0∞`
      have h1 : ENNReal.ofReal |S k ω| ≤ ENNReal.ofReal C₁ * (S k).massOn univ := by
        have h := Submission.cmr_abs_apply_le_massOn P (d + 1) univ univ (S k) ω C₁ hSfin
          (subset_univ _) hb₁
        calc ENNReal.ofReal |S k ω| ≤ ENNReal.ofReal (C₁ * ((S k).massOn univ).toReal) :=
              ENNReal.ofReal_le_ofReal h
          _ = ENNReal.ofReal C₁ * (S k).massOn univ := by
              rw [ENNReal.ofReal_mul hC₁.le, ENNReal.ofReal_toReal hSfin]
      have h2 : ENNReal.ofReal |R k (exteriorDerivativeTestOn univ (d + 1) ω)| ≤
          ENNReal.ofReal C₂ * (R k).massOn univ := by
        have h := Submission.cmr_abs_apply_le_massOn P (d + 2) univ univ (R k)
          (exteriorDerivativeTestOn univ (d + 1) ω) C₂ hRfin (subset_univ _) hb₂
        calc ENNReal.ofReal |R k (exteriorDerivativeTestOn univ (d + 1) ω)| ≤
              ENNReal.ofReal (C₂ * ((R k).massOn univ).toReal) := ENNReal.ofReal_le_ofReal h
          _ = ENNReal.ofReal C₂ * (R k).massOn univ := by
              rw [ENNReal.ofReal_mul hC₂.le, ENNReal.ofReal_toReal hRfin]
      have hle : ENNReal.ofReal |Q k ω - T ω| ≤ ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * A := by
        have habs : |Q k ω - T ω| ≤ |S k ω| + |R k (exteriorDerivativeTestOn univ (d + 1) ω)| := by
          rw [← e]
          calc |Q k ω - T ω| = |-(S k ω) - (T ω - Q k ω - S k ω)| := by ring_nf
            _ ≤ |-(S k ω)| + |T ω - Q k ω - S k ω| := abs_sub _ _
            _ = |S k ω| + |T ω - Q k ω - S k ω| := by rw [abs_neg]
        calc ENNReal.ofReal |Q k ω - T ω|
            ≤ ENNReal.ofReal |S k ω| +
                ENNReal.ofReal |R k (exteriorDerivativeTestOn univ (d + 1) ω)| :=
              (ENNReal.ofReal_le_ofReal habs).trans ENNReal.ofReal_add_le
          _ ≤ ENNReal.ofReal C₁ *
                ((c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.boundary.mass) +
              ENNReal.ofReal C₂ * ((c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.mass) := by
              gcongr
              · exact h1.trans (by gcongr)
              · exact h2.trans (by gcongr)
          _ = ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * A := by rw [hA]; ring
      have := ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hAfin) hle
      rwa [ENNReal.toReal_ofReal (abs_nonneg _), ENNReal.toReal_mul,
        ENNReal.toReal_ofReal (hρ k).le] at this
    rw [tendsto_iff_dist_tendsto_zero]
    have hlim : Tendsto (fun k : ℕ => (1 / 2 : ℝ) ^ k * A.toReal) atTop (𝓝 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
        (by norm_num : (1 / 2 : ℝ) < 1)).mul_const A.toReal
    exact squeeze_zero (fun k => dist_nonneg) (fun k => by rw [Real.dist_eq]; exact hkey k) hlim
  -- Steps 5–7: `∂Q_k ⇀ ∂T`, `M_W(∂Q_k) + M_W(∂∂Q_k) ≤ c M(∂T)`, and the closure theorem
  refine hCL P univ (fun k => (Q k).boundary) T.boundary isOpen_univ hQb ?_ hconv.boundary
  intro W _ _
  refine lt_of_le_of_lt (b := (c : ℝ≥0∞) * T.boundary.mass) (iSup_le fun k => ?_)
    (ENNReal.mul_lt_top ENNReal.coe_lt_top hbm)
  rw [boundaryMassOn_boundary_aux d (Q k) W, add_zero]
  exact ((Q k).boundary.massOn_mono (subset_univ W)).trans (hQbm k)
/-- **Simon Ch. 6, 8.2 for `n = 0`** (the case the book calls trivial): a weak limit of integer
multiplicity `0`-currents with `supⱼ M_W(Tⱼ) < ∞` for `W ⊂⊂ U` is integer multiplicity.  The
hypotheses are (REP), (MR) and (IMC) of `Submission.cbr_isIntegerMultiplicity_of_local`.  By lower
semicontinuity of mass `T` has locally finite mass.  For `x₀ ∈ U` and `B = B_{2r}(x₀) ⊂⊂ U`, each
`Tⱼ` is a point sum `Σₗ w_{j,l}⟨ω(x_{j,l})⟩` on `B` with `Σₗ |w_{j,l}| ≤ M_B(Tⱼ) < C`
(`Submission.cbrz_imrep_zero_local_point_sum` and (MR)).  On `B_r(x₀)` the weak limit is again
a finite integer point sum (`Submission.cbrz_point_sum_limit`), hence integer multiplicity
(`Submission.cbrz_isIntegerMultiplicity_point_sum`), and these local representations glue. -/
theorem Submission.cbr_closure_degree_zero : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U 0) (T : GeometricCurrentOn U 0), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
  intro hREP hMR hIMC P U Ts T hU hTs hbound hconv
  -- Step 7: by part (1) of `cbr_isIntegerMultiplicity_of_local` it suffices that `T` has
  -- locally finite mass and is integer multiplicity near each point of `U`
  refine (Submission.cbr_isIntegerMultiplicity_of_local hREP hMR hIMC P 0 U T hU).1 ?_ ?_
  · -- Step 2: `M_W(T) ≤ liminf_j M_W(T_j) ≤ sup_j (M_W(T_j) + M_W(∂T_j)) < ∞`
    intro W hW hWU
    refine lt_of_le_of_lt ?_ (hbound W hW hWU)
    calc T.massOn W ≤ liminf (fun j => (Ts j).massOn W) atTop := hconv.massOn_le_liminf W
      _ ≤ limsup (fun j => (Ts j).massOn W) atTop := liminf_le_limsup
      _ ≤ ⨆ j, (Ts j).massOn W := limsup_le_iSup
      _ ≤ ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) := iSup_mono fun j => le_self_add
  · -- Step 3: `B_r(x₀) ⊆ U` and `B = B_{2r}(x₀) ⊂⊂ U` for `r = ε/3`, `B_ε(x₀) ⊆ U`
    intro x₀ hx₀
    obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU x₀ hx₀
    have hr : 0 < ε / 3 := by positivity
    have hBU : ball x₀ (ε / 3) ⊆ U := (ball_subset_ball (by linarith)).trans hεU
    refine ⟨ε / 3, hr, hBU, ?_⟩
    have hBcc : CompactlyContained (ball x₀ (2 * (ε / 3))) U := by
      refine ⟨(isCompact_closedBall x₀ (2 * (ε / 3))).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall, ?_⟩
      exact closure_ball_subset_closedBall.trans
        ((closedBall_subset_ball (by linarith)).trans hεU)
    -- `sup_j M_B(T_j) < C`
    obtain ⟨C, hC⟩ := ENNReal.exists_nat_gt (hbound _ isOpen_ball hBcc).ne
    -- each `T_j` is a sum of integer-weighted point masses on `B` of total weight `≤ M_B(T_j)`
    choose R hR using hTs
    choose N w x hxB hw0 hmass hrep using fun j =>
      Submission.cbrz_imrep_zero_local_point_sum P U _ (R j) (Ts j) (hR j) hBcc
    have hCb : ∀ j, (∑ l ∈ Finset.range (N j), (w j l).natAbs) ≤ C := by
      intro j
      have h1 : (∑ l ∈ Finset.range (N j), ((w j l).natAbs : ℝ≥0∞)) < C := by
        calc (∑ l ∈ Finset.range (N j), ((w j l).natAbs : ℝ≥0∞))
            ≤ (R j).measure (ball x₀ (2 * (ε / 3))) := hmass j
          _ = (Ts j).massOn (ball x₀ (2 * (ε / 3))) :=
            (hMR P 0 U (Ts j) (R j) hU (hR j) _ isOpen_ball).symm
          _ ≤ (Ts j).massOn (ball x₀ (2 * (ε / 3))) +
              boundaryMassOn (Ts j) (ball x₀ (2 * (ε / 3))) := le_self_add
          _ ≤ ⨆ i, ((Ts i).massOn (ball x₀ (2 * (ε / 3))) +
              boundaryMassOn (Ts i) (ball x₀ (2 * (ε / 3)))) :=
            le_iSup (fun i => ((Ts i).massOn (ball x₀ (2 * (ε / 3))) +
              boundaryMassOn (Ts i) (ball x₀ (2 * (ε / 3))))) j
          _ < C := hC
      have h2 : ((∑ l ∈ Finset.range (N j), (w j l).natAbs : ℕ) : ℝ≥0∞) < C := by
        push_cast
        exact h1
      exact_mod_cast h2.le
    -- Steps 4–5: on `B_r(x₀)` the weak limit `T` is again a finite integer point sum
    obtain ⟨M, v, y, -, hlim⟩ := Submission.cbrz_point_sum_limit P (closedBall x₀ (2 * (ε / 3)))
      C N w x (TestFormOn (ball x₀ (ε / 3)) 0)
      (fun ω z => (ω : DifferentialForm (Euclid P) 0) z (fun i => i.elim0))
      (fun ω => T.restrictDomain hBU ω) (isCompact_closedBall _ _)
      (fun j l hl => ball_subset_closedBall (hxB j l hl)) hw0 hCb
      (fun ω => by
        have hω := ω.property.1.1
        unfold IsSmoothForm at hω
        exact hω.continuous.eval_const _)
      (fun ω => by
        have hsupp : tsupport ((testFormOnInclusion hBU 0 ω : TestFormOn U 0) :
            DifferentialForm (Euclid P) 0) ⊆ ball x₀ (2 * (ε / 3)) := by
          rw [testFormOnInclusion_coe]
          exact ω.property.2.trans (ball_subset_ball (by linarith))
        simp only [GeometricCurrentOn.restrictDomain_apply]
        refine (hconv (testFormOnInclusion hBU 0 ω)).congr fun j => ?_
        rw [hrep j _ hsupp]
        rfl)
    -- Step 6: a finite integer point sum is integer multiplicity
    exact Submission.cbrz_isIntegerMultiplicity_point_sum P _ _ M v y hlim
/-- **Simon Ch. 6, 6.2–6.3** (boundary rectifiability from the closure theorem).  Assume (REP),
(MR), (IMC), (SL), the deformation theorem (DT), (VO), and the closure theorem (CL) in degree `d`.
If `R ∈ 𝒟_{d+1}(U)` is integer multiplicity and `M_W(∂R) < ∞` for open `W ⊂⊂ U`, then `∂R` is
integer multiplicity.  This is a local property (`cbr_isIntegerMultiplicity_of_local` (1)), so fix
`x₀ ∈ U`.  Slicing by `|· − x₀|` (`cbr_bim_slice_localization`) gives `r > 0` and `R' = R⌞B_r(x₀)`,
represented by an `IMRep` carried by `B_r(x₀)`, with `M(R'), M(∂R') < ∞` and `∂R' = ∂R` on forms
supported in `B_r(x₀)`.  Extending `R'` by zero (`dtc_extend_by_zero`) gives an integer
multiplicity `Y ∈ 𝒟_{d+1}(ℝᴾ)` with `Y|_U = R'` and `spt Y ⊆ B̄_r(x₀)`, so `M(Y) ≤ M(R')` and
`M(∂Y) ≤ M(∂R')` (`cbr_bim_extension_mass_bounds`).  By (DT) and (CL), `∂Y` is integer
multiplicity (`cbr_bim_boundary_im_of_compact_support`), hence so is `(∂Y)|_{B_r(x₀)}`
(`cbr_isIntegerMultiplicity_of_local` (2)), and `(∂Y)|_{B_r(x₀)} = (∂R)|_{B_r(x₀)}`. -/
theorem Submission.cbr_boundary_isIntegerMultiplicity : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → ∀ (P : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary := by
  intro hREP hMR hIMC hSL hDT hVO d hCL P U R hU hRim hbd
  -- Step 11: by `cbr_isIntegerMultiplicity_of_local` (1), it suffices that `∂R` is integer
