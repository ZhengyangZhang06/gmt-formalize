    intro j k hk
    rw [hΛ j, sk_two_mul_pow _ _ (hx0 j), ← ENNReal.ofReal_mul hsqrt]
    exact ENNReal.ofReal_le_ofReal
      (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (h2x j) hk) hsqrt)
  obtain ⟨w, hw0, hws⟩ : ∃ w : ℕ → ℝ, w 0 = 1 ∧
