  -- 5B: under the small-tilt hypothesis `spt μ ∩ B_{σ₀/2}(ξ) ⊆ G ⊆ F`, and (10') excludes holes
  have h5B : (∀ y ∈ R.measure.support ∩ closedBall ξ (σ₀ / 2), ∀ t : ℝ, 0 < t → t ≤ σ₀ / 2 →
