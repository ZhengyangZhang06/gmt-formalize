    (fun y hy t ht ht' => hDb' y hy t ht (by linarith only [ht', hσ₀])) hii
  -- (a) the good set `G = B_{3σ₀/4}(ξ) ∩ G'`
  set G' : Set (Euclid (n + k)) := {y | y ∈ R.measure.support ∧ ∀ t : ℝ, 0 < t → t ≤ σ₀ / 2 →
