        have hT2 := hTay x₀ hx₀ (x - x₀ + r • EuclideanSpace.single j (1 : ℝ)) (by linarith)
        have hT3 := hTay x₀ hx₀ (x - x₀) (by linarith)
        rw [show x₀ + (x - x₀ + r • EuclideanSpace.single j (1 : ℝ)) =
