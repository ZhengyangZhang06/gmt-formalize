    exact measure_mono_null (fun y hy => (hy.1 (hR₀sub hy.2)).elim) measure_empty
  -- (c) `μ(A) = ∫_L μ₀(A − t) dt`: coarea, then (★) and translation by `t − t₀`
  · intro A hA
    rw [hmeas_int n R A hA, (hC1 _ (hθm.indicator hA)).2]
