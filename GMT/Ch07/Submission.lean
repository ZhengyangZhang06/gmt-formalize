    have htend : Tendsto (fun i => ENNReal.ofReal ((1 + η) ^ (m + 1)) *
        (S.massOn W + ((Sf (φ₁ i)).massOn W + (Ps i t).massOn W₀)) +
          (ENNReal.ofReal ((1 + η) ^ (m + 1)) - 1) * cG) atTop
        (𝓝 (ENNReal.ofReal ((1 + η) ^ (m + 1)) * S.massOn W +
          (ENNReal.ofReal ((1 + η) ^ (m + 1)) - 1) * cG)) :=
      (ENNReal.Tendsto.const_mul h1 (Or.inr ENNReal.ofReal_ne_top)).add tendsto_const_nhds
    exact (limsup_le_limsup hev).trans htend.limsup_eq.le
  have hg : Tendsto (fun η : ℝ => ENNReal.ofReal ((1 + η) ^ (m + 1)) * S.massOn W +
      (ENNReal.ofReal ((1 + η) ^ (m + 1)) - 1) * cG) (𝓝[>] 0) (𝓝 (S.massOn W)) := by
    have hc : Continuous fun η : ℝ => ENNReal.ofReal ((1 + η) ^ (m + 1)) :=
      ENNReal.continuous_ofReal.comp ((continuous_const.add continuous_id).pow (m + 1))
    have hl0 := hc.tendsto 0
    simp only [add_zero, one_pow, ENNReal.ofReal_one] at hl0
    have hl := tendsto_nhdsWithin_of_tendsto_nhds (s := Ioi 0) hl0
    have h1 : Tendsto (fun η : ℝ => ENNReal.ofReal ((1 + η) ^ (m + 1)) * S.massOn W) (𝓝[>] 0)
        (𝓝 (1 * S.massOn W)) := ENNReal.Tendsto.mul_const hl (Or.inl one_ne_zero)
    have h2 : Tendsto (fun η : ℝ => (ENNReal.ofReal ((1 + η) ^ (m + 1)) - 1) * cG) (𝓝[>] 0)
        (𝓝 ((1 - 1) * cG)) :=
      ENNReal.Tendsto.mul_const (ENNReal.Tendsto.sub hl (tendsto_const_nhds (x := (1 : ℝ≥0∞)))
        (Or.inl ENNReal.one_ne_top)) (Or.inr hcG)
    have h3 := h1.add h2
    rwa [one_mul, tsub_self, zero_mul, add_zero] at h3
  exact ge_of_tendsto hg (eventually_nhdsWithin_of_forall fun η hη => hlim_eta η hη)

/-- **Compactness of blow-ups** (Lemma BC in the proof of Simon 7.3.1(2); chapter-07.txt lines
302–309, lines 326–345 of the proof and footnote 2, lines 361–364).  If `T` is minimizing in
`U ∩ N`, `spt T ⊆ U ∩ N`, `x ∈ spt T \ spt ∂T` and `Θⁿ(μ_T, x) = θ`, then for `λⱼ > 0`, `λⱼ → 0`,
a subsequence of the blow-ups `Sⱼ = η_{x,λⱼ#}T` converges weakly to an integer multiplicity
`C ∈ 𝒟ₙ(ℝ^{n+k})` with `∂C = 0` that is minimizing in `ℝ^{n+k}`, and `μ_{Sⱼ} → μ_C` for all
representations.  This is the proof of 7.2.4 (lines 157–161 and 176–288) run on the blow-ups, as
in Remark 7.2.5(2) (lines 166–175) with `Nⱼ = η_{x,λⱼ}(N)`.

For `k = 0` this is `dtc_bc_codim_zero` along the whole sequence.  For `k ≥ 1` and `n = m + 1`,
the blow-ups have open exhausting domains, are minimizing in `η_{x,λⱼ}(U ∩ N)` and supported
there, have `M_{B_R(0)}(Sⱼ)` bounded and `∂Sⱼ = 0` in `B_R(0)` for large `j`, and carry
retractions onto `η_{x,λⱼ}(U ∩ N)` with Lipschitz constants tending to `1`
(`dtc_bc_blowUp_hypotheses`, steps 0 and 3).  Truncating at good slicing radii and applying
Federer–Fleming compactness gives `φ`, `C` (integer multiplicity, `∂C = 0`, `S_{φ(j)} ⇀ C`) and the
truncations `Ŝⱼ` (`dtc_bc_truncated_compactness`, step 2).  These hypotheses persist along `φ`, and
comparison with retracted competitors gives, along a further subsequence of any subsequence,
`limsup M_W(S_{φ(j)}) ≤ M_W(S)` for every competitor `S` of `C` near a compact set
(`dtc_bc_local_comparison`, step 4).  This yields the minimality of `C` in `ℝ^{n+k}` and
`μ_{S_{φ(j)}} → μ_C` (`dtc_bc_minimizing_of_local_comparison`, steps 5–6). -/
theorem Submission.dtc_blowUp_compactness : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n → ∀ (U N : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (x : Euclid (n + k)) (θ : ℝ), IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → x ∈ T.support \ boundarySupport T → HasMassDensity T x θ → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C : GeometricCurrentOn (univ : Set (Euclid (n + k))) n), StrictMono φ ∧ ConvergesWeakly (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') C ∧ MassMeasuresConverge (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') C ∧ IsMinimizingIn C univ ∧ BoundaryVanishes C := by
  intro n k ℓ _ hn U N T x θ hU hN _ hmin hspt hx hθ lams hlams hlim
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · -- step 1: codimension zero, along the whole sequence (`Euclid (n + 0)` is `Euclid n`)
    obtain ⟨C, hconv, hmeas, hCmin, hCbd⟩ := Submission.dtc_bc_codim_zero n U T x hn hU hmin.1
      (hspt hx.1).1 hx.2 lams hlams hlim
    exact ⟨id, C, strictMono_id, hconv, hmeas, hCmin, hCbd⟩
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  -- steps 0 and 3: the blow-ups `Sⱼ = η_{x,λⱼ#}T` satisfy the hypotheses of the abstract argument
  obtain ⟨hUo, hUex, hSmin, hSspt, hSmass, hSbd, hπ⟩ :=
    Submission.dtc_bc_blowUp_hypotheses m k ℓ U N T x θ hU hN hmin hspt hx hθ lams hlams hlim
  -- step 2: truncations `Ŝⱼ` and Federer–Fleming compactness give `φ` and `C`
  obtain ⟨φ, C, Ŝ, ρ, hφ, hCim, hCbd, hconv, hŜim, hŜbd, hŜC, hρ, hρU, hŜS⟩ :=
    Submission.dtc_bc_truncated_compactness (m + 1 + k) m (fun j => dilation x (lams j) '' U)
      (fun j => blowUp T x (lams j) (hlams j).ne') (by omega) hUo hUex (fun j => (hSmin j).1)
      hSmass hSbd
  -- the eventual hypotheses persist along `φ`
  have hφ' : Tendsto φ atTop atTop := hφ.tendsto_atTop
  have hmass : ∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop,
      (blowUp T x (lams (φ j)) (hlams (φ j)).ne').massOn (ball 0 R) ≤ c := by
    intro R
    obtain ⟨c, hc, hev⟩ := hSmass R
    exact ⟨c, hc, hφ'.eventually hev⟩
  have hret : ∀ G : ℝ, 0 < G → ∃ πs : ℕ → Euclid (m + 1 + k) → Euclid (m + 1 + k),
      (∀ᶠ j in atTop, ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧
        MapsTo (πs j) (ball 0 G) (dilation x (lams (φ j)) '' (U ∩ N)) ∧
        (∀ y ∈ dilation x (lams (φ j)) '' (U ∩ N) ∩ ball 0 G, πs j y = y) ∧
        ∀ y ∈ ball 0 G, ‖πs j y‖ ≤ 2 * ‖y‖) ∧
      ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G,
        ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖ := by
    intro G hG
    obtain ⟨πs, hev, hlip⟩ := hπ G hG
    exact ⟨fun j => πs (φ j), hφ'.eventually hev, fun η hη => hφ'.eventually (hlip η hη)⟩
  -- step 4: comparison with retracted competitors along subsequences of `S_{φ(j)}`
  have hcomp := Submission.dtc_bc_local_comparison (m + 1 + k) m
    (fun j => dilation x (lams (φ j)) '' U) (fun j => dilation x (lams (φ j)) '' (U ∩ N))
    (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') Ŝ C ρ (by omega) (fun j => hUo (φ j))
    (fun j => hSmin (φ j)) (fun j => hSspt (φ j)) hmass hret hCim hŜim hŜbd hŜC hρ hρU hŜS
  -- steps 5–6: `C` is minimizing in `ℝ^{n+k}` and `μ_{S_{φ(j)}} → μ_C`
  obtain ⟨hCmin, hmeas⟩ := Submission.dtc_bc_minimizing_of_local_comparison (m + 1 + k) (m + 1)
    (fun j => dilation x (lams (φ j)) '' U) (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne')
    C (fun j => hUo (φ j)) (fun R => hφ'.eventually (hUex R)) hCim hconv hcomp
  exact ⟨φ, C, hφ, hconv, hmeas, hCmin, hCbd⟩

/-- **A constant mass ratio about `0` makes `C` a cone** (proof of Simon 7.3.1, chapter-07.txt
lines 336–360, with Ch. 4, 3.6 and Ch. 6, 2.33).  Let `C = τ(M, θ, ξ)` have `∂C = 0`, let
`V = v(M, θ)` be stationary in `ℝᴾ` and `M_{B_ρ(0)}(C) = ωₙρⁿθ₀` for all `ρ > 0`.  Stationarity
along `ℝᴾ` imposes no tangency condition (`γ(t) = y + tv` shows `v ∈ T_y ℝᴾ`), so `δV(X) = 0`
for every `C¹` compactly supported `X`; and `M_{B_ρ(0)}(C) = μ_V(B_ρ(0))` turns the hypothesis
into `μ_V(B_ρ(0)) = aρⁿ` with `a = ωₙθ₀`.  The monotonicity identity then gives `x ∈ TₓM` for
`μ_V`-a.e. `x`, hence `x ∧ C⃗ = 0` `μ_C`-a.e., and Lemma 6.2.33 gives `η_{0,λ#}C = C`. -/
theorem Submission.dtc_cone_of_constant_density : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (θ : ℝ), 0 < n → IsIntegerMultiplicity C → BoundaryVanishes C → (∀ R : IMRep (univ : Set (Euclid P)) n, R.Represents C → R.IsStationaryAlong univ) → (∀ ρ : ℝ, 0 < ρ → C.massOn (ball 0 ρ) = unitBallVolume n * ENNReal.ofReal (ρ ^ n) * ENNReal.ofReal θ) → IsConeCurrent C := by
  intro P n C θ hn hC hbdry hstat hmass
  obtain ⟨R, hR⟩ := hC
  -- `T_y ℝᴾ` contains every `v` (`γ(t) = y + tv`), so `δV(X) = 0` for every `X ∈ C¹_c(ℝᴾ; ℝᴾ)`
  have hvar : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
      R.firstVariation X = 0 := by
    intro X hX hXc
    refine hstat R hR X hX hXc (subset_univ _) fun y _ => ?_
    refine ⟨fun t => y + t • X y, (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffOn,
      mapsTo_univ _ _, by simp, ?_⟩
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (X y)).const_add y
  -- `μ_V(B_ρ(0)) = M_{B_ρ(0)}(C) = (ωₙθ₀)ρⁿ`
  have hball : ∀ ρ : ℝ, 0 < ρ →
      R.measure (ball 0 ρ) = unitBallVolume n * ENNReal.ofReal θ * ENNReal.ofReal (ρ ^ n) := by
    intro ρ hρ
    rw [← Submission.dtc_mass_eq_measure P n univ (ball 0 ρ) C R isOpen_univ isOpen_ball
      (subset_univ _) hR, hmass ρ hρ, mul_right_comm]
  -- `x ∈ TₓM` for `μ_V`-a.e. `x`, so `x ∧ C⃗ = 0` `μ_C`-a.e., so `C` is a cone (Lemma 6.2.33)
  exact Submission.dtc_cone_of_wedge_vanishing P n C R hn hR hbdry
    (Submission.dtc_cone_wedge_vanishes P n univ R
      (Submission.dtc_cone_radial_tangency P n R (unitBallVolume n * ENNReal.ofReal θ) hvar hball))

/-- **Simon 7.3.1 (Theorem, p. 187)**: densities and tangent cones of minimizing currents (proof:
chapter-07.txt lines 302–364, with (1) on `U \ spt ∂T` and (2) at `x ∈ spt T \ spt ∂T`, README
erratum 3).  For `n = 0`, `T = 0` (`dtc_dim_zero_eq_zero`): `Θ ≡ 0` and (2) is vacuous.  For
`n > 0`, the restriction `T'` of `T` to `U' = U \ spt ∂T` is a minimizing cycle in `U ∩ N` with the
masses of `T` on subsets of `U'` (`dtc_localize`), so by 7.1.2 (`minimizing_implies_stationary`)
its varifold has locally bounded mean curvature and the monotonicity formula gives the density `Θ`
of `T'`, upper semicontinuous on `U'` (`dtc_density_usc`); `Θ` is also the density of `T`, since
`M_{B_ρ(x)}(T') = M_{B_ρ(x)}(T)` once `B_ρ(x) ⊆ U'`.  At `x ∈ spt T \ spt ∂T`, a subsequence of the
blow-ups `η_{x,λⱼ#}T` converges to a minimizing cycle `C` in `ℝ^{n+k}` with `μ_{η_{x,λⱼ#}T} → μ_C`
(`dtc_blowUp_compactness`), whence `M_{B_ρ(0)}(C) = ωₙρⁿΘ(x)` for every `ρ > 0` and
`Θⁿ(μ_C, 0) = Θ(x)` (`dtc_blowUp_density`, book (1)–(4)).  `C` is stationary in `ℝ^{n+k}` (7.1.2
with `N = U = ℝ^{n+k}`, the identity chart), so its constant density ratio makes it a cone
(`dtc_cone_of_constant_density`). -/
theorem Submission.density_and_tangent_cones : DensityAndTangentCones := by
  intro n k ℓ hℓ U N T hU hN hNU hmin hspt
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- Step 1: `n = 0`, so `T = 0`, `Θ ≡ 0`, and (2) is vacuous
    obtain ⟨-, hsupp, hmass⟩ := Submission.dtc_dim_zero_eq_zero (0 + k) U (U ∩ N) T hU hmin hspt
    refine ⟨⟨fun _ => 0, fun x _ => ⟨le_rfl, ?_⟩, upperSemicontinuousOn_const⟩, fun x hx => ?_⟩
    · simp only [hmass, ENNReal.zero_div, ENNReal.ofReal_zero]
      exact tendsto_const_nhds
    · rw [hsupp] at hx
      exact absurd hx.1 (Set.notMem_empty x)
  -- Step 2: `T' = T⌞U'`, `U' = U \ spt ∂T`, is a minimizing cycle with the masses of `T`
  obtain ⟨hU', hmin', hbd', hspt', hmass'⟩ :=
    Submission.dtc_localize (n + k) n U (U ∩ N) T hU hn hmin
  have hNU' : (closure N \ N) ∩ (U \ boundarySupport T) = ∅ :=
    subset_empty_iff.mp ((inter_subset_inter_right _ Set.sdiff_subset).trans hNU.subset)
  have hminN : IsMinimizingIn (T.restrictDomain (Set.sdiff_subset : U \ boundarySupport T ⊆ U))
      (N ∩ (U \ boundarySupport T)) := by
    refine ⟨hmin'.1, fun W S hW hWc hS hSbd hSc hSA => hmin'.2 W S hW hWc hS hSbd hSc ?_⟩
    exact hSA.trans (inter_subset_inter_left W fun y hy => ⟨hy.2.1, hy.1⟩)
  -- Step 3: by 7.1.2 the varifold of `T'` has locally bounded mean curvature in `U'`, so the
  -- density `Θ` of `T'` exists and is upper semicontinuous on `U'`
  obtain ⟨R', hR'⟩ := hmin'.1
  have hH := (Submission.minimizing_implies_stationary n k ℓ hℓ (U \ boundarySupport T) N
    (T.restrictDomain (Set.sdiff_subset : U \ boundarySupport T ⊆ U)) hU' hN hNU'
    (hspt'.trans fun y hy => (hspt hy).2) hminN hbd' R' hR').2
  obtain ⟨Θ, hΘ', hΘusc⟩ :=
    Submission.dtc_density_usc (n + k) n (U \ boundarySupport T) _ R' hU' hn hR' hH
  -- `Θ` is the density of `T` on `U'`: `M_{B_ρ(x)}(T') = M_{B_ρ(x)}(T)` once `B_ρ(x) ⊆ U'`
  have hΘ : ∀ x ∈ U \ boundarySupport T, HasMassDensity T x (Θ x) := by
    intro x hx
    obtain ⟨hΘ0, hlim⟩ := hΘ' x hx
    refine ⟨hΘ0, hlim.congr' ?_⟩
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hU' x hx
    filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
    rw [hmass' _ ((ball_subset_ball hρ.2.le).trans hball)]
  refine ⟨⟨Θ, hΘ, hΘusc⟩, fun x hx lams hlams hlim => ?_⟩
  have hxU : x ∈ U := (hspt hx.1).1
  have hxΘ : HasMassDensity T x (Θ x) := hΘ x ⟨hxU, hx.2⟩
  -- Step 4: a subsequence of the blow-ups converges to a minimizing cycle `C`, with mass measures
  obtain ⟨φ, C, hφ, hconv, hmeas, hCmin, hCbd⟩ := Submission.dtc_blowUp_compactness n k ℓ hℓ hn
    U N T x (Θ x) hU hN hNU hmin hspt hx hxΘ lams hlams hlim
  -- Step 5: `M_{B_ρ(0)}(C) = ωₙρⁿΘ(x)` for every `ρ > 0`, and `Θⁿ(μ_C, 0) = Θ(x)`
  obtain ⟨hCball, hCdens⟩ := Submission.dtc_blowUp_density (n + k) n U T C x (Θ x)
    (fun j => lams (φ j)) (fun j => hlams (φ j)) hU hn hxU hmin.1 hCmin.1
    (hlim.comp hφ.tendsto_atTop) hxΘ hmeas
  -- Step 6: `C` is stationary in `ℝ^{n+k}` (7.1.2 with `N = U = ℝ^{n+k}`), hence a cone
  have huniv : IsEmbeddedSubmanifold 2 (n + k) (univ : Set (Euclid (n + k))) := by
    intro y _
    refine ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiff_id.contDiffOn,
      injOn_id _, by simp, fun K _ hK => by simpa using hK, fun z _ => ?_⟩
    rw [fderiv_id]
    exact fun a b h => h
  have hCstat : ∀ R : IMRep (univ : Set (Euclid (n + k))) n, R.Represents C →
      R.IsStationaryAlong univ := fun R hR =>
    (Submission.minimizing_implies_stationary n k k le_rfl univ univ C isOpen_univ huniv
      (by simp) (subset_univ _) (by simpa using hCmin) hCbd R hR).1
  exact ⟨φ, C, hφ, hconv, hmeas, hCmin,
    Submission.dtc_cone_of_constant_density (n + k) n C (Θ x) hn hCmin.1 hCbd hCstat hCball,
    Θ x, hxΘ, hCdens⟩

/-- **Simon 7.3.1 (Theorem, p. 187)** (chapter-07.txt lines 302–364; (1) on `U \ spt ∂T` and (2)
at `x ∈ spt T \ spt ∂T`, README erratum 3): densities exist and are upper semicontinuous off
`spt ∂T`, and blow-ups at `x ∈ spt T \ spt ∂T` subconverge, with their mass measures, to minimizing
cones `C` with `Θⁿ(μ_C, 0) = Θⁿ(μ_T, x)`.  The type is that of `Submission.density_and_tangent_cones`
(DAG node `root.density_and_tangent_cones-a1`), which carries out the frozen proof's seven steps
with 7.1.2 in the role of the stationarity sibling; as the frozen proof's registration note
provides, this inherited prerequisite is reused at its identical type. -/
theorem Submission.idtp_cttp_ctc_density_tangent_cones : DensityAndTangentCones :=
  Submission.density_and_tangent_cones

/-- **Tangent cones of minimizing cycles in `ℝᴾ`** (Simon 7.3.1(2), chapter-07.txt lines 302–309,
with the density bound of Ch. 4, 3.13).  Let `C ∈ 𝒟ₙ(ℝᴾ)`, `n ≥ 1`, be minimizing in `ℝᴾ` with
`∂C = 0`, let `p ∈ spt C` and `λⱼ > 0`, `λⱼ → 0`.  If `P < n`, every `n`-covector on `ℝᴾ`
vanishes, so `C` kills every test form and `spt C = ∅` (`rsd_cmr_support_subset_of_vanish`);
hence `P = n + k`.  With `U = N = ℝⁿ⁺ᵏ` (the identity chart) and `spt ∂C = spt 0 = ∅`, Simon 7.3.1
(`idtp_cttp_ctc_density_tangent_cones`) gives a density `Θ` of `C`, upper semicontinuous on `ℝᴾ`,
and at `p` a subsequence `λ_{φ(j)}` and a minimizing cone `C'` with `η_{p,λ_{φ(j)}#}C ⇀ C'`,
`μ_{η_{p,λ_{φ(j)}#}C} → μ_{C'}` and `Θⁿ(μ_C, p) = Θⁿ(μ_{C'}, 0) = θ`.  For a representation
`C = τ(M, ϑ, ξ)`, `M_W(C) = μ_C(W)` with `μ_C = ϑHⁿ⌞M` and `spt C = spt μ_C`
(`dimred_im_mass_measure`), and the density of `μ_C` is `≥ 1` `μ_C`-a.e.
(`dimred_mono_ae_ball_density_ge_one`), so upper semicontinuity of `Θ` gives `θ ≥ 1`
(`dimred_mono_support_density_ge_one_of_usc`).  Finally `∂C' = 0`, `C'` being a weak limit of
blow-ups of the cycle `C` (`idtp_tpf_blowUp_limit_boundaryVanishes`). -/
theorem Submission.idtp_cttp_cycle_tangent_cone : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), 1 ≤ n → IsMinimizingIn C univ → BoundaryVanishes C → ∀ p ∈ C.support, ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C' : GeometricCurrentOn (univ : Set (Euclid P)) n) (θ : ℝ), StrictMono φ ∧ ConvergesWeakly (fun j => blowUp C p (lams (φ j)) (hlams (φ j)).ne') C' ∧ MassMeasuresConverge (fun j => blowUp C p (lams (φ j)) (hlams (φ j)).ne') C' ∧ IsMinimizingIn C' univ ∧ IsConeCurrent C' ∧ BoundaryVanishes C' ∧ 1 ≤ θ ∧ HasMassDensity C p θ ∧ HasMassDensity C' 0 θ := by
  intro P n C hn hmin hbd p hp lams hlams hlim
  -- Step 1: `n ≤ P`; otherwise `n > P` vectors are dependent, every `n`-covector vanishes, `C`
  -- kills every test form and `spt C = ∅`
  have hnP : n ≤ P := by
    by_contra! hPn
    have hcov : ∀ α : Covector (Euclid P) n, α = 0 := fun α => by
      ext v
      refine α.toAlternatingMap.map_linearDependent v fun hv => ?_
      have hcard := hv.fintype_card_le_finrank
      rw [Fintype.card_fin, finrank_euclideanSpace_fin] at hcard
      omega
    refine Set.notMem_empty p ((Submission.rsd_cmr_support_subset_of_vanish P n univ ∅ C
      isOpen_univ isCompact_empty (empty_subset _) fun ω _ => ?_).1 hp)
    rw [show ω = 0 from Subtype.ext (funext fun x => (hcov _).trans (hcov _).symm)]
    exact map_zero C.toCurrent
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnP
  -- Step 2: `ℝⁿ⁺ᵏ` is an embedded `C²` `(n + k)`-submanifold of itself (the identity chart)
  have huniv : IsEmbeddedSubmanifold 2 (n + k) (univ : Set (Euclid (n + k))) := by
    intro y _
    refine ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiff_id.contDiffOn,
      injOn_id _, by simp, fun K _ hK => by simpa using hK, fun z _ => ?_⟩
    rw [fderiv_id]
    exact fun a b h => h
  -- Step 3: `spt ∂C = spt 0 = ∅`
  have hbsupp : boundarySupport C = ∅ := by
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    change C.boundary = 0 at hbd
    change C.boundary.support = ∅
    rw [hbd]
    exact subset_empty_iff.mp (Submission.rsd_cmr_support_subset_of_vanish (m + 1 + k) m univ ∅ 0
      isOpen_univ isCompact_empty (empty_subset _) fun ω _ => GeometricCurrentOn.zero_apply ω).1
  -- Step 4: Simon 7.3.1 with `U = N = ℝⁿ⁺ᵏ`, `ℓ = k`: the density `Θ` of `C`, upper
  -- semicontinuous on `ℝⁿ⁺ᵏ \ spt ∂C = ℝⁿ⁺ᵏ`, and at `p` the minimizing cone `C'`
  obtain ⟨⟨Θ, hΘ, hΘusc⟩, htan⟩ := Submission.idtp_cttp_ctc_density_tangent_cones n k k le_rfl
    univ univ C isOpen_univ huniv (by simp) (by rwa [Set.inter_self]) (by simp)
  rw [hbsupp, Set.sdiff_empty] at hΘ hΘusc
  obtain ⟨φ, C', hφ, hconv, hmeas, hC'min, hC'cone, θ, hθC, hθC'⟩ :=
    htan p ⟨hp, by rw [hbsupp]; exact Set.notMem_empty p⟩ lams hlams hlim
  -- Step 5: `θ ≥ 1`: for `C = τ(M, ϑ, ξ)`, `M_W(C) = μ_C(W)`, `spt C = spt μ_C`, the density of
  -- `μ_C` is `≥ 1` `μ_C`-a.e., and `Θ` is upper semicontinuous
  obtain ⟨R, hR⟩ := hmin.1
  obtain ⟨hmass, hsupp, -⟩ := Submission.dimred_im_mass_measure (n + k) n univ C R isOpen_univ hR
  have hθ1 : 1 ≤ θ := Submission.dimred_mono_support_density_ge_one_of_usc (n + k) n univ C
    R.measure Θ isOpen_univ hmass (fun x hx => (hsupp x (mem_univ x)).1 hx)
    (Submission.dimred_mono_ae_ball_density_ge_one (n + k) n univ R isOpen_univ) hΘ hΘusc p hp θ
    hθC
  -- Step 6: `∂C' = 0`, `C'` being the weak limit of the blow-ups `η_{p,λ_{φ(j)}#}C` of a cycle
  have hC'bd : BoundaryVanishes C' := Submission.idtp_tpf_blowUp_limit_boundaryVanishes (n + k) n
    univ C p (fun j => lams (φ j)) (fun j => hlams (φ j)) C' isOpen_univ (mem_univ p) hbd
    (hlim.comp hφ.tendsto_atTop) hconv
  exact ⟨φ, C', θ, hφ, hconv, hmeas, hC'min, hC'cone, hC'bd, hθ1, hθC, hθC'⟩
/-- **`Hⁿ` of a disc in the span of an orthonormal family**: if `τ₁, …, τₙ` are orthonormal in
`ℝᴾ`, `Q = span{τ₁, …, τₙ}`, `y ∈ Q` and `ρ > 0`, then `Hⁿ(B_ρ(y) ∩ Q) = ωₙρⁿ`.  The map
`ψ(a) = Σᵢ aᵢτᵢ` is a linear isometry `ℝⁿ → ℝᴾ` with range `Q`, so `ψ(B_ρ(b)) = B_ρ(y) ∩ Q` for
`y = ψ(b)`; `Hⁿ` is invariant under isometries and equals Lebesgue measure on `ℝⁿ`, and
`Lⁿ(B_ρ(b)) = ρⁿ Lⁿ(B₁(0))`. -/
theorem Submission.idtp_cttp_span_ball_measure : ∀ (P n : ℕ) (τ : Fin n → Euclid P), Orthonormal ℝ τ → ∀ y ∈ Submodule.span ℝ (Set.range τ), ∀ ρ : ℝ, 0 < ρ → μHE[n] (ball y ρ ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) = unitBallVolume n * ENNReal.ofReal (ρ ^ n) := by
  intro P n τ hτ y hy ρ hρ
  -- Step 1: `ψ(a) = Σᵢ aᵢτᵢ` is a linear isometry `ℝⁿ → ℝᴾ`
  let f : Euclid n →ₗ[ℝ] Euclid P :=
    (Fintype.linearCombination ℝ τ).comp (WithLp.linearEquiv 2 ℝ (Fin n → ℝ)).toLinearMap
  have hf : ∀ a, f a = ∑ i, a i • τ i := fun a => by
    simp [f, Fintype.linearCombination_apply]
  -- the basis `v` is passed explicitly: leaving it implicit makes unification time out
  let v : Module.Basis (Fin n) ℝ (Euclid n) := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis
  have hv : Orthonormal ℝ v := by
    rw [OrthonormalBasis.coe_toBasis]
    exact (EuclideanSpace.basisFun (Fin n) ℝ).orthonormal
  have hfv : f ∘ v = τ := by
    funext i
    simp [hf, v]
  let ψ : Euclid n →ₗᵢ[ℝ] Euclid P := f.isometryOfOrthonormal hv (by rw [hfv]; exact hτ)
  have hψ : ∀ a, ψ a = ∑ i, a i • τ i := fun a => by
    rw [LinearMap.coe_isometryOfOrthonormal, hf]
  -- Step 2: `range ψ = Q`
  have hrange : range ψ = (Submodule.span ℝ (range τ) : Set (Euclid P)) := by
    ext z
    constructor
    · rintro ⟨a, rfl⟩
      rw [hψ]
      exact Submodule.sum_mem _ fun i _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · intro hz
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hz
      exact ⟨WithLp.toLp 2 c, by rw [hψ]; simpa using hc⟩
  -- Step 3: `ψ(B_ρ(b)) = B_ρ(y) ∩ Q`, where `y = ψ(b)`
  obtain ⟨b, rfl⟩ : y ∈ range ψ := by rw [hrange]; exact hy
  have himage : ψ '' ball b ρ =
      ball (ψ b) ρ ∩ (Submodule.span ℝ (range τ) : Set (Euclid P)) := by
    rw [← hrange]
    ext z
    constructor
    · rintro ⟨a, ha, rfl⟩
      exact ⟨by rw [mem_ball, ψ.isometry.dist_eq]; exact ha, ⟨a, rfl⟩⟩
    · rintro ⟨hz, ⟨a, rfl⟩⟩
      exact ⟨a, by rw [mem_ball, ← ψ.isometry.dist_eq]; exact hz, rfl⟩
  -- Step 4: isometry invariance of `Hⁿ`, `Hⁿ = Lⁿ` on `ℝⁿ`, and scaling of Haar measure of balls
  rw [← himage, ψ.isometry.euclideanHausdorffMeasure_image,
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_ball_of_pos _ _ hρ,
    finrank_euclideanSpace_fin, mul_comm]
  rfl
/-- **Face replacement** (Simon Ch. 6, proof of the Deformation Theorem 5.1, (26)–(37)): an
integer multiplicity `Q ∈ 𝒟ₙ(ℝᴾ)`, `n = m + 1 < P`, vanishing off `L_n ∩ K` (`K` compact) with
`M(∂Q) < ∞` is the lattice chain `Pc = Σ_{p ∈ s} β_p [[F_p]]` up to an integer multiplicity error
`Q − Pc` with `M(Q − Pc) ≤ c M(∂Q)`, where `Σ_p |β_p| ≤ c M(Q)` and `c = max(c_cp, 2)`.
The faces meeting `K` carry `Q` (`dor_lmb_fcd_fr_skeleton_cells`), so
`Q = Σ_p u_p [[F_p°]]` with integer densities `u_p` and `Σ_p ∫|u_p| ≤ M(Q)` ((26)–(28), (33));
testing `∂Q` near each face bounds the variation of `u_p` by `V_p`, `Σ_p V_p ≤ M(∂Q)` ((28)); the
cube Poincaré inequality gives integer medians `β_p` with `∫|u_p − β_p| ≤ c_cp V_p` and
`|β_p| ≤ 2∫|u_p|` ((31), (32), (35)).  Then `Q − Pc = Σ_p (u_p − β_p)[[F_p°]]` ((29)) has mass
`≤ Σ_p ∫|u_p − β_p| ≤ c_cp M(∂Q)` ((34)), `Σ_p |β_p| ≤ 2 M(Q)` ((36)), `Pc` is integer
multiplicity, and `Q − Pc` vanishes off `cthickening(√P, K) ⊇ F_p`. -/
theorem Submission.dor_lmb_fcd_face_replacement : ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (K : Set (Euclid P)) (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact K → IsIntegerMultiplicity Q → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) ({x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩ K) → Q ω = 0) → Q.boundary.mass ≠ ∞ → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity (Q - Pc) ∧ (Q - Pc).mass ≤ ENNReal.ofReal c * Q.boundary.mass ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) ≤ ENNReal.ofReal c * Q.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ⊆ cthickening (Real.sqrt P) K) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (Real.sqrt P) K) → (Q - Pc) ω = 0 := by
  intro P m hmP
  -- `c_cp`: the cube Poincaré constant with integer medians (Simon Ch. 2, 2.7; Ch. 6, (31), (35))
  obtain ⟨ccp, hccp, hcp⟩ := Submission.dor_lmb_fcd_cube_poincare m
  refine ⟨max ccp 2, le_max_of_le_right zero_le_two, ?_⟩
  intro K Q hK hQ hQK hbd
  -- the finitely many faces `F_p` (`p ∈ s`) meeting `K`; their open faces carry `L_n ∩ K` a.e.
  obtain ⟨s, hs, hsK, hL, hcover⟩ := Submission.dor_lmb_fcd_fr_skeleton_cells P m K hmP hK
  -- (26)–(28), (33): `Q = Σ_p u_p [[F_p°]]` with integer densities and `Σ ∫|u_p| ≤ M(Q)`
  obtain ⟨u, huZ, huint, humass, hQu⟩ := Submission.dor_lmb_fcd_fr_face_representation P m s _ Q
    hs (hL.inter hK.isClosed) hcover hQ hQK
  -- (28): `∫ u_p div g ≤ V_p` for admissible `g`, with `Σ V_p ≤ M(∂Q)`
  obtain ⟨V, -, hVsum, hVvar⟩ :=
    Submission.dor_lmb_fcd_fr_boundary_variation P m s u Q hs hQu hbd
  -- (31), (32), (35): integer medians `β_p` with `∫|u_p − β_p| ≤ c_cp V_p`, `|β_p| ≤ 2∫|u_p|`
  have hβex : ∀ p, ∃ b : ℤ, p ∈ s →
      (∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y - b|) ≤ ccp * V p ∧
        |(b : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y| := by
    intro p
    by_cases hp : p ∈ s
    · obtain ⟨b, hb⟩ := hcp (u p) (V p) (huZ p hp) (huint p hp) (hVvar p hp)
      exact ⟨b, fun _ => hb⟩
    · exact ⟨0, fun h => absurd h hp⟩
  choose β hβ using hβex
  -- constants are integrable on the unit cube `Q₁ = (0, 1)ⁿ`, of volume `1`
  have hconst : ∀ p ∈ s, ∀ b : ℝ,
      IntegrableOn (fun _ : Euclid (m + 1) => b) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    intro p hp b
    have h1 := (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).1
    exact integrableOn_const (by rw [h1]; exact ENNReal.one_ne_top)
  -- the lattice chain `Pc = Σ_p β_p [[F_p]]`, and integrability of the face integrands
  obtain ⟨hβint, ⟨Pc, hPc⟩, -⟩ := Submission.dor_lmb_fcd_fr_chain_current P m s
    (fun p _ => (β p : ℝ)) hs fun p hp => hconst p hp _
  obtain ⟨huωint, -, -⟩ := Submission.dor_lmb_fcd_fr_chain_current P m s u hs huint
  -- the mass bound for currents with face densities `u_p − β_p`
  obtain ⟨-, -, hDmass⟩ := Submission.dor_lmb_fcd_fr_chain_current P m s
    (fun p y => u p y - β p) hs fun p hp => Integrable.sub (huint p hp) (hconst p hp _)
  beta_reduce at hβint hPc hDmass
  -- (29): `Q − Pc = Σ_p (u_p − β_p) [[F_p°]]`
  have hQP : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), (Q - Pc) ω =
      ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        (u p y - β p) * (ω : DifferentialForm (Euclid P) (m + 1))
          (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
    intro ω
    show Q ω - Pc ω = _
    rw [hQu ω, hPc ω, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [← integral_sub (huωint ω p hp) (hβint ω p hp)]
    congr 1
    funext y
    ring
  refine ⟨s, β, Pc, hs, ?_, ?_, ?_, ?_, hsK, ?_⟩
  · -- the face formula of `Pc`: `∫_{F_p} f dHⁿ = ∫_{Q₁} f ∘ Φ_p`
    intro ω
    rw [hPc ω]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [(Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.1]
    exact integral_const_mul _ _
  · -- `Pc` is integer multiplicity, hence so is `Q − Pc`
    exact Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ Q Pc isOpen_univ hQ
      (Submission.dor_lmb_fcd_fr_lattice_chain_im P m s β Pc hs hPc)
  · -- (34): `M(Q − Pc) ≤ Σ_p ∫|u_p − β_p| ≤ c_cp Σ_p V_p ≤ c M(∂Q)`
    calc (Q - Pc).mass
        ≤ ENNReal.ofReal (∑ p ∈ s,
            ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y - β p|) :=
          hDmass (Q - Pc) hQP
      _ ≤ ENNReal.ofReal (ccp * ∑ p ∈ s, V p) := by
          refine ENNReal.ofReal_le_ofReal ?_
          rw [Finset.mul_sum]
          exact Finset.sum_le_sum fun p hp => (hβ p hp).1
      _ = ENNReal.ofReal ccp * ENNReal.ofReal (∑ p ∈ s, V p) := ENNReal.ofReal_mul hccp.le
      _ ≤ ENNReal.ofReal (max ccp 2) * Q.boundary.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_left _ _)) hVsum
  · -- (36): `Σ_p |β_p| ≤ 2 Σ_p ∫|u_p| ≤ c M(Q)`
    calc (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞))
        = ENNReal.ofReal (∑ p ∈ s, |(β p : ℝ)|) := by
          rw [ENNReal.ofReal_sum_of_nonneg fun p _ => abs_nonneg _]
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [← ENNReal.ofReal_natCast, Nat.cast_natAbs, Int.cast_abs]
      _ ≤ ENNReal.ofReal (2 * ∑ p ∈ s,
            ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y|) := by
          refine ENNReal.ofReal_le_ofReal ?_
          rw [Finset.mul_sum]
          exact Finset.sum_le_sum fun p hp => (hβ p hp).2
      _ = ENNReal.ofReal 2 * ENNReal.ofReal (∑ p ∈ s,
            ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y|) :=
          ENNReal.ofReal_mul zero_le_two
      _ ≤ ENNReal.ofReal (max ccp 2) * Q.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_right _ _)) humass
  · -- `Q − Pc` vanishes off `cthickening(√P, K)`, which contains every `F_p ⊇ Φ_p(Q₁)`
    intro ω hω
    rw [hQP ω]
    refine Finset.sum_eq_zero fun p hp => setIntegral_eq_zero_of_forall_eq_zero fun y hy => ?_
    have hmem := (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.1 y
      fun i => ⟨(hy i).1.le, (hy i).2.le⟩
    rw [image_eq_zero_of_notMem_tsupport (Set.disjoint_right.1 hω (hsK p hp hmem))]
    simp

/-- **Simon Ch. 6, Deformation Theorem 5.1 (unit scale), display (38) and the end of its proof.**
Let `n = m + 1 < P`, `K` compact and `T ∈ 𝒟ₙ(ℝᴾ)` integer multiplicity, with `∂T` integer
multiplicity and `T` vanishing off `K`.  By 3.2(3), `μ_T` and `μ_{∂T}` are carried by `K`, where
the multiplicities are integrable, so `M(T), M(∂T) < ∞`.  The skeleton deformation gives
`T − Q = ∂R₁ + S₁` with `Q` carried by the `n`-skeleton in `K_Q = cthickening(√P, K)`; face
replacement gives the unit lattice chain `Pc = Σ_{p ∈ s} β_p [[F_p]]` with `M(Q − Pc) ≤ c_f M(∂Q)`
and `Σ_p |β_p| ≤ c_f M(Q)`.  Then `R = R₁` and `S = S₁ + (Q − Pc)` give `T − Pc = ∂R + S` with
`c = c_s(1 + c_f)`, and `cthickening(√P, K_Q) ⊆ cthickening(2√P, K)`. -/
theorem Submission.dor_lmb_fcd_unit_deformation : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (K) → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal c * T.mass ∧ S.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ⊆ cthickening (2 * Real.sqrt P) K) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (2 * Real.sqrt P) K) → R ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (2 * Real.sqrt P) K) → S ω = 0 := by
  intro hSL hIMS P m hmP
  -- Step 1: the constants `c_s` (skeleton deformation) and `c_f` (face replacement)
  obtain ⟨cs, hcs, hSD⟩ := Submission.dor_lmb_fcd_skeleton_deformation hSL hIMS P m hmP
  obtain ⟨cf, hcf, hFR⟩ := Submission.dor_lmb_fcd_face_replacement P m hmP
  refine ⟨cs * (1 + cf), mul_nonneg hcs (by linarith), ?_⟩
  intro K T hK hT hbT hTK
  -- `(A − B)(ω) = A(ω) − B(ω)` and `M(A − B) ≤ M(A) + M(B)` (with `ω` admissible, so is `−ω`)
  have hsub : ∀ {d : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) d)
      (ω : TestFormOn (univ : Set (Euclid P)) d), (A - B) ω = A ω - B ω := fun _ _ _ => rfl
  have hmass_sub : ∀ {d : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) d),
      (A - B).mass ≤ A.mass + B.mass := by
    intro d A B
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    have hω' : -ω ∈ massAdmissibleOn (univ : Set (Euclid P)) d univ :=
      ⟨subset_univ _, fun x => by simpa using hω.2 x⟩
    have h : (A - B) ω = A ω + B (-ω) := by
      show A.toCurrent ω - B.toCurrent ω = A.toCurrent ω + B.toCurrent (-ω)
      rw [B.toCurrent.map_neg ω, sub_eq_add_neg]
    calc ENNReal.ofReal ((A - B) ω) = ENNReal.ofReal (A ω + B (-ω)) := by rw [h]
      _ ≤ ENNReal.ofReal (A ω) + ENNReal.ofReal (B (-ω)) := ENNReal.ofReal_add_le
      _ ≤ A.mass + B.mass := add_le_add (A.le_massOn hω) (B.le_massOn hω')
  -- Step 2: an integer multiplicity current vanishing off the compact `K` has finite mass:
  -- `M(X) = μ_X(ℝᴾ) = μ_X(K) < ∞`, as `μ_X(ℝᴾ ∖ K) = M_{ℝᴾ∖K}(X) = 0` (3.2(3))
  have hfin : ∀ {d : ℕ} (X : GeometricCurrentOn (univ : Set (Euclid P)) d),
      IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) d,
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) d)) K → X ω = 0) → X.mass ≠ ∞ := by
    intro d X ⟨RX, hRX⟩ hXK
    have hmass := (Submission.dor_imrep_massOn_eq_measure_and_support P d univ X RX isOpen_univ
      hRX).1
    have hKc : RX.measure Kᶜ = 0 := by
      rw [← hmass Kᶜ hK.isClosed.isOpen_compl]
      refine le_antisymm (sSup_le ?_) zero_le
      rintro r ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (X ω) ≤ 0
      rw [hXK ω (disjoint_compl_left.mono_left hω.1), ENNReal.ofReal_zero]
    have hKfin : RX.measure K ≠ ∞ := by
      rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
        Measure.restrict_restrict hK.measurableSet, inter_comm]
      exact RX.locallyIntegrable_mult K hK (subset_univ K)
    show X.massOn univ ≠ ∞
    rw [hmass univ isOpen_univ]
    exact ne_top_of_le_ne_top (by rw [hKc, add_zero]; exact hKfin) (measure_univ_le_add_compl K)
  -- `∂T` vanishes off `K` too, since `spt dω ⊆ spt ω`
  have hbTK : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) K → T.boundary ω = 0 := fun ω hω =>
    hTK _ (hω.mono_left (tsupport_exteriorDerivative_subset (ω : DifferentialForm (Euclid P) m)))
  have hTfin : T.mass ≠ ∞ := hfin T hT hTK
  have hbTfin : T.boundary.mass ≠ ∞ := hfin T.boundary hbT hbTK
  -- Step 3: `T − Q = ∂R₁ + S₁`, `Q` carried by the `n`-skeleton in `K_Q = cthickening(√P, K)`
  obtain ⟨Q, R₁, S₁, hQ, hR₁, hS₁, hTQ, hQmass, hbQmass, hR₁mass, hS₁mass, hQK, hR₁K, hS₁K⟩ :=
    hSD K T hK hT hbT hTK hTfin hbTfin
  -- Step 4: the unit lattice chain `Pc` replacing `Q`, with `M(∂Q) ≤ c_s M(∂T) < ∞`
  have hbQfin : Q.boundary.mass ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hbTfin) hbQmass
  obtain ⟨s, β, Pc, hmono, hPc, hQPc, hQPcmass, hβ, hface, hQPcK⟩ :=
    hFR (cthickening (Real.sqrt P) K) Q hK.cthickening hQ hQK hbQfin
  -- Step 7: `cthickening(√P, K) ⊆ cthickening(2√P, K)` and
  -- `cthickening(√P, cthickening(√P, K)) ⊆ cthickening(2√P, K)`
  have hsq : 0 ≤ Real.sqrt P := Real.sqrt_nonneg _
  have hK₁ : cthickening (Real.sqrt P) K ⊆ cthickening (2 * Real.sqrt P) K :=
    cthickening_mono (by linarith) K
  have hK₂ : cthickening (Real.sqrt P) (cthickening (Real.sqrt P) K) ⊆
      cthickening (2 * Real.sqrt P) K := by
    rw [two_mul]
    exact cthickening_cthickening_subset hsq hsq K
  -- Step 5, (38): `R = R₁`, `S = S₁ + (Q − Pc) = S₁ − ((Q − Q) − (Q − Pc))`, integer multiplicity
  have hIMsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ
  refine ⟨s, β, Pc, R₁, S₁ - ((Q - Q) - (Q - Pc)), hmono, hPc, hR₁,
    hIMsub _ _ isOpen_univ hS₁ (hIMsub _ _ isOpen_univ (hIMsub _ _ isOpen_univ hQ hQ) hQPc),
    fun ω => ?_, ?_, ?_, ?_, fun p hp => (hface p hp).trans hK₂,
    fun ω hω => hR₁K ω (hω.mono_right hK₁), fun ω hω => ?_⟩
  · -- `T − Pc = (T − Q) + (Q − Pc) = ∂R₁ + S₁ + (Q − Pc)`
    simp only [hsub]
    linarith [hTQ ω]
  · -- Step 6: `Σ|β_p| ≤ c_f M(Q) ≤ c_f c_s M(T)`
    calc (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) ≤ ENNReal.ofReal cf * Q.mass := hβ
      _ ≤ ENNReal.ofReal cf * (ENNReal.ofReal cs * T.mass) := by gcongr
      _ = ENNReal.ofReal (cf * cs) * T.mass := by rw [← mul_assoc, ← ENNReal.ofReal_mul hcf]
      _ ≤ ENNReal.ofReal (cs * (1 + cf)) * T.mass := by gcongr ENNReal.ofReal ?_ * _; nlinarith
  · -- `M(R) = M(R₁) ≤ c_s M(T)`
    calc R₁.mass ≤ ENNReal.ofReal cs * T.mass := hR₁mass
      _ ≤ ENNReal.ofReal (cs * (1 + cf)) * T.mass := by gcongr ENNReal.ofReal ?_ * _; nlinarith
  · -- `M(S) ≤ M(S₁) + M(Q − Q) + M(Q − Pc) ≤ c_s M(∂T) + c_f c_s M(∂T)`, as `Q − Q = 0`
    have hQQ : (Q - Q).mass = 0 := by
      refine le_antisymm (sSup_le ?_) zero_le
      rintro r ⟨ω, -, rfl⟩
      show ENNReal.ofReal (Q ω - Q ω) ≤ 0
      rw [sub_self, ENNReal.ofReal_zero]
    calc (S₁ - ((Q - Q) - (Q - Pc))).mass ≤ S₁.mass + ((Q - Q).mass + (Q - Pc).mass) :=
          (hmass_sub _ _).trans (add_le_add le_rfl (hmass_sub _ _))
      _ = S₁.mass + (Q - Pc).mass := by rw [hQQ, zero_add]
      _ ≤ ENNReal.ofReal cs * T.boundary.mass + ENNReal.ofReal cf * Q.boundary.mass :=
          add_le_add hS₁mass hQPcmass
      _ ≤ ENNReal.ofReal cs * T.boundary.mass +
            ENNReal.ofReal cf * (ENNReal.ofReal cs * T.boundary.mass) := by gcongr
      _ = ENNReal.ofReal (cs * (1 + cf)) * T.boundary.mass := by
          rw [← mul_assoc, ← add_mul, ← ENNReal.ofReal_mul hcf,
            ← ENNReal.ofReal_add hcs (mul_nonneg hcf hcs)]
          congr 2
          ring
  · -- `S` vanishes off `cthickening(2√P, K)`: so do `S₁` and `Q − Pc`
    have h₁ := hS₁K ω (hω.mono_right hK₁)
    have h₂ := hQPcK ω (hω.mono_right hK₂)
    simp only [hsub] at h₂ ⊢
    linarith

/-- **Simon Ch. 6, Deformation Theorem 5.3** (5.1 after a change of scale) for an integer
multiplicity `T ∈ 𝒟ₙ(ℝᴾ)`, `n = m + 1 < P`, with integer multiplicity `∂T`, vanishing off a compact
`K`: `T − Π = ∂R + S` with `Π = Σ_{p ∈ s} β_p [[F_p]]` an integer combination of the oriented
faces `F_p = ρ(z_p + F_{ι_p})` of the cubical grid of side `ρ`, `(Σ|β_p|)ρⁿ ≤ c M(T)`,
`M(R) ≤ cρ M(T)`, `M(S) ≤ cρ M(∂T)`, and everything within `2√P ρ` of `K`.  As printed before 5.3:
change scale by `x ↦ ρ⁻¹x`, apply the unit-scale theorem 5.1 to `T' = δ_{ρ⁻¹#}T` (integer
multiplicity, `∂T' = δ_{ρ⁻¹#}∂T` integer multiplicity, vanishing off the compact `ρ⁻¹K`) and
change scale back by `δ_ρ(x) = ρx`.  `δ_ρ` maps the unit faces onto the faces of side `ρ`, with
`∫_{ρA} g dHⁿ = ρⁿ ∫_A g(ρx) dHⁿ(x)` and `δ_{ρ#}X(ω) = X(ρⁿ ω(ρ ·))`; masses of `k`-currents scale
by `ρᵏ`; and `ρ · cthickening(2√P, ρ⁻¹K) ⊆ cthickening(2√P ρ, K)`. -/
theorem Submission.dor_lmb_fc_deformation : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal (c * ρ) * T.mass ∧ S.mass ≤ ENNReal.ofReal (c * ρ) * T.boundary.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ cthickening (2 * Real.sqrt P * ρ) K) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (2 * Real.sqrt P * ρ) K) → R ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (2 * Real.sqrt P * ρ) K) → S ω = 0 := by
  intro hSL P m hPm
  -- Theorem 5.1 at unit scale, and the dilations `δ_λ(x) = λx`
  obtain ⟨c, hc, hunit⟩ :=
    Submission.dor_lmb_fcd_unit_deformation hSL Submission.dor_lmb_fc_im_series P m hPm
  obtain ⟨dil, hdil⟩ := Submission.dor_lmb_fcd_dilation P
  refine ⟨c, hc, fun ρ K T hρ hK hT hbT hTK => ?_⟩
  have hρ' : 0 < ρ⁻¹ := inv_pos.mpr hρ
  obtain ⟨-, hinv, hmass, hIM, -, hvan, -, -⟩ := hdil (m + 1) ρ⁻¹ hρ'
  obtain ⟨-, -, hmass₀, hIM₀, hbd₀, -, -, -⟩ := hdil m ρ⁻¹ hρ'
  obtain ⟨-, -, hmassρ, hIMρ, hbdρ, hvanρ, hactρ, hcovρ⟩ := hdil (m + 1) ρ hρ
  obtain ⟨-, -, hmassρ₂, hIMρ₂, -, hvanρ₂, -, -⟩ := hdil (m + 2) ρ hρ
  -- `T' = δ_{ρ⁻¹#}T` is integer multiplicity with integer multiplicity boundary
  -- `∂T' = δ_{ρ⁻¹#}∂T`, and it vanishes off the compact `ρ⁻¹K`
  have hK' : IsCompact ((fun x : Euclid P => ρ⁻¹ • x) '' K) := hK.image (continuous_const_smul ρ⁻¹)
  have hbT' : (dil (m + 1) ρ⁻¹ T).boundary = dil m ρ⁻¹ T.boundary := hbd₀ T
  have hbT'IM : IsIntegerMultiplicity (dil (m + 1) ρ⁻¹ T).boundary := by
    rw [hbT']
    exact hIM₀ _ hbT
  obtain ⟨s, β, Pc', R', S', hmono, hPc', hR', hS', hTPc', hβ, hR'mass, hS'mass, hface',
      hR'van, hS'van⟩ := hunit _ (dil (m + 1) ρ⁻¹ T) hK' (hIM T hT) hbT'IM (hvan T K hTK)
  -- `δ_{ρ#}T' = T`
  have hTT : dil (m + 1) ρ (dil (m + 1) ρ⁻¹ T) = T := by
    simpa only [inv_inv] using hinv T
  -- `δ_{ρ#}X(ω) = X(η)` with the same test form `η = ρ^{m+1} ω(ρ ·)` for every `X`
  have hpull : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      ∃ η : TestFormOn (univ : Set (Euclid P)) (m + 1),
        (∀ x, (η : DifferentialForm (Euclid P) (m + 1)) x =
          ρ ^ (m + 1) • (ω : DifferentialForm (Euclid P) (m + 1)) (ρ • x)) ∧
        ∀ X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), dil (m + 1) ρ X ω = X η := by
    intro ω
    obtain ⟨η, hη, -⟩ := hactρ T ω
    refine ⟨η, hη, fun X => ?_⟩
    obtain ⟨η', hη', hX⟩ := hactρ X ω
    rw [hX, show η' = η from Subtype.ext (funext fun x => (hη' x).trans (hη x).symm)]
  -- the faces of side `ρ` are the images under `δ_ρ` of the unit faces
  have hface : ∀ p : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
      {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧
        (i ∉ Set.range p.2 → x i = ρ * p.1 i)} =
      (fun x => ρ • x) '' {x : Euclid P | ∀ i : Fin P,
        (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
          (i ∉ Set.range p.2 → x i = p.1 i)} := by
    intro p
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_image]
    constructor
    · intro hx
      refine ⟨ρ⁻¹ • x, fun i => ?_, smul_inv_smul₀ hρ.ne' x⟩
      rw [PiLp.smul_apply, smul_eq_mul]
      refine ⟨fun hi => ?_, fun hi => ?_⟩
      · obtain ⟨h₁, h₂⟩ := (hx i).1 hi
        exact ⟨(le_inv_mul_iff₀ hρ).mpr h₁, (inv_mul_le_iff₀ hρ).mpr h₂⟩
      · rw [(hx i).2 hi, inv_mul_cancel_left₀ hρ.ne']
    · rintro ⟨y, hy, rfl⟩ i
      rw [PiLp.smul_apply, smul_eq_mul]
      refine ⟨fun hi => ?_, fun hi => ?_⟩
      · obtain ⟨h₁, h₂⟩ := (hy i).1 hi
        exact ⟨mul_le_mul_of_nonneg_left h₁ hρ.le, mul_le_mul_of_nonneg_left h₂ hρ.le⟩
      · rw [(hy i).2 hi]
  -- `δ_ρ(cthickening(2√P, ρ⁻¹K)) ⊆ cthickening(2√P ρ, K)`
  have hthick : (fun x => ρ • x) '' cthickening (2 * Real.sqrt P)
      ((fun x : Euclid P => ρ⁻¹ • x) '' K) ⊆ cthickening (2 * Real.sqrt P * ρ) K := by
    rintro _ ⟨y, hy, rfl⟩
    rw [hK'.cthickening_eq_biUnion_closedBall (by positivity)] at hy
    obtain ⟨_, ⟨k, hk, rfl⟩, hyk⟩ := mem_iUnion₂.mp hy
    refine mem_cthickening_of_dist_le _ k _ K hk ?_
    calc dist (ρ • y) k = dist (ρ • y) (ρ • ρ⁻¹ • k) := by rw [smul_inv_smul₀ hρ.ne']
      _ = ρ * dist y (ρ⁻¹ • k) := by rw [dist_smul₀, Real.norm_of_nonneg hρ.le]
      _ ≤ ρ * (2 * Real.sqrt P) := by
        gcongr
        exact mem_closedBall.mp hyk
      _ = 2 * Real.sqrt P * ρ := by ring
  -- `Π = δ_{ρ#}Π'`, `R = δ_{ρ#}R'`, `S = δ_{ρ#}S'`
  refine ⟨s, β, dil (m + 1) ρ Pc', dil (m + 2) ρ R', dil (m + 1) ρ S', hmono, fun ω => ?_,
    hIMρ₂ R' hR', hIMρ S' hS', fun ω => ?_, ?_, ?_, ?_, fun p hp => ?_,
    fun ω hω => hvanρ₂ R' _ hR'van ω (hω.mono_right hthick),
    fun ω hω => hvanρ S' _ hS'van ω (hω.mono_right hthick)⟩
  · -- `Π(ω) = Π'(ρ^{m+1} ω(ρ ·)) = Σ_p β_p ρ^{m+1} ∫_{F¹_p} ω(ρx)(e_{ι_p}) dHⁿ(x)`, which is
    -- `Σ_p β_p [[F_p]](ω)` by the change of variables `x ↦ ρx`
    obtain ⟨η, hη, hX⟩ := hpull ω
    rw [hX, hPc']
    simp_rw [hη, ContinuousAlternatingMap.smul_apply, smul_eq_mul, integral_const_mul]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [hface p, hcovρ]
  · -- `T − Π = δ_{ρ#}(T' − Π') = δ_{ρ#}(∂R' + S') = ∂R + S`
    obtain ⟨η, -, hX⟩ := hpull ω
    have hRb : (dil (m + 2) ρ R').boundary = dil (m + 1) ρ R'.boundary := hbdρ R'
    rw [← hTT, hRb]
    simp only [hX]
    exact hTPc' η
  · -- `(Σ|β_p|)ρⁿ ≤ c M(T')ρⁿ = c M(T)`
    have h1 : ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * ENNReal.ofReal (ρ ^ (m + 1)) = 1 := by
      rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ⁻¹ ^ (m + 1)), ← mul_pow,
        inv_mul_cancel₀ hρ.ne', one_pow, ENNReal.ofReal_one]
    calc (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1))
        ≤ ENNReal.ofReal c * (dil (m + 1) ρ⁻¹ T).mass * ENNReal.ofReal (ρ ^ (m + 1)) := by
          gcongr
      _ = ENNReal.ofReal c * T.mass *
          (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * ENNReal.ofReal (ρ ^ (m + 1))) := by
          rw [hmass T]
          ring
      _ = ENNReal.ofReal c * T.mass := by rw [h1, mul_one]
  · -- `M(R) = ρ^{m+2} M(R') ≤ ρ^{m+2} c M(T') = cρ M(T)`
    have h2 : ENNReal.ofReal (ρ ^ (m + 2)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) =
        ENNReal.ofReal (c * ρ) := by
      rw [← ENNReal.ofReal_mul hc, ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ ^ (m + 2))]
      congr 1
      calc ρ ^ (m + 2) * (c * ρ⁻¹ ^ (m + 1)) = c * ρ * (ρ * ρ⁻¹) ^ (m + 1) := by ring
        _ = c * ρ := by rw [mul_inv_cancel₀ hρ.ne', one_pow, mul_one]
    calc (dil (m + 2) ρ R').mass = ENNReal.ofReal (ρ ^ (m + 2)) * R'.mass := hmassρ₂ R'
      _ ≤ ENNReal.ofReal (ρ ^ (m + 2)) * (ENNReal.ofReal c * (dil (m + 1) ρ⁻¹ T).mass) := by
          gcongr
      _ = ENNReal.ofReal (ρ ^ (m + 2)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) *
          T.mass := by
          rw [hmass T]
          ring
      _ = ENNReal.ofReal (c * ρ) * T.mass := by rw [h2]
  · -- `M(S) = ρ^{m+1} M(S') ≤ ρ^{m+1} c M(∂T') = cρ M(∂T)`
    have h3 : ENNReal.ofReal (ρ ^ (m + 1)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ m)) =
        ENNReal.ofReal (c * ρ) := by
      rw [← ENNReal.ofReal_mul hc, ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ ^ (m + 1))]
      congr 1
      calc ρ ^ (m + 1) * (c * ρ⁻¹ ^ m) = c * ρ * (ρ * ρ⁻¹) ^ m := by ring
        _ = c * ρ := by rw [mul_inv_cancel₀ hρ.ne', one_pow, mul_one]
    calc (dil (m + 1) ρ S').mass = ENNReal.ofReal (ρ ^ (m + 1)) * S'.mass := hmassρ S'
      _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) *
          (ENNReal.ofReal c * (dil (m + 1) ρ⁻¹ T).boundary.mass) := by
          gcongr
      _ = ENNReal.ofReal (ρ ^ (m + 1)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ m)) *
          T.boundary.mass := by
          rw [hbT', hmass₀]
          ring
      _ = ENNReal.ofReal (c * ρ) * T.boundary.mass := by rw [h3]
  · -- `F_p = δ_ρ(F¹_p) ⊆ δ_ρ(cthickening(2√P, ρ⁻¹K)) ⊆ cthickening(2√P ρ, K)`
    rw [hface p]
    exact (image_mono (hface' p hp)).trans hthick

/-- **Top-dimensional Deformation Theorem** (Simon Ch. 6, Theorem 5.3 in the case `n = P`, which
the book excludes; step 2(c) of the flat-convergence argument).  Assume (SL).  For `n = m + 1 = P`
there is `c ≥ 0` such that every IM `T ∈ 𝒟ₙ(ℝᴾ)` with IM boundary, vanishing off a compact `K`,
splits for every `ρ > 0` as `T − Π = ∂R + S`: `Π` is an integer combination of the grid cubes
`ρ(z + [0, 1]ᴾ)`, `R = 0`, `S` is IM, `(Σ|β|)ρⁿ ≤ c M(T)`, `M(S) ≤ cρ M(∂T)`, and the cubes, `R`
and `S` lie in `cthickening(2√(P+1)ρ, K)`.
Proof: embed `ι₀ x = (x, 0)`; `T̃ = ι₀#T` and `∂T̃ = ι₀#∂T` are IM with the masses of `T`, `∂T`,
and `T̃` vanishes off `ι₀(K)`.  Deform `T̃` in `ℝ^{P+1}` (codimension one): `T̃ − Π̃ = ∂R̃ + S̃`.
Test this on `ω̃ = ζ · p^#ω`, `p` the projection and `ζ = 1` near the cells: `T̃(ω̃) = T(ω)`
(`p ∘ ι₀ = id`), `∂R̃(ω̃) = R̃(p^#dω) = 0` since `(n + 1)`-covectors on `ℝⁿ` vanish, vertical
cells drop out and horizontal ones project isometrically onto grid cubes.  So `Π := T − S` with
`S(ω) := S̃(ω̃)` is an integer cube chain, hence IM, and `S = T − Π` is IM; `|ω̃(y)| ≤ |ω(py)|`
gives `M(S) ≤ M(S̃)`, and `p(cthickening(r, ι₀(K))) ⊆ cthickening(r, K)` gives the supports. -/
theorem Submission.dor_lmb_fc_deformation_top : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ), m + 1 = P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal (c * ρ) * T.mass ∧ S.mass ≤ ENNReal.ofReal (c * ρ) * T.boundary.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ cthickening (2 * Real.sqrt (P + 1) * ρ) K) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (2 * Real.sqrt (P + 1) * ρ) K) → R ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (2 * Real.sqrt (P + 1) * ρ) K) → S ω = 0 := by
  intro hSL P m hmP
  subst hmP
  classical
  -- Step 3 (constant): Deformation Theorem 5.3 in `ℝ^{P+1}`, valid as `m + 1 < P + 1`
  obtain ⟨c₀, hc₀, hdef⟩ := Submission.dor_lmb_fc_deformation hSL (m + 1 + 1) m (by omega)
  refine ⟨c₀, hc₀, fun ρ K T hρ hK hT hbT hTK => ?_⟩
  -- Notation: the projection `p y = (y₀, …, y_{P-1})` and the embedding `ι₀ x = (x, 0)`
  let p : Euclid (m + 1 + 1) →L[ℝ] Euclid (m + 1) :=
    (EuclideanSpace.equiv (Fin (m + 1)) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi fun i => EuclideanSpace.proj (Fin.castSucc i))
  have hp : ∀ (y : Euclid (m + 1 + 1)) (i : Fin (m + 1)), p y i = y (Fin.castSucc i) :=
    fun y i => rfl
  let ι₀ : Euclid (m + 1) →L[ℝ] Euclid (m + 1 + 1) :=
    (EuclideanSpace.equiv (Fin (m + 1 + 1)) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi (Fin.snoc (α := fun _ => Euclid (m + 1) →L[ℝ] ℝ)
        (fun i => EuclideanSpace.proj i) 0))
  have hιc : ∀ (x : Euclid (m + 1)) (i : Fin (m + 1)), ι₀ x (Fin.castSucc i) = x i := by
    intro x i
    simp [ι₀]
  have hιl : ∀ x : Euclid (m + 1), ι₀ x (Fin.last (m + 1)) = 0 := by
    intro x
    simp [ι₀]
  have hpι : ∀ x, p (ι₀ x) = x := fun x => by
    ext i
    rw [hp, hιc]
  -- `ι₀` is a linear isometric embedding, hence proper, and `p` is `1`-Lipschitz
  have hιiso : Isometry ι₀ := by
    refine AddMonoidHomClass.isometry_of_norm ι₀ fun x => ?_
    rw [EuclideanSpace.norm_eq (ι₀ x), EuclideanSpace.norm_eq x,
      Fin.sum_univ_castSucc (fun j => ‖(ι₀ x).ofLp j‖ ^ 2)]
    simp [hιc, hιl]
  have hιprop : IsProperMap (fun x => (0 : Euclid (m + 1 + 1)) + ι₀ x) := by
    simpa only [zero_add] using hιiso.isClosedEmbedding.isProperMap
  have hpL : LipschitzWith 1 p := by
    refine LipschitzWith.of_dist_le_mul fun y y' => ?_
    rw [dist_eq_norm, dist_eq_norm, ← map_sub, NNReal.coe_one, one_mul,
      EuclideanSpace.norm_eq (p (y - y')), EuclideanSpace.norm_eq (y - y')]
    refine Real.sqrt_le_sqrt ?_
    rw [Fin.sum_univ_castSucc (fun j => ‖(y - y').ofLp j‖ ^ 2)]
    simp only [hp]
    exact le_add_of_nonneg_right (by positivity)
  -- `(m + 2)`-covectors on the `(m + 1)`-dimensional `ℝ^P` vanish
  have hcov0 : ∀ α : Covector (Euclid (m + 1)) (m + 1 + 1), α = 0 := by
    intro α
    ext v
    refine α.toAlternatingMap.map_linearDependent v fun hli => ?_
    have := hli.fintype_card_le_finrank
    simp at this
  -- Steps 1–2: `T̃ = ι₀#T` and `∂T̃ = ι₀#∂T` are IM, `M(T̃) = M(T)` and `M(∂T̃) = M(∂T)`
  obtain ⟨hTtIM, hTtmass⟩ := Submission.dor_lmb_fc_dtop_isometric_pushforward_im (m + 1)
    (m + 1 + 1) (m + 1) ι₀ hιprop T hιiso hT
  obtain ⟨hbTtIM, hbTtmass⟩ := Submission.dor_lmb_fc_dtop_isometric_pushforward_im (m + 1)
    (m + 1 + 1) m ι₀ hιprop T.boundary hιiso hbT
  have hbTt : (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid (m + 1 + 1))))
      ι₀ 0 hιprop T).boundary = GeometricCurrentOn.affinePushforward
        (V := (univ : Set (Euclid (m + 1 + 1)))) ι₀ 0 hιprop T.boundary :=
    GeometricCurrentOn.boundary_affinePushforward (V := (univ : Set (Euclid (m + 1 + 1))))
      ι₀ 0 hιprop T
  set Tt := GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid (m + 1 + 1))))
    ι₀ 0 hιprop T
  -- `T̃` vanishes off the compact set `ι₀(K)`: `tsupport(ι₀^#η) ⊆ ι₀⁻¹(tsupport η)`
  have hTtK : ∀ η : TestFormOn (univ : Set (Euclid (m + 1 + 1))) (m + 1),
      Disjoint (tsupport (η : DifferentialForm (Euclid (m + 1 + 1)) (m + 1))) (ι₀ '' K) →
        Tt η = 0 := by
    intro η hη
    refine hTK (affinePullbackTestOn ι₀ 0 hιprop univ (m + 1) η)
      (Set.disjoint_left.2 fun x hx hxK => ?_)
    have hx' := tsupport_affinePullbackForm_subset ι₀ 0
      (η : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) hx
    simp only [mem_preimage, zero_add] at hx'
    exact Set.disjoint_left.1 hη hx' (mem_image_of_mem ι₀ hxK)
  -- Step 3: the deformation `T̃ − Π̃ = ∂R̃ + S̃` in `ℝ^{P+1}`, with `K' = ι₀(K)`
  have hK' : IsCompact (ι₀ '' K) := hK.image ι₀.continuous
  obtain ⟨st, βt, Pct, Rt, St, hst, hPct, -, -, hdecomp, hβt, -, hStmass, hcells, hRtvan,
    hStvan⟩ := hdef ρ (ι₀ '' K) Tt hρ hK' hTtIM (by rw [hbTt]; exact hbTtIM) hTtK
  have hrad : 2 * Real.sqrt ((m + 1 + 1 : ℕ) : ℝ) * ρ =
      2 * Real.sqrt (((m + 1 : ℕ) : ℝ) + 1) * ρ := by
    rw [Nat.cast_succ (m + 1)]
  rw [hrad] at hcells hRtvan hStvan
  set r := 2 * Real.sqrt (((m + 1 : ℕ) : ℝ) + 1) * ρ
  have hKt : IsCompact (cthickening r (ι₀ '' K)) := hK'.cthickening
  -- `p(K̃) ⊆ cthickening(r, K)` for `K̃ = cthickening(r, ι₀(K))`, by `p ∘ ι₀ = id` and `Lip p ≤ 1`
  have hpK : ∀ y ∈ cthickening r (ι₀ '' K), p y ∈ cthickening r K := by
    intro y hy
    rw [mem_cthickening_iff] at hy ⊢
    refine le_trans (le_infEDist.2 fun z hz => ?_) hy
    obtain ⟨x, hx, rfl⟩ := hz
    calc infEDist (p y) K ≤ edist (p y) x := infEDist_le_edist_of_mem hx
      _ = edist (p y) (p (ι₀ x)) := by rw [hpι]
      _ ≤ edist y (ι₀ x) := by simpa using hpL.edist_le_mul y (ι₀ x)
  -- Step 4: the cut-off pull-back `ω ↦ ω̃ = ζ · p^#ω`, equal to `p^#ω` on an open `V ⊇ K̃`
  obtain ⟨V, E, hVo, hKtV, hEeq, hdEeq, hEsupp, hEnorm, hEcont⟩ :=
    Submission.dor_lmb_fc_dtop_cutoff_pullback (m + 1) (m + 1) p hp _ hKt
  have hKι : K ⊆ ι₀ ⁻¹' V := fun x hx =>
    hKtV (self_subset_cthickening _ (mem_image_of_mem ι₀ hx))
  -- 5(d): `S(ω) := S̃(ω̃)` is a current in `ℝ^P`, `ω ↦ ω̃` being sequentially continuous
  let S : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 1) :=
    { toCurrent := St.toCurrent.comp E
      continuous' := fun ωs h => St.continuous' (fun j => E (ωs j)) (hEcont ωs h) }
  -- 5(a): `T̃(ω̃) = T(ι₀^# ω̃) = T(ω)`, since `ι₀^# ω̃ = ω` on the open `ι₀⁻¹(V) ⊇ K`
  have h5a : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1), Tt (E ω) = T ω := by
    intro ω
    let X : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1) :=
      affinePullbackTestOn ι₀ 0 hιprop univ (m + 1) (E ω)
    have hX : ∀ x, ι₀ x ∈ V → affinePullbackForm ι₀ 0
        (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) x =
          (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x := by
      intro x hx
      simp only [affinePullbackForm, zero_add]
      rw [hEeq ω (ι₀ x) hx]
      ext v
      have hv : ⇑p ∘ ⇑ι₀ ∘ v = v := funext fun k => hpι (v k)
      simp only [ContinuousAlternatingMap.compContinuousLinearMap_apply, hpι, hv]
    -- `ω − ι₀^# ω̃` vanishes on `ι₀⁻¹(V) ⊇ K`, so `T` kills it
    have hsub : tsupport ((ω - X : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1)) :
        DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ (ι₀ ⁻¹' V)ᶜ := by
      refine closure_minimal (fun x hx hxV => hx ?_)
        (hVo.preimage ι₀.continuous).isClosed_compl
      show (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x - affinePullbackForm ι₀ 0
        (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) x = 0
      rw [hX x hxV, sub_self]
    have hvan := hTK (ω - X) (Disjoint.mono_left hsub (disjoint_compl_left_iff_subset.2 hKι))
    have hlin : T (ω - X) = T ω - T X := T.toCurrent.map_sub ω X
    rw [hlin, sub_eq_zero] at hvan
    exact hvan.symm
  -- 5(b): `∂R̃(ω̃) = R̃(dω̃) = 0`, as `dω̃ = p^#(dω) = 0` on `V ⊇ K̃`
  have h5b : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      Rt.boundary (E ω) = 0 := by
    intro ω
    have hsub : tsupport (exteriorDerivative
        (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1))) ⊆ Vᶜ := by
      refine closure_minimal (fun y hy hyV => hy ?_) hVo.isClosed_compl
      rw [hdEeq ω y hyV,
        hcov0 (exteriorDerivative (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) (p y))]
      ext v
      simp
    exact hRtvan (exteriorDerivativeTestOn univ (m + 1) (E ω))
      (Disjoint.mono_left hsub (disjoint_compl_left_iff_subset.2 hKtV))
  -- 5(c): the cells `F̃_q` of `Π̃`, the grid cubes `G_z` of `ℝ^P`, and the horizontal cells `H`
  let F : (Fin (m + 1 + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1 + 1)) → Set (Euclid (m + 1 + 1)) :=
    fun q => {y | ∀ i : Fin (m + 1 + 1), (i ∈ Set.range q.2 → ρ * q.1 i ≤ y i ∧
      y i ≤ ρ * (q.1 i + 1)) ∧ (i ∉ Set.range q.2 → y i = ρ * q.1 i)}
  have hFmeas : ∀ q, MeasurableSet (F q) := by
    intro q
    refine IsClosed.measurableSet ?_
    show IsClosed {y : Euclid (m + 1 + 1) | ∀ i : Fin (m + 1 + 1), _}
    rw [Set.ofPred_forall]
    refine isClosed_iInter fun i => ?_
    by_cases hi : i ∈ Set.range q.2
    · simp only [hi, true_implies, not_true_eq_false, false_implies, and_true, Set.ofPred_and]
      exact (isClosed_le continuous_const (PiLp.continuous_apply 2 (fun _ => ℝ) i)).inter
        (isClosed_le (PiLp.continuous_apply 2 (fun _ => ℝ) i) continuous_const)
    · simp only [hi, false_implies, not_false_eq_true, true_implies, true_and]
      exact isClosed_eq (PiLp.continuous_apply 2 (fun _ => ℝ) i) continuous_const
  let g : (Fin (m + 1 + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1 + 1)) → (Fin (m + 1) → ℤ) :=
    fun q i => q.1 (Fin.castSucc i)
  let I : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1) → (Fin (m + 1) → ℤ) → ℝ :=
    fun ω z => ∫ x in {x : Euclid (m + 1) | ∀ i : Fin (m + 1), ρ * z i ≤ x i ∧
      x i ≤ ρ * (z i + 1)}, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x
        (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[m + 1]
  set H := st.filter fun q => Fin.last (m + 1) ∉ Set.range q.2 with hH
  set s' := H.image g
  set β' : (Fin (m + 1) → ℤ) → ℤ := fun z => ∑ q ∈ H with g q = z, βt q with hβ'
  -- on a cell `ω̃ = p^#ω`; a vertical cell gives `0`, a horizontal one the cube `G_{g q}`
  have hcell : ∀ (ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1))
      (q : (Fin (m + 1 + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1 + 1))), q ∈ st →
      ∫ y in F q, (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) y
        (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) ∂μHE[m + 1] =
        if Fin.last (m + 1) ∈ Set.range q.2 then 0 else I ω (g q) := by
    intro ω q hq
    obtain ⟨hvert, hhor⟩ := Submission.dor_lmb_fc_dtop_projected_cell_integral (m + 1) ρ p
      q.1 q.2 hp (hst q hq)
    have hEq : ∫ y in F q, (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) y
        (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) ∂μHE[m + 1] =
        ∫ y in F q, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) (p y)
          (fun k => p (EuclideanSpace.single (q.2 k) (1 : ℝ))) ∂μHE[m + 1] := by
      refine setIntegral_congr_fun (hFmeas q) fun y hy => ?_
      show (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) y
          (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) =
        (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) (p y)
          (fun k => p (EuclideanSpace.single (q.2 k) (1 : ℝ)))
      rw [hEeq ω y (hKtV (hcells q hq hy)),
        ContinuousAlternatingMap.compContinuousLinearMap_apply]
      rfl
    rw [hEq]
    split_ifs with hlast
    · exact hvert hlast _
    · exact (hhor hlast).1 _
  -- `Π̃(ω̃) = Σ_{z ∈ s'} β'_z ∫_{G_z} ω(e₀, …, e_{P-1}) dHᴾ`, regrouping horizontal cells by `g`
  have hPcE : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      Pct (E ω) = ∑ z ∈ s', (β' z : ℝ) * I ω z := by
    intro ω
    rw [hPct (E ω)]
    calc _ = ∑ q ∈ st, (βt q : ℝ) *
          (if Fin.last (m + 1) ∈ Set.range q.2 then 0 else I ω (g q)) := by
          refine Finset.sum_congr rfl fun q hq => ?_
          congr 1
          exact hcell ω q hq
      _ = ∑ q ∈ H, (βt q : ℝ) * I ω (g q) := by
          rw [hH, Finset.sum_filter]
          refine Finset.sum_congr rfl fun q _ => ?_
          by_cases h : Fin.last (m + 1) ∈ Set.range q.2 <;> simp [h]
      _ = ∑ z ∈ s', ∑ q ∈ H with g q = z, (βt q : ℝ) * I ω (g q) :=
          (Finset.sum_fiberwise_of_maps_to (fun q hq => Finset.mem_image_of_mem g hq) _).symm
      _ = ∑ z ∈ s', (β' z : ℝ) * I ω z := by
          refine Finset.sum_congr rfl fun z _ => ?_
          calc ∑ q ∈ H with g q = z, (βt q : ℝ) * I ω (g q)
              = ∑ q ∈ H with g q = z, (βt q : ℝ) * I ω z :=
                Finset.sum_congr rfl fun q hq => by rw [(Finset.mem_filter.1 hq).2]
            _ = (β' z : ℝ) * I ω z := by
                rw [← Finset.sum_mul]
                simp only [hβ', Int.cast_sum]
  -- Step 6: `Π := T − S` is the cube chain (by 5(a)–(c) and step 3), and `R := 0`
  have hPc : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      (T - S) ω = ∑ z ∈ s', (β' z : ℝ) * I ω z := by
    intro ω
    have h := hdecomp (E ω)
    rw [h5a ω, h5b ω, zero_add] at h
    rw [← hPcE ω]
    show T ω - St (E ω) = Pct (E ω)
    linarith
  -- Step 7: `Π` is IM (an integer cube chain), hence so is `S = T − Π`; `R = 0` is IM
  have hPcIM : IsIntegerMultiplicity (T - S) :=
    Submission.dor_lmb_fc_dtop_cube_chain_im m ρ s' β' (T - S) hρ hPc
  have hSIM : IsIntegerMultiplicity S := by
    have hSeq : S = T - (T - S) := GeometricCurrentOn.ext fun ω => by
      show S ω = T ω - (T ω - S ω)
      ring
    rw [hSeq]
    exact (Submission.cmc_imRep_locality_restrict_sub).2.2.1 (m + 1) (m + 1) univ T (T - S)
      isOpen_univ hT hPcIM
  have hR0IM :
      IsIntegerMultiplicity (0 : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 2)) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 0
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset _
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun x hx => by simp at hx
              locallyIntegrable_mult := fun K _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  -- the cells `(z, id)` of `ℝ^P` for `z ∈ s'`, with coefficients `β'_z`
  set s := s'.image fun z => (z, (id : Fin (m + 1) → Fin (m + 1))) with hs
  set β : (Fin (m + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1)) → ℤ := fun q => β' q.1
  have hinj : Set.InjOn (fun z : Fin (m + 1) → ℤ => (z, (id : Fin (m + 1) → Fin (m + 1))))
      ↑s' := fun z _ z' _ h => congrArg Prod.fst h
  -- Step 8: `Σ|β| ≤ Σ|β̃|`, and `M(S) ≤ M(S̃)` as `|ω̃(y)| ≤ |ω(py)|`
  have hsum : ∑ q ∈ s, ((β q).natAbs : ℝ≥0∞) ≤ ∑ q ∈ st, ((βt q).natAbs : ℝ≥0∞) := by
    rw [hs, Finset.sum_image hinj]
    calc ∑ z ∈ s', ((β (z, id)).natAbs : ℝ≥0∞)
        ≤ ∑ z ∈ s', ∑ q ∈ H with g q = z, ((βt q).natAbs : ℝ≥0∞) := by
          refine Finset.sum_le_sum fun z _ => ?_
          have h1 : (β (z, id)).natAbs ≤ ∑ q ∈ H with g q = z, (βt q).natAbs :=
            Int.natAbs_sum_le _ _
          exact_mod_cast h1
      _ = ∑ q ∈ H, ((βt q).natAbs : ℝ≥0∞) :=
          Finset.sum_fiberwise_of_maps_to (fun q hq => Finset.mem_image_of_mem g hq) _
      _ ≤ ∑ q ∈ st, ((βt q).natAbs : ℝ≥0∞) :=
          Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)
  have hSmass : S.mass ≤ St.mass := by
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    exact St.le_massOn ⟨subset_univ _, fun y => (hEnorm ω y).trans (hω.2 (p y))⟩
  -- Step 9: `G_z = p(F̃_q) ⊆ p(K̃) ⊆ cthickening(r, K)`, and `S` vanishes off `cthickening(r, K)`
  have hcellsub : ∀ q ∈ s, {x : Euclid (m + 1) | ∀ i : Fin (m + 1), (i ∈ Set.range q.2 →
      ρ * q.1 i ≤ x i ∧ x i ≤ ρ * (q.1 i + 1)) ∧ (i ∉ Set.range q.2 → x i = ρ * q.1 i)} ⊆
        cthickening r K := by
    intro q hq x hx
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.1 hq
    obtain ⟨q', hq', rfl⟩ := Finset.mem_image.1 hz
    obtain ⟨hq'st, hq'h⟩ := Finset.mem_filter.1 hq'
    obtain ⟨-, hhor⟩ := Submission.dor_lmb_fc_dtop_projected_cell_integral (m + 1) ρ p
      q'.1 q'.2 hp (hst q' hq'st)
    obtain ⟨y, hy, rfl⟩ := (hhor hq'h).2 x fun i => (hx i).1 (by simp)
    exact hpK y (hcells q' hq'st hy)
  have hSvan : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1))) (cthickening r K) →
        S ω = 0 := fun ω hω => hStvan (E ω) (Set.disjoint_left.2 fun y hy hyK =>
          Set.disjoint_left.1 hω (hEsupp ω hy) (hpK y hyK))
  refine ⟨s, β, T - S, 0, S, ?_, fun ω => ?_, hR0IM, hSIM, fun ω => ?_, ?_, ?_, ?_, hcellsub,
    fun ω _ => rfl, hSvan⟩
  · intro q hq
    obtain ⟨z, -, rfl⟩ := Finset.mem_image.1 hq
    exact strictMono_id
  · -- the cell formula: `F_{(z, id)} = G_z`
    rw [hPc ω, hs, Finset.sum_image hinj]
    refine Finset.sum_congr rfl fun z _ => ?_
    have hset : {x : Euclid (m + 1) | ∀ i : Fin (m + 1),
        (i ∈ Set.range (id : Fin (m + 1) → Fin (m + 1)) → ρ * z i ≤ x i ∧
          x i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range (id : Fin (m + 1) → Fin (m + 1)) →
            x i = ρ * z i)} =
        {x : Euclid (m + 1) | ∀ i : Fin (m + 1), ρ * z i ≤ x i ∧ x i ≤ ρ * (z i + 1)} := by
      ext x
      simp
    show (β' z : ℝ) * I ω z = (β' z : ℝ) * ∫ x in {x : Euclid (m + 1) | ∀ i : Fin (m + 1),
        (i ∈ Set.range (id : Fin (m + 1) → Fin (m + 1)) → ρ * z i ≤ x i ∧
          x i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range (id : Fin (m + 1) → Fin (m + 1)) →
            x i = ρ * z i)},
        (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x
          (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[m + 1]
    rw [hset]
  · -- `T − Π = S = ∂0 + S`
    show T ω - (T ω - S ω) =
      (0 : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 2)).boundary ω + S ω
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply]
    ring
  · calc (∑ q ∈ s, ((β q).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1))
        ≤ (∑ q ∈ st, ((βt q).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) :=
          mul_le_mul_of_nonneg_right hsum zero_le
      _ ≤ ENNReal.ofReal c₀ * Tt.mass := hβt
      _ = ENNReal.ofReal c₀ * T.mass := by rw [hTtmass]
  · -- `M(R) = M(0) = 0`
    refine le_trans (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  · calc S.mass ≤ St.mass := hSmass
      _ ≤ ENNReal.ofReal (c₀ * ρ) * Tt.boundary.mass := hStmass
      _ = ENNReal.ofReal (c₀ * ρ) * T.boundary.mass := by rw [hbTt, hbTtmass]

/-- **Simon Ch. 6, proof of Theorem 7.2, (1)–(3)** (total boundedness): given `Λ < ∞` and
`ε > 0` there is a finite set `𝒬` of `(m+1)`-currents in `U` such that every integer multiplicity
`A ∈ 𝒟_{m+1}(U)` with `∂A` integer multiplicity, vanishing off the compact `K ⊆ U`, with
`M(A), M(∂A) ≤ Λ`, satisfies `A − Q = ∂R + S` for some `Q ∈ 𝒬` and integer multiplicity `R`, `S`
with `M(R) + M(S) < ε`.  If `m + 1 > P` every current of degree `m + 1` is `0` and `𝒬 = {0}`.
Otherwise extend `A` by zero to `Y ∈ 𝒟_{m+1}(ℝᴾ)`, apply the deformation theorem (`m + 1 < P`, or
its top-dimensional case `m + 1 = P`) to `Y` with a grid size `ρ` such that `2cρΛ < ε`, and
restrict back to `U`: the polyhedral part is an integer chain on the finitely many grid cells in
`cthickening (rρ) K` with coefficients at most `cΛ/ρ^{m+1}`, and restriction to `U` keeps
integer multiplicity without increasing mass. -/
theorem Submission.dor_lmb_fc_total_bounded : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ) (U K : Set (Euclid P)) (Λ ε : ℝ≥0∞), IsOpen U → IsCompact K → K ⊆ U → Λ ≠ ∞ → 0 < ε → ∃ 𝒬 : Set (GeometricCurrentOn U (m + 1)), 𝒬.Finite ∧ ∀ A : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity A → IsIntegerMultiplicity A.boundary → (∀ ω : TestFormOn U (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → A ω = 0) → A.mass ≤ Λ → A.boundary.mass ≤ Λ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)), IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn U (m + 1), A ω - Q ω = R.boundary ω + S ω) ∧ R.mass + S.mass < ε := by
  intro hSL P m U K Λ ε hU hK hKU hΛ hε
  -- restriction from `ℝᴾ` to `U` does not increase mass: a form admissible in `U` is admissible
  -- in `ℝᴾ`, with the same value
  have hres : ∀ (d : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) d),
      (X.restrictDomain (subset_univ U)).mass ≤ X.mass := by
    intro d X
    apply sSup_le
    rintro _ ⟨ω, hω, rfl⟩
    exact X.le_massOn (W := univ) (omega := testFormOnInclusion (subset_univ U) d ω)
      ⟨subset_univ _, hω.2⟩
  -- the zero current has mass `0`
  have hzero : ∀ d : ℕ, (0 : GeometricCurrentOn U d).mass = 0 := by
    intro d
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  -- Step 0: for `m + 1 > P` every current of degree `m + 1` is `0`, and `𝒬 = {0}` works
  by_cases hdeg : P < m + 1
  · refine ⟨{0}, finite_singleton 0, fun A _ _ _ _ _ => ⟨0, mem_singleton 0, 0, 0,
      Submission.dor_lmb_fc_tb_zero_isIntegerMultiplicity P (m + 2) U,
      Submission.dor_lmb_fc_tb_zero_isIntegerMultiplicity P (m + 1) U, fun ω => ?_, ?_⟩⟩
    · rw [Submission.dor_lmb_fc_tb_eq_zero_of_lt_degree P (m + 1) U A hdeg]
      simp
    · simpa [hzero] using hε
  -- the deformation theorem in degree `m + 1 ≤ P` (`m + 1 < P`, or `m + 1 = P`), with constant
  -- `c`, the cells lying within distance `r ρ` of `K`
  obtain ⟨c, r, hc, hdef⟩ : ∃ c r : ℝ, 0 ≤ c ∧ ∀ (ρ : ℝ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal (c * ρ) * T.mass ∧ S.mass ≤ ENNReal.ofReal (c * ρ) * T.boundary.mass ∧ ∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ cthickening (r * ρ) K := by
    rcases (not_lt.mp hdeg).lt_or_eq with hlt | heq
    · obtain ⟨c, hc, hD⟩ := Submission.dor_lmb_fc_deformation hSL P m hlt
      refine ⟨c, 2 * Real.sqrt P, hc, fun ρ T hρ hT hbT hTK => ?_⟩
      obtain ⟨s, β, Pc, R, S, -, hPc, hR, hS, hid, hβ, hRm, hSm, hcell, -, -⟩ :=
        hD ρ K T hρ hK hT hbT hTK
      exact ⟨s, β, Pc, R, S, hPc, hR, hS, hid, hβ, hRm, hSm, hcell⟩
    · obtain ⟨c, hc, hD⟩ := Submission.dor_lmb_fc_deformation_top hSL P m heq
      refine ⟨c, 2 * Real.sqrt (P + 1), hc, fun ρ T hρ hT hbT hTK => ?_⟩
      obtain ⟨s, β, Pc, R, S, -, hPc, hR, hS, hid, hβ, hRm, hSm, hcell, -, -⟩ :=
        hD ρ K T hρ hK hT hbT hTK
      exact ⟨s, β, Pc, R, S, hPc, hR, hS, hid, hβ, hRm, hSm, hcell⟩
  -- Step 1: a grid size `ρ > 0` with `2 c ρ Λ < δ`, where `0 < δ < ε`
  obtain ⟨δ, -, hδ0, hδε⟩ := ENNReal.lt_iff_exists_real_btwn.mp hε
  have hδ : 0 < δ := ENNReal.ofReal_pos.mp hδ0
  have hΛr : 0 ≤ Λ.toReal := ENNReal.toReal_nonneg
  have hcΛ : 0 ≤ c * Λ.toReal := mul_nonneg hc hΛr
  obtain ⟨ρ, hρ, hρδ⟩ := exists_pos_mul_lt hδ (2 * c * Λ.toReal)
  have hsmall : 2 * (c * ρ * Λ.toReal) < δ :=
    calc 2 * (c * ρ * Λ.toReal) = 2 * c * Λ.toReal * ρ := by ring
      _ < δ := hρδ
  -- Step 2: `𝒬` is the finite set of integer chains on the grid cells in `cthickening (r ρ) K`
  -- with coefficients at most `c Λ / ρ^{m+1}`
  refine ⟨_, Submission.dor_lmb_fc_tb_cell_chains_finite P m U (cthickening (r * ρ) K) ρ
    ⌊c * Λ.toReal / ρ ^ (m + 1)⌋₊ hρ hK.cthickening, ?_⟩
  intro A hA hbA hAK hAm hbAm
  -- Step 3: extension of `A` by zero to `Y ∈ 𝒟_{m+1}(ℝᴾ)` with `∂Y` integer multiplicity
  obtain ⟨Y, hY, hbY, hYA, hYK, hYm, hbYm⟩ :=
    Submission.dor_lmb_fc_tb_extend_univ_boundary P m U K A hU hK hKU hA hbA hAK
  have hYΛ : Y.mass ≤ Λ := hYm.trans hAm
  have hbYΛ : Y.boundary.mass ≤ Λ := hbYm.trans hbAm
  -- Step 4: deformation of `Y`: `Y − Π = ∂R̂ + Ŝ`
  obtain ⟨s, β, Pc, R, S, hPc, hR, hS, hid, hβ, hRm, hSm, hcell⟩ := hdef ρ Y hρ hY hbY hYK
  -- Step 5: restriction to `U`: `Q = Π⌞U`, `R = R̂⌞U` and `S = Ŝ⌞U`
  refine ⟨Pc.restrictDomain (subset_univ U), ⟨s, β, hcell, fun p hp => ?_, fun ω => ?_⟩,
    R.restrictDomain (subset_univ U), S.restrictDomain (subset_univ U),
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 2) univ U (subset_univ U) R hU hR,
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 1) univ U (subset_univ U) S hU hS,
    fun ω => ?_, ?_⟩
  · -- `|β_p| ρ^{m+1} ≤ (Σ_q |β_q|) ρ^{m+1} ≤ c M(Y) ≤ c Λ`
    have h1 : ((β p).natAbs : ℝ≥0∞) * ENNReal.ofReal (ρ ^ (m + 1)) ≤
        ENNReal.ofReal (c * Λ.toReal) :=
      calc ((β p).natAbs : ℝ≥0∞) * ENNReal.ofReal (ρ ^ (m + 1))
          ≤ (∑ q ∈ s, ((β q).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) := by
            gcongr
            exact Finset.single_le_sum (f := fun q => ((β q).natAbs : ℝ≥0∞))
              (fun _ _ => zero_le) hp
        _ ≤ ENNReal.ofReal c * Y.mass := hβ
        _ ≤ ENNReal.ofReal c * Λ := by gcongr
        _ = ENNReal.ofReal (c * Λ.toReal) := by
            rw [ENNReal.ofReal_mul hc, ENNReal.ofReal_toReal hΛ]
    have h2 : ((β p).natAbs : ℝ) * ρ ^ (m + 1) ≤ c * Λ.toReal := by
      rw [← ENNReal.ofReal_le_ofReal_iff hcΛ, ENNReal.ofReal_mul (Nat.cast_nonneg _),
        ENNReal.ofReal_natCast]
      exact h1
    exact Nat.le_floor ((le_div_iff₀ (pow_pos hρ _)).mpr h2)
  · -- `Q(ω) = Π(ιω)`, and `ιω` has the same underlying form as `ω`
    exact hPc (testFormOnInclusion (subset_univ U) (m + 1) ω)
  · -- `A(ω) − Q(ω) = Y(ιω) − Π(ιω) = ∂R̂(ιω) + Ŝ(ιω)`, where `d(ιω) = ι(dω)`
    rw [← hYA]
    exact hid (testFormOnInclusion (subset_univ U) (m + 1) ω)
  · -- `M(R) + M(S) ≤ M(R̂) + M(Ŝ) ≤ 2 c ρ Λ < ε`
    have hcρ : 0 ≤ c * ρ := mul_nonneg hc hρ.le
    calc (R.restrictDomain (subset_univ U)).mass + (S.restrictDomain (subset_univ U)).mass
        ≤ ENNReal.ofReal (c * ρ) * Λ + ENNReal.ofReal (c * ρ) * Λ := by
          gcongr
          · exact (hres _ R).trans (hRm.trans (by gcongr))
          · exact (hres _ S).trans (hSm.trans (by gcongr))
      _ = ENNReal.ofReal (2 * (c * ρ * Λ.toReal)) := by
          rw [two_mul, ENNReal.ofReal_add (mul_nonneg hcρ hΛr) (mul_nonneg hcρ hΛr),
            ENNReal.ofReal_mul hcρ, ENNReal.ofReal_toReal hΛ]
      _ ≤ ENNReal.ofReal δ := ENNReal.ofReal_le_ofReal hsmall.le
      _ < ε := hδε

/-- **Simon Ch. 6, Theorem 7.2, "only if" part, for cycles** (chapter-06.txt lines 2020–2135):
assume (C1) (`dor_imrep_massOn_eq_measure_and_support`).  Let `n ≥ 1`, `U ⊆ ℝ^P` open, and let
`T_j, T ∈ 𝒟ₙ(U)` be integer multiplicity with `∂T_j = 0`, `∂T = 0`, `T_j ⇀ T` in `U` and
`sup_j M_V(T_j) < ∞` for every open `V ⊂⊂ U`.  Then for every open `W ⊂⊂ U` there are integer
multiplicity `R_j ∈ 𝒟ₙ₊₁(U)`, `S_j ∈ 𝒟ₙ(U)` with `T − T_j = ∂R_j + S_j` in `U` and
`M_W(R_j) + M_W(S_j) → 0`, i.e. `d_W(T_j, T) → 0`.

Step 0: if `W = ∅` then `M_∅ ≡ 0`, and `R_j = 0`, `S_j = T − T_j` work.  Otherwise put
`d_W(T, T_j) = inf {M_W(R) + M_W(S) : T − T_j = ∂R + S, R, S integer multiplicity}` (Simon 7.1).
Pairs with cost `≤ d_W(T, T_j) + 2⁻ʲ` prove the theorem once `d_W(T, T_j) → 0`, and for this it
suffices that every subsequence `T_{ns(j)}` has a further subsequence along which
`d_W(T, ·) → 0`.
Step 1 (`dor_lmb_fc_localize`, with the slicing theorem `dor_lmb_slicing_lipschitz`): a
subsequence `T_{ns(φ(j))}` and integer multiplicity `T'_j ⇀ T'` (the restrictions to a good
sublevel set of `dist(·, W̄)`) that agree with `T_{ns(φ(j))}`, `T` on forms supported in `W`,
vanish off a compact `K ⊆ U`, and have `M(T'_j), M(∂T'_j) ≤ Λ < ∞`.
Steps 2–3 (`dor_lmb_fc_total_bounded`, `dor_lmb_fc_cauchy_subseq`): the `T'_j` are totally bounded
for the flat distance, so `T'_{θ(r+1)} − T'_{θ(r)} = ∂R_r + S_r` with `M(R_r) + M(S_r) ≤ 2⁻ʳ`.
Step 4 (`dor_lmb_fc_series_limit`): `T' − T'_{θ(ℓ)} = ∂R' + S'` with `M(R') + M(S') ≤ 2·2⁻ˡ`.
Step 5: `T − T_{ns(φ(θ(ℓ)))} = ∂R' + S̃` with
`S̃ = (S' − (T' − T)) − (T_{ns(φ(θ(ℓ)))} − T'_{θ(ℓ)})`, integer multiplicity (differences,
`cmc_imRep_locality_restrict_sub`), and `M_W(S̃) = M_W(S')` because both bracketed differences
vanish on forms supported in `W`.  Hence `d_W(T, T_{ns(φ(θ(ℓ)))}) ≤ 2·2⁻ˡ → 0`. -/
theorem Submission.dor_lmb_flat_convergence_cycles : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U n) (T : GeometricCurrentOn U n), IsOpen U → 0 < n → (∀ j, IsIntegerMultiplicity (Ts j)) → IsIntegerMultiplicity T → (∀ j, BoundaryVanishes (Ts j)) → BoundaryVanishes T → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, (Ts j).massOn W < ∞) → WeaklyConvergesOn Ts T → ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ∃ (Rs : ℕ → GeometricCurrentOn U (n + 1)) (Ss : ℕ → GeometricCurrentOn U n), (∀ j, IsIntegerMultiplicity (Rs j)) ∧ (∀ j, IsIntegerMultiplicity (Ss j)) ∧ (∀ j (ω : TestFormOn U n), T ω - Ts j ω = (Rs j).boundary ω + Ss j ω) ∧ Tendsto (fun j => (Rs j).massOn W + (Ss j).massOn W) atTop (𝓝 0) := by
  intro _ P n U Ts T hU hn hTsIM hTIM hTsB _ hbd hconv W _ hWU
  -- write `n = m + 1`, so that `∂T_j = 0` reads `(Ts j).boundary = 0`
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, (Nat.succ_pred_eq_of_pos hn).symm⟩
  have hsub_apply : ∀ {k : ℕ} (A B : GeometricCurrentOn U k) (ω : TestFormOn U k),
      (A - B) ω = A ω - B ω := fun _ _ _ => rfl
  -- differences of integer multiplicity currents (`cmc_imRep_locality_restrict_sub` (c))
  have hsub : ∀ {k : ℕ} (A B : GeometricCurrentOn U k), IsIntegerMultiplicity A →
      IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B) :=
    fun A B hA hB => Submission.cmc_imRep_locality_restrict_sub.2.2.1 P _ U A B hU hA hB
  -- `0 = τ(∅, 1, 0)` is integer multiplicity, and `T − T_j = ∂0 + (T − T_j)`
  have hIM0 : IsIntegerMultiplicity (0 : GeometricCurrentOn U (m + 1 + 1)) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 1
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset U
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun _ _ => Nat.one_pos
              locallyIntegrable_mult := fun K _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  have htriv : ∀ j (ω : TestFormOn U (m + 1)),
      T ω - Ts j ω = (0 : GeometricCurrentOn U (m + 1 + 1)).boundary ω + (T - Ts j) ω := by
    intro j ω
    rw [hsub_apply, GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply, zero_add]
  -- Step 0: if `W = ∅`, then `M_∅ ≡ 0`, and `R_j = 0`, `S_j = T − T_j` work
  rcases W.eq_empty_or_nonempty with rfl | hWne
  · have hmass : ∀ {k : ℕ} (A : GeometricCurrentOn U k), A.massOn ∅ = 0 := by
      intro k A
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, hω, rfl⟩
      have h0 : ω = 0 := Subtype.ext (funext fun x => by
        by_contra hx
        exact hω.1 (subset_tsupport _ hx))
      simp [h0]
    refine ⟨fun _ => 0, fun j => T - Ts j, fun _ => hIM0, fun j => hsub _ _ hTIM (hTsIM j),
      htriv, ?_⟩
    simp only [hmass, add_zero]
    exact tendsto_const_nhds
  have hWsub : W ⊆ U := subset_closure.trans hWU.2
  -- `M_W` only sees forms supported in `W`
  have hcongr : ∀ {k : ℕ} (A B : GeometricCurrentOn U k), (∀ ω : TestFormOn U k,
      tsupport (ω : DifferentialForm (Euclid P) k) ⊆ W → A ω = B ω) →
      A.massOn W = B.massOn W := by
    intro k A B h
    unfold GeometricCurrentOn.massOn
    congr 1
    exact Set.image_congr fun ω hω => congrArg ENNReal.ofReal (h ω hω.1)
  have hε : Tendsto (fun j : ℕ => (2⁻¹ : ℝ≥0∞) ^ j) atTop (𝓝 0) :=
    ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (ENNReal.inv_lt_one.2 ENNReal.one_lt_two)
  -- the flat distance `d_W(T, T_j)` (Simon 7.1)
  obtain ⟨d, hd⟩ : ∃ d : ℕ → ℝ≥0∞, ∀ j, d j = ⨅ (R : GeometricCurrentOn U (m + 1 + 1))
      (S : GeometricCurrentOn U (m + 1)) (_ : IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧
        ∀ ω : TestFormOn U (m + 1), T ω - Ts j ω = R.boundary ω + S ω),
      R.massOn W + S.massOn W := ⟨_, fun _ => rfl⟩
  -- Step 0: once `d_W(T, T_j) → 0`, pairs with cost `≤ d_W(T, T_j) + 2⁻ʲ` prove the theorem
  suffices hd0 : Tendsto d atTop (𝓝 0) by
    have hpair : ∀ j, ∃ (R : GeometricCurrentOn U (m + 1 + 1)) (S : GeometricCurrentOn U (m + 1)),
        (IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧
          ∀ ω : TestFormOn U (m + 1), T ω - Ts j ω = R.boundary ω + S ω) ∧
        R.massOn W + S.massOn W ≤ d j + (2⁻¹ : ℝ≥0∞) ^ j := by
      intro j
      by_cases hdj : d j = ∞
      · exact ⟨0, T - Ts j, ⟨hIM0, hsub _ _ hTIM (hTsIM j), htriv j⟩, by simp [hdj]⟩
      have hlt : d j < d j + (2⁻¹ : ℝ≥0∞) ^ j :=
        ENNReal.lt_add_right hdj (pow_ne_zero j (ENNReal.inv_ne_zero.2 ENNReal.ofNat_ne_top))
      obtain ⟨R, hR⟩ := iInf_lt_iff.1 ((hd j).symm.trans_lt hlt)
      obtain ⟨S, hS⟩ := iInf_lt_iff.1 hR
      obtain ⟨hRS, hcost⟩ := iInf_lt_iff.1 hS
      exact ⟨R, S, hRS, hcost.le⟩
    choose Rs Ss hRS hcost using hpair
    refine ⟨Rs, Ss, fun j => (hRS j).1, fun j => (hRS j).2.1, fun j => (hRS j).2.2, ?_⟩
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_ (fun _ => zero_le)
      hcost
    simpa only [add_zero] using hd0.add hε
  -- Step 0: it suffices that every subsequence has a further subsequence along which
  -- `d_W(T, ·) → 0`
  refine tendsto_of_subseq_tendsto fun ns hns => ?_
  -- Step 1: localization of `T_{ns(j)}` (`dor_lmb_fc_localize`)
  obtain ⟨φ, K, Λ, Ts', T', -, hK, hKU, hΛ, hTs'IM, hTs'BIM, hT'IM, hTs'K, hTs'mass, hTs'conv,
      hTs'W, hT'W⟩ := Submission.dor_lmb_fc_localize Submission.dor_lmb_slicing_lipschitz P m U W
    (fun j => Ts (ns j)) T hU (fun j => hTsIM (ns j)) hTIM (fun j => hTsB (ns j))
    (fun V hV hVU => (iSup_le fun j => le_iSup (fun i => (Ts i).massOn V) (ns j)).trans_lt
      (hbd V hV hVU)) (fun ω => (hconv ω).comp hns) hWne hWU
  -- Steps 2–3: total boundedness (`dor_lmb_fc_total_bounded`) gives a subsequence with
  -- `T'_{θ(r+1)} − T'_{θ(r)} = ∂R_r + S_r`, `M(R_r) + M(S_r) ≤ 2⁻ʳ` (`dor_lmb_fc_cauchy_subseq`)
  obtain ⟨θ, hθ, hcauchy⟩ := Submission.dor_lmb_fc_cauchy_subseq P m U Ts' hU fun ε hε0 => by
    obtain ⟨𝒬, h𝒬, hnet⟩ := Submission.dor_lmb_fc_total_bounded
      Submission.dor_lmb_slicing_lipschitz P m U K Λ ε hU hK hKU hΛ hε0
    exact ⟨𝒬, h𝒬, fun j => hnet (Ts' j) (hTs'IM j) (hTs'BIM j) (hTs'K j) (hTs'mass j).1
      (hTs'mass j).2⟩
  choose Rc Sc hRSc using hcauchy
  -- Step 4: `T' − T'_{θ(ℓ)} = ∂R' + S'` with `M(R') + M(S') ≤ 2·2⁻ˡ` (`dor_lmb_fc_series_limit`)
  have hlim := Submission.dor_lmb_fc_series_limit P m U (fun r => Ts' (θ r)) T' Rc Sc hU
    (fun ω => (hTs'conv ω).comp hθ.tendsto_atTop) hRSc
  refine ⟨fun ℓ => φ (θ ℓ), ?_⟩
  -- Step 5: `d_W(T, T_{ns(φ(θ(ℓ)))}) ≤ 2·2⁻ˡ`
  have hle : ∀ ℓ, d (ns (φ (θ ℓ))) ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := by
    intro ℓ
    obtain ⟨R', S', hR', hS', heq, hmass⟩ := hlim ℓ
    -- `S₁ = S̃ = (S' − (T' − T)) − (T_{ns(φ(θ(ℓ)))} − T'_{θ(ℓ)})`
    set S₁ : GeometricCurrentOn U (m + 1) :=
      (S' - (T' - T)) - (Ts (ns (φ (θ ℓ))) - Ts' (θ ℓ)) with hS₁
    have hS₁IM : IsIntegerMultiplicity S₁ :=
      hsub _ _ (hsub _ _ hS' (hsub _ _ hT'IM hTIM)) (hsub _ _ (hTsIM _) (hTs'IM _))
    have hS₁eq : ∀ ω : TestFormOn U (m + 1),
        T ω - Ts (ns (φ (θ ℓ))) ω = R'.boundary ω + S₁ ω := by
      intro ω
      have h := heq ω
      simp only [hS₁, hsub_apply]
      linarith
    -- the bracketed differences vanish on forms supported in `W`
    have hS₁W : S₁.massOn W = S'.massOn W := by
      refine hcongr _ _ fun ω hω => ?_
      have h₁ : T' ω = T ω := hT'W ω hω
      have h₂ : Ts' (θ ℓ) ω = Ts (ns (φ (θ ℓ))) ω := hTs'W (θ ℓ) ω hω
      simp only [hS₁, hsub_apply, h₁, h₂]
      ring
    calc d (ns (φ (θ ℓ))) ≤ R'.massOn W + S₁.massOn W :=
          (hd _).trans_le (iInf_le_of_le R' (iInf_le_of_le S₁
            (iInf_le_of_le ⟨hR', hS₁IM, hS₁eq⟩ le_rfl)))
      _ = R'.massOn W + S'.massOn W := by rw [hS₁W]
      _ ≤ R'.mass + S'.mass := add_le_add (R'.massOn_mono hWsub) (S'.massOn_mono hWsub)
      _ ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := hmass
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_ (fun _ => zero_le) hle
  simpa only [mul_zero] using ENNReal.Tendsto.const_mul hε (Or.inr ENNReal.ofNat_ne_top)

/-- **Lemma M: limsup bound for the masses of the `Tⱼ` near `y ∈ N`** (Simon 7.2.4 and Remark
7.2.5(2), as used in the proof of 7.4.3; the proof of 7.2.4, chapter-07.txt lines 176–290, with
the competitor projected into `N`, README erratum 5).  `dor_lmb_c1_retraction` gives `r`, `c_π`
and a `C¹` retraction `π` onto `N` near `y` with `‖Dπ(x)‖ ≤ 1 + c_π|x − y|`; monotonicity (C3) and
C1 give `μ_{Tⱼ}(B_s(y)) ≤ c₂sⁿ` for `0 < s ≤ r₀`.  Put `r₁ = min(r₀/3, r/3, 1/(6c_π + 1))`,
`c = 3c_π` and `c₁ = n·c·2ⁿ·3ⁿ·c₂`.  For `0 < ε < ρ < r₁`, flat convergence on
`W = B_{ρ+ε}(y)` writes `T − Tⱼ = ∂Rⱼ + Sⱼ` with `M_W(Rⱼ) + M_W(Sⱼ) → 0`; the level cut at some
`t ∈ (ρ, ρ + ε)` (chosen for each `j`, so no subsequence is needed) and the comparison with the
projected competitor (`Z = Tⱼ`) give
`M_{B_ρ}(Tⱼ) ≤ (1 + cρ)ⁿ(M_W(T) + M_W(Sⱼ) + (2/ε)M_W(Rⱼ)) + ((1 + cρ)ⁿ − 1)c₂(3ρ)ⁿ`, and
`(1 + a)ⁿ − 1 ≤ n·a·2ⁿ` (`0 ≤ a ≤ 1`) bounds the last term by `c₁ρⁿ⁺¹`.  Let `j → ∞`. -/
theorem Submission.dor_minimizing_limsup_mass_bound : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n → ∀ (U N : Set (Euclid (n + k))) (Ts : ℕ → GeometricCurrentOn U n) (T : GeometricCurrentOn U n) (y : Euclid (n + k)), IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → (∀ j, IsMinimizingIn (Ts j) (U ∩ N)) → IsIntegerMultiplicity T → (∀ j, (Ts j).support ⊆ N) → (∀ j, BoundaryVanishes (Ts j)) → BoundaryVanishes T → (∀ j, ∀ R : IMRep U n, R.Represents (Ts j) → R.IsStationaryAlong N) → (∀ W : Set (Euclid (n + k)), IsOpen W → CompactlyContained W U → ⨆ j, (Ts j).massOn W < ∞) → WeaklyConvergesOn Ts T → y ∈ N ∩ U → ∃ r₁ c c₁ : ℝ, 0 < r₁ ∧ 0 ≤ c ∧ 0 ≤ c₁ ∧ ∀ ρ ε : ℝ, 0 < ε → ε < ρ → ρ < r₁ → limsup (fun j => (Ts j).massOn (ball y ρ)) atTop ≤ ENNReal.ofReal ((1 + c * ρ) ^ n) * T.massOn (ball y (ρ + ε)) + ENNReal.ofReal (c₁ * ρ ^ (n + 1)) := by
  intro n k ℓ hℓ hn U N Ts T y hU hN hNcl hmin hT hspt hbd hTbd hstat hmass hconv hy
  have C1 := Submission.dor_imrep_massOn_eq_measure_and_support
  -- Step 1(a): the `C¹` retraction `π` onto `N` near `y`, `‖Dπ(x)‖ ≤ 1 + c_π|x − y|`
  obtain ⟨r, cπ, proj, hr, hcπ, hrU, hproj, hprojN, hprojfix, hprojT, hprojD⟩ :=
    Submission.dor_lmb_c1_retraction (n + k) (n + ℓ) U N y hU hN hNcl hy
  -- Step 1(b): monotonicity at `y` for every representation of every `Tⱼ` (C3)
  obtain ⟨r₀, κ, hr₀, hκ, hr₀U, hmono⟩ :=
    Submission.dor_stationary_mean_curvature_monotonicity n k ℓ hℓ hn U N y hU hN hNcl hy
  choose Rj hRj using fun j => (hmin j).1
  have hcc : ∀ s, closedBall y s ⊆ U → CompactlyContained (ball y s) U := fun s hs =>
    ⟨(isCompact_closedBall y s).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      closure_ball_subset_closedBall.trans hs⟩
  -- Step 1(c): `Λ₀ = supⱼ M_{B_{r₀}(y)}(Tⱼ) < ∞`, hence `μ_{Tⱼ}(B_s(y)) ≤ c₂sⁿ` for `0 < s ≤ r₀`
  obtain ⟨Λ₀, hΛ₀0, hΛ₀⟩ : ∃ Λ₀ : ℝ, 0 ≤ Λ₀ ∧
      ∀ j, (Rj j).measure (ball y r₀) ≤ ENNReal.ofReal Λ₀ := by
    refine ⟨(⨆ j, (Ts j).massOn (ball y r₀)).toReal, ENNReal.toReal_nonneg, fun j => ?_⟩
    rw [ENNReal.ofReal_toReal (hmass _ isOpen_ball
      (hcc r₀ ((closedBall_subset_closedBall (by linarith)).trans hr₀U))).ne,
      ← (C1 (n + k) n U (Ts j) (Rj j) hU (hRj j)).1 _ isOpen_ball]
    exact le_iSup (fun j => (Ts j).massOn (ball y r₀)) j
  obtain ⟨c₂, hc₂, hball⟩ : ∃ c₂ : ℝ, 0 ≤ c₂ ∧ ∀ j s, 0 < s → s ≤ r₀ →
      (Rj j).measure (ball y s) ≤ ENNReal.ofReal (c₂ * s ^ n) := by
    refine ⟨Real.exp (κ * r₀) / r₀ ^ n * Λ₀, by positivity, fun j s hs hsr₀ => ?_⟩
    have h1 := (hmono (Ts j) (Rj j) (hRj j) (hspt j) (hstat j (Rj j) (hRj j))).2 y
      (mem_ball_self hr₀) s r₀ hs hsr₀ le_rfl
    have h3 : 1 ≤ Real.exp (κ * s) / s ^ n * s ^ n := by
      rw [div_mul_cancel₀ _ (pow_pos hs n).ne']
      exact Real.one_le_exp (mul_nonneg hκ hs.le)
    calc (Rj j).measure (ball y s)
        ≤ ENNReal.ofReal (Real.exp (κ * s) / s ^ n * s ^ n) * (Rj j).measure (ball y s) :=
          le_mul_of_one_le_left' (ENNReal.one_le_ofReal.2 h3)
      _ = ENNReal.ofReal (s ^ n) *
            (ENNReal.ofReal (Real.exp (κ * s) / s ^ n) * (Rj j).measure (ball y s)) := by
          rw [mul_comm (Real.exp (κ * s) / s ^ n), ENNReal.ofReal_mul (by positivity), mul_assoc]
      _ ≤ ENNReal.ofReal (s ^ n) *
            (ENNReal.ofReal (Real.exp (κ * r₀) / r₀ ^ n) * ENNReal.ofReal Λ₀) :=
          mul_le_mul_right (h1.trans (mul_le_mul_right (hΛ₀ j) _)) _
      _ = ENNReal.ofReal (Real.exp (κ * r₀) / r₀ ^ n * Λ₀ * s ^ n) := by
          rw [← ENNReal.ofReal_mul (show 0 ≤ Real.exp (κ * r₀) / r₀ ^ n by positivity),
            ← ENNReal.ofReal_mul (show 0 ≤ s ^ n by positivity), mul_comm (s ^ n)]
  -- `(1 + a)ᵐ − 1 ≤ m·a·2ᵐ` for `0 ≤ a ≤ 1`
  have hgeom : ∀ (m : ℕ) (a : ℝ), 0 ≤ a → a ≤ 1 → (1 + a) ^ m - 1 ≤ m * a * 2 ^ m := by
    intro m a ha0 ha1
    induction m with
    | zero => simp
    | succ m ih =>
      have h1 : 1 ≤ (1 + a) ^ m := one_le_pow₀ (by linarith)
      have h2 : (1 : ℝ) ≤ 2 ^ m := one_le_pow₀ (by norm_num)
      have h3 : 0 ≤ (m : ℝ) * 2 ^ m := by positivity
      push_cast
      rw [pow_succ, pow_succ]
      nlinarith [mul_le_mul_of_nonneg_left ih ha0,
        mul_nonneg (mul_nonneg ha0 (sub_nonneg.2 ha1)) h3]
  -- Step 1(d): `r₁ = min(r₀/3, r/3, 1/(6c_π + 1))`, `c = 3c_π`, `c₁ = n·c·2ⁿ·3ⁿ·c₂`
  refine ⟨min (r₀ / 3) (min (r / 3) (1 / (6 * cπ + 1))), 3 * cπ,
    (n : ℝ) * (3 * cπ) * 2 ^ n * 3 ^ n * c₂,
    lt_min (by linarith) (lt_min (by linarith) (div_pos one_pos (by linarith))), by linarith,
    by positivity, fun ρ ε hε hερ hρr₁ => ?_⟩
  have hρ : 0 < ρ := hε.trans hερ
  have hρ₀ : ρ < r₀ / 3 := hρr₁.trans_le (min_le_left _ _)
  have hρr : ρ < r / 3 := hρr₁.trans_le ((min_le_right _ _).trans (min_le_left _ _))
  have hρc : ρ * (6 * cπ + 1) < 1 := (lt_div_iff₀ (by linarith)).1
    (hρr₁.trans_le ((min_le_right _ _).trans (min_le_right _ _)))
  have hcπρ : 0 ≤ cπ * ρ := mul_nonneg hcπ hρ.le
  have h4 : 4 * cπ * ρ ≤ 1 := by nlinarith
  have hrρ : 3 * ρ < r := by linarith
  have hcl3 : closedBall y (3 * ρ) ⊆ U := (closedBall_subset_closedBall hrρ.le).trans hrU
  have hclε : closedBall y (ρ + ε) ⊆ U :=
    (closedBall_subset_closedBall (by linarith)).trans hcl3
  -- Step 4: flat convergence on `W = B_{ρ+ε}(y)` (Simon Ch. 6, 7.2)
  obtain ⟨Rs, Ss, hRs, hSs, hdiff, hlim⟩ :=
    Submission.dor_lmb_flat_convergence_cycles C1 (n + k) n U Ts T hU hn (fun j => (hmin j).1) hT
      hbd hTbd hmass hconv (ball y (ρ + ε)) isOpen_ball (hcc _ hclε)
  -- the error term `((1 + cρ)ⁿ − 1)·c₂(3ρ)ⁿ ≤ c₁ρⁿ⁺¹`
  have hΛ1 : 0 ≤ (1 + 3 * cπ * ρ) ^ n - 1 := sub_nonneg.2 (one_le_pow₀ (by linarith))
  have hreal : ((1 + 3 * cπ * ρ) ^ n - 1) * (c₂ * (3 * ρ) ^ n) ≤
      n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1) :=
    calc ((1 + 3 * cπ * ρ) ^ n - 1) * (c₂ * (3 * ρ) ^ n)
        ≤ n * (3 * cπ * ρ) * 2 ^ n * (c₂ * (3 * ρ) ^ n) :=
          mul_le_mul_of_nonneg_right (hgeom n _ (by positivity) (by linarith)) (by positivity)
      _ = n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1) := by ring
  -- Steps 5–9 for each `j`: cut `Tⱼ` at a good level `t ∈ (ρ, ρ + ε)` and compare with the
  -- competitor `Tⱼ + π_#X` (Simon (3)–(11))
  have hbound : ∀ j, (Ts j).massOn (ball y ρ) ≤
      ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) * (T.massOn (ball y (ρ + ε)) +
        (Ss j).massOn (ball y (ρ + ε)) +
        ENNReal.ofReal (2 / (ρ + ε - ρ)) * (Rs j).massOn (ball y (ρ + ε))) +
      ENNReal.ofReal (n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1)) := by
    intro j
    obtain ⟨t, X, Y, RY, hρt, htε, hX, hXbd, hXvan, hY, hRY, hRYt⟩ :=
      Submission.dor_lmb_good_level_cut C1 (n + k) n U T (Ts j) (Ss j) (Rs j) y ρ (ρ + ε) hU hn
        hT (hmin j).1 (hSs j) (hRs j) (hdiff j) hρ (by linarith) hclε
    have hcmp := Submission.dor_lmb_projected_competitor_comparison C1 (n + k) (n + ℓ) n U N
      (Ts j) X Y (Rj j) RY proj y r cπ ρ t hU hn hN (hmin j) (hspt j) (hbd j) (hRj j) hX hXbd
      hXvan hY hRY hy.1 hcπ hρ hrρ h4 (by linarith) hcl3 hproj hprojN hprojfix hprojT hprojD
    rw [(C1 (n + k) n U (Ts j) (Rj j) hU (hRj j)).1 _ isOpen_ball]
    calc (Rj j).measure (ball y ρ) ≤ (Rj j).measure (closedBall y t) :=
          measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall hρt.le))
      _ ≤ ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) * RY.measure (closedBall y t) +
            ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n - 1) * (Rj j).measure (ball y (3 * ρ)) := hcmp
      _ ≤ ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) * (T.massOn (ball y (ρ + ε)) +
            (Ss j).massOn (ball y (ρ + ε)) +
            ENNReal.ofReal (2 / (ρ + ε - ρ)) * (Rs j).massOn (ball y (ρ + ε))) +
            ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n - 1) * ENNReal.ofReal (c₂ * (3 * ρ) ^ n) :=
          add_le_add (mul_le_mul_right hRYt _)
            (mul_le_mul_right (hball j (3 * ρ) (by linarith) (by linarith)) _)
      _ ≤ _ := by
          rw [← ENNReal.ofReal_mul hΛ1]
          exact add_le_add le_rfl (ENNReal.ofReal_le_ofReal hreal)
  -- Step 10: `M_W(Sⱼ), M_W(Rⱼ) → 0`, so the bound tends to `(1 + cρ)ⁿM_W(T) + c₁ρⁿ⁺¹`
  have hS : Tendsto (fun j => (Ss j).massOn (ball y (ρ + ε))) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le)
      (fun _ => le_add_self)
  have hR : Tendsto (fun j => (Rs j).massOn (ball y (ρ + ε))) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le)
      (fun _ => le_self_add)
  have hlim' : Tendsto (fun j => ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) *
      (T.massOn (ball y (ρ + ε)) + (Ss j).massOn (ball y (ρ + ε)) +
        ENNReal.ofReal (2 / (ρ + ε - ρ)) * (Rs j).massOn (ball y (ρ + ε))) +
      ENNReal.ofReal (n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1))) atTop
      (𝓝 (ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) *
        (T.massOn (ball y (ρ + ε)) + 0 + ENNReal.ofReal (2 / (ρ + ε - ρ)) * 0) +
        ENNReal.ofReal (n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1)))) :=
    (ENNReal.Tendsto.const_mul ((tendsto_const_nhds.add hS).add
      (ENNReal.Tendsto.const_mul hR (Or.inr ENNReal.ofReal_ne_top)))
      (Or.inr ENNReal.ofReal_ne_top)).add tendsto_const_nhds
  rw [mul_zero, add_zero, add_zero] at hlim'
  exact (limsup_le_limsup (Eventually.of_forall hbound)).trans_eq hlim'.limsup_eq

/-- **Simon 7.4.3** (with `Nᵢ = N`; chapter-07.txt lines 617–631), the book's appeal to Allard's
theorem made quantitative.  By 7.1.2 every representation of `Tⱼ` and of `T` is stationary in
`U ∩ N`.  The ε-regularity criterion at `y` (radius `r₀`, excess `δ`) makes a support point `z`
with `|z − y| < r₀` regular once `M_{B_ρ(z)} ≤ (1 + δ)ωₙρⁿ` for some `ρ ≤ r₀`.  For `y` this
follows from `Θⁿ(μ_T, y) = 1`, which also gives `y ∈ spt T`.  For `yⱼ`, fix `η > 0` with
`(1 + η)(1 + 2η)ⁿ < 1 + δ` and a small `ρ`: the upper mass bound in the limit gives
`limsup M_{B_{(1+η)ρ}(y)}(Tⱼ) ≤ (1 + c(1+η)ρ)ⁿ M_{B_{(1+2η)ρ}(y)}(T) + c₁((1+η)ρ)ⁿ⁺¹`, which is
`< (1 + δ)ωₙρⁿ`, and `B_ρ(yⱼ) ⊆ B_{(1+η)ρ}(y)` once `|yⱼ − y| < ηρ`.  For `n = 0` a minimizing
current does not meet `U ∩ N`, so this case is vacuous. -/
theorem Submission.density_one_implies_regular : DensityOneImpliesRegular := by
  intro n k ℓ hℓk U N Ts T ys y hU hN hNcl hTsmin hTmin hTsN hTN hTsb hTb hmass hconv hy hdens
    hys hysspt
  -- `Θⁿ(μ_T, y) = 1` forces `y ∈ spt T`: otherwise `T` vanishes on a ball about `y`, where the
  -- density ratios are then `0`.
  have hyT : y ∈ T.support := by
    by_contra hnot
    have hyZ : y ∈ T.zeroRegion := by
      by_contra hyZ
      exact hnot (show y ∈ U \ T.zeroRegion from ⟨hy.2, hyZ⟩)
    obtain ⟨W, ⟨hWo, -, -, hWv⟩, hyW⟩ := mem_sUnion.1 hyZ
    obtain ⟨ε, hε, hεW⟩ := Metric.isOpen_iff.1 hWo y hyW
    have h0 : Tendsto (fun ρ : ℝ => T.massOn (ball y ρ) /
        (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 0) := by
      apply tendsto_nhds_of_eventually_eq
      filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
      have hm : T.massOn (ball y ρ) = 0 := by
        refine le_antisymm (sSup_le ?_) zero_le
        rintro r ⟨ω, hω, rfl⟩
        exact (ENNReal.ofReal_eq_zero.2
          (hWv ω (hω.1.trans ((ball_subset_ball hρ.2.le).trans hεW))).le).le
      rw [hm, ENNReal.zero_div]
    have h1 := tendsto_nhds_unique hdens.2 h0
    rw [ENNReal.ofReal_one] at h1
    exact one_ne_zero h1
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: a minimizing `0`-current does not meet `U ∩ N`.
    have hmem : y ∈ T.support ∩ (U ∩ N) := ⟨hyT, hy.2, hy.1⟩
    rw [Submission.dor_zero_dim_minimizing_support_disjoint _ U (U ∩ N) T hU hTmin] at hmem
    exact absurd hmem (notMem_empty y)
  -- 7.1.2: representations of minimizing cycles supported in `N` are stationary in `U ∩ N`.
  have hstat : ∀ S : GeometricCurrentOn U n, S.support ⊆ N → IsMinimizingIn S (U ∩ N) →
      BoundaryVanishes S → ∀ R : IMRep U n, R.Represents S → R.IsStationaryAlong N :=
    fun S hSN hSmin hSb R hR => (Submission.minimizing_implies_stationary n k ℓ hℓk U N S hU hN
      hNcl hSN (by rwa [inter_comm]) hSb R hR).1
  obtain ⟨r₀, δ, hr₀, hδ, hreg⟩ :=
    Submission.dor_stationary_cycle_epsilon_regularity n k ℓ hℓk hn U N y hU hN hNcl hy
  obtain ⟨r₁, c, c₁, hr₁, hc, hc₁, hlim⟩ :=
    Submission.dor_minimizing_limsup_mass_bound n k ℓ hℓk hn U N Ts T y hU hN hNcl hTsmin
      hTmin.1 hTsN hTsb hTb (fun j => hstat (Ts j) (hTsN j) (hTsmin j) (hTsb j)) hmass hconv hy
  -- `ωₙ ∈ (0, ∞)`.
  obtain ⟨ωr, hωr, hωeq⟩ : ∃ ωr : ℝ, 0 < ωr ∧ unitBallVolume n = ENNReal.ofReal ωr := by
    have h0 : unitBallVolume n ≠ 0 :=
      (measure_ball_pos (volume : Measure (Euclid n)) (0 : Euclid n) one_pos).ne'
    have htop : unitBallVolume n ≠ ∞ :=
      (measure_ball_lt_top (μ := (volume : Measure (Euclid n))) (x := 0) (r := 1)).ne
    exact ⟨_, ENNReal.toReal_pos h0 htop, (ENNReal.ofReal_toReal htop).symm⟩
  have hbd : ∀ ρ : ℝ, ENNReal.ofReal (1 + δ) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) =
      ENNReal.ofReal ((1 + δ) * (ωr * ρ ^ n)) := by
    intro ρ
    rw [hωeq, ENNReal.ofReal_mul (by linarith : (0 : ℝ) ≤ 1 + δ), ENNReal.ofReal_mul hωr.le,
      mul_assoc]
  -- Density ratios at `y` below `a > 1` bound the mass of small balls about `y`.
  have hD : ∀ a : ℝ, 1 < a → ∀ᶠ s in 𝓝[>] (0 : ℝ),
      T.massOn (ball y s) < ENNReal.ofReal (a * (ωr * s ^ n)) := by
    intro a ha
    have hlt : ENNReal.ofReal 1 < ENNReal.ofReal a :=
      (ENNReal.ofReal_lt_ofReal_iff (by linarith)).2 ha
    filter_upwards [hdens.2.eventually (eventually_lt_nhds hlt), self_mem_nhdsWithin]
      with s hs (hs0 : 0 < s)
    have hpos : (0 : ℝ) < ωr * s ^ n := by positivity
    rw [hωeq, ← ENNReal.ofReal_mul hωr.le, ENNReal.div_lt_iff
      (Or.inl (ENNReal.ofReal_pos.2 hpos).ne') (Or.inl ENNReal.ofReal_ne_top)] at hs
    rwa [ENNReal.ofReal_mul (by linarith : (0 : ℝ) ≤ a)]
  refine ⟨?_, ?_⟩
  · -- `y ∈ reg T`: the density bound at a small scale `ρ ≤ r₀`.
    obtain ⟨RT, hRT⟩ := hTmin.1
    obtain ⟨ρ, hρ, hρ0, hρr₀⟩ := ((hD (1 + δ) (by linarith)).and (Ioo_mem_nhdsGT hr₀)).exists
    refine hreg T RT hRT hTN hTb (hstat T hTN hTmin hTb RT hRT) y hyT (by rwa [dist_self]) ρ hρ0
      hρr₀.le ?_
    rw [hbd]
    exact hρ.le
  · -- `yⱼ ∈ reg Tⱼ` for all large `j`.  First fix `η > 0` with `(1 + η)(1 + 2η)ⁿ < 1 + δ`.
    have hg : Tendsto (fun x : ℝ => (1 + x) * (1 + 2 * x) ^ n) (𝓝 0) (𝓝 1) := by
      have hcont : Continuous fun x : ℝ => (1 + x) * (1 + 2 * x) ^ n := by fun_prop
      simpa using hcont.tendsto 0
    have h1δ : (1 : ℝ) < 1 + δ := by linarith
    have hηev : ∀ᶠ x in 𝓝[>] (0 : ℝ), (1 + x) * (1 + 2 * x) ^ n < 1 + δ ∧ 0 < x := by
      filter_upwards [(hg.eventually (eventually_lt_nhds h1δ)).filter_mono nhdsWithin_le_nhds,
        self_mem_nhdsWithin] with x hx hx0
      exact ⟨hx, hx0⟩
    obtain ⟨η, hηg, hη0⟩ := hηev.exists
    -- Then a scale `ρ`: small enough for both children, with the limit bound below
    -- `(1 + δ)ωₙρⁿ` (as `ρ ↓ 0` the normalized bound tends to `(1 + η)(1 + 2η)ⁿ`).
    have hh : Tendsto (fun ρ : ℝ => (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (1 + 2 * η) ^ n * ωr) +
        c₁ * (1 + η) ^ (n + 1) * ρ) (𝓝 0) (𝓝 ((1 + η) * (1 + 2 * η) ^ n * ωr)) := by
      have hcont : Continuous fun ρ : ℝ => (1 + c * ((1 + η) * ρ)) ^ n *
          ((1 + η) * (1 + 2 * η) ^ n * ωr) + c₁ * (1 + η) ^ (n + 1) * ρ := by fun_prop
      simpa using hcont.tendsto 0
    have hlin : Tendsto (fun ρ : ℝ => (1 + η) * ρ) (𝓝 0) (𝓝 0) := by
      have hcont : Continuous fun ρ : ℝ => (1 + η) * ρ := by fun_prop
      simpa using hcont.tendsto 0
    have hmap : Tendsto (fun ρ : ℝ => (1 + η) * ρ + η * ρ) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
      · have hcont : Continuous fun ρ : ℝ => (1 + η) * ρ + η * ρ := by fun_prop
        simpa using (hcont.tendsto 0).mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
        show 0 < (1 + η) * ρ + η * ρ
        positivity
    have hρev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), 0 < ρ ∧ ρ < r₀ ∧ (1 + η) * ρ < r₁ ∧
        (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (1 + 2 * η) ^ n * ωr) +
          c₁ * (1 + η) ^ (n + 1) * ρ < (1 + δ) * ωr ∧
        T.massOn (ball y ((1 + η) * ρ + η * ρ)) <
          ENNReal.ofReal ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) := by
      filter_upwards [self_mem_nhdsWithin,
        (eventually_lt_nhds hr₀).filter_mono nhdsWithin_le_nhds,
        (hlin.eventually (eventually_lt_nhds hr₁)).filter_mono nhdsWithin_le_nhds,
        (hh.eventually (eventually_lt_nhds (mul_lt_mul_of_pos_right hηg hωr))).filter_mono
          nhdsWithin_le_nhds,
        hmap.eventually (hD (1 + η) (by linarith))] with ρ h1 h2 h3 h4 h5
      exact ⟨h1, h2, h3, h4, h5⟩
    obtain ⟨ρ, hρ0, hρr₀, hρr₁, hρh, hρD⟩ := hρev.exists
    have hηρ : 0 < η * ρ := mul_pos hη0 hρ0
    have hlimρ := hlim ((1 + η) * ρ) (η * ρ) hηρ (by nlinarith) hρr₁
    have hreal : (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
        c₁ * ((1 + η) * ρ) ^ (n + 1) < (1 + δ) * (ωr * ρ ^ n) := by
      have hs : (1 + η) * ρ + η * ρ = (1 + 2 * η) * ρ := by ring
      calc (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
            c₁ * ((1 + η) * ρ) ^ (n + 1)
          = ((1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (1 + 2 * η) ^ n * ωr) +
              c₁ * (1 + η) ^ (n + 1) * ρ) * ρ ^ n := by
            rw [hs, mul_pow, mul_pow, pow_succ ρ n]
            ring
        _ < (1 + δ) * ωr * ρ ^ n := mul_lt_mul_of_pos_right hρh (pow_pos hρ0 n)
        _ = (1 + δ) * (ωr * ρ ^ n) := mul_assoc _ _ _
    have hA : (0 : ℝ) ≤ (1 + c * ((1 + η) * ρ)) ^ n := by positivity
    have hX : (0 : ℝ) ≤ (1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n) := by positivity
    have hB : (0 : ℝ) ≤ c₁ * ((1 + η) * ρ) ^ (n + 1) := by positivity
    have hbound : limsup (fun j => (Ts j).massOn (ball y ((1 + η) * ρ))) atTop <
        ENNReal.ofReal ((1 + δ) * (ωr * ρ ^ n)) :=
      calc limsup (fun j => (Ts j).massOn (ball y ((1 + η) * ρ))) atTop
          ≤ ENNReal.ofReal ((1 + c * ((1 + η) * ρ)) ^ n) *
              T.massOn (ball y ((1 + η) * ρ + η * ρ)) +
              ENNReal.ofReal (c₁ * ((1 + η) * ρ) ^ (n + 1)) := hlimρ
        _ ≤ ENNReal.ofReal ((1 + c * ((1 + η) * ρ)) ^ n) *
              ENNReal.ofReal ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
              ENNReal.ofReal (c₁ * ((1 + η) * ρ) ^ (n + 1)) := by
            gcongr
        _ = ENNReal.ofReal ((1 + c * ((1 + η) * ρ)) ^ n *
              ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
              c₁ * ((1 + η) * ρ) ^ (n + 1)) := by
            rw [ENNReal.ofReal_add (mul_nonneg hA hX) hB, ENNReal.ofReal_mul hA]
        _ < ENNReal.ofReal ((1 + δ) * (ωr * ρ ^ n)) :=
            (ENNReal.ofReal_lt_ofReal_iff (by positivity)).2 hreal
    -- Eventually `|yⱼ − y| < min(ηρ, r₀)` and `M_{B_{(1+η)ρ}(y)}(Tⱼ) < (1 + δ)ωₙρⁿ`.
    filter_upwards [eventually_lt_of_limsup_lt hbound, hys.eventually (ball_mem_nhds y hηρ),
      hys.eventually (ball_mem_nhds y hr₀)] with j hj hjη hjr₀
    obtain ⟨Rj, hRj⟩ := (hTsmin j).1
    refine hreg (Ts j) Rj hRj (hTsN j) (hTsb j) (hstat (Ts j) (hTsN j) (hTsmin j) (hTsb j) Rj hRj)
      (ys j) (hysspt j) hjr₀ ρ hρ0 hρr₀.le ?_
    rw [hbd]
    refine ((Ts j).massOn_mono (ball_subset_ball' ?_)).trans hj.le
    have hd : dist (ys j) y < η * ρ := hjη
    linarith
/-- **Reduction to multiplicity one**, a step of **Simon 7.4.2** (chapter-07.txt lines 605–610),
as in the proof of Ch. 5, Corollary 7.3 (chapter-05.txt lines 1389–1394, `Ṽ = v(M, N⁻¹θ)⌞B_ρ(ξ)`).
Let `T = τ(M, θ, ξ)` be minimizing in `U ∩ N` with `spt T ⊆ N` and `∂T = 0`, let `z₀ ∈ spt T` and
`B = B_r(z₀) ⊆ U`, and let `θ = N₀ ≥ 1` `μ_T`-a.e. on `B` with `Θⁿ(μ_T, z₀) = N₀`.  Then
`T₀ = N₀⁻¹ T` in `B` is minimizing in `B ∩ N`, `spt T₀ ⊆ N`, `∂T₀ = 0`, `M_W(T₀) < ∞` for `W ⊂⊂ B`,
`z₀ ∈ spt T₀`, `Θⁿ(μ_{T₀}, z₀) = 1`, and `z₀ ∈ reg T₀` implies `z₀ ∈ reg T`.  Since
`T(ι ω) = N₀ T₀(ω)`: `T₀ = τ(M ∩ B, 1, ξ)`, `spt T₀ = spt T ∩ B`, `M_W(T) = N₀ M_W(T₀)` for `W ⊆ B`
(so `M_W(T₀) ≤ μ_T(W̄) < ∞` and the densities differ by the factor `N₀`), and `T₀ = m[[M']]` near
`z₀` gives `T = (N₀ m)[[M']]` there.  For minimality let `S₀` compete with `T₀` in `W`, and
`K = spt(S₀ − T₀)`.  The weight of `X = S₀ − T₀` vanishes on `B \ K`, so `X` extends by zero to
`E ∈ 𝒟ₙ(U)`, and `S = T + N₀E` competes with `T` in `W`: it is integer multiplicity, `∂S = ∂T`
because `∂E = 0`, and `spt(S − T) ⊆ K`.  Hence `N₀ M_W(T₀) = M_W(T) ≤ M_W(S) = N₀ M_W(S₀)`. -/
theorem Submission.rsd_constant_multiplicity_reduction : ∀ (P n : ℕ) (U N : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n) (z₀ : Euclid P) (r : ℝ) (N₀ : ℕ), IsOpen U → IsMinimizingIn T (U ∩ N) → T.support ⊆ N → BoundaryVanishes T → R.Represents T → 0 < r → ball z₀ r ⊆ U → 0 < N₀ → (∀ᵐ x ∂R.measure, x ∈ ball z₀ r → R.mult x = N₀) → z₀ ∈ T.support → HasMassDensity T z₀ N₀ → ∃ T₀ : GeometricCurrentOn (ball z₀ r) n, IsMinimizingIn T₀ (ball z₀ r ∩ N) ∧ T₀.support ⊆ N ∧ BoundaryVanishes T₀ ∧ (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W (ball z₀ r) → T₀.massOn W < ∞) ∧ z₀ ∈ T₀.support ∧ HasMassDensity T₀ z₀ 1 ∧ (z₀ ∈ regularSet T₀ → z₀ ∈ regularSet T) := by
  intro P n U N T R z₀ r N₀ hU hmin hTN hbdry hRT hr hBU hN₀ hconst hz₀ hdens
  have hc : (N₀ : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hN₀.ne'
  have hc0 : (0 : ℝ) ≤ N₀ := Nat.cast_nonneg N₀
  have hN0 : ENNReal.ofReal N₀ ≠ 0 := (ENNReal.ofReal_pos.2 (Nat.cast_pos.2 hN₀)).ne'
  have hNtop : ENNReal.ofReal N₀ ≠ ∞ := ENNReal.ofReal_ne_top
  -- Step 1: `T₀ = N₀⁻¹ T` in `B = B_r(z₀)`, i.e. `T(ι ω) = N₀ T₀(ω)` for `ω ∈ 𝒟ⁿ(B)`.
  obtain ⟨T₀, hT₀⟩ : ∃ T₀ : GeometricCurrentOn (ball z₀ r) n, ∀ ω : TestFormOn (ball z₀ r) n,
      T (testFormOnInclusion hBU n ω) = (N₀ : ℝ) * T₀ ω :=
    ⟨⟨(N₀ : ℝ)⁻¹ • (T.restrictDomain hBU).toCurrent, fun ωs h => by
        simpa using ((T.restrictDomain hBU).continuous' ωs h).const_mul (N₀ : ℝ)⁻¹⟩,
      fun ω => (mul_inv_cancel_left₀ hc _).symm⟩
  -- Step 2: `T₀ = τ(M ∩ B, 1, ξ)` is integer multiplicity.
  have hT₀im : IsIntegerMultiplicity T₀ :=
    Submission.rsd_cmr_isIntegerMultiplicity_of_const_mult P n U (ball z₀ r) hBU T R T₀ N₀
      isOpen_ball hN₀ hRT hconst hT₀
  -- Steps 4–5: `spt T₀ = spt T ∩ B`, and `M_W(T) = N₀ M_W(T₀)` for `W ⊆ B`.
  have hspt : T₀.support = T.support ∩ ball z₀ r :=
    Submission.rsd_cmr_support_eq_inter P n U (ball z₀ r) hBU T T₀ N₀ isOpen_ball hc hT₀
  have hmass : ∀ W ⊆ ball z₀ r, T.massOn W = ENNReal.ofReal N₀ * T₀.massOn W :=
    Submission.rsd_cmr_massOn_eq_ofReal_mul P n U (ball z₀ r) hBU T T₀ N₀ hc0 hT₀
  refine ⟨T₀, ⟨hT₀im, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- Step 6: `T₀` is minimizing in `B ∩ N`.  Let `S₀` compete with `T₀` in `W`.
    intro W S₀ hW hWB hS₀ hbS₀ hK hKW
    have hKB : (S₀ - T₀).support ⊆ ball z₀ r := (S₀ - T₀).support_subset_domain
    have hWsub : W ⊆ ball z₀ r := subset_closure.trans hWB.2
    have hX : ∀ ω, (S₀ - T₀) ω = S₀ ω - T₀ ω := fun _ => rfl
    -- Step 6(a): `X = S₀ − T₀ = τ(M_X, θ_X, ξ_X)` is integer multiplicity.
    obtain ⟨RX, hRX⟩ := Submission.rsd_isIntegerMultiplicity_int_combination P n (ball z₀ r) S₀
      T₀ (S₀ - T₀) 1 (-1) isOpen_ball hS₀ hT₀im fun ω => by
        rw [hX]
        push_cast
        ring
    -- Step 6(b): `μ_X` vanishes on a ball about each point of `B \ K`.
    have hnull : ∀ y ∈ ball z₀ r, y ∉ (S₀ - T₀).support →
        ∃ ρ : ℝ, 0 < ρ ∧ RX.measure (ball y ρ) = 0 := by
      intro y hy hyK
      have h := mt (Submission.rsd_mem_support_iff_measure_ball_pos P n (ball z₀ r) (S₀ - T₀) RX
        isOpen_ball hRX y).2 hyK
      push Not at h
      obtain ⟨ρ, hρ, hμ⟩ := h hy
      exact ⟨ρ, hρ, nonpos_iff_eq_zero.1 hμ⟩
    -- Step 6(c): the extension `E ∈ 𝒟ₙ(U)` of `X` by zero.
    obtain ⟨E, hE, hEX, hEK⟩ := Submission.rsd_cmr_zero_extension P n U (ball z₀ r)
      (S₀ - T₀).support hBU (S₀ - T₀) RX isOpen_ball hK hKB hRX hnull
    -- Step 6(d): the competitor `S = T + N₀E` is integer multiplicity.
    obtain ⟨S, hS⟩ : ∃ S : GeometricCurrentOn U n, ∀ ω, S ω = T ω + (N₀ : ℝ) * E ω :=
      ⟨⟨T.toCurrent + (N₀ : ℝ) • E.toCurrent, fun ωs h => by
          simpa using (T.continuous' ωs h).add ((E.continuous' ωs h).const_mul (N₀ : ℝ))⟩,
        fun _ => rfl⟩
    have hSim : IsIntegerMultiplicity S :=
      Submission.rsd_isIntegerMultiplicity_int_combination P n U T E S 1 N₀ hU hmin.1 hE
        fun ω => by
          rw [hS]
          push_cast
          ring
    -- Step 6(f): `S − T = N₀E` vanishes on forms missing `K`, so `spt(S − T) ⊆ K` is compact.
    have hST : ∀ ω, (S - T) ω = S ω - T ω := fun _ => rfl
    obtain ⟨hSTK, hSTc⟩ := Submission.rsd_cmr_support_subset_of_vanish P n U (S₀ - T₀).support
      (S - T) hU hK (hKB.trans hBU) fun ω hω => by
        rw [hST, hS, hEK ω hω, mul_zero, add_zero, sub_self]
    -- Step 6(e): `∂S = ∂T`: `∂E` vanishes on forms missing `K` and on `ι(𝒟ⁿ⁻¹(B))`, where
    -- `∂E(ι ψ) = X(dψ) = ∂S₀(ψ) − ∂T₀(ψ) = 0`; hence `∂E = 0`.
    have hbS : SameBoundary S T := by
      cases n with
      | zero => trivial
      | succ m =>
        have hb₀ : S₀.boundary = T₀.boundary := hbS₀
        have hEb := Submission.rsd_cmr_eq_zero_of_vanish_off_compact P m U (ball z₀ r)
          (S₀ - T₀).support hBU E.boundary isOpen_ball hK hKB
          (fun ω hω => by
            rw [GeometricCurrentOn.boundary_apply]
            exact hEK _ (hω.mono_left
              (tsupport_exteriorDerivative_subset (ω : DifferentialForm (Euclid P) m))))
          fun ψ => by
            have hι : exteriorDerivativeTestOn U m (testFormOnInclusion hBU m ψ) =
                testFormOnInclusion hBU (m + 1) (exteriorDerivativeTestOn (ball z₀ r) m ψ) :=
              Subtype.ext rfl
            have hψ : S₀.boundary ψ = T₀.boundary ψ := by rw [hb₀]
            rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply] at hψ
            rw [GeometricCurrentOn.boundary_apply, hι, hEX, hX, hψ, sub_self]
        change S.boundary = T.boundary
        ext ω
        have h0 := hEb ω
        rw [GeometricCurrentOn.boundary_apply] at h0
        rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, hS, h0, mul_zero,
          add_zero]
    -- Step 6(g): `N₀ M_W(T₀) = M_W(T) ≤ M_W(S) = N₀ M_W(S₀)`, since `S(ι ω) = N₀ S₀(ω)`.
    have hle := hmin.2 W S hW ⟨hWB.1, hWB.2.trans hBU⟩ hSim hbS hSTc fun x hx =>
      ⟨⟨hBU (hKW (hSTK hx)).1.1, (hKW (hSTK hx)).1.2⟩, (hKW (hSTK hx)).2⟩
    rwa [hmass W hWsub, Submission.rsd_cmr_massOn_eq_ofReal_mul P n U (ball z₀ r) hBU S S₀ N₀ hc0
      (fun ω => by
        rw [hS, hT₀, hEX, hX]
        ring) W hWsub, ENNReal.mul_le_mul_iff_right hN0 hNtop] at hle
  · -- Step 4(a): `spt T₀ ⊆ spt T ⊆ N`.
    rw [hspt]
    exact inter_subset_left.trans hTN
  · -- Step 3: `∂T₀ = 0`, as `N₀ ∂T₀(ω) = ∂T(ι ω) = 0`.
    cases n with
    | zero => trivial
    | succ m =>
      have hb : T.boundary = 0 := hbdry
      change T₀.boundary = 0
      ext ω
      have hι : testFormOnInclusion hBU (m + 1) (exteriorDerivativeTestOn (ball z₀ r) m ω) =
          exteriorDerivativeTestOn U m (testFormOnInclusion hBU m ω) := Subtype.ext rfl
      have h0 : T (exteriorDerivativeTestOn U m (testFormOnInclusion hBU m ω)) = 0 := by
        rw [← GeometricCurrentOn.boundary_apply, hb, GeometricCurrentOn.zero_apply]
      have h := hT₀ (exteriorDerivativeTestOn (ball z₀ r) m ω)
      rw [hι, h0] at h
      rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply]
      exact (mul_eq_zero.1 h.symm).resolve_left hc
  · -- Step 5(a): `M_W(T₀) ≤ N₀ M_W(T₀) = M_W(T) = μ_T(W) ≤ μ_T(W̄) < ∞`.
    intro W hW hWB
    have hWsub : W ⊆ ball z₀ r := subset_closure.trans hWB.2
    have hcl : MeasurableSet (closure W) := isClosed_closure.measurableSet
    calc T₀.massOn W ≤ ENNReal.ofReal N₀ * T₀.massOn W :=
          le_mul_of_one_le_left' (ENNReal.one_le_ofReal.2 (Nat.one_le_cast.2 hN₀))
      _ = R.measure W := by
          rw [← hmass W hWsub,
            Submission.rsd_massOn_eq_measure P n U T R hU hRT W hW (hWsub.trans hBU)]
      _ ≤ R.measure (closure W) := measure_mono subset_closure
      _ = ∫⁻ x in R.carrier ∩ closure W, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
          rw [IMRep.measure, withDensity_apply _ hcl, Measure.restrict_restrict hcl, inter_comm]
      _ < ∞ := (R.locallyIntegrable_mult _ hWB.1 (hWB.2.trans hBU)).lt_top
  · -- Step 4(b): `z₀ ∈ spt T ∩ B = spt T₀`.
    rw [hspt]
    exact ⟨hz₀, mem_ball_self hr⟩
  · -- Step 5(b): `M_{B_ρ(z₀)}(T₀) = N₀⁻¹ M_{B_ρ(z₀)}(T)` for `ρ < r`; the density is `N₀⁻¹N₀ = 1`.
    refine ⟨zero_le_one, ?_⟩
    have h := ENNReal.Tendsto.const_mul hdens.2 (Or.inr (ENNReal.inv_ne_top.2 hN0))
    rw [ENNReal.inv_mul_cancel hN0 hNtop, ← ENNReal.ofReal_one] at h
    refine h.congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hr] with ρ hρ
    rw [hmass _ (ball_subset_ball hρ.2.le), mul_div_assoc, ENNReal.inv_mul_cancel_left hN0 hNtop]
  · -- Step 7: `T₀ = m[[M']]` near `z₀` gives `T = (N₀ m)[[M']]` there.
    exact Submission.rsd_cmr_regularSet_transfer P n U (ball z₀ r) hBU T T₀ N₀ z₀
      (Nat.cast_ne_zero.2 hN₀.ne') (fun ω => by rw [Int.cast_natCast]; exact hT₀ ω) hz₀

/-- **Simon 7.4.2–7.4.3** (chapter-07.txt lines 608–631; Allard's theorem for `T/k`): a support
point `p` of a minimizing cycle `T` is regular if `Θⁿ(μ_T, y) = k` for every `y ∈ spt T` near
`p`.  Fix `T = τ(S, θ, ξ)`, so `μ_T = θHⁿ⌞S ≪ Hⁿ⌞S`, and a radius `r ≤ δ` with `B_r(p) ⊆ U`.  Then
`n ≤ P`: otherwise `Hⁿ` vanishes on balls of `ℝᴾ`, against `μ_T(B_1(p)) > 0`.  `μ_T`-a.e. `x` lies
in `spt T` and has density `θ(x)`, so `θ = k` `μ_T`-a.e. on `B_r(p)` by uniqueness of densities;
`k ≥ 1` since `θ > 0` `μ_T`-a.e. and `μ_T(B_r(p)) > 0`.  Dividing by `k`
(`rsd_constant_multiplicity_reduction`) gives a minimizing cycle `T₀` in `B_r(p)` with
`Θⁿ(μ_{T₀}, p) = 1` and `p ∈ reg T₀ → p ∈ reg T`; 7.4.3 for the constant sequence `T₀`, with
`N = ℝ^{n+k₀}` (`P = n + k₀`, identity chart), gives `p ∈ reg T₀`. -/
theorem Submission.idtp_ccd_regular_of_const_density : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (p : Euclid P) (k : ℕ) (δ : ℝ), 1 ≤ n → IsOpen U → IsMinimizingIn T U → BoundaryVanishes T → p ∈ T.support → 0 < δ → (∀ y ∈ T.support, y ∈ ball p δ → HasMassDensity T y k) → p ∈ regularSet T := by
  intro P n U T p k δ _ hU hmin hb hp hδ hdens
  -- `T = τ(S, θ, ξ)`; `μ_T = θHⁿ⌞S ≪ Hⁿ⌞S`, and `μ_T(B_s(p)) > 0` for `s > 0` as `p ∈ spt T`.
  obtain ⟨R, hR⟩ := hmin.1
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hpos : ∀ s : ℝ, 0 < s → 0 < R.measure (ball p s) :=
    ((Submission.rsd_mem_support_iff_measure_ball_pos P n U T R hU hR p).1 hp).2
  -- A radius `r ≤ δ` with `B_r(p) ⊆ U`.
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU p (T.support_subset_domain hp)
  obtain ⟨r, hr, hrδ, hrU⟩ : ∃ r : ℝ, 0 < r ∧ ball p r ⊆ ball p δ ∧ ball p r ⊆ U :=
    ⟨min ε δ, lt_min hε hδ, ball_subset_ball (min_le_right ε δ),
      (ball_subset_ball (min_le_left ε δ)).trans hεU⟩
  -- `n ≤ P`: otherwise `Hⁿ(B_1(p)) = 0` in `ℝᴾ`, so `μ_T(B_1(p)) = 0`.
  have hnP : n ≤ P := by
    refine le_of_not_gt fun hlt => ?_
    have h0 : μHE[n] (ball p 1) = 0 := by
      rcases Measure.euclideanHausdorffMeasure_zero_or_top hlt (ball p 1) with h | h
      · exact h
      · rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume] at h
        exact absurd h measure_ball_lt_top.ne
    refine (hpos 1 one_pos).ne' (hac ?_)
    rw [Measure.restrict_apply' R.measurableSet_carrier]
    exact measure_mono_null inter_subset_left h0
  -- `θ = k` `μ_T`-a.e. on `B_r(p)`: `μ_T`-a.e. point lies in `spt T` and has density `θ`.
  have hae : ∀ᵐ x ∂R.measure, x ∈ ball p r → R.mult x = k := by
    have hspt : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ T.support := by
      rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
      refine measure_mono_null ?_ (Submission.imrep_carrier_sdiff_support_null P n U T R hU hR)
      exact fun x hx => ⟨hx.2, hx.1⟩
    filter_upwards [Submission.rsd_ae_hasMassDensity_mult P n U T R hU hR, hac.ae_le hspt]
      with x hx hxs hxb
    exact_mod_cast Submission.dimred_cs_mi_hasMassDensity_unique P n U T x _ _ hx
      (hdens x hxs (hrδ hxb))
  -- `k ≥ 1`: `θ > 0` `μ_T`-a.e., so `k = 0` would give `μ_T(B_r(p)) = 0`.
  have hk : 0 < k := by
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · have hθ : ∀ᵐ x ∂R.measure, (R.mult x : ℝ≥0∞) ≠ 0 :=
        (ae_withDensity_iff ((measurable_from_nat (f := fun m : ℕ => (m : ℝ≥0∞))).comp
          R.measurable_mult)).2 (Eventually.of_forall fun _ h => h)
      refine absurd (measure_eq_zero_iff_ae_notMem.2 ?_) (hpos r hr).ne'
      filter_upwards [hae, hθ] with x hx hθx hxb
      exact hθx (by simp [hx hxb])
    · exact hk
  -- Division by the multiplicity: a minimizing cycle `T₀` in `B_r(p)` with density `1` at `p`.
  obtain ⟨T₀, hT₀min, hT₀N, hT₀b, hT₀mass, hpT₀, hT₀dens, htrans⟩ :=
    Submission.rsd_constant_multiplicity_reduction P n U univ T R p r k hU (by rwa [inter_univ])
      (subset_univ _) hb hR hr hrU hk hae hp (hdens p hp (mem_ball_self hδ))
  -- Allard (7.4.3) for the constant sequence `T₀`, with `N = ℝ^{n+k₀}` (identity chart).
  obtain ⟨k₀, rfl⟩ := Nat.exists_eq_add_of_le hnP
  have hN : IsEmbeddedSubmanifold 2 (n + k₀) (univ : Set (Euclid (n + k₀))) := by
    intro y _
    refine ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiffOn_id, injOn_id _,
      by simp, fun K _ hK => by simpa using hK, fun z _ => ?_⟩
    rw [fderiv_id]
    exact fun a b h => h
  exact htrans (Submission.density_one_implies_regular n k₀ k₀ le_rfl (ball p r) univ
    (fun _ => T₀) T₀ (fun _ => p) p isOpen_ball hN (by simp) (fun _ => hT₀min) hT₀min
    (fun _ => hT₀N) hT₀N (fun _ => hT₀b) hT₀b
    (fun W hW hWc => by simpa only [iSup_const] using hT₀mass W hW hWc)
    (fun _ => tendsto_const_nhds) ⟨mem_univ p, mem_ball_self hr⟩ hT₀dens tendsto_const_nhds
    (fun _ => hpT₀)).1
/-- **The tangent space of an embedded `C¹` submanifold** (Simon Ch. 2, §4, (4.3)).  If `M` is an
embedded `C¹` `d`-dimensional submanifold of `ℝᴾ` and `x ∈ M`, then `T_xM` is a linear subspace of
dimension `d`: for a local representation `ψ : V → W ∩ M` with `ψ(v) = x`, `T_xM` is the range of
the injective linear map `Dψ(v)`.  A `C¹` curve in `M` through `x` stays in `ψ(V)` near `0` and,
`ψ` being proper and injective, lifts to a curve in `V` converging to `v` at rate `O(t)` (`Dψ(v)` is
injective), so its velocity lies in the closed subspace `range Dψ(v)`; conversely `Dψ(v) u` is the
velocity of `t ↦ ψ(v + a sin(t / a) u)` for small `a > 0`. -/
theorem Submission.idtp_ccd_sfv_span_tangentSpace_finrank : ∀ (P d : ℕ) (M : Set (Euclid P)) (x : Euclid P), IsEmbeddedSubmanifold 1 d M → x ∈ M → (Submodule.span ℝ (tangentSpace M x) : Set (Euclid P)) = tangentSpace M x ∧ Module.finrank ℝ (Submodule.span ℝ (tangentSpace M x)) = d := by
  intro P d M x hM hx
  obtain ⟨V, W, ψ, hVo, hWo, hxW, hψC, hψinj, hψim, hprop, hψD⟩ := hM x hx
  obtain ⟨v, hvV, rfl⟩ : x ∈ ψ '' V := hψim ▸ ⟨hxW, hx⟩
  rw [Nat.cast_one] at hψC
  set L : Euclid d →L[ℝ] Euclid P := fderiv ℝ ψ v
  have hψd : HasFDerivAt ψ L v :=
    ((hψC.contDiffAt (hVo.mem_nhds hvV)).differentiableAt one_ne_zero).hasFDerivAt
  have hrange :
      Set.range L = ((LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)) : Set (Euclid P)) := by
    rw [LinearMap.coe_range]; rfl
  have key : tangentSpace M (ψ v) = Set.range L := by
    ext w
    constructor
    · rintro ⟨γ, -, hγM, hγ0, hγd⟩
      -- lift `γ` near `0` to a curve `φ` in the compact set `S = V ∩ ψ⁻¹(B̄_r(ψ v))`
      have hγc : Tendsto γ (𝓝 0) (𝓝 (ψ v)) := hγ0 ▸ hγd.continuousAt.tendsto
      obtain ⟨r, hr, hrW⟩ := nhds_basis_closedBall.mem_iff.mp (hWo.mem_nhds hxW)
      set S := V ∩ ψ ⁻¹' closedBall (ψ v) r
      have hS : IsCompact S := hprop _ hrW (isCompact_closedBall _ _)
      have hev : ∀ᶠ t in 𝓝 (0 : ℝ), t ∈ Ioo (-1 : ℝ) 1 ∧ γ t ∈ closedBall (ψ v) r := by
        filter_upwards [Ioo_mem_nhds (by norm_num : (-1 : ℝ) < 0) (by norm_num : (0 : ℝ) < 1),
          hγc (closedBall_mem_nhds _ hr)] with t h1 h2
        exact ⟨h1, h2⟩
      have hpre : ∀ t, t ∈ Ioo (-1 : ℝ) 1 ∧ γ t ∈ closedBall (ψ v) r → ∃ z ∈ S, ψ z = γ t := by
        rintro t ⟨ht, htK⟩
        obtain ⟨z, hz, hzt⟩ : γ t ∈ ψ '' V := hψim ▸ ⟨hrW htK, hγM ht⟩
        exact ⟨z, ⟨hz, by rw [mem_preimage, hzt]; exact htK⟩, hzt⟩
      classical
      set φ : ℝ → Euclid d := fun t =>
        if h : t ∈ Ioo (-1 : ℝ) 1 ∧ γ t ∈ closedBall (ψ v) r then (hpre t h).choose else v
        with hφ_def
      have hφ : ∀ᶠ t in 𝓝 (0 : ℝ), φ t ∈ S ∧ ψ (φ t) = γ t := hev.mono fun t ht => by
        rw [hφ_def]; dsimp only; rw [dite_eq_left ht]; exact (hpre t ht).choose_spec
      -- `φ t → v`: every cluster point `z ∈ S` has `ψ z = ψ v`
      have hφv : Tendsto φ (𝓝 0) (𝓝 v) := by
        refine hS.tendsto_nhds_of_unique_mapClusterPt (hφ.mono fun t ht => ht.1) ?_
        intro z hz hcl
        have hψz : ContinuousAt ψ z := hψC.continuousOn.continuousAt (hVo.mem_nhds hz.1)
        have h1 : MapClusterPt (ψ z) (𝓝 0) (ψ ∘ φ) := hcl.continuousAt_comp hψz
        have h2 : Tendsto (ψ ∘ φ) (𝓝 0) (𝓝 (ψ v)) := hγc.congr' (hφ.mono fun t ht => ht.2.symm)
        exact hψinj hz.1 hvV (eq_of_nhds_neBot (ClusterPt.mono h1 h2))
      -- `‖φ t - v‖ ≤ 2K ‖γ t - ψ v‖`, `K` an antilipschitz constant of `L`
      obtain ⟨K, hKpos, hK⟩ := (L : Euclid d →ₗ[ℝ] Euclid P).exists_antilipschitzWith
        (LinearMap.ker_eq_bot.mpr (hψD v hvV))
      have hK0 : (0 : ℝ) < K := hKpos
      have hKL : ∀ h, ‖h‖ ≤ K * ‖L h‖ := fun h => hK.le_mul_norm (map_zero _) h
      have h1 : (fun t => ψ (φ t) - ψ v - L (φ t - v)) =o[𝓝 0] (fun t => φ t - v) :=
        hψd.isLittleO.comp_tendsto hφv
      have h2 : (fun t => φ t - v) =O[𝓝 0] (fun t => γ t - ψ v) := by
        refine Asymptotics.IsBigO.of_bound (2 * K) ?_
        filter_upwards [h1.bound (c := 1 / (2 * K)) (by positivity), hφ] with t ht hφt
        rw [hφt.2] at ht
        have h4 : ‖L (φ t - v)‖ ≤ ‖γ t - ψ v‖ + 1 / (2 * K) * ‖φ t - v‖ := by
          calc ‖L (φ t - v)‖ = ‖(γ t - ψ v) - (γ t - ψ v - L (φ t - v))‖ := by congr 1; abel
            _ ≤ ‖γ t - ψ v‖ + ‖γ t - ψ v - L (φ t - v)‖ := norm_sub_le _ _
            _ ≤ ‖γ t - ψ v‖ + 1 / (2 * K) * ‖φ t - v‖ := by gcongr
        have h5 : ‖φ t - v‖ ≤ K * ‖γ t - ψ v‖ + ‖φ t - v‖ / 2 := by
          calc ‖φ t - v‖ ≤ K * ‖L (φ t - v)‖ := hKL _
            _ ≤ K * (‖γ t - ψ v‖ + 1 / (2 * K) * ‖φ t - v‖) := by gcongr
            _ = K * ‖γ t - ψ v‖ + ‖φ t - v‖ / 2 := by field_simp
        linarith
      have h6 : (fun t => φ t - v) =O[𝓝 0] (fun t : ℝ => t) := by
        have h' := hγd.isBigO_sub
        rw [hγ0] at h'
        simpa only [sub_zero] using h2.trans h'
      -- hence `t • w - L (φ t - v) = o(t)`, and `w` is a limit of points of `range L`
      have h7 : (fun t => ψ (φ t) - ψ v - L (φ t - v)) =o[𝓝 0] (fun t : ℝ => t) :=
        h1.trans_isBigO h6
      have h8 : (fun t => γ t - ψ v - L (φ t - v)) =o[𝓝 0] (fun t : ℝ => t) :=
        h7.congr' (hφ.mono fun t ht => by dsimp only; rw [ht.2]) EventuallyEq.rfl
      have h9 : (fun t => γ t - ψ v - t • w) =o[𝓝 0] (fun t : ℝ => t) := by
        have := hasDerivAt_iff_isLittleO.mp hγd
        simpa [hγ0] using this
      have h10 : (fun t => t • w - L (φ t - v)) =o[𝓝 0] (fun t : ℝ => t) :=
        (h8.sub h9).congr_left fun t => by abel
      have h11 : Tendsto (fun t : ℝ => t⁻¹ • (t • w - L (φ t - v))) (𝓝[≠] 0) (𝓝 0) :=
        h10.tendsto_inv_smul_nhds_zero.mono_left nhdsWithin_le_nhds
      have h12 : Tendsto (fun t : ℝ => L (t⁻¹ • (φ t - v))) (𝓝[≠] 0) (𝓝 w) := by
        have := (tendsto_const_nhds (x := w)).sub h11
        rw [sub_zero] at this
        refine this.congr' ?_
        filter_upwards [self_mem_nhdsWithin] with t (ht : t ≠ 0)
        rw [smul_sub, smul_smul, inv_mul_cancel₀ ht, one_smul, map_smul]
        abel
      have hclosed : IsClosed (Set.range L) :=
        hrange ▸ (LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)).closed_of_finiteDimensional
      exact hclosed.mem_of_tendsto h12 (Eventually.of_forall fun t => ⟨_, rfl⟩)
    · rintro ⟨u, rfl⟩
      obtain ⟨δ, hδ, hδV⟩ := Metric.isOpen_iff.mp hVo v hvV
      set a : ℝ := δ / (‖u‖ + 1) with ha
      have ha0 : 0 < a := by positivity
      set c : ℝ → Euclid d := fun t => v + (a * Real.sin (t / a)) • u with hc
      have hcV : ∀ t, c t ∈ V := fun t => hδV (by
        rw [mem_ball, dist_eq_norm, hc, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_mul,
          abs_of_pos ha0]
        calc a * |Real.sin (t / a)| * ‖u‖ ≤ a * 1 * ‖u‖ := by
              gcongr; exact Real.abs_sin_le_one _
          _ < δ := by
              rw [mul_one, ha, div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
              nlinarith [norm_nonneg u])
      have hcC : ContDiff ℝ 1 c := by
        rw [hc]; fun_prop
      have hcd : HasDerivAt c u 0 := by
        have h1 : HasDerivAt (fun t : ℝ => a * Real.sin (t / a)) 1 0 := by
          have := (((hasDerivAt_id (0 : ℝ)).div_const a).sin).const_mul a
          simpa [ha0.ne'] using this
        simpa only [one_smul] using (h1.smul_const u).const_add v
      refine ⟨ψ ∘ c, (hψC.comp_contDiff hcC hcV).contDiffOn, fun t _ => ?_, ?_, ?_⟩
      · exact ((hψim ▸ mem_image_of_mem ψ (hcV t)) : ψ (c t) ∈ W ∩ M).2
      · simp [hc]
      · exact hψd.comp_hasDerivAt_of_eq 0 hcd (by simp [hc])
  have hspan : Submodule.span ℝ (tangentSpace M (ψ v)) =
      LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P) := by
    rw [key, hrange, Submodule.span_eq]
  refine ⟨?_, ?_⟩
  · rw [hspan, ← hrange, key]
  · rw [hspan, LinearMap.finrank_range_of_inj (hψD v hvV), finrank_euclideanSpace_fin]

/-- **Approximate tangent planes of a carrier inside a `C¹` submanifold** (Simon Ch. 3,
Remark 1.5(2); used with Ch. 4, 2.6 for 7.3.3).  Let `R = (S, θ, ξ)` be an integer multiplicity
triple, `M` an embedded `C¹` `n`-dimensional submanifold, `IsOpen V` and `Hⁿ((S ∩ V) \ M) = 0`.
Then `TₓS = span TₓM` for `Hⁿ`-a.e. `x ∈ S ∩ V`.  For such `x` the field `orients` gives an
approximate tangent plane `Q` of `S` at `x` with `x ∈ M`, and the chosen plane is `Q`.  With a
chart `ψ` of `M` and `ψ(v) = x`, `M` is flat at `x` along `Dψ(v)(ℝⁿ)`; as `M ∪ Vᶜ` carries
`Hⁿ`-almost all of `S`, a bump at a point of `Q` off `Dψ(v)(ℝⁿ)` would have positive `Hⁿ⌞Q`
integral but vanishing blow-up integrals, so `Q ⊆ Dψ(v)(ℝⁿ)`.  Velocities of the curves
`ψ(v + h(t)a)` give `Dψ(v)(ℝⁿ) ⊆ TₓM`, and `dim Q = n = dim span TₓM`
(`idtp_ccd_sfv_span_tangentSpace_finrank`) forces `Q = span TₓM`. -/
theorem Submission.idtp_ccd_sfv_approxTangentPlane_eq_span_ae : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (M V : Set (Euclid P)), IsEmbeddedSubmanifold 1 n M → IsOpen V → μHE[n] ((R.carrier ∩ V) \ M) = 0 → ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ V)), approxTangentPlane n R.carrier x = Submodule.span ℝ (tangentSpace M x) := by
  intro P n U R N O hN hO hnull
  set S := R.carrier with hSdef
  have hSO : MeasurableSet (S ∩ O) := R.measurableSet_carrier.inter hO.measurableSet
  -- `Hⁿ⌞(S ∩ O)`-a.e. `x` has an approximate tangent plane of `S` (field `orients`), lies in
  -- `S ∩ O`, and lies in `N` (as `Hⁿ((S ∩ O) \ N) = 0`)
  have h1 : ∀ᵐ x ∂(μHE[n].restrict (S ∩ O)), ∃ Q, HasApproximateTangentSpaceAt n S x Q :=
    (ae_restrict_of_ae_restrict_of_subset inter_subset_left R.orients).mono
      fun x ⟨Q, hQ, _⟩ => ⟨Q, hQ⟩
  have h2 : ∀ᵐ x ∂(μHE[n].restrict (S ∩ O)), x ∈ S ∩ O := ae_restrict_mem hSO
  have h3 : ∀ᵐ x ∂(μHE[n].restrict (S ∩ O)), x ∈ N := by
    rw [ae_iff, Measure.restrict_apply' hSO]
    refine measure_mono_null (fun y hy => ?_) hnull
    exact ⟨hy.2, hy.1⟩
  filter_upwards [h1, h2, h3] with x hx1 hx2 hxN
  obtain ⟨Q, hQ⟩ := hx1
  -- (a) the chosen plane is `Q` (Ch. 3, Remark 1.5(1))
  have hAQ : approxTangentPlane n S x = Q := by
    have h : ∃ Q', HasApproximateTangentSpaceAt n S x Q' := ⟨Q, hQ⟩
    unfold approxTangentPlane
    rw [dite_eq_left h]
    exact h.choose_spec.unique hQ
  -- (b) `Q ≤ T` whenever a set `N'` carrying `Hⁿ`-almost all of `S` is flat at `x` along `T`:
  -- for `q ∈ Q \ T` the bump `g = max(0, δ/2 − |· − q|)`, `δ = dist(q, T)`, has `∫_Q g dHⁿ > 0`,
  -- while `∫_{η_{x,r}(S)} g dHⁿ = 0` for all small `r`
  have hle : ∀ (N' : Set (Euclid P)) (T : Submodule ℝ (Euclid P)), μHE[n] (S \ N') = 0 →
      (∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ z ∈ N', dist z x < ρ →
        ∃ t ∈ T, ‖z - x - t‖ ≤ ε * ‖z - x‖) → Q ≤ T := by
    intro N' T hnull' hflat q hq
    by_contra hqT
    -- `T` is closed, so `δ = dist(q, T) > 0`
    have hTc : IsClosed (T : Set (Euclid P)) := T.closed_of_finiteDimensional
    have hδ : 0 < infDist q (T : Set (Euclid P)) :=
      (hTc.notMem_iff_infDist_pos ⟨0, T.zero_mem⟩).1 hqT
    set δ := infDist q (T : Set (Euclid P)) with hδdef
    -- the bump `g = max(0, δ/2 − |· − q|)`, positive exactly on `B_{δ/2}(q)`
    set g : Euclid P → ℝ := fun y => max 0 (δ / 2 - ‖y - q‖) with hgdef
    have hgc : Continuous g :=
      continuous_const.max (continuous_const.sub (continuous_id.sub continuous_const).norm)
    have hg0 : 0 ≤ g := fun y => le_max_left _ _
    have hgsupp : ∀ y, g y ≠ 0 → ‖y - q‖ < δ / 2 := by
      intro y hy
      by_contra h
      have h' : δ / 2 ≤ ‖y - q‖ := not_lt.mp h
      apply hy
      exact max_eq_left (by linarith)
    have hgpos : ∀ y, ‖y - q‖ < δ / 2 → 0 < g y := fun y hy =>
      lt_max_of_lt_right (by linarith)
    have hgcs : HasCompactSupport g := by
      apply HasCompactSupport.intro (isCompact_closedBall q (δ / 2))
      intro y hy
      by_contra h
      apply hy
      rw [mem_closedBall, dist_eq_norm]
      exact (hgsupp y h).le
    let f : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨g, hgc⟩, hgcs⟩
    -- `∫_Q g dHⁿ > 0`: `Hⁿ⌞Q` is regular with support `Q ∋ q`
    have hQn : Module.finrank ℝ Q = n := hQ.1
    have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule hQn
    have hsupp :=
      Poincare.SimonGMT.Chapter03.support_euclideanHausdorffMeasure_restrict_submodule hQn
    have hint : Integrable g ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))) :=
      hgc.integrable_of_hasCompactSupport hgcs
    have hpos : 0 < ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] := by
      rw [integral_pos_iff_support_of_nonneg hg0 hint]
      have hq' : q ∈ ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))).support := by
        rw [hsupp]
        exact hq
      have hball : 0 < ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P)))
          (ball q (δ / 2)) :=
        (Measure.mem_support_iff_forall q).1 hq' _ (ball_mem_nhds q (by linarith))
      refine hball.trans_le (measure_mono ?_)
      intro y hy
      rw [mem_ball, dist_eq_norm] at hy
      exact (hgpos y hy).ne'
    -- constants: `ε (|q| + δ) = δ / 2`
    have hqδ : 0 < ‖q‖ + δ := by positivity
    set ε : ℝ := δ / (2 * (‖q‖ + δ)) with hεdef
    have hε : 0 < ε := by positivity
    have hεq : ε * (‖q‖ + δ) = δ / 2 := by
      rw [hεdef]
      field_simp
    obtain ⟨ρ, hρ, hflatρ⟩ := hflat ε hε
    -- `∫_{η_{x,r}(S)} g dHⁿ = 0` for `0 < r < ρ / (|q| + δ)`
    have hvan : ∀ r : ℝ, 0 < r → r < ρ / (‖q‖ + δ) →
        ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' S, f y ∂μHE[n] = 0 := by
      intro r hr hrρ
      -- `η_{x,r}(S \ N') = r⁻¹ (S \ N' − x)` is `Hⁿ`-null
      have hnull'' : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S \ N')) = 0 := by
        have himg' : Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S \ N') =
            (fun y => r⁻¹ • y) '' ((fun y => y - x) '' (S \ N')) := by
          rw [Set.image_image]
          rfl
        have hiso : Isometry (fun y : Euclid P => y - x) :=
          Isometry.of_dist_eq fun a b => dist_sub_right a b x
        rw [himg', Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
          hiso.euclideanHausdorffMeasure_image, hnull', smul_zero]
      -- flatness: `g` vanishes on `η_{x,r}(S ∩ N')`
      have hsub : {y | g y ≠ 0} ∩ Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ⊆
          Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S \ N') := by
        rintro y ⟨hgy, z, hzS, rfl⟩
        refine ⟨z, ⟨hzS, fun hzN => ?_⟩, rfl⟩
        have hyq : ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z - q‖ < δ / 2 := hgsupp _ hgy
        set y := Poincare.SimonGMT.Chapter03.blowUpMap x r z with hy
        have hy' : y = r⁻¹ • (z - x) := rfl
        have hzx : z - x = r • y := by
          rw [hy', smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
        have hynorm : ‖y‖ < ‖q‖ + δ / 2 := by
          calc ‖y‖ = ‖(y - q) + q‖ := by rw [sub_add_cancel]
            _ ≤ ‖y - q‖ + ‖q‖ := norm_add_le _ _
            _ < δ / 2 + ‖q‖ := by linarith
            _ = ‖q‖ + δ / 2 := by ring
        have hzxn : ‖z - x‖ = r * ‖y‖ := by
          rw [hzx, norm_smul, Real.norm_of_nonneg hr.le]
        have hdist : dist z x < ρ := by
          rw [dist_eq_norm, hzxn]
          calc r * ‖y‖ ≤ r * (‖q‖ + δ) := by gcongr; linarith
            _ < ρ / (‖q‖ + δ) * (‖q‖ + δ) := by gcongr
            _ = ρ := by field_simp
        obtain ⟨t, htT, ht⟩ := hflatρ z hzN hdist
        have hrt : r⁻¹ • t ∈ T := T.smul_mem _ htT
        have hyt : y - r⁻¹ • t = r⁻¹ • (z - x - t) := by
          rw [hy']
          exact (smul_sub _ _ _).symm
        have hyt' : ‖y - r⁻¹ • t‖ ≤ ε * ‖y‖ := by
          rw [hyt, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le)]
          calc r⁻¹ * ‖z - x - t‖ ≤ r⁻¹ * (ε * ‖z - x‖) := by gcongr
            _ = ε * ‖y‖ := by rw [hzxn]; field_simp
        have hle' : δ ≤ ‖q - r⁻¹ • t‖ := by
          rw [← dist_eq_norm]
          exact infDist_le_dist_of_mem hrt
        have h2' : ε * ‖y‖ ≤ δ / 2 := by
          rw [← hεq]
          gcongr
          linarith
        have hlt : ‖q - r⁻¹ • t‖ < δ := by
          calc ‖q - r⁻¹ • t‖ = ‖(q - y) + (y - r⁻¹ • t)‖ := by congr 1; abel
            _ ≤ ‖q - y‖ + ‖y - r⁻¹ • t‖ := norm_add_le _ _
            _ < δ / 2 + δ / 2 := by
              have h1' : ‖q - y‖ < δ / 2 := by rw [norm_sub_rev]; exact hyq
              linarith
            _ = δ := by ring
        linarith
      -- so `g = 0` a.e. for `Hⁿ⌞η_{x,r}(S)`, evaluated on the set `{g ≠ 0}`
      have hmeas : MeasurableSet {y | g y ≠ 0} :=
        (isOpen_ne_fun hgc continuous_const).measurableSet
      apply integral_eq_zero_of_ae
      rw [EventuallyEq, ae_iff]
      change (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S)) {y | g y ≠ 0} = 0
      rw [Measure.restrict_apply hmeas]
      exact measure_mono_null hsub hnull''
    -- the blow-up integrals of `g` are eventually `0`, so their limit `∫_Q g dHⁿ` is `0`
    have hlim := hQ.2 f
    have hev : (fun r : ℝ => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' S, f y ∂μHE[n])
        =ᶠ[𝓝[>] 0] fun _ => 0 := by
      have hpos' : 0 < ρ / (‖q‖ + δ) := by positivity
      filter_upwards [Ioo_mem_nhdsGT hpos'] with r hr
      exact hvan r hr.1 hr.2
    have hlim0 : Tendsto (fun r : ℝ => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' S,
        f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0) :=
      tendsto_const_nhds.congr' hev.symm
    have heq := tendsto_nhds_unique hlim hlim0
    have hzero : ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] = 0 := heq
    linarith
  -- a chart `ψ : Vc → W ∩ N` of `N` (Ch. 2, §4, (4.1)) and `v ∈ Vc` with `ψ v = x`
  obtain ⟨Vc, W, ψ, hVc, hW, hxW, hψ, hinj, himg, hprop, hDψ⟩ := hN x hxN
  obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' Vc := by
    rw [himg]
    exact ⟨hxW, hxN⟩
  have hψ1 : ContDiffOn ℝ 1 ψ Vc := by exact_mod_cast hψ
  -- (c) `N` is flat at `ψ v` along `Dψ(v)(ℝⁿ)`: properness, continuity and injectivity of `ψ`
  -- force `z = ψ(β)` with `β` close to `v`, and the first-order expansion at `v` together with
  -- the coercivity `|h| ≤ K|Dψ(v)h|` absorbs the remainder
  have hflatN : ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ z ∈ N, dist z (ψ v) < ρ →
      ∃ h : Euclid n, ‖z - ψ v - fderiv ℝ ψ v h‖ ≤ ε * ‖z - ψ v‖ := by
    intro ε hε
    set L := fderiv ℝ ψ v with hLdef
    have hdiff : DifferentiableAt ℝ ψ v :=
      (hψ1.differentiableOn one_ne_zero).differentiableAt (hVc.mem_nhds hv)
    have hL : HasFDerivAt ψ L v := hdiff.hasFDerivAt
    have hcont : ContinuousOn ψ Vc := hψ1.continuousOn
    -- coercivity of the injective derivative
    obtain ⟨K, hKpos, hK⟩ := LinearMap.exists_antilipschitzWith (L : Euclid n →ₗ[ℝ] Euclid P)
      (LinearMap.ker_eq_bot.mpr (hDψ v hv))
    have hcoer : ∀ h : Euclid n, ‖h‖ ≤ K * ‖L h‖ := fun h =>
      ContinuousLinearMap.bound_of_antilipschitz L hK h
    have hK0 : (0 : ℝ) < K := by exact_mod_cast hKpos
    set η : ℝ := min (1 / (2 * K)) (ε / (2 * K)) with hηdef
    have hη : 0 < η := lt_min (by positivity) (by positivity)
    have hηK : η * K ≤ 1 / 2 := by
      calc η * K ≤ 1 / (2 * K) * K := by gcongr; exact min_le_left _ _
        _ = 1 / 2 := by field_simp
    have hηε : η * (2 * K) ≤ ε := by
      calc η * (2 * K) ≤ ε / (2 * K) * (2 * K) := by gcongr; exact min_le_right _ _
        _ = ε := by field_simp
    -- first-order expansion
    obtain ⟨σ, hσ, hσball⟩ := Metric.eventually_nhds_iff.1 (hL.isLittleO.bound hη)
    -- a compact set away from `v`
    obtain ⟨δ₁, hδ₁, hδ₁W⟩ := Metric.isOpen_iff.1 hW (ψ v) hxW
    set δ₀ : ℝ := δ₁ / 2 with hδ₀eq
    have hδ₀ : 0 < δ₀ := by positivity
    have hcbW : closedBall (ψ v) δ₀ ⊆ W := (closedBall_subset_ball (by linarith)).trans hδ₁W
    have hA : IsCompact (Vc ∩ ψ ⁻¹' closedBall (ψ v) δ₀) :=
      hprop _ hcbW (isCompact_closedBall _ _)
    set C := (Vc ∩ ψ ⁻¹' closedBall (ψ v) δ₀) \ ball v σ with hCdef
    have hC : IsCompact C := hA.diff isOpen_ball
    have hCV : C ⊆ Vc := fun β hβ => hβ.1.1
    -- positive separation on `C`
    obtain ⟨m, hm, hmC⟩ : ∃ m : ℝ, 0 < m ∧ ∀ β ∈ C, m ≤ ‖ψ β - ψ v‖ := by
      rcases C.eq_empty_or_nonempty with hCe | hCne
      · refine ⟨1, one_pos, fun β hβ => ?_⟩
        rw [hCe] at hβ
        exact hβ.elim
      · have hfc : ContinuousOn (fun β => ‖ψ β - ψ v‖) C :=
          ((hcont.mono hCV).sub continuousOn_const).norm
        obtain ⟨β₀, hβ₀C, hβ₀min⟩ := hC.exists_isMinOn hCne hfc
        refine ⟨‖ψ β₀ - ψ v‖, ?_, fun β hβ => (isMinOn_iff.mp hβ₀min) β hβ⟩
        rcases (norm_nonneg (ψ β₀ - ψ v)).lt_or_eq with hlt | heq
        · exact hlt
        · exfalso
          have h0 : ψ β₀ = ψ v := by
            have h' := heq.symm
            rwa [norm_eq_zero, sub_eq_zero] at h'
          have hβv := hinj (hCV hβ₀C) hv h0
          apply hβ₀C.2
          rw [hβv]
          exact mem_ball_self hσ
    refine ⟨min δ₀ m, lt_min hδ₀ hm, ?_⟩
    intro z hzN hzd
    have hzcb : z ∈ closedBall (ψ v) δ₀ := mem_closedBall.2 (hzd.trans_le (min_le_left _ _)).le
    have hzim : z ∈ ψ '' Vc := by
      rw [himg]
      exact ⟨hcbW hzcb, hzN⟩
    obtain ⟨β, hβV, rfl⟩ := hzim
    have hβA : β ∈ Vc ∩ ψ ⁻¹' closedBall (ψ v) δ₀ := ⟨hβV, hzcb⟩
    have hβσ : dist β v < σ := by
      by_contra hcon
      have hβC : β ∈ C := ⟨hβA, fun hb => hcon (mem_ball.1 hb)⟩
      have h1' := hmC β hβC
      rw [← dist_eq_norm] at h1'
      have h2' : min δ₀ m ≤ dist (ψ β) (ψ v) := (min_le_right _ _).trans h1'
      linarith
    refine ⟨β - v, ?_⟩
    have hest : ‖ψ β - ψ v - L (β - v)‖ ≤ η * ‖β - v‖ := hσball hβσ
    have hLh : ‖L (β - v)‖ ≤ ‖ψ β - ψ v‖ + η * ‖β - v‖ := by
      calc ‖L (β - v)‖ = ‖(ψ β - ψ v) - (ψ β - ψ v - L (β - v))‖ := by congr 1; abel
        _ ≤ ‖ψ β - ψ v‖ + ‖ψ β - ψ v - L (β - v)‖ := norm_sub_le _ _
        _ ≤ ‖ψ β - ψ v‖ + η * ‖β - v‖ := by gcongr
    have hh : ‖β - v‖ ≤ 2 * K * ‖ψ β - ψ v‖ := by
      have h2' : ‖β - v‖ ≤ K * ‖ψ β - ψ v‖ + (η * K) * ‖β - v‖ := by
        calc ‖β - v‖ ≤ K * ‖L (β - v)‖ := hcoer (β - v)
          _ ≤ K * (‖ψ β - ψ v‖ + η * ‖β - v‖) := by gcongr
          _ = K * ‖ψ β - ψ v‖ + (η * K) * ‖β - v‖ := by ring
      have h3' : (η * K) * ‖β - v‖ ≤ 1 / 2 * ‖β - v‖ := by gcongr
      linarith
    calc ‖ψ β - ψ v - L (β - v)‖ ≤ η * ‖β - v‖ := hest
      _ ≤ η * (2 * K * ‖ψ β - ψ v‖) := by gcongr
      _ = (η * (2 * K)) * ‖ψ β - ψ v‖ := by ring
      _ ≤ ε * ‖ψ β - ψ v‖ := by gcongr
  -- (d) `Dψ(v)(ℝⁿ) ⊆ T_{ψ v}N` (Ch. 2, §4, (4.3)): `Dψ(v) a` is the velocity at `0` of the
  -- `C¹` curve `t ↦ ψ(v + h(t) a)` in `N`, `h(t) = t / (1 + t² / c²)`, `c = ρ₀ / |a|`
  have hrange : ∀ a : Euclid n, fderiv ℝ ψ v a ∈ tangentSpace N (ψ v) := by
    intro a
    have hψv : HasFDerivAt ψ (fderiv ℝ ψ v) v :=
      ((hψ1.differentiableOn one_ne_zero).differentiableAt (hVc.mem_nhds hv)).hasFDerivAt
    have hVN : ψ '' Vc ⊆ N := himg ▸ inter_subset_right
    by_cases ha : a = 0
    · -- `a = 0`: the constant curve `ψ(v)` has velocity `0 = Dψ(v) 0`
      subst ha
      refine ⟨fun _ => ψ v, contDiffOn_const, fun _ _ => hVN (mem_image_of_mem ψ hv), rfl, ?_⟩
      simpa using hasDerivAt_const (0 : ℝ) (ψ v)
    · obtain ⟨ρ₀, hρ₀, hball⟩ := Metric.isOpen_iff.mp hVc v hv
      have ha' : 0 < ‖a‖ := norm_pos_iff.mpr ha
      set c : ℝ := ρ₀ / ‖a‖ with hc_def
      have hc : 0 < c := div_pos hρ₀ ha'
      have hden : ∀ t : ℝ, 0 < 1 + t ^ 2 / c ^ 2 := fun t => by positivity
      set h : ℝ → ℝ := fun t => t / (1 + t ^ 2 / c ^ 2) with hh_def
      -- `h` is smooth, `h'(0) = 1` and `|h| ≤ c / 2`
      have h_cd : ContDiff ℝ 1 h :=
        contDiff_id.div (contDiff_const.add ((contDiff_id.pow 2).div_const _))
          fun t => (hden t).ne'
      have h_deriv : HasDerivAt h 1 0 := by
        have := hasDerivAt_id' (x := (0 : ℝ)) |>.fun_div
          (((hasDerivAt_id' (x := (0 : ℝ))).fun_pow 2).div_const (c ^ 2) |>.const_add 1)
          (hden 0).ne'
        convert this using 1
        simp
      have h_bd : ∀ t, |h t| ≤ c / 2 := by
        intro t
        rw [hh_def, abs_div, abs_of_pos (hden t), div_le_iff₀ (hden t)]
        have h1' : c / 2 * (1 + t ^ 2 / c ^ 2) = (c ^ 2 + |t| ^ 2) / (2 * c) := by
          rw [sq_abs]; field_simp
        rw [h1', le_div_iff₀ (by positivity)]
        nlinarith [sq_nonneg (c - |t|)]
      -- `β` stays in `B_{ρ₀}(v) ⊆ Vc`, `β(0) = v` and `β'(0) = a`
      set β : ℝ → Euclid n := fun t => v + h t • a with hβ_def
      have hβV : ∀ t, β t ∈ Vc := fun t => hball <| by
        rw [Metric.mem_ball, dist_eq_norm, hβ_def]
        simp only [add_sub_cancel_left, norm_smul, Real.norm_eq_abs]
        calc |h t| * ‖a‖ ≤ c / 2 * ‖a‖ := by gcongr; exact h_bd t
          _ = ρ₀ / 2 := by rw [hc_def]; field_simp
          _ < ρ₀ := by linarith
      have hβ0 : β 0 = v := by simp [hβ_def, hh_def]
      have hβ_cd : ContDiff ℝ 1 β := contDiff_const.add (h_cd.smul contDiff_const)
      have hβ_deriv : HasDerivAt β a 0 := by
        have := HasDerivAt.const_add v (h_deriv.smul_const a)
        rwa [one_smul] at this
      -- `γ = ψ ∘ β` is `C¹` on `(-1, 1)`, lies in `ψ(Vc) ⊆ N`, and `γ'(0) = Dψ(v) a`
      refine ⟨ψ ∘ β, hψ1.comp hβ_cd.contDiffOn fun t _ => hβV t,
        fun t _ => hVN (mem_image_of_mem ψ (hβV t)), by simp [hβ0], ?_⟩
      exact hψv.comp_hasDerivAt_of_eq 0 hβ_deriv hβ0.symm
  -- (e) localize: `N ∪ Oᶜ` carries `Hⁿ`-almost all of `S` and is flat at `ψ v` along
  -- `Dψ(v)(ℝⁿ)`, since `B_s(ψ v) ⊆ O`; so `Q ≤ Dψ(v)(ℝⁿ) ≤ span T_{ψ v}N`
  obtain ⟨s, hs, hsO⟩ := Metric.isOpen_iff.mp hO (ψ v) hx2.2
  have hQT : Q ≤ LinearMap.range (fderiv ℝ ψ v : Euclid n →ₗ[ℝ] Euclid P) := by
    apply hle (N ∪ Oᶜ)
    · refine measure_mono_null (fun y hy => ?_) hnull
      simp only [Set.mem_sdiff, mem_union, mem_compl_iff, not_or, not_not] at hy
      exact ⟨⟨hy.1, hy.2.2⟩, hy.2.1⟩
    · intro ε hε
      obtain ⟨ρ, hρ, hρN⟩ := hflatN ε hε
      refine ⟨min ρ s, lt_min hρ hs, fun z hz hzd => ?_⟩
      have hzN : z ∈ N := by
        rcases hz with hz | hz
        · exact hz
        · exact absurd (hsO (mem_ball.2 (hzd.trans_le (min_le_right _ _)))) hz
      obtain ⟨h, hh⟩ := hρN z hzN (hzd.trans_le (min_le_left _ _))
      exact ⟨_, LinearMap.mem_range_self _ h, hh⟩
  have hTspan : LinearMap.range (fderiv ℝ ψ v : Euclid n →ₗ[ℝ] Euclid P) ≤
      Submodule.span ℝ (tangentSpace N (ψ v)) := by
    intro y hy
    obtain ⟨a, rfl⟩ := LinearMap.mem_range.mp hy
    exact Submodule.subset_span (hrange a)
  -- (f) `dim Q = n = dim span T_{ψ v}N` (sibling `tangent_space_dim`), so `Q = span T_{ψ v}N`
  rw [hAQ]
  exact Submodule.eq_of_le_of_finrank_eq (hQT.trans hTspan)
    (by rw [hQ.1, (Submission.idtp_ccd_sfv_span_tangentSpace_finrank P n N (ψ v) hN hxN).2])

/-- **First variation of a constant-density sheet** (Simon Ch. 4, 2.2–2.3, for the varifold
`v(M, θ)`; step 6(b) and the first equality of step 9 of the parent proof).  Let `T = τ(S, θ, ξ)`
in the open set `U`, `B = B_ρ(p) ⊆ U`, `k ≥ 1`, `M` an embedded `C¹` `n`-submanifold with
`spt T ∩ B = M ∩ B`, and `Θⁿ(μ_T, y) = k` at every `y ∈ spt T ∩ B`.  Then every `C¹` field `X`
with compact support in `B` has `δV(X) = k ∫_{M ∩ B} tr(p_{TₓM} ∘ DX(x)) dHⁿ(x)`.
* `(S ∩ B) ∖ M` is `Hⁿ`-null.  Its points lie off `spt T`, hence in the open zero region of `T`.
  A ball `B_r(x)` there misses `spt T`, so `idtp_ccd_sfv_mult_ae_eq_density` with density `0`
  gives `θ = 0` a.e. on `S ∩ B_r(x)`; as `θ ≥ 1` on `S`, `Hⁿ(S ∩ B_r(x)) = 0`.
* `(M ∩ B) ∖ S = (spt T ∩ B) ∖ S` is `Hⁿ`-null (`idtp_ccd_sfv_support_sdiff_carrier_null`).
* `θ = k` (`idtp_ccd_sfv_mult_ae_eq_density`) and `TₓS = span TₓM`
  (`idtp_ccd_sfv_approxTangentPlane_eq_span_ae`) hold `Hⁿ`-a.e. on `S ∩ B`.
* `DX = 0` off `spt X ⊆ B`, so `δV(X) = ∫_{S ∩ B} θ div_S X dHⁿ = k ∫_{S ∩ B} tr(p_{TₓM} DX) dHⁿ`,
  and `S ∩ B = M ∩ B` up to an `Hⁿ`-null set. -/
theorem Submission.idtp_ccd_sheet_first_variation : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n) (M : Set (Euclid P)) (p : Euclid P) (ρ : ℝ) (k : ℕ), IsOpen U → R.Represents T → ball p ρ ⊆ U → 1 ≤ k → IsEmbeddedSubmanifold 1 n M → T.support ∩ ball p ρ = M ∩ ball p ρ → (∀ y ∈ T.support, y ∈ ball p ρ → HasMassDensity T y k) → ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball p ρ → R.firstVariation X = (k : ℝ) * ∫ x in M ∩ ball p ρ, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[n] := by
  intro P n U T R M p ρ k hU hRT hBU hk hM hsupp hdens X _ _ hXB
  have hS : MeasurableSet R.carrier := R.measurableSet_carrier
  -- Step 2: `(S ∩ B) \ M` is `Hⁿ`-null.  Its points lie off `spt T`, so in the open zero region
  -- of `T`.  A ball `B_r(x)` there misses `spt T`, so `idtp_ccd_sfv_mult_ae_eq_density` applies
  -- vacuously with `k = 0`: `θ = 0` a.e. on `S ∩ B_r(x)`, and `θ ≥ 1` on `S` makes this null.
  have hSM : μHE[n] ((R.carrier ∩ ball p ρ) \ M) = 0 := by
    refine measure_null_of_locally_null _ fun x hx => ?_
    have hxz : x ∈ T.zeroRegion := by
      by_contra hxz
      have hxT : x ∈ T.support ∩ ball p ρ :=
        ⟨mem_sdiff_of_mem (R.carrier_subset hx.1.1) hxz, hx.1.2⟩
      rw [hsupp] at hxT
      exact hx.2 hxT.1
    obtain ⟨r, hr, hrz⟩ := Metric.isOpen_iff.1 T.isOpen_zeroRegion x hxz
    have h0 := (Submission.idtp_ccd_sfv_mult_ae_eq_density P n U T R x r 0 hU hRT
      fun y hy hyr => absurd (hrz hyr) hy.2).2
    have hfalse : ∀ᵐ y ∂(μHE[n].restrict (R.carrier ∩ ball x r)), False := by
      filter_upwards [h0, ae_restrict_mem (hS.inter isOpen_ball.measurableSet)] with y hy hyS
      exact (R.mult_pos y hyS.1).ne' hy
    have hnull : μHE[n] (R.carrier ∩ ball x r) = 0 :=
      Measure.restrict_eq_zero.1 (ae_eq_bot.1 (eventually_false_iff_eq_bot.1 hfalse))
    refine ⟨((R.carrier ∩ ball p ρ) \ M) ∩ ball x r,
      inter_mem_nhdsWithin _ (isOpen_ball.mem_nhds (mem_ball_self hr)),
      measure_mono_null (fun y hy => ?_) hnull⟩
    exact ⟨hy.1.1.1, hy.2⟩
  -- Step 4: `(M ∩ B) \ S` is `Hⁿ`-null, as `spt T ∩ B = M ∩ B`; so `S ∩ B = M ∩ B` a.e.
  have hMS : μHE[n] ((M ∩ ball p ρ) \ R.carrier) = 0 := by
    rw [← hsupp]
    exact Submission.idtp_ccd_sfv_support_sdiff_carrier_null P n U T R p ρ k hU hRT hBU hk hdens
  have hSMae : R.carrier ∩ ball p ρ =ᵐ[μHE[n]] M ∩ ball p ρ := by
    refine ae_eq_set.2 ⟨measure_mono_null (fun y hy => ?_) hSM,
      measure_mono_null (fun y hy => ?_) hMS⟩
    · exact ⟨hy.1, fun hyM => hy.2 ⟨hyM, hy.1.2⟩⟩
    · exact ⟨hy.1, fun hyS => hy.2 ⟨hyS, hy.1.2⟩⟩
  -- Steps 3 and 5: `θ = k` and `TₓS = span TₓM` for `Hⁿ`-a.e. `x ∈ S ∩ B`.
  have hθ := (Submission.idtp_ccd_sfv_mult_ae_eq_density P n U T R p ρ k hU hRT hdens).2
  have hT := Submission.idtp_ccd_sfv_approxTangentPlane_eq_span_ae P n U R M (ball p ρ) hM
    isOpen_ball hSM
  -- Step 6: the integrand vanishes off `tsupport X ⊆ B`.
  have hS0 : ∀ x ∈ R.carrier \ (R.carrier ∩ ball p ρ),
      (R.mult x : ℝ) * tangentialDivergence n R.carrier X x = 0 := by
    intro x hx
    have hxX : x ∉ tsupport X := fun h => hx.2 ⟨hx.1, hXB h⟩
    simp [tangentialDivergence, fderiv_of_notMem_tsupport ℝ hxX]
  -- Step 7: evaluation.
  calc R.firstVariation X
      = ∫ x in R.carrier ∩ ball p ρ, (R.mult x : ℝ) * tangentialDivergence n R.carrier X x
          ∂μHE[n] :=
        setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hS inter_subset_left hS0
    _ = ∫ x in R.carrier ∩ ball p ρ, (k : ℝ) * LinearMap.trace ℝ (Euclid P)
          ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
            (fderiv ℝ X x).toLinearMap) ∂μHE[n] := by
        refine integral_congr_ae ?_
        filter_upwards [hT, hθ] with x hxT hxθ
        simp only [tangentialDivergence, hxT, hxθ]
    _ = (k : ℝ) * ∫ x in R.carrier ∩ ball p ρ, LinearMap.trace ℝ (Euclid P)
          ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
            (fderiv ℝ X x).toLinearMap) ∂μHE[n] :=
        integral_const_mul _ _
    _ = _ := by rw [setIntegral_congr_set hSMae]
/-- **Dilation invariance of the support of a cone** (preliminary (K) of the proof that a cone of
constant density is planar).  If `C ∈ 𝒟ₙ(ℝᴾ)` is a cone and `t > 0`, then `t x ∈ spt C` for every
`x ∈ spt C`.  By contraposition: if `t x` lies in an open `W` with compact closure on which `C`
vanishes, then `x` lies in `W' = {y : t y ∈ W}`, which is open with closure inside the compact set
`t⁻¹ W̄`, and `C` vanishes on `W'`: for `spt ω ⊆ W'` the cone identity gives
`C(ω) = η_{0,t#}C(ω) = C(η_{0,t}^# ω)`, and `spt η_{0,t}^# ω ⊆ {z : t⁻¹ z ∈ spt ω} ⊆ W`.  The
integer multiplicity hypothesis is not needed. -/
theorem Submission.idtp_ccd_cone_support_smul : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), IsIntegerMultiplicity C → IsConeCurrent C → ∀ t : ℝ, 0 < t → ∀ x ∈ C.support, t • x ∈ C.support := by
  intro P n C _ hC t ht x hx
  -- `spt C = ℝᴾ \ zeroRegion C`, so it suffices that `t x ∈ zeroRegion C → x ∈ zeroRegion C`
  simp only [GeometricCurrentOn.support, Set.mem_sdiff, mem_univ, true_and] at hx ⊢
  intro htx
  apply hx
  obtain ⟨W, ⟨hWo, hWc, -, hWv⟩, htxW⟩ := mem_sUnion.1 htx
  -- `x` lies in `W' = {y : t y ∈ W}`
  refine mem_sUnion.2 ⟨(fun y => t • y) ⁻¹' W, ⟨?_, ?_, subset_univ _, ?_⟩, htxW⟩
  · -- `W'` is open
    exact hWo.preimage (continuous_const_smul t)
  · -- `closure W'` is closed in the compact set `{y : t y ∈ closure W} = t⁻¹ closure W`
    have hK : IsCompact ((fun y : Euclid P => t • y) ⁻¹' closure W) := by
      rw [preimage_smul₀ ht.ne']
      exact hWc.smul _
    exact hK.of_isClosed_subset isClosed_closure
      (closure_minimal (preimage_mono subset_closure)
        (isClosed_closure.preimage (continuous_const_smul t)))
  · -- `C` vanishes on `W'`: `C(ω) = η_{0,t#}C(ω) = C(η_{0,t}^# ω)`, as `η_{0,t}(ℝᴾ) = ℝᴾ`
    intro ω hω
    rw [← hC t ht ω]
    have hdom : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
        tsupport (ω : DifferentialForm (Euclid P) n) ⊆ dilation 0 t '' univ := by
      refine ⟨ω.property.1, fun z _ => ⟨t • z, mem_univ _, ?_⟩⟩
      simp [dilation, dilationCLM, ht.ne']
    rw [currentEval, dite_eq_left hdom]
    unfold blowUp
    rw [GeometricCurrentOn.affinePushforward_apply, GeometricCurrentOn.restrictDomain_apply]
    apply hWv
    rw [testFormOnInclusion_coe, affinePullbackTestOn_coe]
    -- `z ∈ spt η_{0,t}^# ω` gives `t⁻¹ z ∈ spt ω ⊆ W'`, i.e. `z = t (t⁻¹ z) ∈ W`
    refine (tsupport_affinePullbackForm_subset _ _ _).trans fun z hz => ?_
    simpa [dilationCLM, ht.ne'] using hω hz
/-- **Area formula on the cone sheet** (step 9 of the parent proof; Simon Ch. 2, §3).  On
`R = (r₀ − s, r₀ + s) × (−s, s)` the sibling `cone_map` shows that `G(t, α) = t γ(α)` is injective
on `R` with injective derivative, `∂₁G = γ(α)` and `∂₂G = t γ′(α)`.  The sibling `prod_area` then
gives `∫_{G(R)} h dH² = ∫_R √(‖∂₁G‖² ‖∂₂G‖² − ⟨∂₁G, ∂₂G⟩²) h(G)`.  Since `‖γ‖ = 1`, `⟨γ, γ′⟩ = 0`
and `t > r₀ − s > 0`, the radicand is `(t ‖γ′(α)‖)²`, so the Jacobian is `t ‖γ′(α)‖`. -/
theorem Submission.idtp_ccd_scsp_cone_area : ∀ (P : ℕ) (r₀ s : ℝ) (γ : ℝ → Euclid P) (h : Euclid P → ℝ), 0 < s → s < r₀ → ContDiffOn ℝ 1 γ (Ioo (-s) s) → InjOn γ (Ioo (-s) s) → (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ inner ℝ (γ α) (deriv γ α) = 0 ∧ deriv γ α ≠ 0) → ∫ x in (fun q : ℝ × ℝ => q.1 • γ q.2) '' (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s), h x ∂μHE[2] = ∫ q in Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s, q.1 * ‖deriv γ q.2‖ * h (q.1 • γ q.2) := by
  intro P r₀ s γ h hs hsr hγ hγinj hγ'
  obtain ⟨hinj, hreg⟩ :=
    Submission.idtp_ccd_scsp_ca_cone_map_regular P r₀ s γ hs hsr hγ hγinj hγ'
  have hR : MeasurableSet (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s) :=
    measurableSet_Ioo.prod measurableSet_Ioo
  refine (Submission.idtp_ccd_scsp_ca_prod_area_formula P (fun q : ℝ × ℝ => q.1 • γ q.2) _ h hR
    (fun z hz => (hreg z hz).1) (fun z hz => (hreg z hz).2.1) hinj).trans
    (setIntegral_congr_fun hR fun z hz => ?_)
  -- `∂₁G = γ(α)` and `∂₂G = t γ′(α)`, with `‖γ(α)‖ = 1`, `⟨γ(α), γ′(α)⟩ = 0` and `t > 0`
  obtain ⟨-, -, h10, h01⟩ := hreg z hz
  obtain ⟨hnorm, horth, -⟩ := hγ' z.2 hz.2
  have hz1 : 0 < z.1 := by linarith [hz.1.1]
  have hJ : (1 : ℝ) ^ 2 * (z.1 * ‖deriv γ z.2‖) ^ 2 - (z.1 * 0) ^ 2 =
      (z.1 * ‖deriv γ z.2‖) ^ 2 := by ring
  rw [h10, h01, hnorm, norm_smul, Real.norm_eq_abs, abs_of_pos hz1, real_inner_smul_right, horth,
    hJ, Real.sqrt_sq (mul_nonneg hz1.le (norm_nonneg _))]
/-- **Great-circle arc** (step 11 of the parent proof: Cauchy–Schwarz and Bessel, then the polar
form).  Put `x = ⟨γ, u⟩ > 0`, `y = ⟨γ, e⟩`, `q = x² + y²` and `w = x e − y u`.  The sibling
`angle_curve` gives `⟨w, γ′⟩ = x ⟨γ′, e⟩ − y ⟨γ′, u⟩ = q`, and orthonormality gives `‖w‖² = q`, so
Cauchy–Schwarz with `‖γ′‖ = q` yields `‖w‖ ≥ 1`, i.e. `q ≥ 1`.  Bessel:
`‖γ − (x u + y e)‖² = 1 − q ≥ 0`, so `q = 1` and `γ = x u + y e`.  Finally `α = arctan (y / x)`
with `x > 0` and `√(1 + (y / x)²) = 1 / x` give `cos α = x` and `sin α = y`. -/
theorem Submission.idtp_ccd_scsp_arc_planarity : ∀ (P : ℕ) (u e : Euclid P) (s : ℝ) (γ : ℝ → Euclid P), ‖u‖ = 1 → ‖e‖ = 1 → inner ℝ u e = 0 → ContDiffOn ℝ 1 γ (Ioo (-s) s) → (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ 0 < inner ℝ (γ α) u ∧ Real.arctan (inner ℝ (γ α) e / inner ℝ (γ α) u) = α) → (∀ α ∈ Ioo (-s) s, ‖deriv γ α‖ = inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2) → ∀ α ∈ Ioo (-s) s, γ α = Real.cos α • u + Real.sin α • e := by
  intro P u e s γ hu he hue hγ hcurve hspeed α hα
  obtain ⟨hnorm, hx, harc⟩ := hcurve α hα
  obtain ⟨-, hrot, -⟩ := Submission.idtp_ccd_scsp_angle_curve P u e s γ hγ hcurve α hα
  have heu : inner ℝ e u = (0 : ℝ) := by rw [real_inner_comm]; exact hue
  -- pointwise statement for `g = γ(α)`, `d = γ′(α)`, `x = ⟨g, u⟩`, `y = ⟨g, e⟩`
  suffices key : ∀ (g d : Euclid P) (x y : ℝ), ‖g‖ = 1 → inner ℝ g u = x → inner ℝ g e = y →
      0 < x → x * inner ℝ d e - y * inner ℝ d u = x ^ 2 + y ^ 2 → ‖d‖ = x ^ 2 + y ^ 2 →
      g = Real.cos (Real.arctan (y / x)) • u + Real.sin (Real.arctan (y / x)) • e by
    have h := key (γ α) (deriv γ α) _ _ hnorm rfl rfl hx hrot (hspeed α hα)
    rwa [harc] at h
  intro g d x y hg hgx hgy hx hrot hd
  have hq : 0 < x ^ 2 + y ^ 2 := by positivity
  -- `w = x e − y u` has `⟨w, d⟩ = q` (the angle identity) and `‖w‖² = q` (orthonormality)
  have hwd : inner ℝ (x • e - y • u) d = x ^ 2 + y ^ 2 := by
    rw [inner_sub_left, real_inner_smul_left, real_inner_smul_left, real_inner_comm d e,
      real_inner_comm d u]
    exact hrot
  have hw : ‖x • e - y • u‖ ^ 2 = x ^ 2 + y ^ 2 := by
    rw [norm_sub_sq_real, real_inner_smul_left, real_inner_smul_right, heu, norm_smul, norm_smul,
      he, hu, Real.norm_eq_abs, Real.norm_eq_abs, mul_one, mul_one, sq_abs, sq_abs]
    ring
  -- Cauchy–Schwarz: `q = ⟨w, d⟩ ≤ ‖w‖ ‖d‖ = ‖w‖ q`, so `‖w‖ ≥ 1` and `q = ‖w‖² ≥ 1`
  have hw1 : 1 ≤ ‖x • e - y • u‖ := by
    refine (le_mul_iff_one_le_left hq).mp ?_
    calc x ^ 2 + y ^ 2 = inner ℝ (x • e - y • u) d := hwd.symm
      _ ≤ ‖x • e - y • u‖ * ‖d‖ := real_inner_le_norm _ _
      _ = ‖x • e - y • u‖ * (x ^ 2 + y ^ 2) := by rw [hd]
  have hq1 : 1 ≤ x ^ 2 + y ^ 2 := by nlinarith
  -- Bessel: `‖g − (x u + y e)‖² = 1 − q ≥ 0`, so `q = 1` and `g = x u + y e`
  have hb : ‖g - (x • u + y • e)‖ ^ 2 = 1 - (x ^ 2 + y ^ 2) := by
    simp only [norm_sub_sq_real, norm_add_sq_real, inner_add_right, real_inner_smul_left,
      real_inner_smul_right, hue, hgx, hgy, hg, norm_smul, hu, he, Real.norm_eq_abs, mul_one,
      sq_abs]
    ring
  have hq' : x ^ 2 + y ^ 2 = 1 :=
    le_antisymm (by linarith [sq_nonneg ‖g - (x • u + y • e)‖]) hq1
  have hgxy : g = x • u + y • e := by
    rw [← sub_eq_zero, ← norm_eq_zero, ← sq_eq_zero_iff, hb, hq', sub_self]
  -- polar form: `√(1 + (y / x)²) = 1 / x`, so `arctan (y / x)` has cosine `x` and sine `y`
  have hsqrt : √(1 + (y / x) ^ 2) = 1 / x := by
    rw [show 1 + (y / x) ^ 2 = (1 / x) ^ 2 by field_simp; linarith]
    exact Real.sqrt_sq (by positivity)
  rw [Real.cos_arctan, Real.sin_arctan, hsqrt, one_div_one_div, div_div_eq_mul_div, div_one,
    div_mul_cancel₀ y hx.ne', hgxy]

/-- **Stationary cone sheets are planar** (steps 1–12 of the parent proof).  Write `p = r₀ u` with
`r₀ = ‖p‖ > 0` and `‖u‖ = 1`.  The sibling `cone_chart` gives a unit `e ⊥ u`, an open `N ∋ p`
inside `B_ρ(p)` and a unit curve `γ` with `γ(0) = u`, `γ′(0) = e`, `M ∩ N = {t γ(α) : (t, α) ∈ R}`
for `R = (r₀ − s, r₀ + s) × (−s, s)` and `T_{tγ(α)}M = span {γ(α), γ′(α)}`.  For `tsupport X ⊆ N`
the integrand vanishes off `N`, so stationarity on `M ∩ B_ρ(p)` is stationarity on `M ∩ N`, and
`cone_conservation` gives `∫ φ′ κ = 0` for `κ = (⟨γ, u⟩² + ⟨γ, e⟩²) / ‖γ′‖`, continuous because
`γ′ ≠ 0` (`angle_curve`).  By `du_bois_reymond` `κ` is constant, so `κ ≡ κ(0) = 1`, i.e.
`‖γ′‖ = ⟨γ, u⟩² + ⟨γ, e⟩²`; `arc_planarity` gives `γ(α) = cos α u + sin α e`, and `sector_plane`
gives `δ > 0` with `M ∩ B_δ(p) = span {u, e} ∩ B_δ(p)`.  Finally `span {u, e} = T_pM`, which is
`2`-dimensional and contains `p` (`tangent_plane_mem`). -/
theorem Submission.idtp_ccd_stationary_cone_sheet_planar : ∀ (P : ℕ) (M : Set (Euclid P)) (p : Euclid P) (ρ : ℝ), IsEmbeddedSubmanifold 1 2 M → p ∈ M → p ≠ 0 → 0 < ρ → (∀ x ∈ M ∩ ball p ρ, ∀ t : ℝ, 0 < t → t • x ∈ ball p ρ → t • x ∈ M) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball p ρ → ∫ x in M ∩ ball p ρ, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[2] = 0) → ∃ (δ : ℝ) (Q : Submodule ℝ (Euclid P)), 0 < δ ∧ Module.finrank ℝ Q = 2 ∧ p ∈ Q ∧ M ∩ ball p δ = (Q : Set (Euclid P)) ∩ ball p δ := by
  intro P M p ρ hM hp hp0 hρ hcone hstat
  -- polar form `p = r₀ u` with `r₀ = ‖p‖ > 0` and `‖u‖ = 1`
  obtain ⟨u, r₀, hu, hr₀, rfl⟩ : ∃ (u : Euclid P) (r₀ : ℝ), ‖u‖ = 1 ∧ 0 < r₀ ∧ r₀ • u = p :=
    ⟨‖p‖⁻¹ • p, ‖p‖,
      by rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hp0)],
      norm_pos_iff.mpr hp0, by rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hp0), one_smul]⟩
  -- the cone sheet `M ∩ N = {t γ(α)}` with `T_{tγ(α)}M = span {γ(α), γ′(α)}`
  obtain ⟨e, s, N, γ, he, hue, hs, hsr, hN, hpN, hNball, hNu, hγ, hγ0, hγ'0, hcurve, hMN, hTM⟩ :=
    Submission.idtp_ccd_scsp_cone_chart P M u r₀ ρ hM hu hr₀ hp hρ hcone
  have hr₀R : r₀ ∈ Ioo (r₀ - s) (r₀ + s) := ⟨by linarith, by linarith⟩
  have h0 : (0 : ℝ) ∈ Ioo (-s) s := ⟨by linarith, hs⟩
  have hRN : ∀ t ∈ Ioo (r₀ - s) (r₀ + s), ∀ α ∈ Ioo (-s) s, t • γ α ∈ N := by
    intro t ht α hα
    have h : t • γ α ∈ M ∩ N := by rw [hMN]; exact ⟨(t, α), ⟨ht, hα⟩, rfl⟩
    exact h.2
  -- stationarity on `M ∩ B_ρ(p)` restricts to `M ∩ N`: the integrand vanishes off `tsupport X ⊆ N`
  have hstatN : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
      tsupport X ⊆ N → ∫ x in (fun q : ℝ × ℝ => q.1 • γ q.2) '' (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s),
        LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ X x).toLinearMap) ∂μHE[2] = 0 := by
    intro X hX hXc hXN
    have hf : ∀ x, x ∉ N → LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ X x).toLinearMap) = 0 := by
      intro x hx
      rw [fderiv_of_notMem_tsupport ℝ fun h => hx (hXN h)]
      simp
    have hset : N ∩ (M ∩ ball (r₀ • u) ρ) = M ∩ N := by
      ext x
      exact ⟨fun h => ⟨h.2.1, h.1⟩, fun h => ⟨h.2, h.1, hNball h.2⟩⟩
    rw [← hMN, ← hset, ← Measure.restrict_restrict hN.measurableSet,
      setIntegral_eq_integral_of_forall_compl_eq_zero hf]
    exact hstat X hX hXc (hXN.trans hNball)
  -- conservation law `∫ φ′ κ = 0` for `κ = (⟨γ, u⟩² + ⟨γ, e⟩²) / ‖γ′‖`
  have hκ := Submission.idtp_ccd_scsp_cone_conservation P u e r₀ s N γ
    (fun x => Submodule.span ℝ (tangentSpace M x)) hu he hue hs hsr hN hNu hγ hcurve
    (fun t ht α hα => ⟨hRN t ht α hα, hTM t ht α hα⟩) hstatN
  have hγ'ne : ∀ α ∈ Ioo (-s) s, deriv γ α ≠ 0 := fun α hα =>
    (Submission.idtp_ccd_scsp_angle_curve P u e s γ hγ hcurve α hα).2.2
  have hcont : ContinuousOn
      (fun α => (inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2) / ‖deriv γ α‖) (Ioo (-s) s) := by
    have hγc := hγ.continuousOn
    refine ContinuousOn.div₀ ?_ (hγ.continuousOn_deriv_of_isOpen isOpen_Ioo le_rfl).norm
      fun α hα => norm_ne_zero_iff.mpr (hγ'ne α hα)
    exact ((hγc.inner continuousOn_const).pow 2).add ((hγc.inner continuousOn_const).pow 2)
  -- du Bois-Reymond: `κ` is constant, and `κ(0) = 1` since `γ(0) = u`, `γ′(0) = e`
  obtain ⟨c, hc⟩ := Submission.idtp_ccd_scsp_du_bois_reymond (-s) s _ hcont hκ
  have hc1 : c = 1 := by
    have h : (inner ℝ (γ 0) u ^ 2 + inner ℝ (γ 0) e ^ 2) / ‖deriv γ 0‖ = c := hc 0 h0
    rw [hγ0, hγ'0, he, real_inner_self_eq_norm_sq, hu, hue] at h
    rw [← h]
    norm_num
  have hspeed : ∀ α ∈ Ioo (-s) s, ‖deriv γ α‖ = inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2 := by
    intro α hα
    have h : (inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2) / ‖deriv γ α‖ = 1 := (hc α hα).trans hc1
    exact ((div_eq_one_iff_eq (norm_ne_zero_iff.mpr (hγ'ne α hα))).mp h).symm
  -- great-circle arc, hence the sheet is a planar sector
  have harc := Submission.idtp_ccd_scsp_arc_planarity P u e s γ hu he hue hγ hcurve hspeed
  have hMN' : M ∩ N = (fun q : ℝ × ℝ => q.1 • (Real.cos q.2 • u + Real.sin q.2 • e)) ''
      (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s) := by
    rw [hMN]
    exact Set.image_congr fun q hq => by simp only [harc q.2 hq.2]
  obtain ⟨δ, hδ, hδeq⟩ :=
    Submission.idtp_ccd_scsp_sector_plane P M N u e r₀ s hu he hue hs hsr hN hpN hMN'
  -- `span {u, e} = T_pM`, a 2-plane containing `p`
  obtain ⟨hdim, hpT⟩ := Submission.idtp_ccd_scsp_tangent_plane_mem P M (r₀ • u) ρ hM hp hρ hcone
  have hT : Submodule.span ℝ (tangentSpace M (r₀ • u)) = Submodule.span ℝ {u, e} := by
    have h := hTM r₀ hr₀R 0 h0
    rwa [hγ0, hγ'0] at h
  refine ⟨δ, Submodule.span ℝ {u, e}, hδ, ?_, ?_, hδeq⟩
  · rw [← hT]
    exact hdim
  · rw [← hT]
    exact hpT
/-- **Constancy on a plane** (Simon Ch. 6, 2.34; the planar step of 7.3.3(1)): let `T ∈ 𝒟ₙ(U)`,
`n ≥ 1`, be integer multiplicity with `∂T = 0`, let `Q` be an `n`-plane, `p ∈ Q`, `B = B_r(p) ⊆ U`
and `spt T ∩ B ⊆ Q`.  If `Θⁿ(μ_T, p) = k`, then `M_W(T) = k Hⁿ(W ∩ Q)` for every open `W ⊆ B`.
Write `T = τ(M, θ, ξ)`.  `T` vanishes on the open zero region, so `Hⁿ((M ∩ B) ∖ Q) = 0`; the
approximate tangent plane of `M` at points of `Q ∩ B` is then `Q`, so `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` for an
orthonormal basis `τ` of `Q`.  Parametrizing `Q` by the isometry `Φ v = p + L v`, this gives
`T(ω) = ∫ G(v) ⟨ω(Φ v), τ⟩ dv` on `B` with `G` integer valued and locally integrable.  Testing
`∂T = 0` on `d(f βⱼ)` shows `∫ G ∂ⱼa = 0` for smooth `a` with compact support in `B_r(0)`, and
mollification with Lebesgue differentiation gives `G = c ∈ ℤ` a.e.  Then `|⟨α, τ⟩| ≤ |α|` and a
unit covector `β` with `⟨β, τ⟩ = 1` give `M_W(T) = |c| Hⁿ(W ∩ Q)`, and the density at `p` forces
`|c| = k`. -/
theorem Submission.idtp_ccd_planar_support_mass : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (Q : Submodule ℝ (Euclid P)) (p : Euclid P) (r : ℝ) (k : ℕ), 1 ≤ n → IsOpen U → IsIntegerMultiplicity T → BoundaryVanishes T → Module.finrank ℝ Q = n → p ∈ Q → 0 < r → ball p r ⊆ U → T.support ∩ ball p r ⊆ (Q : Set (Euclid P)) → HasMassDensity T p k → ∀ W : Set (Euclid P), IsOpen W → W ⊆ ball p r → T.massOn W = (k : ℝ≥0∞) * μHE[n] (W ∩ (Q : Set (Euclid P))) := by
  intro P n U T Q p r k hn _hU hIM hbd hQ hpQ hr hBU hspt hdens W hW hWB
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨R, hR⟩ := hIM
  -- Step 1 (frame)
  let b : OrthonormalBasis (Fin (m + 1)) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)
  let τ : Fin (m + 1) → Euclid P := fun i => (b i : Euclid P)
  have hτ : Orthonormal ℝ τ := b.orthonormal.comp_linearIsometry Q.subtypeₗᵢ
  let L : Euclid (m + 1) →ₗᵢ[ℝ] Euclid P := Q.subtypeₗᵢ.comp b.repr.symm.toLinearIsometry
  have hLe : ∀ i, L (EuclideanSpace.single i 1) = τ i := fun i => by
    simp only [L, τ, LinearIsometry.coe_comp, Function.comp_apply,
      LinearIsometryEquiv.coe_toLinearIsometry, OrthonormalBasis.repr_symm_single,
      Submodule.coe_subtypeₗᵢ, Submodule.coe_subtype]
  have hLQ : ∀ v, L v ∈ Q := fun v => (b.repr.symm v).2
  have hQL : ∀ x ∈ Q, ∃ v, L v = x := fun x hx => ⟨b.repr ⟨x, hx⟩, by
    simp only [L, LinearIsometry.coe_comp, Function.comp_apply,
      LinearIsometryEquiv.coe_toLinearIsometry, LinearIsometryEquiv.symm_apply_apply,
      Submodule.coe_subtypeₗᵢ, Submodule.coe_subtype]⟩
  let Φ : Euclid (m + 1) → Euclid P := fun v => p + L v
  have hΦiso : Isometry Φ := fun v w => by
    simp only [Φ, edist_dist, dist_add_left, L.dist_map]
  have hΦrange : range Φ = (Q : Set (Euclid P)) := by
    ext x
    constructor
    · rintro ⟨v, rfl⟩
      exact Q.add_mem hpQ (hLQ v)
    · intro hx
      obtain ⟨v, hv⟩ := hQL (x - p) (Q.sub_mem hx hpQ)
      exact ⟨v, by simp only [Φ, hv, add_sub_cancel]⟩
  have hΦemb : MeasurableEmbedding Φ := hΦiso.isClosedEmbedding.measurableEmbedding
  have hmap : Measure.map Φ volume = μHE[m + 1].restrict (Q : Set (Euclid P)) := by
    rw [← hΦrange, ← hΦiso.map_euclideanHausdorffMeasure,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  have hΦball : ∀ s, Φ ⁻¹' ball p s = ball 0 s := fun s => by
    ext v
    simp only [Φ, mem_preimage, mem_ball, dist_eq_norm, add_sub_cancel_left, sub_zero,
      L.norm_map]
  -- Step 2 (covectors)
  have hcov : ∀ τ' : Fin (m + 1) → Euclid P, Orthonormal ℝ τ' →
      (∃ β : Covector (Euclid P) (m + 1), covectorEuclideanNorm β ≤ 1 ∧ β τ' = 1) ∧
      ∀ α : Covector (Euclid P) (m + 1), |α τ'| ≤ covectorEuclideanNorm α := by
    intro τ' hτ'
    -- (a) `Σ_j α(f ∘ j)² = Σ_j α(f' ∘ j)²` for orthonormal bases `f`, `f'` of `ℝᴾ`
    have hinv : ∀ (α : Covector (Euclid P) (m + 1)) (f f' : OrthonormalBasis (Fin P) ℝ (Euclid P)),
        ∑ j : Fin (m + 1) → Fin P, (α (fun k => f (j k))) ^ 2 =
          ∑ j : Fin (m + 1) → Fin P, (α (fun k => f' (j k))) ^ 2 := by
      intro α f f'
      set c : Fin P → Fin P → ℝ := fun i s => inner ℝ (f' s) (f i) with hc
      have hexp : ∀ j : Fin (m + 1) → Fin P, α (fun k => f (j k)) =
          ∑ a : Fin (m + 1) → Fin P, (∏ k, c (j k) (a k)) * α (fun k => f' (a k)) := by
        intro j
        have hb : (fun k => f (j k)) = fun k => ∑ s, c (j k) s • f' s :=
          funext fun k => (f'.sum_repr' (f (j k))).symm
        rw [hb, α.map_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [← smul_eq_mul, ← α.map_smul_univ]
      have hdelta : ∀ s t : Fin P, ∑ i, c i s * c i t = if s = t then 1 else 0 := by
        intro s t
        have h1 : ∑ i, c i s * c i t = inner ℝ (f' s) (f' t) := by
          rw [← f.sum_inner_mul_inner (f' s) (f' t)]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [hc, real_inner_comm (f' t) (f i)]
        rw [h1]
        exact (orthonormal_iff_ite.mp f'.orthonormal) s t
      have hT : ∀ a a' : Fin (m + 1) → Fin P,
          ∑ j : Fin (m + 1) → Fin P, ∏ k, (c (j k) (a k) * c (j k) (a' k)) =
            if a = a' then 1 else 0 := by
        intro a a'
        rw [← Fintype.prod_sum (fun k i => c i (a k) * c i (a' k))]
        simp_rw [hdelta]
        split_ifs with h
        · subst h
          simp
        · obtain ⟨k, hk⟩ := Function.ne_iff.mp h
          exact Finset.prod_eq_zero (Finset.mem_univ k) (ite_eq_right hk)
      calc ∑ j : Fin (m + 1) → Fin P, (α (fun k => f (j k))) ^ 2
          = ∑ j : Fin (m + 1) → Fin P, ∑ a : Fin (m + 1) → Fin P, ∑ a' : Fin (m + 1) → Fin P,
              (α (fun k => f' (a k)) * α (fun k => f' (a' k))) *
                ∏ k, (c (j k) (a k) * c (j k) (a' k)) := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [hexp j, sq, Finset.sum_mul_sum]
            refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun a' _ => ?_
            rw [Finset.prod_mul_distrib]
            ring
        _ = ∑ a : Fin (m + 1) → Fin P, ∑ a' : Fin (m + 1) → Fin P,
              (α (fun k => f' (a k)) * α (fun k => f' (a' k))) *
                ∑ j : Fin (m + 1) → Fin P, ∏ k, (c (j k) (a k) * c (j k) (a' k)) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun a _ => ?_
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun a' _ => ?_
            rw [Finset.mul_sum]
