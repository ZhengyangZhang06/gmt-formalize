  have hbdW : ∀ j, (O j - O (j + 1)).boundary = D j - (Z (j + 1) - Z j) := fun j =>
    GeometricCurrentOn.ext fun η => by
      rw [hD, hZ, hZ]
      simp only [sk_sub_apply, GeometricCurrentOn.boundary_apply]
