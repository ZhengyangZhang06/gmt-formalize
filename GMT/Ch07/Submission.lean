    have hkP : k ≤ P := by
      simpa only [Fintype.card_fin] using Fintype.card_le_of_injective ι hι
    -- step 8: `|Φ(y) - Φ(y')| = |y - y'| = √(Σₘ |yₘ - y'ₘ|²) ≤ √k ≤ √P`
    rw [hiso, EuclideanSpace.dist_eq]
    refine Real.sqrt_le_sqrt ?_
