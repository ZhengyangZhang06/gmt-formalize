    have hpre : MeasurableSet (Y.domRestrict ψ ⁻¹' u) := hemb.measurable hu
    have hset : Subtype.val '' (Y.domRestrict ψ ⁻¹' u) = Y ∩ ψ ⁻¹' u :=
