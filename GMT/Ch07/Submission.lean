      ⟨(closedBall_subset_closedBall ht.le).trans
        (closedBall_subset_cthickening (mem_image_of_mem Φ hy) η), by
        rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs]
