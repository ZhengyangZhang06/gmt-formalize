theorem Submission.dmcbrld_exists_small_filling_of_low_density : (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P m : ℕ), ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∀ x₁ : Euclid P, liminf (fun r : ℝ => μ (ball x₁ r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0) < ENNReal.ofReal η₀ → ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ μ (sphere x₁ ρ) = 0 ∧ ∃ (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in ball x₁ ρ, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) ∧ S.boundary = A.boundary ∧ S.mass ≤ ENNReal.ofReal (1 / 2) * μ (ball x₁ ρ) ∧ S.support ⊆ closedBall x₁ ((1 + 3 * Real.sqrt P) * δ) := by
  intro hSL hMR hISO P d
  -- Steps 1, 4 and 5: the choice of `a` (with `η₀ωₙ = aⁿ`) and the filling of the sphere slice
  suffices H : ∃ a : ℝ, 0 < a ∧ ∀ (x₁ : Euclid P) (δ s ρ F : ℝ)
      (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), 0 < s → ρ < s → s < δ → 0 ≤ F →
      F ≤ (a * s) ^ (d + 1) → IsIntegerMultiplicity A.boundary →
      A.boundary.support ⊆ sphere x₁ ρ →
      A.boundary.mass ≤ ENNReal.ofReal (2 * ((d + 1 : ℕ) : ℝ) * a *
        F ^ ((((d + 1 : ℕ) : ℝ) - 1) / ((d + 1 : ℕ) : ℝ))) →
      ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1), S.boundary = A.boundary ∧
        S.mass ≤ ENNReal.ofReal (F / 2) ∧ S.support ⊆ closedBall x₁ ((1 + 3 * Real.sqrt P) * δ) by
    obtain ⟨a, ha, H⟩ := H
    -- Step 0: `ωₙ = Lⁿ(B₁(0))` is positive (Haar measure of a nonempty open set) and finite
    have hω₀ : unitBallVolume (d + 1) ≠ 0 :=
      (measure_ball_pos volume (0 : Euclid (d + 1)) one_pos).ne'
    have hωt : unitBallVolume (d + 1) ≠ ∞ := measure_ball_lt_top.ne
    have hw : 0 < (unitBallVolume (d + 1)).toReal := ENNReal.toReal_pos hω₀ hωt
    -- Step 1: `η₀ = aⁿ/ωₙ`
    have hη₀ : 0 < a ^ (d + 1) / (unitBallVolume (d + 1)).toReal := div_pos (pow_pos ha _) hw
    refine ⟨a ^ (d + 1) / (unitBallVolume (d + 1)).toReal, hη₀, ?_⟩
    intro C μ ξ hCb hμ hξm hξb hC hISP x₁ hlim δ hδ
    -- Step 2: the ratio is frequently below `η₀` along `r ↓ 0`, and eventually `r ∈ (0, δ)`
    obtain ⟨s, hs, hs₀, hsδ⟩ := ((frequently_lt_of_liminf_lt (by isBoundedDefault) hlim).and_eventually
      (Ioo_mem_nhdsGT hδ)).exists
    -- clearing the nonzero, finite denominator `ωₙsⁿ`: `μ(B_s(x₁)) < η₀ωₙsⁿ = (as)ⁿ`
    rw [ENNReal.div_lt_iff (Or.inl (mul_ne_zero hω₀ (ENNReal.ofReal_pos.2 (pow_pos hs₀ _)).ne'))
      (Or.inl (ENNReal.mul_ne_top hωt ENNReal.ofReal_ne_top))] at hs
    have hμs : μ (ball x₁ s) < ENNReal.ofReal ((a * s) ^ (d + 1)) := by
      have e : (a * s) ^ (d + 1) = a ^ (d + 1) / (unitBallVolume (d + 1)).toReal *
          (unitBallVolume (d + 1)).toReal * s ^ (d + 1) := by
        rw [div_mul_cancel₀ _ hw.ne', mul_pow]
      rwa [e, ENNReal.ofReal_mul (mul_nonneg hη₀.le ENNReal.toReal_nonneg),
        ENNReal.ofReal_mul hη₀.le, ENNReal.ofReal_toReal hωt, mul_assoc]
    -- Step 3: the null set `N` of the slices, a good radius `ρ ∈ (0, s) \ N`, `A = C⌞B_ρ(x₁)`
    obtain ⟨N, hN, hslice⟩ :=
      Submission.cbrld_sphere_slice_isIntegerMultiplicity hSL P d C μ ξ x₁ hCb hμ hξm hξb hC hISP
    obtain ⟨ρ, hρ, hρs, hρN, hsph, hlimρ⟩ :=
      Submission.dmcbrld_exists_good_slice_radius P (d + 1) μ x₁ a s N hμ (by omega) ha hs₀ hμs hN
    obtain ⟨A, hA, hAim, hAspt, hAmass⟩ := hslice ρ hρ hρN
    -- `F = μ(B_ρ(x₁)) ≤ μ(B_s(x₁)) < (as)ⁿ`
    have hμρ : μ (ball x₁ ρ) ≤ μ (ball x₁ s) := measure_mono (ball_subset_ball hρs.le)
    have hμρ_ne : μ (ball x₁ ρ) ≠ ∞ := (hμρ.trans_lt (hμs.trans ENNReal.ofReal_lt_top)).ne
    have hF : (μ (ball x₁ ρ)).toReal ≤ (a * s) ^ (d + 1) :=
      ENNReal.toReal_le_of_le_ofReal (by positivity) (hμρ.trans hμs.le)
    obtain ⟨S, hSb, hSmass, hSspt⟩ := H x₁ δ s ρ (μ (ball x₁ ρ)).toReal A hs₀ hρs hsδ
      ENNReal.toReal_nonneg hF hAim hAspt (hAmass.trans hlimρ)
    -- Step 6: `0 < ρ < s < δ` and `M(S) ≤ F/2 = ½ μ(B_ρ(x₁))`
    refine ⟨ρ, hρ, hρs.trans hsδ, hsph, A, S, hA, hSb, ?_, hSspt⟩
    calc S.mass ≤ ENNReal.ofReal ((μ (ball x₁ ρ)).toReal / 2) := hSmass
      _ = ENNReal.ofReal (1 / 2) * μ (ball x₁ ρ) := by
        rw [show (μ (ball x₁ ρ)).toReal / 2 = 1 / 2 * (μ (ball x₁ ρ)).toReal by ring,
          ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 1 / 2), ENNReal.ofReal_toReal hμρ_ne]
  cases d with
  | zero =>
    -- Step 4 (`n = 1`, `a = 1/4`): `M(∂A) ≤ 2a = 1/2 < 1`, so `∂A = 0` and `S = 0`
    refine ⟨1 / 4, by norm_num, fun x₁ δ s ρ F A _ _ _ _ _ hAim _ hAmass => ?_⟩
    have hZ : A.boundary = 0 := by
      refine Submission.cbrld_im_degree_zero_eq_zero_of_mass_lt_one hMR P _ hAim
        (hAmass.trans_lt ?_)
      rw [ENNReal.ofReal_lt_one]
      norm_num
    refine ⟨0, ?_, ?_, ?_⟩
    · rw [hZ]
      exact GeometricCurrentOn.ext fun ω => rfl
    · -- every value of the zero current is `0`
      refine sSup_le ?_
      rintro _ ⟨ω, -, rfl⟩
      simp
    · -- the zero current vanishes on every ball `B₁(y)`
      intro y hy
      exfalso
      apply hy.2
      exact Set.mem_sUnion_of_mem (mem_ball_self one_pos) ⟨isOpen_ball,
