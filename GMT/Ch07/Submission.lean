  -- passing to the limit in `∫_B ⟨f, ζₙ⟩` and `∫_B ⟨f, ∂ⱼζₙ⟩`
  have hlimψ : ∀ f : Euclid m → Euclid k, MemLp f 2 μ → Tendsto
