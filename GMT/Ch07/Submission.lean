  have hZlam : ∀ i, ENNReal.ofReal ((1 + Real.sqrt P) *
      (2 * (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32))) ^ m) * lam i =
      CZ * ENNReal.ofReal ((1 / 2 : ℝ) ^ i) := by
    intro i
    have hq : 0 ≤ (1 + Real.sqrt P) * (2 * (c₅ / ((1 / 2 : ℝ) ^ (i + 1) / 32))) ^ m :=
