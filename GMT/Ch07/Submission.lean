      _ = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ := hνξ ω
  clear hLT hLb hL hνξ hν hloc hfin
  refine ⟨μ, ξ, hUc, hμK, fun W hW => le_antisymm ?_ ?_, hξm, hξ1, hT⟩
  · -- Step 6, `M_W(T) ≤ μ(W)`: `T(ω) ≤ ∫⁻ ‖ξ(ω)‖ₑ dμ ≤ μ(spt ω) ≤ μ(W)` for admissible `ω`
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
