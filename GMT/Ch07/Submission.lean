    have hχcs := hcs χ (cthickening δ (tsupport g)) (IsCompact.cthickening hgc) hχK
    obtain ⟨M, hM⟩ := hg.continuous.bounded_above_of_compact_support hgc
    have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
