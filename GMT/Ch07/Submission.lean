      exact hz
    rw [Measure.prod_apply_symm hE'm] at hprod
    have h0 := (lintegral_eq_zero_iff (measurable_measure_prodMk_right hE'm)).1 hprod
    filter_upwards [h0] with s hs
    rw [ae_iff]
    exact hs
  /- ### The base slice `t₀` -/
