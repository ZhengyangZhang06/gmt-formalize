        ∂(R (φ (ψ j))).measure := by
    intro j ω
    rw [hR'rep j ω]
    exact ((Submission.lcmp_imRep_measure_restrict P (d + 1) U (R (φ (ψ j)))).2.2 (ball x₀ r)
      (R' j) hball_meas (hR'car j) (hR'mult j) (hR'or j)).2 _
  have hSA : ∀ j, S j = A (ψ j) r := by
    intro j
    ext ω
    rw [hSval j ω, hA (ψ j) r ω]
    rfl
  -- (a) `S_j` is carried by `B̄_r(x₀)`; (b) it kills forms supported off `B̄_r(x₀)`
  have hcarr : ∀ j, (R' j).carrier ⊆ closedBall x₀ r := by
    intro j
    rw [hR'car j]
    exact inter_subset_right.trans ball_subset_closedBall
  have hvan : ∀ (j : ℕ) (ω : TestFormOn U (d + 1)),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (d + 1))) (closedBall x₀ r) →
        S j ω = 0 := by
    intro j ω hdisj
    rw [hSval j ω]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    have hx' : x ∉ tsupport (ω : DifferentialForm (Euclid P) (d + 1)) :=
      fun h => hdisj.ne_of_mem h (ball_subset_closedBall hx) rfl
    rw [image_eq_zero_of_notMem_tsupport hx', map_zero]
  -- (c) `M(S_j) ≤ μ_{φψ(j)}(B_r(x₀)) ≤ M_G(T_{φψ(j)}) ≤ Λ`
  have hSmass : ∀ j, (S j).mass ≤ Λ := by
    intro j
    calc (S j).mass ≤ (R (φ (ψ j))).measure (ball x₀ r) :=
          hMSI (d + 1) (ball x₀ r) (S j) (R (φ (ψ j))).measure (R (φ (ψ j))).orient
            (hRbd _) (hSval j)
      _ ≤ (R (φ (ψ j))).measure G := measure_mono (ball_subset_ball hrr₀.le)
      _ = (Ts (φ (ψ j))).massOn G := (hRW _ G hGo).symm
      _ ≤ Λ := hTjG _
  -- (d) `∂S_j = Z + (∂T_{φψ(j)})⌞B_r(x₀)` with `Z = Z_{ψ(j)}(r)` vanishing off `∂B_r(x₀) ⊆ G`,
  -- so `M(∂S_j) ≤ M_G(Z) + μ'_{φψ(j)}(B_r(x₀)) ≤ C + Λ`
  have hsphG : sphere x₀ r ⊆ G := sphere_subset_ball hrr₀
  have hbmass : ∀ j, (S j).boundary.mass ≤ (C : ℝ≥0∞) + Λ := by
    intro j
    set Zd := (A (ψ j) r).boundary - B (ψ j) r
    have hZdvan : ∀ η : TestFormOn U d,
        Disjoint (tsupport (η : DifferentialForm (Euclid P) d)) (sphere x₀ r) → Zd η = 0 := by
      intro η hη
      change (A (ψ j) r).boundary η - B (ψ j) r η = 0
      rw [hAB (ψ j) r η hη, sub_self]
    have hZd : Zd.mass ≤ (C : ℝ≥0∞) :=
      calc Zd.mass = Zd.massOn U := rfl
        _ ≤ Zd.massOn G := Submission.lcmp_massOn_le_of_vanish_off_compact P d U G
            (sphere x₀ r) Zd (isCompact_sphere x₀ r) hGo hsphG hZdvan U
        _ = z (ψ j) r := rfl
        _ ≤ (C : ℝ≥0∞) := (hψC j).le
    have hBm : (B (ψ j) r).mass ≤ Λ :=
      calc (B (ψ j) r).mass ≤ μ' (φ (ψ j)) (ball x₀ r) :=
            hMSI d (ball x₀ r) (B (ψ j) r) (μ' (φ (ψ j))) (ξ' (φ (ψ j)))
              (Filter.Eventually.of_forall (hξ'bd _)) (hB (ψ j) r)
        _ ≤ μ' (φ (ψ j)) G := measure_mono (ball_subset_ball hrr₀.le)
        _ = (Ts (φ (ψ j))).boundary.massOn G := (hμ'W _ G hGo).symm
        _ ≤ Λ := hbTjG _
    have htri : (S j).boundary.massOn U ≤ Zd.massOn U + (B (ψ j) r).massOn U := by
      refine Submission.lcmp_massOn_le_add_of_eval_eq P d U U Zd (B (ψ j) r) (S j).boundary 1
        (by simp) fun η _ => ?_
      rw [hSA j]
      change (A (ψ j) r).boundary η = ((A (ψ j) r).boundary η - B (ψ j) r η) + 1 * B (ψ j) r η
      ring
    calc (S j).boundary.mass = (S j).boundary.massOn U := rfl
      _ ≤ Zd.massOn U + (B (ψ j) r).massOn U := htri
      _ = Zd.mass + (B (ψ j) r).mass := rfl
      _ ≤ (C : ℝ≥0∞) + Λ := add_le_add hZd hBm
  -- (e) `supⱼ (M(S_j) + M(∂S_j)) ≤ Λ + (C + Λ) < ∞`
  have hsup : ⨆ j, ((S j).mass + (S j).boundary.mass) < ∞ := by
    refine lt_of_le_of_lt (iSup_le fun j => add_le_add (hSmass j) (hbmass j)) ?_
    exact ENNReal.add_lt_top.2 ⟨hΛ, ENNReal.add_lt_top.2 ⟨ENNReal.coe_lt_top, hΛ⟩⟩
  -- step 10: (T2) along `φ ∘ ψ`, with `μ(∂B_r(x₀)) = 0`, gives `S_j ⇀ A_T(r) = T⌞{f < r}`
  have hconv' : WeaklyConvergesOn (fun j => Ts (φ (ψ j))) T :=
    fun ω => (hconv ω).comp ((hφ.comp hψ).tendsto_atTop)
  have hlimsup' : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      limsup (fun j => (R (φ (ψ j))).measure K) atTop ≤ μ K := by
    intro K hK hKU
    refine le_trans ?_ (hμlimsup K hK hKU)
    have h1 : limsup (fun j => (R (φ (ψ j))).measure K) atTop =
        limsup (fun j => (R (φ j)).measure K) (map ψ atTop) :=
      limsup_comp (fun j => (R (φ j)).measure K) ψ atTop
    rw [h1]
    exact limsup_le_limsup_of_le hψ.tendsto_atTop (by isBoundedDefault) (by isBoundedDefault)
  have hSconv : WeaklyConvergesOn S (AT r) := by
    intro ω
    have h := hT2 P (d + 1) U (fun j => Ts (φ (ψ j))) T (fun j => (R (φ (ψ j))).measure)
      (fun j => (R (φ (ψ j))).orient) μT μ ξT f r hU hf_cont hconv' (fun j => hRK _)
      (fun j => hRmeas _) (fun j => hRbd _) (fun j => hRrep _) hμTK hξTmeas
      (Filter.Eventually.of_forall hξTbd) hξTrep hμK hlimsup' hsph ω
    rw [hAT r ω]
    convert h using 2 with j
    exact hSval j ω
  -- step 11: `A_T(r)(ω) = T(ω)` for `spt ω ⊆ B_r(x₀) = {f < r}`
  have hagree : ∀ ω : TestFormOn U (d + 1),
      tsupport (ω : DifferentialForm (Euclid P) (d + 1)) ⊆ ball x₀ r → AT r ω = T ω := by
    intro ω hω
    rw [hAT r ω, hξTrep ω]
    refine setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_
    have hx' : x ∉ tsupport (ω : DifferentialForm (Euclid P) (d + 1)) := fun h => hx (hω h)
    rw [image_eq_zero_of_notMem_tsupport hx', map_zero]
  exact ⟨r, S, R', AT r, hr0, (closedBall_subset_closedBall hrr₀.le).trans hcb₀,
    fun j => ⟨hR'rep j, hcarr j⟩, hvan, hsup, hSconv, hagree⟩
/-- **Outer bound on a compact set** (Simon 7.2.4, proof: (F4) and step 8).  Let `U ⊆ ℝᴾ` be
open, `E ⊆ U` compact, `ν(K) < ∞` for compact `K ⊆ U`, and `μ(G) ≤ ν(G) + c` for every open
`G ⊇ E` with `G ⊂⊂ U`.  Then `μ(E) ≤ ν(E) + c`.  Choose `δ > 0` with `{dist(·, E) ≤ δ} ⊆ U`; the
open thickenings `G_k = {dist(·, E) < δ/(k + 2)}` contain `E`, are compactly contained in `U` and
decrease to `closure E = E`, and `ν(G₀) < ∞`, so `ν(G_k) → ν(E)` by continuity from above and
`μ(E) ≤ μ(G_k) ≤ ν(G_k) + c` passes to the limit. -/
theorem Submission.lcmp_measure_le_add_of_open_nhds : ∀ (P : ℕ) (U E : Set (Euclid P)) (μ ν : Measure (Euclid P)) (c : ℝ≥0∞), IsOpen U → IsCompact E → E ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ν K < ∞) → (∀ G : Set (Euclid P), IsOpen G → E ⊆ G → CompactlyContained G U → μ G ≤ ν G + c) → μ E ≤ ν E + c := by
  intro P U E μ ν c hU hE hEU hν hG
  -- Step 1: `cthickening δ E ⊆ U`; the radii `r k = δ/(k + 2) ∈ (0, δ]` decrease
  obtain ⟨δ, hδ, hδU⟩ := hE.exists_cthickening_subset_open hU hEU
  set r : ℕ → ℝ := fun k => δ / ((k : ℝ) + 2) with hr
  have hrpos : ∀ k, 0 < r k := fun k => div_pos hδ (by positivity)
  have hrle : ∀ k, r k ≤ δ := fun k =>
    div_le_self hδ.le (by have : (0 : ℝ) ≤ k := Nat.cast_nonneg k; linarith)
  have hranti : Antitone r := fun a b hab =>
    div_le_div_of_nonneg_left hδ.le (by positivity) (by
      have : (a : ℝ) ≤ b := Nat.cast_le.2 hab
      linarith)
  -- Step 2: `G k = thickening (r k) E` is open, contains `E`, and has compact closure
  -- `⊆ cthickening δ E ⊆ U`; so `μ(E) ≤ μ(G k) ≤ ν(G k) + c`
  set G : ℕ → Set (Euclid P) := fun k => thickening (r k) E
  have hGo : ∀ k, IsOpen (G k) := fun k => isOpen_thickening
  have hEG : ∀ k, E ⊆ G k := fun k => self_subset_thickening (hrpos k) E
  have hclG : ∀ k, closure (G k) ⊆ cthickening δ E := fun k =>
    (closure_thickening_subset_cthickening _ _).trans (cthickening_mono (hrle k) E)
  have hGcc : ∀ k, CompactlyContained (G k) U := fun k =>
    ⟨hE.cthickening.of_isClosed_subset isClosed_closure (hclG k), (hclG k).trans hδU⟩
  have hle : ∀ k, μ E ≤ ν (G k) + c := fun k =>
    (measure_mono (hEG k)).trans (hG _ (hGo k) (hEG k) (hGcc k))
  -- Step 3: `G k` decreases to `closure E = E`, and `ν(G 0) ≤ ν(cthickening δ E) < ∞`
  have hanti : Antitone G := fun a b hab => thickening_mono (hranti hab) E
  have hinter : ⋂ k, G k = E := by
    apply subset_antisymm
    · intro x hx
      rw [mem_iInter] at hx
      have hxcl : x ∈ closure E := by
        rw [closure_eq_iInter_thickening]
        simp only [mem_iInter]
        intro ε hε
        obtain ⟨k, hk⟩ := exists_nat_gt (δ / ε)
        have hrk : r k < ε := by
          rw [hr, div_lt_iff₀ (by positivity)]
          rw [div_lt_iff₀ hε] at hk
          nlinarith
        exact thickening_mono hrk.le E (hx k)
      rwa [hE.isClosed.closure_eq] at hxcl
    · exact subset_iInter hEG
  have hfin0 : ν (G 0) ≠ ∞ :=
    ((measure_mono ((subset_closure).trans (hclG 0))).trans_lt
      (hν _ hE.cthickening hδU)).ne
  -- Step 4: continuity from above gives `ν(G k) + c → ν(E) + c`; pass to the limit
  have htend : Tendsto (fun k => ν (G k)) atTop (𝓝 (ν E)) := by
    have := tendsto_measure_iInter_atTop (μ := ν)
      (fun k => (hGo k).measurableSet.nullMeasurableSet) hanti ⟨0, hfin0⟩
    rwa [hinter] at this
  exact ge_of_tendsto' (htend.add_const c) hle
/-- **Mixed-domain triangle inequality for local mass** (Simon 6.2.5).  Let `U ⊆ V₁`, `U ⊆ V₂`
and let `ιᵢ : 𝒟ⁿ(U) → 𝒟ⁿ(Vᵢ)` be the inclusions.  If `Z(ω) = X(ι₁ω) + c Y(ι₂ω)` for every
`ω ∈ 𝒟ⁿ(U)` with `spt ω ⊆ G`, then `M_G(Z) ≤ M_G(X) + |c| M_G(Y)`.  The inclusions keep the
underlying form, so for `ω` admissible for `M_G(Z)` the forms `ι₁ω`, `ι₂ω` and `−ι₂ω` are
admissible for `M_G(X)` and `M_G(Y)`; hence `|Y(ι₂ω)| ≤ M_G(Y)` and
`Z(ω) ≤ X(ι₁ω) + |c| |Y(ι₂ω)| ≤ M_G(X) + |c| M_G(Y)`.  Taking the supremum over admissible `ω`
gives the claim. -/
theorem Submission.dimred_mbl_lc_ic_rb_massOn_le_add_incl : ∀ (P n : ℕ) (U V₁ V₂ G : Set (Euclid P)) (h₁ : U ⊆ V₁) (h₂ : U ⊆ V₂) (Z : GeometricCurrentOn U n) (X : GeometricCurrentOn V₁ n) (Y : GeometricCurrentOn V₂ n) (c : ℝ), (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ G → Z ω = X (testFormOnInclusion h₁ n ω) + c * Y (testFormOnInclusion h₂ n ω)) → Z.massOn G ≤ X.massOn G + ENNReal.ofReal |c| * Y.massOn G := by
  intro P n U V₁ V₂ G h₁ h₂ Z X Y c hZ
  -- Step 1: `M_G(Z)` is a supremum, so bound each admissible value `ofReal (Z ω)`
  refine sSup_le ?_
  rintro r ⟨ω, hω, rfl⟩
  -- Step 2: the inclusions keep the underlying form, so `ι₁ω` and `ι₂ω` are admissible
  have hω₁ : testFormOnInclusion h₁ n ω ∈ massAdmissibleOn V₁ n G := ⟨hω.1, hω.2⟩
  have hω₂ : testFormOnInclusion h₂ n ω ∈ massAdmissibleOn V₂ n G := ⟨hω.1, hω.2⟩
  -- Step 3: `−ι₂ω` is admissible (same support, same Euclidean coefficient norm)
  have hneg : -testFormOnInclusion h₂ n ω ∈ massAdmissibleOn V₂ n G := by
    refine ⟨?_, fun x => ?_⟩
    · have hco : ((-testFormOnInclusion h₂ n ω : TestFormOn V₂ n) :
          DifferentialForm (Euclid P) n) = -(ω : DifferentialForm (Euclid P) n) := rfl
      rw [hco, tsupport_neg]
      exact hω.1
    · have hco : ((-testFormOnInclusion h₂ n ω : TestFormOn V₂ n) :
          DifferentialForm (Euclid P) n) x = -((ω : DifferentialForm (Euclid P) n) x) := rfl
      rw [hco, covectorEuclideanNorm_neg]
      exact hω.2 x
  -- Step 4: `ofReal X(ι₁ω) ≤ M_G(X)` and, as `Y(−ι₂ω) = −Y(ι₂ω)`, `ofReal |Y(ι₂ω)| ≤ M_G(Y)`
  have hXle : ENNReal.ofReal (X (testFormOnInclusion h₁ n ω)) ≤ X.massOn G := X.le_massOn hω₁
  have hYle : ENNReal.ofReal (Y (testFormOnInclusion h₂ n ω)) ≤ Y.massOn G := Y.le_massOn hω₂
  have hYle' : ENNReal.ofReal (Y (-testFormOnInclusion h₂ n ω)) ≤ Y.massOn G :=
    Y.le_massOn hneg
  have hYneg : Y (-testFormOnInclusion h₂ n ω) = -Y (testFormOnInclusion h₂ n ω) :=
    map_neg Y.toCurrent _
  rw [hYneg] at hYle'
  have habs : ENNReal.ofReal |Y (testFormOnInclusion h₂ n ω)| ≤ Y.massOn G := by
    rcases abs_cases (Y (testFormOnInclusion h₂ n ω)) with ⟨h, _⟩ | ⟨h, _⟩
    · rw [h]; exact hYle
    · rw [h]; exact hYle'
  -- Step 5: `c Y(ι₂ω) ≤ |c| |Y(ι₂ω)|`; `ofReal` is monotone, subadditive and multiplicative
  have hcy : c * Y (testFormOnInclusion h₂ n ω) ≤ |c| * |Y (testFormOnInclusion h₂ n ω)| :=
    calc c * Y (testFormOnInclusion h₂ n ω) ≤ |c * Y (testFormOnInclusion h₂ n ω)| := le_abs_self _
      _ = |c| * |Y (testFormOnInclusion h₂ n ω)| := abs_mul _ _
  -- Step 6: the hypothesis applies as `spt ω ⊆ G`; conclude by monotonicity in `[0, ∞]`
  show ENNReal.ofReal (Z ω) ≤ X.massOn G + ENNReal.ofReal |c| * Y.massOn G
  calc ENNReal.ofReal (Z ω)
      = ENNReal.ofReal (X (testFormOnInclusion h₁ n ω) + c * Y (testFormOnInclusion h₂ n ω)) := by
        rw [hZ ω hω.1]
    _ ≤ ENNReal.ofReal (X (testFormOnInclusion h₁ n ω) + |c| * |Y (testFormOnInclusion h₂ n ω)|) :=
        ENNReal.ofReal_le_ofReal (by linarith)
    _ ≤ ENNReal.ofReal (X (testFormOnInclusion h₁ n ω)) +
          ENNReal.ofReal (|c| * |Y (testFormOnInclusion h₂ n ω)|) := ENNReal.ofReal_add_le
    _ = ENNReal.ofReal (X (testFormOnInclusion h₁ n ω)) +
          ENNReal.ofReal |c| * ENNReal.ofReal |Y (testFormOnInclusion h₂ n ω)| := by
        rw [ENNReal.ofReal_mul (abs_nonneg c)]
    _ ≤ X.massOn G + ENNReal.ofReal |c| * Y.massOn G := by gcongr

/-- **Weights of a sum on a compact set** (Simon 7.2.4, proof (10)).  Let `U ⊆ ℝᴾ` be open,
`U' ⊆ U` open and `E ⊆ U'` compact; let `T = τ(R)`, `Z = τ(R_Z)` in `U` and `Y = τ(R_Y)` in
`ℝᴾ`.  If `Z(ω) = T(ω) + Y(ω)` for every `ω ∈ 𝒟ⁿ(U)` with `spt ω ⊆ U'`, then
`μ_{R_Z}(E) ≤ μ_R(E) + μ_{R_Y}(E)`.  On every open `G ⊇ E` with `G ⊂⊂ U'` the mixed mass
triangle inequality (`c = 1`) gives `M_G(Z) ≤ M_G(T) + M_G(Y)`, i.e.
`μ_{R_Z}(G) ≤ μ_R(G) + μ_{R_Y}(G)`, as masses on open sets are the weights (Simon 6.3.2(3)).
`μ_R + μ_{R_Y}` is finite on compact subsets of `U'`, so the outer bound on a compact set lets
`G` shrink to `E`. -/
theorem Submission.dimred_mbl_lc_ic_rb_measure_le_add_of_compact : ∀ (P n : ℕ) (U U' E : Set (Euclid P)) (T Z : GeometricCurrentOn U n) (Y : GeometricCurrentOn (univ : Set (Euclid P)) n) (R RZ : IMRep U n) (RY : IMRep (univ : Set (Euclid P)) n), IsOpen U → IsOpen U' → U' ⊆ U → IsCompact E → E ⊆ U' → R.Represents T → RZ.Represents Z → RY.Represents Y → (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U' → Z ω = T ω + Y (testFormOnInclusion (subset_univ U) n ω)) → RZ.measure E ≤ R.measure E + RY.measure E := by
  intro P n U U' E T Z Y R RZ RY hU hU' hU'U hE hEU' hR hRZ hRY hZ
  -- Step 1: for open `G`, `M_G(T) = μ_R(G)`, `M_G(Z) = μ_{R_Z}(G)` and `M_G(Y) = μ_{R_Y}(G)`
  have hMT := (Submission.dor_imrep_massOn_eq_measure_and_support P n U T R hU hR).1
  have hMZ := (Submission.dor_imrep_massOn_eq_measure_and_support P n U Z RZ hU hRZ).1
  have hMY :=
    (Submission.dor_imrep_massOn_eq_measure_and_support P n univ Y RY isOpen_univ hRY).1
  -- Step 5: the outer bound on `E ⊆ U'` for `μ_{R_Z}` and `ν = μ_R + μ_{R_Y}`, with `c = 0`
  have key := Submission.lcmp_measure_le_add_of_open_nhds P U' E RZ.measure
    (R.measure + RY.measure) 0 hU' hE hEU' ?_ ?_
  · simpa [Measure.add_apply] using key
  -- Step 2: `ν(K) < ∞` for compact `K ⊆ U'`, since `K ⊆ U` and `K ⊆ ℝᴾ`
  · intro K hK hKU'
    rw [Measure.add_apply]
    exact ENNReal.add_lt_top.2
      ⟨lt_top_iff_ne_top.2
          (Submission.rsd_imrep_compact_measure_ne_top P n U R K hK (hKU'.trans hU'U)).2,
        lt_top_iff_ne_top.2
          (Submission.rsd_imrep_compact_measure_ne_top P n univ RY K hK (subset_univ K)).2⟩
  -- Steps 3–4: for open `G ⊇ E` with `G ⊂⊂ U'`, `Z(ω) = T(ω) + 1 · Y(ιω)` when `spt ω ⊆ G`
  -- (the inclusion of `𝒟ⁿ(U)` into itself is the identity), so the mixed mass triangle gives
  -- `μ_{R_Z}(G) = M_G(Z) ≤ M_G(T) + M_G(Y) = ν(G) + 0`
  · intro G hG hEG hGcc
    have hGU' : G ⊆ U' := subset_closure.trans hGcc.2
    have htri := Submission.dimred_mbl_lc_ic_rb_massOn_le_add_incl P n U U univ G (subset_refl U)
      (subset_univ U) Z T Y 1 (fun ω hω => by
        rw [hZ ω (hω.trans hGU'), one_mul]; rfl)
    rw [hMZ G hG, hMT G hG, hMY G hG] at htri
    simpa [Measure.add_apply] using htri
/-- **Truncation at a good radius** (Simon Ch. 6, 2.9, 3.2 and the slice bound 4.6–4.10).  Let
`S = τ(M, θ, ξ)` in the open `U` with weight `μ`, `∂S = 0` in `B_s ⊆ U`, `0 < ρ < s`, and
`A(ω) = ∫_{B_ρ} ⟨ω, ξ⟩ dμ` with `M_{B_s}(∂A) < ∞`.  Then `Ŝ = τ(M ∩ B_ρ, θ, ξ)`, read as a
current in `ℝᴾ`, has weight `μ⌞B_ρ` and agrees with `S` on forms supported in `B_ρ`, so `∂Ŝ = 0`
there.  For `|β| ≤ 1` and a bump `χ` with `χ = 1` near `B̄_ρ` and `spt χ ⊆ B_s`, the forms `dβ`
and `d(χβ)` agree on `B_ρ`, so `∂Ŝ(β) = ∂A(χβ) ≤ M_{B_s}(∂A)` (6.2.5); hence
`M(∂Ŝ) ≤ M_{B_s}(∂A)`. -/
theorem Submission.dimred_mbl_tc_truncate_at_good_radius : ∀ (P m : ℕ) (U : Set (Euclid P)) (S A : GeometricCurrentOn U (m + 1)) (R : IMRep U (m + 1)) (ρ s : ℝ), IsOpen U → R.Represents S → (∀ β : TestFormOn U m, tsupport (β : DifferentialForm (Euclid P) m) ⊆ ball 0 s → S.boundary β = 0) → 0 < ρ → ρ < s → ball (0 : Euclid P) s ⊆ U → (∀ ω : TestFormOn U (m + 1), A ω = ∫ x in ball (0 : Euclid P) ρ, R.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂R.measure) → A.boundary.massOn (ball 0 s) ≠ ∞ → ∃ (Ŝ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R' : IMRep (univ : Set (Euclid P)) (m + 1)), R'.Represents Ŝ ∧ R'.measure = R.measure.restrict (ball 0 ρ) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 ρ → Ŝ ω = currentEval S (ω : DifferentialForm (Euclid P) (m + 1))) ∧ (∀ β : TestFormOn (univ : Set (Euclid P)) m, tsupport (β : DifferentialForm (Euclid P) m) ⊆ ball 0 ρ → Ŝ.boundary β = 0) ∧ Ŝ.boundary.massOn univ ≤ A.boundary.massOn (ball 0 s) := by
  have hE1 := Submission.cmr_abs_apply_le_massOn
  have hIMC := Submission.cmc_imRep_locality_restrict_sub
  have hRS := Submission.lcmp_imRep_measure_restrict
  intro P m U S A R ρ s hU hSR hSb hρ hρs hsU hA hAfin
  have hcb : closedBall (0 : Euclid P) ρ ⊆ U := (closedBall_subset_ball hρs).trans hsU
  -- Step 1: restriction of R to ball 0 ρ, in U
  obtain ⟨-, R₁, -, hR₁c, hR₁m, hR₁o⟩ := hIMC.2.1 P (m + 1) U R (ball 0 ρ) hU measurableSet_ball
  -- Step 2: the same data as an IMRep in ℝ^P
  let R₂ : IMRep (univ : Set (Euclid P)) (m + 1) :=
    { carrier := R₁.carrier
      mult := R₁.mult
      orient := R₁.orient
      measurableSet_carrier := R₁.measurableSet_carrier
      carrier_subset := subset_univ _
      rectifiable := R₁.rectifiable
      measurable_mult := R₁.measurable_mult
      mult_pos := R₁.mult_pos
      locallyIntegrable_mult := fun K _ _ => by
        refine ne_top_of_le_ne_top
          (R.locallyIntegrable_mult _ (isCompact_closedBall 0 ρ) hcb) ?_
        rw [hR₁c, hR₁m]
        exact lintegral_mono_set (fun x hx => ⟨hx.1.1, ball_subset_closedBall hx.1.2⟩)
      aestronglyMeasurable_orient := R₁.aestronglyMeasurable_orient
      orients := R₁.orients }
  -- Step 3: the current represented in ℝ^P
  obtain ⟨Ŝ, R', hR'rep, hR'c, hR'm, hR'o⟩ :=
    hIMC.2.1 P (m + 1) univ R₂ univ isOpen_univ MeasurableSet.univ
  -- Step 4: weight and action
  obtain ⟨-, -, hrestr⟩ := hRS P (m + 1) U R
  obtain ⟨hmeas₁, hact₁⟩ := hrestr (ball 0 ρ) R₁ measurableSet_ball hR₁c hR₁m hR₁o
  have hR'meas : R'.measure = R.measure.restrict (ball 0 ρ) := by
    rw [← hmeas₁]
    unfold IMRep.measure
    rw [hR'c, hR'm, inter_univ]
  have hact : ∀ ω : DifferentialForm (Euclid P) (m + 1),
      R'.action ω = ∫ x in ball (0 : Euclid P) ρ, R.orient x (ω x) ∂R.measure := by
    intro ω
    rw [← hact₁ ω]
    unfold IMRep.action
    rw [hR'c, hR'm, hR'o, inter_univ]
  have hŜ : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      Ŝ ω = ∫ x in ball (0 : Euclid P) ρ,
        R.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂R.measure := fun ω => by
    rw [hR'rep ω, hact]
  -- Step 5: agreement
  have hagree : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 ρ →
        Ŝ ω = currentEval S (ω : DifferentialForm (Euclid P) (m + 1)) := by
    intro ω hω
    have hωU : IsTestForm (ω : DifferentialForm (Euclid P) (m + 1)) ∧
        tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ U :=
      ⟨ω.property.1, hω.trans (ball_subset_closedBall.trans hcb)⟩
    rw [currentEval, dite_eq_left hωU, hSR, hŜ,
      (hrestr univ R MeasurableSet.univ (by simp) rfl rfl).2, Measure.restrict_univ]
    refine setIntegral_eq_integral_of_forall_compl_eq_zero (fun x hx => ?_)
    show R.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) = 0
    rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hω h)), map_zero]
  -- Step 6: vanishing boundary inside
  have hbdry : ∀ β : TestFormOn (univ : Set (Euclid P)) m,
      tsupport (β : DifferentialForm (Euclid P) m) ⊆ ball 0 ρ → Ŝ.boundary β = 0 := by
    intro β hβ
    have hdβ : tsupport (exteriorDerivative (β : DifferentialForm (Euclid P) m)) ⊆ ball 0 ρ :=
      (tsupport_exteriorDerivative_subset _).trans hβ
    have hβU : (β : DifferentialForm (Euclid P) m) ∈ TestFormOn U m :=
      ⟨β.property.1, hβ.trans (ball_subset_closedBall.trans hcb)⟩
    rw [GeometricCurrentOn.boundary_apply, hagree _ hdβ]
    have hdU : IsTestForm (exteriorDerivative (β : DifferentialForm (Euclid P) m)) ∧
        tsupport (exteriorDerivative (β : DifferentialForm (Euclid P) m)) ⊆ U :=
      ⟨exteriorDerivative_isTestForm β.property.1,
        hdβ.trans (ball_subset_closedBall.trans hcb)⟩
    have := hSb ⟨_, hβU⟩ (hβ.trans (ball_subset_ball hρs.le))
    rw [GeometricCurrentOn.boundary_apply] at this
    show currentEval S (exteriorDerivative (β : DifferentialForm (Euclid P) m)) = 0
    rw [currentEval, dite_eq_left hdU]
    exact this
  -- Step 7: cutoff
  have hmid : ρ < (ρ + s) / 2 := by linarith
  let χ : ContDiffBump (0 : Euclid P) := ⟨ρ, (ρ + s) / 2, hρ, hmid⟩
  have hχsupp : tsupport (χ : Euclid P → ℝ) ⊆ ball 0 s := by
    rw [χ.tsupport_eq]
    exact closedBall_subset_ball (by show (ρ + s) / 2 < s; linarith)
  have hsmul : ∀ (c : ℝ) (α : Covector (Euclid P) m),
      covectorEuclideanNorm (c • α) = |c| * covectorEuclideanNorm α := by
    intro c α
    unfold covectorEuclideanNorm
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg c), Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl (fun I _ => ?_)
    split_ifs <;> simp [ContinuousAlternatingMap.smul_apply, mul_pow]
  -- Step 8: boundary mass
  have hmass : Ŝ.boundary.massOn univ ≤ A.boundary.massOn (ball 0 s) := by
    unfold GeometricCurrentOn.massOn
    apply sSup_le
    rintro _ ⟨β, hβ, rfl⟩
    show ENNReal.ofReal (Ŝ.boundary β) ≤ _
    set b : DifferentialForm (Euclid P) m := (β : DifferentialForm (Euclid P) m)
    let γ : DifferentialForm (Euclid P) m := fun x => (χ x) • b x
    have hγtest : IsTestForm γ := by
      refine ⟨?_, ?_⟩
      · exact (χ.contDiff).smul β.property.1.1
      · exact χ.hasCompactSupport.smul_right
    have hγsupp : tsupport γ ⊆ ball 0 s :=
      (tsupport_smul_subset_left (fun x => χ x) b).trans hχsupp
    have hγU : γ ∈ TestFormOn U m := ⟨hγtest, hγsupp.trans hsU⟩
    have hγnorm : ∀ x, covectorEuclideanNorm (γ x) ≤ 1 := by
      intro x
      show covectorEuclideanNorm (χ x • b x) ≤ 1
      rw [hsmul, abs_of_nonneg (χ.nonneg)]
      calc χ x * covectorEuclideanNorm (b x) ≤ 1 * 1 :=
            mul_le_mul χ.le_one (hβ.2 x) (covectorEuclideanNorm_nonneg _) zero_le_one
        _ = 1 := one_mul 1
    have hloc : ∀ x ∈ ball (0 : Euclid P) ρ, exteriorDerivative b x = exteriorDerivative γ x := by
      intro x hx
      have h1 : (χ : Euclid P → ℝ) =ᶠ[𝓝 x] 1 := χ.eventuallyEq_one_of_mem_ball hx
      have h2 : b =ᶠ[𝓝 x] γ := by
        filter_upwards [h1] with y hy
        show b y = χ y • b y
        rw [hy]; simp
      exact h2.extDeriv_eq
    have hkey : Ŝ.boundary β = A.boundary ⟨γ, hγU⟩ := by
      rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, hŜ, hA]
      refine setIntegral_congr_fun measurableSet_ball (fun x hx => ?_)
      show R.orient x (exteriorDerivative b x) = R.orient x (exteriorDerivative γ x)
      rw [hloc x hx]
    have hle := hE1 P m U (ball 0 s) A.boundary ⟨γ, hγU⟩ 1 hAfin hγsupp hγnorm
    rw [one_mul] at hle
    rw [hkey]
    calc ENNReal.ofReal (A.boundary ⟨γ, hγU⟩)
        ≤ ENNReal.ofReal (A.boundary.massOn (ball 0 s)).toReal :=
          ENNReal.ofReal_le_ofReal ((le_abs_self _).trans hle)
      _ = A.boundary.massOn (ball 0 s) := ENNReal.ofReal_toReal hAfin
  exact ⟨Ŝ, R', hR'rep, hR'meas, hagree, hbdry, hmass⟩
/-- **Simon 6.2.5 and 6.2.11** (local mass vanishes off the support).  If `V ∩ spt T = ∅`, then
`M_V(T) = 0`.  Every `ω` admissible for `M_V(T)` has `spt ω ⊆ V`, which misses `spt T`, so
`T(ω) = 0` by `dtc_vanish_off_support`.  Every term `ofReal(T(ω))` of the supremum defining
`M_V(T)` is therefore `0`, and `M_V(T) ≤ 0` means `M_V(T) = 0` in `[0, ∞]`.  `U` and `V` are
arbitrary sets. -/
theorem Submission.dimred_mbl_lc_ic_massOn_eq_zero_of_disjoint : ∀ (P n : ℕ) (U V : Set (Euclid P)) (T : GeometricCurrentOn U n), Disjoint V T.support → T.massOn V = 0 := by
  intro P n U V T hV
  -- Step 3: `M_V(T) = 0` once every term `ofReal(T(ω))` of the supremum is `≤ 0`
  refine nonpos_iff_eq_zero.mp (sSup_le ?_)
  -- Step 1: an admissible `ω` has `spt ω ⊆ V`, so `spt ω` misses `spt T`
  rintro r ⟨ω, hω, rfl⟩
  -- Step 2: `T(ω) = 0` by `dtc_vanish_off_support`, so `ofReal(T(ω)) = 0`
  change ENNReal.ofReal (T ω) ≤ 0
  rw [Submission.dtc_vanish_off_support P n U T ω (hV.mono_left hω.1), ENNReal.ofReal_zero]

/-- **The comparison cycle** (Simon 7.2.4 with Remark 7.2.5(2)).  Let `F ⊆ ℝᴾ` be compact and let
`C, S, Ŷ ∈ 𝒟_{m+1}(ℝᴾ)` be integer multiplicity with `∂S = ∂C`, `spt(S − C) ⊆ F`, `∂Ŷ = 0` and
`spt Ŷ ⊆ F`.  Then `Y = (S − C) + Ŷ` is an integer multiplicity cycle with `spt Y ⊆ F` compact.
As a current, `Y = (S − C) − ((Ŷ − Ŷ) − Ŷ)` is integer multiplicity by four differences
(`cmc_imRep_locality_restrict_sub` (c)).  With `ζ = dη`, `∂Y(η) = S(ζ) − C(ζ) + Ŷ(ζ) = 0`.
`Y` kills every form supported away from `F` (`dtc_vanish_off_support`), so `spt Y ⊆ F` is
compact (`rsd_cmr_support_subset_of_vanish`). -/
theorem Submission.dimred_mbl_lc_ic_cycle : ∀ (P m : ℕ) (F : Set (Euclid P)) (C S Ŷ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact F → IsIntegerMultiplicity C → IsIntegerMultiplicity S → S.boundary = C.boundary → (S - C).support ⊆ F → IsIntegerMultiplicity Ŷ → Ŷ.boundary = 0 → Ŷ.support ⊆ F → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Y ∧ Y.boundary = 0 ∧ IsCompact Y.support ∧ Y.support ⊆ F ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Y ω = (S - C) ω + Ŷ ω := by
  intro P m F C S Ŷ hF hC hS hbd hSC hŶ hŶbd hŶF
  -- (IMC)(c): differences of integer multiplicity currents in the open set `ℝᴾ`
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ
  -- `Y := X − ((Ŷ − Ŷ) − Ŷ)` with `X := S − C`
  set X := S - C
  set Y := X - ((Ŷ - Ŷ) - Ŷ)
  -- Step 1: four differences of integer multiplicity currents
  have hYim : IsIntegerMultiplicity Y :=
    hsub X _ isOpen_univ (hsub S C isOpen_univ hS hC)
      (hsub _ Ŷ isOpen_univ (hsub Ŷ Ŷ isOpen_univ hŶ hŶ) hŶ)
  -- Step 2: `Y(ω) = X(ω) − ((Ŷ(ω) − Ŷ(ω)) − Ŷ(ω)) = X(ω) + Ŷ(ω)`
  have hXω : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), X ω = S ω - C ω := fun ω => rfl
  have hYω : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Y ω = X ω + Ŷ ω := by
    intro ω
    change X ω - ((Ŷ ω - Ŷ ω) - Ŷ ω) = X ω + Ŷ ω
    ring
  -- Step 3: with `ζ = dη`, `∂Y(η) = Y(ζ) = S(ζ) − C(ζ) + Ŷ(ζ) = 0`
  have hYbd : Y.boundary = 0 := by
    ext η
    have h1 : S.boundary η = C.boundary η := by rw [hbd]
    have h2 : Ŷ.boundary η = 0 := by rw [hŶbd, GeometricCurrentOn.zero_apply]
    simp only [GeometricCurrentOn.boundary_apply] at h1 h2
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply, hYω, hXω, h1, h2,
      sub_self, add_zero]
  -- Step 4: `Y` vanishes on forms supported away from `F`, as `spt X ⊆ F` and `spt Ŷ ⊆ F`
  have hvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) F → Y ω = 0 := by
    intro ω hω
    rw [hYω, Submission.dtc_vanish_off_support P (m + 1) univ X ω (hω.mono_right hSC),
      Submission.dtc_vanish_off_support P (m + 1) univ Ŷ ω (hω.mono_right hŶF), add_zero]
  -- Step 5: hence `spt Y ⊆ F` and `spt Y` is compact
  obtain ⟨hYF, hYc⟩ := Submission.rsd_cmr_support_subset_of_vanish P (m + 1) univ F Y isOpen_univ
    hF (subset_univ F) hvan
  exact ⟨Y, hYim, hYbd, hYc, hYF, hYω⟩

/-- **The comparison current `T + Y⌞U`** (Simon 7.2.4, proof, (8); Ch. 6, 2.16 and
Remark 3.2(1)).  Let `U ⊆ ℝᴾ` be open, and let `T ∈ 𝒟ₙ(U)` and `Y ∈ 𝒟ₙ(ℝᴾ)` be integer
multiplicity.  Then some integer multiplicity `Z ∈ 𝒟ₙ(U)` has `Z(ω) = T(ω) + Y(ιω)` for every
`ω ∈ 𝒟ⁿ(U)`.  The restriction `Y⌞U(ω) = Y(ιω)` is integer multiplicity in the open set `U`
(`dtc_restrictDomain_isIntegerMultiplicity`).  Three differences
(`cmc_imRep_locality_restrict_sub` (c)) make `Z = T − ((T − T) − Y⌞U)` integer multiplicity. -/
theorem Submission.dimred_mbl_lc_ic_add_restrict : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (Y : GeometricCurrentOn (univ : Set (Euclid P)) n), IsOpen U → IsIntegerMultiplicity T → IsIntegerMultiplicity Y → ∃ Z : GeometricCurrentOn U n, IsIntegerMultiplicity Z ∧ ∀ ω : TestFormOn U n, Z ω = T ω + Y (testFormOnInclusion (subset_univ U) n ω) := by
  intro P n U T Y hU hT hY
  -- Step 1: `Y⌞U = Y.restrictDomain (subset_univ U)` is integer multiplicity in `U`
  have hYU : IsIntegerMultiplicity (Y.restrictDomain (subset_univ U)) :=
    Submission.dtc_restrictDomain_isIntegerMultiplicity P n univ U (subset_univ U) Y hU hY
  -- Step 2: `T − T`, `(T − T) − Y⌞U` and `Z = T − ((T − T) − Y⌞U)` are integer multiplicity
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P n U
  refine ⟨T - ((T - T) - Y.restrictDomain (subset_univ U)),
    hsub T _ hU hT (hsub _ _ hU (hsub T T hU hT hT) hYU), fun ω => ?_⟩
  -- Step 3: `Z(ω) = T(ω) − ((T(ω) − T(ω)) − Y(ιω)) = T(ω) + Y(ιω)`
  show T ω - ((T ω - T ω) - Y (testFormOnInclusion (subset_univ U) n ω)) = _
  ring
/-- **Three-region mass bound** (Simon 7.2.4, (8)–(11), with Remark 7.2.5(2)).  Let `W ⊆ F ⊆ B ⊆ U`
with `U`, `W`, `B` open and `F` compact, `T = τ(R)` in `U` with `μ_T(F ∖ W) = 0`, and
`Z = T + Y` in `U`, where `Y = (S − C) + Ŷ`, `spt(S − C) ⊆ W`, `spt Ŷ ⊆ F`, `C = T + Ŷ + Sr` on
forms supported in `W`, `M(Sr) ≤ e` and `μ_Ŷ(F ∖ W) ≤ e`.  Then `b = μ_T(B ∖ F)` satisfies
`M_B(T) = M_W(T) + b` and `M_B(Z) ≤ M_W(S) + e + e + b`.  Masses of the integer multiplicity
currents `T` and `Z` on open sets are measures, and `B = W ⊔ (F ∖ W) ⊔ (B ∖ F)`.  On `B ∖ F`,
`Z = T`; on `W`, `Z = S − Sr`; on `U ∖ spt(S − C)`, an open set containing the compact `F ∖ W`,
`Z = T + Ŷ`, so `μ_Z(F ∖ W) ≤ μ_T(F ∖ W) + μ_Ŷ(F ∖ W) ≤ e`. -/
theorem Submission.dimred_mbl_lc_ic_region_bound : ∀ (P n : ℕ) (U W F B : Set (Euclid P)) (T Z : GeometricCurrentOn U n) (R : IMRep U n) (C S Ŷ Sr Y : GeometricCurrentOn (univ : Set (Euclid P)) n) (e : ℝ≥0∞), IsOpen U → R.Represents T → IsIntegerMultiplicity Z → IsOpen B → B ⊆ U → IsOpen W → IsCompact F → W ⊆ F → F ⊆ B → R.measure (F \ W) = 0 → (S - C).support ⊆ W → IsIntegerMultiplicity Ŷ → Ŷ.support ⊆ F → (∀ R' : IMRep (univ : Set (Euclid P)) n, R'.Represents Ŷ → R'.measure (F \ W) ≤ e) → Sr.mass ≤ e → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → C ω = currentEval T (ω : DifferentialForm (Euclid P) n) + Ŷ ω + Sr ω) → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Y ω = (S - C) ω + Ŷ ω) → (∀ ω : TestFormOn U n, Z ω = T ω + Y (testFormOnInclusion (subset_univ U) n ω)) → ∃ b : ℝ≥0∞, T.massOn B = T.massOn W + b ∧ Z.massOn B ≤ S.massOn W + e + e + b := by
  intro P n U W F B T Z R C S Ŷ Sr Y e hU hR hZ hB hBU hW hF hWF hFB hRFW hXW hŶ hŶF hŶe hSr hC
    hY hZY
  -- Step 0(a): representations `R_Z` of `Z` and `R_Ŷ` of `Ŷ`; `M_G(T) = μ_T(G)` and
  -- `M_G(Z) = μ_Z(G)` for open `G`
  obtain ⟨RZ, hRZ⟩ := hZ
  obtain ⟨RŶ, hRŶ⟩ := hŶ
  have hMT := (Submission.dor_imrep_massOn_eq_measure_and_support P n U T R hU hR).1
  have hMZ := (Submission.dor_imrep_massOn_eq_measure_and_support P n U Z RZ hU hRZ).1
  -- Step 0(b): `F` is closed, so `B ∖ F` is open
  have hFc : IsClosed F := hF.isClosed
  have hO : IsOpen (B \ F) := hB.sdiff hFc
  -- Step 0(c): `μ(B) = μ(W) + μ(F ∖ W) + μ(B ∖ F)` for every measure `μ`
  have hsplit : ∀ μ : Measure (Euclid P), μ B = μ W + μ (F \ W) + μ (B \ F) := fun μ => by
    have hμF : μ F = μ W + μ (F \ W) := by
      rw [← measure_inter_add_sdiff F hW.measurableSet, inter_eq_right.2 hWF]
    rw [← measure_inter_add_sdiff B hFc.measurableSet, inter_eq_right.2 hFB, hμF]
  -- `(S − C)(ω) = S(ω) − C(ω)`
  have hsub : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, (S - C) ω = S ω - C ω := fun _ => rfl
  -- Step 2: on `B ∖ F`, `S − C` and `Ŷ` vanish (their supports lie in `W ⊆ F` and in `F`), so
  -- `Z = T + 0 · Ŷ` there and `μ_Z(B ∖ F) = M_{B∖F}(Z) ≤ M_{B∖F}(T) = μ_T(B ∖ F)`
  have h2 : RZ.measure (B \ F) ≤ R.measure (B \ F) := by
    have h := Submission.dimred_mbl_lc_ic_rb_massOn_le_add_incl P n U U univ (B \ F)
      (subset_refl U) (subset_univ U) Z T Ŷ 0 (fun ω hω => by
        have hX : (S - C) (testFormOnInclusion (subset_univ U) n ω) = 0 :=
          Submission.dtc_vanish_off_support P n univ (S - C) _
            (Disjoint.mono hω (hXW.trans hWF) disjoint_sdiff_left)
        have hŶ0 : Ŷ (testFormOnInclusion (subset_univ U) n ω) = 0 :=
          Submission.dtc_vanish_off_support P n univ Ŷ _
            (Disjoint.mono hω hŶF disjoint_sdiff_left)
        have hι : testFormOnInclusion (subset_refl U) n ω = ω := rfl
        rw [hι, hZY ω, hY, hX, hŶ0]
        simp)
    rw [hMZ _ hO, hMT _ hO] at h
    simpa using h
  -- Step 3: on `W`, `currentEval T (ιω) = T(ω)`, so `Z(ω) = S(ιω) + (−1) · Sr(ιω)` and
  -- `μ_Z(W) = M_W(Z) ≤ M_W(S) + M_W(Sr) ≤ M_W(S) + M(Sr) ≤ M_W(S) + e`
  have h3 : RZ.measure W ≤ S.massOn W + e := by
    have h := Submission.dimred_mbl_lc_ic_rb_massOn_le_add_incl P n U univ univ W
      (subset_univ U) (subset_univ U) Z S Sr (-1) (fun ω hω => by
        have hev : currentEval T ((testFormOnInclusion (subset_univ U) n ω :
            TestFormOn (univ : Set (Euclid P)) n) : DifferentialForm (Euclid P) n) = T ω := by
          rw [testFormOnInclusion_coe, currentEval]
          exact dite_eq_left ω.property
        rw [hZY ω, hY, hsub, hC (testFormOnInclusion (subset_univ U) n ω) hω, hev]
        ring)
    rw [← hMZ W hW]
    calc Z.massOn W ≤ S.massOn W + ENNReal.ofReal |(-1 : ℝ)| * Sr.massOn W := h
      _ = S.massOn W + Sr.massOn W := by simp
      _ ≤ S.massOn W + e := add_le_add le_rfl ((Sr.massOn_mono (subset_univ W)).trans hSr)
  -- Step 4: `spt(S − C)` is closed, so `U′ = U ∖ spt(S − C)` is open; it contains the compact
  -- `F ∖ W`, and `Z = T + Ŷ` on forms supported in `U′`.  `compact_sum_bound` gives
  -- `μ_Z(F ∖ W) ≤ μ_T(F ∖ W) + μ_Ŷ(F ∖ W) = 0 + μ_Ŷ(F ∖ W) ≤ e`
  have hXc : IsClosed (S - C).support := isClosed_univ.sdiff (S - C).isOpen_zeroRegion
  have h4 : RZ.measure (F \ W) ≤ e := by
    have h := Submission.dimred_mbl_lc_ic_rb_measure_le_add_of_compact P n U
      (U \ (S - C).support) (F \ W) T Z Ŷ R RZ RŶ hU (hU.sdiff hXc) sdiff_subset (hF.diff hW)
      (fun x hx => ⟨hBU (hFB hx.1), fun hxX => hx.2 (hXW hxX)⟩) hR hRZ hRŶ (fun ω hω => by
        have hX : (S - C) (testFormOnInclusion (subset_univ U) n ω) = 0 :=
          Submission.dtc_vanish_off_support P n univ (S - C) _
            (Disjoint.mono_left hω disjoint_sdiff_left)
        rw [hZY ω, hY, hX, zero_add])
    rw [hRFW, zero_add] at h
    exact h.trans (hŶe RŶ hRŶ)
  -- Step 1: `M_B(T) = μ_T(W) + μ_T(F ∖ W) + μ_T(B ∖ F) = M_W(T) + 0 + b`
  refine ⟨R.measure (B \ F), ?_, ?_⟩
  · rw [hMT B hB, hMT W hW, hsplit R.measure, hRFW, add_zero]
  -- Step 5: `M_B(Z) = μ_Z(W) + μ_Z(F ∖ W) + μ_Z(B ∖ F) ≤ (M_W(S) + e) + e + b`
  · rw [hMZ B hB, hsplit RZ.measure]
    exact add_le_add (add_le_add h3 h4) h2
/-- **Cancelling the finite mass outside `F`** (Simon 7.2.4 with Remark 7.2.5(2), index
comparison, step 8).  Let `a, b, s, e, M ∈ [0, ∞]`, `L ≥ 1` and `b ≤ M < ∞`, and write
`λ = ofReal(Lⁿ)`, `κ = ofReal(Lⁿ - 1)`.  If `a + b ≤ λ(s + e + e + b)`, then
`a ≤ λ(s + 2e) + κM`.  As `Lⁿ ≥ 1`, `λ = ofReal(1) + ofReal(Lⁿ - 1) = 1 + κ`, so
`λ(s + e + e + b) = (λ(s + 2e) + κb) + b`; the finite `b` cancels in `[0, ∞]`, and `κb ≤ κM`. -/
theorem Submission.dimred_mbl_lc_ic_cancel : ∀ (a b s e M : ℝ≥0∞) (L : ℝ) (n : ℕ), 1 ≤ L → b ≤ M → M ≠ ∞ → a + b ≤ ENNReal.ofReal (L ^ n) * (s + e + e + b) → a ≤ ENNReal.ofReal (L ^ n) * (s + 2 * e) + ENNReal.ofReal (L ^ n - 1) * M := by
  intro a b s e M L n hL hbM hM h
  -- Step 1: `b ≤ M < ∞`
  have hb : b ≠ ∞ := ne_top_of_le_ne_top hM hbM
  -- Step 2: `λ = 1 + κ`, since `Lⁿ = 1 + (Lⁿ - 1)` with `1, Lⁿ - 1 ≥ 0`
  have hLn : ENNReal.ofReal (L ^ n) = 1 + ENNReal.ofReal (L ^ n - 1) := by
    rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_add zero_le_one (sub_nonneg.2 (one_le_pow₀ hL)),
      add_sub_cancel]
  -- Step 3: `λ(s + e + e + b) = (λ(s + 2e) + κb) + b` in the semiring `[0, ∞]`
  have hrhs : ENNReal.ofReal (L ^ n) * (s + e + e + b) =
      ENNReal.ofReal (L ^ n) * (s + 2 * e) + ENNReal.ofReal (L ^ n - 1) * b + b := by
    rw [hLn]
    ring
  rw [hrhs] at h
  -- Step 4: cancel the finite `b`; Step 5: `κb ≤ κM`
  calc a ≤ ENNReal.ofReal (L ^ n) * (s + 2 * e) + ENNReal.ofReal (L ^ n - 1) * b :=
        ENNReal.le_of_add_le_add_right hb h
    _ ≤ ENNReal.ofReal (L ^ n) * (s + 2 * e) + ENNReal.ofReal (L ^ n - 1) * M := by gcongr
/-- Choice of a good slicing level (Simon 7.2.4 (3)–(5), the choice of `α` and of the
subsequence).  Let `A = {a < f < b}` with `νⱼ(A) < ∞`, `νⱼ(A) → 0` and `κⱼ(A) < ∞`.  Some
`t ∈ (a, b)` has `κⱼ{f = t} = 0` and `Dⱼ(t) < ∞` for every `j`, and `D_{φ(j)}(t) → 0` along a
subsequence `φ`, where `Dⱼ(t) = liminf_{h ↓ 0} h⁻¹ νⱼ{t − h < f < t}`.  For `ρⱼ = f_#(νⱼ⌞A)`,
Tonelli gives `∫ ρⱼ((s − c, s)) ds = c νⱼ(A)`, so `Gⱼ(s) = liminf_k (k + 1) ρⱼ((s − 1/(k+1), s))`
has `∫ Gⱼ ≤ νⱼ(A)` (Fatou) and `Dⱼ ≤ Gⱼ` on `(a, b)`.  Fatou in `j` and the countability of the
atoms of `κⱼ⌞A` then give `t`. -/
theorem Submission.lcmp_exists_good_slice_level : ∀ (P : ℕ) (ν κ : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (a b : ℝ), Measurable f → a < b → (∀ j, ν j {x | a < f x ∧ f x < b} < ∞) → Tendsto (fun j => ν j {x | a < f x ∧ f x < b}) atTop (𝓝 0) → (∀ j, κ j {x | a < f x ∧ f x < b} < ∞) → ∃ t ∈ Ioo a b, ∃ φ : ℕ → ℕ, StrictMono φ ∧ (∀ j, κ j {x | f x = t} = 0) ∧ (∀ j, liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * ν j {x | t - h < f x ∧ f x < t}) (𝓝[>] 0) < ∞) ∧ Tendsto (fun j => liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * ν (φ j) {x | t - h < f x ∧ f x < t}) (𝓝[>] 0)) atTop (𝓝 0) := by
  intro P ν κ f a b hf hab hνfin hνlim hκfin
  obtain ⟨A, hA⟩ : ∃ A : Set (Euclid P), A = {x | a < f x ∧ f x < b} := ⟨_, rfl⟩
  rw [← hA] at hνfin hνlim hκfin
  -- Step 2: `ρⱼ = f_#(νⱼ⌞A)` is a finite measure on `ℝ`, `ρⱼ(B) = νⱼ(f⁻¹(B) ∩ A)`
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℕ → Measure ℝ, ρ = fun j => ((ν j).restrict A).map f := ⟨_, rfl⟩
  have hρapp : ∀ j (s : Set ℝ), MeasurableSet s → ρ j s = ν j (f ⁻¹' s ∩ A) := by
    intro j s hs
    rw [hρ, Measure.map_apply hf hs, Measure.restrict_apply (hf hs)]
  have hρuniv : ∀ j, ρ j univ = ν j A := by
    intro j
    rw [hρapp j univ MeasurableSet.univ, preimage_univ, univ_inter]
  have hρfin : ∀ j, IsFiniteMeasure (ρ j) := fun j => ⟨by rw [hρuniv]; exact hνfin j⟩
  -- Step 3: Tonelli on `S_c = {(s, y) : s − c < y < s}`: `∫ ρⱼ((s − c, s)) ds = c νⱼ(A)`
  have hSm : ∀ c : ℝ, MeasurableSet {p : ℝ × ℝ | p.1 - c < p.2 ∧ p.2 < p.1} := fun c =>
    (measurableSet_lt (measurable_fst.sub_const c) measurable_snd).inter
      (measurableSet_lt measurable_snd measurable_fst)
  have hsec : ∀ c t : ℝ,
      Prod.mk t ⁻¹' {p : ℝ × ℝ | p.1 - c < p.2 ∧ p.2 < p.1} = Ioo (t - c) t := by
    intro c t
    ext y
    simp [mem_Ioo]
  have hsec' : ∀ c y : ℝ,
      (fun t => (t, y)) ⁻¹' {p : ℝ × ℝ | p.1 - c < p.2 ∧ p.2 < p.1} = Ioo y (y + c) := by
    intro c y
    ext t
    simp only [mem_preimage, mem_ofPred_eq, mem_Ioo]
    constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith
  have hmeasF : ∀ j (c : ℝ), Measurable fun t : ℝ => ρ j (Ioo (t - c) t) := by
    intro j c
    have := hρfin j
    have := measurable_measure_prodMk_left (ν := ρ j) (hSm c)
    simpa only [hsec] using this
  have hTon : ∀ j (c : ℝ), ∫⁻ t, ρ j (Ioo (t - c) t) = ENNReal.ofReal c * ν j A := by
    intro j c
    have := hρfin j
    have h1 := Measure.prod_apply (μ := (volume : Measure ℝ)) (ν := ρ j) (hSm c)
    have h2 := Measure.prod_apply_symm (μ := (volume : Measure ℝ)) (ν := ρ j) (hSm c)
    simp only [hsec, hsec', Real.volume_Ioo, add_sub_cancel_left] at h1 h2
    rw [← h1, h2, lintegral_const, hρuniv]
  -- Step 4: `Fⱼₖ(s) = (k + 1) ρⱼ((s − 1/(k+1), s))` has `∫ Fⱼₖ = νⱼ(A)`, so the majorant
  -- `Gⱼ = liminf_k Fⱼₖ` has `∫ Gⱼ ≤ νⱼ(A)` (Fatou)
  have hFm : ∀ j (k : ℕ),
      Measurable fun t : ℝ => ((k : ℝ≥0∞) + 1) * ρ j (Ioo (t - 1 / ((k : ℝ) + 1)) t) :=
    fun j k => (hmeasF j _).const_mul _
  have hcancel : ∀ k : ℕ, ((k : ℝ≥0∞) + 1) * ENNReal.ofReal (1 / ((k : ℝ) + 1)) = 1 := by
    intro k
    have hk : ENNReal.ofReal ((k : ℝ) + 1) = (k : ℝ≥0∞) + 1 := by
      rw [ENNReal.ofReal_add (by positivity) zero_le_one, ENNReal.ofReal_natCast,
        ENNReal.ofReal_one]
    rw [one_div, ENNReal.ofReal_inv_of_pos (by positivity), hk,
      ENNReal.mul_inv_cancel (by simp) (by simp)]
  have hFint : ∀ j (k : ℕ),
      ∫⁻ t, ((k : ℝ≥0∞) + 1) * ρ j (Ioo (t - 1 / ((k : ℝ) + 1)) t) = ν j A := by
    intro j k
    rw [lintegral_const_mul _ (hmeasF j _), hTon j, ← mul_assoc, hcancel, one_mul]
  obtain ⟨G, hG⟩ : ∃ G : ℕ → ℝ → ℝ≥0∞, G = fun j t =>
      liminf (fun k : ℕ => ((k : ℝ≥0∞) + 1) * ρ j (Ioo (t - 1 / ((k : ℝ) + 1)) t)) atTop :=
    ⟨_, rfl⟩
  have hGm : ∀ j, Measurable (G j) := fun j => by
    rw [hG]
    exact Measurable.liminf (hFm j)
  have hGint : ∀ j, ∫⁻ t, G j t ≤ ν j A := by
    intro j
    rw [hG]
    calc ∫⁻ t, liminf (fun k : ℕ => ((k : ℝ≥0∞) + 1) * ρ j (Ioo (t - 1 / ((k : ℝ) + 1)) t)) atTop
        ≤ liminf (fun k : ℕ => ∫⁻ t, ((k : ℝ≥0∞) + 1) * ρ j (Ioo (t - 1 / ((k : ℝ) + 1)) t))
          atTop := lintegral_liminf_le (hFm j)
      _ = ν j A := by simp only [hFint, liminf_const]
  have hGfin : ∀ᵐ t, ∀ j, G j t < ∞ :=
    ae_all_iff.2 fun j => ae_lt_top (hGm j) ((hGint j).trans_lt (hνfin j)).ne
  -- Step 5: Fatou in `j`: `∫ liminf_j Gⱼ ≤ liminf_j νⱼ(A) = 0`, so `liminf_j Gⱼ = 0` a.e.
  have hHm : Measurable fun t => liminf (fun j => G j t) atTop := Measurable.liminf hGm
  have hHint : ∫⁻ t, liminf (fun j => G j t) atTop = 0 := by
    refine le_antisymm ?_ zero_le
    calc ∫⁻ t, liminf (fun j => G j t) atTop ≤ liminf (fun j => ∫⁻ t, G j t) atTop :=
          lintegral_liminf_le hGm
      _ ≤ liminf (fun j => ν j A) atTop := liminf_le_liminf (Eventually.of_forall hGint)
      _ = 0 := hνlim.liminf_eq
  have hH0 : ∀ᵐ t, liminf (fun j => G j t) atTop = 0 :=
    ((lintegral_eq_zero_iff hHm).1 hHint).mono fun t ht => ht
  -- Step 6: only countably many levels are atoms of the finite measure `κⱼ⌞A`
  have hatomsAE : ∀ᵐ s : ℝ, ∀ j, (κ j).restrict A {x | f x = s} = 0 := by
    rw [ae_all_iff]
    intro j
    have : IsFiniteMeasure ((κ j).restrict A) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact hκfin j⟩
    have hc := Measure.countable_meas_level_set_pos (μ := (κ j).restrict A) hf
    filter_upwards [hc.ae_notMem (volume : Measure ℝ)] with s hs
    simp only [not_lt, nonpos_iff_eq_zero] at hs
    exact hs
  -- Step 7: a.e. level in the interval `(a, b)` of positive length is good
  have hIoo : volume (Ioo a b) ≠ 0 := by
    rw [Real.volume_Ioo]
    simpa using hab
  have : (ae (volume.restrict (Ioo a b))).NeBot :=
    ae_neBot.2 (by rw [Ne, Measure.restrict_eq_zero]; exact hIoo)
  have hgood : ∀ᵐ s ∂(volume.restrict (Ioo a b)), s ∈ Ioo a b ∧
      liminf (fun j => G j s) atTop = 0 ∧ (∀ j, G j s < ∞) ∧
      ∀ j, (κ j).restrict A {x | f x = s} = 0 := by
    filter_upwards [ae_restrict_mem measurableSet_Ioo, ae_restrict_of_ae hH0,
      ae_restrict_of_ae hGfin, ae_restrict_of_ae hatomsAE] with s h1 h2 h3 h4
    exact ⟨h1, h2, h3, h4⟩
  obtain ⟨t, ht, hHt, hGt, hκt⟩ := hgood.exists
  -- Step 9: `Dⱼ(t) ≤ Gⱼ(t)`, along `hₖ = 1/(k + 1)` with `{t − hₖ < f < t} ⊆ A` for large `k`
  have hlink : ∀ j, liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * ν j {x | t - h < f x ∧ f x < t})
      (𝓝[>] 0) ≤ G j t := by
    intro j
    have hseq : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
        Eventually.of_forall fun k => ?_⟩
      show (0 : ℝ) < 1 / ((k : ℝ) + 1)
      positivity
    have hle := liminf_le_liminf_of_le
      (u := fun h : ℝ => ENNReal.ofReal h⁻¹ * ν j {x | t - h < f x ∧ f x < t}) hseq
    refine hle.trans (le_of_eq ?_)
    rw [hG]
    show liminf ((fun h : ℝ => ENNReal.ofReal h⁻¹ * ν j {x | t - h < f x ∧ f x < t}) ∘
      fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop = _
    apply liminf_congr
    have hsmall : ∀ᶠ k : ℕ in atTop, 1 / ((k : ℝ) + 1) < t - a :=
      tendsto_one_div_add_atTop_nhds_zero_nat.eventually (gt_mem_nhds (sub_pos.2 ht.1))
    filter_upwards [hsmall] with k hk
    simp only [Function.comp_apply]
    have h1 : ENNReal.ofReal (1 / ((k : ℝ) + 1))⁻¹ = (k : ℝ≥0∞) + 1 := by
      rw [one_div, inv_inv, ENNReal.ofReal_add (by positivity) zero_le_one,
        ENNReal.ofReal_natCast, ENNReal.ofReal_one]
    have h2 : ν j {x | t - 1 / ((k : ℝ) + 1) < f x ∧ f x < t} =
        ρ j (Ioo (t - 1 / ((k : ℝ) + 1)) t) := by
      rw [hρapp j _ measurableSet_Ioo]
      congr 1
      ext x
      simp only [mem_ofPred_eq, mem_inter_iff, mem_preimage, mem_Ioo, hA]
      constructor
      · rintro ⟨h3, h4⟩
        refine ⟨⟨h3, h4⟩, ?_, ?_⟩ <;> linarith [ht.2]
      · rintro ⟨⟨h3, h4⟩, -⟩
        exact ⟨h3, h4⟩
    rw [h1, h2]
  -- Step 11: `liminf_j Gⱼ(t) = 0` gives `φ` strictly increasing with `G_{φ(n)}(t) < 1/(n + 1)`
  have hfreq : ∀ n : ℕ, ∃ᶠ j in atTop, G j t < ((n : ℝ≥0∞) + 1)⁻¹ := by
    intro n
    refine frequently_lt_of_liminf_lt (by isBoundedDefault) ?_
    rw [hHt]
    exact ENNReal.inv_pos.2 (by simp)
  obtain ⟨φ, hφ, hφlt⟩ := extraction_forall_of_frequently hfreq
  refine ⟨t, ht, φ, hφ, fun j => ?_, fun j => (hlink j).trans_lt (hGt j), ?_⟩
  -- Step 8: (i), as `{f = t} ⊆ A`
  · have hsubA : {x | f x = t} ⊆ A := by
      intro x hx
      rw [hA]
      simp only [mem_ofPred_eq] at hx ⊢
      rw [hx]
      exact ht
    have h := hκt j
    rwa [Measure.restrict_apply (measurableSet_eq_fun hf measurable_const),
      inter_eq_left.2 hsubA] at h
  -- Step 11: (iii), `0 ≤ D_{φ(n)}(t) ≤ G_{φ(n)}(t) < 1/(n + 1)`
  · have hinv : Tendsto (fun n : ℕ => ((n : ℝ≥0∞) + 1)⁻¹) atTop (𝓝 0) := by
      have := ENNReal.tendsto_inv_nat_nhds_zero.comp (tendsto_add_atTop_nat 1)
      refine this.congr fun n => ?_
      simp [Function.comp_apply, Nat.cast_add, Nat.cast_one]
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hinv (fun _ => zero_le)
      (fun n => (hlink (φ n)).trans (hφlt n).le)
/-- **Decomposition at one good slicing level** (Simon 7.2.4 (3), (6), (7), for one index).
Put `W = {f < t}`, `F = {f ≤ t}` and `Σ = {f = t}`, with `F` compact and `F ⊆ W₀`.  Restricting
`ρ`, `β` and a representation `σ` of `S'` to `W` represents `A`, `B` and `S'⌞W`.  The error
`∂A − B` vanishes on forms supported off the compact `Σ ⊆ W₀`, so `M_G(∂A − B) ≤ c` for every `G`
and `M_G(∂A) ≤ M_G(B) + c`.  Hence `Y = ∂A` is integer multiplicity by (BR′), `∂Y = 0`,
`spt Y ⊆ F`, and `μ_Q(Σ) ≤ μ_β(Σ ∩ W) + c = c` for every representation `Q` of `Y`;
`Sr = S'⌞W − (∂A − B)` has `M(Sr) ≤ M_W(S') + c ≤ M_{W₀}(S') + c`.  For `spt ω ⊆ W`, `ω` and `dω`
vanish off `W`, so `Y(ω) = ∂R(ω)` and `Sr(ω) = S'(ω)`. -/
theorem Submission.dimred_mbl_lc_sd_level_decomposition : ∀ (P m : ℕ) (R A : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (B S' : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (ρ : IMRep (univ : Set (Euclid P)) (m + 2)) (β : IMRep (univ : Set (Euclid P)) (m + 1)) (f : Euclid P → ℝ) (t : ℝ) (W₀ : Set (Euclid P)) (c : ℝ≥0∞), ρ.Represents R → IsIntegerMultiplicity S' → Continuous f → IsOpen W₀ → IsCompact {x | f x ≤ t} → {x | f x ≤ t} ⊆ W₀ → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), A ω = ∫ x in {x | f x < t}, ρ.orient x ((ω : DifferentialForm (Euclid P) (m + 2)) x) ∂ρ.measure) → (∀ η : TestFormOn (univ : Set (Euclid P)) (m + 1), B η = ∫ x in {x | f x < t}, β.orient x ((η : DifferentialForm (Euclid P) (m + 1)) x) ∂β.measure) → (∀ η : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (η : DifferentialForm (Euclid P) (m + 1))) {x | f x = t} → A.boundary η = B η) → (A.boundary - B).massOn W₀ ≤ c → c ≠ ∞ → (∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity T → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → T.boundary.massOn W < ∞) → IsIntegerMultiplicity T.boundary) → ∃ Y Sr : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Y ∧ Y.boundary = 0 ∧ Y.support ⊆ {x | f x ≤ t} ∧ Sr.mass ≤ S'.massOn W₀ + c ∧ (∀ Q : IMRep (univ : Set (Euclid P)) (m + 1), Q.Represents Y → Q.measure {x | f x = t} ≤ c) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ {x | f x < t} → Y ω = R.boundary ω ∧ Sr ω = S' ω := by
  intro P m R A B S' ρ β f t W₀ c hρR hS' hf hW₀ hFc hFW₀ hA hB hAB hmass hc hBR
  -- Step 0: `W` is open, `Σ` is compact, `W ∩ Σ = ∅` and `W, Σ ⊆ F ⊆ W₀`
  have hWo : IsOpen {x : Euclid P | f x < t} := isOpen_lt hf continuous_const
  have hWm : MeasurableSet {x : Euclid P | f x < t} := hWo.measurableSet
  have hLc : IsCompact {x : Euclid P | f x = t} :=
    hFc.of_isClosed_subset (isClosed_eq hf continuous_const) fun x (hx : f x = t) => le_of_eq hx
  have hLW₀ : {x : Euclid P | f x = t} ⊆ W₀ := fun x (hx : f x = t) => hFW₀ (le_of_eq hx)
  have hWW₀ : {x : Euclid P | f x < t} ⊆ W₀ := fun x (hx : f x < t) => hFW₀ (le_of_lt hx)
  have hWL : Disjoint {x : Euclid P | f x < t} {x : Euclid P | f x = t} :=
    Set.disjoint_left.2 fun x (hx : f x < t) (hx' : f x = t) => ne_of_lt hx hx'
  -- Step 1: restricting `ρ`, `β` and a representation `σ` of `S'` to `W` represents `A`, `B`
  -- and `S'⌞W`, with `μ_{β'} = μ_β⌞W` and `μ_{σ'} = μ_σ⌞W`
  obtain ⟨_A₁, ρ', _hρ'A₁, hρ'c, hρ'm, hρ'o⟩ :=
    Submission.cmc_imRep_locality_restrict_sub.2.1 P (m + 2) univ ρ {x | f x < t} isOpen_univ hWm
  obtain ⟨-, hρ'act⟩ := (Submission.lcmp_imRep_measure_restrict P (m + 2) univ ρ).2.2
    {x | f x < t} ρ' hWm hρ'c hρ'm hρ'o
  have hAim : IsIntegerMultiplicity A := ⟨ρ', fun ω => by rw [hA ω, hρ'act]⟩
  obtain ⟨_B₁, β', _hβ'B₁, hβ'c, hβ'm, hβ'o⟩ :=
    Submission.cmc_imRep_locality_restrict_sub.2.1 P (m + 1) univ β {x | f x < t} isOpen_univ hWm
  obtain ⟨hβ'meas, hβ'act⟩ := (Submission.lcmp_imRep_measure_restrict P (m + 1) univ β).2.2
    {x | f x < t} β' hWm hβ'c hβ'm hβ'o
  have hβ'B : β'.Represents B := fun η => by rw [hB η, hβ'act]
  obtain ⟨σ, hσ⟩ := hS'
  obtain ⟨S'W, σ', hσ'S'W, hσ'c, hσ'm, hσ'o⟩ :=
    Submission.cmc_imRep_locality_restrict_sub.2.1 P (m + 1) univ σ {x | f x < t} isOpen_univ hWm
  obtain ⟨hσ'meas, hσ'act⟩ := (Submission.lcmp_imRep_measure_restrict P (m + 1) univ σ).2.2
    {x | f x < t} σ' hWm hσ'c hσ'm hσ'o
  -- Step 2: `∂A − B` kills forms supported off the compact `Σ ⊆ W₀`, so `M_G(∂A − B) ≤ c`
  have hPvan : ∀ η : TestFormOn (univ : Set (Euclid P)) (m + 1),
      Disjoint (tsupport (η : DifferentialForm (Euclid P) (m + 1))) {x | f x = t} →
        (A.boundary - B) η = 0 := fun η hη => by
    show A.boundary η - B η = 0
    rw [hAB η hη, sub_self]
  have hPle : ∀ G : Set (Euclid P), (A.boundary - B).massOn G ≤ c := fun G =>
    (Submission.lcmp_massOn_le_of_vanish_off_compact P (m + 1) univ W₀ {x | f x = t}
      (A.boundary - B) hLc hW₀ hLW₀ hPvan G).trans hmass
  -- Step 3: `∂A = B + 1 · (∂A − B)`, so `M_G(∂A) ≤ M_G(B) + c`
  have hYB : ∀ G : Set (Euclid P), A.boundary.massOn G ≤ B.massOn G + c := fun G =>
    (Submission.lcmp_massOn_le_add_of_eval_eq P (m + 1) univ G B (A.boundary - B) A.boundary 1
      (by norm_num) fun ω _ => by
        show A.boundary ω = B ω + 1 * (A.boundary ω - B ω)
        ring).trans (add_le_add le_rfl (hPle G))
  -- Step 4: `M_G(∂A) ≤ μ_{β'}(closure G) + c < ∞` for `G ⊂⊂ ℝᴾ`, so `Y = ∂A` is integer
  -- multiplicity by (BR′)
  have hβ'fin := (Submission.cbr_imRep_measure_basic P (m + 1) univ β').2.2.2.2.1
  have hβ'mass := (Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ B β'
    isOpen_univ hβ'B).1
  have hYim : IsIntegerMultiplicity A.boundary := by
    refine hBR A hAim fun G hG hGcc => ?_
    calc A.boundary.massOn G ≤ B.massOn G + c := hYB G
      _ = β'.measure G + c := by rw [hβ'mass G hG]
      _ ≤ β'.measure (closure G) + c := add_le_add (measure_mono subset_closure) le_rfl
      _ < ∞ := ENNReal.add_lt_top.2 ⟨hβ'fin _ hGcc.1 (subset_univ _), lt_top_iff_ne_top.2 hc⟩
  -- Step 5: if `spt η ∩ F = ∅` then `dη = 0` on `W ⊆ F`, so `Y(η) = A(dη) = 0`; hence `spt Y ⊆ F`
  have hYspt : A.boundary.support ⊆ {x | f x ≤ t} := by
    refine (Submission.rsd_cmr_support_subset_of_vanish P (m + 1) univ {x | f x ≤ t} A.boundary
      isOpen_univ hFc (subset_univ _) fun η hη => ?_).1
    show A (exteriorDerivativeTestOn univ (m + 1) η) = 0
    rw [hA]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x (hx : f x < t) => ?_
    have h0 : exteriorDerivative (η : DifferentialForm (Euclid P) (m + 1)) x = 0 :=
      image_eq_zero_of_notMem_tsupport fun h =>
        Set.disjoint_left.1 hη (tsupport_exteriorDerivative_subset _ h) (le_of_lt hx)
    show ρ.orient x (exteriorDerivative (η : DifferentialForm (Euclid P) (m + 1)) x) = 0
    rw [h0, map_zero]
  refine ⟨A.boundary, S'W - (A.boundary - B), hYim, GeometricCurrentOn.boundary_boundary A,
    hYspt, ?_, ?_, ?_⟩
  -- Step 6: `Sr = S'⌞W + (−1)(∂A − B)`, so `M(Sr) ≤ M(S'⌞W) + c = M_W(S') + c ≤ M_{W₀}(S') + c`
  · have h1 := Submission.lcmp_massOn_le_add_of_eval_eq P (m + 1) univ univ S'W (A.boundary - B)
      (S'W - (A.boundary - B)) (-1) (by norm_num) fun ω _ => by
        show S'W ω - (A.boundary - B) ω = S'W ω + -1 * (A.boundary - B) ω
        ring
    have h2 : S'W.massOn univ = S'.massOn {x | f x < t} := by
      rw [(Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ S'W σ' isOpen_univ
        hσ'S'W).1 univ isOpen_univ, hσ'meas, Measure.restrict_apply_univ,
        (Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ S' σ isOpen_univ
        hσ).1 _ hWo]
    calc (S'W - (A.boundary - B)).mass
        ≤ S'W.massOn univ + (A.boundary - B).massOn univ := h1
      _ ≤ S'.massOn W₀ + c := by
        rw [h2]
        exact add_le_add (S'.massOn_mono hWW₀) (hPle univ)
  -- Step 7: `μ_Q(G) = M_G(Y) ≤ μ_{β'}(G) + c` for open `G ⊇ Σ`, so
  -- `μ_Q(Σ) ≤ μ_{β'}(Σ) + c = μ_β(Σ ∩ W) + c = c`
  · intro Q hQ
    have hQmass := (Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ A.boundary Q
      isOpen_univ hQ).1
    have h := Submission.lcmp_measure_le_add_of_open_nhds P univ {x | f x = t} Q.measure
      β'.measure c isOpen_univ hLc (subset_univ _) (fun K hK _ => hβ'fin K hK (subset_univ K))
      fun G hG _ _ => by
        rw [← hQmass G hG, ← hβ'mass G hG]
        exact hYB G
    have h0 : β'.measure {x | f x = t} = 0 := by
      rw [hβ'meas, Measure.restrict_apply' hWm, Set.disjoint_iff_inter_eq_empty.1 hWL.symm,
        measure_empty]
    rwa [h0, zero_add] at h
  -- Step 8: for `spt ω ⊆ W`, `ω` and `dω` vanish off `W`
  · intro ω hω
    have hωW : ∀ x, x ∉ {x : Euclid P | f x < t} →
        (ω : DifferentialForm (Euclid P) (m + 1)) x = 0 :=
      fun x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hω h)
    have hdωW : ∀ x, x ∉ {x : Euclid P | f x < t} →
        exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x = 0 :=
      fun x hx => image_eq_zero_of_notMem_tsupport fun h =>
        hx (hω (tsupport_exteriorDerivative_subset _ h))
    constructor
    -- (a) `Y(ω) = ∫_W ξ_ρ(dω) dμ_ρ = ∫ ξ_ρ(dω) dμ_ρ = ρ(dω) = R(dω) = ∂R(ω)`
    · show A (exteriorDerivativeTestOn univ (m + 1) ω) = R (exteriorDerivativeTestOn univ (m + 1) ω)
      rw [hA, hρR (exteriorDerivativeTestOn univ (m + 1) ω),
        (Submission.cbr_imRep_measure_basic P (m + 2) univ ρ).2.2.2.2.2.2]
      refine setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_
      show ρ.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x) = 0
      rw [hdωW x hx, map_zero]
    -- (b) `(∂A − B)(ω) = 0` and `S'⌞W(ω) = ∫_W ξ_σ(ω) dμ_σ = ∫ ξ_σ(ω) dμ_σ = σ(ω) = S'(ω)`
    · show S'W ω - (A.boundary - B) ω = S' ω
      rw [hPvan ω (Set.disjoint_of_subset_left hω hWL), sub_zero, hσ'S'W ω, hσ'act, hσ ω,
        (Submission.cbr_imRep_measure_basic P (m + 1) univ σ).2.2.2.2.2.2]
      refine setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_
      rw [hωW x hx, map_zero]
/-- **Lipschitz cut-off adapted to a compact set** (Simon 7.2.4, step 2 of the proof).  If `U` is
open, `K ⊆ U` is compact and `ε > 0`, there is an `L`-Lipschitz `ψ : ℝᴾ → [0, 1]` with `ψ = 1` on
`K` whose positivity set `W₀ = {ψ > 0}` lies in the `ε`-thickening of `K` and satisfies `W₀ ⊂⊂ U`.
For `K = ∅` take `ψ ≡ 0`.  Otherwise choose `δ > 0` with `cthickening δ K ⊆ U`, put
`r = min δ ε` and `ψ = max 0 (1 - dist(·, K) / r)`: it is `1/r`-Lipschitz and
`W₀ = thickening r K`, whose closure lies in the compact `cthickening r K ⊆ cthickening δ K ⊆ U`. -/
theorem Submission.lcmp_exists_lipschitz_cutoff : ∀ (P : ℕ) (U K : Set (Euclid P)) (ε : ℝ), IsOpen U → IsCompact K → K ⊆ U → 0 < ε → ∃ (ψ : Euclid P → ℝ) (L : NNReal), LipschitzWith L ψ ∧ (∀ x, 0 ≤ ψ x ∧ ψ x ≤ 1) ∧ (∀ x ∈ K, ψ x = 1) ∧ {x | 0 < ψ x} ⊆ thickening ε K ∧ CompactlyContained {x | 0 < ψ x} U := by
  intro P U K ε hU hK hKU hε
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · -- Step 1: `K = ∅`; `ψ ≡ 0` and `L = 0`, so `W₀ = ∅`
    have hempty : {x : Euclid P | (0 : ℝ) < (fun _ : Euclid P => (0 : ℝ)) x} = ∅ := by
      ext x
      simp
    refine ⟨fun _ => 0, 0, LipschitzWith.const 0, fun x => ⟨le_rfl, zero_le_one⟩,
      fun x hx => absurd hx (Set.notMem_empty x), ?_, ?_⟩
    · rw [hempty]
      exact empty_subset _
    · rw [hempty]
      exact ⟨by simp, by simp⟩
  -- Step 2: `cthickening δ K ⊆ U`, `r = min δ ε`, `ψ = max 0 (1 - dist(·, K) / r)`, `L = 1/r`
  obtain ⟨δ, hδ, hδU⟩ := hK.exists_cthickening_subset_open hU hKU
  set r : ℝ := min δ ε with hr
  have hr0 : 0 < r := lt_min hδ hε
  set ψ : Euclid P → ℝ := fun x => max 0 (1 - infDist x K / r) with hψ
  -- Step 3: `dist(·, K)` is `1`-Lipschitz, so `1 - dist(·, K) / r` is `1/r`-Lipschitz, and taking
  -- the maximum with `0` keeps the constant
  have hlip0 : LipschitzWith (Real.toNNReal (1 / r)) fun x : Euclid P => 1 - infDist x K / r := by
    refine LipschitzWith.of_dist_le_mul fun x y => ?_
    rw [Real.dist_eq]
    have h1 : (1 - infDist x K / r) - (1 - infDist y K / r) = (infDist y K - infDist x K) / r := by
      ring
    have h2 : |infDist x K - infDist y K| ≤ dist x y := by
      have := (lipschitz_infDist_pt K).dist_le_mul x y
      rwa [Real.dist_eq, NNReal.coe_one, one_mul] at this
    rw [h1, abs_div, abs_of_pos hr0, Real.coe_toNNReal _ (by positivity), abs_sub_comm]
    calc |infDist x K - infDist y K| / r ≤ dist x y / r := by gcongr
      _ = 1 / r * dist x y := by ring
  have hlip : LipschitzWith (Real.toNNReal (1 / r)) ψ := hlip0.const_max 0
  -- Step 6: `ψ x > 0 ↔ dist(x, K) < r`, i.e. `W₀ = thickening r K` (uses `K ≠ ∅`)
  have hpos : {x | 0 < ψ x} = thickening r K := by
    ext x
    rw [mem_thickening_iff_infDist_lt hKne]
    simp only [hψ, mem_ofPred_eq, lt_max_iff, lt_irrefl, false_or, sub_pos]
    rw [div_lt_one hr0]
  refine ⟨ψ, Real.toNNReal (1 / r), hlip, fun x => ⟨le_max_left _ _, max_le zero_le_one ?_⟩,
    fun x hx => ?_, ?_, ?_⟩
  · -- Step 4: `1 - dist(x, K) / r ≤ 1`, so `0 ≤ ψ ≤ 1`
    have : 0 ≤ infDist x K / r := div_nonneg infDist_nonneg hr0.le
    linarith
  · -- Step 5: `dist(x, K) = 0` on `K`, so `ψ = 1` there
    simp [hψ, infDist_zero_of_mem hx]
  · -- Step 7: `W₀ = thickening r K ⊆ thickening ε K` as `r ≤ ε`
    rw [hpos]
    exact thickening_mono (min_le_right _ _) K
  · -- Step 8: `closure W₀ ⊆ cthickening r K ⊆ cthickening δ K ⊆ U`, and `cthickening r K` is
    -- compact, so its closed subset `closure W₀` is compact
    rw [hpos]
    have hcl : closure (thickening r K) ⊆ cthickening r K :=
      closure_thickening_subset_cthickening r K
    exact ⟨hK.cthickening.of_isClosed_subset isClosed_closure hcl,
      (hcl.trans (cthickening_mono (min_le_left _ _) K)).trans hδU⟩

/-- **Good-level slice decomposition** (Simon 7.2.4 (1)–(7), steps 2 and 4–6 of the proof).
Take a Lipschitz cut-off `ψ` with `ψ = 1` on `K`, `W₀ = {ψ > 0} ⊂⊂ ℝᴾ` inside the
`ε`-thickening of `K`, and slice by `f = -ψ`.  (FL′) on `W₀` gives `C - Ŝⱼ - S'ⱼ = ∂Rⱼ` with
`M_{W₀}(Rⱼ) + M_{W₀}(S'ⱼ) → 0`; (SL′) slices `Rⱼ` and `∂Rⱼ` through their representations.
`good_slice_level` with `νⱼ = μ_{R_{j+j₁}}⌞W₀`, `κ'ⱼ = κ_{j+j₁}` (finite near `W₀` for `j ≥ j₁`)
on `{-1 < f < 0}` gives a level `t` and `φ` with `κ`-null level set and difference quotients
`D_{φ(k)+j₁} → 0`.  Then `W = {f < t}`, `F = {f ≤ t}`, `φ'(i) = φ(i) + j₁`, and the
decomposition at the level `t` for the index `φ'(i)` gives `Ŷᵢ`, `Srᵢ` with
`eᵢ = M_{W₀}(S'_{φ'(i)}) + L·D_{φ'(i)} → 0`. -/
theorem Submission.dimred_mbl_lc_slice_decomposition : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (Ŝ : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (κ : ℕ → Measure (Euclid P)) (K : Set (Euclid P)) (ε : ℝ), IsIntegerMultiplicity C → (∀ j, IsIntegerMultiplicity (Ŝ j)) → (∀ W₀ : Set (Euclid P), IsOpen W₀ → CompactlyContained W₀ univ → ∃ (R : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S' : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ j, IsIntegerMultiplicity (R j) ∧ IsIntegerMultiplicity (S' j) ∧ C - Ŝ j - S' j = (R j).boundary) ∧ Tendsto (fun j => (R j).massOn W₀ + (S' j).massOn W₀) atTop (𝓝 0)) → (∀ (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (m + 2)) (ξ' : Euclid P → MultiVector P (m + 1)) (f : Euclid P → ℝ) (L : NNReal), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (m + 2), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) (m + 1), |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (m + 2)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) (m + 1), T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) (m + 1)) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (B : ℝ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ (t : ℝ) (ω : TestFormOn (univ : Set (Euclid P)) (m + 2)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (m + 2)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn (univ : Set (Euclid P)) (m + 1)), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) (m + 1)) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn (univ : Set (Euclid P)) (m + 1)), Disjoint (tsupport (η : DifferentialForm (Euclid P) (m + 1))) {x | f x = t} → (A t).boundary η = B t η) ∧ ∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → (∀ R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) → (∀ r : ℝ, ∀ᶠ j in atTop, κ j (ball 0 r) ≠ ∞) → IsCompact K → 0 < ε → ∃ (W F : Set (Euclid P)) (φ' : ℕ → ℕ) (e : ℕ → ℝ≥0∞) (Ŷ Sr : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsOpen W ∧ IsCompact F ∧ K ⊆ W ∧ W ⊆ F ∧ W ⊆ thickening ε K ∧ StrictMono φ' ∧ Tendsto e atTop (𝓝 0) ∧ ∀ i, IsIntegerMultiplicity (Ŷ i) ∧ (Ŷ i).boundary = 0 ∧ (Ŷ i).support ⊆ F ∧ (Sr i).mass ≤ e i ∧ (∀ R : IMRep (univ : Set (Euclid P)) (m + 1), R.Represents (Ŷ i) → R.measure (F \ W) ≤ e i) ∧ κ (φ' i) (F \ W) = 0 ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ W → C ω = Ŝ (φ' i) ω + Ŷ i ω + Sr i ω := by
  intro P m C Ŝ κ K ε hC hŜ hFL hSL hBR hκ hK hε
  -- Step 1: an `L`-Lipschitz cut-off `ψ`, `W₀ = {ψ > 0} ⊂⊂ ℝᴾ` and the slicing function `f = -ψ`
  obtain ⟨ψ, L, hψL, -, hψK, hψthick, hψcc⟩ :=
    Submission.lcmp_exists_lipschitz_cutoff P univ K ε isOpen_univ hK (subset_univ K) hε
  set W₀ : Set (Euclid P) := {x | 0 < ψ x}
  have hW₀o : IsOpen W₀ := isOpen_lt continuous_const hψL.continuous
  have hW₀m : MeasurableSet W₀ := hW₀o.measurableSet
  obtain ⟨f, hf⟩ : ∃ f : Euclid P → ℝ, ∀ x, f x = -ψ x := ⟨fun x => -ψ x, fun _ => rfl⟩
  have hfL : LipschitzWith L f := by
    rw [show f = fun x => -ψ x from funext hf]
    exact hψL.neg
  have hfc : Continuous f := hfL.continuous
  -- Step 2: (FL′) on `W₀` gives `C - Ŝⱼ - S'ⱼ = ∂Rⱼ` and `M_{W₀}(Rⱼ) + M_{W₀}(S'ⱼ) → 0`;
  -- `∂Rⱼ` is integer multiplicity, and we fix representations `ρⱼ` of `Rⱼ`, `βⱼ` of `∂Rⱼ`
  obtain ⟨R, S', hRS, hRSlim⟩ := hFL W₀ hW₀o hψcc
  have hRrep : ∀ j, ∃ ρ : IMRep (univ : Set (Euclid P)) (m + 2), ρ.Represents (R j) :=
    fun j => (hRS j).1
  have hbdrep : ∀ j, ∃ β : IMRep (univ : Set (Euclid P)) (m + 1), β.Represents (R j).boundary :=
    fun j => by
      rw [← (hRS j).2.2]
      exact Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ _ _ isOpen_univ
        (Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ _ _ isOpen_univ hC (hŜ j))
        (hRS j).2.1
  choose ρ hρ using hRrep
  choose β hβ using hbdrep
  have hρb := fun j => Submission.cbr_imRep_measure_basic P (m + 2) univ (ρ j)
  have hβb := fun j => Submission.cbr_imRep_measure_basic P (m + 1) univ (β j)
  -- Step 3: (SL′) slices `Rⱼ` (with `μ = μ_{ρⱼ}`, `μ' = μ_{βⱼ}`) by the `L`-Lipschitz `f`
  have hslice := fun j => hSL (R j) (ρ j).measure (β j).measure (ρ j).orient (β j).orient f L
    (fun K' hK' => (hρb j).2.2.2.2.1 K' hK' (subset_univ K'))
    (fun K' hK' => (hβb j).2.2.2.2.1 K' hK' (subset_univ K'))
    (hρb j).2.2.2.2.2.1 (hβb j).2.2.2.2.2.1
    ((hρb j).1.ae_le (Submission.cmc_imRep_locality_restrict_sub.2.2.2 P (m + 2) univ (ρ j)))
    ((hβb j).1.ae_le (Submission.cmc_imRep_locality_restrict_sub.2.2.2 P (m + 1) univ (β j)))
    (fun ω => by rw [hρ j ω, (hρb j).2.2.2.2.2.2]) (fun η => by rw [hβ j η, (hβb j).2.2.2.2.2.2])
    hfL
  choose A B hA hB hAB hABm using hslice
  -- Step 4: `μ_{ρⱼ}(W₀) = M_{W₀}(Rⱼ) < ∞` and `M_{W₀}(Rⱼ), M_{W₀}(S'ⱼ) → 0`
  have hRW₀ : ∀ j, (ρ j).measure W₀ = (R j).massOn W₀ := fun j =>
    ((Submission.dor_imrep_massOn_eq_measure_and_support P (m + 2) univ (R j) (ρ j) isOpen_univ
      (hρ j)).1 W₀ hW₀o).symm
  have hRfin : ∀ j, (R j).massOn W₀ < ∞ := fun j => by
    rw [← hRW₀ j]
    exact (measure_mono subset_closure).trans_lt ((hρb j).2.2.2.2.1 _ hψcc.1 (subset_univ _))
  have hRlim : Tendsto (fun j => (R j).massOn W₀) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hRSlim (fun _ => zero_le)
      fun _ => le_self_add
  have hS'lim : Tendsto (fun j => (S' j).massOn W₀) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hRSlim (fun _ => zero_le)
      fun _ => le_add_self
  have hν : ∀ j s, (ρ j).measure.restrict W₀ s ≤ (R j).massOn W₀ := fun j s =>
    calc (ρ j).measure.restrict W₀ s ≤ (ρ j).measure.restrict W₀ univ :=
          measure_mono (subset_univ s)
      _ = (ρ j).measure W₀ := Measure.restrict_apply_univ W₀
      _ = (R j).massOn W₀ := hRW₀ j
  -- Step 5: `κⱼ` is finite on a ball containing `closure W₀` for `j ≥ j₁`; `good_slice_level`
  -- with `νⱼ = μ_{ρ_{j+j₁}}⌞W₀` and `κ_{j+j₁}` on `{-1 < f < 0} ⊆ W₀` gives `t` and `φ`
  obtain ⟨r₀, hr₀⟩ := hψcc.1.isBounded.subset_ball (0 : Euclid P)
  obtain ⟨j₁, hj₁⟩ := Filter.eventually_atTop.1 (hκ r₀)
  have hA'W₀ : {x | -1 < f x ∧ f x < 0} ⊆ W₀ := fun x hx => by
    have h := hx.2
    rw [hf] at h
    show 0 < ψ x
    linarith
  obtain ⟨t, ⟨ht1, ht0⟩, φ, hφ, hκt, hDfin, hDlim⟩ := Submission.lcmp_exists_good_slice_level P
    (fun j => (ρ (j + j₁)).measure.restrict W₀) (fun j => κ (j + j₁)) f (-1) 0 hfc.measurable
    (by norm_num) (fun j => (hν (j + j₁) _).trans_lt (hRfin (j + j₁)))
    (tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
      (hRlim.comp (tendsto_add_atTop_nat j₁)) (fun _ => zero_le) fun j => hν (j + j₁) _)
    fun j => (measure_mono (hA'W₀.trans (subset_closure.trans hr₀))).trans_lt
      (lt_top_iff_ne_top.2 (hj₁ (j + j₁) (Nat.le_add_left j₁ j)))
  -- Step 6: `W = {f < t}`, `F = {f ≤ t} ⊆ W₀` is compact, `F \ W = {f = t}`
  have hFW₀ : {x | f x ≤ t} ⊆ W₀ := fun x hx => by
    have h : f x ≤ t := hx
    rw [hf] at h
    show 0 < ψ x
    linarith
  have hFc : IsCompact {x | f x ≤ t} :=
    hψcc.1.of_isClosed_subset (isClosed_le hfc continuous_const) (hFW₀.trans subset_closure)
  have hFW : {x | f x ≤ t} \ {x | f x < t} = {x | f x = t} := by
    ext x
    simp only [Set.mem_sdiff, mem_ofPred_eq, not_lt]
    exact ⟨fun h => le_antisymm h.1 h.2, fun h => ⟨h.le, h.ge⟩⟩
  -- Step 7: the difference quotients `Dⱼ = liminf_{h↓0} h⁻¹ μ_{ρⱼ}(W₀ ∩ {t - h < f < t})`
  obtain ⟨D, hD⟩ : ∃ D : ℕ → ℝ≥0∞, ∀ j, D j = liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ *
      (ρ j).measure (W₀ ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0) := ⟨_, fun _ => rfl⟩
  have hDν : ∀ k, D (k + j₁) = liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ *
      (ρ (k + j₁)).measure.restrict W₀ {x | t - h < f x ∧ f x < t}) (𝓝[>] 0) := fun k => by
    rw [hD]
    congr 1
    funext h
    rw [Measure.restrict_apply' hW₀m, inter_comm]
  have hDfin' : ∀ k, D (k + j₁) ≠ ∞ := fun k => by
    rw [hDν]
    exact (hDfin k).ne
  -- Step 8: the decomposition at the level `t` for the index `φ(i) + j₁`
  have hlevel := fun i => Submission.dimred_mbl_lc_sd_level_decomposition P m (R (φ i + j₁))
    (A (φ i + j₁) t) (B (φ i + j₁) t) (S' (φ i + j₁)) (ρ (φ i + j₁)) (β (φ i + j₁)) f t W₀
    ((L : ℝ≥0∞) * D (φ i + j₁)) (hρ _) (hRS _).2.1 hfc hW₀o hFc hFW₀ (hA _ t) (hB _ t) (hAB _ t)
    (by rw [hD]; exact hABm _ W₀ t hW₀o) (ENNReal.mul_ne_top ENNReal.coe_ne_top (hDfin' _)) hBR
  choose Y Sr hY using hlevel
  have hφ' : StrictMono fun i => φ i + j₁ := fun a b hab => Nat.add_lt_add_right (hφ hab) j₁
  refine ⟨{x | f x < t}, {x | f x ≤ t}, fun i => φ i + j₁,
    fun i => (S' (φ i + j₁)).massOn W₀ + (L : ℝ≥0∞) * D (φ i + j₁), Y, Sr,
    isOpen_lt hfc continuous_const, hFc, fun x hx => ?_,
    fun x (hx : f x < t) => show f x ≤ t from le_of_lt hx, fun x hx => ?_,
    hφ', ?_, fun i => ?_⟩
  -- Step 9: `K ⊆ W` (`f = -1 < t` on `K`) and `W ⊆ W₀ ⊆ thickening ε K`
  · show f x < t
    rw [hf, hψK x hx]
    linarith
  · refine hψthick (show 0 < ψ x from ?_)
    have h : f x < t := hx
    rw [hf] at h
    linarith
  -- Step 10: `eᵢ = M_{W₀}(S'_{φ'(i)}) + L·D_{φ'(i)} → 0`
  · have h1 := hS'lim.comp hφ'.tendsto_atTop
    have h2 : Tendsto (fun i => D (φ i + j₁)) atTop (𝓝 0) :=
      hDlim.congr fun i => (hDν (φ i)).symm
    have h3 := ENNReal.Tendsto.const_mul h2 (Or.inr (ENNReal.coe_ne_top (r := L)))
    rw [mul_zero] at h3
    have h4 := h1.add h3
    rw [add_zero] at h4
    exact h4
  -- Step 11: the properties of `Ŷᵢ` and `Srᵢ`
  · obtain ⟨hYim, hYbd, hYspt, hSrm, hYmeas, hYSr⟩ := hY i
    refine ⟨hYim, hYbd, hYspt, hSrm, fun Q hQ => ?_, ?_, fun ω hω => ?_⟩
    · rw [hFW]
      exact (hYmeas Q hQ).trans le_add_self
    · rw [hFW]
      exact hκt (φ i)
    · obtain ⟨h1, h2⟩ := hYSr ω hω
      have h3 : (C - Ŝ (φ i + j₁) - S' (φ i + j₁)) ω = (R (φ i + j₁)).boundary ω := by
        rw [(hRS _).2.2]
      change C ω - Ŝ (φ i + j₁) ω - S' (φ i + j₁) ω = _ at h3
      show C ω = Ŝ (φ i + j₁) ω + Y i ω + Sr i ω
      rw [h1, h2]
      linarith
/-- **Restriction of `T = τ(M, θ, ξ)` to a relatively compact Borel set, as a current in `ℝᴾ`**
(Simon Ch. 6, 3.1–3.2 and 2.11).  Let `U` be open, `μ = θ Hⁿ⌞M` and `E` Borel with `E ⊆ K ⊆ U`,
`K` compact.  By the restriction calculus, `R' = (M ∩ E, θ, ξ)` and `R₁ = (M ∖ E, θ, ξ)` are
integer multiplicity triples in `U`, with weights `μ⌞E`, `μ⌞(ℝᴾ ∖ E)` and actions
`∫_E ⟨ω, ξ⟩ dμ`, `∫_{ℝᴾ∖E} ⟨ω, ξ⟩ dμ`; let `T₁` be the current of `R₁`.  As `E ⊆ K`, `M ∩ E` is
locally `Hⁿ`-finite in all of `ℝᴾ`, so `R'` is also a triple in `ℝᴾ` and defines `Q`.  For
`ω ∈ 𝒟ⁿ(U)` the function `⟨ω, ξ⟩` is `μ`-integrable (bounded by `sup |ω|` and supported in the
compact `spt ω`), so `T(ω) = ∫_E + ∫_{ℝᴾ∖E} = Q(ω) + T₁(ω)`, and `T₁(ω) = 0` if `spt ω ⊆ E`.
Finally `spt Q = spt(μ⌞E) ⊆ closure E ∩ spt μ`, `closure E ⊆ K ⊆ U` and `spt T = U ∩ spt μ`;
`spt Q` is closed in the compact `K`, hence compact. -/
theorem Submission.dimred_mbl_lc_rc_restrict_to_univ : ∀ (P n : ℕ) (U E K : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → MeasurableSet E → IsCompact K → E ⊆ K → K ⊆ U → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) n) (RQ : IMRep (univ : Set (Euclid P)) n) (T₁ : GeometricCurrentOn U n) (R₁ : IMRep U n), RQ.Represents Q ∧ RQ.measure = R.measure.restrict E ∧ R₁.Represents T₁ ∧ R₁.measure = R.measure.restrict Eᶜ ∧ (∀ ω : TestFormOn U n, T ω = Q (testFormOnInclusion (subset_univ U) n ω) + T₁ ω) ∧ (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ E → Q (testFormOnInclusion (subset_univ U) n ω) = T ω) ∧ Q.support ⊆ closure E ∩ T.support ∧ IsCompact Q.support := by
  intro P n U E K T R hU hR hE hK hEK hKU
  obtain ⟨-, hrestrict, -, horient⟩ := Submission.cmc_imRep_locality_restrict_sub
  obtain ⟨hac, hξmeas, hIR⟩ := Submission.lcmp_imRep_measure_restrict P n U R
  -- Step 1: `R' = (M ∩ E, θ, ξ)` and `R₁ = (M ∖ E, θ, ξ)` in `U`, with `R₁` representing `T₁`;
  -- `μ_{R'} = μ⌞E`, `μ_{R₁} = μ⌞(ℝᴾ ∖ E)`, and the actions are integrals against `μ`
  obtain ⟨_, R', -, hR'c, hR'm, hR'o⟩ := hrestrict P n U R E hU hE
  obtain ⟨T₁, R₁, hR₁, hR₁c, hR₁m, hR₁o⟩ := hrestrict P n U R Eᶜ hU hE.compl
  obtain ⟨hR'meas, hR'act⟩ := hIR E R' hE hR'c hR'm hR'o
  obtain ⟨hR₁meas, hR₁act⟩ := hIR Eᶜ R₁ hE.compl hR₁c hR₁m hR₁o
  have hRact := (hIR univ R MeasurableSet.univ (inter_univ _).symm rfl rfl).2
  -- Step 2: `(M ∩ E, θ, ξ)` is a triple in `ℝᴾ`: for compact `K'`, `(M ∩ E) ∩ K' ⊆ (M ∩ E) ∩ K`
  obtain ⟨R₂, hR₂c, hR₂m, hR₂o⟩ : ∃ R₂ : IMRep (univ : Set (Euclid P)) n,
      R₂.carrier = R'.carrier ∧ R₂.mult = R'.mult ∧ R₂.orient = R'.orient :=
    ⟨{ carrier := R'.carrier
       mult := R'.mult
       orient := R'.orient
       measurableSet_carrier := R'.measurableSet_carrier
       carrier_subset := subset_univ _
       rectifiable := R'.rectifiable
       measurable_mult := R'.measurable_mult
       mult_pos := R'.mult_pos
       locallyIntegrable_mult := fun K' _ _ =>
         ne_top_of_le_ne_top (R'.locallyIntegrable_mult K hK hKU)
           (lintegral_mono_set fun x hx => ⟨hx.1, hEK (hR'c.subset hx.1).2⟩)
       aestronglyMeasurable_orient := R'.aestronglyMeasurable_orient
       orients := R'.orients }, rfl, rfl, rfl⟩
  -- the current `Q = τ(M ∩ E, θ, ξ)` in `ℝᴾ`, with the same triple as `R'`
  obtain ⟨Q, RQ, hRQ, hRQc, hRQm, hRQo⟩ :=
    hrestrict P n univ R₂ univ isOpen_univ MeasurableSet.univ
  have hQc : RQ.carrier = R'.carrier := by rw [hRQc, inter_univ, hR₂c]
  have hQm : RQ.mult = R'.mult := by rw [hRQm, hR₂m]
  have hQo : RQ.orient = R'.orient := by rw [hRQo, hR₂o]
  -- (1) `μ_{R_Q} = μ_{R'} = μ⌞E`, and `Q(ω) = R'(ω) = ∫_E ⟨ω, ξ⟩ dμ`
  have hQmeas : RQ.measure = R.measure.restrict E := by
    rw [← hR'meas]
    unfold IMRep.measure
    rw [hQc, hQm]
  have hQact : ∀ ω : TestFormOn U n, Q (testFormOnInclusion (subset_univ U) n ω) =
      ∫ x in E, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure := by
    intro ω
    rw [hRQ, testFormOnInclusion_coe, ← hR'act (ω : DifferentialForm (Euclid P) n)]
    unfold IMRep.action
    rw [hQc, hQm, hQo]
  -- Step 3: for `ω ∈ 𝒟ⁿ(U)`, `⟨ω, ξ⟩` is `μ`-integrable
  have hint : ∀ ω : TestFormOn U n,
      Integrable (fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x)) R.measure := by
    intro ω
    obtain ⟨⟨hsmooth, hcpt⟩, hωU⟩ := ω.2
    set f : DifferentialForm (Euclid P) n := (ω : DifferentialForm (Euclid P) n)
    -- (a) `x ↦ ξ(x)(ω(x))` is `μ`-a.e. strongly measurable
    have hmeas : AEStronglyMeasurable (fun x => R.orient x (f x)) R.measure :=
      isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable₂ hξmeas
        hsmooth.continuous.aestronglyMeasurable
    -- (b) `|ξ(x)(ω(x))| ≤ |ω(x)| ≤ c` for `μ`-a.e. `x`, and it vanishes off `spt ω`
    have hcont : Continuous fun α : Covector (Euclid P) n => covectorEuclideanNorm α := by
      unfold covectorEuclideanNorm
      refine Continuous.sqrt (continuous_finsetSum _ fun I _ => ?_)
      exact continuous_if_const _ (fun _ => (continuous_eval_const _).pow 2)
        fun _ => continuous_const
    obtain ⟨c, hc⟩ := (hcont.comp hsmooth.continuous).bounded_above_of_compact_support
      (hcpt.comp_left (covectorEuclideanNorm_zero P n))
    have hKm : MeasurableSet (tsupport f) := (isClosed_tsupport f).measurableSet
    have hbound : ∀ᵐ x ∂R.measure, ‖R.orient x (f x)‖ ≤ (tsupport f).indicator (fun _ => c) x := by
      filter_upwards [hac.ae_le (horient P n U R)] with x hx
      by_cases hxK : x ∈ tsupport f
      · rw [indicator_of_mem hxK, Real.norm_eq_abs]
        exact (hx (f x)).trans ((Real.le_norm_self _).trans (hc x))
      · rw [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero, norm_zero]
    -- (c) `μ(spt ω) = ∫_{M ∩ spt ω} θ dHⁿ < ∞`
    have hKfin : R.measure (tsupport f) ≠ ∞ := by
      rw [IMRep.measure, withDensity_apply _ hKm, Measure.restrict_restrict hKm,
        inter_comm (tsupport f) R.carrier]
      exact R.locallyIntegrable_mult _ hcpt hωU
    exact ((integrable_indicator_iff hKm).2 (integrableOn_const hKfin)).mono' hmeas hbound
  -- Step 4, (3): `T(ω) = ∫ ⟨ω, ξ⟩ dμ = ∫_E ⟨ω, ξ⟩ dμ + ∫_{ℝᴾ∖E} ⟨ω, ξ⟩ dμ = Q(ω) + T₁(ω)`
  have hsplit : ∀ ω : TestFormOn U n,
      T ω = Q (testFormOnInclusion (subset_univ U) n ω) + T₁ ω := by
    intro ω
    rw [hR ω, hRact, Measure.restrict_univ, hQact ω, hR₁ ω, hR₁act]
    exact (integral_add_compl hE (hint ω)).symm
  -- Step 5, (4): if `spt ω ⊆ E`, then `ω = 0` off `E`, so `T₁(ω) = 0`
  have hEω : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ E →
      Q (testFormOnInclusion (subset_univ U) n ω) = T ω := by
    intro ω hωE
    have hT₁ : T₁ ω = 0 := by
      rw [hR₁ ω, hR₁act]
      refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
      rw [image_eq_zero_of_notMem_tsupport fun h => hx (hωE h), map_zero]
    rw [hsplit ω, hT₁, add_zero]
  -- Step 6, (5): `spt Q = spt(μ⌞E) ⊆ closure E ∩ spt μ`, `closure E ⊆ K ⊆ U`, `spt T = U ∩ spt μ`
  have hQsupp :=
    (Submission.dor_imrep_massOn_eq_measure_and_support P n univ Q RQ isOpen_univ hRQ).2
  have hTsupp := (Submission.dor_imrep_massOn_eq_measure_and_support P n U T R hU hR).2
  have hclK : closure E ⊆ K := closure_minimal hEK hK.isClosed
  have hsub : Q.support ⊆ closure E ∩ T.support := by
    intro x hx
    rw [hQsupp, hQmeas] at hx
    obtain ⟨hxE, hxμ⟩ := Measure.support_restrict_subset hx.2
    rw [hTsupp]
    exact ⟨hxE, hKU (hclK hxE), hxμ⟩
  refine ⟨Q, RQ, T₁, R₁, hRQ, hQmeas, hR₁, hR₁meas, hsplit, hEω, hsub, ?_⟩
  -- Step 7, (6): `spt Q` is closed and lies in the compact `K`
  refine hK.of_isClosed_subset ?_ fun x hx => hclK (hsub hx).1
  rw [hQsupp]
  exact isClosed_univ.inter Measure.isClosed_support

/-- **Sum of integer multiplicity currents under a push-forward** (Simon 7.2.4 (8)–(9), step 4
of the retraction comparison).  Let `push` preserve differences of integer multiplicity currents
in `ℝᴾ` whose supports are compact subsets of `O`, and let `X`, `Y` be two such currents.  Then
`S = X − ((X − X) − Y)` is integer multiplicity by three uses of (IMC)(c), and
`S(ω) = X(ω) + Y(ω)`.  If `X` vanishes on `W₁ ∋ x` and `Y` on `W₂ ∋ x` (Simon 6.2.11), then `S`
vanishes on `W₁ ∩ W₂`, whose closure lies in the compact `closure W₁`; so
`spt S ⊆ spt X ∪ spt Y`, and `spt S`, being closed, is compact and contained in `O`.  Finally
`S − Y = X`, so `push X = push S − push Y`. -/
theorem Submission.dimred_mbl_lc_rc_push_add : ∀ (P n : ℕ) (O : Set (Euclid P)) (push : GeometricCurrentOn (univ : Set (Euclid P)) n → GeometricCurrentOn (univ : Set (Euclid P)) n) (X Y : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ X₁ X₂ : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity X₁ → IsIntegerMultiplicity X₂ → IsCompact X₁.support → X₁.support ⊆ O → IsCompact X₂.support → X₂.support ⊆ O → push (X₁ - X₂) = push X₁ - push X₂) → IsIntegerMultiplicity X → IsIntegerMultiplicity Y → IsCompact X.support → X.support ⊆ O → IsCompact Y.support → Y.support ⊆ O → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) n, S ω = X ω + Y ω) ∧ S.support ⊆ X.support ∪ Y.support ∧ IsCompact S.support ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) n, push S ω = push X ω + push Y ω := by
  intro P n O push X Y hpush hX hY hXc hXO hYc hYO
  -- Step 1: `S = X − ((X − X) − Y)` is integer multiplicity by (IMC)(c), used three times
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P n univ
  set S : GeometricCurrentOn (univ : Set (Euclid P)) n := X - ((X - X) - Y)
  have hSim : IsIntegerMultiplicity S :=
    hsub _ _ isOpen_univ hX (hsub _ _ isOpen_univ (hsub _ _ isOpen_univ hX hX) hY)
  -- and `S(ω) = X(ω) − ((X(ω) − X(ω)) − Y(ω)) = X(ω) + Y(ω)`
  have hSω : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, S ω = X ω + Y ω := by
    intro ω
    show X ω - ((X ω - X ω) - Y ω) = X ω + Y ω
    ring
  -- Step 2: `spt S ⊆ spt X ∪ spt Y`; if `X` vanishes on `W₁ ∋ x` and `Y` on `W₂ ∋ x`, then
  -- `S` vanishes on `W₁ ∩ W₂`, whose closure lies in the compact `closure W₁`
  have hSsupp : S.support ⊆ X.support ∪ Y.support := by
    rintro x ⟨-, hxS⟩
    by_contra hxXY
    have hxX : x ∈ X.zeroRegion := not_not.1 fun h => hxXY (Or.inl ⟨mem_univ x, h⟩)
    have hxY : x ∈ Y.zeroRegion := not_not.1 fun h => hxXY (Or.inr ⟨mem_univ x, h⟩)
    obtain ⟨W₁, ⟨hW₁o, hW₁c, -, hW₁v⟩, hxW₁⟩ := hxX
    obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hxW₂⟩ := hxY
    refine hxS ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o,
      hW₁c.of_isClosed_subset isClosed_closure (closure_mono inter_subset_left), subset_univ _,
      fun ω hω => ?_⟩, hxW₁, hxW₂⟩
    rw [hSω, hW₁v ω (hω.trans inter_subset_left), hW₂v ω (hω.trans inter_subset_right), add_zero]
  -- Step 3: `spt S` is closed, hence compact inside `spt X ∪ spt Y`, and `spt S ⊆ O`
  have hSc : IsCompact S.support :=
    (hXc.union hYc).of_isClosed_subset (isClosed_univ.sdiff S.isOpen_zeroRegion) hSsupp
  have hSO : S.support ⊆ O := hSsupp.trans (union_subset hXO hYO)
  -- Step 4: `S − Y = X`, so the hypothesis on `push` gives `push X = push S − push Y`
  have hSY : S - Y = X := by
    ext ω
    show S ω - Y ω = X ω
    rw [hSω]
    ring
  have hpXY : push X = push S - push Y := by
    rw [← hSY]
    exact hpush S Y hSim hY hSc hSO hYc hYO
  refine ⟨S, hSim, hSω, hSsupp, hSc, fun ω => ?_⟩
  have h := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) n => T ω) hpXY
  change push X ω = push S ω - push Y ω at h
  linarith
/-- **A cycle supported in `A ∩ W` gives an admissible competitor** (Simon 7.1.1; 7.2.4 and
Remark 7.2.5(2)).  Let `U` be open, `T ∈ 𝒟ₙ(U)` (`n = m + 1`) minimizing in `A`, `W ⊂⊂ U` open,
and `X ∈ 𝒟ₙ(ℝᴾ)` integer multiplicity with `∂X = 0` and `spt X` a compact subset of `A ∩ W`.  If
`Z₁(ω) = T(ω) + X(ω)` for `ω ∈ 𝒟ⁿ(U)`, then `M_W(T) ≤ M_W(Z₁)`.  `Z₁ = T − ((X|_U − X|_U) − X|_U)`
is integer multiplicity, and `∂Z₁ = ∂T + ∂X = ∂T`.  As `(Z₁ − T)(ω) = X(ω)`, each point of `U`
outside `spt X` has a small neighbourhood, compactly contained in `U`, on which `Z₁ − T`
vanishes.  So `spt(Z₁ − T) ⊆ spt X ⊆ A ∩ W`, and `spt(Z₁ − T) = spt X ∖ Z_{Z₁−T}` is compact. -/
theorem Submission.dimred_mbl_lc_rc_cycle_competitor : ∀ (P m : ℕ) (U A W : Set (Euclid P)) (T Z₁ : GeometricCurrentOn U (m + 1)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsOpen U → IsMinimizingIn T A → IsOpen W → CompactlyContained W U → IsIntegerMultiplicity X → X.boundary = 0 → IsCompact X.support → X.support ⊆ A ∩ W → (∀ ω : TestFormOn U (m + 1), Z₁ ω = T ω + X (testFormOnInclusion (subset_univ U) (m + 1) ω)) → T.massOn W ≤ Z₁.massOn W := by
  intro P m U A W T Z₁ X hU hT hW hWU hXim hXb hXc hXA hZ
  obtain ⟨hTim, hmin⟩ := hT
  -- Step 1: `X|_U` is integer multiplicity (RO), hence so is `Z₁ = T − ((X|_U − X|_U) − X|_U)`
  set XU : GeometricCurrentOn U (m + 1) := X.restrictDomain (subset_univ U) with hXU
  have hXUim : IsIntegerMultiplicity XU :=
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 1) univ U (subset_univ U) X hU hXim
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) U
  have hZeq : T - ((XU - XU) - XU) = Z₁ := by
    ext ω
    show T ω - ((XU ω - XU ω) - XU ω) = Z₁ ω
    rw [hZ ω, hXU, GeometricCurrentOn.restrictDomain_apply]
    ring
  have hZim : IsIntegerMultiplicity Z₁ :=
    hZeq ▸ hsub T _ hU hTim (hsub _ XU hU (hsub XU XU hU hXUim hXUim) hXUim)
  -- Step 2: `∂Z₁(η) = T(dη) + X(dη) = ∂T(η) + ∂X(η) = ∂T(η)`
  have hbd : SameBoundary Z₁ T := by
    show Z₁.boundary = T.boundary
    ext η
    have hd : testFormOnInclusion (subset_univ U) (m + 1) (exteriorDerivativeTestOn U m η) =
        exteriorDerivativeTestOn univ m (testFormOnInclusion (subset_univ U) m η) := rfl
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, hZ, hd,
      ← X.boundary_apply, hXb, GeometricCurrentOn.zero_apply, add_zero]
  -- Step 3: `(Z₁ − T)(ω) = X(ω)`, so `spt(Z₁ − T) ⊆ spt X`
  have hspt : (Z₁ - T).support ⊆ X.support := by
    rintro x ⟨hxU, hxZ⟩
    refine ⟨mem_univ x, fun hxX => hxZ ?_⟩
    obtain ⟨V, ⟨hVo, -, -, hVX⟩, hxV⟩ := mem_sUnion.1 hxX
    obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hU x hxU
    have hcl : closure (V ∩ ball x (r / 2)) ⊆ closedBall x (r / 2) :=
      (closure_mono inter_subset_right).trans closure_ball_subset_closedBall
    refine mem_sUnion.2 ⟨V ∩ ball x (r / 2), ⟨hVo.inter isOpen_ball,
      (isCompact_closedBall x (r / 2)).of_isClosed_subset isClosed_closure hcl,
      hcl.trans ((closedBall_subset_ball (half_lt_self hr)).trans hrU), fun ω hω => ?_⟩,
      hxV, mem_ball_self (half_pos hr)⟩
    show Z₁ ω - T ω = 0
    rw [hZ ω, hVX (testFormOnInclusion (subset_univ U) (m + 1) ω) (hω.trans inter_subset_left),
      add_zero, sub_self]
  -- Step 4: `spt(Z₁ − T) = spt X ∖ Z_{Z₁−T}` is compact, as `spt X ⊆ W ⊆ closure W ⊆ U`
  have hcpt : IsCompact (Z₁ - T).support := by
    have heq : (Z₁ - T).support = X.support ∩ ((Z₁ - T).zeroRegion)ᶜ :=
      Subset.antisymm (fun x hx => ⟨hspt hx, hx.2⟩)
        fun x hx => ⟨hWU.2 (subset_closure (hXA hx.1).2), hx.2⟩
    rw [heq]
    exact hXc.inter_right (Z₁ - T).isOpen_zeroRegion.isClosed_compl
  -- Step 5: minimality of `T` against the competitor `Z₁` in `W`
  exact hmin W Z₁ hW hWU hZim hbd hcpt (hspt.trans hXA)
/-- **Subadditivity of integer multiplicity weights on closed sets** (Simon 6.2.5 and
6.3.2(3); Simon 7.2.4, proof).  Let `V` be open and `X = X₁ + X₂` in `𝒟ₙ(V)`, where `X = τ(R)`,
`X₁ = τ(R₁)` and `X₂ = τ(R₂)`.  Then `μ_R(F) ≤ μ_{R₁}(F) + μ_{R₂}(F)` for every closed `F ⊆ V`.
For open `G`, `μ_R(G) = M_G(X) ≤ M_G(X₁) + M_G(X₂) = μ_{R₁}(G) + μ_{R₂}(G)`.  As
`μ_{R₁} + μ_{R₂}` is finite on compact subsets of `V`, the outer bound gives the inequality on
compact `K ⊆ V`, and `F = ⋃_j F ∩ B̄(0, j)` is an increasing union of such sets. -/
theorem Submission.dimred_mbl_lc_rc_measure_le_add_of_closed : ∀ (P n : ℕ) (V F : Set (Euclid P)) (X X₁ X₂ : GeometricCurrentOn V n) (R R₁ R₂ : IMRep V n), IsOpen V → R.Represents X → R₁.Represents X₁ → R₂.Represents X₂ → (∀ ω : TestFormOn V n, X ω = X₁ ω + X₂ ω) → IsClosed F → F ⊆ V → R.measure F ≤ R₁.measure F + R₂.measure F := by
  intro P n V F X X₁ X₂ R R₁ R₂ hV hR hR₁ hR₂ hX hF hFV
  -- Step 1: for open `G`, `μ_R(G) = M_G(X) ≤ M_G(X₁) + M_G(X₂) = μ_{R₁}(G) + μ_{R₂}(G)`
  have hopen : ∀ G : Set (Euclid P), IsOpen G →
      R.measure G ≤ (R₁.measure + R₂.measure) G + 0 := by
    intro G hG
    rw [add_zero, Measure.add_apply,
      ← (Submission.dor_imrep_massOn_eq_measure_and_support P n V X R hV hR).1 G hG,
      ← (Submission.dor_imrep_massOn_eq_measure_and_support P n V X₁ R₁ hV hR₁).1 G hG,
      ← (Submission.dor_imrep_massOn_eq_measure_and_support P n V X₂ R₂ hV hR₂).1 G hG]
    exact Submission.lcmp_massOn_le_add_of_eval_eq P n V G X₁ X₂ X 1 (by rw [abs_one])
      fun ω _ => by rw [one_mul]; exact hX ω
  -- Step 2: `μ_{R'}(K) = ∫_{M' ∩ K} θ' dHⁿ < ∞` for compact `K ⊆ V`, so `μ_{R₁} + μ_{R₂}` is
  -- finite on compact subsets of `V`
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ V → (R₁.measure + R₂.measure) K < ∞ := by
    intro K hK hKV
    have hR' : ∀ R' : IMRep V n, R'.measure K < ∞ := fun R' => by
      rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
        Measure.restrict_restrict hK.measurableSet, inter_comm]
      exact (R'.locallyIntegrable_mult K hK hKV).lt_top
    rw [Measure.add_apply]
    exact ENNReal.add_lt_top.2 ⟨hR' R₁, hR' R₂⟩
  -- Step 3: the outer bound with `c = 0` gives `μ_R(K) ≤ μ_{R₁}(K) + μ_{R₂}(K)` for compact `K ⊆ V`
  have hcpt : ∀ K : Set (Euclid P), IsCompact K → K ⊆ V →
      R.measure K ≤ (R₁.measure + R₂.measure) K := fun K hK hKV => by
    simpa only [add_zero] using Submission.lcmp_measure_le_add_of_open_nhds P V K R.measure
      (R₁.measure + R₂.measure) 0 hV hK hKV hfin fun G hG _ _ => hopen G hG
  -- Step 4: `F` is the increasing union of the compact sets `F ∩ B̄(0, j) ⊆ V`; continuity from
  -- below passes the inequality to `F`
  have hmono : Monotone fun j : ℕ => F ∩ closedBall (0 : Euclid P) j := fun a b hab =>
    inter_subset_inter_right F (closedBall_subset_closedBall (Nat.cast_le.2 hab))
  calc R.measure F = ⨆ j : ℕ, R.measure (F ∩ closedBall 0 j) := by
        rw [← hmono.measure_iUnion, iUnion_inter_closedBall_nat]
    _ ≤ ⨆ j : ℕ, (R₁.measure + R₂.measure) (F ∩ closedBall 0 j) := iSup_mono fun j =>
        hcpt _ ((isCompact_closedBall 0 (j : ℝ)).inter_left hF) (inter_subset_left.trans hFV)
    _ ≤ (R₁.measure + R₂.measure) F := iSup_le fun j => measure_mono inter_subset_left
    _ = R₁.measure F + R₂.measure F := Measure.add_apply _ _ _
/-- **Local mass under change of domain** (Simon 6.2.5, 6.2.16).  Let `X ∈ 𝒟ₙ(ℝᴾ)` and
`Z ∈ 𝒟ₙ(U)`.  (a) `M_G(X⌞U) ≤ M_G(X)`: a form `ω ∈ 𝒟ⁿ(U)` admissible for `M_G` is, regarded in
`𝒟ⁿ(ℝᴾ)`, admissible for `M_G(X)` (same support and coefficient norms), with
`X⌞U(ω) = X(ω)`.  (b) If `G ⊆ U` and `X(ω) = Z(ω)` for all `ω ∈ 𝒟ⁿ(U)` with `spt ω ⊆ G`, then
`M_G(X) ≤ M_G(Z)`: a form `ω ∈ 𝒟ⁿ(ℝᴾ)` admissible for `M_G` has `spt ω ⊆ G ⊆ U`, so it is a form
`ω' ∈ 𝒟ⁿ(U)` admissible for `M_G(Z)` with `X(ω) = Z(ω')`.  Take suprema over admissible forms. -/
theorem Submission.dimred_mbl_lc_rc_massOn_restrict_univ : ∀ (P n : ℕ) (U G : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) n) (Z : GeometricCurrentOn U n), (X.restrictDomain (subset_univ U)).massOn G ≤ X.massOn G ∧ (G ⊆ U → (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ G → X (testFormOnInclusion (subset_univ U) n ω) = Z ω) → X.massOn G ≤ Z.massOn G) := by
  intro P n U G X Z
  refine ⟨?_, fun hGU hXZ => ?_⟩
  · -- (a): `X⌞U(ω) = X(ι ω)` and `ι ω` is admissible for `M_G(X)`
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    exact X.le_massOn (omega := testFormOnInclusion (subset_univ U) n ω) hω
  · -- (b): an admissible `ω ∈ 𝒟ⁿ(ℝᴾ)` has `spt ω ⊆ G ⊆ U`, so `ω = ι ω'` with `ω' ∈ 𝒟ⁿ(U)`
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    let ω' : TestFormOn U n :=
      ⟨(ω : DifferentialForm (Euclid P) n), ω.property.1, hω.1.trans hGU⟩
    have hω' : ω' ∈ massAdmissibleOn U n G := hω
    calc ENNReal.ofReal (X ω)
        = ENNReal.ofReal (X (testFormOnInclusion (subset_univ U) n ω')) := rfl
      _ = ENNReal.ofReal (Z ω') := by rw [hXZ ω' hω'.1]
      _ ≤ Z.massOn G := Z.le_massOn hω'
/-- **Retraction comparison** (Simon 7.2.4 (8)–(9), with competitors pushed into `A` as in
Remark 7.2.5(2)).  Let `U` be open and `T ∈ 𝒟ₙ(U)` (`n = m + 1`) minimizing in `A`, with
`spt T ⊆ A`, `0 < G ≤ G₃`, `B̄_{G₃} ⊆ U` and `M_{B_{G₃}}(T) < ∞`.  Let `π` be `C¹` on `B_{2G}`,
with `π(B_{2G}) ⊆ A ∩ B_{G₃}`, `π = id` on `A ∩ B_{2G}` and `‖Dπ‖ ≤ L`.  Let `Y ∈ 𝒟ₙ(ℝᴾ)` be an
integer multiplicity cycle with compact support in `B_G`, and `Z = T + Y` on `𝒟ⁿ(U)`.  Then
`M_{B_G}(T) ≤ Lⁿ M_{B_G}(Z)`.  Take `π_#` on `B_{2G}` from the push-forward hypothesis and split
`T = Q + T₁` with `Q = T⌞B_G ∈ 𝒟ₙ(ℝᴾ)`.  As `spt Q ⊆ B̄_G ∩ spt T ⊆ A ∩ B_{2G}`, `π_# Q = Q`, so
`S = Q + Y` has `π_# S = Q + π_# Y` and `M(π_# S) ≤ Lⁿ M(S)`.  Minimality on `B_{G₃}` against
`T + π_# Y = T₁ + π_# S` gives `μ_T(B_G) + μ_T(B_{G₃} ∖ B_G) ≤ μ_T(B_{G₃} ∖ B_G) + Lⁿ M(S)`, and
the finite term `μ_T(B_{G₃} ∖ B_G)` cancels.  Finally `μ_S(ℝᴾ ∖ B_G) ≤ μ_Q(ℝᴾ ∖ B_G) +
μ_Y(ℝᴾ ∖ B_G) = 0`, so `M(S) = M_{B_G}(S) ≤ M_{B_G}(Z)`, since `S = Z` on forms supported in
`B_G`. -/
theorem Submission.dimred_mbl_lc_retraction_comparison : ∀ (P m : ℕ) (U A : Set (Euclid P)) (T Z : GeometricCurrentOn U (m + 1)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (π : Euclid P → Euclid P) (G G₃ L : ℝ), IsOpen U → IsMinimizingIn T A → T.support ⊆ A → 0 < G → G ≤ G₃ → closedBall (0 : Euclid P) G₃ ⊆ U → T.massOn (ball 0 G₃) ≠ ∞ → ContDiffOn ℝ 1 π (ball 0 (2 * G)) → MapsTo π (ball 0 (2 * G)) (A ∩ ball 0 G₃) → (∀ y ∈ A ∩ ball 0 (2 * G), π y = y) → (∀ y ∈ ball (0 : Euclid P) (2 * G), ‖fderiv ℝ π y‖ ≤ L) → IsIntegerMultiplicity Y → Y.boundary = 0 → IsCompact Y.support → Y.support ⊆ ball 0 G → (∀ ω : TestFormOn U (m + 1), Z ω = T ω + Y (testFormOnInclusion (subset_univ U) (m + 1) ω)) → (∀ (O : Set (Euclid P)) (f : Euclid P → Euclid P) (c : ℝ), IsOpen O → ContDiffOn ℝ 1 f O → (∀ y ∈ O, ‖fderiv ℝ f y‖ ≤ c) → ∃ push : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents X → IsCompact X.support → X.support ⊆ O → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), push X ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity (push X) ∧ (push X).support ⊆ f '' X.support ∧ (push X).mass ≤ ENNReal.ofReal (c ^ (m + 1)) * X.mass ∧ (X.boundary = 0 → (push X).boundary = 0) ∧ ((∀ y ∈ X.support, f y = y) → push X = X)) ∧ ∀ X₁ X₂ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity X₁ → IsIntegerMultiplicity X₂ → IsCompact X₁.support → X₁.support ⊆ O → IsCompact X₂.support → X₂.support ⊆ O → push (X₁ - X₂) = push X₁ - push X₂) → T.massOn (ball 0 G) ≤ ENNReal.ofReal (L ^ (m + 1)) * Z.massOn (ball 0 G) := by
  intro P m U A T Z Y π G G₃ L hU hT hTA hG hGG₃ hG₃U hTfin hπ hπA hπid hπL hYim hYb hYc hYG hZ
    hPF
  have hMR := Submission.dor_imrep_massOn_eq_measure_and_support
  -- Step 1: `π_#` on `O = B_{2G}` (PF); an integer multiplicity representation `R` of `T`; and
  -- `T = Q + T₁` along `B_G ⊆ B̄_G ⊆ U`, with `Q = T⌞B_G ∈ 𝒟ₙ(ℝᴾ)`, `μ_Q = μ_T⌞B_G` and
  -- `μ_{T₁} = μ_T⌞(ℝᴾ ∖ B_G)`
  obtain ⟨push, hpush, hpushsub⟩ := hPF (ball 0 (2 * G)) π L isOpen_ball hπ hπL
  obtain ⟨R, hR⟩ := hT.1
  have hGU : closedBall (0 : Euclid P) G ⊆ U := (closedBall_subset_closedBall hGG₃).trans hG₃U
  obtain ⟨Q, RQ, T₁, R₁, hRQ, hRQmeas, hR₁, hR₁meas, hsplit, hQT, hQsupp, hQc⟩ :=
    Submission.dimred_mbl_lc_rc_restrict_to_univ P (m + 1) U (ball 0 G) (closedBall 0 G) T R hU
      hR measurableSet_ball (isCompact_closedBall 0 G) ball_subset_closedBall hGU
  have hGO : closedBall (0 : Euclid P) G ⊆ ball 0 (2 * G) := closedBall_subset_ball (by linarith)
  -- Step 2: `spt Q ⊆ B̄_G ∩ spt T ⊆ A ∩ B_{2G}`, where `π` is the identity, so `π_# Q = Q`
  have hQA : Q.support ⊆ A ∩ ball 0 (2 * G) := fun x hx =>
    ⟨hTA (hQsupp hx).2, hGO (closure_ball_subset_closedBall (hQsupp hx).1)⟩
  have hQO : Q.support ⊆ ball 0 (2 * G) := fun x hx => (hQA hx).2
  have hpQ : push Q = Q := (hpush Q RQ hRQ hQc hQO).2.2.2.2.2 fun y hy => hπid y (hQA hy)
  -- Step 3: `π_# Y` is an integer multiplicity cycle; `spt π_# Y` is closed and contained in the
  -- compact set `π(spt Y) ⊆ π(B_{2G}) ⊆ A ∩ B_{G₃}`
  obtain ⟨RY, hRY⟩ := hYim
  have hYO : Y.support ⊆ ball 0 (2 * G) := hYG.trans (ball_subset_closedBall.trans hGO)
  obtain ⟨-, hpYim, hpYsupp, -, hpYb, -⟩ := hpush Y RY hRY hYc hYO
  have hpYc : IsCompact (push Y).support :=
    (hYc.image_of_continuousOn (hπ.continuousOn.mono hYO)).of_isClosed_subset
      (isClosed_univ.sdiff (push Y).isOpen_zeroRegion) hpYsupp
  have hpYA : (push Y).support ⊆ A ∩ ball 0 G₃ :=
    hpYsupp.trans ((image_mono hYO).trans hπA.image_subset)
  -- Step 4: `S = Q + Y` is integer multiplicity with compact `spt S ⊆ spt Q ∪ spt Y ⊆ B_{2G}`,
  -- `π_# S = π_# Q + π_# Y`, and `M(π_# S) ≤ Lⁿ M(S)` (PF)
  obtain ⟨S, hSim, hSω, hSsupp, hSc, hpS⟩ :=
    Submission.dimred_mbl_lc_rc_push_add P (m + 1) (ball 0 (2 * G)) push Q Y hpushsub ⟨RQ, hRQ⟩
      ⟨RY, hRY⟩ hQc hQO hYc hYO
  obtain ⟨RS, hRS⟩ := hSim
  have hpSmass : (push S).mass ≤ ENNReal.ofReal (L ^ (m + 1)) * S.mass :=
    (hpush S RS hRS hSc (hSsupp.trans (union_subset hQO hYO))).2.2.2.1
  -- Step 5: the competitor `Z₁ = T − (0 − (π_# Y)|_U) = T + π_# Y`; minimality of `T` in `A` on
  -- `B_{G₃} ⊂⊂ U` gives `M_{B_{G₃}}(T) ≤ M_{B_{G₃}}(Z₁)`
  obtain ⟨Z₁, hZ₁⟩ : ∃ Z₁ : GeometricCurrentOn U (m + 1), ∀ ω : TestFormOn U (m + 1),
      Z₁ ω = T ω + push Y (testFormOnInclusion (subset_univ U) (m + 1) ω) :=
    ⟨T - (0 - (push Y).restrictDomain (subset_univ U)), fun ω => by
      show T ω - (0 - push Y (testFormOnInclusion (subset_univ U) (m + 1) ω)) = _
      ring⟩
  have hG₃U' : CompactlyContained (ball (0 : Euclid P) G₃) U :=
    ⟨(isCompact_closedBall 0 G₃).of_isClosed_subset isClosed_closure
      closure_ball_subset_closedBall, closure_ball_subset_closedBall.trans hG₃U⟩
  have hmin : T.massOn (ball 0 G₃) ≤ Z₁.massOn (ball 0 G₃) :=
    Submission.dimred_mbl_lc_rc_cycle_competitor P m U A (ball 0 G₃) T Z₁ (push Y) hU hT
      isOpen_ball hG₃U' hpYim (hpYb hYb) hpYc hpYA hZ₁
  -- Step 6: `Z₁ = T₁ + Q + π_# Y = T₁ + (π_# S)|_U` on `𝒟ⁿ(U)`, so by (MT), (MR) and the
  -- comparison of domains, `M_{B_{G₃}}(Z₁) ≤ μ_T(B_{G₃} ∖ B_G) + Lⁿ M(S)`
  have hT₁ : T₁.massOn (ball 0 G₃) = R.measure (ball 0 G₃ \ ball 0 G) := by
    rw [(hMR P (m + 1) U T₁ R₁ hU hR₁).1 _ isOpen_ball, hR₁meas,
      Measure.restrict_apply measurableSet_ball, Set.sdiff_eq]
  have hZ₁le : Z₁.massOn (ball 0 G₃) ≤
      R.measure (ball 0 G₃ \ ball 0 G) + ENNReal.ofReal (L ^ (m + 1)) * S.mass := by
    calc Z₁.massOn (ball 0 G₃)
        ≤ T₁.massOn (ball 0 G₃) +
            ((push S).restrictDomain (subset_univ U)).massOn (ball 0 G₃) :=
          Submission.lcmp_massOn_le_add_of_eval_eq P (m + 1) U (ball 0 G₃) T₁
            ((push S).restrictDomain (subset_univ U)) Z₁ 1 (by rw [abs_one]) fun ω _ => by
              rw [hZ₁, hsplit, GeometricCurrentOn.restrictDomain_apply, hpS, hpQ, one_mul]
              ring
      _ ≤ R.measure (ball 0 G₃ \ ball 0 G) + (push S).mass := by
          rw [hT₁]
          gcongr
          exact ((Submission.dimred_mbl_lc_rc_massOn_restrict_univ P (m + 1) U (ball 0 G₃)
            (push S) Z).1).trans ((push S).massOn_mono (subset_univ _))
      _ ≤ R.measure (ball 0 G₃ \ ball 0 G) + ENNReal.ofReal (L ^ (m + 1)) * S.mass := by
          gcongr
  -- Step 7: `M_{B_{G₃}}(T) = μ_T(B_G) + μ_T(B_{G₃} ∖ B_G)` is finite; cancelling the second
  -- term, `M_{B_G}(T) = μ_T(B_G) ≤ Lⁿ M(S)`
  have hTG₃ : T.massOn (ball 0 G₃) = R.measure (ball 0 G) + R.measure (ball 0 G₃ \ ball 0 G) := by
    rw [(hMR P (m + 1) U T R hU hR).1 _ isOpen_ball, ← measure_inter_add_sdiff (ball 0 G₃)
      (measurableSet_ball : MeasurableSet (ball (0 : Euclid P) G)),
      inter_eq_right.2 (ball_subset_ball hGG₃)]
  have hfin : R.measure (ball 0 G₃ \ ball 0 G) ≠ ∞ := by
    refine ne_top_of_le_ne_top hTfin ?_
    rw [hTG₃]
    exact le_add_self
  have hTG : T.massOn (ball 0 G) ≤ ENNReal.ofReal (L ^ (m + 1)) * S.mass := by
    rw [(hMR P (m + 1) U T R hU hR).1 _ isOpen_ball]
    refine (ENNReal.add_le_add_iff_right hfin).1 ?_
    rw [← hTG₃, add_comm (ENNReal.ofReal (L ^ (m + 1)) * S.mass)]
    exact hmin.trans hZ₁le
  -- Step 8: `μ_S(ℝᴾ ∖ B_G) ≤ μ_Q(ℝᴾ ∖ B_G) + μ_Y(ℝᴾ ∖ B_G) = 0`, as `μ_Q = μ_T⌞B_G` and
  -- `spt μ_Y = spt Y ⊆ B_G`; so `M(S) = μ_S(B_G) = M_{B_G}(S) ≤ M_{B_G}(Z)`, because
  -- `S = Q + Y = T + Y = Z` on forms supported in `B_G ⊆ U`
  have hRQout : RQ.measure (ball 0 G)ᶜ = 0 := by
    rw [hRQmeas, Measure.restrict_apply measurableSet_ball.compl, compl_inter_self, measure_empty]
  have hRYout : RY.measure (ball 0 G)ᶜ = 0 := by
    have hYsupp := (hMR P (m + 1) univ Y RY isOpen_univ hRY).2
    rw [univ_inter] at hYsupp
    have hsub : (ball (0 : Euclid P) G)ᶜ ⊆ RY.measure.supportᶜ := by
      rw [compl_subset_compl, ← hYsupp]
      exact hYG
    exact measure_mono_null hsub Measure.measure_compl_support
  have hRSout : RS.measure (ball 0 G)ᶜ = 0 := by
    have h := Submission.dimred_mbl_lc_rc_measure_le_add_of_closed P (m + 1) univ (ball 0 G)ᶜ S Q
      Y RS RQ RY isOpen_univ hRS hRQ hRY hSω isOpen_ball.isClosed_compl (subset_univ _)
    rw [hRQout, hRYout, add_zero] at h
    exact le_antisymm h zero_le
  have hSmass : S.mass = S.massOn (ball 0 G) := by
    rw [GeometricCurrentOn.mass, (hMR P (m + 1) univ S RS isOpen_univ hRS).1 _ isOpen_univ,
      (hMR P (m + 1) univ S RS isOpen_univ hRS).1 _ isOpen_ball,
      ← measure_add_measure_compl (measurableSet_ball : MeasurableSet (ball (0 : Euclid P) G)),
      hRSout, add_zero]
  have hSZ : S.massOn (ball 0 G) ≤ Z.massOn (ball 0 G) :=
    (Submission.dimred_mbl_lc_rc_massOn_restrict_univ P (m + 1) U (ball 0 G) S Z).2
      (ball_subset_closedBall.trans hGU) fun ω hω => by rw [hSω, hQT ω hω, hZ]
  calc T.massOn (ball 0 G) ≤ ENNReal.ofReal (L ^ (m + 1)) * S.mass := hTG
    _ = ENNReal.ofReal (L ^ (m + 1)) * S.massOn (ball 0 G) := by rw [hSmass]
    _ ≤ ENNReal.ofReal (L ^ (m + 1)) * Z.massOn (ball 0 G) := by gcongr

/-- **Local comparison at a single index** (Simon 7.2.4, proof, (9)–(11), with Remark 7.2.5(2)).
Let `T ∈ 𝒟ₙ(U)`, `n = m + 1`, be minimizing in `A` with `spt T ⊆ A` and `T = τ(R)`; let `W ⊆ F ⊆
B_G(0)` with `W` open, `F` compact and `μ_T(F ∖ W) = 0`, and let `0 < G`, `2G ≤ G₃`,
`B̄_{G₃}(0) ⊆ U`, `M_{B_{G₃}(0)}(T) < ∞` and `L ≥ 1`.  Let `S`, `C` be integer multiplicity with
`∂S = ∂C` and `spt(S − C) ⊆ W`, `Ŷ` an integer multiplicity cycle with `spt Ŷ ⊆ F` and
`μ_Ŷ(F ∖ W) ≤ e`, `M(Sr) ≤ e`, and `C = T + Ŷ + Sr` on forms supported in `W`.  Then
`M_W(T) ≤ Lⁿ(M_W(S) + 2e) + (Lⁿ − 1) M_{B_{G₃}(0)}(T)`.  If `A ∩ B_{2G}(0) = ∅`, then `W` misses
`spt T` and `M_W(T) = 0`.  Otherwise `Y = (S − C) + Ŷ` is an integer multiplicity cycle with
`spt Y ⊆ F ⊆ B_G(0)` and `Z = T + Y⌞U` is integer multiplicity, so the retraction comparison
gives `M_{B_G}(T) ≤ Lⁿ M_{B_G}(Z)`.  Splitting `B_G(0) = W ⊔ (F ∖ W) ⊔ (B_G(0) ∖ F)` gives
`M_{B_G}(T) = M_W(T) + b` and `M_{B_G}(Z) ≤ M_W(S) + e + e + b`, where
`b ≤ M_{B_{G₃}(0)}(T) < ∞`; cancelling `b` gives the claim. -/
theorem Submission.dimred_mbl_lc_index_comparison : ∀ (P m : ℕ) (U A W F : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)) (R : IMRep U (m + 1)) (C S Ŷ Sr : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (π : Euclid P → Euclid P) (G G₃ L : ℝ) (e : ℝ≥0∞), IsOpen U → IsMinimizingIn T A → T.support ⊆ A → R.Represents T → 0 < G → 2 * G ≤ G₃ → closedBall (0 : Euclid P) G₃ ⊆ U → T.massOn (ball 0 G₃) ≠ ∞ → 1 ≤ L → (A ∩ ball 0 (2 * G) = ∅ ∨ (ContDiffOn ℝ 1 π (ball 0 (2 * G)) ∧ MapsTo π (ball 0 (2 * G)) (A ∩ ball 0 G₃) ∧ (∀ y ∈ A ∩ ball 0 (2 * G), π y = y) ∧ ∀ y ∈ ball (0 : Euclid P) (2 * G), ‖fderiv ℝ π y‖ ≤ L)) → IsOpen W → IsCompact F → W ⊆ F → F ⊆ ball 0 G → R.measure (F \ W) = 0 → IsIntegerMultiplicity C → IsIntegerMultiplicity S → S.boundary = C.boundary → (S - C).support ⊆ W → IsIntegerMultiplicity Ŷ → Ŷ.boundary = 0 → Ŷ.support ⊆ F → (∀ R' : IMRep (univ : Set (Euclid P)) (m + 1), R'.Represents Ŷ → R'.measure (F \ W) ≤ e) → Sr.mass ≤ e → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ W → C ω = currentEval T (ω : DifferentialForm (Euclid P) (m + 1)) + Ŷ ω + Sr ω) → (∀ (O : Set (Euclid P)) (f : Euclid P → Euclid P) (c : ℝ), IsOpen O → ContDiffOn ℝ 1 f O → (∀ y ∈ O, ‖fderiv ℝ f y‖ ≤ c) → ∃ push : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents X → IsCompact X.support → X.support ⊆ O → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), push X ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity (push X) ∧ (push X).support ⊆ f '' X.support ∧ (push X).mass ≤ ENNReal.ofReal (c ^ (m + 1)) * X.mass ∧ (X.boundary = 0 → (push X).boundary = 0) ∧ ((∀ y ∈ X.support, f y = y) → push X = X)) ∧ ∀ X₁ X₂ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity X₁ → IsIntegerMultiplicity X₂ → IsCompact X₁.support → X₁.support ⊆ O → IsCompact X₂.support → X₂.support ⊆ O → push (X₁ - X₂) = push X₁ - push X₂) → T.massOn W ≤ ENNReal.ofReal (L ^ (m + 1)) * (S.massOn W + 2 * e) + ENNReal.ofReal (L ^ (m + 1) - 1) * T.massOn (ball 0 G₃) := by
  intro P m U A W F T R C S Ŷ Sr π G G₃ L e hU hmin hTA hR hG hGG₃ hG₃U hfin hL hπ hW hF hWF hFG
    hRFW hC hS hbd hSCW hŶ hŶbd hŶF hŶe hSr hCT hPF
  -- `B_G(0) ⊆ B_{2G}(0)` and `B_G(0) ⊆ B_{G₃}(0) ⊆ B̄_{G₃}(0) ⊆ U`, as `0 < G` and `2G ≤ G₃`
  have hGG₃' : G ≤ G₃ := by linarith
  have hB₂ : ball (0 : Euclid P) G ⊆ ball 0 (2 * G) := ball_subset_ball (by linarith)
  have hB₃ : ball (0 : Euclid P) G ⊆ ball 0 G₃ := ball_subset_ball hGG₃'
  have hBU : ball (0 : Euclid P) G ⊆ U := (hB₃.trans ball_subset_closedBall).trans hG₃U
  rcases hπ with hA | ⟨hπC, hπA, hπfix, hπL⟩
  -- Step 1 (case `A ∩ B_{2G}(0) = ∅`): `W ⊆ B_{2G}(0)` misses `A ⊇ spt T`, so `M_W(T) = 0`
  · have hWT : Disjoint W T.support := by
      refine Set.disjoint_left.2 fun x hxW hxT => ?_
      have hx : x ∈ A ∩ ball 0 (2 * G) := ⟨hTA hxT, hB₂ (hFG (hWF hxW))⟩
      rw [hA] at hx
      exact hx
    rw [Submission.dimred_mbl_lc_ic_massOn_eq_zero_of_disjoint P (m + 1) U W T hWT]
    exact zero_le
  -- Step 2: `Y = (S − C) + Ŷ` is an integer multiplicity cycle with `spt Y ⊆ F` compact
  obtain ⟨Y, hYim, hYbd, hYc, hYF, hY⟩ := Submission.dimred_mbl_lc_ic_cycle P m F C S Ŷ hF hC hS
    hbd (hSCW.trans hWF) hŶ hŶbd hŶF
  -- Step 3: `Z = T + Y⌞U` is integer multiplicity in `U` (`T = τ(R)`)
  obtain ⟨Z, hZim, hZ⟩ :=
    Submission.dimred_mbl_lc_ic_add_restrict P (m + 1) U T Y hU ⟨R, hR⟩ hYim
  -- Step 4: the retraction comparison gives (I) `M_{B_G}(T) ≤ Lⁿ M_{B_G}(Z)`
  have hI := Submission.dimred_mbl_lc_retraction_comparison P m U A T Z Y π G G₃ L hU hmin hTA hG
    hGG₃' hG₃U hfin hπC hπA hπfix hπL hYim hYbd hYc (hYF.trans hFG) hZ hPF
  -- Step 5: with `B = B_G(0)`, `M_B(T) = M_W(T) + b` and `M_B(Z) ≤ M_W(S) + e + e + b`
  obtain ⟨b, hTb, hZb⟩ := Submission.dimred_mbl_lc_ic_region_bound P (m + 1) U W F (ball 0 G) T Z
    R C S Ŷ Sr Y e hU hR hZim isOpen_ball hBU hW hF hWF hFG hRFW hSCW hŶ hŶF hŶe hSr hCT hY hZ
  -- Step 6: `b ≤ M_{B_G}(T) ≤ M_{B_{G₃}}(T) < ∞`
  have hbM : b ≤ T.massOn (ball 0 G₃) :=
    calc b ≤ T.massOn W + b := le_add_self
      _ = T.massOn (ball 0 G) := hTb.symm
      _ ≤ T.massOn (ball 0 G₃) := T.massOn_mono hB₃
  -- Step 7: `M_W(T) + b = M_{B_G}(T) ≤ Lⁿ(M_W(S) + e + e + b)`; cancel the finite `b`
  refine Submission.dimred_mbl_lc_ic_cancel (T.massOn W) b (S.massOn W) e
    (T.massOn (ball 0 G₃)) L (m + 1) hL hbM hfin ?_
  calc T.massOn W + b = T.massOn (ball 0 G) := hTb.symm
    _ ≤ ENNReal.ofReal (L ^ (m + 1)) * Z.massOn (ball 0 G) := hI
    _ ≤ ENNReal.ofReal (L ^ (m + 1)) * (S.massOn W + e + e + b) := by gcongr
/-- **A unit orientation paired with a pulled-back covector** (Simon Ch. 6, 1.8–1.10 and
3.3–3.4: `⟨L^#α, ξ⟩ = ⟨α, L_#ξ⟩` with `L_#(τ₁ ∧ ⋯ ∧ τₙ) = Lτ₁ ∧ ⋯ ∧ Lτₙ`).  Write
`ξ(β) = ±β(τ)` with `τ` an orthonormal basis of `Q`, and `α ∘ L = α.compContinuousLinearMap L`.
(a) `|ξ(α ∘ L)| = |(α ∘ L)(τ)| ≤ |α ∘ L|_E ≤ ‖L‖ⁿ |α|_E` (`regcomp_covector_eval_orthonormal_le`,
then `dimred_mbl_pf_oc_covectorEuclideanNorm_comp_le`).  (b) If `L` fixes `Q` pointwise, then
`Lτᵢ = τᵢ` since `τᵢ ∈ span τ = Q`, so `(α ∘ L)(τ) = α(Lτ₁, …, Lτₙ) = α(τ)` and
`ξ(α ∘ L) = ξ(α)`. -/
theorem Submission.dimred_mbl_pf_unitOrientation_comp : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ (α.compContinuousLinearMap L)| ≤ covectorEuclideanNorm α * ‖L‖ ^ n) ∧ ((∀ v ∈ Q, L v = v) → ∀ α : Covector (Euclid P) n, ξ (α.compContinuousLinearMap L) = ξ α) := by
  intro P n ξ Q L hξ
  -- `ξ(β) = ±β(τ)` with one sign, `τ` an orthonormal basis of `Q`; hence `|ξ(β)| = |β(τ)|`
  obtain ⟨τ, hτ, hspan, hsign⟩ := hξ
  have habs : ∀ β : Covector (Euclid P) n, |ξ β| = |β τ| := by
    intro β
    rcases hsign with h | h
    · rw [h]
    · rw [h, abs_neg]
  refine ⟨fun α => ?_, fun hL α => ?_⟩
  · -- (a) `|ξ(α ∘ L)| = |(α ∘ L)(τ)| ≤ |α ∘ L|_E ≤ ‖L‖ⁿ |α|_E`
    rw [habs, mul_comm]
    exact (Submission.regcomp_covector_eval_orthonormal_le P n (α.compContinuousLinearMap L) τ
      hτ).trans (Submission.dimred_mbl_pf_oc_covectorEuclideanNorm_comp_le P P n L α)
  · -- (b) `τᵢ ∈ span τ = Q` is fixed by `L`, so `(α ∘ L)(τ) = α(L ∘ τ) = α(τ)`
    have hLτ : ⇑L ∘ τ = τ := funext fun i =>
      hL (τ i) (hspan ▸ Submodule.subset_span ⟨i, rfl⟩)
    have hτα : (α.compContinuousLinearMap L) τ = α τ := by
      rw [ContinuousAlternatingMap.compContinuousLinearMap_apply, hLτ]
    rcases hsign with h | h <;> rw [h, h, hτα]

/-- **Simon Ch. 6, 2.4, 2.11 and 3.2(3)**, for currents in `ℝᴾ`.  If `Y = τ(M, θ, ξ)`, then
`M(Y) = μ_R(ℝᴾ)` and `spt Y = spt μ_R`; `ℝᴾ` is hereditarily Lindelöf, so `μ_R(ℝᴾ \ spt Y) = 0`,
and `θ ≥ 1` on `M` gives `Hⁿ(M \ spt Y) = 0`.  If `spt Y` is compact, `μ_R(ℝᴾ) = μ_R(spt Y)` is
finite by local integrability of `θ`.  Supports are complements of open zero regions, and a common
relatively compact neighbourhood on which `Y₁` and `Y₂` vanish lies in the zero region of
`Y₁ - Y₂`. -/
theorem Submission.dimred_mbl_pf_imrep_carrier_mass_support : ∀ (P n : ℕ), (∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), R.Represents Y → μHE[n] (R.carrier \ Y.support) = 0 ∧ Y.mass = R.measure univ ∧ (IsCompact Y.support → R.measure univ ≠ ∞)) ∧ ∀ Y₁ Y₂ : GeometricCurrentOn (univ : Set (Euclid P)) n, IsClosed Y₁.support ∧ (Y₁ - Y₂).support ⊆ Y₁.support ∪ Y₂.support := by
  intro P n
  -- Step 6: `spt Y = ℝᴾ \ Z(Y)` is the complement of the open zero region
  have hclosed : ∀ Y : GeometricCurrentOn (univ : Set (Euclid P)) n, IsClosed Y.support :=
    fun Y => by
      rw [GeometricCurrentOn.support, ← compl_eq_univ_sdiff]
      exact Y.isOpen_zeroRegion.isClosed_compl
  refine ⟨fun Y R hR => ?_, fun Y₁ Y₂ => ⟨hclosed Y₁, ?_⟩⟩
  · -- Step 1: `M_W(Y) = μ_R(W)` for open `W`, and `spt Y = spt μ_R`
    obtain ⟨hmass, hsupp⟩ :=
      Submission.dor_imrep_massOn_eq_measure_and_support P n univ Y R isOpen_univ hR
    rw [univ_inter] at hsupp
    -- Step 3: `μ_R(ℝᴾ \ spt Y) = 0`, `ℝᴾ` being hereditarily Lindelöf
    have hnull : R.measure (Y.support)ᶜ = 0 := by
      rw [hsupp]
      exact Measure.measure_compl_support
    refine ⟨?_, hmass univ isOpen_univ, fun hK => ?_⟩
    · -- Step 4: `θ ≥ 1` on `M`, so `Hⁿ(M \ spt Y) = 0`
      have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
        (measurable_from_nat (f := (Nat.cast : ℕ → ℝ≥0∞))).comp R.measurable_mult
      have h0 := (withDensity_apply_eq_zero hθ).1 hnull
      rw [Measure.restrict_apply' R.measurableSet_carrier] at h0
      refine measure_mono_null (fun x hx => ?_) h0
      exact ⟨⟨Nat.cast_ne_zero.2 (R.mult_pos x hx.1).ne', hx.2⟩, hx.1⟩
    · -- Step 5: `μ_R(ℝᴾ) = μ_R(spt Y) = ∫_{M ∩ spt Y} θ dHⁿ < ∞`
      have hfin : R.measure Y.support ≠ ∞ := by
        rw [IMRep.measure, withDensity_apply _ (hclosed Y).measurableSet,
          Measure.restrict_restrict (hclosed Y).measurableSet, inter_comm]
        exact R.locallyIntegrable_mult _ hK (subset_univ _)
      refine ne_top_of_le_ne_top hfin ?_
      calc R.measure univ ≤ R.measure Y.support + R.measure (Y.support)ᶜ :=
            measure_univ_le_add_compl _
        _ = R.measure Y.support := by rw [hnull, add_zero]
  · -- Step 7: a common relatively compact neighbourhood where `Y₁`, `Y₂` vanish
    intro x hx
    by_contra hx'
    rw [mem_union, not_or] at hx'
    simp only [GeometricCurrentOn.support, Set.mem_sdiff, mem_univ, true_and, not_not] at hx hx'
    obtain ⟨⟨W₁, ⟨hW₁, hW₁c, -, hY₁⟩, hxW₁⟩, ⟨W₂, ⟨hW₂, -, -, hY₂⟩, hxW₂⟩⟩ := hx'
    refine hx ⟨W₁ ∩ W₂, ⟨hW₁.inter hW₂, hW₁c.of_isClosed_subset isClosed_closure
      (closure_mono inter_subset_left), subset_univ _, fun ω hω => ?_⟩, hxW₁, hxW₂⟩
    show Y₁ ω - Y₂ ω = 0
    rw [hY₁ ω (hω.trans inter_subset_left), hY₂ ω (hω.trans inter_subset_right), sub_zero]

/-- **Push-forward of `τ(M, θ, ξ)` by a `C¹` map** (Simon 6.2.23–6.2.24(2)).  If `Hⁿ⌞M` is
carried by the compact `K ⊆ U`, `f` is `C¹` on an open `O ⊇ K` and `f(K) ⊆ U`, then
`Q(ω) = ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ(x)⟩ dHⁿ(x)` defines `Q ∈ 𝒟ₙ(U)` with `spt Q` a compact
subset of `f(K)`.  The bound `|Q(ω)| ≤ A sup |ω|` makes the linear functional `Q` a current.
If `spt ω` misses `f(K)`, then `ω(f(x)) = 0` for `x ∈ K`, which is `Hⁿ`-almost all of `M`, so
`Q(ω) = 0`. -/
theorem Submission.dimred_mbl_pf_pushforward_current_exists : ∀ (P n : ℕ) (U K O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P), IsOpen U → IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → IsOpen O → K ⊆ O → ContDiffOn ℝ 1 f O → f '' K ⊆ U → ∃ Q : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, Q ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) ∧ IsCompact Q.support ∧ Q.support ⊆ f '' K := by
  intro P n U K O R f hU hK hKU hMK hO hKO hf hfK
  -- Step 1: `I(ω) = θ ⟨ω(f) ∘ Df, ξ⟩` is integrable and `|∫_M I(ω)| ≤ A B` if `‖ω‖ ≤ B`
  obtain ⟨A, -, hA⟩ := Submission.dimred_mbl_pfc_pullback_integrand_bound P n U K O R f hK hKU
    hMK hO hKO hf
  let I : DifferentialForm (Euclid P) n → Euclid P → ℝ := fun ω x =>
    (R.mult x : ℝ) * R.orient x ((ω (f x)).compContinuousLinearMap (fderiv ℝ f x))
  -- a test form is continuous with compact support, hence bounded
  have hint : ∀ ω : TestFormOn U n,
      Integrable (I (ω : DifferentialForm (Euclid P) n)) (μHE[n].restrict R.carrier) := by
    intro ω
    obtain ⟨B, hB⟩ := ω.2.1.1.continuous.bounded_above_of_compact_support ω.2.1.2
    exact (hA _ B ω.2.1.1.continuous hB).1
  -- Step 2: `I` is linear in `ω`, since `α ↦ α ∘ Df(x)` and `ξ(x)` are linear
  have hadd : ∀ (ω η : TestFormOn U n) (x : Euclid P),
      I ((ω + η : TestFormOn U n) : DifferentialForm (Euclid P) n) x =
        I (ω : DifferentialForm (Euclid P) n) x + I (η : DifferentialForm (Euclid P) n) x := by
    intro ω η x
    have h : ∀ α β : Covector (Euclid P) n, (α + β).compContinuousLinearMap (fderiv ℝ f x) =
        α.compContinuousLinearMap (fderiv ℝ f x) + β.compContinuousLinearMap (fderiv ℝ f x) := by
      intro α β
      ext v
      simp
    simp only [I, Submodule.coe_add, Pi.add_apply, h, map_add, mul_add]
  have hsmul : ∀ (c : ℝ) (ω : TestFormOn U n) (x : Euclid P),
      I ((c • ω : TestFormOn U n) : DifferentialForm (Euclid P) n) x =
        c * I (ω : DifferentialForm (Euclid P) n) x := by
    intro c ω x
    have h : ∀ α : Covector (Euclid P) n, (c • α).compContinuousLinearMap (fderiv ℝ f x) =
        c • α.compContinuousLinearMap (fderiv ℝ f x) := by
      intro α
      ext v
      simp
    simp only [I, Submodule.coe_smul, Pi.smul_apply, h, map_smul, smul_eq_mul]
    ring
  let L : TestFormOn U n →ₗ[ℝ] ℝ :=
    { toFun := fun ω => ∫ x in R.carrier, I (ω : DifferentialForm (Euclid P) n) x ∂μHE[n]
      map_add' := fun ω η => by
        simp only [hadd]
        exact integral_add (hint ω) (hint η)
      map_smul' := fun c ω => by
        simp only [hsmul, RingHom.id_apply, smul_eq_mul]
        exact integral_const_mul c _ }
  -- Step 3: with `c = A` on every compact set, `L` is a current `Q`
  obtain ⟨Q, hQ⟩ := Submission.cmcs_rc_order_zero_current P n U L fun _ _ _ =>
    ⟨A, fun ω B _ hB => (hA _ B ω.2.1.1.continuous hB).2⟩
  -- Step 4: `Hⁿ`-a.e. point of `M` lies in `K`
  have hMKae : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ K := by
    rw [ae_restrict_iff' R.measurableSet_carrier, ae_iff]
    exact measure_mono_null (fun x hx => not_imp.mp hx) hMK
  -- Step 5: `Q(ω) = 0` if `spt ω ∩ f(K) = ∅`, as then `ω(f(x)) = 0` for `x ∈ K`
  have hvan : ∀ ω : TestFormOn U n,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f '' K) → Q ω = 0 := by
    intro ω hω
    rw [hQ]
    show ∫ x in R.carrier, I (ω : DifferentialForm (Euclid P) n) x ∂μHE[n] = 0
    refine integral_eq_zero_of_ae ?_
    filter_upwards [hMKae] with x hx
    have h0 : (ω : DifferentialForm (Euclid P) n) (f x) = 0 :=
      image_eq_zero_of_notMem_tsupport fun h => hω.notMem_of_mem_left h (mem_image_of_mem f hx)
    have h : ((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x) =
        0 := by
      ext v
      simp [h0]
    simp only [I, h, map_zero, mul_zero, Pi.zero_apply]
  -- Step 6: `f(K)` is a compact subset of `U`, so `spt Q` is a compact subset of `f(K)`
  obtain ⟨hsub, hcpt⟩ := Submission.rsd_cmr_support_subset_of_vanish P n U (f '' K) Q hU
    (hK.image_of_continuousOn (hf.continuousOn.mono hKO)) hfK hvan
  exact ⟨Q, hQ, hcpt, hsub⟩
/-- **Simon Ch. 6, 2.23 and Remark 2.24(2)**: the pulled-back integral `∫_M θ ξ(f^#ω) dHⁿ` is the
limit of `Y(ωⱼ)` for test forms `ωⱼ` chosen before `Y` and its representation.  The cut-off
`h = χ f^#ω` is continuous, compactly supported and equal to `f^#ω` on `K`, and test forms
`ωⱼ → h` uniformly; both depend only on `f`, `ω`, `O` and `K`.  If `Y = τ(M, θ, ξ)` with
`spt Y ⊆ K`, then `Hⁿ(M \ K) = 0`, so `Y(ωⱼ) = τ(M, θ, ξ)(ωⱼ) → τ(M, θ, ξ)(h)`, and
`τ(M, θ, ξ)(h) = ∫_M θ ξ(f^#ω) dHⁿ` since `h = f^#ω` on `K`. -/
theorem Submission.dimred_mbl_pf_pullback_integral_extension : ∀ (P n : ℕ) (O K : Set (Euclid P)) (f : Euclid P → Euclid P) (ω : TestFormOn (univ : Set (Euclid P)) n), IsOpen O → ContDiffOn ℝ 1 f O → IsCompact K → K ⊆ O → ∃ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) n, ∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), R.Represents Y → Y.support ⊆ K → Tendsto (fun j => Y (ωs j)) atTop (𝓝 (∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n])) := by
  intro P n O K f ω hO hf hK hKO
  -- (1) the cut-off `h = χ f^#ω`: continuous, compactly supported, `h = f^#ω` on `K`
  obtain ⟨h, hc, hs, hhK⟩ := Submission.dimred_mbl_pf_ext_pullback_cutoff P n O K f
    (ω : DifferentialForm (Euclid P) n) ω.property.1.1.continuous hO hf hK hKO
  -- (2) test forms `ωⱼ → h` uniformly on `ℝᴾ`, chosen before `Y` and `R`
  obtain ⟨ωs, hu⟩ := Submission.dimred_mbl_pf_ext_testForm_uniform_approx P n h hc hs
  refine ⟨ωs, fun Y R hR hYK => ?_⟩
  -- (3) `Hⁿ(M \ K) = 0`, since `Hⁿ(M \ spt Y) = 0` and `spt Y ⊆ K`
  have hnull : μHE[n] (R.carrier \ K) = 0 :=
    measure_mono_null (Set.sdiff_subset_sdiff_right hYK)
      ((Submission.dimred_mbl_pf_imrep_carrier_mass_support P n).1 Y R hR).1
  -- (4) `τ(M, θ, ξ)(ωⱼ) → τ(M, θ, ξ)(h)`
  have hlim := Submission.dimred_mbl_pf_ext_action_tendsto P n univ K R
    (fun j => (ωs j : DifferentialForm (Euclid P) n)) h hK (subset_univ K) hnull
    (fun j => (ωs j).property.1.1.continuous) hc hu.tendstoUniformlyOn
  -- (5) `τ(M, θ, ξ)(h) = ∫_M θ ξ(f^#ω) dHⁿ`, as `Hⁿ⌞M`-a.e. point lies in `K`
  have hμK : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ K := by
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    refine measure_mono_null ?_ hnull
    exact fun x hx => ⟨hx.2, hx.1⟩
  have heq : R.action h = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x
      (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x))
        ∂μHE[n] := by
    rw [IMRep.action]
    refine integral_congr_ae ?_
    filter_upwards [hμK] with x hx
    rw [hhK x hx]
  -- (6) `Y(ωⱼ) = τ(M, θ, ξ)(ωⱼ)`
  rw [← heq]
  exact hlim.congr fun j => (hR (ωs j)).symm
/-- **Simon Ch. 6, 2.24(2) and 2.29, mass of a `C¹` push-forward**: let `Y = τ(M, θ, ξ)` have
compact support `spt Y ⊆ O`, `‖Df‖ ≤ L` on `O`, and `Z(ω) = ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ(x)⟩ dHⁿ`.
Then `M(Z) ≤ Lⁿ M(Y)`.  `Hⁿ`-a.e. on `M`, `x ∈ spt Y ⊆ O` (so `0 ≤ ‖Df(x)‖ ≤ L`) and `ξ(x)` is a
unit orientation, so `|⟨ω(f(x)) ∘ Df(x), ξ(x)⟩| ≤ |ω(f(x))| ‖Df(x)‖ⁿ ≤ Lⁿ` for admissible `ω`;
with `∫_M θ dHⁿ = μ_Y(ℝᴾ) = M(Y) < ∞` this gives `|Z(ω)| ≤ Lⁿ M(Y)`. -/
theorem Submission.dimred_mbl_pf_pushforward_mass_le : ∀ (P n : ℕ) (O : Set (Euclid P)) (f : Euclid P → Euclid P) (L : ℝ) (Y Z : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), (∀ y ∈ O, ‖fderiv ℝ f y‖ ≤ L) → R.Represents Y → IsCompact Y.support → Y.support ⊆ O → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Z ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → Z.mass ≤ ENNReal.ofReal (L ^ n) * Y.mass := by
  intro P n O f L Y Z R hL hR hK hKO hZ
  obtain ⟨hnull, hmass, hfin⟩ :=
    (Submission.dimred_mbl_pf_imrep_carrier_mass_support P n).1 Y R hR
  have hfin' : R.measure univ ≠ ∞ := hfin hK
  have hθm : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  -- `μ_Y(ℝᴾ) = ∫_M θ dHⁿ < ∞`: `θ` is `Hⁿ⌞M`-integrable and `∫_M θ dHⁿ = μ_Y(ℝᴾ)`
  have hlin : R.measure univ = ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
    rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  have hθint : Integrable (fun x => (R.mult x : ℝ)) (μHE[n].restrict R.carrier) := by
    simpa using integrable_toReal_of_lintegral_ne_top hθm.aemeasurable (hlin ▸ hfin')
  have hθ : ∫ x in R.carrier, (R.mult x : ℝ) ∂μHE[n] = (R.measure univ).toReal := by
    rw [hlin, ← integral_toReal hθm.aemeasurable (ae_of_all _ fun x => ENNReal.natCast_lt_top _)]
    simp only [ENNReal.toReal_natCast]
  -- `Hⁿ`-a.e. point of `M` lies in `spt Y ⊆ O`
  have hO : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ O := by
    rw [ae_restrict_iff' R.measurableSet_carrier]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hnull] with x hx hxM
    exact hKO (Classical.byContradiction fun h => hx ⟨hxM, h⟩)
  rw [hmass]
  apply sSup_le
  rintro r ⟨ω, ⟨-, hω1⟩, rfl⟩
  -- `|θ ⟨ω(f(x)) ∘ Df(x), ξ(x)⟩| ≤ Lⁿ θ` `Hⁿ`-a.e. on `M`
  have hbound : ∀ᵐ x ∂(μHE[n].restrict R.carrier), ‖(R.mult x : ℝ) * R.orient x
      (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x))‖ ≤
        L ^ n * (R.mult x : ℝ) := by
    filter_upwards [hO, R.orients] with x hxO hx
    obtain ⟨Q, -, hQ⟩ := hx
    have h1 := (Submission.dimred_mbl_pf_unitOrientation_comp P n (R.orient x) Q (fderiv ℝ f x)
      hQ).1 ((ω : DifferentialForm (Euclid P) n) (f x))
    have h2 : ‖fderiv ℝ f x‖ ^ n ≤ L ^ n := pow_le_pow_left₀ (norm_nonneg _) (hL x hxO) n
    rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs, mul_comm (L ^ n)]
    exact mul_le_mul_of_nonneg_left
      (h1.trans ((mul_le_of_le_one_left (by positivity) (hω1 _)).trans h2)) (Nat.cast_nonneg _)
  -- `|Z(ω)| ≤ Lⁿ ∫_M θ dHⁿ = Lⁿ μ_Y(ℝᴾ)`
  have hZω : ‖Z ω‖ ≤ L ^ n * (R.measure univ).toReal := by
    rw [hZ ω, ← hθ, ← integral_const_mul]
    exact norm_integral_le_of_norm_le (hθint.const_mul _) hbound
  calc ENNReal.ofReal (Z ω) ≤ ENNReal.ofReal (L ^ n * (R.measure univ).toReal) :=
        ENNReal.ofReal_le_ofReal ((Real.le_norm_self _).trans hZω)
    _ = ENNReal.ofReal (L ^ n) * R.measure univ := by
        rw [ENNReal.ofReal_mul' ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hfin']
/-- **A push-forward by a `C¹` map fixing `spt Y` pointwise is `Y`** (Simon Ch. 6, 2.24(2)–(3)
and 3.3; approximate tangent spaces as in Ch. 3, 1.4).  Let `Y = τ(M, θ, ξ)`, `spt Y ⊆ O` with `O`
open, `f ∈ C¹(O)` fix `spt Y` pointwise and `Z(ω) = ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ(x)⟩ dHⁿ`.  Since
`Hⁿ(M \ spt Y) = 0`, blow-ups of points of `M ∩ spt Y` approach every vector of the approximate
tangent plane `Q` oriented by `ξ(x)` at `Hⁿ`-a.e. `x ∈ M`; `f` fixes these points, so `Df(x)`
fixes `Q`, hence `ξ(x)(ω(f(x)) ∘ Df(x)) = ξ(x)(ω(x))` and the integrands of `Z(ω)` and `Y(ω)`
agree `Hⁿ⌞M`-a.e. -/
theorem Submission.dimred_mbl_pf_pushforward_eq_self_of_fix : ∀ (P n : ℕ) (O : Set (Euclid P)) (f : Euclid P → Euclid P) (Y Z : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), IsOpen O → ContDiffOn ℝ 1 f O → R.Represents Y → Y.support ⊆ O → (∀ y ∈ Y.support, f y = y) → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Z ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → Z = Y := by
  intro P n O f Y Z R hO hf hR hYO hfix hZ
  -- Step 1 (carrier_facts): `Hⁿ(M \ spt Y) = 0`
  have hnull : μHE[n] (R.carrier \ Y.support) = 0 :=
    ((Submission.dimred_mbl_pf_imrep_carrier_mass_support P n).1 Y R hR).1
  -- Step 2: `Hⁿ⌞M`-a.e. `x` lies in `spt Y` and `ξ(x)` orients an approximate tangent plane of `M`
  have hgood : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ Y.support ∧
      ∃ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n R.carrier x Q ∧ IsUnitOrientationOf (R.orient x) Q := by
    have hK : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ Y.support := by
      rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
      refine measure_mono_null (fun x hx => ?_) hnull
      exact ⟨hx.2, hx.1⟩
    filter_upwards [hK, R.orients] with x hxK hxQ using ⟨hxK, hxQ⟩
  -- Steps 3–4: at `x ∈ spt Y`, `Df(x)` fixes every approximate tangent plane `Q` of `M` at `x`
  have hDf : ∀ x ∈ Y.support, ∀ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n R.carrier x Q → ∀ w ∈ Q, fderiv ℝ f x w = w := by
    intro x hxK Q hQ w hw
    -- Step 3: `x ∈ spt Y ⊆ O` with `O` open and `f ∈ C¹(O)`, so `f` is differentiable at `x`;
    -- and `f(x) = x`
    set L := fderiv ℝ f x
    have hfL : HasFDerivAt f L x :=
      ((hf.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds (hYO hxK))).hasFDerivAt
    have hfx : f x = x := hfix x hxK
    -- Step 4: it suffices to show `|Lw − w| ≤ ε` for every `ε > 0`; fix the constants
    refine eq_of_forall_dist_le fun ε hε => ?_
    rw [dist_eq_norm]
    set C : ℝ := ‖w‖ + 1 with hC
    set B : ℝ := ‖L‖ + 1 with hB
    have hCpos : 0 < C := by rw [hC]; positivity
    have hBpos : 0 < B := by rw [hB]; positivity
    set η : ℝ := ε / (2 * C) with hη
    set s : ℝ := min 1 (ε / (2 * B))
    have hηpos : 0 < η := div_pos hε (mul_pos two_pos hCpos)
    have hspos : 0 < s := lt_min one_pos (div_pos hε (mul_pos two_pos hBpos))
    have hBs : B * s ≤ ε / 2 := by
      calc B * s ≤ B * (ε / (2 * B)) := mul_le_mul_of_nonneg_left (min_le_right _ _) hBpos.le
        _ = ε / 2 := by field_simp
    have hηC : η * C = ε / 2 := by rw [hη]; field_simp
    -- differentiability at `x`: `|f(y) − f(x) − L(y − x)| ≤ η|y − x|` for `|y − x| < δ`
    obtain ⟨δ, hδ, hδf⟩ := Metric.eventually_nhds_iff.mp (hfL.isLittleO.bound hηpos)
    -- blowup_points with `N = spt Y`: for `0 < λ < λ₀` some `y ∈ M ∩ spt Y` has
    -- `|λ⁻¹(y − x) − w| < s`
    obtain ⟨lam₀, hlam₀, hpts⟩ :=
      Submission.dsmc_att_blowUp_points_of_approxTangent P n R.carrier Y.support x w Q hnull hQ
        hw s hspos
    set lam : ℝ := min (lam₀ / 2) (δ / (2 * C))
    have hlampos : 0 < lam := lt_min (half_pos hlam₀) (div_pos hδ (mul_pos two_pos hCpos))
    obtain ⟨y, ⟨-, hyK⟩, hy⟩ :=
      hpts lam hlampos ((min_le_left _ _).trans_lt (half_lt_self hlam₀))
    -- the secant point `u = λ⁻¹(y − x)`: `|u − w| < s`, `|u| ≤ C` and `|y − x| = λ|u| < δ`
    set u : Euclid P := lam⁻¹ • (y - x) with hu
    have hyx : y - x = lam • u := by rw [hu, smul_inv_smul₀ hlampos.ne']
    have huw : ‖u - w‖ < s := hy
    have huC : ‖u‖ ≤ C := by
      have h1 := norm_le_norm_sub_add u w
      have h2 := huw.trans_le (min_le_left _ _)
      rw [hC]; linarith
    have hyδ : dist y x < δ := by
      rw [dist_eq_norm, hyx, norm_smul, Real.norm_of_nonneg hlampos.le]
      calc lam * ‖u‖ ≤ δ / (2 * C) * C :=
            mul_le_mul (min_le_right _ _) huC (norm_nonneg _)
              (div_pos hδ (mul_pos two_pos hCpos)).le
        _ = δ / 2 := by field_simp
        _ < δ := half_lt_self hδ
    -- `f(y) = y` (`y ∈ spt Y`) and `f(x) = x`, so dividing by `λ > 0`: `|u − Lu| ≤ η|u| ≤ ε/2`
    have hkey : ‖u - L u‖ ≤ ε / 2 := by
      have h := hδf hyδ
      rw [hfix y hyK, hfx, hyx, map_smul, ← smul_sub, norm_smul, norm_smul,
        Real.norm_of_nonneg hlampos.le, mul_left_comm] at h
      calc ‖u - L u‖ ≤ η * ‖u‖ := le_of_mul_le_mul_left h hlampos
        _ ≤ η * C := mul_le_mul_of_nonneg_left huC hηpos.le
        _ = ε / 2 := hηC
    -- `|Lw − w| ≤ |L(w − u)| + |Lu − u| + |u − w| ≤ Bs + ε/2 ≤ ε`
    have hLwu : ‖L w - L u‖ ≤ ‖L‖ * ‖u - w‖ := by
      calc ‖L w - L u‖ = ‖L (w - u)‖ := by rw [map_sub]
        _ ≤ ‖L‖ * ‖w - u‖ := L.le_opNorm _
        _ = ‖L‖ * ‖u - w‖ := by rw [norm_sub_rev]
    calc ‖L w - w‖ = ‖(L w - L u) + (L u - u) + (u - w)‖ := by congr 1; abel
      _ ≤ ‖L w - L u‖ + ‖L u - u‖ + ‖u - w‖ := norm_add₃_le
      _ ≤ ‖L‖ * ‖u - w‖ + ε / 2 + ‖u - w‖ := by rw [norm_sub_rev (L u) u]; linarith
      _ = B * ‖u - w‖ + ε / 2 := by rw [hB]; ring
      _ ≤ B * s + ε / 2 := by linarith [mul_le_mul_of_nonneg_left huw.le hBpos.le]
      _ ≤ ε := by linarith
  -- Step 6: `Z(ω) = ∫_M θ ξ(ω) dHⁿ = Y(ω)`, the integrands agreeing `Hⁿ⌞M`-a.e.
  ext ω
  rw [hZ ω, hR ω, IMRep.action]
  refine integral_congr_ae ?_
  filter_upwards [hgood] with x hx
  obtain ⟨hxK, Q, hQ, hξ⟩ := hx
  -- Step 5 (orient_comp (b)): `ξ(x)(α ∘ Df(x)) = ξ(x)(α)`, and `ω(f(x)) = ω(x)`
  rw [(Submission.dimred_mbl_pf_unitOrientation_comp P n (R.orient x) Q (fderiv ℝ f x) hξ).2
    (hDf x hxK Q hQ), hfix x hxK]

/-- Simon 6.2.24(1), `∂f_#X = f_#∂X`, for a map `f` that is only `C¹` on an open `O ⊇ K`: if
`X = τ(M, θ, ξ)` has `∂X = 0` in `U`, `Hⁿ(M ∖ K) = 0` and
`Q(ω) = ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ⟩ dHⁿ`, then `∂Q = 0` in `U`.  Cut `f` off on `O ∩ U` to a `C¹`
map `φ` with `φ = f`, `Dφ = Df` on an open `V ⊇ K` and `φ = id` off a compact `K' ⊆ O ∩ U`.  The
integrands for `f` and `φ` agree on `M ∩ K`, hence `Hⁿ⌞M`-a.e., so `Q` is the push-forward
formula for `φ`, and `∂Q = 0` by the `C¹` push-forward boundary formula. -/
theorem Submission.dimred_mbl_pf_pushforward_boundaryVanishes : ∀ (P n : ℕ) (U K O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P) (X Q : GeometricCurrentOn U n), IsOpen U → IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → IsOpen O → K ⊆ O → ContDiffOn ℝ 1 f O → R.Represents X → BoundaryVanishes X → (∀ ω : TestFormOn U n, Q ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → BoundaryVanishes Q := by
  intro P n U K O R f X Q hU hK hKU hnull hO hKO hf hRX hX hQ
  -- Step 1: cut `f` off on `O ∩ U`: `φ = f`, `Dφ = Df` on an open `V ⊇ K`, `φ = id` off a
  -- compact `K' ⊆ O ∩ U`
  obtain ⟨φ, V, K', -, hKV, hK', hK'OU, hφ, hφf, hφid⟩ :=
    Submission.dimred_mbl_pfb_c1_compact_perturbation P (O ∩ U) K f (hO.inter hU) hK
      (subset_inter hKO hKU) (hf.mono inter_subset_left)
  -- Step 2: `Hⁿ`-a.e. point of `M` lies in `K`, as `Hⁿ(M ∖ K) = 0`
  have hae : ∀ᵐ x ∂μHE[n], x ∈ R.carrier → x ∈ K := by
    rw [ae_iff]
    exact measure_mono_null (fun x hx => not_imp.1 hx) hnull
  -- Step 3: `∂Q = 0` by the push-forward boundary formula for `φ`, once
  -- `Q(ω) = ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ⟩ dHⁿ`: the integrands agree on `M ∩ K ⊆ V`
  refine Submission.dpf_pushforward_formula_boundaryVanishes P n U K' X Q R φ hU hRX hK'
    (hK'OU.trans inter_subset_right) hφ hφid (fun ω => ?_) hX
  rw [hQ ω]
  refine setIntegral_congr_ae R.measurableSet_carrier ?_
  filter_upwards [hae] with x hxK hxM
  obtain ⟨h1, h2⟩ := hφf x (hKV (hxK hxM))
  rw [h1, h2]
/-- Steps 3(ii)–(iii) of the Jacobian identity for the orientation of a `C¹` graph (Simon 7.4.3,
via Allard's theorem): if `τ` is an orthonormal `n`-frame whose span contains every `F eⱼ`, then
`det(F* ∘ F) = (det 𝒜)²` with `𝒜ᵢⱼ = ⟨τᵢ, F eⱼ⟩`.  Expanding `F eⱼ = Σₗ 𝒜ₗⱼ τₗ` gives the Gram
identity `⟨F eᵢ, F eⱼ⟩ = (𝒜ᵀ𝒜)ᵢⱼ`, and the Gram matrix is the matrix of `F* ∘ F` in the standard
basis of `ℝⁿ`. -/
theorem Submission.dgoj_det_adjoint_comp_eq_det_sq : ∀ (P n : ℕ) (F : Euclid n →L[ℝ] Euclid P) (τ : Fin n → Euclid P), Orthonormal ℝ τ → (∀ j, F (EuclideanSpace.single j (1 : ℝ)) ∈ Submodule.span ℝ (Set.range τ)) → (F.adjoint ∘L F).det = (Matrix.of fun i j => inner ℝ (τ i) (F (EuclideanSpace.single j (1 : ℝ)))).det ^ 2 := by
  intro P n F τ hτ hb
  set A : Matrix (Fin n) (Fin n) ℝ :=
    Matrix.of fun i j => inner ℝ (τ i) (F (EuclideanSpace.single j (1 : ℝ))) with hA
  -- `F eⱼ = Σₗ 𝒜ₗⱼ τₗ`: the coordinates of a vector of `span τ` are its inner products with `τ`
  have hexp : ∀ j, F (EuclideanSpace.single j (1 : ℝ)) = ∑ l, A l j • τ l := by
    intro j
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 (hb j)
    have hcA : ∀ l, A l j = c l := by
      intro l
      rw [hA, Matrix.of_apply, ← hc, hτ.inner_right_fintype]
    rw [← hc]
    simp only [hcA]
  -- the Gram identity `⟨F eᵢ, F eⱼ⟩ = (𝒜ᵀ𝒜)ᵢⱼ`
  have hgram : ∀ i j, inner ℝ (F (EuclideanSpace.single i (1 : ℝ)))
      (F (EuclideanSpace.single j (1 : ℝ))) = (A.transpose * A) i j := by
    intro i j
    rw [Matrix.mul_apply]
    conv_lhs => rw [hexp i]
    rw [sum_inner]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [inner_smul_left, Matrix.transpose_apply]
    simp [hA]
  -- the matrix of `F* ∘ F` in the standard basis has entries `⟨eᵢ, F* F eⱼ⟩ = ⟨F eᵢ, F eⱼ⟩`
  let B := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis
  have hmat : LinearMap.toMatrix B B ((F.adjoint ∘L F : Euclid n →L[ℝ] Euclid n) : Euclid n →ₗ[ℝ] Euclid n)
      = A.transpose * A := by
    ext i j
    rw [LinearMap.toMatrix_apply, ← hgram i j]
    simp only [B, OrthonormalBasis.coe_toBasis, OrthonormalBasis.coe_toBasis_repr_apply,
      EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply, ContinuousLinearMap.coe_coe,
      ContinuousLinearMap.coe_comp, Function.comp_apply]
    rw [← ContinuousLinearMap.adjoint_inner_right, EuclideanSpace.inner_single_left]
    simp
  rw [ContinuousLinearMap.det, ← LinearMap.det_toMatrix B, hmat, Matrix.det_mul,
    Matrix.det_transpose, sq]
/-- Step 3 of the Jacobian identity for the orientation of a `C¹` graph (Simon 7.4.3, via
Allard's theorem): if `F : ℝⁿ → ℝᴾ` is injective, its range `L` has an orthonormal basis
`τ = (τ₁, …, τₙ)`, regarded as an orthonormal `n`-frame in `ℝᴾ` spanning `L`.  Since
`dim L = n`, reindex `stdOrthonormalBasis ℝ L` along `Fin (dim L) ≃ Fin n` and include it into
`ℝᴾ` by the linear isometry `L → ℝᴾ`. -/
theorem Submission.dgoj_exists_orthonormal_frame_range : ∀ (P n : ℕ) (F : Euclid n →L[ℝ] Euclid P), Injective F → ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧ Submodule.span ℝ (Set.range τ) = LinearMap.range (F : Euclid n →ₗ[ℝ] Euclid P) := by
  intro P n F hF
  set L := LinearMap.range (F : Euclid n →ₗ[ℝ] Euclid P) with hLdef
  -- `dim L = dim ℝⁿ = n`, since `F` is injective
  have hL : Module.finrank ℝ L = n := by
    rw [hLdef, LinearMap.finrank_range_of_inj hF, finrank_euclideanSpace_fin]
  let T : OrthonormalBasis (Fin n) ℝ L := (stdOrthonormalBasis ℝ L).reindex (finCongr hL)
  refine ⟨fun i => (T i : Euclid P), ?_, ?_⟩
  · -- the inclusion `L → ℝᴾ` is a linear isometry
    exact T.orthonormal.comp_linearIsometry L.subtypeₗᵢ
  · -- `span (ι '' range T) = ι '' span (range T) = ι '' L = L`
    have h1 : (fun i => (T i : Euclid P)) = L.subtype ∘ T := rfl
    rw [h1, Set.range_comp, Submodule.span_image, ← T.coe_toBasis, T.toBasis.span_eq,
      Submodule.map_top, Submodule.range_subtype]

/-- **The normalized evaluation at `F e` is a unit orientation of `range F`** (Simon 6.1.1,
6.1.7; `√det(F* ∘ F)` is the area Jacobian of Ch. 2, 3.1/3.3).  For injective `F : ℝⁿ → ℝᴾ`,
`det(F* ∘ F) > 0`, and if `α(F e₁, …, F eₙ) = √det(F* ∘ F) ξ(α)` for every `n`-covector `α` then
`ξ = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal frame `τ` of `range F`: with `d = det(⟨τᵢ, F eⱼ⟩)` one has
`det(F* ∘ F) = d² ≠ 0` and `α(F e) = d α(τ)`, so `|d| ξ(α) = d α(τ)` and the sign is that of `d`. -/
theorem Submission.dgoj_unitOrientation_of_injective : ∀ (P n : ℕ) (F : Euclid n →L[ℝ] Euclid P), Injective F → 0 < (F.adjoint ∘L F).det ∧ ∀ ξ : MultiVector P n, (∀ α : Covector (Euclid P) n, α (fun i => F (EuclideanSpace.single i (1 : ℝ))) = Real.sqrt ((F.adjoint ∘L F).det) * ξ α) → IsUnitOrientationOf ξ (LinearMap.range (F : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n F hF
  -- an orthonormal frame `τ` of `range F`; every `F eⱼ` lies in its span
  obtain ⟨τ, hτo, hτs⟩ := Submission.dgoj_exists_orthonormal_frame_range P n F hF
  have hb : ∀ j, F (EuclideanSpace.single j (1 : ℝ)) ∈ Submodule.span ℝ (Set.range τ) := by
    intro j
    rw [hτs]
    exact LinearMap.mem_range_self _ _
  -- `det(F* ∘ F) = d²` for `d = det(⟨τᵢ, F eⱼ⟩)`
  set d := (Matrix.of fun i j => inner ℝ (τ i) (F (EuclideanSpace.single j (1 : ℝ)))).det
  have hdet : (F.adjoint ∘L F).det = d ^ 2 :=
    Submission.dgoj_det_adjoint_comp_eq_det_sq P n F τ hτo hb
  -- `ker(F* ∘ F) = ker F = 0`, so `det(F* ∘ F) ≠ 0` and hence `d ≠ 0`
  have hd : d ≠ 0 := by
    intro h
    have h0 : (F.adjoint ∘L F).det = 0 := by rw [hdet, h, zero_pow two_ne_zero]
    apply LinearMap.det_eq_zero_iff_ker_ne_bot.1 h0
    rw [F.ker_adjoint_comp_self, LinearMap.ker_eq_bot]
    exact hF
  -- (i): `det(F* ∘ F) = d² > 0`
  refine ⟨by rw [hdet]; positivity, fun ξ hξ => ⟨τ, hτo, hτs, ?_⟩⟩
  -- (ii): `|d| ξ(α) = √det(F* ∘ F) ξ(α) = α(F e) = d α(τ)` for every `α`
  have key : ∀ α : Covector (Euclid P) n, |d| * ξ α = d * α τ := by
    intro α
    rw [← Real.sqrt_sq_eq_abs, ← hdet, ← hξ α]
    exact Submission.dgoj_covector_eq_det_mul_of_mem_span P n τ _ hτo hb α
  -- the sign of `d` decides between `ξ(α) = -α(τ)` and `ξ(α) = α(τ)`
  rcases hd.lt_or_gt with hneg | hpos
  · right
    intro α
    have h := key α
    rw [abs_of_neg hneg] at h
    apply mul_left_cancel₀ hd
    linarith
  · left
    intro α
    have h := key α
    rw [abs_of_pos hpos] at h
    exact mul_left_cancel₀ hd h
/-- `C¹` cutoff near a compact set: if `K ⊆ O ⊆ ℝᴾ`, `K` compact, `O` open and `f` is `C¹` on `O`,
then `g = χ • f` is `C¹` on `ℝᴾ` and globally Lipschitz, and `g = f`, `Dg = Df` on `K`.  Here `χ` is
a smooth Urysohn function, `χ = 1` on `cthickening (δ/3) K` and `support χ = thickening (2δ/3) K`
for `cthickening δ K ⊆ O`, so `g = f` near `K` and `g = 0` off the compact `tsupport χ ⊆ O`;
`Dg` is continuous with compact support, hence bounded, and the mean value inequality applies. -/
theorem Submission.dimred_mbl_pfi_c1_lipschitz_cutoff : ∀ (P : ℕ) (K O : Set (Euclid P)) (f : Euclid P → Euclid P), IsCompact K → IsOpen O → K ⊆ O → ContDiffOn ℝ 1 f O → ∃ (g : Euclid P → Euclid P) (L : NNReal), ContDiff ℝ 1 g ∧ LipschitzWith L g ∧ ∀ x ∈ K, g x = f x ∧ fderiv ℝ g x = fderiv ℝ f x := by
  intro P K O f hK hO hKO hf
  classical
  -- Step 1: room around `K` and a smooth Urysohn function `χ` with `tsupport χ ⊆ O` compact
  obtain ⟨δ, hδ, hδO⟩ := hK.exists_cthickening_subset_open hO hKO
  have hts : cthickening (δ / 3) K ⊆ thickening (2 * δ / 3) K :=
    cthickening_subset_thickening' (by positivity) (by linarith) K
  obtain ⟨χ, hχ, hχr, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := (⊤ : ℕ∞))
    isOpen_thickening isClosed_cthickening hts
  have hcl : tsupport χ ⊆ cthickening (2 * δ / 3) K := by
    rw [tsupport, hχs]
    exact closure_thickening_subset_cthickening _ _
  have hclO : tsupport χ ⊆ O := hcl.trans ((cthickening_mono (by linarith) K).trans hδO)
  have hχc : HasCompactSupport χ :=
    (hK.cthickening (r := 2 * δ / 3)).of_isClosed_subset (isClosed_tsupport _) hcl
  -- Step 2: `g = χ • f` is `C¹` at points of `O` (product rule) and off `O` (`g = 0` nearby)
  set g : Euclid P → Euclid P := fun x => χ x • f x with hgdef
  have hgC1 : ContDiff ℝ 1 g := by
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : x ∈ O
    · exact (hχ.contDiffAt.of_le (by exact_mod_cast le_top)).smul (hf.contDiffAt (hO.mem_nhds hx))
    · have hnx : (tsupport χ)ᶜ ∈ 𝓝 x :=
        (isClosed_tsupport χ).isOpen_compl.mem_nhds (fun h => hx (hclO h))
      apply (contDiffAt_const (c := (0 : Euclid P))).congr_of_eventuallyEq
      filter_upwards [hnx] with y hy
      simp [hgdef, image_eq_zero_of_notMem_tsupport hy]
  -- Step 3: `g = f` on the open set `thickening (δ/3) K ⊇ K`, where `χ = 1`
  have hgK : ∀ x ∈ K, g =ᶠ[𝓝 x] f := by
    intro x hx
    have hmem : thickening (δ / 3) K ∈ 𝓝 x :=
      isOpen_thickening.mem_nhds (self_subset_thickening (by positivity) K hx)
    filter_upwards [hmem] with y hy
    have h1 : χ y = 1 := (hχ1 y).1 (thickening_subset_cthickening _ _ hy)
    simp [hgdef, h1]
  -- Step 4: `Dg` is continuous with compact support, hence bounded; mean value inequality
  have hgc : HasCompactSupport g := hχc.smul_right
  obtain ⟨C, hC⟩ := hgc.fderiv (𝕜 := ℝ) |>.exists_bound_of_continuous
    (hgC1.continuous_fderiv one_ne_zero)
  refine ⟨g, (max C 0).toNNReal, hgC1, ?_, fun x hx =>
    ⟨(hgK x hx).eq_of_nhds, (hgK x hx).fderiv_eq⟩⟩
  refine lipschitzWith_of_nnnorm_fderiv_le (hgC1.differentiable one_ne_zero) (fun x => ?_)
  rw [← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal _ (le_max_right _ _)]
  exact (hC x).trans (le_max_left _ _)
/-- **The image of a weighted bi-Lipschitz piece is an integer multiplicity current** (one image
piece of the integrality of push-forwards, Simon Ch. 6, 3.3–3.9, via the area formula of Ch. 2).
Let `U` be open, `H : ℝⁿ → ℝᴾ` Lipschitz, `B` Borel with `m|a − a'| ≤ |H(a) − H(a')|` on `B`,
`DH(a)` injective for `a ∈ B` and `H(B) ⊆ U`; let `w ≥ 1` on `B` be integer-valued and
`ζ(a) = ±DH(a)_# e` for a.e. `a ∈ B`, with `∫_B w J < ∞`, `J = √det(DH* ∘ DH)`.  Then
`(H(B), w ∘ (H|_B)⁻¹, (J⁻¹ ζ) ∘ (H|_B)⁻¹)` is an integer multiplicity triple in `U` of mass
`∫_B w J` acting by `ω ↦ ∫_B w ⟨ω(H(a)), ζ(a)⟩ da`.  `H(B)` is Borel (Lusin–Souslin), the area
formula transports `Hⁿ⌞H(B)` to `J Lⁿ⌞B`, and for a.e. `a ∈ B` the approximate tangent space of
`H(B)` at `H(a)` is `range DH(a)`, oriented by `±DH(a)_# e / J(a)`. -/
theorem Submission.dimred_mbl_pfi_bilipschitz_piece_imrep : ∀ (P n : ℕ) (U : Set (Euclid P)) (H : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ) (w : Euclid n → ℕ) (ζ : Euclid n → MultiVector P n), IsOpen U → LipschitzWith L H → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖H a - H a'‖) → (∀ a ∈ B, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → H '' B ⊆ U → Measurable w → (∀ a ∈ B, 1 ≤ w a) → AEStronglyMeasurable ζ (volume.restrict B) → (∀ᵐ a ∂(volume.restrict B), ∃ s : ℝ, (s = 1 ∨ s = -1) ∧ ∀ α : Covector (Euclid P) n, ζ a α = s * α (fun j => fderiv ℝ H a (EuclideanSpace.single j (1 : ℝ)))) → ∫⁻ a in B, (w a : ℝ≥0∞) * ENNReal.ofReal (Real.sqrt (((fderiv ℝ H a).adjoint ∘L fderiv ℝ H a).det)) ∂volume ≠ ∞ → ∃ R : IMRep U n, R.measure U = ∫⁻ a in B, (w a : ℝ≥0∞) * ENNReal.ofReal (Real.sqrt (((fderiv ℝ H a).adjoint ∘L fderiv ℝ H a).det)) ∂volume ∧ ∀ ω : DifferentialForm (Euclid P) n, R.action ω = ∫ a in B, (w a : ℝ) * ζ a (ω (H a)) ∂volume := by
  intro P n U H B L m w ζ hU hHL hB hm hlow hdiff hHU hwm hw1 hζm hsign hfin
  classical
  -- Step 1: `H` is injective on `B`; `N = H(B)` is Borel and `H|_B` is a measurable embedding
  have hinj : InjOn H B := by
    intro a ha a' ha' h
    have h3 : m * ‖a - a'‖ ≤ m * 0 := by simpa [h] using hlow a ha a' ha'
    have h4 : ‖a - a'‖ ≤ 0 := le_of_mul_le_mul_left h3 hm
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h4)
  have hcont : ContinuousOn H B := hHL.continuous.continuousOn
  have hNmeas : MeasurableSet (H '' B) := hB.image_of_continuousOn_injOn hcont hinj
  have hemb : MeasurableEmbedding (B.domRestrict H) := hcont.measurableEmbedding hB hinj
  have heinj : Injective (B.domRestrict H) := hinj.injective
  -- Step 2: the Jacobian `J = √det(DH* ∘ DH)` is Borel, and positive on `B`
  set J : Euclid n → ℝ := fun a => Real.sqrt (((fderiv ℝ H a).adjoint ∘L fderiv ℝ H a).det)
    with hJdef
  have hcJ : Continuous (fun A : Euclid n →L[ℝ] Euclid P => Real.sqrt ((A.adjoint ∘L A).det)) := by
    refine Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp ?_)
    exact isBoundedBilinearMap_comp.continuous.comp
      ((ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid n) (F := Euclid P)).continuous.prodMk
        continuous_id)
  have hJmeas : Measurable J := hcJ.measurable.comp (measurable_fderiv ℝ H)
  have hJpos : ∀ a ∈ B, 0 < J a := fun a ha =>
    Real.sqrt_pos.2 (Submission.dgoj_unitOrientation_of_injective P n (fderiv ℝ H a) (hdiff a ha).2).1
  have hJarea : ∀ a, Poincare.SimonGMT.Chapter02.areaJacobianAt H a = J a := fun a =>
    Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_sqrt_det_adjoint_comp H a
  -- Step 3: the area formulas `∫⁻_N g dHⁿ = ∫⁻_B J (g ∘ H)` and `∫_N g dHⁿ = ∫_B J (g ∘ H)`
  have hareaL : ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in H '' B, g y ∂μHE[n] =
      ∫⁻ a in B, ENNReal.ofReal (J a) * g (H a) ∂volume := by
    intro g
    have h := Poincare.SimonGMT.Chapter02.weighted_area_formula_volume_of_injective_derivative
      hB (fun a ha => (hdiff a ha).1) (fun a ha => (hdiff a ha).2) hinj g
    rw [finrank_euclideanSpace_fin] at h
    simpa only [hJarea] using h
  have hareaI : ∀ g : Euclid P → ℝ, ∫ y in H '' B, g y ∂μHE[n] =
      ∫ a in B, J a * g (H a) ∂volume := by
    intro g
    have h := Poincare.SimonGMT.Chapter02.integral_area_formula_of_injective_derivative
      hB (fun a ha => (hdiff a ha).1) (fun a ha => (hdiff a ha).2) hinj g
    rw [finrank_euclideanSpace_fin, EuclideanSpace.euclideanHausdorffMeasure_eq_volume n] at h
    simpa only [hJarea, smul_eq_mul] using h
  -- Step 4: a strongly measurable version `ζ'` of `ζ`
  set ζ' := hζm.mk ζ with hζ'eq
  have hζ'sm : StronglyMeasurable ζ' := hζm.stronglyMeasurable_mk
  have hζ'ae : ζ =ᵐ[volume.restrict B] ζ' := hζm.ae_eq_mk
  -- Step 5: `mult = w ∘ (H|_B)⁻¹` and `orient = (J⁻¹ ζ') ∘ (H|_B)⁻¹` on `N`, `0` off `N`
  set mult : Euclid P → ℕ := Function.extend (B.domRestrict H) (fun a : B => w a) 0 with hmultdef
  set orient : Euclid P → MultiVector P n :=
    Function.extend (B.domRestrict H) (fun a : B => (J a)⁻¹ • ζ' a) 0 with horientdef
  have hmult_apply : ∀ a ∈ B, mult (H a) = w a := fun a ha =>
    heinj.extend_apply (fun a : B => w a) 0 ⟨a, ha⟩
  have horient_apply : ∀ a ∈ B, orient (H a) = (J a)⁻¹ • ζ' a := fun a ha =>
    heinj.extend_apply (fun a : B => (J a)⁻¹ • ζ' a) 0 ⟨a, ha⟩
  have hmult_meas : Measurable mult :=
    hemb.measurable_extend (hwm.comp measurable_subtype_coe) measurable_const
  have horient_sm : StronglyMeasurable orient :=
    hemb.stronglyMeasurable_extend
      (((hJmeas.inv.stronglyMeasurable).smul hζ'sm).comp_measurable measurable_subtype_coe)
      stronglyMeasurable_const
  -- Step 6: `∫⁻_N mult dHⁿ = ∫⁻_B w J < ∞`, and `Hⁿ(N) ≤ ∫⁻_B w J` as `w ≥ 1` on `B`
  have hlint : ∫⁻ y in H '' B, (mult y : ℝ≥0∞) ∂μHE[n] =
      ∫⁻ a in B, (w a : ℝ≥0∞) * ENNReal.ofReal (J a) ∂volume := by
    rw [hareaL]
    refine setLIntegral_congr_fun hB (fun a ha => ?_)
    simp only [hmult_apply a ha]
    ring
  have hNfin : μHE[n] (H '' B) ≠ ∞ := by
    refine ne_top_of_le_ne_top hfin ?_
    rw [← setLIntegral_one, hareaL]
    refine setLIntegral_mono' hB (fun a ha => ?_)
    simp only [mul_one]
    calc ENNReal.ofReal (J a) = 1 * ENNReal.ofReal (J a) := (one_mul _).symm
      _ ≤ (w a : ℝ≥0∞) * ENNReal.ofReal (J a) := by
          gcongr
          exact_mod_cast hw1 a ha
  -- Step 7: for a.e. `a ∈ B`, `N` has approximate tangent space `range DH(a)` at `H(a)`, and
  -- `orient(H(a)) = ±DH(a)_# e / J(a)` is a unit orientation of it
  have htan := Submission.dpf_approxTangent_ae_bilipschitz_piece P n univ (H '' B) H B L m isOpen_univ hNmeas (subset_univ _)
    (fun C _ _ => ne_top_of_le_ne_top hNfin (measure_mono inter_subset_left))
    hHL hB hm hlow hdiff subset_rfl
  have hgood : ∀ᵐ a ∂(volume.restrict B), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (H '' B) (H a) Q ∧ IsUnitOrientationOf (orient (H a)) Q := by
    filter_upwards [htan, hsign, hζ'ae, ae_restrict_mem hB] with a ha1 ha2 ha3 haB
    obtain ⟨s, hs, hsα⟩ := ha2
    refine ⟨_, ha1, ?_⟩
    rw [horient_apply a haB]
    have hJa := hJpos a haB
    have hc5 := (Submission.dgoj_unitOrientation_of_injective P n (fderiv ℝ H a) (hdiff a haB).2).2 (s • ((J a)⁻¹ • ζ' a)) (by
      intro α
      have hα := hsα α
      rw [ha3] at hα
      have hs2 : s ^ 2 = 1 := by rcases hs with rfl | rfl <;> norm_num
      simp only [FunLike.coe_smul, Pi.smul_apply, smul_eq_mul, hα]
      field_simp
      rw [hs2, mul_one])
    rcases hs with rfl | rfl
    · simpa using hc5
    · obtain ⟨τ, hτ, hspan, hor⟩ := hc5
      refine ⟨τ, hτ, hspan, ?_⟩
      rcases hor with h | h
      · right
        intro α
        have := h α
        simp only [FunLike.coe_smul, Pi.smul_apply, smul_eq_mul] at this ⊢
        linarith
      · left
        intro α
        have := h α
        simp only [FunLike.coe_smul, Pi.smul_apply, smul_eq_mul] at this ⊢
        linarith
  -- Step 8: transfer to `Hⁿ`-a.e. `y ∈ N`; the exceptional set has `Hⁿ`-null image (`H` Lipschitz)
  have horients : ∀ᵐ y ∂(μHE[n].restrict (H '' B)), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (H '' B) y Q ∧ IsUnitOrientationOf (orient y) Q := by
    rw [ae_restrict_iff' hB] at hgood
    rw [ae_iff] at hgood
    rw [ae_restrict_iff' hNmeas, ae_iff]
    set Z := {a | ¬(a ∈ B → ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (H '' B) (H a) Q ∧ IsUnitOrientationOf (orient (H a)) Q)}
    have hZ : μHE[n] (H '' Z) = 0 := by
      have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn
        (A := Z) n (hHL.lipschitzOnWith)
      rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume n, hgood, mul_zero] at h
      exact nonpos_iff_eq_zero.mp h
    refine measure_mono_null ?_ hZ
    intro y hy
    simp only [mem_ofPred_eq, not_imp] at hy
    obtain ⟨⟨a, haB, rfl⟩, hbad⟩ := hy
    push Not at hbad
    refine ⟨a, ?_, rfl⟩
    show ¬(a ∈ B → _)
    intro h
    obtain ⟨Q, h1, h2⟩ := h haB
    exact hbad Q h1 h2
  -- Step 9: `(N, mult, orient)` is an integer multiplicity triple in `U`
  let R : IMRep U n :=
    { carrier := H '' B
      mult := mult
      orient := orient
      measurableSet_carrier := hNmeas
      carrier_subset := hHU
      rectifiable := (Poincare.SimonGMT.Chapter03.countablyRectifiable_range hHL).mono
        (image_subset_range _ _)
      measurable_mult := hmult_meas
      mult_pos := by
        rintro _ ⟨a, ha, rfl⟩
        rw [hmult_apply a ha]
        exact hw1 a ha
      locallyIntegrable_mult := by
        intro C _ _
        refine ne_top_of_le_ne_top ?_ (lintegral_mono_set inter_subset_left)
        rw [hlint]; exact hfin
      aestronglyMeasurable_orient := horient_sm.aestronglyMeasurable
      orients := horients }
  -- Steps 10–11: the mass `μ_R(U) = ∫⁻_N mult dHⁿ` and the action, by the area formulas
  refine ⟨R, ?_, fun ω => ?_⟩
  · show ((μHE[n].restrict (H '' B)).withDensity fun x => (mult x : ℝ≥0∞)) U = _
    rw [withDensity_apply _ hU.measurableSet, Measure.restrict_restrict hU.measurableSet,
      inter_eq_right.mpr hHU, hlint]
  · show ∫ x in H '' B, (mult x : ℝ) * orient x (ω x) ∂μHE[n] = _
    rw [hareaI]
    refine setIntegral_congr_ae hB ?_
    filter_upwards [(ae_restrict_iff' hB).1 hζ'ae] with a ha haB
    rw [hmult_apply a haB, horient_apply a haB, ha haB]
    have hJa := (hJpos a haB).ne'
    simp only [FunLike.coe_smul, Pi.smul_apply, smul_eq_mul]
    field_simp

/-- Algebra of the area Jacobian for the push-forward of an integer multiplicity current by a `C¹`
map (Simon 6.3.3–3.9; `J_A = √det(A* ∘ A)` is the area Jacobian of Ch. 2, 3.1/3.3).  For linear
`A : ℝⁿ → ℝᴾ` and `Ae = (A e₁, …, A eₙ)`: (a) `J_{L∘A} ≤ ‖L‖ⁿ J_A` for every linear `L` of `ℝᴾ`;
(b) `|α(Ae)| ≤ J_A ‖α‖` for every `n`-covector `α`; (c) if `A` is injective, then
`J_A ξ(α) = s α(Ae)` for every unit orientation `ξ` of `range A`, with one sign `s = ±1` for all
`α`.  If `A` is not injective, `Ae` is linearly dependent, so `α(Ae) = 0`.  Otherwise
`ζ(α) = J_A⁻¹ α(Ae)` is a unit orientation `±τ₁ ∧ ⋯ ∧ τₙ` of `range A`, which gives (b) as
`|α(τ)| ≤ ‖α‖`, and (c) since two unit orientations of `range A` differ by a sign.  For (a),
with orthonormal frames `τ` of `range A` and `σ` of `range (L ∘ A)`, `J_A = |det M|` and
`J_{L∘A} = |det N|` for `M = (⟨τᵢ, A eⱼ⟩)` and `N = (⟨σᵢ, L A eⱼ⟩) = K M`, `K = (⟨σᵢ, L τₖ⟩)`;
by Hadamard's inequality `|det K| ≤ ∏ₖ |L τₖ| ≤ ‖L‖ⁿ`. -/
theorem Submission.dimred_mbl_pfi_gram_jacobian_algebra : ∀ (P n : ℕ) (A : Euclid n →L[ℝ] Euclid P), (∀ L : Euclid P →L[ℝ] Euclid P, Real.sqrt (((L ∘L A).adjoint ∘L (L ∘L A)).det) ≤ ‖L‖ ^ n * Real.sqrt ((A.adjoint ∘L A).det)) ∧ (∀ α : Covector (Euclid P) n, |α (fun j => A (EuclideanSpace.single j (1 : ℝ)))| ≤ Real.sqrt ((A.adjoint ∘L A).det) * ‖α‖) ∧ (Injective A → ∀ ξ : MultiVector P n, IsUnitOrientationOf ξ (LinearMap.range (A : Euclid n →ₗ[ℝ] Euclid P)) → ∃ s : ℝ, (s = 1 ∨ s = -1) ∧ ∀ α : Covector (Euclid P) n, Real.sqrt ((A.adjoint ∘L A).det) * ξ α = s * α (fun j => A (EuclideanSpace.single j (1 : ℝ)))) := by
  intro P n A
  -- if `A` is not injective, `Ae` is linearly dependent and every `α(Ae)` vanishes
  have hdep : ¬ Injective A → ∀ α : Covector (Euclid P) n,
      α (fun j => A (EuclideanSpace.single j (1 : ℝ))) = 0 := by
    intro hA α
    apply α.toAlternatingMap.map_linearDependent
    intro hli
    apply hA
    rw [injective_iff_map_eq_zero]
    intro x hx
    have hx' : ∑ j, x j • A (EuclideanSpace.single j (1 : ℝ)) = 0 := by
      have hsum : x = ∑ j, x j • EuclideanSpace.single j (1 : ℝ) := by
        ext k
        simp [Pi.single_apply]
      have : A x = 0 := hx
      rw [hsum, map_sum] at this
      simpa [map_smul] using this
    have h0 := (Fintype.linearIndependent_iff.mp hli) (fun j => x j) hx'
    ext k
    simp [h0 k]
  -- if `A` is injective, `J_A > 0` and `ζ(α) = J_A⁻¹ α(Ae)` is a unit orientation of `range A`
  have hζ : Injective A → 0 < Real.sqrt ((A.adjoint ∘L A).det) ∧ ∃ ζ : MultiVector P n,
      (∀ β : Covector (Euclid P) n, β (fun j => A (EuclideanSpace.single j (1 : ℝ))) =
        Real.sqrt ((A.adjoint ∘L A).det) * ζ β) ∧
      IsUnitOrientationOf ζ (LinearMap.range (A : Euclid n →ₗ[ℝ] Euclid P)) := by
    intro hA
    obtain ⟨hpos, hor⟩ := Submission.dgoj_unitOrientation_of_injective P n A hA
    have hJpos : 0 < Real.sqrt ((A.adjoint ∘L A).det) := Real.sqrt_pos.2 hpos
    let ζ : MultiVector P n := (Real.sqrt ((A.adjoint ∘L A).det))⁻¹ •
      ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun j => A (EuclideanSpace.single j (1 : ℝ)))
    have hev : ∀ β : Covector (Euclid P) n, β (fun j => A (EuclideanSpace.single j (1 : ℝ))) =
        Real.sqrt ((A.adjoint ∘L A).det) * ζ β := by
      intro β
      simp only [ζ, FunLike.coe_smul, Pi.smul_apply, ContinuousAlternatingMap.apply_apply,
        smul_eq_mul]
      field_simp
    exact ⟨hJpos, ζ, hev, hor ζ hev⟩
  refine ⟨fun L => ?_, fun α => ?_, fun hA ξ hξ => ?_⟩
  · -- (a)
    by_cases hLA : Injective (L ∘L A)
    · have hA : Injective A := fun x y hxy => hLA (by simp [hxy])
      -- orthonormal frames `σ` of `range (L ∘ A)` and `τ` of `range A`
      obtain ⟨σ, hσo, hσs⟩ := Submission.dgoj_exists_orthonormal_frame_range P n (L ∘L A) hLA
      obtain ⟨τ, hτo, hτs⟩ := Submission.dgoj_exists_orthonormal_frame_range P n A hA
      have hbσ : ∀ j, (L ∘L A) (EuclideanSpace.single j (1 : ℝ)) ∈
          Submodule.span ℝ (Set.range σ) := by
        intro j
        rw [hσs]
        exact LinearMap.mem_range_self _ _
      have hbτ : ∀ j, A (EuclideanSpace.single j (1 : ℝ)) ∈ Submodule.span ℝ (Set.range τ) := by
        intro j
        rw [hτs]
        exact LinearMap.mem_range_self _ _
      -- `J_{L∘A} = |det N|` and `J_A = |det M|`
      rw [Submission.dgoj_det_adjoint_comp_eq_det_sq P n (L ∘L A) σ hσo hbσ,
        Submission.dgoj_det_adjoint_comp_eq_det_sq P n A τ hτo hbτ,
        Real.sqrt_sq_eq_abs, Real.sqrt_sq_eq_abs]
      set M := Matrix.of fun i j => inner ℝ (τ i) (A (EuclideanSpace.single j (1 : ℝ))) with hM
      set K := Matrix.of fun i k => inner ℝ (σ i) (L (τ k)) with hK
      -- `A eⱼ = ∑ₖ Mₖⱼ τₖ`
      have hexp : ∀ j, A (EuclideanSpace.single j (1 : ℝ)) = ∑ k, M k j • τ k := by
        intro j
        obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 (hbτ j)
        have hcM : ∀ k, M k j = c k := by
          intro k
          rw [hM, Matrix.of_apply, ← hc]
          exact hτo.inner_right_fintype c k
        simp_rw [hcM]
        exact hc.symm
      -- `N = K M`
      have hN : (Matrix.of fun i j => inner ℝ (σ i) ((L ∘L A) (EuclideanSpace.single j (1 : ℝ)))) =
          K * M := by
        ext i j
        rw [Matrix.of_apply, Matrix.mul_apply, ContinuousLinearMap.comp_apply, hexp j, map_sum,
          inner_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [map_smul, inner_smul_right, hK, Matrix.of_apply, mul_comm]
      rw [hN, Matrix.det_mul, abs_mul]
      refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
      -- Hadamard's inequality: `|det K| ≤ ∏ₖ |L τₖ| ≤ ‖L‖ⁿ`
      set Q := Submodule.span ℝ (Set.range σ)
      have hmem : ∀ i, σ i ∈ Q := fun i => Submodule.subset_span (Set.mem_range_self i)
      let u : Fin n → Q := fun i => ⟨σ i, hmem i⟩
      have hu : Orthonormal ℝ u := by
        rw [← Q.subtypeₗᵢ.orthonormal_comp_iff (v := u)]
        exact hσo
      have huspan : ⊤ ≤ Submodule.span ℝ (Set.range u) := by
        rintro ⟨y, hy⟩ -
        rw [Submodule.mem_span_range_iff_exists_fun] at hy
        obtain ⟨c, hc⟩ := hy
        rw [Submodule.mem_span_range_iff_exists_fun]
        exact ⟨c, Subtype.ext (by simpa [u] using hc)⟩
      let b : OrthonormalBasis (Fin n) ℝ Q := OrthonormalBasis.mk hu huspan
      have hb : ∀ i, (b i : Euclid P) = σ i := fun i => by simp [b, u]
      have hw : ∀ k, L (τ k) ∈ Q := by
        intro k
        have hk : τ k ∈ LinearMap.range (A : Euclid n →ₗ[ℝ] Euclid P) :=
          hτs ▸ Submodule.subset_span (Set.mem_range_self k)
        obtain ⟨x, hx⟩ := hk
        rw [hσs]
        exact ⟨x, by simp [← hx]⟩
      let w : Fin n → Q := fun k => ⟨L (τ k), hw k⟩
      have hKw : K.det = b.toBasis.det w := by
        rw [Module.Basis.det_apply]
        congr 1
        ext i k
        rw [Module.Basis.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
          OrthonormalBasis.repr_apply_apply, Submodule.coe_inner, hb, hK, Matrix.of_apply]
      have : Fact (Module.finrank ℝ Q = n) :=
        ⟨by rw [Module.finrank_eq_card_basis b.toBasis, Fintype.card_fin]⟩
      have hH := (b.toBasis.orientation).abs_volumeForm_apply_le w
      rw [(b.toBasis.orientation).volumeForm_robust b rfl] at hH
      rw [hKw]
      refine hH.trans ?_
      calc ∏ k, ‖w k‖ ≤ ∏ _k : Fin n, ‖L‖ := by
            refine Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) fun k _ => ?_
            have h1 : ‖w k‖ = ‖L (τ k)‖ := rfl
            rw [h1]
            calc ‖L (τ k)‖ ≤ ‖L‖ * ‖τ k‖ := L.le_opNorm _
              _ = ‖L‖ := by rw [hτo.1 k, mul_one]
        _ = ‖L‖ ^ n := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    · -- `L ∘ A` is not injective: `det((L ∘ A)* ∘ (L ∘ A)) = 0`
      have h0 : ((L ∘L A).adjoint ∘L (L ∘L A)).det = 0 := by
        apply LinearMap.det_eq_zero_iff_ker_ne_bot.2
        rw [ContinuousLinearMap.ker_adjoint_comp_self, Ne, LinearMap.ker_eq_bot]
        exact hLA
      rw [h0, Real.sqrt_zero]
      positivity
  · -- (b)
    by_cases hA : Injective A
    · obtain ⟨hJpos, ζ, hev, τ, hτ, -, hsgn⟩ := hζ hA
      have hατ : |α τ| ≤ ‖α‖ := by
        simpa [hτ.norm_eq_one, Real.norm_eq_abs] using α.le_opNorm τ
      rw [hev α, abs_mul, abs_of_pos hJpos]
      refine mul_le_mul_of_nonneg_left ?_ hJpos.le
      rcases hsgn with h | h
      · rwa [h α]
      · rwa [h α, abs_neg]
    · rw [hdep hA α, abs_zero]
      positivity
  · -- (c): `ξ = ±ζ`
    obtain ⟨-, ζ, hev, hζo⟩ := hζ hA
    rcases Submission.rsdic_unitOrientation_eq_or_eq_neg P n ζ ξ _ hζo hξ with h | h
    · exact ⟨1, Or.inl rfl, fun α => by rw [h, hev α]; ring⟩
    · exact ⟨-1, Or.inr rfl, fun α => by rw [h, hev α, neg_apply]; ring⟩

/-- Orientation of an integer multiplicity triple `(M, θ, ξ)` in `U` along a bi-Lipschitz piece of
its carrier: let `F` be Lipschitz, `B` Borel with `m|a − a'| ≤ |F(a) − F(a')|` on `B`, `DF(a)`
injective for `a ∈ B`, and `F(B) ⊆ M`.  Then `b ↦ ξ(F(b))` is a.e. strongly measurable on `B`, and
for a.e. `b ∈ B`, `ξ(F(b))` is a unit orientation of `range DF(b)`.  As `θ ≥ 1` on `M`, `M` is
locally `Hⁿ`-finite in `U`, so it has approximate tangent space `range DF(b)` at `F(b)` for a.e.
`b`; `ξ` orients an approximate tangent space of `M` `Hⁿ`-a.e. on `F(B) ⊆ M`, which pulls back to
a.e. `b ∈ B`; and approximate tangent spaces are unique (Simon Ch. 3, Remark 1.5(1)). -/
theorem Submission.dimred_mbl_pfi_imrep_orient_along_piece : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), IsOpen U → LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → (∀ a ∈ B, DifferentiableAt ℝ F a ∧ Injective (fderiv ℝ F a)) → F '' B ⊆ R.carrier → AEStronglyMeasurable (fun b => R.orient (F b)) (volume.restrict B) ∧ ∀ᵐ b ∂(volume.restrict B), IsUnitOrientationOf (R.orient (F b)) (LinearMap.range (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n U R F B L m hU hFL hB hm hlow hdiff hsub
  -- Step 1: `θ ≥ 1` on `M` and `θ` is locally integrable, so `M` is locally `Hⁿ`-finite in `U`
  have hloc : ∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (R.carrier ∩ C) ≠ ∞ := by
    intro C hC hCU
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult C hC hCU) ?_
    rw [← setLIntegral_one]
    refine setLIntegral_mono' (R.measurableSet_carrier.inter hC.isClosed.measurableSet)
      (fun x hx => ?_)
    have := R.mult_pos x hx.1
    exact_mod_cast this
  -- Step 2: `M` has approximate tangent space `range DF(b)` at `F(b)` for a.e. `b ∈ B`
  have htan := Submission.dpf_approxTangent_ae_bilipschitz_piece P n U R.carrier F B L m hU
    R.measurableSet_carrier R.carrier_subset hloc hFL hB hm hlow hdiff hsub
  -- Step 3: `ξ(F(b))` orients some approximate tangent space of `M` at `F(b)` for a.e. `b ∈ B`
  have hpull := (Submission.ptd_piece_image_measurable_ae_pullback P n F B L m hFL hB hm hlow).2
  have hor1 : ∀ᵐ y ∂(μHE[n].restrict (F '' B)), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n R.carrier y Q ∧ IsUnitOrientationOf (R.orient y) Q :=
    ae_restrict_of_ae_restrict_of_subset hsub R.orients
  have hor2 := hpull _ hor1
  -- Step 5: `ξ(F(b)) = ξ̃(F(b))` for a.e. `b ∈ B`, `ξ̃` a strongly measurable version of `ξ`
  have hξ := R.aestronglyMeasurable_orient
  have heq1 : ∀ᵐ y ∂(μHE[n].restrict (F '' B)), R.orient y = hξ.mk _ y :=
    ae_restrict_of_ae_restrict_of_subset hsub hξ.ae_eq_mk
  have heq2 := hpull _ heq1
  refine ⟨?_, ?_⟩
  · refine (hξ.stronglyMeasurable_mk.comp_measurable
      hFL.continuous.measurable).aestronglyMeasurable.congr ?_
    filter_upwards [heq2] with b hb
    exact hb.symm
  -- Step 4: uniqueness of approximate tangent spaces identifies the oriented one with `range DF(b)`
  · filter_upwards [htan, hor2] with b hb1 hb2
    obtain ⟨Q, hQ, hor⟩ := hb2
    have hQeq := hQ.unique hb1
    rw [← hQeq]
    exact hor

/-- A summable series of integer-weighted Lipschitz parametrizations `Hᵢ : Bᵢ → U` with
orientations `ζᵢ = ±DHᵢ#e` is summed by one integer multiplicity triple `R` in `U`:
`Σᵢ ∫_{Bᵢ} wᵢ ⟨ω ∘ Hᵢ, ζᵢ⟩ = R(ω)` for every `ω ∈ 𝒟ⁿ(U)`.  `DHᵢ` is injective on
`Bᵢ⁺ = {a ∈ Bᵢ : Jᵢ(a) > 0, wᵢ(a) ≥ 1}`; cut `Bᵢ⁺` into bi-Lipschitz pieces `C_{il}`, make each
piece a triple `R_{il}` by the area formula and sum the `R_{il}`, whose total mass is at most
`Σᵢ ∫_{Bᵢ} wᵢJᵢ < ∞`.  The integrands are dominated by `wᵢJᵢ‖ω‖_∞` and vanish a.e. off `Bᵢ⁺`,
so summing over the pieces of each `Bᵢ⁺` gives the series. -/
theorem Submission.dimred_mbl_pfi_param_series_imrep : ∀ (P n : ℕ) (U : Set (Euclid P)) (H : ℕ → Euclid n → Euclid P) (B : ℕ → Set (Euclid n)) (w : ℕ → Euclid n → ℕ) (ζ : ℕ → Euclid n → MultiVector P n), IsOpen U → (∀ i, ∃ L : NNReal, LipschitzWith L (H i)) → (∀ i, MeasurableSet (B i)) → (∀ i, ∀ a ∈ B i, DifferentiableAt ℝ (H i) a) → (∀ i, H i '' B i ⊆ U) → (∀ i, Measurable (w i)) → (∀ i, AEStronglyMeasurable (ζ i) (volume.restrict (B i))) → (∀ i, ∀ᵐ a ∂(volume.restrict (B i)), ∃ s : ℝ, (s = 1 ∨ s = -1) ∧ ∀ α : Covector (Euclid P) n, ζ i a α = s * α (fun j => fderiv ℝ (H i) a (EuclideanSpace.single j (1 : ℝ)))) → ∑' i, ∫⁻ a in B i, (w i a : ℝ≥0∞) * ENNReal.ofReal (Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det)) ∂volume ≠ ∞ → ∃ R : IMRep U n, ∀ ω : TestFormOn U n, HasSum (fun i => ∫ a in B i, (w i a : ℝ) * ζ i a ((ω : DifferentialForm (Euclid P) n) (H i a)) ∂volume) (R.action (ω : DifferentialForm (Euclid P) n)) := by
  intro P n U H B w ζ hU hHL hBm hHd hHU hwm hζm hsign hsum
  classical
  choose LH hLH using hHL
  have hcJ : Continuous (fun A : Euclid n →L[ℝ] Euclid P => Real.sqrt ((A.adjoint ∘L A).det)) := by
    refine Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp ?_)
    exact isBoundedBilinearMap_comp.continuous.comp
      ((ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid n) (F := Euclid P)).continuous.prodMk
        continuous_id)
  have hJmeas : ∀ i, Measurable (fun a =>
      Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det)) :=
    fun i => hcJ.measurable.comp (measurable_fderiv ℝ (H i))
  set Bp : ℕ → Set (Euclid n) := fun i => B i ∩
    {a | 0 < Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det)} ∩
    {a | 1 ≤ w i a}
  have hBpm : ∀ i, MeasurableSet (Bp i) := fun i =>
    ((hBm i).inter (measurableSet_lt measurable_const (hJmeas i))).inter
      (measurableSet_le measurable_const (hwm i))
  have hBpB : ∀ i, Bp i ⊆ B i := fun i => inter_subset_left.trans inter_subset_left
  have hinjBp : ∀ i, ∀ a ∈ Bp i, DifferentiableAt ℝ (H i) a ∧ Injective (fderiv ℝ (H i) a) := by
    intro i a ha
    refine ⟨hHd i a (hBpB i ha), ?_⟩
    have hpos : 0 < ((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det :=
      Real.sqrt_pos.mp ha.1.2
    set A := fderiv ℝ (H i) a
    have hT : IsUnit ((A.adjoint ∘L A : Euclid n →L[ℝ] Euclid n) : Euclid n →ₗ[ℝ] Euclid n) :=
      (LinearMap.isUnit_iff_isUnit_det _).2 (isUnit_iff_ne_zero.2 hpos.ne')
    intro x y hxy
    have h2 : (A.adjoint ∘L A) x = (A.adjoint ∘L A) y := by
      simp only [ContinuousLinearMap.comp_apply, hxy]
    exact (Module.End.isUnit_iff _).1 hT |>.1 h2
  have hpart := fun i => Submission.dimred_mbl_pfi_bilipschitz_partition P n (H i) (Bp i) (hBpm i)
    (hinjBp i)
  choose C mC hCm hCdisj hCunion hmC hClow using hpart
  have hCsub : ∀ i l, C i l ⊆ Bp i := fun i l => (hCunion i) ▸ subset_iUnion (C i) l
  have hJfin : ∀ i, ∫⁻ a in B i, (w i a : ℝ≥0∞) *
      ENNReal.ofReal (Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det))
        ∂volume ≠ ∞ := fun i => ENNReal.ne_top_of_tsum_ne_top hsum i
  have hpiece : ∀ i l, ∃ R : IMRep U n, R.measure U = ∫⁻ a in C i l, (w i a : ℝ≥0∞) *
      ENNReal.ofReal (Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det))
        ∂volume ∧ ∀ ω : DifferentialForm (Euclid P) n,
          R.action ω = ∫ a in C i l, (w i a : ℝ) * ζ i a (ω (H i a)) ∂volume := by
    intro i l
    have hsub : C i l ⊆ B i := (hCsub i l).trans (hBpB i)
    exact Submission.dimred_mbl_pfi_bilipschitz_piece_imrep P n U (H i) (C i l) (LH i) (mC i l)
      (w i) (ζ i) hU (hLH i) (hCm i l) (hmC i l) (hClow i l) (fun a ha => hinjBp i a (hCsub i l ha))
      ((Set.image_mono hsub).trans (hHU i)) (hwm i) (fun a ha => (hCsub i l ha).2)
      ((hζm i).mono_measure (Measure.restrict_mono hsub le_rfl))
      (ae_restrict_of_ae_restrict_of_subset hsub (hsign i))
      (ne_top_of_le_ne_top (hJfin i) (lintegral_mono_set hsub))
  choose Rp hRpmeas hRpact using hpiece
  let e : ℕ ≃ ℕ × ℕ := Nat.pairEquiv.symm
  have hmass : ∑' k, (Rp (e k).1 (e k).2).measure U ≠ ∞ := by
    rw [e.tsum_eq (fun p => (Rp p.1 p.2).measure U), ENNReal.tsum_prod']
    simp_rw [hRpmeas]
    refine ne_top_of_le_ne_top hsum (ENNReal.tsum_le_tsum fun i => ?_)
    rw [← lintegral_iUnion (hCm i) (hCdisj i), hCunion i]
    exact lintegral_mono_set (hBpB i)
  obtain ⟨R', hR'⟩ := Submission.cmcdt_ims_imrep_tsum P n U (fun k => Rp (e k).1 (e k).2) hU hmass
  refine ⟨R', fun ω => ?_⟩
  have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous ω.property.1.1
  obtain ⟨Bω, hBω⟩ := HasCompactSupport.exists_bound_of_continuous ω.property.1.2 hωc
  have hint : ∀ i, IntegrableOn
      (fun a => (w i a : ℝ) * ζ i a ((ω : DifferentialForm (Euclid P) n) (H i a))) (B i) volume := by
    intro i
    have hζ' := hζm i
    have hsm : StronglyMeasurable
        (fun a => (w i a : ℝ) * (hζ'.mk _ a) ((ω : DifferentialForm (Euclid P) n) (H i a))) := by
      have hc : Continuous (fun p : MultiVector P n × Covector (Euclid P) n => p.1 p.2) :=
        isBoundedBilinearMap_apply.continuous
      exact (measurable_from_nat.comp (hwm i)).stronglyMeasurable.mul
        (hc.comp_stronglyMeasurable (hζ'.stronglyMeasurable_mk.prodMk
          (hωc.comp (hLH i).continuous).stronglyMeasurable))
    have hae : (fun a => (w i a : ℝ) * ζ i a ((ω : DifferentialForm (Euclid P) n) (H i a)))
        =ᵐ[volume.restrict (B i)]
        (fun a => (w i a : ℝ) * (hζ'.mk _ a) ((ω : DifferentialForm (Euclid P) n) (H i a))) := by
      filter_upwards [hζ'.ae_eq_mk] with a ha
      simp only [ha]
    have hdom : IntegrableOn (fun a => Bω * ((w i a : ℝ) *
        Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det))) (B i) volume := by
      refine Integrable.const_mul ?_ _
      refine ⟨((measurable_from_nat.comp (hwm i)).mul (hJmeas i)).aestronglyMeasurable, ?_⟩
      rw [HasFiniteIntegral]
      have : ∀ a, ‖(w i a : ℝ) *
          Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det)‖ₑ =
          (w i a : ℝ≥0∞) *
            ENNReal.ofReal (Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det)) := by
        intro a
        rw [← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (by positivity),
          ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast]
      simp_rw [this]
      exact (hJfin i).lt_top
    refine hdom.mono' (hsm.aestronglyMeasurable.congr hae.symm) ?_
    filter_upwards [hsign i] with a ⟨s, hs, hsα⟩
    rw [hsα, norm_mul, norm_mul, Real.norm_natCast]
    have hb := (Submission.dimred_mbl_pfi_gram_jacobian_algebra P n (fderiv ℝ (H i) a)).2.1
      ((ω : DifferentialForm (Euclid P) n) (H i a))
    have hs1 : ‖s‖ = 1 := by rcases hs with h | h <;> simp [h]
    rw [hs1, one_mul, Real.norm_eq_abs]
    calc (w i a : ℝ) * |((ω : DifferentialForm (Euclid P) n) (H i a))
          (fun j => fderiv ℝ (H i) a (EuclideanSpace.single j (1 : ℝ)))|
        ≤ (w i a : ℝ) * (Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det) * Bω) := by
          gcongr
          exact hb.trans (mul_le_mul_of_nonneg_left (hBω _) (Real.sqrt_nonneg _))
      _ = Bω * ((w i a : ℝ) *
          Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det)) := by ring
  have hvanish : ∀ i,
      ∫ a in B i, (w i a : ℝ) * ζ i a ((ω : DifferentialForm (Euclid P) n) (H i a)) ∂volume =
        ∫ a in Bp i, (w i a : ℝ) * ζ i a ((ω : DifferentialForm (Euclid P) n) (H i a)) ∂volume := by
    intro i
    refine setIntegral_eq_of_subset_of_ae_sdiff_eq_zero (hBm i).nullMeasurableSet (hBpB i) ?_
    filter_upwards [(ae_restrict_iff' (hBm i)).1 (hsign i)] with a ha hdiff
    obtain ⟨s, hs, hsα⟩ := ha hdiff.1
    have hnot : ¬ (0 < Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det) ∧
        1 ≤ w i a) := fun h => hdiff.2 ⟨⟨hdiff.1, h.1⟩, h.2⟩
    by_cases hw : 1 ≤ w i a
    · have hJ0 : Real.sqrt (((fderiv ℝ (H i) a).adjoint ∘L fderiv ℝ (H i) a).det) = 0 :=
        le_antisymm (not_lt.1 fun h => hnot ⟨h, hw⟩) (Real.sqrt_nonneg _)
      have hb := (Submission.dimred_mbl_pfi_gram_jacobian_algebra P n (fderiv ℝ (H i) a)).2.1
        ((ω : DifferentialForm (Euclid P) n) (H i a))
      rw [hJ0, zero_mul] at hb
      have h0 : ((ω : DifferentialForm (Euclid P) n) (H i a))
          (fun j => fderiv ℝ (H i) a (EuclideanSpace.single j (1 : ℝ))) = 0 :=
        abs_nonpos_iff.mp hb
      rw [hsα, h0, mul_zero, mul_zero]
    · have hw0 : w i a = 0 := by omega
      simp [hw0]
  have hfib : ∀ i, HasSum (fun l => (Rp i l).action (ω : DifferentialForm (Euclid P) n))
      (∫ a in B i, (w i a : ℝ) * ζ i a ((ω : DifferentialForm (Euclid P) n) (H i a)) ∂volume) := by
    intro i
    simp_rw [hRpact]
    have h1 := hasSum_integral_iUnion (hCm i) (hCdisj i)
      ((hint i).mono_set (by rw [hCunion i]; exact hBpB i))
    rw [hCunion i] at h1
    rw [hvanish i]
    exact h1
  have hprod : HasSum (fun p : ℕ × ℕ => (Rp p.1 p.2).action (ω : DifferentialForm (Euclid P) n))
      (R'.action (ω : DifferentialForm (Euclid P) n)) :=
    (e.hasSum_iff
      (f := fun p : ℕ × ℕ => (Rp p.1 p.2).action (ω : DifferentialForm (Euclid P) n))).mp (hR' ω)
  exact hprod.prod_fiberwise hfib

/-- **Simon Ch. 6, 3.3–3.9**: the push-forward of an integer multiplicity current by a `C¹` map is
integer multiplicity.  Let `R = (M, θ, ξ)` be an integer multiplicity triple in the open set `U`,
`K ⊆ U` compact with `Hⁿ(M \ K) = 0`, `f` of class `C¹` on an open `O ⊇ K` with `f(K) ⊆ U`, and
`Q(ω) = ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ(x)⟩ dHⁿ(x)`.  Then `Q = τ(N', θ', ξ')` in `U`.

Proof sketch:
* Replace `f` by a globally Lipschitz `C¹` map `g` with `g = f` and `Dg = Df` on `K`.
* Up to an `Hⁿ`-null set, `M ∩ K` is the disjoint union of the bi-Lipschitz Borel pieces
  `Gᵢ(Bᵢ)`, and `ξ(Gᵢ(u))` orients `DGᵢ(u)(ℝⁿ)` for a.e. `u ∈ Bᵢ`.  Hence
  `Jᵢ(u) ξ(Gᵢ(u)) = ±DGᵢ(u)e₁ ∧ ⋯ ∧ DGᵢ(u)eₙ`, where `Jᵢ = J_{Gᵢ}` is the area Jacobian.
* Put `Hᵢ = g ∘ Gᵢ`, `wᵢ = θ ∘ Gᵢ` and `ζᵢ(u)(α) = Jᵢ(u) ξ(Gᵢ(u))(α ∘ Dg(Gᵢ(u)))`.  The chain
  rule gives `ζᵢ(u) = ±DHᵢ(u)e₁ ∧ ⋯ ∧ DHᵢ(u)eₙ`.  Since `J_{Hᵢ} ≤ Lip(g)ⁿ Jᵢ`, the series
  `Σᵢ ∫_{Bᵢ} wᵢ ζᵢ(ω ∘ Hᵢ)` has mass at most `Lip(g)ⁿ ∫_{M ∩ K} θ dHⁿ < ∞`.  So it is represented
  by one integer multiplicity triple.
* By the area formula on each piece and countable additivity, its sum is `Q(ω)`.

The tangent-locality hypothesis and `0 < n` are not needed. -/
theorem Submission.dimred_mbl_pf_pushforward_isIntegerMultiplicity : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U K O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P) (Q : GeometricCurrentOn U n), IsOpen U → 0 < n → IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → IsOpen O → K ⊆ O → ContDiffOn ℝ 1 f O → f '' K ⊆ U → (∀ ω : TestFormOn U n, Q ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → IsIntegerMultiplicity Q := by
  intro _TL P n U K O R f Q hU _hn hK hKU hMK hO hKO hf hfK hQ
  classical
  -- Step 1(c): a globally Lipschitz `C¹` map `g` with `g = f`, `Dg = Df` on `K`
  obtain ⟨g, Lg, hgC1, hgL, hgK⟩ :=
    Submission.dimred_mbl_pfi_c1_lipschitz_cutoff P K O f hK hO hKO hf
  have hgdiff : Differentiable ℝ g := hgC1.differentiable one_ne_zero
  have hDgcont : Continuous (fderiv ℝ g) := hgC1.continuous_fderiv one_ne_zero
  have hDg_le : ∀ x, ‖fderiv ℝ g x‖ ≤ (Lg : ℝ) := fun x => norm_fderiv_le_of_lipschitz ℝ hgL
  -- Step 1(a): `M₁ = M ∩ K` is Borel, countably `n`-rectifiable, and `∫_{M₁} θ dHⁿ < ∞`
  have hMmeas : MeasurableSet R.carrier := R.measurableSet_carrier
  have hKmeas : MeasurableSet K := hK.isClosed.measurableSet
  have hM1meas : MeasurableSet (R.carrier ∩ K) := hMmeas.inter hKmeas
  have hM1rect : CountablyRectifiable n (R.carrier ∩ K) := R.rectifiable.mono inter_subset_left
  have hθfin : ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞ :=
    R.locallyIntegrable_mult K hK hKU
  -- Step 2: disjoint bi-Lipschitz Borel pieces `Gᵢ(Bᵢ) ⊆ M₁` covering `M₁` up to a null set
  obtain ⟨G, B, m, hGL, hBmeas, hm, hlow, hdiff, hGBmeas, hGBsub, hdisj, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces P n (R.carrier ∩ K) hM1meas hM1rect
  choose LG hLG using hGL
  have hinj : ∀ i, InjOn (G i) (B i) := by
    intro i a ha a' ha' h
    have h3 : m i * ‖a - a'‖ ≤ m i * 0 := by simpa [h] using hlow i a ha a' ha'
    have h4 : ‖a - a'‖ ≤ 0 := le_of_mul_le_mul_left h3 (hm i)
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h4)
  -- Steps 3–4: `ξ ∘ Gᵢ` is measurable and orients `DGᵢ(u)(ℝⁿ)` for a.e. `u ∈ Bᵢ`
  have hor := fun i => Submission.dimred_mbl_pfi_imrep_orient_along_piece P n U R (G i) (B i)
    (LG i) (m i) hU (hLG i) (hBmeas i) (hm i) (hlow i) (hdiff i)
    ((hGBsub i).trans inter_subset_left)
  -- Step 5: the parametrized data `Hᵢ = g ∘ Gᵢ`, `wᵢ = θ ∘ Gᵢ`, `ζᵢ = Jᵢ (Dg ∘ Gᵢ)_# (ξ ∘ Gᵢ)`
  set H : ℕ → Euclid n → Euclid P := fun i u => g (G i u) with hHdef
  set w : ℕ → Euclid n → ℕ := fun i u => R.mult (G i u) with hwdef
  set J : ℕ → Euclid n → ℝ := fun i u =>
    Real.sqrt (((fderiv ℝ (G i) u).adjoint ∘L fderiv ℝ (G i) u).det) with hJdef
  set ζ : ℕ → Euclid n → MultiVector P n := fun i u =>
    J i u • (R.orient (G i u)).comp
      (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ g (G i u))) with hζdef
  have hHd : ∀ i, ∀ u ∈ B i, DifferentiableAt ℝ (H i) u ∧
      fderiv ℝ (H i) u = (fderiv ℝ g (G i u)).comp (fderiv ℝ (G i) u) := by
    intro i u hu
    have h1 : DifferentiableAt ℝ g (G i u) := hgdiff _
    have h2 : DifferentiableAt ℝ (G i) u := (hdiff i u hu).1
    exact ⟨h1.comp u h2, fderiv_comp u h1 h2⟩
  have hJmeas : ∀ i, Measurable (J i) := by
    intro i
    have hc : Continuous (fun A : Euclid n →L[ℝ] Euclid P =>
        Real.sqrt ((A.adjoint ∘L A).det)) := by
      refine Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp ?_)
      exact isBoundedBilinearMap_comp.continuous.comp
        ((ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid n) (F := Euclid P)).continuous.prodMk
          continuous_id)
    exact hc.measurable.comp (measurable_fderiv ℝ (G i))
  have hcomp : Continuous (fun p : MultiVector P n × (Euclid P →L[ℝ] Euclid P) =>
      p.1.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM (𝕜 := ℝ) (ι := Fin n)
        (F := ℝ) p.2)) :=
    isBoundedBilinearMap_comp.continuous.comp
      (continuous_fst.prodMk
        (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp continuous_snd))
  have hζmeas : ∀ i, AEStronglyMeasurable (ζ i) (volume.restrict (B i)) := by
    intro i
    have h1 : AEStronglyMeasurable (fun u => R.orient (G i u)) (volume.restrict (B i)) :=
      (hor i).1
    have h2 : Continuous (fun u => fderiv ℝ g (G i u)) := hDgcont.comp (hLG i).continuous
    have hsm : StronglyMeasurable (fun u => J i u • (h1.mk _ u).comp
        (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ g (G i u)))) :=
      (hJmeas i).stronglyMeasurable.smul
        (hcomp.comp_stronglyMeasurable (h1.stronglyMeasurable_mk.prodMk h2.stronglyMeasurable))
    refine hsm.aestronglyMeasurable.congr ?_
    filter_upwards [h1.ae_eq_mk] with u hu
    simp only [hζdef, hu]
  -- `(★)` composed with `Dg`: `ζᵢ(u)(α) = ±α(DHᵢ(u)e₁, …, DHᵢ(u)eₙ)` for a.e. `u ∈ Bᵢ`
  have hsign : ∀ i, ∀ᵐ u ∂(volume.restrict (B i)), ∃ s : ℝ, (s = 1 ∨ s = -1) ∧
      ∀ α : Covector (Euclid P) n,
        ζ i u α = s * α (fun j => fderiv ℝ (H i) u (EuclideanSpace.single j (1 : ℝ))) := by
    intro i
    filter_upwards [(hor i).2, ae_restrict_mem (hBmeas i)] with u hu huB
    obtain ⟨s, hs, hsα⟩ := (Submission.dimred_mbl_pfi_gram_jacobian_algebra P n
      (fderiv ℝ (G i) u)).2.2 (hdiff i u huB).2 (R.orient (G i u)) hu
    refine ⟨s, hs, fun α => ?_⟩
    have key := hsα (α.compContinuousLinearMap (fderiv ℝ g (G i u)))
    rw [(hHd i u huB).2]
    simp only [hζdef, hJdef, smul_apply, ContinuousLinearMap.comp_apply,
      ContinuousAlternatingMap.compContinuousLinearMapCLM_apply, smul_eq_mul]
    rw [key]
    simp [ContinuousAlternatingMap.compContinuousLinearMap_apply, Function.comp_def]
  -- `J_{Hᵢ} ≤ ‖Dg‖ⁿ J_{Gᵢ} ≤ Lip(g)ⁿ J_{Gᵢ}` on `Bᵢ`
  have hJH : ∀ i, ∀ u ∈ B i,
      Real.sqrt (((fderiv ℝ (H i) u).adjoint ∘L fderiv ℝ (H i) u).det) ≤ (Lg : ℝ) ^ n * J i u := by
    intro i u hu
    rw [(hHd i u hu).2]
    refine ((Submission.dimred_mbl_pfi_gram_jacobian_algebra P n (fderiv ℝ (G i) u)).1
      (fderiv ℝ g (G i u))).trans ?_
    gcongr
    exact hDg_le _
  -- Step 6: total mass `Σᵢ ∫_{Bᵢ} wᵢ J_{Hᵢ} ≤ Lip(g)ⁿ Σᵢ ∫_{Gᵢ(Bᵢ)} θ ≤ Lip(g)ⁿ ∫_{M₁} θ < ∞`
  have hsum : ∑' i, ∫⁻ u in B i, (w i u : ℝ≥0∞) *
      ENNReal.ofReal (Real.sqrt (((fderiv ℝ (H i) u).adjoint ∘L fderiv ℝ (H i) u).det))
        ∂volume ≠ ∞ := by
    have hterm : ∀ i, ∫⁻ u in B i, (w i u : ℝ≥0∞) *
        ENNReal.ofReal (Real.sqrt (((fderiv ℝ (H i) u).adjoint ∘L fderiv ℝ (H i) u).det))
          ∂volume ≤ ENNReal.ofReal ((Lg : ℝ) ^ n) *
            ∫⁻ y in G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[n] := by
      intro i
      have harea := Poincare.SimonGMT.Chapter02.weighted_area_formula_volume_of_injective_derivative
        (hBmeas i) (fun x hx => (hdiff i x hx).1) (fun x hx => (hdiff i x hx).2) (hinj i)
        (fun y => (R.mult y : ℝ≥0∞))
      rw [finrank_euclideanSpace_fin] at harea
      rw [harea, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      refine setLIntegral_mono' (hBmeas i) (fun u hu => ?_)
      rw [Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_sqrt_det_adjoint_comp]
      calc (w i u : ℝ≥0∞) *
            ENNReal.ofReal (Real.sqrt (((fderiv ℝ (H i) u).adjoint ∘L fderiv ℝ (H i) u).det))
          ≤ (w i u : ℝ≥0∞) * ENNReal.ofReal ((Lg : ℝ) ^ n * J i u) := by
            gcongr
            exact hJH i u hu
        _ = ENNReal.ofReal ((Lg : ℝ) ^ n) * (ENNReal.ofReal (J i u) * (R.mult (G i u) : ℝ≥0∞)) := by
            rw [ENNReal.ofReal_mul (by positivity)]
            simp only [hwdef]
            ring
    have htot : ∑' i, ∫⁻ y in G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[n] ≤
        ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
      rw [← lintegral_iUnion hGBmeas hdisj]
      exact lintegral_mono_set (iUnion_subset hGBsub)
    refine ne_top_of_le_ne_top
      (ENNReal.mul_ne_top (ENNReal.ofReal_ne_top (r := (Lg : ℝ) ^ n)) hθfin) ?_
    calc _ ≤ ∑' i, ENNReal.ofReal ((Lg : ℝ) ^ n) *
            ∫⁻ y in G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[n] := ENNReal.tsum_le_tsum hterm
      _ = ENNReal.ofReal ((Lg : ℝ) ^ n) *
            ∑' i, ∫⁻ y in G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[n] := ENNReal.tsum_mul_left
      _ ≤ _ := by gcongr
  -- `Hᵢ(Bᵢ) ⊆ g(K) = f(K) ⊆ U`
  have himg : ∀ i, H i '' B i ⊆ U := by
    rintro i _ ⟨u, hu, rfl⟩
    have hx : G i u ∈ R.carrier ∩ K := hGBsub i ⟨u, hu, rfl⟩
    show g (G i u) ∈ U
    rw [(hgK _ hx.2).1]
    exact hfK ⟨G i u, hx.2, rfl⟩
  -- Steps 7–11: the parametrized series is represented by one integer multiplicity triple `R'`
  obtain ⟨R', hR'⟩ := Submission.dimred_mbl_pfi_param_series_imrep P n U H B w ζ hU
    (fun i => ⟨Lg * LG i, hgL.comp (hLG i)⟩) hBmeas (fun i u hu => (hHd i u hu).1) himg
    (fun i => R.measurable_mult.comp (hLG i).continuous.measurable) hζmeas hsign hsum
  refine ⟨R', fun ω => ?_⟩
  -- Step 6: `Q(ω)` is the sum of the series (area formula on each piece)
  have hωs : IsSmoothForm (ω : DifferentialForm (Euclid P) n) := ω.property.1.1
  have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous hωs
  obtain ⟨Bω, hBω⟩ := HasCompactSupport.exists_bound_of_continuous ω.property.1.2 hωc
  set Φ : Euclid P → ℝ := fun x => (R.mult x : ℝ) * R.orient x
    (((ω : DifferentialForm (Euclid P) n) (g x)).compContinuousLinearMap (fderiv ℝ g x))
    with hΦdef
  have hQ1 : Q ω = ∫ x in R.carrier ∩ K, Φ x ∂μHE[n] := by
    rw [hQ ω]
    have hae : (R.carrier : Set (Euclid P)) =ᵐ[μHE[n]] (R.carrier ∩ K : Set (Euclid P)) := by
      rw [ae_eq_set]
      constructor
      · rw [sdiff_self_inter]; exact hMK
      · rw [sdiff_eq_empty.mpr inter_subset_left]; exact measure_empty
    rw [setIntegral_congr_set hae]
    refine setIntegral_congr_fun hM1meas (fun x hx => ?_)
    simp only [hΦdef, (hgK x hx.2).1, (hgK x hx.2).2]
  have hQ2 : ∫ x in R.carrier ∩ K, Φ x ∂μHE[n] = ∫ x in ⋃ i, G i '' B i, Φ x ∂μHE[n] := by
    apply setIntegral_congr_set
    rw [ae_eq_set]
    constructor
    · exact hnull
    · rw [sdiff_eq_empty.mpr (iUnion_subset hGBsub)]; exact measure_empty
  -- integrability: `|Φ| ≤ sup|ω| · Lip(g)ⁿ · θ` a.e. on `M`, as `|ξ(x)(β)| ≤ ‖β‖`
  have hUsub : (⋃ i, G i '' B i) ⊆ R.carrier :=
    iUnion_subset fun i => (hGBsub i).trans inter_subset_left
  have hβc : Continuous (fun x => ((ω : DifferentialForm (Euclid P) n) (g x)).compContinuousLinearMap
      (fderiv ℝ g x)) := by
    have := (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM (𝕜 := ℝ)
      (ι := Fin n) (E := Euclid P) (F := Euclid P) (G := ℝ)).comp hDgcont
    exact this.clm_apply (hωc.comp hgdiff.continuous)
  have hξm := R.aestronglyMeasurable_orient
  have hΦsm : StronglyMeasurable (fun x => (R.mult x : ℝ) * (hξm.mk _ x)
      (((ω : DifferentialForm (Euclid P) n) (g x)).compContinuousLinearMap (fderiv ℝ g x))) := by
    have hc : Continuous (fun p : MultiVector P n × Covector (Euclid P) n => p.1 p.2) :=
      isBoundedBilinearMap_apply.continuous
    exact (measurable_from_nat.comp R.measurable_mult).stronglyMeasurable.mul
      (hc.comp_stronglyMeasurable (hξm.stronglyMeasurable_mk.prodMk hβc.stronglyMeasurable))
  have hΦae : Φ =ᵐ[μHE[n].restrict R.carrier] (fun x => (R.mult x : ℝ) * (hξm.mk _ x)
      (((ω : DifferentialForm (Euclid P) n) (g x)).compContinuousLinearMap (fderiv ℝ g x))) := by
    filter_upwards [hξm.ae_eq_mk] with x hx
    simp only [hΦdef, hx]
  have hΦbound : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      ‖Φ x‖ ≤ Bω * (Lg : ℝ) ^ n * (R.mult x : ℝ) := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Qx, -, τ, hτ, -, hsgn⟩ := hx
    set β := ((ω : DifferentialForm (Euclid P) n) (g x)).compContinuousLinearMap (fderiv ℝ g x)
    have hβτ : ‖β τ‖ ≤ ‖β‖ := by
      have h := β.le_opNorm τ
      simpa [hτ.norm_eq_one] using h
    have hξβ : ‖R.orient x β‖ ≤ ‖β‖ := by
      rcases hsgn with h | h
      · rw [h β]; exact hβτ
      · rw [h β, norm_neg]; exact hβτ
    have hβle : ‖β‖ ≤ Bω * (Lg : ℝ) ^ n := by
      refine (ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _).trans ?_
      rw [Fintype.card_fin]
      have h0 : 0 ≤ Bω := (norm_nonneg _).trans (hBω 0)
      exact mul_le_mul (hBω _) (pow_le_pow_left₀ (norm_nonneg _) (hDg_le x) n)
        (pow_nonneg (norm_nonneg _) n) h0
    simp only [hΦdef, norm_mul, Real.norm_natCast]
    calc (R.mult x : ℝ) * ‖R.orient x β‖ ≤ (R.mult x : ℝ) * (Bω * (Lg : ℝ) ^ n) :=
          mul_le_mul_of_nonneg_left (hξβ.trans hβle) (Nat.cast_nonneg _)
      _ = Bω * (Lg : ℝ) ^ n * (R.mult x : ℝ) := by ring
  have hθint : IntegrableOn (fun x => (R.mult x : ℝ)) (R.carrier ∩ K) μHE[n] := by
    refine ⟨(measurable_from_nat.comp R.measurable_mult).aestronglyMeasurable, ?_⟩
    rw [HasFiniteIntegral]
    have : ∀ x, ‖(R.mult x : ℝ)‖ₑ = (R.mult x : ℝ≥0∞) := fun x => by simp
    simp_rw [this]
    exact hθfin.lt_top
  have hint : IntegrableOn Φ (⋃ i, G i '' B i) μHE[n] := by
    have hθint' : IntegrableOn (fun x => Bω * (Lg : ℝ) ^ n * (R.mult x : ℝ))
        (⋃ i, G i '' B i) μHE[n] :=
      (hθint.mono_set (iUnion_subset hGBsub)).const_mul _
    refine hθint'.mono' ?_ ?_
    · exact (hΦsm.aestronglyMeasurable.congr hΦae.symm).mono_measure
        (Measure.restrict_mono hUsub le_rfl)
    · exact ae_restrict_of_ae_restrict_of_subset hUsub hΦbound
  -- countable additivity over the disjoint pieces, and the area formula on each piece
  have hpieces := hasSum_integral_iUnion hGBmeas hdisj hint
  have hterm : ∀ i, ∫ x in G i '' B i, Φ x ∂μHE[n] =
      ∫ u in B i, (w i u : ℝ) * ζ i u ((ω : DifferentialForm (Euclid P) n) (H i u)) ∂volume := by
    intro i
    have harea := Poincare.SimonGMT.Chapter02.integral_area_formula_of_injective_derivative
      (hBmeas i) (fun x hx => (hdiff i x hx).1) (fun x hx => (hdiff i x hx).2) (hinj i) Φ
    rw [finrank_euclideanSpace_fin, EuclideanSpace.euclideanHausdorffMeasure_eq_volume n] at harea
    rw [harea]
    refine setIntegral_congr_fun (hBmeas i) (fun u _ => ?_)
    simp only [Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_sqrt_det_adjoint_comp, hΦdef, hζdef,
      hJdef, hHdef, hwdef, smul_eq_mul, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.comp_apply, ContinuousAlternatingMap.compContinuousLinearMapCLM_apply]
    ring
  simp_rw [hterm] at hpieces
  rw [hQ1, hQ2]
  exact hpieces.unique (hR' ω)
/-- **Simon 6.2.15** (weak compactness, `U = ℝᴾ`): if `sup_j M_{B_R}(T_j) < ∞` for every `R`, a
subsequence of `T_j` converges weakly to a current.  By 6.2.5, `|T_j(ω)| ≤ r · sup_j M_{B_R}(T_j)`
when `spt ω ⊆ B_R` and `|ω| ≤ r`.  Forms supported in `B_R` have a countable uniformly dense
subset (finite nets of `B̄_R`, uniform continuity, a countable dense set in `Λⁿ ≅ ℝᵈ`); Tychonoff
on a countable product gives a subsequence converging on it, hence on every test form.  The limit
is linear and obeys the same bound, so it is sequentially continuous. -/
theorem Submission.dimred_mbl_tc_weak_compactness : ∀ (P n : ℕ) (T : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ R : ℝ, ⨆ j, (T j).massOn (ball (0 : Euclid P) R) < ∞) → ∃ (φ : ℕ → ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), StrictMono φ ∧ WeaklyConvergesOn (fun i => T (φ i)) C := by
  have hE1 := Submission.cmr_abs_apply_le_massOn
  have hNE := Submission.cmr_covector_euclidean_equiv
  intro P n T hT
  obtain ⟨d, c, hc⟩ := hNE P n
  -- c_R := (sup_j M_{B_R}(T_j)).toReal
  let cR : ℝ → ℝ := fun R => (⨆ j, (T j).massOn (ball (0 : Euclid P) R)).toReal
  -- (a) uniform evaluation bound (E1)
  have hev : ∀ (R : ℝ) (ω : TestFormOn (univ : Set (Euclid P)) n) (r : ℝ),
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball 0 R →
      (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ r) →
      ∀ j, |T j ω| ≤ r * cR R := by
    intro R ω r hsupp hr j
    have hle : (T j).massOn (ball 0 R) ≤ ⨆ j, (T j).massOn (ball (0 : Euclid P) R) :=
      le_iSup (fun j => (T j).massOn (ball (0 : Euclid P) R)) j
    have hne : (T j).massOn (ball 0 R) ≠ ∞ := ne_top_of_le_ne_top (hT R).ne hle
    have h1 := hE1 P n univ (ball 0 R) (T j) ω r hne hsupp hr
    have hr0 : 0 ≤ r := (covectorEuclideanNorm_nonneg _).trans (hr 0)
    exact h1.trans (mul_le_mul_of_nonneg_left (ENNReal.toReal_mono (hT R).ne hle) hr0)
  -- every test form has tsupport in a ball and bounded coefficient norm
  have hsupp : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, ∃ R : ℕ,
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball 0 R := by
    intro ω
    obtain ⟨r, hr⟩ := ω.property.1.2.isCompact.isBounded.subset_ball (0 : Euclid P)
    obtain ⟨R, hR⟩ := exists_nat_gt r
    exact ⟨R, hr.trans (ball_subset_ball hR.le)⟩
  have hbdd : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, ∃ r : ℝ,
      ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ r := by
    intro ω
    have hcont : Continuous (fun x => c ((ω : DifferentialForm (Euclid P) n) x)) :=
      c.continuous.comp ω.property.1.1.continuous
    have hcs : HasCompactSupport (fun x => c ((ω : DifferentialForm (Euclid P) n) x)) :=
      ω.property.1.2.comp_left (map_zero c)
    obtain ⟨r, hr⟩ := hcont.bounded_above_of_compact_support hcs
    exact ⟨r, fun x => by rw [hc]; exact hr x⟩
  -- (b) a countable set `D R`, uniformly dense in the test forms supported in `ball 0 R`
  have hsep : ∀ R : ℕ, ∃ D : Set (TestFormOn (univ : Set (Euclid P)) n), D.Countable ∧
      (∀ ω ∈ D, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball 0 R) ∧
      ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
        tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball 0 R →
        ∀ ε > 0, ∃ ω' ∈ D, ∀ x, covectorEuclideanNorm
          ((ω : DifferentialForm (Euclid P) n) x - (ω' : DifferentialForm (Euclid P) n) x) < ε := by
    intro R
    -- a countable dense set `Q` of coefficient vectors
    obtain ⟨Q, hQc, hQd⟩ := TopologicalSpace.exists_countable_dense (EuclideanSpace ℝ (Fin d))
    have : Countable Q := hQc.to_subtype
    -- finite `1/(m+1)`-nets `F m` of `closedBall 0 R`
    have hnet : ∀ m : ℕ, ∃ F : Set (Euclid P), F.Finite ∧
        closedBall (0 : Euclid P) R ⊆ ⋃ y ∈ F, ball y (1 / ((m : ℝ) + 1)) := by
      intro m
      obtain ⟨F, -, hF, hcov⟩ := (isCompact_closedBall (0 : Euclid P) R).finite_cover_balls
        (by positivity : (0 : ℝ) < 1 / ((m : ℝ) + 1))
      exact ⟨F, hF, hcov⟩
    choose F hFfin hFcov using hnet
    have : ∀ m, Finite (F m) := fun m => (hFfin m).to_subtype
    -- for every `ε > 0`, a countable `ε`-net of the forms supported in `ball 0 R`
    have hE : ∀ ε : ℝ, 0 < ε → ∃ E : Set (TestFormOn (univ : Set (Euclid P)) n), E.Countable ∧
        (∀ ω ∈ E, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball 0 R) ∧
        ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
          tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball 0 R →
          ∃ ω' ∈ E, ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x -
            (ω' : DifferentialForm (Euclid P) n) x) < ε := by
      intro ε hε
      have hε4 : 0 < ε / 4 := by positivity
      -- `q ω y ∈ Q` is `ε/4`-close to the coefficient vector of `ω` at `y`
      have hq : ∀ (ω : TestFormOn (univ : Set (Euclid P)) n) (y : Euclid P), ∃ v ∈ Q,
          dist (c ((ω : DifferentialForm (Euclid P) n) y)) v < ε / 4 :=
        fun ω y => hQd.exists_dist_lt _ hε4
      choose q hqQ hq using hq
      -- `S m`: the forms supported in `ball 0 R` whose coefficient vectors vary by `< ε/4` at
      -- distance `< 1/(m+1)`; the code of `ω` at scale `m` is `y ↦ q ω y` on the net `F m`
      let S : ℕ → Set (TestFormOn (univ : Set (Euclid P)) n) := fun m =>
        {ω | tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball 0 R ∧ ∀ x y : Euclid P,
          dist x y < 1 / ((m : ℝ) + 1) → dist (c ((ω : DifferentialForm (Euclid P) n) x))
            (c ((ω : DifferentialForm (Euclid P) n) y)) < ε / 4}
      let code : (m : ℕ) → TestFormOn (univ : Set (Euclid P)) n → (F m → Q) :=
        fun m ω y => ⟨q ω y, hqQ ω y⟩
      -- one representative in `S m` of every code that occurs (countably many codes)
      have hrep : ∀ (m : ℕ) (γ : F m → Q), ∃ ω' : TestFormOn (univ : Set (Euclid P)) n,
          (∃ ω ∈ S m, code m ω = γ) → ω' ∈ S m ∧ code m ω' = γ := by
        intro m γ
        by_cases h : ∃ ω ∈ S m, code m ω = γ
        · obtain ⟨ω, hω, hωγ⟩ := h
          exact ⟨ω, fun _ => ⟨hω, hωγ⟩⟩
        · exact ⟨0, fun h' => absurd h' h⟩
      choose rep hrep using hrep
      refine ⟨⋃ m, range (rep m) ∩ S m,
        countable_iUnion fun m => (countable_range (rep m)).mono inter_subset_left, ?_, ?_⟩
      · intro ω hω
        obtain ⟨m, -, hωS⟩ := mem_iUnion.1 hω
        exact hωS.1
      · intro ω hω
        -- the coefficient vector of `ω` is uniformly continuous
        have hcont : Continuous (fun x => c ((ω : DifferentialForm (Euclid P) n) x)) :=
          c.continuous.comp ω.property.1.1.continuous
        have hcs : HasCompactSupport (fun x => c ((ω : DifferentialForm (Euclid P) n) x)) :=
          ω.property.1.2.comp_left (map_zero c)
        obtain ⟨δ, hδ, hδε⟩ := Metric.uniformContinuous_iff.1
          (hcs.uniformContinuous_of_continuous hcont) (ε / 4) hε4
        obtain ⟨m, hm⟩ := exists_nat_one_div_lt hδ
        have hωS : ω ∈ S m := ⟨hω, fun x y hxy => hδε (hxy.trans hm)⟩
        obtain ⟨ω', hω'R, hω'S, hcode⟩ :
            ∃ ω', ω' ∈ range (rep m) ∧ ω' ∈ S m ∧ code m ω' = code m ω :=
          ⟨rep m (code m ω), mem_range_self _, hrep m (code m ω) ⟨ω, hωS, rfl⟩⟩
        refine ⟨ω', mem_iUnion.2 ⟨m, hω'R, hω'S⟩, fun x => ?_⟩
        by_cases hx : x ∈ closedBall (0 : Euclid P) R
        · -- `x` is `1/(m+1)`-close to a point `y` of the net, where both codes agree
          obtain ⟨y, hyF, hxy⟩ := mem_iUnion₂.1 (hFcov m hx)
          have hxy' : dist x y < 1 / ((m : ℝ) + 1) := mem_ball.1 hxy
          have hqy : q ω' y = q ω y := congrArg Subtype.val (congrFun hcode ⟨y, hyF⟩)
          have h1 := hωS.2 x y hxy'
          have h2 := hq ω y
          have h3 := hq ω' y
          have h4 := hω'S.2 x y hxy'
          rw [hqy, dist_comm] at h3
          rw [dist_comm] at h4
          have t1 := dist_triangle (c ((ω : DifferentialForm (Euclid P) n) x))
            (c ((ω : DifferentialForm (Euclid P) n) y)) (c ((ω' : DifferentialForm (Euclid P) n) x))
          have t2 := dist_triangle (c ((ω : DifferentialForm (Euclid P) n) y)) (q ω y)
            (c ((ω' : DifferentialForm (Euclid P) n) x))
          have t3 := dist_triangle (q ω y) (c ((ω' : DifferentialForm (Euclid P) n) y))
            (c ((ω' : DifferentialForm (Euclid P) n) x))
          rw [hc, map_sub, ← dist_eq_norm]
          linarith
        · have h1 : (ω : DifferentialForm (Euclid P) n) x = 0 :=
            image_eq_zero_of_notMem_tsupport (fun h => hx (ball_subset_closedBall (hω h)))
          have h2 : (ω' : DifferentialForm (Euclid P) n) x = 0 :=
            image_eq_zero_of_notMem_tsupport (fun h => hx (ball_subset_closedBall (hω'S.1 h)))
          rw [h1, h2, sub_zero, covectorEuclideanNorm_zero]; exact hε
    choose E hEc hEsupp hEnet using hE
    refine ⟨⋃ k : ℕ, E (1 / ((k : ℝ) + 1)) (by positivity),
      countable_iUnion fun k => hEc _ _, ?_, ?_⟩
    · intro ω hω
      obtain ⟨k, hk⟩ := mem_iUnion.1 hω
      exact hEsupp _ _ ω hk
    · intro ω hω ε hε
      obtain ⟨k, hk⟩ := exists_nat_one_div_lt hε
      obtain ⟨ω', hω'E, hω'⟩ := hEnet (1 / ((k : ℝ) + 1)) (by positivity) ω hω
      exact ⟨ω', mem_iUnion.2 ⟨k, hω'E⟩, fun x => (hω' x).trans hk⟩
  choose D hDc hDsupp hDdense using hsep
  -- (c) diagonal subsequence on the countable set ⋃ D_R
  let Dall : Set (TestFormOn (univ : Set (Euclid P)) n) := ⋃ R : ℕ, D R
  have hDall : Dall.Countable := countable_iUnion hDc
  have : Countable Dall := hDall.to_subtype
  have hbound : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, ∃ B : ℝ, ∀ j, |T j ω| ≤ B := by
    intro ω
    obtain ⟨R, hR⟩ := hsupp ω
    obtain ⟨r, hr⟩ := hbdd ω
    exact ⟨r * cR R, hev R ω r hR hr⟩
  choose B hB using hbound
  let X : ℕ → (Dall → ℝ) := fun j ω => T j ω
  have hXmem : ∀ j, X j ∈ Set.pi univ (fun ω : Dall => Icc (-B ω) (B ω)) := by
    intro j ω _
    exact abs_le.1 (hB ω j)
  obtain ⟨a, -, φ, hφ, hlimD⟩ :=
    (isCompact_univ_pi (fun ω : Dall => isCompact_Icc)).tendsto_subseq hXmem
  have hconvD : ∀ ω ∈ Dall, ∃ l, Tendsto (fun i => T (φ i) ω) atTop (𝓝 l) := by
    intro ω hω
    exact ⟨a ⟨ω, hω⟩, tendsto_pi_nhds.1 hlimD ⟨ω, hω⟩⟩
  -- (d) Cauchy property on every test form
  have hconv : ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
      ∃ l, Tendsto (fun i => T (φ i) ω) atTop (𝓝 l) := by
    intro ω
    apply cauchySeq_tendsto_of_complete
    rw [Metric.cauchySeq_iff]
    intro ε hε
    obtain ⟨R, hR⟩ := hsupp ω
    have hM0 : 0 ≤ cR R := ENNReal.toReal_nonneg
    set δ : ℝ := ε / (4 * (cR R + 1)) with hδ
    have hδpos : 0 < δ := by positivity
    have hδM : δ * cR R ≤ ε / 4 := by
      have : δ * (cR R + 1) = ε / 4 := by rw [hδ]; field_simp
      nlinarith
    obtain ⟨ω', hω'D, hω'⟩ := hDdense R ω hR δ hδpos
    obtain ⟨l, hl⟩ := hconvD ω' (mem_iUnion.2 ⟨R, hω'D⟩)
    obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.1 hl.cauchySeq (ε / 2) (by positivity)
    refine ⟨N, fun i hi i' hi' => ?_⟩
    have hdiff : ∀ j, |T j ω - T j ω'| ≤ δ * cR R := by
      intro j
      rw [← map_sub]
      apply hev R (ω - ω') δ
      · exact (tsupport_sub _ _).trans (union_subset hR (hDsupp R ω' hω'D))
      · intro x; exact (hω' x).le
    have h1 := abs_le.1 (hdiff (φ i))
    have h2 := abs_le.1 (hdiff (φ i'))
    have h3 := hN i hi i' hi'
    rw [Real.dist_eq] at h3 ⊢
    have h3' := abs_lt.1 h3
    rw [abs_lt]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2, h3'.1, h3'.2]
  -- (e) the limit current
  choose l hl using hconv
  have hadd : ∀ ω η, l (ω + η) = l ω + l η := fun ω η =>
    tendsto_nhds_unique (hl (ω + η)) (by simpa [map_add] using (hl ω).add (hl η))
  have hsmul : ∀ (r : ℝ) ω, l (r • ω) = r * l ω := fun r ω =>
    tendsto_nhds_unique (hl (r • ω)) (by simpa [map_smul] using (hl ω).const_mul r)
  let L : TestFormOn (univ : Set (Euclid P)) n →ₗ[ℝ] ℝ :=
    { toFun := l
      map_add' := hadd
      map_smul' := fun r ω => by simp [hsmul] }
  have hLbound : ∀ (R : ℝ) (ω : TestFormOn (univ : Set (Euclid P)) n) (r : ℝ),
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball 0 R →
      (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ r) →
      |l ω| ≤ r * cR R := fun R ω r hs hr =>
    le_of_tendsto' (hl ω).abs (fun i => hev R ω r hs hr (φ i))
  have hcont : ∀ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) n, TestFormOnConverges ωs 0 →
      Tendsto (fun j => L (ωs j)) atTop (𝓝 0) := by
    intro ωs hωs
    obtain ⟨K, hK, -, hKsupp, -, hunif⟩ := hωs
    obtain ⟨r, hr⟩ := hK.isBounded.subset_ball (0 : Euclid P)
    have h0 := Metric.tendstoUniformlyOn_iff.1 (hunif 0)
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨cn, hcn0, hcnle⟩ : ∃ cn : ℝ, 0 ≤ cn ∧ ∀ α : Covector (Euclid P) n, ‖c α‖ ≤ cn * ‖α‖ :=
      ⟨‖(c : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin d))‖,
        (c : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin d)).opNorm_nonneg,
        fun α => (c : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin d)).le_opNorm α⟩
    have hM0 : 0 ≤ cR r := ENNReal.toReal_nonneg
    set η : ℝ := ε / (2 * ((cn + 1) * (cR r + 1))) with hη
    have hηpos : 0 < η := by positivity
    obtain ⟨N, hN⟩ := eventually_atTop.1 (h0 η hηpos)
    refine ⟨N, fun j hj => ?_⟩
    have hpt : ∀ x, covectorEuclideanNorm ((ωs j : DifferentialForm (Euclid P) n) x) ≤ cn * η := by
      intro x
      by_cases hx : x ∈ K
      · have h1 := hN j hj x hx
        have e0 : iteratedFDeriv ℝ 0
            ((0 : TestFormOn (univ : Set (Euclid P)) n) : DifferentialForm (Euclid P) n) x = 0 := by
          rw [← norm_eq_zero, norm_iteratedFDeriv_zero]; simp
        rw [e0, dist_zero_left, norm_iteratedFDeriv_zero] at h1
        rw [hc]
        calc ‖c ((ωs j : DifferentialForm (Euclid P) n) x)‖
            ≤ cn * ‖(ωs j : DifferentialForm (Euclid P) n) x‖ := hcnle _
          _ ≤ cn * η := mul_le_mul_of_nonneg_left h1.le hcn0
      · rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hKsupp j h)),
          covectorEuclideanNorm_zero]
        positivity
    have hb := hLbound r (ωs j) (cn * η) ((hKsupp j).trans hr) hpt
    rw [Real.dist_eq, sub_zero]
    show |l (ωs j)| < ε
    have hkey : cn * η * cR r ≤ ε / 2 := by
      have h1 : cn * cR r ≤ (cn + 1) * (cR r + 1) := by nlinarith
      have h2 : η * ((cn + 1) * (cR r + 1)) = ε / 2 := by rw [hη]; field_simp
      nlinarith
    linarith
  exact ⟨φ, ⟨L, hcont⟩, hφ, fun ω => hl ω⟩
/-- **Agreement on expanding balls** (truncated compactness for moving blow-ups; Simon 6.2.13):
if `Ŝⱼ ⇀ C` in `ℝᴾ`, `ρⱼ → ∞`, and `Ŝⱼ` agrees with `Sⱼ ∈ 𝒟_{m+1}(Uⱼ)` (via `currentEval`) and
has vanishing boundary on forms supported in `B_{ρⱼ}(0)`, then `∂C = 0` and `Sⱼ ⇀ C` in `ℝᴾ`.
Every test form has compact, hence bounded, support, which lies in `B_{ρⱼ}(0)` for all large `j`;
so `Sⱼ(ω)` eventually equals `Ŝⱼ(ω) → C(ω)`, and `∂Ŝⱼ(β)` tends both to `∂C(β)` and to `0`. -/
theorem Submission.dimred_mbl_tc_limit_of_agreement : ∀ (P m : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) (m + 1)) (Ŝ : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (C : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (ρ : ℕ → ℝ), Tendsto ρ atTop atTop → WeaklyConvergesOn Ŝ C → (∀ (j : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 (ρ j) → Ŝ j ω = currentEval (Ss j) (ω : DifferentialForm (Euclid P) (m + 1))) → (∀ (j : ℕ) (β : TestFormOn (univ : Set (Euclid P)) m), tsupport (β : DifferentialForm (Euclid P) m) ⊆ ball 0 (ρ j) → (Ŝ j).boundary β = 0) → C.boundary = 0 ∧ ConvergesWeakly Ss C := by
  intro P m Us Ss Ŝ C ρ hρ hconv hagree hbd
  -- every test form on `ℝᴾ` has tsupport in some ball, eventually inside `ball 0 (ρ j)`
  have hev : ∀ {k : ℕ} (ω : TestFormOn (univ : Set (Euclid P)) k), ∀ᶠ j in atTop,
      tsupport (ω : DifferentialForm (Euclid P) k) ⊆ ball 0 (ρ j) := by
    intro k ω
    obtain ⟨r, hr⟩ := ω.property.1.2.isCompact.isBounded.subset_ball (0 : Euclid P)
    filter_upwards [hρ.eventually_ge_atTop r] with j hj
    exact hr.trans (ball_subset_ball hj)
  constructor
  · -- `∂Ŝⱼ(β) → ∂C(β)` and `∂Ŝⱼ(β) = 0` eventually, so `∂C(β) = 0`
    apply GeometricCurrentOn.ext
    intro β
    have h1 : Tendsto (fun j => (Ŝ j).boundary β) atTop (𝓝 (C.boundary β)) :=
      hconv.boundary β
    have h2 : Tendsto (fun j => (Ŝ j).boundary β) atTop (𝓝 0) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [hev β] with j hj
      exact (hbd j β hj).symm
    rw [tendsto_nhds_unique h1 h2]
    rfl
  · -- `currentEval (Ss j) ω` eventually equals `Ŝ j ω → C ω`
    intro ω
    refine (hconv ω).congr' ?_
    filter_upwards [hev ω] with j hj
    exact hagree j ω hj
/-- **Integer slice property of integer multiplicity currents** (Simon Ch. 6, 4.5(2)–(3); step
V4(i) of the closure theorem, Ch. 6, 7.2).  Let `X ∈ 𝒟_{d+1}(ℝᴾ)` and `∂X` be integer
multiplicity, `(μ, ξ)`, `(μ', ξ')` admissible representations of `X`, `∂X`, and `f` Lipschitz.
(SL) gives slices `A_t(ω) = ∫_{f<t} ⟨ω, ξ⟩ dμ`, `B_t(η) = ∫_{f<t} ⟨η, ξ'⟩ dμ'` with
`M_W(∂A_t − B_t) ≤ L·liminf_{h↓0} h⁻¹ μ(W ∩ {t − h < f < t})`, so by (MM)
(`cbr_ccisp_ae_massOn_lt_top`) `Z_t = ∂A_t − B_t` has finite mass on bounded sets for a.e. `t`.
For such `t`, `A_t` and `B_t` are integer multiplicity
(`cbr_ccisp_restrict_isIntegerMultiplicity`), `M_W(∂A_t) ≤ M_W(Z_t) + M_W(B_t)` with
`M_W(B_t) ≤ μ'(W̄) < ∞` for `W ⊂⊂ ℝᴾ`, so `∂A_t` is integer multiplicity by (BR), and so is `Z_t`
by (IMC)(c).  Currents agreeing with `A_t`, `B_t` on all test forms are equal to them. -/
theorem Submission.dmcbr_cc_slice_property_of_im : ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (G : Set (Euclid P)) (a b : ℝ) (L : NNReal) (Z : ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ j, μs j (G ∩ {x | a < f x ∧ f x < b}) < ∞) → (∀ (j : ℕ) (t : ℝ), t ∈ Ioo a b → Z j t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs j (G ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∃ g : ℝ → ℝ≥0∞, Measurable g ∧ (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => Z j t) atTop ≤ g t) ∧ ∫⁻ t in Ioo a b, g t ≤ (L : ℝ≥0∞) * liminf (fun j => μs j (G ∩ {x | a < f x ∧ f x < b})) atTop) → (∀ (P k : ℕ) (U : Set (Euclid P)) (μ₁ μ₂ μ₃ : Measure (Euclid P)) (ξ₁ ξ₂ ξ₃ : Euclid P → MultiVector P k), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₁ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₂ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₃ K < ∞) → AEStronglyMeasurable ξ₁ μ₁ → AEStronglyMeasurable ξ₂ μ₂ → AEStronglyMeasurable ξ₃ μ₃ → (∀ᵐ x ∂μ₁, ∀ α : Covector (Euclid P) k, |ξ₁ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₂, ∀ α : Covector (Euclid P) k, |ξ₂ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₃, ∀ α : Covector (Euclid P) k, |ξ₃ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, ∫ x, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂ + ∫ x, ξ₃ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₃) → ∀ (B : Set (Euclid P)) (ω : TestFormOn U k), MeasurableSet B → ∫ x in B, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x in B, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂ + ∫ x in B, ξ₃ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₃) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) → ∀ (P : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), IsIntegerMultiplicity X → IsIntegerMultiplicity X.boundary → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, X.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) := by
  intro hIMC hSL hMM hRU d hBR P X hX hXb μ μ' ξ ξ' hμ hμ' hξm hξ'm hξb hξ'b hXrep hXbrep f L hf
  obtain ⟨-, hIMCb, hIMCc, hIMCd⟩ := hIMC
  -- Step 1: the slices `A_t(ω) = ∫_{f<t} ⟨ω, ξ⟩ dμ`, `B_t(η) = ∫_{f<t} ⟨η, ξ'⟩ dμ'` from (SL) in
  -- `U = ℝᴾ`, with the liminf bound for `M_W(∂A_t − B_t)`
  obtain ⟨At, Bt, hAt, hBt, -, hmass, -⟩ := hSL P d univ X μ μ' ξ ξ' f L isOpen_univ
    (fun K hK _ => hμ K hK) (fun K hK _ => hμ' K hK) hξm hξ'm hξb hξ'b hXrep hXbrep hf
  -- Step 2: for a.e. `t`, `Z_t = ∂A_t − B_t` has finite mass on bounded sets
  have hfin := Submission.cbr_ccisp_ae_massOn_lt_top hMM P d univ
    (fun t => (At t).boundary - Bt t) μ f L hf.continuous hμ hmass
  filter_upwards [hfin] with t ht A B hA hB
  -- Step 8: `A = A_t` and `B = B_t`, as they agree on all test forms
  rw [GeometricCurrentOn.ext fun ω => (hA ω).trans (hAt t ω).symm,
    GeometricCurrentOn.ext fun η => (hB η).trans (hBt t η).symm]
  have hE : MeasurableSet {x | f x < t} :=
    measurableSet_lt hf.continuous.measurable measurable_const
  -- Steps 3–5: `A_t = X⌞{f < t}` and `B_t = (∂X)⌞{f < t}` are integer multiplicity
  have hAIM : IsIntegerMultiplicity (At t) :=
    Submission.cbr_ccisp_restrict_isIntegerMultiplicity hIMCb hIMCd hRU P (d + 1) univ X (At t)
