            by rw [sdiff_eq_empty.mpr (iUnion_subset hGAM), measure_empty]⟩)
      _ = ∑' j, ∫ x in G j '' A j, (R.mult x : ℝ) * R.orient x
          (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap
            (fderiv ℝ φ x)) ∂μHE[n] :=
          integral_iUnion hGA hdisj (hint.mono_set (iUnion_subset hGAM))
      _ = ∑' j, ∫ y in N j, (g j y : ℝ) * η j y ((ω : DifferentialForm (Euclid P) n) y)
          ∂μHE[n] :=
          tsum_congr fun j => hNint j _ hωc.stronglyMeasurable
/-- **Cut-off of a `C¹` map to a compactly supported perturbation of the identity** (the cutoff
step of the `C¹` push-forward, Simon 6.2.24).  Let `O` be open, `K ⊆ O` compact and `f` `C¹` on
`O`.  Take `δ > 0` with `cthickening δ K ⊆ O` and a smooth cutoff `χ` with
`support χ = thickening δ K` and `χ = 1` exactly on `cthickening (δ/2) K`.  Then
`φ = χ f + (1 − χ) id` is `C¹` on `ℝᴾ`, equals `f` on the open neighbourhood
`V = thickening (δ/2) K` of `K` (so `Dφ = Df` on `V`), and equals `id` off the compact set
`K' = spt χ ⊆ cthickening δ K ⊆ O`. -/
theorem Submission.dimred_mbl_pfb_c1_compact_perturbation : ∀ (P : ℕ) (O K : Set (Euclid P)) (f : Euclid P → Euclid P), IsOpen O → IsCompact K → K ⊆ O → ContDiffOn ℝ 1 f O → ∃ (φ : Euclid P → Euclid P) (V K' : Set (Euclid P)), IsOpen V ∧ K ⊆ V ∧ IsCompact K' ∧ K' ⊆ O ∧ ContDiff ℝ 1 φ ∧ (∀ x ∈ V, φ x = f x ∧ fderiv ℝ φ x = fderiv ℝ f x) ∧ ∀ x, x ∉ K' → φ x = x := by
  intro P O K f hO hK hKO hf
  -- Step 1: a margin `δ > 0` with `cthickening δ K ⊆ O`
  obtain ⟨δ, hδ, hδO⟩ := hK.exists_cthickening_subset_open hO hKO
  -- Step 2: smooth Urysohn cutoff `χ` with `support χ = thickening δ K` and
  -- `χ x = 1 ↔ x ∈ cthickening (δ/2) K`
  obtain ⟨χ, hχ, -, hχs, hχt⟩ := exists_contDiff_support_eq_eq_one_iff (n := (⊤ : ℕ∞))
    (isOpen_thickening : IsOpen (thickening δ K))
    (isClosed_cthickening : IsClosed (cthickening (δ / 2) K))
    (cthickening_subset_thickening' hδ (half_lt_self hδ) K)
  have hχ1 : ContDiff ℝ 1 χ := hχ.of_le (by exact_mod_cast le_top)
  -- Step 3: `K' = spt χ ⊆ cthickening δ K ⊆ O` is compact
  have hK'δ : tsupport χ ⊆ cthickening δ K := by
    rw [tsupport, hχs]
    exact closure_thickening_subset_cthickening δ K
  have hK'O : tsupport χ ⊆ O := hK'δ.trans hδO
  have hK' : IsCompact (tsupport χ) :=
    hK.cthickening.of_isClosed_subset (isClosed_tsupport χ) hK'δ
  -- Step 4: `φ = χ f + (1 − χ) id`, `V = thickening (δ/2) K`
  refine ⟨fun x => χ x • f x + (1 - χ x) • x, thickening (δ / 2) K, tsupport χ,
    isOpen_thickening, self_subset_thickening (half_pos hδ) K, hK', hK'O, ?_, ?_, ?_⟩
  · -- Step 7: `φ` is `C¹` at every point
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : x ∈ O
    · -- (a) on `O`, `φ` is a `C¹` combination of `χ`, `f` and `id`
      have hfx : ContDiffAt ℝ 1 f x := hf.contDiffAt (hO.mem_nhds hx)
      exact (hχ1.contDiffAt.smul hfx).add
        ((contDiffAt_const.sub hχ1.contDiffAt).smul contDiffAt_id)
    · -- (b) off `O ⊇ K'`, `φ = id` near `x`
      have hxK' : x ∉ tsupport χ := fun h => hx (hK'O h)
      have hev : (fun y => χ y • f y + (1 - χ y) • y) =ᶠ[𝓝 x] id := by
        filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hxK'] with y hy
        simp [hy]
      exact contDiffAt_id.congr_of_eventuallyEq hev
  · -- Step 6: `χ = 1` on the open set `V`, so `φ = f` near each `x ∈ V`
    intro x hx
    have hev : (fun y => χ y • f y + (1 - χ y) • y) =ᶠ[𝓝 x] f := by
      filter_upwards [isOpen_thickening.mem_nhds hx] with y hy
      have hy1 : χ y = 1 := (hχt y).1 (thickening_subset_cthickening _ _ hy)
      simp [hy1]
    exact ⟨hev.eq_of_nhds, hev.fderiv_eq⟩
  · -- Step 5: `χ = 0` off `K'`, so `φ = id` there
    intro x hx
    simp [image_eq_zero_of_notMem_tsupport hx]
/-- Simon 6.2.24(1), `∂f_#T = f_#∂T`, for a `C¹` map `f` on an open `O ⊇ K` (step 5(d) of the
projected comparison): if `X = τ(M, θ, ξ)` has `∂X = 0` in `U`, `Hⁿ(M ∖ K) = 0` for a compact
`K ⊆ U`, and `Q(ω) = ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ⟩ dHⁿ`, then `∂Q = 0` in `U`.  Replace `f` by a
`C¹` map `φ` equal to `f` on an open `V ⊇ K` and to the identity off a compact `K' ⊆ O ∩ U`.
Since `φ = f` and `Dφ = Df` on `K`, which carries `Hⁿ`-almost all of `M`,
`Q(ω) = ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ⟩ dHⁿ`, and the push-forward formula for `φ` gives `∂Q = 0`. -/
theorem Submission.dor_lmb_pc_pushforward_boundaryVanishes : ∀ (P n : ℕ) (U K O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P) (X Q : GeometricCurrentOn U n), IsOpen U → IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → IsOpen O → K ⊆ O → ContDiffOn ℝ 1 f O → R.Represents X → BoundaryVanishes X → (∀ ω : TestFormOn U n, Q ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → BoundaryVanishes Q := by
  intro P n U K O R f X Q hU hK hKU hMK hO hKO hf hRX hX hQ
  -- Step 1: a `C¹` map `φ` with `φ = f`, `Dφ = Df` on an open `V ⊇ K` and `φ = id` off a
  -- compact `K' ⊆ O ∩ U`
  obtain ⟨φ, V, K', -, hKV, hK', hK'OU, hφ, hφf, hφK'⟩ :=
    Submission.dimred_mbl_pfb_c1_compact_perturbation P (O ∩ U) K f (hO.inter hU) hK
      (subset_inter hKO hKU) (hf.mono inter_subset_left)
  -- Step 2: `Hⁿ`-almost every point of `M` lies in `K`
  have hae : ∀ᵐ x ∂μHE[n], x ∈ R.carrier → x ∈ K := by
    rw [ae_iff]
    refine measure_mono_null (fun x hx => ?_) hMK
    exact not_imp.1 hx
  -- Step 3: `Q(ω) = ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ⟩ dHⁿ`, so `∂Q = 0` by the push-forward formula
  refine Submission.dpf_pushforward_formula_boundaryVanishes P n U K' X Q R φ hU hRX hK'
    (hK'OU.trans inter_subset_right) hφ hφK' (fun ω => ?_) hX
  rw [hQ ω]
  refine setIntegral_congr_ae R.measurableSet_carrier (hae.mono fun x hx hxM => ?_)
  obtain ⟨h1, h2⟩ := hφf x (hKV (hx hxM))
  simp only [h1, h2]
/-- **Additivity of the pairing with a bounded field** (the identity
`∫ ⟨φ, ν_Y⟩ dHⁿ = ∫ ⟨φ, ν_Z + ν_X⟩ dHⁿ` in the competitor mass bound of Simon 7.2.4 (8)–(9)).
Write `ν_R = 1_M θ ξ` for `R = (M, θ, ξ)`.  If `ν_R = ν_{R₁} + ν_{R₂}` `Hⁿ`-a.e. and `F` is
`Hⁿ`-a.e. strongly measurable, vanishes off the compact `K ⊆ U` and `‖F‖ ≤ B`, then
`∫_M θ ⟨F, ξ⟩ dHⁿ = ∫_{M₁} θ₁ ⟨F, ξ₁⟩ dHⁿ + ∫_{M₂} θ₂ ⟨F, ξ₂⟩ dHⁿ`.  Each side is the integral
over `ℝᴾ` of `⟨F, ν⟩ = 1_M θ ⟨F, ξ⟩`, integrable by `dpf_pfc_imrep_pairing_integrable_abs_le`. -/
theorem Submission.dor_lmb_pc_cm_pairing_add_of_bounded : ∀ (P n : ℕ) (U K : Set (Euclid P)) (R₁ R₂ R : IMRep U n) (F : Euclid P → Covector (Euclid P) n) (B : ℝ), IsCompact K → K ⊆ U → AEStronglyMeasurable F μHE[n] → (∀ x, x ∉ K → F x = 0) → (∀ x, ‖F x‖ ≤ B) → (∀ᵐ x ∂μHE[n], R.carrier.indicator (fun y => (R.mult y : ℝ) • R.orient y) x = R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x + R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x) → ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (F x) ∂μHE[n] = ∫ x in R₁.carrier, (R₁.mult x : ℝ) * R₁.orient x (F x) ∂μHE[n] + ∫ x in R₂.carrier, (R₂.mult x : ℝ) * R₂.orient x (F x) ∂μHE[n] := by
  intro P n U K R₁ R₂ R F B hK hKU hF hF0 hFB hvd
  -- Steps 1–3: for each `R'`, `⟨F, ν_{R'}⟩` is `Hⁿ`-integrable with integral `∫_{M'} θ' ⟨F, ξ'⟩`
  have key : ∀ R' : IMRep U n,
      Integrable (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (F x))
        μHE[n] ∧
      ∫ x, R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (F x) ∂μHE[n] =
        ∫ x in R'.carrier, (R'.mult x : ℝ) * R'.orient x (F x) ∂μHE[n] := by
    intro R'
    -- Step 2: `⟨F, ν_{R'}⟩ = 1_{M'} θ' ⟨F, ξ'⟩`
    have hfun : (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (F x)) =
        R'.carrier.indicator (fun y => (R'.mult y : ℝ) * R'.orient y (F y)) := by
      funext x
      by_cases hx : x ∈ R'.carrier
      · simp [indicator_of_mem hx]
      · simp [indicator_of_notMem hx]
    -- Steps 1 and 3: integrability on `M'` from the pairing bound, then `integral_indicator`
    rw [hfun, integrable_indicator_iff R'.measurableSet_carrier,
      integral_indicator R'.measurableSet_carrier]
    exact ⟨(Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n U K R' F B hK hKU hF.restrict
      hF0 hFB).1, rfl⟩
  obtain ⟨-, he⟩ := key R
  obtain ⟨hi₁, he₁⟩ := key R₁
  obtain ⟨hi₂, he₂⟩ := key R₂
  -- Steps 4–5: evaluate `ν_R = ν_{R₁} + ν_{R₂}` at `F` a.e. and integrate additively
  rw [← he, ← he₁, ← he₂, ← integral_add hi₁ hi₂]
  refine integral_congr_ae ?_
  filter_upwards [hvd] with x hx
  rw [hx, add_apply]
/-- **Pull-back field** (the integrand `⟨ω(f(x)), df_x# T⃗⟩` of Simon Ch. 6, 2.24(2)–(3), and the
estimate behind 2.29): if `f` is `C¹` on the open set `O ⊇ G`, `G` is open, `‖Df‖ ≤ Λ` on `G`, and
the continuous form `ω` has `‖ω‖ ≤ W`, then `φ = 1_G · ω(f) ∘ Df` is a.e. strongly measurable for
every measure and `‖φ‖ ≤ W Λⁿ`.  `Df` and `ω ∘ f` are continuous on `O` and `L ↦ (α ↦ α ∘ L)` is
continuous, so `ω(f) ∘ Df` is continuous on the open set `G`; on `G`, `‖α ∘ L‖ ≤ ‖α‖ ‖L‖ⁿ`, and
`φ = 0` off `G`. -/
theorem Submission.dor_lmb_pc_cm_pullback_field_bounded : ∀ (P n : ℕ) (G O : Set (Euclid P)) (f : Euclid P → Euclid P) (ω : DifferentialForm (Euclid P) n) (Λ W : ℝ), IsOpen G → IsOpen O → G ⊆ O → ContDiffOn ℝ 1 f O → Continuous ω → 0 ≤ Λ → (∀ x ∈ G, ‖fderiv ℝ f x‖ ≤ Λ) → (∀ z, ‖ω z‖ ≤ W) → (∀ μ : Measure (Euclid P), AEStronglyMeasurable (G.indicator fun y => (ω (f y)).compContinuousLinearMap (fderiv ℝ f y)) μ) ∧ ∀ x, ‖G.indicator (fun y => (ω (f y)).compContinuousLinearMap (fderiv ℝ f y)) x‖ ≤ W * Λ ^ n := by
  intro P n G O f ω Λ W hG hO hGO hf hω hΛ hDf hW
  -- Steps 1–3: `Df` and `ω ∘ f` are continuous on `O`, hence so is `ω(f) ∘ Df`
  have hcont : ContinuousOn
      (fun y => (ω (f y)).compContinuousLinearMap (fderiv ℝ f y)) G := by
    have h1 : ContinuousOn (fun y => fderiv ℝ f y) O := hf.continuousOn_fderiv_of_isOpen hO le_rfl
    have h2 : ContinuousOn (fun y => ω (f y)) O := hω.comp_continuousOn hf.continuousOn
    have h3 : ContinuousOn (fun y => ContinuousAlternatingMap.compContinuousLinearMapCLM
        (fderiv ℝ f y) (ω (f y))) O :=
      (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp_continuousOn h1).clm_apply h2
    exact h3.mono hGO
  -- Step 5: `W ≥ 0`
  have hW0 : 0 ≤ W := (norm_nonneg _).trans (hW 0)
  refine ⟨fun μ => ?_, fun x => ?_⟩
  -- Step 4: continuity on the open (Borel) set `G` gives measurability of `1_G · ω(f) ∘ Df`
  · rw [aestronglyMeasurable_indicator_iff hG.measurableSet]
    exact hcont.aestronglyMeasurable hG.measurableSet
  -- Steps 6–7: `‖α ∘ L‖ ≤ ‖α‖ ‖L‖ⁿ` on `G`; the field vanishes off `G`
  · by_cases hx : x ∈ G
    · rw [Set.indicator_of_mem hx]
      calc ‖(ω (f x)).compContinuousLinearMap (fderiv ℝ f x)‖
          ≤ ‖ω (f x)‖ * ‖fderiv ℝ f x‖ ^ Fintype.card (Fin n) :=
            ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _
        _ = ‖ω (f x)‖ * ‖fderiv ℝ f x‖ ^ n := by rw [Fintype.card_fin]
        _ ≤ W * Λ ^ n := mul_le_mul (hW _) (pow_le_pow_left₀ (norm_nonneg _) (hDf x hx) n)
            (pow_nonneg (norm_nonneg _) _) hW0
    · rw [Set.indicator_of_notMem hx, norm_zero]
      exact mul_nonneg hW0 (pow_nonneg hΛ n)
/-- The integral form of the mass bound **Simon Ch. 6, 2.29**, `M_W(f_#T) ≤ (sup |Df|)ⁿ M(T)`: if
`|g| ≤ c 1_G` holds `Hⁿ⌞M`-a.e. with `G` measurable, then `ofReal(∫_M θ g dHⁿ) ≤ ofReal(c) μ_R(G)`,
where `μ_R = (Hⁿ⌞M).withDensity θ`.  Indeed `ofReal(∫ θg) ≤ ‖∫ θg‖ₑ ≤ ∫⁻ ‖θg‖ₑ`, and a.e.
`‖θg‖ₑ ≤ 1_G ofReal(c) θ` (on `G` since `|g| ≤ c`, off `G` since `g = 0`), whose lower integral
over `Hⁿ⌞M` is `ofReal(c) μ_R(G)`. -/
theorem Submission.dor_lmb_pc_cm_ofReal_integral_le_measure : ∀ (P n : ℕ) (U G : Set (Euclid P)) (R : IMRep U n) (g : Euclid P → ℝ) (c : ℝ), MeasurableSet G → (∀ᵐ x ∂(μHE[n].restrict R.carrier), |g x| ≤ G.indicator (fun _ => c) x) → ENNReal.ofReal (∫ x in R.carrier, (R.mult x : ℝ) * g x ∂μHE[n]) ≤ ENNReal.ofReal c * R.measure G := by
  intro P n U G R g c hG hg
  -- the weight `θ` is measurable into `[0, ∞]`, being measurable into `ℕ`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  calc ENNReal.ofReal (∫ x in R.carrier, (R.mult x : ℝ) * g x ∂μHE[n])
      ≤ ‖∫ x in R.carrier, (R.mult x : ℝ) * g x ∂μHE[n]‖ₑ := by
        rw [Real.enorm_eq_ofReal_abs]; exact ENNReal.ofReal_le_ofReal (le_abs_self _)
    _ ≤ ∫⁻ x in R.carrier, ‖(R.mult x : ℝ) * g x‖ₑ ∂μHE[n] := enorm_integral_le_lintegral_enorm _
    -- `‖θg‖ₑ ≤ 1_G ofReal(c) θ` holds `Hⁿ⌞M`-a.e.
    _ ≤ ∫⁻ x in R.carrier, G.indicator (fun x => ENNReal.ofReal c * (R.mult x : ℝ≥0∞)) x
          ∂μHE[n] := by
        refine lintegral_mono_ae ?_
        filter_upwards [hg] with x hx
        by_cases hxG : x ∈ G
        · rw [Set.indicator_of_mem hxG] at hx ⊢
          rw [Real.enorm_eq_ofReal_abs, abs_mul, Nat.abs_cast]
          calc ENNReal.ofReal ((R.mult x : ℝ) * |g x|) ≤ ENNReal.ofReal ((R.mult x : ℝ) * c) :=
                ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hx (Nat.cast_nonneg _))
            _ = ENNReal.ofReal c * (R.mult x : ℝ≥0∞) := by
                rw [ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast, mul_comm]
        · rw [Set.indicator_of_notMem hxG] at hx ⊢
          have : g x = 0 := abs_nonpos_iff.mp hx
          simp [this]
    -- `∫⁻_G ofReal(c) θ d(Hⁿ⌞M) = ofReal(c) (Hⁿ⌞M).withDensity θ (G)`
    _ = ENNReal.ofReal c * R.measure G := by
        rw [lintegral_indicator hG, lintegral_const_mul _ hθ, IMRep.measure,
          withDensity_apply _ hG]
/-- **Simon 6.1.8–1.10, 6.3.4–3.5** for a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` of `Q` and a
linear map `L`: `ξ(α ∘ L) = ±α(Lτ₁, …, Lτₙ)`, hence (a) `|ξ(α ∘ L)| ≤ |α|_E ‖L‖ⁿ`, the value
being `0` if `Lτ` is linearly dependent and otherwise bounded by Cauchy–Binet and Hadamard,
`|α(Lτ)| ≤ |α|_E det(⟨Lτᵢ, Lτⱼ⟩)^{1/2} ≤ |α|_E ∏ᵢ |Lτᵢ|`; and (b) `ξ(α ∘ L) = ξ(α)` when `L`
fixes `Q` pointwise. -/
theorem Submission.dor_lmb_pc_unitOrientation_comp : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ (α.compContinuousLinearMap L)| ≤ covectorEuclideanNorm α * ‖L‖ ^ n) ∧ ((∀ v ∈ Q, L v = v) → ∀ α : Covector (Euclid P) n, ξ (α.compContinuousLinearMap L) = ξ α) := by
  intro P n ξ Q L hξ
  obtain ⟨τ, hτ, hspan, hsign⟩ := hξ
  -- `ξ(β) = ±β(τ)`, so `|ξ(β)| = |β(τ)|`
  have habs : ∀ β : Covector (Euclid P) n, |ξ β| = |β τ| := by
    intro β
    rcases hsign with h | h
    · rw [h β]
    · rw [h β, abs_neg]
  refine ⟨fun α => ?_, fun hL α => ?_⟩
  · -- (a): `ξ(α ∘ L) = ±α(v)` with `v = Lτ`
    rw [habs, ContinuousAlternatingMap.compContinuousLinearMap_apply]
    set v : Fin n → Euclid P := L ∘ τ
    have hα := covectorEuclideanNorm_nonneg α
    -- `|vᵢ| = |Lτᵢ| ≤ ‖L‖`
    have hprod : ∏ i, ‖v i‖ ≤ ‖L‖ ^ n := by
      calc ∏ i, ‖v i‖ ≤ ∏ _i : Fin n, ‖L‖ :=
            Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) fun i _ => by
              calc ‖v i‖ = ‖L (τ i)‖ := rfl
                _ ≤ ‖L‖ * ‖τ i‖ := L.le_opNorm _
                _ = ‖L‖ := by rw [hτ.1 i, mul_one]
        _ = ‖L‖ ^ n := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    by_cases hli : LinearIndependent ℝ v
    · -- Cauchy–Binet and Hadamard: `|α(v)| ≤ |α|_E det(⟨vᵢ, vⱼ⟩)^{1/2} ≤ |α|_E ∏ |vᵢ|`
      obtain ⟨σ, -, -, hG, -, hA⟩ := Submission.dpf_exists_orthonormal_frame_det_gram P n v hli
      have h1 := (Submission.covectorEuclideanNorm_gram_bounds P n).1 α v
      rw [hG, Real.sqrt_sq_eq_abs] at h1
      calc |α v| ≤ covectorEuclideanNorm α *
            |Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j))| := h1
        _ ≤ covectorEuclideanNorm α * ∏ i, ‖v i‖ := mul_le_mul_of_nonneg_left hA hα
        _ ≤ covectorEuclideanNorm α * ‖L‖ ^ n := mul_le_mul_of_nonneg_left hprod hα
    · -- a linearly dependent `v` gives `α(v) = 0`
      rw [show α v = 0 from α.toAlternatingMap.map_linearDependent v hli, abs_zero]
      exact mul_nonneg hα (pow_nonneg (norm_nonneg L) n)
  · -- (b): `L` fixes each `τᵢ ∈ span τ = Q`, so `α(Lτ) = α(τ)`
    have hLτ : L ∘ τ = τ := funext fun i => hL (τ i) (hspan ▸ Submodule.subset_span ⟨i, rfl⟩)
    rcases hsign with h | h
    · rw [h, h, ContinuousAlternatingMap.compContinuousLinearMap_apply, hLτ]
    · rw [h, h, ContinuousAlternatingMap.compContinuousLinearMap_apply, hLτ]

/-- **A map fixing `N` to first order fixes the orientation of a triple carried by `N`** (steps
3–4 of the projected comparison; Simon Ch. 3, §1 and Ch. 2, §4).  Let `R = (M, θ, ξ)` satisfy
`Hⁿ(M \ N) = 0` for an embedded `C¹` submanifold `N`, and let `f(x) = x` and `Df(x)v = v` for
`x ∈ N ∩ O` and `v ∈ TₓN`.  For `Hⁿ`-a.e. `x ∈ M`, `x ∈ N` and `ξ(x)` orients an approximate
tangent plane `Q` of `M` at `x` (`R.orients`), and `Q ⊆ TₓN`
(`approxTangent_le_submanifold_tangentSpace`).  If also `x ∈ O`, then `f(x) = x` and `Df(x)`
fixes `Q`, so `ξ(x)(α ∘ Df(x)) = ξ(x)(α)` (`dor_lmb_pc_unitOrientation_comp`, part (b)). -/
theorem Submission.dor_lmb_pc_imrep_orient_fixed_by_retraction : ∀ (P n d : ℕ) (U N O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P), IsEmbeddedSubmanifold 1 d N → MeasurableSet O → μHE[n] (R.carrier \ N) = 0 → (∀ x ∈ N ∩ O, f x = x) → (∀ x ∈ N ∩ O, ∀ v ∈ tangentSpace N x, fderiv ℝ f x v = v) → ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ O)), f x = x ∧ ∀ α : Covector (Euclid P) n, R.orient x (α.compContinuousLinearMap (fderiv ℝ f x)) = R.orient x α := by
  intro P n d U N O R f hN hO hnull hfix hDfix
  -- `Hⁿ⌞M`-a.e. point lies in `N`: `Hⁿ⌞M(ℝᴾ \ N) = Hⁿ(M \ N) = 0`
  have hMN : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ N := by
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    refine measure_mono_null ?_ hnull
    exact fun x hx => ⟨hx.2, hx.1⟩
  -- with `R.orients`, pass from `Hⁿ⌞M` to `Hⁿ⌞(M ∩ O)`
  have hMO : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ O)), x ∈ N ∧ ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n R.carrier x Q ∧ IsUnitOrientationOf (R.orient x) Q :=
    ae_restrict_of_ae_restrict_of_subset inter_subset_left (hMN.and R.orients)
  filter_upwards [hMO, ae_restrict_mem (R.measurableSet_carrier.inter hO)]
    with x ⟨hxN, Q, hQ, hξ⟩ hx
  have hxNO : x ∈ N ∩ O := ⟨hxN, hx.2⟩
  -- the approximate tangent plane `Q` lies in `TₓN`, on which `Df(x)` is the identity
  have hQN := Submission.approxTangent_le_submanifold_tangentSpace P n d N R.carrier x Q hN hxN
    hnull hQ
  exact ⟨hfix x hxNO, (Submission.dor_lmb_pc_unitOrientation_comp P n (R.orient x) Q
    (fderiv ℝ f x) hξ).2 fun v hv => hDfix x hxNO v (hQN hv)⟩
/-- **Competitor mass bound** (Simon 7.2.4 (8)–(9), for the competitor `S = Z + f_#X`).  Let
`Y = τ(RY) = τ(RZ) + τ(RX)`, `f ∈ C¹(O)` with `‖Df‖ ≤ Λ` on `G ⊂⊂ U`, `f = id` and
`ξ_Z(α ∘ Df) = ξ_Z(α)` a.e. on `M_Z ∩ G`, and `M_X ⊆ G` a.e.  For an admissible `ω`
(`spt ω ⊆ G`, `|ω|_E ≤ 1`), `φ := 1_G · ω(f) ∘ Df` is bounded, measurable and vanishes off the
compact `Ḡ ⊆ U`; it represents both parts of `S(ω)`, so the vector density identity
`1_{M_Y} θ_Y ξ_Y = 1_{M_Z} θ_Z ξ_Z + 1_{M_X} θ_X ξ_X` gives `S(ω) = ∫_{M_Y} θ_Y ξ_Y(φ) dHⁿ`.
As `|ξ_Y(α ∘ Df)| ≤ |α|_E ‖Df‖ⁿ ≤ Λⁿ` on `G`, `S(ω) ≤ Λⁿ μ_{RY}(G)`; take the supremum over `ω`. -/
theorem Submission.dor_lmb_pc_competitor_massOn_le : ∀ (P n : ℕ) (U G O : Set (Euclid P)) (RZ RX RY : IMRep U n) (Y S : GeometricCurrentOn U n) (f : Euclid P → Euclid P) (Λ : ℝ), IsOpen U → IsOpen G → CompactlyContained G U → IsOpen O → G ⊆ O → ContDiffOn ℝ 1 f O → 0 ≤ Λ → (∀ x ∈ G, ‖fderiv ℝ f x‖ ≤ Λ) → RY.Represents Y → (∀ ω : TestFormOn U n, Y ω = RZ.action (ω : DifferentialForm (Euclid P) n) + RX.action (ω : DifferentialForm (Euclid P) n)) → (∀ᵐ x ∂(μHE[n].restrict (RZ.carrier ∩ G)), f x = x ∧ ∀ α : Covector (Euclid P) n, RZ.orient x (α.compContinuousLinearMap (fderiv ℝ f x)) = RZ.orient x α) → μHE[n] (RX.carrier \ G) = 0 → (∀ ω : TestFormOn U n, S ω = RZ.action (ω : DifferentialForm (Euclid P) n) + ∫ x in RX.carrier, (RX.mult x : ℝ) * RX.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → S.massOn G ≤ ENNReal.ofReal (Λ ^ n) * RY.measure G := by
  intro P n U G O RZ RX RY Y S f Λ hU hG hGU hO hGO hf hΛ hDf hY hYZX hZfix hXG hS
  obtain ⟨hKc, hKU⟩ := hGU
  -- Step 1: the vector densities satisfy `ν_Y = ν_Z + ν_X` `Hⁿ`-a.e.
  have hvd := Submission.dor_lmb_pc_cm_vector_density_add P n U RZ RX RY Y hU hY hYZX
  -- `M_G(S)` is the supremum of `S(ω)` over the admissible `ω`
  refine sSup_le ?_
  rintro _ ⟨ω, ⟨hωG, hω1⟩, rfl⟩
  show ENNReal.ofReal (S ω) ≤ ENNReal.ofReal (Λ ^ n) * RY.measure G
  -- `ω` is continuous and bounded by `W`
  obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous hsmooth
  obtain ⟨W, hW⟩ := hωc.bounded_above_of_compact_support hcpt
  -- Step 2: `φ = 1_G · ω(f) ∘ Df` is measurable, bounded by `W Λⁿ` and vanishes off `Ḡ`
  set φ : Euclid P → Covector (Euclid P) n := G.indicator fun y =>
    ((ω : DifferentialForm (Euclid P) n) (f y)).compContinuousLinearMap (fderiv ℝ f y) with hφ
  obtain ⟨hφm, hφB⟩ := Submission.dor_lmb_pc_cm_pullback_field_bounded P n G O f
    (ω : DifferentialForm (Euclid P) n) Λ W hG hO hGO hf hωc hΛ hDf hW
  have hφ0 : ∀ x, x ∉ closure G → φ x = 0 := fun x hx =>
    Set.indicator_of_notMem (fun h => hx (subset_closure h)) _
  -- Step 4: `τ(RZ)(ω) = ∫_{M_Z} θ_Z ξ_Z(φ) dHⁿ`, as `f` fixes `M_Z ∩ G` and `ω = φ = 0` off `G`
  have hZ : RZ.action (ω : DifferentialForm (Euclid P) n) =
      ∫ x in RZ.carrier, (RZ.mult x : ℝ) * RZ.orient x (φ x) ∂μHE[n] := by
    refine setIntegral_congr_ae RZ.measurableSet_carrier ?_
    filter_upwards [(ae_restrict_iff' (RZ.measurableSet_carrier.inter hG.measurableSet)).1 hZfix]
      with x hx hxZ
    by_cases hxG : x ∈ G
    · obtain ⟨hfx, hor⟩ := hx ⟨hxZ, hxG⟩
      rw [hφ, Set.indicator_of_mem hxG, hfx, hor]
    · rw [hφ, Set.indicator_of_notMem hxG,
        image_eq_zero_of_notMem_tsupport fun h => hxG (hωG h)]
  -- Step 5: the `X` part equals `∫_{M_X} θ_X ξ_X(φ) dHⁿ`, as `M_X ⊆ G` a.e.
  have hX : ∫ x in RX.carrier, (RX.mult x : ℝ) * RX.orient x
        (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x))
        ∂μHE[n] =
      ∫ x in RX.carrier, (RX.mult x : ℝ) * RX.orient x (φ x) ∂μHE[n] := by
    refine setIntegral_congr_ae RX.measurableSet_carrier ?_
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hXG] with x hx hxX
    have hxG : x ∈ G := by_contra fun h => hx ⟨hxX, h⟩
    rw [hφ, Set.indicator_of_mem hxG]
  -- Steps 3 and 6: `S(ω) = ∫_{M_Y} θ_Y ξ_Y(φ) dHⁿ`, integrating `ν_Y = ν_Z + ν_X` against `φ`
  have hSY : S ω = ∫ x in RY.carrier, (RY.mult x : ℝ) * RY.orient x (φ x) ∂μHE[n] := by
    rw [hS ω, hZ, hX]
    exact (Submission.dor_lmb_pc_cm_pairing_add_of_bounded P n U (closure G) RZ RX RY φ
      (W * Λ ^ n) hKc hKU (hφm μHE[n]) hφ0 hφB hvd).symm
  -- Step 7: `|ξ_Y(φ)| ≤ |ω(f)|_E ‖Df‖ⁿ ≤ Λⁿ` on `G` and `ξ_Y(φ) = 0` off `G`, `Hⁿ⌞M_Y`-a.e.
  have hbound : ∀ᵐ x ∂(μHE[n].restrict RY.carrier),
      |RY.orient x (φ x)| ≤ G.indicator (fun _ => Λ ^ n) x := by
    filter_upwards [RY.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    by_cases hxG : x ∈ G
    · rw [hφ, Set.indicator_of_mem hxG, Set.indicator_of_mem hxG]
      calc |RY.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
            (fderiv ℝ f x))|
          ≤ covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) (f x)) *
              ‖fderiv ℝ f x‖ ^ n :=
            (Submission.dor_lmb_pc_unitOrientation_comp P n (RY.orient x) Q (fderiv ℝ f x) hQ).1 _
        _ ≤ 1 * Λ ^ n := mul_le_mul (hω1 (f x)) (pow_le_pow_left₀ (norm_nonneg _) (hDf x hxG) n)
            (pow_nonneg (norm_nonneg _) n) zero_le_one
        _ = Λ ^ n := one_mul _
    · rw [hφ, Set.indicator_of_notMem hxG, Set.indicator_of_notMem hxG, map_zero, abs_zero]
  -- Step 8: `ofReal(S(ω)) ≤ ofReal(Λⁿ) μ_{RY}(G)`
  rw [hSY]
  exact Submission.dor_lmb_pc_cm_ofReal_integral_le_measure P n U G RY
    (fun x => RY.orient x (φ x)) (Λ ^ n) hG.measurableSet hbound

/-- **Simon Ch. 6, 3.6–3.9 and 2.29 for `n = 0`**: the Lipschitz push-forward of a finite-mass
`0`-dimensional integer multiplicity current.  `H⁰ = μHE[0]` is counting measure, so
`H⁰(M) ≤ μ_R(ℝᴺ) < ∞` makes the carrier `M` finite and `H⁰⌞M`-a.e. statements hold on all of `M`;
there each `ξ(x)` is `ε(x) ev` with `ε(x) = ±1`.  `Y(F)(ω) = ∑_{x ∈ M} θ(x) ε(x) ω(F(x))(∅)` is a
current, `R.action(F_j^# ω)` is the same finite sum with `F_j` in place of `F` (so it converges to
`Y(F)(ω)`), and `Y(F)` depends only on `F` on `M`.  Regrouping by the fibres of `F`,
`Y(F) = τ(M', |c|, sign(c) ev)` with `c(y) = ∑_{F(x) = y} θ(x) ε(x)` and `M' = {c ≠ 0}` finite
(a finite set has approximate tangent space `{0}` at each of its points). -/
theorem Submission.dor_lmb_fcd_imp_degree_zero : ∀ (N N' : ℕ) (R : IMRep (univ : Set (Euclid N)) 0), R.measure univ ≠ ∞ → ∃ Y : (Euclid N → Euclid N') → GeometricCurrentOn (univ : Set (Euclid N')) 0, (∀ (F : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → IsIntegerMultiplicity (Y F) ∧ ∀ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ 1 (Fs j)) → (∀ j, LipschitzWith Λ (Fs j)) → TendstoUniformly Fs F atTop → ∀ ω : TestFormOn (univ : Set (Euclid N')) 0, Tendsto (fun j => R.action (fun x => ((ω : DifferentialForm (Euclid N') 0) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x))) atTop (𝓝 (Y F ω))) ∧ ∀ (F F' : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → LipschitzWith Λ F' → (∀ᵐ x ∂(μHE[0].restrict R.carrier), F x = F' x) → Y F = Y F' := by
  intro N N' R hR
  classical
  -- `μHE[0]` is the counting measure
  have hsing : ∀ {P : ℕ} (x : Euclid P), (μHE[0] : Measure (Euclid P)) {x} = 1 := by
    intro P x
    rw [Measure.euclideanHausdorffMeasure_zero]
    exact Measure.hausdorffMeasure_zero_singleton x
  -- the carrier is finite, since `H⁰(M) ≤ R.measure univ < ∞`
  have hfin : R.carrier.Finite := by
    by_contra hinf
    have hle : (μHE[0] : Measure (Euclid N)) R.carrier ≤ R.measure univ := by
      rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
        ← setLIntegral_one]
      exact setLIntegral_mono' R.measurableSet_carrier fun x hx => by
        exact_mod_cast R.mult_pos x hx
    obtain ⟨n, hn⟩ := ENNReal.exists_nat_gt (ne_top_of_le_ne_top hR hle)
    obtain ⟨t, hts, rfl⟩ := Set.Infinite.exists_subset_card_eq hinf n
    have : ((t.card : ℕ) : ℝ≥0∞) ≤ (μHE[0] : Measure (Euclid N)) R.carrier := by
      calc ((t.card : ℕ) : ℝ≥0∞) = ∑ x ∈ t, (μHE[0] : Measure (Euclid N)) {x} := by
            simp
        _ = (μHE[0] : Measure (Euclid N)) t := sum_measure_singleton
        _ ≤ _ := measure_mono hts
    exact absurd hn (not_lt.mpr this)
  set S := hfin.toFinset
  have hS : (S : Set (Euclid N)) = R.carrier := hfin.coe_toFinset
  -- `H⁰⌞M`-a.e. statements hold at every point of `M`
  have hpt : ∀ {p : Euclid N → Prop},
      (∀ᵐ x ∂((μHE[0] : Measure (Euclid N)).restrict R.carrier), p x) → ∀ x ∈ R.carrier, p x := by
    intro p hp x hx
    by_contra hpx
    have h0 := ae_iff.mp hp
    have hsub : ({x} : Set (Euclid N)) ⊆ {y | ¬ p y} ∩ R.carrier := by
      rintro y rfl
      exact ⟨hpx, hx⟩
    have h1 : (μHE[0] : Measure (Euclid N)) {x} ≤
        ((μHE[0] : Measure (Euclid N)).restrict R.carrier) {y | ¬ p y} :=
      (measure_mono hsub).trans (Measure.le_restrict_apply _ _)
    rw [hsing, h0] at h1
    exact absurd h1 (by norm_num)
  -- the unit `0`-covector and the empty tuple; a `0`-covector is `α(∅)` times the unit
  let K₁ : ∀ {P : ℕ}, Covector (Euclid P) 0 := fun {P} =>
    ContinuousAlternatingMap.constOfIsEmpty ℝ (Euclid P) (Fin 0) (1 : ℝ)
  let v₀ : ∀ {P : ℕ}, Fin 0 → Euclid P := fun {P} => fun i => i.elim0
  have hcov : ∀ {P : ℕ} (α : Covector (Euclid P) 0), α = α v₀ • K₁ := by
    intro P α
    ext v
    simp [K₁, Subsingleton.elim v v₀]
  have horient : ∀ x (α : Covector (Euclid N) 0), R.orient x α = α v₀ * R.orient x K₁ := by
    intro x α
    conv_lhs => rw [hcov α]
    rw [map_smul, smul_eq_mul]
  -- signs: on `M`, `ξ(x) = ε(x) · ev` with `ε(x) = ±1`
  have hsign : ∀ x ∈ R.carrier, R.orient x K₁ = 1 ∨ R.orient x K₁ = -1 := by
    intro x hx
    obtain ⟨Q, -, τ, -, -, hτ⟩ := hpt R.orients x hx
    rcases hτ with hτ | hτ
    · left; rw [hτ]; simp [K₁]
    · right; rw [hτ]; simp [K₁]
  let σ : Euclid N → ℤ := fun x => if R.orient x K₁ = 1 then 1 else -1
  have hσ : ∀ x ∈ R.carrier, R.orient x K₁ = (σ x : ℝ) := by
    intro x hx
    rcases hsign x hx with h | h
    · simp [σ, h]
    · simp [σ, h]
  let wZ : Euclid N → ℤ := fun x => (R.mult x : ℤ) * σ x
  -- `R.action β = ∑_{x ∈ M} θ(x) ε(x) β(x)(∅)`
  have haction : ∀ β : DifferentialForm (Euclid N) 0,
      R.action β = ∑ x ∈ S, (wZ x : ℝ) * β x v₀ := by
    intro β
    have hint : IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x (β x)) (S : Set (Euclid N))
        (μHE[0] : Measure (Euclid N)) := by
      rw [← (S : Set (Euclid N)).biUnion_of_singleton, integrableOn_finite_biUnion S.finite_toSet]
      intro x _
      exact integrableOn_singleton (hx := by rw [hsing]; exact ENNReal.one_lt_top)
    rw [IMRep.action, ← hS, setIntegral_finset S hint]
    refine Finset.sum_congr rfl fun x hx => ?_
    have hxM : x ∈ R.carrier := hS ▸ hx
    rw [measureReal_def, hsing, ENNReal.toReal_one, one_smul, horient, hσ x hxM]
    simp only [wZ]
    push_cast
    ring
  -- the currents `Y(F)(ω) = ∑_{x ∈ M} θ(x) ε(x) ω(F(x))(∅)`
  let L : (Euclid N → Euclid N') → CurrentOn (univ : Set (Euclid N')) 0 := fun F =>
    { toFun := fun ω => ∑ x ∈ S, (wZ x : ℝ) * (ω : DifferentialForm (Euclid N') 0) (F x) v₀
      map_add' := fun ω η => by
        simp only [Submodule.coe_add, Pi.add_apply, ContinuousAlternatingMap.add_apply, mul_add,
          Finset.sum_add_distrib]
      map_smul' := fun c ω => by
        simp only [Submodule.coe_smul, Pi.smul_apply, ContinuousAlternatingMap.smul_apply,
          smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
        exact Finset.sum_congr rfl fun x _ => by ring }
  have hL : ∀ F ω, L F ω = ∑ x ∈ S, (wZ x : ℝ) * (ω : DifferentialForm (Euclid N') 0) (F x) v₀ :=
    fun F ω => rfl
  have hcont : ∀ F (ωs : ℕ → TestFormOn (univ : Set (Euclid N')) 0), TestFormOnConverges ωs 0 →
      Tendsto (fun j => L F (ωs j)) atTop (𝓝 0) := by
    intro F ωs hωs
    obtain ⟨K, -, -, hsupp, -, hconv⟩ := hωs
    have hpt0 : ∀ y,
        Tendsto (fun j => (ωs j : DifferentialForm (Euclid N') 0) y v₀) atTop (𝓝 0) := by
      intro y
      by_cases hy : y ∈ K
      · have hΦ : Continuous (fun g : ContinuousMultilinearMap ℝ (fun _ : Fin 0 => Euclid N')
            (Covector (Euclid N') 0) => g v₀ v₀) :=
          (continuous_eval_const v₀).comp (continuous_eval_const v₀)
        have h0 := (hΦ.tendsto _).comp ((hconv 0).tendsto_at hy)
        simpa [Function.comp_def, iteratedFDeriv_zero_apply] using h0
      · have hz : ∀ j, (ωs j : DifferentialForm (Euclid N') 0) y = 0 := fun j =>
          image_eq_zero_of_notMem_tsupport fun h => hy (hsupp j h)
        simp [hz]
    have := tendsto_finsetSum S fun x _ => (hpt0 (F x)).const_mul (wZ x : ℝ)
    simpa [hL] using this
  let Y : (Euclid N → Euclid N') → GeometricCurrentOn (univ : Set (Euclid N')) 0 := fun F =>
    ⟨L F, hcont F⟩
  have hY : ∀ F ω, Y F ω = ∑ x ∈ S, (wZ x : ℝ) * (ω : DifferentialForm (Euclid N') 0) (F x) v₀ :=
    fun F ω => rfl
  refine ⟨Y, fun F Λ hF => ⟨?_, ?_⟩, ?_⟩
  · -- integrality: regroup the finite sum by the fibres of `F`
    let c : Euclid N' → ℤ := fun y => ∑ x ∈ S.filter (fun x => F x = y), wZ x
    have hc_supp : ∀ y, c y ≠ 0 → y ∈ S.image F := by
      intro y hy
      by_contra hy'
      apply hy
      refine Finset.sum_eq_zero fun x hx => ?_
      rw [Finset.mem_filter] at hx
      exact absurd (Finset.mem_image.mpr ⟨x, hx.1, hx.2⟩) hy'
    let T' : Finset (Euclid N') := (S.image F).filter (fun y => c y ≠ 0)
    have hT' : ∀ y, y ∈ T' ↔ c y ≠ 0 := by
      intro y
      simp only [T', Finset.mem_filter]
      exact ⟨fun h => h.2, fun h => ⟨hc_supp y h, h⟩⟩
    have hT'meas : MeasurableSet (T' : Set (Euclid N')) := T'.finite_toSet.measurableSet
    let ev : MultiVector N' 0 := ContinuousAlternatingMap.apply ℝ (Euclid N') ℝ v₀
    let orient' : Euclid N' → MultiVector N' 0 := fun y => if c y < 0 then -ev else ev
    refine ⟨{ carrier := T'
              mult := fun y => (c y).natAbs
              orient := orient'
              measurableSet_carrier := hT'meas
              carrier_subset := subset_univ _
              rectifiable := ?_
              measurable_mult := ?_
              mult_pos := ?_
              locallyIntegrable_mult := ?_
              aestronglyMeasurable_orient := ?_
              orients := ?_ }, ?_⟩
    · -- a finite set is countably `0`-rectifiable
      obtain ⟨g, hg⟩ := Set.countable_iff_exists_subset_range.mp T'.countable_toSet
      refine ⟨∅, measure_empty, fun j _ => g j, fun j => ⟨0, LipschitzWith.const _⟩, ?_⟩
      intro y hy
      obtain ⟨j, rfl⟩ := hg hy
      exact Or.inr (Set.mem_iUnion.mpr ⟨j, 0, rfl⟩)
    · -- measurability of the multiplicity
      refine measurable_to_countable' fun k => ?_
      by_cases hk : k = 0
      · have : (fun y => (c y).natAbs) ⁻¹' {k} = (T' : Set (Euclid N'))ᶜ := by
          ext y
          simp [hk, hT']
        rw [this]
        exact hT'meas.compl
      · refine (T'.finite_toSet.subset fun y hy => ?_).measurableSet
        have hy' : (c y).natAbs = k := hy
        rw [Finset.mem_coe, hT']
        intro h0
        rw [h0] at hy'
        exact hk hy'.symm
    · intro y hy
      exact Int.natAbs_pos.mpr ((hT' y).mp hy)
    · intro K _ _
      refine ne_top_of_le_ne_top ?_ (lintegral_mono_set Set.inter_subset_left)
      rw [lintegral_finset]
      exact ENNReal.sum_ne_top.mpr fun y _ => by simp
    · refine (StronglyMeasurable.ite ?_ stronglyMeasurable_const
        stronglyMeasurable_const).aestronglyMeasurable
      exact (T'.finite_toSet.subset fun y hy => (hT' y).mpr (ne_of_lt hy)).measurableSet
    · refine ae_restrict_of_forall_mem hT'meas fun y hy => ⟨⊥, ⟨by simp, fun f => ?_⟩, ?_⟩
      · -- the approximate tangent space of a finite set is `{0}`
        obtain ⟨ρ, hρ⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall (0 : Euclid N')
        have hev : ∀ᶠ r in 𝓝[>] (0 : ℝ), 0 < r ∧ ∀ z ∈ T', z ≠ y → ρ < r⁻¹ * ‖z - y‖ := by
          refine eventually_mem_nhdsWithin.and ((Filter.eventually_all_finset T').2 fun z _ => ?_)
          by_cases hzy : z = y
          · exact Eventually.of_forall fun _ h => absurd hzy h
          · have hd : 0 < ‖z - y‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hzy)
            exact ((tendsto_inv_nhdsGT_zero.atTop_mul_const hd).eventually_gt_atTop ρ).mono
              fun r hr _ => hr
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [hev] with r hr
        obtain ⟨hr0, hfar⟩ := hr
        symm
        rw [Submodule.bot_coe]
        refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero
          (T'.finite_toSet.image _).measurableSet ?_ ?_
        · rintro _ rfl
          exact ⟨y, hy, by simp [Poincare.SimonGMT.Chapter03.blowUpMap]⟩
        · rintro _ ⟨⟨z, hz, rfl⟩, hz0⟩
          apply image_eq_zero_of_notMem_tsupport
          intro hmem
          have hzy : z ≠ y := by
            rintro rfl
            exact hz0 (by simp [Poincare.SimonGMT.Chapter03.blowUpMap])
          have h1 := hρ hmem
          have h2 := hfar z hz hzy
          rw [mem_closedBall_zero_iff, Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, norm_inv,
            Real.norm_of_nonneg hr0.le] at h1
          linarith
      · -- `±ev` orients `⊥`
        refine ⟨v₀, ⟨fun i => i.elim0, by intro i; exact i.elim0⟩, by simp, ?_⟩
        by_cases hneg : c y < 0
        · right; intro α; simp [orient', hneg, ev]
        · left; intro α; simp [orient', hneg, ev]
    · -- `R'` represents `Y(F)`
      intro ω
      have hint : IntegrableOn
          (fun y => ((c y).natAbs : ℝ) * orient' y ((ω : DifferentialForm (Euclid N') 0) y))
          (T' : Set (Euclid N')) (μHE[0] : Measure (Euclid N')) := by
        rw [← (T' : Set (Euclid N')).biUnion_of_singleton,
          integrableOn_finite_biUnion T'.finite_toSet]
        intro y _
        exact integrableOn_singleton (hx := by rw [hsing]; exact ENNReal.one_lt_top)
      show ∑ x ∈ S, (wZ x : ℝ) * (ω : DifferentialForm (Euclid N') 0) (F x) v₀ =
        ∫ y in (T' : Set (Euclid N')),
          ((c y).natAbs : ℝ) * orient' y ((ω : DifferentialForm (Euclid N') 0) y)
            ∂(μHE[0] : Measure (Euclid N'))
      rw [setIntegral_finset T' hint]
      have hterm : ∀ y ∈ T', (μHE[0] : Measure (Euclid N')).real {y} •
          (((c y).natAbs : ℝ) * orient' y ((ω : DifferentialForm (Euclid N') 0) y)) =
          (c y : ℝ) * (ω : DifferentialForm (Euclid N') 0) y v₀ := by
        intro y _
        rw [measureReal_def, hsing, ENNReal.toReal_one, one_smul, Nat.cast_natAbs, Int.cast_abs]
        by_cases hneg : c y < 0
        · have habs : |(c y : ℝ)| = -(c y : ℝ) := abs_of_neg (by exact_mod_cast hneg)
          simp only [orient', ite_eq_left hneg, ev, habs, neg_apply,
            ContinuousAlternatingMap.apply_apply]
          ring
        · have habs : |(c y : ℝ)| = (c y : ℝ) := abs_of_nonneg (by exact_mod_cast not_lt.mp hneg)
          simp only [orient', ite_eq_right hneg, ev, habs, ContinuousAlternatingMap.apply_apply]
      rw [Finset.sum_congr rfl hterm]
      show _ = ∑ y ∈ (S.image F).filter (fun y => c y ≠ 0),
        (c y : ℝ) * (ω : DifferentialForm (Euclid N') 0) y v₀
      rw [Finset.sum_filter_of_ne]
      · simp only [c, Int.cast_sum, Finset.sum_mul]
        rw [← Finset.sum_fiberwise_of_maps_to (g := F) (t := S.image F)
          fun x hx => Finset.mem_image_of_mem F hx]
        refine Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun x hx => ?_
        rw [(Finset.mem_filter.mp hx).2]
      · intro y _ h h0
        apply h
        rw [h0, Int.cast_zero, zero_mul]
  · -- `R.action(F_j^# ω) → Y(F)(ω)`
    intro Fs _ _ hFs ω
    simp only [haction, hY]
    refine tendsto_finsetSum S fun x _ => Tendsto.const_mul _ ?_
    have hω : Continuous (ω : DifferentialForm (Euclid N') 0) := ContDiff.continuous ω.property.1.1
    have h1 := (((continuous_eval_const v₀).comp hω).tendsto (F x)).comp (hFs.tendsto_at x)
    refine h1.congr fun j => ?_
    simp only [Function.comp_apply, ContinuousAlternatingMap.compContinuousLinearMap_apply]
    exact congrArg _ (Subsingleton.elim _ _)
  · -- locality
    intro F F' Λ _ _ hFF'
    have hEq : ∀ x ∈ R.carrier, F x = F' x := hpt hFF'
    ext ω
    simp only [hY]
    refine Finset.sum_congr rfl fun x hx => ?_
    rw [hEq x (hS ▸ hx)]

/-- **Simon Ch. 6, 3.4–3.5** (orientation along a bi-Lipschitz parametrised piece): let
`(M, θ, ξ)` be an integer multiplicity triple of degree `k` in `ℝᴺ` with `Hᵏ(M) < ∞`, `G : ℝᵏ → ℝᴺ`
Lipschitz, `B` Borel with `κ|a − a'| ≤ |G(a) − G(a')|` on `B`, `DG(a)` injective for `a ∈ B`, and
`G(B) ⊆ M`.  Then there is a Borel sign `s = ±1` with
`J_G(u) ξ(G u) = s(u) DG(u)e₁ ∧ ⋯ ∧ DG(u)eₖ` for a.e. `u ∈ B`, `J_G = det(⟨DG eₐ, DG e_b⟩)^{1/2}`.
For a.e. `u ∈ B`, `T_{G(u)}M = range DG(u)` and `ξ(G u)` orients it; so does
`ζ = J_G⁻¹ DG(u)e₁ ∧ ⋯ ∧ DG(u)eₖ`, hence `ξ(G u) = ±ζ`.  The sign is read off by comparing the
distances from `J_G ξ̃(G u)` to `±DG(u)e₁ ∧ ⋯ ∧ DG(u)eₖ`, `ξ̃` a Borel version of `ξ`. -/
theorem Submission.dor_lmb_fcd_imp_piece_orientation_sign : ∀ (N k : ℕ) (R : IMRep (univ : Set (Euclid N)) k) (G : Euclid k → Euclid N) (B : Set (Euclid k)) (L : NNReal) (κ : ℝ), μHE[k] R.carrier ≠ ∞ → LipschitzWith L G → MeasurableSet B → 0 < κ → (∀ a ∈ B, ∀ a' ∈ B, κ * ‖a - a'‖ ≤ ‖G a - G a'‖) → (∀ a ∈ B, DifferentiableAt ℝ G a ∧ Injective (fderiv ℝ G a)) → G '' B ⊆ R.carrier → ∃ s : Euclid k → ℝ, Measurable s ∧ (∀ u, s u = 1 ∨ s u = -1) ∧ ∀ᵐ u ∂(volume.restrict B), ∀ α : Covector (Euclid N) k, Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ G u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ G u (EuclideanSpace.single b (1 : ℝ))))) * R.orient (G u) α = s u * α (fun a => fderiv ℝ G u (EuclideanSpace.single a (1 : ℝ))) := by
  intro N k R G B L κ hfin hG hB hκ hbi hdiff hGBM
  -- `e` is the standard basis of `ℝᵏ`; `J T = det(⟨T eₐ, T e_b⟩)^{1/2}` and `Ev T = (α ↦ α(T e))`
  let e : Fin k → Euclid k := fun a => EuclideanSpace.single a (1 : ℝ)
  let J : (Euclid k →L[ℝ] Euclid N) → ℝ := fun T =>
    Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (T (e a)) (T (e b))))
  let Ev : (Euclid k →L[ℝ] Euclid N) → MultiVector N k := fun T =>
    (ContinuousAlternatingMap.apply ℝ (Euclid k) ℝ e).comp
      (ContinuousAlternatingMap.compContinuousLinearMapCLM T)
  have hev : ∀ v : Euclid k, Continuous fun T : Euclid k →L[ℝ] Euclid N => T v :=
    fun v => continuous_eval_const v
  have hJc : Continuous J := Real.continuous_sqrt.comp (Continuous.matrix_det
    (continuous_matrix fun a b => (hev (e a)).inner (hev (e b))))
  have hEvc : Continuous Ev :=
    continuous_const.clm_comp ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM
  -- Step 1: `Hᵏ⌞M`-a.e. properties hold at `G u` for a.e. `u ∈ B`
  obtain ⟨-, hpull⟩ := Submission.ptd_piece_image_measurable_ae_pullback N k G B L κ hG hB hκ hbi
  have hpullM : ∀ p : Euclid N → Prop, (∀ᵐ y ∂(μHE[k].restrict R.carrier), p y) →
      ∀ᵐ u ∂(volume.restrict B), p (G u) :=
    fun p hp => hpull p (ae_restrict_of_ae_restrict_of_subset hGBM hp)
  -- a strongly measurable version `g` of the orientation `ξ`
  let g := R.aestronglyMeasurable_orient.mk R.orient
  have hg : StronglyMeasurable g := R.aestronglyMeasurable_orient.stronglyMeasurable_mk
  have hgeq : ∀ᵐ u ∂(volume.restrict B), R.orient (G u) = g (G u) :=
    hpullM (fun y => R.orient y = g y) R.aestronglyMeasurable_orient.ae_eq_mk
  -- the sign `s u = ±1` compares the distances from `J g(G u)` to `±Ev(DG u)`
  let X : Euclid k → MultiVector N k := fun u => J (fderiv ℝ G u) • g (G u)
  let E : Euclid k → MultiVector N k := fun u => Ev (fderiv ℝ G u)
  let s : Euclid k → ℝ := fun u =>
    if dist (X u) (E u) ≤ dist (X u) ((-1 : ℝ) • E u) then 1 else -1
  have hX : StronglyMeasurable X :=
    (hJc.measurable.comp (measurable_fderiv ℝ G)).stronglyMeasurable.smul
      (hg.comp_measurable hG.continuous.measurable)
  have hE : StronglyMeasurable E :=
    hEvc.comp_stronglyMeasurable (measurable_fderiv ℝ G).stronglyMeasurable
  have hs : Measurable s :=
    Measurable.ite (measurableSet_le
      ((continuous_dist (α := MultiVector N k)).comp_stronglyMeasurable (hX.prodMk hE)).measurable
      ((continuous_dist (α := MultiVector N k)).comp_stronglyMeasurable
        (hX.prodMk (hE.const_smul (-1 : ℝ)))).measurable)
      measurable_const measurable_const
  refine ⟨s, hs, fun u => ?_, ?_⟩
  · simp only [s]
    split_ifs
    · exact Or.inl rfl
    · exact Or.inr rfl
  -- Steps 2–5: for a.e. `u ∈ B`, `J ξ(G u) = ± Ev(DG u)`
  have hkey : ∀ᵐ u ∂(volume.restrict B), X u = E u ∨ X u = (-1 : ℝ) • E u := by
    filter_upwards [ae_restrict_mem hB, hgeq, hpullM _ R.orients,
      Submission.dpf_approxTangent_ae_bilipschitz_piece N k univ R.carrier G B L κ isOpen_univ
        R.measurableSet_carrier (subset_univ _)
        (fun C _ _ => ne_top_of_le_ne_top hfin (measure_mono inter_subset_left)) hG hB hκ hbi
        hdiff hGBM] with u huB hgu hQ hT
    obtain ⟨Q, hQ, hξQ⟩ := hQ
    obtain ⟨-, hinj⟩ := hdiff u huB
    -- the approximate tangent space at `G u` is `range DG(u)`
    have hQeq : Q = LinearMap.range (fderiv ℝ G u : Euclid k →ₗ[ℝ] Euclid N) := hQ.unique hT
    -- `v = DG(u) e` is linearly independent and spans `range DG(u)`
    have hli : LinearIndependent ℝ (fun a => fderiv ℝ G u (e a)) := by
      have h := ((EuclideanSpace.basisFun (Fin k) ℝ).toBasis.linearIndependent).map'
        (fderiv ℝ G u : Euclid k →ₗ[ℝ] Euclid N) (LinearMap.ker_eq_bot.2 hinj)
      convert h using 1
      funext a
      simp [e]
    have hspan : Submodule.span ℝ (range fun a => fderiv ℝ G u (e a)) =
        LinearMap.range (fderiv ℝ G u : Euclid k →ₗ[ℝ] Euclid N) := by
      rw [LinearMap.range_eq_map, ← (EuclideanSpace.basisFun (Fin k) ℝ).toBasis.span_eq,
        Submodule.map_span, ← range_comp]
      congr 2
      funext a
      simp [e]
    -- `ζ = J⁻¹ Ev(DG u)` is a unit orientation of `range DG(u)`, and `J > 0`
    obtain ⟨hpos, hwedge⟩ :=
      Submission.codim1_lur_normalized_wedge_orientation N k (fun a => fderiv ℝ G u (e a)) hli
    have hJpos : 0 < J (fderiv ℝ G u) := Real.sqrt_pos.2 hpos
    have hζ : IsUnitOrientationOf ((J (fderiv ℝ G u))⁻¹ • E u) Q := by
      rw [hQeq, ← hspan]
      exact hwedge _ fun α => rfl
    -- `ξ(G u) = ±ζ`
    rcases Submission.rsdic_unitOrientation_eq_or_eq_neg N k _ _ Q hζ hξQ with h | h
    · left
      ext α
      show J (fderiv ℝ G u) * g (G u) α = E u α
      rw [← hgu, h]
      show J (fderiv ℝ G u) * ((J (fderiv ℝ G u))⁻¹ * E u α) = E u α
      rw [← mul_assoc, mul_inv_cancel₀ hJpos.ne', one_mul]
    · right
      ext α
      show J (fderiv ℝ G u) * g (G u) α = -1 * E u α
      rw [← hgu, h]
      show J (fderiv ℝ G u) * -((J (fderiv ℝ G u))⁻¹ * E u α) = -1 * E u α
      rw [mul_neg, ← mul_assoc, mul_inv_cancel₀ hJpos.ne', one_mul, neg_one_mul]
  -- Steps 5–7: the distance comparison selects the sign
  filter_upwards [hkey, hgeq] with u hu hgu α
  rw [hgu]
  show X u α = s u * E u α
  simp only [s]
  split_ifs with hle
  · rcases hu with h | h
    · rw [h, one_mul]
    · rw [h, dist_self] at hle
      have h0 : (-1 : ℝ) • E u = E u := dist_le_zero.1 hle
      rw [h, h0, one_mul]
  · rcases hu with h | h
    · exact absurd (by rw [h, dist_self]; exact dist_nonneg) hle
    · rw [h]
      rfl

/-- **Parametric representation of an integer multiplicity triple of finite mass** (Simon Ch. 6,
3.1 and 3.3–3.6, with Ch. 3, 1.1–1.3).  Let `R = (M, θ, ξ)` be an `IMRep` in `ℝᴺ` with
`μ_R(ℝᴺ) = ∫_M θ dHᵏ < ∞`, and write `J_G = √det(⟨DG eₐ, DG e_b⟩)`.  Then `M` is, up to an
`Hᵏ`-null set, the disjoint union of Borel pieces `Pᵢ = Gᵢ(Bᵢ) ⊆ M` with `Gᵢ` Lipschitz,
`mᵢ|a − a'| ≤ |Gᵢ(a) − Gᵢ(a')|` on `Bᵢ` and `DGᵢ` injective on `Bᵢ`
(`dpf_rectifiable_bilipschitz_pieces`); on each piece `J_{Gᵢ} ξ(Gᵢ) = sᵢ DGᵢ e` a.e. with
`sᵢ = ±1` (`dor_lmb_fcd_imp_piece_orientation_sign`), and the integer weights are
`wᵢ = (θ ∘ Gᵢ) sᵢ`.  The inverse of `Gᵢ|Bᵢ` is `mᵢ⁻¹`-Lipschitz, so `Gᵢ#(Lᵏ⌞Bᵢ) ≤ mᵢ^{-k} Hᵏ⌞Pᵢ`:
this gives `∫_{Bᵢ} |wᵢ| < ∞` and pulls `Hᵏ`-a.e. statements on `M` back to `Lᵏ`-a.e. statements on
`Bᵢ`.  The area formula `Hᵏ⌞Pᵢ = Gᵢ#((J_{Gᵢ} Lᵏ)⌞Bᵢ)` (`codim1_lura_gram_area_formula`) gives
`Σᵢ ∫_{Bᵢ} |wᵢ| J_{Gᵢ} = ∫_{⋃ Pᵢ} θ dHᵏ ≤ μ_R(ℝᴺ)` and, for bounded continuous `γ`,
`τ(M, θ, ξ)(γ) = Σᵢ ∫_{Pᵢ} θ ξ(γ) dHᵏ = Σᵢ ∫_{Bᵢ} wᵢ γ(Gᵢ)(DGᵢ e)` by countable additivity. -/
theorem Submission.dor_lmb_fcd_imp_parametric_rep : ∀ (N k : ℕ) (R : IMRep (univ : Set (Euclid N)) k), R.measure univ ≠ ∞ → ∃ (G : ℕ → Euclid k → Euclid N) (B : ℕ → Set (Euclid k)) (w : ℕ → Euclid k → ℝ), (∀ i, ∃ L : NNReal, LipschitzWith L (G i)) ∧ (∀ i, MeasurableSet (B i)) ∧ (∀ i, ∀ u ∈ B i, DifferentiableAt ℝ (G i) u) ∧ (∀ i, Measurable (w i)) ∧ (∀ i u, ∃ z : ℤ, w i u = z) ∧ (∀ i, ∀ u ∈ B i, w i u ≠ 0) ∧ (∀ i, IntegrableOn (w i) (B i)) ∧ ∑' i, ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ)))))) ≤ R.measure univ ∧ (∀ γ : Euclid N → Covector (Euclid N) k, Continuous γ → (∃ C : ℝ, ∀ x, ‖γ x‖ ≤ C) → HasSum (fun i => ∫ u in B i, w i u * γ (G i u) (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))) (R.action γ)) ∧ ∀ p : Euclid N → Prop, (∀ᵐ x ∂(μHE[k].restrict R.carrier), p x) → ∀ i, ∀ᵐ u ∂(volume.restrict (B i)), p (G i u) := by
  intro N k R hfin
  -- `θ` as a Borel function with values in `ℝ≥0∞` and in `ℝ`
  have hθm : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun j : ℕ => (j : ℝ≥0∞))).comp R.measurable_mult
  have hθmR : Measurable fun x => (R.mult x : ℝ) :=
    (measurable_from_nat (f := fun j : ℕ => (j : ℝ))).comp R.measurable_mult
  -- Step 1: `μ_R(ℝᴺ) = ∫_M θ dHᵏ`, and `Hᵏ(M) ≤ μ_R(ℝᴺ) < ∞` since `θ ≥ 1` on `M`
  have hmass : R.measure univ = ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k] := by
    rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  have hMfin : μHE[k] R.carrier ≠ ∞ := by
    refine ne_top_of_le_ne_top hfin ?_
    rw [hmass]
    calc μHE[k] R.carrier = ∫⁻ _ in R.carrier, (1 : ℝ≥0∞) ∂μHE[k] := by rw [setLIntegral_one]
      _ ≤ ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k] := by
        refine setLIntegral_mono hθm fun x hx => ?_
        exact_mod_cast R.mult_pos x hx
  -- Step 2: disjoint Borel bi-Lipschitz pieces `Pᵢ = Gᵢ(Bᵢ) ⊆ M` covering `M` up to a null set
  obtain ⟨G, B, m, hLip, hBm, hm, hbi, hdiff, hPm, hPM, hdisj, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces N k R.carrier R.measurableSet_carrier
      R.rectifiable
  choose L hL using hLip
  have hGm : ∀ i, Measurable (G i) := fun i => (hL i).continuous.measurable
  have hinj : ∀ i, InjOn (G i) (B i) := by
    intro i a ha a' ha' h
    have h1 := hbi i a ha a' ha'
    rw [h, sub_self, norm_zero] at h1
    have h2 : ‖a - a'‖ ≤ 0 := by
      by_contra hc
      exact absurd h1 (not_le.mpr (mul_pos (hm i) (not_le.mp hc)))
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h2)
  -- the Gram-determinant Jacobian `J_{Gᵢ}`
  obtain ⟨J, hJ⟩ : ∃ J : ℕ → Euclid k → ℝ, ∀ i u, J i u = Real.sqrt (Matrix.det
      (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))
        (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ))))) :=
    ⟨_, fun _ _ => rfl⟩
  have hJm : ∀ i, Measurable (J i) := by
    intro i
    have h := (Submission.codim1_lura_gram_area_formula k N (G i)).1
    simp only [← hJ] at h
    exact h
  -- Step 3: the signs `sᵢ = ±1` with `J_{Gᵢ}(u) ξ(Gᵢ u) = sᵢ(u) DGᵢ(u)e` a.e. on `Bᵢ`
  choose s hsm hspm hsae using fun i =>
    Submission.dor_lmb_fcd_imp_piece_orientation_sign N k R (G i) (B i) (L i) (m i) hMfin (hL i)
      (hBm i) (hm i) (hbi i) (hdiff i) (hPM i)
  -- Step 4: the weights `wᵢ = (θ ∘ Gᵢ) sᵢ`
  obtain ⟨w, hw⟩ : ∃ w : ℕ → Euclid k → ℝ, ∀ i u, w i u = (R.mult (G i u) : ℝ) * s i u :=
    ⟨_, fun _ _ => rfl⟩
  have hwm : ∀ i, Measurable (w i) := by
    intro i
    have h : w i = fun u => (R.mult (G i u) : ℝ) * s i u := funext (hw i)
    rw [h]
    exact (hθmR.comp (hGm i)).mul (hsm i)
  have hwz : ∀ i u, ∃ z : ℤ, w i u = z := by
    intro i u
    rcases hspm i u with h | h
    · exact ⟨(R.mult (G i u) : ℤ), by rw [hw, h]; push_cast; ring⟩
    · exact ⟨-(R.mult (G i u) : ℤ), by rw [hw, h]; push_cast; ring⟩
  have hw0 : ∀ i, ∀ u ∈ B i, w i u ≠ 0 := by
    intro i u hu
    have hpos : 0 < R.mult (G i u) := R.mult_pos _ (hPM i (mem_image_of_mem _ hu))
    rw [hw]
    refine mul_ne_zero (by exact_mod_cast hpos.ne') ?_
    rcases hspm i u with h | h <;> rw [h] <;> norm_num
  have hwe : ∀ i u, ‖w i u‖ₑ = (R.mult (G i u) : ℝ≥0∞) := by
    intro i u
    rcases hspm i u with h | h <;> simp [hw, h]
  -- Step 5: `Lᵏ(Bᵢ ∩ Gᵢ⁻¹ Z) ≤ mᵢ^{-k} Hᵏ(Z ∩ Pᵢ)`, the inverse of `Gᵢ|Bᵢ` being `mᵢ⁻¹`-Lipschitz
  have hpull : ∀ i (Z : Set (Euclid N)), volume (G i ⁻¹' Z ∩ B i) ≤
      ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k * μHE[k] (Z ∩ G i '' B i) := by
    intro i Z
    have hψ : LipschitzOnWith (Real.toNNReal (m i)⁻¹) (Function.invFunOn (G i) (B i))
        (G i '' B i) := by
      refine LipschitzOnWith.of_dist_le_mul fun y hy y' hy' => ?_
      obtain ⟨a, ha, rfl⟩ := hy
      obtain ⟨a', ha', rfl⟩ := hy'
      rw [(hinj i).leftInvOn_invFunOn ha, (hinj i).leftInvOn_invFunOn ha',
        Real.coe_toNNReal _ (inv_nonneg.mpr (hm i).le), dist_eq_norm, dist_eq_norm,
        inv_mul_eq_div, le_div_iff₀ (hm i)]
      linarith [hbi i a ha a' ha']
    have hsub : G i ⁻¹' Z ∩ B i ⊆ Function.invFunOn (G i) (B i) '' (Z ∩ G i '' B i) :=
      fun u hu => ⟨G i u, ⟨hu.1, mem_image_of_mem _ hu.2⟩, (hinj i).leftInvOn_invFunOn hu.2⟩
    calc volume (G i ⁻¹' Z ∩ B i)
        ≤ volume (Function.invFunOn (G i) (B i) '' (Z ∩ G i '' B i)) := measure_mono hsub
      _ = μHE[k] (Function.invFunOn (G i) (B i) '' (Z ∩ G i '' B i)) := by
        rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
      _ ≤ _ := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn k
          (hψ.mono inter_subset_right)
  have hmaple : ∀ i, Measure.map (G i) (volume.restrict (B i)) ≤
      ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k • μHE[k].restrict (G i '' B i) := by
    intro i
    rw [Measure.le_iff]
    intro Z hZ
    rw [Measure.map_apply (hGm i) hZ, Measure.restrict_apply (hGm i hZ), Measure.smul_apply,
      Measure.restrict_apply hZ, smul_eq_mul]
    exact hpull i Z
  -- Step 5(a): `Hᵏ`-a.e. statements on `M` pull back to `Lᵏ`-a.e. statements on `Bᵢ`
  have hae : ∀ p : Euclid N → Prop, (∀ᵐ x ∂(μHE[k].restrict R.carrier), p x) →
      ∀ i, ∀ᵐ u ∂(volume.restrict (B i)), p (G i u) := by
    intro p hp i
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier] at hp
    rw [ae_iff, Measure.restrict_apply' (hBm i)]
    refine nonpos_iff_eq_zero.mp ?_
    calc volume ({u | ¬p (G i u)} ∩ B i)
        ≤ ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k * μHE[k] ({x | ¬p x} ∩ G i '' B i) :=
          hpull i {x | ¬p x}
      _ ≤ ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k * μHE[k] ({x | ¬p x} ∩ R.carrier) := by
          gcongr
          exact hPM i
      _ = 0 := by rw [hp, mul_zero]
  -- Step 6: `∫_{Bᵢ} |wᵢ| = ∫_{Bᵢ} θ ∘ Gᵢ ≤ mᵢ^{-k} ∫_{Pᵢ} θ dHᵏ ≤ mᵢ^{-k} μ_R(ℝᴺ) < ∞`
  have hwint : ∀ i, IntegrableOn (w i) (B i) := by
    intro i
    refine ⟨(hwm i).aestronglyMeasurable, ?_⟩
    show ∫⁻ u in B i, ‖w i u‖ₑ < ∞
    simp only [hwe]
    calc ∫⁻ u in B i, (R.mult (G i u) : ℝ≥0∞)
        = ∫⁻ y, (R.mult y : ℝ≥0∞) ∂(Measure.map (G i) (volume.restrict (B i))) :=
          (lintegral_map hθm (hGm i)).symm
      _ ≤ ∫⁻ y, (R.mult y : ℝ≥0∞) ∂(((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k •
            μHE[k].restrict (G i '' B i)) := lintegral_mono' (hmaple i) le_rfl
      _ = ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k *
            ∫⁻ y in G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[k] := lintegral_smul_measure _ _
      _ ≤ ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k *
            ∫⁻ y in R.carrier, (R.mult y : ℝ≥0∞) ∂μHE[k] := by
          gcongr
          exact hPM i
      _ < ∞ := by
          rw [← hmass]
          exact ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) hfin.lt_top
  -- Step 7: the area formula on `Pᵢ`, and `Hᵏ⌞Pᵢ = Gᵢ#((J_{Gᵢ} Lᵏ)⌞Bᵢ)`
  have harea' : ∀ i (g : Euclid N → ℝ≥0∞), ∫⁻ y in G i '' B i, g y ∂μHE[k] =
      ∫⁻ u in B i, ENNReal.ofReal (J i u) * g (G i u) := by
    intro i g
    rw [(Submission.codim1_lura_gram_area_formula k N (G i)).2 (B i) (hBm i)
      (fun u hu => (hdiff i u hu).1) (fun u hu => (hdiff i u hu).2) (hinj i) g]
    simp only [hJ]
  have hμeq : ∀ i, μHE[k].restrict (G i '' B i) = Measure.map (G i)
      ((volume.restrict (B i)).withDensity fun u => ((J i u).toNNReal : ℝ≥0∞)) := by
    intro i
    ext Z hZ
    rw [Measure.map_apply (hGm i) hZ, withDensity_apply _ (hGm i hZ),
      ← lintegral_indicator_one hZ, harea' i, ← lintegral_indicator (hGm i hZ)]
    refine lintegral_congr fun u => ?_
    by_cases hu : G i u ∈ Z
    · simp [hu, indicator_of_mem, ENNReal.ofReal]
    · simp [hu]
  have htr : ∀ i (h : Euclid N → ℝ), AEStronglyMeasurable h (μHE[k].restrict R.carrier) →
      ∫ y in G i '' B i, h y ∂μHE[k] = ∫ u in B i, J i u * h (G i u) := by
    intro i h hh
    have hh' : AEStronglyMeasurable h (Measure.map (G i)
        ((volume.restrict (B i)).withDensity fun u => ((J i u).toNNReal : ℝ≥0∞))) := by
      rw [← hμeq i]
      exact hh.mono_measure (Measure.restrict_mono (hPM i) le_rfl)
    rw [hμeq i, integral_map (hGm i).aemeasurable hh',
      integral_withDensity_eq_integral_smul (hJm i).real_toNNReal]
    refine integral_congr_ae (ae_of_all _ fun u => ?_)
    simp only [NNReal.smul_def, smul_eq_mul, Real.coe_toNNReal _ (Real.sqrt_nonneg _), hJ]
  -- Step 8: `Σᵢ ∫_{Bᵢ} |wᵢ| J_{Gᵢ} = Σᵢ ∫_{Pᵢ} θ dHᵏ = ∫_{⋃ Pᵢ} θ dHᵏ ≤ μ_R(ℝᴺ)`
  have hmassle : ∑' i, ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (J i u) ≤ R.measure univ := by
    calc ∑' i, ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (J i u)
        = ∑' i, ∫⁻ y in G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[k] := by
          refine tsum_congr fun i => ?_
          rw [harea' i]
          refine lintegral_congr fun u => ?_
          rw [hwe, mul_comm]
      _ = ∫⁻ y in ⋃ i, G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[k] := (lintegral_iUnion hPm hdisj _).symm
      _ ≤ ∫⁻ y in R.carrier, (R.mult y : ℝ≥0∞) ∂μHE[k] := lintegral_mono_set (iUnion_subset hPM)
      _ = R.measure univ := hmass.symm
  -- Step 9: for bounded continuous `γ`, `τ(γ) = Σᵢ ∫_{Pᵢ} θ ξ(γ) dHᵏ = Σᵢ ∫_{Bᵢ} wᵢ γ(Gᵢ)(DGᵢ e)`
  have hsum : ∀ γ : Euclid N → Covector (Euclid N) k, Continuous γ → (∃ C : ℝ, ∀ x, ‖γ x‖ ≤ C) →
      HasSum (fun i => ∫ u in B i, w i u * γ (G i u)
        (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))) (R.action γ) := by
    rintro γ hγ ⟨C, hC⟩
    -- (a) `|ξ(x)(α)| ≤ ‖α‖` a.e. on `M`, `ξ(x)` being a unit orientation; hence `θ ξ(γ)` is
    -- `Hᵏ`-integrable on `M`, being dominated by `C θ`
    have hbound : ∀ᵐ x ∂(μHE[k].restrict R.carrier), ∀ α : Covector (Euclid N) k,
        |R.orient x α| ≤ ‖α‖ := by
      filter_upwards [R.orients] with x hx
      obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
      intro α
      have hτn : ∀ j, ‖τ j‖ = 1 := fun j => hτ.1 j
      have hατ : |α τ| ≤ ‖α‖ := by
        have h := α.le_opNorm τ
        simp only [hτn, Finset.prod_const_one, mul_one, Real.norm_eq_abs] at h
        exact h
      rcases hξ with h | h
      · rw [h]; exact hατ
      · rw [h, abs_neg]; exact hατ
    have hθi : Integrable (fun x => (R.mult x : ℝ)) (μHE[k].restrict R.carrier) := by
      refine ⟨hθmR.aestronglyMeasurable, ?_⟩
      show ∫⁻ x in R.carrier, ‖(R.mult x : ℝ)‖ₑ ∂μHE[k] < ∞
      simp only [Real.enorm_natCast]
      rw [← hmass]
      exact hfin.lt_top
    have hhm : AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (γ x))
        (μHE[k].restrict R.carrier) := by
      have h2 : AEStronglyMeasurable (fun x => R.orient x (γ x)) (μHE[k].restrict R.carrier) :=
        Continuous.comp_aestronglyMeasurable₂
          (g := fun (L : MultiVector N k) (α : Covector (Euclid N) k) => L α)
          (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid N) k) (F := ℝ)).continuous
          R.aestronglyMeasurable_orient hγ.aestronglyMeasurable
      exact hθmR.aestronglyMeasurable.mul h2
    have hhi : IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x (γ x)) R.carrier μHE[k] := by
      refine Integrable.mono' (hθi.const_mul C) hhm ?_
      filter_upwards [hbound] with x hx
      rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      calc (R.mult x : ℝ) * |R.orient x (γ x)| ≤ (R.mult x : ℝ) * ‖γ x‖ := by
            gcongr; exact hx _
        _ ≤ (R.mult x : ℝ) * C := by gcongr; exact hC x
        _ = C * (R.mult x : ℝ) := mul_comm _ _
    -- (b) `τ(γ) = ∫_{⋃ Pᵢ} θ ξ(γ) dHᵏ = Σᵢ ∫_{Pᵢ} θ ξ(γ) dHᵏ`
    have haction : R.action γ =
        ∫ y in ⋃ i, G i '' B i, (R.mult y : ℝ) * R.orient y (γ y) ∂μHE[k] := by
      rw [IMRep.action]
      refine setIntegral_congr_set ?_
      rw [ae_eq_set]
      refine ⟨hnull, ?_⟩
      rw [sdiff_eq_empty.mpr (iUnion_subset hPM), measure_empty]
    have hU := hasSum_integral_iUnion hPm hdisj (hhi.mono_set (iUnion_subset hPM))
    -- (c) `∫_{Pᵢ} θ ξ(γ) dHᵏ = ∫_{Bᵢ} J_{Gᵢ} θ(Gᵢ) ξ(Gᵢ)(γ(Gᵢ)) = ∫_{Bᵢ} wᵢ γ(Gᵢ)(DGᵢ e)`
    have hterm : ∀ i, ∫ y in G i '' B i, (R.mult y : ℝ) * R.orient y (γ y) ∂μHE[k] =
        ∫ u in B i, w i u * γ (G i u)
          (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) := by
      intro i
      rw [htr i _ hhm]
      refine integral_congr_ae ?_
      filter_upwards [hsae i] with u hu
      have h := hu (γ (G i u))
      rw [← hJ] at h
      rw [hw]
      calc J i u * ((R.mult (G i u) : ℝ) * R.orient (G i u) (γ (G i u)))
          = (R.mult (G i u) : ℝ) * (J i u * R.orient (G i u) (γ (G i u))) := by ring
        _ = (R.mult (G i u) : ℝ) * (s i u * γ (G i u)
              (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))) := by rw [h]
        _ = (R.mult (G i u) : ℝ) * s i u * γ (G i u)
              (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) := by ring
    rw [haction, ← funext hterm]
    exact hU
  -- Step 10: assemble
  refine ⟨G, B, w, fun i => ⟨L i, hL i⟩, hBm, fun i u hu => (hdiff i u hu).1, hwm, hwz, hw0,
    hwint, ?_, hsum, hae⟩
  simpa only [hJ] using hmassle
/-- **Simon Ch. 6, 3.5–3.9 on one bi-Lipschitz piece** (step 7 of the integer multiplicity
push-forward).  Assume (IMC): (a) approximate tangent spaces are local, (b) restricting an
`IMRep` to a Borel set represents a current, (c) differences of integer multiplicity currents are
integer multiplicity, (d) `|⟨α, ξ(x)⟩| ≤ |α|` a.e. on the carrier.  Let `H : ℝᵏ → ℝ^{N'}` be
Lipschitz, `A ⊆ ℝᵏ` Borel with `κ|a − a'| ≤ |H(a) − H(a')|` on `A` (`κ > 0`) and `DH(a)`
injective on `A`, and `g` Borel, integer-valued, nonzero on `A`, with `∫_A |g| J < ∞`, where
`J = √det(⟨DH eₐ, DH e_b⟩)`.  Then `Φ(ω) = ∫_A g ω(H)(DH e₁, …, DH eₖ)` is an integer
multiplicity current with `M(Φ) ≤ ∫_A |g| J`.  With `ψ` a Borel inverse of `H` on `A` and
`η = J⁻¹ DH e₁ ∧ ⋯ ∧ DH eₖ`, `Φ = τ(H(A), |g ∘ ψ|, sign(g ∘ ψ) η ∘ ψ)` by (IMC)(b); the area
formula gives `Hᵏ⌞H(A) = H_#(J Lᵏ⌞A)`, which yields the action, and (IMC)(d) the mass bound. -/
theorem Submission.dor_lmb_fcd_imp_piece_current : ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (k N' : ℕ) (H : Euclid k → Euclid N') (A : Set (Euclid k)) (L : NNReal) (κ : ℝ) (g : Euclid k → ℝ), LipschitzWith L H → MeasurableSet A → 0 < κ → (∀ a ∈ A, ∀ a' ∈ A, κ * ‖a - a'‖ ≤ ‖H a - H a'‖) → (∀ a ∈ A, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → Measurable g → (∀ u, ∃ z : ℤ, g u = z) → (∀ u ∈ A, g u ≠ 0) → ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ H u (EuclideanSpace.single b (1 : ℝ)))))) ≠ ∞ → ∃ Φ : GeometricCurrentOn (univ : Set (Euclid N')) k, IsIntegerMultiplicity Φ ∧ Φ.mass ≤ ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ H u (EuclideanSpace.single b (1 : ℝ)))))) ∧ ∀ ω : TestFormOn (univ : Set (Euclid N')) k, Φ ω = ∫ u in A, g u * (ω : DifferentialForm (Euclid N') k) (H u) (fun a => fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) := by
  intro hIMC k N' H A L κ g hH hA hκ hbi hdiff hg hgZ hg0 hfin
  obtain ⟨-, hIMCb, -, hIMCd⟩ := hIMC
  -- Step 1: `H` is injective on `A`, `N = H(A)` is Borel, and the area formula on `A`
  have hinj : InjOn H A := fun a ha a' ha' h => by
    have hle := hbi a ha a' ha'
    rw [h, sub_self, norm_zero] at hle
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hle hκ))
  have hN : MeasurableSet (H '' A) :=
    hA.image_of_continuousOn_injOn hH.continuous.continuousOn hinj
  have hHm : Measurable H := hH.continuous.measurable
  set J : Euclid k → ℝ := fun u => Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k =>
    inner ℝ (fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ)))
      (fderiv ℝ H u (EuclideanSpace.single b (1 : ℝ)))))
  obtain ⟨hJm, harea⟩ := Submission.codim1_lura_gram_area_formula k N' H
  have hJm' : Measurable J := hJm
  have hareaA : ∀ φ : Euclid N' → ℝ≥0∞,
      ∫⁻ y in H '' A, φ y ∂μHE[k] = ∫⁻ u in A, ENNReal.ofReal (J u) * φ (H u) :=
    harea A hA (fun u hu => (hdiff u hu).1) (fun u hu => (hdiff u hu).2) hinj
  -- Step 2: a Borel left inverse `ψ` of `H` on `A`
  obtain ⟨ψ, hψm, hψ⟩ := (ContinuousOn.measurableEmbedding hA hH.continuous.continuousOn
    hinj).exists_measurable_extend measurable_subtype_coe fun _ => ⟨0⟩
  have hψH : ∀ a ∈ A, ψ (H a) = a := fun a ha => congr_fun hψ ⟨a, ha⟩
  -- Step 3: `η(u) = J(u)⁻¹ DH(u)e₁ ∧ ⋯ ∧ DH(u)eₖ`
  let Ev : (Euclid k →L[ℝ] Euclid N') → MultiVector N' k := fun T =>
    (ContinuousAlternatingMap.apply ℝ (Euclid k) ℝ
      (fun a : Fin k => EuclideanSpace.single a (1 : ℝ))).comp
      (ContinuousAlternatingMap.compContinuousLinearMapCLM T)
  have hEvc : Continuous Ev :=
    continuous_const.clm_comp ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM
  let η : Euclid k → MultiVector N' k := fun u => (J u)⁻¹ • Ev (fderiv ℝ H u)
  have hη : ∀ u α, η u α = (J u)⁻¹ * α (fun a => fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) :=
    fun u α => rfl
  have hηm : StronglyMeasurable η :=
    hJm'.inv.stronglyMeasurable.smul
      (hEvc.comp_stronglyMeasurable (measurable_fderiv ℝ H).stronglyMeasurable)
  -- the frame `DH(a)e` is linearly independent and spans `range DH(a)` for `a ∈ A`
  have hli : ∀ a ∈ A, LinearIndependent ℝ
      (fun i : Fin k => fderiv ℝ H a (EuclideanSpace.single i (1 : ℝ))) := by
    intro a ha
    have := (EuclideanSpace.basisFun (Fin k) ℝ).toBasis.linearIndependent.map'
      (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N') (LinearMap.ker_eq_bot.mpr (hdiff a ha).2)
    simpa [Function.comp_def] using this
  have hspan : ∀ a, Submodule.span ℝ
      (Set.range (fun i : Fin k => fderiv ℝ H a (EuclideanSpace.single i (1 : ℝ)))) =
      LinearMap.range (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N') := by
    intro a
    have : (fun i : Fin k => fderiv ℝ H a (EuclideanSpace.single i (1 : ℝ))) =
        (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N') ∘
          (EuclideanSpace.basisFun (Fin k) ℝ).toBasis := by
      funext i; simp
    rw [this, Set.range_comp, Submodule.span_image,
      (EuclideanSpace.basisFun (Fin k) ℝ).toBasis.span_eq, Submodule.map_top]
  have hJpos : ∀ a ∈ A, 0 < J a := fun a ha =>
    Real.sqrt_pos.2 (Submission.codim1_lur_normalized_wedge_orientation N' k _ (hli a ha)).1
  have hηor : ∀ a ∈ A, IsUnitOrientationOf (η a)
      (LinearMap.range (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N')) := by
    intro a ha
    rw [← hspan a]
    exact (Submission.codim1_lur_normalized_wedge_orientation N' k _ (hli a ha)).2 (η a)
      (fun α => hη a α)
  have hJnn : ∀ u, 0 ≤ J u := fun u => Real.sqrt_nonneg _
  have hfin' : ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (J u) ≠ ∞ := hfin
  -- Step 4: the multiplicity `θ = ⌊|g ∘ ψ|⌋₊`, equal to `|g|` on `A` via `ψ ∘ H = id`
  have hfloor : Measurable (Nat.floor : ℝ → ℕ) :=
    measurable_to_countable fun r => by
      rcases eq_or_ne ⌊r⌋₊ 0 with h | h <;>
        simp [h, Nat.preimage_floor_of_ne_zero, -Nat.floor_eq_zero]
  let mult : Euclid N' → ℕ := fun y => ⌊|g (ψ y)|⌋₊
  have hmultm : Measurable mult := hfloor.comp (continuous_abs.measurable.comp (hg.comp hψm))
  have hmultA : ∀ a ∈ A, ∃ z : ℤ, g a = z ∧ mult (H a) = z.natAbs ∧ |g a| = (z.natAbs : ℝ) := by
    intro a ha
    obtain ⟨z, hz⟩ := hgZ a
    have habs : |g a| = (z.natAbs : ℝ) := by rw [hz, Nat.cast_natAbs, Int.cast_abs]
    refine ⟨z, hz, ?_, habs⟩
    show ⌊|g (ψ (H a))|⌋₊ = z.natAbs
    rw [hψH a ha, habs, Nat.floor_natCast]
  have hmultR : ∀ a ∈ A, ((mult (H a) : ℕ) : ℝ) = |g a| := by
    intro a ha
    obtain ⟨z, -, hm, habs⟩ := hmultA a ha
    rw [habs, hm]
  have hmultE : ∀ a ∈ A, ((mult (H a) : ℕ) : ℝ≥0∞) = ‖g a‖ₑ := by
    intro a ha
    obtain ⟨z, -, hm, habs⟩ := hmultA a ha
    rw [Real.enorm_eq_ofReal_abs, habs, ENNReal.ofReal_natCast, hm]
  have hmultpos : ∀ a ∈ A, 0 < mult (H a) := by
    intro a ha
    obtain ⟨z, hz, hm, -⟩ := hmultA a ha
    rw [hm]
    exact Int.natAbs_pos.2 (by rintro rfl; exact hg0 a ha (by simpa using hz))
  -- `∫_{H(A)} θ dHᵏ = ∫_A |g| J`, and `Hᵏ(H(A)) = ∫_A J ≤ ∫_A |g| J < ∞`
  have hmultint : ∫⁻ y in H '' A, (mult y : ℝ≥0∞) ∂μHE[k] =
      ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (J u) := by
    rw [hareaA]
    refine setLIntegral_congr_fun hA (fun u hu => ?_)
    rw [hmultE u hu, mul_comm]
  have hNfin : μHE[k] (H '' A) ≠ ∞ := by
    refine ne_top_of_le_ne_top hfin' ?_
    rw [← setLIntegral_one, hareaA]
    refine setLIntegral_mono' hA (fun u hu => ?_)
    rw [mul_one]
    calc ENNReal.ofReal (J u) = 1 * ENNReal.ofReal (J u) := (one_mul _).symm
      _ ≤ ‖g u‖ₑ * ENNReal.ofReal (J u) := by
        gcongr
        rw [← hmultE u hu]
        exact_mod_cast hmultpos u hu
  -- Step 5: the orientation `ξ = ±η ∘ ψ` (sign of `g ∘ ψ`)
  let orient : Euclid N' → MultiVector N' k := fun y =>
    (if 0 ≤ g (ψ y) then (1 : ℝ) else -1) • η (ψ y)
  have hsgn : Measurable fun y => if 0 ≤ g (ψ y) then (1 : ℝ) else -1 :=
    Measurable.ite (measurableSet_le measurable_const (hg.comp hψm)) measurable_const
      measurable_const
  have horm : StronglyMeasurable orient :=
    hsgn.stronglyMeasurable.smul (hηm.comp_measurable hψm)
  have horA : ∀ a ∈ A, IsUnitOrientationOf (orient (H a))
      (LinearMap.range (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N')) := by
    intro a ha
    obtain ⟨τ, hτ, hτspan, hτor⟩ := hηor a ha
    show IsUnitOrientationOf ((if 0 ≤ g (ψ (H a)) then (1 : ℝ) else -1) • η (ψ (H a))) _
    rw [hψH a ha]
    split_ifs
    · rw [one_smul]
      exact ⟨τ, hτ, hτspan, hτor⟩
    · refine ⟨τ, hτ, hτspan, hτor.symm.imp (fun h' α => ?_) (fun h' α => ?_)⟩
      · simp [h' α]
      · simp [h' α]
  -- `orients`: `H(A)` has approximate tangent space `range DH(a)` at `H(a)` for a.e. `a ∈ A`,
  -- and `Hᵏ`-null sets of parameters have `Hᵏ`-null images
  have htan := Submission.dpf_approxTangent_ae_bilipschitz_piece N' k univ (H '' A) H A L κ
    isOpen_univ hN (subset_univ _)
    (fun C _ _ => ne_top_of_le_ne_top hNfin (measure_mono inter_subset_left))
    hH hA hκ hbi hdiff subset_rfl
  have hgood : ∀ᵐ b ∂(volume.restrict A), ∃ Q : Submodule ℝ (Euclid N'),
      HasApproximateTangentSpaceAt k (H '' A) (H b) Q ∧ IsUnitOrientationOf (orient (H b)) Q := by
    filter_upwards [htan, ae_restrict_mem hA] with b hb hbA
    exact ⟨_, hb, horA b hbA⟩
  have horients : ∀ᵐ y ∂(μHE[k].restrict (H '' A)), ∃ Q : Submodule ℝ (Euclid N'),
      HasApproximateTangentSpaceAt k (H '' A) y Q ∧ IsUnitOrientationOf (orient y) Q := by
    rw [ae_restrict_iff' hA, ae_iff] at hgood
    rw [ae_restrict_iff' hN, ae_iff]
    refine measure_mono_null (fun y hy => ?_) (le_zero_iff.1
      ((Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn k
        hH.lipschitzOnWith).trans
        (by rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hgood, mul_zero])))
    obtain ⟨⟨b, hb, rfl⟩, hPy⟩ := not_imp.1 hy
    exact ⟨b, not_imp.2 ⟨hb, hPy⟩, rfl⟩
  -- Step 6: the triple `(H(A), θ, ξ)` is an integer multiplicity representation in `ℝ^{N'}`
  let R : IMRep (univ : Set (Euclid N')) k :=
    { carrier := H '' A
      mult := mult
      orient := orient
      measurableSet_carrier := hN
      carrier_subset := subset_univ _
      rectifiable := ⟨∅, measure_empty, fun _ => H, fun _ => ⟨L, hH⟩,
        fun y hy => Or.inr (mem_iUnion.2 ⟨0, image_subset_range H A hy⟩)⟩
      measurable_mult := hmultm
      mult_pos := by
        rintro _ ⟨a, ha, rfl⟩
        exact hmultpos a ha
      locallyIntegrable_mult := fun K _ _ =>
        ne_top_of_le_ne_top (hmultint ▸ hfin') (lintegral_mono_set inter_subset_left)
      aestronglyMeasurable_orient := horm.aestronglyMeasurable
      orients := horients }
  obtain ⟨Φ, R', hRep, hcar, hmul, hori⟩ :=
    hIMCb N' k univ R univ isOpen_univ MeasurableSet.univ
  have hcar' : R'.carrier = H '' A := by rw [hcar, inter_univ]
  have hΦ : ∀ ω : TestFormOn (univ : Set (Euclid N')) k, Φ ω =
      ∫ y in H '' A, (mult y : ℝ) * orient y ((ω : DifferentialForm (Euclid N') k) y) ∂μHE[k] := by
    intro ω
    rw [hRep ω, IMRep.action, hcar', hmul, hori]
  -- Step 7: `Hᵏ⌞H(A) = H_#(J Lᵏ⌞A)`, hence `∫_{H(A)} h dHᵏ = ∫_A J (h ∘ H)`
  have hmeasEq : μHE[k].restrict (H '' A) =
      Measure.map H ((volume.restrict A).withDensity fun u => ENNReal.ofReal (J u)) := by
    ext S hS
    calc (μHE[k].restrict (H '' A)) S = ∫⁻ y in H '' A, S.indicator 1 y ∂μHE[k] :=
          (lintegral_indicator_one hS).symm
      _ = ∫⁻ u in A, ENNReal.ofReal (J u) * S.indicator 1 (H u) := hareaA _
      _ = ∫⁻ u in A, (H ⁻¹' S).indicator (fun u => ENNReal.ofReal (J u)) u := by
          refine lintegral_congr fun u => ?_
          by_cases hu : H u ∈ S <;> simp [hu]
      _ = _ := by
          rw [lintegral_indicator (hHm hS), Measure.map_apply hHm hS, withDensity_apply _ (hHm hS)]
  have hint : ∀ h : Euclid N' → ℝ, AEStronglyMeasurable h (μHE[k].restrict (H '' A)) →
      ∫ y in H '' A, h y ∂μHE[k] = ∫ u in A, J u * h (H u) := by
    intro h hh
    rw [hmeasEq] at hh ⊢
    rw [integral_map hHm.aemeasurable hh, integral_withDensity_eq_integral_toReal_smul
      hJm'.ennreal_ofReal (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)]
    refine integral_congr_ae (ae_of_all _ fun u => ?_)
    simp only [smul_eq_mul, ENNReal.toReal_ofReal (hJnn u)]
  -- Step 8: the action `Φ(ω) = ∫_A g ω(H)(DH e)`
  have hval : ∀ ω : TestFormOn (univ : Set (Euclid N')) k, Φ ω = ∫ u in A, g u *
      (ω : DifferentialForm (Euclid N') k) (H u)
        (fun a => fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) := by
    intro ω
    have hωt : IsTestForm (ω : DifferentialForm (Euclid N') k) := ω.2.1
    have hωc : Continuous (ω : DifferentialForm (Euclid N') k) := ContDiff.continuous hωt.1
    have hcont : Continuous (uncurry fun (ξ : MultiVector N' k) (α : Covector (Euclid N') k) =>
        ξ α) := isBoundedBilinearMap_apply.continuous
    have hm : AEStronglyMeasurable
        (fun y => (mult y : ℝ) * orient y ((ω : DifferentialForm (Euclid N') k) y))
        (μHE[k].restrict (H '' A)) :=
      (measurable_from_nat.comp hmultm).aestronglyMeasurable.mul
        (hcont.comp_aestronglyMeasurable₂ horm.aestronglyMeasurable hωc.aestronglyMeasurable)
    rw [hΦ ω, hint _ hm]
    refine setIntegral_congr_fun hA (fun u hu => ?_)
    have hJu : J u ≠ 0 := (hJpos u hu).ne'
    rw [hmultR u hu]
    show J u * (|g u| * ((if 0 ≤ g (ψ (H u)) then (1 : ℝ) else -1) *
      η (ψ (H u)) ((ω : DifferentialForm (Euclid N') k) (H u)))) = _
    rw [hψH u hu, hη]
    split_ifs with hgu
    · rw [abs_of_nonneg hgu]
      field_simp
    · rw [abs_of_neg (not_le.1 hgu)]
      field_simp
  -- Step 9: the mass bound, from `|ξ(α)| ≤ |α|` a.e. (IMC (d))
  have hbound : ∀ᵐ y ∂(μHE[k].restrict (H '' A)), ∀ α : Covector (Euclid N') k,
      |orient y α| ≤ covectorEuclideanNorm α := by
    have h := hIMCd N' k univ R'
    rw [hcar', hori] at h
    exact h
  have hmass : Φ.mass ≤ ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (J u) := by
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (Φ ω) ≤ _
    rw [hΦ ω, ← hmultint]
    calc ENNReal.ofReal (∫ y in H '' A, (mult y : ℝ) *
          orient y ((ω : DifferentialForm (Euclid N') k) y) ∂μHE[k])
        ≤ ‖∫ y in H '' A, (mult y : ℝ) *
          orient y ((ω : DifferentialForm (Euclid N') k) y) ∂μHE[k]‖ₑ := by
          rw [Real.enorm_eq_ofReal_abs]
          exact ENNReal.ofReal_le_ofReal (le_abs_self _)
      _ ≤ ∫⁻ y in H '' A, ‖(mult y : ℝ) *
          orient y ((ω : DifferentialForm (Euclid N') k) y)‖ₑ ∂μHE[k] :=
          enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ y in H '' A, (mult y : ℝ≥0∞) ∂μHE[k] := by
          refine lintegral_mono_ae (hbound.mono fun y hy => ?_)
          rw [Real.enorm_eq_ofReal_abs, ← ENNReal.ofReal_natCast]
          refine ENNReal.ofReal_le_ofReal ?_
          rw [abs_mul, Nat.abs_cast]
          exact mul_le_of_le_one_right (Nat.cast_nonneg _) ((hy _).trans (hω.2 y))
  exact ⟨Φ, ⟨R', hRep⟩, hmass, hval⟩
/-- **First-order calculus of Lipschitz maps on parameter domains** (Simon Ch. 7, deformation step;
Ch. 6, 2.29; Ch. 2, 3.3–3.5).  Write `J_H(u) = √det(⟨DH(u)eₐ, DH(u)e_b⟩)`.
(i) If `F` is `Λ`-Lipschitz and `G` is differentiable at `u`, then `J_{F∘G}(u) ≤ Λᵏ J_G(u)`:
`|D(F∘G)(u)v| ≤ Λ|DG(u)v|` by difference quotients; a non-injective `D(F∘G)(u)` has singular Gram
matrix, and otherwise the area formula for the linear maps `L = D(F∘G)(u)`, `M = DG(u)` on the unit
ball `S` gives `Hᵏ(L S) = J(L)|S|`, `Hᵏ(M S) = J(M)|S|`, while `L = A ∘ M` with `A` `Λ`-Lipschitz on
`M S`, so `Hᵏ(L S) ≤ Λᵏ Hᵏ(M S)`.
(ii) If `H, H'` are Lipschitz and agree a.e. on a Borel set `B`, then `DH = DH'` a.e. on `B`: at a
point `u` of `E = {H = H'}` where `E` has density `1` along the balls `B(y, |y - u|/(n+1))`,
`y → u` (Lebesgue density theorem for the doubling measure `Lᵏ`), every `y` near `u` is within
`|y - u|/(n+1)` of `E`, so `H - H'` has derivative `0` at `u`. -/
theorem Submission.dor_lmb_fcd_imp_lipschitz_jacobian_locality : (∀ (k N N' : ℕ) (F : Euclid N → Euclid N') (G : Euclid k → Euclid N) (Λ : NNReal) (u : Euclid k), LipschitzWith Λ F → DifferentiableAt ℝ G u → Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ (F ∘ G) u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ (F ∘ G) u (EuclideanSpace.single b (1 : ℝ))))) ≤ (Λ : ℝ) ^ k * Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ G u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ G u (EuclideanSpace.single b (1 : ℝ)))))) ∧ ∀ (k N' : ℕ) (H H' : Euclid k → Euclid N') (B : Set (Euclid k)) (L L' : NNReal), LipschitzWith L H → LipschitzWith L' H' → MeasurableSet B → (∀ᵐ u ∂(volume.restrict B), H u = H' u) → ∀ᵐ u ∂(volume.restrict B), fderiv ℝ H u = fderiv ℝ H' u := by
  refine ⟨fun k N N' F G Λ u hF hG => ?_, fun k N' H H' B L L' hH hH' hB hae => ?_⟩
  · -- (i)  `Lm = D(F∘G)(u)`, `Mm = DG(u)`
    set Lm := fderiv ℝ (F ∘ G) u with hLm
    set Mm := fderiv ℝ G u with hMm
    -- `|Lm v| ≤ Λ |Mm v|`, from the difference quotients along `u + v/n`
    have hLM : ∀ v : Euclid k, ‖Lm v‖ ≤ (Λ : ℝ) * ‖Mm v‖ := by
      intro v
      by_cases hFG : DifferentiableAt ℝ (F ∘ G) u
      · have hc : Tendsto (fun n : ℕ => ‖(n : ℝ)‖) atTop atTop := by
          simpa only [Real.norm_natCast] using tendsto_natCast_atTop_atTop
        have h1 := (hFG.hasFDerivAt.lim v hc).norm
        have h2 := ((hG.hasFDerivAt.lim v hc).norm).const_mul (Λ : ℝ)
        refine le_of_tendsto_of_tendsto' h1 h2 fun n => ?_
        rw [norm_smul, norm_smul, mul_left_comm]
        refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
        rw [← dist_eq_norm, ← dist_eq_norm]
        exact hF.dist_le_mul _ _
      · rw [hLm, fderiv_zero_of_not_differentiableAt hFG, zero_apply, norm_zero]
        positivity
    by_cases hLinj : Injective Lm
    · have hMinj : Injective Mm := by
        intro v w hvw
        apply hLinj
        have h := hLM (v - w)
        simp only [map_sub, hvw, sub_self, norm_zero, mul_zero] at h
        exact sub_eq_zero.mp (norm_le_zero_iff.mp h)
      -- area formula for an injective linear map on the closed unit ball
      have harea : ∀ {P : ℕ} (T : Euclid k →L[ℝ] Euclid P), Injective T →
          μHE[k] (T '' closedBall 0 1) = ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k =>
            inner ℝ (T (EuclideanSpace.single a (1 : ℝ))) (T (EuclideanSpace.single b (1 : ℝ)))))) *
            volume (closedBall (0 : Euclid k) 1) := by
        intro P T hT
        have h := (Submission.codim1_lura_gram_area_formula k P T).2 (closedBall 0 1)
          measurableSet_closedBall (fun x _ => T.differentiableAt)
          (fun x _ => by rw [T.fderiv]; exact hT) hT.injOn (fun _ => 1)
        simpa only [ContinuousLinearMap.fderiv, mul_one, setLIntegral_one, setLIntegral_const] using h
      -- `Lm = A ∘ Mm` with `A = Lm ∘ Linv` `Λ`-Lipschitz on the range of `Mm`
      obtain ⟨Linv, hLinv⟩ := LinearMap.exists_leftInverse_of_injective (Mm : Euclid k →ₗ[ℝ] Euclid N)
        (LinearMap.ker_eq_bot.mpr hMinj)
      have hLx : ∀ x, Linv (Mm x) = x := fun x => by
        simpa using LinearMap.congr_fun hLinv x
      have hA : LipschitzOnWith Λ (fun y => Lm (Linv y)) (Mm '' closedBall 0 1) := by
        refine LipschitzOnWith.of_dist_le_mul fun y hy y' hy' => ?_
        obtain ⟨x, -, rfl⟩ := hy
        obtain ⟨x', -, rfl⟩ := hy'
        simp only [hLx, dist_eq_norm, ← map_sub]
        exact hLM (x - x')
      have himg : (fun y => Lm (Linv y)) '' (Mm '' closedBall 0 1) = Lm '' closedBall 0 1 := by
        rw [image_image]
        simp only [hLx]
      have hle := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn k hA
      rw [himg, harea Lm hLinj, harea Mm hMinj] at hle
      have hS0 : volume (closedBall (0 : Euclid k) 1) ≠ 0 := (measure_closedBall_pos volume 0 one_pos).ne'
      have hSt : volume (closedBall (0 : Euclid k) 1) ≠ ∞ := measure_closedBall_lt_top.ne
      rw [← mul_assoc, ENNReal.mul_le_mul_iff_left hS0 hSt, ← ENNReal.ofReal_coe_nnreal,
        ← ENNReal.ofReal_pow Λ.coe_nonneg, ← ENNReal.ofReal_mul (p := (Λ : ℝ) ^ k) (by positivity)] at hle
      exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp hle
    · -- a non-injective `Lm` has singular Gram matrix
      obtain ⟨v, w, hvw, hne⟩ : ∃ v w, Lm v = Lm w ∧ v ≠ w := by
        simpa [Injective] using hLinj
      have hdet : Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (Lm (EuclideanSpace.single a (1 : ℝ)))
          (Lm (EuclideanSpace.single b (1 : ℝ)))) = 0 := by
        have hx : ∑ b, (v - w).ofLp b • EuclideanSpace.single b (1 : ℝ) = v - w := by
          ext i
          simp [Pi.single_apply]
        rw [← Matrix.exists_mulVec_eq_zero_iff]
        refine ⟨(v - w).ofLp, fun h0 => hne (sub_eq_zero.mp ?_), ?_⟩
        · rw [← hx, h0]
          simp
        · funext a
          simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply]
          calc ∑ b, inner ℝ (Lm (EuclideanSpace.single a (1 : ℝ))) (Lm (EuclideanSpace.single b (1 : ℝ))) *
                (v - w).ofLp b
              = inner ℝ (Lm (EuclideanSpace.single a (1 : ℝ)))
                  (Lm (∑ b, (v - w).ofLp b • EuclideanSpace.single b (1 : ℝ))) := by
                rw [map_sum, inner_sum]
                refine Finset.sum_congr rfl fun b _ => ?_
                rw [map_smul, inner_smul_right, mul_comm]
            _ = 0 := by rw [hx, map_sub, hvw, sub_self, inner_zero_right]
      rw [hdet, Real.sqrt_zero]
      positivity
  · -- (ii)  `E = {H = H'}` is closed and contains almost all of `B`
    set E : Set (Euclid k) := {x | H x = H' x} with hE
    have hBE : B ≤ᵐ[volume] E := by
      filter_upwards [(ae_restrict_iff' hB).mp hae] with x hx
      exact fun hxB => hx hxB
    -- density of `E` along the balls `B(y, |y - x|/(n+1))`, `y → x`
    have hdens : ∀ᵐ x ∂(volume.restrict E), ∀ n : ℕ,
        Tendsto (fun y => volume (E ∩ closedBall y (dist y x / ((n : ℝ) + 1))) /
          volume (closedBall y (dist y x / ((n : ℝ) + 1)))) (𝓝[≠] x) (𝓝 1) := by
      rw [ae_all_iff]
      intro n
      filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_measure_inter_div
        (volume : Measure (Euclid k)) E ((n : ℝ) + 1)] with x hx
      have hn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      refine hx id (fun y => dist y x / ((n : ℝ) + 1)) ?_ ?_
      · rw [tendsto_nhdsWithin_iff]
        constructor
        · have h0 : Tendsto (fun y => dist y x / ((n : ℝ) + 1)) (𝓝 x) (𝓝 (dist x x / ((n : ℝ) + 1))) :=
            ((continuous_id.dist continuous_const).div_const _).tendsto x
          rw [dist_self, zero_div] at h0
          exact h0.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with y hy
          exact div_pos (dist_pos.mpr (mem_compl_singleton_iff.mp hy)) hn
      · refine Eventually.of_forall fun y => ?_
        rw [mem_closedBall, id, mul_div_cancel₀ _ hn.ne', dist_comm]
    filter_upwards [hae, ae_mono (Measure.restrict_mono_ae hBE) hdens] with u hu hdu
    -- `H - H'` has derivative `0` at `u`
    have hD : HasFDerivAt (fun x => H x - H' x) (0 : Euclid k →L[ℝ] Euclid N') u := by
      refine HasFDerivAt.of_isLittleO (Asymptotics.isLittleO_iff.mpr fun c hc => ?_)
      obtain ⟨n, hn⟩ := exists_nat_gt (((L : ℝ) + L') / c)
      have hn1 : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      have hev : ∀ᶠ y in 𝓝[≠] u, (E ∩ closedBall y (dist y u / ((n : ℝ) + 1))).Nonempty := by
        filter_upwards [(hdu n).eventually_ne one_ne_zero] with y hy
        refine nonempty_of_measure_ne_zero (μ := volume) fun h0 => hy ?_
        rw [h0, ENNReal.zero_div]
      rw [eventually_nhdsWithin_iff] at hev
      filter_upwards [hev] with y hy
      simp only [hu, sub_self, sub_zero, zero_apply]
      by_cases hyu : y = u
      · subst hyu
        simp [hu]
      obtain ⟨z, hzE, hz⟩ := hy (mem_compl_singleton_iff.mpr hyu)
      rw [mem_closedBall, dist_comm] at hz
      have hzE' : H z = H' z := hzE
      have hcoef : ((L : ℝ) + L') / ((n : ℝ) + 1) ≤ c := by
        rw [div_le_iff₀ hn1]
        rw [div_lt_iff₀ hc] at hn
        nlinarith
      calc ‖H y - H' y‖ = ‖(H y - H z) - (H' y - H' z)‖ := by rw [hzE']; congr 1; abel
        _ ≤ ‖H y - H z‖ + ‖H' y - H' z‖ := norm_sub_le _ _
        _ ≤ L * dist y z + L' * dist y z := by
            rw [← dist_eq_norm, ← dist_eq_norm]
            exact add_le_add (hH.dist_le_mul _ _) (hH'.dist_le_mul _ _)
        _ = (L + L') * dist y z := by ring
        _ ≤ (L + L') * (dist y u / ((n : ℝ) + 1)) := by gcongr
        _ = ((L + L') / ((n : ℝ) + 1)) * dist y u := by ring
        _ ≤ c * ‖y - u‖ := by
            rw [← dist_eq_norm]
            exact mul_le_mul_of_nonneg_right hcoef dist_nonneg
    by_cases hd : DifferentiableAt ℝ H u
    · have h1 := hd.hasFDerivAt.sub hD
      rw [show (H - fun x => H x - H' x) = H' from funext fun x => sub_sub_cancel (H x) (H' x)] at h1
      rw [h1.fderiv, sub_zero]
    · have hd' : ¬DifferentiableAt ℝ H' u := fun hd' => hd (by
        have h1 := hd'.hasFDerivAt.add hD
        rw [show (H' + fun x => H x - H' x) = H from funext fun x => add_sub_cancel (H' x) (H x)] at h1
        exact h1.differentiableAt)
      rw [fderiv_zero_of_not_differentiableAt hd, fderiv_zero_of_not_differentiableAt hd']

/-- **Integrality of the parametric image series** (Simon Ch. 6, 3.6–3.9: `f#τ(M, θ, ξ)` is an
integer multiplicity current; step 7 of the selected proof, with the bounds of step 6).  Write
`d = k + 1`, `Hᵢ = F ∘ Gᵢ`, `J_H = √det(⟨DH eₐ, DH e_b⟩)`,
`Tᵢ(ω) = ∫_{Bᵢ} wᵢ ω(Hᵢ)(DHᵢ e₀, …, DHᵢ eₖ)` and `mᵢ = ∫⁻_{Bᵢ} |wᵢ| J_{Gᵢ}`.
* `J_{Hᵢ} ≤ Λᵈ J_{Gᵢ}` on `Bᵢ` (`dor_lmb_fcd_imp_lipschitz_jacobian_locality`), so
  `∫⁻_{Bᵢ} |wᵢ| J_{Hᵢ} ≤ Λᵈ mᵢ < ∞`.
* `dor_lmb_fcd_imp_regular_partition` gives disjoint Borel `Aᵢₗ ⊆ Bᵢ` on which `Hᵢ` is
  bi-Lipschitz below with injective derivative, covering every `u ∈ Bᵢ` where `DHᵢ(u)` exists and
  is injective; `dor_lmb_fcd_imp_piece_current` gives integer multiplicity `Φᵢₗ` with
  `Φᵢₗ(ω) = ∫_{Aᵢₗ} wᵢ ω(Hᵢ)(DHᵢ e)` and `M(Φᵢₗ) ≤ ∫⁻_{Aᵢₗ} |wᵢ| J_{Hᵢ}`.
* On `Bᵢ \ ⋃ₗ Aᵢₗ` either `DHᵢ = 0` or the columns `DHᵢ eₐ` are linearly dependent, so the
  integrand vanishes there; it is integrable on `Bᵢ` (`|ω| ≤ C`, `‖DHᵢ‖ ≤ ΛLᵢ`).  Countable
  additivity gives `∑ₗ Φᵢₗ(ω) = Tᵢ(ω)` and `∑ₗ M(Φᵢₗ) ≤ ∫⁻_{Bᵢ} |wᵢ| J_{Hᵢ} ≤ Λᵈ mᵢ`.
* Enumerating the pairs `(i, l)` by `ℕ`, (IMS) gives an integer multiplicity `Y` with
  `∑ᵢₗ Φᵢₗ(ω) = Y(ω)`; summing fibrewise, `∑ᵢ Tᵢ(ω) = Y(ω)`.
* If `|ω(x)| ≤ c`, then `±c⁻¹ω` is admissible for the mass, so `|Φᵢₗ(ω)| ≤ c M(Φᵢₗ)` and
  `|Tᵢ(ω)| ≤ c ∑ₗ M(Φᵢₗ) ≤ c Λᵈ mᵢ`. -/
theorem Submission.dor_lmb_fcd_imp_image_series_im : (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (N N' k : ℕ) (G : ℕ → Euclid (k + 1) → Euclid N) (B : ℕ → Set (Euclid (k + 1))) (w : ℕ → Euclid (k + 1) → ℝ) (F : Euclid N → Euclid N') (Λ : NNReal), (∀ i, ∃ L : NNReal, LipschitzWith L (G i)) → (∀ i, MeasurableSet (B i)) → (∀ i, ∀ u ∈ B i, DifferentiableAt ℝ (G i) u) → (∀ i, Measurable (w i)) → (∀ i u, ∃ z : ℤ, w i u = z) → (∀ i, ∀ u ∈ B i, w i u ≠ 0) → (∀ i, IntegrableOn (w i) (B i)) → ∑' i, ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin (k + 1) => inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ)))))) ≠ ∞ → LipschitzWith Λ F → ∃ Y : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), HasSum (fun i => ∫ u in B i, w i u * (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))) (Y ω)) ∧ ∀ (ω : TestFormOn (univ : Set (Euclid N')) (k + 1)) (c : ℝ), 0 < c → (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) x) ≤ c) → ∀ i, |∫ u in B i, w i u * (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))| ≤ c * (Λ : ℝ) ^ (k + 1) * (∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin (k + 1) => inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ))))))).toReal := by
  intro hIMS hIMC N N' k G B w F Λ hGlip hBm hGd hwm hwZ hw0 hwi hsum hF
  -- Lipschitz constants `Lᵢ` of `Gᵢ`; `Hᵢ = F ∘ Gᵢ` is `ΛLᵢ`-Lipschitz
  choose L hL using hGlip
  have hHlip : ∀ i, LipschitzWith (Λ * L i) (F ∘ G i) := fun i => hF.comp (hL i)
  have hΛ : (Λ : ℝ≥0∞) ^ (k + 1) ≠ ∞ := ENNReal.pow_ne_top ENNReal.coe_ne_top
  -- `mᵢ = ∫⁻_{Bᵢ} |wᵢ| J_{Gᵢ} < ∞`
  have hm : ∀ i, (∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det
      (Matrix.of fun a b : Fin (k + 1) =>
        inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))
          (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ))))))) ≠ ∞ :=
    fun i => ENNReal.ne_top_of_tsum_ne_top hsum i
  -- (1) Jacobian comparison `J_{Hᵢ} ≤ Λᵈ J_{Gᵢ}` on `Bᵢ`: `∫⁻_{Bᵢ} |wᵢ| J_{Hᵢ} ≤ Λᵈ mᵢ`
  have hJ : ∀ i, (∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det
      (Matrix.of fun a b : Fin (k + 1) =>
        inner ℝ (fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))
          (fderiv ℝ (F ∘ G i) u (EuclideanSpace.single b (1 : ℝ))))))) ≤
      (Λ : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det
        (Matrix.of fun a b : Fin (k + 1) =>
          inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))
            (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ)))))) := by
    intro i
    rw [← lintegral_const_mul' _ _ hΛ]
    refine setLIntegral_mono' (hBm i) fun u hu => ?_
    have h := ENNReal.ofReal_le_ofReal
      ((Submission.dor_lmb_fcd_imp_lipschitz_jacobian_locality).1 (k + 1) N N' F (G i) Λ u hF
        (hGd i u hu))
    rw [ENNReal.ofReal_mul (p := (Λ : ℝ) ^ (k + 1)) (by positivity),
      ENNReal.ofReal_pow NNReal.zero_le_coe, ENNReal.ofReal_coe_nnreal] at h
    exact (mul_le_mul_of_nonneg_left h zero_le).trans_eq (mul_left_comm _ _ _)
  -- (3) disjoint Borel pieces `Aᵢₗ ⊆ Bᵢ` covering the points of `Bᵢ` where `DHᵢ` is injective
  choose A κ hAm hAB hAd hκ hAbl hAreg hAcov using fun i =>
    Submission.dor_lmb_fcd_imp_regular_partition (k + 1) N' (F ∘ G i) (B i) (hBm i)
  -- (4) the integer multiplicity piece currents `Φᵢₗ`
  choose Φ hΦIM hΦM hΦω using fun i l =>
    Submission.dor_lmb_fcd_imp_piece_current hIMC (k + 1) N' (F ∘ G i) (A i l) (Λ * L i) (κ i l)
      (w i) (hHlip i) (hAm i l) (hκ i l) (hAbl i l) (hAreg i l) (hwm i) (hwZ i)
      (fun u hu => hw0 i u (hAB i l hu))
      (ne_top_of_le_ne_top (ENNReal.mul_ne_top hΛ (hm i))
        ((lintegral_mono_set (hAB i l)).trans (hJ i)))
  -- (7) `∑ₗ M(Φᵢₗ) ≤ ∫⁻_{⋃ₗ Aᵢₗ} |wᵢ| J_{Hᵢ} ≤ Λᵈ mᵢ`
  have hmass : ∀ i, ∑' l, (Φ i l).mass ≤
      (Λ : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det
        (Matrix.of fun a b : Fin (k + 1) =>
          inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))
            (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ)))))) := by
    intro i
    refine (ENNReal.tsum_le_tsum fun l => hΦM i l).trans ?_
    rw [← lintegral_iUnion (hAm i) (hAd i)]
    exact (lintegral_mono_set (iUnion_subset (hAB i))).trans (hJ i)
  -- linearly independent columns `T e₀, …, T eₖ` force `T` to be injective
  have hcols : ∀ T : Euclid (k + 1) →L[ℝ] Euclid N',
      LinearIndependent ℝ (fun a => T (EuclideanSpace.single a (1 : ℝ))) → Injective T := by
    intro T hli
    rw [injective_iff_map_eq_zero]
    intro z hz
    have hzs : ∑ a, z.ofLp a • EuclideanSpace.single a (1 : ℝ) = z := by
      have h := (EuclideanSpace.basisFun (Fin (k + 1)) ℝ).sum_repr z
      simp only [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] at h
      exact h
    have hc : ∀ a, z.ofLp a = 0 := by
      refine Fintype.linearIndependent_iff.mp hli _ ?_
      calc ∑ a, z.ofLp a • T (EuclideanSpace.single a (1 : ℝ))
          = T (∑ a, z.ofLp a • EuclideanSpace.single a (1 : ℝ)) := by
            rw [map_sum]; simp only [map_smul]
        _ = 0 := by rw [hzs, hz]
    rw [← hzs]
    exact Finset.sum_eq_zero fun a _ => by rw [hc a, zero_smul]
  -- (2), (5), (6): `∑ₗ Φᵢₗ(ω) = Tᵢ(ω)`
  have hfib : ∀ i (ω : TestFormOn (univ : Set (Euclid N')) (k + 1)),
      HasSum (fun l => Φ i l ω) (∫ u in B i, w i u * (ω : DifferentialForm (Euclid N') (k + 1))
        ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))) := by
    intro i ω
    have hωc : Continuous (ω : DifferentialForm (Euclid N') (k + 1)) := ω.property.1.1.continuous
    obtain ⟨C, hC⟩ := HasCompactSupport.exists_bound_of_continuous ω.property.1.2 hωc
    -- (2) the integrand is Borel and bounded by `C (ΛLᵢ)ᵈ |wᵢ|`, hence integrable on `Bᵢ`
    have hcont : Continuous fun p : Euclid N' × (Euclid (k + 1) →L[ℝ] Euclid N') =>
        (ω : DifferentialForm (Euclid N') (k + 1)) p.1
          (fun a => p.2 (EuclideanSpace.single a (1 : ℝ))) :=
      (hωc.comp continuous_fst).eval
        (continuous_pi fun a => continuous_snd.clm_apply continuous_const)
    have hmeas : AEStronglyMeasurable (fun u => (ω : DifferentialForm (Euclid N') (k + 1))
        ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))))
        (volume.restrict (B i)) :=
      Continuous.comp_aestronglyMeasurable₂
        (g := fun (y : Euclid N') (T : Euclid (k + 1) →L[ℝ] Euclid N') =>
          (ω : DifferentialForm (Euclid N') (k + 1)) y
            (fun a => T (EuclideanSpace.single a (1 : ℝ))))
        hcont (hHlip i).continuous.aestronglyMeasurable
        (measurable_fderiv ℝ (F ∘ G i)).aestronglyMeasurable
    have hbd : ∀ u, ‖(ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)
        (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))‖ ≤
        C * ((Λ * L i : NNReal) : ℝ) ^ (k + 1) := by
      intro u
      have hcol : ∀ a : Fin (k + 1),
          ‖fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))‖ ≤ ((Λ * L i : NNReal) : ℝ) := by
        intro a
        calc ‖fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))‖
            ≤ ‖fderiv ℝ (F ∘ G i) u‖ * ‖EuclideanSpace.single a (1 : ℝ)‖ :=
              (fderiv ℝ (F ∘ G i) u).le_opNorm _
          _ = ‖fderiv ℝ (F ∘ G i) u‖ := by simp
          _ ≤ _ := norm_fderiv_le_of_lipschitz ℝ (hHlip i)
      have hprod : ∏ a : Fin (k + 1), ‖fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))‖ ≤
          ((Λ * L i : NNReal) : ℝ) ^ (k + 1) := by
        calc ∏ a : Fin (k + 1), ‖fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))‖
            ≤ ∏ _a : Fin (k + 1), ((Λ * L i : NNReal) : ℝ) :=
              Finset.prod_le_prod₀ (fun a _ => norm_nonneg _) fun a _ => hcol a
          _ = _ := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact (((ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)).le_opNorm _).trans
        (mul_le_mul (hC _) hprod (Finset.prod_nonneg fun a _ => norm_nonneg _)
          ((norm_nonneg _).trans (hC 0)))
    have hint : IntegrableOn (fun u => w i u * (ω : DifferentialForm (Euclid N') (k + 1))
        ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))) (B i) := by
      refine Integrable.mono' ((hwi i).norm.mul_const (C * ((Λ * L i : NNReal) : ℝ) ^ (k + 1)))
        ((hwm i).aestronglyMeasurable.mul hmeas) (ae_of_all _ fun u => ?_)
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hbd u) (norm_nonneg _)
    -- (5) the integrand vanishes on `Bᵢ \ ⋃ₗ Aᵢₗ`, where `DHᵢ = 0` or `DHᵢ` is not injective
    have hvan : ∀ u ∈ B i \ ⋃ l, A i l, w i u * (ω : DifferentialForm (Euclid N') (k + 1))
        ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))) = 0 := by
      rintro u ⟨huB, huA⟩
      rw [mem_iUnion, not_exists] at huA
      suffices h : (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)
          (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))) = 0 by
        rw [h, mul_zero]
      by_cases hd : DifferentiableAt ℝ (F ∘ G i) u
      · by_cases hinj : Injective (fderiv ℝ (F ∘ G i) u)
        · obtain ⟨l, hl⟩ := hAcov i u huB hd hinj
          exact absurd hl (huA l)
        · -- the columns `DHᵢ(u) eₐ` are linearly dependent
          exact ((ω : DifferentialForm (Euclid N') (k + 1))
            ((F ∘ G i) u)).toAlternatingMap.map_linearDependent _ fun hli => hinj (hcols _ hli)
      · rw [fderiv_zero_of_not_differentiableAt hd]
        exact ((ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)).map_zero
    -- (6) `Tᵢ(ω) = ∫_{⋃ₗ Aᵢₗ} = ∑ₗ ∫_{Aᵢₗ} = ∑ₗ Φᵢₗ(ω)`
    rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hBm i) (iUnion_subset (hAB i)) hvan]
    have hfun : (fun l => Φ i l ω) = fun l => ∫ u in A i l, w i u *
        (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)
          (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))) :=
      funext fun l => hΦω i l ω
    rw [hfun]
    exact hasSum_integral_iUnion (hAm i) (hAd i) (hint.mono_set (iUnion_subset (hAB i)))
  -- (8) enumerate the pieces by `ℕ`: `Xᵣ = Φ_{π(r)}`; (IMS) gives the integer multiplicity `Y`
  let π : ℕ ≃ ℕ × ℕ := Nat.pairEquiv.symm
  let X : ℕ → GeometricCurrentOn (univ : Set (Euclid N')) (k + 1) := fun r => Φ (π r).1 (π r).2
  have hXmass : ∑' r, (X r).mass ≠ ∞ := by
    have h : ∑' r, (X r).mass = ∑' i, ∑' l, (Φ i l).mass :=
      (Equiv.tsum_eq π fun p : ℕ × ℕ => (Φ p.1 p.2).mass).trans
        (ENNReal.tsum_prod (f := fun i l => (Φ i l).mass))
    rw [h]
    refine ne_top_of_le_ne_top (ENNReal.mul_ne_top hΛ hsum) ?_
    rw [← ENNReal.tsum_mul_left]
    exact ENNReal.tsum_le_tsum hmass
  obtain ⟨Y, hYIM, hYsum, -⟩ :=
    hIMS N' k univ X isOpen_univ (fun r => hΦIM (π r).1 (π r).2) hXmass
  refine ⟨Y, hYIM, fun ω => ?_, fun ω c hc hωc i => ?_⟩
  · -- (9) `HasSum ((i, l) ↦ Φᵢₗ(ω)) (Y ω)`, summed fibrewise over `l`
    have h : HasSum ((fun p : ℕ × ℕ => Φ p.1 p.2 ω) ∘ π) (Y ω) := hYsum ω
    exact ((Equiv.hasSum_iff π).mp h).prod_fiberwise fun i => hfib i ω
  · -- (10) `±Tᵢ(ω) = ∑ₗ ±Φᵢₗ(ω) ≤ c ∑ₗ M(Φᵢₗ) ≤ c Λᵈ mᵢ`
    have hc0 : c ≠ 0 := hc.ne'
    have hsmul : ∀ (s : ℝ) (α : Covector (Euclid N') (k + 1)),
        covectorEuclideanNorm (s • α) = |s| * covectorEuclideanNorm α := by
      intro s α
      unfold covectorEuclideanNorm
      rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg s), Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun I _ => ?_
      split_ifs
      · rw [ContinuousAlternatingMap.smul_apply, smul_eq_mul, mul_pow]
      · rw [mul_zero]
    -- `|Z(ω)| ≤ c M(Z)`: `±c⁻¹ω` is admissible for `M(Z) = M_{ℝ^{N'}}(Z)`
    have hZω : ∀ Z : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1), Z.mass ≠ ∞ →
        |Z ω| ≤ c * Z.mass.toReal := by
      intro Z hZ
      have hadm : ∀ s : ℝ, |s| = c⁻¹ → s * Z ω ≤ Z.mass.toReal := by
        intro s hs
        have hmem : s • ω ∈ massAdmissibleOn (univ : Set (Euclid N')) (k + 1) univ := by
          rw [massAdmissibleOn, mem_ofPred_eq]
          refine ⟨subset_univ _, fun x => ?_⟩
          rw [Submodule.coe_smul, Pi.smul_apply, hsmul, hs]
          calc c⁻¹ * covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) x)
              ≤ c⁻¹ * c := mul_le_mul_of_nonneg_left (hωc x) (inv_nonneg.mpr hc.le)
            _ = 1 := inv_mul_cancel₀ hc0
        have h := Z.le_massOn hmem
        rw [map_smul, smul_eq_mul] at h
        exact (ENNReal.ofReal_le_iff_le_toReal hZ).mp h
      have h1 := mul_le_mul_of_nonneg_left (hadm c⁻¹ (abs_of_pos (inv_pos.mpr hc))) hc.le
      have h2 := mul_le_mul_of_nonneg_left
        (hadm (-c⁻¹) (by rw [abs_neg, abs_of_pos (inv_pos.mpr hc)])) hc.le
      rw [← mul_assoc, mul_inv_cancel₀ hc0, one_mul] at h1
      rw [neg_mul, mul_neg, ← mul_assoc, mul_inv_cancel₀ hc0, one_mul] at h2
      rw [abs_le]
      constructor <;> linarith
    have hfinsum : ∑' l, (Φ i l).mass ≠ ∞ :=
      ne_top_of_le_ne_top (ENNReal.mul_ne_top hΛ (hm i)) (hmass i)
    have hfin : ∀ l, (Φ i l).mass ≠ ∞ := ENNReal.ne_top_of_tsum_ne_top hfinsum
    have hS : HasSum (fun l => c * ((Φ i l).mass).toReal) (c * (∑' l, (Φ i l).mass).toReal) := by
      rw [ENNReal.tsum_toReal_eq hfin]
      exact (ENNReal.summable_toReal hfinsum).hasSum.mul_left c
    have hup := hasSum_le (fun l => (le_abs_self _).trans (hZω _ (hfin l))) (hfib i ω) hS
    have hlo := hasSum_le (fun l => (neg_le_abs _).trans (hZω _ (hfin l))) (hfib i ω).neg hS
    have hfinal := mul_le_mul_of_nonneg_left
      (ENNReal.toReal_mono (ENNReal.mul_ne_top hΛ (hm i)) (hmass i)) hc.le
    rw [ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.coe_toReal, ← mul_assoc] at hfinal
    rw [abs_le]
    constructor <;> linarith
/-- **Coordinate expansion of a `k`-covector** (the pointwise identity behind
`H^#ω(u)(e) = Σ_I ω_I(H(u)) det D(H^I)(u)`): for `f ∈ Λᵏ(ℝ^{N'})` and `u ∈ (ℝ^{N'})ᵏ`,
`k! f(u) = Σ_I f(e'_{I 0}, …, e'_{I (k-1)}) det (u_b (I c))_{c,b}`, the sum over all maps
`I : Fin k → Fin N'`.  Expand each `u_b = Σ_i u_b(i) e'_i` and use multilinearity; for each
permutation `σ` reindex `J = I ∘ σ` and use `f (v ∘ σ) = sign σ • f v`; average over the `k!`
permutations and recognize the Leibniz formula for the determinant. -/
theorem Submission.dor_lmb_fcd_jwc_covector_det_expansion : ∀ (N' k : ℕ) (f : Covector (Euclid N') k) (u : Fin k → Euclid N'), (k.factorial : ℝ) * f u = ∑ I : Fin k → Fin N', f (fun c => EuclideanSpace.single (I c) (1 : ℝ)) * Matrix.det (Matrix.of fun c b => u b (I c)) := by
  intro N' k f u
  set e : Fin N' → Euclid N' := fun i => EuclideanSpace.single i (1 : ℝ) with he
  -- step 1: multilinear expansion in the standard basis
  have h1 : f u = ∑ J : Fin k → Fin N', (∏ b, u b (J b)) * f (fun b => e (J b)) := by
    have hu : u = fun b => ∑ i, u b i • e i := by
      funext b
      conv_lhs => rw [← (EuclideanSpace.basisFun (Fin N') ℝ).sum_repr (u b)]
      simp [he]
    conv_lhs => rw [hu]
    rw [show f (fun b => ∑ i, u b i • e i) = f.toMultilinearMap (fun b => ∑ i, u b i • e i) from rfl,
      MultilinearMap.map_sum]
    refine Finset.sum_congr rfl fun J _ => ?_
    rw [MultilinearMap.map_smul_univ]
    simp [smul_eq_mul]
  -- step 2: reindex by a permutation `σ`, using alternation
  have h2 : ∀ σ : Equiv.Perm (Fin k), f u = ∑ I : Fin k → Fin N',
      ((Equiv.Perm.sign σ : ℤ) : ℝ) * (∏ b, u b (I (σ b))) * f (fun c => e (I c)) := by
    intro σ
    rw [h1]
    rw [← Equiv.sum_comp ((σ.symm).arrowCongr (Equiv.refl (Fin N')))]
    refine Finset.sum_congr rfl fun I _ => ?_
    have hperm : f (fun b => e (I (σ b))) = ((Equiv.Perm.sign σ : ℤ) : ℝ) * f (fun c => e (I c)) := by
      have := f.toAlternatingMap.map_perm (fun c => e (I c)) σ
      simp only [Function.comp_def] at this
      rw [show f (fun b => e (I (σ b))) = f.toAlternatingMap (fun b => e (I (σ b))) from rfl, this,
        Units.smul_def, zsmul_eq_mul]
      rfl
    simp only [Equiv.arrowCongr_apply, Equiv.refl_apply, Equiv.symm_symm, Function.comp_apply]
    rw [hperm]
    ring
  -- step 3: average over `σ` and recognize the Leibniz formula
  have h3 : (k.factorial : ℝ) * f u = ∑ σ : Equiv.Perm (Fin k), f u := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
  rw [h3]
  calc ∑ σ : Equiv.Perm (Fin k), f u
      = ∑ σ : Equiv.Perm (Fin k), ∑ I : Fin k → Fin N',
          ((Equiv.Perm.sign σ : ℤ) : ℝ) * (∏ b, u b (I (σ b))) * f (fun c => e (I c)) :=
        Finset.sum_congr rfl fun σ _ => h2 σ
    _ = ∑ I : Fin k → Fin N', ∑ σ : Equiv.Perm (Fin k),
          ((Equiv.Perm.sign σ : ℤ) : ℝ) * (∏ b, u b (I (σ b))) * f (fun c => e (I c)) :=
        Finset.sum_comm
    _ = _ := ?_
  refine Finset.sum_congr rfl fun I _ => ?_
  rw [Matrix.det_apply, Finset.mul_sum]
  refine Finset.sum_congr rfl fun σ _ => ?_
  rw [Units.smul_def, zsmul_eq_mul]
  simp only [Matrix.of_apply, he]
  ring
/-- **Jacobian minors of Lipschitz maps are measurable and bounded** (the integrands in the weak
continuity of Jacobian minors): if `g₀, …, g_{r-1}` are `L`-Lipschitz on `ℝᵏ` and
`V₀, …, V_{r-1} ∈ ℝᵏ`, then `D(x) = det (Dg_c(x) V_b)_{c,b}` is measurable and
`|D(x)| ≤ r! (L ∑_b ‖V_b‖)ʳ` for every `x`, where `Dg(x) = fderiv ℝ g x` (`0` where `g` is not
differentiable).  Each entry `x ↦ Dg_c(x) V_b` is measurable (`measurable_fderiv_apply_const`)
and bounded by `‖Dg_c(x)‖ ‖V_b‖ ≤ L ‖V_b‖ ≤ L ∑_b ‖V_b‖` (`norm_fderiv_le_of_lipschitz`); by the
Leibniz formula `D` is a signed sum of `r!` products of `r` entries, which gives both claims.
(`Matrix.det_le` is outside the import closure, so the bound is done by hand.) -/
theorem Submission.dor_lmb_fcd_jwc_minor_measurable_bound : ∀ (k r : ℕ) (L : NNReal) (g : Fin r → Euclid k → ℝ) (V : Fin r → Euclid k), (∀ c, LipschitzWith L (g c)) → Measurable (fun x => Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b))) ∧ ∀ x, |Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b))| ≤ (r.factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ r := by
  intro k r L g V hg
  -- Leibniz formula: `D(x) = ∑_σ sign σ ∏_b Dg_{σ b}(x) V_b`
  have hdet : ∀ x, Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) =
      ∑ σ : Equiv.Perm (Fin r), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b) :=
    fun x => Matrix.det_apply' _
  refine ⟨?_, fun x => ?_⟩
  · -- steps 1–2: the entries are measurable, hence so is the signed sum of their products
    have hm : Measurable fun x => ∑ σ : Equiv.Perm (Fin r),
        ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b) :=
      Finset.measurable_sum _ fun σ _ => measurable_const.mul
        (Finset.measurable_prod _ fun b _ => measurable_fderiv_apply_const ℝ (g (σ b)) (V b))
    simpa only [hdet] using hm
  · -- step 3: every entry is bounded by `s = L ∑_b ‖V_b‖`
    have hent : ∀ c b, |fderiv ℝ (g c) x (V b)| ≤ (L : ℝ) * ∑ b, ‖V b‖ := by
      intro c b
      rw [← Real.norm_eq_abs]
      calc ‖fderiv ℝ (g c) x (V b)‖ ≤ ‖fderiv ℝ (g c) x‖ * ‖V b‖ :=
            ContinuousLinearMap.le_opNorm _ _
        _ ≤ L * ‖V b‖ :=
            mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ (hg c)) (norm_nonneg _)
        _ ≤ L * ∑ b, ‖V b‖ := by
            gcongr
            exact Finset.single_le_sum (f := fun b => ‖V b‖) (fun b _ => norm_nonneg _)
              (Finset.mem_univ b)
    -- step 4: the triangle inequality and `|sign σ| = 1` give `|D(x)| ≤ ∑_σ sʳ = r! sʳ`
    rw [hdet]
    calc |∑ σ : Equiv.Perm (Fin r), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b)|
        ≤ ∑ σ : Equiv.Perm (Fin r),
            |((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ = ∑ σ : Equiv.Perm (Fin r), ∏ b, |fderiv ℝ (g (σ b)) x (V b)| := by
          refine Finset.sum_congr rfl fun σ _ => ?_
          rw [abs_mul, Finset.abs_prod]
          rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
      _ ≤ ∑ _σ : Equiv.Perm (Fin r), ∏ _b : Fin r, (L : ℝ) * ∑ b, ‖V b‖ := by
          gcongr with σ _ b _
          exact hent (σ b) b
      _ = (r.factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ r := by
          rw [Finset.sum_const, Finset.prod_const, Finset.card_univ, Finset.card_univ,
            Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
/-- **Derivative of the mollification of a Lipschitz function**: for an `L`-Lipschitz `f` and a
`C¹` kernel `ρ` with compact support, `D(ρ ⋆ f)(x) v = ∫ ρ(t) Df(x − t) v dt`.  Differentiating
under the integral (`HasCompactSupport.hasFDerivAt_convolution_left`) gives
`D(ρ ⋆ f)(x) v = ∫ Dρ(t) v · f(x − t) dt`.  With `t = x − s` and the reflected kernel
`h(s) = ρ(x − s)` (`C¹` with compact support, hence Lipschitz, and `∂_{−v} h(s) = Dρ(x − s) v`)
the two sides become `∫ ∂_{−v} h · f` and `∫ h · Df(·) v`; they agree by integration by parts for
Lipschitz functions (`LipschitzWith.integral_lineDeriv_mul_eq`: `∫ ∂_v f · h = ∫ ∂_{−v} h · f`)
and Rademacher (`∂_v f = Df · v` a.e.). -/
theorem Submission.dor_lmb_fcd_jwc_mollify_fderiv_eq : ∀ (k : ℕ) (L : NNReal) (f ρ : Euclid k → ℝ), LipschitzWith L f → ContDiff ℝ 1 ρ → HasCompactSupport ρ → ∀ x v : Euclid k, fderiv ℝ (fun y => ∫ t, ρ t * f (y - t)) x v = ∫ t, ρ t * fderiv ℝ f (x - t) v := by
  intro k L f ρ hf hρ hρs x v
  have hconv : (fun y => ∫ t, ρ t * f (y - t)) =
      convolution ρ f (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    funext y; simp [convolution_def]
  have hD := hρs.hasFDerivAt_convolution_left (μ := volume) (ContinuousLinearMap.lsmul ℝ ℝ) hρ
    hf.continuous.locallyIntegrable x
  have hint := (hρs.fderiv (𝕜 := ℝ)).convolutionExists_left (μ := (volume : Measure (Euclid k)))
    ((ContinuousLinearMap.lsmul ℝ ℝ).precompL (Euclid k)) (hρ.continuous_fderiv (by norm_num))
    (hf.continuous.locallyIntegrable (μ := (volume : Measure (Euclid k)))) x
  rw [hconv, hD.fderiv, convolution_def, ContinuousLinearMap.integral_apply hint]
  simp only [ContinuousLinearMap.precompL_apply, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  -- change of variables `t ↦ x - t` on both sides
  rw [← integral_sub_left_eq_self (fun t => fderiv ℝ ρ t v * f (x - t)) (μ := volume) x,
    ← integral_sub_left_eq_self (fun t => ρ t * fderiv ℝ f (x - t) v) (μ := volume) x]
  simp only [sub_sub_cancel]
  -- integration by parts against `h(s) = ρ(x - s)`
  set h : Euclid k → ℝ := fun s => ρ (x - s) with hh
  have hhC1 : ContDiff ℝ 1 h := hρ.comp (contDiff_const.sub contDiff_id)
  have hhs : HasCompactSupport h := hρs.comp_homeomorph (Homeomorph.subLeft x)
  obtain ⟨D, hhL⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hhs hhC1 (by norm_num)
  have hibp := hf.integral_lineDeriv_mul_eq (μ := volume) hhL hhs v
  have hlh : ∀ s, lineDeriv ℝ h s (-v) = fderiv ℝ ρ (x - s) v := by
    intro s
    rw [(hhC1.differentiable (by norm_num) s).lineDeriv_eq_fderiv]
    have h1 : HasFDerivAt h (-(fderiv ℝ ρ (x - s))) s := by
      have := (hρ.differentiable (by norm_num) (x - s)).hasFDerivAt.comp s
        ((hasFDerivAt_const x s).sub (hasFDerivAt_id s))
      simpa [hh, Function.comp_def] using this
    rw [h1.fderiv]
    simp
  -- Rademacher: `∂_v f = Df · v` almost everywhere
  have hlf : ∀ᵐ s ∂(volume : Measure (Euclid k)), lineDeriv ℝ f s v = fderiv ℝ f s v := by
    filter_upwards [hf.ae_differentiableAt] with s hs
    exact hs.lineDeriv_eq_fderiv
  simp only [hlh] at hibp
  rw [← hibp]
  refine integral_congr_ae ?_
  filter_upwards [hlf] with s hs
  rw [hs, hh]
  ring
/-- **Smooth approximation of a Lipschitz function** (step 4 of the weak continuity of Jacobians):
an `L`-Lipschitz `f : ℝᵏ → ℝ` is the uniform limit of `C^∞`, `L`-Lipschitz functions `f_n` with
`Df_n(x) → Df(x)` in operator norm for a.e. `x`.  Take `f_n = ρ_n ⋆ f`, where `ρ_n = φ_n / ∫ φ_n`
normalizes a bump `φ_n` equal to `1` on `B(0, 1/(n+2))` and supported in `B(0, 2/(n+2))`.  Then
`f_n` is smooth, `L`-Lipschitz (`cmcs_ls_mollify_lipschitz`) and `|f_n - f| ≤ 2L/(n+2)`.  By
`dor_lmb_fcd_jwc_mollify_fderiv_eq`, `Df_n(x) eᵢ = (ρ_n ⋆ Df(·) eᵢ)(x)`; as `∫ φ_n ≥ |B(0, 1/(n+2))|`
gives `0 ≤ ρ_n ≤ 2ᵈ / |B(0, 2/(n+2))|`, this tends to `Df(x) eᵢ` at every Lebesgue point of the
bounded function `Df(·) eᵢ`, and `‖T‖ ≤ ∑ᵢ |T eᵢ|` gives convergence in operator norm. -/
theorem Submission.dor_lmb_fcd_jwc_lipschitz_smooth_approx : ∀ (k : ℕ) (L : NNReal) (f : Euclid k → ℝ), LipschitzWith L f → ∃ fs : ℕ → Euclid k → ℝ, (∀ n, ContDiff ℝ (⊤ : ℕ∞) (fs n)) ∧ (∀ n, LipschitzWith L (fs n)) ∧ TendstoUniformly fs f atTop ∧ ∀ᵐ x ∂(volume : Measure (Euclid k)), Tendsto (fun n => fderiv ℝ (fs n) x) atTop (𝓝 (fderiv ℝ f x)) := by
  intro k L f hf
  -- step 1: bumps `φ n` with `rIn = 1/(n+2)`, `rOut = 2/(n+2)`, normalized to `ρ n = φ n / ∫ φ n`
  have hpos : ∀ n : ℕ, (0 : ℝ) < (n : ℝ) + 2 := fun n => by positivity
  let φ : ℕ → ContDiffBump (0 : Euclid k) := fun n =>
    ⟨1 / ((n : ℝ) + 2), 2 / ((n : ℝ) + 2), by have := hpos n; positivity,
      div_lt_div_of_pos_right (by norm_num) (hpos n)⟩
  have hrOut : ∀ n, (φ n).rOut = 2 * (φ n).rIn := fun n => by
    show 2 / ((n : ℝ) + 2) = 2 * (1 / ((n : ℝ) + 2))
    rw [mul_one_div]
  -- `|B(x, r)| = r ^ d * c` with `c = |B(0, 1)| > 0`
  set d := Module.finrank ℝ (Euclid k)
  set c := (volume : Measure (Euclid k)).real (closedBall 0 1)
  have hcpos : 0 < c := ENNReal.toReal_pos (measure_closedBall_pos _ _ one_pos).ne'
    measure_closedBall_lt_top.ne
  have hvol : ∀ (x : Euclid k) (r : ℝ), 0 ≤ r →
      (volume : Measure (Euclid k)).real (closedBall x r) = r ^ d * c :=
    fun x r hr => Measure.addHaar_real_closedBall' _ x hr
  -- `φ n = 1` on `B(0, rIn)` and `φ n ≥ 0`, so `∫ φ n ≥ |B(0, rIn)| = rIn ^ d * c > 0`
  have hφint : ∀ n, Integrable (φ n) (volume : Measure (Euclid k)) := fun n =>
    (φ n).continuous.integrable_of_hasCompactSupport (φ n).hasCompactSupport
  have hIge : ∀ n, (φ n).rIn ^ d * c ≤ ∫ x, φ n x := by
    intro n
    rw [← hvol 0 _ (φ n).rIn_pos.le]
    calc (volume : Measure (Euclid k)).real (closedBall 0 (φ n).rIn)
        = ∫ x in closedBall (0 : Euclid k) (φ n).rIn, φ n x := by
          rw [setIntegral_congr_fun measurableSet_closedBall
            (fun x hx => (φ n).one_of_mem_closedBall hx), setIntegral_const, smul_eq_mul, mul_one]
      _ ≤ ∫ x, φ n x :=
          setIntegral_le_integral (hφint n) (Eventually.of_forall fun x => (φ n).nonneg)
  have hIpos : ∀ n, 0 < ∫ x, φ n x := fun n =>
    (mul_pos (pow_pos (φ n).rIn_pos d) hcpos).trans_le (hIge n)
  set ρ : ℕ → Euclid k → ℝ := fun n x => φ n x / ∫ y, φ n y with hρ
  have hρc : ∀ n, ContDiff ℝ (⊤ : ℕ∞) (ρ n) := fun n => (φ n).contDiff.div_const _
  have hρc1 : ∀ n, ContDiff ℝ 1 (ρ n) := fun n => (φ n).contDiff.div_const _
  have hρcont : ∀ n, Continuous (ρ n) := fun n => (φ n).continuous.div_const _
  have hρs : ∀ n, HasCompactSupport (ρ n) := fun n =>
    (φ n).hasCompactSupport.comp_left (g := fun t : ℝ => t / ∫ y, φ n y) (zero_div _)
  have hρ0 : ∀ n x, 0 ≤ ρ n x := fun n x => div_nonneg (φ n).nonneg (hIpos n).le
  have hρint : ∀ n, ∫ x, ρ n x = 1 := fun n => by
    show ∫ x, φ n x / ∫ y, φ n y = 1
    rw [integral_div, div_self (hIpos n).ne']
  have hρsupp : ∀ n, support (ρ n) ⊆ ball 0 (φ n).rOut := fun n x hx => by
    rw [← (φ n).support_eq, mem_support]
    intro h0
    exact (mem_support.1 hx) (by simp [hρ, h0])
  have hρle : ∀ n x, ρ n x ≤ 1 / ((φ n).rIn ^ d * c) := fun n x =>
    calc ρ n x = φ n x / ∫ y, φ n y := rfl
      _ ≤ 1 / ∫ y, φ n y := div_le_div_of_nonneg_right (φ n).le_one (hIpos n).le
      _ ≤ 1 / ((φ n).rIn ^ d * c) :=
          one_div_le_one_div_of_le (mul_pos (pow_pos (φ n).rIn_pos d) hcpos) (hIge n)
  -- `f_n = ρ n ⋆ f`
  set fs : ℕ → Euclid k → ℝ := fun n x => ∫ t, ρ n t * f (x - t) with hfs
  have hconv : ∀ n, fs n = convolution (ρ n) f (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    intro n; funext x; simp [hfs, convolution_def]
  have hrOut0 : Tendsto (fun n => (φ n).rOut) atTop (𝓝 0) := by
    have := tendsto_const_nhds (x := (2 : ℝ)) |>.div_atTop
      (tendsto_atTop_add_const_right atTop (2 : ℝ) tendsto_natCast_atTop_atTop)
    simpa [φ] using this
  refine ⟨fs, fun n => ?_, fun n => ?_, ?_, ?_⟩
  · -- step 2: `ρ n ⋆ f` is smooth
    rw [hconv]
    exact (hρs n).contDiff_convolution_left _ (hρc n) hf.continuous.locallyIntegrable
  · -- step 3: `ρ n ⋆ f` is `L`-Lipschitz
    exact Submission.cmcs_ls_mollify_lipschitz k (ρ n) f L (hρcont n) (hρs n) (hρ0 n) (hρint n) hf
  · -- step 4: `|f_n x - f x| ≤ L * rOut` for all `x`, and `rOut → 0`
    rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [(hrOut0.const_mul (L : ℝ)).eventually (gt_mem_nhds (by simpa using hε))]
      with n hn x
    have hdist := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := f x) (g := f)
      (by positivity : (0 : ℝ) ≤ L * (φ n).rOut) (hρsupp n) (hρ0 n) (hρint n)
      hf.continuous.aestronglyMeasurable (fun y hy => by
        calc dist (f y) (f x) ≤ L * dist y x := hf.dist_le_mul y x
          _ ≤ L * (φ n).rOut := by gcongr; exact (mem_ball.1 hy).le)
    rw [← hconv] at hdist
    rw [dist_comm]
    exact lt_of_le_of_lt hdist hn
  · -- step 5: `Df_n(x) v = ∫ ρ n t * Df(x - t) v dt`
    have hB1 : ∀ n x v, fderiv ℝ (fs n) x v = ∫ t, ρ n t * fderiv ℝ f (x - t) v := fun n x v =>
      Submission.dor_lmb_fcd_jwc_mollify_fderiv_eq k L f (ρ n) hf (hρc1 n) (hρs n) x v
    have hδ : Tendsto (fun n => (φ n).rOut) atTop (𝓝[>] 0) :=
      tendsto_nhdsWithin_iff.2 ⟨hrOut0, Eventually.of_forall fun n => (φ n).rOut_pos⟩
    -- steps 6-7: for each basis vector `e_i`, `Df_n(x) e_i → Df(x) e_i` for a.e. `x`
    have hDi : ∀ i : Fin k, ∀ᵐ x ∂(volume : Measure (Euclid k)),
        Tendsto (fun n => fderiv ℝ (fs n) x (EuclideanSpace.single i (1 : ℝ))) atTop
          (𝓝 (fderiv ℝ f x (EuclideanSpace.single i (1 : ℝ)))) := by
      intro i
      set g : Euclid k → ℝ := fun s => fderiv ℝ f s (EuclideanSpace.single i (1 : ℝ)) with hg
      have hloc : LocallyIntegrable g (volume : Measure (Euclid k)) := by
        refine (locallyIntegrable_const ((L : ℝ) * ‖EuclideanSpace.single i (1 : ℝ)‖)).mono
          ((measurable_fderiv_apply_const ℝ f _).aestronglyMeasurable)
          (Eventually.of_forall fun s => ?_)
        rw [Real.norm_eq_abs (_ * _), abs_of_nonneg (by positivity)]
        exact (ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hf) (norm_nonneg _))
      -- Lebesgue differentiation: `⨍_{B(x, r)} |g - g x| → 0` as `r → 0`, for a.e. `x`
      filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub volume hloc 1]
        with x hx
      have havg := hx (fun _ => x) (fun n => (φ n).rOut) hδ
        (Eventually.of_forall fun n => mem_closedBall_self (by simpa using (φ n).rOut_pos.le))
      -- `0 ≤ ρ n (x - ·) ≤ 2 ^ d / |B(x, rOut)|`, supported in `B(x, rOut)`, with integral `1`
      have key := tendsto_integral_smul_of_tendsto_average_norm_sub ((2 : ℝ) ^ d) havg
        (g := fun n y => ρ n (x - y))
        (Eventually.of_forall fun n => hloc.integrableOn_isCompact (isCompact_closedBall _ _))
        (tendsto_const_nhds.congr fun n => by
          rw [integral_sub_left_eq_self (ρ n) volume x, hρint n])
        (Eventually.of_forall fun n y hy => by
          have hy' : x - y ∈ ball (0 : Euclid k) (φ n).rOut := hρsupp n hy
          rw [mem_ball, dist_zero_right] at hy'
          rw [mem_closedBall, dist_eq_norm, ← norm_neg, neg_sub]
          exact hy'.le)
        (Eventually.of_forall fun n y => by
          rw [abs_of_nonneg (hρ0 n _), hvol x _ (φ n).rOut_pos.le, hrOut n]
          calc ρ n (x - y) ≤ 1 / ((φ n).rIn ^ d * c) := hρle n _
            _ = 2 ^ d / ((2 * (φ n).rIn) ^ d * c) := by
              rw [mul_pow]
              field_simp)
      refine key.congr fun n => ?_
      rw [hB1, ← integral_sub_left_eq_self (fun y => ρ n (x - y) • g y) volume x]
      simp only [sub_sub_cancel, smul_eq_mul, hg]
    filter_upwards [ae_all_iff.2 hDi] with x hx
    -- step 8: `‖T‖ ≤ ∑ᵢ |T eᵢ|`, so convergence on the basis gives convergence in norm
    have hbound : ∀ T : Euclid k →L[ℝ] ℝ, ‖T‖ ≤ ∑ i, ‖T (EuclideanSpace.single i (1 : ℝ))‖ := by
      intro T
      refine ContinuousLinearMap.opNorm_le_bound T (Finset.sum_nonneg fun i _ => norm_nonneg _)
        fun w => ?_
      have hw : w = ∑ i, w i • EuclideanSpace.single i (1 : ℝ) := by
        conv_lhs => rw [← (EuclideanSpace.basisFun (Fin k) ℝ).sum_repr w]
        simp
      calc ‖T w‖ = ‖∑ i, w i • T (EuclideanSpace.single i (1 : ℝ))‖ := by
            conv_lhs => rw [hw]
            simp [map_sum, map_smul]
        _ ≤ ∑ i, ‖w i • T (EuclideanSpace.single i (1 : ℝ))‖ := norm_sum_le _ _
        _ = ∑ i, ‖w i‖ * ‖T (EuclideanSpace.single i (1 : ℝ))‖ := by simp
        _ ≤ ∑ i, ‖w‖ * ‖T (EuclideanSpace.single i (1 : ℝ))‖ := by
            gcongr with i
            exact PiLp.norm_apply_le w i
        _ = (∑ i, ‖T (EuclideanSpace.single i (1 : ℝ))‖) * ‖w‖ := by
            rw [Finset.sum_mul]; simp [mul_comm]
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun n => norm_nonneg _) (fun n => hbound _) ?_
    have : Tendsto (fun n => ∑ i : Fin k, ‖(fderiv ℝ (fs n) x - fderiv ℝ f x)
        (EuclideanSpace.single i (1 : ℝ))‖) atTop (𝓝 (∑ i : Fin k, (0 : ℝ))) := by
      refine tendsto_finsetSum _ fun i _ => ?_
      have := tendsto_iff_norm_sub_tendsto_zero.1 (hx i)
      simpa using this
    simpa using this
/-- **The Piola identity** (the Jacobian minors are null Lagrangians): for `C²` functions
`g₀, …, g_{r-1}` on `ℝᵏ` and directions `V₀, …, V_r`, the minors
`M_b(y) = det (Dg_c(y) V_{s_b(b')})_{c,b'}` (`s_b = Fin.succAbove b`, so `V_b` is deleted) satisfy
`∑_b (-1)^b DM_b(x) V_b = 0`.  With `G = (g₀, …, g_{r-1})` and the constant determinant form
`θ = dy⁰ ∧ ⋯ ∧ dy^{r-1}` one has `M_b(y) = (G^*θ)(y)(V ∘ s_b)`, so the left side is
`d(G^*θ)(x)(V)`, and `d(G^*θ) = G^*(dθ) = 0` by the naturality of `d` (which is where the symmetry
of `D²G` enters). -/
theorem Submission.dor_lmb_fcd_jwc_piola_identity : ∀ (k r : ℕ) (g : Fin r → Euclid k → ℝ) (V : Fin (r + 1) → Euclid k) (x : Euclid k), (∀ c, ContDiff ℝ 2 (g c)) → ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (fun y => Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c) y (V (b.succAbove b')))) x (V b) = 0 := by
  intro k r g V x hg
  -- Step 1: the map `G = (g₀, …, g_{r-1}) : ℝᵏ → ℝʳ` is `C²`, and `(DG(y) w)_c = Dg_c(y) w`
  set e : (Fin r → ℝ) ≃L[ℝ] Euclid r := (EuclideanSpace.equiv (Fin r) ℝ).symm with he
  set G : Euclid k → Euclid r := fun y => e (fun c => g c y) with hG
  have hGc : ContDiff ℝ 2 G := e.contDiff.comp (contDiff_pi.2 hg)
  have hGd : ∀ y w (c : Fin r), fderiv ℝ G y w c = fderiv ℝ (g c) y w := by
    intro y w c
    have hpi : HasFDerivAt (fun y => fun c => g c y)
        (ContinuousLinearMap.pi fun c => fderiv ℝ (g c) y) y :=
      hasFDerivAt_pi.2 fun c => ((hg c).differentiable (by norm_num) y).hasFDerivAt
    have h := e.hasFDerivAt.comp y hpi
    rw [show G = e ∘ (fun y => fun c => g c y) from rfl, h.fderiv]
    simp [he]
  -- Step 2: the constant determinant form `Θ ≡ θ`, `θ(w) = det (w_b(c))_{c,b}`
  obtain ⟨θ, hθ⟩ := Submission.cmr_cc_det_covector_exists r r id
  set Θ : Euclid r → Covector (Euclid r) r := fun _ => θ with hΘ
  -- Step 3: `dΘ = 0`, since `DΘ = 0` and the alternatization is linear
  have hdΘ : extDeriv Θ (G x) = 0 := by
    simp [extDeriv, hΘ, ← ContinuousAlternatingMap.alternatizeUncurryFinCLM_apply]
  -- Step 4: naturality of `d` gives `d(G^*Θ)(x) = (dΘ)(G x) ∘ DG(x) = 0`
  have hpull := extDeriv_pullback (ω := Θ) (f := G) (x := x) (r := 2) (differentiableAt_const θ)
    hGc.contDiffAt (by simp)
  rw [hdΘ] at hpull
  -- Step 5: the coordinate formula `d(G^*Θ)(x)(V) = ∑_b (-1)^b D[(G^*Θ)(·)(V ∘ s_b)](x) V_b`
  have hβd : DifferentiableAt ℝ (fun y => (Θ (G y)).compContinuousLinearMap (fderiv ℝ G y)) x :=
    (differentiableAt_const θ).continuousAlternatingMapCompContinuousLinearMap
      ((hGc.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num) x)
  have happ := extDeriv_apply hβd V
  rw [hpull] at happ
  -- Step 6: `(G^*Θ)(y)(V ∘ s_b) = M_b(y)` by Steps 1 and 2
  have hβ : ∀ i : Fin (r + 1), (fun y => (Θ (G y)).compContinuousLinearMap (fderiv ℝ G y)
      (i.removeNth V)) = fun y => Matrix.det (Matrix.of fun (c b' : Fin r) =>
        fderiv ℝ (g c) y (V (i.succAbove b'))) := by
    intro i
    funext y
    simp only [hΘ, ContinuousAlternatingMap.compContinuousLinearMap_apply, hθ]
    congr 1
    ext c b'
    simp [Matrix.of_apply, Fin.removeNth, hGd]
  -- Step 7: hence `0 = d(G^*Θ)(x)(V) = ∑_b (-1)^b DM_b(x) V_b`
  simp only [hβ] at happ
  rw [eq_comm] at happ
  simpa [zsmul_eq_mul] using happ

/-- **Integration by parts for Jacobian minors** (formula (∗) of the weak continuity of Jacobian
minors, for `C²` maps): for `C²` functions `g₀, …, g_r` on `ℝᵏ`, directions `V₀, …, V_r` and a
compactly supported `C¹` function `ψ`, with `A = (Dg_c V_b)_{c,b}` and `M_b` the minor of `A`
without row `0` and column `b`, `∫ ψ det A = −Σ_b (−1)^b ∫ (Dψ V_b) g₀ M_b`.  Laplace expansion
along row `0`, the product rule for `F_b = ψ g₀ M_b` and the Piola identity
`Σ_b (−1)^b ∂_{V_b} M_b = 0` give `ψ det A = Σ_b (−1)^b ∂_{V_b} F_b − Σ_b (−1)^b (∂_{V_b} ψ) g₀ M_b`
pointwise, and `∫ ∂_W F = 0` for every compactly supported `C¹` function `F` (integration by
parts of the Lipschitz functions `1` and `F`). -/
theorem Submission.dor_lmb_fcd_jwc_smooth_minor_ibp : ∀ (k r : ℕ) (g : Fin (r + 1) → Euclid k → ℝ) (V : Fin (r + 1) → Euclid k) (ψ : Euclid k → ℝ), (∀ c, ContDiff ℝ 2 (g c)) → ContDiff ℝ 1 ψ → HasCompactSupport ψ → ∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) = -∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * ∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))) := by
  intro k r g V ψ hg hψ hψs
  -- Step 2: the entries `Dg_c(·)W` are `C¹` (`g_c` is `C²`), hence so is every determinant of
  -- such entries (Leibniz formula), in particular every minor `M_b`
  have hdetC1 : ∀ {m : ℕ} (A : Euclid k → Fin m → Fin m → ℝ),
      (∀ i j, ContDiff ℝ 1 (fun x => A x i j)) →
      ContDiff ℝ 1 (fun x => Matrix.det (Matrix.of (A x))) := by
    intro m A hA
    have hLeib : (fun x => Matrix.det (Matrix.of (A x))) =
        fun x => ∑ σ : Equiv.Perm (Fin m), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ i, A x (σ i) i := by
      funext x
      rw [Matrix.det_apply]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [Units.smul_def, zsmul_eq_mul]
      simp [Matrix.of_apply]
    rw [hLeib]
    exact ContDiff.sum fun σ _ => contDiff_const.mul (contDiff_prod fun i _ => hA _ _)
  have hentry : ∀ c (W : Euclid k), ContDiff ℝ 1 (fun x => fderiv ℝ (g c) x W) := fun c W =>
    ((hg c).fderiv_right (by norm_num)).clm_apply contDiff_const
  set M : Fin (r + 1) → Euclid k → ℝ := fun b x => Matrix.det (Matrix.of fun (c b' : Fin r) =>
    fderiv ℝ (g c.succ) x (V (b.succAbove b')))
  have hMC1 : ∀ b, ContDiff ℝ 1 (M b) := fun b =>
    hdetC1 (fun x c b' => fderiv ℝ (g c.succ) x (V (b.succAbove b'))) fun c b' => hentry _ _
  -- `F_b = ψ g₀ M_b` is `C¹` with compact support
  have hFC1 : ∀ b, ContDiff ℝ 1 (fun y => ψ y * g 0 y * M b y) := fun b =>
    (hψ.mul ((hg 0).of_le (by norm_num))).mul (hMC1 b)
  have hFs : ∀ b, HasCompactSupport (fun y => ψ y * g 0 y * M b y) := fun b =>
    hψs.mul_right.mul_right
  -- Step 3: product rule for `∂_{V_b} F_b`
  have hdiff : ∀ b x, fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b) =
      fderiv ℝ ψ x (V b) * g 0 x * M b x + ψ x * fderiv ℝ (g 0) x (V b) * M b x +
        ψ x * g 0 x * fderiv ℝ (M b) x (V b) := by
    intro b x
    have hψd : DifferentiableAt ℝ ψ x := hψ.differentiable (by norm_num) x
    have hgd : DifferentiableAt ℝ (g 0) x := (hg 0).differentiable (by norm_num) x
    have hMd : DifferentiableAt ℝ (M b) x := (hMC1 b).differentiable (by norm_num) x
    have h : HasFDerivAt (fun y => ψ y * g 0 y * M b y) _ x :=
      (hψd.hasFDerivAt.mul hgd.hasFDerivAt).mul hMd.hasFDerivAt
    rw [h.fderiv]
    simp only [add_apply, smul_apply, smul_eq_mul, Pi.mul_apply]
    ring
  -- Steps 1, 4, 5: Laplace expansion along row `0` and the Piola identity give, pointwise,
  -- `ψ det A = Σ_b (−1)^b ∂_{V_b} F_b − Σ_b (−1)^b (∂_{V_b} ψ) g₀ M_b`
  have hpt : ∀ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) =
      ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b) -
        ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * (fderiv ℝ ψ x (V b) * g 0 x * M b x) := by
    intro x
    have hp : ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (M b) x (V b) = 0 :=
      Submission.dor_lmb_fcd_jwc_piola_identity k r (fun c => g c.succ) V x fun c => hg c.succ
    simp_rw [hdiff]
    have halg : ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * (fderiv ℝ ψ x (V b) * g 0 x * M b x +
          ψ x * fderiv ℝ (g 0) x (V b) * M b x + ψ x * g 0 x * fderiv ℝ (M b) x (V b)) -
        ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * (fderiv ℝ ψ x (V b) * g 0 x * M b x) =
        ψ x * ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (g 0) x (V b) * M b x +
          ψ x * g 0 x * ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (M b) x (V b) := by
      rw [← Finset.sum_sub_distrib, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun b _ => by ring
    rw [halg, hp, mul_zero, add_zero, Matrix.det_succ_row_zero]
    rfl
  -- Step 6: `∫ ∂_W F = 0` for `C¹` compactly supported `F` (integration by parts of the
  -- Lipschitz functions `1` and `F`)
  have hIBP0 : ∀ F : Euclid k → ℝ, ContDiff ℝ 1 F → HasCompactSupport F → ∀ W,
      ∫ x, fderiv ℝ F x W = 0 := by
    intro F hF hFs W
    obtain ⟨C, hFL⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hFs hF (by norm_num)
    have h := LipschitzWith.integral_lineDeriv_mul_eq (μ := (volume : Measure (Euclid k)))
      (LipschitzWith.const (1 : ℝ)) hFL hFs (-W)
    have h0 : ∀ x : Euclid k, lineDeriv ℝ (fun _ : Euclid k => (1 : ℝ)) x (-W) = 0 := by
      intro x
      rw [(differentiableAt_const (1 : ℝ)).lineDeriv_eq_fderiv]
      simp
    have h1 : ∀ x, lineDeriv ℝ F x W = fderiv ℝ F x W := fun x =>
      (hF.differentiable (by norm_num) x).lineDeriv_eq_fderiv
    simp only [h0, zero_mul, integral_zero, neg_neg, mul_one, h1] at h
    exact h.symm
  -- Step 7: every term is continuous with compact support, hence integrable; integrate
  have hi1 : ∀ b : Fin (r + 1), Integrable (fun x => (-1 : ℝ) ^ (b : ℕ) *
      fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b)) := fun b =>
    ((((hFC1 b).continuous_fderiv (by norm_num)).clm_apply
      continuous_const).integrable_of_hasCompactSupport ((hFs b).fderiv_apply ℝ (V b))).const_mul _
  have hi2 : ∀ b : Fin (r + 1), Integrable (fun x => (-1 : ℝ) ^ (b : ℕ) *
      (fderiv ℝ ψ x (V b) * g 0 x * M b x)) := fun b =>
    (((((hψ.continuous_fderiv (by norm_num)).clm_apply continuous_const).mul
      (hg 0).continuous).mul (hMC1 b).continuous).integrable_of_hasCompactSupport
      ((hψs.fderiv_apply ℝ (V b)).mul_right.mul_right)).const_mul _
  rw [integral_congr_ae (Eventually.of_forall hpt),
    integral_sub (integrable_finsetSum _ fun b _ => hi1 b)
      (integrable_finsetSum _ fun b _ => hi2 b),
    integral_finsetSum _ fun b _ => hi1 b, integral_finsetSum _ fun b _ => hi2 b]
  have hz : ∑ b : Fin (r + 1), ∫ x, (-1 : ℝ) ^ (b : ℕ) *
      fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b) = 0 :=
    Finset.sum_eq_zero fun b _ => by rw [integral_const_mul, hIBP0 _ (hFC1 b) (hFs b) _, mul_zero]
  rw [hz, zero_sub]
  simp only [integral_const_mul]
  rfl

/-- **Integration by parts for Jacobian minors of Lipschitz maps** (the step "`(∗)` holds for
Lipschitz `v`" in the weak continuity of Jacobian minors): for `L`-Lipschitz `g₀, …, g_r` on `ℝᵏ`,
vectors `V₀, …, V_r` and `ψ ∈ C¹_c(ℝᵏ)`,
`∫ ψ det A = −Σ_b (−1)^b ∫ ∂_{V_b}ψ · g₀ · M_b`, where `A = (Dg_c V_b)_{c,b}` and `M_b` is the minor
`det (Dg_{c+1} V_{s_b(b')})_{c,b'}`, `s_b = b.succAbove`.  Mollify every `g_c`: `C^∞`, `L`-Lipschitz
`g^n_c → g_c` uniformly with `Dg^n_c → Dg_c` a.e.  The identity holds for every `n` (smooth case);
the determinants converge a.e. and are bounded by `(r+1)! (L Σ_b ‖V_b‖)^(r+1)`, resp.
`r! (L Σ_b' ‖V_{s_b(b')}‖)^r`, so both sides converge by dominated convergence (on the right with
`|g^n_0| ≤ |g_0| + 1` for large `n`), and the limits agree. -/
theorem Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp : ∀ (k r : ℕ) (L : NNReal) (g : Fin (r + 1) → Euclid k → ℝ) (V : Fin (r + 1) → Euclid k) (ψ : Euclid k → ℝ), (∀ c, LipschitzWith L (g c)) → ContDiff ℝ 1 ψ → HasCompactSupport ψ → ∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) = -∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * ∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))) := by
  intro k r L g V ψ hg hψ hψs
  -- step 1: smooth `L`-Lipschitz approximants `fs c n` of every component `g c`
  choose fs hfs_smooth hfs_lip hfs_unif hfs_ae using
    fun c => Submission.dor_lmb_fcd_jwc_lipschitz_smooth_approx k L (g c) (hg c)
  -- step 2: the identity for the smooth maps `fs · n`
  have hid := fun n => Submission.dor_lmb_fcd_jwc_smooth_minor_ibp k r (fun c => fs c n) V ψ
    (fun c => (hfs_smooth c n).of_le (by simp)) hψ hψs
  -- step 3: off a null set all derivatives converge, hence so do the entries and determinants
  have hae : ∀ᵐ x ∂(volume : Measure (Euclid k)), ∀ c,
      Tendsto (fun n => fderiv ℝ (fs c n) x) atTop (𝓝 (fderiv ℝ (g c) x)) := ae_all_iff.2 hfs_ae
  have hdet_lim : ∀ {m : ℕ} (σ : Fin m → Fin (r + 1)) (W : Fin m → Euclid k) (x : Euclid k),
      (∀ c, Tendsto (fun n => fderiv ℝ (fs c n) x) atTop (𝓝 (fderiv ℝ (g c) x))) →
      Tendsto (fun n => Matrix.det (Matrix.of fun (c b : Fin m) => fderiv ℝ (fs (σ c) n) x (W b)))
        atTop (𝓝 (Matrix.det (Matrix.of fun (c b : Fin m) => fderiv ℝ (g (σ c)) x (W b)))) := by
    intro m σ W x hx
    have hM : Tendsto (fun n => (Matrix.of fun (c b : Fin m) => fderiv ℝ (fs (σ c) n) x (W b)))
        atTop (𝓝 (Matrix.of fun (c b : Fin m) => fderiv ℝ (g (σ c)) x (W b))) := by
      refine tendsto_pi_nhds.2 fun c => tendsto_pi_nhds.2 fun b => ?_
      exact ((ContinuousLinearMap.apply ℝ ℝ (W b)).continuous.tendsto _).comp (hx (σ c))
    exact ((continuous_id.matrix_det).tendsto _).comp hM
  -- step 4: the bound `B` of the full determinants and the integrability of `ψ`
  set B : ℝ := ((r + 1).factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ (r + 1)
  have hψc : Continuous ψ := hψ.continuous
  have hψi : Integrable ψ := hψc.integrable_of_hasCompactSupport hψs
  -- step 5: the left side converges, dominated by `B |ψ|`
  have hL : Tendsto
      (fun n => ∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (fs c n) x (V b)))
      atTop (𝓝 (∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))) := by
    refine tendsto_integral_of_dominated_convergence (fun x => B * ‖ψ x‖) (fun n => ?_)
      (hψi.norm.const_mul B) (fun n => Eventually.of_forall fun x => ?_) ?_
    · exact hψc.aestronglyMeasurable.mul
        (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L (fun c => fs c n) V
          (fun c => hfs_lip c n)).1.aestronglyMeasurable
    · have h := (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L (fun c => fs c n) V
        (fun c => hfs_lip c n)).2 x
      rw [norm_mul, Real.norm_eq_abs (Matrix.det _), mul_comm]
      exact mul_le_mul_of_nonneg_right h (norm_nonneg _)
    · filter_upwards [hae] with x hx
      exact tendsto_const_nhds.mul (hdet_lim id V x hx)
  -- step 6: each term of the right side converges, dominated by `Br |∂_{V_b}ψ| (|g 0| + 1)`
  have hR : ∀ b : Fin (r + 1), Tendsto (fun n => ∫ x, fderiv ℝ ψ x (V b) * fs 0 n x *
      Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (fs c.succ n) x (V (b.succAbove b'))))
      atTop (𝓝 (∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det
        (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))))) := by
    intro b
    set Br : ℝ := (r.factorial : ℝ) * ((L : ℝ) * ∑ b', ‖V (b.succAbove b')‖) ^ r
    have hdψc : Continuous (fun x => fderiv ℝ ψ x (V b)) :=
      (hψ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdψs : HasCompactSupport (fun x => fderiv ℝ ψ x (V b)) := hψs.fderiv_apply (𝕜 := ℝ) (V b)
    have hwi : Integrable (fun x => Br * (‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1))) := by
      refine Integrable.const_mul ?_ _
      exact Continuous.integrable_of_hasCompactSupport
        (hdψc.norm.mul ((hg 0).continuous.norm.add continuous_const)) hdψs.norm.mul_right
    refine tendsto_integral_filter_of_dominated_convergence
      (fun x => Br * (‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1)))
      (Eventually.of_forall fun n => ?_) ?_ hwi ?_
    · exact (hdψc.mul (hfs_smooth 0 n).continuous).aestronglyMeasurable.mul
        (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L (fun c => fs c.succ n)
          (fun b' => V (b.succAbove b')) (fun c => hfs_lip c.succ n)).1.aestronglyMeasurable
    · -- `|fs 0 n| ≤ |g 0| + 1` once `fs 0 n` is uniformly `1`-close to `g 0`
      obtain ⟨N, hN⟩ :=
        (Metric.tendstoUniformly_iff.1 (hfs_unif 0) 1 one_pos).exists_forall_of_atTop
      refine eventually_atTop.2 ⟨N, fun n hn => Eventually.of_forall fun x => ?_⟩
      have h1 : ‖fs 0 n x‖ ≤ ‖g 0 x‖ + 1 := by
        have := hN n hn x
        rw [dist_comm, dist_eq_norm] at this
        have := norm_le_insert' (fs 0 n x) (g 0 x)
        linarith
      have h2 := (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L (fun c => fs c.succ n)
        (fun b' => V (b.succAbove b')) (fun c => hfs_lip c.succ n)).2 x
      rw [norm_mul, norm_mul, Real.norm_eq_abs (Matrix.det _)]
      calc ‖fderiv ℝ ψ x (V b)‖ * ‖fs 0 n x‖ * |Matrix.det _|
          ≤ ‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1) * Br := by gcongr
        _ = Br * (‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1)) := by ring
    · filter_upwards [hae] with x hx
      refine (tendsto_const_nhds.mul ((hfs_unif 0).tendsto_at x)).mul ?_
      exact hdet_lim Fin.succ (fun b' => V (b.succAbove b')) x hx
  have hRall : Tendsto (fun n => -∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) *
      ∫ x, fderiv ℝ ψ x (V b) * fs 0 n x * Matrix.det
        (Matrix.of fun (c b' : Fin r) => fderiv ℝ (fs c.succ n) x (V (b.succAbove b'))))
      atTop (𝓝 (-∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * ∫ x, fderiv ℝ ψ x (V b) * g 0 x *
        Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))))) :=
    Tendsto.neg (tendsto_finsetSum _ fun b _ => (hR b).const_mul _)
  -- step 7: both sides of step 2 agree for every `n`, so their limits agree
  exact tendsto_nhds_unique hL (hRall.congr fun n => (hid n).symm)
/-- **Weak-* convergence against `L¹` test functions** (density step of the weak continuity of
Jacobian minors): if `|F_j|, |F| ≤ C` and `∫ ψ F_j → ∫ ψ F` for every `C^∞` compactly supported
`ψ`, then `∫ φ F_j → ∫ φ F` for every integrable `φ`.  `C_c^∞` is dense in `L¹`: by
`MemLp.induction_dense` it suffices to approximate `c 1_s` with `μ(s) < ∞`; regularity gives
`K ⊆ s ⊆ U`, `K` compact, `U` open, `μ(U \ K)` small, and `c χ` works for a smooth Urysohn
function `χ` (`χ = 1` exactly on `K`, `support χ = U ∩ B_R(0)`).  (Mathlib's
`MemLp.exist_eLpNorm_sub_le` is outside the import closure.)  For `ε > 0` take such `ψ` with
`∫ |φ − ψ| ≤ η = ε/(4C + 1)`; then `|∫ φ F_j − ∫ φ F| ≤ 2Cη + |∫ ψ F_j − ∫ ψ F| < ε` for large
`j`. -/
theorem Submission.dor_lmb_fcd_jwc_weak_star_l1_upgrade : ∀ (k : ℕ) (C : ℝ) (Fs : ℕ → Euclid k → ℝ) (F : Euclid k → ℝ), (∀ j, AEStronglyMeasurable (Fs j) (volume : Measure (Euclid k))) → AEStronglyMeasurable F (volume : Measure (Euclid k)) → (∀ j x, |Fs j x| ≤ C) → (∀ x, |F x| ≤ C) → (∀ ψ : Euclid k → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ → Tendsto (fun j => ∫ x, ψ x * Fs j x) atTop (𝓝 (∫ x, ψ x * F x))) → ∀ φ : Euclid k → ℝ, Integrable φ → Tendsto (fun j => ∫ x, φ x * Fs j x) atTop (𝓝 (∫ x, φ x * F x)) := by
  intro k C Fs F hFs hF hFsb hFb hconv φ hφ
  have hC : 0 ≤ C := (abs_nonneg _).trans (hFb 0)
  -- step 1: `C_c^∞` is dense in `L¹`; by `MemLp.induction_dense` only `c 1_s` needs approximating
  have hdense : ∀ {ε : ℝ≥0∞}, ε ≠ 0 → ∃ ψ : Euclid k → ℝ,
      eLpNorm (φ - ψ) 1 (volume : Measure (Euclid k)) ≤ ε ∧
        (ContDiff ℝ (⊤ : ℕ∞) ψ ∧ HasCompactSupport ψ) := by
    intro ε hε
    refine MemLp.induction_dense ENNReal.one_ne_top
      (fun g => ContDiff ℝ (⊤ : ℕ∞) g ∧ HasCompactSupport g) ?_ ?_
      (memLp_one_iff_integrable.2 hφ) hε
    · intro c s hs hμs ε' hε'
      -- `K ⊆ s ⊆ U` with `μ(U \ s), μ(s \ K) < δ/2`, `δ = ε'/‖c‖`
      set δ : ℝ≥0∞ := ε' / ‖c‖ₑ with hδ
      have hδ0 : δ ≠ 0 := by
        rw [hδ, Ne, ENNReal.div_eq_zero_iff, not_or]
        exact ⟨hε', enorm_ne_top⟩
      have hδ2 : δ / 2 ≠ 0 := (ENNReal.half_pos hδ0).ne'
      obtain ⟨K, hKs, hKc, hK⟩ := hs.exists_isCompact_sdiff_lt hμs.ne hδ2
      obtain ⟨U, hsU, hUo, -, hU⟩ := hs.exists_isOpen_sdiff_lt hμs.ne hδ2
      -- smooth Urysohn function `χ`: `χ = 1` on `K`, `support χ = U ∩ B_R(0)`, `0 ≤ χ ≤ 1`
      obtain ⟨R, hR⟩ := hKc.isBounded.subset_ball (0 : Euclid k)
      obtain ⟨χ, hχd, hχr, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := (⊤ : ℕ∞))
        (hUo.inter isOpen_ball) hKc.isClosed (subset_inter (hKs.trans hsU) hR)
      have hχc : HasCompactSupport χ := by
        refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid k) R) (fun x hx => ?_)
        rw [← notMem_support, hχs]
        exact fun h => hx (ball_subset_closedBall h.2)
      refine ⟨fun x => c * χ x, ?_, contDiff_const.mul hχd, hχc.mul_left⟩
      -- `|c χ − c 1_s| ≤ |c| 1_{U \ K}`, so `‖c χ − c 1_s‖₁ ≤ ‖c‖ μ(U \ K) ≤ ‖c‖ δ ≤ ε'`
      have hle : ∀ x, ‖((fun x => c * χ x) - s.indicator fun _ => c) x‖ ≤
          ‖(U \ K).indicator (fun _ => c) x‖ := by
        intro x
        obtain ⟨h0, h1⟩ := hχr (mem_range_self x)
        simp only [Pi.sub_apply, Real.norm_eq_abs]
        by_cases hxK : x ∈ K
        · rw [(hχ1 x).1 hxK, indicator_of_mem (hKs hxK)]
          simp
        by_cases hxU : x ∈ U
        · rw [indicator_of_mem (show x ∈ U \ K from ⟨hxU, hxK⟩)]
          by_cases hxs : x ∈ s
          · rw [indicator_of_mem hxs, show c * χ x - c = c * (χ x - 1) by ring, abs_mul]
            exact mul_le_of_le_one_right (abs_nonneg c) (by rw [abs_le]; constructor <;> linarith)
          · rw [indicator_of_notMem hxs, sub_zero, abs_mul]
            exact mul_le_of_le_one_right (abs_nonneg c) (by rw [abs_le]; constructor <;> linarith)
        · have hχ0 : χ x = 0 := by
            rw [← notMem_support, hχs]
            exact fun h => hxU h.1
          rw [hχ0, indicator_of_notMem (fun h => hxU (hsU h))]
          simp
      calc eLpNorm ((fun x => c * χ x) - s.indicator fun _ => c) 1 volume
          ≤ eLpNorm ((U \ K).indicator fun _ => c) 1 volume :=
            eLpNorm_mono (((contDiff_const.mul hχd).continuous.aestronglyMeasurable).sub
              (aestronglyMeasurable_const.indicator hs)) hle
        _ = ‖c‖ₑ * volume (U \ K) := by
          rw [eLpNorm_indicator_const (hUo.measurableSet.diff hKc.isClosed.measurableSet).nullMeasurableSet
            one_ne_zero ENNReal.one_ne_top]
          simp
        _ ≤ ‖c‖ₑ * δ := by
          gcongr
          calc volume (U \ K) ≤ volume ((U \ s) ∪ (s \ K)) := by
                refine measure_mono fun x hx => ?_
                by_cases hxs : x ∈ s
                · exact Or.inr ⟨hxs, hx.2⟩
                · exact Or.inl ⟨hx.1, hxs⟩
            _ ≤ volume (U \ s) + volume (s \ K) := measure_union_le _ _
            _ ≤ δ / 2 + δ / 2 := add_le_add hU.le hK.le
            _ = δ := ENNReal.add_halves δ
        _ ≤ ε' := ENNReal.mul_div_le
    · rintro f g ⟨hf1, hf2⟩ ⟨hg1, hg2⟩
      exact ⟨hf1.add hg1, hf2.add hg2⟩
  -- step 2: `|∫ θ G| ≤ C ∫ |θ|` for integrable `θ` and `|G| ≤ C`
  have hint : ∀ θ : Euclid k → ℝ, Integrable θ → ∀ G : Euclid k → ℝ,
      AEStronglyMeasurable G (volume : Measure (Euclid k)) → (∀ x, |G x| ≤ C) →
      Integrable (fun x => θ x * G x) ∧ |∫ x, θ x * G x| ≤ C * ∫ x, ‖θ x‖ := by
    intro θ hθ G hG hGb
    refine ⟨hθ.mul_bdd hG (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact hGb x), ?_⟩
    calc |∫ x, θ x * G x| = ‖∫ x, θ x * G x‖ := (Real.norm_eq_abs _).symm
      _ ≤ ∫ x, C * ‖θ x‖ := by
          refine norm_integral_le_of_norm_le (hθ.norm.const_mul C) (Eventually.of_forall fun x => ?_)
          rw [norm_mul, Real.norm_eq_abs (G x), mul_comm]
          exact mul_le_mul_of_nonneg_right (hGb x) (norm_nonneg _)
      _ = C * ∫ x, ‖θ x‖ := integral_const_mul _ _
  -- step 3: `ψ ∈ C_c^∞` with `∫ |φ − ψ| ≤ η = ε/(4C + 1)`, and `N` from the convergence on `ψ`
  rw [Metric.tendsto_atTop]
  intro ε hε
  set η : ℝ := ε / (4 * C + 1) with hη
  have hηpos : 0 < η := by positivity
  obtain ⟨ψ, hψε, hψs, hψc⟩ := hdense (ENNReal.ofReal_pos.2 hηpos).ne'
  have hψi : Integrable ψ := hψs.continuous.integrable_of_hasCompactSupport hψc
  have hdiff : ∫ x, ‖(φ - ψ) x‖ ≤ η := by
    have h1 := integral_norm_eq_lintegral_enorm (μ := (volume : Measure (Euclid k)))
      (hφ.sub hψi).aestronglyMeasurable
    rw [h1, ← eLpNorm_one_eq_lintegral_enorm]
    · exact ENNReal.toReal_le_of_le_ofReal hηpos.le hψε
    · exact (hφ.sub hψi).aestronglyMeasurable
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 (hconv ψ hψs hψc) (ε / 2) (by positivity)
  -- step 4: three-term estimate `|∫ φ F_j − ∫ φ F| ≤ 2Cη + |∫ ψ F_j − ∫ ψ F| < ε` for `j ≥ N`
  refine ⟨N, fun j hj => ?_⟩
  have h1 := hint (φ - ψ) (hφ.sub hψi) (Fs j) (hFs j) (hFsb j)
  have h2 := hint (φ - ψ) (hφ.sub hψi) F hF hFb
  have h3 := hint ψ hψi (Fs j) (hFs j) (hFsb j)
  have h4 := hint ψ hψi F hF hFb
  have e1 : ∫ x, φ x * Fs j x = (∫ x, (φ - ψ) x * Fs j x) + ∫ x, ψ x * Fs j x := by
    rw [← integral_add h1.1 h3.1]
    congr 1; funext x; simp only [Pi.sub_apply]; ring
  have e2 : ∫ x, φ x * F x = (∫ x, (φ - ψ) x * F x) + ∫ x, ψ x * F x := by
    rw [← integral_add h2.1 h4.1]
    congr 1; funext x; simp only [Pi.sub_apply]; ring
  have hNj := hN j hj
  rw [Real.dist_eq] at hNj ⊢
  rw [e1, e2]
  have hCη : C * η < ε / 4 := by
    rw [hη, mul_div_assoc']
    rw [div_lt_div_iff₀ (by positivity) (by norm_num)]
    nlinarith
  have hA := h1.2.trans (mul_le_mul_of_nonneg_left hdiff hC)
  have hB := h2.2.trans (mul_le_mul_of_nonneg_left hdiff hC)
  have key : ∀ a1 b1 a2 b2 : ℝ, |(a1 + b1) - (a2 + b2)| ≤ |a1| + |a2| + |b1 - b2| := by
    intro a1 b1 a2 b2
    calc |(a1 + b1) - (a2 + b2)| = |(a1 - a2) + (b1 - b2)| := by ring_nf
      _ ≤ |a1 - a2| + |b1 - b2| := abs_add_le _ _
      _ ≤ |a1| + |a2| + |b1 - b2| := by
          have := abs_sub a1 a2
          linarith
  have := key (∫ x, (φ - ψ) x * Fs j x) (∫ x, ψ x * Fs j x) (∫ x, (φ - ψ) x * F x) (∫ x, ψ x * F x)
  linarith

/-- **Weak continuity of Jacobian minors** (null Lagrangians; Reshetnyak 1967, Ball 1977): if the
`L`-Lipschitz `gʲ_c` converge uniformly to the `L`-Lipschitz `g_c` on `ℝᵏ` (`c < r`), then
`∫ φ det(Dgʲ_c V_b) → ∫ φ det(Dg_c V_b)` for every `φ ∈ L¹`.  Induction on `r`; for `r = 0` both
determinants are `1`.  For `r + 1` the minors are measurable and bounded by
`(r+1)! (L Σ_b ‖V_b‖)^{r+1}`, so by the weak-* to `L¹` upgrade it suffices to take `φ = ψ ∈ C^∞_c`.
Integration by parts in the first row writes `∫ ψ det(Dg_c V_b)` as
`−Σ_b (−1)^b ∫ ∂_{V_b}ψ · g₀ · M_b`, `M_b` the minor of the rows `c ≥ 1` and the columns `≠ b`.
Split `gʲ₀ = (gʲ₀ − g₀) + g₀`: the first part is at most
`r! (L Σ_{b'} ‖V_{b'}‖)^r sup |gʲ₀ − g₀| ∫ |∂_{V_b}ψ| → 0`, and the second converges by the
induction hypothesis with the continuous compactly supported weight `∂_{V_b}ψ · g₀`. -/
theorem Submission.dor_lmb_fcd_jwc_minor_weak_continuity : ∀ (k r : ℕ) (L : NNReal) (gs : ℕ → Fin r → Euclid k → ℝ) (g : Fin r → Euclid k → ℝ) (V : Fin r → Euclid k) (φ : Euclid k → ℝ), Integrable φ → (∀ j c, LipschitzWith L (gs j c)) → (∀ c, LipschitzWith L (g c)) → (∀ c, TendstoUniformly (fun j => gs j c) (g c) atTop) → Tendsto (fun j => ∫ x, φ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (gs j c) x (V b))) atTop (𝓝 (∫ x, φ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))) := by
  intro k r
  induction r with
  | zero =>
    -- the empty determinant is `1`
    intro L gs g V φ hφ hgs hg hU
    simp only [Matrix.det_isEmpty, mul_one]
    exact tendsto_const_nhds
  | succ r ih =>
    intro L gs g V φ hφ hgs hg hU
    -- Step 2: the minors are bounded, so it suffices to test against `ψ ∈ C^∞_c`
    have hb := fun (G : Fin (r + 1) → Euclid k → ℝ) (hG : ∀ c, LipschitzWith L (G c)) =>
      Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L G V hG
    refine Submission.dor_lmb_fcd_jwc_weak_star_l1_upgrade k
      (((r + 1).factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ (r + 1))
      (fun j x => Matrix.det (Matrix.of fun c b => fderiv ℝ (gs j c) x (V b)))
      (fun x => Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))
      (fun j => (hb (gs j) (hgs j)).1.aestronglyMeasurable) (hb g hg).1.aestronglyMeasurable
      (fun j => (hb (gs j) (hgs j)).2) (hb g hg).2 ?_ φ hφ
    intro ψ hψ hψs
    -- Step 3: integrate by parts in the first row
    have hψ1 : ContDiff ℝ 1 ψ := hψ.of_le (by exact_mod_cast le_top)
    have hIBPj := fun j =>
      Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp k r L (gs j) V ψ (hgs j) hψ1 hψs
    have hIBP := Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp k r L g V ψ hg hψ1 hψs
    simp only [hIBPj, hIBP]
    refine Tendsto.neg (tendsto_finsetSum _ fun b _ => Tendsto.const_mul _ ?_)
    -- the minors `Mʲ_b`, `M_b` and their bound
    set Mj : ℕ → Euclid k → ℝ := fun j x => Matrix.det (Matrix.of fun (c b' : Fin r) =>
      fderiv ℝ (gs j c.succ) x (V (b.succAbove b'))) with hMj
    set M : Euclid k → ℝ := fun x => Matrix.det (Matrix.of fun (c b' : Fin r) =>
      fderiv ℝ (g c.succ) x (V (b.succAbove b'))) with hM
    set Br : ℝ := (r.factorial : ℝ) * ((L : ℝ) * ∑ b', ‖V (b.succAbove b')‖) ^ r with hBr
    have hbr := fun j => Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L
      (fun c => gs j c.succ) (fun b' => V (b.succAbove b')) (fun c => hgs j c.succ)
    -- Step 4: the weight `θ_b = ∂_{V_b}ψ · g₀` is continuous with compact support
    have hdψc : Continuous (fun x => fderiv ℝ ψ x (V b)) :=
      (hψ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdψs : HasCompactSupport (fun x => fderiv ℝ ψ x (V b)) :=
      (hψs.fderiv (𝕜 := ℝ)).comp_left (g := fun T : Euclid k →L[ℝ] ℝ => T (V b)) (by simp)
    have hdψi : Integrable (fun x => fderiv ℝ ψ x (V b)) :=
      hdψc.integrable_of_hasCompactSupport hdψs
    have hθi : Integrable (fun x => fderiv ℝ ψ x (V b) * g 0 x) :=
      (hdψc.mul (hg 0).continuous).integrable_of_hasCompactSupport hdψs.mul_right
    -- Step 6: the induction hypothesis with the weight `θ_b`
    have hih := ih L (fun j c => gs j c.succ) (fun c => g c.succ) (fun b' => V (b.succAbove b'))
      (fun x => fderiv ℝ ψ x (V b) * g 0 x) hθi (fun j c => hgs j c.succ) (fun c => hg c.succ)
      (fun c => hU c.succ)
    -- Step 5: `|∫ ∂_{V_b}ψ (gʲ₀ − g₀) Mʲ_b| ≤ Br sup |gʲ₀ − g₀| ∫ |∂_{V_b}ψ| → 0`
    have herr : Tendsto (fun j => ∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x) atTop
        (𝓝 0) := by
      rw [Metric.tendsto_atTop]
      intro ε hε
      set K : ℝ := Br * (∫ x, ‖fderiv ℝ ψ x (V b)‖) + 1 with hK
      have hBr0 : 0 ≤ Br := by positivity
      have hK0 : 0 < K := by
        have : 0 ≤ ∫ x, ‖fderiv ℝ ψ x (V b)‖ := integral_nonneg fun _ => norm_nonneg _
        positivity
      have hδ : 0 < ε / (2 * K) := by positivity
      obtain ⟨N, hN⟩ :=
        (Metric.tendstoUniformly_iff.1 (hU 0) (ε / (2 * K)) hδ).exists_forall_of_atTop
      refine ⟨N, fun j hj => ?_⟩
      rw [Real.dist_eq, sub_zero]
      have hbd : ∀ x, ‖fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x‖ ≤
          (ε / (2 * K) * Br) * ‖fderiv ℝ ψ x (V b)‖ := by
        intro x
        have h1 : |gs j 0 x - g 0 x| ≤ ε / (2 * K) := by
          have := hN j hj x
          rw [dist_comm, Real.dist_eq] at this
          exact this.le
        have h2 : |Mj j x| ≤ Br := (hbr j).2 x
        rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_mul]
        calc |fderiv ℝ ψ x (V b)| * |gs j 0 x - g 0 x| * |Mj j x|
            ≤ |fderiv ℝ ψ x (V b)| * (ε / (2 * K)) * Br := by gcongr
          _ = (ε / (2 * K) * Br) * |fderiv ℝ ψ x (V b)| := by ring
      calc |∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x|
          = ‖∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x‖ := (Real.norm_eq_abs _).symm
        _ ≤ ∫ x, (ε / (2 * K) * Br) * ‖fderiv ℝ ψ x (V b)‖ :=
            norm_integral_le_of_norm_le (hdψi.norm.const_mul _) (Eventually.of_forall hbd)
        _ = (ε / (2 * K)) * (Br * ∫ x, ‖fderiv ℝ ψ x (V b)‖) := by
            rw [integral_const_mul]; ring
        _ ≤ (ε / (2 * K)) * K := by gcongr; linarith
        _ = ε / 2 := by field_simp
        _ < ε := by linarith
    -- Step 7: `∫ ∂_{V_b}ψ gʲ₀ Mʲ_b = ∫ ∂_{V_b}ψ (gʲ₀ − g₀) Mʲ_b + ∫ θ_b Mʲ_b → 0 + ∫ θ_b M_b`
    have hsum := herr.add hih
    rw [zero_add] at hsum
    refine hsum.congr' (Eventually.of_forall fun j => ?_)
    have i2 : Integrable (fun x => fderiv ℝ ψ x (V b) * g 0 x * Mj j x) := by
      have h1 : Integrable (fun x => Mj j x * (fderiv ℝ ψ x (V b) * g 0 x)) :=
        Integrable.bdd_mul (c := Br) hθi (hbr j).1.aestronglyMeasurable
          (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact (hbr j).2 x)
      exact h1.congr (Eventually.of_forall fun x => by simp only; ring)
    have i1 : Integrable (fun x => fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x) := by
      have hgj : Integrable (fun x => fderiv ℝ ψ x (V b) * gs j 0 x) :=
        (hdψc.mul (hgs j 0).continuous).integrable_of_hasCompactSupport hdψs.mul_right
      have h1 : Integrable (fun x => Mj j x * (fderiv ℝ ψ x (V b) * gs j 0 x)) :=
        Integrable.bdd_mul (c := Br) hgj (hbr j).1.aestronglyMeasurable
          (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact (hbr j).2 x)
      have h2 : Integrable (fun x => Mj j x * (fderiv ℝ ψ x (V b) * g 0 x)) :=
        Integrable.bdd_mul (c := Br) hθi (hbr j).1.aestronglyMeasurable
          (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact (hbr j).2 x)
      exact (h1.sub h2).congr (Eventually.of_forall fun x => by simp only [Pi.sub_apply]; ring)
    simp only
    rw [← integral_add i1 i2]
    congr 1
    funext x
    ring

/-- **Weak continuity of pulled-back `k`-forms** (the identification of Simon 2.29 with 3.6): if
the `L`-Lipschitz `H_j : ℝᵏ → ℝ^{N'}` converge uniformly to the `L`-Lipschitz `H`, `w ∈ L¹(A)` and
`ω ∈ 𝒟ᵏ(ℝ^{N'})`, then `∫_A w H_j^#ω(e) → ∫_A w H^#ω(e)`, where
`H^#ω(u)(e) = ω(H(u))(DH(u)e₁, …, DH(u)e_k)`.  Where `G` is differentiable (a.e., by Rademacher)
`D(G^i)(u) v = (DG(u) v) i`, so the covector expansion gives `k! G^#ω(e) = Σ_I ω_I(G) D_I(G)` a.e.,
with coefficients `ω_I(y) = ω(y)(e'_{I 0}, …, e'_{I (k-1)})` continuous with compact support and
minors `D_I(G) = det (D(G^{I c}) e_b)_{c,b}` measurable and bounded by `Cb = k! (L Σ_b ‖e_b‖)ᵏ`.
For each `I` split `ω_I(H_j) = (ω_I(H_j) − ω_I(H)) + ω_I(H)`: the first part contributes at most
`Cb sup |ω_I(H_j) − ω_I(H)| ∫_A |w| → 0` (`ω_I` is uniformly continuous), and
`∫_A w ω_I(H) D_I(H_j) → ∫_A w ω_I(H) D_I(H)` is the weak continuity of Jacobian minors with the
weight `1_A w ω_I(H) ∈ L¹`.  Summing over `I` and dividing by `k!` concludes. -/
theorem Submission.dor_lmb_fcd_jacobian_weak_continuity : ∀ (k N' : ℕ) (A : Set (Euclid k)) (w : Euclid k → ℝ) (L : NNReal) (Hs : ℕ → Euclid k → Euclid N') (H : Euclid k → Euclid N') (ω : TestFormOn (univ : Set (Euclid N')) k), MeasurableSet A → IntegrableOn w A → (∀ j, LipschitzWith L (Hs j)) → LipschitzWith L H → TendstoUniformly Hs H atTop → Tendsto (fun j => ∫ u in A, w u * (ω : DifferentialForm (Euclid N') k) (Hs j u) (fun i => fderiv ℝ (Hs j) u (EuclideanSpace.single i (1 : ℝ)))) atTop (𝓝 (∫ u in A, w u * (ω : DifferentialForm (Euclid N') k) (H u) (fun i => fderiv ℝ H u (EuclideanSpace.single i (1 : ℝ))))) := by
  intro k N' A w L Hs H ω hA hw hHs hH hU
  have hw' : Integrable w (volume.restrict A) := hw
  -- step 1: `ω` is continuous with compact support, hence so are its coefficients
  -- `ω_I(y) = ω(y)(e'_{I 0}, …, e'_{I (k-1)})`, which are therefore bounded
  obtain ⟨⟨hωsm, hωs⟩, -⟩ := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid N') k) := ContDiff.continuous hωsm
  obtain ⟨ωI, hωI⟩ : ∃ f : (Fin k → Fin N') → Euclid N' → ℝ, ∀ I y,
      f I y = (ω : DifferentialForm (Euclid N') k) y
        (fun c => EuclideanSpace.single (I c) (1 : ℝ)) :=
    ⟨fun I y => (ω : DifferentialForm (Euclid N') k) y
      (fun c => EuclideanSpace.single (I c) (1 : ℝ)), fun _ _ => rfl⟩
  have hωIc : ∀ I, Continuous (ωI I) := by
    intro I
    have h : ωI I = fun y => ContinuousAlternatingMap.apply ℝ (Euclid N') ℝ
        (fun c => EuclideanSpace.single (I c) (1 : ℝ)) ((ω : DifferentialForm (Euclid N') k) y) := by
      funext y; rw [hωI]; rfl
    rw [h]
    exact (ContinuousLinearMap.continuous _).comp hωc
  have hωIs : ∀ I, HasCompactSupport (ωI I) := by
    intro I
    have h : ωI I = (fun f : Covector (Euclid N') k =>
        f (fun c => EuclideanSpace.single (I c) (1 : ℝ))) ∘ (ω : DifferentialForm (Euclid N') k) := by
      funext y; rw [hωI]; rfl
    rw [h]
    exact hωs.comp_left (by simp)
  have hωIG : ∀ I (G : Euclid k → Euclid N'), Continuous G →
      Continuous (fun u => ωI I (G u)) ∧ ∃ M, ∀ u, ‖ωI I (G u)‖ ≤ M := fun I G hG =>
    ⟨(hωIc I).comp hG, ((hωIc I).bounded_above_of_compact_support (hωIs I)).imp
      fun _ hM u => hM (G u)⟩
  -- step 2: coordinates of `L`-Lipschitz maps are `L`-Lipschitz, and the minors
  -- `D_I(G) = det (D(G^{I c}) e_b)_{c,b}` are measurable and bounded by `Cb`
  have hcoordL : ∀ G : Euclid k → Euclid N', LipschitzWith L G → ∀ i,
      LipschitzWith L (fun y => G y i) :=
    fun G hG i => LipschitzWith.of_dist_le_mul fun x y =>
      (PiLp.dist_apply_le (G x) (G y) i).trans (hG.dist_le_mul x y)
  obtain ⟨D, hD⟩ : ∃ D : (Euclid k → Euclid N') → (Fin k → Fin N') → Euclid k → ℝ, ∀ G I x,
      D G I x = Matrix.det (Matrix.of fun c b =>
        fderiv ℝ (fun y => G y (I c)) x (EuclideanSpace.single b (1 : ℝ))) :=
    ⟨fun G I x => Matrix.det (Matrix.of fun c b =>
      fderiv ℝ (fun y => G y (I c)) x (EuclideanSpace.single b (1 : ℝ))), fun _ _ _ => rfl⟩
  set Cb : ℝ := (k.factorial : ℝ) *
    ((L : ℝ) * ∑ b : Fin k, ‖EuclideanSpace.single b (1 : ℝ)‖) ^ k
  have hDmb : ∀ G : Euclid k → Euclid N', LipschitzWith L G → ∀ I,
      Measurable (D G I) ∧ ∀ x, |D G I x| ≤ Cb := by
    intro G hG I
    have h := Submission.dor_lmb_fcd_jwc_minor_measurable_bound k k L (fun c y => G y (I c))
      (fun b => EuclideanSpace.single b (1 : ℝ)) (fun c => hcoordL G hG (I c))
    have hDe : D G I = fun x => Matrix.det (Matrix.of fun c b =>
        fderiv ℝ (fun y => G y (I c)) x (EuclideanSpace.single b (1 : ℝ))) := funext (hD G I)
    rw [hDe]
    exact h
  -- `w F D_I(G)` is integrable on `A` for continuous bounded `F`
  have hint : ∀ F : Euclid k → ℝ, Continuous F → (∃ M, ∀ u, ‖F u‖ ≤ M) →
      ∀ G : Euclid k → Euclid N', LipschitzWith L G → ∀ I,
      Integrable (fun u => w u * F u * D G I u) (volume.restrict A) := by
    rintro F hF ⟨M, hM⟩ G hG I
    refine (hw'.mul_bdd hF.aestronglyMeasurable (Eventually.of_forall hM)).mul_bdd (c := Cb)
      (hDmb G hG I).1.aestronglyMeasurable (Eventually.of_forall fun u => ?_)
    rw [Real.norm_eq_abs]
    exact (hDmb G hG I).2 u
  -- step 3: where `G` is differentiable, `D(G^i)(u) v = (DG(u) v) i`, so the covector expansion
  -- gives `k! G^#ω(e) = Σ_I ω_I(G) D_I(G)`
  have hpt : ∀ (G : Euclid k → Euclid N') (u : Euclid k), DifferentiableAt ℝ G u →
      (k.factorial : ℝ) * (ω : DifferentialForm (Euclid N') k) (G u)
          (fun i => fderiv ℝ G u (EuclideanSpace.single i (1 : ℝ))) =
        ∑ I, ωI I (G u) * D G I u := by
    intro G u hGu
    rw [Submission.dor_lmb_fcd_jwc_covector_det_expansion]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [hωI, hD]
    congr 2
    ext c b
    simp only [Matrix.of_apply]
    have h : HasFDerivAt (PiLp.proj 2 (fun _ : Fin N' => ℝ) (I c) ∘ G)
        ((PiLp.proj 2 (fun _ : Fin N' => ℝ) (I c)).comp (fderiv ℝ G u)) u :=
      (PiLp.proj 2 (fun _ : Fin N' => ℝ) (I c)).hasFDerivAt.comp u hGu.hasFDerivAt
    have h' : HasFDerivAt (fun y => G y (I c))
        ((PiLp.proj 2 (fun _ : Fin N' => ℝ) (I c)).comp (fderiv ℝ G u)) u := h
    rw [h'.fderiv]
    rfl
  -- Rademacher: the expansion holds a.e., so `∫_A w G^#ω(e) = (k!)⁻¹ Σ_I ∫_A w ω_I(G) D_I(G)`
  have hexp : ∀ G : Euclid k → Euclid N', LipschitzWith L G →
      ∫ u in A, w u * (ω : DifferentialForm (Euclid N') k) (G u)
          (fun i => fderiv ℝ G u (EuclideanSpace.single i (1 : ℝ))) =
        (k.factorial : ℝ)⁻¹ * ∑ I, ∫ u in A, w u * ωI I (G u) * D G I u := by
    intro G hG
    have hk : (k.factorial : ℝ) ≠ 0 := by positivity
    rw [← integral_finsetSum (f := fun I u => w u * ωI I (G u) * D G I u) Finset.univ
      fun I _ => hint _ (hωIG I G hG.continuous).1 (hωIG I G hG.continuous).2 G hG I,
      ← integral_const_mul]
    refine integral_congr_ae ?_
    filter_upwards [ae_restrict_of_ae (hG.ae_differentiableAt (μ := volume))] with u hu
    have h2 : ∑ I, w u * ωI I (G u) * D G I u = w u * ∑ I, ωI I (G u) * D G I u := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun I _ => mul_assoc _ _ _
    rw [h2, ← hpt G u hu, mul_left_comm, inv_mul_cancel_left₀ hk]
  -- step 4: the coordinates `H_j^i` converge uniformly to `H^i`
  have hcoordU : ∀ i, TendstoUniformly (fun j y => Hs j y i) (fun y => H y i) atTop := by
    intro i
    have hl : LipschitzWith 1 (fun x : Euclid N' => x i) :=
      LipschitzWith.of_dist_le_mul fun x y => by
        rw [NNReal.coe_one, one_mul]
        exact PiLp.dist_apply_le x y i
    exact hl.uniformContinuous.comp_tendstoUniformly hU
  -- step 5: for each `I`, `∫_A w ω_I(H_j) D_I(H_j) → ∫_A w ω_I(H) D_I(H)`
  have hconvI : ∀ I, Tendsto (fun j => ∫ u in A, w u * ωI I (Hs j u) * D (Hs j) I u) atTop
      (𝓝 (∫ u in A, w u * ωI I (H u) * D H I u)) := by
    intro I
    obtain ⟨hωHc, M, hM⟩ := hωIG I H hH.continuous
    -- weak continuity of Jacobian minors, with the fixed weight `φ = 1_A w ω_I(H) ∈ L¹`
    have hφ : Integrable (A.indicator fun u => w u * ωI I (H u)) := by
      rw [integrable_indicator_iff hA]
      exact hw'.mul_bdd hωHc.aestronglyMeasurable (Eventually.of_forall hM)
    have hmain := Submission.dor_lmb_fcd_jwc_minor_weak_continuity k k L
      (fun j c y => Hs j y (I c)) (fun c y => H y (I c)) (fun b => EuclideanSpace.single b (1 : ℝ))
      _ hφ (fun j c => hcoordL (Hs j) (hHs j) (I c)) (fun c => hcoordL H hH (I c))
      (fun c => hcoordU (I c))
    have hind : ∀ G : Euclid k → Euclid N',
        ∫ x, A.indicator (fun u => w u * ωI I (H u)) x * Matrix.det (Matrix.of fun c b =>
          fderiv ℝ (fun y => G y (I c)) x (EuclideanSpace.single b (1 : ℝ))) =
        ∫ u in A, w u * ωI I (H u) * D G I u := by
      intro G
      rw [← integral_indicator hA]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      simp only
      rw [Set.indicator_mul_left A (fun u => w u * ωI I (H u)) (D G I), hD]
    have hmain' : Tendsto (fun j => ∫ u in A, w u * ωI I (H u) * D (Hs j) I u) atTop
        (𝓝 (∫ u in A, w u * ωI I (H u) * D H I u)) := by
      rw [← hind H]
      exact hmain.congr fun j => hind (Hs j)
    -- the error `|∫_A w (ω_I(H_j) − ω_I(H)) D_I(H_j)| ≤ Cb sup |ω_I(H_j) − ω_I(H)| ∫_A |w| → 0`
    have hωU : TendstoUniformly (fun j u => ωI I (Hs j u)) (fun u => ωI I (H u)) atTop :=
      ((hωIs I).uniformContinuous_of_continuous (hωIc I)).comp_tendstoUniformly hU
    have herr : Tendsto (fun j => ∫ u in A, w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u)
        atTop (𝓝 0) := by
      rw [Metric.tendsto_atTop]
      intro ε hε
      set K : ℝ := Cb * (∫ u in A, ‖w u‖) + 1
      have hCb0 : 0 ≤ Cb := by positivity
      have hK0 : 0 < K := by
        have : 0 ≤ ∫ u in A, ‖w u‖ := integral_nonneg fun _ => norm_nonneg _
        positivity
      have hδ : 0 < ε / (2 * K) := by positivity
      obtain ⟨N, hN⟩ :=
        (Metric.tendstoUniformly_iff.1 hωU (ε / (2 * K)) hδ).exists_forall_of_atTop
      refine ⟨N, fun j hj => ?_⟩
      rw [Real.dist_eq, sub_zero]
      have hbd : ∀ u, ‖w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u‖ ≤
          (ε / (2 * K) * Cb) * ‖w u‖ := by
        intro u
        have h1 : |ωI I (Hs j u) - ωI I (H u)| ≤ ε / (2 * K) := by
          have := hN j hj u
          rw [dist_comm, Real.dist_eq] at this
          exact this.le
        have h2 : |D (Hs j) I u| ≤ Cb := (hDmb (Hs j) (hHs j) I).2 u
        rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_mul]
        calc |w u| * |ωI I (Hs j u) - ωI I (H u)| * |D (Hs j) I u|
            ≤ |w u| * (ε / (2 * K)) * Cb := by gcongr
          _ = (ε / (2 * K) * Cb) * |w u| := by ring
      calc |∫ u in A, w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u|
          = ‖∫ u in A, w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u‖ :=
            (Real.norm_eq_abs _).symm
        _ ≤ ∫ u in A, (ε / (2 * K) * Cb) * ‖w u‖ :=
            norm_integral_le_of_norm_le (hw'.norm.const_mul _) (Eventually.of_forall hbd)
        _ = (ε / (2 * K)) * (Cb * ∫ u in A, ‖w u‖) := by
            rw [integral_const_mul]; ring
        _ ≤ (ε / (2 * K)) * K := by gcongr; linarith
        _ = ε / 2 := by field_simp
        _ < ε := by linarith
    -- `∫_A w ω_I(H_j) D_I(H_j) = (error) + ∫_A w ω_I(H) D_I(H_j)`
    have heq : ∀ j, (∫ u in A, w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u) +
        ∫ u in A, w u * ωI I (H u) * D (Hs j) I u =
        ∫ u in A, w u * ωI I (Hs j u) * D (Hs j) I u := by
      intro j
      have i1 := hint _ (hωIG I (Hs j) (hHs j).continuous).1 (hωIG I (Hs j) (hHs j).continuous).2
        (Hs j) (hHs j) I
      have i2 := hint _ hωHc ⟨M, hM⟩ (Hs j) (hHs j) I
      have i3 : Integrable (fun u => w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u)
          (volume.restrict A) :=
        (i1.sub i2).congr (Eventually.of_forall fun u => by simp only [Pi.sub_apply]; ring)
      rw [← integral_add i3 i2]
      refine integral_congr_ae (Eventually.of_forall fun u => ?_)
      simp only
      ring
    have hsum := herr.add hmain'
    rw [zero_add] at hsum
    exact hsum.congr heq
  -- step 6: sum over `I` and divide by `k!`
  have hlim := (tendsto_finsetSum (Finset.univ : Finset (Fin k → Fin N'))
    fun I _ => hconvI I).const_mul ((k.factorial : ℝ)⁻¹)
  rw [hexp H hH]
  exact hlim.congr fun j => (hexp (Hs j) (hHs j)).symm

/-- **Simon Ch. 6, 1.7 and 1.15**: a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` (`τ` orthonormal)
has dual Euclidean coefficient norm exactly one: `|ξ(α)| = |α(τ)| ≤ |α|_E` for every
`n`-covector `α`, and `ξ(±β₀) = 1` for a covector `β₀` with `|β₀|_E = 1` and `β₀(τ) = 1`
(`+β₀` for the sign `+`, `−β₀` for the sign `−`, using `|−β₀|_E = |β₀|_E`). -/
theorem Submission.regcomp_unit_orientation_pairing : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ α| ≤ covectorEuclideanNorm α) ∧ ∃ β : Covector (Euclid P) n, covectorEuclideanNorm β ≤ 1 ∧ ξ β = 1 := by
  rintro P n ξ Q ⟨τ, hτ, -, hξ⟩
  obtain ⟨β₀, hβ₀, hβ₀τ⟩ := Submission.regcomp_exists_covector_eval_orthonormal_eq_one P n τ hτ
  rcases hξ with h | h
  · -- `ξ(α) = α(τ)`: take `β = β₀`
    refine ⟨fun α => ?_, β₀, hβ₀.le, ?_⟩
    · rw [h α]
      exact Submission.regcomp_covector_eval_orthonormal_le P n α τ hτ
    · rw [h β₀, hβ₀τ]
  · -- `ξ(α) = −α(τ)`: `|ξ(α)| = |α(τ)|`, and take `β = −β₀`
    refine ⟨fun α => ?_, -β₀, ?_, ?_⟩
    · rw [h α, abs_neg]
      exact Submission.regcomp_covector_eval_orthonormal_le P n α τ hτ
    · rw [covectorEuclideanNorm_neg]
      exact hβ₀.le
    · rw [h (-β₀), ContinuousAlternatingMap.neg_apply, hβ₀τ, neg_neg]

/-- **Mass bound for an integer combination** (Simon Ch. 6, Remark 3.2(1)): if
`1_M θ ξ = p₁ 1_{M₁} θ₁ ξ₁ + p₂ 1_{M₂} θ₂ ξ₂` holds `Hⁿ`-a.e. for integer multiplicity triples
`R = (M, θ, ξ)`, `R₁ = (M₁, θ₁, ξ₁)`, `R₂ = (M₂, θ₂, ξ₂)`, then `μ_R ≤ |p₁| μ_{R₁} + |p₂| μ_{R₂}`.
At a.e. `x ∈ M`, `regcomp_unit_orientation_pairing` gives `β` with `|β|_E ≤ 1` and
`ξ(x)(β) = 1`, and `|ξᵢ(x)(β)| ≤ |β|_E ≤ 1` at a.e. `x ∈ Mᵢ`; evaluating the identity at `β`
gives `1_M θ ≤ |p₁| 1_{M₁} θ₁ + |p₂| 1_{M₂} θ₂` a.e.  Since `μ_{R'}` has density `1_{M'} θ'` with
respect to `Hⁿ`, this bound integrates to the claim. -/
theorem Submission.dor_lmb_ic_measure_le_of_weighted_orient_eq : ∀ (P n : ℕ) (U : Set (Euclid P)) (R₁ R₂ R : IMRep U n) (p₁ p₂ : ℤ), (∀ᵐ x ∂μHE[n], R.carrier.indicator (fun y => (R.mult y : ℝ) • R.orient y) x = (p₁ : ℝ) • R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x + (p₂ : ℝ) • R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x) → R.measure ≤ (p₁.natAbs : ℝ≥0∞) • R₁.measure + (p₂.natAbs : ℝ≥0∞) • R₂.measure := by
  intro P n U R₁ R₂ R p₁ p₂ h
  -- Step 1: `Hⁿ`-a.e., `x ∈ M'` implies that `ξ'(x)` is a unit orientation
  have hor : ∀ R' : IMRep U n, ∀ᵐ x ∂μHE[n], x ∈ R'.carrier →
      ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (R'.orient x) Q := by
    intro R'
    filter_upwards [(ae_restrict_iff' R'.measurableSet_carrier).mp R'.orients] with x hx hxM
    obtain ⟨Q, -, hQ⟩ := hx hxM
    exact ⟨Q, hQ⟩
  -- Step 2: at such `x`, `|(1_{M'} θ' ξ')(x)(β)| ≤ 1_{M'} θ'(x)` whenever `|β|_E ≤ 1`
  have hone : ∀ (R' : IMRep U n) (x : Euclid P),
      (x ∈ R'.carrier → ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (R'.orient x) Q) →
      ∀ β : Covector (Euclid P) n, covectorEuclideanNorm β ≤ 1 →
        |R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x β| ≤
          ((R'.carrier.indicator R'.mult x : ℕ) : ℝ) := by
    intro R' x hx β hβ
    by_cases hxM : x ∈ R'.carrier
    · obtain ⟨Q, hQ⟩ := hx hxM
      have hle :=
        ((Submission.regcomp_unit_orientation_pairing P n (R'.orient x) Q hQ).1 β).trans hβ
      rw [Set.indicator_of_mem hxM, Set.indicator_of_mem hxM, smul_apply, smul_eq_mul, abs_mul,
        Nat.abs_cast]
      exact mul_le_of_le_one_right (Nat.cast_nonneg _) hle
    · rw [Set.indicator_of_notMem hxM, Set.indicator_of_notMem hxM]
      simp
  -- Step 3: `μ_{R'}` has the measurable density `1_{M'} θ'` with respect to `Hⁿ`
  have hM : ∀ R' : IMRep U n,
      R'.measure = μHE[n].withDensity (R'.carrier.indicator fun x => (R'.mult x : ℝ≥0∞)) := by
    intro R'
    rw [IMRep.measure, withDensity_indicator R'.measurableSet_carrier]
  have hmeas : ∀ R' : IMRep U n, Measurable (R'.carrier.indicator fun x => (R'.mult x : ℝ≥0∞)) :=
    fun R' => (measurable_from_nat.comp R'.measurable_mult).indicator R'.measurableSet_carrier
  have hind : ∀ (R' : IMRep U n) (x : Euclid P), R'.carrier.indicator
      (fun y => (R'.mult y : ℝ≥0∞)) x = ((R'.carrier.indicator R'.mult x : ℕ) : ℝ≥0∞) := by
    intro R' x
    by_cases hxM : x ∈ R'.carrier
    · rw [Set.indicator_of_mem hxM, Set.indicator_of_mem hxM]
    · rw [Set.indicator_of_notMem hxM, Set.indicator_of_notMem hxM, Nat.cast_zero]
  -- Step 4: `|p₁| μ_{R₁} + |p₂| μ_{R₂}` has density `|p₁| 1_{M₁} θ₁ + |p₂| 1_{M₂} θ₂`, so it
  -- suffices to compare the densities `Hⁿ`-a.e.
  rw [hM R, hM R₁, hM R₂, ← withDensity_smul _ (hmeas R₁), ← withDensity_smul _ (hmeas R₂),
    ← withDensity_add_left ((hmeas R₁).const_smul _)]
  refine withDensity_mono ?_
  -- Step 5: `1_M θ ≤ |p₁| 1_{M₁} θ₁ + |p₂| 1_{M₂} θ₂` wherever the identity and Step 1 hold
  filter_upwards [h, hor R, hor R₁, hor R₂] with x hx h0 h1 h2
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hind]
  by_cases hxM : x ∈ R.carrier
  swap
  · rw [Set.indicator_of_notMem hxM, Nat.cast_zero]
    exact zero_le
  -- evaluate the identity at a `β` with `|β|_E ≤ 1` and `ξ(x)(β) = 1`
  obtain ⟨Q, hQ⟩ := h0 hxM
  obtain ⟨-, β, hβ, hξβ⟩ := Submission.regcomp_unit_orientation_pairing P n (R.orient x) Q hQ
  have hev := congrArg (fun F : MultiVector P n => F β) hx
  simp only [Set.indicator_of_mem hxM, add_apply, smul_apply, smul_eq_mul, hξβ, mul_one] at hev
  have hreal : (R.mult x : ℝ) ≤ (p₁.natAbs : ℝ) * ((R₁.carrier.indicator R₁.mult x : ℕ) : ℝ) +
      (p₂.natAbs : ℝ) * ((R₂.carrier.indicator R₂.mult x : ℕ) : ℝ) := by
    rw [hev, Nat.cast_natAbs, Nat.cast_natAbs, Int.cast_abs, Int.cast_abs]
    calc (p₁ : ℝ) * R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x β +
          (p₂ : ℝ) * R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x β
        ≤ |(p₁ : ℝ)| * |R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x β| +
          |(p₂ : ℝ)| * |R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x β| := by
          rw [← abs_mul, ← abs_mul]
          exact add_le_add (le_abs_self _) (le_abs_self _)
      _ ≤ _ := by
          gcongr
          · exact hone R₁ x h1 β hβ
          · exact hone R₂ x h2 β hβ
  -- a real inequality between natural numbers
  have hnat : R.mult x ≤ p₁.natAbs * R₁.carrier.indicator R₁.mult x +
      p₂.natAbs * R₂.carrier.indicator R₂.mult x := by
    exact_mod_cast hreal
  rw [Set.indicator_of_mem hxM]
  exact_mod_cast hnat

/-- **Representations of the partial sums** (Simon Ch. 6, Lemma 3.13, steps 3–4): for integer
multiplicity triples `R r = (M_r, θ_r, ξ_r)` in an open `U` and every `q`, there is a triple
`R' = (M', θ', ξ')` with `1_{M'} θ' ξ' = ∑_{r<q} 1_{M_r} θ_r ξ_r` `Hⁿ`-a.e. and
`μ_{R'} ≤ ∑_{r<q} μ_{R r}`.  Induction on `q`: for `q = 0` take the empty triple `(∅, 0, 0)`; for
`q → q + 1`, `rsdic_exists_imrep_int_combination` with `p₁ = p₂ = 1` combines `R'` and `R q`, and
`dor_lmb_ic_measure_le_of_weighted_orient_eq` bounds the weight of the combination by
`μ_{R'} + μ_{R q}`. -/
theorem Submission.dor_lmb_fc_ims_partial_sum_reps : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : ℕ → IMRep U n), IsOpen U → ∀ q : ℕ, ∃ R' : IMRep U n, (∀ᵐ x ∂μHE[n], R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x = ∑ r ∈ Finset.range q, (R r).carrier.indicator (fun y => ((R r).mult y : ℝ) • (R r).orient y) x) ∧ R'.measure ≤ ∑ r ∈ Finset.range q, (R r).measure := by
  intro P n U R hU q
  induction q with
  | zero =>
    -- the empty triple `(∅, 0, 0)` has density `0` and weight `0`
    let R₀ : IMRep U n :=
      { carrier := ∅
        mult := fun _ => 0
        orient := fun _ => 0
        measurableSet_carrier := MeasurableSet.empty
        carrier_subset := empty_subset U
        rectifiable :=
          Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
        measurable_mult := measurable_const
        mult_pos := fun x hx => absurd hx (notMem_empty x)
        locallyIntegrable_mult := fun K _ _ => by simp
        aestronglyMeasurable_orient := aestronglyMeasurable_const
        orients := by simp }
    refine ⟨R₀, Eventually.of_forall fun x => by simp [R₀], ?_⟩
    simp [R₀, IMRep.measure]
  | succ q ih =>
    obtain ⟨R', hR', hR'μ⟩ := ih
    -- `R''` represents `1 • (density of R') + 1 • (density of R q)`
    obtain ⟨R'', hR''⟩ := Submission.rsdic_exists_imrep_int_combination P n U R' (R q) 1 1 hU
    refine ⟨R'', ?_, ?_⟩
    · filter_upwards [hR'', hR'] with x h₁ h₂
      rw [h₁, h₂, Finset.sum_range_succ]
      simp
    · have h := Submission.dor_lmb_ic_measure_le_of_weighted_orient_eq P n U R' (R q) R'' 1 1 hR''
      simp only [Int.natAbs_one, Nat.cast_one, one_smul] at h
      rw [Finset.sum_range_succ]
      exact h.trans (add_le_add hR'μ le_rfl)
/-- **Localization of weakly convergent integer multiplicity cycles** (Simon Ch. 6, proof of 7.2,
step 1: "by 4.5(1),(2) and an argument as in 6.7(2) of Ch. 2").  Let `W ⊂⊂ U`, `W ≠ ∅`,
`g = dist(·, closure W)`, `δ > 0` with `{g ≤ 3δ}` compact in `U`, `W₁ = {g < 5δ/2}` and
`Λ₀ = supⱼ M_{W₁}(T_j)`.  The slicing hypothesis (its premise is
`dor_imrep_massOn_eq_measure_and_support`), applied to each cycle `T_j` with the empty
representation of `∂T_j = 0`, gives slices `P_{j,t}` of `T_j` by `g`, and
`dor_lmb_fcl_good_level` a level `s ∈ (δ, 2δ)` at which every slice is good, a subsequence `φ`
with `M_{W₁}(P_{φ(j),s}) ≤ C` and no limiting mass of `g_# μ_{φ(j)}` at `s`.  Then the Borel
restrictions `T'_j = T_{φ(j)}⌞{g < s}` and `T' = T⌞{g < s}` are integer multiplicity, `T'_j`
vanishes off `K = {g ≤ s}`, `∂T'_j = P_{φ(j),s}`, `M(T'_j) ≤ Λ₀`,
`M(∂T'_j) ≤ M_{W₁}(P_{φ(j),s}) ≤ C`, `T'_j` and `T'` agree with `T_{φ(j)}` and `T` on forms
supported in `W`, and `T'_j ⇀ T'`. -/
theorem Submission.dor_lmb_fc_localize : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ) (U W : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U (m + 1)) (T : GeometricCurrentOn U (m + 1)), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → IsIntegerMultiplicity T → (∀ j, (Ts j).boundary = 0) → (∀ V : Set (Euclid P), IsOpen V → CompactlyContained V U → ⨆ j, (Ts j).massOn V < ∞) → WeaklyConvergesOn Ts T → W.Nonempty → CompactlyContained W U → ∃ (φ : ℕ → ℕ) (K : Set (Euclid P)) (Λ : ℝ≥0∞) (Ts' : ℕ → GeometricCurrentOn U (m + 1)) (T' : GeometricCurrentOn U (m + 1)), StrictMono φ ∧ IsCompact K ∧ K ⊆ U ∧ Λ ≠ ∞ ∧ (∀ j, IsIntegerMultiplicity (Ts' j)) ∧ (∀ j, IsIntegerMultiplicity (Ts' j).boundary) ∧ IsIntegerMultiplicity T' ∧ (∀ j (ω : TestFormOn U (m + 1)), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → Ts' j ω = 0) ∧ (∀ j, (Ts' j).mass ≤ Λ ∧ (Ts' j).boundary.mass ≤ Λ) ∧ WeaklyConvergesOn Ts' T' ∧ (∀ j (ω : TestFormOn U (m + 1)), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ W → Ts' j ω = Ts (φ j) ω) ∧ ∀ ω : TestFormOn U (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ W → T' ω = T ω := by
  intro hSL P m U W Ts T hU hTsIM hTIM hbd hbound hconv hWne hW
  -- (C1) discharges the antecedent of the slicing hypothesis
  have hSL' := hSL Submission.dor_imrep_massOn_eq_measure_and_support
  have hME := fun (d : ℕ) (X : GeometricCurrentOn U d) (R : IMRep U d) (hR : R.Represents X) =>
    (Submission.dor_imrep_massOn_eq_measure_and_support P d U X R hU hR).1
  -- (IMC)(b) Borel restriction and (IMC)(d) orientation bound
  have hIR := Submission.cmc_imRep_locality_restrict_sub.2.1
  have hIO := Submission.cmc_imRep_locality_restrict_sub.2.2.2
  obtain ⟨RT, hRT⟩ := hTIM
  -- Step 1: `g = dist(·, closure W)`; `{g ≤ r}` is compact in `U` for `r ≤ δ₀ = 3δ`, and
  -- `W₁ = {g < 5δ/2} ⊂⊂ U` gives `Λ₀ = supⱼ M_{W₁}(T_j) < ∞`
  have hCcpt : IsCompact (closure W) := hW.1
  have hCU : closure W ⊆ U := hW.2
  have hCne : (closure W).Nonempty := hWne.closure
  obtain ⟨δ₀, hδ₀, hsub⟩ :=
    Submission.cmc_fcl_dist_sublevel_compact P U (closure W) hU hCcpt hCU hCne
  obtain ⟨g, hgdef⟩ : ∃ g : Euclid P → ℝ, g = fun x => infDist x (closure W) := ⟨_, rfl⟩
  have hgc : Continuous g := by
    rw [hgdef]
    exact continuous_infDist_pt _
  have hgm : Measurable g := hgc.measurable
  have hgL : LipschitzWith 1 g := by
    rw [hgdef]
    exact lipschitz_infDist_pt _
  have hsub' : ∀ r : ℝ, r ≤ δ₀ → IsCompact {x | g x ≤ r} ∧ {x | g x ≤ r} ⊆ U := by
    intro r hr
    rw [hgdef]
    exact hsub r hr
  have hg0 : ∀ x ∈ W, g x = 0 := by
    intro x hx
    rw [hgdef]
    exact infDist_zero_of_mem (subset_closure hx)
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℝ, δ = δ₀ / 3 := ⟨_, rfl⟩
  have hδ : 0 < δ := by rw [hδdef]; positivity
  obtain ⟨W₁, hW₁def⟩ : ∃ W₁ : Set (Euclid P), W₁ = {x | g x < 5 * δ / 2} := ⟨_, rfl⟩
  have hW₁o : IsOpen W₁ := by
    rw [hW₁def]
    exact isOpen_lt hgc continuous_const
  have hW₁cc : CompactlyContained W₁ U := by
    have hcl : closure W₁ ⊆ {x | g x ≤ 5 * δ / 2} := by
      rw [hW₁def]
      exact closure_lt_subset_le hgc continuous_const
    obtain ⟨hK, hKU⟩ := hsub' (5 * δ / 2) (by rw [hδdef]; linarith)
    exact ⟨hK.of_isClosed_subset isClosed_closure hcl, hcl.trans hKU⟩
  have hΛ₀ := hbound W₁ hW₁o hW₁cc
  obtain ⟨Λ₀, hΛ₀def⟩ : ∃ Λ₀ : ℝ≥0∞, Λ₀ = ⨆ j, (Ts j).massOn W₁ := ⟨_, rfl⟩
  rw [← hΛ₀def] at hΛ₀
  have hle₀ : ∀ j, (Ts j).massOn W₁ ≤ Λ₀ := fun j => by
    rw [hΛ₀def]
    exact le_iSup (fun i => (Ts i).massOn W₁) j
  -- Step 1 (cont.): representations `R j` of `T_j` and `RT` of `T` with their integral data
  choose R hR using hTsIM
  have hD := fun j => Submission.cmc_fcl_imrep_integral_data P (m + 1) U (Ts j) (R j) (hR j)
  have hDT := Submission.cmc_fcl_imrep_integral_data P (m + 1) U T RT hRT
  -- Step 3: the empty representation `R₀` (carrier `∅`) of the zero current `∂T_j`, and the
  -- slices of every `T_j` by the `1`-Lipschitz function `g`
  obtain ⟨R₀, hR₀c⟩ : ∃ R₀ : IMRep U m, R₀.carrier = ∅ :=
    ⟨{ carrier := ∅
       mult := fun _ => 0
       orient := fun _ => 0
       measurableSet_carrier := MeasurableSet.empty
       carrier_subset := empty_subset U
       rectifiable :=
         Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
       measurable_mult := measurable_const
       mult_pos := fun x hx => absurd hx (notMem_empty x)
       locallyIntegrable_mult := fun K _ _ => by simp
       aestronglyMeasurable_orient := aestronglyMeasurable_const
       orients := by simp }, rfl⟩
  have hR₀ : ∀ j, R₀.Represents (Ts j).boundary := by
    intro j ω
    rw [hbd j, GeometricCurrentOn.zero_apply, IMRep.action, hR₀c, Measure.restrict_empty,
      integral_zero_measure]
  have hSLj := fun j => hSL' P m U (Ts j) (R j) R₀ g 1 hU (hR j) (hR₀ j) hgL
  choose Ps hPsm hPsg using hSLj
  -- Steps 2 and 4 (`dor_lmb_fcl_good_level`: Helly selection, Fatou, choice of the level): a
  -- level `s ∈ (δ, 2δ)` with good slices for every `j` and a subsequence `φ`, for the
  -- push-forwards `g_# μ_j` (mass on `[δ, 2δ]` at most `μ_j(W₁) = M_{W₁}(T_j) ≤ Λ₀`) and the
  -- slice masses `M_{W₁}(P_{j,t})` (integrals at most `M_{W₁}(T_j) ≤ Λ₀`)
  have hνle : ∀ j, ((R j).measure.map g) (Icc δ (2 * δ)) ≤ Λ₀ := by
    intro j
    rw [Measure.map_apply hgm measurableSet_Icc]
    calc (R j).measure (g ⁻¹' Icc δ (2 * δ)) ≤ (R j).measure W₁ := by
          apply measure_mono
          intro x hx
          simp only [mem_preimage, mem_Icc] at hx
          rw [hW₁def]
          show g x < 5 * δ / 2
          linarith [hx.2]
      _ = (Ts j).massOn W₁ := (hME (m + 1) (Ts j) (R j) (hR j) W₁ hW₁o).symm
      _ ≤ Λ₀ := hle₀ j
  have hFint : ∀ j, ∫⁻ t, (Ps j t).massOn W₁ ≤ Λ₀ := by
    intro j
    calc ∫⁻ t, (Ps j t).massOn W₁ ≤ ((1 : NNReal) : ℝ≥0∞) * (Ts j).massOn W₁ :=
          (hPsm j W₁ hW₁o).2
      _ = (Ts j).massOn W₁ := by rw [ENNReal.coe_one, one_mul]
      _ ≤ Λ₀ := hle₀ j
  obtain ⟨s, hs, φ, C, hφ, hC, hgood, hFC, hconc⟩ :=
    Submission.dor_lmb_fcl_good_level (fun j => (R j).measure.map g)
      (fun j t => (Ps j t).massOn W₁) _ δ (2 * δ) Λ₀ (by linarith) hΛ₀.ne hνle
      (fun j => (hPsm j W₁ hW₁o).1) hFint hPsg
  -- Step 5: `G = {g < s}`, `W ⊆ G ⊆ W₁`, `K = {g ≤ s}` compact in `U`; `T' = T⌞G` and
  -- `T'_j = T_{φ(j)}⌞G` by (IMC)(b), with the integral formulas of `imrep_restrict`
  have hGm : MeasurableSet {x | g x < s} := measurableSet_lt hgm measurable_const
  have hGK : {x | g x < s} ⊆ {x | g x ≤ s} := fun x (hx : g x < s) => le_of_lt hx
  obtain ⟨hKc, hKU⟩ := hsub' s (by rw [hδdef] at hs; linarith [hs.2])
  have hWG : W ⊆ {x | g x < s} := fun x hx => by
    show g x < s
    rw [hg0 x hx]
    linarith [hs.1]
  have hGW₁ : {x | g x < s} ⊆ W₁ := fun x (hx : g x < s) => by
    rw [hW₁def]
    show g x < 5 * δ / 2
    linarith [hs.2]
  obtain ⟨T', RT', hRT'A, hRT'c, hRT'm, hRT'o⟩ := hIR P (m + 1) U RT {x | g x < s} hU hGm
  have hT'f := (Submission.cmc_fcl_imrep_restrict_formula P (m + 1) U RT RT' T' {x | g x < s}
    hGm hRT'A hRT'c hRT'm hRT'o).2
  choose Ts' R' hR'A hR'c hR'm hR'o using
    fun j => hIR P (m + 1) U (R (φ j)) {x | g x < s} hU hGm
  have hTs'f := fun j => Submission.cmc_fcl_imrep_restrict_formula P (m + 1) U (R (φ j)) (R' j)
    (Ts' j) {x | g x < s} hGm (hR'A j) (hR'c j) (hR'm j) (hR'o j)
  -- Step 5(iii): `∂T'_j = P_{φ(j),s}`; both send `ω` to `∫_{M_{φ(j)} ∩ G} θ ⟨dω, ξ⟩ dH^{m+1}`
  have hbdeq : ∀ j, (Ts' j).boundary = Ps (φ j) s := by
    intro j
    apply GeometricCurrentOn.ext
    intro ω
    rw [GeometricCurrentOn.boundary_apply, hR'A j (exteriorDerivativeTestOn U m ω),
      (hgood (φ j)).2.2 ω, IMRep.action, hR'c j, hR'm j, hR'o j, hR₀c, empty_inter,
      Measure.restrict_empty, integral_zero_measure, sub_zero]
    rfl
  refine ⟨φ, {x | g x ≤ s}, Λ₀ + C, Ts', T', hφ, hKc, hKU, ENNReal.add_ne_top.2 ⟨hΛ₀.ne, hC⟩,
    fun j => ⟨R' j, hR'A j⟩, fun j => ?_, ⟨RT', hRT'A⟩, ?_, fun j => ⟨?_, ?_⟩, ?_, ?_, ?_⟩
  · -- Step 5(iii): `∂T'_j = P_{φ(j),s}` is integer multiplicity
    rw [hbdeq j]
    exact (hgood (φ j)).1
  · -- Step 5(i): `T'_j` vanishes off `K ⊇ G`
    intro j ω hdisj
    rw [(hTs'f j).2 ω]
    apply setIntegral_eq_zero_of_forall_eq_zero
    intro x hx
    have hω0 : (ω : DifferentialForm (Euclid P) (m + 1)) x = 0 :=
      image_eq_zero_of_notMem_tsupport (fun hxt => Set.disjoint_left.1 hdisj hxt (hGK hx))
    simp [hω0]
  · -- Step 5(iv): `M(T'_j) = μ_{φ(j)}(U ∩ G) ≤ μ_{φ(j)}(W₁) = M_{W₁}(T_{φ(j)}) ≤ Λ₀` by (C1)
    calc (Ts' j).mass = (Ts' j).massOn U := rfl
      _ = (R' j).measure U := hME (m + 1) (Ts' j) (R' j) (hR'A j) U hU
      _ = (R (φ j)).measure (U ∩ {x | g x < s}) := by
          rw [(hTs'f j).1, Measure.restrict_apply hU.measurableSet]
      _ ≤ (R (φ j)).measure W₁ := measure_mono (inter_subset_right.trans hGW₁)
      _ = (Ts (φ j)).massOn W₁ := (hME (m + 1) (Ts (φ j)) (R (φ j)) (hR (φ j)) W₁ hW₁o).symm
      _ ≤ Λ₀ := hle₀ (φ j)
      _ ≤ Λ₀ + C := le_self_add
  · -- Step 5(iv): `M(∂T'_j) = M(P_{φ(j),s}) ≤ M_{W₁}(P_{φ(j),s}) ≤ C`, as the good slice
    -- `P_{φ(j),s}` vanishes off the compact level set `g⁻¹(s) ⊆ W₁`
    have hLc : IsCompact (g ⁻¹' {s}) :=
      hKc.of_isClosed_subset (isClosed_singleton.preimage hgc) fun x (hx : g x = s) => hx.le
    have hLW₁ : g ⁻¹' {s} ⊆ W₁ := fun x (hx : g x = s) => by
      rw [hW₁def]
      show g x < 5 * δ / 2
      linarith [hs.2]
    calc (Ts' j).boundary.mass = (Ps (φ j) s).massOn U := by rw [hbdeq j]; rfl
      _ ≤ (Ps (φ j) s).massOn W₁ :=
          Submission.lcmp_massOn_le_of_vanish_off_compact P m U W₁ (g ⁻¹' {s}) (Ps (φ j) s)
            hLc hW₁o hLW₁ (hgood (φ j)).2.1 U
      _ ≤ C := hFC j
      _ ≤ Λ₀ + C := le_add_self
  · -- Step 6: `T'_j ⇀ T'`, as no mass of `μ_{φ(j)}` concentrates at `{g = s}`
    refine Submission.cmc_fcl_weakConverges_sublevel P (m + 1) U g s
      (fun j => (R (φ j)).measure) RT.measure (fun j => (R (φ j)).orient) RT.orient
      (fun j => Ts (φ j)) Ts' T T' hgc
      (fun j => lt_of_le_of_lt (measure_mono hGK) ((hD (φ j)).1 _ hKc hKU))
      (lt_of_le_of_lt (measure_mono hGK) (hDT.1 _ hKc hKU))
      (fun j => (hD (φ j)).2.1) hDT.2.1
      (fun j => (hD (φ j)).2.2.1 (hIO P (m + 1) U (R (φ j))))
      (hDT.2.2.1 (hIO P (m + 1) U RT))
      (fun j => (hD (φ j)).2.2.2) hDT.2.2.2 (fun j => (hTs'f j).2) hT'f
      (fun ω => (hconv ω).comp hφ.tendsto_atTop) ?_
    intro ε hε
    obtain ⟨δ', hδ', hev⟩ := hconc ε hε
    refine ⟨δ', hδ', hev.mono fun j hj => ?_⟩
    rw [Measure.map_apply hgm measurableSet_Icc] at hj
    exact hj
  · -- Step 5(ii): on forms supported in `W ⊆ G`, `T'_j = T_{φ(j)}` ...
    intro j ω hω
    rw [(hTs'f j).2 ω, (hD (φ j)).2.2.2 ω]
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro x hx
    have hω0 : (ω : DifferentialForm (Euclid P) (m + 1)) x = 0 :=
      image_eq_zero_of_notMem_tsupport (fun hxt => hx (hWG (hω hxt)))
    simp [hω0]
  · -- ... and `T' = T`
    intro ω hω
    rw [hT'f ω, hDT.2.2.2 ω]
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro x hx
    have hω0 : (ω : DifferentialForm (Euclid P) (m + 1)) x = 0 :=
      image_eq_zero_of_notMem_tsupport (fun hxt => hx (hWG (hω hxt)))
    simp [hω0]
/-- **Extension by zero to `ℝᴾ`** (Simon Ch. 6, proof of Theorem 7.2, which applies the
Deformation Theorem 5.3 in `ℝ^{n+ℓ}` to a current in `U` vanishing off a compact subset of `U`).
Let `A = τ(M, θ, ξ)` in the open `U` vanish off the compact `K ⊆ U`.  Every form admissible for
`M_{U∖K}(A)` is supported off `K`, so `μ_A(U ∖ K) = M_{U∖K}(A) = 0` (Ch. 6, 3.2(3)); as `θ ≥ 1`
on `M ⊆ U`, `Hᵈ(M ∖ K) = 0`.  The triple `(M ∩ K, θ, ξ)` is an `IMRep` in `U`, hence in `ℝᴾ`
(`∫_{M ∩ K} θ dHᵈ < ∞`, `K` being a compact subset of `U`).  Its current `Y ∈ 𝒟_d(ℝᴾ)` restricts
to `A` on `U` (`M ∩ K = M` `Hᵈ`-a.e.), vanishes off `K`, and has
`M(Y) = θHᵈ(M ∩ K) ≤ θHᵈ(M) = M(A)`. -/
theorem Submission.dor_lmb_fc_tb_extend_univ : ∀ (P d : ℕ) (U K : Set (Euclid P)) (A : GeometricCurrentOn U d), IsOpen U → IsCompact K → K ⊆ U → IsIntegerMultiplicity A → (∀ ω : TestFormOn U d, Disjoint (tsupport (ω : DifferentialForm (Euclid P) d)) K → A ω = 0) → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) d, IsIntegerMultiplicity Y ∧ Y.restrictDomain (subset_univ U) = A ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) d, Disjoint (tsupport (ω : DifferentialForm (Euclid P) d)) K → Y ω = 0) ∧ Y.mass ≤ A.mass := by
  intro P d U K A hU hK hKU hA hvan
  obtain ⟨R, hR⟩ := hA
  have hmassA := (Submission.dor_imrep_massOn_eq_measure_and_support P d U A R hU hR).1
  -- `M_{U∖K}(A) = 0`: every admissible form is supported off `K`
  have hzero : A.massOn (U \ K) = 0 := by
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (A ω) ≤ 0
    rw [hvan ω (Set.disjoint_left.2 fun x hx hxK => (hω.1 hx).2 hxK), ENNReal.ofReal_zero]
  -- `Hᵈ(M ∖ K) = 0`: `θ Hᵈ⌞M` vanishes on `U ∖ K`, and `θ ≥ 1` on `M ⊆ U`
  have hnull : μHE[d] (R.carrier \ K) = 0 := by
    have h0 : R.measure (U \ K) = 0 := (hmassA (U \ K) (hU.sdiff hK.isClosed)).symm.trans hzero
    have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
    rw [IMRep.measure, withDensity_apply_eq_zero hθ,
      Measure.restrict_apply' R.measurableSet_carrier] at h0
    have hsub : R.carrier \ K ⊆ {x | (R.mult x : ℝ≥0∞) ≠ 0} ∩ (U \ K) ∩ R.carrier := by
      intro x hx
      refine ⟨⟨?_, R.carrier_subset hx.1, hx.2⟩, hx.1⟩
      show (R.mult x : ℝ≥0∞) ≠ 0
      exact_mod_cast (R.mult_pos x hx.1).ne'
    exact measure_mono_null hsub h0
  -- `(M ∩ K, θ, ξ)` is an `IMRep` in `U` (integer multiplicity calculus (b) with `E = K`) ...
  have hIMC := Submission.cmc_imRep_locality_restrict_sub.2.1
  obtain ⟨-, R₁, -, hcar₁, hmult₁, horient₁⟩ := hIMC P d U R K hU hK.isClosed.measurableSet
  -- ... and also in `ℝᴾ`, as `∫_{M ∩ K} θ dHᵈ < ∞`
  obtain ⟨Rh, hcarh, hmulth, horienth⟩ : ∃ Rh : IMRep (univ : Set (Euclid P)) d,
      Rh.carrier = R.carrier ∩ K ∧ Rh.mult = R.mult ∧ Rh.orient = R.orient := by
    have hsub : R₁.carrier ⊆ R₁.carrier ∩ K := fun x hx => ⟨hx, (hcar₁.subset hx).2⟩
    refine ⟨{ carrier := R₁.carrier
              mult := R₁.mult
              orient := R₁.orient
              measurableSet_carrier := R₁.measurableSet_carrier
              carrier_subset := subset_univ _
              rectifiable := R₁.rectifiable
              measurable_mult := R₁.measurable_mult
              mult_pos := R₁.mult_pos
              locallyIntegrable_mult := fun K' _ _ =>
                ne_top_of_le_ne_top (R₁.locallyIntegrable_mult K hK hKU)
                  (lintegral_mono_set (inter_subset_left.trans hsub))
              aestronglyMeasurable_orient := R₁.aestronglyMeasurable_orient
              orients := R₁.orients }, hcar₁, hmult₁, horient₁⟩
  -- its current `Y ∈ 𝒟_d(ℝᴾ)` (integer multiplicity calculus (b) in `ℝᴾ` with `E = ℝᴾ`)
  obtain ⟨Y, R₂, hR₂, hcar₂, hmult₂, horient₂⟩ :=
    hIMC P d univ Rh univ isOpen_univ MeasurableSet.univ
  rw [hcarh, inter_univ] at hcar₂
  rw [hmulth] at hmult₂
  rw [horienth] at horient₂
  have hact : ∀ ω : DifferentialForm (Euclid P) d, R₂.action ω =
      ∫ x in R.carrier ∩ K, (R.mult x : ℝ) * R.orient x (ω x) ∂μHE[d] := by
    intro ω
    rw [IMRep.action, hcar₂, hmult₂, horient₂]
  refine ⟨Y, ⟨R₂, hR₂⟩, ?_, ?_, ?_⟩
  · -- `Y⌞U = A`, as `M ∩ K = M` up to the `Hᵈ`-null set `M ∖ K`
    have hae : (R.carrier ∩ K : Set (Euclid P)) =ᵐ[μHE[d]] R.carrier :=
      ae_eq_set.2 ⟨by rw [Set.sdiff_eq_empty.2 inter_subset_left, measure_empty],
        by rwa [Set.sdiff_self_inter]⟩
    ext ω
    rw [GeometricCurrentOn.restrictDomain_apply, hR₂, hact, hR ω, IMRep.action]
    exact setIntegral_congr_set hae
  · -- `Y` vanishes off `K ⊇ M ∩ K`
    intro ω hω
    rw [hR₂, hact]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [image_eq_zero_of_notMem_tsupport (Set.disjoint_right.1 hω hx.2), map_zero, mul_zero]
  · -- `M(Y) = θHᵈ(M ∩ K) ≤ θHᵈ(M) = M(A)`
    show Y.massOn univ ≤ A.massOn U
    rw [(Submission.dor_imrep_massOn_eq_measure_and_support P d univ Y R₂ isOpen_univ hR₂).1 univ
        isOpen_univ, hmassA U hU, IMRep.measure, IMRep.measure,
      withDensity_apply _ MeasurableSet.univ, withDensity_apply _ hU.measurableSet,
      Measure.restrict_univ, Measure.restrict_restrict hU.measurableSet,
      inter_eq_self_of_subset_right R.carrier_subset, hcar₂, hmult₂]
    exact lintegral_mono_set inter_subset_left
/-- **Simon Ch. 6, proof of Theorem 7.2** (total boundedness; the cutoff behind `∂Ǎ = Ž` for the
extension by zero): two currents in `ℝᴾ` that vanish off a compact `K ⊆ U`, `U` open, and agree
in `U` are equal.  Choose `δ > 0` with `cthickening δ K ⊆ U` and a smooth `ζ : ℝᴾ → [0, 1]` with
`support ζ = thickening δ K` and `ζ = 1` exactly on `cthickening (δ / 2) K`.  For a test form
`ω`, `ζω` is a test form in `U`, and `ω - ζω` vanishes on the open set `thickening (δ / 2) K ⊇ K`,
so its support misses `K`; hence `X ω = X (ζω) = (X⌞U)(ζω) = (Y⌞U)(ζω) = Y (ζω) = Y ω`. -/
theorem Submission.dor_lmb_fc_tb_eq_of_vanish_off : ∀ (P d : ℕ) (U K : Set (Euclid P)) (X Y : GeometricCurrentOn (univ : Set (Euclid P)) d), IsOpen U → IsCompact K → K ⊆ U → (∀ ω : TestFormOn (univ : Set (Euclid P)) d, Disjoint (tsupport (ω : DifferentialForm (Euclid P) d)) K → X ω = 0) → (∀ ω : TestFormOn (univ : Set (Euclid P)) d, Disjoint (tsupport (ω : DifferentialForm (Euclid P) d)) K → Y ω = 0) → X.restrictDomain (subset_univ U) = Y.restrictDomain (subset_univ U) → X = Y := by
  intro P d U K X Y hU hK hKU hX hY hXY
  -- the cutoff `ζ`: smooth, `support ζ = thickening δ K`, `ζ = 1` on `cthickening (δ / 2) K`
  obtain ⟨δ, hδ, hδU⟩ := hK.exists_cthickening_subset_open hU hKU
  obtain ⟨ζ, hζ, -, hζs, hζ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := ⊤)
    (isOpen_thickening (δ := δ) (E := K)) (isClosed_cthickening (δ := δ / 2) (E := K))
    (cthickening_subset_thickening' hδ (half_lt_self hδ) K)
  have hζU : tsupport ζ ⊆ U := by
    rw [tsupport, hζs]
    exact (closure_thickening_subset_cthickening δ K).trans hδU
  -- `ζ = 1` on the open set `thickening (δ / 2) K ⊇ K`
  have hKV : K ⊆ thickening (δ / 2) K := self_subset_thickening (half_pos hδ) K
  have hζV : ∀ x ∈ thickening (δ / 2) K, ζ x = 1 := fun x hx =>
    (hζ1 x).1 (thickening_subset_cthickening _ _ hx)
  refine GeometricCurrentOn.ext fun ω => ?_
  -- `ζω` as a test form in `U`, and its inclusion `ιη` into `ℝᴾ`
  let η : TestFormOn U d := ⟨ζ • (ω : DifferentialForm (Euclid P) d),
    ⟨hζ.smul ω.property.1.1, ω.property.1.2.smul_left⟩,
    (tsupport_smul_subset_left ζ (ω : DifferentialForm (Euclid P) d)).trans hζU⟩
  let ιη : TestFormOn (univ : Set (Euclid P)) d := testFormOnInclusion (subset_univ U) d η
  -- `ω - ιη = (1 - ζ)ω` vanishes on `thickening (δ / 2) K`, so its support misses `K`
  have hdisj : Disjoint (tsupport ((ω - ιη : TestFormOn (univ : Set (Euclid P)) d) :
      DifferentialForm (Euclid P) d)) K := by
    refine Disjoint.mono_right hKV (Set.disjoint_left.2 fun x hx hxV => ?_)
    refine (notMem_tsupport_iff_eventuallyEq.2 ?_) hx
    filter_upwards [isOpen_thickening.mem_nhds hxV] with y hy
    change (ω : DifferentialForm (Euclid P) d) y - ζ y • (ω : DifferentialForm (Euclid P) d) y = 0
    rw [hζV y hy, one_smul, sub_self]
  -- `X ω = X ιη` and `Y ω = Y ιη`, by linearity and vanishing off `K`
  have hXω : X ω = X ιη :=
    sub_eq_zero.1 ((map_sub X.toCurrent ω ιη).symm.trans (hX _ hdisj))
  have hYω : Y ω = Y ιη :=
    sub_eq_zero.1 ((map_sub Y.toCurrent ω ιη).symm.trans (hY _ hdisj))
  calc X ω = X ιη := hXω
    _ = X.restrictDomain (subset_univ U) η := rfl
    _ = Y.restrictDomain (subset_univ U) η := by rw [hXY]
    _ = Y ιη := rfl
    _ = Y ω := hYω.symm

/-- **Extension by zero of `A` and `∂A`** (Simon Ch. 6, proof of Theorem 7.2, where the
deformation theorem is applied to currents in `ℝᴾ`).  Let `U` be open, `K ⊆ U` compact, and let
`A ∈ 𝒟_{m+1}(U)` and `∂A` be integer multiplicity, with `A` vanishing off `K`.  Extending `A` and
`∂A` by zero gives `Y` and `Z` in `ℝᴾ` with `Y⌞U = A`, `Z⌞U = ∂A`, both vanishing off `K`,
`M(Y) ≤ M(A)` and `M(Z) ≤ M(∂A)`.  Since `spt dω ⊆ spt ω`, `∂Y` vanishes off `K`, and `d` commutes
with the inclusion of test forms, so `(∂Y)⌞U = ∂A = Z⌞U`.  Hence `∂Y = Z`. -/
theorem Submission.dor_lmb_fc_tb_extend_univ_boundary : ∀ (P m : ℕ) (U K : Set (Euclid P)) (A : GeometricCurrentOn U (m + 1)), IsOpen U → IsCompact K → K ⊆ U → IsIntegerMultiplicity A → IsIntegerMultiplicity A.boundary → (∀ ω : TestFormOn U (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → A ω = 0) → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Y ∧ IsIntegerMultiplicity Y.boundary ∧ Y.restrictDomain (subset_univ U) = A ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → Y ω = 0) ∧ Y.mass ≤ A.mass ∧ Y.boundary.mass ≤ A.boundary.mass := by
  intro P m U K A hU hK hKU hA hbA hAK
  -- Step 1: `∂A` vanishes off `K`, as `∂A(ω) = A(dω)` and `spt dω ⊆ spt ω`
  have hbAK : ∀ ω : TestFormOn U m,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) K → A.boundary ω = 0 := by
    intro ω hω
    rw [GeometricCurrentOn.boundary_apply]
    exact hAK _ (hω.mono_left (tsupport_exteriorDerivative_subset _))
  -- Step 2: extend `A` by zero to `Y ∈ 𝒟_{m+1}(ℝᴾ)`
  obtain ⟨Y, hYim, hYA, hYK, hYmass⟩ :=
    Submission.dor_lmb_fc_tb_extend_univ P (m + 1) U K A hU hK hKU hA hAK
  -- Step 3: extend `∂A` by zero to `Z ∈ 𝒟_m(ℝᴾ)`
  obtain ⟨Z, hZim, hZA, hZK, hZmass⟩ :=
    Submission.dor_lmb_fc_tb_extend_univ P m U K A.boundary hU hK hKU hbA hbAK
  -- Step 4: `∂Y` vanishes off `K`, as `∂Y(ω) = Y(dω)` and `spt dω ⊆ spt ω`
  have hbYK : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) K → Y.boundary ω = 0 := by
    intro ω hω
    rw [GeometricCurrentOn.boundary_apply]
    exact hYK _ (hω.mono_left (tsupport_exteriorDerivative_subset _))
  -- Step 5: `(∂Y)⌞U = Z⌞U`: for `ω ∈ 𝒟^m(U)`, `d(ιω) = ι(dω)` (both have underlying form `dω`),
  -- so `(∂Y)⌞U(ω) = Y(ι(dω)) = (Y⌞U)(dω) = A(dω) = ∂A(ω) = (Z⌞U)(ω)`
  have hbYZ : Y.boundary.restrictDomain (subset_univ U) = Z.restrictDomain (subset_univ U) := by
    ext ω
    have hdι : exteriorDerivativeTestOn univ m (testFormOnInclusion (subset_univ U) m ω) =
        testFormOnInclusion (subset_univ U) (m + 1) (exteriorDerivativeTestOn U m ω) :=
      Subtype.ext rfl
    rw [GeometricCurrentOn.restrictDomain_apply, GeometricCurrentOn.boundary_apply, hdι, hZA,
      ← hYA, GeometricCurrentOn.boundary_apply, GeometricCurrentOn.restrictDomain_apply]
  -- Step 6: `∂Y = Z`, as both vanish off `K` and agree in `U`
  have hYZ : Y.boundary = Z :=
    Submission.dor_lmb_fc_tb_eq_of_vanish_off P m U K Y.boundary Z hU hK hKU hbYK hZK hbYZ
  -- Step 7: hence `∂Y` is integer multiplicity and `M(∂Y) = M(Z) ≤ M(∂A)`
  exact ⟨Y, hYim, hYZ ▸ hZim, hYA, hYK, hYmass, hYZ ▸ hZmass⟩
/-- **Simon 6.7.2** (proof, "only finitely many currents `P` as in (2)"): for `ρ > 0`, compact `K`
and `B ∈ ℕ` there are only finitely many currents `Σ_{p ∈ s} b(p) [[F_p]]` with grid cells
`F_p ⊆ K` of side `ρ` and `|b(p)| ≤ B`.  The corner `ρz` of a cell `F_p ⊆ K` gives
`ρ|zᵢ| ≤ ‖ρz‖ ≤ D` (`‖y‖ ≤ D` on `K`), so `p` lies in a finite index set `C`; each such current
is `Φ e = Σ_{q ∈ C} e(q) [[F_q]]` for one of the finitely many `e ∈ [-B, B]^C` (`e = b` on `s`,
`0` off `s`), and a current is determined by its values. -/
theorem Submission.dor_lmb_fc_tb_cell_chains_finite : ∀ (P m : ℕ) (U K : Set (Euclid P)) (ρ : ℝ) (B : ℕ), 0 < ρ → IsCompact K → {X : GeometricCurrentOn U (m + 1) | ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (b : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ), (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ K) ∧ (∀ p ∈ s, (b p).natAbs ≤ B) ∧ ∀ ω : TestFormOn U (m + 1), X ω = ∑ p ∈ s, (b p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]}.Finite := by
  intro P m U K ρ B hρ hK
  classical
  -- `‖y‖ ≤ D` on `K`, and `D / ρ ≤ N`
  obtain ⟨D, hD⟩ := hK.isBounded.exists_norm_le
  obtain ⟨N, hN⟩ : ∃ N : ℕ, D / ρ ≤ N := ⟨⌈D / ρ⌉₊, Nat.le_ceil _⟩
  -- the finite set of index pairs `(z, ι)` with `|zᵢ| ≤ N`
  let C : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P)) :=
    Fintype.piFinset (fun _ : Fin P => Finset.Icc (-(N : ℤ)) N) ×ˢ Finset.univ
  -- a cell `F_p ⊆ K` contains its corner `ρz`, hence `ρ|zᵢ| ≤ D`
  have hC : ∀ p : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
      {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧
        (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ K → p ∈ C := by
    intro p hp
    have hy : (WithLp.toLp 2 (fun i => ρ * (p.1 i : ℝ)) : Euclid P) ∈ K := by
      refine hp fun i => ⟨fun _ => ⟨le_rfl, ?_⟩, fun _ => rfl⟩
      exact mul_le_mul_of_nonneg_left (by linarith) hρ.le
    refine Finset.mem_product.2 ⟨Fintype.mem_piFinset.2 fun i => Finset.mem_Icc.2 ?_,
      Finset.mem_univ _⟩
    have h1 := (PiLp.norm_apply_le (WithLp.toLp 2 (fun i => ρ * (p.1 i : ℝ)) : Euclid P) i).trans
      (hD _ hy)
    simp only [Real.norm_eq_abs, abs_mul, abs_of_pos hρ] at h1
    have h2 : |(p.1 i : ℝ)| ≤ N := ((le_div_iff₀' hρ).2 h1).trans hN
    exact abs_le.1 (by exact_mod_cast h2)
  -- abstract the cells `F_p` and the cell integrals `I_p`
  have key : ∀ (F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P))
      (I : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → TestFormOn U (m + 1) → ℝ),
      (∀ p, F p ⊆ K → p ∈ C) →
      {X : GeometricCurrentOn U (m + 1) | ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P)))
        (b : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ), (∀ p ∈ s, F p ⊆ K) ∧
        (∀ p ∈ s, (b p).natAbs ≤ B) ∧
        ∀ ω : TestFormOn U (m + 1), X ω = ∑ p ∈ s, (b p : ℝ) * I p ω}.Finite := by
    intro F I hFC
    -- `Φ e = Σ_{q ∈ C} e(q) I_q`, for the finitely many `e ∈ [-B, B]^C`
    let Φ : (C → ℤ) → TestFormOn U (m + 1) → ℝ := fun e ω => ∑ q : C, (e q : ℝ) * I q ω
    have hE : (Set.univ.pi fun _ : C => Set.Icc (-(B : ℤ)) B).Finite :=
      Set.Finite.pi fun _ => Set.finite_Icc _ _
    refine Set.Finite.of_finite_image (f := fun X : GeometricCurrentOn U (m + 1) => fun ω => X ω)
      ((hE.image Φ).subset ?_) fun X _ Y _ hXY => GeometricCurrentOn.ext fun ω => congrFun hXY ω
    rintro _ ⟨X, ⟨s, b, hsK, hsb, hX⟩, rfl⟩
    have hsC : s ⊆ C := fun p hp => hFC p (hsK p hp)
    -- `e = b` on `s` and `e = 0` off `s`
    refine ⟨fun q => if (q : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) ∈ s then b q else 0,
      Set.mem_univ_pi.2 fun q => ?_, funext fun ω => ?_⟩
    · show (if (q : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) ∈ s then b q else 0) ∈
        Set.Icc (-(B : ℤ)) B
      split_ifs with hq
      · have h : |b q| ≤ (B : ℤ) := by
          rw [Int.abs_eq_natAbs]
          exact_mod_cast hsb _ hq
        exact Set.mem_Icc.2 (abs_le.1 h)
      · exact Set.mem_Icc.2 ⟨by omega, by omega⟩
    · calc _ = ∑ q ∈ C, ((if q ∈ s then b q else 0 : ℤ) : ℝ) * I q ω :=
            Finset.sum_coe_sort C fun q => ((if q ∈ s then b q else 0 : ℤ) : ℝ) * I q ω
        _ = ∑ p ∈ s, ((if p ∈ s then b p else 0 : ℤ) : ℝ) * I p ω :=
            (Finset.sum_subset hsC fun q _ hq => by simp [hq]).symm
        _ = ∑ p ∈ s, (b p : ℝ) * I p ω := Finset.sum_congr rfl fun p hp => by simp [hp]
        _ = X ω := (hX ω).symm
  exact key _ _ hC
/-- **The zero current is integer multiplicity.**  The triple `(∅, 0, 0)` is an `IMRep` in `U`:
`∅` is Borel and `Hᵈ`-null, hence countably `d`-rectifiable, and the positivity, local
integrability and orientation conditions over `∅` hold vacuously (`Hᵈ⌞∅ = 0`).  Its action is an
integral over `∅`, i.e. `0`, so it represents the zero current. -/
theorem Submission.dor_lmb_fc_tb_zero_isIntegerMultiplicity : ∀ (P d : ℕ) (U : Set (Euclid P)), IsIntegerMultiplicity (0 : GeometricCurrentOn U d) := by
  intro P d U
  refine ⟨{ carrier := ∅
            mult := fun _ => 0
            orient := fun _ => 0
            measurableSet_carrier := MeasurableSet.empty
            carrier_subset := empty_subset U
            rectifiable :=
              Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
            measurable_mult := measurable_const
            mult_pos := fun x hx => absurd hx (notMem_empty x)
            locallyIntegrable_mult := fun K _ _ => by simp
            aestronglyMeasurable_orient := aestronglyMeasurable_const
            orients := by simp }, fun ω => ?_⟩
  simp [IMRep.action]
/-- **Currents of degree above the ambient dimension vanish.**  If `P < d`, any `d` vectors
`v₀, …, v_{d−1}` in `ℝᴾ` are linearly dependent (otherwise `d = card (Fin d) ≤ dim ℝᴾ = P`), so
every alternating `d`-covector vanishes on them.  Hence every test `d`-form in `U` is `0`, and
`A(ω) = A(0) = 0` by linearity. -/
theorem Submission.dor_lmb_fc_tb_eq_zero_of_lt_degree : ∀ (P d : ℕ) (U : Set (Euclid P)) (A : GeometricCurrentOn U d), P < d → A = 0 := by
  intro P d U A hPd
  -- every `d`-covector on `ℝᴾ` is `0`: `d > P` vectors in `ℝᴾ` are linearly dependent
  have hcov : ∀ α : Covector (Euclid P) d, α = 0 := fun α => by
    ext v
    rw [ContinuousAlternatingMap.coe_zero, Pi.zero_apply]
    refine α.toAlternatingMap.map_linearDependent v fun hv => ?_
    have hcard := hv.fintype_card_le_finrank
    rw [Fintype.card_fin, finrank_euclideanSpace_fin] at hcard
    omega
  -- hence every test `d`-form is `0`, and `A(ω) = A(0) = 0`
  ext ω
  rw [GeometricCurrentOn.zero_apply,
    show ω = 0 from Subtype.ext (funext fun x => (hcov _).trans (hcov _).symm)]
  exact map_zero A.toCurrent

/-- **The current `[[G]]` of a Borel set `G ⊆ ℝⁿ` is integer multiplicity** (Simon Ch. 6, 2.2
and Definition 3.1).  The full-space triple `(ℝⁿ, 1, e₀ ∧ ⋯ ∧ eₙ₋₁)` is an `IMRep` in `ℝⁿ`: the
standard basis `e` is orthonormal and spans `⊤`, `ℝⁿ = ⊤` is its own approximate tangent space at
every point, `ℝⁿ = range id` is countably `n`-rectifiable and `Hⁿ` is Lebesgue measure.  Its
restriction to `G` (integer multiplicity calculus (b)) represents `[[G]] = τ(G, 1, e₀ ∧ ⋯ ∧ eₙ₋₁)`,
`[[G]](ω) = ∫_G ω(x)(e₀, …, eₙ₋₁) dHⁿ(x)`. -/
theorem Submission.dor_lmb_fc_dtop_cci_borel_current_im : ∀ (n : ℕ) (G : Set (Euclid n)), MeasurableSet G → ∃ A : GeometricCurrentOn (univ : Set (Euclid n)) n, IsIntegerMultiplicity A ∧ ∀ ω : TestFormOn (univ : Set (Euclid n)) n, A ω = ∫ x in G, (ω : DifferentialForm (Euclid n) n) x (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[n] := by
  intro n G hG
  -- the standard basis `e = (e₀, …, eₙ₋₁)` and `ξ₀ = e₀ ∧ ⋯ ∧ eₙ₋₁`, `⟨α, ξ₀⟩ = α(e)`
  set e : Fin n → Euclid n := fun k => EuclideanSpace.single k (1 : ℝ)
  let ξ₀ : MultiVector n n := ContinuousAlternatingMap.apply ℝ (Euclid n) ℝ e
  -- Step 1: `e` is an orthonormal basis of `ℝⁿ`, so `ξ₀` is a unit orientation of `⊤`
  have hb : ⇑(EuclideanSpace.basisFun (Fin n) ℝ) = e := by
    ext1 k
    exact EuclideanSpace.basisFun_apply (ι := Fin n) (𝕜 := ℝ) k
  have hξ₀ : IsUnitOrientationOf ξ₀ (⊤ : Submodule ℝ (Euclid n)) := by
    refine ⟨e, hb ▸ (EuclideanSpace.basisFun (Fin n) ℝ).orthonormal, ?_, Or.inl fun α => rfl⟩
    rw [← hb, ← OrthonormalBasis.coe_toBasis]
    exact Module.Basis.span_eq _
  -- Step 2: `ℝⁿ = ⊤` has approximate tangent space `⊤` at every point
  have htan : ∀ x : Euclid n, HasApproximateTangentSpaceAt n (univ : Set (Euclid n)) x ⊤ := by
    intro x
    have h := Poincare.SimonGMT.Chapter03.hasApproximateTangentSpaceAt_submodule
      (P := (⊤ : Submodule ℝ (Euclid n))) (n := n)
      (by rw [finrank_top, finrank_euclideanSpace_fin]) (x := x) Submodule.mem_top
    rwa [Submodule.top_coe] at h
  -- Step 3: `ℝⁿ = range id` is countably `n`-rectifiable
  have hrect : CountablyRectifiable n (univ : Set (Euclid n)) := by
    rw [← range_id]
    exact Poincare.SimonGMT.Chapter03.countablyRectifiable_range LipschitzWith.id
  -- Steps 4–5: the full-space triple `(ℝⁿ, 1, ξ₀)`; `Hⁿ` is Lebesgue measure, finite on compacts
  obtain ⟨R, hRc, hRm, hRo⟩ : ∃ R : IMRep (univ : Set (Euclid n)) n,
      R.carrier = univ ∧ R.mult = (fun _ => 1) ∧ R.orient = (fun _ => ξ₀) :=
    ⟨{ carrier := univ
       mult := fun _ => 1
       orient := fun _ => ξ₀
       measurableSet_carrier := MeasurableSet.univ
       carrier_subset := subset_rfl
       rectifiable := hrect
       measurable_mult := measurable_const
       mult_pos := fun _ _ => one_pos
       locallyIntegrable_mult := fun K hK _ => by
         simp only [Nat.cast_one, lintegral_one, Measure.restrict_apply_univ, univ_inter]
         rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
         exact hK.measure_lt_top.ne
       aestronglyMeasurable_orient := aestronglyMeasurable_const
       orients := Filter.Eventually.of_forall fun x => ⟨⊤, htan x, hξ₀⟩ }, rfl, rfl, rfl⟩
  -- Step 6: its restriction `(G, 1, ξ₀)` to `G` represents a current `A`
  obtain ⟨A, R', hA, hcar, hmult, horient⟩ :=
    Submission.cmc_imRep_locality_restrict_sub.2.1 n n univ R G isOpen_univ hG
  refine ⟨A, ⟨R', hA⟩, fun ω => ?_⟩
  -- Step 7: `A(ω) = ∫_G 1 · ⟨ω(x), ξ₀⟩ dHⁿ = ∫_G ω(x)(e) dHⁿ`
  rw [hA ω, IMRep.action, hcar, hmult, horient, hRc, hRm, hRo, univ_inter]
  simp only [Nat.cast_one, one_mul]
  rfl
/-- **Lipschitz extension into `ℝᴾ` with a `√P` loss** (Simon Ch. 2, 1.2, applied to each
coordinate; used for the deformation theorem, Ch. 6, 5.1).  Each coordinate `x ↦ ψ(x)ᵢ` is
`K`-Lipschitz on `S` since `|vᵢ| ≤ |v|`; McShane's extension gives `K`-Lipschitz `gᵢ : ℝᴾ → ℝ`
with `gᵢ = ψ(·)ᵢ` on `S`, and `φ = (gᵢ)ᵢ` agrees with `ψ` on `S` and satisfies
`|φ(x) − φ(y)|² = Σᵢ |gᵢ(x) − gᵢ(y)|² ≤ P K² |x − y|²`. -/
theorem Submission.dor_lmb_fcd_sd_lipschitz_extend : ∀ (P : ℕ) (S : Set (Euclid P)) (ψ : Euclid P → Euclid P) (K : NNReal), LipschitzOnWith K ψ S → ∃ φ : Euclid P → Euclid P, LipschitzWith (NNReal.sqrt P * K) φ ∧ EqOn φ ψ S := by
  intro P S ψ K hψ
  -- each coordinate of `ψ` is `K`-Lipschitz on `S`, as `|v i| ≤ ‖v‖`
  have hcoord : ∀ i : Fin P, LipschitzOnWith K (fun x => ψ x i) S := fun i =>
    LipschitzOnWith.of_dist_le_mul fun x hx y hy =>
      (PiLp.dist_apply_le (ψ x) (ψ y) i).trans (hψ.dist_le_mul x hx y hy)
  -- McShane extension of every coordinate
  choose g hg hgS using fun i => (hcoord i).extend_real
  refine ⟨fun x => WithLp.toLp 2 fun i => g i x, LipschitzWith.of_dist_le_mul fun x y => ?_,
    fun x hx => ?_⟩
  · -- `dist (φ x) (φ y) = √(Σᵢ dist (gᵢ x) (gᵢ y) ^ 2) ≤ √(P (K dist x y) ^ 2)`
    rw [EuclideanSpace.dist_eq]
    calc _ ≤ √(∑ _i : Fin P, ((K : ℝ) * dist x y) ^ 2) := by
          gcongr with i
          exact (hg i).dist_le_mul x y
      _ = ↑(NNReal.sqrt P * K) * dist x y := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
            Real.sqrt_mul (Nat.cast_nonneg _), Real.sqrt_sq (by positivity), NNReal.coe_mul,
            Real.coe_sqrt, NNReal.coe_natCast, mul_assoc]
  · -- agreement on `S`, coordinatewise
    ext i
    exact (hgS i hx).symm
/-- **Simon Ch. 6, 2.11 and 3.2(3)**: if `X = τ(M, θ, ξ)` in `ℝᴾ` and `X(ω) = 0` whenever
`spt ω` misses the closed set `F`, then `μ_R(ℝᴾ \ F) = 0` and `M(X) ≤ M_W(X)` for every open
`W ⊇ F`.  Admissible forms for `M_{ℝᴾ \ F}(X)` have support disjoint from `F`, so
`μ_R(ℝᴾ \ F) = M_{ℝᴾ \ F}(X) = 0`; then `M(X) = μ_R(ℝᴾ) ≤ μ_R(W) + μ_R(ℝᴾ \ W) = μ_R(W) = M_W(X)`. -/
theorem Submission.dor_lmb_fcd_sd_im_concentrated : ∀ (P k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (R : IMRep (univ : Set (Euclid P)) k) (F : Set (Euclid P)), R.Represents X → IsClosed F → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (F) → X ω = 0) → R.measure Fᶜ = 0 ∧ ∀ W : Set (Euclid P), IsOpen W → F ⊆ W → X.mass ≤ X.massOn W := by
  intro P k X R F hR hF hX
  -- `M_W(X) = μ_R(W)` for every open `W`
  have hmass := (Submission.dor_imrep_massOn_eq_measure_and_support P k univ X R isOpen_univ hR).1
  -- every admissible `ω` for `M_{Fᶜ}(X)` has `spt ω` disjoint from `F`, so `X(ω) = 0`
  have h0 : X.massOn Fᶜ = 0 := by
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (X ω) ≤ 0
    rw [hX ω (Set.subset_compl_iff_disjoint_right.mp hω.1), ENNReal.ofReal_zero]
  have hFc : R.measure Fᶜ = 0 := by
    rw [← hmass Fᶜ hF.isOpen_compl, h0]
  refine ⟨hFc, fun W hW hFW => ?_⟩
  -- `M(X) = μ_R(W ∪ Wᶜ) ≤ μ_R(W) + μ_R(Wᶜ)`, and `μ_R(Wᶜ) ≤ μ_R(Fᶜ) = 0`
  calc X.mass = R.measure (W ∪ Wᶜ) := by
        rw [Set.union_compl_self]
        exact hmass univ isOpen_univ
    _ ≤ R.measure W + R.measure Wᶜ := measure_union_le W Wᶜ
    _ = X.massOn W := by
        rw [measure_mono_null (Set.compl_subset_compl.mpr hFW) hFc, add_zero, hmass W hW]

/-- **A good slice in a prescribed interval of levels** (Simon Ch. 6, 4.10 and display (10) of the
proof of 5.1: Markov choice of the slicing level).  Let `T = τ(M, θ, ξ)` in `ℝᴾ`, `f` continuous,
and let `Pₜ` satisfy (H1) `∫ M_W(Pₜ) dt ≤ L M_W(T)` for open `W` and (H2) for a.e. `t`: `Pₜ` is
integer multiplicity, vanishes off `f⁻¹{t}` and is given by the slice formula.  Then some
`t ∈ (a, b)` satisfies (H2) and `(b - a) M(Pₜ) ≤ 2 L μ_T{a < f < b}`.
* `W = {a < f < b}` is open and `M_W(T) = μ_T(W)` by (C1), so (H1) gives
  `∫_{(a, b)} M_W(Pₜ) dt ≤ L μ_T(W)`.
* `dor_lmb_fcd_sd_markov_point` gives `t ∈ (a, b)` in the a.e. set of (H2) with
  `(b - a) M_W(Pₜ) ≤ 2 L μ_T(W)`.
* `Pₜ` is integer multiplicity and vanishes off the closed level set `f⁻¹{t} ⊆ W`, so
  `M(Pₜ) ≤ M_W(Pₜ)` by `dor_lmb_fcd_sd_im_concentrated`. -/
theorem Submission.dor_lmb_fcd_sd_good_slice : ∀ (P m : ℕ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (RT : IMRep (univ : Set (Euclid P)) (m + 1)) (RB : IMRep (univ : Set (Euclid P)) m) (f : Euclid P → ℝ) (L : NNReal) (Ps : ℝ → GeometricCurrentOn (univ : Set (Euclid P)) m) (a b : ℝ), RT.Represents T → Continuous f → a < b → (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) → (∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) m, Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) m, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) m) x) ∂μHE[m + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m]) → ∃ t ∈ Ioo a b, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) m, Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) m, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) m) x) ∂μHE[m + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m]) ∧ ENNReal.ofReal (b - a) * (Ps t).mass ≤ 2 * ((L : ℝ≥0∞) * RT.measure {x | a < f x ∧ f x < b}) := by
  intro P m T RT RB f L Ps a b hRT hf hab hH1 hH2
  -- Step 1: the strip `W = {a < f < b}` is open
  have hW : IsOpen {x : Euclid P | a < f x ∧ f x < b} :=
    (isOpen_lt continuous_const hf).inter (isOpen_lt hf continuous_const)
  -- Step 2: (H1) and (C1) give `∫_{(a, b)} M_W(Pₜ) dt ≤ ∫ M_W(Pₜ) dt ≤ L μ_T(W)`
  obtain ⟨hgm, hgI⟩ := hH1 _ hW
  rw [(Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ T RT isOpen_univ
    hRT).1 _ hW] at hgI
  -- Step 3: Markov choice of `t ∈ (a, b)` in the a.e. set of (H2)
  obtain ⟨t, ht, ⟨⟨Rt, hRt⟩, hvan, hform⟩, hle⟩ := Submission.dor_lmb_fcd_sd_markov_point _ _ a b
    _ hab hgm hH2 ((setLIntegral_le_lintegral _ _).trans hgI)
  -- Step 4: `Pₜ` vanishes off the closed level set `f⁻¹{t} ⊆ W`, so `M(Pₜ) ≤ M_W(Pₜ)`
  have hmass := (Submission.dor_lmb_fcd_sd_im_concentrated P m (Ps t) Rt (f ⁻¹' {t}) hRt
    (isClosed_singleton.preimage hf) hvan).2 _ hW fun x (hx : f x = t) => ⟨hx ▸ ht.1, hx ▸ ht.2⟩
  -- Step 5: `(b - a) M(Pₜ) ≤ (b - a) M_W(Pₜ) ≤ 2 L μ_T(W)`
  exact ⟨t, ht, ⟨Rt, hRt⟩, hvan, hform, (mul_le_mul_right hmass _).trans hle⟩
/-- **Restriction of an integer multiplicity current to a Borel set** (Simon Ch. 6, 2.9, 3.1 and
3.2(3)), for `R = (M, θ, ξ)` in `ℝᴾ`.
(A) For a test form `β`, `x ↦ θ(x) ξ(x)(β(x))` is `Hᵏ`-integrable on `M`: `Hᵏ`-a.e. on `M`,
`|ξ(x)(α)| ≤ |α|`, so the integrand is bounded by `s θ 1_{spt β}` with `s = sup |β|`, and
`∫_{M ∩ spt β} θ dHᵏ < ∞`.
(B) If `X = τ(M, θ, ξ)` vanishes off the closed `F` and `B` is Borel, then `Y = τ(M ∩ B, θ, ξ)`
is integer multiplicity with `M(Y) = ∫_{M ∩ B} θ dHᵏ = μ_R(B)`, and `Y(ω) = 0` whenever `spt ω`
misses `F ∩ B`: `μ_R(Fᶜ) = 0` and `θ ≥ 1` on `M` give `Hᵏ(M ∖ F) = 0`, while the integrand
vanishes on `M ∩ B ∩ F`. -/
theorem Submission.dor_lmb_fcd_sd_im_restrict : ∀ (P k : ℕ) (R : IMRep (univ : Set (Euclid P)) k), (∀ β : DifferentialForm (Euclid P) k, IsTestForm β → IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x (β x)) R.carrier μHE[k]) ∧ ∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (F B : Set (Euclid P)), R.Represents X → IsClosed F → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (F) → X ω = 0) → MeasurableSet B → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) k, IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Y ω = ∫ x in R.carrier ∩ B, (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k]) ∧ Y.mass = R.measure B ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (F ∩ B) → Y ω = 0 := by
  intro P k R
  have hθm : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  refine ⟨fun β hβ => ?_, fun X F B hX hF hXF hB => ?_⟩
  · -- (A), step 1: `x ↦ |β(x)|` is continuous with compact support, hence `|β| ≤ s`
    obtain ⟨hsmooth, hcpt⟩ := hβ
    have hSm : MeasurableSet (tsupport β) := (isClosed_tsupport β).measurableSet
    have hcont : Continuous fun α : Covector (Euclid P) k => covectorEuclideanNorm α := by
      unfold covectorEuclideanNorm
      refine Real.continuous_sqrt.comp (continuous_finsetSum _ fun I _ => ?_)
      split_ifs
      · exact (continuous_eval_const _).pow 2
      · exact continuous_const
    obtain ⟨s, hs⟩ := (hcont.comp hsmooth.continuous).bddAbove_range_of_hasCompactSupport
      (hcpt.comp_left (covectorEuclideanNorm_zero P k))
    -- step 4: `x ↦ θ(x) ξ(x)(β(x))` is `Hᵏ⌞M`-a.e. strongly measurable
    have hev : Continuous fun p : MultiVector P k × Covector (Euclid P) k => p.1 p.2 :=
      continuous_fst.clm_apply continuous_snd
    have hmeas : AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (β x))
        (μHE[k].restrict R.carrier) :=
      (measurable_from_nat.comp R.measurable_mult).aestronglyMeasurable.mul
        (hev.comp_aestronglyMeasurable
          (R.aestronglyMeasurable_orient.prodMk hsmooth.continuous.aestronglyMeasurable))
    -- step 3: `s θ 1_{spt β}` is integrable on `M`, as `∫_{M ∩ spt β} θ dHᵏ < ∞`
    have hint : Integrable (fun x => s * (tsupport β).indicator (fun x => (R.mult x : ℝ)) x)
        (μHE[k].restrict R.carrier) := by
      refine Integrable.const_mul ?_ s
      rw [integrable_indicator_iff hSm, IntegrableOn, Measure.restrict_restrict hSm]
      have h := integrable_toReal_of_lintegral_ne_top
        (μ := μHE[k].restrict (tsupport β ∩ R.carrier)) (f := fun x => (R.mult x : ℝ≥0∞))
        hθm.aemeasurable
        (by rw [inter_comm]; exact R.locallyIntegrable_mult _ hcpt (subset_univ _))
      simpa using h
    -- step 2: `|θ ξ(β)| ≤ θ |β| ≤ s θ 1_{spt β}` `Hᵏ⌞M`-a.e., by (IMC)(d)
    refine hint.mono' hmeas ?_
    filter_upwards [Submission.cmc_imRep_locality_restrict_sub.2.2.2 P k univ R] with x hx
    by_cases hxS : x ∈ tsupport β
    · rw [indicator_of_mem hxS, norm_mul, Real.norm_natCast, Real.norm_eq_abs, mul_comm s]
      exact mul_le_mul_of_nonneg_left ((hx (β x)).trans (hs (mem_range_self x)))
        (Nat.cast_nonneg _)
    · simp [indicator_of_notMem hxS, image_eq_zero_of_notMem_tsupport hxS]
  · -- (B), step 5: `θ Hᵏ⌞M` does not charge `Fᶜ`, so `Hᵏ(M ∖ F) = 0` as `θ ≥ 1` on `M`
    have hnull : μHE[k] (R.carrier ∩ Fᶜ) = 0 := by
      have h0 := (Submission.dor_lmb_fcd_sd_im_concentrated P k X R F hX hF hXF).1
      rw [IMRep.measure, withDensity_apply_eq_zero' hθm.aemeasurable,
        Measure.restrict_apply' R.measurableSet_carrier] at h0
      refine measure_mono_null ?_ h0
      intro x hx
      exact ⟨⟨by simpa using (R.mult_pos x hx.1).ne', hx.2⟩, hx.1⟩
    -- step 6: `Y = τ(M ∩ B, θ, ξ)` by (IMC)(b)
    obtain ⟨Y, R', hY, hcar, hmult, horient⟩ :=
      Submission.cmc_imRep_locality_restrict_sub.2.1 P k univ R B isOpen_univ hB
    have hrep : ∀ ω : TestFormOn (univ : Set (Euclid P)) k, Y ω = ∫ x in R.carrier ∩ B,
        (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k] := by
      intro ω
      rw [hY ω, IMRep.action, hcar, hmult, horient]
    refine ⟨Y, ⟨R', hY⟩, hrep, ?_, fun ω hω => ?_⟩
    · -- step 7: `M(Y) = μ_{R'}(ℝᴾ) = ∫_{M ∩ B} θ dHᵏ = μ_R(B)` by (C1)
      rw [GeometricCurrentOn.mass, (Submission.dor_imrep_massOn_eq_measure_and_support P k univ
        Y R' isOpen_univ hY).1 univ isOpen_univ]
      simp only [IMRep.measure, hcar, hmult]
      rw [withDensity_apply _ MeasurableSet.univ, withDensity_apply _ hB, Measure.restrict_univ,
        Measure.restrict_restrict hB, inter_comm]
    · -- step 8: the integrand vanishes on `M ∩ B ∩ F`, and `(M ∩ B) ∖ F` is `Hᵏ`-null
      rw [hrep ω]
      refine integral_eq_zero_of_ae ?_
      rw [EventuallyEq, ae_restrict_iff' (R.measurableSet_carrier.inter hB)]
      refine ae_iff.2 (measure_mono_null (fun x hx => ?_) hnull)
      obtain ⟨⟨hxM, hxB⟩, hne⟩ := Classical.not_imp.1 hx
      refine ⟨hxM, fun hxF => hne ?_⟩
      rw [image_eq_zero_of_notMem_tsupport (disjoint_right.1 hω ⟨hxF, hxB⟩), map_zero, mul_zero,
        Pi.zero_apply]
/-- **Simon Ch. 6, Lemma 3.13 (steps 5–7 of the proof)**: an `Hⁿ`-a.e. limit `η` of integer
multiplicity densities `D_q = 1_{N_q} ϑ_q ζ_q` of `IMRep`s `R_q = (N_q, ϑ_q, ζ_q)` in the open `U`,
whose weights `μ_{R_q}(K)` are bounded uniformly in `q` on each compact `K ⊆ U`, is itself the
density of an `IMRep` `R'`, and `R'` acts by `ω ↦ ∫ ⟨ω, η⟩ dHⁿ`.
* `N(ζ) = √|ζ(Lζ)|`, with `L` from `dor_ims_unitOrientation_dual`, is continuous with
  `N(cζ) = c` for unit orientations `ζ` and `c ≥ 0`; so `N(D_q) = 1_{N_q} ϑ_q ∈ ℕ` a.e., and these
  integers are eventually equal to `θ = ⌊N(η̃)⌋` (`η̃` a Borel version of `η`) off a Borel null set.
* `M = (⋃_q N_q) ∩ {θ ≥ 1}` and `ξ = η̃ / θ` on `M`; Fatou bounds `∫_{M ∩ K} θ dHⁿ` by the
  weight bound.
* On `M`, eventually `x ∈ N_q` with `TₓN_q = TₓM` (tangent locality), so `ζ_q(x) = ±e` orients
  `TₓM` and `ζ_q(x) = D_q(x) / θ(x) → ξ(x)`; hence `ξ(x) = ±e` orients `TₓM`.
* `D_{R'} = η` a.e., so the actions agree. -/
theorem Submission.dor_lmb_fc_ims_ae_limit_imrep : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : ℕ → IMRep U n) (η : Euclid P → MultiVector P n), IsOpen U → (∀ᵐ x ∂μHE[n], Tendsto (fun q => (R q).carrier.indicator (fun y => ((R q).mult y : ℝ) • (R q).orient y) x) atTop (𝓝 (η x))) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ q, (R q).measure K ≤ C) → ∃ R' : IMRep U n, (∀ᵐ x ∂μHE[n], R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x = η x) ∧ ∀ ω : DifferentialForm (Euclid P) n, R'.action ω = ∫ x, η x (ω x) ∂μHE[n] := by
  have hIMC := Submission.cmc_imRep_locality_restrict_sub
  have hUOD := Submission.dor_ims_unitOrientation_dual
  have hsign := Submission.rsdic_unitOrientation_eq_or_eq_neg
  intro P n U R η hU hconv hbound
  obtain ⟨L, hL⟩ := hUOD P n
  -- Step 0: the multiplicity functional N(ζ) = √|ζ(Lζ)|
  set N : MultiVector P n → ℝ := fun ζ => Real.sqrt |ζ (L ζ)| with hN
  have hN_cont : Continuous N := by
    have h1 : Continuous fun ζ : MultiVector P n => ζ (L ζ) :=
      isBoundedBilinearMap_apply.continuous.comp (continuous_id.prodMk L.continuous)
    exact Real.continuous_sqrt.comp (continuous_abs.comp h1)
  have hN_smul : ∀ (ζ : MultiVector P n) (Q : Submodule ℝ (Euclid P)) (c : ℝ),
      IsUnitOrientationOf ζ Q → 0 ≤ c → N (c • ζ) = c := by
    intro ζ Q c hζ hc
    have h1 := (hL ζ Q hζ).2.2
    have h2 : (c • ζ) (L (c • ζ)) = c * c := by
      rw [map_smul, smul_apply, map_smul, h1, smul_eq_mul, smul_eq_mul, mul_one]
    simp only [hN, h2]
    rw [abs_of_nonneg (mul_nonneg hc hc), Real.sqrt_mul_self hc]
  have hN_zero : N 0 = 0 := by simp [hN]
  -- densities and integer multiplicities
  set D : ℕ → Euclid P → MultiVector P n := fun q x =>
    (R q).carrier.indicator (fun y => ((R q).mult y : ℝ) • (R q).orient y) x with hD
  set b : ℕ → Euclid P → ℕ := fun q x => (R q).carrier.indicator (R q).mult x with hb
  have hb_meas : ∀ q, Measurable (b q) := fun q =>
    (R q).measurable_mult.indicator (R q).measurableSet_carrier
  have hor : ∀ q, ∀ᵐ x ∂μHE[n], x ∈ (R q).carrier → ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (R q).carrier x Q ∧ IsUnitOrientationOf ((R q).orient x) Q :=
    fun q => (ae_restrict_iff' (R q).measurableSet_carrier).1 (R q).orients
  -- Step 1: N(D_q(x)) = b_q(x) a.e.
  have hND : ∀ q, ∀ᵐ x ∂μHE[n], N (D q x) = (b q x : ℝ) := by
    intro q
    filter_upwards [hor q] with x hx
    by_cases hxM : x ∈ (R q).carrier
    · obtain ⟨Q, -, hQ⟩ := hx hxM
      simp only [hD, hb, Set.indicator_of_mem hxM]
      exact hN_smul _ Q _ hQ (Nat.cast_nonneg _)
    · simp only [hD, hb, Set.indicator_of_notMem hxM, Nat.cast_zero]
      exact hN_zero
  -- Step 2: a Borel version of η
  have hmult_meas : ∀ q, Measurable (fun y => ((R q).mult y : ℝ)) := fun q =>
    measurable_from_nat.comp (R q).measurable_mult
  have hD_meas : ∀ q, AEStronglyMeasurable (D q) μHE[n] := fun q =>
    (aestronglyMeasurable_indicator_iff (R q).measurableSet_carrier).2
      ((hmult_meas q).aestronglyMeasurable.smul (R q).aestronglyMeasurable_orient)
  have hmetr : TopologicalSpace.PseudoMetrizableSpace (MultiVector P n) :=
    @PseudoEMetricSpace.pseudoMetrizableSpace _
      (inferInstance : PseudoEMetricSpace (MultiVector P n))
  have hη_meas : AEStronglyMeasurable η μHE[n] :=
    aestronglyMeasurable_of_tendsto_ae atTop hD_meas hconv
  set ηt := hη_meas.mk η with hηt
  have hηt_sm : StronglyMeasurable ηt := hη_meas.stronglyMeasurable_mk
  have hηt_ae : η =ᵐ[μHE[n]] ηt := hη_meas.ae_eq_mk
  -- Step 3: the good set and a Borel null set Z₀ containing its complement
  set G : Set (Euclid P) := {x | η x = ηt x ∧ Tendsto (fun q => D q x) atTop (𝓝 (η x)) ∧
    ∀ q, N (D q x) = (b q x : ℝ) ∧ (x ∈ (R q).carrier → ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (R q).carrier x Q ∧
        IsUnitOrientationOf ((R q).orient x) Q)} with hG
  have hG_ae : ∀ᵐ x ∂μHE[n], x ∈ G := by
    have h3 := ae_all_iff.2 fun q => (hND q).and (hor q)
    filter_upwards [hηt_ae, hconv, h3] with x h1 h2 h3
    exact ⟨h1, h2, h3⟩
  set Z₀ := toMeasurable μHE[n] Gᶜ with hZ₀
  have hZ₀_meas : MeasurableSet Z₀ := measurableSet_toMeasurable _ _
  have hZ₀_null : μHE[n] Z₀ = 0 := by
    rw [hZ₀, measure_toMeasurable]
    exact hG_ae
  have hgood : ∀ x, x ∉ Z₀ → x ∈ G := fun x hx => by
    by_contra h
    exact hx (subset_toMeasurable _ _ h)
  -- Step 4: integer limits
  have nat_stab : ∀ (c : ℕ → ℕ) (a : ℝ), Tendsto (fun q => (c q : ℝ)) atTop (𝓝 a) →
      ∃ q₀, (∀ q ≥ q₀, c q = c q₀) ∧ a = c q₀ := by
    intro c a h
    obtain ⟨q₀, hq₀⟩ := (Metric.tendsto_atTop.1 h) (1 / 2) (by norm_num)
    have hconst : ∀ q ≥ q₀, c q = c q₀ := by
      intro q hq
      have h1 := hq₀ q hq
      have h2 := hq₀ q₀ le_rfl
      rw [Real.dist_eq] at h1 h2
      have h3 : |(c q : ℝ) - (c q₀ : ℝ)| < 1 := by
        calc |(c q : ℝ) - (c q₀ : ℝ)| = |((c q : ℝ) - a) - ((c q₀ : ℝ) - a)| := by ring_nf
          _ ≤ |(c q : ℝ) - a| + |(c q₀ : ℝ) - a| := abs_sub _ _
          _ < 1 / 2 + 1 / 2 := add_lt_add h1 h2
          _ = 1 := by norm_num
      have h4 : |((c q : ℤ) - (c q₀ : ℤ))| < 1 := by
        have : (((c q : ℤ) - (c q₀ : ℤ) : ℤ) : ℝ) = (c q : ℝ) - (c q₀ : ℝ) := by push_cast; ring
        rw [← Int.cast_lt (R := ℝ), Int.cast_abs, this]
        simpa using h3
      have h5 := Int.abs_lt_one_iff.1 h4
      omega
    refine ⟨q₀, hconst, ?_⟩
    have h5 : Tendsto (fun q => (c q : ℝ)) atTop (𝓝 (c q₀ : ℝ)) := by
      apply tendsto_const_nhds.congr'
      filter_upwards [eventually_ge_atTop q₀] with q hq
      rw [hconst q hq]
    exact tendsto_nhds_unique h h5
  have hstab : ∀ x ∈ G, ∃ q₀, (∀ q ≥ q₀, b q x = b q₀ x) ∧ N (η x) = (b q₀ x : ℝ) := by
    intro x hx
    have h1 : Tendsto (fun q => N (D q x)) atTop (𝓝 (N (η x))) :=
      (hN_cont.tendsto _).comp hx.2.1
    have h2 : Tendsto (fun q => (b q x : ℝ)) atTop (𝓝 (N (η x))) :=
      h1.congr fun q => (hx.2.2 q).1
    exact nat_stab (fun q => b q x) _ h2
  -- the multiplicity θ, the carrier M₊ and the orientation ξ
  set θ : Euclid P → ℕ := Z₀ᶜ.indicator (fun y => ⌊N (ηt y)⌋₊) with hθ
  have hθ_meas : Measurable θ :=
    (Measurable.comp (show Measurable (Nat.floor : ℝ → ℕ) from Nat.floor_mono.measurable)
      (hN_cont.measurable.comp hηt_sm.measurable)).indicator hZ₀_meas.compl
  have hθ_good : ∀ x, x ∉ Z₀ → ∃ q₀, (∀ q ≥ q₀, b q x = θ x) := by
    intro x hx
    obtain ⟨q₀, hq₀, hNη⟩ := hstab x (hgood x hx)
    refine ⟨q₀, fun q hq => ?_⟩
    have h1 : θ x = b q₀ x := by
      simp only [hθ, Set.indicator_of_mem (show x ∈ Z₀ᶜ from hx)]
      rw [← (hgood x hx).1, hNη, Nat.floor_natCast]
    rw [h1, hq₀ q hq]
  set M : Set (Euclid P) := (⋃ q, (R q).carrier) ∩ Z₀ᶜ ∩ {x | 1 ≤ θ x} with hM
  have hM_meas : MeasurableSet M :=
    ((MeasurableSet.iUnion fun q => (R q).measurableSet_carrier).inter hZ₀_meas.compl).inter
      (hθ_meas (MeasurableSet.of_discrete (s := {k : ℕ | 1 ≤ k})))
  have hMU : M ⊆ U := fun x hx => by
    obtain ⟨q, hq⟩ := mem_iUnion.1 hx.1.1
    exact (R q).carrier_subset hq
  set ξ : Euclid P → MultiVector P n := M.indicator (fun x => ((θ x : ℝ))⁻¹ • ηt x) with hξ
  have hθr_meas : Measurable (fun x => ((θ x : ℝ))⁻¹) :=
    (measurable_from_nat.comp hθ_meas : Measurable (fun x => (θ x : ℝ))).inv
  have hξ_sm : StronglyMeasurable ξ :=
    (hθr_meas.stronglyMeasurable.smul hηt_sm).indicator hM_meas
  -- Step 6: Fatou and local finiteness
  have hmeasK : ∀ q (K : Set (Euclid P)), MeasurableSet K →
      (R q).measure K = ∫⁻ x, K.indicator (fun y => (b q y : ℝ≥0∞)) x ∂μHE[n] := by
    intro q K hKm
    have hNm := (R q).measurableSet_carrier
    have h1 : K.indicator (fun y => (b q y : ℝ≥0∞)) =
        (K ∩ (R q).carrier).indicator (fun y => ((R q).mult y : ℝ≥0∞)) := by
      funext y
      by_cases hyK : y ∈ K <;> by_cases hyN : y ∈ (R q).carrier <;> simp [hb, hyK, hyN]
    rw [h1, lintegral_indicator (hKm.inter hNm), IMRep.measure, withDensity_apply _ hKm,
      Measure.restrict_restrict hKm]
  have hM_lint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∫⁻ x in M ∩ K, (θ x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    intro K hK hKU
    obtain ⟨C, hC, hCq⟩ := hbound K hK hKU
    have hKm := hK.measurableSet
    have hpt : ∀ x, (M ∩ K).indicator (fun y => (θ y : ℝ≥0∞)) x ≤
        liminf (fun q => K.indicator (fun y => (b q y : ℝ≥0∞)) x) atTop := by
      intro x
      by_cases hx : x ∈ M ∩ K
      · rw [Set.indicator_of_mem hx]
        obtain ⟨q₀, hq₀⟩ := hθ_good x hx.1.1.2
        have hev : (fun q => K.indicator (fun y => (b q y : ℝ≥0∞)) x) =ᶠ[atTop]
            fun _ => (θ x : ℝ≥0∞) := by
          filter_upwards [eventually_ge_atTop q₀] with q hq
          rw [Set.indicator_of_mem hx.2, hq₀ q hq]
        rw [(tendsto_const_nhds.congr' hev.symm).liminf_eq]
      · rw [Set.indicator_of_notMem hx]
        exact zero_le
    have hlt : ∫⁻ x in M ∩ K, (θ x : ℝ≥0∞) ∂μHE[n] ≤ C := by
      calc ∫⁻ x in M ∩ K, (θ x : ℝ≥0∞) ∂μHE[n]
          = ∫⁻ x, (M ∩ K).indicator (fun y => (θ y : ℝ≥0∞)) x ∂μHE[n] :=
            (lintegral_indicator (hM_meas.inter hKm) _).symm
        _ ≤ ∫⁻ x, liminf (fun q => K.indicator (fun y => (b q y : ℝ≥0∞)) x) atTop ∂μHE[n] :=
            lintegral_mono hpt
        _ ≤ liminf (fun q => ∫⁻ x, K.indicator (fun y => (b q y : ℝ≥0∞)) x ∂μHE[n]) atTop :=
            lintegral_liminf_le fun q =>
              ((measurable_from_nat.comp (hb_meas q) : Measurable (fun y => (b q y : ℝ≥0∞)))).indicator hKm
        _ = liminf (fun q => (R q).measure K) atTop := by
            congr 1
            funext q
            exact (hmeasK q K hKm).symm
        _ ≤ C := liminf_le_of_frequently_le' (Frequently.of_forall hCq)
    exact ne_top_of_le_ne_top hC hlt
  have hNq_fin : ∀ q (K : Set (Euclid P)), IsCompact K → K ⊆ U →
      μHE[n] ((R q).carrier ∩ K) ≠ ∞ := by
    intro q K hK hKU
    refine ne_top_of_le_ne_top ((R q).locallyIntegrable_mult K hK hKU) ?_
    calc μHE[n] ((R q).carrier ∩ K) = ∫⁻ _ in (R q).carrier ∩ K, 1 ∂μHE[n] :=
          (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in (R q).carrier ∩ K, ((R q).mult x : ℝ≥0∞) ∂μHE[n] := by
          apply setLIntegral_mono' ((R q).measurableSet_carrier.inter hK.measurableSet)
          intro x hx
          exact_mod_cast (R q).mult_pos x hx.1
  have hM_fin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M ∩ K) ≠ ∞ := by
    intro K hK hKU
    refine ne_top_of_le_ne_top (hM_lint K hK hKU) ?_
    calc μHE[n] (M ∩ K) = ∫⁻ _ in M ∩ K, 1 ∂μHE[n] := (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in M ∩ K, (θ x : ℝ≥0∞) ∂μHE[n] := by
          apply setLIntegral_mono' (hM_meas.inter hK.measurableSet)
          intro x hx
          exact_mod_cast hx.1.2
  -- Step 7: orientation
  have htan : ∀ q, ∀ᵐ x ∂μHE[n], x ∈ M ∩ (R q).carrier → ∀ Q : Submodule ℝ (Euclid P),
      (HasApproximateTangentSpaceAt n (M ∩ (R q).carrier) x Q ↔
        HasApproximateTangentSpaceAt n (R q).carrier x Q) ∧
      (HasApproximateTangentSpaceAt n (M ∩ (R q).carrier) x Q ↔
        HasApproximateTangentSpaceAt n M x Q) := by
    intro q
    have hMq := hM_meas.inter (R q).measurableSet_carrier
    have h1 := hIMC.1 P n U (M ∩ (R q).carrier) (R q).carrier hU hMq
      (R q).measurableSet_carrier inter_subset_right (R q).carrier_subset (hNq_fin q)
    have h2 := hIMC.1 P n U (M ∩ (R q).carrier) M hU hMq hM_meas inter_subset_left hMU hM_fin
    rw [ae_restrict_iff' hMq] at h1 h2
    filter_upwards [h1, h2] with x hx1 hx2 hx Q
    exact ⟨hx1 hx Q, hx2 hx Q⟩
  have htan' := ae_all_iff.2 htan
  have horients : ∀ᵐ x ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf (ξ x) Q := by
    rw [ae_restrict_iff' hM_meas]
    filter_upwards [htan'] with x hx hxM
    have hxZ : x ∉ Z₀ := hxM.1.2
    have hxG := hgood x hxZ
    obtain ⟨q₀, hq₀⟩ := hθ_good x hxZ
    have hθpos : 1 ≤ θ x := hxM.2
    have hmem : ∀ q ≥ q₀, x ∈ (R q).carrier ∧ (R q).mult x = θ x := by
      intro q hq
      have h1 := hq₀ q hq
      by_cases hxq : x ∈ (R q).carrier
      · refine ⟨hxq, ?_⟩
        simpa [hb, hxq] using h1
      · exfalso
        simp only [hb, Set.indicator_of_notMem hxq] at h1
        omega
    have hTq : ∀ q ≥ q₀, ∃ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf ((R q).orient x) Q := by
      intro q hq
      have hxq := (hmem q hq).1
      obtain ⟨Q, hQT, hQu⟩ := (hxG.2.2 q).2 hxq
      refine ⟨Q, ?_, hQu⟩
      have h := hx q ⟨hxM, hxq⟩ Q
      exact h.2.1 (h.1.2 hQT)
    obtain ⟨Q, hQT, hQu⟩ := hTq q₀ le_rfl
    set e := (R q₀).orient x with he
    have hpm : ∀ q ≥ q₀, (R q).orient x ∈ ({e, -e} : Set (MultiVector P n)) := by
      intro q hq
      obtain ⟨Q', hQ'T, hQ'u⟩ := hTq q hq
      have hQQ' : Q' = Q := hQ'T.unique hQT
      rw [hQQ'] at hQ'u
      rcases hsign P n e ((R q).orient x) Q hQu hQ'u with h | h
      · exact Or.inl h
      · exact Or.inr h
    have hθx0 : (θ x : ℝ) ≠ 0 := by
      have : θ x ≠ 0 := by omega
      exact_mod_cast this
    have hlim : Tendsto (fun q => (R q).orient x) atTop (𝓝 (ξ x)) := by
      have h1 : Tendsto (fun q => ((θ x : ℝ))⁻¹ • D q x) atTop (𝓝 (((θ x : ℝ))⁻¹ • η x)) :=
        hxG.2.1.const_smul _
      have h2 : ξ x = ((θ x : ℝ))⁻¹ • η x := by
        simp only [hξ, Set.indicator_of_mem hxM, hxG.1]
      rw [h2]
      refine h1.congr' ?_
      filter_upwards [eventually_ge_atTop q₀] with q hq
      obtain ⟨hxq, hmq⟩ := hmem q hq
      simp only [hD, Set.indicator_of_mem hxq, hmq, smul_smul, inv_mul_cancel₀ hθx0, one_smul]
    have hclosed : IsClosed ({e, -e} : Set (MultiVector P n)) :=
      (Set.toFinite _).isClosed
    have hξmem : ξ x ∈ ({e, -e} : Set (MultiVector P n)) :=
      hclosed.mem_of_tendsto hlim (eventually_atTop.2 ⟨q₀, hpm⟩)
    refine ⟨Q, hQT, ?_⟩
    rcases hξmem with h | h
    · rw [h]
      exact hQu
    · rw [Set.mem_singleton_iff.1 h]
      obtain ⟨τ, hτ, hspan, hs⟩ := hQu
      refine ⟨τ, hτ, hspan, ?_⟩
      rcases hs with hs | hs
      · right
        intro α
        rw [neg_apply, hs α]
      · left
        intro α
        rw [neg_apply, hs α, neg_neg]
  -- Step 8: the IMRep
  let R' : IMRep U n :=
    { carrier := M
      mult := θ
      orient := ξ
      measurableSet_carrier := hM_meas
      carrier_subset := hMU
      rectifiable := (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion _
        fun q => (R q).rectifiable).mono fun x hx => hx.1.1
      measurable_mult := hθ_meas
      mult_pos := fun x hx => hx.2
      locallyIntegrable_mult := hM_lint
      aestronglyMeasurable_orient := hξ_sm.aestronglyMeasurable
      orients := horients }
  -- Step 9: the density of R' is η a.e., and the action formula
  have hdens : ∀ᵐ x ∂μHE[n], M.indicator (fun y => (θ y : ℝ) • ξ y) x = η x := by
    have hZ := measure_eq_zero_iff_ae_notMem.1 hZ₀_null
    filter_upwards [hZ] with x hxZ
    have hxG := hgood x hxZ
    by_cases hxM : x ∈ M
    · have hθ1 : 1 ≤ θ x := hxM.2
      have hθx0 : (θ x : ℝ) ≠ 0 := by
        have : θ x ≠ 0 := by omega
        exact_mod_cast this
      simp only [Set.indicator_of_mem hxM, hξ, smul_smul, mul_inv_cancel₀ hθx0, one_smul]
      exact hxG.1.symm
    · rw [Set.indicator_of_notMem hxM]
      obtain ⟨q₀, hq₀⟩ := hθ_good x hxZ
      have hzero : ∀ q ≥ q₀, D q x = 0 := by
        intro q hq
        by_cases hxq : x ∈ (R q).carrier
        · exfalso
          apply hxM
          refine ⟨⟨mem_iUnion.2 ⟨q, hxq⟩, hxZ⟩, ?_⟩
          show 1 ≤ θ x
          rw [← hq₀ q hq]
          simp only [hb, Set.indicator_of_mem hxq]
          exact (R q).mult_pos x hxq
        · simp only [hD, Set.indicator_of_notMem hxq]
      have h5 : Tendsto (fun q => D q x) atTop (𝓝 0) := by
        apply tendsto_const_nhds.congr'
        filter_upwards [eventually_ge_atTop q₀] with q hq
        rw [hzero q hq]
      exact tendsto_nhds_unique h5 hxG.2.1
  refine ⟨R', hdens, fun ω => ?_⟩
  show ∫ x in M, (θ x : ℝ) * ξ x (ω x) ∂μHE[n] = ∫ x, η x (ω x) ∂μHE[n]
  rw [← integral_indicator hM_meas]
  apply integral_congr_ae
  filter_upwards [hdens] with x hx
  rw [← hx]
  by_cases hxM : x ∈ M
  · simp only [Set.indicator_of_mem hxM, smul_apply, smul_eq_mul]
  · simp only [Set.indicator_of_notMem hxM, zero_apply]

/-- **Simon Ch. 6, Lemma 3.13 (p. 149), for the partial sums of a mass-summable series.**  If
`X_r ∈ 𝒟ₙ(U)` (`n = m + 1`, `U` open) are integer multiplicity with `Σ_r M(X_r) < ∞`, then
`Y(ω) = Σ_r X_r(ω)` is an integer multiplicity current with `M(Y) ≤ Σ_r M(X_r)`.
Write `X_r = τ(M_r, θ_r, ξ_r)`; by 3.2(3), `M(X_r) = μ_{X_r}(U)`, so the densities
`η_r = 1_{M_r} θ_r ξ_r` sum `Hⁿ`-a.e. to some `η` with `Σ_r X_r(ω) = ∫ ⟨ω, η⟩ dHⁿ`.  The partial
sums `Σ_{r<q} η_r` are `Hⁿ`-a.e. the densities of triples `R'_q` with `μ_{R'_q} ≤ Σ_{r<q} μ_{X_r}`;
they converge to `η` with locally bounded masses, so `η` is the density of a triple `(M₊, θ, ξ)`
and `Y = τ(M₊, θ, ξ)`.  An admissible `ω` has `Y(ω) = Σ_r X_r(ω) ≤ Σ_r M(X_r)`. -/
theorem Submission.dor_lmb_fc_im_series : ∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass := by
  intro P m U X hU hX hfin
  -- Step 2: triples `R_r = (M_r, θ_r, ξ_r)` with `X_r = τ(R_r)`; `M(X_r) = μ_{R_r}(U)` (3.2(3))
  have hX' : ∀ r, ∃ R : IMRep U (m + 1), R.Represents (X r) := hX
  choose R hR using hX'
  have hmass : ∀ r, (X r).mass = (R r).measure U := fun r =>
    (Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) U (X r) (R r) hU (hR r)).1 U hU
  have hfin' : ∑' r, (R r).measure U ≠ ∞ := by simpa only [hmass] using hfin
  -- `η = Σ_r 1_{M_r} θ_r ξ_r` converges `Hⁿ`-a.e., and `Σ_r X_r(ω) = ∫ ⟨ω, η⟩ dHⁿ`
  obtain ⟨η, hη, hηω⟩ := Submission.dor_lmb_fc_ims_density_series P (m + 1) U R hfin'
  -- Steps 3–4: the partial sums `Y_q = Σ_{r<q} X_r` are represented by triples `R'_q` with
  -- density `Σ_{r<q} 1_{M_r} θ_r ξ_r` `Hⁿ`-a.e. and `μ_{R'_q} ≤ Σ_{r<q} μ_{R_r}`
  choose R' hR'η hR'μ using Submission.dor_lmb_fc_ims_partial_sum_reps P (m + 1) U R hU
  -- the densities of the `R'_q` converge to `η` `Hⁿ`-a.e.
  have hconv : ∀ᵐ x ∂μHE[m + 1], Tendsto (fun q => (R' q).carrier.indicator
      (fun y => ((R' q).mult y : ℝ) • (R' q).orient y) x) atTop (𝓝 (η x)) := by
    filter_upwards [hη, ae_all_iff.2 hR'η] with x hx hx'
    exact hx.tendsto_sum_nat.congr fun q => (hx' q).symm
  -- `μ_{R'_q}(K) ≤ Σ_{r<q} μ_{R_r}(U) ≤ Σ_r μ_{R_r}(U) < ∞` for compact `K ⊆ U`
  have hbound : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ q, (R' q).measure K ≤ C := by
    intro K _ hKU
    refine ⟨∑' r, (R r).measure U, hfin', fun q => ?_⟩
    calc (R' q).measure K ≤ (∑ r ∈ Finset.range q, (R r).measure) K :=
          Measure.le_iff'.1 (hR'μ q) K
      _ = ∑ r ∈ Finset.range q, (R r).measure K := Measure.finsetSum_apply _ _ _
      _ ≤ ∑ r ∈ Finset.range q, (R r).measure U :=
          Finset.sum_le_sum fun r _ => measure_mono hKU
      _ ≤ ∑' r, (R r).measure U := ENNReal.sum_le_tsum _
  -- Steps 5–7: a triple `R★ = (M₊, θ, ξ)` with density `η`, so `τ(R★)(ω) = ∫ ⟨ω, η⟩ dHⁿ`
  obtain ⟨Rs, -, hRs⟩ :=
    Submission.dor_lmb_fc_ims_ae_limit_imrep P (m + 1) U R' η hU hconv hbound
  -- `Y = τ(R★)`: the restriction of `R★` to `E = ℝᴾ` represents a current `Y`
  obtain ⟨Y, R₀, hY, hcar, hmult, hor⟩ :=
    Submission.cmc_imRep_locality_restrict_sub.2.1 P (m + 1) U Rs univ hU MeasurableSet.univ
  have hYω : ∀ ω : TestFormOn U (m + 1),
      Y ω = ∫ x, η x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] := by
    intro ω
    rw [hY ω, ← hRs (ω : DifferentialForm (Euclid P) (m + 1))]
    simp only [IMRep.action, hcar, hmult, hor, inter_univ]
  -- Step 1: `Σ_r X_r(ω) = Σ_r τ(R_r)(ω)` converges to `∫ ⟨ω, η⟩ dHⁿ = Y(ω)`
  have hsum : ∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω) := by
    intro ω
    have hXR : (fun r => X r ω) =
        fun r => (R r).action (ω : DifferentialForm (Euclid P) (m + 1)) := funext fun r => hR r ω
    rw [hXR, hYω ω]
    exact hηω ω
  refine ⟨Y, ⟨R₀, hY⟩, hsum, ?_⟩
  -- Step 1: for admissible `ω`, `X_r(ω) ≤ M(X_r) < ∞`, so `Y(ω) = Σ_r X_r(ω) ≤ Σ_r M(X_r)`
  have hne : ∀ r, (X r).mass ≠ ∞ := ENNReal.ne_top_of_tsum_ne_top hfin
  refine sSup_le ?_
  rintro _ ⟨ω, hω, rfl⟩
  show ENNReal.ofReal (Y ω) ≤ ∑' r, (X r).mass
  rw [ENNReal.ofReal_le_iff_le_toReal hfin, ENNReal.tsum_toReal_eq hne]
  exact hasSum_le (fun r => (ENNReal.ofReal_le_iff_le_toReal (hne r)).1 ((X r).le_massOn hω))
    (hsum ω) (ENNReal.summable_toReal hfin).hasSum

/-- **Lipschitz push-forward of a finite-mass integer multiplicity triple** (Simon Ch. 6,
3.3–3.9 with Remark 2.24 and Lemma 2.29).  For `R = (M, θ, ξ)` with `μ_R(ℝᴺ) < ∞` there is
`F ↦ Y(F)` with `Y(F)` integer multiplicity for Lipschitz `F`, `R(Fⱼ^#ω) → Y(F)(ω)` for
`C¹` maps `Fⱼ → F` uniformly with a common Lipschitz constant, and `Y(F) = Y(F')` when
`F = F'` `Hᵏ`-a.e. on `M`.
* `k = 0`: `dor_lmb_fcd_imp_degree_zero`.
* `k = d ≥ 1`: `dor_lmb_fcd_imp_parametric_rep` gives `Gᵢ`, `Bᵢ`, integer `wᵢ` with
  `R(γ) = ∑ᵢ ∫_{Bᵢ} wᵢ γ(Gᵢ)(DGᵢ e)` for bounded continuous `γ` and
  `∑ᵢ mᵢ ≤ μ_R(ℝᴺ)`, `mᵢ = ∫⁻_{Bᵢ} |wᵢ| J_{Gᵢ}`.  For Lipschitz `F`, (IMS) and (IMC) give the
  integer multiplicity `Y(F)` of `dor_lmb_fcd_imp_image_series_im` with
  `Y(F)(ω) = ∑ᵢ Tᵢ(F)(ω)`, `Tᵢ(F)(ω) = ∫_{Bᵢ} wᵢ ω(F ∘ Gᵢ)(D(F ∘ Gᵢ) e)`; `Y(F) = 0` otherwise.
* Limit: `Fⱼ^#ω` is continuous and bounded by `sup |ω| Λᵈ`, and the chain rule on `Bᵢ` gives
  `R(Fⱼ^#ω) = ∑ᵢ Tᵢ(Fⱼ)(ω)`; `Tᵢ(Fⱼ)(ω) → Tᵢ(F)(ω)` by the weak continuity of pulled-back forms
  (`dor_lmb_fcd_jacobian_weak_continuity`), and `|Tᵢ(Fⱼ)(ω)| ≤ c Λᵈ mᵢ` is summable, so dominated
  convergence for series (the counting measure) gives `R(Fⱼ^#ω) → Y(F)(ω)`.
* Locality: `F ∘ Gᵢ = F' ∘ Gᵢ` a.e. on `Bᵢ` (pull-back of `Hᵏ⌞M`-null sets), hence
  `D(F ∘ Gᵢ) = D(F' ∘ Gᵢ)` a.e. on `Bᵢ` (`dor_lmb_fcd_imp_lipschitz_jacobian_locality`), so
  `Tᵢ(F) = Tᵢ(F')` and `Y(F) = Y(F')`. -/
theorem Submission.dor_lmb_fcd_im_pushforward : (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ∀ (N N' k : ℕ) (R : IMRep (univ : Set (Euclid N)) k), R.measure univ ≠ ∞ → ∃ Y : (Euclid N → Euclid N') → GeometricCurrentOn (univ : Set (Euclid N')) k, (∀ (F : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → IsIntegerMultiplicity (Y F) ∧ ∀ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ 1 (Fs j)) → (∀ j, LipschitzWith Λ (Fs j)) → TendstoUniformly Fs F atTop → ∀ ω : TestFormOn (univ : Set (Euclid N')) k, Tendsto (fun j => R.action (fun x => ((ω : DifferentialForm (Euclid N') k) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x))) atTop (𝓝 (Y F ω))) ∧ ∀ (F F' : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → LipschitzWith Λ F' → (∀ᵐ x ∂(μHE[k].restrict R.carrier), F x = F' x) → Y F = Y F' := by
  intro hIMS N N' k R hR
  obtain _ | k := k
  · exact Submission.dor_lmb_fcd_imp_degree_zero N N' R hR
  -- the parametric representation `R(γ) = ∑ᵢ ∫_{Bᵢ} wᵢ γ(Gᵢ)(DGᵢ e)`, `∑ᵢ mᵢ ≤ μ_R(ℝᴺ) < ∞`
  obtain ⟨G, B, w, hGlip, hBm, hGd, hwm, hwZ, hw0, hwi, hsum, hact, hpull⟩ :=
    Submission.dor_lmb_fcd_imp_parametric_rep N (k + 1) R hR
  choose L hL using hGlip
  have hfin := ne_top_of_le_ne_top hR hsum
  -- `Y(F)`: the integer multiplicity sum `∑ᵢ Tᵢ(F)` for Lipschitz `F`, and `0` otherwise
  have hex : ∀ F : Euclid N → Euclid N', ∃ Y : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1),
      ∀ Λ : NNReal, LipschitzWith Λ F → IsIntegerMultiplicity Y ∧
        ∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), HasSum (fun i => ∫ u in B i, w i u *
          (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)
            (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))) (Y ω) := by
    intro F
    by_cases hF : ∃ Λ : NNReal, LipschitzWith Λ F
    · obtain ⟨Λ, hΛ⟩ := hF
      obtain ⟨Y, hYIM, hYω, -⟩ := Submission.dor_lmb_fcd_imp_image_series_im hIMS
        Submission.cmc_imRep_locality_restrict_sub N N' k G B w F Λ (fun i => ⟨L i, hL i⟩) hBm
        hGd hwm hwZ hw0 hwi hfin hΛ
      exact ⟨Y, fun _ _ => ⟨hYIM, hYω⟩⟩
    · exact ⟨0, fun Λ hΛ => absurd ⟨Λ, hΛ⟩ hF⟩
  choose Y hY using hex
  refine ⟨Y, fun F Λ hF => ⟨(hY F Λ hF).1, ?_⟩, ?_⟩
  · intro Fs hFs hFsL hFsU ω
    have hωc : Continuous (ω : DifferentialForm (Euclid N') (k + 1)) := ω.property.1.1.continuous
    obtain ⟨C, hC⟩ := HasCompactSupport.exists_bound_of_continuous ω.property.1.2 hωc
    -- `Tᵢ(Fⱼ)(ω)`, `Tᵢ(F)(ω)` and `mᵢ`
    let f : ℕ → ℕ → ℝ := fun j i => ∫ u in B i, w i u *
      (ω : DifferentialForm (Euclid N') (k + 1)) ((Fs j ∘ G i) u)
        (fun a => fderiv ℝ (Fs j ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))
    let g : ℕ → ℝ := fun i => ∫ u in B i, w i u *
      (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)
        (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))
    let m : ℕ → ℝ := fun i => (∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det
      (Matrix.of fun a b : Fin (k + 1) =>
        inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))
          (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ))))))).toReal
    -- (a) `R(Fⱼ^#ω) = ∑ᵢ Tᵢ(Fⱼ)(ω)`: `Fⱼ^#ω` is continuous and bounded, and on `Bᵢ`
    -- `(Fⱼ^#ω)(Gᵢ)(DGᵢ e) = ω(Fⱼ ∘ Gᵢ)(D(Fⱼ ∘ Gᵢ) e)` by the chain rule
    have htr : ∀ j, HasSum (f j) (R.action (fun x =>
        ((ω : DifferentialForm (Euclid N') (k + 1)) (Fs j x)).compContinuousLinearMap
          (fderiv ℝ (Fs j) x))) := by
      intro j
      have hγc : Continuous (fun x =>
          ((ω : DifferentialForm (Euclid N') (k + 1)) (Fs j x)).compContinuousLinearMap
            (fderiv ℝ (Fs j) x)) :=
        (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp
          ((hFs j).continuous_fderiv one_ne_zero)).clm_apply (hωc.comp (hFs j).continuous)
      have hγb : ∃ C' : ℝ, ∀ x,
          ‖((ω : DifferentialForm (Euclid N') (k + 1)) (Fs j x)).compContinuousLinearMap
            (fderiv ℝ (Fs j) x)‖ ≤ C' := by
        refine ⟨C * (Λ : ℝ) ^ (k + 1), fun x => ?_⟩
        refine (ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _).trans ?_
        rw [Fintype.card_fin]
        exact mul_le_mul (hC _)
          (pow_le_pow_left₀ (norm_nonneg _) (norm_fderiv_le_of_lipschitz ℝ (hFsL j)) _)
          (by positivity) ((norm_nonneg _).trans (hC 0))
      convert hact _ hγc hγb using 1
      funext i
      refine setIntegral_congr_fun (hBm i) fun u hu => ?_
      rw [fderiv_comp u ((hFs j).differentiable one_ne_zero (G i u)) (hGd i u hu)]
      rfl
    -- (b) `Tᵢ(Fⱼ)(ω) → Tᵢ(F)(ω)`: weak continuity of pulled-back forms
    have hterm : ∀ i, Tendsto (fun j => f j i) atTop (𝓝 (g i)) := fun i =>
      Submission.dor_lmb_fcd_jacobian_weak_continuity (k + 1) N' (B i) (w i) (Λ * L i)
        (fun j => Fs j ∘ G i) (F ∘ G i) ω (hBm i) (hwi i) (fun j => (hFsL j).comp (hL i))
        (hF.comp (hL i)) (hFsU.comp (G i))
    -- (c) `|Tᵢ(Fⱼ)(ω)| ≤ c Λᵈ mᵢ` with `c > sup |ω|`
    have hcont : Continuous fun α : Covector (Euclid N') (k + 1) => covectorEuclideanNorm α := by
      unfold covectorEuclideanNorm
      refine Real.continuous_sqrt.comp (continuous_finsetSum _ fun I _ => ?_)
      split_ifs
      · exact (continuous_eval_const _).pow 2
      · exact continuous_const
    obtain ⟨c, hc⟩ := (hcont.comp hωc).bounded_above_of_compact_support
      (ω.property.1.2.comp_left (covectorEuclideanNorm_zero N' (k + 1)))
    have hc' : ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) x) ≤
        max c 0 + 1 := by
      intro x
      have := hc x
      rw [Function.comp_apply, Real.norm_of_nonneg (covectorEuclideanNorm_nonneg _)] at this
      linarith [le_max_left c 0]
    have hbd : ∀ j i, ‖f j i‖ ≤ (max c 0 + 1) * (Λ : ℝ) ^ (k + 1) * m i := by
      intro j
      obtain ⟨-, -, -, hb⟩ := Submission.dor_lmb_fcd_imp_image_series_im hIMS
        Submission.cmc_imRep_locality_restrict_sub N N' k G B w (Fs j) Λ (fun i => ⟨L i, hL i⟩)
        hBm hGd hwm hwZ hw0 hwi hfin (hFsL j)
      intro i
      rw [Real.norm_eq_abs]
      exact hb ω _ (by positivity) hc' i
    have hbs : Summable fun i => (max c 0 + 1) * (Λ : ℝ) ^ (k + 1) * m i :=
      (ENNReal.summable_toReal hfin).mul_left _
    -- (d) dominated convergence for series, via the counting measure on `ℕ`
    have hbi : Integrable (fun i => (max c 0 + 1) * (Λ : ℝ) ^ (k + 1) * m i) Measure.count := by
      rw [integrable_count_iff]
      refine hbs.congr fun i => ?_
      exact (Real.norm_of_nonneg ((norm_nonneg _).trans (hbd 0 i))).symm
    have hfi : ∀ j, Integrable (f j) Measure.count := fun j =>
      hbi.mono' (measurable_of_countable _).aestronglyMeasurable (ae_of_all _ (hbd j))
    have hgi : Integrable g Measure.count :=
      hbi.mono' (measurable_of_countable _).aestronglyMeasurable (ae_of_all _ fun i =>
        le_of_tendsto (tendsto_norm.comp (hterm i)) (Eventually.of_forall fun j => hbd j i))
    have hlim := tendsto_integral_of_dominated_convergence _
      (fun j => (hfi j).aestronglyMeasurable) hbi (fun j => ae_of_all _ (hbd j))
      (ae_of_all _ hterm)
    have e1 : ∀ j, ∫ i, f j i ∂Measure.count = R.action (fun x =>
        ((ω : DifferentialForm (Euclid N') (k + 1)) (Fs j x)).compContinuousLinearMap
          (fderiv ℝ (Fs j) x)) := by
      intro j
      rw [integral_countable (hfi j)]
      simp only [count_real_singleton, one_smul]
      exact (htr j).tsum_eq
    have e2 : ∫ i, g i ∂Measure.count = Y F ω := by
      rw [integral_countable hgi]
      simp only [count_real_singleton, one_smul]
      exact ((hY F Λ hF).2 ω).tsum_eq
    rw [e2] at hlim
    exact hlim.congr e1
  · -- locality: `F ∘ Gᵢ = F' ∘ Gᵢ` and `D(F ∘ Gᵢ) = D(F' ∘ Gᵢ)` a.e. on `Bᵢ`
    intro F F' Λ hF hF' hae
    ext ω
    refine ((hY F Λ hF).2 ω).unique ?_
    convert (hY F' Λ hF').2 ω using 1
    funext i
    have h1 : ∀ᵐ u ∂(volume.restrict (B i)), (F ∘ G i) u = (F' ∘ G i) u :=
      hpull (fun x => F x = F' x) hae i
    have h2 := (Submission.dor_lmb_fcd_imp_lipschitz_jacobian_locality).2 (k + 1) N' (F ∘ G i)
      (F' ∘ G i) (B i) (Λ * L i) (Λ * L i) (hF.comp (hL i)) (hF'.comp (hL i)) (hBm i) h1
    refine integral_congr_ae ?_
    filter_upwards [h1, h2] with u hu1 hu2
    rw [hu1, hu2]

/-- **Shells along the level sets of `f`** (Simon Ch. 6, proof of the Deformation Theorem 5.1:
the shells `T_ρ − T_{ρ/2}` of (8)–(13), here cut along the level sets of `f`).  Let
`T = τ(M, θ, ξ)` vanish off the closed set `K`, `∂T = τ(M', θ', ξ')`, and let
`Zⱼ = ∂(T⌞{f < rⱼ}) − (∂T)⌞{f < rⱼ}` (the slice `⟨T, f, rⱼ−⟩` of 4.6), i.e.
`Zⱼ(ω) = ∫_{M ∩ {f < rⱼ}} θ⟨dω, ξ⟩ dHᵐ⁺¹ − ∫_{M' ∩ {f < rⱼ}} θ'⟨ω, ξ'⟩ dHᵐ`.  The shells
`Wⱼ = T⌞Sⱼ`, `Dⱼ = (∂T)⌞Sⱼ` (`S₀ = {f ≥ r₀}`, `Sⱼ₊₁ = {rⱼ₊₁ ≤ f < rⱼ}`) and `A_N = T⌞{f < r_N}`
are integer multiplicity with masses `μ_T(Sⱼ)`, `μ_{∂T}(Sⱼ)` and `μ_T({f < r_N})`.  Splitting the
integrals over `M` and `M'` along `{f < rⱼ}` gives `∂W₀ = D₀ − Z₀`, `∂Wⱼ₊₁ = Dⱼ₊₁ + Zⱼ − Zⱼ₊₁`
and `Σ_{j ≤ N} Wⱼ = T − A_N`.  `Wⱼ`, `Dⱼ` and (by induction on `j`, as `Eⱼ ⊆ Eⱼ₊₁` for antitone
`r`) `Zⱼ` vanish off `Eⱼ = K ∩ {f ≥ rⱼ}`. -/
theorem Submission.dor_lmb_fcd_sd_shells : ∀ (P m : ℕ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (RT : IMRep (univ : Set (Euclid P)) (m + 1)) (RB : IMRep (univ : Set (Euclid P)) m) (K : Set (Euclid P)) (f : Euclid P → ℝ) (r : ℕ → ℝ) (Z : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) m), RT.Represents T → RB.Represents T.boundary → IsClosed K → Continuous f → Antitone r → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (K) → T ω = 0) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), Z j ω = (∫ x in RT.carrier ∩ {x | f x < r j}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) m) x) ∂μHE[m + 1]) - ∫ x in RB.carrier ∩ {x | f x < r j}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m]) → ∃ (W A : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (D : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) m), (∀ j, IsIntegerMultiplicity (W j)) ∧ (∀ j, IsIntegerMultiplicity (D j)) ∧ (∀ j (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (K ∩ {x | r j ≤ f x}) → W j ω = 0) ∧ (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (K ∩ {x | r j ≤ f x}) → D j ω = 0) ∧ (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (K ∩ {x | r j ≤ f x}) → Z j ω = 0) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) m, (W 0).boundary ω = D 0 ω - Z 0 ω) ∧ (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), (W (j + 1)).boundary ω = D (j + 1) ω + Z j ω - Z (j + 1) ω) ∧ (∀ N (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), ∑ j ∈ Finset.range (N + 1), W j ω = T ω - A N ω) ∧ (W 0).mass = RT.measure {x | r 0 ≤ f x} ∧ (∀ j, (W (j + 1)).mass = RT.measure {x | r (j + 1) ≤ f x ∧ f x < r j}) ∧ (D 0).mass = RB.measure {x | r 0 ≤ f x} ∧ (∀ j, (D (j + 1)).mass = RB.measure {x | r (j + 1) ≤ f x ∧ f x < r j}) ∧ ∀ N, (A N).mass = RT.measure {x | f x < r N} := by
  intro P m T RT RB K f r Z hRT hRB hK hf hr hTK hZ
  -- Step 1: `∂T` vanishes off `K`, because `spt dω ⊆ spt ω`
  have hbK : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) K → T.boundary ω = 0 := by
    intro ω hω
    rw [GeometricCurrentOn.boundary_apply]
    exact hTK _
      (hω.mono_left (tsupport_exteriorDerivative_subset (ω : DifferentialForm (Euclid P) m)))
  -- Step 2 (im_restrict (A)): `g_ω = θ⟨dω, ξ⟩` and `k_η = θ⟨η, ξ⟩` are integrable on `M`,
  -- `h_ω = θ'⟨ω, ξ'⟩` on `M'`
  obtain ⟨hintT, hresT⟩ := Submission.dor_lmb_fcd_sd_im_restrict P (m + 1) RT
  obtain ⟨hintB, hresB⟩ := Submission.dor_lmb_fcd_sd_im_restrict P m RB
  have hg : ∀ ω : TestFormOn (univ : Set (Euclid P)) m, IntegrableOn (fun x => (RT.mult x : ℝ) *
      RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) m) x)) RT.carrier
        μHE[m + 1] :=
    fun ω => hintT _ (exteriorDerivative_isTestForm ω.property.1)
  have hh : ∀ ω : TestFormOn (univ : Set (Euclid P)) m, IntegrableOn (fun x => (RB.mult x : ℝ) *
      RB.orient x ((ω : DifferentialForm (Euclid P) m) x)) RB.carrier μHE[m] :=
    fun ω => hintB _ ω.property.1
  have hk : ∀ η : TestFormOn (univ : Set (Euclid P)) (m + 1), IntegrableOn (fun x =>
      (RT.mult x : ℝ) * RT.orient x ((η : DifferentialForm (Euclid P) (m + 1)) x)) RT.carrier
        μHE[m + 1] :=
    fun η => hintT _ η.property.1
  -- Step 3: `T(η) = ∫_M k_η` and `∂T(ω) = T(dω) = ∫_M g_ω = ∫_{M'} h_ω`
  have hTη : ∀ η : TestFormOn (univ : Set (Euclid P)) (m + 1), T η = ∫ x in RT.carrier,
      (RT.mult x : ℝ) * RT.orient x ((η : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] :=
    hRT
  have hbT : ∀ ω : TestFormOn (univ : Set (Euclid P)) m, T.boundary ω = ∫ x in RT.carrier,
      (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) m) x)
        ∂μHE[m + 1] :=
    fun ω => hRT (exteriorDerivativeTestOn univ m ω)
  have hbB : ∀ ω : TestFormOn (univ : Set (Euclid P)) m, T.boundary ω = ∫ x in RB.carrier,
      (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] :=
    hRB
  -- Step 4: splitting integrals along the (Borel) level sets of the continuous `f`
  have hle : ∀ a : ℝ, MeasurableSet {x | a ≤ f x} := fun a =>
    measurableSet_le measurable_const hf.measurable
  have hlt : ∀ a : ℝ, MeasurableSet {x | f x < a} := fun a =>
    measurableSet_lt hf.measurable measurable_const
  have hband : ∀ a b : ℝ, MeasurableSet {x | a ≤ f x ∧ f x < b} := fun a b =>
    (hle a).inter (hlt b)
  -- (i) `∫_{G ∩ {a ≤ f}} u = ∫_G u − ∫_{G ∩ {f < a}} u`
  have split₁ : ∀ (μ : Measure (Euclid P)) (G : Set (Euclid P)) (u : Euclid P → ℝ) (a : ℝ),
      IntegrableOn u G μ → ∫ x in G ∩ {x | a ≤ f x}, u x ∂μ =
        (∫ x in G, u x ∂μ) - ∫ x in G ∩ {x | f x < a}, u x ∂μ := by
    intro μ G u a hu
    have h := integral_inter_add_sdiff (hle a) hu
    have hd : G \ {x | a ≤ f x} = G ∩ {x | f x < a} := by
      ext x
      simp only [Set.mem_sdiff, mem_inter_iff, mem_ofPred_eq, not_le]
    rw [hd] at h
    linarith
  -- (ii) for `b ≤ a`, `∫_{G ∩ {b ≤ f < a}} u = ∫_{G ∩ {f < a}} u − ∫_{G ∩ {f < b}} u`
  have split₂ : ∀ (μ : Measure (Euclid P)) (G : Set (Euclid P)) (u : Euclid P → ℝ) (a b : ℝ),
      b ≤ a → IntegrableOn u G μ → ∫ x in G ∩ {x | b ≤ f x ∧ f x < a}, u x ∂μ =
        (∫ x in G ∩ {x | f x < a}, u x ∂μ) - ∫ x in G ∩ {x | f x < b}, u x ∂μ := by
    intro μ G u a b hba hu
    have h := integral_inter_add_sdiff (hlt b)
      (hu.mono_set inter_subset_left : IntegrableOn u (G ∩ {x | f x < a}) μ)
    have h₁ : G ∩ {x | f x < a} ∩ {x | f x < b} = G ∩ {x | f x < b} := by
      ext x
      simp only [mem_inter_iff, mem_ofPred_eq]
      exact ⟨fun hx => ⟨hx.1.1, hx.2⟩, fun hx => ⟨⟨hx.1, hx.2.trans_le hba⟩, hx.2⟩⟩
    have h₂ : (G ∩ {x | f x < a}) \ {x | f x < b} = G ∩ {x | b ≤ f x ∧ f x < a} := by
      ext x
      simp only [Set.mem_sdiff, mem_inter_iff, mem_ofPred_eq, not_lt]
      exact ⟨fun hx => ⟨hx.1.1, hx.2, hx.1.2⟩, fun hx => ⟨⟨hx.1, hx.2.2⟩, hx.2.1⟩⟩
    rw [h₁, h₂] at h
    linarith
  -- Step 5 (im_restrict (B)): the restrictions `T⌞B` and `(∂T)⌞B` to Borel sets `B`, which are
  -- integer multiplicity, have mass `μ_T(B)`, `μ_{∂T}(B)` and vanish off `K ∩ B`
  choose YT hYT_im hYT_eq hYT_mass hYT_van using
    fun (B : Set (Euclid P)) (hB : MeasurableSet B) => hresT T K B hRT hK hTK hB
  choose YB hYB_im hYB_eq hYB_mass hYB_van using
    fun (B : Set (Euclid P)) (hB : MeasurableSet B) => hresB T.boundary K B hRB hK hbK hB
  obtain ⟨W, hW0, hWs⟩ : ∃ W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
      W 0 = YT {x | r 0 ≤ f x} (hle (r 0)) ∧
        ∀ j, W (j + 1) = YT {x | r (j + 1) ≤ f x ∧ f x < r j} (hband _ _) :=
    ⟨fun j => Nat.casesOn j (YT {x | r 0 ≤ f x} (hle (r 0)))
      fun i => YT {x | r (i + 1) ≤ f x ∧ f x < r i} (hband _ _), rfl, fun _ => rfl⟩
  obtain ⟨D, hD0, hDs⟩ : ∃ D : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) m,
      D 0 = YB {x | r 0 ≤ f x} (hle (r 0)) ∧
        ∀ j, D (j + 1) = YB {x | r (j + 1) ≤ f x ∧ f x < r j} (hband _ _) :=
    ⟨fun j => Nat.casesOn j (YB {x | r 0 ≤ f x} (hle (r 0)))
      fun i => YB {x | r (i + 1) ≤ f x ∧ f x < r i} (hband _ _), rfl, fun _ => rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
      ∀ N, A N = YT {x | f x < r N} (hlt (r N)) :=
    ⟨fun N => YT {x | f x < r N} (hlt (r N)), fun _ => rfl⟩
  -- Step 6: `Wⱼ` and `Dⱼ` vanish off `Eⱼ = K ∩ {rⱼ ≤ f}`, which contains `K ∩ Sⱼ`
  have hWv : ∀ j (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (K ∩ {x | r j ≤ f x}) →
        W j ω = 0 := by
    rintro (_ | j) ω hω
    · rw [hW0]
      exact hYT_van _ _ ω hω
    · rw [hWs]
      exact hYT_van _ _ ω (hω.mono_right (inter_subset_inter_right K fun x hx => hx.1))
  have hDv : ∀ j (ω : TestFormOn (univ : Set (Euclid P)) m),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (K ∩ {x | r j ≤ f x}) →
        D j ω = 0 := by
    rintro (_ | j) ω hω
    · rw [hD0]
      exact hYB_van _ _ ω hω
    · rw [hDs]
      exact hYB_van _ _ ω (hω.mono_right (inter_subset_inter_right K fun x hx => hx.1))
  -- Step 7: `∂W₀(ω) = ∫_M g_ω − ∫_{M ∩ {f < r₀}} g_ω = D₀(ω) − Z₀(ω)`
  have hbW0 : ∀ ω : TestFormOn (univ : Set (Euclid P)) m, (W 0).boundary ω = D 0 ω - Z 0 ω := by
    intro ω
    have e₁ : (W 0).boundary ω = ∫ x in RT.carrier ∩ {x | r 0 ≤ f x}, (RT.mult x : ℝ) *
        RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) m) x) ∂μHE[m + 1] := by
      rw [GeometricCurrentOn.boundary_apply, hW0, hYT_eq]
      rfl
    have e₂ : D 0 ω = ∫ x in RB.carrier ∩ {x | r 0 ≤ f x}, (RB.mult x : ℝ) *
        RB.orient x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
      rw [hD0, hYB_eq]
    rw [e₁, e₂, hZ 0 ω, split₁ _ _ _ (r 0) (hg ω), split₁ _ _ _ (r 0) (hh ω)]
    linarith [hbT ω, hbB ω]
  -- Step 8: `∂Wⱼ₊₁(ω) = ∫_{M ∩ {f < rⱼ}} g_ω − ∫_{M ∩ {f < rⱼ₊₁}} g_ω = Dⱼ₊₁(ω) + Zⱼ(ω) − Zⱼ₊₁(ω)`
  have hbWs : ∀ j (ω : TestFormOn (univ : Set (Euclid P)) m),
      (W (j + 1)).boundary ω = D (j + 1) ω + Z j ω - Z (j + 1) ω := by
    intro j ω
    have hrj : r (j + 1) ≤ r j := hr (Nat.le_succ j)
    have e₁ : (W (j + 1)).boundary ω = ∫ x in RT.carrier ∩ {x | r (j + 1) ≤ f x ∧ f x < r j},
        (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) m) x)
          ∂μHE[m + 1] := by
      rw [GeometricCurrentOn.boundary_apply, hWs, hYT_eq]
      rfl
    have e₂ : D (j + 1) ω = ∫ x in RB.carrier ∩ {x | r (j + 1) ≤ f x ∧ f x < r j},
        (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
      rw [hDs, hYB_eq]
    rw [e₁, e₂, hZ j ω, hZ (j + 1) ω, split₂ _ _ _ (r j) (r (j + 1)) hrj (hg ω),
      split₂ _ _ _ (r j) (r (j + 1)) hrj (hh ω)]
    ring
  -- Step 9: `Σ_{j ≤ N} Wⱼ = T − A_N`, by induction on `N`
  have hsum : ∀ N (η : TestFormOn (univ : Set (Euclid P)) (m + 1)),
      ∑ j ∈ Finset.range (N + 1), W j η = T η - A N η := by
    intro N η
    induction N with
    | zero =>
      rw [Finset.sum_range_one, hW0, hA, hYT_eq, hYT_eq, hTη, split₁ _ _ _ (r 0) (hk η)]
    | succ N ih =>
      rw [Finset.sum_range_succ, ih, hWs, hA, hA, hYT_eq, hYT_eq, hYT_eq,
        split₂ _ _ _ (r N) (r (N + 1)) (hr (Nat.le_succ N)) (hk η)]
      ring
  -- Step 10: `Zⱼ` vanishes off `Eⱼ`, by induction on `j` (`Eⱼ ⊆ Eⱼ₊₁` as `r` is antitone)
  have hZv : ∀ j (ω : TestFormOn (univ : Set (Euclid P)) m),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (K ∩ {x | r j ≤ f x}) →
        Z j ω = 0 := by
    intro j
    induction j with
    | zero =>
      intro ω hω
      have h₁ : (W 0).boundary ω = 0 := by
        rw [GeometricCurrentOn.boundary_apply]
        exact hWv 0 _ (hω.mono_left
          (tsupport_exteriorDerivative_subset (ω : DifferentialForm (Euclid P) m)))
      linarith [hbW0 ω, hDv 0 ω hω]
    | succ j ih =>
      intro ω hω
      have h₁ : (W (j + 1)).boundary ω = 0 := by
        rw [GeometricCurrentOn.boundary_apply]
        exact hWv (j + 1) _ (hω.mono_left
          (tsupport_exteriorDerivative_subset (ω : DifferentialForm (Euclid P) m)))
      have h₂ : Z j ω = 0 := ih ω (hω.mono_right (inter_subset_inter_right K
        fun x hx => (hr (Nat.le_succ j)).trans hx))
      linarith [hbWs j ω, hDv (j + 1) ω hω]
  -- Step 11: integrality and masses of the shells (im_restrict (B))
  refine ⟨W, A, D, ?_, ?_, hWv, hDv, hZv, hbW0, hbWs, hsum, ?_, fun j => ?_, ?_, fun j => ?_,
    fun N => ?_⟩
  · rintro (_ | j)
    · rw [hW0]
      exact hYT_im _ _
    · rw [hWs]
      exact hYT_im _ _
  · rintro (_ | j)
    · rw [hD0]
      exact hYB_im _ _
    · rw [hDs]
      exact hYB_im _ _
  · rw [hW0]
    exact hYT_mass _ _
  · rw [hWs]
    exact hYT_mass _ _
  · rw [hD0]
    exact hYB_mass _ _
  · rw [hDs]
    exact hYB_mass _ _
  · rw [hA]
    exact hYT_mass _ _
/-- **Jacobian minors of a Lipschitz map**: for an `L`-Lipschitz `v : ℝᵐ → ℝᵖ`, rows
`a : Fin r → Fin p` and columns `b : Fin r → Fin m`, the minor
`M(u) = det ((Dv(u) e_{b t})_{a s})_{s,t}` is Borel measurable in `u` and `|M(u)| ≤ r! Lʳ`.
`u ↦ Dv(u)` is measurable and `A ↦ det ((A e_{b t})_{a s})` is continuous; every entry is bounded
by `‖Dv(u)‖ ≤ L`, and the Leibniz formula has `r!` terms of absolute value at most `Lʳ`. -/
theorem Submission.cmcdt_lpi_pc_minor_measurable_bound : ∀ (m p r : ℕ) (L : NNReal) (v : Euclid m → Euclid p) (a : Fin r → Fin p) (b : Fin r → Fin m), LipschitzWith L v → Measurable (fun u => Matrix.det (Matrix.of fun s t => fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s))) ∧ ∀ u, |Matrix.det (Matrix.of fun s t => fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s))| ≤ (r.factorial : ℝ) * (L : ℝ) ^ r := by
  intro m p r L v a b hv
  constructor
  · -- `u ↦ Dv(u)` is measurable and `A ↦ det ((A e_{b t})_{a s})` is continuous
    have hcont : Continuous fun A : Euclid m →L[ℝ] Euclid p =>
        Matrix.det (Matrix.of fun s t => A (EuclideanSpace.single (b t) 1) (a s)) := by
      refine Continuous.matrix_det (continuous_matrix fun s t => ?_)
      exact (continuous_apply (a s)).comp
        ((PiLp.continuous_ofLp 2 _).comp (continuous_eval_const _))
    exact hcont.measurable.comp (measurable_fderiv ℝ v)
  · intro u
    -- entry bound `|(Dv(u) e_{b t})_{a s}| ≤ ‖Dv(u)‖ ≤ L`
    have hentry : ∀ s t, |fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s)| ≤ (L : ℝ) := by
      intro s t
      calc |fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s)|
          = ‖fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s)‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖fderiv ℝ v u (EuclideanSpace.single (b t) 1)‖ := PiLp.norm_apply_le _ _
        _ ≤ ‖fderiv ℝ v u‖ * ‖EuclideanSpace.single (b t) (1 : ℝ)‖ := (fderiv ℝ v u).le_opNorm _
        _ = ‖fderiv ℝ v u‖ := by simp
        _ ≤ L := norm_fderiv_le_of_lipschitz ℝ hv
    -- Leibniz formula: `r!` terms, each of absolute value at most `Lʳ`
    rw [Matrix.det_apply]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ σ : Equiv.Perm (Fin r), |Equiv.Perm.sign σ • ∏ i, Matrix.of
            (fun s t => fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s)) (σ i) i|
        ≤ ∑ _σ : Equiv.Perm (Fin r), (L : ℝ) ^ r := by
          refine Finset.sum_le_sum fun σ _ => ?_
          rw [Units.smul_def, zsmul_eq_mul, abs_mul, Finset.abs_prod]
          have hsign : |((Equiv.Perm.sign σ : ℤ) : ℝ)| = 1 := by
            rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
          rw [hsign, one_mul]
          calc ∏ i, |Matrix.of (fun s t => fderiv ℝ v u (EuclideanSpace.single (b t) 1) (a s))
                (σ i) i|
              ≤ ∏ _i : Fin r, (L : ℝ) :=
                Finset.prod_le_prod₀ (fun i _ => abs_nonneg _) fun i _ => hentry _ _
            _ = (L : ℝ) ^ r := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ = (r.factorial : ℝ) * (L : ℝ) ^ r := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
/-- Projection reduction for the constant-planes step of the cycle case of closure and boundary
rectifiability: if an `n`-vector `ζ` (`n = d + 1`) vanishes on every `n`-covector `w♭ ∧ α` with
`w ∈ Vᗮ` and `α` a `d`-covector, then `ζ(β) = ζ(β ∘ p_V)` for every `n`-covector `β`, where `p_V`
is the orthogonal projection onto `V`.  Take an orthonormal basis `e` of `ℝᴾ` with each `eᵢ` in
`V` or in `Vᗮ` (subordinate to `ℝᴾ = V ⊕ Vᗮ`) and the covectors `e^I(u) = det(⟨e_{I b}, u_a⟩)`,
`I : Fin n → Fin P` (`cbr_ci_cp_pr_inner_det_covector`), so that `n! β = ∑_I β(e_I) e^I`
(`cbr_ci_cp_pr_factorial_mul_eq_sum_det`).  If `e_{I k} ∈ Vᗮ` for some `k`, Laplace expansion along
column `k` writes `e^I = e_{I k}♭ ∧ α` (`cbr_ci_cp_pr_det_covector_laplace`), so `ζ(e^I) = 0`;
otherwise `p_V e_{I b} = e_{I b}` for every `b`, and `β ∘ p_V` has the same coefficient `β(e_I)`. -/
theorem Submission.cbr_ci_cp_eval_comp_starProjection_eq : ∀ (P d : ℕ) (ζ : MultiVector P (d + 1)) (V : Submodule ℝ (Euclid P)), (∀ w ∈ Vᗮ, ∀ (α : Covector (Euclid P) d) (γ : Covector (Euclid P) (d + 1)), (∀ u : Fin (d + 1) → Euclid P, γ u = ∑ i : Fin (d + 1), (-1 : ℝ) ^ (i : ℕ) * (inner ℝ w (u i) * α (i.removeNth u))) → ζ γ = 0) → ∀ β : Covector (Euclid P) (d + 1), ζ β = ζ (β.compContinuousLinearMap V.starProjection) := by
  have hdet := Submission.cbr_ci_cp_pr_inner_det_covector
  have hlap := Submission.cbr_ci_cp_pr_det_covector_laplace
  have hexp := Submission.cbr_ci_cp_pr_factorial_mul_eq_sum_det
  intro P d ζ V hζ β
  -- Step 1: an orthonormal basis of `ℝᴾ` subordinate to `ℝᴾ = V ⊕ Vᗮ`
  obtain ⟨e, he⟩ : ∃ e : OrthonormalBasis (Fin P) ℝ (Euclid P), ∀ i, e i ∈ V ∨ e i ∈ Vᗮ := by
    have hV' := V.orthogonalFamily_self
    have hint : DirectSum.IsInternal (fun b : Bool => cond b V Vᗮ) := by
      refine DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hV'.independent ?_
      rw [iSup_bool_eq]
      exact Submodule.sup_orthogonal_of_hasOrthogonalProjection
    refine ⟨hint.subordinateOrthonormalBasis finrank_euclideanSpace_fin hV', fun i => ?_⟩
    have hi := hint.subordinateOrthonormalBasis_subordinate finrank_euclideanSpace_fin i hV'
    revert hi
    cases hint.subordinateOrthonormalBasisIndex finrank_euclideanSpace_fin i hV'
    · exact Or.inr
    · exact Or.inl
  -- Step 2: the determinant covectors `e^I(u) = det(⟨e_{I b}, u_a⟩)`
  choose γ hγ using fun I : Fin (d + 1) → Fin P => hdet P (d + 1) fun b => e (I b)
  -- Step 3: `(d+1)! ζ(β') = ∑_I β'(e_I) ζ(e^I)` for every `(d+1)`-covector `β'`
  have hsum : ∀ β' : Covector (Euclid P) (d + 1), ((d + 1).factorial : ℝ) * ζ β' =
      ∑ I : Fin (d + 1) → Fin P, β' (fun a => e (I a)) * ζ (γ I) := by
    intro β'
    have hcov : ((d + 1).factorial : ℝ) • β' =
        ∑ I : Fin (d + 1) → Fin P, β' (fun a => e (I a)) • γ I := by
      ext u
      rw [ContinuousAlternatingMap.smul_apply, ContinuousAlternatingMap.sum_apply, smul_eq_mul,
        hexp P (d + 1) e β' u]
      refine Finset.sum_congr rfl fun I _ => ?_
      rw [ContinuousAlternatingMap.smul_apply, smul_eq_mul, hγ]
    have := congrArg ζ hcov
    rw [map_smul, map_sum, smul_eq_mul] at this
    rw [this]
    simp only [map_smul, smul_eq_mul]
  -- Step 4: `ζ(e^I) = 0` if some `e_{I k} ∈ Vᗮ` (Laplace expansion along column `k`)
  have hkill : ∀ (I : Fin (d + 1) → Fin P) (k : Fin (d + 1)), e (I k) ∈ Vᗮ → ζ (γ I) = 0 := by
    intro I k hk
    obtain ⟨α, hα⟩ := hlap P d (fun b => e (I b)) k (γ I) (hγ I)
    exact hζ (e (I k)) hk α (γ I) hα
  -- Step 5: `β ∘ p_V` and `β` agree on `e_I` if every `e_{I b} ∈ V`
  have hcoef : ∀ I : Fin (d + 1) → Fin P, (∀ b, e (I b) ∈ V) →
      β.compContinuousLinearMap V.starProjection (fun a => e (I a)) = β (fun a => e (I a)) := by
    intro I hI
    rw [ContinuousAlternatingMap.compContinuousLinearMap_apply]
    congr 1
    funext a
    exact Submodule.starProjection_eq_self_iff.mpr (hI a)
  -- Step 6: compare the two expansions term by term
  have hfact : ((d + 1).factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  apply mul_left_cancel₀ hfact
  rw [hsum β, hsum (β.compContinuousLinearMap V.starProjection)]
  refine Finset.sum_congr rfl fun I _ => ?_
  by_cases hI : ∀ b, e (I b) ∈ V
  · rw [hcoef I hI]
  · obtain ⟨k, hk⟩ := not_forall.mp hI
    rw [hkill I k ((he (I k)).resolve_left hk), mul_zero, mul_zero]
/-- `(2M+1)^r` lattice points of a subspace `V ⊆ ℝᴾ` of dimension `r`, pairwise at distance
`≥ 2` and of norm `≤ 2M√r` (the packing step of the growth bound for the dimension of `V`).
For an orthonormal basis `e` of `V`, `c ↦ Σⱼ cⱼ eⱼ` is a linear isometry `ℓ²(ℝʳ) ≃ V`; take
`u_k = 2 Σⱼ kⱼ eⱼ` for `k` in the box `([−M, M] ∩ ℤ)ʳ`.  Distinct integer vectors differ by
`≥ 1` in some coordinate, so `‖u_k − u_l‖ ≥ 2`, and `‖u_k‖² = Σⱼ (2kⱼ)² ≤ r(2M)²`. -/
theorem Submission.cbr_ci_cp_gd_subspace_lattice_packing : ∀ (P : ℕ) (V : Submodule ℝ (Euclid P)) (M : ℕ), ∃ S : Finset (Euclid P), S.card = (2 * M + 1) ^ Module.finrank ℝ V ∧ (∀ x ∈ S, x ∈ V) ∧ (∀ x ∈ S, ‖x‖ ≤ 2 * M * Real.sqrt (Module.finrank ℝ V)) ∧ (∀ x ∈ S, ∀ y ∈ S, x ≠ y → 2 ≤ dist x y) := by
  intro P V M
  classical
  -- orthonormal coordinates `e.repr.symm : ℓ²(ℝʳ) ≃ₗᵢ V` and the points `u_k = e.repr.symm (2k)`
  let e := stdOrthonormalBasis ℝ V
  let c : (Fin (Module.finrank ℝ V) → ℤ) → EuclideanSpace ℝ (Fin (Module.finrank ℝ V)) :=
    fun k => WithLp.toLp 2 fun j => 2 * (k j : ℝ)
  let u : (Fin (Module.finrank ℝ V) → ℤ) → Euclid P := fun k => (e.repr.symm (c k) : Euclid P)
  have hnorm : ∀ k, ‖u k‖ = ‖c k‖ := fun k => by
    simp only [u, Submodule.norm_coe, LinearIsometryEquiv.norm_map]
  have hdist : ∀ k l, dist (u k) (u l) = dist (c k) (c l) := fun k l => by
    simp only [dist_eq_norm, u, ← Submodule.coe_sub, ← map_sub, Submodule.norm_coe,
      LinearIsometryEquiv.norm_map]
  -- distinct integer vectors give points at distance `≥ 2`
  have hsep : ∀ k l, k ≠ l → 2 ≤ dist (u k) (u l) := by
    intro k l hkl
    obtain ⟨j, hj⟩ := Function.ne_iff.mp hkl
    have h1 : (1 : ℝ) ≤ |(k j : ℝ) - l j| := by
      rw [← Int.cast_sub, ← Int.cast_abs]
      exact_mod_cast Int.one_le_abs (sub_ne_zero.mpr hj)
    calc (2 : ℝ) ≤ dist (c k j) (c l j) := by
          simp only [c, Real.dist_eq, ← mul_sub, abs_mul, abs_two]
          linarith
      _ ≤ dist (c k) (c l) := PiLp.dist_apply_le _ _ _
      _ = dist (u k) (u l) := (hdist k l).symm
  have hinj : Function.Injective u := fun k l hkl => by
    by_contra h
    have := hsep k l h
    rw [hkl, dist_self] at this
    norm_num at this
  -- the box `Λ_M = ([−M, M] ∩ ℤ)ʳ`
  refine ⟨(Fintype.piFinset fun _ => Finset.Icc (-(M : ℤ)) M).image u, ?_, ?_, ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ hinj, Fintype.card_piFinset, Int.card_Icc,
      Fin.prod_const]
    congr 1
    omega
  · simp only [Finset.mem_image]
    rintro x ⟨k, -, rfl⟩
    exact (e.repr.symm (c k)).2
  · simp only [Finset.mem_image, Fintype.mem_piFinset, Finset.mem_Icc]
    rintro x ⟨k, hk, rfl⟩
    rw [hnorm]
    have hM : (0 : ℝ) ≤ 2 * M * Real.sqrt (Module.finrank ℝ V) := by positivity
    refine (pow_le_pow_iff_left₀ (norm_nonneg _) hM two_ne_zero).mp ?_
    rw [EuclideanSpace.norm_sq_eq, mul_pow, Real.sq_sqrt (Nat.cast_nonneg _)]
    calc ∑ j, ‖c k j‖ ^ 2 ≤ ∑ _j : Fin (Module.finrank ℝ V), (2 * (M : ℝ)) ^ 2 := by
          refine Finset.sum_le_sum fun j _ => ?_
          rw [Real.norm_eq_abs, sq_abs]
          have hkj : -(M : ℝ) ≤ k j ∧ (k j : ℝ) ≤ M :=
            ⟨by exact_mod_cast (hk j).1, by exact_mod_cast (hk j).2⟩
          simp only [c]
          nlinarith [hkj.1, hkj.2]
      _ = (2 * M) ^ 2 * Module.finrank ℝ V := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_comm]
  · simp only [Finset.mem_image]
    rintro x ⟨k, -, rfl⟩ y ⟨l, -, rfl⟩ hxy
    exact hsep k l fun h => hxy (h ▸ rfl)
/-- Packing count for unit balls translated along a subspace `V` (used in the proof of Simon 7.2.4,
p. 184, to show that a measure with `ν(B_R(0)) ≤ C Rⁿ` that is invariant under the translations of
`V` has `dim V ≤ n`): if `ν` is invariant under translation by every `v ∈ V`, and `S ⊆ V` is finite
with `‖x‖ ≤ ρ` for `x ∈ S` and `dist x y ≥ 2` for distinct `x, y ∈ S`, then
`#S · ν(B_1(0)) ≤ ν(B_{ρ+1}(0))`.  Each `B_1(x) = {y : -x + y ∈ B_1(0)}` has measure `ν(B_1(0))`
(as `-x ∈ V`), and these balls are pairwise disjoint (triangle inequality) and lie in
`B_{ρ+1}(0)`. -/
theorem Submission.cbr_ci_cp_gd_translated_ball_count : ∀ (P : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (S : Finset (Euclid P)) (ρ : ℝ), (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => v + x) ⁻¹' A) = ν A) → (∀ x ∈ S, x ∈ V) → (∀ x ∈ S, ‖x‖ ≤ ρ) → (∀ x ∈ S, ∀ y ∈ S, x ≠ y → 2 ≤ dist x y) → (S.card : ℝ≥0∞) * ν (ball 0 1) ≤ ν (ball 0 (ρ + 1)) := by
  intro P ν V S ρ hinv hSV hSρ hsep
  -- equal mass: `B_1(x)` is the preimage of `B_1(0)` under `y ↦ -x + y`, and `-x ∈ V`
  have hmass : ∀ x ∈ S, ν (ball x 1) = ν (ball 0 1) := by
    intro x hx
    have hpre : (fun y => -x + y) ⁻¹' ball (0 : Euclid P) 1 = ball x 1 := by
      ext y
      simp only [mem_preimage, mem_ball_iff_norm, sub_zero, neg_add_eq_sub]
    rw [← hpre]
    exact hinv (-x) (V.neg_mem (hSV x hx)) _ measurableSet_ball
  -- disjointness: a common point `z` would give `2 ≤ dist x y ≤ dist z x + dist z y < 2`
  have hdisj : (S : Set (Euclid P)).PairwiseDisjoint fun x => ball x 1 := by
    intro x hx y hy hxy
    refine Set.disjoint_left.mpr fun z hzx hzy => ?_
    rw [mem_ball] at hzx hzy
    linarith [hsep x hx y hy hxy, dist_triangle_left x y z]
  -- containment: `‖z‖ ≤ ‖x‖ + ‖z - x‖ < ρ + 1`
  have hsub : (⋃ x ∈ S, ball x 1) ⊆ ball (0 : Euclid P) (ρ + 1) := by
    refine iUnion₂_subset fun x hx z hz => ?_
    rw [mem_ball_iff_norm] at hz
    rw [mem_ball_zero_iff]
    linarith [hSρ x hx, norm_le_norm_add_norm_sub' z x]
  -- counting: `#S · ν(B_1(0)) = Σ_{x ∈ S} ν(B_1(x)) = ν(⋃_{x ∈ S} B_1(x)) ≤ ν(B_{ρ+1}(0))`
  calc (S.card : ℝ≥0∞) * ν (ball 0 1) = ∑ x ∈ S, ν (ball x 1) := by
        rw [Finset.sum_congr rfl hmass, Finset.sum_const, nsmul_eq_mul]
    _ = ν (⋃ x ∈ S, ball x 1) :=
        (measure_biUnion_finset hdisj fun x _ => measurableSet_ball).symm
    _ ≤ ν (ball 0 (ρ + 1)) := measure_mono hsub
/-- Final step of the growth-forces-dimension argument in the proof of Simon 7.2.4 (packing
`(2M+1)ʳ` disjoint unit balls of an `r`-plane into `B_{3M√r}(0)`): if `a > 0` and
`a·Mʳ ≤ b·Mⁿ` for every integer `M ≥ 1`, then `r ≤ n`.  Otherwise `n + 1 ≤ r`; the Archimedean
property gives `N > b/a`, and `M = N + 1` has `a·M > b`, while
`a·M·Mⁿ = a·Mⁿ⁺¹ ≤ a·Mʳ ≤ b·Mⁿ` gives `a·M ≤ b` after cancelling `Mⁿ > 0`. -/
theorem Submission.cbr_ci_cp_gd_le_of_pow_bound : ∀ (r n : ℕ) (a b : ℝ), 0 < a → (∀ M : ℕ, 1 ≤ M → a * (M : ℝ) ^ r ≤ b * (M : ℝ) ^ n) → r ≤ n := by
  intro r n a b ha h
  -- suppose `n + 1 ≤ r`
  by_contra hrn
  have hr : n + 1 ≤ r := Nat.lt_iff_add_one_le.mp (not_le.mp hrn)
  -- Archimedean choice `N > b / a`; `M := N + 1 ≥ 1` has `a * M > b`
  obtain ⟨N, hN⟩ := exists_nat_gt (b / a)
  have hM : (1 : ℝ) ≤ ((N + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.le_add_left 1 N
  have hbM : b < ((N + 1 : ℕ) : ℝ) * a := by
    rw [← div_lt_iff₀ ha]
    push_cast
    linarith
  -- `a * M * Mⁿ = a * Mⁿ⁺¹ ≤ a * Mʳ ≤ b * Mⁿ`, then cancel `Mⁿ > 0`
  have hle : a * ((N + 1 : ℕ) : ℝ) * ((N + 1 : ℕ) : ℝ) ^ n ≤ b * ((N + 1 : ℕ) : ℝ) ^ n :=
    calc a * ((N + 1 : ℕ) : ℝ) * ((N + 1 : ℕ) : ℝ) ^ n = a * ((N + 1 : ℕ) : ℝ) ^ (n + 1) := by
          ring
      _ ≤ a * ((N + 1 : ℕ) : ℝ) ^ r := mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hM hr) ha.le
      _ ≤ b * ((N + 1 : ℕ) : ℝ) ^ n := h (N + 1) (Nat.le_add_left 1 N)
  have hMa := le_of_mul_le_mul_right hle (pow_pos (zero_lt_one.trans_le hM) n)
  linarith

/-- **Growth forces `dim V ≤ n`** (step 4 of the constant-planes argument, with `ωₙ` replaced by an
arbitrary finite constant `C`).  Let `r = dim V` and `m₀ = ν(B₁(0))`, so `0 < m₀ ≤ C < ∞` (growth at
`R = 1`).  Fix `M ≥ 1`.  The sibling `lattice_packing` gives `(2M+1)ʳ` points of `V` of norm
`≤ 2M√r` with pairwise distances `≥ 2`; by the sibling `ball_count` (translation invariance and
disjointness of their unit balls) and the growth bound at `R = 2M√r + 1`,
`(2M+1)ʳ m₀ ≤ ν(B_{2M√r+1}(0)) ≤ C (2M√r+1)ⁿ`.  As `M ≤ 2M+1` and `2M√r + 1 ≤ (2√r+1)M`, this gives
`m₀ Mʳ ≤ C (2√r+1)ⁿ Mⁿ` for every `M ≥ 1`, and the sibling `pow_bound` yields `r ≤ n`. -/
theorem Submission.cbr_ci_cp_finrank_le_of_growth : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (C : ℝ≥0∞), C ≠ ∞ → (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => v + x) ⁻¹' A) = ν A) → (∀ R : ℝ, 0 < R → ν (ball 0 R) ≤ C * ENNReal.ofReal (R ^ n)) → 0 < ν (ball 0 1) → Module.finrank ℝ V ≤ n := by
  intro P n ν V C hC hinv hgrowth hpos
  -- Step 1: `m₀ = ν(B₁(0))` is finite, by the growth bound at `R = 1`
  have hfin : ν (ball 0 1) ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top hC ENNReal.ofReal_ne_top) (hgrowth 1 one_pos)
  -- Step 2: by the sibling `pow_bound` it suffices that `m₀ Mʳ ≤ C (2√r+1)ⁿ Mⁿ` for all `M ≥ 1`
  refine Submission.cbr_ci_cp_gd_le_of_pow_bound (Module.finrank ℝ V) n (ν (ball 0 1)).toReal
    (C.toReal * (2 * Real.sqrt (Module.finrank ℝ V) + 1) ^ n)
    (ENNReal.toReal_pos hpos.ne' hfin) fun M hM => ?_
  -- Step 3: `(2M+1)ʳ` points of `V` of norm `≤ 2M√r`, pairwise `2`-separated (`lattice_packing`)
  obtain ⟨S, hcard, hSV, hSnorm, hSsep⟩ := Submission.cbr_ci_cp_gd_subspace_lattice_packing P V M
  -- Step 4: `(2M+1)ʳ m₀ ≤ ν(B_{2M√r+1}(0)) ≤ C (2M√r+1)ⁿ` (`ball_count`, then growth)
  have hρ : 0 ≤ 2 * (M : ℝ) * Real.sqrt (Module.finrank ℝ V) := by positivity
  have hle := (Submission.cbr_ci_cp_gd_translated_ball_count P ν V S _ hinv hSV hSnorm hSsep).trans
    (hgrowth (2 * M * Real.sqrt (Module.finrank ℝ V) + 1) (by linarith))
  have hpow : 0 ≤ (2 * (M : ℝ) * Real.sqrt (Module.finrank ℝ V) + 1) ^ n := by positivity
  have hreal := ENNReal.toReal_mono (ENNReal.mul_ne_top hC ENNReal.ofReal_ne_top) hle
  rw [ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal hpow, hcard,
    ENNReal.toReal_natCast] at hreal
  push_cast at hreal
  -- Step 5: `Mʳ ≤ (2M+1)ʳ` and `2M√r + 1 ≤ (2√r+1)M`, since `M ≥ 1`
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have h1 : (M : ℝ) ^ Module.finrank ℝ V ≤ (2 * M + 1) ^ Module.finrank ℝ V :=
    pow_le_pow_left₀ (by positivity) (by linarith) _
  have h2 : (2 * M * Real.sqrt (Module.finrank ℝ V) + 1) ^ n ≤
      (2 * Real.sqrt (Module.finrank ℝ V) + 1) ^ n * (M : ℝ) ^ n := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (by positivity)
      (by nlinarith [Real.sqrt_nonneg (Module.finrank ℝ V : ℝ)]) _
  calc (ν (ball 0 1)).toReal * (M : ℝ) ^ Module.finrank ℝ V
      ≤ (2 * M + 1) ^ Module.finrank ℝ V * (ν (ball 0 1)).toReal := by
        rw [mul_comm]
        exact mul_le_mul_of_nonneg_right h1 ENNReal.toReal_nonneg
    _ ≤ C.toReal * (2 * M * Real.sqrt (Module.finrank ℝ V) + 1) ^ n := hreal
    _ ≤ C.toReal * ((2 * Real.sqrt (Module.finrank ℝ V) + 1) ^ n * (M : ℝ) ^ n) :=
        mul_le_mul_of_nonneg_left h2 ENNReal.toReal_nonneg
    _ = C.toReal * (2 * Real.sqrt (Module.finrank ℝ V) + 1) ^ n * (M : ℝ) ^ n := by ring

/-- **Covectors vanish through a rank-deficient projection** (Simon Ch. 6, §1): if
`dim V < n`, then `β ∘ p_V = 0` for every `n`-covector `β` on `ℝᴾ`, `p_V` the orthogonal
projection onto `V`.  For any `u₁, …, uₙ` the `n` vectors `p_V u₁, …, p_V uₙ` lie in `V`, so they
are linearly dependent, and the alternating form `β` vanishes on a linearly dependent family. -/
theorem Submission.cbr_ci_cp_comp_starProjection_eq_zero_of_finrank_lt : ∀ (P n : ℕ) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V < n → ∀ β : Covector (Euclid P) n, β.compContinuousLinearMap V.starProjection = 0 := by
  intro P n V hlt β
  -- Step 1: it suffices that `β(p_V u₁, …, p_V uₙ) = 0` for every family `u`
  ext u
  rw [ContinuousAlternatingMap.compContinuousLinearMap_apply, ContinuousAlternatingMap.coe_zero,
    Pi.zero_apply]
  -- Step 2: an alternating form vanishes on a family that is not linearly independent
  apply β.toAlternatingMap.map_linearDependent
  -- Step 3: `p_V ∘ u = V.subtype ∘ v` with `vᵢ := p_V uᵢ ∈ V`; were it independent, so would be
  -- the `n` vectors `vᵢ` of `V`, giving `n ≤ dim V < n`
  intro hli
  have hli' : LinearIndependent ℝ (fun i => V.orthogonalProjectionOnto (u i)) := by
    apply LinearIndependent.of_comp V.subtype
    exact hli
  have hcard := hli'.fintype_card_le_finrank
  rw [Fintype.card_fin] at hcard
  omega
/-- **An orthonormal frame spanning a subspace** (Simon 6.1.1; the frame `τ` of
`IsUnitOrientationOf`): an `n`-dimensional subspace `V` of `ℝᴾ` is `span{v₀, …, vₙ₋₁}` for an
orthonormal `v : Fin n → ℝᴾ`.  Reindex the orthonormal basis `stdOrthonormalBasis ℝ V` along
`finrank ℝ V = n` to `b : Fin n → V` and put `vᵢ = ↑bᵢ`; the inclusion `V → ℝᴾ` is a linear
isometry, so `v` is orthonormal, and `span (range v)` is the image of `span (range b) = ⊤` under
the inclusion, i.e. `V`. -/
theorem Submission.cbr_ci_cp_exists_orthonormal_frame_of_finrank_eq : ∀ (P n : ℕ) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → ∃ v : Fin n → Euclid P, Orthonormal ℝ v ∧ Submodule.span ℝ (Set.range v) = V := by
  intro P n V hV
  -- Step 1: an orthonormal basis `b` of `V` indexed by `Fin n`
  let b : OrthonormalBasis (Fin n) ℝ V := (stdOrthonormalBasis ℝ V).reindex (finCongr hV)
  refine ⟨fun i => (b i : Euclid P), ?_, ?_⟩
  · -- Step 2: `vᵢ = ↑bᵢ` is orthonormal, the inclusion `V.subtypeₗᵢ` being a linear isometry
    exact b.orthonormal.comp_linearIsometry V.subtypeₗᵢ
  · -- Step 3: `span (range v) = map V.subtype (span (range b)) = map V.subtype ⊤ = V`
    have hrange : Set.range (fun i => (b i : Euclid P)) = (V.subtype) '' Set.range b := by
      rw [← Set.range_comp]; rfl
    have hb : Submodule.span ℝ (Set.range b) = ⊤ := by
      simpa [OrthonormalBasis.coe_toBasis] using b.toBasis.span_eq
    rw [hrange, Submodule.span_image, hb, Submodule.map_top, Submodule.range_subtype]
/-- **Reversing an orthonormal frame by negating its first vector** (Simon 6.1; the sign in
`ζ = ±v₀ ∧ ⋯ ∧ v_d`): for orthonormal `v₀, …, v_d` in `ℝᴾ`, `w = (-v₀, v₁, …, v_d)` is
orthonormal with the same span, and `β(w) = -β(v)` for every `(d+1)`-covector `β`.  With the
signs `c = (-1, 1, …, 1)`, `wᵢ = cᵢ vᵢ` and `cᵢ² = 1`, so `⟨wᵢ, wⱼ⟩ = cᵢcⱼ⟨vᵢ, vⱼ⟩ = δᵢⱼ` and
`vᵢ = cᵢ wᵢ`; `β` is linear in its first slot. -/
theorem Submission.cbr_ci_cp_exists_orthonormal_frame_eval_neg : ∀ (P d : ℕ) (v : Fin (d + 1) → Euclid P), Orthonormal ℝ v → ∃ w : Fin (d + 1) → Euclid P, Orthonormal ℝ w ∧ Submodule.span ℝ (Set.range w) = Submodule.span ℝ (Set.range v) ∧ ∀ β : Covector (Euclid P) (d + 1), β w = -β v := by
  intro P d v hv
  -- Step 1: the signs `c = (-1, 1, …, 1)`, with `cᵢ cᵢ = 1` and `w = (cᵢ • vᵢ)ᵢ`
  let c : Fin (d + 1) → ℝ := Function.update (fun _ => (1 : ℝ)) 0 (-1)
  have hc : ∀ i, c i * c i = 1 := by
    intro i
    by_cases h : i = 0
    · subst h; simp [c]
    · simp [c, h]
  have hw : (fun i => c i • v i) = Function.update v 0 (-v 0) := by
    funext i
    by_cases h : i = 0
    · subst h; simp [c]
    · simp [c, h]
  refine ⟨Function.update v 0 (-v 0), ?_, ?_, ?_⟩
  · -- Step 2: `⟨wᵢ, wⱼ⟩ = cᵢ cⱼ ⟨vᵢ, vⱼ⟩ = δᵢⱼ`
    rw [← hw]
    rw [orthonormal_iff_ite] at hv ⊢
    intro i j
    rw [real_inner_smul_left, real_inner_smul_right, hv i j]
    by_cases hij : i = j
    · subst hij
      simp only [↓reduceIte, mul_one]
      exact hc i
    · simp only [hij, ↓reduceIte, mul_zero]
  · -- Step 3: `wᵢ = cᵢ • vᵢ` and `vᵢ = cᵢ • wᵢ`, so the two spans contain each other
    rw [← hw]
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      have h : v i = c i • (c i • v i) := by
        rw [smul_smul, hc i, one_smul]
      rw [h]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  · -- Step 4: `β` is linear in slot `0`: `β(update v 0 ((-1) • v₀)) = (-1) • β(v)`
    intro β
    have h := β.map_update_smul v 0 (-1 : ℝ) (v 0)
    rw [neg_one_smul, Function.update_eq_self] at h
    rw [h, neg_one_smul]
/-- **Normalisation of a constant unit `n`-vector** (step 5 of the constant-planes lemma in the
proof of the closure theorem, Simon Ch. 6, 3.11, used for 7.2.4; Simon (6.1.1), (6.1.15)): let
`ζ₀ ∈ Λₙ(ℝᴾ)`, `n = d + 1`, satisfy `|ζ₀(β)| ≤ |β|_E` for every `n`-covector `β`, `ζ₀(β₁) = 1` for
some `β₁` with `|β₁|_E ≤ 1`, and `ζ₀(β) = ζ₀(β ∘ p_V)` for a subspace `V` with `dim V ≤ n`.  Then
`dim V = n` and `ζ₀(β) = β(v₀, …, v_d)` for an orthonormal frame `v` of `V`.  If `dim V < n` then
`β₁ ∘ p_V = 0`, so `ζ₀(β₁) = 0`.  Otherwise let `v` be an orthonormal frame of `V` and `β₂` a
covector with `|β₂|_E = 1`, `β₂(v) = 1`.  As every `p_V u_j` lies in `V = span v`,
`β(p_V u) = det(⟨v_i, p_V u_j⟩) β(v) = β(v) β₂(p_V u)`, so `ζ₀(β) = β(v) s` with `s = ζ₀(β₂)`.
Then `|s| ≤ |β₂|_E = 1` and `1 = |β₁(v)| |s| ≤ |s|`, as `|β₁(v)| ≤ |β₁|_E ≤ 1`; so `s = ±1`, and for
`s = −1` the frame with `v₀` negated works. -/
theorem Submission.cbr_ci_cp_eval_eq_orthonormal_frame : ∀ (P d : ℕ) (ζ₀ : MultiVector P (d + 1)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V ≤ d + 1 → (∀ β : Covector (Euclid P) (d + 1), |ζ₀ β| ≤ covectorEuclideanNorm β) → (∃ β : Covector (Euclid P) (d + 1), covectorEuclideanNorm β ≤ 1 ∧ ζ₀ β = 1) → (∀ β : Covector (Euclid P) (d + 1), ζ₀ β = ζ₀ (β.compContinuousLinearMap V.starProjection)) → Module.finrank ℝ V = d + 1 ∧ ∃ v : Fin (d + 1) → Euclid P, Orthonormal ℝ v ∧ Submodule.span ℝ (Set.range v) = V ∧ ∀ β : Covector (Euclid P) (d + 1), ζ₀ β = β v := by
  intro P d ζ₀ V hdim hle hβ₁ hproj
  obtain ⟨β₁, hβ₁, hζβ₁⟩ := hβ₁
  -- Step 1: `dim V = d + 1`; otherwise `β₁ ∘ p_V = 0` and `1 = ζ₀(β₁) = ζ₀(β₁ ∘ p_V) = ζ₀(0) = 0`
  have hrank : Module.finrank ℝ V = d + 1 := by
    refine le_antisymm hdim (not_lt.mp fun hlt => ?_)
    have h0 : ζ₀ β₁ = 0 := by
      rw [hproj β₁,
        Submission.cbr_ci_cp_comp_starProjection_eq_zero_of_finrank_lt P (d + 1) V hlt β₁,
        map_zero]
    rw [hζβ₁] at h0
    exact one_ne_zero h0
  -- Step 2: an orthonormal frame `v` of `V`
  obtain ⟨v, hv, hspan⟩ :=
    Submission.cbr_ci_cp_exists_orthonormal_frame_of_finrank_eq P (d + 1) V hrank
  -- Step 4: a covector `β₂` with `|β₂|_E = 1` and `β₂(v) = 1`
  obtain ⟨β₂, hβ₂, hβ₂v⟩ :=
    Submission.regcomp_exists_covector_eval_orthonormal_eq_one P (d + 1) v hv
  -- Step 3: `p_V u_j ∈ V = span v`, so `β(p_V u) = det(⟨v_i, p_V u_j⟩) β(v) = β(v) β₂(p_V u)`
  have hcomp : ∀ β : Covector (Euclid P) (d + 1),
      β.compContinuousLinearMap V.starProjection =
        β v • β₂.compContinuousLinearMap V.starProjection := by
    intro β
    ext u
    have hmem : ∀ j, (V.starProjection ∘ u) j ∈ Submodule.span ℝ (Set.range v) := fun j => by
      rw [hspan]
      exact V.starProjection_apply_mem (u j)
    rw [ContinuousAlternatingMap.smul_apply,
      ContinuousAlternatingMap.compContinuousLinearMap_apply,
      ContinuousAlternatingMap.compContinuousLinearMap_apply,
      Submission.dgoj_covector_eq_det_mul_of_mem_span P (d + 1) v _ hv hmem β,
      Submission.dgoj_covector_eq_det_mul_of_mem_span P (d + 1) v _ hv hmem β₂, hβ₂v,
      smul_eq_mul]
    ring
  -- Step 4: `ζ₀(β) = ζ₀(β ∘ p_V) = β(v) ζ₀(β₂ ∘ p_V) = β(v) s` with `s = ζ₀(β₂)`
  have hζ : ∀ β : Covector (Euclid P) (d + 1), ζ₀ β = β v * ζ₀ β₂ := by
    intro β
    rw [hproj β, hcomp β, map_smul, ← hproj β₂, smul_eq_mul]
  -- Step 5: `|s| ≤ |β₂|_E = 1`
  have hs₁ : |ζ₀ β₂| ≤ 1 := (hle β₂).trans_eq hβ₂
  -- Step 6: `1 = |β₁(v)| |s| ≤ |s|`, as `|β₁(v)| ≤ |β₁|_E ≤ 1`
  have hs₂ : 1 ≤ |ζ₀ β₂| := by
    have hβ₁v : |β₁ v| ≤ 1 :=
      (Submission.regcomp_covector_eval_orthonormal_le P (d + 1) β₁ v hv).trans hβ₁
    calc (1 : ℝ) = |β₁ v| * |ζ₀ β₂| := by rw [← abs_mul, ← hζ β₁, hζβ₁, abs_one]
      _ ≤ 1 * |ζ₀ β₂| := mul_le_mul_of_nonneg_right hβ₁v (abs_nonneg _)
      _ = |ζ₀ β₂| := one_mul _
  -- Step 7: `s = ±1`; for `s = −1` negate `v₀`
  refine ⟨hrank, ?_⟩
  rcases (abs_eq zero_le_one).mp (le_antisymm hs₁ hs₂) with hs | hs
  · exact ⟨v, hv, hspan, fun β => by rw [hζ β, hs, mul_one]⟩
  · obtain ⟨w, hw, hwspan, hwβ⟩ := Submission.cbr_ci_cp_exists_orthonormal_frame_eval_neg P d v hv
    exact ⟨w, hw, hwspan.trans hspan, fun β => by rw [hζ β, hs, hwβ β, mul_neg_one]⟩

/-- A measure `m` on `ℝᴾ` carried by an `n`-dimensional linear subspace `V`, finite on compact
sets and invariant under the translations by `V`, is a constant multiple of `Hⁿ⌞V` (used for the
product structure of translation invariant measures in the integer multiplicity part of Simon
7.2.4, Remark 7.2.5(1)).  The orthogonal projection `π : ℝᴾ → V` pushes `m` forward to a
translation invariant measure on `V`, finite on compact sets, hence `c • vol_V` by uniqueness of
Haar measure.  As `m` is carried by `V`, it is the image of `π_# m` under the inclusion
`V → ℝᴾ`, an isometry, and `μHE[n] = vol_V` on `V`. -/
theorem Submission.cbr_ci_cp_prod_subspace_haar : ∀ (P n : ℕ) (m : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → m (V : Set (Euclid P))ᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → m K < ∞) → (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → m ((fun x => v + x) ⁻¹' A) = m A) → ∃ c : ℝ≥0∞, m = c • (μHE[n]).restrict (V : Set (Euclid P)) := by
  intro P n m V hn hVc hcpt hinv
  subst hn
  -- the orthogonal projection `π` onto `V` fixes `V` pointwise
  have hπ : ∀ x ∈ V, ((V.orthogonalProjectionOnto x : V) : Euclid P) = x := fun x hx => by
    simpa using congrArg Subtype.val (V.orthogonalProjectionOnto_mem_subspace_eq_self ⟨x, hx⟩)
  have hπm : Measurable V.orthogonalProjectionOnto :=
    V.orthogonalProjectionOnto.continuous.measurable
  -- invariance of `m` under the translations by `V`, as an identity of measures
  have htr : ∀ v ∈ V, m.map (fun x => v + x) = m := fun v hv => by
    ext A hA
    rw [Measure.map_apply (measurable_const_add v) hA, hinv v hv A hA]
  -- `m' = π_# m` is translation invariant on `V`, as `(g + ·) ∘ π = π ∘ (g + ·)` for `g ∈ V`
  set m' : Measure V := m.map V.orthogonalProjectionOnto with hm'
  have hinv' : m'.IsAddLeftInvariant := ⟨fun g => by
    have hcomm : (fun x : V => g + x) ∘ V.orthogonalProjectionOnto =
        V.orthogonalProjectionOnto ∘ (fun x => (g : Euclid P) + x) := by
      funext x; simp
    rw [hm', Measure.map_map (measurable_const_add g) hπm, hcomm,
      ← Measure.map_map hπm (measurable_const_add _), htr _ g.2]⟩
  -- `m'` is finite on compact sets, as `π⁻¹ K ⊆ ι K ∪ Vᶜ` and `m Vᶜ = 0`
  have hfin' : IsFiniteMeasureOnCompacts m' := ⟨fun K hK => by
    rw [hm', Measure.map_apply hπm hK.isClosed.measurableSet]
    calc m (V.orthogonalProjectionOnto ⁻¹' K)
        ≤ m (Subtype.val '' K ∪ (V : Set (Euclid P))ᶜ) := by
          refine measure_mono fun x hx => ?_
          by_cases hxV : x ∈ V
          · exact Or.inl ⟨_, hx, hπ x hxV⟩
          · exact Or.inr hxV
      _ ≤ m (Subtype.val '' K) + m (V : Set (Euclid P))ᶜ := measure_union_le _ _
      _ < ∞ := by
          rw [hVc, add_zero]
          exact hcpt _ (hK.image continuous_subtype_val)⟩
  -- uniqueness of Haar measure on `V`
  obtain ⟨c, hc⟩ : ∃ c : NNReal, m' = c • (volume : Measure V) :=
    ⟨_, Measure.isAddLeftInvariant_eq_smul m' volume⟩
  -- `m = ι_# m'` for the inclusion `ι : V → ℝᴾ`, as `ι ∘ π = id` on `V`, which carries `m`
  have hm : m = m'.map Subtype.val := by
    rw [hm', Measure.map_map continuous_subtype_val.measurable hπm]
    conv_lhs => rw [← Measure.map_id (μ := m)]
    refine Measure.map_congr (measure_mono_null (fun x hx => ?_) hVc)
    exact fun hxV => hx (hπ x hxV).symm
  -- `ι_# vol_V = Hⁿ⌞V`, as `μHE[n] = vol_V` on `V` and `ι` is an isometry with range `V`
  have hvol : (volume : Measure V).map Subtype.val =
      (μHE[Module.finrank ℝ V]).restrict (V : Set (Euclid P)) := by
    rw [← InnerProductSpace.euclideanHausdorffMeasure_eq_volume,
      isometry_subtype_coe.map_euclideanHausdorffMeasure, Subtype.range_coe]
  refine ⟨c, ?_⟩
  rw [hm, hc, Measure.map_smul _ continuous_subtype_val.aemeasurable, hvol,
    Measure.coe_nnreal_smul]

/-- Let `ν` be a measure on `ℝᴾ`, finite on compact sets and invariant under the translations by
an `n`-dimensional linear subspace `V`, and let `p`, `q` be the orthogonal projections onto `V`
and `Vᗮ`.  Then `ν(p⁻¹ A ∩ q⁻¹ B) = σ(B) Hⁿ(A ∩ V)` for all Borel `A`, `B`, for a measure `σ`
carried by `Vᗮ` and finite on compact sets (used for the product structure of translation
invariant measures in the integer multiplicity part of Simon 7.2.4, Remark 7.2.5(1)).  Take
`σ = ωₙ⁻¹ q_#(ν⌞p⁻¹ B_1(0))`.  For bounded `B`, `p_#(ν⌞q⁻¹ B)` is carried by `V`, finite on
compact sets and invariant under the translations by `V`, hence equal to `c Hⁿ⌞V`; evaluating at
`B_1(0)`, where `Hⁿ(V ∩ B_1(0)) = ωₙ`, gives `c = σ(B)`.  Exhausting `B` by the bounded sets
`B ∩ B_j(0)` gives the general case. -/
theorem Submission.cbr_ci_cp_prod_rectangle_formula : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => v + x) ⁻¹' A) = ν A) → ∃ σ : Measure (Euclid P), σ (Vᗮ : Set (Euclid P))ᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) ∧ ∀ A B : Set (Euclid P), MeasurableSet A → MeasurableSet B → ν (V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B) = σ B * μHE[n] (A ∩ (V : Set (Euclid P))) := by
  intro P n ν V hn hcpt hinv
  -- `p = V.starProjection` and `q = Vᗮ.starProjection` are continuous linear, hence measurable
  have hpm : Measurable V.starProjection := V.starProjection.continuous.measurable
  have hqm : Measurable Vᗮ.starProjection := Vᗮ.starProjection.continuous.measurable
  -- for `v ∈ V`, `p (v + y) = v + p y` and `q (v + y) = q y`
  have hpv : ∀ v ∈ V, ∀ y, V.starProjection (v + y) = v + V.starProjection y := fun v hv y => by
    rw [map_add, Submodule.starProjection_eq_self_iff.2 hv]
  have hqv : ∀ v ∈ V, ∀ y, Vᗮ.starProjection (v + y) = Vᗮ.starProjection y := fun v hv y => by
    rw [map_add, Submodule.starProjection_orthogonal_apply_eq_zero hv, zero_add]
  -- boxes `{y : p y ∈ E, q y ∈ F}` with `E`, `F` bounded lie in a compact ball, as `y = p y + q y`
  have hbox : ∀ E F : Set (Euclid P), Bornology.IsBounded E → Bornology.IsBounded F →
      ν (V.starProjection ⁻¹' E ∩ Vᗮ.starProjection ⁻¹' F) < ∞ := by
    intro E F hE hF
    obtain ⟨R, hR⟩ := hE.subset_closedBall 0
    obtain ⟨S, hS⟩ := hF.subset_closedBall 0
    refine lt_of_le_of_lt (measure_mono fun y hy => ?_) (hcpt _ (isCompact_closedBall 0 (R + S)))
    rw [mem_closedBall_zero_iff, ← V.starProjection_add_starProjection_orthogonal y]
    exact (norm_add_le _ _).trans
      (add_le_add (mem_closedBall_zero_iff.1 (hR hy.1)) (mem_closedBall_zero_iff.1 (hS hy.2)))
  -- `Hⁿ(B_1(0) ∩ V) = ωₙ`, and `0 < ωₙ < ∞`
  have hω : μHE[n] (ball (0 : Euclid P) 1 ∩ V) = unitBallVolume n := by
    rw [Set.inter_comm, Submission.idtp_tdc_subspace_ball_measure P n V 0 1 hn V.zero_mem one_pos]
    simp
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  -- `σ = ωₙ⁻¹ q_#(ν⌞p⁻¹ B_1(0))`, so `σ(B) = ωₙ⁻¹ ν(q⁻¹ B ∩ p⁻¹ B_1(0))` for Borel `B`
  obtain ⟨σ, hσB⟩ : ∃ σ : Measure (Euclid P), ∀ B, MeasurableSet B → σ B =
      (unitBallVolume n)⁻¹ * ν (Vᗮ.starProjection ⁻¹' B ∩ V.starProjection ⁻¹' ball 0 1) :=
    ⟨(unitBallVolume n)⁻¹ • (ν.restrict (V.starProjection ⁻¹' ball 0 1)).map Vᗮ.starProjection,
      fun B hB => by
        rw [Measure.smul_apply, Measure.map_apply hqm hB, Measure.restrict_apply (hqm hB),
          smul_eq_mul]⟩
  -- the rectangle formula for bounded Borel `B`
  have hbdd : ∀ A B : Set (Euclid P), MeasurableSet A → MeasurableSet B → Bornology.IsBounded B →
      ν (V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B) = σ B * μHE[n] (A ∩ V) := by
    intro A B hA hB hBb
    -- `m = p_#(ν⌞q⁻¹ B)`, with `m(E) = ν(p⁻¹ E ∩ q⁻¹ B)` for Borel `E`
    obtain ⟨m, hmE⟩ : ∃ m : Measure (Euclid P), ∀ E, MeasurableSet E →
        m E = ν (V.starProjection ⁻¹' E ∩ Vᗮ.starProjection ⁻¹' B) :=
      ⟨(ν.restrict (Vᗮ.starProjection ⁻¹' B)).map V.starProjection, fun E hE => by
        rw [Measure.map_apply hpm hE, Measure.restrict_apply (hpm hE)]⟩
    -- `m` is carried by `V`, as `p y ∈ V`
    have hmV : m (V : Set (Euclid P))ᶜ = 0 := by
      rw [hmE _ (Submodule.closed_of_finiteDimensional V).measurableSet.compl]
      exact measure_mono_null (fun y hy => absurd (V.starProjection_apply_mem y) hy.1) measure_empty
    -- `m` is finite on compact sets, as compact sets are bounded
    have hmcpt : ∀ K : Set (Euclid P), IsCompact K → m K < ∞ := fun K hK => by
      rw [hmE K hK.isClosed.measurableSet]
      exact hbox K B hK.isBounded hBb
    -- `m` is invariant under the translations by `V`, as `ν` is
    have hminv : ∀ v ∈ V, ∀ E : Set (Euclid P), MeasurableSet E →
        m ((fun x => v + x) ⁻¹' E) = m E := by
      intro v hv E hE
      have hpre : V.starProjection ⁻¹' ((fun x => v + x) ⁻¹' E) ∩ Vᗮ.starProjection ⁻¹' B =
          (fun x => v + x) ⁻¹' (V.starProjection ⁻¹' E ∩ Vᗮ.starProjection ⁻¹' B) := by
        ext y
        simp only [mem_inter_iff, mem_preimage, hpv v hv, hqv v hv]
      rw [hmE _ (hE.preimage (measurable_const_add v)), hmE E hE, hpre,
        hinv v hv _ ((hpm hE).inter (hqm hB))]
    -- `m = c • Hⁿ⌞V`; evaluating at `B_1(0)` gives `c = σ(B)`
    obtain ⟨c, hc⟩ := Submission.cbr_ci_cp_prod_subspace_haar P n m V hn hmV hmcpt hminv
    have hball : ν (V.starProjection ⁻¹' ball 0 1 ∩ Vᗮ.starProjection ⁻¹' B) =
        unitBallVolume n * c := by
      rw [← hmE (ball 0 1) measurableSet_ball, hc, Measure.smul_apply,
        Measure.restrict_apply measurableSet_ball, hω, smul_eq_mul, mul_comm]
    have hσc : σ B = c := by
      rw [hσB B hB, Set.inter_comm, hball, ENNReal.inv_mul_cancel_left hω0 hωtop]
    rw [← hmE A hA, hc, Measure.smul_apply, Measure.restrict_apply hA, hσc, smul_eq_mul]
  refine ⟨σ, ?_, fun K hK => ?_, fun A B hA hB => ?_⟩
  · -- `σ` is carried by `Vᗮ`, as `q y ∈ Vᗮ`
    rw [hσB _ V.isClosed_orthogonal.measurableSet.compl,
      measure_mono_null (fun y hy => absurd (Vᗮ.starProjection_apply_mem y) hy.1) measure_empty,
      mul_zero]
  · -- `σ` is finite on compact sets, as compact sets are bounded and `ωₙ ≠ 0`
    rw [hσB K hK.isClosed.measurableSet, Set.inter_comm]
    exact ENNReal.mul_lt_top (ENNReal.inv_lt_top.2 (pos_iff_ne_zero.2 hω0))
      (hbox _ _ isBounded_ball hK.isBounded)
  · -- exhaust `B` by the bounded sets `B ∩ B_j(0)`, by continuity from below for `ν` and `σ`
    have hmono : Monotone fun j : ℕ => B ∩ ball (0 : Euclid P) j := fun i j hij =>
      inter_subset_inter_right _ (ball_subset_ball (Nat.cast_le.2 hij))
    have hU : ⋃ j : ℕ, B ∩ ball (0 : Euclid P) j = B := by
      rw [← inter_iUnion, iUnion_ball_nat, inter_univ]
    have hmono' : Monotone fun j : ℕ =>
        V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' (B ∩ ball (0 : Euclid P) j) :=
      fun i j hij => inter_subset_inter_right _ (preimage_mono (hmono hij))
    have hνU := hmono'.measure_iUnion (μ := ν)
    have hσU := hmono.measure_iUnion (μ := σ)
    rw [← inter_iUnion, ← preimage_iUnion, hU] at hνU
    rw [hU] at hσU
    rw [hνU, hσU, ENNReal.iSup_mul]
    exact iSup_congr fun j => hbdd A _ hA (hB.inter measurableSet_ball)
      (isBounded_ball.subset inter_subset_right)
/-- If `σ` is carried by `Vᗮ` and finite on compact sets, and `ν` has the rectangle values
`ν(p⁻¹(A) ∩ q⁻¹(B)) = σ(B) Hⁿ(A ∩ V)` for Borel `A`, `B` (`p`, `q` the orthogonal projections onto
the `n`-dimensional subspace `V` and onto `Vᗮ`), then `ν(A) = ∫_V σ({y : t + y ∈ A}) dHⁿ(t)`, i.e.
`ν` is the image of `(Hⁿ⌞V) ⊗ σ` under `(t, y) ↦ t + y` (used, via the closure theorem, in the
proof of Simon 7.2.4).  The rectangles form a π-system generating the Borel sets (`y = p y + q y`),
the image measure takes the same values on them because `σ` is carried by `Vᗮ`, and the rectangles
over the balls `B_{j+1}(0)` cover `ℝᴾ` and have finite `ν`-measure, so the two measures agree. -/
theorem Submission.cbr_ci_cp_prod_of_rectangles : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → σ (Vᗮ : Set (Euclid P))ᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) → (∀ A B : Set (Euclid P), MeasurableSet A → MeasurableSet B → ν (V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B) = σ B * μHE[n] (A ∩ (V : Set (Euclid P)))) → ∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n] := by
  intro P n ν σ V hn hσ hσfin hrect A hA
  -- `σ` is finite on compact sets, hence locally finite and σ-finite on `ℝᴾ`
  have : IsFiniteMeasureOnCompacts σ := ⟨hσfin⟩
  have hp : Measurable V.starProjection := V.starProjection.continuous.measurable
  have hq : Measurable Vᗮ.starProjection := Vᗮ.starProjection.continuous.measurable
  have hV : MeasurableSet (V : Set (Euclid P)) := V.closed_of_finiteDimensional.measurableSet
  -- the candidate `λ = s_#((Hⁿ⌞V) ⊗ σ)` with `s(t, y) = t + y`
  have hs : Measurable fun z : Euclid P × Euclid P => z.1 + z.2 := measurable_fst.add measurable_snd
  have hlam : ∀ A : Set (Euclid P), MeasurableSet A →
      ((μHE[n].restrict (V : Set (Euclid P))).prod σ).map (fun z => z.1 + z.2) A =
        ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n] := by
    intro A hA
    rw [Measure.map_apply hs hA, Measure.prod_apply (hs hA)]
    rfl
  rw [← hlam A hA]
  congr 1
  -- rectangles `p⁻¹(A) ∩ q⁻¹(B)` form a π-system generating the Borel σ-algebra
  let C : Set (Set (Euclid P)) := {S | ∃ A B : Set (Euclid P), MeasurableSet A ∧ MeasurableSet B ∧
    S = V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B}
  have hgen : (inferInstance : MeasurableSpace (Euclid P)) = MeasurableSpace.generateFrom C := by
    refine le_antisymm ?_ (MeasurableSpace.generateFrom_le ?_)
    · have hp' : Measurable[MeasurableSpace.generateFrom C] V.starProjection := fun A hA =>
        MeasurableSpace.measurableSet_generateFrom ⟨A, univ, hA, MeasurableSet.univ, by
          rw [preimage_univ, inter_univ]⟩
      have hq' : Measurable[MeasurableSpace.generateFrom C] Vᗮ.starProjection := fun B hB =>
        MeasurableSpace.measurableSet_generateFrom ⟨univ, B, MeasurableSet.univ, hB, by
          rw [preimage_univ, univ_inter]⟩
      have hid := @Measurable.add _ _ _ _ (MeasurableSpace.generateFrom C)
        (fun y => V.starProjection y) (fun y => Vᗮ.starProjection y) _ hp' hq'
      have hfun : ((fun y => V.starProjection y) + fun y => Vᗮ.starProjection y) = id :=
        funext V.starProjection_add_starProjection_orthogonal
      rw [hfun] at hid
      exact fun S hS => hid hS
    · rintro _ ⟨A, B, hA, hB, rfl⟩
      exact (hp hA).inter (hq hB)
  have hpi : IsPiSystem C := by
    rintro _ ⟨A, B, hA, hB, rfl⟩ _ ⟨A', B', hA', hB', rfl⟩ _
    exact ⟨A ∩ A', B ∩ B', hA.inter hA', hB.inter hB', by
      rw [preimage_inter, preimage_inter, inter_inter_inter_comm]⟩
  -- the rectangles `p⁻¹(B_{j+1}(0)) ∩ q⁻¹(B_{j+1}(0))` cover `ℝᴾ` and have finite `ν`-measure
  refine Measure.ext_of_generateFrom_of_iUnion C
    (fun j : ℕ => V.starProjection ⁻¹' ball 0 (j + 1) ∩ Vᗮ.starProjection ⁻¹' ball 0 (j + 1))
    hgen hpi ?_ ?_ ?_ ?_
  · refine eq_univ_of_forall fun y => mem_iUnion.2 ?_
    obtain ⟨j, hj⟩ := exists_nat_gt (max ‖V.starProjection y‖ ‖Vᗮ.starProjection y‖)
    exact ⟨j, mem_ball_zero_iff.2 ((le_max_left _ _).trans_lt (hj.trans (lt_add_one _))),
      mem_ball_zero_iff.2 ((le_max_right _ _).trans_lt (hj.trans (lt_add_one _)))⟩
  · exact fun j => ⟨_, _, measurableSet_ball, measurableSet_ball, rfl⟩
  · intro j
    rw [hrect _ _ measurableSet_ball measurableSet_ball, inter_comm,
      Submission.idtp_tdc_subspace_ball_measure P n V 0 (j + 1) hn V.zero_mem (by positivity)]
    exact ENNReal.mul_ne_top measure_ball_lt_top.ne
      (ENNReal.mul_ne_top (measure_ball_lt_top (μ := volume)).ne ENNReal.ofReal_ne_top)
  -- `ν` and `λ` agree on rectangles because `σ` is carried by `Vᗮ`
  · rintro _ ⟨A, B, hA, hB, rfl⟩
    rw [hrect A B hA hB, hlam _ ((hp hA).inter (hq hB))]
    have key : EqOn (fun t => σ ((fun y => t + y) ⁻¹'
        (V.starProjection ⁻¹' A ∩ Vᗮ.starProjection ⁻¹' B))) (A.indicator fun _ => σ B) V := by
      intro t ht
      have hsec : ∀ y ∈ (Vᗮ : Set (Euclid P)),
          V.starProjection (t + y) = t ∧ Vᗮ.starProjection (t + y) = y := by
        intro y hy
        refine ⟨?_, ?_⟩
        · rw [map_add, V.starProjection_eq_self_iff.mpr ht,
            V.starProjection_apply_eq_zero_iff.mpr hy, add_zero]
        · rw [map_add, V.starProjection_orthogonal_apply_eq_zero ht,
            Vᗮ.starProjection_eq_self_iff.mpr hy, zero_add]
      simp only
      rw [← measure_inter_conull hσ]
      by_cases htA : t ∈ A
      · rw [indicator_of_mem htA, ← measure_inter_conull (s := B) hσ]
        congr 1
        ext y
        simp only [mem_inter_iff, mem_preimage]
        constructor
        · rintro ⟨⟨-, hyB⟩, hy⟩
          rw [(hsec y hy).2] at hyB
          exact ⟨hyB, hy⟩
        · rintro ⟨hyB, hy⟩
          rw [(hsec y hy).1, (hsec y hy).2]
          exact ⟨⟨htA, hyB⟩, hy⟩
      · rw [indicator_of_notMem htA]
        convert measure_empty (μ := σ)
        ext y
        simp only [mem_inter_iff, mem_preimage, mem_empty_iff_false, iff_false]
        rintro ⟨⟨hyA, -⟩, hy⟩
        exact htA ((hsec y hy).1 ▸ hyA)
    rw [setLIntegral_congr_fun hV key, lintegral_indicator_const hA, Measure.restrict_apply hA]

/-- A measure `ν` on `ℝᴾ`, finite on compact sets and invariant under the translations by an
`n`-dimensional linear subspace `V`, is the image of `(Hⁿ⌞V) ⊗ σ` under `(t, y) ↦ t + y` for a
measure `σ` carried by `V^⊥` and finite on compact sets (used for the product structure of
translation invariant measures in the integer multiplicity part of Simon 7.2.4, Remark
7.2.5(1)).  With `p = V.starProjection` and `q = Vᗮ.starProjection`, uniqueness of Haar measure
on `V` gives such a `σ` with `ν(p⁻¹(A) ∩ q⁻¹(B)) = σ(B)·Hⁿ(A ∩ V)` for Borel `A`, `B`; the image
of `(Hⁿ⌞V) ⊗ σ` under addition has the same values on these rectangles, which form a generating
π-system covered by countably many rectangles of finite measure, so it equals `ν`. -/
theorem Submission.cbr_ci_cp_invariant_measure_product : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => v + x) ⁻¹' A) = ν A) → ∃ σ : Measure (Euclid P), σ (Vᗮ : Set (Euclid P))ᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) ∧ ∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n] := by
  intro P n ν V hn hcpt hinv
  -- the transverse measure `σ` on `V^⊥` and the rectangle formula (Haar uniqueness on `V`)
  obtain ⟨σ, hσV, hσcpt, hrect⟩ :=
    Submission.cbr_ci_cp_prod_rectangle_formula P n ν V hn hcpt hinv
  -- `ν` agrees with the image of `(Hⁿ⌞V) ⊗ σ` on rectangles, hence on all Borel sets
  exact ⟨σ, hσV, hσcpt, Submission.cbr_ci_cp_prod_of_rectangles P n ν σ V hn hσV hσcpt hrect⟩

/-- `ν(B_r(x)) ≤ ωₙrⁿ σ(B_r(x − p_V x))` when `ν(A) = ∫_V σ({y : t + y ∈ A}) dHⁿ(t)` for a
subspace `V` with `dim V = n` and a measure `σ` carried by `Vᗮ`.  Write `x = p₀ + q₀` with
`p₀ = p_V x ∈ V` and `q₀ = x − p_V x ∈ Vᗮ`.  For `t ∈ V` and `z ∈ Vᗮ`, Pythagoras gives
`|t + z − x|² = |t − p₀|² + |z − q₀|²`, so `t + z ∈ B_r(x)` forces `t ∈ B_r(p₀)` and
`z ∈ B_r(q₀)`.  Hence `σ({y : t + y ∈ B_r(x)}) ≤ 1_{B_r(p₀)}(t) σ(B_r(q₀))`, and integrating over
`V` gives `ν(B_r(x)) ≤ σ(B_r(q₀)) Hⁿ(V ∩ B_r(p₀)) = ωₙrⁿ σ(B_r(q₀))`. -/
theorem Submission.cbr_ci_cp_atm_ball_le_transversal_ball : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)), Module.finrank ℝ V = n → σ (Vᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]) → ∀ (x : Euclid P) (r : ℝ), 0 < r → ν (ball x r) ≤ unitBallVolume n * ENNReal.ofReal (r ^ n) * σ (ball (x - V.starProjection x) r) := by
  intro P n ν σ V hn hσ hν x r hr
  -- `x = p₀ + q₀` with `p₀ = p_V x ∈ V` and `q₀ = x − p₀ ∈ Vᗮ`
  set p₀ := V.starProjection x
  have hp₀ : p₀ ∈ V := V.starProjection_apply_mem x
  have hq₀ : x - p₀ ∈ Vᗮ := V.sub_starProjection_mem_orthogonal x
  -- Pythagoras: for `t ∈ V` and `z ∈ Vᗮ`, `t + z ∈ B_r(x)` forces `t ∈ B_r(p₀)`, `z ∈ B_r(q₀)`
  have hpyth : ∀ t ∈ V, ∀ z ∈ Vᗮ, t + z ∈ ball x r →
      t ∈ ball p₀ r ∧ z ∈ ball (x - p₀) r := by
    intro t ht z hz htz
    have hpy := norm_add_sq_eq_norm_sq_add_norm_sq_real
      (V.inner_right_of_mem_orthogonal (V.sub_mem ht hp₀) (Vᗮ.sub_mem hz hq₀))
    rw [show t - p₀ + (z - (x - p₀)) = t + z - x by abel] at hpy
    simp only [mem_ball, dist_eq_norm] at htz ⊢
    have hlt : ‖t + z - x‖ * ‖t + z - x‖ < r * r := mul_self_lt_mul_self (norm_nonneg _) htz
    constructor
    · exact (mul_self_lt_mul_self_iff (norm_nonneg _) hr.le).2
        (by linarith [mul_self_nonneg ‖z - (x - p₀)‖])
    · exact (mul_self_lt_mul_self_iff (norm_nonneg _) hr.le).2
        (by linarith [mul_self_nonneg ‖t - p₀‖])
  -- `σ` is carried by `Vᗮ`, so `σ({y : t + y ∈ B_r(x)}) ≤ 1_{B_r(p₀)}(t) σ(B_r(q₀))` on `V`
  have hslice : ∀ t ∈ (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' ball x r) ≤
      (ball p₀ r).indicator (fun _ => σ (ball (x - p₀) r)) t := by
    intro t ht
    rw [← measure_inter_conull (s := (fun y => t + y) ⁻¹' ball x r) hσ]
    by_cases htp : t ∈ ball p₀ r
    · rw [indicator_of_mem htp]
      exact measure_mono fun z hz => (hpyth t ht z hz.2 hz.1).2
    · have hempty : (fun y => t + y) ⁻¹' ball x r ∩ (Vᗮ : Set (Euclid P)) = ∅ :=
        eq_empty_of_forall_notMem fun z hz => htp (hpyth t ht z hz.2 hz.1).1
      rw [indicator_of_notMem htp, hempty, measure_empty]
  -- integrate over `V` and use `Hⁿ(V ∩ B_r(p₀)) = ωₙrⁿ`
  calc ν (ball x r)
      = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' ball x r) ∂μHE[n] :=
        hν _ measurableSet_ball
    _ ≤ ∫⁻ t in (V : Set (Euclid P)),
          (ball p₀ r).indicator (fun _ => σ (ball (x - p₀) r)) t ∂μHE[n] :=
        setLIntegral_mono' V.closed_of_finiteDimensional.measurableSet hslice
    _ = σ (ball (x - p₀) r) * μHE[n] ((V : Set (Euclid P)) ∩ ball p₀ r) := by
        rw [lintegral_indicator_const measurableSet_ball, Measure.restrict_apply measurableSet_ball,
          inter_comm]
    _ = unitBallVolume n * ENNReal.ofReal (r ^ n) * σ (ball (x - p₀) r) := by
        rw [Submission.idtp_tdc_subspace_ball_measure P n V p₀ r hn hp₀ hr, mul_comm]
/-- If `σ` is finite on compact sets and `f(r) ≤ ωₙrⁿσ(B_r(z))` for every `r > 0`, then
`liminf_{r↓0} f(r)/(ωₙrⁿ) ≤ σ({z})` (used in the closure step of the proof of Simon 7.2.4,
p. 184, to show that the transversal measure of a measure invariant along a plane is atomic).
For `r > 0`, `f(r)/(ωₙrⁿ) ≤ σ(B_r(z))` in `[0, ∞]`; and `σ(B_r(z)) → σ({z})` as `r ↓ 0` by
continuity from above, the balls decreasing to `{z}` and `σ(B_1(z)) ≤ σ(B̄_1(z)) < ∞`. -/
theorem Submission.cbr_ci_cp_atm_liminf_density_le_atom : ∀ (P n : ℕ) (σ : Measure (Euclid P)) (z : Euclid P) (f : ℝ → ℝ≥0∞), (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) → (∀ r : ℝ, 0 < r → f r ≤ unitBallVolume n * ENNReal.ofReal (r ^ n) * σ (ball z r)) → liminf (fun r : ℝ => f r / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) ≤ σ {z} := by
  intro P n σ z f hσ hf
  -- the balls `B_r(z)` decrease to `{z}` as `r ↓ 0`
  have hinter : (⋂ r > (0 : ℝ), ball z r) = {z} := by
    ext y
    simp only [mem_iInter, mem_ball, mem_singleton_iff]
    refine ⟨fun hy => ?_, fun hy r hr => by rwa [hy, dist_self]⟩
    by_contra hne
    exact lt_irrefl _ (hy (dist y z) (dist_pos.2 hne))
  -- continuity from above, with `σ(B_1(z)) ≤ σ(B̄_1(z)) < ∞`
  have hlim : Tendsto (fun r : ℝ => σ (ball z r)) (𝓝[>] 0) (𝓝 (σ {z})) := by
    rw [← hinter]
    exact tendsto_measure_biInter_gt (fun r _ => measurableSet_ball.nullMeasurableSet)
      (fun i j _ hij => ball_subset_ball hij)
      ⟨1, one_pos, ((measure_mono ball_subset_closedBall).trans_lt
        (hσ _ (isCompact_closedBall z 1))).ne⟩
  -- `f(r)/(ωₙrⁿ) ≤ σ(B_r(z))` for `r > 0`, then monotonicity of `liminf`
  calc liminf (fun r : ℝ => f r / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0)
      ≤ liminf (fun r : ℝ => σ (ball z r)) (𝓝[>] 0) :=
        liminf_le_liminf (eventually_mem_nhdsWithin.mono fun r hr =>
          ENNReal.div_le_of_le_mul' (hf r hr))
    _ = σ {z} := hlim.liminf_eq
/-- If `ν(A) = ∫_V σ(A − t) dHⁿ(t)` for Borel `A`, where `V` is an `n`-dimensional subspace of
`ℝᴾ` and `σ` is carried by `Vᗮ`, and `x − p_V x ∈ Z` for `ν`-a.e. `x` with `Z` Borel, then
`σ(ℝᴾ ∖ Z) = 0` (used for the translation-invariant blow-up measures in B. White's proof of the
closure theorem, part of Simon 7.2.4).  The Borel set `E = {y : y − p_V y ∉ Z}` is `ν`-null and
invariant under translation by `V`, so `0 = ν(E) = σ(E) Hⁿ(V)`;
`Hⁿ(V) ≥ Hⁿ(V ∩ B_1(0)) = ωₙ > 0` gives `σ(E) = 0`, and `ℝᴾ ∖ Z ⊆ E ∪ (ℝᴾ ∖ Vᗮ)` because
`p_V w = 0` for `w ∈ Vᗮ`. -/
theorem Submission.cbr_ci_cp_atm_transversal_carried : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (Z : Set (Euclid P)), Module.finrank ℝ V = n → σ (Vᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]) → MeasurableSet Z → (∀ᵐ x ∂ν, x - V.starProjection x ∈ Z) → σ Zᶜ = 0 := by
  intro P n ν σ V Z hn hσ hD hZ hae
  -- `E = {y : y − p_V y ∉ Z}` is Borel and `ν`-null
  set E : Set (Euclid P) := (fun y => y - V.starProjection y) ⁻¹' Zᶜ with hE_def
  have hE : MeasurableSet E := (continuous_id.sub V.starProjection.continuous).measurable hZ.compl
  have hνE : ν E = 0 := ae_iff.mp hae
  -- `p_V (t + y) = t + p_V y` for `t ∈ V`, so `E` is invariant under translation by `V`
  -- and the product formula gives `ν(E) = σ(E) Hⁿ(V)`
  have hprod : ν E = σ E * μHE[n] (V : Set (Euclid P)) := by
    rw [hD E hE, ← setLIntegral_const]
    refine setLIntegral_congr_fun V.closed_of_finiteDimensional.measurableSet fun t ht => ?_
    congr 1
    ext y
    simp [hE_def, Submodule.starProjection_eq_self_iff.mpr ht]
  -- `Hⁿ(V) ≥ Hⁿ(V ∩ B_1(0)) = ωₙ > 0`
  have hV : μHE[n] (V : Set (Euclid P)) ≠ 0 := by
    have hball := Submission.idtp_tdc_subspace_ball_measure P n V 0 1 hn V.zero_mem one_pos
    rw [one_pow, ENNReal.ofReal_one, mul_one] at hball
    have hω : 0 < unitBallVolume n := measure_ball_pos volume (0 : Euclid n) one_pos
    refine (hω.trans_le ?_).ne'
    rw [← hball]
    exact measure_mono Set.inter_subset_left
  have hσE : σ E = 0 := by
    rw [hνE, eq_comm, mul_eq_zero] at hprod
    exact hprod.resolve_right hV
  -- `ℝᴾ ∖ Z ⊆ E ∪ (ℝᴾ ∖ Vᗮ)`, since `p_V w = 0` for `w ∈ Vᗮ`
  refine measure_mono_null (fun w hw => ?_) (measure_union_null hσE hσ)
  by_cases hw' : w ∈ Vᗮ
  · left
    show w - V.starProjection w ∈ Zᶜ
    rwa [(V.starProjection_apply_eq_zero_iff).mpr hw', sub_zero]
  · exact Or.inr hw'
/-- A measure `ν` on `ℝᴾ` with `ν(A) = ∫⁻_{t ∈ V} σ({y : t + y ∈ A}) dHⁿ(t)` for Borel `A`, whose
transversal measure `σ` is carried by a countable set `Z`, is the countable sum of weighted parallel
planes `ν = Σ_{w ∈ Z} σ({w}) Hⁿ⌞(w + V)` (a step of the proof of Simon 7.2.4, for cycles with a
constant orientation).  `σ` is the sum of its atoms on `Z`; inserting this into the product
formula, monotone convergence exchanges sum and integral, and the translation by `w` is an isometry
carrying `{t : t + w ∈ A} ∩ V` onto `A ∩ (w + V)`, under which `Hⁿ` is invariant. -/
theorem Submission.cbr_ci_cp_atm_sum_planes_of_carried : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (Z : Set (Euclid P)), Z.Countable → σ Zᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]) → ν = Measure.sum (fun w : Z => σ {(w : Euclid P)} • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) := by
  intro P n ν σ V Z hZ hσ hν
  have := hZ.to_subtype
  -- `σ` is carried by the countable set `Z`, hence is the sum of its atoms there
  have hatom : ∀ S : Set (Euclid P), MeasurableSet S →
      σ S = ∑' w : Z, S.indicator (fun x => σ {x}) (w : Euclid P) := by
    intro S hS
    have hSZ : S ∩ Z = ⋃ w : Z, S ∩ {(w : Euclid P)} := by
      ext y
      simp
    rw [← measure_inter_conull hσ, hSZ, measure_iUnion]
    · congr 1
      ext w
      by_cases hw : (w : Euclid P) ∈ S
      · simp [hw]
      · simp [hw]
    · intro w w' hww'
      exact Disjoint.mono inter_subset_right inter_subset_right
        (disjoint_singleton.2 (Subtype.coe_injective.ne hww'))
    · exact fun w => hS.inter (measurableSet_singleton _)
  ext A hA
  rw [hν A hA, Measure.sum_apply _ hA]
  calc ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]
      = ∫⁻ t in (V : Set (Euclid P)), ∑' w : Z,
          ((fun t => t + (w : Euclid P)) ⁻¹' A).indicator (fun _ => σ {(w : Euclid P)}) t ∂μHE[n] := by
        refine lintegral_congr fun t => ?_
        rw [hatom _ (measurable_const_add t hA)]
        refine tsum_congr fun w => ?_
        by_cases hw : t + (w : Euclid P) ∈ A
        · rw [indicator_of_mem (show (w : Euclid P) ∈ (fun y => t + y) ⁻¹' A from hw),
            indicator_of_mem (show t ∈ (fun t => t + (w : Euclid P)) ⁻¹' A from hw)]
        · rw [indicator_of_notMem (show (w : Euclid P) ∉ (fun y => t + y) ⁻¹' A from hw),
            indicator_of_notMem (show t ∉ (fun t => t + (w : Euclid P)) ⁻¹' A from hw)]
    -- monotone convergence for the countable sum, then integrate the indicators
    _ = ∑' w : Z, σ {(w : Euclid P)} *
          (μHE[n]).restrict (V : Set (Euclid P)) ((fun t => t + (w : Euclid P)) ⁻¹' A) := by
        rw [lintegral_tsum fun w : Z => (measurable_const.indicator
          (measurable_add_const (w : Euclid P) hA)).aemeasurable]
        simp only [lintegral_indicator_const (measurable_add_const _ hA)]
    _ = ∑' w : Z, (σ {(w : Euclid P)} • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) A := by
        congr 1
        ext w
        rw [Measure.restrict_apply (measurable_add_const _ hA), Measure.smul_apply, smul_eq_mul,
          Measure.restrict_apply hA]
        congr 1
        -- the translation by `w` is an isometry carrying `{t : t + w ∈ A} ∩ V` onto `A ∩ (w + V)`
        have hpre : (fun t => t + (w : Euclid P)) ⁻¹' (A ∩ {y : Euclid P | y - w ∈ V}) =
            (fun t => t + (w : Euclid P)) ⁻¹' A ∩ V := by
          ext t
          simp
        rw [← hpre, (isometry_add_right (w : Euclid P)).euclideanHausdorffMeasure_preimage,
          (add_right_surjective (w : Euclid P)).range_eq, inter_univ]

/-- **A transversal measure with lower density `≥ c` is atomic** (B. White's tangent-plane proof of
the closure theorem used for Simon 7.2.4: a cycle with constant orientation is a sum of parallel
planes).  Let `V ⊆ ℝᴾ` be an `n`-dimensional subspace, `σ` a measure carried by `Vᗮ` and finite on
compact sets, and `ν(A) = ∫_V σ({y : t + y ∈ A}) dHⁿ(t)` for Borel `A`.  If
`ofReal c ≤ liminf_{r ↓ 0} ν(B_r(y))/(ωₙrⁿ)` for `ν`-a.e. `y`, then
`ν = Σ_{w ∈ Z} σ({w}) Hⁿ⌞(w + V)` for the set `Z ⊆ Vᗮ` of atoms of `σ` of mass `≥ c`.
`Z ∩ B̄_j(0)` is finite, since infinitely many atoms of mass `≥ c` have infinite `σ`-measure while
`σ(B̄_j(0)) < ∞`; so `Z` is countable.  For `x ∈ ℝᴾ`, `ν(B_r(x)) ≤ ωₙrⁿσ(B_r(x − p x))`
(`p` the projection onto `V`), so the lower density of `ν` at `x` is at most `σ({x − p x})`;
hence `x − p x ∈ Z` for `ν`-a.e. `x`, `σ` is carried by `Z`, and `ν` is the sum of the planes. -/
theorem Submission.cbr_ci_cp_atomic_transversal : ∀ (P n : ℕ) (ν σ : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (c : ℝ), 0 < c → Module.finrank ℝ V = n → σ (Vᗮ : Set (Euclid P))ᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → σ K < ∞) → (∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in (V : Set (Euclid P)), σ ((fun y => t + y) ⁻¹' A) ∂μHE[n]) → (∀ᵐ y ∂ν, ENNReal.ofReal c ≤ liminf (fun r : ℝ => ν (ball y r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0)) → ∃ Z : Set (Euclid P), Z.Countable ∧ Z ⊆ (Vᗮ : Set (Euclid P)) ∧ (∀ w ∈ Z, ENNReal.ofReal c ≤ σ {w}) ∧ ν = Measure.sum (fun w : Z => σ {(w : Euclid P)} • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) := by
  intro P n ν σ V c hc hn hσV hσK hD hdens
  -- `Z`: the atoms of `σ` in `Vᗮ` of mass at least `c`
  set Z : Set (Euclid P) := {w | w ∈ (Vᗮ : Set (Euclid P)) ∧ ENNReal.ofReal c ≤ σ {w}}
  -- `Z ∩ B̄_j(0)` is finite: infinitely many atoms of mass `≥ c` would have infinite measure
  have hZc : Z.Countable := by
    rw [← iUnion_inter_closedBall_nat Z (0 : Euclid P)]
    refine countable_iUnion fun j => Set.Finite.countable ?_
    by_contra hinf
    have hlt : σ (Z ∩ closedBall (0 : Euclid P) j) < ∞ :=
      (measure_mono inter_subset_right).trans_lt (hσK _ (isCompact_closedBall _ _))
    exact hlt.ne (Set.Infinite.meas_eq_top hinf
      ⟨ENNReal.ofReal c, (ENNReal.ofReal_pos.2 hc).ne', fun w hw => hw.1.2⟩)
  -- `ν`-a.e. `x`: the density bound and `ν(B_r(x)) ≤ ωₙrⁿσ(B_r(x − p x))` give `x − p x ∈ Z`
  have hae : ∀ᵐ x ∂ν, x - V.starProjection x ∈ Z := by
    filter_upwards [hdens] with x hx
    exact ⟨V.sub_starProjection_mem_orthogonal x, hx.trans
      (Submission.cbr_ci_cp_atm_liminf_density_le_atom P n σ (x - V.starProjection x)
        (fun r => ν (ball x r)) hσK
        (Submission.cbr_ci_cp_atm_ball_le_transversal_ball P n ν σ V hn hσV hD x))⟩
  -- `σ` is carried by the countable set `Z`, so `ν` is the sum of the planes `w + V`, `w ∈ Z`
  have hσZ : σ Zᶜ = 0 :=
    Submission.cbr_ci_cp_atm_transversal_carried P n ν σ V Z hn hσV hD hZc.measurableSet hae
  exact ⟨Z, hZc, fun w hw => hw.1, fun w hw => hw.2,
    Submission.cbr_ci_cp_atm_sum_planes_of_carried P n ν σ V Z hZc hσZ hD⟩

/-- `Hⁿ({y : y - w ∈ V} ∩ B_R(0)) = ωₙ(√(R² - ‖w‖²))ⁿ` for an `n`-dimensional linear subspace `V`
of `ℝᴾ`, an offset `w ∈ V^⊥` and `‖w‖ < R` (a plane in a ball, used in the proof of Simon 7.2.4,
p. 184, for measures carried by finitely many parallel `n`-planes).  Put `ρ = √(R² - ‖w‖²) > 0`.
By Pythagoras `‖t + w‖² = ‖t‖² + ‖w‖²` for `t ∈ V`, so the translation `t ↦ t + w`, an isometry,
maps `V ∩ B_ρ(0)` onto the set; isometry invariance of `μHE[n]` and the subspace-ball formula
`Hⁿ(V ∩ B_ρ(0)) = ωₙρⁿ` conclude. -/
theorem Submission.cbr_ci_cp_fp_offset_plane_ball_measure : ∀ (P n : ℕ) (V : Submodule ℝ (Euclid P)) (w : Euclid P) (R : ℝ), Module.finrank ℝ V = n → w ∈ Vᗮ → ‖w‖ < R → μHE[n] ({y : Euclid P | y - w ∈ V} ∩ ball 0 R) = unitBallVolume n * ENNReal.ofReal (Real.sqrt (R ^ 2 - ‖w‖ ^ 2) ^ n) := by
  intro P n V w R hn hw hR
  -- the radius `ρ = √(R² - ‖w‖²)` is positive and `ρ² = R² - ‖w‖²`
  have hpos : 0 < R ^ 2 - ‖w‖ ^ 2 := by nlinarith [norm_nonneg w]
  have hρ : 0 < Real.sqrt (R ^ 2 - ‖w‖ ^ 2) := Real.sqrt_pos.2 hpos
  have hρsq : Real.sqrt (R ^ 2 - ‖w‖ ^ 2) ^ 2 = R ^ 2 - ‖w‖ ^ 2 := Real.sq_sqrt hpos.le
  -- Pythagoras: `‖t + w‖² = ‖t‖² + ‖w‖²` for `t ∈ V`, as `w ⊥ V`
  have hpyth : ∀ t ∈ V, ‖t + w‖ ^ 2 = ‖t‖ ^ 2 + ‖w‖ ^ 2 := fun t ht => by
    rw [sq, sq, sq]
    exact norm_add_sq_eq_norm_sq_add_norm_sq_real (Submodule.inner_right_of_mem_orthogonal ht hw)
  -- the translation `t ↦ t + w` maps `V ∩ B_ρ(0)` onto `{y | y - w ∈ V} ∩ B_R(0)`
  have himage : (fun t => t + w) '' ((V : Set (Euclid P)) ∩ ball 0 (Real.sqrt (R ^ 2 - ‖w‖ ^ 2))) =
      {y : Euclid P | y - w ∈ V} ∩ ball 0 R := by
    ext y
    simp only [Set.mem_image, Set.mem_inter_iff, SetLike.mem_coe, mem_ball_zero_iff,
      Set.mem_ofPred_eq]
    constructor
    · rintro ⟨t, ⟨ht, htρ⟩, rfl⟩
      refine ⟨by simpa using ht, ?_⟩
      have h := hpyth t ht
      nlinarith [norm_nonneg t, norm_nonneg w, norm_nonneg (t + w)]
    · rintro ⟨hy, hyR⟩
      refine ⟨y - w, ⟨hy, ?_⟩, sub_add_cancel y w⟩
      have h := hpyth (y - w) hy
      rw [sub_add_cancel] at h
      nlinarith [norm_nonneg (y - w), norm_nonneg y]
  -- isometry invariance of `μHE[n]`, then the subspace-ball formula with centre `0 ∈ V`
  rw [← himage, (isometry_add_right w).euclideanHausdorffMeasure_image]
  exact Submission.idtp_tdc_subspace_ball_measure P n V 0 _ hn V.zero_mem hρ

/-- Weighted parallel `n`-planes with at most Euclidean volume growth have total weight `≤ 1`.
Let `V ⊆ ℝᴾ` be an `n`-dimensional subspace, `Z ⊆ V^⊥` and `a : ℝᴾ → [0, ∞]`.  If
`ν = Σ_{w ∈ Z} a(w) Hⁿ⌞{y : y − w ∈ V}` satisfies `ν(B_R(0)) ≤ ωₙRⁿ` for every `R > 0`, then
`Σ_{w ∈ Z} a(w) ≤ 1`.  For a finite set `s` of offsets put `M = Σ_{z ∈ s} ‖z‖` and let `R > M`.
Each plane `z + V` meets `B_R(0)` in an `n`-ball of radius `√(R² − ‖z‖²) ≥ R − M`, so
`ωₙ(R − M)ⁿ Σ_{z ∈ s} a(z) ≤ ν(B_R(0)) ≤ ωₙRⁿ`, i.e. `Σ_{z ∈ s} a(z) ≤ (R / (R − M))ⁿ`; let
`R → ∞`. -/
theorem Submission.cbr_ci_cp_fp_tsum_weight_le_one : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (Z : Set (Euclid P)) (a : Euclid P → ℝ≥0∞), Module.finrank ℝ V = n → Z ⊆ (Vᗮ : Set (Euclid P)) → ν = Measure.sum (fun w : Z => a w • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) → (∀ R : ℝ, 0 < R → ν (ball 0 R) ≤ unitBallVolume n * ENNReal.ofReal (R ^ n)) → ∑' w : Z, a w ≤ 1 := by
  intro P n ν V Z a hn hZ hν hνR
  -- `0 < ωₙ < ∞`
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  -- `ν(B_R(0)) = Σ_{z ∈ Z} a(z) Hⁿ({y : y − z ∈ V} ∩ B_R(0))`
  have hball : ∀ R : ℝ, ν (ball 0 R) =
      ∑' z : Z, a z * μHE[n] ({y : Euclid P | y - z ∈ V} ∩ ball 0 R) := by
    intro R
    rw [hν, Measure.sum_apply _ measurableSet_ball]
    refine tsum_congr fun z => ?_
    rw [Measure.smul_apply, smul_eq_mul, Measure.restrict_apply measurableSet_ball, inter_comm]
  -- it suffices to bound every finite partial sum; `M` bounds the offsets in `s`
  refine ENNReal.summable.tsum_le_of_sum_le fun s => ?_
  obtain ⟨M, hM, hzM⟩ : ∃ M : ℝ, 0 ≤ M ∧ ∀ z ∈ s, ‖(z : Euclid P)‖ ≤ M :=
    ⟨∑ z ∈ s, ‖(z : Euclid P)‖, Finset.sum_nonneg fun _ _ => norm_nonneg _, fun z hz =>
      Finset.single_le_sum (f := fun z : Z => ‖(z : Euclid P)‖) (fun _ _ => norm_nonneg _) hz⟩
  -- for `R > M`: `Σ_{z ∈ s} a(z) ≤ (R / (R − M))ⁿ`
  have key : ∀ R : ℝ, M < R → ∑ z ∈ s, a z ≤ ENNReal.ofReal ((R / (R - M)) ^ n) := by
    intro R hR
    have hRM : 0 < R - M := sub_pos.mpr hR
    -- each plane meets `B_R(0)` in an `n`-ball of radius `√(R² − ‖z‖²) ≥ R − M`
    have hplane : ∀ z ∈ s, unitBallVolume n * ENNReal.ofReal ((R - M) ^ n) ≤
        μHE[n] ({y : Euclid P | y - z ∈ V} ∩ ball 0 R) := by
      intro z hz
      have hzR := hzM z hz
      have hr : R - M ≤ Real.sqrt (R ^ 2 - ‖(z : Euclid P)‖ ^ 2) := by
        refine Real.le_sqrt_of_sq_le ?_
        nlinarith [mul_nonneg hRM.le hM, mul_nonneg (sub_nonneg.mpr hzR) hM,
          mul_nonneg (sub_nonneg.mpr hzR) (norm_nonneg (z : Euclid P))]
      rw [Submission.cbr_ci_cp_fp_offset_plane_ball_measure P n V z R hn (hZ z.2)
        (hzR.trans_lt hR)]
      gcongr
    have hsum : unitBallVolume n * ((∑ z ∈ s, a z) * ENNReal.ofReal ((R - M) ^ n)) ≤
        unitBallVolume n * ENNReal.ofReal (R ^ n) :=
      calc unitBallVolume n * ((∑ z ∈ s, a z) * ENNReal.ofReal ((R - M) ^ n))
          = ∑ z ∈ s, a z * (unitBallVolume n * ENNReal.ofReal ((R - M) ^ n)) := by
            rw [Finset.sum_mul, Finset.mul_sum]
            exact Finset.sum_congr rfl fun z _ => mul_left_comm _ _ _
        _ ≤ ∑ z ∈ s, a z * μHE[n] ({y : Euclid P | y - z ∈ V} ∩ ball 0 R) := by
            gcongr with z hz
            exact hplane z hz
        _ ≤ ∑' z : Z, a z * μHE[n] ({y : Euclid P | y - z ∈ V} ∩ ball 0 R) :=
            ENNReal.sum_le_tsum s
        _ = ν (ball 0 R) := (hball R).symm
        _ ≤ unitBallVolume n * ENNReal.ofReal (R ^ n) := hνR R (hM.trans_lt hR)
    have hpow : 0 < (R - M) ^ n := pow_pos hRM n
    rwa [ENNReal.mul_le_mul_iff_right hω0 hωtop,
      ← ENNReal.le_div_iff_mul_le (Or.inl (ENNReal.ofReal_pos.mpr hpow).ne')
        (Or.inl ENNReal.ofReal_ne_top), ← ENNReal.ofReal_div_of_pos hpow, ← div_pow] at hsum
  -- `(R / (R − M))ⁿ → 1` as `R → ∞`
  have hlim : Tendsto (fun R : ℝ => ENNReal.ofReal ((R / (R - M)) ^ n)) atTop (𝓝 1) := by
    have hsub : Tendsto (fun R : ℝ => R - M) atTop atTop :=
      tendsto_atTop_atTop.2 fun b => ⟨b + M, fun R hR => by linarith⟩
    have h1 : Tendsto (fun R : ℝ => 1 + M / (R - M)) atTop (𝓝 1) := by
      simpa using tendsto_const_nhds.add (tendsto_const_nhds.div_atTop hsub)
    have h2 : Tendsto (fun R : ℝ => R / (R - M)) atTop (𝓝 1) :=
      h1.congr' ((eventually_gt_atTop M).mono fun R hR => by
        rw [← same_add_div (sub_pos.mpr hR).ne', sub_add_cancel])
    simpa using ENNReal.tendsto_ofReal (h2.pow n)
  exact ge_of_tendsto hlim ((eventually_gt_atTop M).mono key)
/-- A finite sum `ν = ∑ᵢ (αᵢ)₊ Hⁿ⌞(wᵢ + V)` of planes parallel to `V`, with offsets `wᵢ ∈ Vᗮ`,
that charges every ball `B_r(0)` has a plane through `0`: some `wᵢ = 0` (used in the proof that
the limit in Simon 7.2.4 is integer multiplicity, Remark 7.2.5(1)).  Otherwise pick
`0 < r < ‖wᵢ‖` for all `i`; for `y ∈ wᵢ + V`, Pythagoras gives `‖y‖² = ‖y - wᵢ‖² + ‖wᵢ‖² > r²`,
so every plane misses `B_r(0)` and `ν(B_r(0)) = 0`. -/
theorem Submission.cbr_ci_cp_fp_exists_offset_eq_zero : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (N : ℕ) (w : Fin N → Euclid P) (α : Fin N → ℝ), (∀ i, w i ∈ Vᗮ) → ν = ∑ i, ENNReal.ofReal (α i) • (μHE[n]).restrict {y : Euclid P | y - w i ∈ V} → (∀ r : ℝ, 0 < r → 0 < ν (ball 0 r)) → ∃ i, w i = 0 := by
  intro P n ν V N w α hw hν hpos
  by_contra hne
  -- a radius `0 < r < ‖w i‖` for each of the finitely many offsets `w i ≠ 0`
  obtain ⟨r, hr, hrw⟩ : ∃ r : ℝ, 0 < r ∧ ∀ i, r < ‖w i‖ :=
    ((eventually_mem_nhdsWithin : ∀ᶠ r in 𝓝[>] (0 : ℝ), r ∈ Ioi 0).and
      (eventually_all.2 fun i => nhdsWithin_le_nhds
        (eventually_lt_nhds (norm_pos_iff.2 fun hi => hne ⟨i, hi⟩)))).exists
  -- by Pythagoras (`w i ∈ Vᗮ`), every plane `{y | y - w i ∈ V}` misses `B_r(0)`
  have hmiss : ∀ i, ball (0 : Euclid P) r ∩ {y : Euclid P | y - w i ∈ V} = ∅ := by
    intro i
    refine eq_empty_iff_forall_notMem.2 fun y ⟨hy, ht⟩ => ?_
    rw [mem_ball_zero_iff] at hy
    have hpyth := norm_add_sq_eq_norm_sq_add_norm_sq_real
      (Submodule.inner_right_of_mem_orthogonal (show y - w i ∈ V from ht) (hw i))
    rw [sub_add_cancel] at hpyth
    have hlt : ‖y‖ < ‖w i‖ := hy.trans (hrw i)
    nlinarith [norm_nonneg y, mul_self_nonneg ‖y - w i‖]
  -- hence `ν(B_r(0)) = 0`, contradicting the positivity hypothesis
  have hzero : ν (ball 0 r) = 0 := by
    rw [hν, Measure.finsetSum_apply]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [Measure.smul_apply, Measure.restrict_apply measurableSet_ball, hmiss i, measure_empty,
      smul_zero]
  exact (hpos r hr).ne' hzero

/-- Let `ν = Σ_{w ∈ Z} a(w) Hⁿ⌞{y : y − w ∈ V}` be a sum of parallel translates of the `n`-plane
`V`, with offsets `Z ⊆ V^⊥` and weights `a(w) ≥ c > 0`.  If `ν(B_R(0)) ≤ ωₙRⁿ` for all `R > 0`
and `ν(B_r(0)) > 0` for all `r > 0`, then `ν = Σᵢ αᵢ Hⁿ⌞{y : y − wᵢ ∈ V}` for finitely many
distinct `wᵢ ∈ V^⊥` and `αᵢ ≥ c` with `Σᵢ αᵢ ≤ 1` and some `wᵢ = 0` (the constant-plane step
of the closure argument for Simon 7.2.4).  The growth bound gives `Σ_{w ∈ Z} a(w) ≤ 1`, so `Z`
is finite; enumerating `Z` gives the finite sum, and positivity near `0` forces a plane through
`0`. -/
theorem Submission.cbr_ci_cp_finite_parallel_planes : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Submodule ℝ (Euclid P)) (Z : Set (Euclid P)) (a : Euclid P → ℝ≥0∞) (c : ℝ), 0 < c → Module.finrank ℝ V = n → Z ⊆ (Vᗮ : Set (Euclid P)) → (∀ w ∈ Z, ENNReal.ofReal c ≤ a w) → ν = Measure.sum (fun w : Z => a w • (μHE[n]).restrict {y : Euclid P | y - w ∈ V}) → (∀ R : ℝ, 0 < R → ν (ball 0 R) ≤ unitBallVolume n * ENNReal.ofReal (R ^ n)) → (∀ r : ℝ, 0 < r → 0 < ν (ball 0 r)) → ∃ (N : ℕ) (w : Fin N → Euclid P) (α : Fin N → ℝ), Injective w ∧ (∀ i, w i ∈ Vᗮ) ∧ (∀ i, c ≤ α i) ∧ ∑ i, α i ≤ 1 ∧ (∃ i, w i = 0) ∧ ν = ∑ i, ENNReal.ofReal (α i) • (μHE[n]).restrict {y : Euclid P | y - w i ∈ V} := by
  intro P n ν V Z a c hc hn hZ ha hν hgrowth hpos
  -- the total weight is at most `1`
  have htsum : ∑' w : Z, a w ≤ 1 :=
    Submission.cbr_ci_cp_fp_tsum_weight_le_one P n ν V Z a hn hZ hν hgrowth
  -- every weight is at least `ofReal c ≠ 0`, so `Z` is finite
  have hZfin : Finite Z := by
    by_contra hinf
    have : Infinite Z := not_finite_iff_infinite.1 hinf
    have hle : ∑' _ : Z, ENNReal.ofReal c ≤ ∑' w : Z, a w :=
      ENNReal.tsum_le_tsum fun w => ha w w.2
    rw [ENNReal.tsum_const_eq_top_of_ne_zero (ENNReal.ofReal_pos.2 hc).ne'] at hle
    exact ENNReal.one_ne_top (top_le_iff.1 (hle.trans htsum))
  have : Fintype Z := Fintype.ofFinite Z
  -- every weight is finite
  have hfin : ∀ w : Z, a w ≠ ∞ := fun w =>
    ne_top_of_le_ne_top ENNReal.one_ne_top ((ENNReal.le_tsum w).trans htsum)
  -- enumerate `Z` as `w₁, …, w_N` and put `αᵢ := a(wᵢ)`
  obtain ⟨e⟩ : Nonempty (Fin (Fintype.card Z) ≃ Z) := ⟨(Fintype.equivFin Z).symm⟩
  have hw : ∀ i, (e i : Euclid P) ∈ Vᗮ := fun i => hZ (e i).2
  have hνsum : ν = ∑ i, ENNReal.ofReal (a (e i)).toReal •
      (μHE[n]).restrict {y : Euclid P | y - (e i : Euclid P) ∈ V} := by
    rw [hν, Measure.sum_fintype, ← e.sum_comp]
    exact Finset.sum_congr rfl fun i _ => by rw [ENNReal.ofReal_toReal (hfin (e i))]
  refine ⟨Fintype.card Z, fun i => e i, fun i => (a (e i)).toReal,
    Subtype.val_injective.comp e.injective, hw,
    fun i => (ENNReal.ofReal_le_iff_le_toReal (hfin (e i))).1 (ha _ (e i).2), ?_,
    Submission.cbr_ci_cp_fp_exists_offset_eq_zero P n ν V (Fintype.card Z) (fun i => e i)
      (fun i => (a (e i)).toReal) hw hνsum hpos, hνsum⟩
  -- `Σᵢ αᵢ = (Σ_{w ∈ Z} a(w)).toReal ≤ 1`
  rw [tsum_fintype] at htsum
  rw [← ENNReal.toReal_sum fun i _ => hfin (e i), e.sum_comp (fun w : Z => a w)]
  exact (ENNReal.toReal_mono ENNReal.one_ne_top htsum).trans_eq ENNReal.toReal_one

/-- **A cycle with constant unit `n`-vector, Euclidean growth and positive lower density is a
finite sum of parallel `n`-planes** (White's tangent-plane argument for the closure theorem used in
Simon 7.2.4; B. White, Comment. Math. Helv. 64 (1989) 207–220).  Let `n = d + 1`, `ν` a locally
finite measure on `ℝᴾ` and `ζ₀` an `n`-vector with `|ζ₀(β)| ≤ |β|` and `ζ₀(β₁) = 1` for some
`|β₁| ≤ 1`, such that `C(ω) = ∫ ⟨ω, ζ₀⟩ dν` has `∂C = 0`, `ν(B_R(0)) ≤ ωₙRⁿ`, `0 ∈ spt ν` and
`liminf_{r↓0} ν(B_r(y))/(ωₙrⁿ) ≥ c > 0` for `ν`-a.e. `y`.  Then `ζ₀(β) = β(v)` for an orthonormal
`v = (v₁, …, vₙ)`, and `ν = Σᵢ αᵢ Hⁿ⌞(wᵢ + span v)` for finitely many distinct `wᵢ ⊥ span v`, one
of them `0`, with `αᵢ ≥ c` and `Σᵢ αᵢ ≤ 1`.  The cycle condition gives a subspace `V` (spanned by
the Riesz representatives of `w ↦ ζ₀(w♭ ∧ α)`) along which `ν` has vanishing directional
derivatives and such that `ζ₀(w♭ ∧ α) = 0` for `w ⊥ V` (`cbr_ci_cp_wedge_annihilator_subspace`);
so `ν` is invariant under translation by `V` (`cbr_ci_cp_translation_invariant_of_fderiv`) and
`ζ₀` only sees coordinates in `V` (`cbr_ci_cp_eval_comp_starProjection_eq`).  The growth bound,
with `ωₙ < ∞` and `ν(B_1(0)) > 0`, gives `dim V ≤ n` (`cbr_ci_cp_finrank_le_of_growth`), and the
normalisation of `ζ₀` then gives `dim V = n` and `ζ₀(β) = β(v)` for an orthonormal frame `v` of
`V` (`cbr_ci_cp_eval_eq_orthonormal_frame`).  Haar uniqueness on `V` gives `ν = Hⁿ⌞V ⊗ σ`
(`cbr_ci_cp_invariant_measure_product`), the lower density bound makes `σ` purely atomic with
atoms `≥ c` (`cbr_ci_cp_atomic_transversal`), and the growth bound and `0 ∈ spt ν` leave finitely
many planes of total weight `≤ 1`, one through `0` (`cbr_ci_cp_finite_parallel_planes`).  Finally
`span v = V`, and `⟨wᵢ, vⱼ⟩ = 0` as `wᵢ ∈ V^⊥` and `vⱼ ∈ V`. -/
theorem Submission.cbr_ci_constant_cycle_planes : ∀ (P d : ℕ) (ν : Measure (Euclid P)) (ζ₀ : MultiVector P (d + 1)) (c : ℝ), 0 < c → (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ β : Covector (Euclid P) (d + 1), |ζ₀ β| ≤ covectorEuclideanNorm β) → (∃ β : Covector (Euclid P) (d + 1), covectorEuclideanNorm β ≤ 1 ∧ ζ₀ β = 1) → (∀ φ : TestFormOn (univ : Set (Euclid P)) d, ∫ y, ζ₀ (exteriorDerivative (φ : DifferentialForm (Euclid P) d) y) ∂ν = 0) → (∀ R : ℝ, 0 < R → ν (ball 0 R) ≤ unitBallVolume (d + 1) * ENNReal.ofReal (R ^ (d + 1))) → (∀ r : ℝ, 0 < r → 0 < ν (ball 0 r)) → (∀ᵐ y ∂ν, ENNReal.ofReal c ≤ liminf (fun r : ℝ => ν (ball y r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0)) → ∃ (v : Fin (d + 1) → Euclid P) (N : ℕ) (w : Fin N → Euclid P) (α : Fin N → ℝ), Orthonormal ℝ v ∧ (∀ β : Covector (Euclid P) (d + 1), ζ₀ β = β v) ∧ Injective w ∧ (∀ (i : Fin N) (j : Fin (d + 1)), inner ℝ (w i) (v j) = 0) ∧ (∀ i, c ≤ α i) ∧ ∑ i, α i ≤ 1 ∧ (∃ i, w i = 0) ∧ ν = ∑ i, ENNReal.ofReal (α i) • (μHE[(d + 1)]).restrict {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)} := by
  intro P d ν ζ₀ c hc hfin hnorm hone hcyc hgrowth hpos hdens
  -- Steps 0–1: a subspace `V` with `∫ Dφ(y)[v] dν(y) = 0` for `v ∈ V` (`φ ∈ C_c^∞`), and
  -- `ζ₀(w♭ ∧ α) = 0` for `w ∈ V^⊥`
  obtain ⟨V, hVderiv, hVann⟩ :=
    Submission.cbr_ci_cp_wedge_annihilator_subspace P d ν ζ₀ hfin hcyc
  -- Step 2: `ν` is invariant under translation by every vector of `V`
  have hinv : ∀ v ∈ V, ∀ A : Set (Euclid P), MeasurableSet A →
      ν ((fun x => v + x) ⁻¹' A) = ν A := fun v hv =>
    Submission.cbr_ci_cp_translation_invariant_of_fderiv P ν v hfin (hVderiv v hv)
  -- Step 3: `ζ₀` only sees coordinates in `V`: `ζ₀(β) = ζ₀(β ∘ p_V)`
  have hproj := Submission.cbr_ci_cp_eval_comp_starProjection_eq P d ζ₀ V hVann
  -- Step 4: `ωₙ < ∞`, `ν(B_1(0)) > 0` and `ν(B_R(0)) ≤ ωₙRⁿ` force `dim V ≤ n`
  have hωn : unitBallVolume (d + 1) ≠ ∞ := measure_ball_lt_top.ne
  have hdimle : Module.finrank ℝ V ≤ d + 1 :=
    Submission.cbr_ci_cp_finrank_le_of_growth P (d + 1) ν V (unitBallVolume (d + 1)) hωn hinv
      hgrowth (hpos 1 one_pos)
  -- Step 5: normalisation: `dim V = n` and `ζ₀(β) = β(v)` for an orthonormal frame `v` of `V`
  obtain ⟨hdim, v, hv, hspan, hζ₀⟩ :=
    Submission.cbr_ci_cp_eval_eq_orthonormal_frame P d ζ₀ V hdimle hnorm hone hproj
  -- Step 6: product structure `ν = Hⁿ⌞V ⊗ σ`, with `σ` concentrated on `V^⊥`
  obtain ⟨σ, hσV, hσfin, hνσ⟩ :=
    Submission.cbr_ci_cp_invariant_measure_product P (d + 1) ν V hdim hfin hinv
  -- Step 7: `σ` is purely atomic, with atoms `Z ⊆ V^⊥` of mass `≥ c`
  obtain ⟨Z, -, hZV, hZc, hνZ⟩ :=
    Submission.cbr_ci_cp_atomic_transversal P (d + 1) ν σ V c hc hdim hσV hσfin hνσ hdens
  -- Steps 8–9: finitely many planes of total weight `≤ 1`, one of them through `0`
  obtain ⟨N, w, α, hw, hwV, hαc, hαsum, hw0, hν⟩ :=
    Submission.cbr_ci_cp_finite_parallel_planes P (d + 1) ν V Z (fun w => σ {w}) c hc hdim hZV
      hZc hνZ hgrowth hpos
  -- Step 10: the required form, with `span v = V` and `⟨wᵢ, vⱼ⟩ = 0` (`wᵢ ∈ V^⊥`, `vⱼ ∈ V`)
  have hvV : ∀ j, v j ∈ V := fun j => hspan ▸ Submodule.subset_span (Set.mem_range_self j)
  refine ⟨v, N, w, α, hv, hζ₀, hw, fun i j => ?_, hαc, hαsum, hw0, ?_⟩
  · exact Submodule.inner_left_of_mem_orthogonal (hvV j) (hwV i)
  · rw [hspan]
    exact hν

/-- Smooth cutoffs converging pointwise to the indicator of an open set (used to recover the
measure of an open set from the integrals of `C_c^∞` test functions by dominated convergence): for
open `V ⊆ ℝⁿ` there are smooth compactly supported `bⱼ : ℝⁿ → [0, 1]` with `spt bⱼ ⊆ V` and
`bⱼ → 𝟙_V` pointwise.  The compact sets `Kⱼ = {y : dist(y, ℝⁿ \ V) ≥ 1/(j+1)} ∩ B̄(0, j)` lie in
`V` and exhaust it; for `rⱼ > 0` with the closed `2rⱼ`-neighbourhood of `Kⱼ` inside `V`, the
smooth Urysohn lemma gives `bⱼ` with support the open `2rⱼ`-neighbourhood of `Kⱼ` and equal to `1`
exactly on the closed `rⱼ`-neighbourhood. -/
theorem Submission.cbr_ci_pw_noi_smooth_cutoff_seq : ∀ (n : ℕ) (V : Set (Euclid n)), IsOpen V → ∃ b : ℕ → Euclid n → ℝ, (∀ j, ContDiff ℝ (⊤ : ℕ∞) (b j)) ∧ (∀ j, HasCompactSupport (b j)) ∧ (∀ j, tsupport (b j) ⊆ V) ∧ (∀ j y, 0 ≤ b j y ∧ b j y ≤ 1) ∧ ∀ y, Tendsto (fun j => b j y) atTop (𝓝 (V.indicator (fun _ => (1 : ℝ)) y)) := by
  intro n V hV
  -- Step 1: the compact exhaustion `Kⱼ = {y : infEDist y Vᶜ ≥ 1/(j+1)} ∩ B̄(0, j)` of `V`.
  set K : ℕ → Set (Euclid n) := fun j =>
    {y | ((j : ℝ≥0∞) + 1)⁻¹ ≤ infEDist y Vᶜ} ∩ closedBall 0 j
  have hKc : ∀ j, IsCompact (K j) := fun j =>
    (isCompact_closedBall 0 (j : ℝ)).inter_left (isClosed_le continuous_const continuous_infEDist)
  have hKV : ∀ j, K j ⊆ V := by
    intro j y hy
    by_contra hyV
    have h1 : ((j : ℝ≥0∞) + 1)⁻¹ ≤ infEDist y Vᶜ := hy.1
    rw [infEDist_zero_of_mem hyV] at h1
    exact (ENNReal.inv_pos.mpr (by simp)).ne' (le_antisymm h1 bot_le)
  have hKev : ∀ y ∈ V, ∀ᶠ j in atTop, y ∈ K j := by
    intro y hy
    have hpos : 0 < infEDist y Vᶜ := by
      rw [infEDist_pos_iff_notMem_closure, hV.isClosed_compl.closure_eq]
      exact fun h => h hy
    have h1 : ∀ᶠ j : ℕ in atTop, ((j : ℝ≥0∞) + 1)⁻¹ ≤ infEDist y Vᶜ := by
      have ht : Tendsto (fun j : ℕ => ((j : ℝ≥0∞) + 1)⁻¹) atTop (𝓝 0) :=
        (ENNReal.tendsto_inv_nat_nhds_zero.comp (tendsto_add_atTop_nat 1)).congr fun j => by simp
      filter_upwards [ht.eventually (gt_mem_nhds hpos)] with j hj using hj.le
    have h2 : ∀ᶠ j : ℕ in atTop, y ∈ closedBall (0 : Euclid n) j := by
      obtain ⟨N, hN⟩ := exists_nat_ge ‖y‖
      filter_upwards [eventually_ge_atTop N] with j hj
      rw [mem_closedBall, dist_zero_right]
      exact hN.trans (by exact_mod_cast hj)
    filter_upwards [h1, h2] with j hj1 hj2 using ⟨hj1, hj2⟩
  -- Step 2: radii `rⱼ > 0` with `cthickening (2 rⱼ) Kⱼ ⊆ V`.
  have hr : ∀ j, ∃ r : ℝ, 0 < r ∧ cthickening (2 * r) (K j) ⊆ V := by
    intro j
    obtain ⟨δ, hδ, hsub⟩ := (hKc j).exists_cthickening_subset_open hV (hKV j)
    exact ⟨δ / 2, by positivity, by rwa [mul_div_cancel₀ _ two_ne_zero]⟩
  choose r hr0 hrV using hr
  -- Step 3: smooth Urysohn functions, `1` exactly on `cthickening rⱼ Kⱼ`, with support
  -- `thickening (2 rⱼ) Kⱼ`.
  have hb : ∀ j, ∃ f : Euclid n → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f ∧ range f ⊆ Icc 0 1 ∧
      support f = thickening (2 * r j) (K j) ∧ ∀ x, x ∈ cthickening (r j) (K j) ↔ f x = 1 :=
    fun j => exists_contDiff_support_eq_eq_one_iff isOpen_thickening isClosed_cthickening
      (cthickening_subset_thickening' (by linarith [hr0 j]) (by linarith [hr0 j]) _)
  choose b hbsmooth hbrange hbsupp hbone using hb
  have htsupp : ∀ j, tsupport (b j) ⊆ cthickening (2 * r j) (K j) := by
    intro j
    rw [tsupport, hbsupp]
    exact closure_thickening_subset_cthickening _ _
  refine ⟨b, hbsmooth,
    fun j => (hKc j).cthickening.of_isClosed_subset (isClosed_tsupport _) (htsupp j),
    fun j => (htsupp j).trans (hrV j), fun j y => hbrange j ⟨y, rfl⟩, fun y => ?_⟩
  -- Step 4: `bⱼ y = 1` for large `j` if `y ∈ V`, and `bⱼ y = 0` for all `j` if `y ∉ V`.
  by_cases hy : y ∈ V
  · rw [indicator_of_mem hy]
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [hKev y hy] with j hj
    exact ((hbone j y).mp (self_subset_cthickening _ hj)).symm
  · rw [indicator_of_notMem hy]
    refine tendsto_const_nhds.congr' (Eventually.of_forall fun j => ?_)
    by_contra hne
    exact hy ((htsupp j).trans (hrV j) (subset_tsupport _ (Ne.symm hne)))

/-- Finite Borel measures on `ℝⁿ` are determined on an open set `U` by their integrals of smooth
functions with compact support in `U`: if `∫ b dμ = ∫ b dν` for every `C^∞` function `b` with
compact support and `spt b ⊆ U`, then `μ⌞U = ν⌞U`.  For open `O`, smooth cutoffs `bⱼ → 𝟙_{O ∩ U}`
with `0 ≤ bⱼ ≤ 1` and dominated convergence give `μ(O ∩ U) = ν(O ∩ U)`; the open sets form a
π-system generating the Borel σ-algebra. -/
theorem Submission.cbr_ci_pw_noi_restrict_eq_of_smooth_test : ∀ (n : ℕ) (U : Set (Euclid n)) (μ ν : Measure (Euclid n)), IsOpen U → IsFiniteMeasure μ → IsFiniteMeasure ν → (∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U → ∫ y, b y ∂μ = ∫ y, b y ∂ν) → μ.restrict U = ν.restrict U := by
  intro n U μ ν hU hμ hν htest
  -- Step 1: `μ` and `ν` agree on `O ∩ U` for every open `O`, by testing with smooth cutoffs
  -- `bⱼ → 𝟙_{O ∩ U}` and dominated convergence (bound `1`, integrable as the measures are finite).
  have hopen : ∀ O : Set (Euclid n), IsOpen O → μ (O ∩ U) = ν (O ∩ U) := by
    intro O hO
    obtain ⟨b, hbs, hbc, hbt, hb01, hblim⟩ :=
      Submission.cbr_ci_pw_noi_smooth_cutoff_seq n (O ∩ U) (hO.inter hU)
    have hlim : ∀ ρ : Measure (Euclid n), IsFiniteMeasure ρ →
        Tendsto (fun j => ∫ y, b j y ∂ρ) atTop (𝓝 (ρ.real (O ∩ U))) := by
      intro ρ hρ
      rw [← integral_indicator_one (hO.inter hU).measurableSet]
      refine tendsto_integral_of_dominated_convergence (fun _ => (1 : ℝ))
        (fun j => (hbs j).continuous.aestronglyMeasurable) (integrable_const 1)
        (fun j => Eventually.of_forall fun y => ?_) (Eventually.of_forall hblim)
      rw [Real.norm_eq_abs, abs_le]
      constructor <;> linarith [(hb01 j y).1, (hb01 j y).2]
    have heq : ∀ j, ∫ y, b j y ∂μ = ∫ y, b j y ∂ν := fun j =>
      htest (b j) (hbs j) (hbc j) ((hbt j).trans inter_subset_right)
    have h₁ := hlim μ hμ
    have h₂ := hlim ν hν
    simp_rw [heq] at h₁
    exact (ENNReal.toReal_eq_toReal_iff' (measure_ne_top _ _) (measure_ne_top _ _)).mp
      (tendsto_nhds_unique h₁ h₂)
  -- Step 2: `μ⌞U` and `ν⌞U` agree on the π-system of open sets, which generates the Borel
  -- σ-algebra, and on `univ`; finite measures agreeing there are equal.
  refine ext_of_generate_finite {s | IsOpen s} BorelSpace.measurable_eq isPiSystem_isOpen ?_ ?_
  · intro s (hs : IsOpen s)
    rw [Measure.restrict_apply hs.measurableSet, Measure.restrict_apply hs.measurableSet]
    exact hopen s hs
  · rw [Measure.restrict_apply_univ, Measure.restrict_apply_univ]
    simpa using hopen univ isOpen_univ

/-- A smooth-test identity between a density and a push-forward holds on Borel subsets of `U`
(closure theorem argument, Simon Ch. 6, as used for 7.2.4): if `∫_U b u dLⁿ = ∫ (b ∘ q) h dσ` for
every smooth `b` with compact support in `U`, then `∫_B u dLⁿ = ∫_{q⁻¹ B} h dσ` for every Borel
`B ⊆ U`.  The finite measures `μ₁ = u⁺ Lⁿ⌞U + q_♯(h⁻ σ)` and `μ₂ = u⁻ Lⁿ⌞U + q_♯(h⁺ σ)` have the
same integral against every such `b`, hence agree on `U`; evaluating them on `B` and splitting `u`
and `h` into positive and negative parts gives the identity. -/
theorem Submission.cbr_ci_pw_noi_setIntegral_eq_preimage : ∀ (P n : ℕ) (U : Set (Euclid n)) (u : Euclid n → ℝ) (σ : Measure (Euclid P)) (q : Euclid P → Euclid n) (h : Euclid P → ℝ), IsOpen U → Measurable q → IntegrableOn u U → Integrable h σ → (∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U → ∫ y in U, b y * u y = ∫ x, b (q x) * h x ∂σ) → ∀ B : Set (Euclid n), MeasurableSet B → B ⊆ U → ∫ y in B, u y = ∫ x in q ⁻¹' B, h x ∂σ := by
  intro P n U u σ q h hU hq hu hh htest B hB hBU
  -- Step 1: the finite measures `λ± = u± Lⁿ⌞U` and `m± = q_♯(h± σ)`.
  set lp : Measure (Euclid n) := (volume.restrict U).withDensity fun y => ENNReal.ofReal (u y)
    with hlp
  set lm : Measure (Euclid n) := (volume.restrict U).withDensity fun y => ENNReal.ofReal (-u y)
    with hlm
  set mp : Measure (Euclid n) := (σ.withDensity fun x => ENNReal.ofReal (h x)).map q with hmp
  set mm : Measure (Euclid n) := (σ.withDensity fun x => ENNReal.ofReal (-h x)).map q with hmm
  have hlpf : IsFiniteMeasure lp := isFiniteMeasure_withDensity_ofReal hu.2
  have hlmf : IsFiniteMeasure lm := isFiniteMeasure_withDensity_ofReal hu.neg.2
  have hmpf : IsFiniteMeasure mp := by
    have : IsFiniteMeasure (σ.withDensity fun x => ENNReal.ofReal (h x)) :=
      isFiniteMeasure_withDensity_ofReal hh.2
    exact Measure.isFiniteMeasure_map _ _
  have hmmf : IsFiniteMeasure mm := by
    have : IsFiniteMeasure (σ.withDensity fun x => ENNReal.ofReal (-h x)) :=
      isFiniteMeasure_withDensity_ofReal hh.neg.2
    exact Measure.isFiniteMeasure_map _ _
  -- Step 2: integrals of a function `b` against `λ±` and `m±`.
  have hlam : ∀ (f : Euclid n → ℝ) (b : Euclid n → ℝ), IntegrableOn f U →
      ∫ y, b y ∂((volume.restrict U).withDensity fun y => ENNReal.ofReal (f y)) =
        ∫ y in U, max (f y) 0 * b y := by
    intro f b hf
    rw [integral_withDensity_eq_integral_toReal_smul₀ hf.aemeasurable.ennreal_ofReal
      (Eventually.of_forall fun _ => ENNReal.ofReal_lt_top)]
    simp only [ENNReal.toReal_ofReal', smul_eq_mul]
  have hpush : ∀ (g : Euclid P → ℝ) (b : Euclid n → ℝ), Integrable g σ → Continuous b →
      ∫ y, b y ∂((σ.withDensity fun x => ENNReal.ofReal (g x)).map q) =
        ∫ x, max (g x) 0 * b (q x) ∂σ := by
    intro g b hg hb
    rw [integral_map hq.aemeasurable hb.aestronglyMeasurable,
      integral_withDensity_eq_integral_toReal_smul₀ hg.aemeasurable.ennreal_ofReal
        (Eventually.of_forall fun _ => ENNReal.ofReal_lt_top)]
    simp only [ENNReal.toReal_ofReal', smul_eq_mul]
  -- Step 3: `λ₊ + m₋` and `λ₋ + m₊` have the same integral against every test function, since
  -- `u = u⁺ - u⁻`, `h = h⁺ - h⁻` and `∫_U b u = ∫ (b ∘ q) h dσ`.
  have hkey : ∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U →
      ∫ y, b y ∂(lp + mm) = ∫ y, b y ∂(lm + mp) := by
    intro b hb hbc hbU
    have hbcont : Continuous b := hb.continuous
    obtain ⟨C, hC⟩ := hbcont.bounded_above_of_compact_support hbc
    have hbm : AEStronglyMeasurable b (volume.restrict U) := hbcont.aestronglyMeasurable
    have hbqm : AEStronglyMeasurable (fun x => b (q x)) σ :=
      (hbcont.measurable.comp hq).aestronglyMeasurable
    rw [integral_add_measure (hbcont.integrable_of_hasCompactSupport hbc)
        (hbcont.integrable_of_hasCompactSupport hbc),
      integral_add_measure (hbcont.integrable_of_hasCompactSupport hbc)
        (hbcont.integrable_of_hasCompactSupport hbc),
      hlam u b hu, hlam (fun y => -u y) b hu.neg, hpush h b hh hbcont,
      hpush (fun x => -h x) b hh.neg hbcont]
    have I1 : (∫ y in U, max (u y) 0 * b y) - ∫ y in U, max (-u y) 0 * b y =
        ∫ y in U, b y * u y := by
      have hsub := integral_sub (hu.pos_part.mul_bdd hbm (Eventually.of_forall hC))
        (hu.neg_part.mul_bdd hbm (Eventually.of_forall hC))
      refine hsub.symm.trans (integral_congr_ae (Eventually.of_forall fun y => ?_))
      simp only
      rw [← sub_mul, max_zero_sub_max_neg_zero_eq_self, mul_comm]
    have I2 : ∫ x, max (h x) 0 * b (q x) ∂σ - ∫ x, max (-h x) 0 * b (q x) ∂σ =
        ∫ x, b (q x) * h x ∂σ := by
      have hsub := integral_sub (hh.pos_part.mul_bdd hbqm (Eventually.of_forall fun x => hC (q x)))
        (hh.neg_part.mul_bdd hbqm (Eventually.of_forall fun x => hC (q x)))
      refine hsub.symm.trans (integral_congr_ae (Eventually.of_forall fun x => ?_))
      simp only
      rw [← sub_mul, max_zero_sub_max_neg_zero_eq_self, mul_comm]
    have := htest b hb hbc hbU
    linarith
  -- Step 4: uniqueness, so the two measures agree on the measurable subset `B` of `U`.
  have hres := Submission.cbr_ci_pw_noi_restrict_eq_of_smooth_test n U (lp + mm) (lm + mp) hU
    inferInstance inferInstance hkey
  have hBeq : (lp + mm) B = (lm + mp) B := by
    have := congrArg (fun μ : Measure (Euclid n) => μ B) hres
    simpa only [Measure.restrict_apply hB, inter_eq_left.mpr hBU] using this
  -- Step 5: `λ±(B) = ∫⁻_B (±u)⁺` and `m±(B) = ∫⁻_{q⁻¹ B} (±h)⁺ dσ`.
  have hlB : ∀ f : Euclid n → ℝ, ((volume.restrict U).withDensity fun y => ENNReal.ofReal (f y)) B =
      ∫⁻ y in B, ENNReal.ofReal (f y) := by
    intro f
    rw [withDensity_apply _ hB, Measure.restrict_restrict hB, inter_eq_left.mpr hBU]
  have hmB : ∀ g : Euclid P → ℝ, ((σ.withDensity fun x => ENNReal.ofReal (g x)).map q) B =
      ∫⁻ x in q ⁻¹' B, ENNReal.ofReal (g x) ∂σ := by
    intro g
    rw [Measure.map_apply hq hB, withDensity_apply _ (hq hB)]
  -- Step 6: all four values are finite, so the identity of Step 4 passes to real numbers, and
  -- both set integrals are differences of positive and negative parts.
  rw [Measure.add_apply, Measure.add_apply] at hBeq
  have hreal : (lp B).toReal + (mm B).toReal = (lm B).toReal + (mp B).toReal := by
    rw [← ENNReal.toReal_add (measure_ne_top _ _) (measure_ne_top _ _),
      ← ENNReal.toReal_add (measure_ne_top _ _) (measure_ne_top _ _), hBeq]
  have hL : ∫ y in B, u y = (lp B).toReal - (lm B).toReal := by
    rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part (hu.mono_set hBU), hlp, hlm, hlB, hlB]
  have hR : ∫ x in q ⁻¹' B, h x ∂σ = (mp B).toReal - (mm B).toReal := by
    rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hh.integrableOn, hmp, hmm, hmB, hmB]
  rw [hL, hR]
  linarith

/-- Null-off-image bound for the density `u` (step 10 of the weight-at-least-one argument): if
`∫_U b u = ∫ (b ∘ q) h dσ` for every `b ∈ C_c^∞(U)` and `σ` is carried by `A`, then `u = 0`
`Lⁿ`-a.e. on `U \ q(A)`, i.e. `Lⁿ(B ∩ {u ≠ 0}) ≤ Lⁿ(B ∩ q(A))` for measurable `B ⊆ U`.  With
`E` a measurable hull of `q(A)`, every measurable `B' ⊆ U \ E` has `σ`-null preimage `q⁻¹(B')`,
so `∫_{B'} u = ∫_{q⁻¹(B')} h dσ = 0` (`cbr_ci_pw_noi_setIntegral_eq_preimage`); hence `u = 0`
a.e. on `U \ E` and `Lⁿ(B ∩ {u ≠ 0}) ≤ Lⁿ(B ∩ E) = Lⁿ(B ∩ q(A))`. -/
theorem Submission.cbr_ci_pw_density_null_off_image : ∀ (P n : ℕ) (U : Set (Euclid n)) (u : Euclid n → ℝ) (σ : Measure (Euclid P)) (q : Euclid P → Euclid n) (h : Euclid P → ℝ) (A : Set (Euclid P)), IsOpen U → Continuous q → IntegrableOn u U → σ univ < ∞ → Integrable h σ → σ Aᶜ = 0 → (∀ b : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → tsupport b ⊆ U → ∫ y in U, b y * u y = ∫ x, b (q x) * h x ∂σ) → ∀ B : Set (Euclid n), MeasurableSet B → B ⊆ U → volume (B ∩ {y | u y ≠ 0}) ≤ volume (B ∩ q '' A) := by
  intro P n U u σ q h A hU hq hu _hσ hh hA htest B hB hBU
  -- the measurable hull `E` of `q '' A`
  set E : Set (Euclid n) := toMeasurable volume (q '' A) with hE
  have hUE : MeasurableSet (U \ E) := hU.measurableSet.diff (measurableSet_toMeasurable _ _)
  -- `∫_s u = 0` for measurable `s ⊆ U \ E`, because `q ⁻¹' s ⊆ Aᶜ` is `σ`-null
  have hzero : ∀ s : Set (Euclid n), MeasurableSet s → s ⊆ U \ E → ∫ y in s, u y = 0 := by
    intro s hs hsUE
    rw [Submission.cbr_ci_pw_noi_setIntegral_eq_preimage P n U u σ q h hU hq.measurable hu hh
      htest s hs (hsUE.trans sdiff_subset)]
    refine setIntegral_measure_zero _ (measure_mono_null ?_ hA)
    intro x hx hxA
    exact (hsUE hx).2 (subset_toMeasurable _ _ ⟨x, hxA, rfl⟩)
  -- hence `u = 0` a.e. on `U \ E`
  have hae : u =ᵐ[volume.restrict (U \ E)] 0 :=
    (hu.mono_set sdiff_subset).ae_eq_zero_of_forall_setIntegral_eq_zero fun s hs _ => by
      rw [Measure.restrict_restrict hs]
      exact hzero _ (hs.inter hUE) inter_subset_right
  have hnull : volume ({y | u y ≠ 0} ∩ (U \ E)) = 0 := by
    rw [← Measure.restrict_apply' hUE]
    exact hae
  -- `B ∩ {u ≠ 0} ⊆ (B ∩ E) ∪ ({u ≠ 0} ∩ (U \ E))` and `Lⁿ(B ∩ E) = Lⁿ(B ∩ q '' A)`
  calc volume (B ∩ {y | u y ≠ 0})
      ≤ volume (B ∩ E ∪ {y | u y ≠ 0} ∩ (U \ E)) := by
        refine measure_mono fun y hy => ?_
        by_cases hyE : y ∈ E
        · exact Or.inl ⟨hy.1, hyE⟩
        · exact Or.inr ⟨hy.2, hBU hy.1, hyE⟩
    _ ≤ volume (B ∩ E) + volume ({y | u y ≠ 0} ∩ (U \ E)) := measure_union_le _ _
    _ = volume (B ∩ q '' A) := by
        rw [hnull, add_zero, inter_comm, hE,
          Measure.measure_toMeasurable_inter_of_sFinite hB, inter_comm]
/-- **Weak continuity of Jacobian minors of Lipschitz maps** (the induction `P(r)` of the weak
continuity of minors; Reshetnyak, Ball 1977, Ball–Currie–Olver 1981): if `gʲ_c, g_c` (`c < r`)
are `L`-Lipschitz on `ℝᵏ` with `gʲ_c → g_c` uniformly, `V_b ∈ ℝᵏ` and `φ` is integrable, then
`∫ φ det (Dgʲ_c V_b) → ∫ φ det (Dg_c V_b)`.  Induction on `r`, for all `L`, rows, directions and
weights; `r = 0` is trivial (the empty determinant is `1`).  For `r + 1` the minors are measurable
and bounded by `(r+1)! (L Σ_b ‖V_b‖)^(r+1)`, so by the weak-* upgrade it suffices to test against
`ψ ∈ C^∞_c`, and integration by parts gives `∫ ψ det = −Σ_b (−1)^b ∫ ∂_{V_b}ψ · g₀ · M_b`.  Split
`gʲ₀ = (gʲ₀ − g₀) + g₀`: the error term is at most `sup |gʲ₀ − g₀| · Br ∫ |∂_{V_b}ψ| → 0`, where
`Br` bounds the `r × r` minors `Mʲ_b`, and the main term converges by the induction hypothesis
with the integrable weight `∂_{V_b}ψ · g₀`. -/
theorem Submission.cmcdt_lpi_mwc_coordinate_minor_continuity : ∀ (k r : ℕ) (L : NNReal) (gs : ℕ → Fin r → Euclid k → ℝ) (g : Fin r → Euclid k → ℝ) (V : Fin r → Euclid k) (φ : Euclid k → ℝ), Integrable φ → (∀ j c, LipschitzWith L (gs j c)) → (∀ c, LipschitzWith L (g c)) → (∀ c, TendstoUniformly (fun j => gs j c) (g c) atTop) → Tendsto (fun j => ∫ x, φ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (gs j c) x (V b))) atTop (𝓝 (∫ x, φ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))) := by
  intro k r
  induction r with
  | zero =>
    -- step 1: the empty determinant is `1`, so the sequence is constant
    intro L gs g V φ _ _ _ _
    simp only [Matrix.det_isEmpty, mul_one]
    exact tendsto_const_nhds
  | succ r ih =>
    intro L gs g V φ hφ hgs hg hconv
    -- step 2: the minors are measurable and bounded, so `C^∞_c` weights `ψ` suffice
    have hMs := fun j =>
      Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L (gs j) V (hgs j)
    have hM := Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L g V hg
    refine Submission.dor_lmb_fcd_jwc_weak_star_l1_upgrade k _
      (fun j x => Matrix.det (Matrix.of fun c b => fderiv ℝ (gs j c) x (V b)))
      (fun x => Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))
      (fun j => (hMs j).1.aestronglyMeasurable) hM.1.aestronglyMeasurable (fun j => (hMs j).2)
      hM.2 ?_ φ hφ
    intro ψ hψ hψs
    have hψ1 : ContDiff ℝ 1 ψ := hψ.of_le (by simp)
    -- step 3: integrate by parts (for every `j` and for the limit); it suffices to treat each `b`
    suffices hR : ∀ b : Fin (r + 1), Tendsto (fun j => ∫ x, fderiv ℝ ψ x (V b) * gs j 0 x *
        Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) atTop
        (𝓝 (∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (g c.succ) x (V (b.succAbove b'))))) by
      rw [Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp k r L g V ψ hg hψ1 hψs]
      refine Tendsto.congr (fun j => (Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp k r L (gs j)
        V ψ (hgs j) hψ1 hψs).symm) ?_
      exact Tendsto.neg (tendsto_finsetSum _ fun b _ => (hR b).const_mul _)
    intro b
    -- step 4: `χ = ∂_{V_b}ψ` and `θ = χ · g 0` are continuous with compact support, hence
    -- integrable; the minors `M j` are measurable and bounded by `Br`
    have hχc : Continuous (fun x => fderiv ℝ ψ x (V b)) :=
      (hψ1.continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hχs : HasCompactSupport (fun x => fderiv ℝ ψ x (V b)) :=
      hψs.fderiv_apply (𝕜 := ℝ) (V b)
    have hχi : Integrable (fun x => fderiv ℝ ψ x (V b)) :=
      hχc.integrable_of_hasCompactSupport hχs
    have hθi : Integrable (fun x => fderiv ℝ ψ x (V b) * g 0 x) :=
      (hχc.mul (hg 0).continuous).integrable_of_hasCompactSupport hχs.mul_right
    have hMb := fun j => Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L
      (fun c => gs j c.succ) (fun b' => V (b.succAbove b')) (fun c => hgs j c.succ)
    obtain ⟨Br, hBr0, hBr⟩ : ∃ Br : ℝ, 0 ≤ Br ∧ ∀ j x, ‖Matrix.det (Matrix.of fun (c b' : Fin r) =>
        fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))‖ ≤ Br :=
      ⟨(r.factorial : ℝ) * ((L : ℝ) * ∑ b', ‖V (b.succAbove b')‖) ^ r, by positivity,
        fun j x => by rw [Real.norm_eq_abs]; exact (hMb j).2 x⟩
    have hI1 : ∀ j, Integrable (fun x => fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) *
        Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) := fun j =>
      ((hχc.mul ((hgs j 0).continuous.sub (hg 0).continuous)).integrable_of_hasCompactSupport
        hχs.mul_right).mul_bdd (hMb j).1.aestronglyMeasurable (Eventually.of_forall (hBr j))
    have hI2 : ∀ j, Integrable (fun x => fderiv ℝ ψ x (V b) * g 0 x *
        Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) := fun j =>
      hθi.mul_bdd (hMb j).1.aestronglyMeasurable (Eventually.of_forall (hBr j))
    -- split `gs j 0 = (gs j 0 - g 0) + g 0`
    have hsplit : ∀ j, ∫ x, fderiv ℝ ψ x (V b) * gs j 0 x * Matrix.det (Matrix.of
        fun (c b' : Fin r) => fderiv ℝ (gs j c.succ) x (V (b.succAbove b'))) =
        (∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Matrix.det (Matrix.of
          fun (c b' : Fin r) => fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) +
        ∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of
          fun (c b' : Fin r) => fderiv ℝ (gs j c.succ) x (V (b.succAbove b'))) := by
      intro j
      rw [← integral_add (hI1 j) (hI2 j)]
      congr 1
      funext x
      ring
    -- step 5: the error term tends to `0` by the uniform convergence `gs j 0 → g 0`
    have hT1 : Tendsto (fun j => ∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) *
        Matrix.det (Matrix.of fun (c b' : Fin r) =>
          fderiv ℝ (gs j c.succ) x (V (b.succAbove b')))) atTop (𝓝 0) := by
      obtain ⟨A, hA0, hA⟩ : ∃ A : ℝ, 0 ≤ A ∧ ∫ x, ‖fderiv ℝ ψ x (V b)‖ = A :=
        ⟨∫ x, ‖fderiv ℝ ψ x (V b)‖, integral_nonneg fun x => norm_nonneg _, rfl⟩
      have hBA : 0 ≤ Br * A := mul_nonneg hBr0 hA0
      rw [Metric.tendsto_atTop]
      intro ε hε
      have hδ : 0 < ε / (Br * A + 1) := by positivity
      obtain ⟨N, hN⟩ := (Metric.tendstoUniformly_iff.1 (hconv 0) _ hδ).exists_forall_of_atTop
      refine ⟨N, fun j hj => ?_⟩
      rw [dist_zero_right]
      calc _ ≤ ∫ x, ε / (Br * A + 1) * Br * ‖fderiv ℝ ψ x (V b)‖ := by
            refine norm_integral_le_of_norm_le (hχi.norm.const_mul _)
              (Eventually.of_forall fun x => ?_)
            have h1 : ‖gs j 0 x - g 0 x‖ ≤ ε / (Br * A + 1) := by
              have := hN j hj x
              rw [dist_comm, dist_eq_norm] at this
              exact this.le
            have h2 := hBr j x
            rw [norm_mul, norm_mul]
            calc _ ≤ ‖fderiv ℝ ψ x (V b)‖ * (ε / (Br * A + 1)) * Br := by gcongr
              _ = ε / (Br * A + 1) * Br * ‖fderiv ℝ ψ x (V b)‖ := by ring
        _ = ε / (Br * A + 1) * (Br * A) := by rw [integral_const_mul, hA]; ring
        _ < ε / (Br * A + 1) * (Br * A + 1) := mul_lt_mul_of_pos_left (by linarith) hδ
        _ = ε := div_mul_cancel₀ ε (by positivity)
    -- step 6: the main term converges by the induction hypothesis with the weight `θ`
    have hT2 := ih L (fun j c => gs j c.succ) (fun c => g c.succ) (fun b' => V (b.succAbove b'))
      (fun x => fderiv ℝ ψ x (V b) * g 0 x) hθi (fun j c => hgs j c.succ) (fun c => hg c.succ)
      (fun c => hconv c.succ)
    -- step 7: add the two limits
    have hsum := hT1.add hT2
    rw [zero_add] at hsum
    exact hsum.congr fun j => (hsplit j).symm

/-- **Weak continuity of Jacobian minors of Lipschitz maps** (step 6(v) of the integrality of
Lipschitz push-forwards; Simon Ch. 6, 2.29): if `v_j, v₀ : ℝᵐ → ℝᵖ` are `L`-Lipschitz, `v_j → v₀`
uniformly and `c ∈ L¹`, then `∫ c M^{a,b}(v_j) → ∫ c M^{a,b}(v₀)`, where
`M^{a,b}(v)(u) = det ((Dv(u) e_{b_t})_{a_s})_{s,t}`.  The coordinate projection `p_i y = y_i` is
`1`-Lipschitz, so the rows `v^{a_s} = p_{a_s} ∘ v` are `L`-Lipschitz and `v_j^{a_s} → v₀^{a_s}`
uniformly; the coordinate version `cmcdt_lpi_mwc_coordinate_minor_continuity` (with
`V_t = e_{b_t}`, `φ = c`) gives the convergence for the minors `det (D(v^{a_s}) e_{b_t})_{s,t}`.
At every point where `v` is differentiable, hence a.e. by Rademacher,
`D(v^{a_s})(u) = p_{a_s} ∘ Dv(u)`, so these minors have the same integrals as `M^{a,b}(v)`. -/
theorem Submission.cmcdt_lpi_minor_weak_continuity : ∀ (m p r : ℕ) (L : NNReal) (v : ℕ → Euclid m → Euclid p) (v₀ : Euclid m → Euclid p) (a : Fin r → Fin p) (b : Fin r → Fin m) (c : Euclid m → ℝ), (∀ j, LipschitzWith L (v j)) → LipschitzWith L v₀ → TendstoUniformly v v₀ atTop → Integrable c → Tendsto (fun j => ∫ u, c u * Matrix.det (Matrix.of fun s t => fderiv ℝ (v j) u (EuclideanSpace.single (b t) 1) (a s))) atTop (𝓝 (∫ u, c u * Matrix.det (Matrix.of fun s t => fderiv ℝ v₀ u (EuclideanSpace.single (b t) 1) (a s)))) := by
  intro m p r L v v₀ a b c hv hv₀ hvv₀ hc
  -- step 1: the coordinate projection `y ↦ y i` is `1`-Lipschitz, so the rows
  -- `v^{a_s} = (· (a s)) ∘ v` are `L`-Lipschitz and converge uniformly
  have hproj : ∀ i : Fin p, LipschitzWith 1 (fun y : Euclid p => y i) := fun i =>
    LipschitzWith.of_dist_le_mul fun y y' => by
      rw [NNReal.coe_one, one_mul]
      exact PiLp.dist_apply_le y y' i
  have hrow : ∀ f : Euclid m → Euclid p, LipschitzWith L f → ∀ s,
      LipschitzWith L (fun u => f u (a s)) := fun f hf s => by
    have h := (hproj (a s)).comp hf
    rw [one_mul] at h
    exact h
  -- step 2: by Rademacher, a.e. `D(v^{a_s})(u) e_{b_t} = (Dv(u) e_{b_t})_{a_s}`, so the
  -- coordinate minors have the same integrals as the minors of the statement
  have hcoord : ∀ f : Euclid m → Euclid p, LipschitzWith L f →
      ∫ u, c u * Matrix.det (Matrix.of fun s t =>
        fderiv ℝ (fun y => f y (a s)) u (EuclideanSpace.single (b t) 1)) =
      ∫ u, c u * Matrix.det (Matrix.of fun s t =>
        fderiv ℝ f u (EuclideanSpace.single (b t) 1) (a s)) := by
    intro f hf
    refine integral_congr_ae ?_
    filter_upwards [hf.ae_differentiableAt] with u hu
    have hent : ∀ (i : Fin p) (w : Euclid m),
        fderiv ℝ (fun y => f y i) u w = fderiv ℝ f u w i := by
      intro i w
      have h := (PiLp.hasFDerivAt_apply (𝕜 := ℝ) 2 (f u) i).comp u hu.hasFDerivAt
      rw [show (fun y => f y i) = (fun g : Euclid p => g i) ∘ f from rfl, h.fderiv]
      rfl
    simp only [hent]
  -- step 3: the coordinate statement for `g_s = v^{a_s}`, `V_t = e_{b_t}` and `φ = c`
  have h := Submission.cmcdt_lpi_mwc_coordinate_minor_continuity m r L
    (fun j s u => v j u (a s)) (fun s u => v₀ u (a s)) (fun t => EuclideanSpace.single (b t) 1) c
    hc (fun j => hrow (v j) (hv j)) (hrow v₀ hv₀)
    (fun s => (hproj (a s)).uniformContinuous.comp_tendstoUniformly hvv₀)
  rw [hcoord v₀ hv₀] at h
  exact h.congr fun j => hcoord (v j) (hv j)

/-- **Weak continuity of `f(v_j) · M(v_j)` against `L¹` weights.**  Let `v_j → v₀` uniformly,
all `L`-Lipschitz, `w ∈ L¹(ℝ^m)`, `f` continuous with compact support, and
`M(v)(u) = det((Dv(u) e_{b t})_{a s})_{s,t}`.  Then `∫ w f(v_j) M(v_j) → ∫ w f(v₀) M(v₀)`.  Split
`w f(v_j) M_j = w (f(v_j) - f(v₀)) M_j + c M_j` with `c = w f(v₀) ∈ L¹`.  Since `|M_j| ≤ K = r! Lʳ`
and `f ∘ v_j → f ∘ v₀` uniformly, the first integral is eventually at most `η K ‖w‖₁` for any
`η > 0`; the second converges by the weak continuity of Jacobian minors. -/
theorem Submission.cmcdt_lpi_pc_scalar_weak_continuity : ∀ (m p r : ℕ) (L : NNReal) (v : ℕ → Euclid m → Euclid p) (v₀ : Euclid m → Euclid p) (a : Fin r → Fin p) (b : Fin r → Fin m) (w : Euclid m → ℝ) (f : Euclid p → ℝ), (∀ j, LipschitzWith L (v j)) → LipschitzWith L v₀ → TendstoUniformly v v₀ atTop → Integrable w → Continuous f → HasCompactSupport f → Tendsto (fun j => ∫ u, w u * (f (v j u) * Matrix.det (Matrix.of fun s t => fderiv ℝ (v j) u (EuclideanSpace.single (b t) 1) (a s)))) atTop (𝓝 (∫ u, w u * (f (v₀ u) * Matrix.det (Matrix.of fun s t => fderiv ℝ v₀ u (EuclideanSpace.single (b t) 1) (a s))))) := by
  intro m p r L v v₀ a b w f hv hv₀ hunif hw hf hfc
  -- `f` is bounded by `C`, so the weight `c = w · f(v₀)` is integrable
  obtain ⟨C, hC⟩ := hf.bounded_above_of_compact_support hfc
  have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC 0)
  have hc : Integrable (fun u => w u * f (v₀ u)) :=
    hw.mul_bdd (hf.comp hv₀.continuous).aestronglyMeasurable (Eventually.of_forall fun u => hC (v₀ u))
  -- the minors are measurable and bounded by `r! Lʳ`, and their `c`-integrals converge
  suffices key : ∀ (M : ℕ → Euclid m → ℝ) (M₀ : Euclid m → ℝ) (K : ℝ), (∀ j, Measurable (M j)) →
      (∀ j u, |M j u| ≤ K) →
      Tendsto (fun j => ∫ u, w u * f (v₀ u) * M j u) atTop (𝓝 (∫ u, w u * f (v₀ u) * M₀ u)) →
      Tendsto (fun j => ∫ u, w u * (f (v j u) * M j u)) atTop (𝓝 (∫ u, w u * (f (v₀ u) * M₀ u))) from
    key (fun j u => Matrix.det (Matrix.of fun s t => fderiv ℝ (v j) u (EuclideanSpace.single (b t) 1) (a s)))
      (fun u => Matrix.det (Matrix.of fun s t => fderiv ℝ v₀ u (EuclideanSpace.single (b t) 1) (a s)))
      ((r.factorial : ℝ) * (L : ℝ) ^ r)
      (fun j => (Submission.cmcdt_lpi_pc_minor_measurable_bound m p r L (v j) a b (hv j)).1)
      (fun j => (Submission.cmcdt_lpi_pc_minor_measurable_bound m p r L (v j) a b (hv j)).2)
      (Submission.cmcdt_lpi_minor_weak_continuity m p r L v v₀ a b (fun u => w u * f (v₀ u)) hv hv₀
        hunif hc)
  intro M M₀ K hM hMK hS
  have hK : 0 ≤ K := (abs_nonneg _).trans (hMK 0 0)
  have hfv : ∀ j, Continuous (fun u => f (v j u)) := fun j => hf.comp (hv j).continuous
  have hfv₀ : Continuous (fun u => f (v₀ u)) := hf.comp hv₀.continuous
  -- split `w f(v_j) M_j = w (f(v_j) - f(v₀)) M_j + c M_j`; both pieces are integrable
  have hI₁ : ∀ j, Integrable (fun u => w u * ((f (v j u) - f (v₀ u)) * M j u)) := fun j =>
    hw.mul_bdd (c := (C + C) * K) (((hfv j).sub hfv₀).measurable.mul (hM j)).aestronglyMeasurable
      (Eventually.of_forall fun u => by
        rw [norm_mul, Real.norm_eq_abs (M j u)]
        exact mul_le_mul ((norm_sub_le _ _).trans (add_le_add (hC _) (hC _))) (hMK j u)
          (abs_nonneg _) (by linarith))
  have hI₂ : ∀ j, Integrable (fun u => w u * f (v₀ u) * M j u) := fun j =>
    hc.mul_bdd (c := K) (hM j).aestronglyMeasurable
      (Eventually.of_forall fun u => (Real.norm_eq_abs _).le.trans (hMK j u))
  have hsplit : ∀ j, (∫ u, w u * (f (v j u) * M j u)) =
      (∫ u, w u * ((f (v j u) - f (v₀ u)) * M j u)) + ∫ u, w u * f (v₀ u) * M j u := by
    intro j
    rw [← integral_add (hI₁ j) (hI₂ j)]
    congr 1
    funext u
    ring
  -- the first piece tends to `0`
  have hT : Tendsto (fun j => ∫ u, w u * ((f (v j u) - f (v₀ u)) * M j u)) atTop (𝓝 0) := by
    have hU := (hfc.uniformContinuous_of_continuous hf).comp_tendstoUniformly hunif
    have hW : 0 ≤ ∫ u, ‖w u‖ := integral_nonneg fun u => norm_nonneg (w u)
    have hD : 0 < K * (∫ u, ‖w u‖) + 1 := by nlinarith [mul_nonneg hK hW]
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨η, hη, hηε⟩ : ∃ η : ℝ, 0 < η ∧ η * K * (∫ u, ‖w u‖) < ε := by
      refine ⟨ε / (K * (∫ u, ‖w u‖) + 1), div_pos hε hD, ?_⟩
      rw [mul_assoc, div_mul_eq_mul_div, div_lt_iff₀ hD]
      nlinarith [mul_nonneg hK hW]
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.1 (Metric.tendstoUniformly_iff.1 hU η hη)
    refine ⟨N, fun n hn => ?_⟩
    have hpt : ∀ u, ‖w u * ((f (v n u) - f (v₀ u)) * M n u)‖ ≤ η * K * ‖w u‖ := by
      intro u
      have h₁ : ‖f (v n u) - f (v₀ u)‖ ≤ η := by
        rw [← dist_eq_norm, dist_comm]
        exact (hN n hn u).le
      calc ‖w u * ((f (v n u) - f (v₀ u)) * M n u)‖
          = ‖w u‖ * (‖f (v n u) - f (v₀ u)‖ * |M n u|) := by
            rw [norm_mul, norm_mul, Real.norm_eq_abs (M n u)]
        _ ≤ ‖w u‖ * (η * K) :=
            mul_le_mul_of_nonneg_left (mul_le_mul h₁ (hMK n u) (abs_nonneg _) hη.le) (norm_nonneg _)
        _ = η * K * ‖w u‖ := mul_comm _ _
    rw [dist_zero_right]
    calc ‖∫ u, w u * ((f (v n u) - f (v₀ u)) * M n u)‖ ≤ ∫ u, η * K * ‖w u‖ :=
          norm_integral_le_of_norm_le (hw.norm.const_mul _) (Eventually.of_forall hpt)
      _ = η * K * (∫ u, ‖w u‖) := integral_const_mul _ _
      _ < ε := hηε
  -- the second piece converges to `∫ c M₀`; add the limits
  have hlim := hT.add hS
  rw [zero_add] at hlim
  have e : (∫ u, w u * (f (v₀ u) * M₀ u)) = ∫ u, w u * f (v₀ u) * M₀ u := by
    congr 1
    funext u
    ring
  rw [e]
  exact hlim.congr fun j => (hsplit j).symm

/-- **Weak continuity of pull-backs under uniformly convergent Lipschitz maps** (step 6 (B4) of
the proof that Lipschitz push-forwards of integer multiplicity currents are integer multiplicity;
Simon Ch. 6, 2.29 and 3.6).  Let `Hⱼ, H₀ : ℝᵐ → ℝ^{N'}` be `L`-Lipschitz with `Hⱼ → H₀`
uniformly, `w ∈ L¹(ℝᵐ)` and `ω` a continuous, compactly supported `m`-form on `ℝ^{N'}`.  Then
`∫ w ω(Hⱼ)(DHⱼ e) → ∫ w ω(H₀)(DH₀ e)`.  For `I : Fin m → Fin N'` let
`ω_I(y) = ω(y)(e'_{I 0}, …, e'_{I (m-1)})` and `M_I(H)(u) = det ((DH(u) e_t)_{I s})_{s,t}`.
The coordinate expansion of `m`-covectors gives `w ω(H)(DH e) = (m!)⁻¹ Σ_I w ω_I(H) M_I(H)`
pointwise.  Every summand is integrable (`M_I(H)` is measurable and bounded by `m! Lᵐ`, and `ω_I`
is bounded), so the integral splits over `I`; each summand converges by the scalar weak continuity
with the continuous, compactly supported coefficient `ω_I`. -/
theorem Submission.cmcdt_lpi_pullback_weak_continuity : ∀ (m N' : ℕ) (L : NNReal) (H : ℕ → Euclid m → Euclid N') (H₀ : Euclid m → Euclid N') (w : Euclid m → ℝ) (ω : DifferentialForm (Euclid N') m), (∀ j, LipschitzWith L (H j)) → LipschitzWith L H₀ → TendstoUniformly H H₀ atTop → Integrable w → Continuous ω → HasCompactSupport ω → Tendsto (fun j => ∫ u, w u * ω (H j u) (fun a => fderiv ℝ (H j) u (EuclideanSpace.single a 1))) atTop (𝓝 (∫ u, w u * ω (H₀ u) (fun a => fderiv ℝ H₀ u (EuclideanSpace.single a 1)))) := by
  intro m N' L H H₀ w ω hH hH₀ hHH₀ hw hωc hωs
  -- the coefficients `ω_I(y) = ω(y)(e'_{I 0}, …, e'_{I (m-1)})` are continuous with compact support
  have hωIc : ∀ I : Fin m → Fin N',
      Continuous fun y => ω y (fun c => EuclideanSpace.single (I c) (1 : ℝ)) := fun I =>
    hωc.eval_const _
  have hωIs : ∀ I : Fin m → Fin N',
      HasCompactSupport fun y => ω y (fun c => EuclideanSpace.single (I c) (1 : ℝ)) := fun I =>
    hωs.comp_left (g := fun α : Covector (Euclid N') m =>
      α (fun c => EuclideanSpace.single (I c) (1 : ℝ))) (by simp)
  -- step 1: `w ω(G)(DG e) = (m!)⁻¹ Σ_I w ω_I(G) M_I(G)` pointwise (coordinate expansion)
  have hexp : ∀ (G : Euclid m → Euclid N') (u : Euclid m),
      w u * ω (G u) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)) =
        (m.factorial : ℝ)⁻¹ * ∑ I : Fin m → Fin N',
          w u * (ω (G u) (fun c => EuclideanSpace.single (I c) (1 : ℝ)) *
            Matrix.det (Matrix.of fun s t => fderiv ℝ G u (EuclideanSpace.single t 1) (I s))) := by
    intro G u
    have hm : (m.factorial : ℝ) ≠ 0 := by exact_mod_cast m.factorial_ne_zero
    rw [← Finset.mul_sum, ← Submission.dor_lmb_fcd_jwc_covector_det_expansion N' m (ω (G u))
      (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)), mul_left_comm (w u),
      inv_mul_cancel_left₀ hm]
  -- step 2: the minors are measurable and bounded by `m! Lᵐ` and `ω_I` is bounded, so every
  -- summand is integrable and the integral splits over `I`
  have hint : ∀ G : Euclid m → Euclid N', LipschitzWith L G →
      ∫ u, w u * ω (G u) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)) =
        (m.factorial : ℝ)⁻¹ * ∑ I : Fin m → Fin N', ∫ u,
          w u * (ω (G u) (fun c => EuclideanSpace.single (I c) (1 : ℝ)) *
            Matrix.det (Matrix.of fun s t => fderiv ℝ G u (EuclideanSpace.single t 1) (I s))) := by
    intro G hG
    have hI : ∀ I : Fin m → Fin N', Integrable fun u =>
        w u * (ω (G u) (fun c => EuclideanSpace.single (I c) (1 : ℝ)) *
          Matrix.det (Matrix.of fun s t => fderiv ℝ G u (EuclideanSpace.single t 1) (I s))) := by
      intro I
      obtain ⟨hmeas, hbd⟩ :=
        Submission.cmcdt_lpi_pc_minor_measurable_bound m N' m L G I (fun t => t) hG
      obtain ⟨C, hC⟩ := (hωIc I).bounded_above_of_compact_support (hωIs I)
      refine hw.mul_bdd (c := C * ((m.factorial : ℝ) * (L : ℝ) ^ m))
        (((hωIc I).comp hG.continuous).measurable.mul hmeas).aestronglyMeasurable
        (Eventually.of_forall fun u => ?_)
      rw [norm_mul]
      exact mul_le_mul (hC _) ((Real.norm_eq_abs _).trans_le (hbd u)) (norm_nonneg _)
        ((norm_nonneg _).trans (hC 0))
    rw [← integral_finsetSum _ fun I _ => hI I, ← integral_const_mul]
    exact integral_congr_ae (Eventually.of_forall (hexp G))
  -- step 3: each summand converges by the scalar weak continuity with coefficient `ω_I`
  have hlim := (tendsto_finsetSum (Finset.univ : Finset (Fin m → Fin N')) fun I _ =>
    Submission.cmcdt_lpi_pc_scalar_weak_continuity m N' m L H H₀ I (fun t => t) w
      (fun y => ω y (fun c => EuclideanSpace.single (I c) (1 : ℝ))) hH hH₀ hHH₀ hw (hωIc I)
      (hωIs I)).const_mul ((m.factorial : ℝ)⁻¹)
  rw [hint H₀ hH₀]
  exact hlim.congr fun j => (hint (H j) (hH j)).symm

/-- **Integer density on one injective Lipschitz piece** (Simon Ch. 6, 3.6–3.9: the multiplicity
of `f#T` on a piece where `f` is injective).  Let `H : ℝⁿ → ℝᴾ` be `L`-Lipschitz, injective on the
Borel set `B` with injective `DH(u)` at every `u ∈ B`, and let `g : ℝⁿ → ℤ` be integrable and
nonzero on `B`.  With `h` a Borel inverse of `H|B` (Lusin–Souslin), `m = 1_{H(B)} · (g ∘ h)` is
Borel, integer-valued and `m ∘ H = g` on `B`.  For injective linear `A`, the area formula on the
unit ball and `Hⁿ(A(S)) ≤ ‖A‖ⁿ Hⁿ(S)` give `JA ≤ ‖A‖ⁿ`; as `‖DH‖ ≤ L`, `JH ≤ Lⁿ` on `B`, and the
area formula gives `∫_{H(B)} |m| dHⁿ = ∫_B JH |g| ≤ Lⁿ ∫_B |g|`.  Since `|m| ≥ 1` on `H(B)`, this
bounds `Hⁿ(H(B)) < ∞`. -/
theorem Submission.cmcdt_lpi_pc_piece_multiplicity : ∀ (P n : ℕ) (L : NNReal) (H : Euclid n → Euclid P) (B : Set (Euclid n)) (g : Euclid n → ℤ), LipschitzWith L H → MeasurableSet B → InjOn H B → (∀ a ∈ B, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → Measurable g → IntegrableOn (fun u => (g u : ℝ)) B → (∀ u ∈ B, g u ≠ 0) → ∃ m : Euclid P → ℝ, Measurable m ∧ (∀ y, ∃ z : ℤ, m y = z) ∧ (∀ u ∈ B, m (H u) = g u) ∧ μHE[n] (H '' B) ≠ ∞ ∧ ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] ≤ (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ := by
  intro P n L H B g hH hB hinj hdiff hg hgi hg0
  -- `G A = √det(⟨A eₖ, A eₗ⟩)`, the Gram-determinant Jacobian of a linear `A : ℝⁿ → ℝᴾ`
  obtain ⟨G, hG⟩ : ∃ G : (Euclid n →L[ℝ] Euclid P) → ℝ, ∀ A, G A = Real.sqrt (Matrix.det
      (Matrix.of fun k l : Fin n => inner ℝ (A (EuclideanSpace.single k 1)) (A (EuclideanSpace.single l 1)))) :=
    ⟨_, fun A => rfl⟩
  -- Lusin–Souslin: `H(B)` is Borel and `h ∘ H = id` on `B` for a Borel `h`
  obtain ⟨hN, h, hh, hhH⟩ := Submission.cmcdt_lpi_pc_measurable_inverse P n H B
    hH.continuous.continuousOn hB hinj
  -- the density `m = 1_{H(B)} · (g ∘ h)`
  obtain ⟨m, hm⟩ : ∃ m : Euclid P → ℝ, m = (H '' B).indicator fun y => (g (h y) : ℝ) := ⟨_, rfl⟩
  have hmH : ∀ u ∈ B, m (H u) = g u := fun u hu => by
    simp only [hm, indicator_of_mem (mem_image_of_mem H hu), hhH u hu]
  -- `G A ≤ ‖A‖ⁿ`: the area formula for `A` on the unit ball `B₁` gives `Hⁿ(A(B₁)) = G A · |B₁|`,
  -- while `A` is `‖A‖`-Lipschitz, so `Hⁿ(A(B₁)) ≤ ‖A‖ⁿ Hⁿ(B₁) = ‖A‖ⁿ |B₁|`
  have hGle : ∀ A : Euclid n →L[ℝ] Euclid P, Injective A →
      ENNReal.ofReal (G A) ≤ (‖A‖₊ : ℝ≥0∞) ^ n := by
    intro A hA
    have harea := (Submission.codim1_lura_gram_area_formula n P A).2 (ball 0 1) measurableSet_ball
      (fun x _ => A.differentiableAt) (fun x _ => by rw [A.fderiv]; exact hA) hA.injOn
      (fun _ => 1)
    simp only [A.fderiv, ← hG, mul_one, setLIntegral_one, setLIntegral_const] at harea
    have hlip := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (A.lipschitzWith.lipschitzOnWith (s := ball (0 : Euclid n) 1))
    rw [harea, EuclideanSpace.euclideanHausdorffMeasure_eq_volume n] at hlip
    exact (ENNReal.mul_le_mul_iff_left (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
      measure_ball_lt_top.ne).1 hlip
  -- the Jacobian bound `JH ≤ Lⁿ` on `B`, from `‖DH(u)‖ ≤ L`
  have hJ : ∀ u ∈ B, ENNReal.ofReal (G (fderiv ℝ H u)) ≤ (L : ℝ≥0∞) ^ n := by
    intro u hu
    refine (hGle _ (hdiff u hu).2).trans ?_
    have hle : ‖fderiv ℝ H u‖ ≤ L := norm_fderiv_le_of_lipschitz ℝ hH
    gcongr
    exact_mod_cast hle
  -- the area formula for `H` on `B` with weight `|m|`, and `m ∘ H = g` on `B`
  have hbound : ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] ≤ (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ := by
    have hareaH := (Submission.codim1_lura_gram_area_formula n P H).2 B hB
      (fun u hu => (hdiff u hu).1) (fun u hu => (hdiff u hu).2) hinj fun y => ‖m y‖ₑ
    simp only [← hG] at hareaH
    calc ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n]
        = ∫⁻ u in B, ENNReal.ofReal (G (fderiv ℝ H u)) * ‖m (H u)‖ₑ := hareaH
      _ ≤ ∫⁻ u in B, (L : ℝ≥0∞) ^ n * ‖(g u : ℝ)‖ₑ := by
          refine setLIntegral_mono' hB fun u hu => ?_
          rw [hmH u hu]
          gcongr
          exact hJ u hu
      _ = (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ :=
          lintegral_const_mul' _ _ (ENNReal.pow_ne_top ENNReal.coe_ne_top)
  -- `|m| ≥ 1` on `H(B)` (`g` is a nonzero integer on `B`), so `Hⁿ(H(B)) ≤ ∫_{H(B)} |m| dHⁿ`
  have hmeasN : μHE[n] (H '' B) ≤ ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] := by
    rw [← setLIntegral_one]
    refine setLIntegral_mono' hN ?_
    rintro _ ⟨u, hu, rfl⟩
    rw [hmH u hu, Real.enorm_eq_ofReal_abs, ENNReal.one_le_ofReal, ← Int.cast_abs]
    exact_mod_cast Int.one_le_abs (hg0 u hu)
  refine ⟨m, ?_, fun y => ?_, hmH, ?_, hbound⟩
  · rw [hm]
    exact ((measurable_of_countable fun z : ℤ => (z : ℝ)).comp (hg.comp hh)).indicator hN
  · by_cases hy : y ∈ H '' B
    · exact ⟨g (h y), by rw [hm, indicator_of_mem hy]⟩
    · exact ⟨0, by rw [hm, indicator_of_notMem hy, Int.cast_zero]⟩
  · exact (hmeasN.trans_lt (hbound.trans_lt (ENNReal.mul_lt_top
      (ENNReal.pow_lt_top ENNReal.coe_lt_top) hgi.2))).ne
/-- **Simon Ch. 6, 3.5 and 3.7** (the induced orientation of a bi-Lipschitz piece): let
`H : ℝⁿ → ℝᴾ` be `L`-Lipschitz, `B ⊆ ℝⁿ` Borel and `κ > 0` with `κ|a − a'| ≤ |H a − H a'|` on
`B`, and let `H` be differentiable with injective derivative at every point of `B`.  With
`v(u) = (DH(u)e₁, …, DH(u)eₙ)` and `J(u) = √det(⟨vₐ(u), v_b(u)⟩)`, the field
`η = 1_{H(B)} · ξ ∘ H⁻¹`, `ξ(u) = J(u)⁻¹ (α ↦ α(v(u)))`, is strongly measurable; for `u ∈ B`,
`η(H u)` is a unit orientation of `range DH(u)` with `J(u) η(H u)(α) = α(v(u))`; and `η` orients
the approximate tangent space of `H(B)` at `Hⁿ`-a.e. point of `H(B)`.
For an orthonormal basis `τ` of `range DH(u)` and the coordinate matrix `M` of `v(u)` in `τ`,
`α(v(u)) = det M · α(τ)` and `⟨vₐ, v_b⟩ = (MᵀM)ₐ_b`, so `J(u) = |det M| > 0` and
`η(H u) = ±(α ↦ α(τ))`.  The tangent planes `range DH(u)` exist at `H u` for a.e. `u ∈ B`, and
the area formula sends the exceptional `λ`-null set to an `Hⁿ`-null set. -/
theorem Submission.cmcdt_lpi_pc_piece_orientation : ∀ (P n : ℕ) (L : NNReal) (κ : ℝ) (H : Euclid n → Euclid P) (B : Set (Euclid n)), LipschitzWith L H → MeasurableSet B → 0 < κ → (∀ a ∈ B, ∀ a' ∈ B, κ * ‖a - a'‖ ≤ ‖H a - H a'‖) → (∀ a ∈ B, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → ∃ η : Euclid P → MultiVector P n, StronglyMeasurable η ∧ (∀ u ∈ B, IsUnitOrientationOf (η (H u)) (LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)) ∧ ∀ α : Covector (Euclid P) n, Real.sqrt (Matrix.det (Matrix.of fun a b : Fin n => inner ℝ (fderiv ℝ H u (EuclideanSpace.single a 1)) (fderiv ℝ H u (EuclideanSpace.single b 1)))) * η (H u) α = α (fun a => fderiv ℝ H u (EuclideanSpace.single a 1))) ∧ ∀ᵐ y ∂(μHE[n].restrict (H '' B)), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n (H '' B) y Q ∧ IsUnitOrientationOf (η y) Q := by
  intro P n L κ H B hH hB hκ hcolip hreg
  -- `H` is injective on `B`, so `H(B)` is Borel with a Borel left inverse `h`
  have hinjOn : InjOn H B := by
    intro a ha a' ha' hHa
    have h := hcolip a ha a' ha'
    rw [hHa, sub_self, norm_zero] at h
    have h' : ‖a - a'‖ ≤ 0 := le_of_mul_le_mul_left (by simpa using h) hκ
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
  obtain ⟨hN, h, hh, hhH⟩ := Submission.cmcdt_lpi_pc_measurable_inverse P n H B
    hH.continuous.continuousOn hB hinjOn
  -- `v(u) = (DH(u)eₐ)ₐ`, `J(u) = √det(⟨vₐ(u), v_b(u)⟩)`, `ev z = (α ↦ α(z))`, `ξ(u) = J(u)⁻¹ ev(v(u))`
  let v : Euclid n → Fin n → Euclid P := fun u a => fderiv ℝ H u (EuclideanSpace.single a 1)
  let J : Euclid n → ℝ := fun u =>
    Real.sqrt (Matrix.det (Matrix.of fun a b : Fin n => inner ℝ (v u a) (v u b)))
  let ev : (Fin n → Euclid P) → MultiVector P n := fun z =>
    ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ z
  let ξ : Euclid n → MultiVector P n := fun u => (J u)⁻¹ • ev (v u)
  have hξ : ∀ u (α : Covector (Euclid P) n), ξ u α = (J u)⁻¹ * α (v u) := fun _ _ => rfl
  -- `ev z = ∑_f (∏ₐ z_{a, f(a)}) ev(e_{f(0)}, …, e_{f(n-1)})`, a finite sum of constant vectors
  have hexp : ∀ z : Fin n → Euclid P, ev z = ∑ f : Fin n → Fin P,
      (∏ a, z a (f a)) • ev (fun a => EuclideanSpace.single (f a) (1 : ℝ)) := by
    intro z
    ext α
    have hz : z = fun a => ∑ i, z a i • EuclideanSpace.single i (1 : ℝ) := by
      funext a
      have h := (EuclideanSpace.basisFun (Fin P) ℝ).sum_repr (z a)
      simp only [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply] at h
      exact h.symm
    have hα : α z = α (fun a => ∑ i, z a i • EuclideanSpace.single i (1 : ℝ)) := congrArg α hz
    simp only [ev, ContinuousAlternatingMap.apply_apply, _root_.sum_apply, _root_.smul_apply,
      smul_eq_mul]
    rw [hα, α.map_sum]
    refine Finset.sum_congr rfl fun f _ => ?_
    rw [α.map_smul_univ, smul_eq_mul]
  -- strong measurability: `J` is Borel and every coefficient `∏ₐ (DH(u)eₐ)_{f(a)}` is Borel
  -- (instance search misses `ContinuousAdd (MultiVector P n)`: the `Add` of the `Covector`-domain
  -- operator space does not unify with that of its `AddGroup` at instance transparency)
  have : ContinuousAdd (MultiVector P n) :=
    (inferInstance : IsTopologicalAddGroup (MultiVector P n)).toContinuousAdd
  have hevm : StronglyMeasurable fun u => ev (v u) := by
    have h : (fun u => ev (v u)) = fun u => ∑ f : Fin n → Fin P,
        (∏ a, v u a (f a)) • ev (fun a => EuclideanSpace.single (f a) (1 : ℝ)) :=
      funext fun u => hexp (v u)
    rw [h]
    refine Finset.stronglyMeasurable_fun_sum Finset.univ fun f _ => ?_
    refine (Measurable.stronglyMeasurable ?_).smul_const _
    refine Finset.measurable_prod Finset.univ fun a _ => ?_
    exact (PiLp.continuous_apply 2 (fun _ : Fin P => ℝ) (f a)).measurable.comp
      (measurable_fderiv_apply_const ℝ H (EuclideanSpace.single a 1))
  have hJm : Measurable J := (Submission.codim1_lura_gram_area_formula n P H).1
  have hξm : StronglyMeasurable ξ := hJm.inv.stronglyMeasurable.smul hevm
  -- `η = 1_{H(B)} · ξ ∘ h`
  refine ⟨(H '' B).indicator (fun y => ξ (h y)), (hξm.comp_measurable hh).indicator hN, ?_⟩
  have hηH : ∀ u ∈ B, (H '' B).indicator (fun y => ξ (h y)) (H u) = ξ u := fun u hu =>
    (Set.indicator_of_mem (Set.mem_image_of_mem H hu) _).trans (congrArg ξ (hhH u hu))
  -- `ξ(u)` is a unit orientation of `range DH(u)` and `J(u) ξ(u)(α) = α(v(u))`
  have hi : ∀ u ∈ B, IsUnitOrientationOf (ξ u)
      (LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)) ∧
      ∀ α : Covector (Euclid P) n, J u * ξ u α = α (v u) := by
    intro u hu
    have hinj := (hreg u hu).2
    set W := LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)
    have hWdim : Module.finrank ℝ W = n := by
      rw [LinearMap.finrank_range_of_inj hinj, finrank_euclideanSpace_fin]
    -- an orthonormal basis `τ` of `W` and the coordinate matrix `M` of `v(u)` in it
    let b : OrthonormalBasis (Fin n) ℝ W := (stdOrthonormalBasis ℝ W).reindex (finCongr hWdim)
    let τ : Fin n → Euclid P := fun i => (b i : Euclid P)
    let w : Fin n → W := fun a =>
      ⟨v u a, LinearMap.mem_range_self (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)
        (EuclideanSpace.single a 1)⟩
    let M : Matrix (Fin n) (Fin n) ℝ := b.toBasis.toMatrix w
    have hτ : Orthonormal ℝ τ := b.orthonormal.comp_linearIsometry W.subtypeₗᵢ
    have hτspan : Submodule.span ℝ (Set.range τ) = W := by
      have hr : Set.range τ = W.subtype '' Set.range b := Set.range_comp _ _
      rw [hr, Submodule.span_image, ← OrthonormalBasis.coe_toBasis, b.toBasis.span_eq,
        Submodule.map_subtype_top]
    -- `α(v(u)) = det M · α(τ)`: restrict `α` to `W` and compare with the basis determinant
    have hαv : ∀ α : Covector (Euclid P) n, α (v u) = M.det * α τ := by
      intro α
      have h := (α.toAlternatingMap.compLinearMap W.subtype).eq_smul_basis_det b.toBasis
      calc α (v u) = (α.toAlternatingMap.compLinearMap W.subtype) w := rfl
        _ = ((α.toAlternatingMap.compLinearMap W.subtype) b.toBasis • b.toBasis.det) w := by
          rw [← h]
        _ = M.det * α τ := by
          simp only [AlternatingMap.smul_apply, b.toBasis.det_apply, smul_eq_mul]
          exact mul_comm _ _
    -- `⟨vₐ, v_c⟩ = (MᵀM)ₐ_c` because `τ` is orthonormal, so `J(u) = |det M|`
    have hgram : (Matrix.of fun a c : Fin n => inner ℝ (v u a) (v u c)) = M.transpose * M := by
      ext a c
      have h1 : inner ℝ (v u a) (v u c) = inner ℝ (w a) (w c) :=
        (Submodule.coe_inner W (w a) (w c)).symm
      rw [Matrix.of_apply, Matrix.mul_apply, h1, ← b.sum_inner_mul_inner (w a) (w c)]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Matrix.transpose_apply, real_inner_comm (b i) (w a)]
      simp only [M, b.toBasis.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
        OrthonormalBasis.repr_apply_apply]
    have hJM : J u = |M.det| := by
      show Real.sqrt (Matrix.det (Matrix.of fun a c : Fin n => inner ℝ (v u a) (v u c))) = |M.det|
      rw [hgram, Matrix.det_mul, Matrix.det_transpose, ← sq, Real.sqrt_sq_eq_abs]
    -- `v(u)` is linearly independent (`DH(u)` is injective), so `det M ≠ 0`
    have hw : LinearIndependent ℝ w := by
      have h0 : LinearIndependent ℝ
          (fun a : Fin n => (EuclideanSpace.single a (1 : ℝ) : Euclid n)) := by
        have h := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis.linearIndependent
        have he : ⇑(EuclideanSpace.basisFun (Fin n) ℝ).toBasis =
            fun a : Fin n => (EuclideanSpace.single a (1 : ℝ) : Euclid n) := by
          funext a
          rw [OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply]
        rwa [he] at h
      have h1 : LinearIndependent ℝ (v u) := h0.map' _ (LinearMap.ker_eq_bot.2 hinj)
      exact LinearIndependent.of_comp W.subtype h1
    have hdet : M.det ≠ 0 := by
      have hspan : Submodule.span ℝ (Set.range w) = ⊤ :=
        hw.span_eq_top_of_card_eq_finrank' (by rw [Fintype.card_fin, hWdim])
      exact ((b.toBasis.is_basis_iff_det).1 ⟨hw, hspan⟩).ne_zero
    have hJpos : 0 < J u := by
      rw [hJM]
      exact abs_pos.2 hdet
    refine ⟨⟨τ, hτ, hτspan, ?_⟩, fun α => ?_⟩
    · rcases hdet.lt_or_gt with hneg | hpos
      · right
        intro α
        rw [hξ, hαv, hJM, abs_of_neg hneg, inv_neg, neg_mul, inv_mul_cancel_left₀ hdet]
      · left
        intro α
        rw [hξ, hαv, hJM, abs_of_pos hpos, inv_mul_cancel_left₀ hdet]
    · rw [hξ, mul_inv_cancel_left₀ hJpos.ne']
  refine ⟨fun u hu => ?_, ?_⟩
  · rw [hηH u hu]
    exact hi u hu
  · -- the tangent planes `range DH(u)` exist off a `λ`-null set `E ∩ B`, whose image is `Hⁿ`-null
    have htan := Submission.ptd_piece_image_approxTangent_ae P n H B L κ hH hB hκ hcolip hreg
    rw [ae_iff] at htan
    obtain ⟨E, hEsub, hEmeas, hE0⟩ := exists_measurable_superset_of_null htan
    rw [Measure.restrict_apply hEmeas] at hE0
    have hnull : μHE[n] (H '' (E ∩ B)) = 0 := by
      have harea := (Submission.codim1_lura_gram_area_formula n P H).2 (E ∩ B)
        (hEmeas.inter hB) (fun x hx => (hreg x hx.2).1) (fun x hx => (hreg x hx.2).2)
        (hinjOn.mono inter_subset_right) (fun _ => 1)
      rwa [setLIntegral_one, Measure.restrict_eq_zero.2 hE0, lintegral_zero_measure] at harea
    filter_upwards [ae_restrict_mem hN, ae_restrict_of_ae (measure_eq_zero_iff_ae_notMem.1 hnull)]
      with y hyN hyE
    obtain ⟨u, hu, rfl⟩ := hyN
    refine ⟨LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P), ?_, ?_⟩
    · by_contra hc
      have huE : u ∈ E := hEsub hc
      exact hyE ⟨u, ⟨huE, hu⟩, rfl⟩
    · rw [hηH u hu]
      exact (hi u hu).1

/-- **The Lipschitz image of an integer-weighted bi-Lipschitz piece** (Simon Ch. 6, 3.5–3.9).
Let `H : ℝⁿ → ℝᴾ` be `L`-Lipschitz, let `B ⊆ ℝⁿ` be Borel with `κ |a − a'| ≤ |H a − H a'|` on `B`
(`κ > 0`), `H` differentiable with injective `DH` at every point of `B`, and let `g : ℝⁿ → ℤ` be
measurable, integrable and nonzero on `B`.
Assume (L3) `|α(τ)| ≤ |α|` for orthonormal `τ`, and (IMC)(b): the restriction of an `IMRep` to
a Borel set represents a current.  Then `H_♯(g [[B]])` is an integer multiplicity current `Φ`
with `M(Φ) ≤ Lⁿ ∫_B |g|` and `Φ(ω) = ∫_B g ω(H)(DH e₀, …, DH eₙ₋₁)`.

Proof sketch:
* `H` is injective on `B`, so `N = H(B)` is Borel; `m = g ∘ H⁻¹` is an integer density with
  `∫_N |m| dHⁿ ≤ Lⁿ ∫_B |g|`, and `η` orients `N` `Hⁿ`-a.e. with `J η(H) = DH e₀ ∧ ⋯ ∧ DH eₙ₋₁`
  on `B`, `J` the Gram Jacobian.
* `(N, m, η)` is an `IMRep` acting by `ω ↦ ∫_N m ⟨ω, η⟩ dHⁿ` (`N ⊆ range H` is rectifiable), and
  (IMC)(b) with `E = ℝᴾ` makes it represent a current `Φ`.
* The Gram area formula gives `Φ(ω) = ∫_B J g ⟨ω(H), η(H)⟩ = ∫_B g ω(H)(DH e)`.
* For admissible `ω`, (L3) and the unit orientation give `|⟨ω, η⟩| ≤ 1` on `N`, so
  `M(Φ) ≤ ∫_N |m| dHⁿ ≤ Lⁿ ∫_B |g|`. -/
theorem Submission.cmcdt_lpi_pc_piece_current : (∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α) → (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) → ∀ (P n : ℕ) (L : NNReal) (κ : ℝ) (H : Euclid n → Euclid P) (B : Set (Euclid n)) (g : Euclid n → ℤ), LipschitzWith L H → MeasurableSet B → 0 < κ → (∀ a ∈ B, ∀ a' ∈ B, κ * ‖a - a'‖ ≤ ‖H a - H a'‖) → (∀ a ∈ B, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → Measurable g → IntegrableOn (fun u => (g u : ℝ)) B → (∀ u ∈ B, g u ≠ 0) → ∃ Φ : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity Φ ∧ Φ.mass ≤ (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) n, Φ ω = ∫ u in B, (g u : ℝ) * (ω : DifferentialForm (Euclid P) n) (H u) (fun a => fderiv ℝ H u (EuclideanSpace.single a 1)) := by
  intro hL3 hIMC P n L κ H B g hH hB hκ hbilip hdiff hg hgint hg0
  -- Step 1: `H` is injective on `B`, so `N = H(B)` is Borel
  have hinj : InjOn H B := by
    intro a ha a' ha' haa'
    have h := hbilip a ha a' ha'
    rw [haa', sub_self, norm_zero] at h
    have h0 : ‖a - a'‖ ≤ 0 := by
      by_contra hpos
      exact absurd h (not_le.mpr (mul_pos hκ (not_le.mp hpos)))
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h0)
  have hNmeas : MeasurableSet (H '' B) :=
    (Submission.cmcdt_lpi_pc_measurable_inverse P n H B hH.continuous.continuousOn hB hinj).1
  -- Step 2: the integer density `m = g ∘ H⁻¹` and the orientation `η` of `N`
  obtain ⟨m, hm, hmint, hmH, hNfin, hmle⟩ :=
    Submission.cmcdt_lpi_pc_piece_multiplicity P n L H B g hH hB hinj hdiff hg hgint hg0
  obtain ⟨η, hη, hηH, hηae⟩ :=
    Submission.cmcdt_lpi_pc_piece_orientation P n L κ H B hH hB hκ hbilip hdiff
  have hmfin : ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top)
      (ne_of_lt hgint.hasFiniteIntegral)) hmle
  -- Step 3: the `IMRep` `(N, m, η)` in `ℝᴾ`
  obtain ⟨R, hR⟩ := Submission.cmcdt_ims_imrep_of_int_density P n univ (H '' B) η m isOpen_univ
    hNmeas (subset_univ _)
    ((Poincare.SimonGMT.Chapter03.countablyRectifiable_range hH).mono (image_subset_range H B))
    (fun K _ _ => ne_top_of_le_ne_top hNfin (measure_mono inter_subset_left)) hη hm hmint
    (fun K _ _ => ne_top_of_le_ne_top hmfin (lintegral_mono_set inter_subset_left)) hηae
  -- Step 4: (IMC)(b) with `E = ℝᴾ` gives the current `Φ`, acting by `∫_N m ⟨ω, η⟩ dHⁿ`
  obtain ⟨Φ, R', hR', hcar, hmult, horient⟩ :=
    hIMC P n univ R univ isOpen_univ MeasurableSet.univ
  have hΦ : ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
      Φ ω = ∫ y in H '' B, m y * η y ((ω : DifferentialForm (Euclid P) n) y) ∂μHE[n] := by
    intro ω
    rw [hR' ω, ← hR (ω : DifferentialForm (Euclid P) n)]
    simp only [IMRep.action]
    rw [hcar, inter_univ, hmult, horient]
  -- Step 5: the formula, from the Gram area formula and `J η(H) = DH e₀ ∧ ⋯ ∧ DH eₙ₋₁` on `B`
  have hformula : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, Φ ω = ∫ u in B,
      (g u : ℝ) * (ω : DifferentialForm (Euclid P) n) (H u)
        (fun a => fderiv ℝ H u (EuclideanSpace.single a 1)) := by
    intro ω
    rw [hΦ ω, Submission.codim1_lur_cd_injective_area_formula_gram P n H B hB
      (fun v hv => (hdiff v hv).1) (fun v hv => (hdiff v hv).2) hinj]
    refine setIntegral_congr_fun hB fun u hu => ?_
    have hJ := (hηH u hu).2 ((ω : DifferentialForm (Euclid P) n) (H u))
    rw [hmH u hu, ← hJ]
    ring
  refine ⟨Φ, ⟨R', hR'⟩, ?_, hformula⟩
  -- Step 6: the mass bound, from `|⟨ω, η⟩| ≤ 1` on `N` for admissible `ω`
  rw [GeometricCurrentOn.mass, GeometricCurrentOn.massOn]
  refine sSup_le ?_
  rintro _ ⟨ω, hω, rfl⟩
  have hle : ∀ y ∈ H '' B,
      ‖m y * η y ((ω : DifferentialForm (Euclid P) n) y)‖ₑ ≤ ‖m y‖ₑ := by
    rintro _ ⟨u, hu, rfl⟩
    obtain ⟨τ, hτ, -, hητ⟩ := (hηH u hu).1
    have h1 : |η (H u) ((ω : DifferentialForm (Euclid P) n) (H u))| ≤ 1 := by
      refine le_trans ?_ ((hL3 P n _ τ hτ).trans (hω.2 (H u)))
      rcases hητ with h | h <;> simp [h]
    rw [enorm_mul]
    calc ‖m (H u)‖ₑ * ‖η (H u) ((ω : DifferentialForm (Euclid P) n) (H u))‖ₑ
        ≤ ‖m (H u)‖ₑ * 1 := by
          gcongr
          rw [Real.enorm_eq_ofReal_abs]
          exact ENNReal.ofReal_le_one.mpr h1
      _ = ‖m (H u)‖ₑ := mul_one _
  calc ENNReal.ofReal (Φ ω)
      ≤ ‖Φ ω‖ₑ := by
        rw [Real.enorm_eq_ofReal_abs]
        exact ENNReal.ofReal_le_ofReal (le_abs_self _)
    _ = ‖∫ y in H '' B, m y * η y ((ω : DifferentialForm (Euclid P) n) y) ∂μHE[n]‖ₑ := by
        rw [hΦ ω]
    _ ≤ ∫⁻ y in H '' B, ‖m y * η y ((ω : DifferentialForm (Euclid P) n) y)‖ₑ ∂μHE[n] :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ y in H '' B, ‖m y‖ₑ ∂μHE[n] := setLIntegral_mono' hNmeas hle
    _ ≤ (L : ℝ≥0∞) ^ n * ∫⁻ u in B, ‖(g u : ℝ)‖ₑ := hmle

/-- **Integer multiplicity push-forward of a weighted Lipschitz piece** (step B3 of the
deformation theorem, Simon 6.5.1; Simon 6.3.5–3.9 for `H_#τ(M, θ, ξ)`).  Let `n = k + 1`,
`H : ℝⁿ → ℝ^{N'}` be `L`-Lipschitz, `A ⊆ ℝⁿ` Borel and `g : ℝⁿ → ℤ` integrable on `A`.  Then
`ω ↦ ∫_A g(u)·ω(H(u))(DH(u)e₀, …, DH(u)eₙ₋₁) du` is an integer multiplicity current.
Write `Ψ_ω` for this integrand.  By `cmcdt_lpi_pc_regular_part_reduction`, `∫_A Ψ_ω = ∫_{A⁺} Ψ_ω`
with `A⁺ = {u ∈ A : DH(u) exists and is injective, g(u) ≠ 0}`.  `cmcdt_lpi_pc_bilipschitz_partition`
splits `A⁺` into disjoint Borel pieces `C_l` on which `H` is bi-Lipschitz, and
`cmcdt_lpi_pc_piece_current` (with (L3) of (CB) and part (b) of (IMC)) gives integer multiplicity
currents `Φ_l` with `M(Φ_l) ≤ Lⁿ ∫_{C_l} |g|` and `Φ_l(ω) = ∫_{C_l} Ψ_ω`.  Hence
`Σ_l M(Φ_l) ≤ Lⁿ ∫_A |g| < ∞`, (IMSc) sums the `Φ_l` to an integer multiplicity `S`, and countable
additivity of the integral over `A⁺ = ⋃_l C_l` gives `S(ω) = ∫_{A⁺} Ψ_ω = ∫_A Ψ_ω`. -/
theorem Submission.cmcdt_lpi_lipschitz_piece_im : ((∀ (N N' k : ℕ) (A : Euclid N →L[ℝ] Euclid N') (β : Covector (Euclid N') k), covectorEuclideanNorm (β.compContinuousLinearMap A) ≤ ‖A‖ ^ k * covectorEuclideanNorm β) ∧ (∀ (N k : ℕ) (v : Euclid N) (β : Covector (Euclid N) (k + 1)), covectorEuclideanNorm (β.curryLeft v) ≤ ‖v‖ * covectorEuclideanNorm β) ∧ ∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S)) → ∀ (N' k : ℕ) (L : NNReal) (H : Euclid (k + 1) → Euclid N') (A : Set (Euclid (k + 1))) (g : Euclid (k + 1) → ℤ), LipschitzWith L H → MeasurableSet A → Measurable g → IntegrableOn (fun u => (g u : ℝ)) A → ∃ S : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1), IsIntegerMultiplicity S ∧ ∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), S ω = ∫ u in A, (g u : ℝ) * (ω : DifferentialForm (Euclid N') (k + 1)) (H u) (fun a => fderiv ℝ H u (EuclideanSpace.single a 1)) := by
  intro hCB hIMC hIMSc N' k L H A g hH hA hg hgi
  -- Steps 1–2: `Ψ_ω` is integrable on `A` and `∫_A Ψ_ω = ∫_{A⁺} Ψ_ω`
  obtain ⟨hAp, hΨ⟩ :=
    Submission.cmcdt_lpi_pc_regular_part_reduction N' (k + 1) L H A g hH hA hg hgi
  set Ap : Set (Euclid (k + 1)) :=
    {u | u ∈ A ∧ DifferentiableAt ℝ H u ∧ Injective (fderiv ℝ H u) ∧ g u ≠ 0}
  -- Step 3: disjoint Borel pieces `C_l` with `⋃_l C_l = A⁺`, on which `H` is bi-Lipschitz
  obtain ⟨C, κ, hCm, hCd, hCU, hκ, hCbil⟩ :=
    Submission.cmcdt_lpi_pc_bilipschitz_partition N' (k + 1) H Ap hAp
      fun a ha => ⟨ha.2.1, ha.2.2.1⟩
  have hCA : ∀ l, C l ⊆ Ap := fun l => (subset_iUnion C l).trans hCU.subset
  -- Steps 5–7: an integer multiplicity current `Φ_l` for each piece, with
  -- `M(Φ_l) ≤ Lⁿ ∫_{C_l} |g|` and `Φ_l(ω) = ∫_{C_l} Ψ_ω`
  choose Φ hΦim hΦmass hΦω using fun l =>
    Submission.cmcdt_lpi_pc_piece_current hCB.2.2 hIMC.2.1 N' (k + 1) L (κ l) H (C l) g hH
      (hCm l) (hκ l) (hCbil l) (fun a ha => ⟨(hCA l ha).2.1, (hCA l ha).2.2.1⟩) hg
      (hgi.mono_set fun u hu => (hCA l hu).1) fun u hu => (hCA l hu).2.2.2
  -- Step 8: `Σ_l M(Φ_l) ≤ Lⁿ Σ_l ∫_{C_l} |g| = Lⁿ ∫_{A⁺} |g| ≤ Lⁿ ∫_A |g| < ∞`
  have hsum : ∑' l, (Φ l).mass < ∞ :=
    calc ∑' l, (Φ l).mass ≤ ∑' l, (L : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in C l, ‖(g u : ℝ)‖ₑ :=
          ENNReal.tsum_le_tsum hΦmass
      _ = (L : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in Ap, ‖(g u : ℝ)‖ₑ := by
          rw [ENNReal.tsum_mul_left, ← lintegral_iUnion hCm hCd, hCU]
      _ ≤ (L : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in A, ‖(g u : ℝ)‖ₑ :=
          mul_le_mul_right (lintegral_mono_set fun u hu => hu.1) _
      _ < ∞ := ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) hgi.2
  -- (IMSc): the series `S = Σ_l Φ_l` is an integer multiplicity current
  obtain ⟨S, hS, -, -, hSim⟩ := hIMSc N' k Φ hsum
  refine ⟨S, hSim hΦim, fun ω => ?_⟩
  -- countable additivity over `A⁺ = ⋃_l C_l` and uniqueness of sums
  obtain ⟨hint, heq⟩ := hΨ ω
  rw [heq]
  refine (hS ω).unique ?_
  simp only [hΦω]
  rw [← hCU]
  exact hasSum_integral_iUnion hCm hCd
    (hint.mono_set (iUnion_subset fun l => (hCA l).trans fun u hu => hu.1))

/-- **Integrality of the Lipschitz push-forward** (Simon Ch. 6, 2.29 and 3.6–3.9; step 7 of the
proof of the Lipschitz push-forward used by the deformation theorem 6.5.1).  Assume (CB), (VO),
(MR), (IMC) and (IMS).  Let `X ∈ 𝒟ₖ₊₁(ℝᴺ)` be integer multiplicity with `M(X) < ∞`, `F`
`Λ`-Lipschitz, and `S ∈ 𝒟ₖ₊₁(ℝᴺ')` with `X(ηⱼ) → S(ω)`, where `ηⱼ = Fⱼ^#ω` near `spt X` for
smooth `Λ`-Lipschitz `Fⱼ → F` uniformly.  Then `S` is integer multiplicity.
* piece_representation: `X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)` with `Σᵢ ∫_{Aᵢ} |wᵢ| cᵢ ≤ M(X)`.
* On `Aᵢ ⊆ Gᵢ⁻¹(spt X)` the chain rule turns the `i`-th term of `X(ηⱼ)` into
  `Tᵢⱼ(ω) = ∫_{Aᵢ} wᵢ ω(Fⱼ ∘ Gᵢ)(D(Fⱼ ∘ Gᵢ) e)`, and (L1) bounds it by `Λⁿ C ∫_{Aᵢ} |wᵢ| cᵢ`
  when `|ω| ≤ C`.
* pullback_continuity gives `Tᵢⱼ(ω) → Tᵢ(ω) = ∫_{Aᵢ} wᵢ ω(F ∘ Gᵢ)(D(F ∘ Gᵢ) e)`, and Tannery's
  theorem gives `S(ω) = Σᵢ Tᵢ(ω)`.
* piece_current makes each `Tᵢ` an integer multiplicity `Sᵢ` with `M(Sᵢ) ≤ Λⁿ ∫_{Aᵢ} |wᵢ| cᵢ`;
  (IMS) sums the `Sᵢ` to an integer multiplicity current, which equals `S`. -/
theorem Submission.cmcdt_lpi_pushforward_im : ((∀ (N N' k : ℕ) (A : Euclid N →L[ℝ] Euclid N') (β : Covector (Euclid N') k), covectorEuclideanNorm (β.compContinuousLinearMap A) ≤ ‖A‖ ^ k * covectorEuclideanNorm β) ∧ (∀ (N k : ℕ) (v : Euclid N) (β : Covector (Euclid N) (k + 1)), covectorEuclideanNorm (β.curryLeft v) ≤ ‖v‖ * covectorEuclideanNorm β) ∧ ∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ((∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S)) → ∀ (N N' k : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)) (S : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1)), LipschitzWith Λ F → IsIntegerMultiplicity X → IsCompact X.support → X.mass < ∞ → (∃ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Fs j)) ∧ (∀ j, LipschitzWith Λ (Fs j)) ∧ TendstoUniformly Fs F atTop ∧ ∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), ∃ ηs : ℕ → TestFormOn (univ : Set (Euclid N)) (k + 1), (∀ j, ∃ W : Set (Euclid N), IsOpen W ∧ X.support ⊆ W ∧ ∀ x ∈ W, (ηs j : DifferentialForm (Euclid N) (k + 1)) x = ((ω : DifferentialForm (Euclid N') (k + 1)) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x)) ∧ Tendsto (fun j => X (ηs j)) atTop (𝓝 (S ω))) → IsIntegerMultiplicity S := by
  intro hCB hVO hMR hIMC hIMS N N' k Λ F X S hF hX _hXc hXm hFs
  obtain ⟨Fs, hFs_smooth, hFs_lip, hFs_tend, hη⟩ := hFs
  -- (IMSc): (IMS) applied to (VO), (MR) and (IMC)
  have hIMSc := hIMS hVO hMR hIMC
  -- Step 1: `X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)`, with `Bᵢ = ∫_{Aᵢ} |wᵢ| cᵢ` and `Σᵢ Bᵢ ≤ M(X) < ∞`
  obtain ⟨G, A, w, c, hG_lip, hA, hw, -, hG_diff, hG_spt, hw_int, hc, hB, hXsum⟩ :=
    Submission.cmcdt_lpi_piece_representation hCB hVO hMR hIMC N k X hX hXm
  choose L hL using hG_lip
  obtain ⟨B, hBeq⟩ : ∃ B : ℕ → ℝ≥0∞,
      ∀ i, B i = ∫⁻ u in A i, ENNReal.ofReal (|(w i u : ℝ)| * c i u) := ⟨_, fun _ => rfl⟩
  have hBsum : ∑' i, B i ≠ ∞ := by
    simp only [hBeq]
    exact (hB.trans_lt hXm).ne
  have hBi : ∀ i, B i ≠ ∞ := fun i => ne_top_of_le_ne_top hBsum (ENNReal.le_tsum i)
  -- Step 2: the `Fⱼ` are differentiable everywhere
  have hFs_diff : ∀ j, Differentiable ℝ (Fs j) := fun j =>
    (hFs_smooth j).differentiable (by simp)
  -- Step 3 (chain rule): on `Aᵢ`, `ω(Fⱼ ∘ Gᵢ)(D(Fⱼ ∘ Gᵢ) e) = βᵢⱼ(DGᵢ e)`,
  -- where `βᵢⱼ = ω(Fⱼ ∘ Gᵢ) ∘ DFⱼ(Gᵢ)`
  have hchain : ∀ i j, ∀ u ∈ A i, ∀ ω : DifferentialForm (Euclid N') (k + 1),
      ω (Fs j (G i u)) (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1)) =
        ((ω (Fs j (G i u))).compContinuousLinearMap (fderiv ℝ (Fs j) (G i u)))
          (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a 1)) := by
    intro i j u hu ω
    rw [ContinuousAlternatingMap.compContinuousLinearMap_apply,
      fderiv_fun_comp u (hFs_diff j (G i u)) (hG_diff i u hu)]
    rfl
  -- Step 6 (pointwise): if `|ω| ≤ C`, then `|ω(Fⱼ ∘ Gᵢ)(D(Fⱼ ∘ Gᵢ) e)| ≤ cᵢ Λⁿ C` on `Aᵢ`, by (L1)
  have hpt : ∀ i j, ∀ u ∈ A i, ∀ (ω : DifferentialForm (Euclid N') (k + 1)) (C : ℝ),
      (∀ y, covectorEuclideanNorm (ω y) ≤ C) →
      |ω (Fs j (G i u)) (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1))|
        ≤ c i u * ((Λ : ℝ) ^ (k + 1) * C) := by
    intro i j u hu ω C hC
    rw [hchain i j u hu ω]
    obtain ⟨hc0, hcα⟩ := hc i u hu
    refine (hcα _).trans (mul_le_mul_of_nonneg_left ?_ hc0)
    refine (hCB.1 N N' (k + 1) (fderiv ℝ (Fs j) (G i u)) (ω (Fs j (G i u)))).trans ?_
    exact mul_le_mul
      (pow_le_pow_left₀ (norm_nonneg _) (norm_fderiv_le_of_lipschitz ℝ (hFs_lip j)) _) (hC _)
      (covectorEuclideanNorm_nonneg _) (by positivity)
  -- Step 6 (integrated): `|Tᵢⱼ(ω)| ≤ Bᵢ Λⁿ C`, uniformly in `j`
  have hTij : ∀ i j (ω : DifferentialForm (Euclid N') (k + 1)) (C : ℝ), 0 ≤ C →
      (∀ y, covectorEuclideanNorm (ω y) ≤ C) →
      ‖∫ u in A i, (w i u : ℝ) * ω (Fs j (G i u))
          (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1))‖ ≤
        (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) := by
    intro i j ω C hC0 hC
    have hK : 0 ≤ (Λ : ℝ) ^ (k + 1) * C := by positivity
    have hfin : B i * ENNReal.ofReal ((Λ : ℝ) ^ (k + 1) * C) ≠ ∞ :=
      ENNReal.mul_ne_top (hBi i) ENNReal.ofReal_ne_top
    have hval : (B i * ENNReal.ofReal ((Λ : ℝ) ^ (k + 1) * C)).toReal =
        (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) := by
      rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hK]
    refine (norm_integral_le_lintegral_norm _).trans ((ENNReal.toReal_mono hfin ?_).trans_eq hval)
    rw [hBeq i, ← lintegral_mul_const' _ _ ENNReal.ofReal_ne_top]
    refine setLIntegral_mono' (hA i) fun u hu => ?_
    rw [← ENNReal.ofReal_mul (mul_nonneg (abs_nonneg _) (hc i u hu).1)]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hpt i j u hu ω C hC) (abs_nonneg _)
  -- Step 7 (termwise limit): `Tᵢⱼ(ω) → Tᵢ(ω)`, by pullback_continuity with the weight `1_{Aᵢ} wᵢ`
  have hlim : ∀ i (ω : TestFormOn (univ : Set (Euclid N')) (k + 1)),
      Tendsto (fun j => ∫ u in A i, (w i u : ℝ) *
          (ω : DifferentialForm (Euclid N') (k + 1)) (Fs j (G i u))
            (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1))) atTop
        (𝓝 (∫ u in A i, (w i u : ℝ) * (ω : DifferentialForm (Euclid N') (k + 1)) (F (G i u))
          (fun a => fderiv ℝ (fun v => F (G i v)) u (EuclideanSpace.single a 1)))) := by
    intro i ω
    have hind : ∀ f : Euclid (k + 1) → ℝ,
        ∫ u, (A i).indicator (fun u => (w i u : ℝ)) u * f u = ∫ u in A i, (w i u : ℝ) * f u := by
      intro f
      rw [← integral_indicator (hA i)]
      congr 1
      funext u
      exact (Set.indicator_mul_left _ _ _).symm
    have h := Submission.cmcdt_lpi_pullback_weak_continuity (k + 1) N' (Λ * L i)
      (fun j v => Fs j (G i v)) (fun v => F (G i v)) ((A i).indicator fun u => (w i u : ℝ))
      (ω : DifferentialForm (Euclid N') (k + 1)) (fun j => (hFs_lip j).comp (hL i))
      (hF.comp (hL i)) (hFs_tend.comp (G i)) ((hw_int i).integrable_indicator (hA i))
      (ContDiff.continuous ω.property.1.1) ω.property.1.2
    simpa only [hind] using h
  -- every test form has bounded coefficient norm: `|·|` is continuous and `ω` has compact support
  have hNcont : Continuous fun α : Covector (Euclid N') (k + 1) => covectorEuclideanNorm α := by
    unfold covectorEuclideanNorm
    refine Continuous.sqrt (continuous_finsetSum _ fun I _ => ?_)
    by_cases hI : StrictMono I
    · simp only [hI, ↓reduceIte]
      exact (continuous_eval_const _).pow 2
    · simp only [hI, ↓reduceIte]
      exact continuous_const
  have hbound : ∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), ∃ C : ℝ, 0 ≤ C ∧
      ∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) y) ≤ C := by
    intro ω
    have hcs : HasCompactSupport fun y =>
        covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) y) :=
      HasCompactSupport.comp_left (g := covectorEuclideanNorm) ω.property.1.2
        (covectorEuclideanNorm_zero N' (k + 1))
    obtain ⟨C, hC⟩ :=
      (hNcont.comp (ContDiff.continuous ω.property.1.1)).bounded_above_of_compact_support hcs
    exact ⟨max C 0, le_max_right _ _, fun y =>
      ((Real.le_norm_self _).trans (hC y)).trans (le_max_left _ _)⟩
  -- Tannery's theorem (dominated convergence for series): if `|fⱼ(i)| ≤ bᵢ` with `Σᵢ bᵢ < ∞`
  -- and `fⱼ(i) → g(i)` for every `i`, then `Σᵢ fⱼ(i) → Σᵢ g(i)`; an `ε/3` argument
  have htannery : ∀ (f : ℕ → ℕ → ℝ) (g bound : ℕ → ℝ), Summable bound →
      (∀ i, Tendsto (fun j => f j i) atTop (𝓝 (g i))) → (∀ j i, ‖f j i‖ ≤ bound i) →
      Tendsto (fun j => ∑' i, f j i) atTop (𝓝 (∑' i, g i)) := by
    intro f g bound h_sum hab h_bound
    have h_g_le : ∀ i, ‖g i‖ ≤ bound i := fun i =>
      le_of_tendsto' (tendsto_norm.comp (hab i)) fun j => h_bound j i
    have h_sumg : Summable fun i => ‖g i‖ :=
      h_sum.of_norm_bounded fun i => (norm_norm (g i)).symm ▸ h_g_le i
    have h_suma : ∀ j, Summable fun i => ‖f j i‖ := fun j =>
      h_sum.of_norm_bounded fun i => by simpa only [norm_norm] using h_bound j i
    rw [Metric.tendsto_nhds]
    intro ε hε
    -- a finite set `T` carrying all but `ε/3` of `Σᵢ bᵢ`
    obtain ⟨T, hT⟩ : ∃ T : Finset ℕ, dist (∑ i ∈ T, bound i) (∑' i, bound i) < ε / 3 := by
      have hS := h_sum.hasSum
      rw [HasSum, Metric.tendsto_nhds] at hS
      exact Eventually.exists <| hS _ (by positivity)
    have h1 : ∑' i : (Tᶜ : Set ℕ), bound i < ε / 3 := by
      calc _ ≤ ‖∑' i : (Tᶜ : Set ℕ), bound i‖ := Real.le_norm_self _
        _ = ‖∑' i, bound i - ∑ i ∈ T, bound i‖ := congrArg _ ?_
        _ < ε / 3 := by rwa [dist_eq_norm, norm_sub_rev] at hT
      rw [eq_sub_iff_add_eq']
      exact h_sum.sum_add_tsum_compl
    have h2 : Tendsto (fun j => ∑ i ∈ T, f j i) atTop (𝓝 (∑ i ∈ T, g i)) :=
      tendsto_finsetSum _ fun i _ => hab i
    rw [Metric.tendsto_nhds] at h2
    filter_upwards [h2 (ε / 3) (by positivity)] with j hj
    rw [dist_eq_norm, ← (h_suma j).of_norm.tsum_sub h_sumg.of_norm,
      ← ((h_suma j).of_norm.sub h_sumg.of_norm).sum_add_tsum_compl (s := T),
      (by ring : ε = ε / 3 + (ε / 3 + ε / 3))]
    refine (norm_add_le _ _).trans_lt (add_lt_add ?_ ?_)
    · simpa only [dist_eq_norm, Finset.sum_sub_distrib] using hj
    · rw [((h_suma j).subtype _).of_norm.tsum_sub (h_sumg.subtype _).of_norm]
      refine (norm_sub_le _ _).trans_lt (add_lt_add ?_ ?_)
      · refine ((norm_tsum_le_tsum_norm ((h_suma j).subtype _)).trans ?_).trans_lt h1
        exact ((h_suma j).subtype _).tsum_le_tsum (fun i => h_bound j i) (h_sum.subtype _)
      · refine ((norm_tsum_le_tsum_norm (h_sumg.subtype _)).trans ?_).trans_lt h1
        exact (h_sumg.subtype _).tsum_le_tsum (fun i => h_g_le i) (h_sum.subtype _)
  -- Step 8 (☆): `S(ω) = Σᵢ Tᵢ(ω)`, and `|Tᵢ(ω)| ≤ Bᵢ Λⁿ C` when `|ω| ≤ C`
  have hstar : ∀ (ω : TestFormOn (univ : Set (Euclid N')) (k + 1)) (C : ℝ), 0 ≤ C →
      (∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) y) ≤ C) →
      HasSum (fun i => ∫ u in A i, (w i u : ℝ) *
          (ω : DifferentialForm (Euclid N') (k + 1)) (F (G i u))
            (fun a => fderiv ℝ (fun v => F (G i v)) u (EuclideanSpace.single a 1))) (S ω) ∧
      ∀ i, ‖∫ u in A i, (w i u : ℝ) * (ω : DifferentialForm (Euclid N') (k + 1)) (F (G i u))
          (fun a => fderiv ℝ (fun v => F (G i v)) u (EuclideanSpace.single a 1))‖ ≤
        (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) := by
    intro ω C hC0 hC
    -- the limits `Tᵢ(ω)` inherit the bound of the `Tᵢⱼ(ω)`
    have hTi : ∀ i, ‖∫ u in A i, (w i u : ℝ) *
        (ω : DifferentialForm (Euclid N') (k + 1)) (F (G i u))
          (fun a => fderiv ℝ (fun v => F (G i v)) u (EuclideanSpace.single a 1))‖ ≤
        (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) := fun i =>
      le_of_tendsto' (hlim i ω).norm fun j => hTij i j ω C hC0 hC
    have hbsum : Summable fun i => (B i).toReal * ((Λ : ℝ) ^ (k + 1) * C) :=
      (ENNReal.summable_toReal hBsum).mul_right _
    refine ⟨?_, hTi⟩
    obtain ⟨ηs, hηW, hηlim⟩ := hη ω
    -- Step 5: `X(ηⱼ) = Σᵢ Tᵢⱼ(ω)`, since `ηⱼ = Fⱼ^#ω` on a neighbourhood of `Gᵢ(Aᵢ) ⊆ spt X`
    have hXj : ∀ j, HasSum (fun i => ∫ u in A i, (w i u : ℝ) *
        (ω : DifferentialForm (Euclid N') (k + 1)) (Fs j (G i u))
          (fun a => fderiv ℝ (fun v => Fs j (G i v)) u (EuclideanSpace.single a 1)))
        (X (ηs j)) := by
      intro j
      obtain ⟨W, -, hXW, hW⟩ := hηW j
      convert hXsum (ηs j) using 1
      funext i
      refine setIntegral_congr_fun (hA i) fun u hu => ?_
      rw [hW (G i u) (hXW (hG_spt i (mem_image_of_mem (G i) hu))),
        hchain i j u hu (ω : DifferentialForm (Euclid N') (k + 1))]
    -- Step 8: Tannery's theorem, `X(ηⱼ) = Σᵢ Tᵢⱼ(ω) → Σᵢ Tᵢ(ω)`; also `X(ηⱼ) → S(ω)`
    have htan := htannery _ _ _ hbsum (fun i => hlim i ω) fun j i =>
      hTij i j (ω : DifferentialForm (Euclid N') (k + 1)) C hC0 hC
    rw [tendsto_nhds_unique hηlim (Tendsto.congr (fun j => (hXj j).tsum_eq) htan)]
    exact (hbsum.of_norm_bounded hTi).hasSum
  -- Step 9: integer multiplicity pieces `Sᵢ` with `Sᵢ(ω) = Tᵢ(ω)`
  choose Sp hSp_im hSp using fun i => Submission.cmcdt_lpi_lipschitz_piece_im hCB hIMC hIMSc N'
    k (Λ * L i) (fun v => F (G i v)) (A i) (w i) (hF.comp (hL i)) (hA i) (hw i) (hw_int i)
  -- Step 10: `M(Sᵢ) ≤ Λⁿ Bᵢ`, so `Σᵢ M(Sᵢ) < ∞`
  have hSp_mass : ∀ i,
      (Sp i).mass ≤ ENNReal.ofReal ((B i).toReal * ((Λ : ℝ) ^ (k + 1) * 1)) := by
    intro i
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    refine ENNReal.ofReal_le_ofReal ?_
    rw [hSp i ω]
    exact (Real.le_norm_self _).trans ((hstar ω 1 zero_le_one hω.2).2 i)
  have hSp_sum : ∑' i, (Sp i).mass < ∞ := by
    have hbsum1 : Summable fun i => (B i).toReal * ((Λ : ℝ) ^ (k + 1) * 1) :=
      (ENNReal.summable_toReal hBsum).mul_right _
    calc ∑' i, (Sp i).mass
        ≤ ∑' i, ENNReal.ofReal ((B i).toReal * ((Λ : ℝ) ^ (k + 1) * 1)) :=
          ENNReal.tsum_le_tsum hSp_mass
      _ = ENNReal.ofReal (∑' i, (B i).toReal * ((Λ : ℝ) ^ (k + 1) * 1)) :=
          (ENNReal.ofReal_tsum_of_nonneg (fun i => by positivity) hbsum1).symm
      _ < ∞ := ENNReal.ofReal_lt_top
  -- Step 11: `Ŝ = Σᵢ Sᵢ` is integer multiplicity, and `Ŝ(ω) = Σᵢ Tᵢ(ω) = S(ω)`
  obtain ⟨Shat, hShat, -, -, hShat_im⟩ := hIMSc N' k Sp hSp_sum
  obtain ⟨R, hR⟩ := hShat_im hSp_im
  refine ⟨R, fun ω => ?_⟩
  rw [← hR ω]
  obtain ⟨C, hC0, hC⟩ := hbound ω
  refine (hstar ω C hC0 hC).1.unique ?_
  simpa only [hSp] using hShat ω
/-- **The cylinder over an integer multiplicity current is integer multiplicity** (step 8 (B5) of
the proof of the deformation theorem, Simon 6.5.1; Simon Ch. 6, 2.18–2.20 and 3.2(2):
`[[(0,1)]] × τ(M, θ, ξ) = τ((0,1) × M, θ, e₁ ∧ ξ)`).  Write `ι(t, x) = (t, x) ∈ ℝᴺ⁺¹`,
`e₀ = ι(1, 0)` and `Jv = ι(0, v)`.  Let `X ∈ 𝒟ₖ₊₁(ℝᴺ)` be integer multiplicity with `M(X) < ∞`,
and let `C ∈ 𝒟ₖ₊₂(ℝᴺ⁺¹)` satisfy `C(ω) = X(η)` for a test form `η` with
`η(x)(v) = ∫₀¹ ω(ι(t, x))(e₀, Jv) dt`.  By `cmcdt_lpi_piece_representation`,
`X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)` with Lipschitz `Gᵢ` and `Σᵢ ∫_{Aᵢ} |wᵢ| cᵢ ≤ M(X)`.  The product
pieces `Ĝᵢ(z) = ι(z₀, Gᵢ(tail z))` on `Âᵢ = (0, 1) × Aᵢ` with weights `ŵᵢ = wᵢ ∘ tail` turn each
term into `∫_{Âᵢ} ŵᵢ ω(Ĝᵢ)(DĜᵢ ê)` (`cmcdt_lpi_cyl_piece_action`), the action of an integer
multiplicity current `Ŝᵢ` (`cmcdt_lpi_lipschitz_piece_im`) of mass `M(Ŝᵢ) ≤ ∫_{Aᵢ} |wᵢ| cᵢ`
(`cmcdt_lpi_cyl_piece_mass`).  So `Σᵢ M(Ŝᵢ) ≤ M(X) < ∞`, (IMS) sums the `Ŝᵢ` to an integer
multiplicity current `Ĉ`, and `C(ω) = Σᵢ Ŝᵢ(ω) = Ĉ(ω)` for every test form `ω`. -/
theorem Submission.cmcdt_lpi_cylinder_im : ((∀ (N N' k : ℕ) (A : Euclid N →L[ℝ] Euclid N') (β : Covector (Euclid N') k), covectorEuclideanNorm (β.compContinuousLinearMap A) ≤ ‖A‖ ^ k * covectorEuclideanNorm β) ∧ (∀ (N k : ℕ) (v : Euclid N) (β : Covector (Euclid N) (k + 1)), covectorEuclideanNorm (β.curryLeft v) ≤ ‖v‖ * covectorEuclideanNorm β) ∧ ∀ (N k : ℕ) (α : Covector (Euclid N) k) (τ : Fin k → Euclid N), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ((∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S)) → ∀ (N k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)) (C : GeometricCurrentOn (univ : Set (Euclid (N + 1))) (k + 1 + 1)), IsIntegerMultiplicity X → IsCompact X.support → X.mass < ∞ → (∀ ω : TestFormOn (univ : Set (Euclid (N + 1))) (k + 1 + 1), ∃ η : TestFormOn (univ : Set (Euclid N)) (k + 1), (∀ (x : Euclid N) (v : Fin (k + 1) → Euclid N), (η : DifferentialForm (Euclid N) (k + 1)) x v = ∫ t in (0 : ℝ)..1, (ω : DifferentialForm (Euclid (N + 1)) (k + 1 + 1)) (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) (Fin.cons (EuclideanSpace.single 0 1) (fun i => WithLp.toLp 2 (Fin.cons 0 (WithLp.ofLp (v i)))))) ∧ C ω = X η) → IsIntegerMultiplicity C := by
  intro hCB hVO hMR hIMC hIMS N k X C hX _hXc hXm hslice
  -- (IMSc): (IMS) applied to (VO), (MR), (IMC)
  have hIMSc := hIMS hVO hMR hIMC
  -- Step 1: pieces `(Gᵢ, Aᵢ, wᵢ, cᵢ)` with `X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)`
  obtain ⟨G, A, w, c, hGL, hA, hw, hc, hGd, -, hwi, hcb, hsum, hrep⟩ :=
    Submission.cmcdt_lpi_piece_representation hCB hVO hMR hIMC N k X hX hXm
  choose L hL using hGL
  -- Step 2: the product pieces `Ĝᵢ(z) = ι(z₀, Gᵢ(tail z))`, `Âᵢ = (0, 1) × Aᵢ`, `ŵᵢ = wᵢ ∘ tail`
  obtain ⟨Gh, hGh⟩ : ∃ Gh : ℕ → Euclid (k + 1 + 1) → Euclid (N + 1), ∀ i z,
      Gh i z = WithLp.toLp 2 (Fin.cons (WithLp.ofLp z 0)
        (WithLp.ofLp (G i (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))))) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨Ah, hAh⟩ : ∃ Ah : ℕ → Set (Euclid (k + 1 + 1)), ∀ i,
      Ah i = {z : Euclid (k + 1 + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧
        (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid (k + 1)) ∈ A i} :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨wh, hwh⟩ : ∃ wh : ℕ → Euclid (k + 1 + 1) → ℤ, ∀ i z,
      wh i z = w i (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) :=
    ⟨_, fun _ _ => rfl⟩
  -- Steps 2–3 for each piece: `Ĝᵢ` Lipschitz, `Âᵢ` Borel, `ŵᵢ` integrable, and the slice identity
  -- `∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e) = ∫_{Âᵢ} ŵᵢ ω(Ĝᵢ)(DĜᵢ ê)`
  have hact := fun i => Submission.cmcdt_lpi_cyl_piece_action N (k + 1) (L i) (G i) (A i) (w i)
    (Gh i) (Ah i) (wh i) (hL i) (hA i) (hw i) (hwi i) (hGd i) (hGh i) (hAh i) (hwh i)
  -- Step 4: integer multiplicity pieces `Ŝᵢ(ω) = ∫_{Âᵢ} ŵᵢ ω(Ĝᵢ)(DĜᵢ ê)`
  have hS : ∀ i, ∃ S : GeometricCurrentOn (univ : Set (Euclid (N + 1))) (k + 1 + 1),
      IsIntegerMultiplicity S ∧ ∀ ω : TestFormOn (univ : Set (Euclid (N + 1))) (k + 1 + 1),
        S ω = ∫ z in Ah i, (wh i z : ℝ) *
          (ω : DifferentialForm (Euclid (N + 1)) (k + 1 + 1)) (Gh i z)
            (fun a => fderiv ℝ (Gh i) z (EuclideanSpace.single a 1)) := by
    intro i
    obtain ⟨hGhL, hAhm, hwhm, hwhi, -⟩ := hact i
    exact Submission.cmcdt_lpi_lipschitz_piece_im hCB hIMC hIMSc (N + 1) (k + 1) (max 1 (L i))
      (Gh i) (Ah i) (wh i) hGhL hAhm hwhm hwhi
  choose S hSim hSrep using hS
  -- Step 5: `M(Ŝᵢ) = sup {Ŝᵢ(ω) : |ω| ≤ 1} ≤ ∫_{Aᵢ} |wᵢ| cᵢ`, so `Σᵢ M(Ŝᵢ) ≤ M(X) < ∞`
  have hmass : ∀ i, (S i).mass ≤ ∫⁻ u in A i, ENNReal.ofReal (|(w i u : ℝ)| * c i u) := by
    intro i
    unfold GeometricCurrentOn.mass GeometricCurrentOn.massOn
    apply sSup_le
    rintro _ ⟨ω, hω, rfl⟩
    dsimp only
    rw [hSrep i ω]
    exact Submission.cmcdt_lpi_cyl_piece_mass hCB.1 hCB.2.1 N (k + 1) (G i) (A i) (w i) (c i)
      (Gh i) (Ah i) (wh i) (hA i) (hw i) (hc i) (hGd i) (hcb i) (hGh i) (hAh i) (hwh i) _ hω.2
  have hfin : ∑' i, (S i).mass < ∞ :=
    lt_of_le_of_lt ((ENNReal.tsum_le_tsum hmass).trans hsum) hXm
  -- Step 6: (IMSc) sums the `Ŝᵢ` to an integer multiplicity `Ĉ = τ(R)`
  obtain ⟨Ch, hChsum, -, -, hChim⟩ := hIMSc (N + 1) (k + 1) S hfin
  obtain ⟨R, hR⟩ := hChim hSim
  -- `C(ω) = X(η) = Σᵢ Ŝᵢ(ω) = Ĉ(ω)`, so `R` also represents `C`
  refine ⟨R, fun ω => ?_⟩
  obtain ⟨η, hη, hCω⟩ := hslice ω
  have hSη : (fun i => S i ω) = fun i => ∫ u in A i, (w i u : ℝ) *
      (η : DifferentialForm (Euclid N) (k + 1)) (G i u)
        (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a 1)) := by
    funext i
    rw [hSrep i ω]
    exact ((hact i).2.2.2.2 ω η hη).symm
  have hCsum : HasSum (fun i => S i ω) (C ω) := by
    rw [hSη, hCω]
    exact hrep η
  rw [hCsum.unique (hChsum ω)]
  exact hR ω

/-- **Integrality of Lipschitz push-forwards and of cylinders** (Simon Ch. 6, 2.25, 2.29 and
3.3–3.9; Part B of the Lipschitz push-forward step of the deformation theorem 6.5.1).  Assume
(VO), (MR), (IMC) and (IMS), and let `X ∈ 𝒟ₖ₊₁(ℝᴺ)` be integer multiplicity with compact
support and `M(X) < ∞`.
(I) If `Fⱼ → F` uniformly, the `Fⱼ` smooth and all maps `Λ`-Lipschitz, then a weak limit
`S(ω) = limⱼ X(Fⱼ^#ω)` is integer multiplicity: `X(η) = Σᵢ ∫_{Aᵢ} wᵢ η(Gᵢ)(DGᵢ e)` over
integer-weighted Lipschitz pieces, `X(Fⱼ^#ω) → Σᵢ ∫_{Aᵢ} wᵢ ω(F ∘ Gᵢ)(D(F ∘ Gᵢ) e)` by weak
continuity of pull-backs, and the limit is a series of integer multiplicity currents
`(F ∘ Gᵢ)_#(wᵢ [[Aᵢ]])` (`cmcdt_lpi_pushforward_im`).
(II) The cylinder `C = [[0, 1]] × X`, `C(ω) = X(∫₀¹ ω(t, ·)(e₀, ·) dt)`, is integer multiplicity,
by the product pieces `(t, u) ↦ (t, Gᵢ(u))` and Fubini (`cmcdt_lpi_cylinder_im`).
Both use the covector bounds `|A^#β| ≤ ‖A‖ᵏ|β|`, `|ι_vβ| ≤ |v||β|` and `|α(τ)| ≤ |α|` for
orthonormal `τ` (`cmcdt_lp_covector_norm_bounds`). -/
theorem Submission.cmcdt_lp_integer_multiplicity : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ((∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S)) → (∀ (N N' k : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N') (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)) (S : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1)), LipschitzWith Λ F → IsIntegerMultiplicity X → IsCompact X.support → X.mass < ∞ → (∃ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Fs j)) ∧ (∀ j, LipschitzWith Λ (Fs j)) ∧ TendstoUniformly Fs F atTop ∧ ∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), ∃ ηs : ℕ → TestFormOn (univ : Set (Euclid N)) (k + 1), (∀ j, ∃ W : Set (Euclid N), IsOpen W ∧ X.support ⊆ W ∧ ∀ x ∈ W, (ηs j : DifferentialForm (Euclid N) (k + 1)) x = ((ω : DifferentialForm (Euclid N') (k + 1)) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x)) ∧ Tendsto (fun j => X (ηs j)) atTop (𝓝 (S ω))) → IsIntegerMultiplicity S) ∧ ∀ (N k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid N)) (k + 1)) (C : GeometricCurrentOn (univ : Set (Euclid (N + 1))) (k + 1 + 1)), IsIntegerMultiplicity X → IsCompact X.support → X.mass < ∞ → (∀ ω : TestFormOn (univ : Set (Euclid (N + 1))) (k + 1 + 1), ∃ η : TestFormOn (univ : Set (Euclid N)) (k + 1), (∀ (x : Euclid N) (v : Fin (k + 1) → Euclid N), (η : DifferentialForm (Euclid N) (k + 1)) x v = ∫ t in (0 : ℝ)..1, (ω : DifferentialForm (Euclid (N + 1)) (k + 1 + 1)) (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) (Fin.cons (EuclideanSpace.single 0 1) (fun i => WithLp.toLp 2 (Fin.cons 0 (WithLp.ofLp (v i)))))) ∧ C ω = X η) → IsIntegerMultiplicity C := by
  intro hVO hMR hIMC hIMS
  -- (I) the limit of the smooth push-forwards `(Fⱼ)_# X`; (II) the cylinder `[[0, 1]] × X`
  exact ⟨Submission.cmcdt_lpi_pushforward_im Submission.cmcdt_lp_covector_norm_bounds hVO hMR
