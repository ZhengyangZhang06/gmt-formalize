      hcN.imp fun cN h => ⟨h, _, rfl⟩
    have hcN1 : 0 < cN + 1 := lt_add_of_le_of_pos hcN0 one_pos
    have hA₁0 : 0 ≤ A₁ := (mul_nonneg (mul_nonneg (add_nonneg (mul_nonneg zero_le_four hCd.le)
