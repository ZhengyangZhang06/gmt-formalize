        rw [NNReal.coe_one, one_mul]
        refine (dist_pi_le_iff dist_nonneg).2 fun i => ?_
        by_cases h : i ∈ s
        · simp only [h, ↓reduceDIte, dist_self, dist_nonneg]
        · simpa only [h, ↓reduceDIte] using dist_le_pi_dist t t' ⟨i, h⟩
