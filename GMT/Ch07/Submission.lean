      rw [integral_sub hi3 hi2, h3]
      linarith
    have heq : ∀ x : Euclid P, deriv η (‖x‖ ^ 2) * (2 * ‖x‖ ^ 2) - 2 * deriv η (‖x‖ ^ 2) *
