  -- Step 4: Lipschitz extensions `φⱼ` of `ψ|{d ≥ sⱼ}` (`sⱼ = 2⁻ʲ/32`) with constant `Λⱼ = c₅/sⱼ`
  have hs0 : ∀ j : ℕ, 0 < (1 / 2 : ℝ) ^ j / 32 := fun j => div_pos (he0 j) h32
