        rintro _ ⟨u, hu, rfl⟩ _ ⟨u', hu', rfl⟩
        rw [hψ u hu, hψ u' hu', dist_eq_norm, dist_eq_norm]
        calc ‖F' u - F' u'‖ ≤ K' * ‖u - u'‖ := hF'.norm_sub_le u u'
          _ ≤ K' * (2 * C A' * ‖Φ u - Φ u'‖) := mul_le_mul_of_nonneg_left (hkey u hu u' hu') K'.2
