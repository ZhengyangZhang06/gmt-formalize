skeleton deformation gives `T − Q₀ − S₁ = ∂R₁`, and the face replacement, applied with the compact
set `cthickening(√P, ρ⁻¹K) ⊇ spt Q₀` and the bound `c_sρ⁻ⁿΛ ≥ M(Q₀)`, gives `P_c` in a finite
family `𝒬₀` fixed in advance with `M(Q₀ − P_c) ≤ c_f M(∂Q₀)` and `M(∂P_c) ≤ c_f M(∂Q₀)`.  Then
`Q = δ_{ρ#}P_c ∈ δ_{ρ#}𝒬₀`, `R = δ_{ρ#}R₁` and `S = δ_{ρ#}(S₁ + Q₀ − P_c)` satisfy
`A − Q − S = ∂R`, `M(R) ≤ c_sρM(A)`, `M(S) ≤ cρM(∂A)`, `M(∂Q) ≤ c_f c_s M(∂A)` and
`spt R ⊆ cthickening(ρ√P, spt A) ⊆ cthickening(1, K)`.  The antecedent `M_W(T) = μ_T(W)` of the
two children is `dtc_mass_eq_measure` applied to `W ∩ U`. -/
theorem Submission.dtc_bc_lc_fd_deformation : ∀ (P m : ℕ), m + 1 < P → ∃ c : NNReal, ∀ (K : Set (Euclid P)) (Λ : NNReal) (ε : ℝ≥0∞), IsCompact K → 0 < ε → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ A : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity A → A.support ⊆ K → A.mass ≤ Λ → A.boundary.mass ≤ Λ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧ IsIntegerMultiplicity Q.boundary ∧ A - Q - S = R.boundary ∧ R.mass + S.mass ≤ ε ∧ Q.boundary.mass ≤ c * A.boundary.mass ∧ R.support ⊆ cthickening 1 K := by
  intro P m _
  -- `M_W(T) = μ_T(W)` for open `W`: `dtc_mass_eq_measure` gives it for `W ∩ U`, and neither side
  -- changes when `W` is replaced by `W ∩ U` (test forms in `U` and `θHⁿ⌞M` live in `U`)
  have hMR : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n),
      IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W →
        T.massOn W = R.measure W := by
    intro P n U T R hU hR W hW
    have h₁ : T.massOn W = T.massOn (W ∩ U) :=
      le_antisymm (sSup_le_sSup (image_mono fun ω hω => ⟨subset_inter hω.1 ω.2.2, hω.2⟩))
        (T.massOn_mono inter_subset_left)
    have h₂ : R.measure (W \ U) = 0 := by
      refine withDensity_absolutelyContinuous _ _ ?_
      rw [Measure.restrict_apply' R.measurableSet_carrier]
      exact measure_mono_null (fun x hx => (hx.1.2 (R.carrier_subset hx.2)).elim) measure_empty
    rw [h₁, ← measure_inter_add_sdiff W hU.measurableSet, h₂, add_zero]
    exact Submission.dtc_mass_eq_measure P n U (W ∩ U) T R hU (hW.inter hU) inter_subset_right hR
  -- the unit-scale deformation onto the `n`-skeleton, the face replacement and the dilations
  obtain ⟨cs, -, hskel⟩ := Submission.dtc_bc_lc_fd_dfm_skeleton_deformation
    Submission.dtc_vanish_off_support hMR Submission.dtc_bc_lc_fd_dfm_mass_representation_core
    Submission.cmc_imRep_locality_restrict_sub Submission.cmc_slice_mass_bounds P m
  obtain ⟨cf, -, hface⟩ := Submission.dtc_bc_lc_fd_dfm_face_replacement
    Submission.dtc_vanish_off_support hMR Submission.cmc_imRep_locality_restrict_sub P m
  obtain ⟨dil, hdil⟩ := Submission.cmcdt_dilation_pushforward P
  -- `c = c_s(1 + c_f)`, so `c_s ≤ c` and `c_s + c_f c_s = c`
  obtain ⟨c, hcs, hcfs⟩ : ∃ c : NNReal, (cs : ℝ≥0∞) ≤ c ∧ (cs : ℝ≥0∞) + cf * cs = c :=
    ⟨cs * (1 + cf), by exact_mod_cast le_mul_of_one_le_right zero_le le_self_add,
      by push_cast; ring⟩
  refine ⟨c, fun K Λ ε hK hε => ?_⟩
  -- a real `η ∈ (0, ε]` and a scale `ρ > 0` with `ρ√P ≤ 1` and `2cΛρ ≤ η`
  obtain ⟨η, hη, hηε⟩ : ∃ η : ℝ, 0 < η ∧ ENNReal.ofReal η ≤ ε := by
    obtain ⟨r, -, hr, hrε⟩ := ENNReal.lt_iff_exists_real_btwn.1 hε
    exact ⟨r, ENNReal.ofReal_pos.1 hr, hrε.le⟩
  obtain ⟨ρ, hρ, hρP, hρη⟩ :
      ∃ ρ : ℝ, 0 < ρ ∧ ρ * Real.sqrt P ≤ 1 ∧ ρ * (2 * c * Λ) ≤ η := by
    refine ⟨min (1 / (Real.sqrt P + 1)) (η / (2 * c * Λ + 1)),
      lt_min (by positivity) (by positivity), ?_, ?_⟩
    · calc min (1 / (Real.sqrt P + 1)) (η / (2 * c * Λ + 1)) * Real.sqrt P
          ≤ 1 / (Real.sqrt P + 1) * Real.sqrt P :=
            mul_le_mul_of_nonneg_right (min_le_left _ _) (Real.sqrt_nonneg _)
        _ ≤ 1 := by
            rw [div_mul_eq_mul_div, one_mul, div_le_one (by positivity)]
            linarith
    · calc min (1 / (Real.sqrt P + 1)) (η / (2 * c * Λ + 1)) * (2 * c * Λ)
          ≤ η / (2 * c * Λ + 1) * (2 * c * Λ) :=
            mul_le_mul_of_nonneg_right (min_le_right _ _) (by positivity)
        _ ≤ η := by
            rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
            exact mul_le_mul_of_nonneg_left (by linarith) hη.le
  have hpow : ∀ j : ℕ, ρ ^ (j + 1) * ρ⁻¹ ^ j = ρ := fun j => by
    rw [inv_pow, ← div_eq_mul_inv, div_eq_iff (pow_ne_zero _ hρ.ne')]
    ring
  -- `δ_{ρ⁻¹#}` and `δ_{ρ#}` in the degrees used below
  have hρi : 0 < ρ⁻¹ := inv_pos.2 hρ
  obtain ⟨-, hinv, hmT, hsT, hiT, -⟩ := hdil (m + 1) ρ⁻¹ hρi
  obtain ⟨-, -, hmT', -, -, hbT⟩ := hdil m ρ⁻¹ hρi
  obtain ⟨hlin, -, hm1, -, -, hb1⟩ := hdil (m + 1) ρ hρ
  obtain ⟨-, -, hm0, -, hi0, hb0⟩ := hdil m ρ hρ
  obtain ⟨-, -, hm2, hs2, hi2, -⟩ := hdil (m + 2) ρ hρ
  -- the finite family: `δ_{ρ#}𝒬₀`, with `𝒬₀` the face family for the compact set
  -- `cthickening(√P, ρ⁻¹K)` and the mass bound `c_sρ⁻ⁿΛ`
  obtain ⟨𝒬₀, h𝒬₀, hface'⟩ := hface (cthickening (Real.sqrt P) ((fun x => ρ⁻¹ • x) '' K))
    (cs * (ρ⁻¹ ^ (m + 1)).toNNReal * Λ) (hK.image (continuous_const_smul ρ⁻¹)).cthickening
  refine ⟨dil (m + 1) ρ '' 𝒬₀, h𝒬₀.image _, fun A hA hAK hAM hAbM => ?_⟩
  -- `T = δ_{ρ⁻¹#}A`: `δ_{ρ#}T = A`, `spt T = ρ⁻¹ spt A`, `M(T) = ρ⁻ⁿM(A)`, `M(∂T) = ρ¹⁻ⁿM(∂A)`
  obtain ⟨T, hAT, hTi, hTs, hTM, hTbM⟩ : ∃ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
      dil (m + 1) ρ T = A ∧ IsIntegerMultiplicity T ∧
        T.support = (fun x => ρ⁻¹ • x) '' A.support ∧
        T.mass = ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * A.mass ∧
        T.boundary.mass = ENNReal.ofReal (ρ⁻¹ ^ m) * A.boundary.mass :=
    ⟨dil (m + 1) ρ⁻¹ A, by simpa only [inv_inv] using hinv A, hiT A hA, hsT A, hmT A,
      by rw [hbT A]; exact hmT' _⟩
  have hTc : IsCompact T.support := by
    rw [hTs]
    exact (hK.of_isClosed_subset (isClosed_univ.sdiff A.isOpen_zeroRegion) hAK).image
      (continuous_const_smul ρ⁻¹)
  have hTMf : T.mass < ∞ := by
    rw [hTM]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hAM.trans_lt ENNReal.coe_lt_top)
  have hTbMf : T.boundary.mass < ∞ := by
    rw [hTbM]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hAbM.trans_lt ENNReal.coe_lt_top)
  -- the unit-scale deformation `T − Q₀ − S₁ = ∂R₁`
  obtain ⟨Q₀, R₁, S₁, hQ₀, hR₁, hTQRS, hQ₀sk, hQ₀M, hQ₀bM, hR₁M, hS₁M, hspt, -⟩ :=
    hskel T hTi hTc hTMf hTbMf
  -- the face replacement `P_c ∈ 𝒬₀` of `Q₀`
  have hQ₀K : Q₀.support ⊆ cthickening (Real.sqrt P) ((fun x => ρ⁻¹ • x) '' K) := by
    refine subset_union_left.trans (hspt.trans (cthickening_subset_of_subset _ ?_))
    rw [hTs]
    exact image_mono hAK
  have hQ₀Λ : Q₀.mass ≤ ((cs * (ρ⁻¹ ^ (m + 1)).toNNReal * Λ : NNReal) : ℝ≥0∞) := by
    calc Q₀.mass ≤ cs * T.mass := hQ₀M
      _ ≤ cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * Λ) := by
          rw [hTM]
          gcongr
      _ = ((cs * (ρ⁻¹ ^ (m + 1)).toNNReal * Λ : NNReal) : ℝ≥0∞) := by
          rw [ENNReal.coe_mul, ENNReal.coe_mul, mul_assoc]
          rfl
  obtain ⟨Pc, hPc, -, hPcb, -, -, hPcbM, hDM, -, -⟩ := hface' Q₀ hQ₀ hQ₀K hQ₀sk hQ₀Λ
    (hQ₀bM.trans_lt (ENNReal.mul_lt_top ENNReal.coe_lt_top hTbMf))
  -- `M(Z) ≤ M(X) + M(Y)` whenever `Z = X + Y` (mass is a supremum of evaluations)
  have hmass_add : ∀ (X Y Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)),
      (∀ ω, Z ω = X ω + Y ω) → Z.mass ≤ X.mass + Y.mass := by
    intro X Y Z hZ
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (Z ω) ≤ _
    rw [hZ]
    exact ENNReal.ofReal_add_le.trans (add_le_add (X.le_massOn hω) (Y.le_massOn hω))
  have hsub : ∀ (X Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), (X - Y) ω = X ω - Y ω :=
    fun _ _ _ => rfl
  -- `Q = δ_{ρ#}P_c`, `R = δ_{ρ#}R₁` and `S = δ_{ρ#}(S₁ + Q₀ − P_c)`
  refine ⟨dil (m + 1) ρ Pc, ⟨Pc, hPc, rfl⟩, dil (m + 2) ρ R₁, dil (m + 1) ρ (S₁ - (Pc - Q₀)),
    hi2 R₁ hR₁, by rw [hb0]; exact hi0 _ hPcb, ?_, ?_, ?_, ?_⟩
  -- `A − Q − S = δ_{ρ#}(T − P_c − (S₁ + Q₀ − P_c)) = δ_{ρ#}(T − Q₀ − S₁) = δ_{ρ#}∂R₁ = ∂R`
  · have hRb : (dil (m + 2) ρ R₁).boundary = dil (m + 1) ρ R₁.boundary := hb1 R₁
    rw [← hAT, ← hlin, ← hlin, hRb, ← hTQRS]
    congr 1
    ext ω
    simp only [hsub]
    ring
  -- `M(R) + M(S) ≤ cρΛ + cρΛ ≤ η ≤ ε`
  · have hR : (dil (m + 2) ρ R₁).mass ≤ ENNReal.ofReal ρ * (c * Λ) := by
      have hpow₂ : ρ ^ (m + 2) * ρ⁻¹ ^ (m + 1) = ρ := hpow (m + 1)
      calc (dil (m + 2) ρ R₁).mass = ENNReal.ofReal (ρ ^ (m + 2)) * R₁.mass := hm2 R₁
        _ ≤ ENNReal.ofReal (ρ ^ (m + 2)) * (cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * Λ)) := by
            gcongr
            calc R₁.mass ≤ cs * T.mass := hR₁M
              _ ≤ cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * Λ) := by
                  rw [hTM]
                  gcongr
        _ = ENNReal.ofReal (ρ ^ (m + 2) * ρ⁻¹ ^ (m + 1)) * (cs * Λ) := by
            rw [ENNReal.ofReal_mul (pow_nonneg hρ.le _)]
            ring
        _ ≤ ENNReal.ofReal ρ * (c * Λ) := by
            rw [hpow₂]
            gcongr
    have hS : (dil (m + 1) ρ (S₁ - (Pc - Q₀))).mass ≤ ENNReal.ofReal ρ * (c * Λ) := by
      have hS' : (S₁ - (Pc - Q₀)).mass ≤ c * T.boundary.mass := by
        calc (S₁ - (Pc - Q₀)).mass ≤ S₁.mass + (Q₀ - Pc).mass :=
              hmass_add _ _ _ fun ω => by simp only [hsub]; ring
          _ ≤ cs * T.boundary.mass + cf * (cs * T.boundary.mass) := by
              gcongr
              exact hDM.trans (by gcongr)
          _ = c * T.boundary.mass := by
              rw [← hcfs]
              ring
      calc (dil (m + 1) ρ (S₁ - (Pc - Q₀))).mass
          = ENNReal.ofReal (ρ ^ (m + 1)) * (S₁ - (Pc - Q₀)).mass := hm1 _
        _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) * (c * (ENNReal.ofReal (ρ⁻¹ ^ m) * Λ)) := by
            gcongr
            calc (S₁ - (Pc - Q₀)).mass ≤ c * T.boundary.mass := hS'
              _ ≤ c * (ENNReal.ofReal (ρ⁻¹ ^ m) * Λ) := by
                  rw [hTbM]
                  gcongr
        _ = ENNReal.ofReal (ρ ^ (m + 1) * ρ⁻¹ ^ m) * (c * Λ) := by
            rw [ENNReal.ofReal_mul (pow_nonneg hρ.le _)]
            ring
        _ = ENNReal.ofReal ρ * (c * Λ) := by rw [hpow]
    have h2cΛ : ENNReal.ofReal (2 * c * Λ) = 2 * c * Λ := by
      rw [show (2 * c * Λ : ℝ) = ((2 * c * Λ : NNReal) : ℝ) by push_cast; ring,
        ENNReal.ofReal_coe_nnreal]
      push_cast
      ring
    calc (dil (m + 2) ρ R₁).mass + (dil (m + 1) ρ (S₁ - (Pc - Q₀))).mass
        ≤ ENNReal.ofReal ρ * (c * Λ) + ENNReal.ofReal ρ * (c * Λ) := add_le_add hR hS
      _ = ENNReal.ofReal (ρ * (2 * c * Λ)) := by
          rw [ENNReal.ofReal_mul hρ.le, h2cΛ]
          ring
      _ ≤ ENNReal.ofReal η := ENNReal.ofReal_le_ofReal hρη
      _ ≤ ε := hηε
  -- `M(∂Q) = ρᵐM(∂P_c) ≤ ρᵐc_f c_s M(∂T) = c_f c_s M(∂A) ≤ c M(∂A)`
  · rw [hb0, hm0]
    calc ENNReal.ofReal (ρ ^ m) * Pc.boundary.mass
        ≤ ENNReal.ofReal (ρ ^ m) * (cf * (cs * (ENNReal.ofReal (ρ⁻¹ ^ m) * A.boundary.mass))) := by
          gcongr
          calc Pc.boundary.mass ≤ cf * Q₀.boundary.mass := hPcbM
            _ ≤ cf * (cs * (ENNReal.ofReal (ρ⁻¹ ^ m) * A.boundary.mass)) := by
                rw [← hTbM]
                gcongr
      _ = ENNReal.ofReal (ρ ^ m * ρ⁻¹ ^ m) * (cf * cs) * A.boundary.mass := by
          rw [ENNReal.ofReal_mul (pow_nonneg hρ.le _)]
          ring
      _ ≤ c * A.boundary.mass := by
          rw [← mul_pow, mul_inv_cancel₀ hρ.ne', one_pow, ENNReal.ofReal_one, one_mul, ← hcfs]
          gcongr
          exact le_add_self
  -- `spt R = ρ spt R₁ ⊆ ρ cthickening(√P, ρ⁻¹ spt A) ⊆ cthickening(ρ√P, K) ⊆ cthickening(1, K)`
  · rw [hs2]
    rintro _ ⟨x, hx, rfl⟩
    have hx' := hspt (mem_union_right _ hx)
    rw [hTc.cthickening_eq_biUnion_closedBall (Real.sqrt_nonneg _), hTs] at hx'
    obtain ⟨_, ⟨a, ha, rfl⟩, hxa⟩ := mem_iUnion₂.1 hx'
    refine mem_cthickening_of_dist_le _ a 1 K (hAK ha) ?_
    calc dist (ρ • x) a = dist (ρ • x) (ρ • ρ⁻¹ • a) := by rw [smul_inv_smul₀ hρ.ne']
      _ = ρ * dist x (ρ⁻¹ • a) := by rw [dist_smul₀, Real.norm_of_nonneg hρ.le]
      _ ≤ ρ * Real.sqrt P := mul_le_mul_of_nonneg_left (mem_closedBall.1 hxa) hρ.le
      _ ≤ 1 := hρP
/-- **Cauchy subsequence for the flat decomposition** (Simon Ch. 6, proof of 7.2,
chapter-06.txt lines 2101–2118: "apply (1) with `ε = 1, 1/2, 1/4` etc. to extract a subsequence
`{T_{j_r}}` … `T_{j_{r+1}} − T_{j_r} = ∂R_r + S_r` … `M(R_r) + M(S_r) ≤ 1/2^r`"; the errors `S`
need not be integer multiplicity).  If for every `ε > 0` a finite `𝒬` gives decompositions
`X_j − Q − S = ∂R` with `Q ∈ 𝒬`, `R` integer multiplicity, `spt R ⊆ L` and `M(R) + M(S) ≤ ε`,
then some subsequence has `X_{φ(r+1)} − X_{φ(r)} − S = ∂R` of the same kind with
`M(R) + M(S) ≤ 2^{-r}`.  For the `2^{-(r+1)}`-net `𝒬_r` every infinite index set contains an
infinite fibre of `j ↦ Q_r(j)`; for `j, l` in it, `R_{r,j} − R_{r,l}` and `S_{r,j} − S_{r,l}`
decompose `X_j − X_l` (`M(A − B) ≤ M(A) + M(B)`, `spt (R_{r,j} − R_{r,l}) ⊆ L`).  The diagonal
lemma `cmc_fc_cs_diagonal_subseq` then extracts `φ`. -/
theorem Submission.dtc_bc_lc_fd_cauchy_subseq : ∀ (P m : ℕ) (L : Set (Euclid P)) (X : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact L → (∀ ε : ℝ≥0∞, 0 < ε → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ j, ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧ R.support ⊆ L ∧ X j - Q - S = R.boundary ∧ R.mass + S.mass ≤ ε) → ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ r, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧ R.support ⊆ L ∧ X (φ (r + 1)) - X (φ r) - S = R.boundary ∧ R.mass + S.mass ≤ (2⁻¹ : ℝ≥0∞) ^ r := by
  intro P m L X hL hnet
  -- the contract's difference acts pointwise
  have hsub : ∀ {k : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) k)
      (ω : TestFormOn (univ : Set (Euclid P)) k), (A - B) ω = A ω - B ω := fun _ _ _ => rfl
  -- Step 4(d): `M(A − B) ≤ M(A) + M(B)`, since `−ω` is admissible along with `ω`
  have hmass : ∀ {k : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) k),
      (A - B).mass ≤ A.mass + B.mass := by
    intro k A B
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    have hω' : -ω ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      refine ⟨subset_univ _, fun x => ?_⟩
      change covectorEuclideanNorm (-(ω : DifferentialForm (Euclid P) k) x) ≤ 1
      rw [covectorEuclideanNorm_neg]
      exact hω.2 x
    calc ENNReal.ofReal ((A - B) ω) = ENNReal.ofReal (A ω + B (-ω)) := by
          rw [hsub, sub_eq_add_neg]
          congr 2
          exact (map_neg B.toCurrent ω).symm
      _ ≤ ENNReal.ofReal (A ω) + ENNReal.ofReal (B (-ω)) := ENNReal.ofReal_add_le
      _ ≤ A.mass + B.mass := add_le_add (A.le_massOn hω) (B.le_massOn hω')
  -- Step 1: `2^{-(r+1)}`-nets `𝒬_r` and decompositions `X_j − Q_r(j) − S_{r,j} = ∂R_{r,j}`
  choose 𝒬 h𝒬 hdec using fun r : ℕ =>
    hnet ((2⁻¹ : ℝ≥0∞) ^ (r + 1)) (ENNReal.pow_pos (ENNReal.inv_pos.2 ENNReal.ofNat_ne_top) _)
  choose Q hQ R S hR hRL hXRS hRS using hdec
  -- Step 5: the diagonal lemma for the relation `C(r, j, l)` of step 2
  refine Submission.cmc_fc_cs_diagonal_subseq (fun r j l =>
    ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
      (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)),
      IsIntegerMultiplicity R ∧ R.support ⊆ L ∧ X j - X l - S = R.boundary ∧
        R.mass + S.mass ≤ (2⁻¹ : ℝ≥0∞) ^ r) fun r I hI => ?_
  -- Step 3: some fibre `J = {j ∈ I | Q_r(j) = Q₀}` over the finite net `𝒬_r` is infinite
  obtain ⟨Q₀, -, hJ⟩ : ∃ Q₀ ∈ 𝒬 r, {j ∈ I | Q r j = Q₀}.Infinite := by
    by_contra hcon
    exact hI (((h𝒬 r).biUnion fun Q₀ hQ₀ =>
      Set.not_infinite.1 fun h => hcon ⟨Q₀, hQ₀, h⟩).subset
        fun j hj => Set.mem_biUnion (hQ r j) ⟨hj, rfl⟩)
  refine ⟨{j ∈ I | Q r j = Q₀}, sep_subset _ _, hJ, ?_⟩
  -- Step 4: for `j, l ∈ J` take `R_{r,j} − R_{r,l}` and `S_{r,j} − S_{r,l}`
  rintro j ⟨-, hj⟩ l ⟨-, hl⟩
  refine ⟨R r j - R r l, S r j - S r l, ?_, ?_, ?_, ?_⟩
  · -- (a) integer multiplicity, by (IC)(c)
    exact Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 2) univ (R r j) (R r l)
      isOpen_univ (hR r j) (hR r l)
  · -- (c) `spt (R_{r,j} − R_{r,l}) ⊆ L`: both vanish on forms supported away from `L`
    refine (Submission.rsd_cmr_support_subset_of_vanish P (m + 2) univ L (R r j - R r l)
      isOpen_univ hL (subset_univ L) fun ω hω => ?_).1
    rw [hsub, Submission.dtc_vanish_off_support P (m + 2) univ (R r j) ω
      (hω.mono_right (hRL r j)), Submission.dtc_vanish_off_support P (m + 2) univ (R r l) ω
      (hω.mono_right (hRL r l)), sub_zero]
  · -- (b) subtract the two decompositions, using `Q_r(j) = Q₀ = Q_r(l)`
    ext ω
    have h₁ := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => T ω)
      (hXRS r j)
    have h₂ := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => T ω)
      (hXRS r l)
    simp only [hsub, GeometricCurrentOn.boundary_apply, hj, hl] at h₁ h₂ ⊢
    linarith
  · -- (d) `M(R) + M(S) ≤ 2 · 2^{-(r+1)} = 2^{-r}`
    calc (R r j - R r l).mass + (S r j - S r l).mass
        ≤ ((R r j).mass + (R r l).mass) + ((S r j).mass + (S r l).mass) :=
          add_le_add (hmass _ _) (hmass _ _)
      _ = ((R r j).mass + (S r j).mass) + ((R r l).mass + (S r l).mass) :=
          add_add_add_comm _ _ _ _
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ (r + 1) + (2⁻¹ : ℝ≥0∞) ^ (r + 1) := add_le_add (hRS r j) (hRS r l)
      _ = (2⁻¹ : ℝ≥0∞) ^ r := by
          rw [pow_succ, ← mul_add, ENNReal.inv_two_add_inv_two, mul_one]
/-- **Simon 6.2.3 and 6.2.11**: if `S(ω) = c·∂T(ω)` for every test `n`-form `ω` in `U`, then
`spt S ⊆ spt T`.  If `x ∉ spt T`, then `x` lies in an open `W` with compact closure in `U` on
which `T` vanishes.  For a test `n`-form `ω` with `spt ω ⊆ W`, `S(ω) = c·∂T(ω) = c·T(dω) = 0`,
as `spt dω ⊆ spt ω ⊆ W`.  So `W` is also a zero region of `S`, and `x ∉ spt S`. -/
theorem Submission.dimred_cs_sos_mt_cc_support_smul_boundary : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (S : GeometricCurrentOn U n) (c : ℝ), (∀ ω : TestFormOn U n, S ω = c * T.boundary ω) → S.support ⊆ T.support := by
  intro P n U T S c hS x hx
  -- `x ∈ spt S = U \ S.zeroRegion`; it remains to show `x ∉ T.zeroRegion`
  refine ⟨hx.1, ?_⟩
  -- step 1: otherwise `x` lies in a zero region `W` of `T`
  rintro ⟨W, ⟨hWo, hWc, hWU, hTW⟩, hxW⟩
  -- steps 2–3: `W` is a zero region of `S` as well, so `x ∈ S.zeroRegion`
  refine hx.2 ⟨W, ⟨hWo, hWc, hWU, fun ω hω => ?_⟩, hxW⟩
  -- `S(ω) = c·∂T(ω) = c·T(dω)`, and `T(dω) = 0` as `spt dω ⊆ spt ω ⊆ W`
  rw [hS ω, GeometricCurrentOn.boundary_apply,
    hTW (exteriorDerivativeTestOn U n ω)
      ((tsupport_exteriorDerivative_subset (ω : DifferentialForm (Euclid P) n)).trans hω),
    mul_zero]
/-- **Vanishing on the carrier and the `C⁰` bound for `T = τ(M, θ, ξ)`** (Simon 6.3.1 (‡); step 0
of the construction of the cone `0 ⨯ X`, Simon 6.2.30, in the dimension reduction argument).  By
`R.Represents X`, `X(γ) = ∫_M θ ⟨γ, ξ⟩ dHⁿ`.  (a) If `γ = 0` on `M`, the integrand vanishes at
every point of `M`.  (b) `Hⁿ`-a.e. on `M`, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ` orthonormal, so
`|⟨α, ξ(x)⟩| = |α(τ)| ≤ ‖α‖`.  If `μ_R(ℝᴾ) = ∫_M θ dHⁿ < ∞`, then `θ` is `Hⁿ⌞M`-integrable
with integral `μ_R(ℝᴾ)`, and `|X(γ)| ≤ ∫_M θ b dHⁿ = μ_R(ℝᴾ) b`. -/
theorem Submission.dimred_cs_sos_cfs_cc_imrep_vanish_bound : ∀ (P n : ℕ) (U : Set (Euclid P)) (X : GeometricCurrentOn U n) (R : IMRep U n), R.Represents X → (∀ γ : TestFormOn U n, (∀ x ∈ R.carrier, (γ : DifferentialForm (Euclid P) n) x = 0) → X γ = 0) ∧ (R.measure univ ≠ ∞ → ∀ (γ : TestFormOn U n) (b : ℝ), (∀ x, ‖(γ : DifferentialForm (Euclid P) n) x‖ ≤ b) → |X γ| ≤ (R.measure univ).toReal * b) := by
  intro P n U X R hR
  refine ⟨fun γ hγ => ?_, fun hfin γ b hb => ?_⟩
  · -- Step 1: the integrand `θ(x) ⟨γ(x), ξ(x)⟩` vanishes at every point of `M`
    rw [hR γ, IMRep.action]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [hγ x hx, map_zero, mul_zero]
  · -- Step 2: `Hⁿ`-a.e. on `M`, `|⟨α, ξ(x)⟩| ≤ ‖α‖`, since `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ`, `τ` orthonormal
    have hξ : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
        ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ ‖α‖ := by
      filter_upwards [R.orients] with x hx α
      obtain ⟨Q, -, τ, hτ, -, hsign⟩ := hx
      have hα : |α τ| ≤ ‖α‖ := by
        simpa [hτ.1] using α.le_opNorm τ
      rcases hsign with h | h
      · rw [h α]
        exact hα
      · rw [h α, abs_neg]
        exact hα
    -- Step 3: `μ_R(ℝᴾ) = ∫⁻_M θ dHⁿ`
    have hmass : R.measure univ = ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
      rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
    -- Step 4: `θ` is `Hⁿ⌞M`-integrable with integral `μ_R(ℝᴾ)`
    have hθm : AEMeasurable (fun x => (R.mult x : ℝ≥0∞)) (μHE[n].restrict R.carrier) :=
      (measurable_from_nat.comp R.measurable_mult).aemeasurable
    have hθi : Integrable (fun x => (R.mult x : ℝ)) (μHE[n].restrict R.carrier) := by
      simpa only [ENNReal.toReal_natCast] using
        integrable_toReal_of_lintegral_ne_top hθm (by rwa [← hmass])
    have hθ : ∫ x in R.carrier, (R.mult x : ℝ) ∂μHE[n] = (R.measure univ).toReal := by
      rw [hmass, ← integral_toReal hθm (Eventually.of_forall fun x => ENNReal.natCast_lt_top _)]
      simp only [ENNReal.toReal_natCast]
    -- Step 5: `|X(γ)| ≤ ∫_M θ b dHⁿ = μ_R(ℝᴾ) b`
    rw [hR γ, IMRep.action, ← Real.norm_eq_abs, ← hθ, ← integral_mul_const]
    refine norm_integral_le_of_norm_le (hθi.mul_const b) ?_
    filter_upwards [hξ] with x hx
    rw [norm_mul, Real.norm_eq_abs, Nat.abs_cast]
    exact mul_le_mul_of_nonneg_left ((hx _).trans (hb x)) (Nat.cast_nonneg _)
/-- **The cut-off radial operator `ω ↦ ζ·Kω`** (for the cone `0 ⨯ T = h#([[(0, 1)]] × T)`,
`h(t, x) = tx`, Simon 6.2.30).  For a `(q+2)`-form `β` put `(Kβ)(x) = ∫₀¹ t^{q+1} ι_x β(tx) dt`,
`ι_x α = α.curryLeft x`, and assume that `Kβ` is `C^∞` whenever `β` is.  Let `ζ` be the bump
function with `ζ = 1` on `B̄_ρ(0)`, `ζ = 0` off `B_{ρ+1}(0)` and `0 ≤ ζ ≤ 1`.  The integrands are
continuous, so `K` is linear on test forms and `Φ ω = ζ·Kω` is a linear map
`𝒟^{q+2}(ℝᴾ) → 𝒟^{q+1}(ℝᴾ)` with `Φ ω = Kω` on `B_ρ(0)`.  Since `‖ι_x α‖ ≤ ‖α‖ ‖x‖`,
`‖ω‖ ≤ b` gives `‖Kω(x)‖ ≤ b ‖x‖`, hence `‖(Φ ω)(x)‖ ≤ (ρ + 1) b`. -/
theorem Submission.dimred_cs_sos_cfs_cc_cutoff_cone_operator : ∀ (P q : ℕ) (ρ : ℝ), 0 < ρ → (∀ β : DifferentialForm (Euclid P) (q + 1 + 1), ContDiff ℝ (⊤ : ℕ∞) β → ContDiff ℝ (⊤ : ℕ∞) (fun x : Euclid P => ∫ t in (0 : ℝ)..1, t ^ (q + 1) • (β (t • x)).curryLeft x)) → ∃ Φ : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1) →ₗ[ℝ] TestFormOn (univ : Set (Euclid P)) (q + 1), (∀ (ω : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1)) (x : Euclid P), ‖x‖ < ρ → (Φ ω : DifferentialForm (Euclid P) (q + 1)) x = ∫ t in (0 : ℝ)..1, t ^ (q + 1) • ((ω : DifferentialForm (Euclid P) (q + 1 + 1)) (t • x)).curryLeft x) ∧ ∀ (ω : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1)) (b : ℝ), (∀ y, ‖(ω : DifferentialForm (Euclid P) (q + 1 + 1)) y‖ ≤ b) → ∀ x, ‖(Φ ω : DifferentialForm (Euclid P) (q + 1)) x‖ ≤ (ρ + 1) * b := by
  intro P q ρ hρ hK
  -- Step 1: the cutoff `ζ`, with `ζ = 1` on `closedBall 0 ρ` and `ζ = 0` off `ball 0 (ρ + 1)`
  let ζ : ContDiffBump (0 : Euclid P) := ⟨ρ, ρ + 1, hρ, by linarith⟩
  let K : DifferentialForm (Euclid P) (q + 1 + 1) → DifferentialForm (Euclid P) (q + 1) :=
    fun β x => ∫ t in (0 : ℝ)..1, t ^ (q + 1) • (β (t • x)).curryLeft x
  -- Step 2: for continuous `β` the integrands are continuous, hence interval integrable
  have hint : ∀ β : DifferentialForm (Euclid P) (q + 1 + 1), Continuous β → ∀ x : Euclid P,
      IntervalIntegrable (fun t : ℝ => t ^ (q + 1) • (β (t • x)).curryLeft x) volume 0 1 := by
    intro β hβ x
    refine Continuous.intervalIntegrable ?_ 0 1
    have hc : Continuous fun t : ℝ => (β (t • x)).curryLeft :=
      (ContinuousAlternatingMap.curryLeftLI (𝕜 := ℝ)).continuous.comp
        (hβ.comp (continuous_id.smul continuous_const))
    exact (continuous_pow (q + 1)).smul (hc.clm_apply continuous_const)
  have hsm : ∀ ω : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1),
      ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) (q + 1 + 1)) := fun ω => ω.2.1.1
  -- Step 3: `K` is additive and homogeneous on test forms
  have hKadd : ∀ ω ω' : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1),
      K ((ω : DifferentialForm (Euclid P) (q + 1 + 1)) + ω') = K ω + K ω' := by
    intro ω ω'
    funext x
    simp only [K, Pi.add_apply, ContinuousAlternatingMap.curryLeft_add, add_apply, smul_add]
    exact intervalIntegral.integral_add (hint _ (hsm ω).continuous x) (hint _ (hsm ω').continuous x)
  have hKsmul : ∀ (c : ℝ) (ω : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1)),
      K (c • (ω : DifferentialForm (Euclid P) (q + 1 + 1))) = c • K ω := by
    intro c ω
    funext x
    simp only [K, Pi.smul_apply, ContinuousAlternatingMap.curryLeft_smul, smul_apply]
    rw [← intervalIntegral.integral_smul]
    congr 1
    funext t
    rw [smul_comm]
  -- Step 4: `ζ • Kω` is a test form, `Kω` being smooth by the hypothesis on `K`
  have hη : ∀ ω : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1),
      (fun x => ζ x • K ω x) ∈ TestFormOn (univ : Set (Euclid P)) (q + 1) := by
    intro ω
    refine ⟨⟨?_, ?_⟩, subset_univ _⟩
    · exact (ζ.contDiff (n := ⊤)).smul (hK _ (hsm ω))
    · exact ζ.hasCompactSupport.smul_right
  -- Step 5: `Φ ω := ζ • Kω` is linear in `ω`
  let Φ : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1) →ₗ[ℝ]
      TestFormOn (univ : Set (Euclid P)) (q + 1) :=
    { toFun := fun ω => ⟨fun x => ζ x • K ω x, hη ω⟩
      map_add' := by
        intro ω ω'
        apply Subtype.ext
        funext x
        show ζ x • K ((ω : DifferentialForm (Euclid P) (q + 1 + 1)) + ω') x =
          ζ x • K ω x + ζ x • K ω' x
        rw [hKadd, Pi.add_apply, smul_add]
      map_smul' := by
        intro c ω
        apply Subtype.ext
        funext x
        show ζ x • K (c • (ω : DifferentialForm (Euclid P) (q + 1 + 1))) x = c • (ζ x • K ω x)
        rw [hKsmul, Pi.smul_apply, smul_comm] }
  refine ⟨Φ, ?_, ?_⟩
  · -- Step 6: `ζ x = 1` for `‖x‖ < ρ`, so `(Φ ω)(x) = Kω(x)`
    intro ω x hx
    show ζ x • K ω x = _
    rw [ζ.one_of_mem_closedBall (mem_closedBall_zero_iff.2 hx.le), one_smul]
  · -- Step 7: `‖(Φ ω)(x)‖ ≤ (ρ + 1) b`
    intro ω b hb x
    have hb0 : 0 ≤ b := (norm_nonneg _).trans (hb 0)
    show ‖ζ x • K ω x‖ ≤ (ρ + 1) * b
    rcases lt_or_ge ‖x‖ (ρ + 1) with hx | hx
    · -- `‖t ^ (q + 1) • ι_x ω(t x)‖ ≤ ‖ω(t x)‖ ‖x‖ ≤ b ‖x‖` on `(0, 1]`, so `‖Kω(x)‖ ≤ b ‖x‖`
      have hKx : ‖K ω x‖ ≤ b * ‖x‖ := by
        have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 1)
          (C := b * ‖x‖)
          (f := fun t => t ^ (q + 1) •
            ((ω : DifferentialForm (Euclid P) (q + 1 + 1)) (t • x)).curryLeft x)
          (by
            intro t ht
            rw [uIoc_of_le zero_le_one] at ht
            rw [norm_smul, norm_pow, Real.norm_eq_abs, abs_of_pos ht.1]
            calc t ^ (q + 1) * ‖((ω : DifferentialForm (Euclid P) (q + 1 + 1)) (t • x)).curryLeft x‖
                ≤ 1 * (b * ‖x‖) := by
                  refine mul_le_mul (pow_le_one₀ ht.1.le ht.2) ?_ (norm_nonneg _) zero_le_one
                  calc ‖((ω : DifferentialForm (Euclid P) (q + 1 + 1)) (t • x)).curryLeft x‖
                      ≤ ‖((ω : DifferentialForm (Euclid P) (q + 1 + 1)) (t • x)).curryLeft‖ *
                          ‖x‖ := ContinuousLinearMap.le_opNorm _ _
                    _ = ‖(ω : DifferentialForm (Euclid P) (q + 1 + 1)) (t • x)‖ * ‖x‖ := by
                        rw [ContinuousAlternatingMap.norm_curryLeft]
                    _ ≤ b * ‖x‖ := mul_le_mul_of_nonneg_right (hb _) (norm_nonneg _)
              _ = b * ‖x‖ := one_mul _)
        simpa using h
      -- `0 ≤ ζ ≤ 1` and `‖x‖ < ρ + 1`
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ζ.nonneg]
      calc ζ x * ‖K ω x‖ ≤ 1 * (b * ‖x‖) := mul_le_mul ζ.le_one hKx (norm_nonneg _) zero_le_one
        _ ≤ (ρ + 1) * b := by nlinarith [norm_nonneg x]
    · -- `ζ x = 0` for `‖x‖ ≥ ρ + 1`
      rw [ζ.zero_of_le_dist (by rw [dist_zero_right]; exact hx), zero_smul, norm_zero]
      exact mul_nonneg (by linarith) hb0
/-- **Localized radial homotopy formula with a compactly supported primitive** (the cone
construction behind Simon 6.2.25–2.32).  Write `K₀β(x) = ∫₀¹ t^q ι_x β(tx) dt` and
`K₁α(x) = ∫₀¹ t^(q+1) ι_x α(tx) dt`, and assume the homotopy formula (H): `K₀β` is `C^∞` and
`d(K₀β) + K₁(dβ) = β` for every `C^∞` `(q+1)`-form `β`.  For a test form `γ`, (H) gives
`K₁(dγ) = γ − d(K₀γ)`.  Let `ζ` be a bump equal to `1` near every point of `B(0, |ρ| + 1)`.  Then
`ψ = ζ K₀γ` is a test form, and `ψ = K₀γ` near each `x` with `‖x‖ < ρ`, so
`dψ(x) = d(K₀γ)(x)` there. -/
theorem Submission.dimred_cs_sos_cfs_cc_cutoff_homotopy : ∀ (P q : ℕ) (ρ : ℝ), (∀ β : DifferentialForm (Euclid P) (q + 1), ContDiff ℝ (⊤ : ℕ∞) β → ContDiff ℝ (⊤ : ℕ∞) (fun x : Euclid P => ∫ t in (0 : ℝ)..1, t ^ q • (β (t • x)).curryLeft x) ∧ ∀ x : Euclid P, exteriorDerivative (fun y : Euclid P => ∫ t in (0 : ℝ)..1, t ^ q • (β (t • y)).curryLeft y) x + (∫ t in (0 : ℝ)..1, t ^ (q + 1) • (exteriorDerivative β (t • x)).curryLeft x) = β x) → ∀ γ : TestFormOn (univ : Set (Euclid P)) (q + 1), ∃ ψ : TestFormOn (univ : Set (Euclid P)) q, ∀ x : Euclid P, ‖x‖ < ρ → (∫ t in (0 : ℝ)..1, t ^ (q + 1) • (exteriorDerivative (γ : DifferentialForm (Euclid P) (q + 1)) (t • x)).curryLeft x) = (γ : DifferentialForm (Euclid P) (q + 1)) x - exteriorDerivative (ψ : DifferentialForm (Euclid P) q) x := by
  intro P q ρ hH γ
  -- Step 1: the homotopy formula (H) for the smooth form `γ`
  obtain ⟨hKγ, hγ⟩ := hH (γ : DifferentialForm (Euclid P) (q + 1)) γ.property.1.1
  -- Step 2: a bump `ζ` equal to `1` near every point of `B(0, |ρ| + 1)`
  let ζ : ContDiffBump (0 : Euclid P) := ⟨|ρ| + 1, |ρ| + 2, by positivity, by linarith⟩
  -- Step 3: the test form `ψ = ζ K₀γ`
  refine ⟨⟨fun y => ζ y • ∫ t in (0 : ℝ)..1,
      t ^ q • ((γ : DifferentialForm (Euclid P) (q + 1)) (t • y)).curryLeft y,
    ⟨ζ.contDiff.smul hKγ, ζ.hasCompactSupport.smul_right⟩, subset_univ _⟩, fun x hx => ?_⟩
  -- Step 4: `ψ = K₀γ` near `x`, so `dψ(x) = d(K₀γ)(x)`
  have hxζ : x ∈ ball (0 : Euclid P) ζ.rIn := by
    rw [mem_ball_zero_iff]
    exact hx.trans_le ((le_abs_self ρ).trans (le_add_of_nonneg_right zero_le_one))
  have hloc : (fun y => ζ y • ∫ t in (0 : ℝ)..1,
      t ^ q • ((γ : DifferentialForm (Euclid P) (q + 1)) (t • y)).curryLeft y) =ᶠ[𝓝 x]
      fun y => ∫ t in (0 : ℝ)..1,
        t ^ q • ((γ : DifferentialForm (Euclid P) (q + 1)) (t • y)).curryLeft y := by
    filter_upwards [ζ.eventuallyEq_one_of_mem_ball hxζ] with y hy
    rw [hy, Pi.one_apply, one_smul]
  -- Step 5: `K₁(dγ)(x) = γ(x) - d(K₀γ)(x) = γ(x) - dψ(x)`
  exact (eq_sub_of_add_eq' (hγ x)).trans
    (congrArg (fun v => (γ : DifferentialForm (Euclid P) (q + 1)) x - v) hloc.extDeriv_eq.symm)
/-- Smoothness of parametric integrals over `[0, 1]`, used for the slice form of `[[0, 1]] × T`
(Simon 6.2.17–2.22).  If `h : ℝ × ℝᴺ → V` is `C^∞`, then `x ↦ ∫₀¹ h(t, x) dt` is `C^∞` and its
derivative at `x` is `∫₀¹ D[x' ↦ h(t, x')](x) dt`.  The derivative formula is differentiation under
the integral sign, with the partial derivative bounded on `[0, 1] × closedBall x 1`; `C^n` follows
by induction on `n` over all value spaces, the derivative being a parametric integral of the
`C^∞` map `(t, x) ↦ D[x' ↦ h(t, x')](x)` with values in `L(ℝᴺ, V)`. -/
theorem Submission.cmcdt_lpo_slice_param_integral : ∀ (N : ℕ) (V : Type) [NormedAddCommGroup V] [NormedSpace ℝ V] [CompleteSpace V] (h : ℝ × Euclid N → V), ContDiff ℝ (⊤ : ℕ∞) h → ContDiff ℝ (⊤ : ℕ∞) (fun x : Euclid N => ∫ t in (0 : ℝ)..1, h (t, x)) ∧ ∀ x : Euclid N, HasFDerivAt (fun x' : Euclid N => ∫ t in (0 : ℝ)..1, h (t, x')) (∫ t in (0 : ℝ)..1, fderiv ℝ (fun x' : Euclid N => h (t, x')) x) x := by
  intro N
  -- Steps 1–2: `x' ↦ h (t, x')` has derivative `(fderiv ℝ h (t, x)).comp inr` at `x`, so the
  -- partial derivative `h₁ p = fderiv ℝ (fun x' => h (p.1, x')) p.2` is `C^∞` in `p`.
  have hsmooth : ∀ (V : Type) [NormedAddCommGroup V] [NormedSpace ℝ V] (h : ℝ × Euclid N → V),
      ContDiff ℝ (⊤ : ℕ∞) h →
        ContDiff ℝ (⊤ : ℕ∞) (fun p : ℝ × Euclid N => fderiv ℝ (fun x' : Euclid N => h (p.1, x')) p.2) := by
    intro V _ _ h hh
    have hd : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ h) := (contDiff_infty_iff_fderiv.1 hh).2
    have hpart : (fun p : ℝ × Euclid N => fderiv ℝ (fun x' : Euclid N => h (p.1, x')) p.2) =
        fun p => (fderiv ℝ h p).comp (ContinuousLinearMap.inr ℝ ℝ (Euclid N)) := by
      funext p
      exact (((contDiff_infty_iff_fderiv.1 hh).1 p).hasFDerivAt.comp p.2
        (hasFDerivAt_prodMk_right p.1 p.2)).fderiv
    rw [hpart]
    exact hd.clm_comp contDiff_const
  -- Step 3: differentiation under the integral sign, with a uniform bound on the partial
  -- derivative over the compact set `[0, 1] × closedBall x₀ 1`.
  have hderiv : ∀ (V : Type) [NormedAddCommGroup V] [NormedSpace ℝ V] (h : ℝ × Euclid N → V),
      ContDiff ℝ (⊤ : ℕ∞) h → ∀ x₀ : Euclid N,
        HasFDerivAt (fun x' : Euclid N => ∫ t in (0 : ℝ)..1, h (t, x'))
          (∫ t in (0 : ℝ)..1, fderiv ℝ (fun x' : Euclid N => h (t, x')) x₀) x₀ := by
    intro V _ _ h hh x₀
    have hdiff : Differentiable ℝ h := (contDiff_infty_iff_fderiv.1 hh).1
    have hc : Continuous h := hh.continuous
    have h₁c := (hsmooth V h hh).continuous
    obtain ⟨B, hB⟩ := (isCompact_Icc.prod (isCompact_closedBall x₀ 1)).exists_bound_of_continuousOn
      h₁c.continuousOn
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le'' (μ := volume)
      (F := fun x t => h (t, x)) (F' := fun x t => fderiv ℝ (fun x' : Euclid N => h (t, x')) x)
      (bound := fun _ => B) (ball_mem_nhds x₀ one_pos) ?_ ?_ ?_ ?_ intervalIntegrable_const ?_
    · exact Eventually.of_forall fun x =>
        (hc.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable
    · exact (hc.comp (continuous_id.prodMk continuous_const)).intervalIntegrable 0 1
    · exact (h₁c.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable
    · refine (ae_restrict_mem measurableSet_uIoc).mono fun t ht x hx => ?_
      rw [uIoc_of_le zero_le_one] at ht
      exact hB (t, x) (Set.mk_mem_prod (Ioc_subset_Icc_self ht) (ball_subset_closedBall hx))
    · exact Eventually.of_forall fun t x _ =>
        ((hdiff (t, x)).hasFDerivAt.comp x (hasFDerivAt_prodMk_right t x)).differentiableAt.hasFDerivAt
  -- Step 4: `C^n` for every `n`, by induction over all value spaces at once.
  have hind : ∀ n : ℕ, ∀ (V : Type) [NormedAddCommGroup V] [NormedSpace ℝ V] (h : ℝ × Euclid N → V),
      ContDiff ℝ (⊤ : ℕ∞) h → ContDiff ℝ n (fun x : Euclid N => ∫ t in (0 : ℝ)..1, h (t, x)) := by
    intro n
    induction n with
    | zero =>
      intro V _ _ h hh
      rw [Nat.cast_zero, contDiff_zero]
      exact continuous_iff_continuousAt.2 fun x => (hderiv V h hh x).continuousAt
    | succ n ih =>
      intro V _ _ h hh
      rw [Nat.cast_add_one, contDiff_succ_iff_hasFDerivAt]
      exact ⟨fun x => ∫ t in (0 : ℝ)..1, fderiv ℝ (fun x' : Euclid N => h (t, x')) x,
        ih (Euclid N →L[ℝ] V) _ (hsmooth V h hh), hderiv V h hh⟩
  -- Step 5.
  intro V _ _ _ h hh
  exact ⟨contDiff_infty.2 fun n => hind n V h hh, hderiv V h hh⟩

/-- The exterior derivative commutes with parametric integrals over `[0, 1]`, used for the radial
homotopy formula `β = d(Kβ) + K(dβ)` (Simon 6.2.25–2.26).  If `h : ℝ × ℝᴺ → Λᵏ(ℝᴺ)` is `C^∞`, then
`d(y ↦ ∫₀¹ h(t, y) dt)(x) = ∫₀¹ d(y ↦ h(t, y))(x) dt`.  By `param_integral` the derivative of
`y ↦ ∫₀¹ h(t, y) dt` at `x` is `∫₀¹ D[y ↦ h(t, y)](x) dt`; its integrand `Dh(t, x) ∘L inr` is
continuous in `t`, and `d = alternatizeUncurryFin ∘ D` with `alternatizeUncurryFin` continuous
linear, so it commutes with the interval integral. -/
theorem Submission.dimred_cs_sos_cfs_rh_extDeriv_param_integral : ∀ (N k : ℕ) (h : ℝ × Euclid N → Covector (Euclid N) k), ContDiff ℝ (⊤ : ℕ∞) h → ∀ x : Euclid N, exteriorDerivative (fun y : Euclid N => ∫ t in (0 : ℝ)..1, h (t, y)) x = ∫ t in (0 : ℝ)..1, exteriorDerivative (fun y : Euclid N => h (t, y)) x := by
  intro N k h hh x
  -- Step 1: `DF(x) = ∫₀¹ D[y ↦ h (t, y)](x) dt` for `F y = ∫₀¹ h (t, y) dt`.
  have hpi := (Submission.cmcdt_lpo_slice_param_integral N (Covector (Euclid N) k) h hh).2 x
  have hdiff : Differentiable ℝ h := hh.differentiable (by simp)
  -- Step 2: `D[y ↦ h (t, y)](x) = Dh (t, x) ∘L inr`, by the chain rule.
  have hpart : ∀ t : ℝ, fderiv ℝ (fun y : Euclid N => h (t, y)) x =
      (fderiv ℝ h (t, x)).comp (ContinuousLinearMap.inr ℝ ℝ (Euclid N)) := fun t =>
    ((hdiff (t, x)).hasFDerivAt.comp x (hasFDerivAt_prodMk_right t x)).fderiv
  -- Step 3: the partial derivative is continuous in `t`, hence interval integrable on `[0, 1]`.
  have hcont : Continuous fun t : ℝ => fderiv ℝ (fun y : Euclid N => h (t, y)) x := by
    simp_rw [hpart]
    exact ((hh.continuous_fderiv (by simp)).comp (continuous_id.prodMk continuous_const)).clm_comp
      continuous_const
  have hint := Continuous.intervalIntegrable (μ := volume)
    (E := Euclid N →L[ℝ] Covector (Euclid N) k) hcont 0 1
  -- Step 4: the continuous linear map `alternatizeUncurryFin` commutes with the integral.
  have hcomm := ContinuousLinearMap.intervalIntegral_comp_comm (𝕜 := ℝ)
    (E := Euclid N →L[ℝ] Covector (Euclid N) k) (F := Covector (Euclid N) (k + 1))
    (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Euclid N) ℝ (n := k)) hint
  -- Step 5: `dF(x) = alt (DF(x)) = alt (∫₀¹ Dhₜ(x) dt) = ∫₀¹ alt (Dhₜ(x)) dt = ∫₀¹ dhₜ(x) dt`.
  show ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ _ x) =
    ∫ t in (0 : ℝ)..1, ContinuousAlternatingMap.alternatizeUncurryFin
      (fderiv ℝ (fun y : Euclid N => h (t, y)) x)
  rw [hpi.fderiv]
  simpa using hcomm.symm
/-- **Radial Cartan identity**, the integrand of the radial homotopy formula for forms (the
homotopy `h(t, x) = t x` of Simon Ch. 6, 2.26).  For a `(q+1)`-form `β` differentiable at `t • x`,
`d(y ↦ t^q ι_y β(t y))(x) + t^(q+1) ι_x dβ(t x) = (q + 1) t^q β(t x) + t^(q+1) Dβ(t x)[x]`.  This
is Cartan's formula `Submission.dtc_cone_euler_cartan` for `β_t = β (t • ·)` at `x`, rewritten
with `Dβ_t(x) = t • Dβ(t x)` (`fderiv_comp_smul`) and multiplied by the constant `t^q`. -/
theorem Submission.dimred_cs_sos_cfs_rh_radial_cartan : ∀ (P q : ℕ) (β : DifferentialForm (Euclid P) (q + 1)) (t : ℝ) (x : Euclid P), DifferentiableAt ℝ β (t • x) → exteriorDerivative (fun y : Euclid P => t ^ q • (β (t • y)).curryLeft y) x + t ^ (q + 1) • (exteriorDerivative β (t • x)).curryLeft x = (((q : ℝ) + 1) * t ^ q) • β (t • x) + t ^ (q + 1) • fderiv ℝ β (t • x) x := by
  intro P q β t x hβ
  -- Cartan's formula for `β_t = β (t • ·)`, which is differentiable at `x`
  have hβt : DifferentiableAt ℝ (fun y : Euclid P => β (t • y)) x :=
    hβ.comp x (differentiableAt_id.const_smul t)
  have hC := Submission.dtc_cone_euler_cartan P q (fun y => β (t • y)) x hβt
  -- dilation chain rule `Dβ_t(x) = t • Dβ(t x)`, hence `dβ_t(x) = t • dβ(t x)`
  have hD : fderiv ℝ (fun y : Euclid P => β (t • y)) x = t • fderiv ℝ β (t • x) :=
    fderiv_comp_smul t
  have hd : exteriorDerivative (fun y : Euclid P => β (t • y)) x =
      t • exteriorDerivative β (t • x) := by
    show ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ (fun y : Euclid P => β (t • y)) x) =
      t • ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ β (t • x))
    rw [hD, ContinuousAlternatingMap.alternatizeUncurryFin_smul]
  -- `d` commutes with the constant factor `t ^ q`
  have hs : exteriorDerivative (fun y : Euclid P => t ^ q • (β (t • y)).curryLeft y) x =
      t ^ q • exteriorDerivative (fun y : Euclid P => (β (t • y)).curryLeft y) x :=
    extDeriv_fun_smul (t ^ q) (fun y : Euclid P => (β (t • y)).curryLeft y)
  rw [hd, hD, ContinuousAlternatingMap.curryLeft_smul, smul_apply, smul_apply] at hC
  rw [hs, eq_sub_of_add_eq hC]
  module

/-- **Radial homotopy formula** (Poincaré lemma for the radial contraction; Simon Ch. 6,
2.25–2.26).  For a `C^∞` `(q + 1)`-form `β` on `ℝᴾ`, `Kβ(x) = ∫₀¹ tᵠ ι_x β(t x) dt` is `C^∞` and
`d(Kβ)(x) + ∫₀¹ t^{q+1} ι_x (dβ)(t x) dt = β(x)`, where `ι_x α = α.curryLeft x`.  The integrand
`h(t, x) = tᵠ ι_x β(t x)` is jointly `C^∞`, so `Kβ` is `C^∞` and `d(Kβ)(x) = ∫₀¹ d(h(t, ·))(x) dt`.
By the radial Cartan identity, `d(h(t, ·))(x) = G(t) - F(t)` with `F(t) = t^{q+1} ι_x (dβ)(t x)`
and `G(t) = (q + 1) tᵠ β(t x) + t^{q+1} Dβ(t x)[x]`, the derivative of `t ↦ t^{q+1} β(t x)`; the
fundamental theorem of calculus gives `∫₀¹ G = β(x)`. -/
theorem Submission.dimred_cs_sos_cfs_radial_homotopy : ∀ (P q : ℕ) (β : DifferentialForm (Euclid P) (q + 1)), ContDiff ℝ (⊤ : ℕ∞) β → ContDiff ℝ (⊤ : ℕ∞) (fun x : Euclid P => ∫ t in (0 : ℝ)..1, t ^ q • (β (t • x)).curryLeft x) ∧ ∀ x : Euclid P, exteriorDerivative (fun y : Euclid P => ∫ t in (0 : ℝ)..1, t ^ q • (β (t • y)).curryLeft y) x + (∫ t in (0 : ℝ)..1, t ^ (q + 1) • (exteriorDerivative β (t • x)).curryLeft x) = β x := by
  intro P q β hβ
  -- Step 1: the integrand `h(t, x) = tᵠ ι_x β(t x)` is jointly `C^∞`
  have hh : ContDiff ℝ (⊤ : ℕ∞)
      (fun p : ℝ × Euclid P => p.1 ^ q • (β (p.1 • p.2)).curryLeft p.2) :=
    (contDiff_fst.pow q).smul
      (((ContinuousAlternatingMap.curryLeftLI (𝕜 := ℝ) (E := Euclid P) (F := ℝ)
        (n := q)).contDiff.comp (hβ.comp (contDiff_fst.smul contDiff_snd))).clm_apply
        contDiff_snd)
  -- Step 2: conclusion (1), by the parametric-integral lemma
  refine ⟨(Submission.cmcdt_lpo_slice_param_integral P (Covector (Euclid P) q) _ hh).1,
    fun x => ?_⟩
  have hdiff : Differentiable ℝ β := hβ.differentiable (by simp)
  have hDβ : Continuous (fderiv ℝ β) := hβ.continuous_fderiv (by simp)
  have hsx : Continuous fun t : ℝ => t • x := continuous_id.smul continuous_const
  -- Step 3: `d(Kβ)(x) = ∫₀¹ d(h(t, ·))(x) dt`
  have hA : exteriorDerivative
      (fun y : Euclid P => ∫ t in (0 : ℝ)..1, t ^ q • (β (t • y)).curryLeft y) x =
      ∫ t in (0 : ℝ)..1, exteriorDerivative
        (fun y : Euclid P => t ^ q • (β (t • y)).curryLeft y) x :=
    Submission.dimred_cs_sos_cfs_rh_extDeriv_param_integral P q _ hh x
  -- Step 4: the radial Cartan identity `d(h(t, ·))(x) = G(t) - F(t)`; `G` and `F` are continuous
  let G : ℝ → Covector (Euclid P) (q + 1) := fun t =>
    (((q : ℝ) + 1) * t ^ q) • β (t • x) + t ^ (q + 1) • fderiv ℝ β (t • x) x
  let F : ℝ → Covector (Euclid P) (q + 1) := fun t =>
    t ^ (q + 1) • (exteriorDerivative β (t • x)).curryLeft x
  have hB : ∀ t : ℝ, exteriorDerivative
      (fun y : Euclid P => t ^ q • (β (t • y)).curryLeft y) x = G t - F t := fun t =>
    eq_sub_of_add_eq (Submission.dimred_cs_sos_cfs_rh_radial_cartan P q β t x (hdiff _))
  have hG : Continuous G :=
    ((continuous_const.mul (continuous_pow q)).smul (hβ.continuous.comp hsx)).add
      ((continuous_pow (q + 1)).smul ((hDβ.comp hsx).clm_apply continuous_const))
  have hdβ : Continuous (exteriorDerivative β) :=
    (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Euclid P) ℝ).continuous.comp hDβ
  have hF : Continuous F :=
    (continuous_pow (q + 1)).smul
      (((ContinuousAlternatingMap.curryLeftLI (𝕜 := ℝ) (E := Euclid P) (F := ℝ)
        (n := q + 1)).continuous.comp (hdβ.comp hsx)).clm_apply continuous_const)
  -- `G(t)` is the derivative of `t ↦ t^{q+1} β(t x)`
  have hderiv : ∀ t : ℝ, HasDerivAt (fun s : ℝ => s ^ (q + 1) • β (s • x)) (G t) t := by
    intro t
    have h1 : HasDerivAt (fun s : ℝ => β (s • x)) (fderiv ℝ β (t • x) x) t := by
      have h := (hdiff (t • x)).hasFDerivAt.comp_hasDerivAt t ((hasDerivAt_id' t).smul_const x)
      rw [one_smul] at h
      exact h
    convert (hasDerivAt_pow (q + 1) t).fun_smul h1 using 1
    simp only [G, Nat.add_sub_cancel]
    push_cast
    exact add_comm _ _
  -- Step 5: integrate over `[0, 1]`
  have hint : (∫ t in (0 : ℝ)..1, exteriorDerivative
      (fun y : Euclid P => t ^ q • (β (t • y)).curryLeft y) x) =
      (∫ t in (0 : ℝ)..1, G t) - ∫ t in (0 : ℝ)..1, F t := by
    rw [intervalIntegral.integral_congr fun t _ => hB t]
    exact intervalIntegral.integral_sub (hG.intervalIntegrable 0 1) (hF.intervalIntegrable 0 1)
  have hftc : (∫ t in (0 : ℝ)..1, G t) = β x := by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hderiv t)
      (hG.intervalIntegrable 0 1)]
    simp
  rw [hA, hint, hftc]
  exact sub_add_cancel _ _

/-- **The cone `0 ⨯ X` over a compactly supported cycle** (Simon 6.2.30–2.32).  Let
`X ∈ 𝒟_{q+1}(ℝᴾ)` be represented by `R = (M, θ, ξ)` with `M ⊆ spt X` and `μ_R(ℝᴾ) < ∞`, `∂X = 0`
and `spt X` compact.  With `Kω(x) = ∫₀¹ t^{q+1} ι_x ω(tx) dt`, take `Φω` equal to `Kω` on a ball
`B_ρ(0) ⊇ spt X` with `‖Φω‖ ≤ (ρ + 1) sup ‖ω‖`, and put `Y(ω) = X(Φω)`.  The bound
`|X(γ)| ≤ μ_R(ℝᴾ) sup ‖γ‖` makes `Y` a current.  On `B_ρ(0)`, `K(dγ) = γ − dψ` for a test form
`ψ`, so `∂Y(γ) = X(γ) − ∂X(ψ) = X(γ)`.  If `spt ω` misses the compact cone
`C₀ = {s x : s ∈ [0, 1], x ∈ spt X}`, then `Kω = 0` on `spt X`, so `Y(ω) = 0`; hence `spt Y ⊆ C₀`
is compact. -/
theorem Submission.dimred_cs_sos_cfs_cone_current : ∀ (P q : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (q + 1)) (R : IMRep (univ : Set (Euclid P)) (q + 1)), R.Represents X → R.carrier ⊆ X.support → R.measure univ ≠ ∞ → X.boundary = 0 → IsCompact X.support → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (q + 1 + 1), Y.boundary = X ∧ IsCompact Y.support ∧ Y.support ⊆ {y : Euclid P | ∃ s ∈ Icc (0 : ℝ) 1, ∃ x ∈ X.support, y = s • x} ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1), ∃ η : TestFormOn (univ : Set (Euclid P)) (q + 1), (∀ x ∈ X.support, (η : DifferentialForm (Euclid P) (q + 1)) x = ∫ t in (0 : ℝ)..1, t ^ (q + 1) • ((ω : DifferentialForm (Euclid P) (q + 1 + 1)) (t • x)).curryLeft x) ∧ Y ω = X η := by
  intro P q X R hRep hMX hmass hbd hcpt
  -- Step 0: `X` kills forms vanishing on `M`, and `|X(γ)| ≤ μ_R(ℝᴾ) b` when `‖γ‖ ≤ b`
  obtain ⟨hvan, hbound⟩ :=
    Submission.dimred_cs_sos_cfs_cc_imrep_vanish_bound P (q + 1) univ X R hRep
  -- Step 1: `spt X ⊆ B_ρ(0)` with `ρ > 0`
  obtain ⟨ρ, hρ, hXρ⟩ := hcpt.isBounded.subset_ball_lt 0 0
  have hnorm : ∀ x ∈ X.support, ‖x‖ < ρ := fun x hx => mem_ball_zero_iff.mp (hXρ hx)
  -- Step 2: the cut-off cone operator `Φ`; `Kω` is smooth by the radial homotopy formula
  obtain ⟨Φ, hΦK, hΦb⟩ := Submission.dimred_cs_sos_cfs_cc_cutoff_cone_operator P q ρ hρ
    fun β hβ => (Submission.dimred_cs_sos_cfs_radial_homotopy P (q + 1) β hβ).1
  -- Step 3: `Y = X ∘ Φ` is a current, since `|X(Φω)| ≤ μ_R(ℝᴾ) (ρ + 1) M` when `‖ω‖ ≤ M`
  obtain ⟨Y, hY⟩ := Submission.cmcs_rc_order_zero_current P (q + 1 + 1) univ (X.toCurrent ∘ₗ Φ)
    fun _ _ _ => ⟨(R.measure univ).toReal * (ρ + 1), fun ω M _ hM =>
      calc |(X.toCurrent ∘ₗ Φ) ω| = |X (Φ ω)| := rfl
        _ ≤ (R.measure univ).toReal * ((ρ + 1) * M) := hbound hmass (Φ ω) _ (hΦb ω M hM)
        _ = (R.measure univ).toReal * (ρ + 1) * M := (mul_assoc _ _ _).symm⟩
  -- Step 5: `∂Y = X`
  have hbdY : Y.boundary = X := by
    ext γ
    -- `ψ ∈ 𝒟^q` with `K(dγ) = γ − dψ` on `B_ρ(0)`, by the homotopy formula in degree `q`
    obtain ⟨ψ, hψ⟩ := Submission.dimred_cs_sos_cfs_cc_cutoff_homotopy P q ρ
      (Submission.dimred_cs_sos_cfs_radial_homotopy P q) γ
    have hdγ : (exteriorDerivativeTestOn (univ : Set (Euclid P)) (q + 1) γ :
        DifferentialForm (Euclid P) (q + 1 + 1)) =
        exteriorDerivative (γ : DifferentialForm (Euclid P) (q + 1)) := rfl
    have hdψ : (exteriorDerivativeTestOn (univ : Set (Euclid P)) q ψ :
        DifferentialForm (Euclid P) (q + 1)) =
        exteriorDerivative (ψ : DifferentialForm (Euclid P) q) := rfl
    -- `Φ(dγ) − γ + dψ` vanishes on `M ⊆ spt X ⊆ B_ρ(0)`, so `X` kills it
    have h0 : X (Φ (exteriorDerivativeTestOn univ (q + 1) γ) - γ +
        exteriorDerivativeTestOn univ q ψ) = 0 := by
      refine hvan _ fun x hx => ?_
      have hx' := hnorm x (hMX hx)
      simp only [Submodule.coe_add, Submodule.coe_sub, Pi.add_apply, Pi.sub_apply]
      rw [hΦK _ x hx', hdγ, hψ x hx', hdψ]
      abel
    -- `X(dψ) = ∂X(ψ) = 0`
    have hXdψ : X (exteriorDerivativeTestOn univ q ψ) = 0 := by
      rw [← GeometricCurrentOn.boundary_apply, hbd, GeometricCurrentOn.zero_apply]
    rw [map_add X.toCurrent, map_sub X.toCurrent] at h0
    rw [GeometricCurrentOn.boundary_apply, hY]
    change X (Φ (exteriorDerivativeTestOn univ (q + 1) γ)) = X γ
    linarith
  -- Step 6: the cone `C₀ = {s x : s ∈ [0, 1], x ∈ spt X}` is compact
  have hC₀ : IsCompact {y : Euclid P | ∃ s ∈ Icc (0 : ℝ) 1, ∃ x ∈ X.support, y = s • x} := by
    have himg : {y : Euclid P | ∃ s ∈ Icc (0 : ℝ) 1, ∃ x ∈ X.support, y = s • x} =
        (fun p : ℝ × Euclid P => p.1 • p.2) '' (Icc (0 : ℝ) 1 ×ˢ X.support) := by
      ext y
      constructor
      · rintro ⟨s, hs, x, hx, rfl⟩
        exact ⟨(s, x), ⟨hs, hx⟩, rfl⟩
      · rintro ⟨⟨s, x⟩, ⟨hs, hx⟩, rfl⟩
        exact ⟨s, hs, x, hx, rfl⟩
    rw [himg]
    exact (isCompact_Icc.prod hcpt).image (continuous_fst.smul continuous_snd)
  -- Step 6a: if `spt ω ∩ C₀ = ∅`, then `Kω = 0` on `M ⊆ spt X`, so `Y(ω) = X(Φω) = 0`
  have hYvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (q + 1 + 1)))
        {y : Euclid P | ∃ s ∈ Icc (0 : ℝ) 1, ∃ x ∈ X.support, y = s • x} → Y ω = 0 := by
    intro ω hω
    rw [hY]
    refine hvan (Φ ω) fun x hx => ?_
    have hxX := hMX hx
    have hzero : EqOn (fun t : ℝ => t ^ (q + 1) •
        ((ω : DifferentialForm (Euclid P) (q + 1 + 1)) (t • x)).curryLeft x) 0 (uIcc 0 1) := by
      intro t ht
      rw [uIcc_of_le zero_le_one] at ht
      have hnot : t • x ∉ tsupport (ω : DifferentialForm (Euclid P) (q + 1 + 1)) :=
        Set.disjoint_right.mp hω ⟨t, ht, x, hxX, rfl⟩
      simp [image_eq_zero_of_notMem_tsupport hnot]
    rw [hΦK ω x (hnorm x hxX), intervalIntegral.integral_congr hzero]
    simp
  -- Step 6b: `spt Y ⊆ C₀` and `spt Y` is compact
  -- Steps 4 and 7: `η = Φω` equals `Kω` on `spt X ⊆ B_ρ(0)` and `Y(ω) = X(η)`
  obtain ⟨hsub, hYcpt⟩ := Submission.rsd_cmr_support_subset_of_vanish P (q + 1 + 1) univ _ Y
    isOpen_univ hC₀ (subset_univ _) hYvan
  exact ⟨Y, hbdY, hYcpt, hsub, fun ω => ⟨Φ ω, fun x hx => hΦK ω x (hnorm x hx), hY ω⟩⟩
/-- **Truncated cone map** (Simon Ch. 6, 2.30: the cone `0 ⨯ T = h_#([[(0,1)]] × T)`,
`h(t, x) = tx`).  Put `ρ' = max ρ 1`, let `r(y) = φ(y) y` with `φ` a smooth bump that is `1` on
`B̄_{ρ'}(0)` and vanishes off `B_{ρ'+1}(0)`, and let `σ(s) = max 0 (min s 1)`.  Then
`H(z) = σ(z₀) r(G(tail z))` is Lipschitz, as a product of bounded Lipschitz factors (`|σ| ≤ 1`,
`‖r‖ ≤ ρ' + 1`).  On the open set `{z₀ ∈ (0,1), ‖G(tail z)‖ < ρ'}`, `H(z) = z₀ G(tail z)`, so
there `DH(z)v = z₀ DG(tail z)(tail v) + v₀ G(tail z)`, which on `ê₀` and `ê_{a+1}` gives the
`Fin.cons` tuple. -/
theorem Submission.dimred_cs_sos_cfs_cp_cone_map : ∀ (P n : ℕ) (G : Euclid n → Euclid P) (L : NNReal) (ρ : ℝ), LipschitzWith L G → ∃ H : Euclid (n + 1) → Euclid P, (∃ K : NNReal, LipschitzWith K H) ∧ ∀ z : Euclid (n + 1), WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 → ‖G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))‖ < ρ → H z = WithLp.ofLp z 0 • G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) ∧ (DifferentiableAt ℝ G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) → (fun b => fderiv ℝ H z (EuclideanSpace.single b 1)) = Fin.cons (G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))) (fun a => WithLp.ofLp z 0 • fderiv ℝ G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) (EuclideanSpace.single a 1))) := by
  intro P n G L ρ hG
  -- step 1: a Lipschitz, bounded `r` with `r = id` on `closedBall 0 ρ'`, `ρ' := max ρ 1`
  set ρ' : ℝ := max ρ 1 with hρ'
  have hρ'pos : 0 < ρ' := lt_of_lt_of_le one_pos (le_max_right _ _)
  obtain ⟨r, ⟨Kr, hKr⟩, hr_bound, hr_id⟩ : ∃ r : Euclid P → Euclid P, (∃ K : NNReal, LipschitzWith K r) ∧
      (∀ y, ‖r y‖ ≤ ρ' + 1) ∧ (∀ y : Euclid P, ‖y‖ ≤ ρ' → r y = y) := by
    let φ : ContDiffBump (0 : Euclid P) := ⟨ρ', ρ' + 1, hρ'pos, by linarith⟩
    refine ⟨fun y => φ y • y, ?_, ?_, ?_⟩
    · have hr_smooth : ContDiff ℝ 1 (fun y : Euclid P => φ y • y) := φ.contDiff.smul contDiff_id
      have hr_supp : HasCompactSupport (fun y : Euclid P => φ y • y) := φ.hasCompactSupport.smul_right
      exact ContDiff.lipschitzWith_of_hasCompactSupport hr_supp hr_smooth (by simp)
    · intro y
      by_cases hy : ‖y‖ < ρ' + 1
      · calc ‖φ y • y‖ = |φ y| * ‖y‖ := by rw [norm_smul, Real.norm_eq_abs]
          _ ≤ 1 * (ρ' + 1) := by
            gcongr
            · rw [abs_of_nonneg φ.nonneg]; exact φ.le_one
          _ = ρ' + 1 := one_mul _
      · have h0 : φ y = 0 := φ.zero_of_le_dist (by simpa [dist_zero_right] using not_lt.mp hy)
        simp [h0]; linarith
    · intro y hy
      have : φ y = 1 := φ.one_of_mem_closedBall (by simpa [mem_closedBall, dist_zero_right] using hy)
      simp [this]
  -- the clamp `σ(s) = max(0, min(s, 1))`
  obtain ⟨σ, hσ, hσb, hσid⟩ : ∃ σ : ℝ → ℝ, LipschitzWith 1 σ ∧ (∀ s, |σ s| ≤ 1) ∧
      ∀ s ∈ Ioo (0 : ℝ) 1, σ s = s := by
    refine ⟨fun s => max 0 (min s 1), (LipschitzWith.id.min_const 1).const_max 0, ?_, ?_⟩
    · intro s
      rw [abs_le]; constructor
      · have : (0 : ℝ) ≤ max 0 (min s 1) := le_max_left _ _
        linarith
      · exact max_le (by norm_num) (min_le_right _ _)
    · intro s hs
      simp only [min_eq_left hs.2.le, max_eq_right hs.1.le]
  -- coordinate maps `π₀ z = z₀`, `π' z = tail z`
  let π0 : Euclid (n + 1) →L[ℝ] ℝ := EuclideanSpace.proj 0
  have hπ0 : ∀ z, π0 z = WithLp.ofLp z 0 := fun z => rfl
  let πtl : Euclid (n + 1) →ₗ[ℝ] Euclid n :=
    { toFun := fun z => WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))
      map_add' := fun x y => rfl
      map_smul' := fun c x => rfl }
  let πt : Euclid (n + 1) →L[ℝ] Euclid n := LinearMap.toContinuousLinearMap πtl
  have hπt : ∀ z, πt z = WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) := fun z => rfl
  -- step 2: the map `H(z) = σ(z₀) • r(G(tail z))`
  refine ⟨fun z => σ (WithLp.ofLp z 0) • r (G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))), ?_, ?_⟩
  · -- step 3(a): `H` is Lipschitz
    have h1 : LipschitzWith (1 * ‖π0‖₊) (fun z : Euclid (n + 1) => σ (WithLp.ofLp z 0)) :=
      hσ.comp π0.lipschitzWith
    have h2 : LipschitzWith (Kr * (L * ‖πt‖₊))
        (fun z : Euclid (n + 1) => r (G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))))) :=
      hKr.comp (hG.comp πt.lipschitzWith)
    refine ⟨_, LipschitzWith.of_dist_le' (K := (ρ' + 1) * ((1 * ‖π0‖₊ : NNReal) : ℝ) +
      ((Kr * (L * ‖πt‖₊) : NNReal) : ℝ)) fun z z' => ?_⟩
    have e1 := h1.dist_le_mul z z'
    have e2 := h2.dist_le_mul z z'
    simp only [dist_eq_norm] at e1 e2 ⊢
    set a := σ (WithLp.ofLp z 0)
    set a' := σ (WithLp.ofLp z' 0)
    set R := r (G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))))
    set R' := r (G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z'))))
    have ha' : ‖a'‖ ≤ 1 := (Real.norm_eq_abs _).le.trans (hσb _)
    calc ‖a • R - a' • R'‖ = ‖(a - a') • R + a' • (R - R')‖ := by
          congr 1; rw [sub_smul, smul_sub]; abel
      _ ≤ ‖a - a'‖ * ‖R‖ + ‖a'‖ * ‖R - R'‖ := by
          refine (norm_add_le _ _).trans ?_
          rw [norm_smul (a - a') R, norm_smul a' (R - R')]
      _ ≤ (((1 * ‖π0‖₊ : NNReal) : ℝ) * ‖z - z'‖) * (ρ' + 1) +
            1 * (((Kr * (L * ‖πt‖₊) : NNReal) : ℝ) * ‖z - z'‖) := by
          gcongr
          exact hr_bound _
      _ = ((ρ' + 1) * ((1 * ‖π0‖₊ : NNReal) : ℝ) + ((Kr * (L * ‖πt‖₊) : NNReal) : ℝ)) *
            ‖z - z'‖ := by ring
  · -- step 4: value and derivative on `{z₀ ∈ (0,1), ‖G(tail z)‖ < ρ}`
    intro z hz hzρ
    let Ht : Euclid (n + 1) → Euclid P := fun z' => π0 z' • G (πt z')
    let O : Set (Euclid (n + 1)) := {z' | π0 z' ∈ Ioo (0 : ℝ) 1 ∧ ‖G (πt z')‖ < ρ'}
    have hO : IsOpen O :=
      (isOpen_Ioo.preimage π0.continuous).inter
        (isOpen_lt (continuous_norm.comp (hG.continuous.comp πt.continuous)) continuous_const)
    have hzO : z ∈ O := ⟨hz, lt_of_lt_of_le hzρ (le_max_left _ _)⟩
    have hEq : ∀ z' ∈ O, σ (WithLp.ofLp z' 0) • r (G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z')))) =
        Ht z' := by
      rintro z' ⟨h0, hρz⟩
      rw [hπ0] at h0
      rw [hπt] at hρz
      show _ = π0 z' • G (πt z')
      rw [hπ0, hπt, hσid _ h0, hr_id _ hρz.le]
    have hev : (fun z' : Euclid (n + 1) =>
        σ (WithLp.ofLp z' 0) • r (G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z'))))) =ᶠ[𝓝 z] Ht :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hzO) hEq
    refine ⟨hEq z hzO, fun hGd => ?_⟩
    have hD : HasFDerivAt Ht (π0 z • (fderiv ℝ G (πt z)).comp πt + π0.smulRight (G (πt z))) z :=
      π0.hasFDerivAt.smul (hGd.hasFDerivAt.comp z πt.hasFDerivAt)
    rw [hev.fderiv_eq, hD.fderiv]
    have hs0 : π0 (EuclideanSpace.single 0 1) = 1 := by simp [π0]
    have hss : ∀ a : Fin n, π0 (EuclideanSpace.single a.succ 1) = 0 := by
      intro a; simp [π0, Fin.succ_ne_zero]
    have ht0 : πt (EuclideanSpace.single 0 1) = 0 := by
      rw [hπt]; ext j; simp [Fin.tail, Fin.succ_ne_zero]
    have hts : ∀ a : Fin n, πt (EuclideanSpace.single a.succ 1) = EuclideanSpace.single a 1 := by
      intro a; rw [hπt]; ext j; simp [Fin.tail]
    funext b
    refine Fin.cases ?_ (fun a => ?_) b
    · simp [hs0, ht0]
      rfl
    · simp [hss, hts]
      rfl
/-- Fubini–Tonelli on the cylinder `Â = {z ∈ ℝ^{n+1} : z₀ ∈ (0, 1), tail z ∈ A}` for Borel
`A ⊆ ℝⁿ`.  The map `e(u, t) = (t, u₁, …, uₙ)`, the composite of the swap `ℝⁿ × ℝ ≃ ℝ × ℝⁿ`,
`id × ofLp`, the inverse of `piFinSuccAbove · 0` (i.e. `Fin.cons`) and `toLp`, is a
measure-preserving measurable equivalence `ℝⁿ × ℝ ≃ᵐ ℝ^{n+1}` with `e⁻¹(Â) = A × (0, 1)`.  Hence
`Â` is Borel, and change of variables along `e` followed by Tonelli (resp. Fubini) on the product
set `A × (0, 1)` gives the iterated lower Lebesgue (resp. Bochner) integrals. -/
theorem Submission.cmcdt_lpi_cyl_fubini : ∀ (n : ℕ) (A : Set (Euclid n)), MeasurableSet A → MeasurableSet {z : Euclid (n + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧ (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A} ∧ (∀ f : Euclid (n + 1) → ℝ≥0∞, Measurable f → ∫⁻ z in {z : Euclid (n + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧ (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A}, f z = ∫⁻ u in A, ∫⁻ t in Ioo (0 : ℝ) 1, f (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u)))) ∧ ∀ f : Euclid (n + 1) → ℝ, IntegrableOn f {z : Euclid (n + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧ (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A} → ∫ z in {z : Euclid (n + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧ (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A}, f z = ∫ u in A, ∫ t in Ioo (0 : ℝ) 1, f (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u))) := by
  intro n A hA
  set Ah := {z : Euclid (n + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧
    (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A} with hAh_def
  -- the measurable equivalence `e : ℝⁿ × ℝ ≃ᵐ ℝ^{n+1}`, `(u, t) ↦ (t, u)`
  let e : (Euclid n × ℝ) ≃ᵐ Euclid (n + 1) :=
    (MeasurableEquiv.prodComm.trans
      ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.toLp 2 (Fin n → ℝ)).symm).trans
        (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm)).trans
      (MeasurableEquiv.toLp 2 (Fin (n + 1) → ℝ))
  have he : ∀ p : Euclid n × ℝ, e p = WithLp.toLp 2 (Fin.cons p.2 (WithLp.ofLp p.1)) := by
    rintro ⟨u, t⟩
    simp [e, MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv, Fin.insertNth_zero']
    exact ⟨rfl, rfl⟩
  -- each factor of `e` preserves Lebesgue measure
  have hmp : MeasurePreserving e volume volume := by
    have h1 : MeasurePreserving
        (MeasurableEquiv.prodComm : (Euclid n × ℝ) ≃ᵐ (ℝ × Euclid n)) volume volume :=
      Measure.measurePreserving_swap
    have h2 : MeasurePreserving (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.toLp 2 (Fin n → ℝ)).symm) volume volume :=
      (MeasurePreserving.id volume).prod
        (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin n))
    have h3 : MeasurePreserving
        (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm volume volume :=
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm _
    have h4 : MeasurePreserving (MeasurableEquiv.toLp 2 (Fin (n + 1) → ℝ)) volume volume := by
      have := (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin (n + 1))).symm _
      simpa using this
    exact h4.comp (h3.comp (h2.comp h1))
  -- `e⁻¹(Â) = A × (0, 1)`
  have hpre : e ⁻¹' Ah = A ×ˢ Ioo (0 : ℝ) 1 := by
    ext ⟨u, t⟩
    simp [Ah, he, and_comm]
  have hAhm : MeasurableSet Ah := by
    have : Ah = e.symm ⁻¹' (A ×ˢ Ioo (0 : ℝ) 1) := by
      rw [← hpre]; ext z; simp
    rw [this]
    exact e.symm.measurable (hA.prod measurableSet_Ioo)
  refine ⟨hAhm, ?_, ?_⟩
  · intro f hf
    rw [← hmp.setLIntegral_comp_preimage_emb e.measurableEmbedding f Ah, hpre]
    rw [Measure.volume_eq_prod, setLIntegral_prod]
    · simp only [he]
    · exact (hf.comp e.measurable).aemeasurable
  · intro f hf
    rw [← hmp.setIntegral_preimage_emb e.measurableEmbedding f Ah, hpre]
    rw [Measure.volume_eq_prod, setIntegral_prod]
    · simp only [he]
    · rw [← Measure.volume_eq_prod, ← hpre]
      exact (hmp.integrableOn_comp_preimage e.measurableEmbedding).2 hf
/-- **Simon 7.3.1, footnote 2** (`q_#T = T` for the orthogonal projection `q` onto `V`): if the
weight `μ_R = θ Hᵐ⌞M` of the triple `R = (M, θ, ξ)` gives no mass to `ℝᴾ \ V`, then
`τ(M, θ, ξ)(q^#ω) = τ(M, θ, ξ)(ω)` for every `m`-form `ω`.  As `Hᵐ⌞M ≪ μ_R`, `Hᵐ(M \ V) = 0`; so
`Hᵐ`-a.e. `x ∈ M` lies in `V` and has an approximate tangent plane `Q` oriented by `ξ(x)`.  `V` is
flat at `x ∈ V` along `V`, so `Q ≤ V`; then `qx = x`, `q` fixes `Q` pointwise, and
`⟨(q^#ω)(x), ξ(x)⟩ = ⟨ω(x) ∘ Λᵐq, ξ(x)⟩ = ⟨ω(x), ξ(x)⟩`. -/
theorem Submission.dimred_cs_sp_action_starProjection_eq : ∀ (P m : ℕ) (R : IMRep (univ : Set (Euclid P)) m) (V : Submodule ℝ (Euclid P)), R.measure ((V : Set (Euclid P))ᶜ) = 0 → ∀ ω : DifferentialForm (Euclid P) m, R.action (affinePullbackForm V.starProjection 0 ω) = R.action ω := by
  intro P m R V hV ω
  -- `Hᵐ⌞M ≪ μ_R`, so `Hᵐ⌞M` gives no mass to `Vᶜ`
  have hV' : (μHE[m].restrict R.carrier) ((V : Set (Euclid P))ᶜ) = 0 :=
    (Submission.cbr_imRep_measure_basic P m univ R).2.1 hV
  -- hence `Hᵐ(M \ V) = 0`, and `Hᵐ⌞M`-a.e. `x` lies in `V`
  have hnull : μHE[m] (R.carrier \ (V : Set (Euclid P))) = 0 := by
    rwa [Measure.restrict_apply' R.measurableSet_carrier, ← Set.sdiff_eq_compl_inter] at hV'
  have hVae : ∀ᵐ x ∂(μHE[m].restrict R.carrier), x ∈ (V : Set (Euclid P)) := by
    rw [ae_iff]
    exact hV'
  -- the integrands agree `Hᵐ⌞M`-a.e.
  unfold IMRep.action
  refine integral_congr_ae ?_
  filter_upwards [hVae, R.orients] with x hxV hx
  obtain ⟨Q, hQ, hξ⟩ := hx
  -- `Q ≤ V`: `V` is flat at `x ∈ V` along `V` (take `t = z - x`)
  have hQV : Q ≤ V :=
    Submission.atsm_approxTangent_le_of_flat P m (V : Set (Euclid P)) R.carrier x Q V hnull
      (fun ε hε => ⟨1, one_pos, fun z hz _ => ⟨z - x, V.sub_mem hz hxV, by
        rw [sub_self, norm_zero]
        positivity⟩⟩) hQ
  -- `q` fixes `Q` pointwise and fixes `x`
  have hfix : ∀ v ∈ Q, V.starProjection v = v := fun v hv =>
    Submodule.starProjection_eq_self_iff.2 (hQV hv)
  have hxq : V.starProjection x = x := Submodule.starProjection_eq_self_iff.2 hxV
  -- `(q^#ω)(x) = ω(x) ∘ Λᵐq`, and `Λᵐq` fixes the unit orientation `ξ(x)` of `Q`
  have key := Submission.dtc_bc_lc_unitOrientation_comp_eq P m (R.orient x) Q V.starProjection
    hξ hfix (ω x)
  simp only [affinePullbackForm, zero_add, hxq]
  rw [key]

/-- **Simon 7.3.1, footnote 2** (`spt C ⊆ TₓN`): if the weight `θ Hᵐ⌞M` of the triple
`R = (M, θ, ξ)` gives no mass to `ℝᴾ \ V`, the orthogonal projection `q` onto `V` fixes
`τ(M, θ, ξ)`: `τ(M, θ, ξ)(q^#ω) = τ(M, θ, ξ)(ω)`.  As `θ ≥ 1` on `M`, `Hᵐ(M \ V) = 0`; so for
`Hᵐ`-a.e. `x ∈ M`, `x ∈ V` and the approximate tangent plane oriented by `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₘ`
lies in `V` (along which `V` is flat at `x`).  Then `qx = x`, `qτᵢ = τᵢ` and
`⟨(q^#ω)(x), ξ(x)⟩ = ⟨ω(x), ξ(x)⟩`. -/
theorem Submission.idtp_fons_cs_sp_action_starProjection_eq : ∀ (P m : ℕ) (R : IMRep (univ : Set (Euclid P)) m) (V : Submodule ℝ (Euclid P)), R.measure ((V : Set (Euclid P))ᶜ) = 0 → ∀ ω : DifferentialForm (Euclid P) m, R.action (affinePullbackForm V.starProjection 0 ω) = R.action ω := by
  intro P m R V hV ω
  -- `Hᵐ(M \ V) = 0`, since `θ ≥ 1` on `M`
  have hnull : μHE[m] (R.carrier \ (V : Set (Euclid P))) = 0 := by
    have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
    rw [IMRep.measure, withDensity_apply_eq_zero hθ,
      Measure.restrict_apply' R.measurableSet_carrier] at hV
    refine measure_mono_null ?_ hV
    intro x hx
    exact ⟨⟨Nat.cast_ne_zero.2 (R.mult_pos x hx.1).ne', hx.2⟩, hx.1⟩
  -- so `Hᵐ⌞M`-a.e. `x` lies in `V`
  have hVae : ∀ᵐ x ∂(μHE[m].restrict R.carrier), x ∈ (V : Set (Euclid P)) := by
    rw [ae_restrict_iff' R.measurableSet_carrier]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hnull] with x hx hxM
    by_contra hxV
    exact hx ⟨hxM, hxV⟩
  -- the integrands agree `Hᵐ⌞M`-a.e.
  unfold IMRep.action
  refine integral_congr_ae ?_
  filter_upwards [hVae, R.orients] with x hxV hQ
  obtain ⟨Q, hQ, τ, -, hspan, hor⟩ := hQ
  -- `TₓM = Q ≤ V`: `V` is flat at `x ∈ V` along `V` (take `t = z - x`)
  have hQV : Q ≤ V :=
    Submission.atsm_approxTangent_le_of_flat P m (V : Set (Euclid P)) R.carrier x Q V hnull
      (fun ε hε => ⟨1, one_pos, fun z hz _ => ⟨z - x, V.sub_mem hz hxV, by
        rw [sub_self, norm_zero]
        positivity⟩⟩) hQ
  have hτ : V.starProjection ∘ τ = τ := by
    funext i
    exact Submodule.starProjection_eq_self_iff.2
      (hQV (hspan ▸ Submodule.subset_span (mem_range_self i)))
  have hx : V.starProjection x = x := Submodule.starProjection_eq_self_iff.2 hxV
  congr 1
  rcases hor with hor | hor <;>
    simp only [hor, affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply,
      zero_add, hx, hτ]
/-- **Carrier, mass and support of integer multiplicity currents in `ℝᴾ`** (Simon Ch. 6, 2.11 and
Remark 3.2(3)).  (1) If `Y = τ(M, θ, ξ)` in `ℝᴾ`, then `Hⁿ(M \ spt Y) = 0`, `M(Y) = μ_R(ℝᴾ)`, and
`μ_R(ℝᴾ) < ∞` if `spt Y` is compact.  (2) `spt Y₁` is closed and `spt(Y₁ - Y₂) ⊆ spt Y₁ ∪ spt Y₂`.
`Y` kills every form supported in the open set `W = ℝᴾ \ spt Y` (`dtc_vanish_off_support`), so
`μ_R(W) = M_W(Y) = 0` (`dtc_mass_eq_measure`) and, as `θ ≥ 1` on `M`, `Hⁿ(M ∩ W) = 0`; for compact
`spt Y`, `μ_R(ℝᴾ) ≤ μ_R(spt Y) + μ_R(W) = ∫_{M ∩ spt Y} θ dHⁿ < ∞`.  A common relatively compact
neighbourhood on which `Y₁` and `Y₂` vanish lies in the zero region of `Y₁ - Y₂`. -/
theorem Submission.dtc_bc_lc_pf_imrep_carrier_mass_support : ∀ (P n : ℕ), (∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), R.Represents Y → μHE[n] (R.carrier \ Y.support) = 0 ∧ Y.mass = R.measure univ ∧ (IsCompact Y.support → R.measure univ ≠ ∞)) ∧ ∀ Y₁ Y₂ : GeometricCurrentOn (univ : Set (Euclid P)) n, IsClosed Y₁.support ∧ (Y₁ - Y₂).support ⊆ Y₁.support ∪ Y₂.support := by
  intro P n
  -- Step 1: `spt Y = ℝᴾ \ Z(Y)` is closed, the zero region `Z(Y)` being open
  have hclosed : ∀ Y : GeometricCurrentOn (univ : Set (Euclid P)) n, IsClosed Y.support := by
    intro Y
    rw [GeometricCurrentOn.support, ← compl_eq_univ_sdiff]
    exact Y.isOpen_zeroRegion.isClosed_compl
  refine ⟨fun Y R hRY => ?_, fun Y₁ Y₂ => ⟨hclosed Y₁, ?_⟩⟩
  · -- Step 2: `M_W(Y) = 0` on the open set `W = ℝᴾ \ spt Y` (`dtc_vanish_off_support`)
    have hWo : IsOpen (Y.support)ᶜ := (hclosed Y).isOpen_compl
    have hmass : Y.massOn (Y.support)ᶜ = 0 := by
      refine le_antisymm (sSup_le ?_) zero_le
      rintro r ⟨ω, hω, rfl⟩
      dsimp only
      rw [Submission.dtc_vanish_off_support P n univ Y ω
        (subset_compl_iff_disjoint_right.mp hω.1), ENNReal.ofReal_zero]
    -- Step 3: `μ_R(W) = M_W(Y) = 0` (`dtc_mass_eq_measure`); as `θ ≥ 1` on `M`, `Hⁿ(M ∩ W) = 0`
    have hμW : R.measure (Y.support)ᶜ = 0 := by
      rw [← Submission.dtc_mass_eq_measure P n univ _ Y R isOpen_univ hWo (subset_univ _) hRY]
      exact hmass
    have hnull : μHE[n] (R.carrier \ Y.support) = 0 := by
      have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
        measurable_from_nat.comp R.measurable_mult
      have h := (withDensity_apply_eq_zero' (μ := μHE[n].restrict R.carrier)
        hθ.aemeasurable).1 hμW
      rw [Measure.restrict_apply' R.measurableSet_carrier] at h
      refine measure_mono_null ?_ h
      intro x hx
      exact ⟨⟨Nat.cast_ne_zero.2 (R.mult_pos x hx.1).ne', hx.2⟩, hx.1⟩
    -- Step 4: `M(Y) = M_{ℝᴾ}(Y) = μ_R(ℝᴾ)`
    refine ⟨hnull, Submission.dtc_mass_eq_measure P n univ univ Y R isOpen_univ isOpen_univ
      subset_rfl hRY, fun hK => ?_⟩
    -- Step 5: `μ_R(ℝᴾ) ≤ μ_R(spt Y) + μ_R(W) = ∫_{M ∩ spt Y} θ dHⁿ < ∞`
    have hKm : R.measure Y.support =
        ∫⁻ x in R.carrier ∩ Y.support, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
      rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
        Measure.restrict_restrict hK.measurableSet, inter_comm]
    refine ne_top_of_le_ne_top ?_ ((measure_mono (union_compl_self Y.support).ge).trans
      ((measure_union_le _ _).trans_eq (by rw [hμW, add_zero])))
    rw [hKm]
    exact R.locallyIntegrable_mult _ hK (subset_univ _)
  · -- Step 6: `x ∉ spt Y₁ ∪ spt Y₂` lies in open `W₁`, `W₂` with compact closures on which
    -- `Y₁`, `Y₂` vanish; then `W₁ ∩ W₂` witnesses `x ∈ Z(Y₁ - Y₂)`
    intro x hx
    by_contra hxs
    rw [mem_union, not_or] at hxs
    have hZ : ∀ Y : GeometricCurrentOn (univ : Set (Euclid P)) n, x ∉ Y.support →
        x ∈ Y.zeroRegion := fun Y h => not_not.mp fun h' => h ⟨mem_univ x, h'⟩
    obtain ⟨W₁, ⟨hW₁o, hW₁c, -, hW₁v⟩, hxW₁⟩ := mem_sUnion.mp (hZ Y₁ hxs.1)
    obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hxW₂⟩ := mem_sUnion.mp (hZ Y₂ hxs.2)
    -- `closure (W₁ ∩ W₂) ⊆ closure W₁` is compact, and `(Y₁ - Y₂)(ω) = Y₁(ω) - Y₂(ω) = 0`
    refine hx.2 ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o, hW₁c.of_isClosed_subset isClosed_closure
      (closure_mono inter_subset_left), subset_univ _, fun ω hω => ?_⟩, hxW₁, hxW₂⟩
    show Y₁ ω - Y₂ ω = 0
    rw [hW₁v ω (hω.trans inter_subset_left), hW₂v ω (hω.trans inter_subset_right), sub_zero]

/-- **Simon Ch. 6, 2.27 and 2.29** (pointwise estimate behind the push-forward; step 1(a) of the
local comparison in the proof of 7.3.1): let `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` be a unit orientation of `Q`
(`τ` orthonormal, `span τ = Q`) and `L` a continuous linear map.  (a) `⟨α ∘ ΛⁿL, ξ⟩ = ±α(L ∘ τ)`,
and `|α(v)| ≤ |α|_E det(⟨vᵢ, vⱼ⟩)^{1/2}` (Cauchy–Binet and Cauchy–Schwarz,
`covectorEuclideanNorm_gram_bounds`), `det(⟨vᵢ, vⱼ⟩) ≤ ∏ᵢ |vᵢ|²` (Hadamard) and
`|Lτᵢ| ≤ ‖L‖ |τᵢ| = ‖L‖` give `|⟨α ∘ ΛⁿL, ξ⟩| ≤ |α|_E ‖L‖ⁿ`.  (b) If `L` fixes `Q` pointwise,
then `L ∘ τ = τ` since each `τᵢ ∈ Q`, so `⟨α ∘ ΛⁿL, ξ⟩ = ±α(τ) = ⟨α, ξ⟩`. -/
theorem Submission.dtc_bc_lc_pf_unitOrientation_comp : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ (α.compContinuousLinearMap L)| ≤ covectorEuclideanNorm α * ‖L‖ ^ n) ∧ ((∀ v ∈ Q, L v = v) → ∀ α : Covector (Euclid P) n, ξ (α.compContinuousLinearMap L) = ξ α) := by
  rintro P n ξ Q L ⟨τ, hτ, hspan, hsign⟩
  -- `(α ∘ ΛⁿL)(τ) = α(L ∘ τ)`
  have hcomp : ∀ α : Covector (Euclid P) n, α.compContinuousLinearMap L τ = α (⇑L ∘ τ) :=
    fun α => ContinuousAlternatingMap.compContinuousLinearMap_apply α L τ
  refine ⟨fun α => ?_, fun hL α => ?_⟩
  · -- (a) `|⟨α ∘ ΛⁿL, ξ⟩| = |α(L ∘ τ)|` for either sign
    have habs : |ξ (α.compContinuousLinearMap L)| = |α (⇑L ∘ τ)| := by
      rcases hsign with h | h
      · rw [h, hcomp]
      · rw [h, hcomp, abs_neg]
    -- `|Lτᵢ| ≤ ‖L‖ |τᵢ| = ‖L‖`
    have hLτ : ∀ i, ‖(⇑L ∘ τ) i‖ ≤ ‖L‖ := fun i => by
      simpa only [Function.comp_apply, hτ.norm_eq_one i, mul_one] using L.le_opNorm (τ i)
    have hα := covectorEuclideanNorm_nonneg α
    rw [habs]
    calc |α (⇑L ∘ τ)|
        ≤ covectorEuclideanNorm α * Real.sqrt (Matrix.det (Matrix.of fun i j =>
            inner ℝ ((⇑L ∘ τ) i) ((⇑L ∘ τ) j))) :=
          (Submission.covectorEuclideanNorm_gram_bounds P n).1 α (⇑L ∘ τ)
      _ ≤ covectorEuclideanNorm α * Real.sqrt (∏ i, ‖(⇑L ∘ τ) i‖ ^ 2) :=
          mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt
            (Submission.dtc_bc_lc_pf_gram_det_le_prod_norm_sq P n (⇑L ∘ τ))) hα
      _ = covectorEuclideanNorm α * ∏ i, ‖(⇑L ∘ τ) i‖ := by
          rw [Finset.prod_pow, Real.sqrt_sq (Finset.prod_nonneg fun i _ => norm_nonneg _)]
      _ ≤ covectorEuclideanNorm α * ‖L‖ ^ n := by
          rw [← Fin.prod_const]
          exact mul_le_mul_of_nonneg_left
            (Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) fun i _ => hLτ i) hα
  · -- (b) each `τᵢ` lies in `Q = span (range τ)`, so `L ∘ τ = τ`
    have hLτ : ⇑L ∘ τ = τ := by
      funext i
      exact hL (τ i) (hspan ▸ Submodule.subset_span (mem_range_self i))
    rcases hsign with h | h <;> rw [h, h, hcomp, hLτ]

/-- **Cut-off of the pulled-back form** (Simon Ch. 6, 2.23 and Remark 2.24(2)).  Let `O ⊆ ℝᴾ` be
open, `K ⊆ O` compact, `f : ℝᴾ → ℝ^Q` of class `C¹` on `O` and `ω` a continuous `n`-form on `ℝ^Q`.
Some continuous, compactly supported `h : ℝᴾ → Λⁿ(ℝᴾ)` equals `ω(f(x)) ∘ Df(x)` on `K`.

Proof sketch:
* `f` and `Df` are continuous on `O`, and `(β, A) ↦ β ∘ A` is continuous (it has a strict
  derivative everywhere), so `γ(x) = ω(f(x)) ∘ Df(x)` is continuous on `O`.
* Take `ρ > 0` with `cthickening ρ K ⊆ O`, and a Urysohn cut-off `χ` with
  `support χ = thickening ρ K` and `χ = 1` on `cthickening (ρ/2) K ⊇ K`.
* `h = χ • γ` has `tsupport h ⊆ tsupport χ ⊆ cthickening ρ K`, a compact subset of `O`: so `h` has
  compact support, is continuous (being continuous on the open `O ⊇ tsupport h`), and `h = γ`
  on `K`. -/
theorem Submission.dtc_bc_lc_pf_ext_pullback_cutoff : ∀ (P Q n : ℕ) (O K : Set (Euclid P)) (f : Euclid P → Euclid Q) (ω : DifferentialForm (Euclid Q) n), IsOpen O → ContDiffOn ℝ 1 f O → IsCompact K → K ⊆ O → Continuous ω → ∃ h : Euclid P → Covector (Euclid P) n, Continuous h ∧ HasCompactSupport h ∧ ∀ x ∈ K, h x = (ω (f x)).compContinuousLinearMap (fderiv ℝ f x) := by
  intro P Q n O K f ω hO hf hK hKO hω
  -- `f` and `Df` are continuous on `O`
  have hfc : ContinuousOn f O := hf.continuousOn
  have hDf : ContinuousOn (fderiv ℝ f) O := hf.continuousOn_fderiv_of_isOpen hO le_rfl
  -- `(β, A) ↦ β ∘ A` is continuous, having a strict derivative everywhere
  have hΦ : Continuous fun βA : Covector (Euclid Q) n × (Euclid P →L[ℝ] Euclid Q) =>
      βA.1.compContinuousLinearMap βA.2 :=
    continuous_iff_continuousAt.2 fun βA =>
      (ContinuousAlternatingMap.hasStrictFDerivAt_compContinuousLinearMap βA).continuousAt
  -- `γ(x) = ω(f(x)) ∘ Df(x)` is continuous on `O`
  have hγ : ContinuousOn (fun x => (ω (f x)).compContinuousLinearMap (fderiv ℝ f x)) O :=
    hΦ.comp_continuousOn ((hω.comp_continuousOn hfc).prodMk hDf)
  -- a margin `cthickening ρ K ⊆ O`, a compact set
  obtain ⟨ρ, hρ, hρO⟩ := hK.exists_cthickening_subset_open hO hKO
  have hρK : IsCompact (cthickening ρ K) := hK.cthickening
  -- a cut-off `χ` with `support χ = thickening ρ K` and `χ = 1` on `cthickening (ρ/2) K`
  obtain ⟨χ, hχ, -, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := 0)
    (isOpen_thickening (δ := ρ) (E := K)) (isClosed_cthickening (δ := ρ / 2) (E := K))
    (cthickening_subset_thickening' hρ (half_lt_self hρ) K)
  have hχK : ∀ x ∈ K, χ x = 1 := fun x hx => (hχ1 x).1 (self_subset_cthickening K hx)
  have hχt : tsupport χ ⊆ cthickening ρ K := by
    rw [tsupport, hχs]
    exact closure_thickening_subset_cthickening ρ K
  -- `h = χ • γ`, whose support lies in `tsupport χ`
  have hts := tsupport_smul_subset_left χ
    fun x => (ω (f x)).compContinuousLinearMap (fderiv ℝ f x)
  refine ⟨fun x => χ x • (ω (f x)).compContinuousLinearMap (fderiv ℝ f x), ?_, ?_, ?_⟩
  · -- continuous on the open `O ⊇ tsupport h`, hence continuous
    exact (hχ.continuous.continuousOn.smul hγ).continuous_of_tsupport_subset hO
      (hts.trans (hχt.trans hρO))
  · -- `tsupport h ⊆ tsupport χ ⊆ cthickening ρ K`, a compact set
    exact hρK.of_isClosed_subset (isClosed_tsupport _) (hts.trans hχt)
  · -- `χ = 1` on `K`
    intro x hx
    simp only [hχK x hx, one_smul]
/-- **Mollification** (behind Simon Ch. 6, Remark 2.24(2)): a continuous, compactly supported
`n`-covector field `h` on `ℝᴾ` is the uniform limit of test forms `ωⱼ ∈ 𝒟ⁿ(ℝᴾ)`.

Let `ψⱼ = φⱼ / ∫ φⱼ`, where `φⱼ ≥ 0` is a smooth bump with `support φⱼ = B_{1/(j+1)}(0)`, so
`ψⱼ ≥ 0` and `∫ ψⱼ = 1`.  Then `ωⱼ = ψⱼ ⋆ h` is `C^∞` with compact support, and
`‖ωⱼ(x) − h(x)‖ ≤ sup_{‖t‖ < 1/(j+1)} ‖h(x − t) − h(x)‖`, which tends to `0` uniformly in `x`
because `h` is uniformly continuous. -/
theorem Submission.dtc_bc_lc_pf_ext_mollify_tendstoUniformly : ∀ (P n : ℕ) (h : Euclid P → Covector (Euclid P) n), Continuous h → HasCompactSupport h → ∃ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) n, TendstoUniformly (fun j x => (ωs j : DifferentialForm (Euclid P) n) x) h atTop := by
  intro P n h hhc hhs
  -- (1) `h` is locally integrable
  have hhi : LocallyIntegrable h volume := hhc.locallyIntegrable
  -- (2) smooth bumps `φ j ≥ 0` with `support (φ j) = B_{1/(j+1)}(0)`, and the normalized kernels
  -- `ψ j = φ j / ∫ φ j`: `ψ j ≥ 0`, `∫ ψ j = 1`
  have hr : ∀ j : ℕ, 0 < 1 / ((j : ℝ) + 1) := fun j => Nat.one_div_pos_of_nat
  let φ : ℕ → ContDiffBump (0 : Euclid P) := fun j =>
    ⟨1 / ((j : ℝ) + 1) / 2, 1 / ((j : ℝ) + 1), half_pos (hr j), half_lt_self (hr j)⟩
  have hφ : ∀ j, 0 < ∫ y, φ j y := fun j => by
    refine (integral_pos_iff_support_of_nonneg (φ j).nonneg'
      ((φ j).continuous.integrable_of_hasCompactSupport (φ j).hasCompactSupport)).mpr ?_
    rw [(φ j).support_eq]
    exact measure_ball_pos volume 0 (hr j)
  let ψ : ℕ → Euclid P → ℝ := fun j y => φ j y / ∫ y, φ j y
  have hψφ : ∀ j, support (ψ j) ⊆ support (φ j) := fun j y hy h0 => hy (by simp [ψ, h0])
  have hψs : ∀ j, support (ψ j) ⊆ ball 0 (1 / ((j : ℝ) + 1)) := fun j =>
    (hψφ j).trans (φ j).support_eq.subset
  have hψc : ∀ j, HasCompactSupport (ψ j) := fun j => (φ j).hasCompactSupport.mono (hψφ j)
  have hψ0 : ∀ j y, 0 ≤ ψ j y := fun j y => div_nonneg (φ j).nonneg (hφ j).le
  have hψ1 : ∀ j, ∫ y, ψ j y = 1 := fun j => by rw [integral_div, div_self (hφ j).ne']
  -- (3) `ω j = ψ j ⋆ h`
  let ω : ℕ → DifferentialForm (Euclid P) n := fun j =>
    convolution (ψ j) h (ContinuousLinearMap.lsmul ℝ ℝ) volume
  -- (4) `ω j` is `C^∞` with compact support, so it is a test form on `ℝᴾ`
  have hω : ∀ j, ω j ∈ TestFormOn (univ : Set (Euclid P)) n := fun j =>
    ⟨⟨(hψc j).contDiff_convolution_left _ ((φ j).contDiff.div_const _) hhi,
      (hψc j).convolution _ hhs⟩, subset_univ _⟩
  refine ⟨fun j => ⟨ω j, hω j⟩, Metric.tendstoUniformly_iff.mpr fun ε hε => ?_⟩
  -- (6) uniform continuity of `h` gives `δ` for `ε/2`; take `J` with `1/(J+1) < δ`
  obtain ⟨δ, hδ, hhδ⟩ := Metric.uniformContinuous_iff.mp
    (hhs.uniformContinuous_of_continuous hhc) (ε / 2) (half_pos hε)
  obtain ⟨J, hJ⟩ := exists_nat_one_div_lt hδ
  refine eventually_atTop.mpr ⟨J, fun j hj x => ?_⟩
  -- (5) for `j ≥ J`, `‖h(y) − h(x)‖ < ε/2` on `B_{1/(j+1)}(x)`, so `‖ω j x − h x‖ ≤ ε/2 < ε`
  rw [dist_comm]
  refine lt_of_le_of_lt ?_ (half_lt_self hε)
  exact dist_convolution_le (half_pos hε).le (hψs j) (hψ0 j) (hψ1 j) hhc.aestronglyMeasurable
    fun y hy => (hhδ ((mem_ball.mp hy).trans_le ((Nat.one_div_le_one_div hj).trans hJ.le))).le
/-- **Limit of `IMRep` integrals under uniform convergence on a compact carrier set** (Simon
Ch. 6, 2.24(2) with the integral representation 6.3.1 (‡); chapter-06.txt lines 415–424, 271).
Let `R = (M, θ, ξ)` be an `IMRep` in `U`, `K ⊆ U` compact with `Hⁿ(M \ K) = 0`, and `gⱼ`, `g`
continuous `n`-covector fields with `gⱼ → g` uniformly on `K`.  Then
`∫_M θ ⟨gⱼ, ξ⟩ dHⁿ → ∫_M θ ⟨g, ξ⟩ dHⁿ`.

Write `μ = Hⁿ⌞M`.  `μ`-a.e. `x` lies in `K`, and `M =ᵐ M ∩ K`, so `θ` is `μ`-integrable by the
local integrability of `θ` on `K`.  A unit orientation has `|ξ(x)(β)| = |β(τ)| ≤ ‖β‖` (`τ`
orthonormal), so for continuous `G` the integrand `θ ξ(G)` is a.e. strongly measurable and
dominated by `(sup_K ‖G‖) θ`, hence integrable.  Finally
`|∫ θ ξ(gⱼ) dμ − ∫ θ ξ(g) dμ| ≤ ∫ θ ‖gⱼ − g‖ dμ ≤ Θ ε/(Θ + 1) < ε` for large `j`,
where `Θ = ∫ θ dμ`. -/
theorem Submission.dtc_bc_lc_pf_ext_imrep_integral_tendsto : ∀ (P n : ℕ) (U K : Set (Euclid P)) (R : IMRep U n) (gs : ℕ → Euclid P → Covector (Euclid P) n) (g : Euclid P → Covector (Euclid P) n), IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → (∀ j, Continuous (gs j)) → Continuous g → TendstoUniformlyOn gs g atTop K → Tendsto (fun j => ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (gs j x) ∂μHE[n]) atTop (𝓝 (∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (g x) ∂μHE[n])) := by
  intro P n U K R gs g hK hKU hnull hgs hg hunif
  set μ := μHE[n].restrict R.carrier with hμ
  -- (1) `μ`-a.e. point lies in `K`, as `Hⁿ(M \ K) = 0`
  have hae : ∀ᵐ x ∂μ, x ∈ K := by
    rw [hμ, ae_restrict_iff' R.measurableSet_carrier, ae_iff]
    refine measure_mono_null (fun x hx => ?_) hnull
    simp only [mem_ofPred_eq, not_imp] at hx
    exact hx
  -- (2) a unit orientation has norm at most one
  have hbound : ∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ ‖α‖ := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    intro α
    have hτn : ∀ i, ‖τ i‖ = 1 := fun i => hτ.1 i
    have hατ : |α τ| ≤ ‖α‖ := by
      have h := α.le_opNorm τ
      simp only [hτn, Finset.prod_const_one, mul_one, Real.norm_eq_abs] at h
      exact h
    rcases hξ with h | h
    · rw [h]; exact hατ
    · rw [h, abs_neg]; exact hατ
  -- (3) `θ` is `μ`-integrable: `μ = Hⁿ⌞(M ∩ K)` and `∫_{M ∩ K} θ dHⁿ < ∞`
  have hθmeas : AEStronglyMeasurable (fun x => (R.mult x : ℝ)) μ :=
    ((measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult).aestronglyMeasurable
  have hμK : μ = μHE[n].restrict (R.carrier ∩ K) := by
    rw [hμ]
    refine Measure.restrict_congr_set (ae_eq_set.2 ⟨?_, ?_⟩)
    · rw [sdiff_self_inter]
      exact hnull
    · rw [sdiff_eq_empty.2 inter_subset_left]
      exact measure_empty
  have hθint : Integrable (fun x => (R.mult x : ℝ)) μ := by
    refine ⟨hθmeas, ?_⟩
    show ∫⁻ x, ‖(R.mult x : ℝ)‖ₑ ∂μ < ∞
    rw [hμK]
    simp only [Real.enorm_natCast]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult K hK hKU)
  -- (4) measurability of the integrand for continuous `G`
  have hmeas : ∀ G : Euclid P → Covector (Euclid P) n, Continuous G →
      AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (G x)) μ := by
    intro G hG
    have h2 : AEStronglyMeasurable (fun x => R.orient x (G x)) μ :=
      Continuous.comp_aestronglyMeasurable₂
        (g := fun (L : MultiVector P n) (α : Covector (Euclid P) n) => L α)
        (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid P) n) (F := ℝ)).continuous
        R.aestronglyMeasurable_orient hG.aestronglyMeasurable
    exact hθmeas.mul h2
  -- (5) integrability of the integrand for continuous `G`: it is dominated by `(sup_K ‖G‖) θ`
  have hint : ∀ G : Euclid P → Covector (Euclid P) n, Continuous G →
      Integrable (fun x => (R.mult x : ℝ) * R.orient x (G x)) μ := by
    intro G hG
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hG.continuousOn
    refine Integrable.mono' (hθint.const_mul C) (hmeas G hG) ?_
    filter_upwards [hbound, hae] with x hx hxK
    rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs]
    calc (R.mult x : ℝ) * |R.orient x (G x)| ≤ (R.mult x : ℝ) * ‖G x‖ := by
          gcongr; exact hx _
      _ ≤ (R.mult x : ℝ) * C := by gcongr; exact hC x hxK
      _ = C * (R.mult x : ℝ) := mul_comm _ _
  -- (6) the estimate `|∫ θ ξ(gⱼ) dμ − ∫ θ ξ(g) dμ| ≤ Θ ε/(Θ + 1) < ε` for large `j`
  set Θ := ∫ x, (R.mult x : ℝ) ∂μ with hΘdef
  have hΘ : 0 ≤ Θ := integral_nonneg fun x => Nat.cast_nonneg _
  rw [Metric.tendstoUniformlyOn_iff] at hunif
  rw [Metric.tendsto_atTop]
  intro ε hε
  have hε' : 0 < ε / (Θ + 1) := div_pos hε (by linarith)
  obtain ⟨N, hN⟩ := eventually_atTop.mp (hunif (ε / (Θ + 1)) hε')
  refine ⟨N, fun j hj => ?_⟩
  rw [Real.dist_eq, ← integral_sub (hint _ (hgs j)) (hint _ hg), ← Real.norm_eq_abs]
  have hle : ‖∫ x, ((R.mult x : ℝ) * R.orient x (gs j x) - (R.mult x : ℝ) * R.orient x (g x)) ∂μ‖
      ≤ ∫ x, ε / (Θ + 1) * (R.mult x : ℝ) ∂μ := by
    refine norm_integral_le_of_norm_le (hθint.const_mul _) ?_
    filter_upwards [hbound, hae] with x hx hxK
    rw [← mul_sub, ← (R.orient x).map_sub, norm_mul, Real.norm_natCast, Real.norm_eq_abs]
    calc (R.mult x : ℝ) * |R.orient x (gs j x - g x)| ≤ (R.mult x : ℝ) * ‖gs j x - g x‖ := by
          gcongr; exact hx _
      _ ≤ (R.mult x : ℝ) * (ε / (Θ + 1)) := by
          gcongr
          have h := hN j hj x hxK
          rw [dist_comm, dist_eq_norm] at h
          exact h.le
      _ = ε / (Θ + 1) * (R.mult x : ℝ) := mul_comm _ _
  rw [integral_const_mul, ← hΘdef] at hle
  refine hle.trans_lt ?_
  rw [div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
  nlinarith

/-- **Integral form of the push-forward along one fixed sequence of test forms** (Simon Ch. 6,
2.23–2.24(2)).  For `f` of class `C¹` on an open `O ⊇ K` (`K` compact) and `ω ∈ 𝒟ⁿ(ℝᴾ)` there
are `ω_j ∈ 𝒟ⁿ(ℝᴾ)`, chosen before any current, with `Y(ω_j) → ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ⟩ dHⁿ`
for every `Y = τ(M, θ, ξ)` with `spt Y ⊆ K`.  A cut-off of `ω(f(·)) ∘ Df(·)` is a continuous,
compactly supported `h` equal to it on `K` (`dtc_bc_lc_pf_ext_pullback_cutoff`), and mollified
test forms converge to `h` uniformly (`dtc_bc_lc_pf_ext_mollify_tendstoUniformly`).  As
`Hⁿ(M \ K) ≤ Hⁿ(M \ spt Y) = 0` (`dtc_bc_lc_pf_imrep_carrier_mass_support`),
`Y(ω_j) = ∫_M θ ξ(ω_j) → ∫_M θ ξ(h)` (`dtc_bc_lc_pf_ext_imrep_integral_tendsto`), and
`∫_M θ ξ(h)` is the stated integral because `h = ω(f) ∘ Df` on `K`. -/
theorem Submission.dtc_bc_lc_pf_pullback_integral_extension : ∀ (P n : ℕ) (O K : Set (Euclid P)) (f : Euclid P → Euclid P) (ω : TestFormOn (univ : Set (Euclid P)) n), IsOpen O → ContDiffOn ℝ 1 f O → IsCompact K → K ⊆ O → ∃ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) n, ∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), R.Represents Y → Y.support ⊆ K → Tendsto (fun j => Y (ωs j)) atTop (𝓝 (∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n])) := by
  intro P n O K f ω hO hf hK hKO
  -- Steps 1–2: a continuous, compactly supported `h` with `h = ω(f(·)) ∘ Df(·)` on `K`
  obtain ⟨h, hhc, hhs, hhK⟩ := Submission.dtc_bc_lc_pf_ext_pullback_cutoff P P n O K f
    (ω : DifferentialForm (Euclid P) n) hO hf hK hKO ω.property.1.1.continuous
  -- Step 3: test forms `ω_j → h` uniformly; they depend only on `f`, `ω`, `O` and `K`
  obtain ⟨ωs, hωs⟩ := Submission.dtc_bc_lc_pf_ext_mollify_tendstoUniformly P n h hhc hhs
  refine ⟨ωs, fun Y R hRY hYK => ?_⟩
  -- Step 4(a): `Hⁿ(M \ K) ≤ Hⁿ(M \ spt Y) = 0`
  have hnull : μHE[n] (R.carrier \ K) = 0 :=
    measure_mono_null (Set.sdiff_subset_sdiff_right hYK)
      ((Submission.dtc_bc_lc_pf_imrep_carrier_mass_support P n).1 Y R hRY).1
  -- Step 5: `h = ω(f) ∘ Df` on `K`, which contains `Hⁿ`-a.e. point of `M`, so the limits agree
  have hae : (fun x => (R.mult x : ℝ) * R.orient x (h x)) =ᵐ[μHE[n].restrict R.carrier]
      fun x => (R.mult x : ℝ) * R.orient x
        (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) := by
    have hMK : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ K := by
      rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
      refine measure_mono_null (fun x hx => ?_) hnull
      exact ⟨hx.2, hx.1⟩
    filter_upwards [hMK] with x hx
    rw [hhK x hx]
  rw [← integral_congr_ae hae]
  -- Step 6: `Y(ω_j) = ∫_M θ ξ(ω_j) → ∫_M θ ξ(h)`
  exact (Submission.dtc_bc_lc_pf_ext_imrep_integral_tendsto P n univ K R
    (fun j x => (ωs j : DifferentialForm (Euclid P) n) x) h hK (subset_univ K) hnull
    (fun j => (ωs j).property.1.1.continuous) hhc hωs.tendstoUniformlyOn).congr
    fun j => (hRY (ωs j)).symm
/-- **Mass bound for the push-forward formula** (Simon Ch. 6, 2.27 and 2.29:
`M(f_#T) ≤ (ess sup |Df|)ⁿ M(T)`).  Let `‖Df‖ ≤ L` on `O`, let `R = (M, θ, ξ)` represent `Y` with
`spt Y ⊆ O`, and let `Z(ω) = ∫_M θ ⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩ dHⁿ`.  Then `M(Z) ≤ Lⁿ M(Y)`.
* `Hⁿ(M ∖ spt Y) = 0` and `M(Y) = μ_R(ℝᴾ) = ∫_M θ dHⁿ`.
* For `|ω| ≤ 1` and `Hⁿ`-a.e. `x ∈ M`: `x ∈ spt Y ⊆ O`, so `0 ≤ ‖Df(x)‖ ≤ L` (in particular
  `L ≥ 0` whenever `M` is not `Hⁿ`-null), and `ξ(x)` is a unit orientation of a plane, so
  `|⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩| ≤ |ω(f(x))| ‖Df(x)‖ⁿ ≤ Lⁿ`.
* Hence `Z(ω) ≤ ∫_M |θ ⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩| dHⁿ ≤ Lⁿ ∫_M θ dHⁿ = Lⁿ M(Y)`; take the
  supremum over `ω`. -/
theorem Submission.dtc_bc_lc_pf_pushforward_mass_le : ∀ (P n : ℕ) (O : Set (Euclid P)) (f : Euclid P → Euclid P) (L : ℝ) (Y Z : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), (∀ y ∈ O, ‖fderiv ℝ f y‖ ≤ L) → R.Represents Y → IsCompact Y.support → Y.support ⊆ O → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Z ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → Z.mass ≤ ENNReal.ofReal (L ^ n) * Y.mass := by
  intro P n O f L Y Z R hL hRY _ hKO hZ
  -- Step 1: `Hⁿ(M ∖ spt Y) = 0` and `M(Y) = μ_R(ℝᴾ) = ∫_M θ dHⁿ`
  obtain ⟨hnull, hmass, -⟩ := (Submission.dtc_bc_lc_pf_imrep_carrier_mass_support P n).1 Y R hRY
  have hspt : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ Y.support := by
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    refine measure_mono_null (fun x hx => ?_) hnull
    exact ⟨hx.2, hx.1⟩
  have hθ : ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] = Y.mass := by
    rw [hmass, IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  -- Step 2: fix an admissible `ω`, i.e. `|ω(z)| ≤ 1` for every `z`
  apply sSup_le
  rintro _ ⟨ω, ⟨-, hω⟩, rfl⟩
  dsimp only
  -- Step 3: `|θ ⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩| ≤ Lⁿ θ` at `Hⁿ`-a.e. `x ∈ M`
  have hbound : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      ‖(R.mult x : ℝ) * R.orient x
        (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x))‖ₑ ≤
          ENNReal.ofReal (L ^ n) * (R.mult x : ℝ≥0∞) := by
    filter_upwards [hspt, R.orients] with x hx hor
    obtain ⟨Q, -, hQ⟩ := hor
    have hDf : ‖fderiv ℝ f x‖ ≤ L := hL x (hKO hx)
    have hLn : 0 ≤ L ^ n := pow_nonneg ((norm_nonneg _).trans hDf) n
    have hξ : |R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
        (fderiv ℝ f x))| ≤ L ^ n :=
      calc _ ≤ covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) (f x)) *
            ‖fderiv ℝ f x‖ ^ n :=
          (Submission.dtc_bc_lc_pf_unitOrientation_comp P n (R.orient x) Q (fderiv ℝ f x) hQ).1 _
        _ ≤ 1 * L ^ n := mul_le_mul (hω (f x)) (pow_le_pow_left₀ (norm_nonneg _) hDf n)
            (pow_nonneg (norm_nonneg _) n) zero_le_one
        _ = L ^ n := one_mul _
    rw [Real.enorm_eq_ofReal_abs, abs_mul, Nat.abs_cast, ← ENNReal.ofReal_natCast,
      ← ENNReal.ofReal_mul hLn, mul_comm (L ^ n)]
    exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hξ (Nat.cast_nonneg _))
  -- Step 4: `Z(ω) ≤ ∫_M |θ ⟨ω(f(x)) ∘ ΛⁿDf(x), ξ(x)⟩| dHⁿ ≤ Lⁿ ∫_M θ dHⁿ = Lⁿ M(Y)`
  rw [hZ ω]
  refine (Real.ofReal_le_enorm _).trans ((enorm_integral_le_lintegral_enorm _).trans
    ((lintegral_mono_ae hbound).trans_eq ?_))
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hθ]

/-- **Push-forward of an integer multiplicity current by a `C¹` map** (Simon Ch. 6, 3.3–3.9, with
the area formula of Ch. 3, 2.4–2.6).  Let `R = (M, θ, ξ)` be an integer multiplicity triple in the
open `U` with `Hⁿ(M ∖ K) = 0` for a compact `K ⊆ U`, let `f` be `C¹` on an open `O ⊇ K` with
`f(K) ⊆ U`, and let `Q(ω) = ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ(x)⟩ dHⁿ(x)` for `ω ∈ 𝒟ⁿ(U)`.  Replace `f`
by a globally `Λ`-Lipschitz `C¹` map `φ` with `φ = f` and `Dφ = Df` on `K`, and cut
`M₁ = M ∩ K` (with `∫_{M₁} θ < ∞`), up to an `Hⁿ`-null set, into disjoint bi-Lipschitz pieces
`Gⱼ(Aⱼ)` on which `φ ∘ Gⱼ` either is bi-Lipschitz with injective derivative or has nowhere
injective derivative.  On each piece `ξ ∘ Gⱼ = ±DGⱼ#e / J_{Gⱼ}` a.e., and the area formula turns
the contribution of `Gⱼ(Aⱼ)` to `Q(ω)` into `∫_{Nⱼ} gⱼ ⟨ω, ηⱼ⟩ dHⁿ`, with
`Nⱼ ⊆ φ(Gⱼ(Aⱼ)) ⊆ f(K) ⊆ U`, an integer `gⱼ ≠ 0` on `Nⱼ`, an orientation `ηⱼ` of `TNⱼ`, and
`∫_{Nⱼ} |gⱼ| ≤ Λⁿ ∫_{Gⱼ(Aⱼ)} θ`.  As `|⟨β, ξ⟩| ≤ ‖β‖` a.e. on `M` and `‖Dφ‖ ≤ Λ`, the integrand
`θ ⟨ω(φ) ∘ Dφ, ξ⟩` is `Hⁿ⌞M₁`-integrable, so `Q(ω) = Σⱼ ∫_{Nⱼ} gⱼ ⟨ω, ηⱼ⟩ dHⁿ` with
`Σⱼ ∫_{Nⱼ} |gⱼ| ≤ Λⁿ ∫_{M₁} θ < ∞`; gluing the pieces gives an integer multiplicity triple
representing `Q`. -/
theorem Submission.dtc_bc_lc_pf_pushforward_isIntegerMultiplicity : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U K O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P) (Q : GeometricCurrentOn U n), IsOpen U → 0 < n → IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → IsOpen O → K ⊆ O → ContDiffOn ℝ 1 f O → f '' K ⊆ U → (∀ ω : TestFormOn U n, Q ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → IsIntegerMultiplicity Q := by
  intro hTL P n U K O R f Q hU _hn hK hKU hMK hO hKO hf hfK hQ
  -- Step 1(b): a globally Lipschitz `C¹` map `φ` with `φ = f` and `Dφ = Df` on `K`
  obtain ⟨φ, Λ, hφ, hφL, hφK⟩ :=
    Submission.dtc_bc_lc_pfi_c1_cutoff_lipschitz P O K f hO hK hKO hf
  have hφd : Differentiable ℝ φ := hφ.differentiable one_ne_zero
  -- Step 1(a): `M₁ = M ∩ K` is Borel with `∫_{M₁} θ dHⁿ < ∞`
  have hM₁ : MeasurableSet (R.carrier ∩ K) :=
    R.measurableSet_carrier.inter hK.isClosed.measurableSet
  have hθM₁ : ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞ :=
    R.locallyIntegrable_mult K hK hKU
  -- Step 2: disjoint bi-Lipschitz pieces `Gⱼ(Aⱼ)` covering `M₁` up to a null set, on which
  -- `φ ∘ Gⱼ` is bi-Lipschitz with injective derivative or has nowhere injective derivative
  obtain ⟨G, A, κ, hGL, hA, hκ, hGκ, hGd, hGA, hGAM, hdisj, hnull, hφG⟩ :=
    Submission.dtc_bc_lc_pfi_refined_bilipschitz_pieces P n (R.carrier ∩ K) φ hM₁
      (R.rectifiable.mono inter_subset_left) hφd
  choose L hL using hGL
  have hGAR : ∀ j, G j '' A j ⊆ R.carrier := fun j => (hGAM j).trans inter_subset_left
  -- Step 4: `ξ ∘ Gⱼ = ±DGⱼ#e / J_{Gⱼ}` a.e. on `Aⱼ`; Steps 5–8: the image pieces
  -- `Nⱼ ⊆ φ(Gⱼ(Aⱼ))` with integer multiplicities `gⱼ` and orientations `ηⱼ`
  have hpiece := fun j =>
    Submission.dtc_bc_lc_pfi_piece_pushforward_image P n U R (G j) (A j) (L j) (κ j) φ Λ
      (hL j) (hA j) (hκ j) (hGκ j) (hGd j) (hGAR j)
      (ne_top_of_le_ne_top hθM₁ (lintegral_mono_set (hGAM j)))
      (Submission.dtc_bc_lc_pfi_piece_orientation_sign P n U R (G j) (A j) (L j) (κ j) hU
        (hL j) (hA j) (hκ j) (hGκ j) (hGd j) (hGAR j))
      hφd hφL (hφG j)
  choose N g η hN hNφ hNr hg hg0 hη hηT hgθ hNint using hpiece
  -- Steps 9–11: glue the image pieces into one integer multiplicity triple in `U`
  refine Submission.dtc_bc_lc_pfi_isIntegerMultiplicity_of_pieces hTL P n U N g η Q hU hN ?_
    hNr hg hg0 hη hηT ?_ ?_
  · -- `Nⱼ ⊆ φ(Gⱼ(Aⱼ)) ⊆ φ(K) = f(K) ⊆ U`
    intro j y hy
    obtain ⟨x, hx, rfl⟩ := hNφ j hy
    have hxK : x ∈ K := (hGAM j hx).2
    rw [(hφK x hxK).1]
    exact hfK (mem_image_of_mem f hxK)
  · -- `Σⱼ ∫_{Nⱼ} |gⱼ| ≤ Λⁿ Σⱼ ∫_{Gⱼ(Aⱼ)} θ = Λⁿ ∫_{⋃ⱼ Gⱼ(Aⱼ)} θ ≤ Λⁿ ∫_{M₁} θ < ∞`
    have hle : ∑' j, ∫⁻ y in N j, ((g j y).natAbs : ℝ≥0∞) ∂μHE[n] ≤
        (Λ : ℝ≥0∞) ^ n * ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
      calc ∑' j, ∫⁻ y in N j, ((g j y).natAbs : ℝ≥0∞) ∂μHE[n]
          ≤ ∑' j, (Λ : ℝ≥0∞) ^ n * ∫⁻ x in G j '' A j, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
            ENNReal.tsum_le_tsum hgθ
        _ = (Λ : ℝ≥0∞) ^ n * ∫⁻ x in ⋃ j, G j '' A j, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
            rw [ENNReal.tsum_mul_left, lintegral_iUnion hGA hdisj]
        _ ≤ (Λ : ℝ≥0∞) ^ n * ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
            gcongr
            exact iUnion_subset hGAM
    exact ne_top_of_le_ne_top
      (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) hθM₁) hle
  · -- `Q(ω) = ∫_{M₁} θ ⟨ω(φ) ∘ Dφ, ξ⟩ = Σⱼ ∫_{Gⱼ(Aⱼ)} θ ⟨ω(φ) ∘ Dφ, ξ⟩ = Σⱼ ∫_{Nⱼ} gⱼ ⟨ω, ηⱼ⟩`
    intro ω
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ω.property.1.1.continuous
    obtain ⟨C, hC⟩ := HasCompactSupport.exists_bound_of_continuous ω.property.1.2 hωc
    have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC 0)
    -- Step 1(c): `x ↦ θ(x) ⟨ω(φ(x)) ∘ Dφ(x), ξ(x)⟩` is `Hⁿ⌞M₁`-integrable, being bounded by
    -- `C Λⁿ θ` (`|⟨β, ξ⟩| ≤ ‖β‖` a.e. on `M`, `‖β ∘ Dφ‖ ≤ ‖β‖ ‖Dφ‖ⁿ`, `‖Dφ‖ ≤ Λ`)
    have hβ : Continuous fun x =>
        ((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x) := by
      have h := (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp
        (hφ.continuous_fderiv one_ne_zero)).clm_apply (hωc.comp hφ.continuous)
      simpa only [Function.comp_apply,
        ContinuousAlternatingMap.compContinuousLinearMapCLM_apply] using h
    have hθ : Measurable fun x => (R.mult x : ℝ) :=
      (measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult
    have hθi : Integrable (fun x => (R.mult x : ℝ)) (μHE[n].restrict (R.carrier ∩ K)) := by
      refine ⟨hθ.aestronglyMeasurable, ?_⟩
      show ∫⁻ x, ‖(R.mult x : ℝ)‖ₑ ∂(μHE[n].restrict (R.carrier ∩ K)) < ∞
      simp only [Real.enorm_natCast]
      exact lt_top_iff_ne_top.mpr hθM₁
    have hint : IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x
        (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)))
        (R.carrier ∩ K) μHE[n] := by
      refine Integrable.mono' (hθi.const_mul (C * (Λ : ℝ) ^ n))
        (hθ.aestronglyMeasurable.mul ?_) ?_
      · exact Continuous.comp_aestronglyMeasurable₂
          (g := fun (L : MultiVector P n) (α : Covector (Euclid P) n) => L α)
          (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid P) n) (F := ℝ)).continuous
          (R.aestronglyMeasurable_orient.mono_set inter_subset_left) hβ.aestronglyMeasurable
      · filter_upwards [ae_restrict_of_ae_restrict_of_subset inter_subset_left R.orients]
          with x hx
        obtain ⟨T, -, hT⟩ := hx
        have h1 := (Submission.dtc_bc_lc_pfi_unitOrientation_algebra P n).2.1 _ T hT
          (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x))
        have h2 := ContinuousAlternatingMap.norm_compContinuousLinearMap_le
          ((ω : DifferentialForm (Euclid P) n) (φ x)) (fderiv ℝ φ x)
        rw [Fintype.card_fin] at h2
        have h3 : ‖fderiv ℝ φ x‖ ^ n ≤ (Λ : ℝ) ^ n :=
          pow_le_pow_left₀ (norm_nonneg _) (norm_fderiv_le_of_lipschitz ℝ hφL) n
        rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs, mul_comm (C * (Λ : ℝ) ^ n)]
        gcongr
        exact h1.trans (h2.trans (mul_le_mul (hC _) h3 (by positivity) hC0))
    calc Q ω = ∫ x in R.carrier ∩ K, (R.mult x : ℝ) * R.orient x
          (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap
            (fderiv ℝ φ x)) ∂μHE[n] := by
          -- `Hⁿ(M ∖ K) = 0`, and `φ = f`, `Dφ = Df` on `M₁ ⊆ K`
          rw [hQ ω, setIntegral_congr_set (ae_eq_set.mpr
            ⟨by rw [sdiff_self_inter]; exact hMK,
              by rw [sdiff_eq_empty.mpr inter_subset_left, measure_empty]⟩)]
          refine setIntegral_congr_fun hM₁ fun x hx => ?_
          simp only [(hφK x hx.2).1, (hφK x hx.2).2]
      _ = ∫ x in ⋃ j, G j '' A j, (R.mult x : ℝ) * R.orient x
          (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap
            (fderiv ℝ φ x)) ∂μHE[n] :=
          -- the pieces cover `M₁` up to an `Hⁿ`-null set
          setIntegral_congr_set (ae_eq_set.mpr ⟨hnull,
            by rw [sdiff_eq_empty.mpr (iUnion_subset hGAM), measure_empty]⟩)
      _ = ∑' j, ∫ x in G j '' A j, (R.mult x : ℝ) * R.orient x
          (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap
            (fderiv ℝ φ x)) ∂μHE[n] :=
          integral_iUnion hGA hdisj (hint.mono_set (iUnion_subset hGAM))
      _ = ∑' j, ∫ y in N j, (g j y : ℝ) * η j y ((ω : DifferentialForm (Euclid P) n) y)
          ∂μHE[n] :=
          tsum_congr fun j => hNint j _ hωc.stronglyMeasurable

/-- **Push-forward by a map that is `C¹` near the support** (Simon Ch. 6, 2.23–2.24(2), 2.29 and
3.3–3.9).  Let `O` be open, `f` be `C¹` on `O` and `n = m + 1`.  For integer multiplicity
`Y ∈ 𝒟ₙ(ℝᴾ)` with `spt Y` compact and `⊆ O`, choose a representation `(M₀, θ₀, ξ₀)` and a `C¹` map
`φ`, the identity off a compact set, with `φ = f` and `Dφ = Df` on an open `V ⊇ spt Y`; put
`push Y(ω) = ∫_{M₀} θ₀ ⟨ω(φ(x)) ∘ ΛⁿDφ(x), ξ₀⟩ dHⁿ`, a current.  For every other `Y`,
`push Y = 0`.  As `Hⁿ(M₀ ∖ spt Y) = 0`, `f` may replace `φ` in the integrand.
(i) Every representation `(M, θ, ξ)` of `Y` gives the same integral: it is the limit of `Y(ωⱼ)`
for one sequence of test forms `ωⱼ`, chosen before the representation.
(ii) `push Y` is integer multiplicity by the area formula (Simon 3.5–3.9).
(iii) If `spt ω` misses the compact set `f(spt Y)`, the integrand vanishes `Hⁿ`-a.e. on `M`.
(iv) `|⟨ω(f(x)) ∘ ΛⁿDf(x), ξ⟩| ≤ |ω(f(x))|·‖Df(x)‖ⁿ` gives `M(push Y) ≤ Lⁿ M(Y)`.
(v) The formula with `φ` sends cycles to cycles (Simon 2.24(1)).
(B) `Y₁ − Y₂` is integer multiplicity with compact support in `spt Y₁ ∪ spt Y₂ ⊆ O`, and the three
integrals are the limits of `(Y₁ − Y₂)(ωⱼ) = Y₁(ωⱼ) − Y₂(ωⱼ)`, `Y₁(ωⱼ)` and `Y₂(ωⱼ)`. -/
theorem Submission.dtc_bc_lc_pushforward : ∀ (P m : ℕ) (O : Set (Euclid P)) (f : Euclid P → Euclid P), IsOpen O → ContDiffOn ℝ 1 f O → ∃ push : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents Y → IsCompact Y.support → Y.support ⊆ O → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), push Y ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity (push Y) ∧ (push Y).support ⊆ f '' Y.support ∧ (∀ L : ℝ, (∀ y ∈ O, ‖fderiv ℝ f y‖ ≤ L) → (push Y).mass ≤ ENNReal.ofReal (L ^ (m + 1)) * Y.mass) ∧ (Y.boundary = 0 → (push Y).boundary = 0)) ∧ ∀ Y₁ Y₂ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Y₁ → IsIntegerMultiplicity Y₂ → IsCompact Y₁.support → Y₁.support ⊆ O → IsCompact Y₂.support → Y₂.support ⊆ O → push (Y₁ - Y₂) = push Y₁ - push Y₂ := by
  intro P m O f hO hf
  -- Step 1: `Hⁿ(M ∖ spt Y) = 0`, so `Hⁿ`-a.e. point of the carrier lies in `spt Y`
  have hcf := Submission.dtc_bc_lc_pf_imrep_carrier_mass_support P (m + 1)
  have hspt : ∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents Y →
      ∀ᵐ x ∂(μHE[m + 1].restrict R.carrier), x ∈ Y.support := by
    intro Y R hR
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    refine measure_mono_null (fun x hx => ?_) (hcf.1 Y R hR).1
    exact ⟨hx.2, hx.1⟩
  -- Step 2: for `Y ∈ 𝒴`, a representation `R₀` and a cut-off `φ` of `f` near `spt Y` define
  -- `push Y` by the formula with `φ` (a current); `push Y = 0` otherwise
  have key : ∀ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
      ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
        IsIntegerMultiplicity Y → IsCompact Y.support → Y.support ⊆ O →
          ∃ (R₀ : IMRep (univ : Set (Euclid P)) (m + 1)) (φ : Euclid P → Euclid P)
            (V K' : Set (Euclid P)), R₀.Represents Y ∧ Y.support ⊆ V ∧ IsCompact K' ∧
            ContDiff ℝ 1 φ ∧ (∀ x ∈ V, φ x = f x ∧ fderiv ℝ φ x = fderiv ℝ f x) ∧
            (∀ x, x ∉ K' → φ x = x) ∧
            ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), S ω = ∫ x in R₀.carrier,
              (R₀.mult x : ℝ) * R₀.orient x (((ω : DifferentialForm (Euclid P) (m + 1))
                (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[m + 1] := by
    intro Y
    by_cases hY : IsIntegerMultiplicity Y ∧ IsCompact Y.support ∧ Y.support ⊆ O
    · obtain ⟨⟨R₀, hR₀⟩, hK, hKO⟩ := hY
      obtain ⟨φ, V, K', -, hKV, hK', hφ, hφf, hφK'⟩ :=
        Submission.dtc_bc_lc_pf_c1_compact_perturbation P O Y.support f hO hK hKO hf
      obtain ⟨S, hS⟩ := Submission.dpf_pushforward_formula_current_exists P (m + 1) univ K' R₀ φ
        hK' (subset_univ _) hφ hφK'
      exact ⟨S, fun _ _ _ => ⟨R₀, φ, V, K', hR₀, hKV, hK', hφ, hφf, hφK', hS⟩⟩
    · exact ⟨0, fun h₁ h₂ h₃ => absurd ⟨h₁, h₂, h₃⟩ hY⟩
  choose push hpush using key
  -- Step 3 (i): the formula with `f`, for every representation of `Y`
  have hform : ∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents Y → IsCompact Y.support →
      Y.support ⊆ O → ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), push Y ω =
        ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) (m + 1))
          (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[m + 1] := by
    intro Y R hR hK hKO ω
    obtain ⟨R₀, φ, V, K', hR₀, hKV, -, -, hφf, -, hS⟩ := hpush Y ⟨R, hR⟩ hK hKO
    -- `φ = f` and `Dφ = Df` on `V ⊇ spt Y`, which contains `Hⁿ`-a.e. point of `M₀`
    have h₀ : push Y ω = ∫ x in R₀.carrier, (R₀.mult x : ℝ) * R₀.orient x
        (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap
          (fderiv ℝ f x)) ∂μHE[m + 1] := by
      rw [hS ω]
      refine integral_congr_ae ?_
      filter_upwards [hspt Y R₀ hR₀] with x hx
      rw [(hφf x (hKV hx)).1, (hφf x (hKV hx)).2]
    -- both integrals are limits of `Y(ωⱼ)` for one sequence `ωⱼ`
    obtain ⟨ωs, hωs⟩ := Submission.dtc_bc_lc_pf_pullback_integral_extension P (m + 1) O Y.support
      f ω hO hf hK hKO
    rw [h₀]
    exact tendsto_nhds_unique (hωs Y R₀ hR₀ subset_rfl) (hωs Y R hR subset_rfl)
  refine ⟨push, fun Y R hR hK hKO => ⟨hform Y R hR hK hKO, ?_, ?_, ?_, ?_⟩, ?_⟩
  · -- Step 4 (ii): integer multiplicity by the area formula, with tangent locality from the
    -- integer multiplicity calculus (`↔` reversed)
    exact Submission.dtc_bc_lc_pf_pushforward_isIntegerMultiplicity
      (fun P n U A B hU hA hB hAB hBU hfin =>
        (Submission.cmc_imRep_locality_restrict_sub.1 P n U A B hU hA hB hAB hBU hfin).mono
          fun x hx Q => (hx Q).symm)
      P (m + 1) univ Y.support O R f (push Y) isOpen_univ (Nat.succ_pos m) hK (subset_univ _)
      (hcf.1 Y R hR).1 hO hKO hf (subset_univ _) (hform Y R hR hK hKO)
  · -- Step 5 (iii): if `spt ω` misses the compact set `f(spt Y)`, then `ω(f(x)) = 0` for
    -- `Hⁿ`-a.e. `x ∈ M`, so `push Y(ω) = 0`
    have hfK : IsCompact (f '' Y.support) := hK.image_of_continuousOn (hf.continuousOn.mono hKO)
    refine (Submission.rsd_cmr_support_subset_of_vanish P (m + 1) univ (f '' Y.support) (push Y)
      isOpen_univ hfK (subset_univ _) fun ω hω => ?_).1
    rw [hform Y R hR hK hKO ω]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [hspt Y R hR] with x hx
    have h0 : (ω : DifferentialForm (Euclid P) (m + 1)) (f x) = 0 :=
      image_eq_zero_of_notMem_tsupport (Set.disjoint_right.1 hω (mem_image_of_mem f hx))
    have h0' : ((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap
        (fderiv ℝ f x) = 0 := by
      ext v
      simp [h0]
    simp [h0']
  · -- Step 6 (iv): the mass bound
    intro L hL
    exact Submission.dtc_bc_lc_pf_pushforward_mass_le P (m + 1) O f L Y (push Y) R hL hR hK hKO
      (hform Y R hR hK hKO)
  · -- Step 7 (v): `push Y` is given by the formula with `φ`, which preserves cycles
    intro hYb
    obtain ⟨R₀, φ, V, K', hR₀, -, hK', hφ, -, hφK', hS⟩ := hpush Y ⟨R, hR⟩ hK hKO
    exact Submission.dpf_pushforward_formula_boundaryVanishes P (m + 1) univ K' Y (push Y) R₀ φ
      isOpen_univ hR₀ hK' (subset_univ _) hφ hφK' hS hYb
  · -- Step 8 (B): `Y₁ − Y₂ ∈ 𝒴`, and all three formulas are limits along one sequence `ωⱼ`
    intro Y₁ Y₂ hY₁ hY₂ hK₁ hKO₁ hK₂ hKO₂
    obtain ⟨R₁₂, hR₁₂⟩ := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ Y₁ Y₂
      isOpen_univ hY₁ hY₂
    obtain ⟨R₁, hR₁⟩ := hY₁
    obtain ⟨R₂, hR₂⟩ := hY₂
    have hsub : (Y₁ - Y₂).support ⊆ Y₁.support ∪ Y₂.support := (hcf.2 Y₁ Y₂).2
    have hK₁₂ : IsCompact (Y₁ - Y₂).support :=
      (hK₁.union hK₂).of_isClosed_subset (hcf.2 (Y₁ - Y₂) Y₂).1 hsub
    have hKO₁₂ : (Y₁ - Y₂).support ⊆ O := hsub.trans (union_subset hKO₁ hKO₂)
    ext ω
    obtain ⟨ωs, hωs⟩ := Submission.dtc_bc_lc_pf_pullback_integral_extension P (m + 1) O
      (Y₁.support ∪ Y₂.support) f ω hO hf (hK₁.union hK₂) (union_subset hKO₁ hKO₂)
    have h₁ := hωs Y₁ R₁ hR₁ subset_union_left
    have h₂ := hωs Y₂ R₂ hR₂ subset_union_right
    have h₁₂ := hωs (Y₁ - Y₂) R₁₂ hR₁₂ hsub
    rw [← hform Y₁ R₁ hR₁ hK₁ hKO₁ ω] at h₁
    rw [← hform Y₂ R₂ hR₂ hK₂ hKO₂ ω] at h₂
    rw [← hform (Y₁ - Y₂) R₁₂ hR₁₂ hK₁₂ hKO₁₂ ω] at h₁₂
    exact tendsto_nhds_unique h₁₂ (h₁.sub h₂)
/-- Comparison of measures from open subsets, by outer regularity (Simon 1.15(1)): if
`μ(ℝᴾ \ U) = 0`, `ν` is finite on compact subsets of the open set `U`, and `μ(V) ≤ ν(V)` for every
open `V ⊆ U`, then `μ ≤ ν`.  `U` is exhausted by the open sets
`V_k = {‖x‖ < k, 1/k < d(x, ℝᴾ \ U)}`, each inside the compact `K_k ⊆ U`; `ν⌞V_k` is finite,
hence outer regular, which gives `μ(E ∩ V_k) ≤ ν(E ∩ V_k)`; continuity from below finishes. -/
theorem Submission.dtc_bc_lc_measure_le_of_le_on_open : ∀ (P : ℕ) (U : Set (Euclid P)) (μ ν : Measure (Euclid P)), IsOpen U → μ Uᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ν K < ∞) → (∀ V : Set (Euclid P), IsOpen V → V ⊆ U → μ V ≤ ν V) → μ ≤ ν := by
  intro P U μ ν hU hμU hν hle
  -- Steps 1–3: the exhaustion `V k ⊆ K k ⊆ U`, `V` increasing with union `U`
  set V : ℕ → Set (Euclid P) :=
    fun k => {x | ‖x‖ < k ∧ (k : ℝ≥0∞)⁻¹ < infEDist x Uᶜ}
  set K : ℕ → Set (Euclid P) :=
    fun k => {x | ‖x‖ ≤ k ∧ (k : ℝ≥0∞)⁻¹ ≤ infEDist x Uᶜ}
  have hVopen : ∀ k, IsOpen (V k) := fun k =>
    (isOpen_lt continuous_norm continuous_const).inter
      (isOpen_lt continuous_const continuous_infEDist)
  have hKcpt : ∀ k, IsCompact (K k) := fun k => by
    refine isCompact_of_isClosed_isBounded ?_ ?_
    · exact (isClosed_le continuous_norm continuous_const).inter
        (isClosed_le continuous_const continuous_infEDist)
    · refine (isBounded_closedBall (x := (0 : Euclid P)) (r := (k : ℝ))).subset ?_
      intro x hx
      simpa [mem_closedBall, dist_zero_right] using hx.1
  have hKU : ∀ k, K k ⊆ U := fun k x hx => by
    by_contra hxU
    have h0 : infEDist x Uᶜ = 0 := infEDist_zero_of_mem hxU
    have h1 : (k : ℝ≥0∞)⁻¹ ≤ 0 := h0 ▸ hx.2
    exact (ENNReal.inv_ne_zero.mpr (ENNReal.natCast_ne_top k)) (nonpos_iff_eq_zero.mp h1)
  have hVK : ∀ k, V k ⊆ K k := fun k x hx => ⟨hx.1.le, hx.2.le⟩
  have hVmono : Monotone V := fun k m hkm x hx =>
    ⟨lt_of_lt_of_le hx.1 (by exact_mod_cast hkm),
      lt_of_le_of_lt (ENNReal.inv_le_inv.mpr (by exact_mod_cast hkm)) hx.2⟩
  have hVU : ⋃ k, V k = U := by
    apply subset_antisymm
    · exact iUnion_subset fun k => (hVK k).trans (hKU k)
    · intro x hx
      have hpos : 0 < infEDist x Uᶜ := by
        rw [infEDist_pos_iff_notMem_closure, hU.isClosed_compl.closure_eq]
        exact fun h => h hx
      obtain ⟨a, ha⟩ := ENNReal.exists_inv_nat_lt hpos.ne'
      obtain ⟨b, hb⟩ := exists_nat_gt ‖x‖
      refine mem_iUnion.mpr ⟨max a b, ?_, ?_⟩
      · exact lt_of_lt_of_le hb (by exact_mod_cast le_max_right a b)
      · exact lt_of_le_of_lt (ENNReal.inv_le_inv.mpr (by exact_mod_cast le_max_left a b)) ha
  -- Step 4: `ν (V k) < ∞`
  have hνV : ∀ k, ν (V k) ≠ ∞ := fun k =>
    ne_of_lt (lt_of_le_of_lt (measure_mono (hVK k)) (hν _ (hKcpt k) (hKU k)))
  -- Step 5: comparison inside `V k`, by outer regularity of the finite measure `ν⌞V k`
  have hcomp : ∀ k (E : Set (Euclid P)), μ (E ∩ V k) ≤ ν (E ∩ V k) := by
    intro k E
    have : IsFiniteMeasure (ν.restrict (V k)) := isFiniteMeasure_restrict.mpr (hνV k)
    refine le_of_forall_gt fun r hr => ?_
    rw [← Measure.restrict_apply' (hVopen k).measurableSet] at hr
    obtain ⟨O, hEO, hO, hOr⟩ := Set.exists_isOpen_lt_of_lt E r hr
    rw [Measure.restrict_apply' (hVopen k).measurableSet] at hOr
    calc μ (E ∩ V k) ≤ μ (O ∩ V k) := measure_mono (inter_subset_inter_left _ hEO)
      _ ≤ ν (O ∩ V k) := hle _ (hO.inter (hVopen k))
          (inter_subset_right.trans ((hVK k).trans (hKU k)))
      _ < r := hOr
  -- Steps 6–8: concentration on `U`, continuity from below, `Measure.le_iff`
  rw [Measure.le_iff]
  intro E hE
  calc μ E = μ (E ∩ U) := by
        have h := measure_inter_add_sdiff E hU.measurableSet (μ := μ)
        have h2 : μ (E \ U) = 0 := measure_mono_null (fun x hx => hx.2) hμU
        rw [h2, add_zero] at h
        exact h.symm
    _ = ⨆ k, μ (E ∩ V k) := by
        rw [← hVU, inter_iUnion]
        exact Monotone.measure_iUnion fun k m hkm => inter_subset_inter_right E (hVmono hkm)
    _ ≤ ν E := iSup_le fun k => (hcomp k E).trans (measure_mono inter_subset_left)

/-- **Subadditivity of weights** (Simon 6.2.5 and 6.3.2(3), as used in the proof of 7.2.4).  If
`|c| ≤ 1` and `Z(ω) = X(ω) + c Y(ω)` for every `ω ∈ 𝒟ⁿ(U)`, then `μ_Z ≤ μ_X + μ_Y`.  For open
`V ⊆ U`, `μ_Z(V) = M_V(Z) ≤ M_V(X) + M_V(Y) = μ_X(V) + μ_Y(V)` by the mass triangle inequality
and `M_V = μ(V)`.  As `M_Z ⊆ U`, `μ_Z` is concentrated on `U`, and `μ_X + μ_Y` is finite on
compact subsets of `U`; so the inequality extends from open subsets of `U` to all sets. -/
theorem Submission.dtc_bc_lc_measure_le_add : ∀ (P n : ℕ) (U : Set (Euclid P)) (X Y Z : GeometricCurrentOn U n) (RX RY RZ : IMRep U n) (c : ℝ), IsOpen U → |c| ≤ 1 → RX.Represents X → RY.Represents Y → RZ.Represents Z → (∀ ω : TestFormOn U n, Z ω = X ω + c * Y ω) → RZ.measure ≤ RX.measure + RY.measure := by
  intro P n U X Y Z RX RY RZ c hU hc hRX hRY hRZ hZ
  obtain ⟨-, -, -, -, hXK, -, -⟩ := Submission.cbr_imRep_measure_basic P n U RX
  obtain ⟨-, -, -, -, hYK, -, -⟩ := Submission.cbr_imRep_measure_basic P n U RY
  obtain ⟨-, -, -, hZM, -, -, -⟩ := Submission.cbr_imRep_measure_basic P n U RZ
  refine Submission.dtc_bc_lc_measure_le_of_le_on_open P U RZ.measure (RX.measure + RY.measure)
    hU ?_ ?_ ?_
  -- Step 3: `μ_Z(ℝᴾ \ U) ≤ μ_Z(ℝᴾ \ M_Z) = 0`, as `M_Z ⊆ U`
  · exact measure_mono_null (compl_subset_compl.2 RZ.carrier_subset) hZM
  -- Step 4: `μ_X(K) + μ_Y(K) < ∞` for compact `K ⊆ U`
  · intro K hK hKU
    rw [Measure.add_apply]
    exact ENNReal.add_lt_top.2 ⟨hXK K hK hKU, hYK K hK hKU⟩
  -- Steps 1–2: `μ_Z(V) = M_V(Z) ≤ M_V(X) + M_V(Y) = μ_X(V) + μ_Y(V)` for open `V ⊆ U`
  · intro V hV hVU
    calc RZ.measure V = Z.massOn V :=
          (Submission.dtc_mass_eq_measure P n U V Z RZ hU hV hVU hRZ).symm
      _ ≤ X.massOn V + Y.massOn V :=
          Submission.lcmp_massOn_le_add_of_eval_eq P n U V X Y Z c hc fun ω _ => hZ ω
      _ = (RX.measure + RY.measure) V := by
          rw [Measure.add_apply, Submission.dtc_mass_eq_measure P n U V X RX hU hV hVU hRX,
            Submission.dtc_mass_eq_measure P n U V Y RY hU hV hVU hRY]

/-- **Simon 7.2.4, local comparison: retraction estimate.**  Let `n = m + 1`, `S ∈ 𝒟ₙ(U)` be
minimizing in `A` with `spt S ⊆ A`, `B̄_G ⊆ U`, and let `π` be `C¹` and `L`-Lipschitz on `B_{2G}`,
with `π(B_{2G}) ⊆ A`, `π = id` on `A ∩ B_{2G}` and `|π(y)| ≤ 2|y|`.  If `Y ∈ 𝒟ₙ(ℝᴾ)` is an integer
multiplicity cycle with compact support in `B_{G/2}`, then `M_{B_G}(S) ≤ Lⁿ M_{B_G}(S + Y)`.
Here `‖Dπ‖ ≤ L` on `B_{2G}`, and `Q = S⌞B_G` is an integer multiplicity current in `ℝᴾ` with
compact support in `B̄_G ∩ spt S ⊆ A`.  `π` fixes `spt Q`, so `π_#Q = Q` and
`π_#(Q + Y) = Q + π_#Y`.  `π_#Y` is an integer multiplicity cycle supported in the compact set
`π(spt Y) ⊆ A ∩ B_G`, so minimality (7.2.4 (9)) gives `M_{B_G}(S) ≤ M_{B_G}(S + π_#Y)`, and
`M_{B_G}(S + π_#Y) = M_{B_G}(π_#(Q + Y)) ≤ Lⁿ M(Q + Y)`.  Finally `μ_{Q+Y} ≤ μ_Q + μ_Y` vanishes
off `B_G`, so `M(Q + Y) = M_{B_G}(Q + Y) = M_{B_G}(S + Y)`. -/
theorem Submission.dtc_bc_lc_retraction_comparison : ∀ (P m : ℕ) (U A : Set (Euclid P)) (S : GeometricCurrentOn U (m + 1)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (π : Euclid P → Euclid P) (G L : ℝ), IsOpen U → IsMinimizingIn S A → S.support ⊆ A → 0 < G → closedBall (0 : Euclid P) G ⊆ U → 0 ≤ L → ContDiffOn ℝ 1 π (ball 0 (2 * G)) → MapsTo π (ball 0 (2 * G)) A → (∀ y ∈ A ∩ ball 0 (2 * G), π y = y) → (∀ y ∈ ball 0 (2 * G), ‖π y‖ ≤ 2 * ‖y‖) → (∀ y ∈ ball 0 (2 * G), ∀ z ∈ ball 0 (2 * G), ‖π y - π z‖ ≤ L * ‖y - z‖) → IsIntegerMultiplicity Y → Y.boundary = 0 → IsCompact Y.support → Y.support ⊆ ball 0 (G / 2) → S.massOn (ball 0 G) ≤ ENNReal.ofReal (L ^ (m + 1)) * (S - (0 - Y.restrictDomain (subset_univ U))).massOn (ball 0 G) := by
  -- the children and the sibling prerequisites used below
  have hPF := Submission.dtc_bc_lc_pushforward
  have hRestr := Submission.dtc_bc_lc_rc_ambient_restriction
  have hComp := Submission.dtc_bc_lc_rc_cycle_competitor
  have hOF := Submission.dtc_bc_lc_orient_fixed
  have hF4 := Submission.dtc_bc_lc_measure_le_add
  have hM := Submission.dtc_mass_eq_measure
  have hV := Submission.dtc_vanish_off_support
  have hIM := Submission.cmc_imRep_locality_restrict_sub
  have hSV := Submission.rsd_cmr_support_subset_of_vanish
  have hAG := Submission.dtc_massOn_eq_of_agreeOn
  intro P m U A S Y π G L hU hmin hsptS hG hGU hL hπC hπA hπfix hπ2 hπLip hYim hYbd hYcpt hYsub
  -- `B_G` is open with `closure B_G = B̄_G ⊆ U` compact; `B̄_G ⊆ B_{2G}`
  have hBopen : IsOpen (ball (0 : Euclid P) G) := isOpen_ball
  have hclos : closure (ball (0 : Euclid P) G) = closedBall 0 G := closure_ball 0 hG.ne'
  have hBcc : CompactlyContained (ball (0 : Euclid P) G) U := by
    refine ⟨?_, ?_⟩
    · rw [hclos]; exact isCompact_closedBall 0 G
    · rw [hclos]; exact hGU
  have hBU : ball (0 : Euclid P) G ⊆ U := ball_subset_closedBall.trans hGU
  have hO : IsOpen (ball (0 : Euclid P) (2 * G)) := isOpen_ball
  have hcb2 : closedBall (0 : Euclid P) G ⊆ ball 0 (2 * G) := closedBall_subset_ball (by linarith)
  have hBB2 : ball (0 : Euclid P) G ⊆ ball 0 (2 * G) := ball_subset_ball (by linarith)
  -- Step 1: `‖Dπ(y)‖ ≤ L` on `B_{2G}`, as `π` is `L`-Lipschitz on this open ball
  have hDπ : ∀ y ∈ ball (0 : Euclid P) (2 * G), ‖fderiv ℝ π y‖ ≤ L := by
    intro y hy
    have hlip : LipschitzOnWith (Real.toNNReal L) π (ball (0 : Euclid P) (2 * G)) := by
      apply LipschitzOnWith.of_dist_le_mul
      intro a ha b hb
      rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ hL]
      exact hπLip a ha b hb
    have := norm_fderiv_le_of_lipschitzOn ℝ (hO.mem_nhds hy) hlip
    simpa [Real.coe_toNNReal _ hL] using this
  -- Step 2: `Q = S⌞B_G` in `ℝᴾ`, represented by `(M ∩ B_G, θ, ξ)`, agreeing with `S` on forms
  -- supported in `B_G`, with compact support in `B̄_G ∩ spt S ⊆ A ∩ B_{2G}`
  obtain ⟨R, hR⟩ := hmin.1
  obtain ⟨Q, RQ, hRQ, hRQc, -, -, hQ1, hQsupp, hQcpt⟩ :=
    hRestr P (m + 1) U (ball 0 G) S R hU hBopen hBcc hR
  have hQsub : Q.support ⊆ ball (0 : Euclid P) (2 * G) := by
    intro y hy
    have h1 := (hQsupp hy).1
    rw [hclos] at h1
    exact hcb2 h1
  have hQA : Q.support ⊆ A := fun y hy => hsptS (hQsupp hy).2
  -- Step 3: the push-forward `π_#` on currents with compact support in `B_{2G}`; `π_#Q = Q`,
  -- since `π x = x` and `ΛⁿDπ(x)` fixes `ξ(x)` for a.e. `x ∈ M ∩ B_G`
  obtain ⟨push, hpushA, hpushB⟩ := hPF P m (ball 0 (2 * G)) π hO hπC
  have hYsub2 : Y.support ⊆ ball (0 : Euclid P) (2 * G) :=
    hYsub.trans (ball_subset_ball (by linarith))
  have hpQ : push Q = Q := by
    have hfix := hOF P (m + 1) univ (ball 0 (2 * G)) Q RQ π isOpen_univ hO hRQ
      (hπC.differentiableOn one_ne_zero) (fun y hy => hπfix y ⟨hQA hy.1, hy.2⟩)
    have hcar : RQ.carrier ∩ ball 0 (2 * G) = RQ.carrier := by
      rw [hRQc]
      exact inter_eq_left.mpr (fun x hx => hBB2 hx.2)
    rw [hcar] at hfix
    obtain ⟨hformula, -⟩ := hpushA Q RQ hRQ hQcpt hQsub
    ext ω
    rw [hformula ω, hRQ ω]
    unfold IMRep.action
    apply integral_congr_ae
    filter_upwards [hfix] with x hx
    rw [hx.1, hx.2]
  -- Step 4: additivity, `π_#0 = 0`, `π_#(0 − Y) = 0 − π_#Y` and `π_#(Q + Y) = Q + π_#Y`
  have h0im : IsIntegerMultiplicity (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) := by
    have h := hIM.2.2.1 P (m + 1) univ Y Y isOpen_univ hYim hYim
    have h' : Y - Y = 0 := by
      ext ω
      show Y ω - Y ω = 0
      ring
    rwa [h'] at h
  have h0spt := hSV P (m + 1) univ ∅ (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
    isOpen_univ isCompact_empty (empty_subset _) (fun ω _ => rfl)
  have h0sub : (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)).support ⊆
      ball 0 (2 * G) := h0spt.1.trans (empty_subset _)
  have hp0 : push 0 = 0 := by
    have h := hpushB 0 0 h0im h0im h0spt.2 h0sub h0spt.2 h0sub
    have h00 : (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) - 0 = 0 := by
      ext ω
      show (0 : ℝ) - 0 = 0
      ring
    rw [h00] at h
    ext ω
    have hω := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => T ω) h
    change push 0 ω = push 0 ω - push 0 ω at hω
    show push 0 ω = 0
    linarith
  have hnYim : IsIntegerMultiplicity (0 - Y) := hIM.2.2.1 P (m + 1) univ 0 Y isOpen_univ h0im hYim
  have hnYspt := hSV P (m + 1) univ Y.support (0 - Y) isOpen_univ hYcpt (subset_univ _)
    (fun ω hω => by
      show (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) ω - Y ω = 0
      rw [hV P (m + 1) univ Y ω hω, sub_zero]
      rfl)
  have hpnY : push (0 - Y) = 0 - push Y := by
    rw [hpushB 0 Y h0im hYim h0spt.2 h0sub hYcpt hYsub2, hp0]
  have hQYim : IsIntegerMultiplicity (Q - (0 - Y)) :=
    hIM.2.2.1 P (m + 1) univ Q (0 - Y) isOpen_univ ⟨RQ, hRQ⟩ hnYim
  have hQYspt := hSV P (m + 1) univ (Q.support ∪ Y.support) (Q - (0 - Y)) isOpen_univ
    (hQcpt.union hYcpt) (subset_univ _) (fun ω hω => by
      have h1 := hV P (m + 1) univ Q ω (Disjoint.mono_right subset_union_left hω)
      have h2 := hV P (m + 1) univ Y ω (Disjoint.mono_right subset_union_right hω)
      show Q ω - ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) ω - Y ω) = 0
      rw [h1, h2]
      show (0 : ℝ) - (0 - 0) = 0
      ring)
  have hQYsub : (Q - (0 - Y)).support ⊆ ball 0 (2 * G) :=
    hQYspt.1.trans (union_subset hQsub hYsub2)
  have hpQY : push (Q - (0 - Y)) = Q - (0 - push Y) := by
    rw [hpushB Q (0 - Y) ⟨RQ, hRQ⟩ hnYim hQcpt hQsub hnYspt.2 (hnYspt.1.trans hYsub2), hpQ, hpnY]
  -- Step 5: `π_#Y` is an integer multiplicity cycle supported in the compact set
  -- `π(spt Y) ⊆ A ∩ B_G`, so minimality gives `M_{B_G}(S) ≤ M_{B_G}(S + (π_#Y)|_U)`
  obtain ⟨RY, hRY⟩ := hYim
  obtain ⟨-, hpYim, hpYspt, -, hpYbd⟩ := hpushA Y RY hRY hYcpt hYsub2
  have hKcpt : IsCompact (π '' Y.support) :=
    hYcpt.image_of_continuousOn (hπC.continuousOn.mono hYsub2)
  have hKsub : π '' Y.support ⊆ A ∩ ball 0 G := by
    rintro _ ⟨y, hy, rfl⟩
    have hy2 := hYsub2 hy
    refine ⟨hπA hy2, ?_⟩
    have h1 := hπ2 y hy2
    have h2 : ‖y‖ < G / 2 := by simpa using hYsub hy
    rw [mem_ball_zero_iff]
    linarith
  have hcomp := hComp P m U A (ball 0 G) (π '' Y.support) S (push Y) hU hmin hBopen hBcc hpYim
    (hpYbd hYbd) hKcpt hpYspt hKsub
  -- Step 6(a): `M_{B_G}(S + (π_#Y)|_U) = M_{B_G}(π_#(Q + Y))`, by (Q1)
  have h6a : (S - (0 - (push Y).restrictDomain (subset_univ U))).massOn (ball 0 G) =
      (push (Q - (0 - Y))).massOn (ball 0 G) := by
    symm
    apply hAG P (m + 1) univ U (ball 0 G) (subset_univ U) (push (Q - (0 - Y))) _ hBU
    intro ω hω
    rw [hpQY]
    show Q (testFormOnInclusion (subset_univ U) (m + 1) ω) -
        ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
          (testFormOnInclusion (subset_univ U) (m + 1) ω) -
          push Y (testFormOnInclusion (subset_univ U) (m + 1) ω)) =
      S ω - ((0 : GeometricCurrentOn U (m + 1)) ω -
        push Y (testFormOnInclusion (subset_univ U) (m + 1) ω))
    rw [hQ1 ω hω]
    rfl
  -- Step 6(b): `M(π_#(Q + Y)) ≤ Lⁿ M(Q + Y)`
  obtain ⟨RQY, hRQY⟩ := hQYim
  obtain ⟨-, -, -, hpmass, -⟩ := hpushA (Q - (0 - Y)) RQY hRQY hQYspt.2 hQYsub
  have h6b := hpmass L hDπ
  -- Step 6(c): `μ_{Q+Y} ≤ μ_Q + μ_Y` vanishes off `B_G`, so `M(Q + Y) = M_{B_G}(Q + Y)`
  have hF := hF4 P (m + 1) univ Q Y (Q - (0 - Y)) RQ RY RQY 1 isOpen_univ (by simp) hRQ hRY hRQY
    (fun ω => by
      show Q ω - ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) ω - Y ω) = Q ω + 1 * Y ω
      rw [GeometricCurrentOn.zero_apply]
      ring)
  have hQc : RQ.measure (ball (0 : Euclid P) G)ᶜ = 0 := by
    unfold IMRep.measure
    apply withDensity_absolutelyContinuous
    rw [Measure.restrict_apply measurableSet_ball.compl, hRQc]
    have : (ball (0 : Euclid P) G)ᶜ ∩ (R.carrier ∩ ball 0 G) = ∅ := by
      ext x
      simp only [mem_inter_iff, mem_compl_iff, mem_empty_iff_false, iff_false, not_and]
      intro h1 _ h2
      exact h1 h2
    rw [this, measure_empty]
  have hYc : RY.measure (ball (0 : Euclid P) G)ᶜ = 0 := by
    have h1 : RY.measure (Y.support)ᶜ = 0 := by
      rw [← hM P (m + 1) univ (Y.support)ᶜ Y RY isOpen_univ hYcpt.isClosed.isOpen_compl
        (subset_univ _) hRY]
      apply le_zero_iff.mp
      apply sSup_le
      rintro r ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (Y ω) ≤ 0
      rw [hV P (m + 1) univ Y ω (Set.subset_compl_iff_disjoint_right.mp hω.1),
        ENNReal.ofReal_zero]
    apply measure_mono_null _ h1
    exact compl_subset_compl.mpr (hYsub.trans (ball_subset_ball (by linarith)))
  have hQYc : RQY.measure (ball (0 : Euclid P) G)ᶜ = 0 := by
    have h := Measure.le_iff'.mp hF (ball (0 : Euclid P) G)ᶜ
    rw [Measure.add_apply, hQc, hYc, add_zero] at h
    exact le_zero_iff.mp h
  have h6c : (Q - (0 - Y)).mass = (Q - (0 - Y)).massOn (ball 0 G) := by
    show (Q - (0 - Y)).massOn univ = (Q - (0 - Y)).massOn (ball 0 G)
    rw [hM P (m + 1) univ univ (Q - (0 - Y)) RQY isOpen_univ isOpen_univ subset_rfl hRQY,
      hM P (m + 1) univ (ball 0 G) (Q - (0 - Y)) RQY isOpen_univ hBopen (subset_univ _) hRQY,
      ← measure_add_measure_compl (measurableSet_ball : MeasurableSet (ball (0 : Euclid P) G)),
      hQYc, add_zero]
  -- Step 6(d): `M_{B_G}(Q + Y) = M_{B_G}(S + Y|_U)`, by (Q1)
  have h6d : (Q - (0 - Y)).massOn (ball 0 G) =
      (S - (0 - Y.restrictDomain (subset_univ U))).massOn (ball 0 G) := by
    apply hAG P (m + 1) univ U (ball 0 G) (subset_univ U) (Q - (0 - Y)) _ hBU
    intro ω hω
    show Q (testFormOnInclusion (subset_univ U) (m + 1) ω) -
        ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
          (testFormOnInclusion (subset_univ U) (m + 1) ω) -
          Y (testFormOnInclusion (subset_univ U) (m + 1) ω)) =
      S ω - ((0 : GeometricCurrentOn U (m + 1)) ω -
        Y (testFormOnInclusion (subset_univ U) (m + 1) ω))
    rw [hQ1 ω hω]
    rfl
  -- Step 7: the chain of inequalities
  calc S.massOn (ball 0 G)
      ≤ (S - (0 - (push Y).restrictDomain (subset_univ U))).massOn (ball 0 G) := hcomp
    _ = (push (Q - (0 - Y))).massOn (ball 0 G) := h6a
    _ ≤ (push (Q - (0 - Y))).mass := GeometricCurrentOn.massOn_mono _ (subset_univ _)
    _ ≤ ENNReal.ofReal (L ^ (m + 1)) * (Q - (0 - Y)).mass := h6b
    _ = ENNReal.ofReal (L ^ (m + 1)) * (Q - (0 - Y)).massOn (ball 0 G) := by rw [h6c]
    _ = ENNReal.ofReal (L ^ (m + 1)) *
        (S - (0 - Y.restrictDomain (subset_univ U))).massOn (ball 0 G) := by rw [h6d]
/-- **Simon 7.2.4, proof (3)–(5)** (choice of the level `α`): given countably many properties of
`t ∈ ℝ`, each holding for `L¹`-a.e. `t`, functions `gᵢ ≥ 0` on `(a, b)` with
`Σᵢ ∫_{(a,b)} gᵢ < ∞`, and measures `μᵢ` with `μᵢ{a < h < b} < ∞`, some `t ∈ (a, b)` satisfies
every property, has `Σᵢ gᵢ(t) < ∞` and `μᵢ{h = t} = 0` for all `i`.  The failures of the
properties form a null set; `Σᵢ gᵢ` has finite integral over `(a, b)`, hence is finite a.e.;
the disjoint level sets `{h = t}` carry mass of the finite measure `μᵢ⌞{a < h < b}` for at most
countably many `t`; and `(a, b)` has positive measure. -/
theorem Submission.dtc_bc_lc_good_level : ∀ (P : ℕ) (g : ℕ → ℝ → ℝ≥0∞) (μ : ℕ → Measure (Euclid P)) (h : Euclid P → ℝ) (good : ℕ → ℝ → Prop) (a b : ℝ), a < b → Measurable h → (∀ i, AEMeasurable (g i) (volume.restrict (Ioo a b))) → (∑' i, ∫⁻ t in Ioo a b, g i t) ≠ ∞ → (∀ i, μ i {x | a < h x ∧ h x < b} ≠ ∞) → (∀ i, ∀ᵐ t, good i t) → ∃ t ∈ Ioo a b, (∀ i, good i t) ∧ (∑' i, g i t) ≠ ∞ ∧ ∀ i, μ i {x | h x = t} = 0 := by
  intro P g μ h good a b hab hh hg hsum hμ hgood
  set S : Set (Euclid P) := {x | a < h x ∧ h x < b}
  -- for each `i`, only countably many levels `t` have `μᵢ⌞S {h = t} > 0`
  have hC : ∀ i, {t : ℝ | 0 < (μ i).restrict S {x | h x = t}}.Countable := by
    intro i
    have : IsFiniteMeasure ((μ i).restrict S) := isFiniteMeasure_restrict.2 (hμ i)
    exact Measure.countable_meas_level_set_pos hh
  -- `∫_{(a,b)} Σᵢ gᵢ = Σᵢ ∫_{(a,b)} gᵢ < ∞`, so `Σᵢ gᵢ < ∞` a.e. on `(a, b)`
  have hfin : ∀ᵐ t ∂(volume.restrict (Ioo a b)), ∑' i, g i t < ∞ := by
    refine ae_lt_top' (AEMeasurable.tsum hg) ?_
    rwa [lintegral_tsum hg]
  have hall : ∀ᵐ t ∂(volume.restrict (Ioo a b)), t ∈ Ioo a b ∧ (∀ i, good i t) ∧
      ∑' i, g i t < ∞ ∧ t ∉ ⋃ i, {t : ℝ | 0 < (μ i).restrict S {x | h x = t}} := by
    filter_upwards [ae_restrict_mem measurableSet_Ioo, ae_restrict_of_ae (ae_all_iff.2 hgood),
      hfin, ae_restrict_of_ae ((countable_iUnion hC).ae_notMem volume)] with t h₁ h₂ h₃ h₄
    exact ⟨h₁, h₂, h₃, h₄⟩
  -- `(a, b)` has positive measure
  have : (ae (volume.restrict (Ioo a b))).NeBot := by
    refine ae_neBot.2 fun h₀ => ?_
    rw [Measure.restrict_eq_zero, Real.volume_Ioo] at h₀
    exact (ENNReal.ofReal_pos.2 (sub_pos.2 hab)).ne' h₀
  obtain ⟨t, ht, hgt, hst, hCt⟩ := hall.exists
  refine ⟨t, ht, hgt, hst.ne, fun i => ?_⟩
  have hS : {x | h x = t} ⊆ S := fun x (hx : h x = t) => show a < h x ∧ h x < b from hx ▸ ht
  rw [← Measure.restrict_eq_self (μ i) hS]
  exact nonpos_iff_eq_zero.1 (not_lt.1 fun hpos => hCt (mem_iUnion.2 ⟨i, hpos⟩))
/-- **Simon 7.2.4, (12)–(13)** (upper bound on compact sets): let `μ` be finite on compact
subsets of `ℝᴾ`, and suppose that for every compact `K`, `ε > 0` and subsequence `ψ` there are
`K ⊆ W ⊆ thickening ε K` and a further subsequence `φ'` with `limsup_i μ_{ψ(φ'(i))}(W) ≤ μ(W)`.
Then `limsup_j μ_j(K) ≤ μ(K)` for every compact `K`.  If `μ(thickening ε K) < b < limsup_j μ_j(K)`,
then `μ_{ψ(i)}(K) > b` along a subsequence `ψ`, and
`b ≤ limsup_i μ_{ψ(φ'(i))}(W) ≤ μ(W) ≤ μ(thickening ε K) < b`.  Hence
`limsup_j μ_j(K) ≤ μ(thickening ε K)` for every `ε > 0`, and `μ(thickening ε K) → μ(K)` as
`ε ↓ 0` by continuity from above (`K` is closed and `μ(thickening 1 K) ≤ μ(cthickening 1 K) < ∞`).
-/
theorem Submission.dtc_bc_mm_limsup_le_of_subseq : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ limsup (fun i => μs (ψ (φ' i)) W) atTop ≤ μ W) → ∀ K : Set (Euclid P), IsCompact K → limsup (fun j => μs j K) atTop ≤ μ K := by
  intro P μs μ hfin hsub K hK
  -- `limsup_j μ_j(K) ≤ μ(thickening ε K)` for every `ε > 0`.
  have hthick : ∀ ε : ℝ, 0 < ε → limsup (fun j => μs j K) atTop ≤ μ (thickening ε K) := by
    intro ε hε
    by_contra hlt
    obtain ⟨b, hab, hbL⟩ := exists_between (not_le.mp hlt)
    obtain ⟨ψ, hψ, hψb⟩ := extraction_of_frequently_atTop (frequently_lt_of_lt_limsup (h := hbL))
    obtain ⟨W, hKW, hWε, φ', -, hW⟩ := hsub K ε hK hε ψ hψ
    have hb : b ≤ limsup (fun i => μs (ψ (φ' i)) W) atTop :=
      le_limsup_of_frequently_le (Frequently.of_forall fun i =>
        (hψb (φ' i)).le.trans (measure_mono hKW))
    exact (hb.trans (hW.trans (measure_mono hWε))).not_gt hab
  -- Continuity from above: `μ(thickening r K) → μ(K)` as `r ↓ 0`.
  have hT : Tendsto (fun r => μ (thickening r K)) (𝓝[>] 0) (𝓝 (μ K)) :=
    tendsto_measure_thickening_of_isClosed ⟨1, one_pos, ((measure_mono
      (thickening_subset_cthickening 1 K)).trans_lt (hfin _ hK.cthickening)).ne⟩ hK.isClosed
  exact ge_of_tendsto hT (eventually_nhdsWithin_of_forall hthick)

/-- **Simon 7.2.4, (8)**, localized (minimality of the limit `C`).  For a competitor `S` with
`K = spt(S − C)` compact and `K ⊆ W`, pick `ε > 0` with `thickening ε K ⊆ W`; the local comparison
with `ψ = id` gives an open `W'`, `K ⊆ W' ⊆ W`, and `φ'` with `limsup M_{W'}(S_{φ'(i)}) ≤ M_{W'}(S)`,
so `M_{W'}(C) ≤ liminf M_{W'}(S_{φ'(i)}) ≤ M_{W'}(S)` by lower semicontinuity of mass.  Off `K` the
currents `S` and `C` agree, so their weights `μ_S, μ_C` agree on the Borel set `W \ W' ⊆ ℝᴾ \ K`,
and `M_W(C) = μ_C(W') + μ_C(W \ W') ≤ μ_S(W') + μ_S(W \ W') = M_W(S)`. -/
theorem Submission.dtc_bc_mm_isMinimizingIn_univ : ∀ (P n : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → IsIntegerMultiplicity C → ConvergesWeakly Ss C → (∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ ∀ S : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity S → SameBoundary S C → (S - C).support ⊆ K → limsup (fun j => (Ss (ψ (φ' j))).massOn W) atTop ≤ S.massOn W) → IsMinimizingIn C univ := by
  intro P n Us Ss C hUs hC hconv hcomp
  refine ⟨hC, fun W S hW _ hS hbd hKc hsub => ?_⟩
  -- `K = spt(S − C)` is a compact subset of `W`; pick `ε > 0` with `thickening ε K ⊆ W`
  set K := (S - C).support
  have hKW : K ⊆ W := fun x hx => (hsub hx).2
  obtain ⟨ε, hε, hεW⟩ := hKc.exists_thickening_subset_open hW hKW
  -- the local comparison with `ψ = id`: `K ⊆ W' ⊆ W`, `limsup M_{W'}(S_{φ'(i)}) ≤ M_{W'}(S)`
  obtain ⟨W', hW'o, hKW', hW'ε, φ', hφ', hcmp⟩ := hcomp K ε hKc hε id strictMono_id
  have hW'W : W' ⊆ W := hW'ε.trans hεW
  -- lower semicontinuity: `M_{W'}(C) ≤ liminf M_{W'}(S_{φ'(i)}) ≤ limsup ≤ M_{W'}(S)`
  have hCS : C.massOn W' ≤ S.massOn W' :=
    le_trans (Submission.dtc_bc_mm_massOn_le_liminf P n Us Ss C hUs hconv φ' hφ' W')
      (le_trans liminf_le_limsup (hcmp S hS hbd subset_rfl))
  -- on open sets the masses are the weights `μ_C = μ_{R_C}` and `μ_S = μ_{R_S}`
  obtain ⟨RC, hRC⟩ := hC
  obtain ⟨RS, hRS⟩ := hS
  have hmC := Submission.cmc_massOn_eq_imRep_measure P n univ C RC isOpen_univ hRC
  have hmS := Submission.cmc_massOn_eq_imRep_measure P n univ S RS isOpen_univ hRS
  -- `μ_S = μ_C` on the open subsets of `ℝᴾ \ K` (there `S = C`), hence on its Borel subsets
  have hagree : ∀ A : Set (Euclid P), MeasurableSet A → A ⊆ Kᶜ → RS.measure A = RC.measure A :=
    Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P Kᶜ RS.measure RC.measure
      hKc.isClosed.isOpen_compl
      (fun K' hK' _ =>
        (Submission.rsd_imrep_compact_measure_ne_top P n univ RS K' hK' (subset_univ _)).2)
      (fun G hG hGK => by
        rw [← hmS G hG, ← hmC G hG]
        exact Submission.cmc_ml_massOn_eq_of_disjoint_sub_support P n univ S C K G subset_rfl
          (subset_compl_iff_disjoint_right.mp hGK))
  have hdiff : RS.measure (W \ W') = RC.measure (W \ W') :=
    hagree _ (hW.measurableSet.diff hW'o.measurableSet) fun x hx hxK => hx.2 (hKW' hxK)
  -- additivity: `M_W(C) = μ_C(W') + μ_C(W \ W') ≤ μ_S(W') + μ_S(W \ W') = M_W(S)`
  have hsplit : ∀ μ : Measure (Euclid P), μ W' + μ (W \ W') = μ W := fun μ => by
    rw [← measure_inter_add_sdiff W hW'o.measurableSet, inter_eq_right.mpr hW'W]
  calc C.massOn W = RC.measure W' + RC.measure (W \ W') := by rw [hmC W hW, hsplit]
    _ ≤ RS.measure W' + RS.measure (W \ W') := by
        rw [← hmC W' hW'o, ← hmS W' hW'o, hdiff]
        exact add_le_add hCS le_rfl
    _ = S.massOn W := by rw [hmS W hW, hsplit]
/-- **Simon 7.2.4 (12)–(14)** (chapter-07.txt lines 260–288): for the weights `μⱼ = θⱼ Hⁿ⌞Mⱼ`
of `Sⱼ = τ(Mⱼ, θⱼ, ξⱼ)` and `μ = θ Hⁿ⌞M` of `C = τ(M, θ, ξ)`, (a) `μ(K) < ∞` and (b)
`limsup_j μⱼ(K) ≤ μ(K)` for compact `K`, and (c) `μ(G) ≤ liminf_j μⱼ(G)` for bounded open `G`.
On open sets mass is the weight (Simon 6.3.2(3)); (c) is the lower semicontinuity of mass, and
(b) is the local comparison with the admissible competitor `S = C`, passed to the whole sequence
by the subsequence-of-subsequence criterion (lines 278–280). -/
theorem Submission.dtc_bc_mm_measure_bounds : ∀ (P n : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ j, IsOpen (Us j)) → (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → ConvergesWeakly Ss C → (∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ ∀ S : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity S → SameBoundary S C → (S - C).support ⊆ K → limsup (fun j => (Ss (ψ (φ' j))).massOn W) atTop ≤ S.massOn W) → ∀ Rs : (j : ℕ) → IMRep (Us j) n, (∀ j, (Rs j).Represents (Ss j)) → ∀ R : IMRep (univ : Set (Euclid P)) n, R.Represents C → (∀ K : Set (Euclid P), IsCompact K → R.measure K < ∞) ∧ (∀ K : Set (Euclid P), IsCompact K → limsup (fun j => (Rs j).measure K) atTop ≤ R.measure K) ∧ (∀ G : Set (Euclid P), IsOpen G → Bornology.IsBounded G → R.measure G ≤ liminf (fun j => (Rs j).measure G) atTop) := by
  intro P n Us Ss C hUs hexh hconv hloc Rs hRs R hR
  -- on open sets mass is the weight: `M_G(C) = μ(G)` and `M_G(Sⱼ) = μⱼ(G)`
  have hC : ∀ G : Set (Euclid P), IsOpen G → C.massOn G = R.measure G := fun G hG =>
    Submission.cmc_massOn_eq_imRep_measure P n univ C R isOpen_univ hR G hG
  have hS : ∀ G : Set (Euclid P), IsOpen G → ∀ j, (Ss j).massOn G = (Rs j).measure G :=
    fun G hG j =>
      Submission.cmc_massOn_eq_imRep_measure P n (Us j) (Ss j) (Rs j) (hUs j) (hRs j) G hG
  -- (a): `μ(K) = ∫_{M ∩ K} θ dHⁿ < ∞`
  have ha : ∀ K : Set (Euclid P), IsCompact K → R.measure K < ∞ := fun K hK =>
    lt_top_iff_ne_top.2
      (Submission.rsd_imrep_compact_measure_ne_top P n univ R K hK (subset_univ K)).2
  -- `C` is an admissible competitor for itself: `∂C = ∂C`, and `spt(C − C) = ∅` since `C − C`
  -- vanishes on every ball `B₁(x)`, whose closure is compact
  have hsame : SameBoundary C C := by
    cases n
    · trivial
    · rfl
  have hspt : ∀ K : Set (Euclid P), (C - C).support ⊆ K := by
    intro K x hx
    have hx' : x ∈ univ \ (C - C).zeroRegion := hx
    refine absurd (mem_sUnion.2 ⟨ball x 1, ?_, mem_ball_self one_pos⟩) hx'.2
    refine ⟨isOpen_ball, isBounded_ball.isCompact_closure, subset_univ _, fun ω _ => ?_⟩
    exact sub_self (C ω)
  refine ⟨ha, ?_, ?_⟩
  · -- (b): the comparison with `S = C` gives `limsup_i μ_{ψ(φ'(i))}(W) ≤ μ(W)` on the open
    -- `W ⊇ K` it provides, the hypothesis of the subsequence criterion
    refine Submission.dtc_bc_mm_limsup_le_of_subseq P (fun j => (Rs j).measure) R.measure ha ?_
    intro K ε hK hε ψ hψ
    obtain ⟨W, hW, hKW, hWK, φ', hφ', hcmp⟩ := hloc K ε hK hε ψ hψ
    refine ⟨W, hKW, hWK, φ', hφ', ?_⟩
    calc limsup (fun i => (Rs (ψ (φ' i))).measure W) atTop
        = limsup (fun i => (Ss (ψ (φ' i))).massOn W) atTop := by
          congr 1; funext i; exact (hS W hW _).symm
      _ ≤ C.massOn W := hcmp C ⟨R, hR⟩ hsame (hspt K)
      _ = R.measure W := hC W hW
  · -- (c): lower semicontinuity of mass along the whole sequence (`φ = id`)
    intro G hG _
    calc R.measure G = C.massOn G := (hC G hG).symm
      _ ≤ liminf (fun i => (Ss (id i)).massOn G) atTop :=
          Submission.dtc_bc_mm_massOn_le_liminf P n Us Ss C hexh hconv id strictMono_id G
      _ = liminf (fun j => (Rs j).measure G) atTop := by
          congr 1; funext j; exact hS G hG j

/-- **Simon 6.3.2(3), 6.2.16** (locality of the weight measure).  If `R₁, R₂` represent
`T₁ ∈ 𝒟ₙ(U₁)`, `T₂ ∈ 𝒟ₙ(U₂)` and `T₁ = T₂` in the open set `W ⊆ U₁ ∩ U₂`, then
`μ_{R₁}⌞W = μ_{R₂}⌞W`.  For open `G ⊆ W` the admissible forms for `M_G(Tᵢ)` are forms in
`𝒟ⁿ(W)`, on which `T₁, T₂` agree, so `μ_{R₁}(G) = M_G(T₁) = M_G(T₂) = μ_{R₂}(G)`; as `μ_{R₁}` is
finite on compact subsets of `W`, the two measures agree on every Borel subset of `W`. -/
theorem Submission.dtc_bc_measure_restrict_eq_of_eqOn : ∀ (P n : ℕ) (U₁ U₂ W : Set (Euclid P)) (T₁ : GeometricCurrentOn U₁ n) (T₂ : GeometricCurrentOn U₂ n) (R₁ : IMRep U₁ n) (R₂ : IMRep U₂ n), IsOpen U₁ → IsOpen U₂ → IsOpen W → W ⊆ U₁ → W ⊆ U₂ → R₁.Represents T₁ → R₂.Represents T₂ → (∀ ω : TestFormOn W n, currentEval T₁ (ω : DifferentialForm (Euclid P) n) = currentEval T₂ (ω : DifferentialForm (Euclid P) n)) → R₁.measure.restrict W = R₂.measure.restrict W := by
  intro P n U₁ U₂ W T₁ T₂ R₁ R₂ hU₁ hU₂ hW hWU₁ hWU₂ hR₁ hR₂ hT
  -- `ω ∈ 𝒟ⁿ(W)` regarded in `𝒟ⁿ(Uᵢ)`: `Tᵢ(ω) = currentEval Tᵢ ω`
  have hev₁ : ∀ ω : TestFormOn W n,
      T₁ (testFormOnInclusion hWU₁ n ω) = currentEval T₁ (ω : DifferentialForm (Euclid P) n) := by
    intro ω
    rw [currentEval, dite_eq_left ⟨ω.property.1, ω.property.2.trans hWU₁⟩]
    rfl
  have hev₂ : ∀ ω : TestFormOn W n,
      T₂ (testFormOnInclusion hWU₂ n ω) = currentEval T₂ (ω : DifferentialForm (Euclid P) n) := by
    intro ω
    rw [currentEval, dite_eq_left ⟨ω.property.1, ω.property.2.trans hWU₂⟩]
    rfl
  -- 1. `M_G(T₁) = M_G(T₂⌞W) = M_G(T₂)` for `G ⊆ W`
  have hmass : ∀ G : Set (Euclid P), G ⊆ W → T₁.massOn G = T₂.massOn G := by
    intro G hGW
    rw [Submission.dtc_massOn_eq_of_agreeOn P n U₁ W G hWU₁ T₁ (T₂.restrictDomain hWU₂) hGW
        fun ω _ => by rw [GeometricCurrentOn.restrictDomain_apply, hev₁, hev₂, hT],
      Submission.dtc_massOn_eq_of_agreeOn P n U₂ W G hWU₂ T₂ (T₂.restrictDomain hWU₂) hGW
        fun ω _ => rfl]
  -- 2. `μ_{R₁}(G) = M_G(T₁) = M_G(T₂) = μ_{R₂}(G)` for open `G ⊆ W`
  have hopen : ∀ G : Set (Euclid P), IsOpen G → G ⊆ W → R₁.measure G = R₂.measure G := by
    intro G hG hGW
    rw [← Submission.dtc_mass_eq_measure P n U₁ G T₁ R₁ hU₁ hG (hGW.trans hWU₁) hR₁,
      ← Submission.dtc_mass_eq_measure P n U₂ G T₂ R₂ hU₂ hG (hGW.trans hWU₂) hR₂, hmass G hGW]
  -- 3. `μ_{R₁}(C) < ∞` for compact `C ⊆ W ⊆ U₁`
  have hfin : ∀ C : Set (Euclid P), IsCompact C → C ⊆ W → R₁.measure C ≠ ∞ := fun C hC hCW =>
    (Submission.rsd_imrep_compact_measure_ne_top P n U₁ R₁ C hC (hCW.trans hWU₁)).2
  -- 4. hence `μ_{R₁}(B ∩ W) = μ_{R₂}(B ∩ W)` for Borel `B`
  ext B hB
  rw [Measure.restrict_apply hB, Measure.restrict_apply hB]
  exact Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P W R₁.measure R₂.measure hW hfin
    hopen (B ∩ W) (hB.inter hW.measurableSet) inter_subset_right
/-- A constant multiple `X = c[[ℝⁿ]]` (`n ≥ 1`) with compact support is zero (step 6 of
`dtc_bc_cz_isMinimizingIn`): if `X(ω) = c ∫ ω(y)(e₁, …, eₙ) dy` for every `ω ∈ 𝒟ⁿ(ℝⁿ)` and
`spt X` is compact, then `c = 0`.  Take `r₀` with `spt X ⊆ B̄_{r₀}(0)` and `p = (|r₀| + 2)e₁`,
so `‖p‖ = |r₀| + 2`.  A test form `ω` with `spt ω ⊆ B̄₁(p)` and `∫ ω(y)(e₁, …, eₙ) dy > 0` has
`spt ω ∩ spt X = ∅`, since `‖p‖ ≤ ‖y‖ + ‖y − p‖ ≤ r₀ + 1` for `y` in both.  Hence `X(ω) = 0`
(Simon 6.2.11), so `c ∫ ω(y)(e₁, …, eₙ) dy = 0` and `c = 0`. -/
theorem Submission.dtc_bc_cz_isMinimizingIn_const_eq_zero : ∀ (n : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid n)) n) (c : ℝ), 0 < n → IsCompact X.support → (∀ ω : TestFormOn (univ : Set (Euclid n)) n, X ω = c * ∫ y, (ω : DifferentialForm (Euclid n) n) y ⇑(EuclideanSpace.basisFun (Fin n) ℝ)) → c = 0 := by
  intro n X c hn hX hXc
  -- Step 1: `spt X ⊆ B̄(0, r₀)`, `spt X` being compact
  obtain ⟨r₀, hr₀⟩ := hX.isBounded.subset_closedBall (0 : Euclid n)
  -- Step 2: `p = (|r₀| + 2) e₁` (`n ≥ 1`) has `‖p‖ = |r₀| + 2`
  obtain ⟨p, hpn⟩ : ∃ p : Euclid n, ‖p‖ = |r₀| + 2 :=
    ⟨(|r₀| + 2) • EuclideanSpace.single (⟨0, hn⟩ : Fin n) (1 : ℝ), by
      rw [norm_smul, PiLp.norm_single, norm_one, mul_one, Real.norm_eq_abs,
        abs_of_pos (by positivity)]⟩
  -- Step 3 (child `bump_form`): `ω` with `spt ω ⊆ B̄(p, 1)` and `∫ ω(y)(e) dy > 0`
  obtain ⟨ω, hωs, hωI⟩ := Submission.dtc_bc_cz_isMinimizingIn_bump_form n p 1 one_pos
  -- Step 4: `spt ω ∩ spt X = ∅`, as `‖p‖ ≤ ‖y‖ + ‖y − p‖ ≤ r₀ + 1 < |r₀| + 2` on it
  have hdisj : Disjoint (tsupport (ω : DifferentialForm (Euclid n) n)) X.support := by
    refine Set.disjoint_left.mpr fun y hyω hyX => ?_
    have h1 : ‖y - p‖ ≤ 1 := mem_closedBall_iff_norm.mp (hωs hyω)
    have h2 : ‖y‖ ≤ r₀ := mem_closedBall_zero_iff.mp (hr₀ hyX)
    have h3 : ‖p‖ ≤ ‖y‖ + ‖y - p‖ := by
      simpa only [sub_sub_cancel] using norm_sub_le y (y - p)
    linarith [le_abs_self r₀]
  -- Step 5 (`dtc_vanish_off_support`): `X(ω) = 0`
  have hX0 : X ω = 0 := Submission.dtc_vanish_off_support n n univ X ω hdisj
  -- Step 6: `c ∫ ω(y)(e) dy = 0` with a positive integral, so `c = 0`
  rw [hXc ω] at hX0
  exact (mul_eq_zero.mp hX0).resolve_right hωI.ne'

/-- **Simon 6.2.13, 6.2.16, 7.2.4 and Remark 7.2.5(1)** (eventual local agreement with a limit
current).  Assume measure locality (the type of `dtc_bc_measure_restrict_eq_of_eqOn`).  Let
`Sⱼ ∈ 𝒟ₙ(Uⱼ)`, `n = m + 1`, `Uⱼ` open, and `C ∈ 𝒟ₙ(ℝᴾ)`, and suppose that for every `R`, for all
large `j`: `B_R(0) ⊆ Uⱼ`, `Sⱼ(ω) = C(ω)` if `spt ω ⊆ B_R(0)`, and `∂Sⱼ(β) = 0` if
`spt β ⊆ B_R(0)`.  Then `Sⱼ ⇀ C`, `μ_{Sⱼ} → μ_C` and `∂C = 0`.  Every compact set lies in some
ball `B_R(0)`: so `Sⱼ(ω) = C(ω)` for large `j`; for `spt f ⊆ B_R(0)` measure locality gives
`μ_{Sⱼ}⌞B_R(0) = μ_C⌞B_R(0)`, hence `∫ f dμ_{Sⱼ} = ∫ f dμ_C`, for large `j`; and
`∂C(β) = C(dβ) = Sⱼ(dβ) = ∂Sⱼ(β) = 0`. -/
theorem Submission.dtc_bc_cz_local_agreement : (∀ (P n : ℕ) (U₁ U₂ W : Set (Euclid P)) (T₁ : GeometricCurrentOn U₁ n) (T₂ : GeometricCurrentOn U₂ n) (R₁ : IMRep U₁ n) (R₂ : IMRep U₂ n), IsOpen U₁ → IsOpen U₂ → IsOpen W → W ⊆ U₁ → W ⊆ U₂ → R₁.Represents T₁ → R₂.Represents T₂ → (∀ ω : TestFormOn W n, currentEval T₁ (ω : DifferentialForm (Euclid P) n) = currentEval T₂ (ω : DifferentialForm (Euclid P) n)) → R₁.measure.restrict W = R₂.measure.restrict W) → ∀ (P m : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) (m + 1)) (C : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ j, IsOpen (Us j)) → (∀ R : ℝ, ∀ᶠ j in atTop, ball (0 : Euclid P) R ⊆ Us j ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 R → currentEval (Ss j) (ω : DifferentialForm (Euclid P) (m + 1)) = C ω) ∧ ∀ β : TestFormOn (Us j) m, tsupport (β : DifferentialForm (Euclid P) m) ⊆ ball 0 R → (Ss j).boundary β = 0) → ConvergesWeakly Ss C ∧ MassMeasuresConverge Ss C ∧ C.boundary = 0 := by
  intro hmeas P m Us Ss C hUs hagree
  refine ⟨?_, ?_, ?_⟩
  · -- 1. `spt ω ⊆ B_r(0)` for some `r`, so `Sⱼ(ω) = C(ω)` for all large `j`
    intro ω
    obtain ⟨r, hr⟩ := ω.property.1.2.isCompact.isBounded.subset_ball (0 : Euclid P)
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [hagree r] with j hj
    exact (hj.2.1 ω hr).symm
  · -- 2. `spt f ⊆ B_r(0)` for some `r`, so `f = 0` off `B_r(0)`
    intro Rs hRs R hR f _ hfc _
    obtain ⟨r, hr⟩ := hfc.isCompact.isBounded.subset_ball (0 : Euclid P)
    have hf0 : ∀ x, x ∉ ball (0 : Euclid P) r → f x = 0 := fun x hx =>
      image_eq_zero_of_notMem_tsupport fun h => hx (hr h)
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [hagree r] with j hj
    -- `Sⱼ = C` on `𝒟ⁿ(B_r(0))`, read through `currentEval`
    have hloc : ∀ ω : TestFormOn (ball (0 : Euclid P) r) (m + 1),
        currentEval (Ss j) (ω : DifferentialForm (Euclid P) (m + 1)) =
          currentEval C (ω : DifferentialForm (Euclid P) (m + 1)) := by
      intro ω
      have h := hj.2.1 (testFormOnInclusion (subset_univ _) (m + 1) ω) ω.property.2
      rw [testFormOnInclusion_coe] at h
      rw [h, currentEval, dite_eq_left ⟨ω.property.1, subset_univ _⟩]
      rfl
    -- measure locality on `B_r(0) ⊆ Uⱼ`: `μ_{Sⱼ}⌞B_r(0) = μ_C⌞B_r(0)`
    have hrestr := hmeas P (m + 1) (Us j) univ (ball 0 r) (Ss j) C (Rs j) R (hUs j) isOpen_univ
      isOpen_ball hj.1 (subset_univ _) (hRs j) hR hloc
    calc ∫ x, f x ∂R.measure = ∫ x in ball (0 : Euclid P) r, f x ∂R.measure :=
          (setIntegral_eq_integral_of_forall_compl_eq_zero hf0).symm
      _ = ∫ x in ball (0 : Euclid P) r, f x ∂(Rs j).measure := by rw [hrestr]
      _ = ∫ x, f x ∂(Rs j).measure := setIntegral_eq_integral_of_forall_compl_eq_zero hf0
  · -- 3. `spt β ⊆ B_r(0) ⊆ Uⱼ` for some `r`, `j`, and `C(dβ) = Sⱼ(dβ) = ∂Sⱼ(β) = 0`
    ext β
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply]
    obtain ⟨r, hr⟩ := β.property.1.2.isCompact.isBounded.subset_ball (0 : Euclid P)
    obtain ⟨j, hj⟩ := (hagree r).exists
    have hdβ : tsupport ((exteriorDerivativeTestOn univ m β : TestFormOn (univ : Set (Euclid P))
        (m + 1)) : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 r :=
      (tsupport_exteriorDerivative_subset (β : DifferentialForm (Euclid P) m)).trans hr
    rw [← hj.2.1 _ hdβ, currentEval,
      dite_eq_left ⟨(exteriorDerivativeTestOn univ m β).property.1, hdβ.trans hj.1⟩]
    exact hj.2.2 ⟨β, β.property.1, hr.trans hj.1⟩ hr
/-- **Simon 7.2.4** (the "standard approximation argument" at the end of its proof, p. 187,
lower half): if `μ(G) ≤ liminf_j μ_j(G)` for every bounded open `G`, then
`∫ g dμ ≤ liminf_j ∫ g dμ_j` in `[0, ∞]` for every continuous `g ≥ 0` with compact support.
By the layer cake formula both sides integrate `t ↦ ν{g > t}` over `t > 0`; for `t > 0` the set
`{g > t}` is open and lies in the compact `tsupport g`, and Fatou's lemma finishes. -/
theorem Submission.dtc_bc_rc_lintegral_le_liminf : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ G : Set (Euclid P), IsOpen G → Bornology.IsBounded G → μ G ≤ liminf (fun j => μs j G) atTop) → ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → (∀ x, 0 ≤ g x) → ∫⁻ x, ENNReal.ofReal (g x) ∂μ ≤ liminf (fun j => ∫⁻ x, ENNReal.ofReal (g x) ∂(μs j)) atTop := by
  intro P μs μ hG g hg hgc hg0
  -- step 1: `tsupport g` is compact, hence bounded
  have hK : Bornology.IsBounded (tsupport g) := hgc.isCompact.isBounded
  -- step 2: layer cake, `∫⁻ ofReal (g x) ∂ν = ∫⁻ t in Ioi 0, ν {x | t < g x}`
  simp_rw [lintegral_eq_lintegral_meas_lt _ (ae_of_all _ hg0) hg.measurable.aemeasurable]
  calc ∫⁻ t in Ioi 0, μ {x | t < g x}
      ≤ ∫⁻ t in Ioi 0, liminf (fun j => μs j {x | t < g x}) atTop := by
        -- steps 3 and 5: for `t > 0`, `{x | t < g x}` is open and contained in `tsupport g`
        refine setLIntegral_mono' measurableSet_Ioi fun t ht =>
          hG _ (isOpen_lt continuous_const hg) ?_
        exact hK.subset fun x hx => subset_tsupport g (lt_trans ht hx).ne'
    _ ≤ liminf (fun j => ∫⁻ t in Ioi 0, μs j {x | t < g x}) atTop :=
        -- steps 4 and 6: `t ↦ μs j {x | t < g x}` is antitone, hence measurable; Fatou
        lintegral_liminf_le fun j => Antitone.measurable fun s t hst =>
          measure_mono fun x hx => lt_of_le_of_lt hst hx
/-- **Simon 7.2.4** (proof, the "standard approximation argument", upper bound): if `μ` is finite
on compact sets and `limsup_j μⱼ(K) ≤ μ(K)` for every compact `K`, then
`limsup_j ∫ g dμⱼ ≤ ∫ g dμ` for every continuous compactly supported `g ≥ 0`.  By the layer cake
formula `∫ g dν = ∫₀^∞ ν{g ≥ t} dt`; for `t > 0` the sets `{g ≥ t}` are compact subsets of
`tsupport g`, so after an index shift the integrands are dominated by
`(μ(tsupport g) + 1) · 1_{t ≤ M}` (`g ≤ M`), and the reverse Fatou lemma applies. -/
theorem Submission.dtc_bc_rc_limsup_lintegral_le : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun j => μs j K) atTop ≤ μ K) → ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → (∀ x, 0 ≤ g x) → limsup (fun j => ∫⁻ x, ENNReal.ofReal (g x) ∂(μs j)) atTop ≤ ∫⁻ x, ENNReal.ofReal (g x) ∂μ := by
  intro P μs μ hfin hlim g hg hgc hg0
  -- `g ≤ M`
  obtain ⟨M, hM⟩ := hg.bounded_above_of_compact_support hgc
  have hgM : ∀ x, g x ≤ M := fun x => (Real.le_norm_self (g x)).trans (hM x)
  -- `μⱼ(tsupport g) < A := μ(tsupport g) + 1 < ∞` for `j ≥ j₁`
  have hK₀ : IsCompact (tsupport g) := hgc.isCompact
  have hAtop : μ (tsupport g) + 1 ≠ ∞ :=
    ENNReal.add_ne_top.2 ⟨(hfin _ hK₀).ne, ENNReal.one_ne_top⟩
  obtain ⟨j₁, hj₁⟩ := eventually_atTop.1 (eventually_lt_of_limsup_lt
    ((hlim _ hK₀).trans_lt (ENNReal.lt_add_right (hfin _ hK₀).ne one_ne_zero)))
  -- for `t > 0`, `{g ≥ t}` is a compact subset of `tsupport g`
  have hsub : ∀ t : ℝ, 0 < t → {x | t ≤ g x} ⊆ tsupport g := fun t ht x hx =>
    subset_tsupport g (ht.trans_le hx).ne'
  have hcpt : ∀ t : ℝ, 0 < t → IsCompact {x | t ≤ g x} := fun t ht =>
    hK₀.of_isClosed_subset (isClosed_le continuous_const hg) (hsub t ht)
  -- layer cake: `∫ g dν = ∫₀^∞ ν{g ≥ t} dt`
  have hlc : ∀ ν : Measure (Euclid P),
      ∫⁻ x, ENNReal.ofReal (g x) ∂ν = ∫⁻ t in Ioi 0, ν {x | t ≤ g x} := fun ν =>
    lintegral_eq_lintegral_meas_le ν (ae_of_all _ hg0) hg.measurable.aemeasurable
  simp_rw [hlc]
  rw [← limsup_nat_add _ j₁]
  calc limsup (fun i => ∫⁻ t in Ioi 0, μs (i + j₁) {x | t ≤ g x}) atTop
      ≤ ∫⁻ t in Ioi 0, limsup (fun i => μs (i + j₁) {x | t ≤ g x}) atTop := by
        -- reverse Fatou, dominated by `A · 1_{(-∞, M]}`
        refine limsup_lintegral_le (f := fun i t => μs (i + j₁) {x | t ≤ g x})
          ((Iic M).indicator fun _ => μ (tsupport g) + 1) (fun i => ?_) (fun i => ?_) ?_
        · exact Antitone.measurable fun s t hst => measure_mono fun x hx => hst.trans hx
        · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
          by_cases htM : t ≤ M
          · rw [indicator_of_mem (mem_Iic.2 htM)]
            exact (measure_mono (hsub t ht)).trans (hj₁ _ (Nat.le_add_left _ _)).le
          · have he : {x | t ≤ g x} = (∅ : Set (Euclid P)) :=
              eq_empty_iff_forall_notMem.2 fun x hx => htM (le_trans hx (hgM x))
            simp [he]
        · rw [lintegral_indicator_const measurableSet_Iic, Measure.restrict_apply measurableSet_Iic,
            Iic_inter_Ioi, Real.volume_Ioc]
          exact ENNReal.mul_ne_top hAtop ENNReal.ofReal_ne_top
    _ ≤ ∫⁻ t in Ioi 0, μ {x | t ≤ g x} := by
        refine setLIntegral_mono' measurableSet_Ioi fun t ht => ?_
        rw [limsup_nat_add (fun j => μs j {x | t ≤ g x}) j₁]
        exact hlim _ (hcpt t ht)

/-- **Radon convergence from the compact/open semicontinuity bounds** (the "standard approximation
argument" ending Simon's proof of 7.2.4, p. 187).  Let `μ`, `μⱼ` be Borel measures on `ℝᴾ` with
(a) `μ(K) < ∞` and (b) `limsup_j μⱼ(K) ≤ μ(K)` for compact `K`, and (c) `μ(G) ≤ liminf_j μⱼ(G)`
for bounded open `G`.  Then `∫ f dμⱼ → ∫ f dμ` for continuous `f` with compact support.  For
such `g ≥ 0`, `∫⁻ g dμⱼ → ∫⁻ g dμ < ∞` by the Fatou bound `dtc_bc_rc_lintegral_le_liminf` (from
(c)) and the reverse Fatou bound `dtc_bc_rc_limsup_lintegral_le` (from (a), (b)), so the Bochner
integrals `∫ g = (∫⁻ g).toReal` converge.  By (a), (b), `μⱼ(spt f) < ∞` for large `j`; then
`f⁺ = max(f, 0)` and `f⁻ = max(−f, 0)` are `μⱼ`-integrable and `∫ f = ∫ f⁺ − ∫ f⁻`. -/
theorem Submission.dtc_bc_tendsto_integral_of_limsup_liminf : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun j => μs j K) atTop ≤ μ K) → (∀ G : Set (Euclid P), IsOpen G → Bornology.IsBounded G → μ G ≤ liminf (fun j => μs j G) atTop) → ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun j => ∫ x, f x ∂(μs j)) atTop (𝓝 (∫ x, f x ∂μ)) := by
  intro P μs μ ha hb hc f hf hfc
  -- `K₀ = spt f` is compact, and `μⱼ(K₀) < ∞` for `j ≥ j₁` by (a) and (b)
  have hK₀ : IsCompact (tsupport f) := hfc.isCompact
  obtain ⟨j₁, hj₁⟩ : ∃ j₁, ∀ j ≥ j₁, μs j (tsupport f) < ∞ :=
    eventually_atTop.1 (eventually_lt_of_limsup_lt ((hb _ hK₀).trans_lt (ha _ hK₀)))
  -- a continuous function vanishing off `K₀` is `ν`-integrable whenever `ν(K₀) < ∞`
  have hint : ∀ ν : Measure (Euclid P), ν (tsupport f) < ∞ → ∀ g : Euclid P → ℝ,
      Continuous g → support g ⊆ tsupport f → Integrable g ν := by
    intro ν hν g hg hgs
    have : IsFiniteMeasure (ν.restrict (tsupport f)) := isFiniteMeasure_restrict.2 hν.ne
    exact (integrableOn_iff_integrable_of_support_subset hgs).1
      (hg.integrable_of_hasCompactSupport (hfc.mono' hgs))
  -- continuous `g ≥ 0` with compact support: `∫⁻ g dμⱼ → ∫⁻ g dμ < ∞`, then take `toReal`
  have key : ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → (∀ x, 0 ≤ g x) →
      Tendsto (fun j => ∫ x, g x ∂(μs j)) atTop (𝓝 (∫ x, g x ∂μ)) := by
    intro g hg hgc hg0
    have hT : Tendsto (fun j => ∫⁻ x, ENNReal.ofReal (g x) ∂(μs j)) atTop
        (𝓝 (∫⁻ x, ENNReal.ofReal (g x) ∂μ)) :=
      tendsto_of_le_liminf_of_limsup_le
        (Submission.dtc_bc_rc_lintegral_le_liminf P μs μ hc g hg hgc hg0)
        (Submission.dtc_bc_rc_limsup_lintegral_le P μs μ ha hb g hg hgc hg0)
    have hfin : ∫⁻ x, ENNReal.ofReal (g x) ∂μ ≠ ∞ := by
      have : IsFiniteMeasureOnCompacts μ := ⟨ha⟩
      exact (hg.integrable_of_hasCompactSupport hgc).lintegral_lt_top.ne
    have hconv : ∀ ν : Measure (Euclid P),
        ∫ x, g x ∂ν = (∫⁻ x, ENNReal.ofReal (g x) ∂ν).toReal := fun ν =>
      integral_eq_lintegral_of_nonneg_ae (ae_of_all _ hg0) hg.aestronglyMeasurable
    rw [hconv μ]
    exact ((ENNReal.tendsto_toReal hfin).comp hT).congr fun j => (hconv (μs j)).symm
  -- `f = f⁺ − f⁻` with `f⁺ = max(f, 0)`, `f⁻ = max(−f, 0)` continuous, `≥ 0`, supported in `K₀`
  have hcp : Continuous fun x => max (f x) 0 := hf.max continuous_const
  have hcn : Continuous fun x => max (-f x) 0 := hf.neg.max continuous_const
  have hsp : support (fun x => max (f x) 0) ⊆ support f := by
    intro x hx
    rw [mem_support] at hx ⊢
    contrapose! hx
    simp [hx]
  have hsn : support (fun x => max (-f x) 0) ⊆ support f := by
    intro x hx
    rw [mem_support] at hx ⊢
    contrapose! hx
    simp [hx]
  have hsplit : ∀ ν : Measure (Euclid P), ν (tsupport f) < ∞ →
      ∫ x, f x ∂ν = ∫ x, max (f x) 0 ∂ν - ∫ x, max (-f x) 0 ∂ν := by
    intro ν hν
    rw [← integral_sub (hint ν hν _ hcp (hsp.trans (subset_tsupport f)))
      (hint ν hν _ hcn (hsn.trans (subset_tsupport f)))]
    simp only [max_zero_sub_max_neg_zero_eq_self]
  rw [hsplit μ (ha _ hK₀)]
  refine ((key _ hcp (hfc.mono hsp) fun x => le_max_right _ _).sub
    (key _ hcn (hfc.mono hsn) fun x => le_max_right _ _)).congr' ?_
  filter_upwards [eventually_ge_atTop j₁] with j hj
  exact (hsplit (μs j) (hj₁ j hj)).symm

/-- **Blow-ups at a point of finite density have locally bounded mass** (proof of Simon 7.3.1,
display (1), chapter-07.txt lines 329–335): if `Θⁿ(μ_T, x) = θ` and `λⱼ > 0`, `λⱼ → 0`, then
for each `R` there is `c < ∞` with `M_{B_R(0)}(η_{x,λⱼ#}T) ≤ c` for all large `j`.  For `R ≤ 0`
the ball is empty and the mass is `0`.  For `R > 0`, `M_{B_ρ(x)}(T) ≤ (θ + 1) ωₙ ρⁿ` for small
`ρ > 0`; since `η_{x,λ}(B_{λR}(x)) = B_R(0)`, the scaling `Submission.dtc_blowUp_scaling` gives
`M_{B_R(0)}(η_{x,λⱼ#}T) = λⱼ⁻ⁿ M_{B_{λⱼR}(x)}(T) ≤ (θ + 1) ωₙ Rⁿ` once `λⱼR` is small. -/
theorem Submission.dtc_bc_bh_blowUp_massOn_ball_bounded : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (x : Euclid P) (θ : ℝ), IsOpen U → 0 < n → HasMassDensity T x θ → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (blowUp T x (lams j) (hlams j).ne').massOn (ball 0 R) ≤ c := by
  intro P n U T x θ hU hn hθ lams hlams hlim R
  obtain ⟨hθ0, hlimθ⟩ := hθ
  by_cases hR : 0 < R
  swap
  · -- `R ≤ 0`: `B_R(0) = ∅`, the only admissible form is `0`, so the mass is `0`
    refine ⟨0, ENNReal.zero_ne_top, Eventually.of_forall fun j => ?_⟩
    have hempty : ball (0 : Euclid P) R = ∅ := ball_eq_empty.2 (not_lt.1 hR)
    rw [hempty]
    apply sSup_le
    rintro r ⟨ω, hω, rfl⟩
    have hω0 : ω = 0 := by
      apply Subtype.ext
      funext y
      by_contra hy
      have : y ∈ tsupport (ω : DifferentialForm (Euclid P) n) := subset_tsupport _ hy
      exact (hω.1 this).elim
    simp only [hω0, map_zero, ENNReal.ofReal_zero, le_refl]
  -- `ωₙ ∈ (0, ∞)`
  have hω0 : unitBallVolume n ≠ 0 :=
    (Metric.measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  -- the density ratio is eventually `< ofReal (θ + 1)` as `ρ ↓ 0`
  have hlt : ENNReal.ofReal θ < ENNReal.ofReal (θ + 1) :=
    (ENNReal.ofReal_lt_ofReal_iff (by linarith)).2 (by linarith)
  obtain ⟨s₀, hs₀, hs₀ev⟩ := (nhdsGT_basis (0 : ℝ)).eventually_iff.1
    ((tendsto_order.1 hlimθ).2 _ hlt)
  -- hence `M_{B_ρ(x)}(T) ≤ ofReal (θ + 1) ωₙ ρⁿ` for `0 < ρ < s₀`
  have hmass : ∀ ρ : ℝ, 0 < ρ → ρ < s₀ →
      T.massOn (ball x ρ) ≤ ENNReal.ofReal (θ + 1) * (unitBallVolume n * ENNReal.ofReal (ρ ^ n)) := by
    intro ρ hρ hρs
    have h := hs₀ev ⟨hρ, hρs⟩
    have hb0 : unitBallVolume n * ENNReal.ofReal (ρ ^ n) ≠ 0 :=
      mul_ne_zero hω0 (ENNReal.ofReal_pos.2 (pow_pos hρ n)).ne'
    have hbtop : unitBallVolume n * ENNReal.ofReal (ρ ^ n) ≠ ∞ :=
      ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
    exact ((ENNReal.div_lt_iff (Or.inl hb0) (Or.inl hbtop)).1 h).le
  refine ⟨ENNReal.ofReal (θ + 1) * (unitBallVolume n * ENNReal.ofReal (R ^ n)),
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top), ?_⟩
  have hsmall : ∀ᶠ j in atTop, lams j * R < s₀ := by
    have h0 : Tendsto (fun j => lams j * R) atTop (𝓝 0) := by
      simpa using hlim.mul_const R
    exact (tendsto_order.1 h0).2 s₀ hs₀
  filter_upwards [hsmall] with j hj
  have hlam := hlams j
  -- `η_j(B_{λⱼR}(x)) = B_R(0)`
  have himg : dilation x (lams j) '' ball x (lams j * R) = ball 0 R := by
    have hdil : ∀ y : Euclid P, dilation x (lams j) y = (lams j)⁻¹ • (y - x) := by
      intro y
      simp only [dilation, dilationCLM, FunLike.coe_smul, Pi.smul_apply,
        ContinuousLinearMap.coe_id', id_eq, smul_sub]
      abel
    ext z
    constructor
    · rintro ⟨y, hy, rfl⟩
      rw [mem_ball, dist_eq_norm] at hy
      rw [mem_ball, dist_zero_right, hdil, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam.le)]
      calc (lams j)⁻¹ * ‖y - x‖ < (lams j)⁻¹ * (lams j * R) :=
            mul_lt_mul_of_pos_left hy (inv_pos.2 hlam)
        _ = R := by field_simp
    · intro hz
      rw [mem_ball, dist_zero_right] at hz
      refine ⟨x + lams j • z, ?_, ?_⟩
      · rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
        exact mul_lt_mul_of_pos_left hz hlam
      · rw [hdil, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hlam.ne', one_smul]
  rw [← himg, (Submission.dtc_blowUp_scaling P n U U T x (lams j) hlam hU hn).1 (ball x (lams j * R))]
  calc ENNReal.ofReal ((lams j)⁻¹ ^ n) * T.massOn (ball x (lams j * R))
      ≤ ENNReal.ofReal ((lams j)⁻¹ ^ n) *
          (ENNReal.ofReal (θ + 1) * (unitBallVolume n * ENNReal.ofReal ((lams j * R) ^ n))) := by
        gcongr
        exact hmass _ (mul_pos hlam hR) hj
    _ = ENNReal.ofReal (θ + 1) * (unitBallVolume n * ENNReal.ofReal (R ^ n)) := by
        rw [mul_left_comm]
        congr 1
        rw [mul_left_comm, ← ENNReal.ofReal_mul (by positivity)]
        congr 2
        rw [mul_pow, ← mul_assoc, ← mul_pow, inv_mul_cancel₀ hlam.ne', one_pow, one_mul]

/-- **Blow-up domains and boundaries near `x ∉ spt ∂T`** (Simon 7.3.1, proof, chapter-07.txt
lines 334–335: "`∂η_{x,λⱼ#}T = 0` in `B_R(0)` for sufficiently large `j` (because
`x ∉ spt ∂T`)").  `ηⱼ = η_{x,λⱼ}` is an affine homeomorphism with `ηⱼ(x + λⱼz) = z`, so (1) `ηⱼ(U)`
is open.  As `x ∈ U ∩ Z(∂T)` (`Z` the zero region, `spt ∂T = U \ Z(∂T)`), some `B_r(x)` lies in
`U ∩ Z(∂T)`, and `λⱼR < r` for all large `j`; then (2) `B̄_R(0) ⊆ ηⱼ(B_r(x)) ⊆ ηⱼ(U)`, and (3)
`∂(ηⱼ#T) = ηⱼ#(∂T)` has support `ηⱼ(spt ∂T)`, which misses `B_R(0) ⊆ ηⱼ(B_r(x))`, so `∂(ηⱼ#T)`
annihilates every test form supported in `B_R(0)` (`dtc_blowUp_algebra`,
`dtc_vanish_off_support`). -/
theorem Submission.dtc_bc_bh_blowUp_domain_boundary : ∀ (P m : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)) (x : Euclid P), IsOpen U → x ∈ U → x ∉ boundarySupport T → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → (∀ j, IsOpen (dilation x (lams j) '' U)) ∧ (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ dilation x (lams j) '' U) ∧ (∀ R : ℝ, ∀ᶠ j in atTop, ∀ ω : TestFormOn (dilation x (lams j) '' U) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball 0 R → (blowUp T x (lams j) (hlams j).ne').boundary ω = 0) := by
  intro P m U T x hU hxU hxb lams hlams hlim
  -- `η_{x,λ}(y) = λ⁻¹ • (y - x)`
  have hdil : ∀ (lam : ℝ) (y : Euclid P), dilation x lam y = lam⁻¹ • (y - x) := by
    intro lam y
    simp only [dilation, dilationCLM, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.coe_id', id_eq, smul_sub]
    abel
  -- `η_{x,λ}(x + λz) = z`, and `η_{x,λ}(y) = z` forces `y = x + λz`
  have hdil_inv : ∀ (lam : ℝ) (z : Euclid P), lam ≠ 0 → dilation x lam (x + lam • z) = z := by
    intro lam z hlam
    rw [hdil, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hlam, one_smul]
  have hdil_eq : ∀ (lam : ℝ) (y z : Euclid P), lam ≠ 0 → dilation x lam y = z →
      y = x + lam • z := by
    intro lam y z hlam h
    rw [← h, hdil, smul_smul, mul_inv_cancel₀ hlam, one_smul, add_sub_cancel]
  -- `λⱼR` is eventually below any positive bound
  have hsmall : ∀ (R t : ℝ), 0 < t → ∀ᶠ j in atTop, lams j * R < t := by
    intro R t ht
    have h0 : Tendsto (fun j => lams j * R) atTop (𝓝 0) := by
      simpa using hlim.mul_const R
    exact (tendsto_order.1 h0).2 t ht
  -- (1) `ηⱼ(U)` is the image of the open `U` under a homeomorphism
  have hopen : ∀ j, IsOpen (dilation x (lams j) '' U) := by
    intro j
    have hlam : lams j ≠ 0 := (hlams j).ne'
    have hfun : dilation x (lams j) =
        ((Homeomorph.subRight x).trans (Homeomorph.smulOfNeZero (lams j)⁻¹ (inv_ne_zero hlam)) :
          Euclid P → Euclid P) := by
      funext y
      rw [hdil]
      rfl
    rw [hfun]
    exact ((Homeomorph.subRight x).trans
      (Homeomorph.smulOfNeZero (lams j)⁻¹ (inv_ne_zero hlam))).isOpenMap U hU
  -- a ball `B_r(x)` inside `U` and inside the zero region of `∂T`
  have hxZ : x ∈ T.boundary.zeroRegion := by
    by_contra h
    exact hxb ⟨hxU, h⟩
  obtain ⟨r, hr, hrU⟩ :=
    Metric.isOpen_iff.1 (hU.inter T.boundary.isOpen_zeroRegion) x ⟨hxU, hxZ⟩
  refine ⟨hopen, ?_, ?_⟩
  · -- (2) `B̄_R(0) ⊆ ηⱼ(U)` once `λⱼR < r`
    intro R
    filter_upwards [hsmall R r hr] with j hj
    intro z hz
    have hlam := hlams j
    refine ⟨x + lams j • z, (hrU ?_).1, hdil_inv (lams j) z hlam.ne'⟩
    rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
    rw [mem_closedBall, dist_zero_right] at hz
    calc lams j * ‖z‖ ≤ lams j * R := mul_le_mul_of_nonneg_left hz hlam.le
      _ < r := hj
  · -- (3) `∂(ηⱼ#T)(ω) = 0` for `spt ω ⊆ B_R(0)` once `λⱼR < r`
    intro R
    filter_upwards [hsmall R r hr] with j hj ω hω
    have hlam := hlams j
    have hALG := Submission.dtc_blowUp_algebra P U x (lams j) hlam
    rw [hALG.2.2.2 m T]
    apply Submission.dtc_vanish_off_support
    rw [hALG.2.2.1 m T.boundary, Set.disjoint_left]
    rintro z hz ⟨y, hy, hyz⟩
    have hyx : y = x + lams j • z := hdil_eq (lams j) y z hlam.ne' hyz
    have hzR := hω hz
    rw [mem_ball, dist_zero_right] at hzR
    have hyball : y ∈ ball x r := by
      rw [hyx, mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul,
        Real.norm_of_nonneg hlam.le]
      calc lams j * ‖z‖ ≤ lams j * R := mul_le_mul_of_nonneg_left hzR.le hlam.le
        _ < r := hj
    exact hy.2 (hrU hyball).2
/-- **Rescaled retractions** (Simon 7.2.4 and Remark 7.2.5(2), rescaled for the blow-ups of
7.3.1).  Let `π` be a `C¹` retraction of `B_δ(x)` onto `N` (`π(B_δ(x)) ⊆ N`, `π = id` on
`N ∩ B_δ(x)`) whose Lipschitz constant on `B_s(x)` is at most `1 + η` for small `s`.  Then
`πⱼ(z) = η_{x,λⱼ}(π(x + λⱼz)) = λⱼ⁻¹(π(x + λⱼz) − x)` is, for all large `j`, a `C¹` map of
`B_G(0)` into `η_{x,λⱼ}(U ∩ N)` which is the identity on `η_{x,λⱼ}(U ∩ N) ∩ B_G(0)` and satisfies
`|πⱼ(z)| ≤ 2|z|`; and for every `η > 0`, eventually `πⱼ` is `(1 + η)`-Lipschitz on `B_G(0)`.
Once `λⱼG` is below a radius `s₁` on which `π` is `2`-Lipschitz and below half the radius of a
ball `B_{r₀}(x) ⊆ U`, `x + λⱼz ∈ B_{s₁}(x)` and `|π(x + λⱼz) − x| ≤ 2λⱼ|z| < r₀` (`π(x) = x`). -/
theorem Submission.dtc_bc_bh_rescaled_retraction : ∀ (P : ℕ) (U N : Set (Euclid P)) (x : Euclid P) (δ : ℝ) (π : Euclid P → Euclid P), IsOpen U → x ∈ U → x ∈ N → 0 < δ → ContDiffOn ℝ 1 π (ball x δ) → MapsTo π (ball x δ) N → (∀ y ∈ N ∩ ball x δ, π y = y) → (∀ η : ℝ, 0 < η → ∃ s : ℝ, 0 < s ∧ s ≤ δ ∧ ∀ y ∈ ball x s, ∀ z ∈ ball x s, ‖π y - π z‖ ≤ (1 + η) * ‖y - z‖) → ∀ lams : ℕ → ℝ, (∀ j, 0 < lams j) → Tendsto lams atTop (𝓝 0) → ∀ G : ℝ, 0 < G → ∃ πs : ℕ → Euclid P → Euclid P, (∀ᶠ j in atTop, ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧ MapsTo (πs j) (ball 0 G) (dilation x (lams j) '' (U ∩ N)) ∧ (∀ y ∈ dilation x (lams j) '' (U ∩ N) ∩ ball 0 G, πs j y = y) ∧ ∀ y ∈ ball 0 G, ‖πs j y‖ ≤ 2 * ‖y‖) ∧ ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G, ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖ := by
  intro P U N x δ π hU hxU hxN hδ hC hmaps hid hlip lams hlams hlim G hG
  -- a ball `B_{r₀}(x) ⊆ U`
  obtain ⟨r₀, hr₀, hr₀U⟩ := Metric.isOpen_iff.1 hU x hxU
  -- `π` is `2`-Lipschitz on `B_{s₁}(x)`
  obtain ⟨s₁, hs₁, hs₁δ, hlip1⟩ := hlip 1 one_pos
  have hπx : π x = x := hid x ⟨hxN, mem_ball_self hδ⟩
  -- `η_{x,λ}(y) = λ⁻¹ • (y - x)`
  have hdil : ∀ (lam : ℝ) (y : Euclid P), dilation x lam y = lam⁻¹ • (y - x) := by
    intro lam y
    simp only [dilation, dilationCLM, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.coe_id', id_eq, smul_sub]
    abel
  -- `x + λ • z ∈ B_t(x)` when `z ∈ B_G(0)` and `λ G ≤ t`
  have hmem : ∀ (lam t : ℝ) (z : Euclid P), 0 < lam → lam * G ≤ t → z ∈ ball (0 : Euclid P) G →
      x + lam • z ∈ ball x t := by
    intro lam t z hlam hlt hz
    rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
    rw [mem_ball, dist_zero_right] at hz
    calc lam * ‖z‖ < lam * G := mul_lt_mul_of_pos_left hz hlam
      _ ≤ t := hlt
  -- `λⱼ G < t` for all large `j`
  have hsmall : ∀ t : ℝ, 0 < t → ∀ᶠ j in atTop, lams j * G < t := by
    intro t ht
    have h0 : Tendsto (fun j => lams j * G) atTop (𝓝 0) := by
      simpa using hlim.mul_const G
    exact (tendsto_order.1 h0).2 t ht
  refine ⟨fun j z => dilation x (lams j) (π (x + lams j • z)), ?_, ?_⟩
  · filter_upwards [hsmall (min s₁ (r₀ / 2)) (lt_min hs₁ (half_pos hr₀))] with j hj
    have hlam := hlams j
    have hj₁ : lams j * G ≤ s₁ := hj.le.trans (min_le_left _ _)
    have hj₂ : lams j * G ≤ r₀ / 2 := hj.le.trans (min_le_right _ _)
    have hjδ : lams j * G ≤ δ := hj₁.trans hs₁δ
    -- the affine map `z ↦ x + λⱼ z` maps `B_G(0)` into `B_δ(x)`
    have hmapsδ : MapsTo (fun z : Euclid P => x + lams j • z) (ball 0 G) (ball x δ) :=
      fun z hz => hmem (lams j) δ z hlam hjδ hz
    -- `π(x + λⱼ z) ∈ U ∩ N` and `|π(x + λⱼ z) - x| ≤ 2 λⱼ |z|`
    have hkey : ∀ z ∈ ball (0 : Euclid P) G, π (x + lams j • z) ∈ U ∩ N ∧
        ‖π (x + lams j • z) - x‖ ≤ 2 * (lams j * ‖z‖) := by
      intro z hz
      have hy : x + lams j • z ∈ ball x s₁ := hmem (lams j) s₁ z hlam hj₁ hz
      have hbd : ‖π (x + lams j • z) - x‖ ≤ 2 * (lams j * ‖z‖) := by
        have := hlip1 _ hy x (mem_ball_self hs₁)
        rw [hπx] at this
        calc ‖π (x + lams j • z) - x‖ ≤ (1 + 1) * ‖x + lams j • z - x‖ := this
          _ = 2 * (lams j * ‖z‖) := by
            rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]; norm_num
      refine ⟨⟨hr₀U ?_, hmaps (hmapsδ hz)⟩, hbd⟩
      rw [mem_ball, dist_eq_norm]
      rw [mem_ball, dist_zero_right] at hz
      calc ‖π (x + lams j • z) - x‖ ≤ 2 * (lams j * ‖z‖) := hbd
        _ < 2 * (lams j * G) := by
          have := mul_lt_mul_of_pos_left hz hlam
          linarith
        _ ≤ r₀ := by linarith
    refine ⟨?_, ?_, ?_, ?_⟩
    · -- `C¹` on `B_G(0)`
      have hdilC : ContDiff ℝ 1 (dilation x (lams j)) := by
        unfold dilation
        exact contDiff_const.add (dilationCLM P (lams j)).contDiff
      have haff : ContDiff ℝ 1 (fun z : Euclid P => x + lams j • z) :=
        contDiff_const.add (contDiff_id.const_smul (lams j))
      exact hdilC.comp_contDiffOn (hC.comp haff.contDiffOn hmapsδ)
    · -- maps `B_G(0)` into `η_j(U ∩ N)`
      intro z hz
      exact ⟨π (x + lams j • z), (hkey z hz).1, rfl⟩
    · -- identity on `η_j(U ∩ N) ∩ B_G(0)`
      rintro z ⟨⟨y', hy', rfl⟩, hz⟩
      have hinv : x + lams j • dilation x (lams j) y' = y' := by
        rw [hdil, smul_smul, mul_inv_cancel₀ hlam.ne', one_smul, add_sub_cancel]
      show dilation x (lams j) (π (x + lams j • dilation x (lams j) y')) = dilation x (lams j) y'
      rw [hinv, hid y' ⟨hy'.2, ?_⟩]
      rw [← hinv]
      exact hmapsδ hz
    · -- `|π_j(z)| ≤ 2|z|`
      intro z hz
      show ‖dilation x (lams j) (π (x + lams j • z))‖ ≤ 2 * ‖z‖
      rw [hdil, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam.le)]
      calc (lams j)⁻¹ * ‖π (x + lams j • z) - x‖ ≤ (lams j)⁻¹ * (2 * (lams j * ‖z‖)) :=
            mul_le_mul_of_nonneg_left (hkey z hz).2 (inv_nonneg.2 hlam.le)
        _ = 2 * ‖z‖ := by field_simp
  · intro η hη
    obtain ⟨s, hs, hsδ, hlipη⟩ := hlip η hη
    filter_upwards [hsmall s hs] with j hj y hy z hz
    have hlam := hlams j
    have hy' := hmem (lams j) s y hlam hj.le hy
    have hz' := hmem (lams j) s z hlam hj.le hz
    show ‖dilation x (lams j) (π (x + lams j • y)) - dilation x (lams j) (π (x + lams j • z))‖ ≤
      (1 + η) * ‖y - z‖
    rw [hdil, hdil, ← smul_sub, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam.le)]
    have h1 := hlipη _ hy' _ hz'
    have h2 : ‖x + lams j • y - (x + lams j • z)‖ = lams j * ‖y - z‖ := by
      rw [add_sub_add_left_eq_sub, ← smul_sub, norm_smul, Real.norm_of_nonneg hlam.le]
    have h3 : π (x + lams j • y) - x - (π (x + lams j • z) - x) =
        π (x + lams j • y) - π (x + lams j • z) := by abel
    rw [h3]
    calc (lams j)⁻¹ * ‖π (x + lams j • y) - π (x + lams j • z)‖
        ≤ (lams j)⁻¹ * ((1 + η) * (lams j * ‖y - z‖)) := by
          rw [← h2]; exact mul_le_mul_of_nonneg_left h1 (inv_nonneg.2 hlam.le)
      _ = (1 + η) * ‖y - z‖ := by field_simp
/-- Local `C¹` retraction onto `N` (proof of Simon 7.3.1), Lipschitz bound near a point: if `f` is
`C¹` on `B_δ(x)` and `‖Df(x)‖ ≤ c`, then for every `η > 0`, `f` is `(c + η)`-Lipschitz on some
`B_s(x)`, `0 < s ≤ δ`.  `Df` is continuous at `x`, so `‖Df(y)‖ ≤ ‖Df(x)‖ + η ≤ c + η` on a small
ball `B_s(x)`; the mean value inequality on the convex ball `B_s(x)` gives the bound. -/
theorem Submission.dtc_bc_lr_lipschitz_near_point : ∀ (P : ℕ) (f : Euclid P → Euclid P) (x : Euclid P) (δ c : ℝ), 0 < δ → ContDiffOn ℝ 1 f (ball x δ) → ‖fderiv ℝ f x‖ ≤ c → ∀ η : ℝ, 0 < η → ∃ s : ℝ, 0 < s ∧ s ≤ δ ∧ ∀ y ∈ ball x s, ∀ z ∈ ball x s, ‖f y - f z‖ ≤ (c + η) * ‖y - z‖ := by
  intro P f x δ c hδ hf hc η hη
  -- `f` is differentiable at every point of the open ball `B_δ(x)`, and `Df` is continuous there
  have hdiff : ∀ y ∈ ball x δ, DifferentiableAt ℝ f y := fun y hy =>
    (hf.differentiableOn one_ne_zero y hy).differentiableAt (isOpen_ball.mem_nhds hy)
  have hcont : ContinuousOn (fderiv ℝ f) (ball x δ) :=
    hf.continuousOn_fderiv_of_isOpen isOpen_ball le_rfl
  -- continuity of `Df` at `x`: `‖Df(y) - Df(x)‖ < η` for `|y - x| < s₁`; take `s = min s₁ δ`
  obtain ⟨s₁, hs₁, hDf⟩ := Metric.continuousAt_iff.1
    (hcont.continuousAt (isOpen_ball.mem_nhds (mem_ball_self hδ))) η hη
  refine ⟨min s₁ δ, lt_min hs₁ hδ, min_le_right _ _, ?_⟩
  -- `‖Df(y)‖ ≤ ‖Df(x)‖ + ‖Df(y) - Df(x)‖ ≤ c + η` on `B_s(x)`
  have hbound : ∀ y ∈ ball x (min s₁ δ), ‖fderiv ℝ f y‖ ≤ c + η := by
    intro y hy
    have hy₁ : ‖fderiv ℝ f y - fderiv ℝ f x‖ < η := by
      rw [← dist_eq_norm]
      exact hDf ((mem_ball.1 hy).trans_le (min_le_left _ _))
    exact (norm_le_norm_add_norm_sub' _ _).trans (add_le_add hc hy₁.le)
  -- mean value inequality on the convex ball `B_s(x)`
  intro y hy z hz
  exact (convex_ball x (min s₁ δ)).norm_image_sub_le_of_norm_fderiv_le
    (fun w hw => hdiff w (ball_subset_ball (min_le_right _ _) hw)) hbound hz hy
/-- **Simon 7.3.1** (proof; local retraction onto `N`, step 1): an injective linear map
`L : ℝᵈ → ℝᴾ` has a left inverse `A` with `‖L ∘ A‖ ≤ 1`.  With `Q = L(ℝᵈ)`, `p` the orthogonal
projection of `ℝᴾ` onto `Q` and `e : ℝᵈ ≃ Q`, `e w = L w`, take `A = e⁻¹ ∘ p`: then `A ∘ L = id`,
and `L ∘ A` is the orthogonal projection of `ℝᴾ` onto `Q`, of norm `≤ 1`. -/
theorem Submission.dtc_bc_lr_left_inverse_projection : ∀ (P d : ℕ) (L : Euclid d →L[ℝ] Euclid P), Injective L → ∃ A : Euclid P →L[ℝ] Euclid d, A.comp L = ContinuousLinearMap.id ℝ (Euclid d) ∧ ‖L.comp A‖ ≤ 1 := by
  intro P d L hL
  -- `Q = L(ℝᵈ)` and the isomorphism `e : ℝᵈ ≃ Q`, `e w = L w`
  let Q : Submodule ℝ (Euclid P) := LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)
  let e : Euclid d ≃L[ℝ] Q :=
    (LinearEquiv.ofInjective (L : Euclid d →ₗ[ℝ] Euclid P) hL).toContinuousLinearEquiv
  have he : ∀ w, (e w : Euclid P) = L w := fun w => rfl
  -- `A = e⁻¹ ∘ p`, `p` the orthogonal projection onto `Q`
  refine ⟨(e.symm : Q →L[ℝ] Euclid d).comp Q.orthogonalProjectionOnto, ?_, ?_⟩
  · -- `p (L w) = e w`, so `A (L w) = w`
    refine ContinuousLinearMap.ext fun w => ?_
    have hp : Q.orthogonalProjectionOnto (L w) = e w := by
      rw [← he]
      exact Q.orthogonalProjectionOnto_mem_subspace_eq_self (e w)
    simp [hp]
  · -- `L ∘ A = ι ∘ p` is the orthogonal projection of `ℝᴾ` onto `Q`
    have hLA : L.comp ((e.symm : Q →L[ℝ] Euclid d).comp Q.orthogonalProjectionOnto) =
        Q.starProjection := by
      refine ContinuousLinearMap.ext fun y => ?_
      rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearEquiv.coe_coe, ← he, ContinuousLinearEquiv.apply_symm_apply,
        Submodule.starProjection_apply]
    rw [hLA]
    exact Q.starProjection_norm_le
/-- **Local `C¹` inverse** (inverse function theorem, step 2 of the local retraction in the proof
of Simon 7.3.1).  If `h` is `C¹` on the open set `V ∋ v₀` with `Dh(v₀) = id`, there are open
`V₀ ⊆ V` with `v₀ ∈ V₀` and `O`, and `k`, `C¹` on `O`, such that `h : V₀ → O` and `k : O → V₀` are
mutually inverse, and `Dk(h(v₀)) = id`.  The inverse function theorem gives a partial
homeomorphism `e` with `⇑e = h`, source `S ∋ v₀` and target `T`; on the open set
`G = {v ∈ V : ‖Dh(v) − 1‖ < 1}` (which contains `v₀`) `Dh(v)` is invertible (Neumann series).  Take
`V₀ = S ∩ G`, `O = T ∩ e.symm⁻¹(V₀)`, `k = e.symm`; the `C¹` inverse rule at each `u ∈ O` makes
`k` `C¹` on `O`, and `k` has derivative `id⁻¹ = id` at `h(v₀)`. -/
theorem Submission.dtc_bc_lr_local_inverse : ∀ (d : ℕ) (h : Euclid d → Euclid d) (V : Set (Euclid d)) (v₀ : Euclid d), IsOpen V → v₀ ∈ V → ContDiffOn ℝ 1 h V → fderiv ℝ h v₀ = ContinuousLinearMap.id ℝ (Euclid d) → ∃ (V₀ O : Set (Euclid d)) (k : Euclid d → Euclid d), IsOpen V₀ ∧ IsOpen O ∧ V₀ ⊆ V ∧ v₀ ∈ V₀ ∧ MapsTo h V₀ O ∧ MapsTo k O V₀ ∧ (∀ v ∈ V₀, k (h v) = v) ∧ (∀ u ∈ O, h (k u) = u) ∧ ContDiffOn ℝ 1 k O ∧ fderiv ℝ k (h v₀) = ContinuousLinearMap.id ℝ (Euclid d) := by
  intro d h V v₀ hV hv₀ hh hd
  -- Step 1: `h` is `C¹` at every point of `V`, `Dh` is continuous on `V`, and `h` has strict
  -- derivative `id` at `v₀`
  have hca : ∀ v ∈ V, ContDiffAt ℝ 1 h v := fun v hv => hh.contDiffAt (hV.mem_nhds hv)
  have hcont : ContinuousOn (fderiv ℝ h) V := hh.continuousOn_fderiv_of_isOpen hV le_rfl
  have hfd : HasFDerivAt h
      ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
        Euclid d →L[ℝ] Euclid d) v₀ := by
    rw [ContinuousLinearEquiv.coe_refl, ← hd]
    exact ((hca v₀ hv₀).differentiableAt one_ne_zero).hasFDerivAt
  have hs := (hca v₀ hv₀).hasStrictFDerivAt' hfd one_ne_zero
  -- Step 2: the inverse function theorem gives a partial homeomorphism `e` with `⇑e = h`, and
  -- its inverse has derivative `id⁻¹ = id` at `h(v₀)`
  obtain ⟨e, he⟩ : ∃ e : OpenPartialHomeomorph (Euclid d) (Euclid d),
      e = hs.toOpenPartialHomeomorph h := ⟨_, rfl⟩
  have hecoe : (e : Euclid d → Euclid d) = h := by
    rw [he]; exact hs.toOpenPartialHomeomorph_coe
  have hv₀e : v₀ ∈ e.source := by
    rw [he]; exact hs.mem_toOpenPartialHomeomorph_source
  have hk : HasFDerivAt (e.symm : Euclid d → Euclid d) (ContinuousLinearMap.id ℝ (Euclid d))
      (h v₀) := by
    have h7 := hs.to_localInverse
    rw [hs.localInverse_def, ← he, ContinuousLinearEquiv.refl_symm,
      ContinuousLinearEquiv.coe_refl] at h7
    exact h7.hasFDerivAt
  -- Step 3: `G = {v ∈ V : ‖Dh(v) − 1‖ < 1}` is open, contains `v₀`, and `Dh(v)` is invertible
  -- for `v ∈ G`
  obtain ⟨G, hG⟩ : ∃ G : Set (Euclid d), G = V ∩ fderiv ℝ h ⁻¹' ball 1 1 := ⟨_, rfl⟩
  have hGo : IsOpen G := hG ▸ hcont.isOpen_inter_preimage hV isOpen_ball
  have hGV : G ⊆ V := hG ▸ inter_subset_left
  have hv₀G : v₀ ∈ G := by
    rw [hG]
    refine ⟨hv₀, ?_⟩
    show fderiv ℝ h v₀ ∈ ball 1 1
    rw [hd, ← ContinuousLinearMap.one_def]
    exact mem_ball_self one_pos
  have hGu : ∀ v ∈ G, ∃ L : Euclid d ≃L[ℝ] Euclid d,
      (L : Euclid d →L[ℝ] Euclid d) = fderiv ℝ h v := by
    intro v hv
    rw [hG] at hv
    have hu : IsUnit (fderiv ℝ h v) := by
      by_contra hnu
      exact nonunits.subset_compl_ball (mem_nonunits_iff.mpr hnu) hv.2
    obtain ⟨u, hu⟩ := hu
    refine ⟨ContinuousLinearEquiv.unitsEquiv ℝ (Euclid d) u, ?_⟩
    ext x
    simp [ContinuousLinearEquiv.unitsEquiv_apply, ← hu]
  -- Step 4: `V₀ = S ∩ G`, `O = T ∩ e.symm⁻¹(V₀)`, `k = e.symm`
  refine ⟨e.source ∩ G, e.target ∩ e.symm ⁻¹' (e.source ∩ G), e.symm,
    e.open_source.inter hGo, e.isOpen_inter_preimage_symm (e.open_source.inter hGo),
    fun v hv => hGV hv.2, ⟨hv₀e, hv₀G⟩, ?_, fun u hu => hu.2, fun v hv => ?_, fun u hu => ?_,
    ?_, ?_⟩
  -- Step 5: mapping and inverse identities
  · intro v hv
    have h1 := e.map_source hv.1
    have h2 := e.left_inv hv.1
    rw [hecoe] at h1 h2
    exact ⟨h1, by rw [mem_preimage, h2]; exact hv⟩
  · have h2 := e.left_inv hv.1
    rwa [hecoe] at h2
  · have h2 := e.right_inv hu.1
    rwa [hecoe] at h2
  -- Step 6: `k` is `C¹` on `O`, by the `C¹` inverse rule at each `u ∈ O`
  · intro u hu
    obtain ⟨L, hL⟩ := hGu _ hu.2.2
    have ha : e.symm u ∈ V := hGV hu.2.2
    have hfa : HasFDerivAt (e : Euclid d → Euclid d) (L : Euclid d →L[ℝ] Euclid d)
        (e.symm u) := by
      rw [hL, hecoe]
      exact ((hca _ ha).differentiableAt one_ne_zero).hasFDerivAt
    have hca' : ContDiffAt ℝ 1 (e : Euclid d → Euclid d) (e.symm u) := by
      rw [hecoe]; exact hca _ ha
    exact (e.contDiffAt_symm hu.1 hfa hca').contDiffWithinAt
  -- Step 7: `Dk(h(v₀)) = id`
  · exact hk.fderiv
/-- **Simon 7.3.1** (proof of (2), local retraction onto `N`, chart step): if `W` is open, `ψ` is
continuous and injective on `V`, `ψ(V) = W ∩ N` and `ψ` is proper over `W` (`V ∩ ψ⁻¹(K)` is
compact for compact `K ⊆ W`), then `N ∩ B_ρ(ψ(v₀)) ⊆ ψ(V₀)` for some `ρ > 0`, whenever `V₀ ⊆ V`
is open and `v₀ ∈ V₀`.  Otherwise there are `yᵢ = ψ(fᵢ) ∈ N` with `fᵢ ∈ V \ V₀` and
`yᵢ → ψ(v₀)`; the `fᵢ` lie in the compact set `V ∩ ψ⁻¹({ψ(v₀)} ∪ {yᵢ})`, so a subsequence
converges to some `a ∈ V \ V₀` with `ψ(a) = ψ(v₀)`, contradicting injectivity. -/
theorem Submission.dtc_bc_lr_chart_image_nhds : ∀ (P d : ℕ) (N W : Set (Euclid P)) (V V₀ : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen W → ContinuousOn ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → IsOpen V₀ → V₀ ⊆ V → v₀ ∈ V₀ → ∃ ρ : ℝ, 0 < ρ ∧ N ∩ ball (ψ v₀) ρ ⊆ ψ '' V₀ := by
  intro P d N W V V₀ ψ v₀ hW hψc hψi hψV hprop hV₀ hV₀V hv₀
  -- Step 1: `x := ψ v₀ ∈ W` and `B_{r_W}(x) ⊆ W`
  have hv₀V : v₀ ∈ V := hV₀V hv₀
  have hxW : ψ v₀ ∈ W := (hψV ▸ mem_image_of_mem ψ hv₀V : ψ v₀ ∈ W ∩ N).1
  obtain ⟨rW, hrW, hballW⟩ := Metric.isOpen_iff.1 hW _ hxW
  -- Step 2: otherwise pick `yᵢ ∈ N ∩ B_{min(r_W, 1/(i+1))}(x) \ ψ(V₀)`, so `yᵢ ∈ W` and `yᵢ → x`
  by_contra hcon
  have hseq : ∀ i : ℕ, ∃ y, y ∈ N ∧ dist y (ψ v₀) < min rW (1 / ((i : ℝ) + 1)) ∧ y ∉ ψ '' V₀ := by
    intro i
    obtain ⟨y, ⟨hyN, hyb⟩, hy⟩ := not_subset.1 fun h =>
      hcon ⟨min rW (1 / ((i : ℝ) + 1)), lt_min hrW (by positivity), h⟩
    exact ⟨y, hyN, hyb, hy⟩
  choose y hyN hyd hyV₀ using hseq
  have hyW : ∀ i, y i ∈ W := fun i => hballW ((hyd i).trans_le (min_le_left _ _))
  have hylim : Tendsto y atTop (𝓝 (ψ v₀)) :=
    tendsto_iff_dist_tendsto_zero.2 (squeeze_zero (fun i => dist_nonneg)
      (fun i => ((hyd i).trans_le (min_le_right _ _)).le) tendsto_one_div_add_atTop_nhds_zero_nat)
  -- Step 3: `yᵢ = ψ(fᵢ)` with `fᵢ ∈ V \ V₀`
  have hf : ∀ i, ∃ f, f ∈ V ∧ ψ f = y i := fun i => (hψV.symm ▸ ⟨hyW i, hyN i⟩ : y i ∈ ψ '' V)
  choose f hfV hfy using hf
  have hfV₀ : ∀ i, f i ∉ V₀ := fun i hi => hyV₀ i ⟨f i, hi, hfy i⟩
  -- Step 4: `K := {x} ∪ {yᵢ}` is a compact subset of `W`, so `V ∩ ψ⁻¹(K) ∋ fᵢ` is compact
  have hKW : insert (ψ v₀) (range y) ⊆ W := by
    rintro z (rfl | ⟨i, rfl⟩)
    exacts [hxW, hyW i]
  have hfK : ∀ i, f i ∈ V ∩ ψ ⁻¹' insert (ψ v₀) (range y) := fun i =>
    ⟨hfV i, Or.inr ⟨i, (hfy i).symm⟩⟩
  -- Step 5: a subsequence `f_{φ(i)} → a ∈ V`
  obtain ⟨a, ⟨haV, -⟩, φ, hφ, hfa⟩ :=
    (hprop _ hKW hylim.isCompact_insert_range).tendsto_subseq hfK
  -- Step 6: `a ∉ V₀`, as `V₀ᶜ` is closed
  have haV₀ : a ∉ V₀ :=
    hV₀.isClosed_compl.mem_of_tendsto hfa (Eventually.of_forall fun i => hfV₀ (φ i))
  -- Step 7: `ψ(a) = x` by continuity of `ψ` on `V` and uniqueness of limits
  have h₁ : Tendsto (ψ ∘ (f ∘ φ)) atTop (𝓝 (ψ a)) :=
    (hψc a haV).tendsto.comp
      (tendsto_nhdsWithin_iff.2 ⟨hfa, Eventually.of_forall fun i => hfV (φ i)⟩)
  have h₂ : Tendsto (ψ ∘ (f ∘ φ)) atTop (𝓝 (ψ v₀)) := by
    have hcomp : ψ ∘ (f ∘ φ) = y ∘ φ := funext fun i => hfy (φ i)
    rw [hcomp]
    exact hylim.comp hφ.tendsto_atTop
  -- Step 8: injectivity gives `a = v₀ ∈ V₀`, a contradiction
  exact haV₀ (hψi haV hv₀V (tendsto_nhds_unique h₁ h₂) ▸ hv₀)

/-- **Local `C¹` retraction onto an embedded `C²` submanifold** (proof of Simon 7.3.1; it stands
in for the nearest-point projection onto `N`, cf. Simon 7.5).  For `x ∈ N` there are `δ > 0` and
`π`, `C¹` on `B_δ(x)`, with `π(B_δ(x)) ⊆ N`, `π = id` on `N ∩ B_δ(x)`, and, for every `η > 0`,
`π` is `(1 + η)`-Lipschitz on some `B_s(x)`, `0 < s ≤ δ`.

* A chart `ψ` with `ψ(v₀) = x`, and a left inverse `A` of `L = Dψ(v₀)` with `‖L ∘ A‖ ≤ 1`.
* Inverse function theorem for `h = A(ψ − x)`, `Dh(v₀) = A ∘ L = id`: a `C¹` inverse
  `k : O → V₀` with `Dk(h(v₀)) = id`.
* Properness of the chart: `N ∩ B_ρ(x) ⊆ ψ(V₀)`.
* `π(y) = ψ(k(A(y − x)))`, `δ = min(ρ, r₀/(‖A‖ + 1))` with `B_{r₀}(0) ⊆ O`; `π` fixes
  `N ∩ B_δ(x)` because `A(ψ(v) − x) = h(v)`, and `Dπ(x) = L ∘ A` has norm `≤ 1`. -/
theorem Submission.dtc_bc_local_retraction : ∀ (P d : ℕ) (N : Set (Euclid P)) (x : Euclid P), IsEmbeddedSubmanifold 2 d N → x ∈ N → ∃ (δ : ℝ) (π : Euclid P → Euclid P), 0 < δ ∧ ContDiffOn ℝ 1 π (ball x δ) ∧ MapsTo π (ball x δ) N ∧ (∀ y ∈ N ∩ ball x δ, π y = y) ∧ ∀ η : ℝ, 0 < η → ∃ s : ℝ, 0 < s ∧ s ≤ δ ∧ ∀ y ∈ ball x s, ∀ z ∈ ball x s, ‖π y - π z‖ ≤ (1 + η) * ‖y - z‖ := by
  intro P d N x hN hx
  -- Step 1: a chart `ψ` at `x = ψ v₀`, `L = Dψ(v₀)` and a left inverse `A` of `L`
  obtain ⟨V, W, ψ, hVo, hWo, hxW, hψ2, hψinj, hψV, hψK, hψD⟩ := hN x hx
  obtain ⟨v₀, hv₀V, hψv₀⟩ : x ∈ ψ '' V := hψV ▸ ⟨hxW, hx⟩
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ2.of_le (by norm_num)
  have hψv₀D : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ :=
    ((hψ1.contDiffAt (hVo.mem_nhds hv₀V)).differentiableAt one_ne_zero).hasFDerivAt
  obtain ⟨A, hAL, hLA⟩ :=
    Submission.dtc_bc_lr_left_inverse_projection P d (fderiv ℝ ψ v₀) (hψD v₀ hv₀V)
  -- Step 2: the local inverse `k` of `h = A (ψ - x)` near `v₀`
  set h : Euclid d → Euclid d := fun v => A (ψ v - x) with hh_def
  have hh1 : ContDiffOn ℝ 1 h V := A.contDiff.comp_contDiffOn (hψ1.sub contDiffOn_const)
  have hhD : fderiv ℝ h v₀ = ContinuousLinearMap.id ℝ (Euclid d) := by
    rw [← hAL]
    exact (A.hasFDerivAt.comp v₀ (hψv₀D.sub_const x)).fderiv
  obtain ⟨V₀, O, k, hV₀o, hOo, hV₀V, hv₀V₀, hhV₀, hkO, hkh, -, hk1, hkD⟩ :=
    Submission.dtc_bc_lr_local_inverse d h V v₀ hVo hv₀V hh1 hhD
  have hh0 : h v₀ = 0 := by simp [hh_def, hψv₀]
  -- Step 3: `ψ(V₀)` is a neighbourhood of `x` in `N`
  obtain ⟨ρ, hρ, hρV₀⟩ := Submission.dtc_bc_lr_chart_image_nhds P d N W V V₀ ψ v₀ hWo
    hψ1.continuousOn hψinj hψV hψK hV₀o hV₀V hv₀V₀
  rw [hψv₀] at hρV₀
  -- Step 4: `δ` and `π(y) = ψ (k (A (y - x)))`
  obtain ⟨r₀, hr₀, hr₀O⟩ := Metric.isOpen_iff.1 hOo 0 (by rw [← hh0]; exact hhV₀ hv₀V₀)
  have hA1 : 0 < ‖A‖ + 1 := by positivity
  set δ : ℝ := min ρ (r₀ / (‖A‖ + 1))
  have hδ : 0 < δ := lt_min hρ (div_pos hr₀ hA1)
  have hAO : MapsTo (fun y => A (y - x)) (ball x δ) O := by
    intro y hy
    apply hr₀O
    rw [mem_ball_zero_iff]
    have hy' : ‖y - x‖ < r₀ / (‖A‖ + 1) := (mem_ball_iff_norm.1 hy).trans_le (min_le_right _ _)
    calc ‖A (y - x)‖ ≤ ‖A‖ * ‖y - x‖ := A.le_opNorm _
      _ ≤ (‖A‖ + 1) * ‖y - x‖ := mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _)
      _ < (‖A‖ + 1) * (r₀ / (‖A‖ + 1)) := mul_lt_mul_of_pos_left hy' hA1
      _ = r₀ := by field_simp
  -- (i) `π` is `C¹` on `B_δ(x)`
  have hπ1 : ContDiffOn ℝ 1 (fun y => ψ (k (A (y - x)))) (ball x δ) :=
    hψ1.comp (hk1.comp (A.contDiff.comp (contDiff_id.sub contDiff_const)).contDiffOn hAO)
      ((hkO.comp hAO).mono_right hV₀V)
  -- (ii) `π(B_δ(x)) ⊆ N`
  have hπN : MapsTo (fun y => ψ (k (A (y - x)))) (ball x δ) N := by
    intro y hy
    have hy' : ψ (k (A (y - x))) ∈ ψ '' V := mem_image_of_mem ψ (hV₀V (hkO (hAO hy)))
    rw [hψV] at hy'
    exact hy'.2
  -- (iii) `π` fixes `N ∩ B_δ(x)`
  have hπfix : ∀ y ∈ N ∩ ball x δ, ψ (k (A (y - x))) = y := by
    rintro y ⟨hyN, hy⟩
    obtain ⟨v, hv, rfl⟩ := hρV₀ ⟨hyN, ball_subset_ball (min_le_left _ _) hy⟩
    exact congrArg ψ (hkh v hv)
  -- `Dπ(x) = L ∘ Dk(h(v₀)) ∘ A = L ∘ A` has norm `≤ 1`
  have hπD : ‖fderiv ℝ (fun y => ψ (k (A (y - x)))) x‖ ≤ 1 := by
    have hg : HasFDerivAt (fun y => A (y - x)) A x := by
      have := A.hasFDerivAt.comp x ((hasFDerivAt_id x).sub_const x)
      rw [ContinuousLinearMap.comp_id] at this
      exact this
    have hgx : A (x - x) = h v₀ := by rw [hh0, sub_self, map_zero]
    have hk : HasFDerivAt k (ContinuousLinearMap.id ℝ (Euclid d)) (A (x - x)) := by
      rw [hgx, ← hkD]
      exact ((hk1.contDiffAt (hOo.mem_nhds (hhV₀ hv₀V₀))).differentiableAt
        one_ne_zero).hasFDerivAt
    have hψ' : HasFDerivAt ψ (fderiv ℝ ψ v₀) (k (A (x - x))) := by
      rw [hgx, hkh v₀ hv₀V₀]
      exact hψv₀D
    have hπx : HasFDerivAt (fun y => ψ (k (A (y - x))))
        ((fderiv ℝ ψ v₀).comp ((ContinuousLinearMap.id ℝ (Euclid d)).comp A)) x :=
      hψ'.comp x (hk.comp x hg)
    rw [hπx.fderiv, ContinuousLinearMap.id_comp]
    exact hLA
  -- (iv) Lipschitz constant `1 + η` near `x`
  exact ⟨δ, fun y => ψ (k (A (y - x))), hδ, hπ1, hπN, hπfix,
    fun η hη => Submission.dtc_bc_lr_lipschitz_near_point P _ x δ 1 hδ hπ1 hπD η hη⟩

/-- **The blow-ups satisfy the hypotheses of the compactness theorem** (proof of Simon 7.3.1,
display (1), chapter-07.txt lines 326–337; compactness theorem 7.2.4 in the form of
Remark 7.2.5(2)).  Let `T` be minimizing in `U ∩ N`, `spt T ⊆ U ∩ N`, `x ∈ spt T \ spt ∂T`,
`Θⁿ(μ_T, x) = θ`, and `λⱼ > 0`, `λⱼ → 0`; put `ηⱼ = η_{x,λⱼ}` and `Sⱼ = η_{x,λⱼ#}T`.  Then
(1) `ηⱼ(U)` is open; (2) `B̄_R(0) ⊆ ηⱼ(U)` for large `j`; (3) `Sⱼ` is minimizing in
`ηⱼ(U ∩ N)`; (4) `spt Sⱼ ⊆ ηⱼ(U ∩ N)`; (5) `M_{B_R(0)}(Sⱼ)` is bounded for large `j`;
(6) `∂Sⱼ = 0` in `B_R(0)` for large `j`; (7) there are `C¹` retractions `πⱼ` of `B_G(0)` onto
`ηⱼ(U ∩ N)` with `|πⱼ(y)| ≤ 2|y|` and Lipschitz constants tending to `1`.

* (1), (2), (6): `dtc_bc_bh_blowUp_domain_boundary`, as `x ∈ U` and `x ∉ spt ∂T`.
* (3): `dtc_blowUp_scaling` with `A = U ∩ N`.
* (4): `spt Sⱼ = ηⱼ(spt T)` (`dtc_blowUp_algebra`) and `spt T ⊆ U ∩ N`.
* (5): `dtc_bc_bh_blowUp_massOn_ball_bounded`, from the finite density at `x`.
* (7): a local retraction `π` onto `N` at `x ∈ N` (`dtc_bc_local_retraction`), rescaled to
  `πⱼ = ηⱼ ∘ π ∘ ηⱼ⁻¹` by `dtc_bc_bh_rescaled_retraction`. -/
theorem Submission.dtc_bc_blowUp_hypotheses : ∀ (m k ℓ : ℕ) (U N : Set (Euclid (m + 1 + k))) (T : GeometricCurrentOn U (m + 1)) (x : Euclid (m + 1 + k)) (θ : ℝ), IsOpen U → IsEmbeddedSubmanifold 2 (m + 1 + ℓ) N → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → x ∈ T.support \ boundarySupport T → HasMassDensity T x θ → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → (∀ j, IsOpen (dilation x (lams j) '' U)) ∧ (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid (m + 1 + k)) R ⊆ dilation x (lams j) '' U) ∧ (∀ j, IsMinimizingIn (blowUp T x (lams j) (hlams j).ne') (dilation x (lams j) '' (U ∩ N))) ∧ (∀ j, (blowUp T x (lams j) (hlams j).ne').support ⊆ dilation x (lams j) '' (U ∩ N)) ∧ (∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (blowUp T x (lams j) (hlams j).ne').massOn (ball 0 R) ≤ c) ∧ (∀ R : ℝ, ∀ᶠ j in atTop, ∀ ω : TestFormOn (dilation x (lams j) '' U) m, tsupport (ω : DifferentialForm (Euclid (m + 1 + k)) m) ⊆ ball 0 R → (blowUp T x (lams j) (hlams j).ne').boundary ω = 0) ∧ (∀ G : ℝ, 0 < G → ∃ πs : ℕ → Euclid (m + 1 + k) → Euclid (m + 1 + k), (∀ᶠ j in atTop, ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧ MapsTo (πs j) (ball 0 G) (dilation x (lams j) '' (U ∩ N)) ∧ (∀ y ∈ dilation x (lams j) '' (U ∩ N) ∩ ball 0 G, πs j y = y) ∧ ∀ y ∈ ball 0 G, ‖πs j y‖ ≤ 2 * ‖y‖) ∧ ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G, ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖) := by
  intro m k ℓ U N T x θ hU hN hmin hspt hx hθ lams hlams hlim
  -- `x ∈ spt T ⊆ U ∩ N`
  have hxU : x ∈ U := (hspt hx.1).1
  have hxN : x ∈ N := (hspt hx.1).2
  -- (1), (2), (6): the blown-up domains exhaust `ℝᴾ`, and `∂Sⱼ = 0` on growing balls
  obtain ⟨h1, h2, h6⟩ := Submission.dtc_bc_bh_blowUp_domain_boundary (m + 1 + k) m U T x hU hxU
    hx.2 lams hlams hlim
  refine ⟨h1, h2, ?_, ?_, ?_, h6, ?_⟩
  · -- (3) minimality in `U ∩ N` is carried to `ηⱼ(U ∩ N)`
    intro j
    exact (Submission.dtc_blowUp_scaling (m + 1 + k) (m + 1) U (U ∩ N) T x (lams j) (hlams j) hU
      (Nat.succ_pos m)).2.2 hmin
  · -- (4) `spt Sⱼ = ηⱼ(spt T) ⊆ ηⱼ(U ∩ N)`
    intro j
    rw [(Submission.dtc_blowUp_algebra (m + 1 + k) U x (lams j) (hlams j)).2.2.1 (m + 1) T]
    exact image_mono hspt
  · -- (5) local mass bounds from `Θⁿ(μ_T, x) = θ`
    exact Submission.dtc_bc_bh_blowUp_massOn_ball_bounded (m + 1 + k) (m + 1) U T x θ hU
      (Nat.succ_pos m) hθ lams hlams hlim
  · -- (7) rescale a local `C¹` retraction onto `N` at `x`
    intro G hG
    obtain ⟨δ, π, hδ, hC, hmaps, hid, hlip⟩ :=
      Submission.dtc_bc_local_retraction (m + 1 + k) (m + 1 + ℓ) N x hN hxN
    exact Submission.dtc_bc_bh_rescaled_retraction (m + 1 + k) U N x δ π hU hxU hxN hδ hC hmaps
      hid hlip lams hlams hlim G hG

/-- **Simon 7.2.4** (proof, pp. 186–187: (8) and its localization, (12)–(14) and the closing
"standard approximation argument").  Let `Sⱼ ∈ 𝒟ₙ(Uⱼ)`, the open `Uⱼ` exhausting `ℝᴾ`, converge
weakly to the integer multiplicity `C ∈ 𝒟ₙ(ℝᴾ)`, and assume the local comparison: for compact `K`,
`ε > 0` and every subsequence `ψ` there are an open `W`, `K ⊆ W ⊆ K_ε`, and a further subsequence
`φ'` with `limsup_i M_W(S_{ψ(φ'(i))}) ≤ M_W(S)` for every integer multiplicity `S` with `∂S = ∂C`
and `spt(S − C) ⊆ K`.  Then `C` is minimizing in `ℝᴾ` (`dtc_bc_mm_isMinimizingIn_univ`), and
`μ_{Sⱼ} → μ_C` for all representations: the weights satisfy the compact/open semicontinuity
bounds (`dtc_bc_mm_measure_bounds`), so the Radon criterion
`dtc_bc_tendsto_integral_of_limsup_liminf` gives `∫ f dμ_{Sⱼ} → ∫ f dμ_C`. -/
theorem Submission.dtc_bc_minimizing_of_local_comparison : ∀ (P n : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ j, IsOpen (Us j)) → (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → IsIntegerMultiplicity C → ConvergesWeakly Ss C → (∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ ∀ S : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity S → SameBoundary S C → (S - C).support ⊆ K → limsup (fun j => (Ss (ψ (φ' j))).massOn W) atTop ≤ S.massOn W) → IsMinimizingIn C univ ∧ MassMeasuresConverge Ss C := by
  intro P n Us Ss C hU hex hC hconv hloc
  -- step 1: `C` is minimizing in `ℝᴾ` (book (8) and its localization)
  refine ⟨Submission.dtc_bc_mm_isMinimizingIn_univ P n Us Ss C hex hC hconv hloc, ?_⟩
  -- step 2: for representations `Rⱼ` of `Sⱼ` and `R` of `C`, `μ = μ_R` is finite on compacts,
  -- `limsup_j μⱼ(K) ≤ μ(K)` for compact `K` (13) and `μ(G) ≤ liminf_j μⱼ(G)` for bounded open
  -- `G` (14); the condition `tsupport f ⊆ ℝᴾ` is vacuous
  intro Rs hRs R hR f hf hfc _
  obtain ⟨ha, hb, hc⟩ :=
    Submission.dtc_bc_mm_measure_bounds P n Us Ss C hU hex hconv hloc Rs hRs R hR
  exact Submission.dtc_bc_tendsto_integral_of_limsup_liminf P (fun j => (Rs j).measure)
    R.measure ha hb hc f hf hfc

/-- **Orthogonal projection does not increase `m`-dimensional area** (Simon Ch. 7 §3, footnote 2;
Gram-determinant form, cf. 6.3.4–3.5).  If `τ₁, …, τₘ` is orthonormal in `ℝᴾ` and `q` is the
orthogonal projection onto a subspace `V`, then `det(⟨qτᵢ, qτⱼ⟩) ≤ 1`.  With `U eᵢ = τᵢ` (an
isometry) and `T = q ∘ U` (a contraction), the Gram matrix is the matrix of `S = T* T` in the
standard basis, whose eigenvalues `λₖ = ‖T uₖ‖²` lie in `[0, 1]`; so `det G = ∏ₖ λₖ ≤ 1`. -/
theorem Submission.dimred_cs_sp_op_gram_det_starProjection_le_one : ∀ (P m : ℕ) (V : Submodule ℝ (Euclid P)) (τ : Fin m → Euclid P), Orthonormal ℝ τ → Matrix.det (Matrix.of fun i j => inner ℝ (V.starProjection (τ i)) (V.starProjection (τ j))) ≤ 1 := by
  intro P m V τ hτ
  classical
  let b := EuclideanSpace.basisFun (Fin m) ℝ
  let v : Fin m → Euclid P := fun i => V.starProjection (τ i)
  -- `U eᵢ = τᵢ` (an isometry since `τ` is orthonormal), `T eᵢ = q τᵢ`, so `T = q ∘ U`
  let U : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Euclid P := b.toBasis.constr ℝ τ
  let T : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Euclid P := b.toBasis.constr ℝ v
  let S := LinearMap.adjoint T ∘ₗ T
  have hS : S.IsSymmetric := LinearMap.isSymmetric_adjoint_comp_self T
  have hn : Module.finrank ℝ (EuclideanSpace ℝ (Fin m)) = m := finrank_euclideanSpace_fin
  have hUe : ∀ a, U (b a) = τ a := by
    intro a
    have := b.toBasis.constr_basis ℝ τ a
    rw [OrthonormalBasis.coe_toBasis] at this
    exact this
  have hTe : ∀ a, T (b a) = v a := by
    intro a
    have := b.toBasis.constr_basis ℝ v a
    rw [OrthonormalBasis.coe_toBasis] at this
    exact this
  have hTU : ∀ c, T c = V.starProjection (U c) := by
    have hlin : T = (V.starProjection : Euclid P →L[ℝ] Euclid P).toLinearMap ∘ₗ U := by
      apply b.toBasis.ext
      intro a
      rw [OrthonormalBasis.coe_toBasis, LinearMap.comp_apply, hTe, hUe]
      rfl
    intro c
    rw [hlin]
    rfl
  have hUiso : ∀ c, ‖U c‖ = ‖c‖ := by
    intro c
    have hb : Orthonormal ℝ (b.toBasis : Fin m → EuclideanSpace ℝ (Fin m)) := by
      rw [OrthonormalBasis.coe_toBasis]; exact b.orthonormal
    have hf : Orthonormal ℝ (U ∘ b.toBasis) := by
      have hcomp : (U ∘ b.toBasis) = τ := by
        funext a
        simp only [Function.comp_apply, OrthonormalBasis.coe_toBasis, hUe]
      rw [hcomp]; exact hτ
    exact (U.isometryOfOrthonormal hb hf).norm_map c
  -- the orthogonal projection is a contraction, so `‖T c‖ ≤ ‖c‖`
  have hcontr : ∀ c, ‖T c‖ ≤ ‖c‖ := by
    intro c
    rw [hTU, ← hUiso c]
    exact V.norm_starProjection_apply_le (U c)
  have hSinner : ∀ x y, inner ℝ x (S y) = inner ℝ (T x) (T y) := by
    intro x y
    simp [S, LinearMap.adjoint_inner_right]
  -- the matrix of `S` in the standard basis is the Gram matrix `G`
  have hmat :
      LinearMap.toMatrix b.toBasis b.toBasis S = Matrix.of fun i j => inner ℝ (v i) (v j) := by
    ext i j
    rw [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
      OrthonormalBasis.repr_apply_apply, OrthonormalBasis.coe_toBasis, hSinner, hTe, hTe]
    rfl
  have hdet : LinearMap.det S = Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) := by
    rw [← LinearMap.det_toMatrix b.toBasis, hmat]
  -- spectral theorem: `λₖ = ⟪uₖ, S uₖ⟫ = ‖T uₖ‖² ∈ [0, 1]`
  have hbounds : ∀ k, 0 ≤ hS.eigenvalues hn k ∧ hS.eigenvalues hn k ≤ 1 := by
    intro k
    have h1 := hS.apply_eigenvectorBasis hn k
    have hu : ‖hS.eigenvectorBasis hn k‖ = 1 := (hS.eigenvectorBasis hn).orthonormal.1 k
    have h2 : inner ℝ (hS.eigenvectorBasis hn k) (S (hS.eigenvectorBasis hn k)) =
        hS.eigenvalues hn k := by
      rw [h1, inner_smul_right, real_inner_self_eq_norm_sq, hu]
      simp
    rw [← h2, hSinner, real_inner_self_eq_norm_sq]
    have h3 := hcontr (hS.eigenvectorBasis hn k)
    rw [hu] at h3
    have h4 := norm_nonneg (T (hS.eigenvectorBasis hn k))
    exact ⟨by positivity, pow_le_one₀ h4 h3⟩
  change Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) ≤ 1
  rw [← hdet, hS.det_eq_prod_eigenvalues hn]
  simp only [RCLike.ofReal_real_eq_id, id]
  exact Finset.prod_le_one₀ (fun k _ => (hbounds k).1) (fun k _ => (hbounds k).2)

/-- **Simon 7.3.1, footnote 2; 6.3.4–3.5** (orthogonal projection does not increase area): if
`ξ = ±τ₁ ∧ ⋯ ∧ τₘ` is a unit orientation of `Q` and `q` is the orthogonal projection onto `V`,
then `|⟨α ∘ q, ξ⟩| = |α(qτ₁, …, qτₘ)| ≤ |α|_E · det(⟨qτᵢ, qτⱼ⟩)^{1/2} ≤ |α|_E`, by the Gram bound
of `covectorEuclideanNorm_gram_bounds` and `det(⟨qτᵢ, qτⱼ⟩) ≤ 1` (`q` is a contraction). -/
theorem Submission.dimred_cs_sp_orient_projection_le : ∀ (P m : ℕ) (V Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P m) (α : Covector (Euclid P) m), IsUnitOrientationOf ξ Q → |ξ (α.compContinuousLinearMap V.starProjection)| ≤ covectorEuclideanNorm α := by
  intro P m V Q ξ α hξ
  obtain ⟨τ, hτ, -, hsign⟩ := hξ
  -- `ξ(α ∘ q) = ±(α ∘ q)(τ) = ±α(qτ₁, …, qτₘ)`
  have hcomp : α.compContinuousLinearMap V.starProjection τ =
      α fun i => V.starProjection (τ i) := rfl
  have hval : |ξ (α.compContinuousLinearMap V.starProjection)| =
      |α fun i => V.starProjection (τ i)| := by
    rcases hsign with h | h
    · rw [h, hcomp]
    · rw [h, abs_neg, hcomp]
  -- the Gram bound for `v = qτ`, then `det(⟨qτᵢ, qτⱼ⟩) ≤ 1`
  rw [hval]
  calc |α fun i => V.starProjection (τ i)|
      ≤ covectorEuclideanNorm α * Real.sqrt (Matrix.det (Matrix.of fun i j =>
          inner ℝ (V.starProjection (τ i)) (V.starProjection (τ j)))) :=
        (Submission.covectorEuclideanNorm_gram_bounds P m).1 α _
    _ ≤ covectorEuclideanNorm α :=
        mul_le_of_le_one_right (covectorEuclideanNorm_nonneg α) (Real.sqrt_le_one.mpr
          (Submission.dimred_cs_sp_op_gram_det_starProjection_le_one P m V τ hτ))
/-- **Simon Ch. 6, 3.2(3)** (locality of the weight): if `S = τ(R_S)` and `T = τ(R_T)` agree on
every test form supported in the open set `O`, then `μ_{R_S}⌞O = μ_{R_T}⌞O`.  For open `G`,
`dor_imrep_massOn_eq_measure_and_support` gives `μ_{R_S}(G ∩ O) = M_{G ∩ O}(S)` and likewise for
`T`, while `M_{G ∩ O}(S) = M_{G ∩ O}(T)` because every admissible form is supported in `O`.  So
the restricted weights agree on open sets, a π-system generating the Borel sets, and both are
finite on the balls `B(0, j)` covering `ℝᴾ`. -/
theorem Submission.dimred_cs_sp_measure_restrict_eq_of_agree : ∀ (P m : ℕ) (S T : GeometricCurrentOn (univ : Set (Euclid P)) m) (RS RT : IMRep (univ : Set (Euclid P)) m) (O : Set (Euclid P)), IsOpen O → RS.Represents S → RT.Represents T → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ O → S ω = T ω) → RS.measure.restrict O = RT.measure.restrict O := by
  intro P m S T RS RT O hO hS hT hST
  have hmS := (Submission.dor_imrep_massOn_eq_measure_and_support P m univ S RS isOpen_univ hS).1
  have hmT := (Submission.dor_imrep_massOn_eq_measure_and_support P m univ T RT isOpen_univ hT).1
  -- `M_G(S) = M_G(T)` for `G ⊆ O`: the admissible forms are the same, and `S`, `T` agree on them
  have hmass : ∀ G : Set (Euclid P), G ⊆ O → S.massOn G = T.massOn G := by
    intro G hG
    unfold GeometricCurrentOn.massOn
    rw [image_congr fun ω hω => by rw [hST ω (hω.1.trans hG)]]
  -- the restricted weights agree on open sets
  have hopen : ∀ G : Set (Euclid P), IsOpen G →
      RS.measure.restrict O G = RT.measure.restrict O G := by
    intro G hG
    rw [Measure.restrict_apply hG.measurableSet, Measure.restrict_apply hG.measurableSet,
      ← hmS _ (hG.inter hO), ← hmT _ (hG.inter hO), hmass _ inter_subset_right]
  -- `μ_{R_S}⌞O (B(0, j)) ≤ μ_{R_S}(B̄(0, j)) = ∫_{M_S ∩ B̄(0, j)} θ_S dHᵐ < ∞`
  have hball : ∀ j : ℕ, RS.measure.restrict O (ball (0 : Euclid P) j) ≠ ∞ := by
    intro j
    have hfin : RS.measure (closedBall (0 : Euclid P) j) < ∞ := by
      rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
        Measure.restrict_restrict measurableSet_closedBall, inter_comm]
      exact (RS.locallyIntegrable_mult _ (isCompact_closedBall _ _) (subset_univ _)).lt_top
    exact ((Measure.restrict_apply_le _ _).trans
      (measure_mono ball_subset_closedBall)).trans_lt hfin |>.ne
  exact Measure.ext_of_generateFrom_of_iUnion {s | IsOpen s} (fun j : ℕ => ball (0 : Euclid P) j)
    BorelSpace.measurable_eq isPiSystem_isOpen (iUnion_ball_nat 0)
    (fun j => (isOpen_ball : IsOpen (ball (0 : Euclid P) j))) hball hopen

/-- **Simon Ch. 6, 2.11–2.12**: if `Y = τ(M, θ, ξ)` in `ℝᴾ` and `F ⊇ M` is closed, then
`spt Y ⊆ F`.  The open set `ℝᴾ ∖ F` misses `M`, so `μ_R(ℝᴾ ∖ F) = ∫_{(ℝᴾ ∖ F) ∩ M} θ dHⁿ = 0`;
an open `μ_R`-null set misses `spt μ_R`, and `spt Y = spt μ_R`. -/
theorem Submission.dimred_cs_sp_cp_support_subset_of_carrier_subset : ∀ (P n : ℕ) (Y : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (F : Set (Euclid P)), R.Represents Y → IsClosed F → R.carrier ⊆ F → Y.support ⊆ F := by
  intro P n Y R F hR hF hMF
  have hG : MeasurableSet Fᶜ := hF.isOpen_compl.measurableSet
  -- Step 1: `μ_R(ℝᴾ ∖ F) = ∫_{(ℝᴾ ∖ F) ∩ M} θ dHⁿ = 0`, because `(ℝᴾ ∖ F) ∩ M = ∅`
  have h0 : R.measure Fᶜ = 0 := by
    rw [IMRep.measure, withDensity_apply _ hG, Measure.restrict_restrict hG,
      (disjoint_compl_left_iff_subset.mpr hMF).inter_eq, Measure.restrict_empty,
      lintegral_zero_measure]
  -- Step 2: the open null set `ℝᴾ ∖ F` misses `spt μ_R`
  have hsupp : Fᶜ ⊆ R.measure.supportᶜ :=
    Measure.subset_compl_support_of_isOpen hF.isOpen_compl h0
  -- Step 3: `spt Y = ℝᴾ ∩ spt μ_R`
  have hY : Y.support = univ ∩ R.measure.support :=
    (Submission.dor_imrep_massOn_eq_measure_and_support P n univ Y R isOpen_univ hR).2
  intro x hx
  rw [hY] at hx
  by_contra hxF
  exact hsupp hxF hx.2
/-- **A compactly carried integer multiplicity cycle annihilates exact forms** (the cut-off step of
Simon Ch. 6, 2.23–2.24).  Let `X = τ(M, θ, ξ) ∈ 𝒟_{k+1}(ℝᴾ)` with `∂X = 0`, and let `K` be compact
with `μ_R(ℝᴾ ∖ K) = 0`, `μ_R = θ H^{k+1}⌞M`.  Then `∫_M θ ⟨dη, ξ⟩ dH^{k+1} = 0` for every smooth
`k`-form `η` (no support condition).  As `θ ≥ 1` on `M`, `H^{k+1}(M ∖ K) = 0`.  A bump function
`ζ ≡ 1` on a ball `B ⊇ K` makes `ψ = ζη` a test form with `dψ = dη` on `B`, so the integral equals
`X(dψ) = ∂X(ψ) = 0`. -/
theorem Submission.dimred_cs_sp_cp_action_extDeriv_eq_zero : ∀ (P k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)) (R : IMRep (univ : Set (Euclid P)) (k + 1)) (K : Set (Euclid P)) (η : DifferentialForm (Euclid P) k), R.Represents X → IsCompact K → R.measure Kᶜ = 0 → X.boundary = 0 → IsSmoothForm η → R.action (exteriorDerivative η) = 0 := by
  intro P k X R K η hR hK hμK hX hη
  -- Step 1: `θ ≥ 1` on `M`, so `H^{k+1}(M ∖ K) ≤ μ_R(ℝᴾ ∖ K) = 0`
  have hKc : MeasurableSet Kᶜ := hK.isClosed.measurableSet.compl
  have hnull : μHE[k + 1] (Kᶜ ∩ R.carrier) = 0 := by
    refine le_antisymm ?_ zero_le
    calc μHE[k + 1] (Kᶜ ∩ R.carrier) = ∫⁻ _ in Kᶜ ∩ R.carrier, 1 ∂μHE[k + 1] :=
          (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in Kᶜ ∩ R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k + 1] :=
          setLIntegral_mono' (hKc.inter R.measurableSet_carrier) fun x hx => by
            exact_mod_cast R.mult_pos x hx.2
      _ = R.measure Kᶜ := by
          rw [IMRep.measure, withDensity_apply _ hKc, Measure.restrict_restrict hKc]
      _ = 0 := hμK
  have hae : ∀ᵐ x ∂(μHE[k + 1].restrict R.carrier), x ∈ K := by
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    exact hnull
  -- Step 2: a bump function `ζ ≡ 1` on a ball `B ⊇ K` makes `ψ = ζη` a test form
  obtain ⟨r, hr⟩ := hK.isBounded.subset_ball (0 : Euclid P)
  let ζ : ContDiffBump (0 : Euclid P) :=
    ⟨max r 1, max r 1 + 1, zero_lt_one.trans_le (le_max_right r 1), lt_add_one _⟩
  have hKζ : K ⊆ ball (0 : Euclid P) ζ.rIn := hr.trans (ball_subset_ball (le_max_left r 1))
  let ψ : DifferentialForm (Euclid P) k := fun x => ζ x • η x
  have hψ : IsTestForm ψ := ⟨ζ.contDiff.smul hη, ζ.hasCompactSupport.smul_right⟩
  let ψt : TestFormOn (univ : Set (Euclid P)) k := ⟨ψ, hψ, subset_univ _⟩
  -- Step 3: `ψ = η` near each point of `B`, so `dψ = dη` on `B`
  have hloc : ∀ x ∈ ball (0 : Euclid P) ζ.rIn, exteriorDerivative ψ x = exteriorDerivative η x := by
    intro x hx
    refine Filter.EventuallyEq.extDeriv_eq ?_
    filter_upwards [ζ.eventuallyEq_one_of_mem_ball hx] with y hy
    simp only [ψ, hy, Pi.one_apply, one_smul]
  -- Step 4: the two integrals agree, as `H^{k+1}⌞M`-a.e. point lies in `K`
  have h4 : R.action (exteriorDerivative η) = R.action (exteriorDerivative ψ) := by
    simp only [IMRep.action]
    refine integral_congr_ae ?_
    filter_upwards [hae] with x hx
    rw [hloc x (hKζ hx)]
  -- Step 5: `R.action (dψ) = X(dψ) = ∂X(ψ) = 0`
  have h5 : R.action (exteriorDerivative ψ) = X (exteriorDerivativeTestOn univ k ψt) :=
    (hR (exteriorDerivativeTestOn univ k ψt)).symm
  rw [h4, h5, ← GeometricCurrentOn.boundary_apply, hX, GeometricCurrentOn.zero_apply]
/-- Continuity of translates: for a continuous compactly supported `j`-form `η`,
`t ↦ τ(M, θ, ξ)(η(t + ·))` is continuous on `ℝᴾ`.  For `‖t − t₀‖ < 1` the integrands vanish off
`B = B̄_ρ(0)`, `ρ = r + ‖t₀‖ + 1` where `spt η ⊆ B̄_r(0)`, and are dominated by `C₀ θ 1_B`,
`C₀` bounding `‖η‖` (as `‖ξ‖ ≤ 1` a.e.); `θ 1_B` is integrable since `θ` is locally
`Hʲ`-integrable, so dominated convergence gives continuity at `t₀`. -/
theorem Submission.dimred_cs_sos_mt_si_translate_action_continuous : ∀ (P j : ℕ) (R : IMRep (univ : Set (Euclid P)) j) (η : DifferentialForm (Euclid P) j), Continuous η → HasCompactSupport η → Continuous (fun t : Euclid P => R.action (fun y => η (t + y))) := by
  intro P j R η hηc hηs
  -- Step 1: `‖ξ(y)‖ ≤ 1` for `Hʲ⌞M`-a.e. `y`, as `ξ(y) α = ±α(τ)` with `τ` orthonormal
  have hξ : ∀ᵐ y ∂(μHE[j].restrict R.carrier), ‖R.orient y‖ ≤ 1 := by
    filter_upwards [R.orients] with y hy
    obtain ⟨Q, -, τ, hτ, -, hτξ⟩ := hy
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun α => ?_
    have hbound : ‖α τ‖ ≤ ‖α‖ := by
      simpa [hτ.1] using α.le_opNorm τ
    rcases hτξ with h | h
    · rw [h, one_mul]
      exact hbound
    · rw [h, norm_neg, one_mul]
      exact hbound
  -- Step 2: a bound `C₀` for `η` and a support radius `r`
  obtain ⟨C₀, hC₀⟩ := hηc.bounded_above_of_compact_support hηs
  have hC₀n : 0 ≤ C₀ := le_trans (norm_nonneg _) (hC₀ 0)
  obtain ⟨r, hr⟩ : ∃ r, tsupport η ⊆ closedBall (0 : Euclid P) r :=
    hηs.isCompact.isBounded.subset_closedBall 0
  -- Step 3: measurability of the integrands
  have hθm : Measurable fun y => (R.mult y : ℝ) := measurable_from_nat.comp R.measurable_mult
  have happly : Continuous fun p : MultiVector P j × Covector (Euclid P) j => p.1 p.2 :=
    continuous_fst.clm_apply continuous_snd
  have hmeas : ∀ t : Euclid P, AEStronglyMeasurable
      (fun y => (R.mult y : ℝ) * R.orient y (η (t + y))) (μHE[j].restrict R.carrier) :=
    fun t => hθm.aestronglyMeasurable.mul
      (happly.comp_aestronglyMeasurable
        (R.aestronglyMeasurable_orient.prodMk
          (hηc.comp (continuous_const.add continuous_id)).aestronglyMeasurable))
  -- Step 4: for each `y`, the integrand is continuous in `t`
  have hcont : ∀ y : Euclid P,
      Continuous fun t : Euclid P => (R.mult y : ℝ) * R.orient y (η (t + y)) := fun y =>
    continuous_const.mul
      ((R.orient y).continuous.comp (hηc.comp (continuous_id.add continuous_const)))
  rw [continuous_iff_continuousAt]
  intro t₀
  -- Step 5: the window `B = B̄_ρ(0)`, `ρ = r + ‖t₀‖ + 1`: if `‖t − t₀‖ < 1` and
  -- `t + y ∈ spt η`, then `y ∈ B`
  set ρ : ℝ := r + ‖t₀‖ + 1 with hρ
  set B : Set (Euclid P) := closedBall (0 : Euclid P) ρ with hB
  have hBm : MeasurableSet B := measurableSet_closedBall
  have hmemB : ∀ t ∈ ball t₀ 1, ∀ y : Euclid P, t + y ∈ tsupport η → y ∈ B := by
    intro t ht y hy
    have h1 : ‖t + y‖ ≤ r := by simpa using hr hy
    have h2 : ‖t - t₀‖ < 1 := by rwa [mem_ball, dist_eq_norm] at ht
    have h3 := norm_sub_norm_le t t₀
    have h4 := norm_sub_le (t + y) t
    rw [add_sub_cancel_left] at h4
    simp only [hB, mem_closedBall, dist_zero_right, hρ]
    linarith
  -- Step 6: `θ 1_B` is integrable, `θ` being locally `Hʲ`-integrable
  have hθB : IntegrableOn (fun y => (R.mult y : ℝ)) B (μHE[j].restrict R.carrier) := by
    refine ⟨hθm.aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_enorm, Measure.restrict_restrict hBm, inter_comm]
    simpa only [Real.enorm_natCast] using
      (R.locallyIntegrable_mult B (isCompact_closedBall 0 ρ) (subset_univ _)).lt_top
  -- Step 7: domination by `C₀ θ 1_B` for `t ∈ B₁(t₀)`
  have h_bound : ∀ᶠ t in 𝓝 t₀, ∀ᵐ y ∂(μHE[j].restrict R.carrier),
      ‖(R.mult y : ℝ) * R.orient y (η (t + y))‖ ≤
        C₀ * B.indicator (fun x => (R.mult x : ℝ)) y := by
    filter_upwards [ball_mem_nhds t₀ one_pos] with t ht
    filter_upwards [hξ] with y hy
    by_cases hty : t + y ∈ tsupport η
    · have hyB := hmemB t ht y hty
      rw [indicator_of_mem hyB, norm_mul, Real.norm_natCast]
      calc (R.mult y : ℝ) * ‖R.orient y (η (t + y))‖
          ≤ (R.mult y : ℝ) * (‖R.orient y‖ * ‖η (t + y)‖) := by
            gcongr; exact (R.orient y).le_opNorm _
        _ ≤ (R.mult y : ℝ) * (1 * C₀) := by
            gcongr
            exact hC₀ _
        _ = C₀ * (R.mult y : ℝ) := by ring
    · rw [image_eq_zero_of_notMem_tsupport hty, map_zero, mul_zero, norm_zero]
      by_cases hyB : y ∈ B
      · rw [indicator_of_mem hyB]; positivity
      · rw [indicator_of_notMem hyB, mul_zero]
  -- Step 8: dominated convergence
  show ContinuousAt (fun t => ∫ y in R.carrier, (R.mult y : ℝ) * R.orient y (η (t + y)) ∂μHE[j]) t₀
  exact continuousAt_of_dominated (Eventually.of_forall hmeas) h_bound
    ((hθB.integrable_indicator hBm).const_mul C₀)
    (Eventually.of_forall fun y => (hcont y).continuousAt)
/-- Translates along `G` of an action carried by `Gᗮ` vanish outside a compact set: if
`μ_R(ℝᴾ \ Gᗮ) = 0` and `η` has compact support, then `τ(M, θ, ξ)(η(t + ·)) = 0` for every
`t ∈ G \ K`, `K = p(spt η)` with `p` the orthogonal projection onto `G`.  As `θ ≥ 1` on `M`,
`Hʲ`-a.e. `y ∈ M` lies in `Gᗮ`, and there `η(t + y) ≠ 0` would give `t = p(t + y) ∈ K`. -/
theorem Submission.dimred_cs_sos_mt_si_translate_action_eq_zero_of_concentrated : ∀ (P j : ℕ) (G : Submodule ℝ (Euclid P)) (R : IMRep (univ : Set (Euclid P)) j) (η : DifferentialForm (Euclid P) j), HasCompactSupport η → R.measure (Gᗮ : Set (Euclid P))ᶜ = 0 → ∃ K : Set (Euclid P), IsCompact K ∧ ∀ t ∈ G, t ∉ K → R.action (fun y => η (t + y)) = 0 := by
  intro P j G R η hη hG
  -- Step 1: `K = p(spt η)` is compact, `p` the orthogonal projection onto `G`
  refine ⟨G.starProjection '' tsupport η, hη.isCompact.image G.starProjection.continuous, ?_⟩
  intro t ht htK
  -- Step 2: `Hʲ⌞M`-a.e. point lies in `Gᗮ`, since `θ ≠ 0` on `M`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hae : ∀ᵐ y ∂(μHE[j].restrict R.carrier), y ∈ (Gᗮ : Set (Euclid P)) := by
    have h1 : ∀ᵐ y ∂R.measure, y ∈ (Gᗮ : Set (Euclid P)) := mem_ae_iff.2 hG
    filter_upwards [(ae_withDensity_iff hθ).1 h1, ae_restrict_mem R.measurableSet_carrier]
      with y hy hyM
    exact hy (by exact_mod_cast (R.mult_pos y hyM).ne')
  -- Step 3: the integrand vanishes at every `y ∈ Gᗮ`
  refine integral_eq_zero_of_ae ?_
  filter_upwards [hae] with y hy
  have hty : t + y ∉ tsupport η := fun h => htK ⟨t + y, h, by
    rw [map_add, Submodule.starProjection_eq_self_iff.2 ht,
      G.starProjection_apply_eq_zero_iff.2 hy, add_zero]⟩
  simp only [Pi.zero_apply, image_eq_zero_of_notMem_tsupport hty, map_zero, mul_zero]
/-- **Simon 7.3.5, proof (measure of a projection box)**: let `G ⊆ ℝᴾ` be a subspace with
orthogonal projections `p = p_G` and `q = p_{G^⊥}`, let `σ` be carried by `G^⊥`, let `E ⊆ G` be
Borel and let `ν(A) = ∫_E σ(A − t) dHᵏ(t)` for every Borel `A`.  Then
`ν(p⁻¹(C) ∩ q⁻¹(B)) = Hᵏ(E ∩ C) σ(B)` for all Borel `C`, `B`.  For `t ∈ G` and `y ∈ G^⊥`,
`p(t + y) = t` and `q(t + y) = y`, so the section `A − t` of `A = p⁻¹(C) ∩ q⁻¹(B)` meets `G^⊥` in
`B ∩ G^⊥` if `t ∈ C` and in `∅` otherwise; as `σ` is carried by `G^⊥`, `σ(A − t) = 1_C(t) σ(B)`
for `t ∈ E`, and integrating over `E` gives `Hᵏ(E ∩ C) σ(B)`. -/
theorem Submission.dimred_cs_sos_mt_product_box_measure : ∀ (P k : ℕ) (G : Submodule ℝ (Euclid P)) (ν σ : Measure (Euclid P)) (E : Set (Euclid P)), σ (Gᗮ : Set (Euclid P))ᶜ = 0 → MeasurableSet E → E ⊆ (G : Set (Euclid P)) → (∀ A : Set (Euclid P), MeasurableSet A → ν A = ∫⁻ t in E, σ ((fun y => t + y) ⁻¹' A) ∂μHE[k]) → ∀ C B : Set (Euclid P), MeasurableSet C → MeasurableSet B → ν (G.starProjection ⁻¹' C ∩ Gᗮ.starProjection ⁻¹' B) = μHE[k] (E ∩ C) * σ B := by
  intro P k G ν σ E hσ hE hEG hν C B hC hB
  -- for `t ∈ G` and `y ∈ G^⊥`: `p(t + y) = t` and `q(t + y) = y`
  have hpq : ∀ t ∈ G, ∀ y ∈ Gᗮ,
      G.starProjection (t + y) = t ∧ Gᗮ.starProjection (t + y) = y := by
    intro t ht y hy
    have hp : G.starProjection (t + y) = t := by
      rw [map_add, Submodule.starProjection_eq_self_iff.2 ht,
        (Submodule.starProjection_apply_eq_zero_iff G).2 hy, add_zero]
    exact ⟨hp, by rw [Submodule.starProjection_orthogonal_val, hp, add_sub_cancel_left]⟩
  -- `σ` is carried by `G^⊥`, so `σ(A − t) = 1_C(t) σ(B)` for `t ∈ E`
  have hsec : ∀ t ∈ E, σ ((fun y => t + y) ⁻¹' (G.starProjection ⁻¹' C ∩
      Gᗮ.starProjection ⁻¹' B)) = C.indicator (fun _ => σ B) t := by
    intro t ht
    rw [← measure_inter_conull (s := (fun y => t + y) ⁻¹' _) hσ]
    by_cases htC : t ∈ C
    · rw [indicator_of_mem htC, ← measure_inter_conull (s := B) hσ]
      congr 1
      ext y
      simp only [mem_inter_iff, mem_preimage, SetLike.mem_coe]
      constructor
      · rintro ⟨⟨-, hyB⟩, hy⟩
        rw [(hpq t (hEG ht) y hy).2] at hyB
        exact ⟨hyB, hy⟩
      · rintro ⟨hyB, hy⟩
        rw [(hpq t (hEG ht) y hy).1, (hpq t (hEG ht) y hy).2]
        exact ⟨⟨htC, hyB⟩, hy⟩
    · rw [indicator_of_notMem htC]
      refine measure_mono_null (fun y hy => ?_) measure_empty
      have h1 : G.starProjection (t + y) ∈ C := hy.1.1
      rw [(hpq t (hEG ht) y hy.2).1] at h1
      exact (htC h1).elim
  -- integrating `1_C σ(B)` over `E` gives `σ(B) Hᵏ(C ∩ E)`
  rw [hν _ ((G.starProjection.continuous.measurable hC).inter
      (Gᗮ.starProjection.continuous.measurable hB)), setLIntegral_congr_fun hE hsec,
    lintegral_indicator_const hC, Measure.restrict_apply hC, inter_comm C E, mul_comm]
/-- **`μ_R = Θ Hⁿ`** (step 5 of the measure invariance of a cone with invariant density, in the
cone splitting of the dimension reduction argument; Simon Ch. 4, 3.12, chapter-04.txt
lines 350–354, the canonical representative `θ_V(x) = Θⁿ(V, x)` of `V = v(M, θ)`).  Let
`S = τ(M, θ, ξ)` in `ℝᴾ`, and let `Θⁿ(μ_S, x) = Θ(x)` at every `x`.  Then `θ Hⁿ⌞M = Θ Hⁿ`, i.e.
`μ_R(A) = ∫⁻_A Θ dHⁿ` for every Borel `A`.  Split `∫⁻_A Θ dHⁿ` along the Borel carrier `M`:
* on `A ∩ M`, `Θ = θ` `Hⁿ`-a.e. (`Submission.dimred_cs_mi_density_eq_mult_ae`), so this part is
  `∫⁻_{A∩M} θ dHⁿ = μ_R(A)`;
* on `A \ M`, `Θ ≤ 0` off the `Hⁿ`-null set `{x ∉ M, Θ(x) > 0}`
  (`Submission.dimred_cs_mi_density_null_off_carrier`), so `ofReal Θ = 0` there `Hⁿ`-a.e.

No measurability of `Θ` is needed: a.e.-equal functions have equal lower integrals. -/
theorem Submission.dimred_cs_mi_measure_eq_withDensity : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (Θ : Euclid P → ℝ), R.Represents S → (∀ x : Euclid P, HasMassDensity S x (Θ x)) → R.measure = (μHE[n] : Measure (Euclid P)).withDensity (fun x => ENNReal.ofReal (Θ x)) := by
  intro P n S R Θ hR hΘ
  -- Step 1: compare both measures on a Borel set `A`
  ext A hA
  -- Steps 2–3: `μ_R(A) = ∫⁻_{A∩M} θ dHⁿ`, and split `∫⁻_A Θ dHⁿ` along `M`
  rw [IMRep.measure, withDensity_apply _ hA, withDensity_apply _ hA, Measure.restrict_restrict hA,
    ← lintegral_inter_add_sdiff _ A R.measurableSet_carrier]
  -- Step 4: on `A ∩ M`, `ofReal Θ = θ` `Hⁿ`-a.e.
  have hM : ∫⁻ x in A ∩ R.carrier, ENNReal.ofReal (Θ x) ∂μHE[n] =
      ∫⁻ x in A ∩ R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
    have hae := ae_restrict_of_ae_restrict_of_subset
      (inter_subset_right : A ∩ R.carrier ⊆ R.carrier)
      (Submission.dimred_cs_mi_density_eq_mult_ae P n S R Θ hR hΘ)
    refine lintegral_congr_ae ?_
    filter_upwards [hae] with x hx
    rw [hx, ENNReal.ofReal_natCast]
  -- Step 5: on `A \ M`, `ofReal Θ = 0` `Hⁿ`-a.e., since `{x ∉ M, Θ(x) > 0}` is `Hⁿ`-null
  have hMc : ∫⁻ x in A \ R.carrier, ENNReal.ofReal (Θ x) ∂μHE[n] = 0 := by
    have hnull := Submission.dimred_cs_mi_density_null_off_carrier P n S R Θ hR hΘ
    have hae : ∀ᵐ x ∂μHE[n], x ∈ A \ R.carrier → ENNReal.ofReal (Θ x) = 0 := by
      refine ae_iff.2 (measure_mono_null (fun x hx => ?_) hnull)
      obtain ⟨hxAM, hx0⟩ := not_imp.1 hx
      exact ⟨hxAM.2, ENNReal.ofReal_pos.1 (pos_iff_ne_zero.2 hx0)⟩
    rw [lintegral_congr_ae ((ae_restrict_iff' (hA.diff R.measurableSet_carrier)).2 hae)]
    exact lintegral_zero
  -- Step 6: `∫⁻_A Θ dHⁿ = ∫⁻_{A∩M} θ dHⁿ + 0 = μ_R(A)`
  rw [hM, hMc, add_zero]
/-- **Translation invariance of `ν = Hⁿ.withDensity f` for a translation-invariant density `f`**
(step 6 of the measure invariance proof in the cone splitting argument, with `ofReal ∘ Θ` replaced
by an arbitrary `f`): if `f(y + x) = f(x)` for every `x`, then `ν((y + ·)⁻¹(A)) = ν(A)`, i.e.
`ν(A − y) = ν(A)`, for every Borel `A ⊆ ℝᴾ`.  The translation `τ(x) = y + x` is a bijective
isometry, hence a measurable embedding preserving `Hⁿ`, so
`∫⁻_{τ⁻¹(A)} f(τ(a)) dHⁿ(a) = ∫⁻_A f dHⁿ`; and `f ∘ τ = f` by hypothesis. -/
theorem Submission.dimred_cs_mi_withDensity_translate : ∀ (P n : ℕ) (f : Euclid P → ℝ≥0∞) (y : Euclid P), (∀ x : Euclid P, f (y + x) = f x) → ∀ A : Set (Euclid P), MeasurableSet A → (μHE[n] : Measure (Euclid P)).withDensity f ((fun x => y + x) ⁻¹' A) = (μHE[n] : Measure (Euclid P)).withDensity f A := by
  intro P n f y hf A hA
  -- Step 1: `τ(x) = y + x` is a homeomorphism, hence a measurable embedding; `τ⁻¹(A)` is Borel.
  have hτ : MeasurableEmbedding (fun x : Euclid P => y + x) :=
    (Homeomorph.addLeft y).measurableEmbedding
  -- Step 2: `τ` is a bijective isometry, so it preserves `Hⁿ`.
  have hmp : MeasurePreserving (fun x : Euclid P => y + x) μHE[n] μHE[n] :=
    (IsometryEquiv.addLeft y).measurePreserving_euclideanHausdorffMeasure n
  -- Steps 3–5: `ν(τ⁻¹(A)) = ∫⁻_{τ⁻¹(A)} f(y + a) dHⁿ(a) = ∫⁻_A f dHⁿ = ν(A)`.
  calc (μHE[n] : Measure (Euclid P)).withDensity f ((fun x => y + x) ⁻¹' A)
      = ∫⁻ a in (fun x => y + x) ⁻¹' A, f (y + a) ∂μHE[n] := by
        rw [withDensity_apply _ (hτ.measurable hA)]
        simp only [hf]
    _ = ∫⁻ b in A, f b ∂μHE[n] := hmp.setLIntegral_comp_preimage_emb hτ f A
    _ = (μHE[n] : Measure (Euclid P)).withDensity f A := (withDensity_apply _ hA).symm
/-- **`n`-homogeneity of `f Hⁿ` for a dilation-invariant density `f`** (Simon Lemma 7.3.5,
chapter-07.txt lines 407–420, whose proof is "left to the reader": part (ii) of the invariance of
the mass measure `μ = Θ Hⁿ` of `S` when its density `Θ` is invariant under `w ↦ λw`, with an
arbitrary `f : ℝᴾ → [0, ∞]` in place of `ofReal ∘ Θ`).  If `λ > 0` and `f(λx) = f(x)` for all `x`,
then `(f Hⁿ)(λA) = λⁿ (f Hⁿ)(A)` for every Borel `A ⊆ ℝᴾ`.  `δ(x) = λx` is a homeomorphism, so
`λA = δ(A)` is Borel and `δ⁻¹(λA) = A`; the change of variables (ii) of
`Submission.euclid_hausdorff_dilation_change_of_variables` with `g = f` and `f ∘ δ = f` gives
`(f Hⁿ)(A) = λ⁻ⁿ (f Hⁿ)(λA)`, and `λⁿ λ⁻ⁿ = 1`. -/
theorem Submission.dimred_cs_mi_withDensity_dilate : ∀ (P n : ℕ) (f : Euclid P → ℝ≥0∞) (lam : ℝ), 0 < lam → (∀ x : Euclid P, f (lam • x) = f x) → ∀ A : Set (Euclid P), MeasurableSet A → (μHE[n] : Measure (Euclid P)).withDensity f ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * (μHE[n] : Measure (Euclid P)).withDensity f A := by
  intro P n f lam hlam hf A hA
  -- Step 1: `δ(x) = λx` is a homeomorphism, hence a measurable embedding: `D = δ(A)` is Borel and
  -- `δ⁻¹(D) = A` by injectivity.
  have hδ : MeasurableEmbedding (fun x : Euclid P => lam • x) :=
    (Homeomorph.smulOfNeZero lam hlam.ne').measurableEmbedding
  have hD : MeasurableSet ((fun x : Euclid P => lam • x) '' A) := hδ.measurableSet_image.2 hA
  have hpre : (fun x : Euclid P => lam • x) ⁻¹' ((fun x : Euclid P => lam • x) '' A) = A :=
    Set.preimage_image_eq A hδ.injective
  -- Steps 2–3: change of variables (ii) with `c = λ`, `M = D`, `g = f`; with `δ⁻¹(D) = A` and
  -- `f(λz) = f(z)` it reads `∫⁻_A f dHⁿ = λ⁻ⁿ ∫⁻_D f dHⁿ`.
  have h := (Submission.euclid_hausdorff_dilation_change_of_variables P n lam hlam
    ((fun x : Euclid P => lam • x) '' A)).2.1 f
  rw [hpre] at h
  simp only [hf] at h
  -- Steps 4–5: `ν(A) = λ⁻ⁿ ν(D)` by `withDensity_apply` (`A`, `D` Borel), and
  -- `ofReal(λⁿ) ofReal(λ⁻ⁿ) = ofReal((λλ⁻¹)ⁿ) = 1`.
  rw [withDensity_apply _ hD, withDensity_apply _ hA, h, ← mul_assoc,
    ← ENNReal.ofReal_mul (pow_nonneg hlam.le n), ← mul_pow, mul_inv_cancel₀ hlam.ne', one_pow,
    ENNReal.ofReal_one, one_mul]

/-- **Density invariance gives invariance of the mass measure** (the measure step of the cone
splitting in the dimension-reducing argument, Simon 7.3.4–7.3.5, chapter-07.txt lines 380–417).
Let `S = τ(M, θ, ξ)` in `ℝᴾ` have a density `Θ(x)` at every `x`, and let
`HasMassDensity S w θ → HasMassDensity S (y + λw) θ` for `y ∈ L`, `λ > 0`.  Then `μ = θHⁿ⌞M`
satisfies (i) `μ(A − y) = μ(A)` for `y ∈ L` and (ii) `μ(λA) = λⁿμ(A)` for `λ > 0`, `A` Borel.
Densities are unique, so `Θ(y + λw) = Θ(w)`; `μ = Θ·Hⁿ` (Simon Ch. 3, Remark 1.8(2); Ch. 1,
Theorem 3.6); and `Θ·Hⁿ` inherits translation invariance and `n`-homogeneity from `Hⁿ`. -/
theorem Submission.dimred_cs_measure_invariant_of_density_invariant : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)), 0 < n → R.Represents S → (∀ x : Euclid P, ∃ θ : ℝ, HasMassDensity S x θ) → (∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ (w : Euclid P) (θ : ℝ), HasMassDensity S w θ → HasMassDensity S (y + lam • w) θ) → (∀ y ∈ L, ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => y + x) ⁻¹' A) = R.measure A) ∧ ∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * R.measure A := by
  intro P n S R L _hn hRS hdens hinv
  -- Step 1: choose the density `Θ(x)` of `S` at every `x`.
  choose Θ hΘ using hdens
  -- Step 2: `μ = Θ·Hⁿ`.
  have hμ : R.measure = (μHE[n] : Measure (Euclid P)).withDensity (fun x => ENNReal.ofReal (Θ x)) :=
    Submission.dimred_cs_mi_measure_eq_withDensity P n S R Θ hRS hΘ
  -- Step 3: densities are unique, so `Θ(y + λw) = Θ(w)` for `y ∈ L`, `λ > 0`.
  have hΘinv : ∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ w : Euclid P, Θ (y + lam • w) = Θ w :=
    fun y hy lam hlam w => Submission.dimred_cs_mi_hasMassDensity_unique P n univ S (y + lam • w)
      _ _ (hΘ (y + lam • w)) (hinv y hy lam hlam w (Θ w) (hΘ w))
  refine ⟨fun y hy A hA => ?_, fun lam hlam A hA => ?_⟩
  -- Step 4, (i): `Θ(y + x) = Θ(x)` (`λ = 1`), and `Θ·Hⁿ` is invariant under such translations.
  · rw [hμ]
    refine Submission.dimred_cs_mi_withDensity_translate P n _ y (fun x => ?_) A hA
    have h := hΘinv y hy 1 one_pos x
    rw [one_smul] at h
    exact congrArg ENNReal.ofReal h
  -- Step 5, (ii): `Θ(λx) = Θ(x)` (`y = 0 ∈ L`), and `Θ·Hⁿ` is `n`-homogeneous under such dilations.
  · rw [hμ]
    refine Submission.dimred_cs_mi_withDensity_dilate P n _ lam hlam (fun x => ?_) A hA
    have h := hΘinv 0 L.zero_mem lam hlam x
    rw [zero_add] at h
    exact congrArg ENNReal.ofReal h
/-- **Simon Ch. 3, 1.4; Ch. 4**: the approximate tangent planes `TₓM` of an integer multiplicity
representation `R = (M, θ, ξ)` in `ℝᴾ` form an `R.measure`-a.e.-measurable field of orthogonal
projections `x ↦ p_{TₓM}` (Borel σ-algebra of the operator-norm topology).  For `n = 0` every
`TₓM` is `⊥`.  For `n ≥ 1` let `f_u(y) = max(1 − |y|², 0)⟨u, y⟩²`: as `θ ≥ 1` on `M`,
`Hⁿ⌞M` is finite on compact sets, so `x ↦ ∫_{η_{x,r}(M)} f_u dHⁿ` is continuous; at `μ`-a.e. `x`
(`R.orients`, `μ = θHⁿ⌞M ≪ Hⁿ⌞M`) `TₓM` exists and these integrals tend, along `r = 1/(k+1)`, to
`∫_{TₓM} f_u dHⁿ = cₙ|p_{TₓM} u|²`, `cₙ > 0`.  So each `x ↦ |p_{TₓM} u|²` is a.e.-measurable,
hence so is `x ↦ p_{TₓM}`. -/
theorem Submission.imrep_univ_tangent_starProjection_aemeasurable : ∀ (P n : ℕ) (R : IMRep (univ : Set (Euclid P)) n), AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure := by
  intro P n R
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: a `0`-dimensional approximate tangent plane is `⊥`, so `p_{TₓM} = 0` for every `x`
    have h0 : ∀ x, (approxTangentPlane 0 R.carrier x).starProjection = 0 := by
      intro x
      have hx : approxTangentPlane 0 R.carrier x = ⊥ := by
        unfold approxTangentPlane
        split_ifs with h
        · exact Submodule.finrank_eq_zero.1 h.choose_spec.1
        · rfl
      rw [hx, Submodule.starProjection_bot]
    simp_rw [h0]
    exact aemeasurable_const
  obtain ⟨c, hc, hcQ⟩ := Submission.exists_plane_cutoff_quadratic_moment_eq n hn
  -- `Hⁿ(M ∩ K) ≤ ∫_{M ∩ K} θ dHⁿ < ∞` for compact `K`, as `θ ≥ 1` on `M`
  have hM : ∀ K : Set (Euclid P), IsCompact K → μHE[n] (R.carrier ∩ K) ≠ ∞ := by
    intro K hK
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK (subset_univ K)) ?_
    calc μHE[n] (R.carrier ∩ K) = ∫⁻ _ in R.carrier ∩ K, 1 ∂μHE[n] := (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
        setLIntegral_mono' (R.measurableSet_carrier.inter hK.isClosed.measurableSet)
          fun x hx => by exact_mod_cast R.mult_pos x hx.1
  -- `TₓM` is an approximate tangent plane at `μ`-a.e. `x`, since `μ ≪ Hⁿ⌞M`
  have hT : ∀ᵐ x ∂R.measure,
      HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
    have h : ∀ᵐ x ∂μHE[n].restrict R.carrier,
        HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
      filter_upwards [R.orients] with x hx
      obtain ⟨Q, hQ, -⟩ := hx
      have h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
      unfold approxTangentPlane
      rw [dite_eq_left h]
      exact h.choose_spec
    exact (withDensity_absolutelyContinuous _ _).ae_le h
  refine Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq P R.measure
    (approxTangentPlane n R.carrier) fun u => ?_
  -- the test function `f_u(y) = max(1 − |y|², 0)⟨u, y⟩²`, continuous with support in `B̄₁(0)`
  obtain ⟨φ, hφ_def⟩ : ∃ φ : Euclid P → ℝ, φ = fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2 :=
    ⟨_, rfl⟩
  have hφ : Continuous φ := by
    rw [hφ_def]
    fun_prop
  have hφs : HasCompactSupport φ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) 1) fun z hz => ?_
    have h1 : 1 < ‖z‖ := by simpa using hz
    have h2 : 1 - ‖z‖ ^ 2 ≤ 0 := by nlinarith
    simp [hφ_def, max_eq_right h2]
  -- `|p_x u|² = lim_k c⁻¹ ∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ` at `μ`-a.e. `x`
  refine aemeasurable_of_tendsto_metrizable_ae' (f := fun (k : ℕ) x => c⁻¹ *
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x (1 / ((k : ℝ) + 1)) '' R.carrier, φ y ∂μHE[n])
    (fun k => (continuous_const.mul (Submission.continuous_blowUp_image_setIntegral P n R.carrier
      hM φ hφ hφs (1 / ((k : ℝ) + 1)) (by positivity))).aemeasurable) ?_
  filter_upwards [hT] with x hx
  have hr : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
      Eventually.of_forall fun k => mem_Ioi.2 (by positivity)⟩
  have hval : ‖(approxTangentPlane n R.carrier x).starProjection u‖ ^ 2 =
      c⁻¹ * ∫ y in (approxTangentPlane n R.carrier x : Set (Euclid P)), φ y ∂μHE[n] := by
    rw [hφ_def, hcQ P _ hx.1 u, inv_mul_cancel_left₀ hc.ne']
  rw [hval]
  exact ((hx.2 ⟨⟨φ, hφ⟩, hφs⟩).comp hr).const_mul c⁻¹
/-- **Closed-ball masses at points of the spine** (step 1 of the parent proof: the scaling
`(ωₙρⁿ)⁻¹μ_C(B_ρ(0)) = Θⁿ(T, x)` for each `ρ > 0` in Simon's proof of 7.3.1, moved to centres `z`
in the subspace `L` of Lemma 7.3.5).  Let `μ` be invariant under translations by vectors of `L`
and satisfy `μ(λA) = λⁿμ(A)` for `λ > 0`, both on Borel sets.  Then `μ(B̄_ρ(z)) = ρⁿμ(B̄_1(z))`
for `z ∈ L` and `ρ > 0`.  Translation by `-z ∈ L` maps `B̄_r(z)` onto `B̄_r(0)`, and
`B̄_ρ(0) = ρB̄_1(0)`. -/
theorem Submission.dimred_cs_st_closedBall_measure_scaling : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (L : Submodule ℝ (Euclid P)), (∀ y ∈ L, ∀ A : Set (Euclid P), MeasurableSet A → μ ((fun x => y + x) ⁻¹' A) = μ A) → (∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid P), MeasurableSet A → μ ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * μ A) → ∀ z ∈ L, ∀ ρ : ℝ, 0 < ρ → μ (closedBall z ρ) = ENNReal.ofReal (ρ ^ n) * μ (closedBall z 1) := by
  intro P n μ L htrans hhom z hz ρ hρ
  -- translation by `-z ∈ L`: `B̄_r(z) = (x ↦ -z + x)⁻¹' B̄_r(0)`
  have htr : ∀ r : ℝ, μ (closedBall z r) = μ (closedBall 0 r) := by
    intro r
    rw [← htrans (-z) (L.neg_mem hz) (closedBall 0 r) measurableSet_closedBall]
    congr 1
    ext x
    simp only [mem_closedBall, mem_preimage, dist_eq_norm, sub_zero, neg_add_eq_sub]
  -- dilation by `ρ`: `B̄_ρ(0) = (x ↦ ρ • x) '' B̄_1(0)`
  have hsc : (fun x => ρ • x) '' closedBall (0 : Euclid P) 1 = closedBall 0 ρ := by
    rw [Set.image_smul, smul_unitClosedBall_of_nonneg hρ.le]
  rw [htr ρ, htr 1, ← hsc, hhom ρ hρ _ measurableSet_closedBall]

/-- **Simon, proof of 7.3.1 (chapter-07.txt lines 352–360), at a centre `z`.**  Let
`R = (M, θ, ξ)` be an integer multiplicity triple in `ℝᴾ` with `V = v(M, θ)` stationary:
`δV(X) = 0` for every `X ∈ C¹_c(ℝᴾ; ℝᴾ)`.  If `μ_V(B_ρ(z)) = ρⁿμ_V(B_1(z))` for every `ρ > 0`
(closed balls, `μ_V = θHⁿ⌞M`), then `x − z ∈ TₓM`, i.e. `p_x(x − z) = x − z`, for `μ_V`-a.e. `x`.
The ratio `ρ⁻ⁿμ_V(B_ρ(z)) = μ_V(B_1(z))` is constant and finite (`θ` is locally integrable), so
the monotonicity identity 4.3.6 (`dtc_cone_monotonicity_identity`) gives
`∫_{B_ρ(z) \ B_σ(z)} |(x − z) − p_x(x − z)|² / |x − z|ⁿ⁺² dμ_V = 0` for `0 < σ ≤ ρ`.  The
integrand is `μ_V`-a.e.-measurable (`imrep_univ_tangent_starProjection_aemeasurable`), so it
vanishes a.e. on each annulus, where `|x − z| > σ > 0`; the annuli
`B_{k+1}(z) \ B_{1/(k+1)}(z)` exhaust `ℝᴾ \ {z}`, and `p_z(0) = 0`. -/
theorem Submission.dimred_cs_st_tangent_sub_of_ball_ratio : ∀ (P n : ℕ) (R : IMRep (univ : Set (Euclid P)) n) (z : Euclid P), (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → R.firstVariation X = 0) → (∀ ρ : ℝ, 0 < ρ → R.measure (closedBall z ρ) = ENNReal.ofReal (ρ ^ n) * R.measure (closedBall z 1)) → ∀ᵐ x ∂R.measure, (approxTangentPlane n R.carrier x).starProjection (x - z) = x - z := by
  intro P n R z hstat hball
  -- Step 1: `a := μ(B̄_1(z)) < ∞`
  have ha : R.measure (closedBall z 1) ≠ ∞ := by
    have h := R.locallyIntegrable_mult (closedBall z 1) (isCompact_closedBall z 1) (subset_univ _)
    rwa [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, Set.inter_comm]
  -- Step 2: the normalized ratio is constantly `a`
  have hratio : ∀ ρ : ℝ, 0 < ρ →
      R.measure (closedBall z ρ) / ENNReal.ofReal (ρ ^ n) = R.measure (closedBall z 1) := by
    intro ρ hρ
    rw [hball ρ hρ, mul_comm, ENNReal.mul_div_cancel_right
      (ENNReal.ofReal_pos.2 (pow_pos hρ n)).ne' ENNReal.ofReal_ne_top]
  -- Step 3: measurability of the defect integrand
  have hp : AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection (x - z))
      R.measure :=
    (continuous_fst.clm_apply continuous_snd).aemeasurable2
      (Submission.imrep_univ_tangent_starProjection_aemeasurable P n R)
      (aemeasurable_id.sub_const z)
  have hf : AEMeasurable (fun x => ENNReal.ofReal
      (‖(x - z) - (approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 /
        ‖x - z‖ ^ (n + 2))) R.measure :=
    ENNReal.measurable_ofReal.comp_aemeasurable
      ((((aemeasurable_id.sub_const z).sub hp).norm.pow_const 2).div
        ((measurable_id.sub_const z).norm.pow_const (n + 2)).aemeasurable)
  -- Step 4: the defect over each annulus vanishes
  have hann : ∀ σ ρ : ℝ, 0 < σ → σ ≤ ρ → ∀ᵐ x ∂R.measure,
      x ∈ closedBall z ρ \ closedBall z σ →
      (approxTangentPlane n R.carrier x).starProjection (x - z) = x - z := by
    intro σ ρ hσ hσρ
    have h := Submission.dtc_cone_monotonicity_identity P n R hstat z σ ρ hσ hσρ
    rw [hratio σ hσ, hratio ρ (hσ.trans_le hσρ)] at h
    have hD := (lintegral_eq_zero_iff' (hf.mono_measure Measure.restrict_le_self)).1
      ((ENNReal.add_right_inj ha).1 (h.trans (add_zero _).symm))
    have hA : MeasurableSet (closedBall z ρ \ closedBall z σ) :=
      measurableSet_closedBall.diff measurableSet_closedBall
    filter_upwards [(ae_restrict_iff' hA).1 hD] with x hx hxA
    have hxσ : σ < ‖x - z‖ := by
      have h2 := hxA.2
      rw [mem_closedBall, dist_eq_norm, not_le] at h2
      exact h2
    have h0 : ‖(x - z) - (approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 /
        ‖x - z‖ ^ (n + 2) ≤ 0 :=
      ENNReal.ofReal_eq_zero.1 (hx hxA)
    rw [div_le_iff₀ (pow_pos (hσ.trans hxσ) _), zero_mul] at h0
    have hnorm := (pow_eq_zero_iff two_ne_zero).1 (le_antisymm h0 (sq_nonneg _))
    exact (sub_eq_zero.1 (norm_eq_zero.1 hnorm)).symm
  -- Step 5: the annuli `B̄_{k+1}(z) \ B̄_{1/(k+1)}(z)` exhaust `ℝᴾ \ {z}`
  have hk1 : ∀ k : ℕ, (1 : ℝ) ≤ (k : ℝ) + 1 := fun k => le_add_of_nonneg_left k.cast_nonneg
  have hall := ae_all_iff.2 fun k : ℕ => hann (1 / ((k : ℝ) + 1)) ((k : ℝ) + 1) (by positivity)
    (((div_le_one (by positivity)).2 (hk1 k)).trans (hk1 k))
  filter_upwards [hall] with x hx
  rcases eq_or_ne x z with rfl | hxz
  · simp
  have hxpos : 0 < ‖x - z‖ := norm_pos_iff.2 (sub_ne_zero.2 hxz)
  obtain ⟨k, hk⟩ := exists_nat_gt (max ‖x - z‖ ‖x - z‖⁻¹)
  have hk0 : (0 : ℝ) < (k : ℝ) + 1 := by positivity
  refine hx k (Set.mem_sdiff_of_mem ?_ ?_)
  · rw [mem_closedBall, dist_eq_norm]
    linarith [le_max_left ‖x - z‖ ‖x - z‖⁻¹]
  · rw [mem_closedBall, dist_eq_norm, not_le, one_div_lt hk0 hxpos, one_div]
    linarith [le_max_right ‖x - z‖ ‖x - z‖⁻¹]

/-- **Spine tangency** (a step of Simon 7.3.5, whose proof is left to the reader, chapter-07.txt
lines 407–418; argued as in the proof of 7.3.1, lines 355–360).  Let `R = (M, θ, ξ)` be an integer
multiplicity triple in `ℝᴾ` with `V = v(M, θ)` stationary and `L ⊆ ℝᴾ` a subspace such that
`μ_V = θHⁿ⌞M` is invariant under translation by every `y ∈ L` and `μ_V(λA) = λⁿμ_V(A)` for
`λ > 0`.  Then `x ∈ TₓM` and `L ⊆ TₓM` for `μ_V`-a.e. `x`.  For `z ∈ L`,
`μ_V(B̄_ρ(z)) = ρⁿμ_V(B̄_1(z))` (`dimred_cs_st_closedBall_measure_scaling`), so the monotonicity
identity (Ch. 4, 3.6) forces `x − z ∈ TₓM` for `μ_V`-a.e. `x`
(`dimred_cs_st_tangent_sub_of_ball_ratio`).  Apply this to `z = 0` and to every `z` in a finite
set `S` spanning `L` (in place of a countable dense subset of `L`): for `μ_V`-a.e. `x`, `x ∈ TₓM`
and `z = x − (x − z) ∈ TₓM` for `z ∈ S`, so the subspace `TₓM` contains `span S = L`. -/
theorem Submission.dimred_cs_spine_tangent_of_invariant_measure : ∀ (P n : ℕ) (R : IMRep (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)), 0 < n → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → R.firstVariation X = 0) → (∀ y ∈ L, ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => y + x) ⁻¹' A) = R.measure A) → (∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * R.measure A) → ∀ᵐ x ∂R.measure, (approxTangentPlane n R.carrier x).starProjection x = x ∧ ∀ v ∈ L, (approxTangentPlane n R.carrier x).starProjection v = v := by
  intro P n R L _hn hstat htrans hhom
  -- for each `z ∈ L` the ball ratios at `z` are constant, so `x - z ∈ TₓM` for `μ_V`-a.e. `x`
  have htan : ∀ z ∈ L, ∀ᵐ x ∂R.measure,
      (approxTangentPlane n R.carrier x).starProjection (x - z) = x - z := fun z hz =>
    Submission.dimred_cs_st_tangent_sub_of_ball_ratio P n R z hstat
      (Submission.dimred_cs_st_closedBall_measure_scaling P n R.measure L htrans hhom z hz)
  -- a finite set `S ⊆ L` spanning `L`
  obtain ⟨S, hS⟩ : L.FG := IsNoetherian.noetherian L
  have hSL : ∀ z ∈ S, z ∈ L := fun z hz => hS ▸ Submodule.subset_span (Finset.mem_coe.2 hz)
  filter_upwards [htan 0 L.zero_mem, (eventually_all_finset S).2 fun z hz => htan z (hSL z hz)]
    with x hx0 hxS
  rw [sub_zero] at hx0
  have hxT : x ∈ approxTangentPlane n R.carrier x := Submodule.starProjection_eq_self_iff.1 hx0
  -- `z = x - (x - z) ∈ TₓM` for `z ∈ S`, so `L = span S ≤ TₓM`
  have hLT : L ≤ approxTangentPlane n R.carrier x := by
    rw [← hS, Submodule.span_le]
    intro z hz
    have h := (approxTangentPlane n R.carrier x).sub_mem hxT
      (Submodule.starProjection_eq_self_iff.1 (hxS z (Finset.mem_coe.1 hz)))
    rwa [sub_sub_cancel] at h
  exact ⟨hx0, fun v hv => Submodule.starProjection_eq_self_iff.2 (hLT hv)⟩
/-- **Radial tangency makes a boundaryless current a cone** (step 4 of the cone-splitting proof:
Simon 7.3.1(2) proof, Ch. 6, 2.25–2.27 and 2.33).  Let `S = τ(M, θ, ξ) ∈ 𝒟ₙ(ℝᴾ)`, `n ≥ 1`,
`∂S = 0`, with `x ∈ TₓM` for `μ`-a.e. `x`.  Then `x ∧ ξ(x) = 0` `μ`-a.e.
(`dtc_cone_wedge_vanishes`), so `S` annihilates `L_X β = nβ + Dβ[·]` for the Euler field
(`dtc_cwv_euler_lie_annihilated`), hence `G(s) = S(sⁿ ω(s ·))` is constant on `(0, ∞)`
(`dtc_cwv_action_dilation_invariant`), i.e. `S(λ⁻ⁿ ω(λ⁻¹ ·)) = S(ω)`, and `S` is a cone by the
cone criterion `dtc_cwv_isConeCurrent_of_pullback_invariant`. -/
theorem Submission.dimred_cs_cone_of_radial_tangency : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), 0 < n → R.Represents S → BoundaryVanishes S → (∀ᵐ x ∂R.measure, (approxTangentPlane n R.carrier x).starProjection x = x) → IsConeCurrent S := by
  intro P n S R hn hR hb hrad
  -- step 2: `ξ(x)(ι_x β) = 0` for `μ`-a.e. `x` and every `(n + 1)`-covector `β`
  have hw := Submission.dtc_cone_wedge_vanishes P n univ R hrad
  -- step 4: `R.action (L_X β) = S(L_X β) = 0`
  have hL : ∀ β γ : TestFormOn (univ : Set (Euclid P)) n,
      (∀ y, (γ : DifferentialForm (Euclid P) n) y =
        (n : ℝ) • (β : DifferentialForm (Euclid P) n) y +
          fderiv ℝ (β : DifferentialForm (Euclid P) n) y y) →
      R.action (γ : DifferentialForm (Euclid P) n) = 0 := fun β γ hγ =>
    (hR γ).symm.trans (Submission.dtc_cwv_euler_lie_annihilated P n S R hn hR hb hw β γ hγ)
  -- steps 1, 3 and 5: by the cone criterion, `S(ω') = R.action ω' = R.action ω = S(ω)`
  refine Submission.dtc_cwv_isConeCurrent_of_pullback_invariant P n S fun lam hlam ω ω' hω' => ?_
  rw [hR ω', hR ω]
  exact Submission.dtc_cwv_action_dilation_invariant P n R hL lam hlam ω ω' hω'
/-- **Push-forward of an integer multiplicity triple by a linear map** (Simon Ch. 6, 3.3–3.9,
Lemma 3.9, for `f = L`).  Let `R = (M, θ, ξ)` be an `IMRep` in `ℝᴾ` of dimension `m ≥ 1` with
`μ_R(ℝᴾ \ K) = 0` for a compact `K`.  Then `L_#τ(M, θ, ξ)` is represented by a triple carried by
`L(K)`.  `T = τ(M, θ, ξ)` is a current (`dtc_imrep_current`) with
`spt T = spt μ_R ⊆ K` (`dor_imrep_massOn_eq_measure_and_support`), a compact set.  The
`C¹` push-forward along `L` (`dtc_bc_lc_pushforward`, with `DL(x) = L`) is integer multiplicity,
has support in `L(spt T) ⊆ L(K)`, and evaluates `ω` to `∫_M θ ⟨ω(Lx) ∘ ΛᵐL, ξ⟩ dHᵐ = R(L^#ω)`.
A representation `R₁` of it has `spt μ_{R₁} = spt L_#T ⊆ L(K)`, so `μ_{R₁}(ℝᴾ \ L(K)) = 0`, and
`θ₁ ≥ 1` on `M₁` gives `Hᵐ(M₁ \ L(K)) = 0`.  Cutting `R₁` to the compact set `L(K)`
(`dtc_imrep_of_null_off_compact`) keeps its action. -/
theorem Submission.dimred_cs_sp_imrep_linear_pushforward : ∀ (P m : ℕ) (R : IMRep (univ : Set (Euclid P)) m) (L : Euclid P →L[ℝ] Euclid P) (K : Set (Euclid P)), 0 < m → IsCompact K → R.measure Kᶜ = 0 → ∃ R' : IMRep (univ : Set (Euclid P)) m, R'.carrier ⊆ L '' K ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) m, R'.action (ω : DifferentialForm (Euclid P) m) = R.action (affinePullbackForm L 0 (ω : DifferentialForm (Euclid P) m)) := by
  intro P m R L K hm hK hRK
  obtain ⟨m, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  -- Step 1: `T = τ(M, θ, ξ)` has `spt T = spt μ_R ⊆ K`, so `spt T` is compact
  obtain ⟨T, hT⟩ := Submission.dtc_imrep_current P (m + 1) univ R
  have hsptT : T.support = R.measure.support := by
    rw [(Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ T R isOpen_univ
      hT).2, univ_inter]
  have hTK : T.support ⊆ K := by
    rw [hsptT]
    exact Measure.support_subset_of_isClosed hK.isClosed (mem_ae_iff.mpr hRK)
  have hTc : IsCompact T.support :=
    hK.of_isClosed_subset (hsptT ▸ Measure.isClosed_support) hTK
  -- Step 2: the `C¹` push-forward along `L` is integer multiplicity with support in `L(K)`
  obtain ⟨push, hpush, -⟩ := Submission.dtc_bc_lc_pushforward P m univ L isOpen_univ
    L.contDiff.contDiffOn
  obtain ⟨hform, ⟨R₁, hR₁⟩, hspt, -, -⟩ := hpush T R hT hTc (subset_univ _)
  have hLK : IsCompact (L '' K) := hK.image L.continuous
  -- Step 3: `spt μ_{R₁} = spt L_#T ⊆ L(K)`, so `μ_{R₁}(ℝᴾ \ L(K)) = 0`
  have hμ₁ : R₁.measure (L '' K)ᶜ = 0 := by
    have hsupp₁ : R₁.measure.support ⊆ L '' K := by
      rw [← univ_inter R₁.measure.support,
        ← (Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ (push T) R₁
          isOpen_univ hR₁).2]
      exact hspt.trans (image_mono hTK)
    exact measure_mono_null (compl_subset_compl.mpr hsupp₁) Measure.measure_compl_support
  -- Step 4: `θ₁ ≥ 1` on `M₁`, hence `Hᵐ(M₁ \ L(K)) = 0`
  have hnull : μHE[m + 1] (R₁.carrier \ L '' K) = 0 := by
    have hmeas : MeasurableSet (L '' K)ᶜ := hLK.isClosed.measurableSet.compl
    have h0 : ∫⁻ x in R₁.carrier ∩ (L '' K)ᶜ, (R₁.mult x : ℝ≥0∞) ∂μHE[m + 1] = 0 := by
      rw [← hμ₁, IMRep.measure, withDensity_apply _ hmeas, Measure.restrict_restrict hmeas,
        inter_comm]
    refine nonpos_iff_eq_zero.mp ?_
    calc μHE[m + 1] (R₁.carrier \ L '' K)
        = ∫⁻ _ in R₁.carrier ∩ (L '' K)ᶜ, 1 ∂μHE[m + 1] := by rw [setLIntegral_one, sdiff_eq]
      _ ≤ ∫⁻ x in R₁.carrier ∩ (L '' K)ᶜ, (R₁.mult x : ℝ≥0∞) ∂μHE[m + 1] :=
        setLIntegral_mono
          ((measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R₁.measurable_mult)
          fun x hx => Nat.one_le_cast.mpr (R₁.mult_pos x hx.1)
      _ = 0 := h0
  -- Step 5: cut `R₁` to the compact set `L(K)`; the action is `R(L^#ω)` since `DL(x) = L`
  obtain ⟨R', hR'K, hR'⟩ := Submission.dtc_imrep_of_null_off_compact P (m + 1) univ univ
    (L '' K) R₁ hLK (subset_univ _) (subset_univ _) hnull
  refine ⟨R', hR'K, fun ω => ?_⟩
  rw [hR' ω, ← hR₁ ω, hform ω]
  simp only [IMRep.action, affinePullbackForm, zero_add, ContinuousLinearMap.fderiv]

/-- **Simon Ch. 6, 2.23–2.24 and 3.9, for a linear map `L`**: if `X = τ(M, θ, ξ)` in `ℝᴾ` has
compact support `K`, then the push-forward `L_#X` is an integer multiplicity current `Y` with
`spt Y ⊆ L(K)`, `∂Y = 0` if `∂X = 0`, and `Y(ω) = τ(M, θ, ξ)(L^#ω)`.  Since `K = spt μ_R`, the
measure `μ_R` is carried by `K`; push `(M, θ, ξ)` forward to a triple `R'` carried by `L(K)` and
let `Y = τ(R')`.  `L(K)` is compact, hence closed, so `spt Y ⊆ L(K)`; and if `∂X = 0` then
`∂Y(φ) = τ(M, θ, ξ)(L^#dφ) = τ(M, θ, ξ)(d(L^#φ)) = 0`. -/
theorem Submission.dimred_cs_sp_linear_pushforward : ∀ (P m : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) m) (R : IMRep (univ : Set (Euclid P)) m) (L : Euclid P →L[ℝ] Euclid P), 0 < m → R.Represents X → IsCompact X.support → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) m, IsIntegerMultiplicity Y ∧ Y.support ⊆ L '' X.support ∧ (BoundaryVanishes X → BoundaryVanishes Y) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) m, Y ω = R.action (affinePullbackForm L 0 (ω : DifferentialForm (Euclid P) m)) := by
  intro P m X R L hm hR hK
  -- Step 1: `spt X = spt μ_R`, so `μ_R(ℝᴾ \ spt X) = 0`
  have hnull : R.measure X.supportᶜ = 0 := by
    rw [(Submission.dor_imrep_massOn_eq_measure_and_support P m univ X R isOpen_univ hR).2,
      univ_inter]
    exact Measure.measure_compl_support
  -- Step 2: push `(M, θ, ξ)` forward to a triple `R'` carried by `L(spt X)`
  obtain ⟨R', hR'sub, hR'act⟩ :=
    Submission.dimred_cs_sp_imrep_linear_pushforward P m R L X.support hm hK hnull
  -- Step 3: `Y = τ(R')`, so `Y(ω) = τ(R')(ω) = τ(M, θ, ξ)(L^#ω)`
  obtain ⟨Y, hY⟩ := Submission.dtc_imrep_current P m univ R'
  have hact : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Y ω = R.action (affinePullbackForm L 0 (ω : DifferentialForm (Euclid P) m)) :=
    fun ω => (hY ω).trans (hR'act ω)
  refine ⟨Y, ⟨R', hY⟩, ?_, ?_, hact⟩
  · -- Step 4: `L(spt X)` is compact, hence closed, and contains the carrier of `R'`
    exact Submission.dimred_cs_sp_cp_support_subset_of_carrier_subset P m Y R' (L '' X.support)
      hY (hK.image L.continuous).isClosed hR'sub
  · -- Step 5: for `m = k + 1`, `∂Y(φ) = τ(M, θ, ξ)(L^#dφ) = τ(M, θ, ξ)(d(L^#φ)) = 0`
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hm.ne'
    intro hX
    change X.boundary = 0 at hX
    change Y.boundary = 0
    ext φ
    have hφ : IsSmoothForm (φ : DifferentialForm (Euclid P) k) := φ.property.1.1
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply, hact]
    change R.action (affinePullbackForm L 0
      (exteriorDerivative (φ : DifferentialForm (Euclid P) k))) = 0
    rw [← exteriorDerivative_affinePullbackForm L 0 hφ]
    exact Submission.dimred_cs_sp_cp_action_extDeriv_eq_zero P k X R X.support _ hR hK hnull hX
      (affinePullbackForm_isSmoothForm L 0 hφ)
/-- **Orthogonal projection does not increase mass** (Simon 7.3.1, footnote 2; the push-forward
`f_# T(ω) = ∫ ⟨ω(f(x)), dfₓ# ξ(x)⟩ dμ_T(x)` of Ch. 6, 2.24(2); dimension reduction for 7.3.3).
Let `q` be the orthogonal projection onto `V`, `T = τ(M_T, θ_T, ξ_T)` with `μ_T(ℝᴾ \ V) = 0`,
`X = τ(M_X, θ_X, ξ_X)` with `μ_X(ℝᴾ \ K) = 0` for a compact `K`, and `S' = T + q_# X`, i.e.
`S'(ω) = T(ω) + τ(M_X, θ_X, ξ_X)(q^# ω)`.  The integer combination `R = (M, θ, ξ)` with
`1_M θ ξ = 1_{M_T} θ_T ξ_T + 1_{M_X} θ_X ξ_X` `Hᵐ`-a.e. has
`τ(R)(β) = τ(M_T, θ_T, ξ_T)(β) + τ(M_X, θ_X, ξ_X)(β)` whenever both pairings are integrable
(pairing bound).  This holds for test forms, so `R` represents `T + X`, and for `q^# ω`: `M_T`
lies a.e. in `V`, where `q^# ω` vanishes off `spt ω`, and `M_X` lies a.e. in `K`.  As
`μ_T(ℝᴾ \ V) = 0`, `τ(M_T, θ_T, ξ_T)(q^# ω) = T(ω)`, hence `S'(ω) = τ(R)(q^# ω)`.  A unit
orientation satisfies `|⟨α ∘ Λᵐq, ξ⟩| ≤ |α|_E ‖q‖ᵐ ≤ |α|_E` (Hadamard, `‖q‖ ≤ 1`), so for `ω`
with `spt ω ⊆ O` and `|ω|_E ≤ 1`, `S'(ω) ≤ ∫_{M ∩ q⁻¹(spt ω)} θ dHᵐ ≤ μ_R(q⁻¹(O))`. -/
theorem Submission.idtp_fons_cs_sp_projected_massOn_le : ∀ (P m : ℕ) (T X S' : GeometricCurrentOn (univ : Set (Euclid P)) m) (RT RX : IMRep (univ : Set (Euclid P)) m) (V : Submodule ℝ (Euclid P)) (K : Set (Euclid P)), RT.Represents T → RX.Represents X → RT.measure ((V : Set (Euclid P))ᶜ) = 0 → IsCompact K → RX.measure Kᶜ = 0 → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, S' ω = T ω + RX.action (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m))) → ∃ R : IMRep (univ : Set (Euclid P)) m, (∀ ω : TestFormOn (univ : Set (Euclid P)) m, R.action (ω : DifferentialForm (Euclid P) m) = T ω + X ω) ∧ ∀ O : Set (Euclid P), S'.massOn O ≤ R.measure (V.starProjection ⁻¹' O) := by
  intro P m T X S' RT RX V K hRT hRX hTV hK hXK hS'
  -- Step 1: if `μ_{R'}(ℝᴾ \ C) = 0`, then `Hᵐ⌞M'`-a.e. point lies in `C`, as `θ' ≥ 1` on `M'`
  have hlive : ∀ (R' : IMRep (univ : Set (Euclid P)) m) (C : Set (Euclid P)), R'.measure Cᶜ = 0 →
      ∀ᵐ x ∂(μHE[m].restrict R'.carrier), x ∈ C := by
    intro R' C hC
    have hac : μHE[m].restrict R'.carrier ≪ R'.measure :=
      withDensity_absolutelyContinuous' (f := fun x => (R'.mult x : ℝ≥0∞))
        (measurable_from_nat.comp R'.measurable_mult).aemeasurable
        (by
          filter_upwards [ae_restrict_mem R'.measurableSet_carrier] with x hx
          exact Nat.cast_ne_zero.2 (R'.mult_pos x hx).ne')
    exact ae_iff.2 (hac hC)
  -- Step 2: integrability of `θ' ⟨β, ξ'⟩` on `M'` for a continuous bounded `β` that vanishes
  -- `Hᵐ⌞M'`-a.e. off a compact `C`: apply the pairing bound to `1_C β`, which equals `β` a.e.
  have hint_of : ∀ (R' : IMRep (univ : Set (Euclid P)) m) (β : DifferentialForm (Euclid P) m)
      (C : Set (Euclid P)) (B : ℝ), Continuous β → (∀ x, ‖β x‖ ≤ B) → IsCompact C →
      (∀ᵐ x ∂(μHE[m].restrict R'.carrier), x ∉ C → β x = 0) →
      Integrable (fun x => (R'.mult x : ℝ) * R'.orient x (β x)) (μHE[m].restrict R'.carrier) := by
    intro R' β C B hβ hB hC h0
    refine (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P m univ C R' (C.indicator β) B hC
      (subset_univ C) (hβ.aestronglyMeasurable.indicator hC.isClosed.measurableSet)
      (fun x hx => indicator_of_notMem hx β)
      (fun x => (norm_indicator_le_norm_self β x).trans (hB x))).1.congr ?_
    filter_upwards [h0] with x hx
    by_cases hxC : x ∈ C
    · rw [indicator_of_mem hxC]
    · rw [indicator_of_notMem hxC, hx hxC]
  -- Step 3: the integer combination `R` with `1_M θ ξ = 1_{M_T} θ_T ξ_T + 1_{M_X} θ_X ξ_X` a.e.
  obtain ⟨R, hR⟩ := Submission.rsdic_exists_imrep_int_combination P m univ RT RX 1 1 isOpen_univ
  -- Step 4: `τ(R)(β) = τ(RT)(β) + τ(RX)(β)` when both pairings are integrable, since
  -- `τ(R')(β) = ∫ ⟨β, 1_{M'} θ' ξ'⟩ dHᵐ` for every `R'`
  have hadd : ∀ β : DifferentialForm (Euclid P) m,
      Integrable (fun x => (RT.mult x : ℝ) * RT.orient x (β x)) (μHE[m].restrict RT.carrier) →
      Integrable (fun x => (RX.mult x : ℝ) * RX.orient x (β x)) (μHE[m].restrict RX.carrier) →
      R.action β = RT.action β + RX.action β := by
    intro β hT hX
    have hfun : ∀ R' : IMRep (univ : Set (Euclid P)) m,
        (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (β x)) =
          R'.carrier.indicator (fun y => (R'.mult y : ℝ) * R'.orient y (β y)) := by
      intro R'
      funext x
      by_cases hx : x ∈ R'.carrier
      · simp [indicator_of_mem hx]
      · simp [indicator_of_notMem hx]
    have hact : ∀ R' : IMRep (univ : Set (Euclid P)) m, R'.action β =
        ∫ x, R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (β x) ∂μHE[m] := by
      intro R'
      rw [hfun R', integral_indicator R'.measurableSet_carrier]
      rfl
    have hint : ∀ R' : IMRep (univ : Set (Euclid P)) m,
        Integrable (fun x => (R'.mult x : ℝ) * R'.orient x (β x)) (μHE[m].restrict R'.carrier) →
        Integrable (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x
          (β x)) μHE[m] := by
      intro R' h
      rw [hfun R', integrable_indicator_iff R'.measurableSet_carrier]
      exact h
    rw [hact R, hact RT, hact RX, ← integral_add (hint RT hT) (hint RX hX)]
    refine integral_congr_ae ?_
    filter_upwards [hR] with x hx
    rw [hx]
    simp
  -- Step 5: a test form is continuous, bounded and vanishes off its compact support, so `R`
  -- represents `T + X`
  have htest : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      R.action (ω : DifferentialForm (Euclid P) m) =
        RT.action (ω : DifferentialForm (Euclid P) m) +
          RX.action (ω : DifferentialForm (Euclid P) m) := by
    intro ω
    obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
    have hωc : Continuous (ω : DifferentialForm (Euclid P) m) := ContDiff.continuous hsmooth
    obtain ⟨B, hB⟩ := hωc.bounded_above_of_compact_support hcpt
    have h0 : ∀ R' : IMRep (univ : Set (Euclid P)) m, ∀ᵐ x ∂(μHE[m].restrict R'.carrier),
        x ∉ tsupport (ω : DifferentialForm (Euclid P) m) →
          (ω : DifferentialForm (Euclid P) m) x = 0 :=
      fun R' => Eventually.of_forall fun x hx => image_eq_zero_of_notMem_tsupport hx
    exact hadd _ (hint_of RT _ _ B hωc hB hcpt (h0 RT)) (hint_of RX _ _ B hωc hB hcpt (h0 RX))
  -- Step 6: `q^# ω`, `(q^# ω)(x) = ω(q x) ∘ Λᵐq`, is continuous with `‖q^# ω‖ ≤ sup ‖ω‖`
  -- (`‖q‖ ≤ 1`); it vanishes on `V \ spt ω` (`q x = x` there), so `S'(ω) = τ(R)(q^# ω)`
  have hq1 : ‖V.starProjection‖ ≤ 1 := V.starProjection_norm_le
  have hpull : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      S' ω =
        R.action (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m)) := by
    intro ω
    obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
    have hωc : Continuous (ω : DifferentialForm (Euclid P) m) := ContDiff.continuous hsmooth
    obtain ⟨B, hB⟩ := hωc.bounded_above_of_compact_support hcpt
    have hβc : Continuous
        (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m)) :=
      ContDiff.continuous (affinePullbackForm_isSmoothForm V.starProjection 0 hsmooth)
    have hβB : ∀ x,
        ‖affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x‖ ≤ B := by
      intro x
      calc ‖affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x‖
          ≤ ‖(ω : DifferentialForm (Euclid P) m) (0 + V.starProjection x)‖ *
              ‖V.starProjection‖ ^ Fintype.card (Fin m) :=
            ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _
        _ ≤ ‖(ω : DifferentialForm (Euclid P) m) (0 + V.starProjection x)‖ :=
            mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hq1)
        _ ≤ B := hB _
    have hT0 : ∀ᵐ x ∂(μHE[m].restrict RT.carrier),
        x ∉ tsupport (ω : DifferentialForm (Euclid P) m) →
          affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x = 0 := by
      filter_upwards [hlive RT _ hTV] with x hxV hx
      have hqx : V.starProjection x = x :=
        Submodule.starProjection_eq_self_iff.2 (SetLike.mem_coe.1 hxV)
      ext v
      simp [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply, hqx,
        image_eq_zero_of_notMem_tsupport hx]
    have hX0 : ∀ᵐ x ∂(μHE[m].restrict RX.carrier), x ∉ K →
        affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x = 0 := by
      filter_upwards [hlive RX K hXK] with x hxK hx
      exact absurd hxK hx
    rw [hS' ω, hRT ω, ← Submission.idtp_fons_cs_sp_action_starProjection_eq P m RT V hTV
      (ω : DifferentialForm (Euclid P) m), hadd _ (hint_of RT _ _ B hβc hβB hcpt hT0)
      (hint_of RX _ K B hβc hβB hK hX0)]
  refine ⟨R, fun ω => by rw [htest ω, ← hRT ω, ← hRX ω], fun O => ?_⟩
  -- Step 7: a unit orientation has `|⟨α ∘ Λᵐq, ξ⟩| ≤ |α|_E ‖q‖ᵐ ≤ |α|_E` (Hadamard)
  have hproj : ∀ᵐ x ∂(μHE[m].restrict R.carrier), ∀ α : Covector (Euclid P) m,
      |R.orient x (α.compContinuousLinearMap V.starProjection)| ≤ covectorEuclideanNorm α := by
    filter_upwards [R.orients] with x hx α
    obtain ⟨Q, -, hQ⟩ := hx
    exact ((Submission.dtc_bc_lc_pf_unitOrientation_comp P m (R.orient x) Q V.starProjection
      hQ).1 α).trans (mul_le_of_le_one_right (covectorEuclideanNorm_nonneg α)
        (pow_le_one₀ (norm_nonneg _) hq1))
  -- Step 8: for admissible `ω` with `spt ω ⊆ O`, `|θ ⟨q^# ω, ξ⟩| ≤ θ 1_{q⁻¹(spt ω)}` a.e. on `M`,
  -- so `S'(ω) = τ(R)(q^# ω) ≤ μ_R(q⁻¹(spt ω)) ≤ μ_R(q⁻¹(O))`
  apply sSup_le
  rintro r ⟨ω, ⟨hωO, hω1⟩, rfl⟩
  have hs : MeasurableSet (V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)) :=
    ((isClosed_tsupport _).preimage V.starProjection.continuous).measurableSet
  have hpt : ∀ᵐ x ∂(μHE[m].restrict R.carrier),
      ‖(R.mult x : ℝ) * R.orient x
          (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x)‖ₑ ≤
        (V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)).indicator
          (fun y => (R.mult y : ℝ≥0∞)) x := by
    filter_upwards [hproj] with x hx
    by_cases hxs : x ∈ V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)
    · rw [indicator_of_mem hxs, ← ofReal_norm, ← ENNReal.ofReal_natCast]
      refine ENNReal.ofReal_le_ofReal ?_
      rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      exact mul_le_of_le_one_right (Nat.cast_nonneg _)
        ((hx ((ω : DifferentialForm (Euclid P) m) (0 + V.starProjection x))).trans (hω1 _))
    · have hxs' : V.starProjection x ∉ tsupport (ω : DifferentialForm (Euclid P) m) := hxs
      have h0 :
          affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x = 0 := by
        ext v
        simp [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply,
          image_eq_zero_of_notMem_tsupport hxs']
      rw [indicator_of_notMem hxs, h0]
      simp
  calc ENNReal.ofReal (S' ω)
      = ENNReal.ofReal (R.action
          (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m))) := by
        rw [hpull ω]
    _ ≤ ‖R.action (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m))‖ₑ :=
        (ENNReal.ofReal_le_ofReal (Real.le_norm_self _)).trans_eq (ofReal_norm _)
    _ ≤ ∫⁻ x in R.carrier, ‖(R.mult x : ℝ) * R.orient x
          (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x)‖ₑ ∂μHE[m] :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ x in R.carrier,
          (V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)).indicator
            (fun y => (R.mult y : ℝ≥0∞)) x ∂μHE[m] :=
        lintegral_mono_ae hpt
    _ = R.measure (V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)) := by
        rw [lintegral_indicator hs, IMRep.measure, withDensity_apply _ hs]
    _ ≤ R.measure (V.starProjection ⁻¹' O) := measure_mono (preimage_mono hωO)
/-- **Orthogonal projection does not increase mass, `spt X` compact** (Simon 7.3.1, footnote 2;
dimension reduction for 7.3.3).  Let `q` be the orthogonal projection onto `V`,
`T = τ(M_T, θ_T, ξ_T)` with `μ_T(ℝᴾ \ V) = 0`, `X = τ(M_X, θ_X, ξ_X)` with `spt X` compact, and
`S'(ω) = T(ω) + τ(M_X, θ_X, ξ_X)(q^# ω)`.  Then some integer multiplicity triple `R` represents
`T + X` and `M_O(S') ≤ μ_R(q⁻¹(O))` for every `O`.  By Ch. 6, 3.2(3) and 2.12, `spt X = spt μ_X`,
and `μ_X(ℝᴾ \ spt μ_X) = 0` as `ℝᴾ` is second countable; so `μ_X` is carried by the compact set
`K = spt X`, which is the case proved above. -/
theorem Submission.dimred_cs_sp_projected_massOn_le : ∀ (P m : ℕ) (T X S' : GeometricCurrentOn (univ : Set (Euclid P)) m) (RT RX : IMRep (univ : Set (Euclid P)) m) (V : Submodule ℝ (Euclid P)), RT.Represents T → RX.Represents X → RT.measure ((V : Set (Euclid P))ᶜ) = 0 → IsCompact X.support → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, S' ω = T ω + RX.action (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m))) → ∃ R : IMRep (univ : Set (Euclid P)) m, (∀ ω : TestFormOn (univ : Set (Euclid P)) m, R.action (ω : DifferentialForm (Euclid P) m) = T ω + X ω) ∧ ∀ O : Set (Euclid P), S'.massOn O ≤ R.measure (V.starProjection ⁻¹' O) := by
  intro P m T X S' RT RX V hRT hRX hTV hK hS'
  -- `spt X = ℝᴾ ∩ spt μ_X`, and `μ_X` vanishes off its support (`ℝᴾ` is second countable)
  have hXK : RX.measure (X.support)ᶜ = 0 := by
    rw [(Submission.dor_imrep_massOn_eq_measure_and_support P m univ X RX isOpen_univ hRX).2,
      univ_inter]
    exact Measure.measure_compl_support
  -- the compactly carried case, with `K = spt X`
  exact Submission.idtp_fons_cs_sp_projected_massOn_le P m T X S' RT RX V X.support hRT hRX hTV hK
    hXK hS'
/-- Balls of a product measure `μ = Hᵈ⌞L ⊗ μ₀` (`d = dim L`, `μ₀` concentrated on `L^⊥`):
`μ(B_ρ(t + y)) = ∫_{ℝᵈ} μ₀(B_{√(ρ² − |σ|²)}(y)) dLᵈ(σ)` for `t ∈ L`, `y ∈ L^⊥` and `ρ > 0`.  For
`s ∈ L` and `y' ∈ L^⊥`, Pythagoras gives `s + y' ∈ B_ρ(t + y)` iff `y' ∈ B_{√(ρ² − |t − s|²)}(y)`;
an isometric parametrization of `L` by `ℝᵈ` carries `Lᵈ` to `Hᵈ⌞L`, and a translation centres the
integral at `t`. -/
theorem Submission.dimred_cs_psd_ball_formula : ∀ (P : ℕ) (L : Submodule ℝ (Euclid P)) (μ μ₀ : Measure (Euclid P)), μ₀ (Lᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → μ A = ∫⁻ t in (L : Set (Euclid P)), μ₀ ((fun y => t + y) ⁻¹' A) ∂μHE[Module.finrank ℝ L]) → ∀ t ∈ L, ∀ y ∈ Lᗮ, ∀ ρ : ℝ, 0 < ρ → μ (ball (t + y) ρ) = ∫⁻ σ : Euclid (Module.finrank ℝ L), μ₀ (ball y (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2))) := by
  intro P L μ μ₀ hconc hprod t ht y hy ρ hρ
  -- concentration of `μ₀` on `Lᗮ`
  have hconc' : ∀ X : Set (Euclid P), μ₀ X = μ₀ (X ∩ (Lᗮ : Set (Euclid P))) := by
    intro X
    refine le_antisymm ?_ (measure_mono inter_subset_left)
    calc μ₀ X ≤ μ₀ (X ∩ (Lᗮ : Set (Euclid P))) + μ₀ (X \ (Lᗮ : Set (Euclid P))) :=
          measure_le_inter_add_sdiff μ₀ X _
      _ ≤ μ₀ (X ∩ (Lᗮ : Set (Euclid P))) + μ₀ (Lᗮ : Set (Euclid P))ᶜ := by
          gcongr
          exact fun z hz => hz.2
      _ = μ₀ (X ∩ (Lᗮ : Set (Euclid P))) := by rw [hconc, add_zero]
  -- slicing the ball over a point `s ∈ L`
  have hslice : ∀ s ∈ L, μ₀ ((fun y' => s + y') ⁻¹' ball (t + y) ρ) =
      μ₀ (ball y (Real.sqrt (ρ ^ 2 - ‖t - s‖ ^ 2))) := by
    intro s hs
    rw [hconc' ((fun y' => s + y') ⁻¹' ball (t + y) ρ), hconc' (ball y _)]
    congr 1
    ext y'
    simp only [mem_inter_iff, mem_preimage, mem_ball, SetLike.mem_coe]
    refine and_congr_left fun hy' => ?_
    have horth : inner ℝ (s - t) (y' - y) = 0 :=
      Submodule.inner_right_of_mem_orthogonal (L.sub_mem hs ht) (Lᗮ.sub_mem hy' hy)
    have hpyth : ‖s + y' - (t + y)‖ ^ 2 = ‖t - s‖ ^ 2 + ‖y' - y‖ ^ 2 := by
      have h1 : s + y' - (t + y) = (s - t) + (y' - y) := by abel
      rw [h1, ← norm_neg (t - s), neg_sub]
      have := norm_add_sq_eq_norm_sq_add_norm_sq_real horth
      nlinarith [this]
    rw [dist_eq_norm, dist_eq_norm, Real.lt_sqrt (norm_nonneg _)]
    rw [← sq_lt_sq₀ (norm_nonneg _) hρ.le, hpyth]
    constructor <;> intro h <;> linarith
  rw [hprod _ measurableSet_ball,
    setLIntegral_congr_fun (Submodule.closed_of_finiteDimensional L).measurableSet hslice]
  -- an isometric parametrization of `L` by `ℝᵈ`
  set d := Module.finrank ℝ L
  let b := stdOrthonormalBasis ℝ L
  let ι : Euclid d → Euclid P := fun σ => ((b.repr.symm σ : L) : Euclid P)
  have hι : Isometry ι := L.subtypeₗᵢ.isometry.comp b.repr.symm.isometry
  have hrange : range ι = (L : Set (Euclid P)) := by
    ext z
    constructor
    · rintro ⟨σ, rfl⟩
      exact (b.repr.symm σ).2
    · intro hz
      exact ⟨b.repr ⟨z, hz⟩, by simp [ι]⟩
  have hmap : (volume : Measure (Euclid d)).map ι = μHE[d].restrict (L : Set (Euclid P)) := by
    rw [← EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hι.map_euclideanHausdorffMeasure,
      hrange]
  rw [← hmap, hι.isClosedEmbedding.measurableEmbedding.lintegral_map]
  -- translate
  set σt : Euclid d := b.repr ⟨t, ht⟩
  have hnorm : ∀ σ : Euclid d, ‖t - ι σ‖ = ‖σ - σt‖ := by
    intro σ
    have ht' : t = ι σt := by simp [ι, σt]
    rw [ht', ← dist_eq_norm, hι.dist_eq, dist_eq_norm, norm_sub_rev]
  simp_rw [hnorm]
  exact lintegral_sub_right_eq_self (fun σ => μ₀ (ball y (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)))) σt
/-- **Cavalieri slicing of Euclidean balls**: for `ρ ≥ 0`,
`L^{d+m}(B_ρ(0)) = ∫_{ℝᵈ} Lᵐ(B_{√(ρ² − ‖σ‖²)}(0)) dLᵈ(σ)`.  Reindexing along
`Fin d ⊕ Fin m ≃ Fin (d + m)` and splitting the blocks is a linear isometry
`ℝ^{d+m} ≃ ℝᵈ × ℝᵐ` (L² product norm), hence carries `L^{d+m}` to `Lᵈ ⊗ Lᵐ`; it maps `B_ρ(0)`
onto `Q = {(u, v) : ‖u‖² + ‖v‖² < ρ²}`, whose slice over `σ` is `B_{√(ρ² − ‖σ‖²)}(0)`, and Tonelli
gives the formula. -/
theorem Submission.dimred_cs_psd_ball_volume_slice : ∀ (d m : ℕ) (ρ : ℝ), 0 ≤ ρ → volume (ball (0 : Euclid (d + m)) ρ) = ∫⁻ σ : Euclid d, volume (ball (0 : Euclid m) (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2))) := by
  intro d m ρ hρ
  -- `Φ = ofLp ∘ e : ℝ^{d+m} → ℝᵈ × ℝᵐ` is volume preserving onto `Lᵈ ⊗ Lᵐ`
  let e : Euclid (d + m) ≃ₗᵢ[ℝ] WithLp 2 (Euclid d × Euclid m) :=
    (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ finSumFinEquiv.symm).trans
      (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ => ℝ))
  have hΦ : MeasurePreserving (fun x => WithLp.ofLp (e x)) volume
      ((volume : Measure (Euclid d)).prod (volume : Measure (Euclid m))) := by
    have h := (WithLp.volume_preserving_ofLp (Euclid d) (Euclid m)).comp e.measurePreserving
    rw [← Measure.volume_eq_prod]
    exact h
  -- `B_ρ(0) = Φ⁻¹(Q)`, since `‖x‖² = ‖Φ(x).1‖² + ‖Φ(x).2‖²`
  set Q : Set (Euclid d × Euclid m) := {p | ‖p.1‖ ^ 2 + ‖p.2‖ ^ 2 < ρ ^ 2}
  have hQ : MeasurableSet Q :=
    (isOpen_lt (by fun_prop) (by fun_prop)).measurableSet
  have hpre : (fun x => WithLp.ofLp (e x)) ⁻¹' Q = ball (0 : Euclid (d + m)) ρ := by
    ext x
    simp only [mem_preimage, mem_ofPred_eq, mem_ball_zero_iff, Q]
    have hn : ‖x‖ ^ 2 = ‖(WithLp.ofLp (e x)).1‖ ^ 2 + ‖(WithLp.ofLp (e x)).2‖ ^ 2 := by
      rw [← e.norm_map x, WithLp.prod_norm_sq_eq_of_L2]
      rfl
    rw [← hn]
    exact sq_lt_sq₀ (norm_nonneg x) hρ
  -- Tonelli, and the slice of `Q` over `σ` is `B_{√(ρ² − ‖σ‖²)}(0)`
  rw [← hpre, hΦ.measure_preimage hQ.nullMeasurableSet, Measure.prod_apply hQ]
  refine lintegral_congr fun σ => ?_
  congr 1
  ext v
  simp only [mem_preimage, mem_ofPred_eq, mem_ball_zero_iff, Q]
  rw [Real.lt_sqrt (norm_nonneg v)]
  constructor <;> intro h <;> linarith

/-- **Simon 7.3.5** (chapter-07.txt lines 407–417, proof left to the reader): the density step
for a product `[[L]] × S₀`, with `d = dim L`.  If `f(0) = 0` and `f(r)/(ωₘrᵐ) → θ` as `r ↓ 0`, then
`(ω_{d+m}ρ^{d+m})⁻¹ ∫_{ℝᵈ} f(√(ρ² − |σ|²)) dσ → θ` as `ρ ↓ 0`.  Every radius `√(ρ² − |σ|²)`
lies in `[0, ρ]`, so for `a' < θ < b'` the hypothesis gives `a'·Lᵐ(B_r) ≤ f(r) ≤ b'·Lᵐ(B_r)` for
all small `r ≥ 0`.  Integrating in `σ` and using the slice identity
`∫_{ℝᵈ} Lᵐ(B_{√(ρ² − |σ|²)}) dσ = L^{d+m}(B_ρ) = ω_{d+m}ρ^{d+m}` bounds the ratio between `a'`
and `b'` for all small `ρ > 0`; no measurability of `f` is needed. -/
theorem Submission.dimred_cs_psd_radial_density : ∀ (d m : ℕ) (f : ℝ → ℝ≥0∞) (θ : ℝ≥0∞), f 0 = 0 → Tendsto (fun r : ℝ => f r / (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 θ) → Tendsto (fun ρ : ℝ => (∫⁻ σ : Euclid d, f (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2))) / (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m)))) (𝓝[>] 0) (𝓝 θ) := by
  intro d m f θ hf0 hlim
  -- `Lᵏ(B_r(0)) = ωₖrᵏ` for `r > 0`, with `0 < ωₖ < ∞`
  have hvol : ∀ (k : ℕ) (r : ℝ), 0 < r →
      volume (ball (0 : Euclid k) r) = unitBallVolume k * ENNReal.ofReal (r ^ k) := by
    intro k r hr
    rw [Measure.addHaar_ball_of_pos volume (0 : Euclid k) hr, finrank_euclideanSpace_fin, mul_comm]
    rfl
  have hω0 : ∀ k : ℕ, unitBallVolume k ≠ 0 := fun k =>
    (measure_ball_pos volume (0 : Euclid k) one_pos).ne'
  have hωt : ∀ k : ℕ, unitBallVolume k ≠ ⊤ := fun k => measure_ball_lt_top.ne
  have hc0 : ∀ (k : ℕ) (r : ℝ), 0 < r → unitBallVolume k * ENNReal.ofReal (r ^ k) ≠ 0 := by
    intro k r hr
    exact mul_ne_zero (hω0 k) (ENNReal.ofReal_pos.2 (pow_pos hr k)).ne'
  have hct : ∀ (k : ℕ) (r : ℝ), unitBallVolume k * ENNReal.ofReal (r ^ k) ≠ ⊤ := fun k r =>
    ENNReal.mul_ne_top (hωt k) ENNReal.ofReal_ne_top
  -- the comparison profile `v(r) = Lᵐ(B_r(0))`, with `v(0) = 0 = f(0)`
  set v : ℝ → ℝ≥0∞ := fun r => volume (ball (0 : Euclid m) r) with hv
  have hv0 : v 0 = 0 := by simp [hv]
  -- slice identity: `∫_{ℝᵈ} v(√(ρ² − |σ|²)) dσ = ω_{d+m}ρ^{d+m}`
  have hslice : ∀ ρ : ℝ, 0 < ρ → ∫⁻ σ : Euclid d, v (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) =
      unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m)) := by
    intro ρ hρ
    rw [← hvol _ _ hρ, Submission.dimred_cs_psd_ball_volume_slice d m ρ hρ.le]
  -- every radius `√(ρ² − |σ|²)` lies in `[0, ρ]`
  have hsq_le : ∀ ρ : ℝ, 0 < ρ → ∀ σ : Euclid d, Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2) ≤ ρ := by
    intro ρ hρ σ
    calc Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2) ≤ Real.sqrt (ρ ^ 2) :=
          Real.sqrt_le_sqrt (by nlinarith [norm_nonneg σ])
      _ = ρ := Real.sqrt_sq hρ.le
  refine tendsto_order.2 ⟨fun a ha => ?_, fun b hb => ?_⟩
  · -- lower bound: `a'·v ≤ f` on `[0, s)` integrates to `a' ≤` the ratio for `ρ ∈ (0, s)`
    obtain ⟨a', haa', ha'θ⟩ := exists_between ha
    have h1 : ∀ᶠ r in 𝓝[>] (0 : ℝ), a' < f r / (unitBallVolume m * ENNReal.ofReal (r ^ m)) :=
      (tendsto_order.1 hlim).1 a' ha'θ
    obtain ⟨s, hs, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 h1
    filter_upwards [Ioo_mem_nhdsGT hs] with ρ hρ
    have hbound : ∀ σ : Euclid d, a' * v (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) ≤
        f (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) := by
      intro σ
      rcases (Real.sqrt_nonneg (ρ ^ 2 - ‖σ‖ ^ 2)).eq_or_lt with h | h
      · rw [← h, hv0, mul_zero]
        exact zero_le
      · have hr : Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2) ∈ Ioo 0 s :=
          ⟨h, lt_of_le_of_lt (hsq_le ρ hρ.1 σ) hρ.2⟩
        have h2 := hsub hr
        simp only [mem_ofPred_eq] at h2
        rw [ENNReal.lt_div_iff_mul_lt (Or.inl (hc0 m _ h)) (Or.inl (hct m _))] at h2
        rw [hv]
        simp only
        rw [hvol m _ h]
        exact h2.le
    have hint := lintegral_mono (μ := (volume : Measure (Euclid d))) hbound
    rw [lintegral_const_mul' _ _ (ne_top_of_lt ha'θ), hslice ρ hρ.1] at hint
    calc a < a' := haa'
      _ = a' * (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m))) /
            (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m))) :=
          (ENNReal.mul_div_cancel_right (hc0 _ _ hρ.1) (hct _ _)).symm
      _ ≤ _ := ENNReal.div_le_div_right hint _
  · -- upper bound: `f ≤ b'·v` on `[0, s)` integrates to the ratio `≤ b'` for `ρ ∈ (0, s)`
    obtain ⟨b', hθb', hb'b⟩ := exists_between hb
    have h1 : ∀ᶠ r in 𝓝[>] (0 : ℝ), f r / (unitBallVolume m * ENNReal.ofReal (r ^ m)) < b' :=
      (tendsto_order.1 hlim).2 b' hθb'
    obtain ⟨s, hs, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 h1
    filter_upwards [Ioo_mem_nhdsGT hs] with ρ hρ
    have hbound : ∀ σ : Euclid d, f (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) ≤
        b' * v (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) := by
      intro σ
      rcases (Real.sqrt_nonneg (ρ ^ 2 - ‖σ‖ ^ 2)).eq_or_lt with h | h
      · rw [← h, hf0]
        exact zero_le
      · have hr : Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2) ∈ Ioo 0 s :=
          ⟨h, lt_of_le_of_lt (hsq_le ρ hρ.1 σ) hρ.2⟩
        have h2 := hsub hr
        simp only [mem_ofPred_eq] at h2
        rw [ENNReal.div_lt_iff (Or.inl (hc0 m _ h)) (Or.inl (hct m _))] at h2
        rw [hv]
        simp only
        rw [hvol m _ h]
        exact h2.le
    have hint := lintegral_mono (μ := (volume : Measure (Euclid d))) hbound
    rw [lintegral_const_mul' _ _ (ne_top_of_lt hb'b), hslice ρ hρ.1] at hint
    calc _ ≤ b' * (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m))) /
            (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m))) :=
          ENNReal.div_le_div_right hint _
      _ = b' := ENNReal.mul_div_cancel_right (hc0 _ _ hρ.1) (hct _ _)
      _ < b := hb'b
/-- For a nondecreasing `f : ℝ → [0, ∞]`, `∫_{ℝᵈ} f(√(ε² − |σ|²)) dσ ≠ 0` for every `ε > 0` iff
`f(ε) ≠ 0` for every `ε > 0`.  Every radius `√(ε² − |σ|²)` lies in `[0, ε]`, so `f(ε) = 0` kills
the integrand; conversely the integrand is `≥ f(ε/2)` on `B_{ε/2}(0)`, a ball of positive
Lebesgue measure. -/
theorem Submission.dimred_cs_psd_radial_support : ∀ (d : ℕ) (f : ℝ → ℝ≥0∞), Monotone f → ((∀ ε : ℝ, 0 < ε → (∫⁻ σ : Euclid d, f (Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2))) ≠ 0) ↔ ∀ ε : ℝ, 0 < ε → f ε ≠ 0) := by
  intro d f hf
  constructor
  · -- (⇒) if `f(ε) = 0`, then `0 ≤ f(√(ε² − |σ|²)) ≤ f(ε) = 0` for every `σ`
    intro h ε hε hfε
    apply h ε hε
    have hz : ∀ σ : Euclid d, f (Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2)) = 0 := by
      intro σ
      refine le_antisymm ?_ zero_le
      calc f (Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2)) ≤ f ε := by
            apply hf
            calc Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2) ≤ Real.sqrt (ε ^ 2) :=
                  Real.sqrt_le_sqrt (by nlinarith [norm_nonneg σ])
              _ = ε := Real.sqrt_sq hε.le
        _ = 0 := hfε
    simp [hz]
  · -- (⇐) the integral is `≥ f(ε/2) · Lᵈ(B_{ε/2}(0))`, a product of nonzero factors
    intro h ε hε h0
    have hε2 : 0 < ε / 2 := by linarith
    have hle : ∀ σ : Euclid d, (ball (0 : Euclid d) (ε / 2)).indicator (fun _ => f (ε / 2)) σ ≤
        f (Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2)) := by
      intro σ
      by_cases hσ : σ ∈ ball (0 : Euclid d) (ε / 2)
      · rw [indicator_of_mem hσ]
        apply hf
        rw [mem_ball_zero_iff] at hσ
        rw [Real.le_sqrt hε2.le (by nlinarith [norm_nonneg σ])]
        nlinarith [norm_nonneg σ]
      · rw [indicator_of_notMem hσ]
        exact zero_le
    have hint := lintegral_mono (μ := (volume : Measure (Euclid d))) hle
    rw [h0, lintegral_indicator_const measurableSet_ball] at hint
    have hprod : f (ε / 2) * volume (ball (0 : Euclid d) (ε / 2)) = 0 := le_antisymm hint zero_le
    rcases mul_eq_zero.1 hprod with hf0 | hv0
    · exact h _ hε2 hf0
    · exact (measure_ball_pos volume (0 : Euclid d) hε2).ne' hv0

/-- Supports and densities of `[[L]] × S₀` (in the proof of **Simon 7.3.5**, chapter-07.txt
lines 410–418, which the book leaves to the reader): let `d = dim L < n`, let `R`, `R₀` represent
`S`, `S₀` in `ℝᴾ`, and put `μ = μ_R`, `μ₀ = μ_{R₀}`.  If `μ₀(ℝᴾ ∖ L^⊥) = 0` and
`μ(A) = ∫_L μ₀(A − t) dHᵈ(t)` for Borel `A`, then for `t ∈ L`, `y ∈ L^⊥` and `ρ > 0`,
`μ(B_ρ(t + y)) = ∫_{ℝᵈ} f(√(ρ² − |σ|²)) dσ` with `f(r) = μ₀(B_r(y))`.  As `f` is nondecreasing,
`μ` charges every ball about `t + y` iff `μ₀` charges every ball about `y`, i.e.
`t + y ∈ spt S ⟺ y ∈ spt S₀`.  If `(ω_{n−d} r^{n−d})⁻¹ f(r) → θ` as `r ↓ 0`, then
`(ωₙρⁿ)⁻¹ μ(B_ρ(t + y)) → θ`, as `d + (n − d) = n`; so a density of `S₀` at `y` is one of `S`
at `t + y`, and, densities being unique, `S₀` having a density at `y` gives the converse. -/
theorem Submission.dimred_cs_product_support_density : ∀ (P n : ℕ) (L : Submodule ℝ (Euclid P)) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (S₀ : GeometricCurrentOn (univ : Set (Euclid P)) (n - Module.finrank ℝ L)) (R : IMRep (univ : Set (Euclid P)) n) (R₀ : IMRep (univ : Set (Euclid P)) (n - Module.finrank ℝ L)), Module.finrank ℝ L < n → R.Represents S → R₀.Represents S₀ → R₀.measure (Lᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → R.measure A = ∫⁻ t in (L : Set (Euclid P)), R₀.measure ((fun y => t + y) ⁻¹' A) ∂μHE[Module.finrank ℝ L]) → (∀ y ∈ Lᗮ, ∃ θ : ℝ, HasMassDensity S₀ y θ) → (∀ t ∈ L, ∀ y ∈ Lᗮ, (t + y ∈ S.support ↔ y ∈ S₀.support)) ∧ ∀ t ∈ L, ∀ y ∈ Lᗮ, ∀ θ : ℝ, (HasMassDensity S (t + y) θ ↔ HasMassDensity S₀ y θ) := by
  intro P n L S S₀ R R₀ hdn hR hR₀ hconc hprod hdens
  -- `M_W(S) = μ(W)` and `M_W(S₀) = μ₀(W)` for open `W`; supports are read off from balls
  obtain ⟨hmS, hsS, -⟩ := Submission.dimred_im_mass_measure P n univ S R isOpen_univ hR
  obtain ⟨hmS₀, hsS₀, -⟩ :=
    Submission.dimred_im_mass_measure P (n - Module.finrank ℝ L) univ S₀ R₀ isOpen_univ hR₀
  -- slicing: `μ(B_ρ(t + y)) = ∫_{ℝᵈ} μ₀(B_{√(ρ² − |σ|²)}(y)) dσ`
  have hball := Submission.dimred_cs_psd_ball_formula P L R.measure R₀.measure hconc hprod
  refine ⟨fun t ht y hy => ?_, fun t ht y hy θ => ?_⟩
  · -- supports, via the nondecreasing profile `r ↦ μ₀(B_r(y))`
    have hmono : Monotone fun r : ℝ => R₀.measure (ball y r) :=
      fun a b hab => measure_mono (ball_subset_ball hab)
    rw [hsS _ (mem_univ _), hsS₀ _ (mem_univ _),
      ← Submission.dimred_cs_psd_radial_support (Module.finrank ℝ L) _ hmono]
    exact forall₂_congr fun ε hε => by rw [hball t ht y hy ε hε]
  · -- a density `a` of `S₀` at `y` is a density of `S` at `t + y`
    have key : ∀ a : ℝ, HasMassDensity S₀ y a → HasMassDensity S (t + y) a := by
      rintro a ⟨ha, hlim⟩
      refine ⟨ha, ?_⟩
      have h0 : Tendsto (fun r : ℝ => R₀.measure (ball y r) /
          (unitBallVolume (n - Module.finrank ℝ L) *
            ENNReal.ofReal (r ^ (n - Module.finrank ℝ L)))) (𝓝[>] 0) (𝓝 (ENNReal.ofReal a)) :=
        hlim.congr fun r => by rw [hmS₀ _ isOpen_ball (subset_univ _)]
      have h1 := Submission.dimred_cs_psd_radial_density (Module.finrank ℝ L)
        (n - Module.finrank ℝ L) (fun r => R₀.measure (ball y r)) _ (by simp) h0
      rw [Nat.add_sub_of_le hdn.le] at h1
      refine h1.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ hρ
      rw [hmS _ isOpen_ball (subset_univ _), hball t ht y hy ρ hρ]
    refine ⟨fun h => ?_, key θ⟩
    -- `S₀` has a density `Θ₀` at `y`, which is also one of `S` at `t + y`; densities are unique,
    -- as limits along `𝓝[>] 0` are unique and `ofReal` is injective on `[0, ∞)`
    obtain ⟨Θ₀, hΘ₀⟩ := hdens y hy
    have hS := key Θ₀ hΘ₀
    rwa [(ENNReal.ofReal_eq_ofReal_iff h.1 hS.1).1 (tendsto_nhds_unique h.2 hS.2)]

/-- **Simon 7.3.5** (proof left to the reader, chapter-07.txt lines 407–417), the carrier of a
competitor: let `S₁ = τ(M₁, θ₁, ξ₁)` and `S₂ = τ(M₂, θ₂, ξ₂)` in `ℝᴾ`, `μᵢ = θᵢHʲ⌞Mᵢ`, and let
`F` be closed.  If `μ₂(ℝᴾ ∖ F) = 0` and `spt(S₁ − S₂) ⊆ F`, then `μ₁(ℝᴾ ∖ F) = 0`.  A point off
`F` has a `μ₂`-null ball, so `spt S₂ ⊆ F` (`dimred_im_mass_measure`); off `F` both `S₂` and
`S₁ − S₂` vanish on open sets `W ⊂⊂ ℝᴾ`, so `S₁ = S₂ + (S₁ − S₂)` vanishes on their intersection
and `spt S₁ ⊆ F`; finally `μ₁(ℝᴾ ∖ spt S₁) = 0` (`imrep_carrier_sdiff_support_null`). -/
theorem Submission.dimred_cs_sos_mt_cm_carried_transfer : ∀ (P j : ℕ) (S₁ S₂ : GeometricCurrentOn (univ : Set (Euclid P)) j) (R₁ R₂ : IMRep (univ : Set (Euclid P)) j) (F : Set (Euclid P)), R₁.Represents S₁ → R₂.Represents S₂ → IsClosed F → R₂.measure Fᶜ = 0 → (S₁ - S₂).support ⊆ F → R₁.measure Fᶜ = 0 := by
  intro P j S₁ S₂ R₁ R₂ F hR₁ hR₂ hF hR₂F hsupp
  -- `spt S₂ ⊆ F`: a point `x ∉ F` has a ball `B_ε(x) ⊆ ℝᴾ ∖ F`, which is `μ₂`-null
  have h2 : S₂.support ⊆ F := by
    intro x hx
    by_contra hxF
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hF.isOpen_compl x hxF
    exact ((Submission.dimred_im_mass_measure P j univ S₂ R₂ isOpen_univ hR₂).2.1 x (mem_univ x)).1
      hx ε hε (measure_mono_null hball hR₂F)
  -- `spt S₁ ⊆ F`: off `F`, `S₂` vanishes on some `W₁ ⊂⊂ ℝᴾ` and `S₁ − S₂` on some `W₂ ⊂⊂ ℝᴾ`
  -- about `x`, so `S₁` vanishes on `W₁ ∩ W₂ ⊂⊂ ℝᴾ`
  have h1 : S₁.support ⊆ F := by
    intro x hx
    by_contra hxF
    have hz2 : x ∈ S₂.zeroRegion := by
      by_contra hc
      exact hxF (h2 ⟨mem_univ x, hc⟩)
    have hz3 : x ∈ (S₁ - S₂).zeroRegion := by
      by_contra hc
      exact hxF (hsupp ⟨mem_univ x, hc⟩)
    obtain ⟨W₁, ⟨hW₁o, hW₁c, hW₁U, hW₁v⟩, hxW₁⟩ := mem_sUnion.mp hz2
    obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hxW₂⟩ := mem_sUnion.mp hz3
    have hcl : closure (W₁ ∩ W₂) ⊆ closure W₁ := closure_mono inter_subset_left
    apply hx.2
    refine mem_sUnion.mpr ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o, hW₁c.of_isClosed_subset isClosed_closure hcl,
      hcl.trans hW₁U, ?_⟩, hxW₁, hxW₂⟩
    intro ω hω
    have e1 : S₂ ω = 0 := hW₁v ω (hω.trans inter_subset_left)
    have e2 : S₁ ω - S₂ ω = 0 := hW₂v ω (hω.trans inter_subset_right)
    linarith
  -- `μ₁(ℝᴾ ∖ spt S₁) = 0`: `μ₁ ≪ Hʲ⌞M₁` and `Hʲ(M₁ ∖ spt S₁) = 0`
  have h3 : R₁.measure (S₁.support)ᶜ = 0 := by
    apply withDensity_absolutelyContinuous
    rw [Measure.restrict_apply' R₁.measurableSet_carrier, inter_comm, ← Set.sdiff_eq]
    exact Submission.imrep_carrier_sdiff_support_null P j univ S₁ R₁ isOpen_univ hR₁
  exact measure_mono_null (compl_subset_compl.mpr h1) h3
/-- **The comparison box** (proof of Simon 7.3.5, which the book leaves to the reader).  Let
`g = (g₁, …, g_k)` be orthonormal in `ℝᴾ`, `G = span{gᵢ}`, `p = G.starProjection`,
`q = Gᗮ.starProjection`, `r < s`, `C_s = {x : |⟨gᵢ, x⟩| < s for all i}` and
`W = p⁻¹(C_s) ∩ q⁻¹(B_ρ(0))`.  Then `W` is open: `C_s` is a finite intersection of open sets, and
`p`, `q` are continuous.  A vector `t = Σ cᵢgᵢ ∈ G` has `cᵢ = ⟨gᵢ, t⟩`, so `‖t‖ ≤ Σᵢ |⟨gᵢ, t⟩|`.
Hence `‖x‖ ≤ ‖p x‖ + ‖q x‖ ≤ ks + ρ` on `W`, and `W ⊂⊂ ℝᴾ`.  Finally, `⟨gᵢ, p x⟩ = ⟨p gᵢ, x⟩ =
⟨gᵢ, x⟩`, so for `K ⊆ B_ρ(0)` the slab `{|⟨gᵢ, ·⟩| ≤ r} ∩ q⁻¹(K)` lies in `W`. -/
theorem Submission.dimred_cs_sos_mt_cm_comparison_box : ∀ (P k : ℕ) (g : Fin k → Euclid P) (r s ρ : ℝ), Orthonormal ℝ g → r < s → IsOpen ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ) ∧ CompactlyContained ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ) univ ∧ ∀ K : Set (Euclid P), K ⊆ ball (0 : Euclid P) ρ → {x | ∀ i, |inner ℝ (g i) x| ≤ r} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' K ⊆ (Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ := by
  intro P k g r s ρ hg hrs
  set G := Submodule.span ℝ (Set.range g)
  -- Step 1: `C_s = ⋂ᵢ {|⟨gᵢ, ·⟩| < s}` is open and `p`, `q` are continuous, so `W` is open
  have hCo : IsOpen {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} := by
    have hset : {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} = ⋂ i, {x | |inner ℝ (g i) x| < s} := by
      ext x; simp
    rw [hset]
    exact isOpen_iInter_of_finite fun i =>
      isOpen_lt (continuous_const.inner continuous_id).abs continuous_const
  have hWo : IsOpen (G.starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩
      Gᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ) :=
    (hCo.preimage G.starProjection.continuous).inter
      (isOpen_ball.preimage Gᗮ.starProjection.continuous)
  -- Step 2: `t = Σ cᵢgᵢ ∈ G` has `cᵢ = ⟨gᵢ, t⟩` and `‖gᵢ‖ = 1`, so `‖t‖ ≤ Σᵢ |⟨gᵢ, t⟩|`
  have hcoord : ∀ t ∈ G, ‖t‖ ≤ ∑ i, |inner ℝ (g i) t| := by
    intro t ht
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 ht
    calc ‖∑ i, c i • g i‖ ≤ ∑ i, ‖c i • g i‖ := norm_sum_le _ _
      _ = ∑ i, |inner ℝ (g i) (∑ j, c j • g j)| := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [norm_smul, hg.1 i, mul_one, hg.inner_right_fintype c i, Real.norm_eq_abs]
  -- Step 3: on `W`, `‖x‖ ≤ ‖p x‖ + ‖q x‖ ≤ ks + ρ`, so `W` is bounded
  have hbdd : Bornology.IsBounded (G.starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩
      Gᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ) := by
    rw [isBounded_iff_subset_closedBall 0]
    refine ⟨k * s + ρ, fun x hx => ?_⟩
    rw [mem_closedBall, dist_zero_right]
    have h1 : ‖G.starProjection x‖ ≤ k * s := by
      calc ‖G.starProjection x‖ ≤ ∑ i, |inner ℝ (g i) (G.starProjection x)| :=
            hcoord _ (G.starProjection_apply_mem x)
        _ ≤ ∑ _i : Fin k, s := Finset.sum_le_sum fun i _ => (hx.1 i).le
        _ = k * s := by simp
    have h2 : ‖Gᗮ.starProjection x‖ < ρ := by simpa using hx.2
    calc ‖x‖ = ‖G.starProjection x + Gᗮ.starProjection x‖ := by
          rw [G.starProjection_add_starProjection_orthogonal]
      _ ≤ ‖G.starProjection x‖ + ‖Gᗮ.starProjection x‖ := norm_add_le _ _
      _ ≤ k * s + ρ := by linarith
  -- Step 4: `ℝᴾ` is proper, so the bounded set `W` has compact closure
  refine ⟨hWo, ⟨hbdd.isCompact_closure, subset_univ _⟩, ?_⟩
  -- Step 5: `⟨gᵢ, p x⟩ = ⟨p gᵢ, x⟩ = ⟨gᵢ, x⟩`, so the slab over `K ⊆ B_ρ(0)` lies in `W`
  intro K hK x hx
  refine ⟨fun i => ?_, hK hx.2⟩
  have hgi : inner ℝ (g i) (G.starProjection x) = inner ℝ (g i) x := by
    rw [← G.inner_starProjection_left_eq_right,
      G.starProjection_eq_self_iff.mpr (Submodule.subset_span ⟨i, rfl⟩)]
  rw [hgi]
  exact (hx.1 i).trans_lt hrs

/-- **Coordinate boxes in the span of an orthonormal frame have `Hᵏ`-measure `(2r)ᵏ`** (Simon
Ch. 1, 2.9, `Hᵏ = Lᵏ` on `ℝᵏ`; box volumes for the splitting lemma, Ch. 7, 3.5).  Let
`G = span g` and `ι(u) = Σᵢ uᵢ gᵢ` for `u : Fin k → ℝ` with the sup norm.  By
`Submission.cbr_cipi_affine_plane_measure` at `a = 0`, `ι_*(Lᵏ) = Hᵏ⌞G`.  Both boxes are Borel
subsets of the closed subspace `G`, so `Hᵏ(S) = (Hᵏ⌞G)(S) = Lᵏ(ι⁻¹S)`.  Orthonormality gives
`ι(u) ∈ G` and `⟨gᵢ, ι(u)⟩ = uᵢ`, so the closed and open boxes pull back to the sup-norm balls
`closedBall 0 r` and `ball 0 r` of `ℝᵏ`, both of volume `(2r)ᵏ`. -/
theorem Submission.dimred_cs_sos_mt_fm_box_measure : ∀ (P k : ℕ) (g : Fin k → Euclid P), Orthonormal ℝ g → ∀ r : ℝ, 0 < r → μHE[k] {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} = ENNReal.ofReal ((2 * r) ^ k) ∧ μHE[k] {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < r} = ENNReal.ofReal ((2 * r) ^ k) := by
  intro P k g hg r hr
  set G : Set (Euclid P) := (Submodule.span ℝ (Set.range g) : Set (Euclid P))
  set ι : (Fin k → ℝ) → Euclid P := fun u => ∑ i, u i • g i
  -- Step 1: `ι_*(Lᵏ) = Hᵏ⌞G`, the affine plane measure at `a = 0`
  have hmap : Measure.map ι volume = (μHE[k] : Measure (Euclid P)).restrict G := by
    simpa [ι, G] using (Submission.cbr_cipi_affine_plane_measure P k g 0 hg).1
  -- Step 2: `ι` is continuous, `G` is closed, and the coordinates `|⟨gᵢ, ·⟩|` are continuous
  have hιm : Measurable ι :=
    (continuous_finsetSum _ fun i _ => (continuous_apply i).smul continuous_const).measurable
  have hGc : IsClosed G := (Submodule.span ℝ (Set.range g)).closed_of_finiteDimensional
  have hcont : ∀ i, Continuous fun t : Euclid P => |inner ℝ (g i) t| := fun i =>
    (continuous_const.inner continuous_id).abs
  -- Step 3: `Hᵏ(S) = (Hᵏ⌞G)(S) = Lᵏ(ι⁻¹S)` for Borel `S ⊆ G`
  have key : ∀ S : Set (Euclid P), MeasurableSet S → S ⊆ G → μHE[k] S = volume (ι ⁻¹' S) := by
    intro S hS hSG
    rw [← Measure.map_apply hιm hS, hmap, Measure.restrict_apply hS, inter_eq_left.mpr hSG]
  -- Step 4: `ι(u) ∈ G` and `⟨gᵢ, ι(u)⟩ = uᵢ` by orthonormality
  have hmemG : ∀ u, ι u ∈ Submodule.span ℝ (Set.range g) := fun u =>
    Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span (mem_range_self i))
  have hcoord : ∀ u i, inner ℝ (g i) (ι u) = u i := fun u i => hg.inner_right_fintype u i
  refine ⟨?_, ?_⟩
  -- Step 5: the closed box pulls back to the sup-norm `closedBall 0 r`, of volume `(2r)ᵏ`
  · rw [key _ ?_ fun t ht => ht.1]
    · have hpre : ι ⁻¹' {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} =
          closedBall 0 r := by
        ext u
        simp only [mem_preimage, mem_ofPred_eq, hcoord, mem_closedBall_zero_iff,
          pi_norm_le_iff_of_nonneg hr.le, Real.norm_eq_abs]
        exact ⟨fun h => h.2, fun h => ⟨hmemG u, h⟩⟩
      rw [hpre, Real.volume_pi_closedBall _ hr.le, Fintype.card_fin]
    · rw [ofPred_and, ofPred_forall]
      exact hGc.measurableSet.inter (MeasurableSet.iInter fun i =>
        (isClosed_le (hcont i) continuous_const).measurableSet)
  -- Step 6: the open box pulls back to the sup-norm `ball 0 r`, of volume `(2r)ᵏ`
  · rw [key _ ?_ fun t ht => ht.1]
    · have hpre : ι ⁻¹' {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < r} =
          ball 0 r := by
        ext u
        simp only [mem_preimage, mem_ofPred_eq, hcoord, mem_ball_zero_iff, pi_norm_lt_iff hr,
          Real.norm_eq_abs]
        exact ⟨fun h => h.2, fun h => ⟨hmemG u, h⟩⟩
      rw [hpre, Real.volume_pi_ball _ hr, Fintype.card_fin]
    · rw [ofPred_and, ofPred_forall]
      exact hGc.measurableSet.inter (MeasurableSet.iInter fun i =>
        (isOpen_lt (hcont i) continuous_const).measurableSet)

/-- **The frame map of an orthonormal family pushes Lebesgue measure to `Hᵏ` on its span**
(Simon Ch. 1, 2.9, `Hᵏ = Lᵏ` on `ℝᵏ`; the coordinates of the splitting lemma, Ch. 7, 3.5).  Let
`G = span g` and `ι(u) = Σᵢ uᵢ gᵢ` for `u : Fin k → ℝ`.  (i) is
`Submission.cbr_cipi_affine_plane_measure` at `a = 0`, `ι_*(Lᵏ) = Hᵏ⌞G`, and (ii) is
`Submission.dimred_cs_sos_mt_fm_box_measure`: the closed and open coordinate boxes of `G` of
half-width `r` both have `Hᵏ`-measure `(2r)ᵏ`. -/
theorem Submission.dimred_cs_sos_mt_frame_measure : ∀ (P k : ℕ) (g : Fin k → Euclid P), Orthonormal ℝ g → (volume : Measure (Fin k → ℝ)).map (fun u => ∑ i, u i • g i) = μHE[k].restrict (Submodule.span ℝ (Set.range g) : Set (Euclid P)) ∧ ∀ r : ℝ, 0 < r → μHE[k] {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} = ENNReal.ofReal ((2 * r) ^ k) ∧ μHE[k] {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < r} = ENNReal.ofReal ((2 * r) ^ k) := by
  intro P k g hg
  refine ⟨?_, Submission.dimred_cs_sos_mt_fm_box_measure P k g hg⟩
  -- (i): the affine plane measure at `a = 0`, where `0 + ι(u) = ι(u)` and `y − 0 = y`
  simpa using (Submission.cbr_cipi_affine_plane_measure P k g 0 hg).1
/-- **Simon 7.3.5, proof (masses in a projection box)**: let `g` be orthonormal with span `G`,
`p = p_G`, `q = p_{G^⊥}`, `0 < r < s`, `Q_r = {t ∈ G : |⟨gᵢ, t⟩| ≤ r ∀ i}`,
`C_s = {x : |⟨gᵢ, x⟩| < s ∀ i}`, `B` open and `W = p⁻¹(C_s) ∩ q⁻¹(B)`.  Let `S`, `A₁`, `A₂` be
represented by `R`, `R_{A₁}`, `R_{A₂}`, whose measures are `A ↦ ∫_E μ(A − t) dHᵏ(t)` for
`(E, μ) = (G, μ₀)`, `(G ∖ Q_r, μ₀)`, `(Q_r, μ₀′)` with `μ₀`, `μ₀′` carried by `G^⊥`.  Then
`M_W(S) = (2s)ᵏ μ₀(B)`, `M_W(A₁) = ((2s)ᵏ − (2r)ᵏ) μ₀(B)` and `M_W(A₂) = (2r)ᵏ μ₀′(B)`.  `W` is
open, so each mass is the measure of `W` (`Submission.imrep_represents_massOn_eq_measure`), and
`Submission.dimred_cs_sos_mt_product_box_measure` turns it into `Hᵏ(E ∩ C_s) μ(B)`.  Here
`G ∩ C_s` is the open box of half-width `s`, while `r < s` gives `Q_r ∩ C_s = Q_r` and
`(G ∖ Q_r) ∩ C_s = (G ∩ C_s) ∖ Q_r`; the box volumes `(2s)ᵏ`, `(2r)ᵏ`
(`Submission.dimred_cs_sos_mt_frame_measure`) and `measure_sdiff` finish. -/
theorem Submission.dimred_cs_sos_mt_cm_box_masses : ∀ (P k m n : ℕ) (g : Fin k → Euclid P) (S A₁ A₂ : GeometricCurrentOn (univ : Set (Euclid P)) n) (R RA₁ RA₂ : IMRep (univ : Set (Euclid P)) n) (R₀ R₀' : IMRep (univ : Set (Euclid P)) m) (r s : ℝ) (B : Set (Euclid P)), Orthonormal ℝ g → 0 < r → r < s → IsOpen B → R.Represents S → RA₁.Represents A₁ → RA₂.Represents A₂ → R₀.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → R₀'.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → R.measure A = ∫⁻ t in (Submodule.span ℝ (Set.range g) : Set (Euclid P)), R₀.measure ((fun y => t + y) ⁻¹' A) ∂μHE[k]) → (∀ A : Set (Euclid P), MeasurableSet A → RA₁.measure A = ∫⁻ t in (Submodule.span ℝ (Set.range g) : Set (Euclid P)) \ {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, R₀.measure ((fun y => t + y) ⁻¹' A) ∂μHE[k]) → (∀ A : Set (Euclid P), MeasurableSet A → RA₂.measure A = ∫⁻ t in {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, R₀'.measure ((fun y => t + y) ⁻¹' A) ∂μHE[k]) → S.massOn ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' B) = ENNReal.ofReal ((2 * s) ^ k) * R₀.measure B ∧ A₁.massOn ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' B) = (ENNReal.ofReal ((2 * s) ^ k) - ENNReal.ofReal ((2 * r) ^ k)) * R₀.measure B ∧ A₂.massOn ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' B) = ENNReal.ofReal ((2 * r) ^ k) * R₀'.measure B := by
  intro P k m n g S A₁ A₂ R RA₁ RA₂ R₀ R₀' r s B hg hr hrs hB hR hRA₁ hRA₂ hR₀c hR₀'c hRμ hμA₁ hμA₂
  -- Step 1: `G` and `Q_r` are closed, `C_s` is open, hence `W = p⁻¹(C_s) ∩ q⁻¹(B)` is open
  have hGc : IsClosed (Submodule.span ℝ (Set.range g) : Set (Euclid P)) :=
    (Submodule.span ℝ (Set.range g)).closed_of_finiteDimensional
  have hcont : ∀ i, Continuous fun t : Euclid P => |inner ℝ (g i) t| := fun i =>
    (continuous_const.inner continuous_id).abs
  have hQc : IsClosed
      {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} := by
    rw [ofPred_and, ofPred_forall]
    exact hGc.inter (isClosed_iInter fun i => isClosed_le (hcont i) continuous_const)
  have hCo : IsOpen {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} := by
    rw [ofPred_forall]
    exact isOpen_iInter_of_finite fun i => isOpen_lt (hcont i) continuous_const
  have hWo : IsOpen ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹'
      {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' B) :=
    (hCo.preimage (Submodule.span ℝ (Set.range g)).starProjection.continuous).inter
      (hB.preimage (Submodule.span ℝ (Set.range g))ᗮ.starProjection.continuous)
  -- Step 2: the box volumes `Hᵏ(Q_r) = (2r)ᵏ` and `Hᵏ(G ∩ C_s) = (2s)ᵏ`
  obtain ⟨-, hfm⟩ := Submission.dimred_cs_sos_mt_frame_measure P k g hg
  have hQμ := (hfm r hr).1
  have hOμ := (hfm s (hr.trans hrs)).2
  have hGC : (Submodule.span ℝ (Set.range g) : Set (Euclid P)) ∩
      {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} =
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < s} := rfl
  -- Step 3: `Q_r ⊆ C_s`, hence `Q_r ⊆ G ∩ C_s`, because `r < s`
  have hQC : {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} ⊆
      {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} := fun t ht i => (ht.2 i).trans_lt hrs
  have hQO : {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} ⊆
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < s} :=
    fun t ht => ⟨ht.1, hQC ht⟩
  -- Step 4: each mass is the measure of the open `W`, which is `Hᵏ(E ∩ C_s) μ(B)`; here
  -- `G ∩ C_s` is the open box of half-width `s` and `Q_r ∩ C_s = Q_r`
  have mS := Submission.imrep_represents_massOn_eq_measure P n univ _ S R isOpen_univ hR hWo
    (subset_univ _)
  have mA₁ := Submission.imrep_represents_massOn_eq_measure P n univ _ A₁ RA₁ isOpen_univ hRA₁ hWo
    (subset_univ _)
  have mA₂ := Submission.imrep_represents_massOn_eq_measure P n univ _ A₂ RA₂ isOpen_univ hRA₂ hWo
    (subset_univ _)
  rw [Submission.dimred_cs_sos_mt_product_box_measure P k _ R.measure R₀.measure _ hR₀c
    hGc.measurableSet subset_rfl hRμ _ B hCo.measurableSet hB.measurableSet, hGC, hOμ] at mS
  rw [Submission.dimred_cs_sos_mt_product_box_measure P k _ RA₂.measure R₀'.measure _ hR₀'c
    hQc.measurableSet (fun t ht => ht.1) hμA₂ _ B hCo.measurableSet hB.measurableSet,
    inter_eq_left.mpr hQC, hQμ] at mA₂
  -- Step 5: `(G ∖ Q_r) ∩ C_s = (G ∩ C_s) ∖ Q_r` has measure `(2s)ᵏ − (2r)ᵏ`
  have hdiff : ((Submodule.span ℝ (Set.range g) : Set (Euclid P)) \
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}) ∩
      {x | ∀ i, |inner ℝ (g i) x| < s} =
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < s} \
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} := by
    rw [← hGC]
    exact sdiff_inter_right_comm _ _ _
  rw [Submission.dimred_cs_sos_mt_product_box_measure P k _ RA₁.measure R₀.measure _ hR₀c
    (hGc.measurableSet.diff hQc.measurableSet) sdiff_subset hμA₁ _ B hCo.measurableSet
    hB.measurableSet, hdiff, measure_sdiff hQO hQc.measurableSet.nullMeasurableSet
    (by rw [hQμ]; exact ENNReal.ofReal_ne_top), hOμ, hQμ] at mA₁
  exact ⟨mS, mA₁, mA₂⟩

/-- **Bounded subsets of the span of an orthonormal frame have finite `Hᵏ`-measure** (Simon
Ch. 1, 2.9, `Hᵏ = Lᵏ` on `ℝᵏ`; integrability over `G` in the splitting lemma, Ch. 7, 3.5).
Let `G = span g`.  A bounded `E ⊆ G` lies in some `closedBall 0 ρ`; put `r = max ρ 0 + 1 > 0`.
For `t ∈ E`, Cauchy–Schwarz and `‖gᵢ‖ = 1` give `|⟨gᵢ, t⟩| ≤ ‖t‖ ≤ ρ ≤ r`, so `E` lies in the
closed coordinate box of `G` of half-width `r`.  By `Submission.dimred_cs_sos_mt_frame_measure`
(ii) that box has `Hᵏ`-measure `(2r)ᵏ < ∞`, and monotonicity finishes. -/
theorem Submission.dimred_cs_sos_mt_si_span_bounded_measure_ne_top : ∀ (P k : ℕ) (g : Fin k → Euclid P), Orthonormal ℝ g → ∀ E : Set (Euclid P), E ⊆ (Submodule.span ℝ (Set.range g) : Set (Euclid P)) → Bornology.IsBounded E → μHE[k] E ≠ ∞ := by
  intro P k g hg E hEG hE
  -- Step 1: `E ⊆ closedBall 0 ρ`; put `r = max ρ 0 + 1`, so that `0 < r` and `ρ ≤ r`
  obtain ⟨ρ, hρ⟩ := hE.subset_closedBall 0
  set r : ℝ := max ρ 0 + 1
  have hr : 0 < r := by linarith [le_max_right ρ 0]
  have hρr : ρ ≤ r := by linarith [le_max_left ρ 0]
  -- Step 2: `E` lies in the closed box of half-width `r`, by Cauchy–Schwarz and `‖gᵢ‖ = 1`
  have hbox : E ⊆ {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} := by
    intro t ht
    refine ⟨hEG ht, fun i => ?_⟩
    calc |inner ℝ (g i) t| ≤ ‖g i‖ * ‖t‖ := abs_real_inner_le_norm _ _
      _ = ‖t‖ := by rw [hg.1 i, one_mul]
      _ ≤ ρ := mem_closedBall_zero_iff.mp (hρ ht)
      _ ≤ r := hρr
  -- Step 3: the box has `Hᵏ`-measure `(2r)ᵏ < ∞` by frame_measure (ii); monotonicity finishes
  refine ne_top_of_le_ne_top ?_ (measure_mono hbox)
  rw [((Submission.dimred_cs_sos_mt_frame_measure P k g hg).2 r hr).1]
  exact ENNReal.ofReal_ne_top
/-- **Interior product with a frame; translated test forms.**  (a) For `g = (g₁, …, g_k)` in
`ℝᴾ` and `n' = k + m`, `♭α(v) = α(g₁, …, g_k, v₁, …, v_m)` defines a continuous linear map
`♭ : Λ^{n'} → Λ^m`.  Updating `vⱼ` updates only the entry `natAdd k j` of `(g, v)`, so `♭α` is
multilinear; it is alternating because equal entries of `v` stay at distinct indices; it is
continuous; and `‖♭α‖ ≤ (∏ᵢ ‖gᵢ‖) ‖α‖`, so `α ↦ ♭α` is bounded (`LinearMap.mkContinuous`).
(b) For a continuous linear `Φ : Λᵃ → Λᵇ`, a test `a`-form `ω` and `t ∈ ℝᴾ`, `y ↦ Φ(ω(t + y))`
is smooth and vanishes off the closed set `{y : t + y ∈ spt ω}`, the compact translate
`spt ω − t`; hence it is a test form supported there.  This is the interior product `♭_g` of
the product construction `[[E]] ×_g A` used to split off the spine of a cone. -/
theorem Submission.dimred_cs_sos_mt_interior_product : ∀ P : ℕ, (∀ (k m n' : ℕ) (g : Fin k → Euclid P) (h : n' = k + m), ∃ flat : Covector (Euclid P) n' →L[ℝ] Covector (Euclid P) m, ∀ (α : Covector (Euclid P) n') (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) ∧ ∀ (a b : ℕ) (flat : Covector (Euclid P) a →L[ℝ] Covector (Euclid P) b) (ω : DifferentialForm (Euclid P) a) (t : Euclid P), IsTestForm ω → IsTestForm (fun y => flat (ω (t + y))) ∧ tsupport (fun y => flat (ω (t + y))) ⊆ (fun y => t + y) ⁻¹' tsupport ω := by
  intro P
  refine ⟨fun k m n' g h => ?_, fun a b flat ω t hω => ?_⟩
  · -- (a) the interior product with the frame `g`; first identify `n'` with `k + m`
    subst h
    -- the entries `castAdd m i` (from `g`) and `natAdd k j` (from `v`) are distinct
    have hne : ∀ (i : Fin k) (j : Fin m), Fin.castAdd m i ≠ Fin.natAdd k j := by
      intro i j hc
      have hv := congrArg Fin.val hc
      have hi := i.isLt
      simp only [Fin.val_castAdd, Fin.val_natAdd] at hv
      omega
    -- updating `v` at `j` updates `Fin.append g v` at `natAdd k j` (for any `DecidableEq`)
    have hupd : ∀ (_ : DecidableEq (Fin m)) (v : Fin m → Euclid P) (j : Fin m) (x : Euclid P),
        Fin.append g (Function.update v j x) =
          Function.update (Fin.append g v) (Fin.natAdd k j) x := by
      intro _ v j x
      funext z
      induction z using Fin.addCases with
      | left i => rw [Fin.append_left, Function.update_of_ne (hne i j), Fin.append_left]
      | right j' =>
        rw [Fin.append_right, Function.update_apply_of_injective _ (Fin.natAdd_injective m k)]
        congr 1
        funext i
        rw [Fin.append_right]
    -- `v ↦ Fin.append g v` is continuous: each entry is a constant `gᵢ` or a projection `vⱼ`
    have hcont : Continuous fun v : Fin m → Euclid P => Fin.append g v := by
      refine continuous_pi fun z => ?_
      induction z using Fin.addCases with
      | left i => simp only [Fin.append_left]; exact continuous_const
      | right j => simp only [Fin.append_right]; exact continuous_apply j
    -- `♭α (v) = α (g, v)` is a continuous alternating map
    let φ : Covector (Euclid P) (k + m) → Covector (Euclid P) m := fun α =>
      { toFun := fun v => α (Fin.append g v)
        map_update_add' := fun v j x y => by
          simp only [hupd _ v j, α.map_update_add]
        map_update_smul' := fun v j c x => by
          simp only [hupd _ v j, α.map_update_smul]
        cont := α.cont.comp hcont
        map_eq_zero_of_eq' := fun v i j hv hij =>
          α.map_eq_zero_of_eq (Fin.append g v) (i := Fin.natAdd k i) (j := Fin.natAdd k j)
            (by rw [Fin.append_right, Fin.append_right]; exact hv)
            ((Fin.natAdd_injective m k).ne hij) }
    have hφ : ∀ α v, φ α v = α (Fin.append g v) := fun α v => rfl
    -- `α ↦ ♭α` is linear
    let L : Covector (Euclid P) (k + m) →ₗ[ℝ] Covector (Euclid P) m :=
      { toFun := φ
        map_add' := fun α β => by
          ext v
          simp only [hφ, ContinuousAlternatingMap.add_apply]
        map_smul' := fun c α => by
          ext v
          simp only [hφ, ContinuousAlternatingMap.smul_apply, RingHom.id_apply] }
    -- and bounded: `|α (g, v)| ≤ ‖α‖ ∏ᵢ ‖gᵢ‖ ∏ⱼ ‖vⱼ‖`, so `‖♭α‖ ≤ (∏ᵢ ‖gᵢ‖) ‖α‖`
    have hbound : ∀ α, ‖L α‖ ≤ (∏ i, ‖g i‖) * ‖α‖ := by
      intro α
      refine ContinuousAlternatingMap.opNorm_le_bound _ (by positivity) fun v => ?_
      calc ‖L α v‖ = ‖α (Fin.append g v)‖ := rfl
        _ ≤ ‖α‖ * ∏ z, ‖Fin.append g v z‖ := α.le_opNorm _
        _ = (∏ i, ‖g i‖) * ‖α‖ * ∏ j, ‖v j‖ := by
          rw [Fin.prod_univ_add]
          simp only [Fin.append_left, Fin.append_right]
          ring
    refine ⟨L.mkContinuous (∏ i, ‖g i‖) hbound, fun α v => ?_⟩
    rw [LinearMap.mkContinuous_apply, Fin.cast_refl, Function.comp_id]
    rfl
  · -- (b) off `{y : t + y ∈ spt ω}` the form `ω (t + y)` vanishes, hence so does its image
    have hsub : tsupport (fun y => flat (ω (t + y))) ⊆ (fun y => t + y) ⁻¹' tsupport ω := by
      refine closure_minimal (fun y hy => ?_)
        ((isClosed_tsupport ω).preimage (continuous_const.add continuous_id))
      by_contra hy'
      apply hy
      show flat (ω (t + y)) = 0
      rw [image_eq_zero_of_notMem_tsupport (f := ω) (x := t + y) hy', map_zero]
    have hs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) ω := hω.1
    -- `{y : t + y ∈ spt ω}` is the compact translate `spt ω − t`
    have hK : IsCompact ((fun y => t + y) ⁻¹' tsupport ω) := by
      have hK' := (Homeomorph.addLeft t).isCompact_preimage.mpr hω.2
      rwa [Homeomorph.coe_addLeft] at hK'
    refine ⟨⟨?_, ?_⟩, hsub⟩
    · exact flat.contDiff.comp (hs.comp (contDiff_const.add contDiff_id))
    · exact hK.of_isClosed_subset (isClosed_tsupport _) hsub

/-- **Slices of an integer multiplicity current are continuous and integrable over a frame span**
(the product construction of the splitting lemma, Ch. 7, 3.5).  Let `G = span g`, `η = Φ ∘ ω`
and `F(t) = T(η(t + ·))`.  By `Submission.dimred_cs_sos_mt_interior_product` (b) each
`η(t + ·)` is a test form, so `F(t) = τ(M, θ, ξ)(η(t + ·))` as `R_T` represents `T`.  (i) is
`Submission.dimred_cs_sos_mt_si_translate_action_continuous`, `η` being continuous with compact
support.  (ii) A bounded `E ⊆ G` has compact closure, on which the continuous `F` is bounded,
and finite `Hᵏ`-measure by `Submission.dimred_cs_sos_mt_si_span_bounded_measure_ne_top`.
(iii) If `μ_{R_T}(ℝᴾ \ Gᗮ) = 0`, then
`Submission.dimred_cs_sos_mt_si_translate_action_eq_zero_of_concentrated` gives a compact `K`
with `F = 0` on `G \ K`; `F` is integrable on the bounded set `E ∩ K` by (ii) and vanishes on
`E \ K`. -/
theorem Submission.dimred_cs_sos_mt_slice_integrable : ∀ (P k j n' : ℕ) (g : Fin k → Euclid P) (T : GeometricCurrentOn (univ : Set (Euclid P)) j) (RT : IMRep (univ : Set (Euclid P)) j) (flat : Covector (Euclid P) n' →L[ℝ] Covector (Euclid P) j) (ω : TestFormOn (univ : Set (Euclid P)) n'), Orthonormal ℝ g → RT.Represents T → Continuous (fun t => currentEval T (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y)))) ∧ (∀ E : Set (Euclid P), MeasurableSet E → E ⊆ (Submodule.span ℝ (Set.range g) : Set (Euclid P)) → Bornology.IsBounded E → IntegrableOn (fun t => currentEval T (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y)))) E μHE[k]) ∧ (RT.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → ∀ E : Set (Euclid P), MeasurableSet E → E ⊆ (Submodule.span ℝ (Set.range g) : Set (Euclid P)) → IntegrableOn (fun t => currentEval T (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y)))) E μHE[k]) := by
  intro P k j n' g T RT flat ω hg hRT
  -- Step 1: `η = Φ ∘ ω` is continuous with compact support
  have hω : IsTestForm (ω : DifferentialForm (Euclid P) n') := ω.2.1
  have hωs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (ω : DifferentialForm (Euclid P) n') := hω.1
  set η : DifferentialForm (Euclid P) j := fun z => flat ((ω : DifferentialForm (Euclid P) n') z)
  have hηc : Continuous η := flat.continuous.comp hωs.continuous
  have hηs : HasCompactSupport η := hω.2.comp_left flat.map_zero
  -- Step 2: `F(t) = T(η(t + ·)) = τ(M, θ, ξ)(η(t + ·))`, as `η(t + ·)` is a test form
  have hF : (fun t => currentEval T (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y))))
      = fun t => RT.action (fun y => η (t + y)) := by
    funext t
    have hmem : IsTestForm (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y))) ∧
        tsupport (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y))) ⊆ univ :=
      ⟨((Submission.dimred_cs_sos_mt_interior_product P).2 n' j flat ω t hω).1, subset_univ _⟩
    rw [currentEval, dite_eq_left hmem]
    exact hRT _
  rw [hF]
  -- Step 3 (i): continuity of translates
  have hcont : Continuous fun t => RT.action (fun y => η (t + y)) :=
    Submission.dimred_cs_sos_mt_si_translate_action_continuous P j RT η hηc hηs
  -- Step 4 (ii): `F` is bounded on the compact closure of `E`, and `Hᵏ(E) < ∞`
  have hii : ∀ E : Set (Euclid P), MeasurableSet E →
      E ⊆ (Submodule.span ℝ (Set.range g) : Set (Euclid P)) → Bornology.IsBounded E →
      IntegrableOn (fun t => RT.action (fun y => η (t + y))) E μHE[k] := by
    intro E hEm hEG hEb
    obtain ⟨C, hC⟩ := hEb.isCompact_closure.exists_bound_of_continuousOn hcont.continuousOn
    refine Measure.integrableOn_of_bounded (M := C)
      (Submission.dimred_cs_sos_mt_si_span_bounded_measure_ne_top P k g hg E hEG hEb)
      hcont.aestronglyMeasurable ?_
    filter_upwards [ae_restrict_mem hEm] with t ht
    exact hC t (subset_closure ht)
  refine ⟨hcont, hii, fun hconc E hEm hEG => ?_⟩
  -- Step 5 (iii): `F = 0` on `G \ K`, so integrability on `E` reduces to the bounded `E ∩ K`
  obtain ⟨K, hK, hK0⟩ := Submission.dimred_cs_sos_mt_si_translate_action_eq_zero_of_concentrated
    P j (Submodule.span ℝ (Set.range g)) RT η hηs hconc
  refine IntegrableOn.of_forall_sdiff_eq_zero
    (hii (E ∩ K) (hEm.inter hK.isClosed.measurableSet) (inter_subset_left.trans hEG)
      (hK.isBounded.subset inter_subset_right)) hEm ?_
  rintro t ⟨htE, htEK⟩
  exact hK0 t (hEG htE) fun htK => htEK ⟨htE, htK⟩
/-- **Outer bound on a compact set** (Simon 7.2.4, proof: (F4) and step 8).  Let `U ⊆ ℝᴾ` be
open, `E ⊆ U` compact, `ν(K) < ∞` for compact `K ⊆ U`, and `μ(G) ≤ ν(G) + c` for every open
`G ⊇ E` with `G ⊂⊂ U`.  Then `μ(E) ≤ ν(E) + c`.  Choose `δ > 0` with `{dist(·, E) ≤ δ} ⊆ U`; the
open thickenings `G_k = {dist(·, E) < δ/(k + 2)}` contain `E`, are compactly contained in `U` and
decrease to `closure E = E`, and `ν(G₀) < ∞`, so `ν(G_k) → ν(E)` by continuity from above and
`μ(E) ≤ μ(G_k) ≤ ν(G_k) + c` passes to the limit. -/
theorem Submission.lcmp_measure_le_add_of_open_nhds : ∀ (P : ℕ) (U E : Set (Euclid P)) (μ ν : Measure (Euclid P)) (c : ℝ≥0∞), IsOpen U → IsCompact E → E ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ν K < ∞) → (∀ G : Set (Euclid P), IsOpen G → E ⊆ G → CompactlyContained G U → μ G ≤ ν G + c) → μ E ≤ ν E + c := by
  intro P U E μ ν c hU hE hEU hν hG
  -- Step 1: `cthickening δ E ⊆ U`; the radii `r k = δ/(k + 2) ∈ (0, δ]` decrease
  obtain ⟨δ, hδ, hδU⟩ := hE.exists_cthickening_subset_open hU hEU
  set r : ℕ → ℝ := fun k => δ / ((k : ℝ) + 2) with hr
  have hrpos : ∀ k, 0 < r k := fun k => div_pos hδ (by positivity)
  have hrle : ∀ k, r k ≤ δ := fun k =>
    div_le_self hδ.le (by have : (0 : ℝ) ≤ k := Nat.cast_nonneg k; linarith)
  have hranti : Antitone r := fun a b hab =>
    div_le_div_of_nonneg_left hδ.le (by positivity) (by
      have : (a : ℝ) ≤ b := Nat.cast_le.2 hab
      linarith)
  -- Step 2: `G k = thickening (r k) E` is open, contains `E`, and has compact closure
  -- `⊆ cthickening δ E ⊆ U`; so `μ(E) ≤ μ(G k) ≤ ν(G k) + c`
  set G : ℕ → Set (Euclid P) := fun k => thickening (r k) E
  have hGo : ∀ k, IsOpen (G k) := fun k => isOpen_thickening
  have hEG : ∀ k, E ⊆ G k := fun k => self_subset_thickening (hrpos k) E
  have hclG : ∀ k, closure (G k) ⊆ cthickening δ E := fun k =>
    (closure_thickening_subset_cthickening _ _).trans (cthickening_mono (hrle k) E)
  have hGcc : ∀ k, CompactlyContained (G k) U := fun k =>
    ⟨hE.cthickening.of_isClosed_subset isClosed_closure (hclG k), (hclG k).trans hδU⟩
  have hle : ∀ k, μ E ≤ ν (G k) + c := fun k =>
    (measure_mono (hEG k)).trans (hG _ (hGo k) (hEG k) (hGcc k))
  -- Step 3: `G k` decreases to `closure E = E`, and `ν(G 0) ≤ ν(cthickening δ E) < ∞`
  have hanti : Antitone G := fun a b hab => thickening_mono (hranti hab) E
  have hinter : ⋂ k, G k = E := by
    apply subset_antisymm
    · intro x hx
      rw [mem_iInter] at hx
      have hxcl : x ∈ closure E := by
        rw [closure_eq_iInter_thickening]
        simp only [mem_iInter]
        intro ε hε
        obtain ⟨k, hk⟩ := exists_nat_gt (δ / ε)
        have hrk : r k < ε := by
          rw [hr, div_lt_iff₀ (by positivity)]
          rw [div_lt_iff₀ hε] at hk
          nlinarith
        exact thickening_mono hrk.le E (hx k)
      rwa [hE.isClosed.closure_eq] at hxcl
    · exact subset_iInter hEG
  have hfin0 : ν (G 0) ≠ ∞ :=
    ((measure_mono ((subset_closure).trans (hclG 0))).trans_lt
      (hν _ hE.cthickening hδU)).ne
  -- Step 4: continuity from above gives `ν(G k) + c → ν(E) + c`; pass to the limit
  have htend : Tendsto (fun k => ν (G k)) atTop (𝓝 (ν E)) := by
    have := tendsto_measure_iInter_atTop (μ := ν)
      (fun k => (hGo k).measurableSet.nullMeasurableSet) hanti ⟨0, hfin0⟩
    rwa [hinter] at this
  exact ge_of_tendsto' (htend.add_const c) hle
/-- **A cycle supported in `A ∩ W` gives an admissible competitor** (Simon 7.1.1; 7.2.4 and
Remark 7.2.5(2)).  Let `U` be open, `T ∈ 𝒟ₙ(U)` (`n = m + 1`) minimizing in `A`, `W ⊂⊂ U` open,
and `X ∈ 𝒟ₙ(ℝᴾ)` integer multiplicity with `∂X = 0` and `spt X` a compact subset of `A ∩ W`.  If
`Z₁(ω) = T(ω) + X(ω)` for `ω ∈ 𝒟ⁿ(U)`, then `M_W(T) ≤ M_W(Z₁)`.  `Z₁ = T − ((X|_U − X|_U) − X|_U)`
is integer multiplicity, and `∂Z₁ = ∂T + ∂X = ∂T`.  As `(Z₁ − T)(ω) = X(ω)`, each point of `U`
outside `spt X` has a small neighbourhood, compactly contained in `U`, on which `Z₁ − T`
vanishes.  So `spt(Z₁ − T) ⊆ spt X ⊆ A ∩ W`, and `spt(Z₁ − T) = spt X ∖ Z_{Z₁−T}` is compact. -/
theorem Submission.dimred_mbl_lc_rc_cycle_competitor : ∀ (P m : ℕ) (U A W : Set (Euclid P)) (T Z₁ : GeometricCurrentOn U (m + 1)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsOpen U → IsMinimizingIn T A → IsOpen W → CompactlyContained W U → IsIntegerMultiplicity X → X.boundary = 0 → IsCompact X.support → X.support ⊆ A ∩ W → (∀ ω : TestFormOn U (m + 1), Z₁ ω = T ω + X (testFormOnInclusion (subset_univ U) (m + 1) ω)) → T.massOn W ≤ Z₁.massOn W := by
  intro P m U A W T Z₁ X hU hT hW hWU hXim hXb hXc hXA hZ
  obtain ⟨hTim, hmin⟩ := hT
  -- Step 1: `X|_U` is integer multiplicity (RO), hence so is `Z₁ = T − ((X|_U − X|_U) − X|_U)`
  set XU : GeometricCurrentOn U (m + 1) := X.restrictDomain (subset_univ U) with hXU
  have hXUim : IsIntegerMultiplicity XU :=
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 1) univ U (subset_univ U) X hU hXim
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) U
  have hZeq : T - ((XU - XU) - XU) = Z₁ := by
    ext ω
    show T ω - ((XU ω - XU ω) - XU ω) = Z₁ ω
    rw [hZ ω, hXU, GeometricCurrentOn.restrictDomain_apply]
    ring
  have hZim : IsIntegerMultiplicity Z₁ :=
    hZeq ▸ hsub T _ hU hTim (hsub _ XU hU (hsub XU XU hU hXUim hXUim) hXUim)
  -- Step 2: `∂Z₁(η) = T(dη) + X(dη) = ∂T(η) + ∂X(η) = ∂T(η)`
  have hbd : SameBoundary Z₁ T := by
    show Z₁.boundary = T.boundary
    ext η
    have hd : testFormOnInclusion (subset_univ U) (m + 1) (exteriorDerivativeTestOn U m η) =
        exteriorDerivativeTestOn univ m (testFormOnInclusion (subset_univ U) m η) := rfl
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, hZ, hd,
      ← X.boundary_apply, hXb, GeometricCurrentOn.zero_apply, add_zero]
  -- Step 3: `(Z₁ − T)(ω) = X(ω)`, so `spt(Z₁ − T) ⊆ spt X`
  have hspt : (Z₁ - T).support ⊆ X.support := by
    rintro x ⟨hxU, hxZ⟩
    refine ⟨mem_univ x, fun hxX => hxZ ?_⟩
    obtain ⟨V, ⟨hVo, -, -, hVX⟩, hxV⟩ := mem_sUnion.1 hxX
    obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hU x hxU
    have hcl : closure (V ∩ ball x (r / 2)) ⊆ closedBall x (r / 2) :=
      (closure_mono inter_subset_right).trans closure_ball_subset_closedBall
    refine mem_sUnion.2 ⟨V ∩ ball x (r / 2), ⟨hVo.inter isOpen_ball,
      (isCompact_closedBall x (r / 2)).of_isClosed_subset isClosed_closure hcl,
      hcl.trans ((closedBall_subset_ball (half_lt_self hr)).trans hrU), fun ω hω => ?_⟩,
      hxV, mem_ball_self (half_pos hr)⟩
    show Z₁ ω - T ω = 0
    rw [hZ ω, hVX (testFormOnInclusion (subset_univ U) (m + 1) ω) (hω.trans inter_subset_left),
      add_zero, sub_self]
  -- Step 4: `spt(Z₁ − T) = spt X ∖ Z_{Z₁−T}` is compact, as `spt X ⊆ W ⊆ closure W ⊆ U`
  have hcpt : IsCompact (Z₁ - T).support := by
    have heq : (Z₁ - T).support = X.support ∩ ((Z₁ - T).zeroRegion)ᶜ :=
      Subset.antisymm (fun x hx => ⟨hspt hx, hx.2⟩)
        fun x hx => ⟨hWU.2 (subset_closure (hXA hx.1).2), hx.2⟩
    rw [heq]
    exact hXc.inter_right (Z₁ - T).isOpen_zeroRegion.isClosed_compl
  -- Step 5: minimality of `T` against the competitor `Z₁` in `W`
  exact hmin W Z₁ hW hWU hZim hbd hcpt (hspt.trans hXA)

/-- **Mass of the split competitor** (Simon, Ch. 7, Lemma 3.5).  Let `G = span g` for an
orthonormal frame `g` and `Q_r = {t ∈ G : |⟨gᵢ, t⟩| ≤ r ∀ i}`.  On test forms, through the
interior product `♭` with `g`, let `S = [[G]] × S₀`, `Z = [[Q_r]] × (S₀' − S₀) + E'`,
`A₁ = [[G \ Q_r]] × S₀` and `A₂ = [[Q_r]] × S₀'`, where `S₀ = τ(R₀)` and `S₀' = τ(R₀')` are
carried by `Gᗮ`, and let `S' = S + Z`.  Fix a continuous linear `♭` by
`Submission.dimred_cs_sos_mt_interior_product` (a).  The slices `t ↦ S₀(♭ω(t + ·))` and
`t ↦ S₀'(♭ω(t + ·))` are `Hᵏ`-integrable on `G` and on the closed `Q_r ⊆ G`
(`Submission.dimred_cs_sos_mt_slice_integrable` (iii)), so `∫_G − ∫_{Q_r} = ∫_{G \ Q_r}` gives
`S' = A₁ + (A₂ + E')`.  Two applications of `Submission.lcmp_massOn_le_add_of_eval_eq`, through
`T₂ = A₂ + E'`, and `M_W(E') ≤ M(E')` give `M_W(S') ≤ M_W(A₁) + M_W(A₂) + M(E')`. -/
theorem Submission.dimred_cs_sos_mt_cm_split_mass : ∀ (P k m n : ℕ) (g : Fin k → Euclid P) (h : n = k + m) (S₀ S₀' : GeometricCurrentOn (univ : Set (Euclid P)) m) (R₀ R₀' : IMRep (univ : Set (Euclid P)) m) (S Z E' A₁ A₂ S' : GeometricCurrentOn (univ : Set (Euclid P)) n) (r : ℝ) (W : Set (Euclid P)), Orthonormal ℝ g → R₀.Represents S₀ → R₀'.Represents S₀' → R₀.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → R₀'.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) m, (∀ (α : Covector (Euclid P) n) (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, S ω = ∫ t in (Submodule.span ℝ (Set.range g) : Set (Euclid P)), currentEval S₀ (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[k]) → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) m, (∀ (α : Covector (Euclid P) n) (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, Z ω = (∫ t in {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, currentEval (S₀' - S₀) (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[k]) + E' ω) → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) m, (∀ (α : Covector (Euclid P) n) (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, A₁ ω = ∫ t in (Submodule.span ℝ (Set.range g) : Set (Euclid P)) \ {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, currentEval S₀ (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[k]) → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) m, (∀ (α : Covector (Euclid P) n) (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, A₂ ω = ∫ t in {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, currentEval S₀' (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[k]) → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, S' ω = S ω + Z ω) → S'.massOn W ≤ A₁.massOn W + A₂.massOn W + E'.mass := by
  intro P k m n g h S₀ S₀' R₀ R₀' S Z E' A₁ A₂ S' r W hg hR₀ hR₀' hR₀c hR₀'c hSf hZf hA₁f hA₂f hS'
  -- Step 1: a continuous linear interior product `♭` with the frame `g`
  obtain ⟨flatL, hflatL⟩ := (Submission.dimred_cs_sos_mt_interior_product P).1 k m n g h
  -- Step 2: `G` and `Q_r ⊆ G` are closed, hence Borel
  have hGc : IsClosed ((Submodule.span ℝ (Set.range g) : Set (Euclid P))) :=
    Submodule.closed_of_finiteDimensional _
  have hQc : IsClosed
      {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} := by
    have hset : {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} =
        (Submodule.span ℝ (Set.range g) : Set (Euclid P)) ∩ ⋂ i, {t | |inner ℝ (g i) t| ≤ r} := by
      ext t; simp
    rw [hset]
    exact hGc.inter (isClosed_iInter fun i =>
      isClosed_le (continuous_const.inner continuous_id).abs continuous_const)
  have hQG : {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} ⊆
      (Submodule.span ℝ (Set.range g) : Set (Euclid P)) := fun t ht => ht.1
  -- Step 3: `currentEval (S₀' − S₀) = currentEval S₀' − currentEval S₀`
  have hdiff : ∀ φ : DifferentialForm (Euclid P) m,
      currentEval (S₀' - S₀) φ = currentEval S₀' φ - currentEval S₀ φ := by
    intro φ
    unfold currentEval
    split_ifs with hφ
    · rfl
    · simp
  -- Steps 4–5: the slices are integrable on `G` and `Q_r`, so `S' = A₁ + (A₂ + E')`
  have hact : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, S' ω = A₁ ω + (A₂ ω + E' ω) := by
    intro ω
    have hint := Submission.dimred_cs_sos_mt_slice_integrable P k m n g S₀ R₀ flatL ω hg hR₀
    have hint' := Submission.dimred_cs_sos_mt_slice_integrable P k m n g S₀' R₀' flatL ω hg hR₀'
    have hIG := hint.2.2 hR₀c _ hGc.measurableSet subset_rfl
    have hIQ := hint.2.2 hR₀c _ hQc.measurableSet hQG
    have hIQ' := hint'.2.2 hR₀'c _ hQc.measurableSet hQG
    rw [hS' ω, hSf flatL hflatL ω, hZf flatL hflatL ω, hA₁f flatL hflatL ω, hA₂f flatL hflatL ω]
    simp_rw [hdiff]
    rw [integral_sub hIQ' hIQ, setIntegral_sdiff hQc.measurableSet hIG hQG]
    ring
  -- Step 6: the current `T₂ = A₂ − (0 − E') = A₂ + E'`
  let T₂ : GeometricCurrentOn (univ : Set (Euclid P)) n := A₂ - (0 - E')
  have hT₂ : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, T₂ ω = A₂ ω + E' ω := by
    intro ω
    show A₂ ω - ((0 : GeometricCurrentOn (univ : Set (Euclid P)) n) ω - E' ω) = A₂ ω + E' ω
    rw [GeometricCurrentOn.zero_apply]; ring
  -- Step 7: two triangle inequalities with `c = 1`, and `M_W(E') ≤ M(E')`
  have h1 : S'.massOn W ≤ A₁.massOn W + T₂.massOn W :=
    Submission.lcmp_massOn_le_add_of_eval_eq P n univ W A₁ T₂ S' 1 (by simp)
      (fun ω _ => by rw [hact ω, hT₂ ω, one_mul])
  have h2 : T₂.massOn W ≤ A₂.massOn W + E'.massOn W :=
    Submission.lcmp_massOn_le_add_of_eval_eq P n univ W A₂ E' T₂ 1 (by simp)
      (fun ω _ => by rw [hT₂ ω, one_mul])
  have h3 : E'.massOn W ≤ E'.mass := E'.massOn_mono (subset_univ W)
  -- Step 8: combine the three bounds
  calc S'.massOn W ≤ A₁.massOn W + T₂.massOn W := h1
    _ ≤ A₁.massOn W + (A₂.massOn W + E'.mass) := by
      gcongr
      exact h2.trans (by gcongr)
    _ = A₁.massOn W + A₂.massOn W + E'.mass := by rw [add_assoc]
/-- Measure comparison in the minimality transfer of **Simon Lemma 7.3.5**.  Let `Sᵢ = τ(Rᵢ)` in
`ℝᴾ` with weights `μᵢ = θᵢ Hʲ⌞Mᵢ` (`i = 1, 2`), and let `W₀ ⊆ B` be open with
`K = spt(S₁ − S₂) ⊆ W₀`.  Then `μ₁(B) + μ₂(W₀) = μ₂(B) + μ₁(W₀)` in `[0, ∞]`.  `S₁ − S₂` is integer
multiplicity (`rsd_isIntegerMultiplicity_int_combination`), say `S₁ − S₂ = τ(M, θ, ξ)`, and
`Hʲ(M ∖ K) = 0` (`imrep_carrier_sdiff_support_null`).  If `spt ω ∩ K = ∅`, the integrand
`θ⟨ω, ξ⟩` vanishes on `K`, so `S₁(ω) = S₂(ω)`.  Hence `M_O(S₁) = M_O(S₂)`, i.e. `μ₁(O) = μ₂(O)`
(`imrep_represents_massOn_eq_measure`), for every open `O` disjoint from the closed set `K`.  Apply
this to `B ∖ K` and `W₀ ∖ K`, and split `B` and `W₀` at the Borel set `K`. -/
theorem Submission.dimred_cs_sos_mt_measure_comparison : ∀ (P j : ℕ) (S₁ S₂ : GeometricCurrentOn (univ : Set (Euclid P)) j) (R₁ R₂ : IMRep (univ : Set (Euclid P)) j) (W₀ B : Set (Euclid P)), R₁.Represents S₁ → R₂.Represents S₂ → IsOpen W₀ → IsOpen B → (S₁ - S₂).support ⊆ W₀ → W₀ ⊆ B → R₁.measure B + R₂.measure W₀ = R₂.measure B + R₁.measure W₀ := by
  intro P j S₁ S₂ R₁ R₂ W₀ B hR₁ hR₂ hW₀ hB hKW hWB
  -- `K = spt(S₁ − S₂) = ℝᴾ ∖ Z` is closed, `Z` being the open zero region
  set K := (S₁ - S₂).support
  have hKc : IsClosed K := isClosed_univ.sdiff (S₁ - S₂).isOpen_zeroRegion
  -- `S₁ − S₂ = 1·S₁ + (−1)·S₂` is integer multiplicity; let `R = (M, θ, ξ)` represent it
  have hsub : ∀ ω : TestFormOn (univ : Set (Euclid P)) j, (S₁ - S₂) ω = S₁ ω - S₂ ω :=
    fun ω => LinearMap.sub_apply _ _ ω
  obtain ⟨R, hR⟩ : IsIntegerMultiplicity (S₁ - S₂) :=
    Submission.rsd_isIntegerMultiplicity_int_combination P j univ S₁ S₂ (S₁ - S₂) 1 (-1)
      isOpen_univ ⟨R₁, hR₁⟩ ⟨R₂, hR₂⟩ fun ω => by
        rw [hsub ω]
        push_cast
        ring
  -- `Hʲ(M ∖ K) = 0`
  have hnull := Submission.imrep_carrier_sdiff_support_null P j univ (S₁ - S₂) R isOpen_univ hR
  -- `S₁(ω) = S₂(ω)` for every test form `ω` supported off `K`: the integrand of
  -- `(S₁ − S₂)(ω) = ∫_M θ ⟨ω, ξ⟩ dHʲ` vanishes on `M ∩ K`, and `M ∖ K` is null
  have hvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) j,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) j)) K → S₁ ω = S₂ ω := by
    intro ω hω
    have h0 : (S₁ - S₂) ω = 0 := by
      rw [hR ω, IMRep.action]
      refine integral_eq_zero_of_ae ?_
      rw [EventuallyEq, ae_restrict_iff' R.measurableSet_carrier]
      filter_upwards [measure_eq_zero_iff_ae_notMem.mp hnull] with x hx hxM
      have hxK : x ∈ K := by
        by_contra hxK
        exact hx ⟨hxM, hxK⟩
      have hωx : (ω : DifferentialForm (Euclid P) j) x = 0 :=
        image_eq_zero_of_notMem_tsupport fun h => hω.notMem_of_mem_left h hxK
      simp [hωx]
    rw [hsub ω] at h0
    linarith
  -- hence `M_O(S₁) = M_O(S₂)`, i.e. `R₁.measure O = R₂.measure O`, for open `O` disjoint from `K`
  have hmeas : ∀ O : Set (Euclid P), IsOpen O → Disjoint O K → R₁.measure O = R₂.measure O := by
    intro O hO hOK
    rw [← Submission.imrep_represents_massOn_eq_measure P j univ O S₁ R₁ isOpen_univ hR₁ hO
        (subset_univ O),
      ← Submission.imrep_represents_massOn_eq_measure P j univ O S₂ R₂ isOpen_univ hR₂ hO
        (subset_univ O)]
    unfold GeometricCurrentOn.massOn
    congr 1
    refine image_congr fun ω hω => ?_
    rw [hvan ω (hOK.mono_left hω.1)]
  -- split `B` and `W₀` at the Borel set `K ⊆ W₀ ⊆ B` and compare
  have hKm : MeasurableSet K := hKc.measurableSet
  have hBK := hmeas (B \ K) (hB.sdiff hKc) disjoint_sdiff_left
  have hWK := hmeas (W₀ \ K) (hW₀.sdiff hKc) disjoint_sdiff_left
  rw [← measure_sdiff_add_inter (μ := R₁.measure) B hKm,
    ← measure_sdiff_add_inter (μ := R₂.measure) W₀ hKm,
    ← measure_sdiff_add_inter (μ := R₂.measure) B hKm,
    ← measure_sdiff_add_inter (μ := R₁.measure) W₀ hKm,
    inter_eq_right.mpr (hKW.trans hWB), inter_eq_right.mpr hKW, hBK, hWK]
  ring

/-- Box cancellation in the competitor mass bound of the minimality transfer of **Simon Lemma
7.3.5**.  Let `S₀ = τ(R₀)` and `S₀′ = τ(R₀′)` in `ℝᴾ` with weights `μ₀ = θ₀ Hᵐ⌞M₀` and `μ₀′`, let
`W₀ ⊆ B` be open with `B` bounded and `spt(S₀′ − S₀) ⊆ W₀`, and let `a, b, e ∈ [0, ∞]` with
`b ≤ a < ∞`.  If `a μ₀(B) ≤ (a − b) μ₀(B) + b μ₀′(B) + e`, then `b M_{W₀}(S₀) ≤ b M_{W₀}(S₀′) + e`.
The measure comparison (`dimred_cs_sos_mt_measure_comparison`) gives
`μ₀′(B) + μ₀(W₀) = μ₀(B) + μ₀′(W₀)`, and `M_{W₀}(S₀) = μ₀(W₀)`, `M_{W₀}(S₀′) = μ₀′(W₀)`
(`imrep_represents_massOn_eq_measure`).  `closure B` is compact, so `μ₀(B) < ∞` by the local
integrability of `θ₀`.  Adding `b μ₀(W₀)` to the hypothesis and using `(a − b) + b = a` gives
`a μ₀(B) + b μ₀(W₀) ≤ a μ₀(B) + (b μ₀′(W₀) + e)`; cancel the finite `a μ₀(B)`. -/
theorem Submission.dimred_cs_sos_mt_cm_box_cancellation : ∀ (P m : ℕ) (S₀ S₀' : GeometricCurrentOn (univ : Set (Euclid P)) m) (R₀ R₀' : IMRep (univ : Set (Euclid P)) m) (W₀ B : Set (Euclid P)) (a b e : ℝ≥0∞), R₀.Represents S₀ → R₀'.Represents S₀' → IsOpen W₀ → IsOpen B → Bornology.IsBounded B → (S₀' - S₀).support ⊆ W₀ → W₀ ⊆ B → b ≤ a → a ≠ ∞ → a * R₀.measure B ≤ (a - b) * R₀.measure B + b * R₀'.measure B + e → b * S₀.massOn W₀ ≤ b * S₀'.massOn W₀ + e := by
  intro P m S₀ S₀' R₀ R₀' W₀ B a b e hR₀ hR₀' hW₀ hB hBb hKW hWB hba ha hineq
  -- measure comparison: `μ₀′(B) + μ₀(W₀) = μ₀(B) + μ₀′(W₀)`
  have hcmp := Submission.dimred_cs_sos_mt_measure_comparison P m S₀' S₀ R₀' R₀ W₀ B hR₀' hR₀
    hW₀ hB hKW hWB
  -- `M_{W₀}(S₀) = μ₀(W₀)` and `M_{W₀}(S₀′) = μ₀′(W₀)`
  rw [Submission.imrep_represents_massOn_eq_measure P m univ W₀ S₀ R₀ isOpen_univ hR₀ hW₀
      (subset_univ W₀),
    Submission.imrep_represents_massOn_eq_measure P m univ W₀ S₀' R₀' isOpen_univ hR₀' hW₀
      (subset_univ W₀)]
  -- `μ₀(B) ≤ μ₀(closure B) = ∫_{M₀ ∩ closure B} θ₀ dHᵐ < ∞`, `closure B` being compact
  have hfin : R₀.measure B ≠ ∞ := by
    have hc : MeasurableSet (closure B) := isClosed_closure.measurableSet
    have hint := R₀.locallyIntegrable_mult (closure B) hBb.isCompact_closure (subset_univ _)
    have hcl : R₀.measure (closure B) =
        ∫⁻ x in R₀.carrier ∩ closure B, (R₀.mult x : ℝ≥0∞) ∂μHE[m] := by
      unfold IMRep.measure
      rw [withDensity_apply _ hc, Measure.restrict_restrict hc, inter_comm]
    rw [← hcl] at hint
    exact ne_top_of_le_ne_top hint (measure_mono subset_closure)
  -- add `b μ₀(W₀)` to the hypothesis and cancel the finite `a μ₀(B)`
  refine ENNReal.le_of_add_le_add_left (ENNReal.mul_ne_top ha hfin) ?_
  calc a * R₀.measure B + b * R₀.measure W₀
      ≤ (a - b) * R₀.measure B + b * R₀'.measure B + e + b * R₀.measure W₀ := by gcongr
    _ = (a - b) * R₀.measure B + b * (R₀'.measure B + R₀.measure W₀) + e := by ring
    _ = (a - b) * R₀.measure B + b * (R₀.measure B + R₀'.measure W₀) + e := by rw [hcmp]
    _ = (a - b + b) * R₀.measure B + (b * R₀'.measure W₀ + e) := by ring
    _ = a * R₀.measure B + (b * R₀'.measure W₀ + e) := by rw [tsub_add_cancel_of_le hba]
/-- **The weight of a cone is homogeneous of degree `n`** (proof of Simon 7.4.5,
chapter-07.txt lines 697–699, "by virtue of the fact that `C` is a cone").  If the cone `C` is
represented by `R = (M, θ, ξ)` with weight `μ = θHⁿ⌞M` and `λ > 0`, then `μ(λA) = λⁿ μ(A)` for
every Borel `A`.  The dilated triple `R_λ = (λ⁻¹M, θ(λ·), ξ(λ·))` is integer multiplicity, and
`R_λ(ω) = R(λ⁻ⁿ ω(λ⁻¹·)) = C(λ⁻ⁿ ω(λ⁻¹·)) = C(ω)` as `η_{0,λ#}C = C`, so `R_λ` represents `C`.
By the uniqueness of the weight (Simon Ch. 6, 3.2(3)), `μ(A) = μ_{R_λ}(A) = λ⁻ⁿ μ(λA)`. -/
theorem Submission.cone_current_imrep_measure_smul_image : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), IsConeCurrent C → R.Represents C → ∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * R.measure A := by
  intro P n C R hC hR lam hlam A hA
  -- Step 1: the dilated triple `R_λ = (λ⁻¹M, θ(λ·), ξ(λ·))` is integer multiplicity, with
  -- `R_λ(ω) = R(λ⁻ⁿ ω(λ⁻¹·))` for every form `ω` and `μ_{R_λ}(A) = λ⁻ⁿ μ(λA)` for Borel `A`
  obtain ⟨Rl, hcar, hmult, horient⟩ := Submission.imrep_univ_smul_rescale_exists P n R lam hlam
  obtain ⟨haction, hmeasure⟩ :=
    Submission.imrep_smul_rescale_action_measure P n R Rl lam hlam hcar hmult horient
  -- Step 2: `R_λ` represents `C`: `C(ω) = C(ω') = R(ω') = R_λ(ω)` for `ω' = λ⁻ⁿ ω(λ⁻¹·)`
  have hRl : Rl.Represents C := by
    intro ω
    obtain ⟨ω', hω', hCω'⟩ := Submission.cone_current_apply_dilation_pullback P n C hC lam hlam ω
    rw [← hCω', hR ω', haction]
    congr 1
    funext y
    exact hω' y
  -- Step 3: the weight does not depend on the representation, so `μ_{R_λ} = μ` and
  -- `μ(A) = λ⁻ⁿ μ(λA)`
  have hA' := hmeasure A hA
  rw [Submission.imrep_measure_eq_of_represents_same_current P n univ C Rl R isOpen_univ hRl hR]
    at hA'
  -- Step 4: multiply by `λⁿ`, using `λⁿ λ⁻ⁿ = 1`
  have hpow : ENNReal.ofReal (lam ^ n) * ENNReal.ofReal (lam⁻¹ ^ n) = 1 := by
    rw [← ENNReal.ofReal_mul (pow_nonneg hlam.le n), ← mul_pow, mul_inv_cancel₀ hlam.ne', one_pow,
      ENNReal.ofReal_one]
  rw [hA', ← mul_assoc, hpow, one_mul]
/-- **The tangential rotation ratio of an integer multiplicity triple is measurable**
(Simon 7.3.3, proof; Ch. 6, 3.1).  For `R = (M, θ, ξ)` with weight `μ = θ Hⁿ⌞M`, a subspace `Q`
with projection `π` and `A x = ⟨x, a⟩ e − ⟨x, e⟩ a`, the ratio `|p_{TₓM}(A x)|² / |π x|²` is
`μ`-a.e. strongly measurable: `x ↦ p_{TₓM}` is `Hⁿ⌞M`-a.e. strongly measurable, hence
`μ`-a.e. strongly measurable as `μ ≪ Hⁿ⌞M`; evaluation at the continuous field `A` is continuous
bilinear, `|π x|²` is continuous, and real division (`t / 0 = 0`) is measurable. -/
theorem Submission.idtp_cse_fd_fs_frame_ratio_aesm : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), AEStronglyMeasurable (fun x : Euclid P => ‖(approxTangentPlane n R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) R.measure := by
  intro P n U R Q a e
  -- `x ↦ p_{TₓM}` is `μ`-a.e. strongly measurable, since `μ = (Hⁿ⌞M).withDensity θ ≪ Hⁿ⌞M`
  have hT : AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection)
      R.measure :=
    (Submission.imrep_approxTangent_starProjection_aesm P n U R).mono_ac
      (withDensity_absolutelyContinuous _ _)
  -- evaluation `(L, v) ↦ L v` at the continuous field `A x = ⟨x, a⟩ e − ⟨x, e⟩ a`
  have hA : Continuous fun x : Euclid P => inner ℝ x a • e - inner ℝ x e • a := by fun_prop
  have hN : AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection
      (inner ℝ x a • e - inner ℝ x e • a)) R.measure :=
    (ContinuousLinearMap.id ℝ (Euclid P →L[ℝ] Euclid P)).aestronglyMeasurable_comp₂ hT
      hA.aestronglyMeasurable
  -- the denominator `|π x|²` is continuous, and real division is measurable
  have hD : Continuous fun x : Euclid P => ‖Q.starProjection x‖ ^ 2 := by fun_prop
  exact (hN.norm.fun_pow 2).aemeasurable.fun_div hD.measurable.aemeasurable |>.aestronglyMeasurable
/-- **Transfer of a push-forward density identity.**  Let `ν` be a finite measure on `X`,
`φ : X → ℝ²` measurable, `g` `ν`-a.e. strongly measurable with `0 ≤ g ≤ 1` `ν`-a.e., and
`H : ℝ² → [0, ∞]` a.e.-measurable with `∫ b H dp = ∫ (b ∘ φ) g dν` for every Borel `b ≥ 0`.  Then
`H < ∞` a.e., `H` is integrable, `∫ b H dp = ∫ (b ∘ φ) g dν` for every bounded Borel
`b : ℝ² → ℝ`, and `∫_S H dp = ∫_{φ⁻¹(S)} g dν` for every Borel `S`.  Taking `b ≡ 1` gives
`∫ H dp ≤ ν(X) < ∞`; for a Borel `0 ≤ β ≤ M` both sides are integrable and their lower integrals
agree (`b = ofReal ∘ β`); a bounded `b` is `max(b, 0) − max(−b, 0)`; and `b = 1_S` gives the set
identity. -/
theorem Submission.idtp_cse_fd_fs_pushforward_signed_transfer : ∀ (X : Type) [MeasurableSpace X] (ν : Measure X) (φ : X → ℝ × ℝ) (g : X → ℝ) (H : ℝ × ℝ → ℝ≥0∞), ν univ ≠ ∞ → Measurable φ → AEStronglyMeasurable g ν → (∀ᵐ x ∂ν, 0 ≤ g x ∧ g x ≤ 1) → AEMeasurable H volume → (∀ b : ℝ × ℝ → ℝ≥0∞, Measurable b → ∫⁻ p : ℝ × ℝ, b p * H p = ∫⁻ x, b (φ x) * ENNReal.ofReal (g x) ∂ν) → (∀ᵐ p : ℝ × ℝ, H p ≠ ∞) ∧ Integrable (fun p : ℝ × ℝ => (H p).toReal) ∧ (∀ b : ℝ × ℝ → ℝ, Measurable b → (∃ M : ℝ, ∀ p, |b p| ≤ M) → ∫ p : ℝ × ℝ, b p * (H p).toReal = ∫ x, b (φ x) * g x ∂ν) ∧ ∀ S : Set (ℝ × ℝ), MeasurableSet S → ∫⁻ p in S, H p = ∫⁻ x in φ ⁻¹' S, ENNReal.ofReal (g x) ∂ν := by
  intro X _ ν φ g H hν hφ hg hg01 hH htr
  have : IsFiniteMeasure ν := ⟨lt_top_iff_ne_top.mpr hν⟩
  -- the identity with `b ≡ 1`, and `∫ ofReal g dν ≤ ν(X) < ∞` since `g ≤ 1` a.e.
  have hfin : ∫⁻ p : ℝ × ℝ, H p ≠ ∞ := by
    have h1 := htr (fun _ => 1) measurable_const
    simp only [one_mul] at h1
    rw [h1]
    refine ne_top_of_le_ne_top hν ?_
    calc ∫⁻ x, ENNReal.ofReal (g x) ∂ν ≤ ∫⁻ _, 1 ∂ν :=
          lintegral_mono_ae (hg01.mono fun x hx => ENNReal.ofReal_le_one.mpr hx.2)
      _ = ν univ := lintegral_one
  -- (i) and (ii)
  have hi : ∀ᵐ p : ℝ × ℝ, H p ≠ ∞ := (ae_lt_top' hH hfin).mono fun p hp => hp.ne
  have hii : Integrable (fun p : ℝ × ℝ => (H p).toReal) :=
    integrable_toReal_of_lintegral_ne_top hH hfin
  -- the signed identity for a Borel `β` with `0 ≤ β ≤ M`, via lower integrals
  have hpos : ∀ β : ℝ × ℝ → ℝ, Measurable β → ∀ M : ℝ, (∀ p, 0 ≤ β p ∧ β p ≤ M) →
      Integrable (fun p => β p * (H p).toReal) ∧ Integrable (fun x => β (φ x) * g x) ν ∧
      ∫ p : ℝ × ℝ, β p * (H p).toReal = ∫ x, β (φ x) * g x ∂ν := by
    intro β hβ M hβM
    have hint1 : Integrable (fun p => β p * (H p).toReal) :=
      hii.bdd_mul hβ.aestronglyMeasurable (Eventually.of_forall fun p => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hβM p).1]
        exact (hβM p).2)
    have hint2 : Integrable (fun x => β (φ x) * g x) ν := by
      refine Integrable.of_bound ((hβ.comp hφ).aestronglyMeasurable.mul hg) M ?_
      filter_upwards [hg01] with x hx
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (hβM (φ x)).1 hx.1)]
      calc β (φ x) * g x ≤ M * 1 :=
            mul_le_mul (hβM (φ x)).2 hx.2 hx.1 ((hβM (φ x)).1.trans (hβM (φ x)).2)
        _ = M := mul_one M
    refine ⟨hint1, hint2, ?_⟩
    rw [integral_eq_lintegral_of_nonneg_ae
        (Eventually.of_forall fun p => mul_nonneg (hβM p).1 ENNReal.toReal_nonneg)
        hint1.aestronglyMeasurable,
      integral_eq_lintegral_of_nonneg_ae (hg01.mono fun x hx => mul_nonneg (hβM (φ x)).1 hx.1)
        hint2.aestronglyMeasurable]
    congr 1
    calc ∫⁻ p, ENNReal.ofReal (β p * (H p).toReal)
        = ∫⁻ p, ENNReal.ofReal (β p) * H p := by
          refine lintegral_congr_ae ?_
          filter_upwards [hi] with p hp
          rw [ENNReal.ofReal_mul (hβM p).1, ENNReal.ofReal_toReal hp]
      _ = ∫⁻ x, ENNReal.ofReal (β (φ x)) * ENNReal.ofReal (g x) ∂ν :=
          htr (fun p => ENNReal.ofReal (β p)) (ENNReal.measurable_ofReal.comp hβ)
      _ = ∫⁻ x, ENNReal.ofReal (β (φ x) * g x) ∂ν := by
          refine lintegral_congr fun x => ?_
          rw [ENNReal.ofReal_mul (hβM (φ x)).1]
  refine ⟨hi, hii, ?_, ?_⟩
  · -- (iii): split `b = max b 0 - max (-b) 0`
    rintro b hb ⟨M, hM⟩
    have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
    obtain ⟨i1, i2, e1⟩ := hpos (fun p => max (b p) 0) (hb.max measurable_const) M
      fun p => ⟨le_max_right _ _, max_le ((le_abs_self _).trans (hM p)) hM0⟩
    obtain ⟨i3, i4, e2⟩ := hpos (fun p => max (-b p) 0) (hb.neg.max measurable_const) M
      fun p => ⟨le_max_right _ _, max_le ((neg_le_abs _).trans (hM p)) hM0⟩
    calc ∫ p, b p * (H p).toReal
        = ∫ p, (max (b p) 0 * (H p).toReal - max (-b p) 0 * (H p).toReal) := by
          refine integral_congr_ae (Eventually.of_forall fun p => ?_)
          dsimp only
          rw [← sub_mul, max_zero_sub_eq_self]
      _ = (∫ p, max (b p) 0 * (H p).toReal) - ∫ p, max (-b p) 0 * (H p).toReal :=
          integral_sub i1 i3
      _ = (∫ x, max (b (φ x)) 0 * g x ∂ν) - ∫ x, max (-b (φ x)) 0 * g x ∂ν := by rw [e1, e2]
      _ = ∫ x, (max (b (φ x)) 0 * g x - max (-b (φ x)) 0 * g x) ∂ν := (integral_sub i2 i4).symm
      _ = ∫ x, b (φ x) * g x ∂ν := by
          refine integral_congr_ae (Eventually.of_forall fun x => ?_)
          dsimp only
          rw [← sub_mul, max_zero_sub_eq_self]
  · -- (iv): the identity with `b = 1_S`
    intro S hS
    have key := htr (S.indicator 1) (measurable_one.indicator hS)
    calc ∫⁻ p in S, H p = ∫⁻ p, S.indicator H p := (lintegral_indicator hS H).symm
      _ = ∫⁻ p, S.indicator 1 p * H p := by
          refine lintegral_congr fun p => ?_
          by_cases hp : p ∈ S <;> simp [hp]
      _ = ∫⁻ x, S.indicator 1 (φ x) * ENNReal.ofReal (g x) ∂ν := key
      _ = ∫⁻ x, (φ ⁻¹' S).indicator (fun x => ENNReal.ofReal (g x)) x ∂ν := by
          refine lintegral_congr fun x => ?_
          by_cases hx : φ x ∈ S <;> simp [hx]
      _ = ∫⁻ x in φ ⁻¹' S, ENNReal.ofReal (g x) ∂ν := lintegral_indicator (hφ hS) _

/-- **Signed fibre identity** (flux density for the cone-sector endpoint density in the proof of
Simon 7.3.3).  Let `R = (M, θ, ξ)` be a `2`-dimensional integer multiplicity triple in `ℝᴾ`,
`μ = θ H²⌞M`, `Q` a plane with orthonormal basis `a, e`, `π = Q.starProjection`,
`Ax = ⟨x, a⟩e − ⟨x, e⟩a`, `G(x) = |p_{TₓM}(Ax)|² / |πx|²`, `f(x) = arctan(⟨x, e⟩/⟨x, a⟩)`,
`F̃(x) = (|x|, f(x))` and
`Z(s, s') = {x : ⟨x, a⟩ > 0, ||x| − 1| < s', |f(x)| < s', |x − πx| < s|x|}`.  If
`∫ b H = ∫_{Z(s, s)} b(F̃) G dμ` for every Borel `b : ℝ² → [0, ∞]`, then `H < ∞` a.e., `H` is
integrable, the identity holds for bounded signed Borel `b`, and
`∫_{(1 − s', 1 + s') × (−s', s')} H = ∫_{Z(s, s')} G dμ` for `s' ≤ s`.  Self-adjointness of `π`
and Bessel's inequality for `a, e` give `|p_T(Ax)|² ≤ |Ax|² ≤ |πx|²`, so `0 ≤ G ≤ 1`
(`t / 0 = 0`); `Z(s, s) ⊆ B̄_{1+|s|}(0)` has finite `μ`-measure, so the push-forward transfer
applies to `μ⌞Z(s, s)`, and `F̃⁻¹((1 − s', 1 + s') × (−s', s')) ∩ Z(s, s) = Z(s, s')`. -/
theorem Submission.idtp_cse_fd_fibre_signed_identity : ∀ (P : ℕ) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ) (H : ℝ × ℝ → ℝ≥0∞), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → AEMeasurable H volume → (∀ b : ℝ × ℝ → ℝ≥0∞, Measurable b → ∫⁻ p : ℝ × ℝ, b p * H p = ∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, b (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) * ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) → (∀ᵐ p : ℝ × ℝ, H p ≠ ∞) ∧ Integrable (fun p : ℝ × ℝ => (H p).toReal) ∧ (∀ b : ℝ × ℝ → ℝ, Measurable b → (∃ M : ℝ, ∀ p, |b p| ≤ M) → ∫ p : ℝ × ℝ, b p * (H p).toReal = ∫ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, b (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) ∧ ∀ s' : ℝ, s' ≤ s → ∫⁻ p in Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s', H p = ∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure := by
  intro P R Q a e s H hQ haQ heQ ha he hae hHm hH
  -- `Z = Z(s, s)`
  set Z : Set (Euclid P) := {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧
    |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} with hZ
  -- Step 1: the frame bound `|p_T(Ax)|² ≤ |Ax|² = ⟨πx, a⟩² + ⟨πx, e⟩² ≤ |πx|²`
  have haa : inner ℝ a a = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, ha, one_pow]
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he, one_pow]
  have hea : inner ℝ e a = (0 : ℝ) := by rw [real_inner_comm, hae]
  have hframe : ∀ (T : Submodule ℝ (Euclid P)) (x : Euclid P),
      ‖T.starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 ≤ ‖Q.starProjection x‖ ^ 2 := by
    intro T x
    -- `π` is self-adjoint and fixes `a, e ∈ Q`
    have hya : inner ℝ (Q.starProjection x) a = inner ℝ x a := by
      rw [Submodule.inner_starProjection_left_eq_right,
        Submodule.starProjection_eq_self_iff.2 haQ]
    have hye : inner ℝ (Q.starProjection x) e = inner ℝ x e := by
      rw [Submodule.inner_starProjection_left_eq_right,
        Submodule.starProjection_eq_self_iff.2 heQ]
    have hA : ∀ u v : ℝ, ‖u • e - v • a‖ ^ 2 = u ^ 2 + v ^ 2 := by
      intro u v
      rw [← real_inner_self_eq_norm_sq]
      simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right,
        haa, hee, hae, hea]
      ring
    -- Bessel: `0 ≤ |y − ⟨y, a⟩a − ⟨y, e⟩e|² = |y|² − ⟨y, a⟩² − ⟨y, e⟩²`
    have hB : ∀ y : Euclid P, inner ℝ y a ^ 2 + inner ℝ y e ^ 2 ≤ ‖y‖ ^ 2 := by
      intro y
      have h : ‖y - (inner ℝ y a • a + inner ℝ y e • e)‖ ^ 2 =
          ‖y‖ ^ 2 - (inner ℝ y a ^ 2 + inner ℝ y e ^ 2) := by
        rw [← real_inner_self_eq_norm_sq, ← real_inner_self_eq_norm_sq y]
        simp only [inner_sub_left, inner_sub_right, inner_add_left, inner_add_right,
          real_inner_smul_left, real_inner_smul_right, haa, hee, hae, hea, real_inner_comm y a,
          real_inner_comm y e]
        ring
      rw [← sub_nonneg, ← h]
      positivity
    calc ‖T.starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2
        ≤ ‖inner ℝ x a • e - inner ℝ x e • a‖ ^ 2 := by
          gcongr
          exact T.norm_starProjection_apply_le _
      _ = inner ℝ (Q.starProjection x) a ^ 2 + inner ℝ (Q.starProjection x) e ^ 2 := by
          rw [hA, hya, hye]
      _ ≤ ‖Q.starProjection x‖ ^ 2 := hB _
  -- Step 2: `F̃ = (|·|, f)` is Borel
  have hφ : Measurable fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) :=
    continuous_norm.measurable.prodMk (Real.continuous_arctan.measurable.comp
      ((continuous_id.inner continuous_const).measurable.div
        (continuous_id.inner continuous_const).measurable))
  -- Step 3: `Z ⊆ B̄_{1+|s|}(0)`, so `μ(Z) < ∞` by local integrability of `θ`
  have hZK : Z ⊆ closedBall (0 : Euclid P) (1 + |s|) := by
    intro x hx
    rw [mem_closedBall_zero_iff]
    have h1 := le_abs_self (‖x‖ - 1)
    have h2 := le_abs_self s
    have h3 := hx.2.1
    linarith
  have hfin : R.measure.restrict Z univ ≠ ∞ := by
    rw [Measure.restrict_apply_univ]
    refine ne_top_of_le_ne_top ?_ (measure_mono hZK)
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact R.locallyIntegrable_mult _ (isCompact_closedBall 0 _) (subset_univ _)
  -- Step 4: the push-forward transfer for `ν = μ⌞Z`, `φ = F̃`, `g = G` (`0 ≤ G ≤ 1`)
  obtain ⟨h1, h2, h3, h4⟩ := Submission.idtp_cse_fd_fs_pushforward_signed_transfer (Euclid P)
    (R.measure.restrict Z) (fun x => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)))
    (fun x => ‖(approxTangentPlane 2 R.carrier x).starProjection
      (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) H hfin hφ
    (Submission.idtp_cse_fd_fs_frame_ratio_aesm P 2 univ R Q a e).restrict
    (ae_of_all _ fun x => ⟨div_nonneg (sq_nonneg _) (sq_nonneg _),
      div_le_one_of_le₀ (hframe _ x) (sq_nonneg _)⟩) hHm hH
  refine ⟨h1, h2, h3, fun s' hs' => ?_⟩
  -- Step 5: `F̃⁻¹((1 − s', 1 + s') × (−s', s')) ∩ Z(s, s) = Z(s, s')` for `s' ≤ s`
  have hS : MeasurableSet (Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s') :=
    measurableSet_Ioo.prod measurableSet_Ioo
  have hset : (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹'
      (Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s') ∩ Z = {x : Euclid P | 0 < inner ℝ x a ∧
        |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧
        ‖x - Q.starProjection x‖ < s * ‖x‖} := by
    ext x
    simp only [hZ, mem_inter_iff, mem_preimage, mem_prod, mem_Ioo, mem_ofPred_eq, abs_lt]
    constructor
    · rintro ⟨⟨⟨hr₁, hr₂⟩, hf₁, hf₂⟩, hxa, -, -, hxπ⟩
      exact ⟨hxa, ⟨by linarith, by linarith⟩, ⟨hf₁, hf₂⟩, hxπ⟩
    · rintro ⟨hxa, ⟨hr₁, hr₂⟩, ⟨hf₁, hf₂⟩, hxπ⟩
      exact ⟨⟨⟨by linarith, by linarith⟩, hf₁, hf₂⟩, hxa, ⟨by linarith, by linarith⟩,
        ⟨by linarith, by linarith⟩, hxπ⟩
  rw [h4 _ hS, Measure.restrict_restrict (hφ hS), hset]

/-- **Simon 7.3.3, proof (gap in a cone sector)**: let `R = (M, θ, ξ)` represent `C ∈ 𝒟₂(ℝᴾ)`,
`μ = θH²⌞M`, `q(x) = x − π_Q x` and `f(x) = arctan(⟨x, e⟩/⟨x, a⟩)`.  Assume the localization
`Loc(s)`: for `0 < s' ≤ s`, every `x ∈ spt C` with `⟨x, a⟩ > 0`, `|‖x‖ − 1| < s'`, `|f(x)| < s'`
and `|q(x)| ≤ 2s|x|` has `|q(x)| < (s'/4)|x|` and `|x − a| < 3s'`.  Then `μ`-a.e. `x` with
`⟨x, a⟩ > 0`, `|‖x‖ − 1| < s` and `|f(x)| < s` has `|q(x)| < (s/2)|x|` or `2s|x| < |q(x)|`.
Indeed `spt C = ℝᴾ ∩ spt μ = spt μ`, which is `μ`-conull as `ℝᴾ` is second countable, hence
hereditarily Lindelöf; at `x ∈ spt C` with `|q(x)| ≤ 2s|x|`, `Loc(s)` with `s' = s` gives
`|q(x)| < (s/4)|x| ≤ (s/2)|x|`. -/
theorem Submission.idtp_cse_fd_gap_ae : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (R : IMRep (univ : Set (Euclid P)) 2) (s : ℝ), R.Represents C → 0 < s → (∀ s' : ℝ, 0 < s' → s' ≤ s → ∀ x ∈ C.support, 0 < inner ℝ x a → |‖x‖ - 1| < s' → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' → ‖x - Q.starProjection x‖ ≤ 2 * s * ‖x‖ → ‖x - Q.starProjection x‖ < s' / 4 * ‖x‖ ∧ dist x a < 3 * s') → ∀ᵐ x ∂R.measure, 0 < inner ℝ x a → |‖x‖ - 1| < s → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s → ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ 2 * s * ‖x‖ < ‖x - Q.starProjection x‖ := by
  intro P C Q a e R s hRC hs hloc
  -- `spt C = ℝᴾ ∩ spt μ = spt μ`, as `ℝᴾ` is open and `R` represents `C`
  have hspt : C.support = R.measure.support := by
    rw [Submission.imrep_represents_support_eq_inter_measure_support P 2 univ C R isOpen_univ hRC,
      univ_inter]
  -- `μ`-a.e. `x` lies in `spt μ = spt C` (`ℝᴾ` is second countable, hence hereditarily Lindelöf)
  filter_upwards [Measure.support_mem_ae (μ := R.measure)] with x hx hxa hx1 hxf
  rw [← hspt] at hx
  -- either `2s|x| < |q(x)|`, or `|q(x)| ≤ 2s|x|` and `Loc(s)` gives `|q(x)| < (s/4)|x| ≤ (s/2)|x|`
  rcases le_or_gt ‖x - Q.starProjection x‖ (2 * s * ‖x‖) with hle | hlt
  · refine Or.inl ((hloc s hs le_rfl x hx hxa hx1 hxf hle).1.trans_le ?_)
    exact mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg x)
  · exact Or.inr hlt

/-- **Integrals against the weight of a cone scale homogeneously** (scaling step 5(i) of the
flux-density argument for planar sectors of 2-dimensional minimizing cones, proof of Simon 7.3.3).
If the cone `C` is represented by `R = (M, θ, ξ)` with weight `μ = θHⁿ⌞M` and `r > 0`, then
`∫ φ(rx) dμ(x) = r⁻ⁿ ∫ φ dμ` for every `φ : ℝᴾ → ℝ`.  `S(x) = rx` is a homeomorphism, hence a
measurable embedding, and `S⁻¹(A) = r⁻¹A` with `μ(r⁻¹A) = r⁻ⁿ μ(A)` (homogeneity of the weight of
a cone) gives `S_#μ = r⁻ⁿ μ`; integrals commute with the push-forward along `S`. -/
theorem Submission.idtp_cse_fd_cone_integral_smul : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), IsConeCurrent C → R.Represents C → ∀ r : ℝ, 0 < r → ∀ φ : Euclid P → ℝ, ∫ x, φ (r • x) ∂R.measure = (r ^ n)⁻¹ * ∫ x, φ x ∂R.measure := by
  intro P n C R hC hR r hr φ
  -- Step 1: `S(x) = rx` is a homeomorphism of `ℝᴾ`, hence a measurable embedding
  have hS : MeasurableEmbedding (fun x : Euclid P => r • x) :=
    measurableEmbedding_const_smul₀ hr.ne'
  -- Step 2: `S_#μ = r⁻ⁿ μ`, as `S⁻¹(A) = r⁻¹A` and `μ(r⁻¹A) = r⁻ⁿ μ(A)` for Borel `A`
  have hmap : Measure.map (fun x : Euclid P => r • x) R.measure =
      ENNReal.ofReal (r⁻¹ ^ n) • R.measure := by
    ext A hA
    rw [Measure.map_apply hS.measurable hA, Set.preimage_smul₀ hr.ne', ← Set.image_smul,
      Submission.cone_current_imrep_measure_smul_image P n C R hC hR r⁻¹ (inv_pos.2 hr) A hA,
      Measure.smul_apply, smul_eq_mul]
  -- Step 3: change of variables, `∫ φ(rx) dμ = ∫ φ d(S_#μ) = r⁻ⁿ ∫ φ dμ`, and `r⁻¹ⁿ = (rⁿ)⁻¹`
  have h := hS.integral_map (μ := R.measure) φ
  rw [hmap, integral_smul_measure, ENNReal.toReal_ofReal (pow_nonneg (inv_nonneg.2 hr.le) n),
    smul_eq_mul, inv_pow] at h
  exact h.symm

/-- **Flux-density hypotheses (α) and (β)** (steps 4–6 of the flux-density argument for
`idtp_cse_flux_density_eq`).  Let `C` be a `2`-dimensional cone, `μ = μ_R` the weight of a
representation `R` of `C`, `f(x) = arctan(⟨x, e⟩ / ⟨x, a⟩)`, `G(x) = |p_{Tₓ}(Ax)|² / |πx|²`
and `Z` the sector `{⟨x, a⟩ > 0, ||x| − 1| < s, |f(x)| < s, |x − πx| < s|x|}`.  If the tangent
planes are dilation invariant (TS), `H` is the density of the push-forward of `G μ⌞Z` under
`x ↦ (|x|, f(x))` (SI), and the rotation conservation law (RC) holds, then
(α) `∫ ψ'(p₂) l(p₁) H(p) dp = 0`, and
(β) `∫ l(p₁ / r) ψ(p₂) H(p) dp = r² ∫ l(p₁) ψ(p₂) H(p) dp` for `|r − 1| < s / 4`.
(α) is (SI) followed by (RC).  For (β), both radial windows lie in `(1 − s, 1 + s)`, so the
`Z`-integrals are integrals over the dilation-invariant sector `Z'` obtained by dropping the
radial condition; `|ry| / r = |y|`, `f(ry) = f(y)`, `1_{Z'}(ry) = 1_{Z'}(y)` and, by (TS),
`G(ry) = G(y)` for `μ`-a.e. `y`, so the cone scaling `∫ φ(ry) dμ(y) = r⁻² ∫ φ dμ`
(`Submission.idtp_cse_fd_cone_integral_smul`) concludes. -/
theorem Submission.idtp_cse_fd_alpha_beta : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ) (H : ℝ × ℝ → ℝ), IsConeCurrent C → R.Represents C → 0 < s → s ≤ 1 / 4 → (∀ r : ℝ, 0 < r → ∀ᵐ x ∂R.measure, approxTangentPlane 2 R.carrier (r • x) = approxTangentPlane 2 R.carrier x) → (∀ b : ℝ × ℝ → ℝ, Measurable b → (∃ M : ℝ, ∀ p, |b p| ≤ M) → ∫ p : ℝ × ℝ, b p * H p = ∫ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, b (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) → (∀ ψ l : ℝ → ℝ, ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo (-s) s → tsupport l ⊆ Ioo (1 - s) (1 + s) → ∫ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure = 0) → (∀ ψ l : ℝ → ℝ, ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo (-s) s → tsupport l ⊆ Ioo (1 - s) (1 + s) → ∫ p : ℝ × ℝ, deriv ψ p.2 * l p.1 * H p = 0) ∧ (∀ (l ψ : ℝ → ℝ) (r : ℝ), ContDiff ℝ 1 l → ContDiff ℝ 1 ψ → tsupport l ⊆ Ioo (1 - s / 2) (1 + s / 2) → tsupport ψ ⊆ Ioo (-s) s → |r - 1| < s / 4 → ∫ p : ℝ × ℝ, l (p.1 / r) * ψ p.2 * H p = r ^ 2 * ∫ p : ℝ × ℝ, l p.1 * ψ p.2 * H p) := by
  intro P C R Q a e s H hC hR hs hs4 hTS hSI hRC
  -- `f(x) = arctan(⟨x, e⟩ / ⟨x, a⟩)` and `G(x) = |p_{Tₓ}(Ax)|² / |πx|²`.
  obtain ⟨f, hf⟩ : ∃ f : Euclid P → ℝ, ∀ x, Real.arctan (inner ℝ x e / inner ℝ x a) = f x :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : Euclid P → ℝ, ∀ x, ‖(approxTangentPlane 2 R.carrier x).starProjection
      (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2 = G x :=
    ⟨_, fun _ => rfl⟩
  simp only [hf, hG] at hSI hRC
  -- Step 0: continuous functions with `tsupport` in a bounded interval, and the derivatives of
  -- such `C¹` functions, are bounded; so are products of bounded functions.
  have hcpt : ∀ (g : ℝ → ℝ) (u v : ℝ), tsupport g ⊆ Ioo u v → HasCompactSupport g :=
    fun g u v hg => isCompact_Icc.of_isClosed_subset (isClosed_tsupport g)
      (hg.trans Ioo_subset_Icc_self)
  have hbdd : ∀ g : ℝ → ℝ, Continuous g → HasCompactSupport g → ∃ M : ℝ, ∀ t, |g t| ≤ M := by
    intro g hg hgc
    obtain ⟨M, hM⟩ := hg.bounded_above_of_compact_support hgc
    exact ⟨M, fun t => (Real.norm_eq_abs (g t)) ▸ hM t⟩
  have hbdd_mul : ∀ (g₁ g₂ : ℝ × ℝ → ℝ) (M₁ M₂ : ℝ), (∀ p, |g₁ p| ≤ M₁) →
      (∀ p, |g₂ p| ≤ M₂) → ∃ M : ℝ, ∀ p, |g₁ p * g₂ p| ≤ M := by
    intro g₁ g₂ M₁ M₂ h₁ h₂
    refine ⟨M₁ * M₂, fun p => ?_⟩
    rw [abs_mul]
    exact mul_le_mul (h₁ p) (h₂ p) (abs_nonneg _) ((abs_nonneg _).trans (h₁ p))
  refine ⟨fun ψ l hψ hl hψs hls => ?_, fun l ψ r hl hψ hls hψs hr => ?_⟩
  -- Step 1: (α) is (SI) applied to `b(p) = ψ'(p₂) l(p₁)`, followed by (RC).
  · obtain ⟨A, hA⟩ := hbdd (deriv ψ) (hψ.continuous_deriv le_rfl) (hcpt ψ _ _ hψs).deriv
    obtain ⟨B, hB⟩ := hbdd l hl.continuous (hcpt l _ _ hls)
    obtain ⟨M, hM⟩ := hbdd_mul (fun p => deriv ψ p.2) (fun p => l p.1) A B (fun p => hA p.2)
      (fun p => hB p.1)
    have hmeas : Measurable fun p : ℝ × ℝ => deriv ψ p.2 * l p.1 :=
      (((hψ.continuous_deriv le_rfl).comp continuous_snd).mul
        (hl.continuous.comp continuous_fst)).measurable
    exact (hSI (fun p => deriv ψ p.2 * l p.1) hmeas ⟨M, hM⟩).trans (hRC ψ l hψ hl hψs hls)
  -- Step 2: setup for (β).
  · obtain ⟨hr₁, hr₂⟩ := abs_lt.mp hr
    have hr0 : 0 < r := by linarith
    obtain ⟨A, hA⟩ := hbdd l hl.continuous (hcpt l _ _ hls)
    obtain ⟨B, hB⟩ := hbdd ψ hψ.continuous (hcpt ψ _ _ hψs)
    obtain ⟨M₁, hM₁⟩ := hbdd_mul (fun p => l (p.1 / r)) (fun p => ψ p.2) A B
      (fun p => hA _) (fun p => hB _)
    obtain ⟨M₂, hM₂⟩ := hbdd_mul (fun p => l p.1) (fun p => ψ p.2) A B
      (fun p => hA _) (fun p => hB _)
    have hmeas₁ : Measurable fun p : ℝ × ℝ => l (p.1 / r) * ψ p.2 :=
      ((hl.continuous.comp (continuous_fst.div_const r)).mul
        (hψ.continuous.comp continuous_snd)).measurable
    have hmeas₂ : Measurable fun p : ℝ × ℝ => l p.1 * ψ p.2 :=
      ((hl.continuous.comp continuous_fst).mul (hψ.continuous.comp continuous_snd)).measurable
    -- (2.1): both sides of (β) are integrals over the sector `Z`.
    have hSI₁ := hSI _ hmeas₁ ⟨M₁, hM₁⟩
    have hSI₂ := hSI _ hmeas₂ ⟨M₂, hM₂⟩
    -- The sector `Z` and the dilation-invariant sector `Z' ⊇ Z` without the radial condition.
    obtain ⟨Z, hZ⟩ : ∃ Z : Set (Euclid P), Z = {x : Euclid P | 0 < inner ℝ x a ∧
        |‖x‖ - 1| < s ∧ |f x| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} := ⟨_, rfl⟩
    obtain ⟨Z', hZ'⟩ : ∃ Z' : Set (Euclid P), Z' = {x : Euclid P | 0 < inner ℝ x a ∧
        |f x| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} := ⟨_, rfl⟩
    rw [← hZ] at hSI₁ hSI₂
    have hZ'meas : MeasurableSet Z' := by
      have hia : Measurable fun y : Euclid P => inner ℝ y a :=
        (continuous_id.inner continuous_const).measurable
      have hie : Measurable fun y : Euclid P => inner ℝ y e :=
        (continuous_id.inner continuous_const).measurable
      have hfm : Measurable fun y => |f y| := by
        simp only [← hf]
        exact continuous_abs.measurable.comp (Real.continuous_arctan.measurable.comp (hie.div hia))
      have hq : Measurable fun y : Euclid P => ‖y - Q.starProjection y‖ :=
        (continuous_id.sub Q.starProjection.continuous).norm.measurable
      have hn : Measurable fun y : Euclid P => s * ‖y‖ :=
        (continuous_const.mul continuous_norm).measurable
      rw [hZ']
      exact (measurableSet_lt measurable_const hia).inter
        ((measurableSet_lt hfm measurable_const).inter (measurableSet_lt hq hn))
    have hZZ' : Z ⊆ Z' := by
      rw [hZ, hZ']
      rintro x ⟨hxa, -, hxf, hxq⟩
      exact ⟨hxa, hxf, hxq⟩
    -- Step 3: both integrands vanish on `Z' \ Z` (radial windows).
    have hrad : ∀ x : Euclid P, x ∈ Z' → |‖x‖ - 1| < s → x ∈ Z := by
      intro x hx hx1
      rw [hZ'] at hx
      obtain ⟨hxa, hxf, hxq⟩ := hx
      rw [hZ]
      exact ⟨hxa, hx1, hxf, hxq⟩
    have hvan₁ : ∀ x ∈ Z' \ Z, l (‖x‖ / r) * ψ (f x) * G x = 0 := by
      rintro x ⟨hxZ', hxZ⟩
      by_cases hl0 : l (‖x‖ / r) = 0
      · rw [hl0, zero_mul, zero_mul]
      refine absurd (hrad x hxZ' ?_) hxZ
      obtain ⟨ht₁, ht₂⟩ := hls (subset_tsupport l (Function.mem_support.mpr hl0))
      have hx : ‖x‖ = r * (‖x‖ / r) := (mul_div_cancel₀ _ hr0.ne').symm
      generalize ‖x‖ / r = t at hx ht₁ ht₂
      have ht0 : 0 < t := by linarith
      rw [abs_lt]
      constructor
      · nlinarith [mul_lt_mul_of_pos_right (show 1 - s / 4 < r by linarith) ht0,
          mul_lt_mul_of_pos_left ht₁ (show (0 : ℝ) < 1 - s / 4 by linarith)]
      · nlinarith [mul_lt_mul_of_pos_right (show r < 1 + s / 4 by linarith) ht0,
          mul_lt_mul_of_pos_left ht₂ (show (0 : ℝ) < 1 + s / 4 by linarith)]
    have hvan₂ : ∀ x ∈ Z' \ Z, l ‖x‖ * ψ (f x) * G x = 0 := by
      rintro x ⟨hxZ', hxZ⟩
      by_cases hl0 : l ‖x‖ = 0
      · rw [hl0, zero_mul, zero_mul]
      refine absurd (hrad x hxZ' ?_) hxZ
      obtain ⟨ht₁, ht₂⟩ := hls (subset_tsupport l (Function.mem_support.mpr hl0))
      rw [abs_lt]
      constructor <;> linarith
    -- Step 4: dilation invariance of `|·| / r`, `f`, `Z'` and, `μ`-a.e., of `G`.
    have hnorm : ∀ y : Euclid P, ‖r • y‖ = r * ‖y‖ := fun y => norm_smul_of_nonneg hr0.le y
    have hfr : ∀ y, f (r • y) = f y := fun y => by
      rw [← hf, ← hf, real_inner_smul_left, real_inner_smul_left, mul_div_mul_left _ _ hr0.ne']
    have hZ'r : ∀ y, r • y ∈ Z' ↔ y ∈ Z' := by
      intro y
      have hproj : r • y - Q.starProjection (r • y) = r • (y - Q.starProjection y) := by
        rw [map_smul, smul_sub]
      rw [hZ', Set.mem_ofPred_eq, Set.mem_ofPred_eq, hfr, hproj, hnorm, hnorm,
        real_inner_smul_left, mul_pos_iff_of_pos_left hr0, mul_left_comm,
        mul_lt_mul_iff_right₀ hr0]
    have hGr : ∀ y, approxTangentPlane 2 R.carrier (r • y) = approxTangentPlane 2 R.carrier y →
        G (r • y) = G y := by
      intro y hy
      have hA : inner ℝ (r • y) a • e - inner ℝ (r • y) e • a =
          r • (inner ℝ y a • e - inner ℝ y e • a) := by
        rw [real_inner_smul_left, real_inner_smul_left, smul_sub, mul_smul, mul_smul]
      rw [← hG, ← hG, hy, hA, map_smul, map_smul, hnorm, hnorm, mul_pow, mul_pow,
        mul_div_mul_left _ _ (pow_ne_zero 2 hr0.ne')]
    -- `φ := 1_{Z'} h₁` satisfies `φ(ry) = (1_{Z'} h₂)(y)` for `μ`-a.e. `y`.
    have hae : (fun y => Z'.indicator (fun x => l (‖x‖ / r) * ψ (f x) * G x) (r • y))
        =ᵐ[R.measure] Z'.indicator fun x => l ‖x‖ * ψ (f x) * G x := by
      filter_upwards [hTS r hr0] with y hy
      by_cases hyZ : y ∈ Z'
      · rw [Set.indicator_of_mem ((hZ'r y).2 hyZ), Set.indicator_of_mem hyZ, hnorm,
          mul_div_cancel_left₀ _ hr0.ne', hfr, hGr y hy]
      · rw [Set.indicator_of_notMem (fun h => hyZ ((hZ'r y).1 h)),
          Set.indicator_of_notMem hyZ]
    -- Step 5: the cone scaling of `μ`.
    have hcone := Submission.idtp_cse_fd_cone_integral_smul P 2 C R hC hR r hr0
      (Z'.indicator fun x => l (‖x‖ / r) * ψ (f x) * G x)
    rw [integral_congr_ae hae, integral_indicator hZ'meas, integral_indicator hZ'meas,
      setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hZ'meas hZZ' hvan₁,
      setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hZ'meas hZZ' hvan₂] at hcone
    -- Step 6: conclusion.
    rw [hSI₁, hSI₂, hcone, ← mul_assoc, mul_inv_cancel₀ (pow_ne_zero 2 hr0.ne'), one_mul]
/-- **Flux density, identifying the constant** (steps 7–9 of the proof of
`idtp_cse_flux_density_eq`).  Let `0 < s ≤ 1`, `B = (1 − s/8, 1 + s/8) × (−s, s)` and
`B' = (1 − s/8, 1 + s/8) × (−s/8, s/8)`.  If `H < ∞` a.e., `toReal ∘ H = c·p₁` a.e. on `B`, and the
box integrals `I(s') = ∫_{(1−s', 1+s') × (−s', s')} H` (`0 < s' ≤ s/8`) satisfy `I(s')/s'² → 4m` as
`s' ↓ 0`, then `H = m·p₁` a.e. on `B'`.  Indeed `H = c·p₁` a.e. on `B`, so `c ≥ 0` (`p₁ > 0` on the
non-null `B' ⊆ B`); by Tonelli `I(s') = 4c·s'²`, and uniqueness of limits gives `c = m`. -/
theorem Submission.idtp_cse_fd_identify_constant : ∀ (s c : ℝ) (m : ℕ) (H : ℝ × ℝ → ℝ≥0∞) (I : ℝ → ℝ≥0∞), 0 < s → s ≤ 1 → (∀ᵐ p : ℝ × ℝ, H p ≠ ∞) → (∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-s) s → (H p).toReal = c * p.1) → (∀ s' : ℝ, 0 < s' → s' ≤ s / 8 → ∫⁻ p in Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s', H p = I s') → Tendsto (fun s' : ℝ => I s' / ENNReal.ofReal (s' ^ 2)) (𝓝[>] 0) (𝓝 (4 * (m : ℝ≥0∞))) → ∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-(s / 8)) (s / 8) → H p = ENNReal.ofReal ((m : ℝ) * p.1) := by
  intro s c m H I hs hs1 hfin hH hI hlim
  -- step 1: `H = ofReal (c p₁)` a.e. on `B`
  have h1 : ∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-s) s →
      H p = ENNReal.ofReal (c * p.1) := by
    filter_upwards [hfin, hH] with p hp1 hp2 hpB
    rw [← hp2 hpB, ENNReal.ofReal_toReal hp1]
  -- step 2: `c ≥ 0`, since `B' ⊆ B` has positive measure and `p₁ > 0` on it
  have hc : 0 ≤ c := by
    refine le_of_not_gt fun hneg => ?_
    have hpos : volume (Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-(s / 8)) (s / 8)) ≠ 0 := by
      rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioo, Real.volume_Ioo]
      refine mul_ne_zero ?_ ?_ <;> rw [ne_eq, ENNReal.ofReal_eq_zero, not_le] <;> linarith
    apply hpos
    rw [measure_eq_zero_iff_ae_notMem]
    filter_upwards [hH] with p hp hpB'
    have h0 := hp ⟨hpB'.1, by linarith [hpB'.2.1], by linarith [hpB'.2.2]⟩
    have hp1 : 0 < p.1 := by linarith [hpB'.1.1]
    have := mul_neg_of_neg_of_pos hneg hp1
    linarith [ENNReal.toReal_nonneg (a := H p)]
  -- step 3: the box integrals, `I s' = ofReal (4c) · ofReal (s'²)`
  have h3 : ∀ s' : ℝ, 0 < s' → s' ≤ s / 8 →
      I s' = ENNReal.ofReal (4 * c) * ENNReal.ofReal (s' ^ 2) := by
    intro s' hs' hs'8
    have hsub : Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s' ⊆
        Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-s) s :=
      prod_mono (Ioo_subset_Ioo (by linarith) (by linarith))
        (Ioo_subset_Ioo (by linarith) (by linarith))
    rw [← hI s' hs' hs'8, setLIntegral_congr_fun_ae (measurableSet_Ioo.prod measurableSet_Ioo)
      (h1.mono fun p hp hpS => hp (hsub hpS)), Measure.volume_eq_prod,
      setLIntegral_prod (fun p : ℝ × ℝ => ENNReal.ofReal (c * p.1)) (by fun_prop)]
    simp only [setLIntegral_const, Real.volume_Ioo]
    have hint : ∫ x in Ioo (1 - s') (1 + s'), c * x = 2 * c * s' := by
      rw [← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le (by linarith),
        intervalIntegral.integral_const_mul, integral_id]
      ring
    have hlint : ∫⁻ x in Ioo (1 - s') (1 + s'), ENNReal.ofReal (c * x) =
        ENNReal.ofReal (2 * c * s') := by
      rw [← hint, ofReal_integral_eq_lintegral_ofReal]
      · exact (by fun_prop : Continuous fun x : ℝ => c * x).integrableOn_Icc.mono_set
          Ioo_subset_Icc_self
      · exact (ae_restrict_iff' measurableSet_Ioo).mpr
          (Eventually.of_forall fun x hx => mul_nonneg hc (by linarith [hx.1]))
    rw [lintegral_mul_const' _ _ ENNReal.ofReal_ne_top, hlint,
      ← ENNReal.ofReal_mul (mul_nonneg (mul_nonneg (by norm_num) hc) hs'.le),
      ← ENNReal.ofReal_mul (by linarith)]
    congr 1
    ring
  -- step 4: `c = m`, by uniqueness of limits along `𝓝[>] 0`
  have h4 : ENNReal.ofReal (4 * c) = 4 * (m : ℝ≥0∞) := by
    have hev : (fun _ : ℝ => ENNReal.ofReal (4 * c)) =ᶠ[𝓝[>] 0]
        fun s' : ℝ => I s' / ENNReal.ofReal (s' ^ 2) := by
      filter_upwards [Ioc_mem_nhdsGT (show (0 : ℝ) < s / 8 by positivity)] with s' hs'
      rw [h3 s' hs'.1 hs'.2, ENNReal.mul_div_cancel_right _ ENNReal.ofReal_ne_top]
      rw [ne_eq, ENNReal.ofReal_eq_zero, not_le]
      exact pow_pos hs'.1 2
    exact tendsto_nhds_unique (tendsto_const_nhds.congr' hev) hlim
  have hcm : c = m := by
    have h4' : ENNReal.ofReal (4 * c) = ENNReal.ofReal (4 * (m : ℝ)) := by
      rw [h4, ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_natCast, ENNReal.ofReal_ofNat]
    rw [ENNReal.ofReal_eq_ofReal_iff (by positivity) (by positivity)] at h4'
    linarith
  -- step 5: conclusion on `B' ⊆ B`
  filter_upwards [h1] with p hp hpB'
  rw [hp ⟨hpB'.1, by linarith [hpB'.2.1], by linarith [hpB'.2.2]⟩, hcm]
/-- Step 13 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem): if `∂T = 0` and `T` integrates forms supported in the cylinder
`C` over the graph `Φ(v) = z + ι v + ι' (u v)`, `v ∈ D = B_s(0)`, with density `G`, then `G` has
vanishing weak derivatives: `∫_D G ∂ⱼa = 0` for smooth `a` with compact support in `D`.  Write
`n = m + 1`.  The `m`-form `ψ = a • βⱼ` on `ℝⁿ` has `dψ(e₀, …, e_m) = ∂ⱼa`, and its cut-off lift
`φ ∈ 𝒟ᵐ(U)` is supported in `C` and equals `Pr^#ψ` near every graph point, so
`dφ(Φ(v))(DΦ(v)e) = dψ(v)(e) = ∂ⱼa(v)` on `D`.  Hence `0 = ∂T(φ) = T(dφ) = ∫_D G ∂ⱼa`. -/
theorem Submission.dgcr_graph_boundary_weak_derivatives : ∀ (n k : ℕ) (U : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s h : ℝ) (G : Euclid n → ℝ), 0 < n → BoundaryVanishes T → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → 0 < h → ContDiffOn ℝ 1 u (ball 0 s) → (∀ v ∈ ball (0 : Euclid n) s, u v ∈ ball (0 : Euclid k) h) → {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = ∫ v in ball (0 : Euclid n) s, G v * (ω : DifferentialForm (Euclid (n + k)) n) (z + ι v + ι' (u v)) (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ)))) → ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ ball (0 : Euclid n) s → ∀ j : Fin n, ∫ v in ball (0 : Euclid n) s, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0 := by
  intro n k U T ι ι' u z s h G hn hT hperp hs hh hu hmaps hCU hrep a ha hac has j
  -- `n = m + 1`, so `∂T = 0` reads `T.boundary = 0`
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hn.ne'
  -- the `m`-form `ψ = a • βⱼ` on `ℝⁿ`: `spt ψ ⊆ spt a` and `dψ(x)(e₀, …, e_m) = ∂ⱼa(x)`
  obtain ⟨ψ, hψs, hψa, hψd⟩ := Submission.dgcr_bwd_coordinate_form m a j ha
  -- the test form `φ = (η ∘ Q) • Pr^#ψ ∈ 𝒟ᵐ(U)`: `spt φ ⊆ C` and `φ = Pr^#ψ` near each `Φ(v)`
  obtain ⟨φ, hφC, hφψ⟩ := Submission.dgcr_bwd_graph_cutoff_lift m k U ι ι' u z s h ψ hperp
    (Submission.dgcr_orthogonal_coordinates (m + 1) k ι ι' hperp).1 hh hu.continuousOn hmaps hCU
    hψs (hac.mono' ((subset_tsupport ψ).trans hψa)) (hψa.trans has)
  -- `T(dφ) = ∂T(φ) = 0`
  have hT0 : T (exteriorDerivativeTestOn U m φ) = 0 := by
    have hT' : T.boundary = 0 := hT
    rw [← GeometricCurrentOn.boundary_apply, hT', GeometricCurrentOn.zero_apply]
  -- `spt dφ ⊆ spt φ ⊆ C`, so `T(dφ)` is the graph integral of `dφ`
  rw [hrep _ ((tsupport_exteriorDerivative_subset
    (φ : DifferentialForm (Euclid (m + 1 + k)) m)).trans hφC)] at hT0
  refine Eq.trans ?_ hT0
  refine setIntegral_congr_fun measurableSet_ball fun v hv => ?_
  -- on `D`: `dφ(Φ(v))(DΦ(v)e) = d(Pr^#ψ)(Φ(v))(DΦ(v)e) = dψ(v)(e) = ∂ⱼa(v)`
  have hud : DifferentiableAt ℝ u v :=
    (hu.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds hv)
  have hdφ : exteriorDerivative (φ : DifferentialForm (Euclid (m + 1 + k)) m) (z + ι v + ι' (u v)) =
      exteriorDerivative (affinePullbackForm (ContinuousLinearMap.adjoint ι.toContinuousLinearMap)
        (-(ContinuousLinearMap.adjoint ι.toContinuousLinearMap z)) ψ) (z + ι v + ι' (u v)) :=
    (hφψ v hv).extDeriv_eq
  change G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) =
    G v * exteriorDerivative (φ : DifferentialForm (Euclid (m + 1 + k)) m) (z + ι v + ι' (u v))
      (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ)))
  rw [hdφ, Submission.dgcr_bwd_graph_pullback_extDeriv m k ι ι' u z ψ v hperp hψs hud, hψd v]
/-- **Mollification approximates a `C¹_c` function in a directional derivative** (step 3 of the
extension from smooth to `C¹` tests in the graph-cycle regularity step of Simon 7.4.3).  For
`φ ∈ C¹_c(ℝⁿ)`, `δ > 0`, a direction `v` and `ε > 0` there is `ψ ∈ C^∞_c(ℝⁿ)` with `spt ψ` in the
closed `δ`-neighbourhood of `spt φ` and `|Dψ(x)v − Dφ(x)v| ≤ ε` for all `x`.  Take `r₀ > 0` with
`|∂ᵥφ(a) − ∂ᵥφ(b)| < ε` when `|a − b| < r₀` (`∂ᵥφ` is continuous with compact support), a
normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`, and `ψ = ρ ⋆ φ`; then
`∂ᵥψ = ρ ⋆ ∂ᵥφ`, which is within `ε` of `∂ᵥφ`. -/
theorem Submission.dgcr_stc_mollify_C1_fderiv_approx : ∀ (n : ℕ) (φ : Euclid n → ℝ), ContDiff ℝ 1 φ → HasCompactSupport φ → ∀ (δ : ℝ), 0 < δ → ∀ (v : Euclid n) (ε : ℝ), 0 < ε → ∃ ψ : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ ∧ HasCompactSupport ψ ∧ tsupport ψ ⊆ cthickening δ (tsupport φ) ∧ ∀ x, |fderiv ℝ ψ x v - fderiv ℝ φ x v| ≤ ε := by
  intro n φ hφ hφc δ hδ v ε hε
  -- `∂ᵥφ = Dφ(·) v` is continuous with compact support, hence uniformly continuous: it varies by
  -- less than `ε` on balls of radius `r₀`
  have hDφ : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  have hDφc : HasCompactSupport (fderiv ℝ φ) := hφc.fderiv ℝ
  have hg : Continuous fun x => fderiv ℝ φ x v := hDφ.clm_apply continuous_const
  have hgc : HasCompactSupport fun x => fderiv ℝ φ x v :=
    hDφc.comp_left (g := fun A : Euclid n →L[ℝ] ℝ => A v) rfl
  obtain ⟨r₀, hr₀, hr₀g⟩ :=
    Metric.uniformContinuous_iff.mp (hgc.uniformContinuous_of_continuous hg) ε hε
  -- a normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`; `ψ = ρ ⋆ φ`
  obtain ⟨ρ, hρ, hρc, hρ0, hρ1, hρs⟩ :=
    Submission.dgcr_stc_exists_normalized_mollifier n (min r₀ δ) (lt_min hr₀ hδ)
  have hρi : LocallyIntegrable ρ volume := hρ.continuous.locallyIntegrable
  let L := ContinuousLinearMap.lsmul ℝ ℝ (E := ℝ)
  -- `spt ψ ⊆ spt ρ + spt φ ⊆ B_r(0) + spt φ`, inside the closed set `cthickening δ (spt φ)`
  have hsupp : tsupport (convolution ρ φ L volume) ⊆ cthickening δ (tsupport φ) := by
    refine closure_minimal (fun z hz => ?_) isClosed_cthickening
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_add.mp (support_convolution_subset L hz)
    refine mem_cthickening_of_dist_le _ b δ _ (subset_tsupport φ hb) ?_
    rw [dist_eq_norm, add_sub_cancel_right]
    exact (mem_ball_zero_iff.mp (hρs ha)).le.trans (min_le_right r₀ δ)
  -- `ψ` is smooth, and compactly supported as `cthickening δ (spt φ)` is compact
  refine ⟨convolution ρ φ L volume,
    hρc.contDiff_convolution_left L hρ hφ.continuous.locallyIntegrable,
    (IsCompact.cthickening hφc).of_isClosed_subset (isClosed_tsupport _) hsupp, hsupp, fun x => ?_⟩
  -- `Dψ(x) v = (ρ ⋆ ∂ᵥφ)(x)`
  rw [(hφc.hasFDerivAt_convolution_right L hρi hφ x).fderiv,
    convolution_precompR_apply L hρi hDφc hDφ x v, ← Real.dist_eq]
  -- `ρ ≥ 0`, `∫ ρ = 1`, `spt ρ ⊆ B_r(0)` and `|∂ᵥφ(y) − ∂ᵥφ(x)| < ε` on `B_r(x)`
  exact dist_convolution_le hε.le hρs hρ0 hρ1 hg.aestronglyMeasurable fun y hy =>
    (hr₀g ((mem_ball.mp hy).trans_le (min_le_left r₀ δ))).le

/-- Step 14 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem): weak derivatives tested against `C^∞` functions may be
tested against `C¹` functions.  If `∫_D G ∂ⱼa = 0` for every `a ∈ C_c^∞(D)`, then `∫ G ∂ᵢφ = 0`
for every `φ ∈ C_c¹(D)`.  On the compact set `K = cthickening δ (spt φ) ⊆ D`, `G` is integrable
and `∂ᵢφ` is bounded.  The mollified tests `ψ` satisfy `spt ψ ⊆ K` and `|∂ᵢψ − ∂ᵢφ| ≤ ε`, so
`∫_K G ∂ᵢφ = 0` in the limit; every integrand vanishes off `K`. -/
theorem Submission.dgcr_smooth_tests_to_C1_tests : ∀ (n : ℕ) (D : Set (Euclid n)) (G : Euclid n → ℝ), IsOpen D → LocallyIntegrableOn G D volume → (∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ D → ∀ j : Fin n, ∫ v in D, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0) → ∀ φ : Euclid n → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∀ i : Fin n, ∫ x, G x * fderiv ℝ φ x ((EuclideanSpace.basisFun (Fin n) ℝ) i) = 0 := by
  intro n D G hD hG htest φ hφ hφc hφD i
  rw [EuclideanSpace.basisFun_apply]
  -- step 1: `K = cthickening δ (tsupport φ) ⊆ D` is compact and `G` is integrable on `K`
  obtain ⟨δ, hδ, hKD⟩ := hφc.isCompact.exists_cthickening_subset_open hD hφD
  have hK : IsCompact (cthickening δ (tsupport φ)) := hφc.isCompact.cthickening
  have hGK : IntegrableOn G (cthickening δ (tsupport φ)) volume :=
    hG.integrableOn_compact_subset hKD hK
  -- `G ∂ᵢu` vanishes off `K` when `tsupport u ⊆ K`
  have hvan : ∀ u : Euclid n → ℝ, tsupport u ⊆ cthickening δ (tsupport φ) →
      ∀ x ∉ cthickening δ (tsupport φ), G x * fderiv ℝ u x (EuclideanSpace.single i 1) = 0 :=
    fun u hu x hx => by rw [fderiv_of_notMem_tsupport ℝ fun h => hx (hu h), zero_apply, mul_zero]
  -- step 2: `∂ᵢφ` is continuous, hence bounded on `K`
  have hf : Continuous fun x => fderiv ℝ φ x (EuclideanSpace.single i 1) :=
    (hφ.continuous_fderiv one_ne_zero).clm_apply continuous_const
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hf.continuousOn
  -- step 3: the integral over `ℝⁿ` is the integral over `K`
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (hvan φ (self_subset_cthickening _))]
  -- step 4: smooth tests `ψ` with `tsupport ψ ⊆ K` approximate `∂ᵢφ` uniformly on `K`
  refine Submission.dgcr_stc_setIntegral_mul_eq_zero_of_uniform_approx n
    (cthickening δ (tsupport φ)) G (fun x => fderiv ℝ φ x (EuclideanSpace.single i 1)) C
    isClosed_cthickening.measurableSet hGK hf.aestronglyMeasurable
    (fun x hx => (Real.norm_eq_abs _).symm.trans_le (hC x hx)) fun ε hε => ?_
  obtain ⟨ψ, hψ, hψc, hψK, hψε⟩ := Submission.dgcr_stc_mollify_C1_fderiv_approx n φ hφ hφc δ hδ
    (EuclideanSpace.single i 1) ε hε
  refine ⟨fun x => fderiv ℝ ψ x (EuclideanSpace.single i 1),
    ((hψ.continuous_fderiv (by simp)).clm_apply continuous_const).aestronglyMeasurable,
    fun x _ => (abs_sub_comm _ _).trans_le (hψε x), ?_⟩
  -- `∫_K G ∂ᵢψ = ∫ G ∂ᵢψ = ∫_D G ∂ᵢψ`, which vanishes as `ψ` is a smooth test in `D`
  have hvanD : ∀ x ∉ D, G x * fderiv ℝ ψ x (EuclideanSpace.single i 1) = 0 :=
    fun x hx => hvan ψ hψK x fun h => hx (hKD h)
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero (hvan ψ hψK),
    ← setIntegral_eq_integral_of_forall_compl_eq_zero hvanD]
  exact htest ψ hψ hψc (hψK.trans hKD) i

/-- **An integer multiplicity cycle carried by a `C¹` graph is regular** (Simon 7.4.3, p. 194,
"Hence by Allard's Theorem 5.2 of Ch. 5 we have `y ∈ reg T`", with the Constancy Theorem 6.2.34).
Let `T = τ(M, θ, ξ) ∈ 𝒟ₙ(U)` with `∂T = 0`, `ι`, `ι'` linear isometries with orthogonal ranges,
`Φ(v) = z + ιv + ι'u(v)` for a `C¹` map `u` on `B_s(0)` with `u(0) = 0`, and
`C = {z + ιv + ι'w : |v| < s, |w| < h} ⊆ U`.  If `spt μ_T ∩ C = Σ := Φ(B_s(0))` and `z ∈ spt T`,
then `z ∈ reg T`.  `Σ` is an embedded `C¹` submanifold through `z = Φ(0)` with a continuous unit
orientation `ξ_Σ`, and `T(ω) = ∫_Σ g ⟨ω, ξ_Σ⟩ dHⁿ` for `spt ω ⊆ C`, with `G = g ∘ Φ` locally
integrable and integer-valued on `B_s(0)`.  By the area formula and
`α(DΦe₁, …, DΦeₙ) = JΦ ⟨α, ξ_Σ⟩`, `T(ω) = ∫_{B_s(0)} G ω(Φ)(DΦe₁, …, DΦeₙ) dv`; `∂T = 0` kills
the weak derivatives of `G`, so `G = m ∈ ℤ` a.e. on the connected ball and `T = m[[Σ]]` in `C`.
`m ≠ 0` as `z ∈ spt T`, and `ρ = min(s, h)/2` gives `B̄_ρ(z) ⊆ C`. -/
theorem Submission.dor_graph_supported_cycle_regular : ∀ (n k : ℕ) (U : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (R : IMRep U n) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s h : ℝ), 0 < n → IsOpen U → R.Represents T → BoundaryVanishes T → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → 0 < h → ContDiffOn ℝ 1 u (ball 0 s) → u 0 = 0 → {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} = (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s → z ∈ T.support → z ∈ regularSet T := by
  intro n k U T R ι ι' u z s h hn _hU hRT hbd horth hs hh hu hu0 hCU hspt hzT
  -- step 1: orthogonal coordinates `x − z = ιv + ι'w` with `‖x − z‖² = ‖v‖² + ‖w‖²`
  obtain ⟨hdec, hpyth⟩ := Submission.dgcr_orthogonal_coordinates n k ι ι' horth
  have hle : ∀ (v : Euclid n) (w : Euclid k), ‖v‖ ≤ ‖ι v + ι' w‖ ∧ ‖w‖ ≤ ‖ι v + ι' w‖ := by
    intro v w
    have h2 := hpyth v w
    constructor <;> nlinarith [norm_nonneg v, norm_nonneg w, norm_nonneg (ι v + ι' w)]
  have huniq : ∀ (v v' : Euclid n) (w w' : Euclid k), ι v + ι' w = ι v' + ι' w' → w = w' := by
    intro v v' w w' heq
    have h0 : ι (v - v') + ι' (w - w') = 0 := by
      rw [map_sub, map_sub, sub_add_sub_comm, heq, sub_self]
    have h1 := (hle (v - v') (w - w')).2
    rw [h0, norm_zero] at h1
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h1)
  -- `ρ := min(s, h)/2`, so `B̄_ρ(z) ⊆ C ⊆ U`
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = min s h / 2 := ⟨_, rfl⟩
  have hρ : 0 < ρ := by rw [hρdef]; exact half_pos (lt_min hs hh)
  have hρs : ρ < s := by rw [hρdef]; linarith [min_le_left s h, lt_min hs hh]
  have hρh : ρ < h := by rw [hρdef]; linarith [min_le_right s h, lt_min hs hh]
  have hclosed : closedBall z ρ ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
    intro x hx
    obtain ⟨v, w, hvw⟩ := hdec (x - z)
    have hxz : ‖ι v + ι' w‖ ≤ ρ := by rw [← hvw, ← dist_eq_norm]; exact hx
    refine ⟨v, ?_, w, ?_, ?_⟩
    · rw [mem_ball_zero_iff]; exact ((hle v w).1.trans hxz).trans_lt hρs
    · rw [mem_ball_zero_iff]; exact ((hle v w).2.trans hxz).trans_lt hρh
    · rw [add_assoc, ← hvw, add_sub_cancel]
  have hballC : ball z ρ ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} :=
    ball_subset_closedBall.trans hclosed
  -- `‖v‖ ≤ ‖Φ(v) − z‖`, `z = Φ(0) ∈ Σ`, and `u(B_s(0)) ⊆ B_h(0)` because `Σ ⊆ C`
  have hnorm : ∀ v : Euclid n, ‖v‖ ≤ ‖z + ι v + ι' (u v) - z‖ := fun v => by
    rw [add_assoc, add_sub_cancel_left]; exact (hle v (u v)).1
  have hzS : z ∈ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s :=
    ⟨0, mem_ball_self hs, by simp [hu0]⟩
  have huh : ∀ v ∈ ball (0 : Euclid n) s, u v ∈ ball (0 : Euclid k) h := by
    intro v hv
    have hmem : z + ι v + ι' (u v) ∈ R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
      rw [hspt]; exact ⟨v, hv, rfl⟩
    obtain ⟨v', -, w', hw', heq⟩ := hmem.2
    rw [add_assoc, add_assoc] at heq
    rwa [huniq v v' (u v) w' (add_left_cancel heq)]
  -- step 2: `Σ` is an embedded `C¹` submanifold with `T_{Φ(v)}Σ = range DΦ(v)`, oriented by `ξ`
  obtain ⟨hinj, hdiff, hemb, htan⟩ := Submission.dgcr_graph_chart_embedded n k ι ι' u z s horth hs hu
  obtain ⟨ξ, β, hξc, hβc, hξβ, hξo, hjac⟩ :=
    Submission.dgcr_graph_orientation_jacobian n k ι ι' u z s hn horth hs hu
  have hor : IsOrientation n ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ξ := by
    refine ⟨hξc, ?_⟩
    rintro _ ⟨v, hv, rfl⟩
    exact ⟨_, (htan v hv).symm, hξo v hv⟩
  -- step 3: an integer density `g` on `Σ` with `T(ω) = ∫_Σ g ⟨ω, ξ⟩ dHⁿ` for `spt ω ⊆ C`
  obtain ⟨g, hgloc, hgint, hgrep⟩ := Submission.dgcr_graph_integer_density_on_graph n k U T R ι ι' u z
    s h ξ β hn hRT horth hs hh hu hCU hspt hβc hξβ hξo
  -- step 4: area formula `∫_Σ F dHⁿ = ∫_{B_s(0)} JΦ · F ∘ Φ dLⁿ`, `JΦ = √det(DΦ* DΦ)`
  have harea : ∀ F : Euclid (n + k) → ℝ, ∫ x in (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, F x ∂μHE[n] = ∫ v in ball (0 : Euclid n) s, Real.sqrt (((fderiv ℝ (fun v => z + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => z + ι v + ι' (u v)) v).det) * F (z + ι v + ι' (u v)) := by
    intro F
    have h4 := Poincare.SimonGMT.Chapter02.integral_area_formula_of_injective_derivative
      measurableSet_ball (fun v hv => (hdiff v hv).1) (fun v hv => (hdiff v hv).2) hinj F
    rw [finrank_euclideanSpace_fin, EuclideanSpace.euclideanHausdorffMeasure_eq_volume n] at h4
    rw [h4]
    refine setIntegral_congr_fun measurableSet_ball fun v _ => ?_
    simp only [smul_eq_mul, Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_sqrt_det_adjoint_comp]
  -- with `α(DΦe₁, …, DΦeₙ) = JΦ ⟨α, ξ⟩`: `T(ω) = ∫_{B_s(0)} G ω(Φ)(DΦe₁, …, DΦeₙ) dv`, `G = g ∘ Φ`
  have hrepD : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = ∫ v in ball (0 : Euclid n) s, g (z + ι v + ι' (u v)) * (ω : DifferentialForm (Euclid (n + k)) n) (z + ι v + ι' (u v)) (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ))) := by
    intro ω hω
    rw [hgrep ω hω, harea]
    refine setIntegral_congr_fun measurableSet_ball fun v hv => ?_
    simp only [hjac v hv]
    ring
  -- step 5: `∂T = 0` gives `∫ G ∂ⱼa = 0` for all tests `a`; distributional constancy on `B_s(0)`
  have hBT := Submission.dgcr_graph_boundary_weak_derivatives n k U T ι ι' u z s h
    (fun v => g (z + ι v + ι' (u v))) hn hbd horth hs hh hu huh hCU hrepD
  have hSC := Submission.dgcr_smooth_tests_to_C1_tests n (ball (0 : Euclid n) s)
    (fun v => g (z + ι v + ι' (u v))) isOpen_ball hgloc hBT
  obtain ⟨c, hc⟩ := Poincare.SimonGMT.Chapter08.ae_eq_const_of_weak_coordinate_derivatives_zero
    hgloc isOpen_ball (convex_ball (0 : Euclid n) s).isPreconnected hSC
  -- the constant is an integer `m`: `G` is integer-valued a.e. and `Lⁿ(B_s(0)) > 0`
  obtain ⟨v₀, -, hv₀c, m, hv₀m⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae
    (measure_ball_pos volume (0 : Euclid n) hs).ne' (hc.and hgint)
  have hGm : ∀ᵐ v ∂(volume.restrict (ball (0 : Euclid n) s)), g (z + ι v + ι' (u v)) = m := by
    filter_upwards [hc] with v hv
    exact hv.trans (hv₀c.symm.trans hv₀m)
  -- step 6: `T = m[[Σ]]` in `C`
  have hrepm : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = (m : ℝ) * ∫ x in (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, ξ x ((ω : DifferentialForm (Euclid (n + k)) n) x) ∂μHE[n] := by
    intro ω hω
    rw [hrepD ω hω, harea, ← integral_const_mul]
    refine integral_congr_ae ?_
    filter_upwards [hGm, ae_restrict_mem measurableSet_ball] with v hv hvD
    rw [hv, hjac v hvD]
  -- step 7: `m ≠ 0`, since otherwise `T` vanishes in `B_ρ(z)` and `z ∉ spt T`
  have hm0 : m ≠ 0 := by
    intro hm
    subst hm
    have hvan : T.VanishesOn (ball z ρ) := by
      intro ω hω
      rw [hrepm ω (hω.trans hballC), Int.cast_zero, zero_mul]
    exact hzT.2 (Set.mem_sUnion.2 ⟨ball z ρ, ⟨isOpen_ball,
      (isCompact_closedBall z ρ).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      closure_ball_subset_closedBall.trans (hclosed.trans hCU), hvan⟩, mem_ball_self hρ⟩)
  -- step 8: `Hⁿ(Σ ∩ K) ≤ Hⁿ(Φ(B̄_ρ(0))) < ∞` for `K ⊆ B_ρ(z)`
  have hfin : ∀ K : Set (Euclid (n + k)), IsCompact K → K ⊆ ball z ρ → μHE[n] (((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ∩ K) ≠ ∞ := by
    intro K _ hK
    refine ne_top_of_le_ne_top
      ((Submission.dgcr_graph_measure_bounds n k ι ι' u z s horth hs hu).2 ρ hρs) (measure_mono ?_)
    rintro _ ⟨⟨v, -, rfl⟩, hvK⟩
    refine ⟨v, ?_, rfl⟩
    have hv := hK hvK
    rw [mem_ball, dist_eq_norm] at hv
    rw [mem_closedBall_zero_iff]
    exact (hnorm v).trans hv.le
  exact ⟨hzT, ρ, hρ, hballC.trans hCU, m, (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, ξ,
    hm0, hzS, hemb, hor, hfin, fun ω hω => hrepm ω (hω.trans hballC)⟩

/-- **ε-regularity for stationary cycles**, the book's appeal to Allard's theorem in Simon 7.4.3
(chapter-07.txt lines 624–631; Allard's theorem is Ch. 5, 5.2).  Near `y₀ ∈ N ∩ U`, the varifold
`v(M, θ)` of a cycle `T = τ(M, θ, ξ)` stationary in `U ∩ N` has generalized mean curvature
`|H| ≤ κ` in `B_{2r_c}(y₀)` (Ch. 4, 2.7).  If `z ∈ spt T` is near `y₀` and
`M_{B_ρ(z)}(T) ≤ (1 + δ)ωₙρⁿ`, then `μ_R(B̄_{ρ'}(z)) ≤ (1 + δ₁)ωₙρ'ⁿ` for a slightly smaller
`ρ'`, because `M_W(T) = μ_R(W)` and `z ∈ spt μ_R`.  Allard's theorem (gradient bound `1/4`) then
makes `spt μ_R ∩ B_{γρ'}(z)` the graph of a `C¹` map `u` over an `n`-plane through `z`.  In the
cylinder of radius `γρ'/4` about `z`, `spt μ_R` is exactly that graph, so `z ∈ reg T` by the
Constancy Theorem argument (Ch. 6, 2.34). -/
theorem Submission.dor_stationary_cycle_epsilon_regularity : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n →
    ∀ (U N : Set (Euclid (n + k))) (y₀ : Euclid (n + k)), IsOpen U →
    IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → y₀ ∈ N ∩ U →
    ∃ r₀ δ : ℝ, 0 < r₀ ∧ 0 < δ ∧ ∀ (T : GeometricCurrentOn U n) (R : IMRep U n),
      R.Represents T → T.support ⊆ N → BoundaryVanishes T → R.IsStationaryAlong N →
      ∀ z ∈ T.support, dist z y₀ < r₀ → ∀ ρ : ℝ, 0 < ρ → ρ ≤ r₀ →
        T.massOn (ball z ρ) ≤ ENNReal.ofReal (1 + δ) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) →
        z ∈ regularSet T := by
  intro n k ℓ hℓk hn U N y₀ hU hN hNcl hy₀
  -- The mean curvature bound `κ` and the first variation formula on `B_{2r_c}(y₀)`.
  obtain ⟨rc, κ, hrc, hκ, hrcU, hmc⟩ :=
    Submission.dor_stationary_mean_curvature_monotonicity n k ℓ hℓk hn U N y₀ hU hN hNcl hy₀
  -- Allard's constants `δ₁`, `γ` for the gradient bound `1/4`.
  obtain ⟨δ₁, γ, hδ₁, hγ, hγ1, hallard⟩ :=
    Submission.dor_allard_bounded_curvature_graph n k hn (1 / 4) (by norm_num)
  have hκ1 : 0 < κ + 1 := by linarith
  refine ⟨min (rc / 2) (δ₁ / (κ + 1)), δ₁ / 2, lt_min (half_pos hrc) (div_pos hδ₁ hκ1),
    half_pos hδ₁, ?_⟩
  intro T R hR hTN hTb hstat z hz hzy ρ hρ hρr₀ hmass
  obtain ⟨hρrc, hρδ⟩ := le_min_iff.1 hρr₀
  have hzy' : dist z y₀ < rc / 2 := (lt_min_iff.1 hzy).1
  -- `M_W(T) = μ_R(W)` for open `W`, and `spt T = U ∩ spt μ_R`; so `z ∈ spt μ_R`.
  obtain ⟨hmassEq, hsupp⟩ :=
    Submission.dor_imrep_massOn_eq_measure_and_support (n + k) n U T R hU hR
  have hzR : z ∈ R.measure.support := by
    have h := hz
    rw [hsupp] at h
    exact h.2
  obtain ⟨⟨H, hHm, hHκ, hHfv⟩, -⟩ := hmc T R hR hTN hstat
  -- A smaller radius `ρ' = tρ`, `t = 1 - d/n`, with `(1 + δ₁/2)ρⁿ ≤ (1 + δ₁)ρ'ⁿ` (Bernoulli).
  set d : ℝ := δ₁ / (2 * (1 + δ₁)) with hd
  have hd0 : 0 < d := div_pos hδ₁ (by linarith)
  have hd1 : d < 1 := by
    rw [hd, div_lt_one (by linarith)]
    linarith
  have hδd : (1 + δ₁) * (1 - d) = 1 + δ₁ / 2 := by
    rw [hd]
    field_simp
    ring
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast hn
  set t : ℝ := 1 - d / n with ht
  have hdn : d / n ≤ d := div_le_self hd0.le hnR
  have hdn0 : 0 < d / n := div_pos hd0 (by linarith)
  have ht0 : 0 < t := by linarith
  have ht1 : t < 1 := by linarith
  have hbern : 1 - d ≤ t ^ n := by
    have h := one_add_mul_le_pow (show (-2 : ℝ) ≤ -(d / n) by linarith) n
    have e1 : (n : ℝ) * -(d / n) = -d := by
      field_simp
    have e2 : (1 : ℝ) + -(d / n) = t := by
      rw [ht]
      ring
    rw [e1, e2] at h
    linarith
  set ρ' : ℝ := t * ρ with hρ'
  have hρ'0 : 0 < ρ' := mul_pos ht0 hρ
  have hρ'ρ : ρ' < ρ := mul_lt_of_lt_one_left hρ ht1
  have hreal : (1 + δ₁ / 2) * ρ ^ n ≤ (1 + δ₁) * ρ' ^ n := by
    have hρn : 0 ≤ ρ ^ n := pow_nonneg hρ.le n
    calc (1 + δ₁ / 2) * ρ ^ n = (1 + δ₁) * ((1 - d) * ρ ^ n) := by
          rw [← hδd]
          ring
      _ ≤ (1 + δ₁) * (t ^ n * ρ ^ n) := by
          gcongr
      _ = (1 + δ₁) * ρ' ^ n := by
          rw [hρ', mul_pow]
  -- Allard's mass hypothesis on the closed ball `B̄_{ρ'}(z) ⊆ B_ρ(z)`.
  have hmass' : R.measure (closedBall z ρ') ≤
      ENNReal.ofReal (1 + δ₁) * unitBallVolume n * ENNReal.ofReal (ρ' ^ n) := by
    calc R.measure (closedBall z ρ') ≤ R.measure (ball z ρ) :=
          measure_mono (closedBall_subset_ball hρ'ρ)
      _ = T.massOn (ball z ρ) := (hmassEq _ isOpen_ball).symm
      _ ≤ ENNReal.ofReal (1 + δ₁ / 2) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) := hmass
      _ ≤ ENNReal.ofReal (1 + δ₁) * unitBallVolume n * ENNReal.ofReal (ρ' ^ n) := by
          rw [mul_right_comm, mul_right_comm (ENNReal.ofReal (1 + δ₁)),
            ← ENNReal.ofReal_mul (show (0 : ℝ) ≤ 1 + δ₁ / 2 by linarith),
            ← ENNReal.ofReal_mul (show (0 : ℝ) ≤ 1 + δ₁ by linarith)]
          gcongr
  -- Allard's curvature hypothesis `κρ' ≤ δ₁`.
  have hκρ' : κ * ρ' ≤ δ₁ := by
    have h1 : ρ' * (κ + 1) ≤ δ₁ := (le_div_iff₀ hκ1).1 (hρ'ρ.le.trans hρδ)
    have h2 : ρ' * (κ + 1) = κ * ρ' + ρ' := by ring
    linarith
  -- `B̄_{ρ'}(z) ⊆ W := B_{2r_c}(y₀) ⊆ U`.
  have hWU : ball y₀ (2 * rc) ⊆ U :=
    (ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith))).trans hrcU
  have hBW : closedBall z ρ' ⊆ ball y₀ (2 * rc) := by
    intro x hx
    rw [mem_closedBall] at hx
    rw [mem_ball]
    calc dist x y₀ ≤ dist x z + dist z y₀ := dist_triangle _ _ _
      _ < 2 * rc := by linarith
  -- Allard: `spt μ_R ∩ B_{γρ'}(z)` is the graph of `u` over `ι(ℝⁿ)`, with `‖Du‖ ≤ 1/4`.
  obtain ⟨ι, ι', u, horth, hu0, hu, hDu, hgraph⟩ :=
    hallard U (ball y₀ (2 * rc)) R H κ ρ' z isOpen_ball hWU hρ'0 hBW hHm hHκ hHfv hzR hmass'
      hκρ'
  -- The cylinder `{z + ι v + ι' w : |v|, |w| < s}`, `s = γρ'/4`, lies in `B_{γρ'}(z) ⊆ U`.
  set s : ℝ := γ * ρ' / 4 with hs
  have hγρ' : 0 < γ * ρ' := mul_pos hγ hρ'0
  have hs0 : 0 < s := by linarith
  have hsγ : s < γ * ρ' := by linarith
  have hγρ'ρ' : γ * ρ' ≤ ρ' := mul_le_of_le_one_left hρ'0.le hγ1
  have hnorm : ∀ (v : Euclid n) (w : Euclid k), dist (z + ι v + ι' w) z ≤ ‖v‖ + ‖w‖ := by
    intro v w
    rw [dist_eq_norm, add_assoc, add_sub_cancel_left]
    calc ‖ι v + ι' w‖ ≤ ‖ι v‖ + ‖ι' w‖ := norm_add_le _ _
      _ = ‖v‖ + ‖w‖ := by rw [ι.norm_map, ι'.norm_map]
  have hcyl : {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s,
      x = z + ι v + ι' w} ⊆ ball z (γ * ρ') := by
    rintro x ⟨v, hv, w, hw, rfl⟩
    rw [mem_ball_zero_iff] at hv hw
    rw [mem_ball]
    calc dist (z + ι v + ι' w) z ≤ ‖v‖ + ‖w‖ := hnorm v w
      _ < γ * ρ' := by linarith
  have hcylU : {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s,
      x = z + ι v + ι' w} ⊆ U :=
    hcyl.trans ((ball_subset_ball hγρ'ρ').trans (ball_subset_closedBall.trans (hBW.trans hWU)))
  -- `|u(v)| ≤ |v|/4` on `B_{γρ'}(0)` (mean value inequality, `u(0) = 0`).
  have hu_le : ∀ v ∈ ball (0 : Euclid n) (γ * ρ'), ‖u v‖ ≤ 1 / 4 * ‖v‖ := by
    intro v hv
    have h := (convex_ball (0 : Euclid n) (γ * ρ')).norm_image_sub_le_of_norm_fderiv_le
      (fun x hx => (hu.differentiableOn_one x hx).differentiableAt (isOpen_ball.mem_nhds hx))
      hDu (mem_ball_self hγρ') hv
    simpa [hu0] using h
  -- In the cylinder, `spt μ_R` is exactly the graph over `B_s(0)`: the ranges of `ι`, `ι'` are
  -- orthogonal, so a graph point `z + ι v' + ι' u(v')` equal to `z + ι v + ι' w` has `v' = v`.
  have hsupp_eq : R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s,
      ∃ w ∈ ball (0 : Euclid k) s, x = z + ι v + ι' w} =
      (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s := by
    ext x
    constructor
    · rintro ⟨hxR, hxC⟩
      have hxB := hcyl hxC
      obtain ⟨v, hv, w, -, rfl⟩ := hxC
      have hx : z + ι v + ι' w ∈ R.measure.support ∩ ball z (γ * ρ') := ⟨hxR, hxB⟩
      rw [hgraph] at hx
      obtain ⟨⟨v', -, hv'⟩, -⟩ := hx
      have hsum : ι v' + ι' (u v') = ι v + ι' w := by
        simpa only [add_assoc, add_right_inj] using hv'
      have hdiff : ι (v' - v) = ι' (w - u v') := by
        rw [map_sub, map_sub, sub_eq_sub_iff_add_eq_add, hsum, add_comm (ι v)]
      have hzero : ι (v' - v) = 0 := by
        rw [← inner_self_eq_zero (𝕜 := ℝ)]
        nth_rewrite 2 [hdiff]
        exact horth _ _
      have hvv : v' = v := by
        have h0 : ‖v' - v‖ = 0 := by
          rw [← ι.norm_map, hzero, norm_zero]
        exact sub_eq_zero.1 (norm_eq_zero.1 h0)
      subst hvv
      exact ⟨v', hv, hv'⟩
    · rintro ⟨v, hv, rfl⟩
      have hvs : ‖v‖ < s := mem_ball_zero_iff.1 hv
      have hvγ : v ∈ ball (0 : Euclid n) (γ * ρ') := ball_subset_ball hsγ.le hv
      have huv : ‖u v‖ < s := by
        have h := hu_le v hvγ
        linarith [norm_nonneg v]
      have hxB : z + ι v + ι' (u v) ∈ ball z (γ * ρ') := by
        rw [mem_ball]
        calc dist (z + ι v + ι' (u v)) z ≤ ‖v‖ + ‖u v‖ := hnorm v (u v)
          _ < γ * ρ' := by linarith
      have hx : z + ι v + ι' (u v) ∈
          ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) (γ * ρ')) ∩ ball z (γ * ρ') :=
        ⟨⟨v, hvγ, rfl⟩, hxB⟩
      rw [← hgraph] at hx
      exact ⟨hx.1, v, hv, u v, mem_ball_zero_iff.2 huv, rfl⟩
  -- Constancy over the base disc (`dor_graph_supported_cycle_regular`): `z ∈ reg T`.
  exact Submission.dor_graph_supported_cycle_regular n k U T R ι ι' u z s s hn hU hR hTb horth
    hs0 hs0 (hu.mono (ball_subset_ball hsγ.le)) hu0 hcylU hsupp_eq hz

/-- **Simon Ch. 2, §4** (4.1–4.3 and the definition of `Cˡ` functions on `M`): the tangent
projection `z ↦ P_{T_zN}` of an embedded `C²` submanifold `N ⊆ ℝᴾ` is `C¹` on `N`, i.e. it is the
restriction to `N` of a map that is `C¹` on an open `O ⊇ N`.  Along a chart `ψ`,
`T_{ψ(v)}N = range Dψ(v)` (`Submission.chart_tangentSpace_eq_range_fderiv`), and the projection
onto `range L` is `L (L*L)⁻¹ L*`, a smooth function of `L` near each injective `L`.  The inverse
function theorem for `Λ ∘ ψ`, `Λ` a left inverse of `Dψ(v₀)`, gives a `C¹` left inverse `φ` of
`ψ` on an open subset of `ℝᴾ`; by 4.2 (`ψ` is proper, so a homeomorphism onto `W ∩ N`),
`φ ∘ ψ = id` on all of `N` near `ψ(v₀)`, so `y ↦ P_{range Dψ(φ(y))}` extends `P_N` near `ψ(v₀)`.
A smooth partition of unity on the union `O` of these neighbourhoods glues the local
extensions. -/
theorem Submission.submanifold_tangentProjection_c1_extension : ∀ (P d : ℕ) (N : Set (Euclid P)), IsEmbeddedSubmanifold 2 d N → ∃ (O : Set (Euclid P)) (pr : Euclid P → (Euclid P →L[ℝ] Euclid P)), IsOpen O ∧ N ⊆ O ∧ ContDiffOn ℝ 1 pr O ∧ ∀ z ∈ N, pr z = (Submodule.span ℝ (tangentSpace N z)).starProjection := by
  intro P d N hN
  classical
  -- Step 1: `L ↦ P_{range L} = L (L*L)⁻¹ L*` is `C¹` near every injective `L₀`.
  have hproj : ∀ L₀ : Euclid d →L[ℝ] Euclid P, Injective L₀ →
      ContDiffAt ℝ 1 (fun L : Euclid d →L[ℝ] Euclid P =>
        (LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)).starProjection) L₀ := by
    intro L₀ hL₀
    -- the adjoint `L ↦ L*`, as an `ℝ`-linear continuous map
    let adj : (Euclid d →L[ℝ] Euclid P) →L[ℝ] (Euclid P →L[ℝ] Euclid d) :=
      { toFun := fun L => ContinuousLinearMap.adjoint L
        map_add' := fun A B => map_add _ A B
        map_smul' := fun c A => by simp
        cont := ContinuousLinearMap.adjoint.continuous }
    have hadj : ∀ L, adj L = ContinuousLinearMap.adjoint L := fun _ => rfl
    -- the Gram operator `L*L` is invertible at `L₀`
    let G : (Euclid d →L[ℝ] Euclid P) → (Euclid d →L[ℝ] Euclid d) := fun L => adj L ∘L L
    have hG : ContDiff ℝ 1 G := adj.contDiff.clm_comp contDiff_id
    have hGunit : IsUnit (G L₀) := by
      have hinj : Injective (G L₀) := by
        intro x y hxy
        have h0 : G L₀ (x - y) = 0 := by simp [map_sub, hxy]
        have h1 : inner ℝ (L₀ (x - y)) (L₀ (x - y)) = 0 := by
          have := congrArg (fun z => inner ℝ z (x - y)) h0
          simpa only [G, ContinuousLinearMap.coe_comp, comp_apply, hadj,
            ContinuousLinearMap.adjoint_inner_left, inner_zero_left] using this
        have h2 : L₀ (x - y) = L₀ 0 := by rw [inner_self_eq_zero.1 h1, map_zero]
        exact sub_eq_zero.1 (hL₀ h2)
      rw [ContinuousLinearMap.isUnit_iff_bijective]
      refine ⟨hinj, ?_⟩
      simpa using (LinearMap.injective_iff_surjective
        (f := (G L₀ : Euclid d →ₗ[ℝ] Euclid d))).1 hinj
    let Γ : (Euclid d →L[ℝ] Euclid P) → (Euclid P →L[ℝ] Euclid P) :=
      fun L => L ∘L (Ring.inverse (G L) ∘L adj L)
    have hinv : ContDiffAt ℝ 1 (fun L => Ring.inverse (G L)) L₀ := by
      have h := contDiffAt_ringInverse ℝ (n := 1) hGunit.unit
      rw [IsUnit.unit_spec] at h
      exact h.comp L₀ hG.contDiffAt
    have hΓ : ContDiffAt ℝ 1 Γ L₀ :=
      contDiffAt_id.clm_comp (hinv.clm_comp adj.contDiff.contDiffAt)
    -- `Γ L = P_{range L}` wherever `L*L` is invertible, in particular near `L₀`
    have hev : ∀ᶠ L in 𝓝 L₀, IsUnit (G L) :=
      hG.continuous.continuousAt.preimage_mem_nhds (Units.isOpen.mem_nhds hGunit)
    refine hΓ.congr_of_eventuallyEq ?_
    filter_upwards [hev] with L hL
    ext1 x
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ⟨_, rfl⟩ ?_
    rintro w ⟨a, rfl⟩
    have hcancel : G L (Ring.inverse (G L) (adj L x)) = adj L x := by
      have := congrArg (fun T : Euclid d →L[ℝ] Euclid d => T (adj L x))
        (Ring.mul_inverse_cancel (G L) hL)
      simpa [mul_apply_eq_comp] using this
    -- `L*(x - Γ L x) = 0`, i.e. `x - Γ L x ⊥ range L`
    have hperp : adj L (x - Γ L x) = 0 := by
      have : adj L (Γ L x) = G L (Ring.inverse (G L) (adj L x)) := rfl
      rw [map_sub, this, hcancel, sub_self]
    have : inner ℝ (x - Γ L x) (L a) = inner ℝ (adj L (x - Γ L x)) a := by
      rw [hadj, ContinuousLinearMap.adjoint_inner_left]
    rw [ContinuousLinearMap.coe_coe, this, hperp, inner_zero_left]
  -- Step 2: a `C¹` left inverse, defined on an open subset of `ℝᴾ`, of a `C¹` immersion `ψ`
  -- near `v₀`: the inverse function theorem for `Λ ∘ ψ`, `Λ` a left inverse of `Dψ(v₀)`.
  have hlinv : ∀ (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen V →
      ContDiffOn ℝ 1 ψ V → v₀ ∈ V → Injective (fderiv ℝ ψ v₀) →
      ∃ (O : Set (Euclid P)) (φ : Euclid P → Euclid d) (ε : ℝ), 0 < ε ∧ IsOpen O ∧
        ContDiffOn ℝ 1 φ O ∧ MapsTo φ O V ∧
        ∀ v : Euclid d, dist v v₀ < ε → v ∈ V ∧ ψ v ∈ O ∧ φ (ψ v) = v := by
    intro V ψ v₀ hV hψ hv₀ hinj
    obtain ⟨Λl, hΛl⟩ := LinearMap.exists_leftInverse_of_injective
      (fderiv ℝ ψ v₀ : Euclid d →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.2 hinj)
    let Λ : Euclid P →L[ℝ] Euclid d := LinearMap.toContinuousLinearMap Λl
    have hΛ : ∀ x, Λ (fderiv ℝ ψ v₀ x) = x := fun x => by
      simpa [Λ] using LinearMap.congr_fun hΛl x
    have hid : Λ ∘L fderiv ℝ ψ v₀ = ContinuousLinearMap.id ℝ (Euclid d) := by
      ext1 x
      simp [hΛ]
    let χ : Euclid d → Euclid d := fun v => Λ (ψ v)
    have hψat : ∀ v ∈ V, ContDiffAt ℝ 1 ψ v := fun v hv => hψ.contDiffAt (hV.mem_nhds hv)
    have hχat : ∀ v ∈ V, ContDiffAt ℝ 1 χ v := fun v hv =>
      Λ.contDiff.contDiffAt.comp v (hψat v hv)
    have hχderiv : ∀ v ∈ V, HasFDerivAt χ (Λ ∘L fderiv ℝ ψ v) v := fun v hv =>
      Λ.hasFDerivAt.comp v ((hψat v hv).differentiableAt one_ne_zero).hasFDerivAt
    -- the open set where `D(Λ ∘ ψ)` is invertible
    let D : Set (Euclid d) := V ∩ (fun v => Λ ∘L fderiv ℝ ψ v) ⁻¹' {A | IsUnit A}
    have hDopen : IsOpen D :=
      (continuousOn_const.clm_comp
        (hψ.continuousOn_fderiv_of_isOpen hV le_rfl)).isOpen_inter_preimage hV Units.isOpen
    have hv₀D : v₀ ∈ D :=
      ⟨hv₀, show IsUnit (Λ ∘L fderiv ℝ ψ v₀) by rw [hid]; exact isUnit_one⟩
    -- the inverse function theorem for `χ = Λ ∘ ψ` at `v₀`, where `Dχ(v₀) = id`
    have hstrict : HasStrictFDerivAt χ
        ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
          Euclid d →L[ℝ] Euclid d) v₀ := by
      refine (hχat v₀ hv₀).hasStrictFDerivAt' ?_ one_ne_zero
      have := hχderiv v₀ hv₀
      rw [hid] at this
      exact this
    let h := hstrict.toOpenPartialHomeomorph χ
    have hcoe : (h : Euclid d → Euclid d) = χ := rfl
    let S := h.source ∩ D
    have hSopen : IsOpen S := h.open_source.inter hDopen
    have hv₀S : v₀ ∈ S := ⟨hstrict.mem_toOpenPartialHomeomorph_source, hv₀D⟩
    let T := h.target ∩ h.symm ⁻¹' S
    have hTopen : IsOpen T := h.isOpen_inter_preimage_symm hSopen
    -- `h⁻¹` is `C¹` on `T`, where the derivative of `h` is invertible
    have hsymm : ∀ t ∈ T, ContDiffAt ℝ 1 h.symm t := by
      intro t ht
      have hs : h.symm t ∈ S := ht.2
      obtain ⟨u, hu⟩ := hs.2.2
      apply h.contDiffAt_symm ht.1 (f₀' := ContinuousLinearEquiv.unitsEquiv ℝ (Euclid d) u)
      · have he : ((ContinuousLinearEquiv.unitsEquiv ℝ (Euclid d) u : Euclid d ≃L[ℝ] Euclid d) :
            Euclid d →L[ℝ] Euclid d) = Λ ∘L fderiv ℝ ψ (h.symm t) := by
          ext1 x
          simp [ContinuousLinearEquiv.unitsEquiv_apply, hu]
        rw [he, hcoe]
        exact hχderiv _ hs.2.1
      · rw [hcoe]
        exact hχat _ hs.2.1
    obtain ⟨ε, hε, hεS⟩ := Metric.isOpen_iff.1 hSopen v₀ hv₀S
    refine ⟨Λ ⁻¹' T, fun y => h.symm (Λ y), ε, hε, hTopen.preimage Λ.continuous, ?_, ?_, ?_⟩
    · intro y hy
      exact ((hsymm (Λ y) hy).comp y Λ.contDiff.contDiffAt).contDiffWithinAt
    · intro y hy
      exact (hy.2 : h.symm (Λ y) ∈ S).2.1
    · intro v hv
      have hvS : v ∈ S := hεS (mem_ball.2 hv)
      have hleft : h.symm (h v) = v := h.left_inv hvS.1
      refine ⟨hvS.2.1, ⟨h.map_source hvS.1, ?_⟩, hleft⟩
      show h.symm (h v) ∈ S
      rw [hleft]
      exact hvS
  -- Step 3: a proper injective chart has a continuous inverse: `ψ v` close to `ψ v₀` forces `v`
  -- close to `v₀`.
  have hprox : ∀ (V : Set (Euclid d)) (W : Set (Euclid P)) (ψ : Euclid d → Euclid P)
      (v₀ : Euclid d), IsOpen W → ContinuousOn ψ V → InjOn ψ V →
      (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → v₀ ∈ V → ψ v₀ ∈ W →
      ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ v ∈ V, dist (ψ v) (ψ v₀) < ρ → dist v v₀ < ε := by
    intro V W ψ v₀ hW hψ hinj hprop hv₀ hv₀W ε hε
    obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.1 hW (ψ v₀) hv₀W
    -- `C = {v ∈ V : |ψ v - ψ v₀| ≤ r / 2, |v - v₀| ≥ ε}` is compact and `ψ v₀ ∉ ψ(C)`
    have hC : IsCompact ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) ∩ (ball v₀ ε)ᶜ) :=
      (hprop _ ((closedBall_subset_ball (by linarith)).trans hrW)
        (isCompact_closedBall _ _)).inter_right isOpen_ball.isClosed_compl
    have himg := hC.image_of_continuousOn (hψ.mono fun x hx => hx.1.1)
    have hnot : ψ v₀ ∉ ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) ∩ (ball v₀ ε)ᶜ) := by
      rintro ⟨w, ⟨⟨hwV, -⟩, hwb⟩, hw⟩
      exact hwb (by rw [hinj hwV hv₀ hw]; exact mem_ball_self hε)
    obtain ⟨ρ, hρ, hρC⟩ := Metric.isOpen_iff.1 himg.isClosed.isOpen_compl (ψ v₀) hnot
    refine ⟨min ρ (r / 2), lt_min hρ (by linarith), fun v hv hdist => ?_⟩
    by_contra hcon
    exact hρC (mem_ball.2 (lt_of_lt_of_le hdist (min_le_left _ _)))
      ⟨v, ⟨⟨hv, mem_closedBall.2 (lt_of_lt_of_le hdist (min_le_right _ _)).le⟩,
        fun hvb => hcon (mem_ball.1 hvb)⟩, rfl⟩
  -- Step 4: near each `p = ψ v₀ ∈ N`, `y ↦ P_{range Dψ(φ y)}` is a `C¹` extension of `P_N`.
  have hloc : ∀ p ∈ N, ∃ (U : Set (Euclid P)) (f : Euclid P → (Euclid P →L[ℝ] Euclid P)),
      IsOpen U ∧ p ∈ U ∧ ContDiffOn ℝ 1 f U ∧
        ∀ z ∈ N ∩ U, f z = (Submodule.span ℝ (tangentSpace N z)).starProjection := by
    intro p hp
    obtain ⟨V, W, ψ, hV, hW, hpW, hψ, hinj, himg, hprop, hDψ⟩ := hN p hp
    have hpV : p ∈ ψ '' V := by rw [himg]; exact ⟨hpW, hp⟩
    obtain ⟨v₀, hv₀, rfl⟩ := hpV
    have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by exact_mod_cast (by norm_num : (1 : ℕ) ≤ 2))
    have hDψ1 : ContDiffOn ℝ 1 (fun v => fderiv ℝ ψ v) V := hψ.fderiv_of_isOpen hV (by norm_num)
    obtain ⟨O₁, φ, ε, hε, hO₁, hφ, hφV, hφψ⟩ := hlinv V ψ v₀ hV hψ1 hv₀ (hDψ v₀ hv₀)
    obtain ⟨ρ, hρ, hρε⟩ := hprox V W ψ v₀ hW hψ1.continuousOn hinj hprop hv₀ hpW ε hε
    refine ⟨O₁ ∩ ball (ψ v₀) ρ ∩ W,
      fun y => (LinearMap.range (fderiv ℝ ψ (φ y) : Euclid d →ₗ[ℝ] Euclid P)).starProjection,
      (hO₁.inter isOpen_ball).inter hW,
      ⟨⟨(hφψ v₀ (by simpa using hε)).2.1, mem_ball_self hρ⟩, hpW⟩, ?_, ?_⟩
    · intro y hy
      have hφy : φ y ∈ V := hφV hy.1.1
      exact ((hproj _ (hDψ _ hφy)).comp y ((hDψ1.contDiffAt (hV.mem_nhds hφy)).comp y
        (hφ.contDiffAt (hO₁.mem_nhds hy.1.1)))).contDiffWithinAt
    · rintro z ⟨hzN, ⟨hzO, hzρ⟩, hzW⟩
      have hzV : z ∈ ψ '' V := by rw [himg]; exact ⟨hzW, hzN⟩
      obtain ⟨v, hv, rfl⟩ := hzV
      -- `T_{ψ v}N = range Dψ(v)`
      have hspan : Submodule.span ℝ (tangentSpace N (ψ v)) =
          LinearMap.range (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P) := by
        rw [Submission.chart_tangentSpace_eq_range_fderiv P d 2 N W V ψ v (by norm_num) hV hW hψ
          hinj himg hprop hDψ hv, ← ContinuousLinearMap.coe_coe, ← LinearMap.coe_range,
          Submodule.span_eq]
      show (LinearMap.range (fderiv ℝ ψ (φ (ψ v)) : Euclid d →ₗ[ℝ] Euclid P)).starProjection = _
      rw [(hφψ v (hρε v hv (mem_ball.1 hzρ))).2.2, hspan]
  -- Step 5: glue the local extensions by a smooth partition of unity on `O = ⋃ₚ Uₚ`.
  choose! U f hU hpU hf hfN using hloc
  let O : Set (Euclid P) := ⋃ p ∈ N, U p
  have hO : IsOpen O := isOpen_biUnion fun p hp => hU p hp
  have hNO : N ⊆ O := fun p hp => mem_biUnion hp (hpU p hp)
  let O' : TopologicalSpace.Opens (Euclid P) := ⟨O, hO⟩
  have : LocallyCompactSpace O' := ChartedSpace.locallyCompactSpace (Euclid P) O'
  let t : O' → Set (Euclid P →L[ℝ] Euclid P) := fun x =>
    if (x : Euclid P) ∈ N then {(Submodule.span ℝ (tangentSpace N x)).starProjection} else univ
  have ht : ∀ x, Convex ℝ (t x) := by
    intro x
    by_cases hx : (x : Euclid P) ∈ N
    · simp only [t, ite_eq_left hx]
      exact convex_singleton _
    · simp only [t, ite_eq_right hx]
      exact convex_univ
  obtain ⟨g, hg⟩ := exists_contMDiffMap_forall_mem_convex_of_local (n := 1)
    (modelWithCornersSelf ℝ (Euclid P)) ht fun x => by
      have hx : (x : Euclid P) ∈ ⋃ p ∈ N, U p := x.2
      obtain ⟨p, hp, hxp⟩ := mem_iUnion₂.1 hx
      refine ⟨Subtype.val ⁻¹' U p,
        (continuous_subtype_val.isOpen_preimage _ (hU p hp)).mem_nhds hxp, fun y => f p y,
        fun y hy => ?_, fun y hy => ?_⟩
      · exact ContMDiffAt.contMDiffWithinAt ((contMDiffAt_subtype_iff (U := O') (f := f p)).2
          (contMDiffAt_iff_contDiffAt.2 ((hf p hp).contDiffAt ((hU p hp).mem_nhds hy))))
      · by_cases hyN : (y : Euclid P) ∈ N
        · simp only [t, ite_eq_left hyN, mem_singleton_iff]
          exact hfN p hp y ⟨hyN, hy⟩
        · simp only [t, ite_eq_right hyN, mem_univ]
  refine ⟨O, fun y => if hy : y ∈ O then g ⟨y, hy⟩ else 0, hO, hNO, fun y hy => ?_, fun z hz => ?_⟩
  · have hgy : ContMDiffAt (modelWithCornersSelf ℝ (Euclid P))
        (modelWithCornersSelf ℝ (Euclid P →L[ℝ] Euclid P)) 1
        (fun x : O' => (fun y => if hy : y ∈ O then g ⟨y, hy⟩ else 0) (x : Euclid P))
        ⟨y, hy⟩ := by
      refine (g.contMDiff ⟨y, hy⟩).congr_of_eventuallyEq (Eventually.of_forall fun x => ?_)
      have hx : (x : Euclid P) ∈ O := x.2
      simp only [dite_eq_left hx]
    exact (contMDiffAt_iff_contDiffAt.1 ((contMDiffAt_subtype_iff (U := O')
      (f := fun y => if hy : y ∈ O then g ⟨y, hy⟩ else 0)).1 hgy)).contDiffWithinAt
  · have h1 := hg ⟨z, hNO hz⟩
    simp only [t, ite_eq_left hz, mem_singleton_iff] at h1
    show (if hy : z ∈ O then g ⟨z, hy⟩ else 0) = _
    rw [dite_eq_left (hNO hz)]
    exact h1

/-- **Simon Ch. 4, 2.7 and 3.14** (with Ch. 2, 5.9): if `V = v(M, θ)` is stationary in `N ∩ U`,
where `N` is an embedded `C²` submanifold with `(N̄ \ N) ∩ U = ∅` and `Hⁿ(M \ N) = 0`, then `V`
has generalized mean curvature `H` in `U`, bounded on compact subsets of `U`.  Extend
`z ↦ P_{T_zN}` to a `C¹` field `pr` on an open `O ⊇ N` and take `H` with
`H(x) = Σⱼ (Dpr(x)[p eⱼ])*(p eⱼ)` on `N ∩ U`, `p = p_{TₓM}`.  For `X ∈ C¹_c(U)`, the tangential
part `X^T` (equal to `pr·X` near `N`) is tangent to `N` on `N ∩ U`, so `δV(X^T) = 0` and
`δV(X) = δV(X − X^T)`.  At `Hⁿ`-a.e. `x ∈ M`, `x ∈ N` and `TₓM ⊆ TₓN`, so
`div_M(X − X^T)(x) = −X(x)·H(x)`; integrating against `θ` gives `δV(X) = −∫ X·H dμ_V`. -/
theorem Submission.meanCurvature_bounded_of_stationaryAlong : ∀ (P n d : ℕ) (U N : Set (Euclid P)) (R : IMRep U n), IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → μHE[n] (R.carrier \ N) = 0 → R.IsStationaryAlong N → R.HasLocallyBoundedMeanCurvature := by
  intro P n d U N R hU hN hNU hMN hstat
  -- the `C¹` extension `pr` of `z ↦ P_{T_zN}` to an open set `O ⊇ N`
  obtain ⟨O, pr, hO, hNO, hpr, hprN⟩ :=
    Submission.submanifold_tangentProjection_c1_extension P d N hN
  -- `p(x) = p_{TₓM}` is `Hⁿ⌞M`-a.e. strongly measurable, and `‖p(x)‖ ≤ 1`
  have hp : AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection)
      (μHE[n].restrict R.carrier) := Submission.imrep_approxTangent_starProjection_aesm P n U R
  -- `H` with `H(x) = Σⱼ (Dpr(x)[p eⱼ])*(p eⱼ)` on `N ∩ U`, measurable and bounded on compact
  -- subsets of `U`
  obtain ⟨H, hHm, hHb, hH⟩ := Submission.mcs_exists_meanCurvature_field P
    (μHE[n].restrict R.carrier) U N O pr _ hU hO hNO hpr hNU hp
    fun x => Submodule.starProjection_norm_le _
  -- `T_zN` is a linear subspace for `z ∈ N`, the range of `Dψ` in a chart
  have hTN : ∀ z ∈ N, ∃ T : Submodule ℝ (Euclid P), tangentSpace N z = T := by
    intro z hz
    obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, hψV, hproper, hDψ⟩ := hN z hz
    obtain ⟨v, hv, rfl⟩ : z ∈ ψ '' V := hψV ▸ ⟨hzW, hz⟩
    exact ⟨LinearMap.range (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P),
      Submission.chart_tangentSpace_eq_range_fderiv P d 2 N W V ψ v one_le_two hV hW hψ hinj hψV
        hproper hDψ hv⟩
  -- `C²` charts are `C¹` charts
  have hN1 : IsEmbeddedSubmanifold 1 d N := fun y hy => by
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, h⟩ := hN y hy
    exact ⟨V, W, ψ, hV, hW, hyW, hψ.of_le (by norm_num), h⟩
  -- `Hⁿ⌞M`-a.e. point lies in `N`, as `Hⁿ(M \ N) = 0`
  have hMN' : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ N := by
    rw [ae_restrict_iff' R.measurableSet_carrier]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMN] with x hx hxM
    by_contra hxN
    exact hx ⟨hxM, hxN⟩
  refine ⟨H, hHm.mono_ac (withDensity_absolutelyContinuous _ _),
    fun K hK hKU => (hHb K hK hKU).imp fun Λ hΛ => ae_of_all _ hΛ, fun X hX hXc hXU => ?_⟩
  -- the tangential part `X^T ∈ C¹_c(U)`, equal to `pr·X` near every point of `N`
  obtain ⟨XT, hXT, hXTc, hXTU, hXTN⟩ :=
    Submission.mcs_exists_c1_field_eq_proj_near P U N O pr X hU hO hNO hpr hNU hX hXc hXU
  -- `X^T(z) = P_{T_zN} X(z) ∈ T_zN` on `N ∩ U`, so `δV(X^T) = 0` by stationarity
  have hXT0 : R.firstVariation XT = 0 := by
    refine hstat XT hXT hXTc hXTU fun z hz => ?_
    obtain ⟨T, hT⟩ := hTN z hz.1
    have hmem : XT z ∈ Submodule.span ℝ (tangentSpace N z) := by
      rw [(hXTN z hz.1).eq_of_nhds, hprN z hz.1]
      exact Submodule.starProjection_apply_mem _ _
    rw [hT, Submodule.span_eq] at hmem
    rwa [hT]
  -- `δV(X) = δV(X^T) + δV(X − X^T) = δV(X − X^T)`
  have hsplit : R.firstVariation X = R.firstVariation (X - XT) := by
    have h := Submission.mcs_firstVariation_add P n U R XT (X - XT) hp hXT hXTc hXTU (hX.sub hXT)
      (hXc.sub hXTc) ((tsupport_sub X XT).trans (union_subset hXU hXTU))
    rwa [add_sub_cancel, hXT0, zero_add] at h
  -- at `Hⁿ⌞M`-a.e. `x`: `x ∈ M ∩ N` and `TₓM ⊆ TₓN`, so `div_M(X − X^T)(x) = −X(x)·H(x)`
  have hdiv : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      tangentialDivergence n R.carrier (X - XT) x = -inner ℝ (X x) (H x) := by
    filter_upwards [ae_restrict_mem R.measurableSet_carrier, hMN', R.orients]
      with x hxM hxN ⟨Q, hQ, _⟩
    have hex : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    have hTx : HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
      rw [approxTangentPlane, dite_eq_left hex]
      exact hex.choose_spec
    have hQS : approxTangentPlane n R.carrier x ≤ Submodule.span ℝ (tangentSpace N x) :=
      fun u hu => Submodule.subset_span (Submission.approxTangent_le_submanifold_tangentSpace P n d
        N R.carrier x _ hN1 hxN hMN hTx hu)
    have hY : (X - XT) =ᶠ[𝓝 x] fun y => X y - pr y (X y) :=
      (hXTN x hxN).mono fun y hy => by rw [Pi.sub_apply, hy]
    have hprx : DifferentiableAt ℝ pr x :=
      (hpr.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds (hNO hxN))
    rw [tangentialDivergence, Submission.mcs_trace_normal_part_eq_neg_inner P _ _ pr X (X - XT) x
      hQS (hprN x hxN) hprx (hX.differentiable one_ne_zero x) hY, hH x ⟨hxN, R.carrier_subset hxM⟩]
  -- integrate against `θ`: `∫_M θ div_M(X − X^T) dHⁿ = −∫ X·H dμ_V`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
  rw [hsplit, IMRep.firstVariation, IMRep.measure, integral_withDensity_eq_integral_toReal_smul hθ
    (ae_of_all _ fun x => ENNReal.natCast_lt_top _), ← integral_neg]
  refine integral_congr_ae ?_
  filter_upwards [hdiv] with x hx
  rw [hx, ENNReal.toReal_natCast, smul_eq_mul, mul_neg]

/-- **Simon 7.1.2** (chapter-07.txt lines 29–60, with README erratum 1).  For a representation
`R = (M, θ, ξ)` of `T`, `Hⁿ(M ∖ spt T) = 0`, hence `Hⁿ(M ∖ N) = 0` because `spt T ⊆ N`.
Comparing `T` with the competitors `φ_{t#}T` of 1.2 (2), (3), where `φ_t` preserves `N ∩ U` and
is the identity off `spt X` (Ch. 4, 2.1 with `U ∩ N` in place of `U`), shows that `v(M, θ)` is
stationary in `N ∩ U`; stationarity in `N ∩ U` then gives a generalized mean curvature in `U`
that is bounded on compact sets (Ch. 4, 2.7 and 3.14).  The hypothesis `ℓ ≤ k` is not used. -/
theorem Submission.minimizing_implies_stationary : MinimizingImpliesStationary := by
  intro n k ℓ _hℓk U N T hU hN hNcl hTN hmin hbdry R hR
  -- `μ_T(U ∖ spt T) = 0` and `spt T ⊆ N`.
  have hnull : μHE[n] (R.carrier \ N) = 0 :=
    measure_mono_null (Set.sdiff_subset_sdiff_right hTN)
      (Submission.imrep_carrier_sdiff_support_null (n + k) n U T R hU hR)
  have hstat : R.IsStationaryAlong N :=
    Submission.stationaryAlong_of_minimizing_in_submanifold (n + k) n (n + ℓ) U N T R hU hN hNcl
      hmin hbdry hR hnull
  exact ⟨hstat, Submission.meanCurvature_bounded_of_stationaryAlong (n + k) n (n + ℓ) U N R hU hN
    hNcl hnull hstat⟩
/-- **Approximate tangent planes of a bi-Lipschitz piece image** (Simon Ch. 3, 1.4, by the density
argument of Theorem 1.6): if `g : ℝⁿ → ℝᴾ` is `L`-Lipschitz, `A` is Borel,
`c‖a − a'‖ ≤ ‖g(a) − g(a')‖` on `A` (`c > 0`) and `g` is differentiable with injective derivative
on `A`, then for a.e. `b ∈ A`, `g(A)` has approximate tangent space `range Dg(b)` at `g(b)`.
At a density point `b` of `A` that is a Lebesgue point of the Jacobian `0 ≤ J_g ≤ Lⁿ`, the
injective area formula turns the blow-up integrals into
`∫ 1_A(b + rv) J_g(b + rv) f(r⁻¹(g(b + rv) − g(b))) dv`, which tends to
`J_g(b) ∫ f(Dg(b)v) dv = ∫_{range Dg(b)} f dHⁿ`. -/
theorem Submission.idtp_caf_piece_image_approxTangent_ae : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (A : Set (Euclid n)) (L : NNReal) (c : ℝ), 1 ≤ n → LipschitzWith L g → MeasurableSet A → 0 < c → (∀ a ∈ A, ∀ a' ∈ A, c * ‖a - a'‖ ≤ ‖g a - g a'‖) → (∀ a ∈ A, DifferentiableAt ℝ g a ∧ Injective (fderiv ℝ g a)) → ∀ᵐ a ∂(volume.restrict A), HasApproximateTangentSpaceAt n (g '' A) (g a) (LinearMap.range (fderiv ℝ g a : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n g A L c _ hg hA hc hco hdiff
  -- the area Jacobian `J = J_g` is Borel and nonnegative
  set J : Euclid n → ℝ := Poincare.SimonGMT.Chapter02.areaJacobianAt g with hJ_def
  have hJm : Measurable J := Poincare.SimonGMT.Chapter02.measurable_areaJacobianAt g
  have hJ0 : ∀ a, 0 ≤ J a := Poincare.SimonGMT.Chapter02.areaJacobianAt_nonneg g
  -- `Hⁿ(Dg(a)(S)) = J(a) λ(S)` for every `a` and every `S`
  have hlin : ∀ (a : Euclid n) (S : Set (Euclid n)),
      μHE[n] (fderiv ℝ g a '' S) = ENNReal.ofReal (J a) * volume S := by
    intro a S
    have h := LinearMap.euclideanHausdorffMeasure_image_eq_normDet_mul_volume
      (fderiv ℝ g a : Euclid n →ₗ[ℝ] Euclid P) S
    rw [finrank_euclideanSpace_fin, ContinuousLinearMap.coe_coe] at h
    rw [h, hJ_def, Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_normDet]
  -- `J ≤ Lⁿ`: `Dg(a)` is `L`-Lipschitz, so `J(a) λ(B̄₁(0)) = Hⁿ(Dg(a)(B̄₁(0))) ≤ Lⁿ λ(B̄₁(0))`
  have hJL : ∀ a, J a ≤ (L : ℝ) ^ n := by
    intro a
    have hTL : LipschitzWith L (fderiv ℝ g a) :=
      (fderiv ℝ g a).lipschitzWith.weaken (by
        rw [← NNReal.coe_le_coe, coe_nnnorm]
        exact norm_fderiv_le_of_lipschitz ℝ hg)
    have hle := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hTL.lipschitzOnWith (s := closedBall (0 : Euclid n) 1))
    rw [hlin, EuclideanSpace.euclideanHausdorffMeasure_eq_volume] at hle
    have hle' := (ENNReal.mul_le_mul_iff_left
      (measure_closedBall_pos volume (0 : Euclid n) one_pos).ne' measure_closedBall_lt_top.ne).1 hle
    rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_pow NNReal.zero_le_coe,
      ENNReal.ofReal_le_ofReal_iff (pow_nonneg NNReal.zero_le_coe n)] at hle'
    exact hle'
  -- `g` is injective on `A`, so the injective Lipschitz area formula holds on `A`
  have hinj : InjOn g A := by
    intro a ha a' ha' h
    have h1 := hco a ha a' ha'
    rw [h, sub_self, norm_zero, ← mul_zero c] at h1
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (le_of_mul_le_mul_left h1 hc))
  have harea : ∀ φ : Euclid P → ℝ≥0∞,
      ∫⁻ y in g '' A, φ y ∂μHE[n] = ∫⁻ x in A, ENNReal.ofReal (J x) * φ (g x) ∂volume := by
    intro φ
    have h := Poincare.SimonGMT.Chapter02.weighted_area_formula_lipschitz_injOn hg hA hinj φ
    rw [finrank_euclideanSpace_fin] at h
    exact h
  -- a.e. point of `A` is a density point of `A` and a Lebesgue point of the bounded Borel `J`
  have hdens := Besicovitch.ae_tendsto_measure_inter_div (volume : Measure (Euclid n)) A
  have hJloc : LocallyIntegrable J volume :=
    (locallyIntegrable_const ((L : ℝ) ^ n)).mono hJm.aestronglyMeasurable
      (Eventually.of_forall fun a => by
        rw [Real.norm_of_nonneg (hJ0 a), Real.norm_of_nonneg (pow_nonneg NNReal.zero_le_coe n)]
        exact hJL a)
  have hleb : ∀ᵐ b ∂(volume : Measure (Euclid n)),
      Tendsto (fun ρ : ℝ => ⨍ a in closedBall b ρ, ‖J a - J b‖ ∂volume) (𝓝[>] 0) (𝓝 0) := by
    filter_upwards [(Besicovitch.vitaliFamily
      (volume : Measure (Euclid n))).ae_tendsto_average_norm_sub hJloc] with b hb
    exact hb.comp (Besicovitch.tendsto_filterAt volume b)
  filter_upwards [ae_restrict_mem hA, hdens, ae_restrict_of_ae hleb] with b hbA hbdens hbleb
  obtain ⟨hgb, hinjb⟩ := hdiff b hbA
  have hcob : ∀ a ∈ A, c * ‖a - b‖ ≤ ‖g a - g b‖ := fun a ha => hco a ha b hbA
  -- at a density point, `c‖v‖ ≤ ‖Dg(b)v‖`
  have hγ := Submission.pit_fderiv_lower_bound_of_density P n g A c b hc hcob hgb hbdens
  refine ⟨?_, fun f => ?_⟩
  · rw [LinearMap.finrank_range_of_inj hinjb, finrank_euclideanSpace_fin]
  · -- `∫_{range Dg(b)} f dHⁿ = J(b) ∫ f(Dg(b)v) dv`
    rw [Submission.pit_setIntegral_range_linear P n (fderiv ℝ g b) (J b) f (hJ0 b) (hlin b)
      (map_continuous f)]
    -- the rescaled area integrals converge to it, and equal the blow-up integrals for `r > 0`
    refine (Submission.idtp_caf_rescaled_integral_tendsto P n g A J ((L : ℝ) ^ n) c b f
      hg.continuous hA hJm (fun a => ⟨hJ0 a, hJL a⟩) hc hcob hgb hγ hbdens hbleb
      (map_continuous f) f.hasCompactSupport).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
    exact (Submission.pit_blowUp_image_setIntegral_eq_rescaled P n g A J b r f hg.continuous hA
      hJm hJ0 harea hr (map_continuous f)).symm
/-- **Approximate tangent planes along a bi-Lipschitz piece** (Simon Ch. 3, 1.4–1.5).  Let
`M ⊆ ℝᴾ` be Borel with `Hⁿ(M ∩ K) < ∞` for compact `K`, and `g : ℝⁿ → ℝᴾ` Lipschitz with
`c‖a − a'‖ ≤ ‖g a − g a'‖` on the Borel set `A`, differentiable with injective derivative on `A`,
and `g(A) ⊆ M`.  Then `T_{g(a)}M = range Dg(a)` for Lebesgue-a.e. `a ∈ A`: `g(A) ⊆ M` is Borel and
locally `Hⁿ`-finite, so `g(A)` and `M` have the same approximate tangent planes `Hⁿ`-a.e. on
`g(A)`; this pulls back to a.e. `a ∈ A`, where `g(A)` has approximate tangent space
`range Dg(a)` at `g(a)`. -/
theorem Submission.idtp_caf_piece_approxTangentPlane_ae : ∀ (P n : ℕ) (M : Set (Euclid P)) (g : Euclid n → Euclid P) (A : Set (Euclid n)) (L : NNReal) (c : ℝ), 1 ≤ n → MeasurableSet M → (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → LipschitzWith L g → MeasurableSet A → 0 < c → (∀ a ∈ A, ∀ a' ∈ A, c * ‖a - a'‖ ≤ ‖g a - g a'‖) → (∀ a ∈ A, DifferentiableAt ℝ g a ∧ Injective (fderiv ℝ g a)) → g '' A ⊆ M → ∀ᵐ a ∂(volume.restrict A), approxTangentPlane n M (g a) = LinearMap.range (fderiv ℝ g a : Euclid n →ₗ[ℝ] Euclid P) := by
  intro P n M g A L c hn hM hMfin hg hA hc hlow hdiff hAM
  -- Step 1: `g(A)` is Borel, and `Hⁿ⌞g(A)`-a.e. properties hold at `g a` for a.e. `a ∈ A`
  obtain ⟨hgA, hpull⟩ :=
    Submission.ptd_piece_image_measurable_ae_pullback P n g A L c hg hA hc hlow
  -- Step 2: `g(A) ⊆ M` is locally `Hⁿ`-finite
  have hgAfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ → μHE[n] (g '' A ∩ K) ≠ ∞ :=
    fun K hK _ => ne_top_of_le_ne_top (hMfin K hK) (measure_mono (inter_subset_inter_left K hAM))
  -- Step 3: `g(A)` and `M` have the same approximate tangent planes `Hⁿ⌞g(A)`-a.e.
  have htrans : ∀ᵐ y ∂(μHE[n].restrict (g '' A)), ∀ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (g '' A) y Q ↔ HasApproximateTangentSpaceAt n M y Q := by
    rw [ae_restrict_iff' hgA]
    filter_upwards [Submission.doraggt_ae_approxTangent_transfer P n univ (g '' A) M isOpen_univ
      hgA hM hgAfin fun K hK _ => hMfin K hK] with y hy hyA using hy (mem_univ y) hyA (hAM hyA)
  -- Step 4: pull back to a.e. `a ∈ A`; step 5: the tangent plane of the piece at `g a`
  filter_upwards [hpull _ htrans,
    Submission.idtp_caf_piece_image_approxTangent_ae P n g A L c hn hg hA hc hlow hdiff]
    with a hQ hT
  -- Step 6: `range Dg(a)` is the approximate tangent space of `M` at `g a`
  exact Submission.dpf_itt_approxTangentPlane_eq P n M (g a) _ ((hQ _).1 hT)
/-- **Fibre sums of `Hⁿ`-a.e. equal weights agree `Lⁿ`-a.e.** (Simon Ch. 2, 1.8(i): Lipschitz
images of `Hⁿ`-null sets are `Hⁿ`-null).  Let `S ⊆ V`, `F = G` on `V` with `G` Lipschitz, and
`h = h'` `Hⁿ⌞S`-a.e.  Enlarge `{h ≠ h'}` to a Borel `Hⁿ⌞S`-null set `N`; then `Hⁿ(N ∩ S) = 0`, so
`F(N ∩ S) = G(N ∩ S)` is `Hⁿ = Lⁿ`-null.  For `y ∉ F(N ∩ S)` every `x ∈ S` with `F(x) = y` lies
outside `N`, so `h(x) = h'(x)` and the fibre sums `Σ_{x ∈ S, F(x) = y}` of `h` and `h'` agree. -/
theorem Submission.idtp_caf_paf_fiberSum_ae_congr : ∀ (P n : ℕ) (S V : Set (Euclid P)) (F G : Euclid P → Euclid n) (LG : NNReal) (h h' : Euclid P → ℝ≥0∞), S ⊆ V → LipschitzWith LG G → EqOn F G V → h =ᵐ[μHE[n].restrict S] h' → (fun y : Euclid n => ∑' x : ↥(S ∩ F ⁻¹' {y}), h x) =ᵐ[volume] (fun y : Euclid n => ∑' x : ↥(S ∩ F ⁻¹' {y}), h' x) := by
  intro P n S V F G LG h h' hSV hG hFG hh
  -- a Borel `Hⁿ⌞S`-null set `N ⊇ {h ≠ h'}`; then `Hⁿ(N ∩ S) = 0`
  obtain ⟨N, hNsub, hNmeas, hN0⟩ := exists_measurable_superset_of_null (ae_iff.1 hh)
  rw [Measure.restrict_apply hNmeas] at hN0
  -- `F(N ∩ S) = G(N ∩ S)` is `Hⁿ`-null (Lipschitz image), i.e. `Lⁿ`-null
  have hFG' : F '' (N ∩ S) = G '' (N ∩ S) := image_congr fun x hx => hFG (hSV hx.2)
  have hM : volume (F '' (N ∩ S)) = 0 := by
    rw [hFG', ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    refine le_antisymm ?_ zero_le
    calc μHE[n] (G '' (N ∩ S)) ≤ (LG : ℝ≥0∞) ^ n * μHE[n] (N ∩ S) :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            hG.lipschitzOnWith
      _ = 0 := by rw [hN0, mul_zero]
  -- off `F(N ∩ S)` every fibre point lies outside `N`, where `h = h'`
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 hM] with y hy
  refine tsum_congr fun x => ?_
  by_contra hne
  exact hy ⟨x, ⟨hNsub hne, x.2.1⟩, x.2.2⟩
/-- **Weighted area formula, fibre side** (Simon Ch. 2, §3, (3.4)–(3.5), for the Lipschitz map
`Φ : ℝⁿ → ℝⁿ`).  Let `g` be continuous and injective on the Borel set `A`, let `F ∘ g = Φ` on `A`
with `Φ` Lipschitz, and let `h ≥ 0` be Borel.  Then `y ↦ Σ_{x ∈ g(A), F(x) = y} h(x)` is
`Lⁿ`-a.e. measurable and its integral is `∫_A |det DΦ(a)| h(g(a)) dLⁿ(a)`.  The carrier fibre
over `y` is `g(A ∩ Φ⁻¹{y})`, so the fibre sum is `Σ_{a ∈ A, Φ(a) = y} h(g(a))`.  The formula for
`Φ` is proved in place from Mathlib's change of variables, as the SimonGMT area formula is not
available in this file.  Off the null images of the non-differentiability set (Rademacher and
the Lipschitz image bound) and of the critical set (Sard), the fibre sum splits over a countable
partition of `A` into pieces on which `Φ` is injective, and on each piece the injective change
of variables formula applies. -/
theorem Submission.idtp_caf_paf_fiber_side : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (A : Set (Euclid n)) (F : Euclid P → Euclid n) (Φ : Euclid n → Euclid n) (LΦ : NNReal) (h : Euclid P → ℝ≥0∞), Continuous g → MeasurableSet A → InjOn g A → LipschitzWith LΦ Φ → (∀ a ∈ A, F (g a) = Φ a) → Measurable h → AEMeasurable (fun y : Euclid n => ∑' x : ↥(g '' A ∩ F ⁻¹' {y}), h x) volume ∧ ∫⁻ y, (∑' x : ↥(g '' A ∩ F ⁻¹' {y}), h x) ∂volume = ∫⁻ a in A, ENNReal.ofReal |LinearMap.det (fderiv ℝ Φ a : Euclid n →ₗ[ℝ] Euclid n)| * h (g a) ∂volume := by
  intro P n g A F Φ LΦ h hg hA hgA hΦ hFg hh
  -- the weight `w = h ∘ g` on the parameter side is Borel
  set w : Euclid n → ℝ≥0∞ := fun a => h (g a)
  have hw : Measurable w := hh.comp hg.measurable
  -- `g(A) ∩ F⁻¹{y} = g(A ∩ Φ⁻¹{y})`, and `tsum_image` reindexes the fibre sum
  have hfib : ∀ y, (∑' x : ↥(g '' A ∩ F ⁻¹' {y}), h x) = ∑' a : ↥(A ∩ Φ ⁻¹' {y}), w a := by
    intro y
    have hset : g '' A ∩ F ⁻¹' {y} = g '' (A ∩ Φ ⁻¹' {y}) := by
      ext x
      simp only [mem_inter_iff, mem_image, mem_preimage, mem_singleton_iff]
      constructor
      · rintro ⟨⟨a, ha, rfl⟩, hy⟩
        exact ⟨a, ⟨ha, (hFg a ha).symm.trans hy⟩, rfl⟩
      · rintro ⟨a, ⟨ha, hy⟩, rfl⟩
        exact ⟨⟨a, ha, rfl⟩, (hFg a ha).trans hy⟩
    rw [hset, tsum_image h (hgA.mono inter_subset_left)]
  simp only [hfib]
  -- `D`: differentiability points of `Φ`; `s`: the points of `A ∩ D` with `det DΦ ≠ 0`
  set D : Set (Euclid n) := {x | DifferentiableAt ℝ Φ x}
  have hDm : MeasurableSet D := measurableSet_of_differentiableAt ℝ Φ
  have hdetm : Measurable fun x => (fderiv ℝ Φ x).det :=
    ContinuousLinearMap.continuous_det.measurable.comp (measurable_fderiv ℝ Φ)
  set s : Set (Euclid n) := A ∩ D ∩ {x | (fderiv ℝ Φ x).det ≠ 0}
  have hsm : MeasurableSet s := (hA.inter hDm).inter (hdetm (measurableSet_singleton 0).compl)
  -- precision `r B` with `r B * ‖B⁻¹‖ < 1` whenever `B` is invertible
  let r : (Euclid n →L[ℝ] Euclid n) → NNReal := fun B =>
    if hB : B.det ≠ 0 then
      (‖((B.toContinuousLinearEquivOfDetNeZero hB).symm : Euclid n →L[ℝ] Euclid n)‖₊ + 1)⁻¹
    else 1
  have rpos : ∀ B, r B ≠ 0 := by
    intro B
    simp only [r]
    split_ifs
    · exact inv_ne_zero (by positivity)
    · exact one_ne_zero
  -- a countable measurable partition of `s` into pieces `S k` on which `Φ` is close to `B k`
  obtain ⟨t, B, ht_disj, ht_meas, hst, happrox, hB⟩ :=
    exists_partition_approximatesLinearOn_of_hasFDerivWithinAt Φ s (fderiv ℝ Φ)
      (fun x hx => (hx.1.2 : DifferentiableAt ℝ Φ x).hasFDerivAt.hasFDerivWithinAt) r rpos
  set S : ℕ → Set (Euclid n) := fun k => s ∩ t k
  have hSm : ∀ k, MeasurableSet (S k) := fun k => hsm.inter (ht_meas k)
  have hSdisj : Pairwise (Disjoint on S) := fun i j hij =>
    (ht_disj hij).mono inter_subset_right inter_subset_right
  have hSU : ⋃ k, S k = s := by
    simp only [S, ← inter_iUnion]
    exact inter_eq_left.mpr hst
  have hSder : ∀ k, ∀ x ∈ S k, HasFDerivWithinAt Φ (fderiv ℝ Φ x) (S k) x := fun k x hx =>
    (hx.1.1.2 : DifferentiableAt ℝ Φ x).hasFDerivAt.hasFDerivWithinAt
  -- `Φ` is injective on each piece: `B k = DΦ(z)` is invertible and `r (B k) * ‖(B k)⁻¹‖ < 1`
  have hSinj : ∀ k, InjOn Φ (S k) := by
    intro k x hx y hy hxy
    obtain ⟨z, hz, hBz⟩ := hB ⟨x, hx.1⟩ k
    have hdet : (B k).det ≠ 0 := hBz ▸ hz.2
    set e := (B k).toContinuousLinearEquivOfDetNeZero hdet
    set N : ℝ := ‖(e.symm : Euclid n →L[ℝ] Euclid n)‖
    have hr : ((r (B k) : NNReal) : ℝ) = (N + 1)⁻¹ := by
      simp only [r, dite_eq_left hdet, NNReal.coe_inv, NNReal.coe_add, coe_nnnorm,
        NNReal.coe_one, N, e]
    have happ := happrox k x hx y hy
    rw [hxy, sub_self, zero_sub, norm_neg, hr] at happ
    have h1 : ‖x - y‖ ≤ N * ‖B k (x - y)‖ := by
      have hxy' : e.symm (B k (x - y)) = x - y := by
        rw [show B k (x - y) = e (x - y) from rfl, ContinuousLinearEquiv.symm_apply_apply]
      calc ‖x - y‖ = ‖(e.symm : Euclid n →L[ℝ] Euclid n) (B k (x - y))‖ := by
              rw [ContinuousLinearEquiv.coe_coe, hxy']
        _ ≤ N * ‖B k (x - y)‖ := (e.symm : Euclid n →L[ℝ] Euclid n).le_opNorm _
    have hN : 0 ≤ N := norm_nonneg _
    have h2 : ‖x - y‖ ≤ N * ((N + 1)⁻¹ * ‖x - y‖) :=
      h1.trans (mul_le_mul_of_nonneg_left happ hN)
    have h3 : ‖x - y‖ ≤ 0 := by
      have hN1 : 0 < N + 1 := by linarith
      have h4 : N * ((N + 1)⁻¹ * ‖x - y‖) = ‖x - y‖ - (N + 1)⁻¹ * ‖x - y‖ := by
        field_simp
        ring
      rw [h4] at h2
      have h5 : (N + 1)⁻¹ * ‖x - y‖ ≤ 0 := by linarith
      have h6 : 0 < (N + 1)⁻¹ := inv_pos.mpr hN1
      nlinarith [norm_nonneg (x - y)]
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h3)
  -- `G k y`: the fibre sum of `w` over `S k ∩ Φ⁻¹{y}`, which has at most one point
  set G : ℕ → Euclid n → ℝ≥0∞ := fun k y => ∑' a, (S k ∩ Φ ⁻¹' {y}).indicator w a
  have hG_apply : ∀ k, ∀ x ∈ S k, G k (Φ x) = w x := by
    intro k x hx
    simp only [G]
    rw [tsum_eq_single x]
    · exact indicator_of_mem (show x ∈ S k ∩ Φ ⁻¹' {Φ x} from ⟨hx, rfl⟩) w
    · intro a hax
      exact indicator_of_notMem (fun ha => hax (hSinj k ha.1 hx ha.2)) w
  have hG_zero : ∀ k y, y ∉ Φ '' S k → G k y = 0 := by
    intro k y hy
    simp only [G]
    exact (tsum_congr fun a => indicator_of_notMem (fun ha => hy ⟨a, ha.1, ha.2⟩) w).trans
      tsum_zero
  have hG_meas : ∀ k, Measurable (G k) := by
    intro k
    have hemb := measurableEmbedding_of_fderivWithin (hSm k) (hSder k) (hSinj k)
    have hGe : G k = Function.extend ((S k).domRestrict Φ) (fun x => w x) 0 := by
      funext y
      by_cases hy : ∃ x : S k, (S k).domRestrict Φ x = y
      · obtain ⟨x, rfl⟩ := hy
        rw [hemb.injective.extend_apply]
        exact hG_apply k x x.2
      · rw [extend_apply' _ _ _ hy, hG_zero k y]
        · rfl
        · rintro ⟨x, hx, rfl⟩
          exact hy ⟨⟨x, hx⟩, rfl⟩
    rw [hGe]
    exact hemb.measurable_extend (hw.comp measurable_subtype_coe) measurable_const
  -- injective change of variables on each piece
  have hG_int : ∀ k, ∫⁻ y, G k y =
      ∫⁻ x in S k, ENNReal.ofReal |(fderiv ℝ Φ x).det| * w x := by
    intro k
    rw [← setLIntegral_eq_of_support_subset (s := Φ '' S k) (fun y hy => by
        by_contra hy'
        exact hy (hG_zero k y hy')),
      lintegral_image_eq_lintegral_abs_det_fderiv_mul volume (hSm k) (hSder k) (hSinj k)]
    exact setLIntegral_congr_fun (hSm k) (fun x hx => by rw [hG_apply k x hx])
  -- null images: of `Dᶜ` (Rademacher, Lipschitz image bound) and of the critical set (Sard)
  have hDc : volume Dᶜ = 0 := ae_iff.mp (hΦ.ae_differentiableAt (μ := volume))
  have hnull1 : volume (Φ '' Dᶜ) = 0 := by
    have h1 := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hΦ.lipschitzOnWith (s := Dᶜ))
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hDc, mul_zero] at h1
    exact nonpos_iff_eq_zero.mp h1
  have hnull2 : volume (Φ '' (A ∩ D ∩ {x | (fderiv ℝ Φ x).det = 0})) = 0 :=
    addHaar_image_eq_zero_of_det_fderivWithin_eq_zero volume
      (fun x hx => (hx.1.2 : DifferentiableAt ℝ Φ x).hasFDerivAt.hasFDerivWithinAt)
      (fun x hx => hx.2)
  -- off these null sets, the fibre sum over `A` splits over the pieces
  have hae : ∀ᵐ y ∂volume, (∑' a : ↥(A ∩ Φ ⁻¹' {y}), w a) = ∑' k, G k y := by
    filter_upwards [measure_eq_zero_iff_ae_notMem.mp (measure_union_null hnull1 hnull2)] with y hy
    rw [tsum_subtype (A ∩ Φ ⁻¹' {y}) w]
    simp only [G]
    rw [ENNReal.tsum_comm]
    refine tsum_congr fun a => ?_
    by_cases ha : a ∈ A ∩ Φ ⁻¹' {y}
    · have haD : a ∈ D := by
        by_contra hD
        exact hy (Or.inl ⟨a, hD, ha.2⟩)
      have hadet : (fderiv ℝ Φ a).det ≠ 0 := by
        intro h0
        exact hy (Or.inr ⟨a, ⟨⟨ha.1, haD⟩, h0⟩, ha.2⟩)
      have has : a ∈ s := ⟨⟨ha.1, haD⟩, hadet⟩
      obtain ⟨k, hk⟩ := mem_iUnion.mp (hst has)
      rw [indicator_of_mem ha, tsum_eq_single k]
      · exact (indicator_of_mem (show a ∈ S k ∩ Φ ⁻¹' {y} from ⟨⟨has, hk⟩, ha.2⟩) w).symm
      · intro j hj
        exact indicator_of_notMem (fun haj => Set.disjoint_left.mp (ht_disj hj) haj.1.2 hk) w
    · rw [indicator_of_notMem ha]
      exact ((tsum_congr fun k => indicator_of_notMem
        (fun hak => ha ⟨hak.1.1.1.1, hak.2⟩) w).trans tsum_zero).symm
  have hGsum : Measurable fun y => ∑' k, G k y := Measurable.tsum hG_meas
  refine ⟨hGsum.aemeasurable.congr (Filter.EventuallyEq.symm hae), ?_⟩
  rw [lintegral_congr_ae hae, lintegral_tsum (fun k => (hG_meas k).aemeasurable)]
  simp only [hG_int]
  rw [← lintegral_iUnion hSm hSdisj, hSU]
  -- the integrand vanishes a.e. on `A \ s`
  rw [← inter_eq_left.mpr (show s ⊆ A from fun x hx => hx.1.1), ← setLIntegral_indicator hsm]
  apply lintegral_congr_ae
  filter_upwards [ae_restrict_of_ae (hΦ.ae_differentiableAt (μ := volume)), ae_restrict_mem hA]
    with x hxD hxA
  by_cases hxs : x ∈ s
  · rw [indicator_of_mem hxs]
  · rw [indicator_of_notMem hxs]
    have h0 : (fderiv ℝ Φ x).det = 0 := by
      by_contra h0
      exact hxs ⟨⟨hxA, hxD⟩, h0⟩
    have h0' : LinearMap.det (fderiv ℝ Φ x : Euclid n →ₗ[ℝ] Euclid n) = 0 := h0
    simp [h0']
/-- **Carrier side of the area formula on one piece** (Simon Ch. 3, 2.4–2.5, with the injective
area formula of Ch. 2, §3).  Let `g : ℝⁿ → ℝᴾ` be Lipschitz, injective on the Borel set `A` and
differentiable at every point of `A`, let `F = G` on an open `V ⊇ g(A)` with `F` differentiable on
`g(A)`, and let `T(g(a)) = range Dg(a)` for a.e. `a ∈ A`.  With `u` the standard orthonormal basis
of `T(x)` and `J_T(x) = √det(DF(x)uᵢ · DF(x)uⱼ)`, every `h ≥ 0` has
`∫_{g(A)} J_T h dHⁿ = ∫_A |det D(G ∘ g)| h ∘ g dLⁿ`.

The area formula is proved inline.  `J L = √det(L eᵢ · L eⱼ)` is the Jacobian of a linear
`L : ℝᵐ → Y`; for injective `L`, `L = ι ∘ M` with `ι` an isometry and `J L = |det M|`, so
`Hᵐ(L(S)) = J L · Hᵐ(S)`.  On pieces where `g` is close to an injective linear map, Hausdorff
measure of the image is comparable to `J`, giving `Hⁿ(g(E)) = ∫_E J(Dg)` where `Dg` is injective;
where `Dg` is not injective, the graphs `x ↦ (g x, εx)` show `Hⁿ(g(E)) = 0` as `ε → 0`.  A.e. on
`A`, `D(G ∘ g)(a) = DF(g(a)) ∘ Dg(a)` and comparing volumes of the image of the unit ball gives
`|det D(G ∘ g)(a)| = J_T(g(a)) · J(Dg(a))`. -/
theorem Submission.idtp_caf_paf_carrier_side : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (A : Set (Euclid n)) (Lg : NNReal) (V : Set (Euclid P)) (F G : Euclid P → Euclid n) (T : Euclid P → Submodule ℝ (Euclid P)) (h : Euclid P → ℝ≥0∞), LipschitzWith Lg g → MeasurableSet A → InjOn g A → (∀ a ∈ A, DifferentiableAt ℝ g a) → IsOpen V → g '' A ⊆ V → EqOn F G V → (∀ x ∈ g '' A, DifferentiableAt ℝ F x) → (∀ᵐ a ∂(volume.restrict A), T (g a) = LinearMap.range (fderiv ℝ g a : Euclid n →ₗ[ℝ] Euclid P)) → ∫⁻ x in g '' A, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (T x)) => inner ℝ (fderiv ℝ F x (stdOrthonormalBasis ℝ (T x) i)) (fderiv ℝ F x (stdOrthonormalBasis ℝ (T x) j))))) * h x ∂μHE[n] = ∫⁻ a in A, ENNReal.ofReal |LinearMap.det (fderiv ℝ (G ∘ g) a : Euclid n →ₗ[ℝ] Euclid n)| * h (g a) ∂volume := by
  classical
  -- the Jacobian `J L = √det(L eᵢ · L eⱼ)` of a linear map `L : ℝᵐ → Y`
  obtain ⟨Jac, hJac⟩ : ∃ Jac : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y],
      (EuclideanSpace ℝ (Fin m) →L[ℝ] Y) → ℝ,
      ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
        (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y),
        Jac L = Real.sqrt (Matrix.det (Matrix.of fun i j : Fin m =>
          inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1)))) :=
    ⟨fun {m} {_} [_] [_] L => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin m =>
      inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1)))),
      fun _ => rfl⟩
  have jac_nonneg : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), 0 ≤ Jac L := by
    intro m Y _ _ L
    rw [hJac]
    exact Real.sqrt_nonneg _
  -- an injective `L` factors as `ι ∘ M` with `ι` an isometry, and `J L = |det M| ≠ 0`
  have jac_factor : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), Injective L →
      ∃ (ι : EuclideanSpace ℝ (Fin m) →ₗᵢ[ℝ] Y)
        (M : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] EuclideanSpace ℝ (Fin m)),
        (∀ x, ι (M x) = L x) ∧ Jac L = |LinearMap.det M| ∧ LinearMap.det M ≠ 0 := by
    intro m Y _ _ _ L hL
    have hW : Module.finrank ℝ (LinearMap.range (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y)) = m := by
      rw [LinearMap.finrank_range_of_inj hL, finrank_euclideanSpace_fin]
    obtain ⟨u⟩ : Nonempty (OrthonormalBasis (Fin m) ℝ
        (LinearMap.range (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y))) :=
      ⟨(stdOrthonormalBasis ℝ _).reindex (finCongr hW)⟩
    obtain ⟨ι, M, hιM⟩ : ∃ (ι : EuclideanSpace ℝ (Fin m) →ₗᵢ[ℝ] Y)
        (M : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] EuclideanSpace ℝ (Fin m)), ∀ x, ι (M x) = L x := by
      refine ⟨(LinearMap.range (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y)).subtypeₗᵢ.comp
          u.repr.symm.toLinearIsometry,
        u.repr.toLinearEquiv.toLinearMap ∘ₗ (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y).rangeRestrict,
        fun x => ?_⟩
      change ((u.repr.symm (u.repr ((L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y).rangeRestrict x)) :
        LinearMap.range (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y)) : Y) = L x
      rw [LinearIsometryEquiv.symm_apply_apply]
      rfl
    have hdetM : LinearMap.det M ≠ 0 := by
      rw [Ne, LinearMap.det_eq_zero_iff_ker_ne_bot, not_not, LinearMap.ker_eq_bot]
      intro x y hxy
      apply hL
      rw [← hιM x, ← hιM y, hxy]
    refine ⟨ι, M, hιM, ?_, hdetM⟩
    have hgram : (Matrix.of fun i j : Fin m =>
        inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1))) =
        Matrix.transpose (LinearMap.toMatrix (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
          (EuclideanSpace.basisFun (Fin m) ℝ).toBasis M) *
          LinearMap.toMatrix (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
            (EuclideanSpace.basisFun (Fin m) ℝ).toBasis M := by
      ext i j
      rw [Matrix.of_apply, ← hιM, ← hιM, LinearIsometry.inner_map_map, Matrix.mul_apply,
        PiLp.inner_apply]
      refine Finset.sum_congr rfl fun k _ => ?_
      simp only [Matrix.transpose_apply, LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis,
        OrthonormalBasis.coe_toBasis_repr_apply, EuclideanSpace.basisFun_apply,
        EuclideanSpace.basisFun_repr, RCLike.inner_apply, conj_trivial]
      ring
    rw [hJac, hgram, Matrix.det_mul, Matrix.det_transpose, LinearMap.det_toMatrix, ← sq,
      Real.sqrt_sq_eq_abs]
  -- the linear area formula `Hᵈ(L(S)) = J L · Hᵈ(S)` for injective `L` (`d = m`)
  have linear_area : ∀ {m d : ℕ}, m = d → ∀ {Y : Type} [NormedAddCommGroup Y]
      [InnerProductSpace ℝ Y] [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), Injective L →
      ∀ (s : Set (EuclideanSpace ℝ (Fin m))), μHE[d] (L '' s) = ENNReal.ofReal (Jac L) * μHE[d] s := by
    intro m d hd Y _ _ _ _ _ L hL s
    subst hd
    obtain ⟨ι, M, hιM, hJ, -⟩ := jac_factor L hL
    have himage : L '' s = ι '' (M '' s) := by
      rw [image_image]
      exact image_congr fun x _ => (hιM x).symm
    rw [himage, ι.isometry.euclideanHausdorffMeasure_image,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_image_linearMap, hJ]
  have jac_eq_zero : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), ¬ Injective L → Jac L = 0 := by
    intro m Y _ _ L hL
    obtain ⟨w, hw0, hLw⟩ : ∃ w, w ≠ 0 ∧ L w = 0 := by
      have hker : LinearMap.ker (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y) ≠ ⊥ := fun h =>
        hL (LinearMap.ker_eq_bot.mp h)
      obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
      exact ⟨w, hw0, hw⟩
    have hdet : Matrix.det (Matrix.of fun i j : Fin m =>
        inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1))) = 0 := by
      rw [← Matrix.exists_mulVec_eq_zero_iff]
      refine ⟨fun j => w j, ?_, ?_⟩
      · intro h
        apply hw0
        ext j
        exact congrFun h j
      · ext i
        have hw : w = ∑ j, w j • EuclideanSpace.single j (1 : ℝ) := by
          ext k
          simp [Finset.sum_apply, Pi.single_apply]
        have : ∑ j, inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1)) * w j
            = inner ℝ (L (EuclideanSpace.single i 1)) (L w) := by
          conv_rhs => rw [hw]
          simp [map_sum, map_smul, inner_sum, inner_smul_right, mul_comm]
        simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply]
        rw [this, hLw, inner_zero_right]
    rw [hJac, hdet, Real.sqrt_zero]
  have jac_pos : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), Injective L → 0 < Jac L := by
    intro m Y _ _ _ L hL
    obtain ⟨ι, M, -, hJ, hdet⟩ := jac_factor L hL
    rw [hJ]
    exact abs_pos.mpr hdet
  have continuous_jac : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y],
      Continuous (fun L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y => Jac L) := by
    intro m Y _ _
    simp only [hJac]
    apply Real.continuous_sqrt.comp
    apply Continuous.matrix_det
    refine continuous_pi fun i => continuous_pi fun j => ?_
    simp only [Matrix.of_apply]
    exact ((ContinuousLinearMap.apply ℝ Y _).continuous).inner
      ((ContinuousLinearMap.apply ℝ Y _).continuous)
  -- comparing pairwise distances compares Hausdorff measures of images
  have image_le_of_dist_le : ∀ {X Z : Type} [MetricSpace X] [MeasurableSpace X] [BorelSpace X]
      [MetricSpace Z] [MeasurableSpace Z] [BorelSpace Z] [Nonempty X]
      {f g : X → Z} {s : Set X} {K : NNReal}, InjOn g s →
      (∀ x ∈ s, ∀ y ∈ s, dist (f x) (f y) ≤ K * dist (g x) (g y)) →
      ∀ (d : ℕ), μHE[d] (f '' s) ≤ (K : ℝ≥0∞) ^ d * μHE[d] (g '' s) := by
    intro X Z _ _ _ _ _ _ _ f g s K hg hfg d
    have hh : LipschitzOnWith K (f ∘ invFunOn g s) (g '' s) := by
      rw [lipschitzOnWith_iff_dist_le_mul]
      rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
      simpa only [comp_apply, hg.leftInvOn_invFunOn hx,
        hg.leftInvOn_invFunOn hy] using hfg x hx y hy
    have himage : (f ∘ invFunOn g s) '' (g '' s) = f '' s := by
      rw [image_comp, hg.invFunOn_image Subset.rfl]
    simpa only [himage] using
      Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn d hh
  -- sharp comparisons for a map approximating an injective linear map
  have approx_upper : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      {f : EuclideanSpace ℝ (Fin n) → Y} {L : EuclideanSpace ℝ (Fin n) →L[ℝ] Y}
      {s : Set (EuclideanSpace ℝ (Fin n))} {δ K : NNReal},
      ApproximatesLinearOn f L s δ → AntilipschitzWith K L →
      μHE[n] (f '' s) ≤ ((1 + δ * K : NNReal) : ℝ≥0∞) ^ n * (ENNReal.ofReal (Jac L) * μHE[n] s) := by
    intro n Y _ _ _ _ _ f L s δ K hf hL
    rw [← linear_area rfl L hL.injective s]
    apply image_le_of_dist_le hL.injective.injOn
    intro x hx y hy
    have hb : ‖x - y‖ ≤ K * ‖L x - L y‖ := by
      simpa only [dist_eq_norm] using hL.le_mul_dist x y
    have herror : ‖f x - f y - (L x - L y)‖ ≤ (δ : ℝ) * K * ‖L x - L y‖ := by
      calc
        _ ≤ δ * ‖x - y‖ := by simpa only [map_sub] using hf x hx y hy
        _ ≤ δ * (K * ‖L x - L y‖) := mul_le_mul_of_nonneg_left hb δ.2
        _ = _ := by ring
    simp only [dist_eq_norm, NNReal.coe_add, NNReal.coe_one, NNReal.coe_mul]
    calc
      ‖f x - f y‖ ≤ ‖f x - f y - (L x - L y)‖ + ‖L x - L y‖ := norm_le_norm_sub_add _ _
      _ ≤ (δ : ℝ) * K * ‖L x - L y‖ + ‖L x - L y‖ := add_le_add herror le_rfl
      _ = (1 + (δ : ℝ) * K) * ‖L x - L y‖ := by ring
  have approx_lower : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      {f : EuclideanSpace ℝ (Fin n) → Y} {L : EuclideanSpace ℝ (Fin n) →L[ℝ] Y}
      {s : Set (EuclideanSpace ℝ (Fin n))} {δ K : NNReal},
      ApproximatesLinearOn f L s δ → AntilipschitzWith K L → δ * K < 1 →
      ENNReal.ofReal (Jac L) * μHE[n] s ≤
        (((1 - δ * K)⁻¹ : NNReal) : ℝ≥0∞) ^ n * μHE[n] (f '' s) := by
    intro n Y _ _ _ _ _ f L s δ K hf hL hδ
    have hδR : (δ : ℝ) * K < 1 := hδ
    have hdist : ∀ x ∈ s, ∀ y ∈ s, dist (L x) (L y) ≤
        ((1 - δ * K)⁻¹ : NNReal) * dist (f x) (f y) := by
      intro x hx y hy
      have hb : ‖x - y‖ ≤ K * ‖L x - L y‖ := by
        simpa only [dist_eq_norm] using hL.le_mul_dist x y
      have herror : ‖f x - f y - (L x - L y)‖ ≤ (δ : ℝ) * K * ‖L x - L y‖ := by
        calc
          _ ≤ δ * ‖x - y‖ := by simpa only [map_sub] using hf x hx y hy
          _ ≤ δ * (K * ‖L x - L y‖) := mul_le_mul_of_nonneg_left hb δ.2
          _ = _ := by ring
      have htriangle : ‖L x - L y‖ ≤ ‖f x - f y‖ + ‖f x - f y - (L x - L y)‖ := by
        simpa only [norm_sub_rev, add_comm] using
          (norm_le_norm_sub_add (L x - L y) (f x - f y))
      simp only [dist_eq_norm, NNReal.coe_inv, NNReal.coe_sub hδ.le,
        NNReal.coe_one, NNReal.coe_mul, inv_mul_eq_div]
      apply (le_div_iff₀ (sub_pos.mpr hδR)).mpr
      nlinarith
    have hfinj : InjOn f s := by
      intro x hx y hy hxy
      apply hL.injective
      apply dist_le_zero.mp
      simpa only [hxy, dist_self, mul_zero] using hdist x hx y hy
    rw [← linear_area rfl L hL.injective s]
    exact image_le_of_dist_le hfinj hdist _
  -- one radius controlling both the image measure and the Jacobians of nearby maps
  have radius_area : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      (L : EuclideanSpace ℝ (Fin n) →L[ℝ] Y), Injective L → ∀ {q : NNReal}, 1 < q →
      ∃ δ : NNReal, 0 < δ ∧
        (∀ B : EuclideanSpace ℝ (Fin n) →L[ℝ] Y, ‖B - L‖ ≤ δ →
          ENNReal.ofReal (Jac B) ≤ q * ENNReal.ofReal (Jac L) ∧
          ENNReal.ofReal (Jac L) ≤ q * ENNReal.ofReal (Jac B)) ∧
        (∀ (s : Set (EuclideanSpace ℝ (Fin n))) (f : EuclideanSpace ℝ (Fin n) → Y),
          ApproximatesLinearOn f L s δ →
          μHE[n] (f '' s) ≤ q * (ENNReal.ofReal (Jac L) * μHE[n] s) ∧
            ENNReal.ofReal (Jac L) * μHE[n] s ≤ q * μHE[n] (f '' s)) := by
    intro n Y _ _ _ _ _ L hL q hq
    obtain ⟨K, _, hK⟩ := (L : EuclideanSpace ℝ (Fin n) →ₗ[ℝ] Y).exists_antilipschitzWith
      (LinearMap.ker_eq_bot.mpr hL)
    have hsmall : ∀ᶠ δ : NNReal in 𝓝 0, δ * K < 1 := by
      exact (continuousAt_id.mul continuousAt_const).eventually_lt
        continuousAt_const (by simp)
    have hupper : ∀ᶠ δ : NNReal in 𝓝 0, (1 + δ * K) ^ n < q := by
      exact ((continuousAt_const.add (continuousAt_id.mul continuousAt_const)).pow _).eventually_lt
        continuousAt_const (by simpa using hq)
    have hlower : ∀ᶠ δ : NNReal in 𝓝 0, ((1 - δ * K)⁻¹) ^ n < q := by
      apply ContinuousAt.eventually_lt _ continuousAt_const (by simpa using hq)
      apply ContinuousAt.pow
      apply ContinuousAt.inv₀
      · exact continuousAt_const.sub (continuousAt_id.mul continuousAt_const)
      · simp
    have hJ : 0 < Jac L := jac_pos L hL
    have hqR : (1 : ℝ) < q := hq
    have hmul : Jac L < (q : ℝ) * Jac L := by nlinarith
    have hnear : ∀ᶠ B : EuclideanSpace ℝ (Fin n) →L[ℝ] Y in 𝓝 L,
        Jac B < (q : ℝ) * Jac L ∧ Jac L < (q : ℝ) * Jac B :=
      (continuous_jac.continuousAt.eventually_lt continuousAt_const hmul).and
        (continuousAt_const.eventually_lt
          (continuousAt_const.mul continuous_jac.continuousAt) hmul)
    obtain ⟨ε, hε, hnear⟩ := Metric.eventually_nhds_iff.mp hnear
    have hevent : ∀ᶠ δ : NNReal in 𝓝[>] 0,
        0 < δ ∧ δ * K < 1 ∧ (1 + δ * K) ^ n < q ∧ ((1 - δ * K)⁻¹) ^ n < q ∧ (δ : ℝ) < ε := by
      have hεnhds : ∀ᶠ δ : NNReal in 𝓝 0, (δ : ℝ) < ε :=
        (NNReal.continuous_coe.continuousAt.eventually_lt continuousAt_const (by simpa using hε))
      filter_upwards [self_mem_nhdsWithin,
        hsmall.filter_mono nhdsWithin_le_nhds, hupper.filter_mono nhdsWithin_le_nhds,
        hlower.filter_mono nhdsWithin_le_nhds, hεnhds.filter_mono nhdsWithin_le_nhds]
        with δ hδ hsmall hupper hlower hδε
      exact ⟨hδ, hsmall, hupper, hlower, hδε⟩
    obtain ⟨δ, hδ, hδsmall, hδupper, hδlower, hδε⟩ := hevent.exists
    refine ⟨δ, hδ, ?_, fun s f hf => ⟨?_, ?_⟩⟩
    · intro B hB
      have hdist : dist B L < ε := by
        rw [dist_eq_norm]
        exact hB.trans_lt hδε
      obtain ⟨hupper, hlower⟩ := hnear hdist
      constructor
      · simpa only [ENNReal.ofReal_mul (NNReal.coe_nonneg q), ENNReal.ofReal_coe_nnreal] using
          ENNReal.ofReal_le_ofReal hupper.le
      · simpa only [ENNReal.ofReal_mul (NNReal.coe_nonneg q), ENNReal.ofReal_coe_nnreal] using
          ENNReal.ofReal_le_ofReal hlower.le
    · refine (approx_upper hf hK).trans ?_
      gcongr
      exact_mod_cast hδupper.le
    · refine (approx_lower hf hK hδsmall).trans ?_
      gcongr
      exact_mod_cast hδlower.le
  -- on a.e. point of an approximation piece the derivative is close to the linear map
  have approx_fderiv : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
      {f : EuclideanSpace ℝ (Fin n) → Y} {s : Set (EuclideanSpace ℝ (Fin n))}
      {A : EuclideanSpace ℝ (Fin n) →L[ℝ] Y} {δ : NNReal},
      ApproximatesLinearOn f A s δ → MeasurableSet s →
      ∀ (f' : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] Y),
      (∀ x ∈ s, HasFDerivWithinAt f (f' x) s x) →
      ∀ᵐ x ∂(volume : Measure (EuclideanSpace ℝ (Fin n))).restrict s, ‖f' x - A‖₊ ≤ δ := by
    intro n Y _ _ f s A δ hf hs f' hf'
    open scoped Pointwise in
    filter_upwards [Besicovitch.ae_tendsto_measure_inter_div volume s, ae_restrict_mem hs]
    intro x hx xs
    apply ContinuousLinearMap.opNorm_le_bound _ δ.2 fun z => ?_
    suffices H : ∀ ε, 0 < ε → ‖(f' x - A) z‖ ≤ (δ + ε) * (‖z‖ + ε) + ‖f' x - A‖ * ε by
      have :
          Tendsto (fun ε : ℝ => ((δ : ℝ) + ε) * (‖z‖ + ε) + ‖f' x - A‖ * ε) (𝓝[>] 0)
            (𝓝 ((δ + 0) * (‖z‖ + 0) + ‖f' x - A‖ * 0)) :=
        Tendsto.mono_left (Continuous.tendsto
          (((continuous_const.add continuous_id).mul (continuous_const.add continuous_id)).add
            (continuous_const.mul continuous_id)) 0) nhdsWithin_le_nhds
      simp only [add_zero, mul_zero] at this
      apply le_of_tendsto_of_tendsto tendsto_const_nhds this
      filter_upwards [self_mem_nhdsWithin]
      exact H
    intro ε εpos
    have B₁ : ∀ᶠ r in 𝓝[>] (0 : ℝ), (s ∩ ({x} + r • closedBall z ε)).Nonempty :=
      Measure.eventually_nonempty_inter_smul_of_density_one volume s x hx _ measurableSet_closedBall
        (Metric.measure_closedBall_pos volume z εpos).ne'
    obtain ⟨ρ, ρpos, hρ⟩ :
        ∃ ρ > 0, ball x ρ ∩ s ⊆ {y | ‖f y - f x - (f' x) (y - x)‖ ≤ ε * ‖y - x‖} :=
      mem_nhdsWithin_iff.1 ((hf' x xs).isLittleO.bound εpos)
    have B₂ : ∀ᶠ r in 𝓝[>] (0 : ℝ), {x} + r • closedBall z ε ⊆ ball x ρ := by
      apply nhdsWithin_le_nhds
      exact eventually_singleton_add_smul_subset isBounded_closedBall (ball_mem_nhds x ρpos)
    obtain ⟨r, ⟨y, ⟨ys, hy⟩⟩, rρ, rpos⟩ :
        ∃ r : ℝ, (s ∩ ({x} + r • closedBall z ε)).Nonempty ∧
          {x} + r • closedBall z ε ⊆ ball x ρ ∧ 0 < r :=
      (B₁.and (B₂.and self_mem_nhdsWithin)).exists
    obtain ⟨a, az, ya⟩ : ∃ a, a ∈ closedBall z ε ∧ y = x + r • a := by
      simp only [mem_smul_set, image_add_left, mem_preimage, singleton_add] at hy
      rcases hy with ⟨a, az, ha⟩
      exact ⟨a, az, by simp only [ha, add_neg_cancel_left]⟩
    have norm_a : ‖a‖ ≤ ‖z‖ + ε :=
      calc
        ‖a‖ = ‖z + (a - z)‖ := by simp only [add_sub_cancel]
        _ ≤ ‖z‖ + ‖a - z‖ := norm_add_le _ _
        _ ≤ ‖z‖ + ε := by grw [mem_closedBall_iff_norm.1 az]
    have I : r * ‖(f' x - A) a‖ ≤ r * (δ + ε) * (‖z‖ + ε) :=
      calc
        r * ‖(f' x - A) a‖ = ‖(f' x - A) (r • a)‖ := by
          simp only [map_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
        _ = ‖f y - f x - A (y - x) - (f y - f x - (f' x) (y - x))‖ := by
          simp only [ya, add_sub_cancel_left, sub_sub_sub_cancel_left, sub_apply, map_smul,
            smul_sub]
        _ ≤ ‖f y - f x - A (y - x)‖ + ‖f y - f x - (f' x) (y - x)‖ := norm_sub_le _ _
        _ ≤ δ * ‖y - x‖ + ε * ‖y - x‖ := (add_le_add (hf _ ys _ xs) (hρ ⟨rρ hy, ys⟩))
        _ = r * (δ + ε) * ‖a‖ := by
          simp only [ya, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
          ring
        _ ≤ r * (δ + ε) * (‖z‖ + ε) := by gcongr
    calc
      ‖(f' x - A) z‖ = ‖(f' x - A) a + (f' x - A) (z - a)‖ := by
        congr 1
        simp only [sub_apply, map_sub]
        abel
      _ ≤ ‖(f' x - A) a‖ + ‖(f' x - A) (z - a)‖ := norm_add_le _ _
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖f' x - A‖ * ‖z - a‖ := by
        apply add_le_add
        · rw [mul_assoc] at I; exact (mul_le_mul_iff_right₀ rpos).1 I
        · apply ContinuousLinearMap.le_opNorm
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖f' x - A‖ * ε := by
        rw [mem_closedBall_iff_norm'] at az
        gcongr
  -- the area formula with injective derivative, up to a factor `q²`
  have regular_comparison : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      {s : Set (EuclideanSpace ℝ (Fin n))} {f : EuclideanSpace ℝ (Fin n) → Y}
      {f' : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] Y},
      MeasurableSet s → (∀ x ∈ s, HasFDerivWithinAt f (f' x) s x) →
      (∀ x ∈ s, Injective (f' x)) → InjOn f s → ∀ {q : NNReal}, 1 < q →
      μHE[n] (f '' s) ≤ (q : ℝ≥0∞) ^ 2 * ∫⁻ x in s, ENNReal.ofReal (Jac (f' x)) ∂volume ∧
        (∫⁻ x in s, ENNReal.ofReal (Jac (f' x)) ∂volume) ≤ (q : ℝ≥0∞) ^ 2 * μHE[n] (f '' s) := by
    intro n Y _ _ _ _ _ s f f' hs hf' hreg hinj q hq
    rcases eq_empty_or_nonempty s with rfl | hsne
    · simp
    have hchoice : ∀ L : EuclideanSpace ℝ (Fin n) →L[ℝ] Y, ∃ δ : NNReal, 0 < δ ∧ (Injective L →
        (∀ B : EuclideanSpace ℝ (Fin n) →L[ℝ] Y, ‖B - L‖ ≤ δ →
          ENNReal.ofReal (Jac B) ≤ q * ENNReal.ofReal (Jac L) ∧
          ENNReal.ofReal (Jac L) ≤ q * ENNReal.ofReal (Jac B)) ∧
        (∀ (t : Set (EuclideanSpace ℝ (Fin n))) (g : EuclideanSpace ℝ (Fin n) → Y),
          ApproximatesLinearOn g L t δ →
          μHE[n] (g '' t) ≤ q * (ENNReal.ofReal (Jac L) * μHE[n] t) ∧
            ENNReal.ofReal (Jac L) * μHE[n] t ≤ q * μHE[n] (g '' t))) := by
      intro L
      by_cases hL : Injective L
      · obtain ⟨δ, hδ, hJ, harea⟩ := radius_area L hL hq
        exact ⟨δ, hδ, fun _ => ⟨hJ, harea⟩⟩
      · exact ⟨1, zero_lt_one, fun h => (hL h).elim⟩
    choose δ hδpos hδ using hchoice
    obtain ⟨t, L, hdisj, ht, hcover, happrox, hactual⟩ :=
      exists_partition_approximatesLinearOn_of_hasFDerivWithinAt f s f' hf'
        δ (fun L => (hδpos L).ne')
    have hLreg (i : ℕ) : Injective (L i) := by
      obtain ⟨x, hx, hL⟩ := hactual hsne i
      rw [hL]
      exact hreg x hx
    have hseq : s = ⋃ i, s ∩ t i := by
      rw [← inter_iUnion]
      exact Subset.antisymm (subset_inter Subset.rfl hcover) inter_subset_left
    have hsumimage : μHE[n] (f '' s) = ∑' i, μHE[n] (f '' (s ∩ t i)) := by
      conv_lhs => rw [hseq, image_iUnion]
      apply measure_iUnion
      · intro i j hij
        exact Disjoint.image (Disjoint.mono inter_subset_right inter_subset_right (hdisj hij))
          hinj inter_subset_left inter_subset_left
      · intro i
        apply (hs.inter (ht i)).image_of_continuousOn_injOn
        · exact (fun x hx => (hf' x hx.1).continuousWithinAt.mono inter_subset_left)
        · exact hinj.mono inter_subset_left
    have hsumintegral :
        (∫⁻ x in s, ENNReal.ofReal (Jac (f' x)) ∂volume) =
          ∑' i, ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume := by
      conv_lhs => rw [hseq]
      exact lintegral_iUnion (fun i => hs.inter (ht i))
        (pairwise_disjoint_mono hdisj (fun _ => inter_subset_right)) _
    have hvol : (μHE[n] : Measure (EuclideanSpace ℝ (Fin n))) = volume :=
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume n
    have hpiece (i : ℕ) :
        μHE[n] (f '' (s ∩ t i)) ≤ (q : ℝ≥0∞) ^ 2 *
            ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume ∧
          (∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume) ≤
            (q : ℝ≥0∞) ^ 2 * μHE[n] (f '' (s ∩ t i)) := by
      have hJ := (hδ (L i) (hLreg i)).1
      obtain ⟨harea_upper, harea_lower⟩ := (hδ (L i) (hLreg i)).2 (s ∩ t i) f (happrox i)
      rw [hvol] at harea_upper harea_lower
      have hderiv := approx_fderiv (happrox i) (hs.inter (ht i)) f'
        (fun x hx => (hf' x hx.1).mono inter_subset_left)
      have hJupper :
          (∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume) ≤
            q * (ENNReal.ofReal (Jac (L i)) * volume (s ∩ t i)) := by
        calc
          _ ≤ ∫⁻ _ in s ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (Jac (L i)) ∂volume := by
            apply lintegral_mono_ae
            filter_upwards [hderiv] with x hx
            exact (hJ (f' x) hx).1
          _ = _ := by rw [setLIntegral_const, mul_assoc]
      have hJlower : ENNReal.ofReal (Jac (L i)) * volume (s ∩ t i) ≤
          q * ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume := by
        calc
          _ = ∫⁻ _ in s ∩ t i, ENNReal.ofReal (Jac (L i)) ∂volume :=
            (setLIntegral_const _ _).symm
          _ ≤ ∫⁻ x in s ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (Jac (f' x)) ∂volume := by
            apply lintegral_mono_ae
            filter_upwards [hderiv] with x hx
            exact (hJ (f' x) hx).2
          _ = _ := lintegral_const_mul' _ _ ENNReal.coe_ne_top
      constructor
      · calc
          _ ≤ q * (ENNReal.ofReal (Jac (L i)) * volume (s ∩ t i)) := harea_upper
          _ ≤ q * (q * ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume) := by gcongr
          _ = _ := by rw [pow_two, mul_assoc]
      · calc
          _ ≤ q * (ENNReal.ofReal (Jac (L i)) * volume (s ∩ t i)) := hJupper
          _ ≤ q * (q * μHE[n] (f '' (s ∩ t i))) := by gcongr
          _ = _ := by rw [pow_two, mul_assoc]
    rw [hsumimage, hsumintegral]
    constructor
    · calc
        _ ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume :=
          ENNReal.tsum_le_tsum (fun i => (hpiece i).1)
        _ = _ := ENNReal.tsum_mul_left
    · calc
        _ ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * μHE[n] (f '' (s ∩ t i)) :=
          ENNReal.tsum_le_tsum (fun i => (hpiece i).2)
        _ = _ := ENNReal.tsum_mul_left
  -- the area formula with injective derivative
  have regular_area : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      {s : Set (EuclideanSpace ℝ (Fin n))} {f : EuclideanSpace ℝ (Fin n) → Y}
      {f' : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] Y},
      MeasurableSet s → (∀ x ∈ s, HasFDerivWithinAt f (f' x) s x) →
      (∀ x ∈ s, Injective (f' x)) → InjOn f s →
      μHE[n] (f '' s) = ∫⁻ x in s, ENNReal.ofReal (Jac (f' x)) ∂volume := by
    intro n Y _ _ _ _ _ s f f' hs hf' hreg hinj
    have hlimit (a : ℝ≥0∞) :
        Tendsto (fun q : NNReal => (q : ℝ≥0∞) ^ 2 * a) (𝓝[>] 1) (𝓝 a) := by
      have hcoe : Tendsto (fun q : NNReal => (q : ℝ≥0∞)) (𝓝[>] 1) (𝓝 1) :=
        (ENNReal.tendsto_coe.2 tendsto_id).mono_left nhdsWithin_le_nhds
      simpa only [one_pow, one_mul] using
        ENNReal.Tendsto.mul_const (ENNReal.Tendsto.pow (n := 2) hcoe) (Or.inl (by simp))
    apply le_antisymm
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (regular_comparison hs hf' hreg hinj hq).1
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (regular_comparison hs hf' hreg hinj hq).2
  -- critical points: the graphs `x ↦ (f x, εx)` have injective derivatives and shrinking area
  have critical_finite : ∀ {P n : ℕ} {s : Set (EuclideanSpace ℝ (Fin n))}
      {f : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin P)}, MeasurableSet s →
      (∀ x ∈ s, DifferentiableAt ℝ f x) → (∀ x ∈ s, ¬ Injective (fderiv ℝ f x)) →
      volume s ≠ ⊤ → ∀ {B : ℝ}, (∀ x ∈ s, ‖fderiv ℝ f x‖ ≤ B) → μHE[n] (f '' s) = 0 := by
    intro P n s f hs hf hcrit hfinite B hB
    obtain ⟨G, hGapply, hGcont, hGderiv⟩ : ∃ G : (EuclideanSpace ℝ (Fin n) →L[ℝ]
        EuclideanSpace ℝ (Fin P)) → ℝ → (EuclideanSpace ℝ (Fin n) →L[ℝ]
          WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n))),
        (∀ L ε x, G L ε x = WithLp.toLp 2 (L x, ε • x)) ∧
        Continuous (fun p : (EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin P)) × ℝ =>
          G p.1 p.2) ∧
        ∀ (L : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin P))
          (x : EuclideanSpace ℝ (Fin n)), HasFDerivAt f L x → ∀ ε : ℝ,
            HasFDerivAt (fun y => (WithLp.toLp 2 (f y, ε • y) :
              WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n)))) (G L ε) x := by
      refine ⟨fun L ε => (WithLp.prodContinuousLinearEquiv 2 ℝ (EuclideanSpace ℝ (Fin P))
          (EuclideanSpace ℝ (Fin n))).symm.toContinuousLinearMap.comp
          (L.prod (ε • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin n)))),
        fun _ _ _ => rfl, ?_, ?_⟩
      · apply Continuous.clm_comp continuous_const
        exact (ContinuousLinearMap.prodₗᵢ ℝ).continuous.comp
          (continuous_fst.prodMk (continuous_snd.smul continuous_const))
      · intro L x hL ε
        exact (WithLp.prodContinuousLinearEquiv 2 ℝ (EuclideanSpace ℝ (Fin P))
          (EuclideanSpace ℝ (Fin n))).symm.toContinuousLinearMap.hasFDerivAt.comp
          x (hL.prodMk ((hasFDerivAt_id x).const_smul ε))
    have hc : Continuous (fun p : (EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin P)) × ℝ =>
        Jac (G p.1 p.2)) := continuous_jac.comp hGcont
    have hzero : ∀ x ∈ s, Jac (G (fderiv ℝ f x) 0) = 0 := by
      intro x hx
      apply jac_eq_zero
      intro hg
      apply hcrit x hx
      intro y z hyz
      apply hg
      rw [hGapply, hGapply, zero_smul, zero_smul, hyz]
    have hgraph : ∀ ε : ℝ, ε ≠ 0 →
        μHE[n] (f '' s) ≤ ∫⁻ x in s, ENNReal.ofReal (Jac (G (fderiv ℝ f x) ε)) ∂volume := by
      intro ε hε
      have hinj : Injective (fun y : EuclideanSpace ℝ (Fin n) => (WithLp.toLp 2 (f y, ε • y) :
          WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n)))) := by
        intro x y h
        have he : ε • x = ε • y := congrArg WithLp.snd h
        exact (smul_right_injective _ hε) he
