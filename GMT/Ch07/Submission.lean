      intro g hg hgc hgD hg0
      obtain ⟨hb₁, he₁⟩ := h₁ g hg hgc hgD hg0
      obtain ⟨hb₂, he₂⟩ := h₂ g hg hgc hgD hg0
      rw [he₁, he₂]
