  have hY0 : (push m (φ 0) (D 0)).mass ≤ ENNReal.ofReal (c₄ ^ m) * T.boundary.mass :=
    (hpD 0).2.2.1.trans (keyP c₄ 1 _ _ 0 m 0 0 _ _ hc₄ zero_le_one (hΛe 0) (by simp) (by simp)
