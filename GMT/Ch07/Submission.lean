      intro ℓ
      simpa only [Real.norm_eq_abs, sq_abs] using hhs ℝ ℓ
    have hhsf : ∀ (f : Euclid P → ℝ) (ℓ : Euclid P →L[ℝ] ℝ), (∀ u, f u = ℓ u) →
