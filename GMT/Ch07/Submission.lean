    have hsum := Finset.sum_le_sum (s := Finset.univ) fun c _ => key c
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum] at hsum
    rw [hS, hG, hgrad]
    have e : 2 * (∑ a, ∑ d, H a d ^ 2) ^ 2 / ρ ^ 2 =
        2 * ρ⁻¹ ^ 2 * (∑ a, ∑ d, H a d ^ 2) ^ 2 := by ring
    rw [e]
    nlinarith [hsum]
  exact frame _ b (fderiv ℝ ν x) _ _ ‖x‖
    (fun a => Submodule.subset_span (hCZ _ (hbT a) _ (hbT a)).1)
    (fun a c => (hCZ _ (hbT a) _ (hbT c)).2.1)
    (by rw [hlast, map_smul, hDx, smul_zero])
    (fun a c d => ((hCZ _ (hbT a) _ (hbT c)).2.2 _ (hbT d)).1)
    (fun a c d => ((hCZ _ (hbT a) _ (hbT c)).2.2 _ (hbT d)).2)
    (by rw [hlast, map_smul, hΦW x hxW, hrad, smul_neg]) hg
/-- **Simon, Appendix B, end of the proof of B.2** (the extension of (3) under (4), the cut-offs
`γ_ε`, and the choice (6); `chapter-B.txt` lines 250–282).  Let `M ⊆ A₀ ≅ ℝ^{m+1}`, `2 ≤ m ≤ 6`,
be a smooth embedded hypercone (`0 ∉ M`, `tM = M`, `M̄ ⊆ M ∪ {0}`, locally `Hᵐ`-finite) with unit
normal `ν`, density one at each of its points, and the Hardy-type inequality (3)
`2∫ψ²|A|²/|x|² ≤ ∫|A|²|∇^Mψ|²` for compactly supported locally Lipschitz `ψ`.  Then
`Dν(x)v = 0` for `x ∈ M`, `v ∈ T_xM`.

Proof.  `|A|² = Σⱼ|Dν(x)(P_xeⱼ)|²` is continuous on `M` (`P_x = Π_{A₀} − ν(x) ⊗ ν(x)`,
`Submission.codim1_hcp_sc_tangent_normal_complement`) and homogeneous of degree `−2`
(`Submission.codim1_hcp_sc_cone_normal_homogeneous`), so `|A|² ≤ c|x|⁻²`.  The profile is the
smooth variant `p(ρ) = ρᵃ/(1 + ρ^{a−b})`, `a = 1 + ε = 11/10`, `b = 2 − m/2 − ε`, of the printed
`ψ = r^{1+ε} r₁^{1−n/2−2ε}` (`ε = 1/10`): `p ≤ ρᵃ`, `p ≤ ρᵇ` and `(ρp')² ≤ (11/10)²p²`, since
`ρp'/p` lies between `b ≥ −11/10` and `a`.  Hence `F = |A|²p(|x|)²/|x|²` is `Hᵐ`-integrable on
`M` by the dyadic estimates of `Submission.codim1_hcp_sc_cone_annuli_measure` (replacing the polar
formula (5)).  For `κₙ = 1/(n+2)` let `gₙ` be the piecewise-linear cut-off (`0` below `κₙ/2`,
`1` on `[κₙ, 1/κₙ]`, `0` above `2/κₙ`, `|ρgₙ'| ≤ 2`).  The test function `ψₙ = p(|x|)gₙ(|x|)`
is locally Lipschitz on `M` and vanishes outside the compact `M ∩ {κₙ/2 ≤ |x| ≤ 2/κₙ}`; as
`x ∈ T_xM`, `Σⱼ(δⱼψₙ)² = (p'gₙ + pgₙ')²(|x|)` off the null spheres
(`Submission.codim1_hcp_sc_fderivWithin_tangent_eq`).  Applying (3) to `ψₙ` with
`(a + b)² ≤ (3/2)a² + 3b²` gives `(37/200)∫gₙ²F ≤ 3∫|A|²p²gₙ'²`, and dominated convergence
yields `(37/200)∫_M F ≤ 0`.  Hence `|A|² = 0` a.e. on `M`, so everywhere on `M` by continuity and
density one, and finally `Dν(x) = 0` on `T_xM`. -/
theorem Submission.codim1_hcp_sc_hardy_cone_flat : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), 2 ≤ m → m ≤ 6 → Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (0 : Euclid P) ∉ M → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → closure M ⊆ insert 0 M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ z ∈ M, Tendsto (fun s : ℝ => μHE[m] (M ∩ ball z s) / (unitBallVolume m * ENNReal.ofReal (s ^ m))) (𝓝[>] 0) (𝓝 1)) → (∀ ψ : Euclid P → ℝ, LocallyLipschitzOn M ψ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ψ x = 0) → 2 * (∫ x in M, ψ x ^ 2 * (∑ j : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))‖ ^ 2) / ‖x‖ ^ 2 ∂μHE[m]) ≤ ∫ x in M, (∑ j : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))‖ ^ 2) * (∑ j : Fin P, (fderivWithin ℝ ψ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) → ∀ x ∈ M, ∀ v ∈ tangentSpace M x, fderiv ℝ ν x v = 0 := by
  intro P m A₀ M ν hm2 hm6
  -- Step 4: the profile `p(ρ) = ρᵃ/(1 + ρ^{a−b})`, `a = 11/10`, `b = 19/10 − m/2`
  obtain ⟨p, p', hpC, hp, hp0, hp', hpα, hpβ⟩ : ∃ p p' : ℝ → ℝ,
      (∀ ρ : ℝ, 0 < ρ → ContDiffAt ℝ 1 p ρ) ∧
      (∀ ρ : ℝ, 0 < ρ → HasDerivAt p (p' ρ) ρ) ∧ (∀ ρ : ℝ, 0 < ρ → 0 < p ρ) ∧
      (∀ ρ : ℝ, 0 < ρ → (ρ * p' ρ) ^ 2 ≤ 121 / 100 * p ρ ^ 2) ∧
      (∀ ρ : ℝ, 0 < ρ → p ρ ^ 2 ≤ ρ ^ (-(9 / 5) : ℝ) * ρ ^ 4) ∧
      (∀ ρ : ℝ, 0 < ρ → p ρ ^ 2 ≤ ρ ^ (-(m : ℝ) - 1 / 5) * ρ ^ 4) := by
    have hm2' : (2 : ℝ) ≤ m := by exact_mod_cast hm2
    have hm6' : (m : ℝ) ≤ 6 := by exact_mod_cast hm6
    set a : ℝ := 11 / 10 with ha
    set b : ℝ := 19 / 10 - (m : ℝ) / 2 with hb
    set c : ℝ := a - b with hc
    have hc0 : 0 < c := by rw [hc, ha, hb]; linarith
    -- `(ρ^e)² = ρ^{2e−4} ρ⁴`
    have hsq : ∀ ρ : ℝ, 0 < ρ → ∀ e : ℝ, (ρ ^ e) ^ 2 = ρ ^ (2 * e - 4) * ρ ^ 4 := by
      intro ρ hρ e
      rw [← Real.rpow_two, ← Real.rpow_mul hρ.le, ← Real.rpow_natCast ρ 4, ← Real.rpow_add hρ]
      congr 1
      push_cast
      ring
    refine ⟨fun r => r ^ a / (1 + r ^ c),
      fun r => (a * r ^ (a - 1) * (1 + r ^ c) - r ^ a * (c * r ^ (c - 1))) / (1 + r ^ c) ^ 2,
      ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro ρ hρ
      exact (Real.contDiffAt_rpow_const_of_ne hρ.ne').div
        (contDiffAt_const.add (Real.contDiffAt_rpow_const_of_ne hρ.ne')) (by positivity)
    · intro ρ hρ
      have h1 := Real.hasDerivAt_rpow_const (p := a) (Or.inl hρ.ne')
      have h2 := (Real.hasDerivAt_rpow_const (p := c) (Or.inl hρ.ne')).const_add 1
      exact h1.div h2 (by positivity)
    · intro ρ hρ
      positivity
    · intro ρ hρ
      have hX : 0 < ρ ^ a := Real.rpow_pos_of_pos hρ a
      have ht : 0 < ρ ^ c := Real.rpow_pos_of_pos hρ c
      simp only
      rw [Real.rpow_sub_one hρ.ne', Real.rpow_sub_one hρ.ne']
      set X := ρ ^ a
      set t := ρ ^ c
      have key : ρ * ((a * (X / ρ) * (1 + t) - X * (c * (t / ρ))) / (1 + t) ^ 2) =
          X / (1 + t) * ((a + b * t) / (1 + t)) := by
        rw [hc]
        field_simp
        ring
      rw [key, mul_pow]
      have hq : ((a + b * t) / (1 + t)) ^ 2 ≤ 121 / 100 := by
        rw [div_pow, div_le_iff₀ (by positivity)]
        have h1 : -(11 / 10) * (1 + t) ≤ a + b * t := by rw [ha, hb]; nlinarith
        have h2 : a + b * t ≤ 11 / 10 * (1 + t) := by rw [ha, hb]; nlinarith
        nlinarith
      have := sq_nonneg (X / (1 + t))
      nlinarith
    · intro ρ hρ
      have hX : 0 ≤ ρ ^ a := Real.rpow_nonneg hρ.le a
      have ht : 0 < ρ ^ c := Real.rpow_pos_of_pos hρ c
      have hle : ρ ^ a / (1 + ρ ^ c) ≤ ρ ^ a := div_le_self hX (by linarith)
      calc (ρ ^ a / (1 + ρ ^ c)) ^ 2 ≤ (ρ ^ a) ^ 2 := pow_le_pow_left₀ (by positivity) hle 2
        _ = ρ ^ (-(9 / 5) : ℝ) * ρ ^ 4 := by rw [hsq ρ hρ a, ha]; norm_num
    · intro ρ hρ
      have hX : 0 ≤ ρ ^ a := Real.rpow_nonneg hρ.le a
      have ht : 0 < ρ ^ c := Real.rpow_pos_of_pos hρ c
      have hle : ρ ^ a / (1 + ρ ^ c) ≤ ρ ^ b := by
        calc ρ ^ a / (1 + ρ ^ c) ≤ ρ ^ a / ρ ^ c := div_le_div_of_nonneg_left hX ht (by linarith)
          _ = ρ ^ b := by rw [← Real.rpow_sub hρ, hc]; ring_nf
      calc (ρ ^ a / (1 + ρ ^ c)) ^ 2 ≤ (ρ ^ b) ^ 2 := pow_le_pow_left₀ (by positivity) hle 2
        _ = ρ ^ (-(m : ℝ) - 1 / 5) * ρ ^ 4 := by rw [hsq ρ hρ b, hb]; ring_nf
  -- Step 6: the piecewise-linear cut-off `g_κ` and its derivative `g_κ'` off the break points
  have hcutoff : ∀ κ : ℝ, 0 < κ → κ < 1 → ∃ g g' : ℝ → ℝ, (∃ K, LipschitzWith K g) ∧
      (∀ ρ, 0 ≤ g ρ ∧ g ρ ≤ 1) ∧ (∀ ρ, ρ < κ / 2 ∨ 2 / κ < ρ → g ρ = 0) ∧
      (∀ ρ, ρ ≠ κ / 2 → ρ ≠ κ → ρ ≠ 1 / κ → ρ ≠ 2 / κ → HasDerivAt g (g' ρ) ρ) ∧
      Measurable g' ∧ (∀ ρ, 0 < ρ → (ρ * g' ρ) ^ 2 ≤ 4) ∧
      (∀ ρ, κ < ρ → ρ < 1 / κ → g ρ = 1 ∧ g' ρ = 0) := by
    intro κ hκ0 hκ1
    classical
    set g : ℝ → ℝ := fun ρ => max 0 (min 1 (min (2 * ρ / κ - 1) (2 - κ * ρ))) with hg
    set g' : ℝ → ℝ := fun ρ =>
      if ρ ∈ Ioo (κ / 2) κ then 2 / κ else if ρ ∈ Ioo (1 / κ) (2 / κ) then -κ else 0 with hg'
    -- the break points are ordered: `κ/2 < κ < 1/κ < 2/κ`
    have hb1 : κ / 2 < κ := by linarith
    have hb2 : κ < 1 / κ := by rw [lt_div_iff₀ hκ0]; nlinarith
    have hb3 : 1 / κ < 2 / κ := div_lt_div_of_pos_right one_lt_two hκ0
    -- `2ρ/κ − 1` and `2 − κρ` against the break points
    have hA0 : ∀ ρ, ρ ≤ κ / 2 → 2 * ρ / κ - 1 ≤ 0 := fun ρ hρ => by
      rw [sub_nonpos, div_le_one hκ0]; linarith
    have hA0' : ∀ ρ, κ / 2 ≤ ρ → 0 ≤ 2 * ρ / κ - 1 := fun ρ hρ => by
      rw [sub_nonneg, le_div_iff₀ hκ0]; linarith
    have hA1 : ∀ ρ, ρ ≤ κ → 2 * ρ / κ - 1 ≤ 1 := fun ρ hρ => by
      rw [sub_le_iff_le_add, div_le_iff₀ hκ0]; linarith
    have hA1' : ∀ ρ, κ ≤ ρ → 1 ≤ 2 * ρ / κ - 1 := fun ρ hρ => by
      rw [le_sub_iff_add_le, le_div_iff₀ hκ0]; linarith
    have hB1 : ∀ ρ, ρ ≤ 1 / κ → 1 ≤ 2 - κ * ρ := fun ρ hρ => by
      rw [le_div_iff₀ hκ0] at hρ; linarith
    have hB1' : ∀ ρ, 1 / κ ≤ ρ → 2 - κ * ρ ≤ 1 := fun ρ hρ => by
      rw [div_le_iff₀ hκ0] at hρ; linarith
    have hB0 : ∀ ρ, ρ ≤ 2 / κ → 0 ≤ 2 - κ * ρ := fun ρ hρ => by
      rw [le_div_iff₀ hκ0] at hρ; linarith
    have hB0' : ∀ ρ, 2 / κ ≤ ρ → 2 - κ * ρ ≤ 0 := fun ρ hρ => by
      rw [div_le_iff₀ hκ0] at hρ; linarith
    -- values of `g` on the five pieces
    have hv1 : ∀ ρ, ρ ≤ κ / 2 → g ρ = 0 := fun ρ hρ =>
      max_eq_left ((min_le_right _ _).trans ((min_le_left _ _).trans (hA0 ρ hρ)))
    have hv2 : ∀ ρ, κ / 2 ≤ ρ → ρ ≤ κ → g ρ = 2 * ρ / κ - 1 := fun ρ hρ hρ' => by
      have h1 := hA1 ρ hρ'
      have h2 := hB1 ρ (hρ'.trans hb2.le)
      simp only [hg, min_eq_left (h1.trans h2), min_eq_right h1, max_eq_right (hA0' ρ hρ)]
    have hv3 : ∀ ρ, κ ≤ ρ → ρ ≤ 1 / κ → g ρ = 1 := fun ρ hρ hρ' => by
      have h := le_min (hA1' ρ hρ) (hB1 ρ hρ')
      simp only [hg, min_eq_left h, max_eq_right zero_le_one]
    have hv4 : ∀ ρ, 1 / κ ≤ ρ → ρ ≤ 2 / κ → g ρ = 2 - κ * ρ := fun ρ hρ hρ' => by
      have h1 := hB1' ρ hρ
      have h2 := hA1' ρ (hb2.le.trans hρ)
      simp only [hg, min_eq_right (h1.trans h2), min_eq_right h1, max_eq_right (hB0 ρ hρ')]
    have hv5 : ∀ ρ, 2 / κ ≤ ρ → g ρ = 0 := fun ρ hρ =>
      max_eq_left ((min_le_right _ _).trans ((min_le_right _ _).trans (hB0' ρ hρ)))
    refine ⟨g, g', ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · -- Lipschitz: `max 0 (min 1 (min ℓ₁ ℓ₂))` with `ℓ₁, ℓ₂` affine
      have hl1 : LipschitzWith (Real.toNNReal (2 / κ)) (fun ρ : ℝ => 2 * ρ / κ - 1) := by
        apply LipschitzWith.of_dist_le_mul
        intro x y
        rw [Real.coe_toNNReal _ (by positivity), Real.dist_eq, Real.dist_eq,
          show 2 * x / κ - 1 - (2 * y / κ - 1) = 2 / κ * (x - y) by ring, abs_mul,
          abs_of_pos (by positivity)]
      have hl2 : LipschitzWith (Real.toNNReal κ) (fun ρ : ℝ => 2 - κ * ρ) := by
        apply LipschitzWith.of_dist_le_mul
        intro x y
        rw [Real.coe_toNNReal _ hκ0.le, Real.dist_eq, Real.dist_eq,
          show 2 - κ * x - (2 - κ * y) = -κ * (x - y) by ring, abs_mul, abs_neg, abs_of_pos hκ0]
      exact ⟨_, ((hl1.min hl2).const_min 1).const_max 0⟩
    · intro ρ
      exact ⟨le_max_left _ _, max_le zero_le_one (min_le_left _ _)⟩
    · rintro ρ (hρ | hρ)
      · exact hv1 ρ hρ.le
      · exact hv5 ρ hρ.le
    · intro ρ h1 h2 h3 h4
      rcases lt_or_gt_of_ne h1 with hρ1 | hρ1
      · -- `ρ < κ/2`: `g = 0` near `ρ`
        have hev : g =ᶠ[𝓝 ρ] fun _ => 0 :=
          Filter.eventually_of_mem (Iio_mem_nhds hρ1) fun t ht => hv1 t (le_of_lt ht)
        have hval : g' ρ = 0 := by
          simp only [hg', mem_Ioo]
          rw [ite_eq_right (by intro h; linarith [h.1]), ite_eq_right (by intro h; linarith [h.1])]
        rw [hval]
        exact (hasDerivAt_const ρ (0 : ℝ)).congr_of_eventuallyEq hev
      rcases lt_or_gt_of_ne h2 with hρ2 | hρ2
      · -- `κ/2 < ρ < κ`: `g(t) = 2t/κ − 1` near `ρ`
        have hev : g =ᶠ[𝓝 ρ] fun t => 2 * t / κ - 1 :=
          Filter.eventually_of_mem (Ioo_mem_nhds hρ1 hρ2) fun t ht => hv2 t ht.1.le ht.2.le
        have hval : g' ρ = 2 / κ := by
          simp only [hg', mem_Ioo]
          rw [ite_eq_left ⟨hρ1, hρ2⟩]
        rw [hval]
        have hd : HasDerivAt (fun t : ℝ => 2 * t / κ - 1) (2 * 1 / κ) ρ :=
          (((hasDerivAt_id ρ).const_mul 2).div_const κ).sub_const 1
        rw [mul_one] at hd
        exact hd.congr_of_eventuallyEq hev
      rcases lt_or_gt_of_ne h3 with hρ3 | hρ3
      · -- `κ < ρ < 1/κ`: `g = 1` near `ρ`
        have hev : g =ᶠ[𝓝 ρ] fun _ => 1 :=
          Filter.eventually_of_mem (Ioo_mem_nhds hρ2 hρ3) fun t ht => hv3 t ht.1.le ht.2.le
        have hval : g' ρ = 0 := by
          simp only [hg', mem_Ioo]
          rw [ite_eq_right (by intro h; linarith [h.2]), ite_eq_right (by intro h; linarith [h.1])]
        rw [hval]
        exact (hasDerivAt_const ρ (1 : ℝ)).congr_of_eventuallyEq hev
      rcases lt_or_gt_of_ne h4 with hρ4 | hρ4
      · -- `1/κ < ρ < 2/κ`: `g(t) = 2 − κt` near `ρ`
        have hev : g =ᶠ[𝓝 ρ] fun t => 2 - κ * t :=
          Filter.eventually_of_mem (Ioo_mem_nhds hρ3 hρ4) fun t ht => hv4 t ht.1.le ht.2.le
        have hval : g' ρ = -κ := by
          simp only [hg', mem_Ioo]
          rw [ite_eq_right (by intro h; linarith [h.2]), ite_eq_left ⟨hρ3, hρ4⟩]
        rw [hval]
        have hd : HasDerivAt (fun t : ℝ => 2 - κ * t) (-(κ * 1)) ρ :=
          ((hasDerivAt_id ρ).const_mul κ).const_sub 2
        rw [mul_one] at hd
        exact hd.congr_of_eventuallyEq hev
      · -- `ρ > 2/κ`: `g = 0` near `ρ`
        have hev : g =ᶠ[𝓝 ρ] fun _ => 0 :=
          Filter.eventually_of_mem (Ioi_mem_nhds hρ4) fun t ht => hv5 t (le_of_lt ht)
        have hval : g' ρ = 0 := by
          simp only [hg', mem_Ioo]
          rw [ite_eq_right (by intro h; linarith [h.2]), ite_eq_right (by intro h; linarith [h.2])]
        rw [hval]
        exact (hasDerivAt_const ρ (0 : ℝ)).congr_of_eventuallyEq hev
    · exact Measurable.ite measurableSet_Ioo measurable_const
        (Measurable.ite measurableSet_Ioo measurable_const measurable_const)
    · intro ρ hρ
      simp only [hg', mem_Ioo]
      split_ifs with h h'
      · have : ρ * (2 / κ) ≤ 2 := by
          rw [mul_div_assoc', div_le_iff₀ hκ0]; linarith [h.2]
        have h0 : 0 ≤ ρ * (2 / κ) := by positivity
        nlinarith
      · have : ρ * κ ≤ 2 := by
          have := h'.2; rw [lt_div_iff₀ hκ0] at this; linarith
        have h0 : 0 ≤ ρ * κ := by positivity
        nlinarith
      · norm_num
    · intro ρ hρ hρ'
      refine ⟨hv3 ρ hρ.le hρ'.le, ?_⟩
      simp only [hg', mem_Ioo]
      rw [ite_eq_right (by intro h; linarith [h.2]), ite_eq_right (by intro h; linarith [h.1])]
  intro hA₀ hMA₀ h0M hMsub hcl hcone hfin hνO hν hdens hH3
  -- the product of two bounded Lipschitz functions is Lipschitz
  have hlipmul : ∀ (f g : Euclid P → ℝ) (s : Set (Euclid P)) (Kf Kg : NNReal) (Bf Bg : ℝ),
      LipschitzOnWith Kf f s → LipschitzOnWith Kg g s → (∀ x ∈ s, |f x| ≤ Bf) →
      (∀ x ∈ s, |g x| ≤ Bg) →
      LipschitzOnWith (Real.toNNReal Bf * Kg + Real.toNNReal Bg * Kf) (fun x => f x * g x) s := by
    intro f g s Kf Kg Bf Bg hf hg hBf hBg
    apply LipschitzOnWith.of_dist_le_mul
    intro x hx y hy
    have hBf0 : 0 ≤ Bf := (abs_nonneg _).trans (hBf x hx)
    have hBg0 : 0 ≤ Bg := (abs_nonneg _).trans (hBg y hy)
    have h1 := hf.dist_le_mul x hx y hy
    have h2 := hg.dist_le_mul x hx y hy
    rw [Real.dist_eq] at h1 h2 ⊢
    push_cast
    rw [Real.coe_toNNReal _ hBf0, Real.coe_toNNReal _ hBg0]
    have e : f x * g x - f y * g y = f x * (g x - g y) + g y * (f x - f y) := by ring
    rw [e]
    calc |f x * (g x - g y) + g y * (f x - f y)| ≤ |f x| * |g x - g y| + |g y| * |f x - f y| := by
          rw [← abs_mul, ← abs_mul]; exact abs_add_le _ _
      _ ≤ Bf * (Kg * dist x y) + Bg * (Kf * dist x y) := by
          gcongr
          · exact hBf x hx
          · exact hBg y hy
      _ = (Bf * Kg + Bg * Kf) * dist x y := by ring
  -- Step 2: radial test functions, `Σⱼ (δⱼ(u ∘ |·|)(x))² = u'(|x|)²` for `x ∈ T_xM`
  have hradial : ∀ (x : Euclid P) (u : ℝ → ℝ) (d : ℝ), x ≠ 0 → x ∈ tangentSpace M x →
      HasDerivAt u d ‖x‖ → ∑ j : Fin P, (fderivWithin ℝ (fun y => u ‖y‖) M x
        ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2 =
        d ^ 2 := by
    intro x u d hx hxT hu
    have hr : 0 < ‖x‖ := norm_pos_iff.2 hx
    -- derivative of the norm at `x ≠ 0`
    have hnorm : HasFDerivAt (fun y : Euclid P => ‖y‖) ((1 / (2 * ‖x‖)) • (2 • innerSL ℝ x)) x := by
      have h1 := (hasStrictFDerivAt_norm_sq x).hasFDerivAt.sqrt (by positivity)
      simp only [Real.sqrt_sq (norm_nonneg _)] at h1
      exact h1
    have hφ : HasFDerivWithinAt (fun y => u ‖y‖) (d • ((1 / (2 * ‖x‖)) • (2 • innerSL ℝ x))) M x :=
      (hu.comp_hasFDerivAt x hnorm).hasFDerivWithinAt
    have hPx : (Submodule.span ℝ (tangentSpace M x)).starProjection x = x :=
      Submodule.starProjection_eq_self_iff.2 (Submodule.subset_span hxT)
    have key : ∀ j : Fin P, fderivWithin ℝ (fun y => u ‖y‖) M x
        ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) =
        d / ‖x‖ * x.ofLp j := by
      intro j
      rw [Submission.codim1_hcp_sc_fderivWithin_tangent_eq P ℝ M _ _ x hφ _
        (Submodule.starProjection_apply_mem _ _)]
      simp only [smul_apply, innerSL_apply_apply, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat]
      rw [← Submodule.inner_starProjection_left_eq_right, hPx, EuclideanSpace.inner_single_right,
        one_mul, conj_trivial]
      field_simp
    simp_rw [key]
    have hs := EuclideanSpace.real_norm_sq_eq x
    calc ∑ j : Fin P, (d / ‖x‖ * x.ofLp j) ^ 2 = (d / ‖x‖) ^ 2 * ∑ j : Fin P, x.ofLp j ^ 2 := by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
      _ = (d / ‖x‖) ^ 2 * ‖x‖ ^ 2 := by rw [hs]
      _ = d ^ 2 := by field_simp
  -- Step 1(a): cone facts; `M = M̄ \ {0}` is Borel
  have hM1 : IsEmbeddedSubmanifold 1 m M := hMsub 1
  have hx0 : ∀ x ∈ M, x ≠ 0 := fun x hx h => h0M (h ▸ hx)
  have hxpos : ∀ x ∈ M, 0 < ‖x‖ := fun x hx => norm_pos_iff.2 (hx0 x hx)
  have hclM : ∀ x ∈ closure M, x ≠ 0 → x ∈ M := fun x hx hx' =>
    (Set.mem_insert_iff.1 (hcl hx)).resolve_left hx'
  have hMmeas : MeasurableSet M := by
    have hMeq : M = closure M \ {0} := by
      ext x
      exact ⟨fun hx => ⟨subset_closure hx, hx0 x hx⟩, fun hx => hclM x hx.1 hx.2⟩
    rw [hMeq]
    exact isClosed_closure.measurableSet.diff (measurableSet_singleton 0)
  -- the sibling results
  have hNC := Submission.codim1_hcp_sc_tangent_normal_complement P m A₀ M ν hA₀ hMA₀ hM1 hν
  have hCN :=
    Submission.codim1_hcp_sc_cone_normal_homogeneous P m A₀ M ν hA₀ hMA₀ hM1 hcone hνO hν
  obtain ⟨hsph, hint_in, hint_out⟩ :=
    Submission.codim1_hcp_sc_cone_annuli_measure P m M h0M hcl hcone hfin
  obtain ⟨O, hO, hMO, hνC⟩ := hνO
  -- Step 1(b): `T_x = A₀ ∩ ν(x)^⊥` is a linear subspace
  have hspan : ∀ x ∈ M, ∀ w ∈ Submodule.span ℝ (tangentSpace M x), w ∈ tangentSpace M x := by
    intro x hx w hw
    have hT := (hNC x hx).1
    have hle : Submodule.span ℝ (tangentSpace M x) ≤ A₀ ⊓ LinearMap.ker (innerₛₗ ℝ (ν x)) := by
      rw [hT, Submodule.span_le]
      rintro v ⟨hvA, hvν⟩
      exact ⟨hvA, hvν⟩
    have hw' := hle hw
    rw [hT]
    exact ⟨hw'.1, hw'.2⟩
  -- `|A|²`, nonnegative and continuous on `M` (`P_x = Π_{A₀} − ν(x) ⊗ ν(x)`)
  set A2 : Euclid P → ℝ := fun x => ∑ j : Fin P,
    ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection
      (EuclideanSpace.single j 1))‖ ^ 2 with hA2
  have hA2nn : ∀ x, 0 ≤ A2 x := fun x => Finset.sum_nonneg fun j _ => sq_nonneg _
  have hA2cont : ContinuousOn A2 M := by
    have hD : ContinuousOn (fderiv ℝ ν) O := hνC.continuousOn_fderiv_of_isOpen hO (by simp)
    have hνc : ContinuousOn ν O := hνC.continuousOn
    have hÃ : ContinuousOn (fun y => ∑ j : Fin P, ‖fderiv ℝ ν y (A₀.starProjection
        (EuclideanSpace.single j 1) - inner ℝ (ν y) (EuclideanSpace.single j 1) • ν y)‖ ^ 2) O := by
      refine continuousOn_finsetSum _ fun j _ => ?_
      have hinner : ContinuousOn
          (fun y => inner ℝ (ν y) (EuclideanSpace.single j (1 : ℝ) : Euclid P)) O :=
        hνc.inner continuousOn_const
      have hvec : ContinuousOn (fun y =>
          A₀.starProjection (EuclideanSpace.single j (1 : ℝ) : Euclid P) -
          inner ℝ (ν y) (EuclideanSpace.single j (1 : ℝ) : Euclid P) • ν y) O :=
        continuousOn_const.sub (hinner.smul hνc)
      exact ((hD.clm_apply hvec).norm).pow 2
    refine (hÃ.mono hMO).congr fun x hx => ?_
    simp only [hA2, (hNC x hx).2]
  -- Step 1(d): `|A|²(tx) = t⁻²|A|²(x)`
  have hhom : ∀ x ∈ M, ∀ t : ℝ, 0 < t → A2 (t • x) = (t ^ 2)⁻¹ * A2 x := by
    intro x hx t ht
    have htx : t • x ∈ M := hcone t ht x hx
    obtain ⟨-, hνt, hD⟩ := (hCN x hx).2.2 t ht
    simp only [hA2, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hP : (Submodule.span ℝ (tangentSpace M (t • x))).starProjection
        (EuclideanSpace.single j 1) = (Submodule.span ℝ (tangentSpace M x)).starProjection
        (EuclideanSpace.single j 1) := by
      rw [(hNC _ htx).2, (hNC x hx).2, hνt]
    have hv := hspan x hx _ (Submodule.starProjection_apply_mem
      (Submodule.span ℝ (tangentSpace M x)) (EuclideanSpace.single j 1))
    have h := hD _ hv
    rw [hP, ← h, norm_smul, mul_pow, Real.norm_eq_abs, sq_abs, ← mul_assoc,
      inv_mul_cancel₀ (pow_pos ht 2).ne', one_mul]
  -- Step 1(e): `|A|²(x) ≤ c|x|⁻²`, `c = max_{M ∩ S¹} |A|²`
  obtain ⟨cA, hcA0, hcA⟩ : ∃ c : ℝ, 0 ≤ c ∧ ∀ x ∈ M, A2 x ≤ c / ‖x‖ ^ 2 := by
    have hSph : IsCompact (closure M ∩ sphere (0 : Euclid P) 1) :=
      (isCompact_sphere 0 1).inter_left isClosed_closure
    have hSphM : closure M ∩ sphere (0 : Euclid P) 1 ⊆ M := fun y hy =>
      hclM y hy.1 (by rintro rfl; simp at hy)
    obtain ⟨c, hc⟩ := hSph.exists_bound_of_continuousOn (hA2cont.mono hSphM)
    refine ⟨max c 0, le_max_right _ _, fun x hx => ?_⟩
    have hr := hxpos x hx
    have hyM : ‖x‖⁻¹ • x ∈ M := hcone _ (inv_pos.2 hr) x hx
    have hy1 : ‖x‖⁻¹ • x ∈ sphere (0 : Euclid P) 1 := by
      rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hr.ne']
    have hxy : ‖x‖ • (‖x‖⁻¹ • x) = x := by rw [smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
    have hb := hc _ ⟨subset_closure hyM, hy1⟩
    rw [Real.norm_eq_abs, abs_of_nonneg (hA2nn _)] at hb
    calc A2 x = A2 (‖x‖ • (‖x‖⁻¹ • x)) := by rw [hxy]
      _ = (‖x‖ ^ 2)⁻¹ * A2 (‖x‖⁻¹ • x) := hhom _ hyM _ hr
      _ ≤ (‖x‖ ^ 2)⁻¹ * max c 0 := by gcongr; exact hb.trans (le_max_left _ _)
      _ = max c 0 / ‖x‖ ^ 2 := by rw [inv_mul_eq_div]
  -- Step 3: spheres are null
  have hae : ∀ c : ℝ, 0 < c → ∀ᵐ x ∂(μHE[m].restrict M), ‖x‖ ≠ c := by
    intro c hc
    rw [ae_restrict_iff' hMmeas]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 (hsph c hc)] with x hx hxM hxc
    exact hx ⟨hxM, mem_sphere_zero_iff_norm.2 hxc⟩
  -- Step 4: the profile `p`
  have hm2' : (2 : ℝ) ≤ m := by exact_mod_cast hm2
  -- Step 5: `F = |A|² p(r)²/r²` is integrable on `M`
  set F : Euclid P → ℝ := fun x => A2 x * p ‖x‖ ^ 2 / ‖x‖ ^ 2 with hF
  have hFnn : ∀ x, 0 ≤ F x := fun x =>
    div_nonneg (mul_nonneg (hA2nn x) (sq_nonneg _)) (sq_nonneg _)
  have hpc : ContinuousOn (fun x : Euclid P => p ‖x‖) M := fun x hx =>
    ((hp _ (hxpos x hx)).continuousAt.comp continuous_norm.continuousAt).continuousWithinAt
  have hFcont : ContinuousOn F M :=
    (hA2cont.mul (hpc.pow 2)).div (continuous_norm.continuousOn.pow 2)
      fun x hx => (pow_pos (hxpos x hx) 2).ne'
  have hFle : ∀ x ∈ M, ∀ e : ℝ, p ‖x‖ ^ 2 ≤ ‖x‖ ^ e * ‖x‖ ^ 4 → F x ≤ cA * ‖x‖ ^ e := by
    intro x hx e he
    have hr := hxpos x hx
    have hr2 : 0 < ‖x‖ ^ 2 := by positivity
    show A2 x * p ‖x‖ ^ 2 / ‖x‖ ^ 2 ≤ cA * ‖x‖ ^ e
    rw [div_le_iff₀ hr2]
    calc A2 x * p ‖x‖ ^ 2 ≤ (cA / ‖x‖ ^ 2) * (‖x‖ ^ e * ‖x‖ ^ 4) :=
          mul_le_mul (hcA x hx) he (sq_nonneg _) (by positivity)
      _ = cA * ‖x‖ ^ e * ‖x‖ ^ 2 := by field_simp
  have hFint : Integrable F (μHE[m].restrict M) := by
    refine ⟨hFcont.aestronglyMeasurable hMmeas, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (ae_of_all _ hFnn),
      ← lintegral_inter_add_sdiff _ M (measurableSet_ball (x := (0 : Euclid P)) (ε := 1))]
    refine ENNReal.add_lt_top.2 ⟨?_, ?_⟩
    · calc ∫⁻ x in M ∩ ball 0 1, ENNReal.ofReal (F x) ∂μHE[m]
          ≤ ∫⁻ x in M ∩ ball 0 1, ENNReal.ofReal cA * ENNReal.ofReal (‖x‖ ^ (-(9 / 5) : ℝ))
              ∂μHE[m] := by
            refine setLIntegral_mono' (hMmeas.inter measurableSet_ball) fun x hx => ?_
            rw [← ENNReal.ofReal_mul hcA0]
            exact ENNReal.ofReal_le_ofReal (hFle x hx.1 _ (hpα _ (hxpos x hx.1)))
        _ = ENNReal.ofReal cA * ∫⁻ x in M ∩ ball 0 1, ENNReal.ofReal (‖x‖ ^ (-(9 / 5) : ℝ))
              ∂μHE[m] := lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
        _ < ∞ := ENNReal.mul_lt_top ENNReal.ofReal_lt_top
            (lt_top_iff_ne_top.2 (hint_in _ (by linarith)))
    · calc ∫⁻ x in M \ ball 0 1, ENNReal.ofReal (F x) ∂μHE[m]
          ≤ ∫⁻ x in M \ ball 0 1, ENNReal.ofReal cA * ENNReal.ofReal (‖x‖ ^ (-(m : ℝ) - 1 / 5))
              ∂μHE[m] := by
            refine setLIntegral_mono' (hMmeas.diff measurableSet_ball) fun x hx => ?_
            rw [← ENNReal.ofReal_mul hcA0]
            exact ENNReal.ofReal_le_ofReal (hFle x hx.1 _ (hpβ _ (hxpos x hx.1)))
        _ = ENNReal.ofReal cA * ∫⁻ x in M \ ball 0 1, ENNReal.ofReal (‖x‖ ^ (-(m : ℝ) - 1 / 5))
              ∂μHE[m] := lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
        _ < ∞ := ENNReal.mul_lt_top ENNReal.ofReal_lt_top
            (lt_top_iff_ne_top.2 (hint_out _ (by linarith)))
  -- Step 6: the cut-offs `gₙ`, `κₙ = 1/(n+2)`
  have hκ0 : ∀ n : ℕ, (0 : ℝ) < 1 / ((n : ℝ) + 2) := fun n => by positivity
  have hκ1 : ∀ n : ℕ, 1 / ((n : ℝ) + 2) < 1 := fun n => by
    rw [div_lt_one (by positivity)]
    linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
  choose g g' hgL hg01 hgsupp hgd hg'meas hg'bd hg1 using
    fun n : ℕ => hcutoff (1 / ((n : ℝ) + 2)) (hκ0 n) (hκ1 n)
  have hXbd : ∀ n x, ‖g n ‖x‖ ^ 2 * F x‖ ≤ F x := by
    intro n x
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (sq_nonneg _) (hFnn x))]
    have h01 := hg01 n ‖x‖
    have h1 : g n ‖x‖ ^ 2 ≤ 1 := by nlinarith [h01.1, h01.2]
    calc g n ‖x‖ ^ 2 * F x ≤ 1 * F x := mul_le_mul_of_nonneg_right h1 (hFnn x)
      _ = F x := one_mul _
  have hYbd : ∀ n, ∀ x ∈ M, ‖A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2‖ ≤ 4 * F x := by
    intro n x hx
    have hr := hxpos x hx
    have hb := hg'bd n ‖x‖ hr
    rw [Real.norm_eq_abs, abs_of_nonneg
      (mul_nonneg (mul_nonneg (hA2nn x) (sq_nonneg _)) (sq_nonneg _))]
    have h4 : g' n ‖x‖ ^ 2 ≤ 4 / ‖x‖ ^ 2 := by
      rw [le_div_iff₀ (by positivity)]
      nlinarith [hb]
    calc A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2 ≤ A2 x * p ‖x‖ ^ 2 * (4 / ‖x‖ ^ 2) :=
          mul_le_mul_of_nonneg_left h4 (mul_nonneg (hA2nn x) (sq_nonneg _))
      _ = 4 * F x := by simp only [hF]; ring
  have hXint : ∀ n, Integrable (fun x => g n ‖x‖ ^ 2 * F x) (μHE[m].restrict M) := by
    intro n
    obtain ⟨K, hK⟩ := hgL n
    exact hFint.mono' ((((hK.continuous.comp continuous_norm).continuousOn.pow 2).mul
      hFcont).aestronglyMeasurable hMmeas) (ae_of_all _ (hXbd n))
  have hYint : ∀ n, Integrable (fun x => A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2) (μHE[m].restrict M) := by
    intro n
    refine (hFint.const_mul 4).mono' (((hA2cont.mul (hpc.pow 2)).aestronglyMeasurable
      hMmeas).mul (((hg'meas n).comp measurable_norm).pow_const 2).aestronglyMeasurable) ?_
    rw [ae_restrict_iff' hMmeas]
    exact ae_of_all _ (hYbd n)
  -- Step 6(c)–(e): (3) for `ψₙ = p(r)gₙ(r)` gives `(37/200)∫gₙ²F ≤ 3∫|A|²p²gₙ'²`
  have hkey : ∀ n : ℕ, 37 / 200 * (∫ x in M, g n ‖x‖ ^ 2 * F x ∂μHE[m]) ≤
      3 * ∫ x in M, A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2 ∂μHE[m] := by
    intro n
    set κ : ℝ := 1 / ((n : ℝ) + 2) with hκ
    have hκ' : 0 < κ := hκ0 n
    obtain ⟨K, hK⟩ := hgL n
    -- (a) `ψₙ` is locally Lipschitz on `M`
    have hφL : LocallyLipschitzOn M (fun y : Euclid P => p ‖y‖ * g n ‖y‖) := by
      intro x hx
      obtain ⟨K₁, t, ht, hK₁⟩ :=
        ((hpC ‖x‖ (hxpos x hx)).comp x (contDiffAt_norm ℝ (hx0 x hx))).exists_lipschitzOnWith
      have hxt : x ∈ t := mem_of_mem_nhds ht
      refine ⟨_, t ∩ ball x 1, mem_nhdsWithin_of_mem_nhds (inter_mem ht (ball_mem_nhds x one_pos)),
        hlipmul _ _ _ _ _ (|p ‖x‖| + K₁) 1 (hK₁.mono inter_subset_left)
          ((hK.comp lipschitzWith_one_norm).lipschitzOnWith) ?_ ?_⟩
      · intro y hy
        have h1 := hK₁.dist_le_mul y hy.1 x hxt
        have h2 : dist y x < 1 := hy.2
        rw [Real.dist_eq] at h1
        have h3 : (K₁ : ℝ) * dist y x ≤ K₁ := by
          calc (K₁ : ℝ) * dist y x ≤ K₁ * 1 := mul_le_mul_of_nonneg_left h2.le K₁.2
            _ = K₁ := mul_one _
        have h4 := abs_sub_abs_le_abs_sub (p ‖y‖) (p ‖x‖)
        simp only [Function.comp] at h1 ⊢
        linarith
      · intro y _
        have h01 := hg01 n ‖y‖
        rw [abs_of_nonneg h01.1]
        exact h01.2
    -- (b) `ψₙ` vanishes on `M` outside the compact `M̄ ∩ {κ/2 ≤ r ≤ 2/κ} ⊆ M`
    have hφsupp : ∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧
        ∀ x ∈ M, x ∉ C → p ‖x‖ * g n ‖x‖ = 0 := by
      refine ⟨closure M ∩ (closedBall 0 (2 / κ) \ ball 0 (κ / 2)),
        ((isCompact_closedBall 0 _).diff isOpen_ball).inter_left isClosed_closure, ?_, ?_⟩
      · rintro x ⟨hx, -, hx2⟩
        refine hclM x hx ?_
        rintro rfl
        exact hx2 (mem_ball_self (by positivity))
      · intro x hx hxC
        have hout : ‖x‖ < κ / 2 ∨ 2 / κ < ‖x‖ := by
          rcases lt_or_ge ‖x‖ (κ / 2) with h | h
          · exact Or.inl h
          rcases lt_or_ge (2 / κ) ‖x‖ with h' | h'
          · exact Or.inr h'
          exact absurd ⟨subset_closure hx, mem_closedBall_zero_iff.2 h', fun hb => by
            rw [mem_ball_zero_iff] at hb; linarith⟩ hxC
        rw [hgsupp n ‖x‖ hout, mul_zero]
    -- (c) apply (3)
    have h3 := hH3 (fun y : Euclid P => p ‖y‖ * g n ‖y‖) hφL hφsupp
    -- (d) the right side off the null spheres `r ∈ {κ/2, κ, 1/κ, 2/κ}`
    have hbound : ∫ x in M, A2 x * (p' ‖x‖ * g n ‖x‖ + p ‖x‖ * g' n ‖x‖) ^ 2 ∂μHE[m] ≤
        ∫ x in M, (363 / 200 * (g n ‖x‖ ^ 2 * F x) + 3 * (A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2))
          ∂μHE[m] := by
      refine integral_mono_of_nonneg (ae_of_all _ fun x => mul_nonneg (hA2nn x) (sq_nonneg _))
        (((hXint n).const_mul _).add ((hYint n).const_mul _)) ?_
      rw [EventuallyLE, ae_restrict_iff' hMmeas]
      refine ae_of_all _ fun x hx => ?_
      have hr := hxpos x hx
      have hpp := hp' ‖x‖ hr
      have h1 : (p' ‖x‖ * g n ‖x‖ + p ‖x‖ * g' n ‖x‖) ^ 2 ≤
          3 / 2 * (p' ‖x‖ * g n ‖x‖) ^ 2 + 3 * (p ‖x‖ * g' n ‖x‖) ^ 2 := by
        nlinarith [sq_nonneg (p' ‖x‖ * g n ‖x‖ - 2 * (p ‖x‖ * g' n ‖x‖))]
      have h2 : p' ‖x‖ ^ 2 ≤ 121 / 100 * (p ‖x‖ ^ 2 / ‖x‖ ^ 2) := by
        rw [mul_div_assoc', le_div_iff₀ (by positivity)]
        nlinarith [hpp]
      have h2' : (p' ‖x‖ * g n ‖x‖) ^ 2 ≤ 121 / 100 * (g n ‖x‖ ^ 2 * (p ‖x‖ ^ 2 / ‖x‖ ^ 2)) := by
        calc (p' ‖x‖ * g n ‖x‖) ^ 2 = g n ‖x‖ ^ 2 * p' ‖x‖ ^ 2 := by ring
          _ ≤ g n ‖x‖ ^ 2 * (121 / 100 * (p ‖x‖ ^ 2 / ‖x‖ ^ 2)) :=
            mul_le_mul_of_nonneg_left h2 (sq_nonneg _)
          _ = 121 / 100 * (g n ‖x‖ ^ 2 * (p ‖x‖ ^ 2 / ‖x‖ ^ 2)) := by ring
      calc A2 x * (p' ‖x‖ * g n ‖x‖ + p ‖x‖ * g' n ‖x‖) ^ 2
          ≤ A2 x * (3 / 2 * (121 / 100 * (g n ‖x‖ ^ 2 * (p ‖x‖ ^ 2 / ‖x‖ ^ 2))) +
              3 * (p ‖x‖ * g' n ‖x‖) ^ 2) := by
            apply mul_le_mul_of_nonneg_left _ (hA2nn x)
            linarith
        _ = 363 / 200 * (g n ‖x‖ ^ 2 * F x) + 3 * (A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2) := by
            simp only [hF]; ring
    have hsplit : ∫ x in M, (363 / 200 * (g n ‖x‖ ^ 2 * F x) +
          3 * (A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2)) ∂μHE[m] =
        363 / 200 * (∫ x in M, g n ‖x‖ ^ 2 * F x ∂μHE[m]) +
          3 * ∫ x in M, A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2 ∂μHE[m] := by
      rw [integral_add ((hXint n).const_mul _) ((hYint n).const_mul _), integral_const_mul,
        integral_const_mul]
    have hineq : 2 * (∫ x in M, g n ‖x‖ ^ 2 * F x ∂μHE[m]) ≤
        363 / 200 * (∫ x in M, g n ‖x‖ ^ 2 * F x ∂μHE[m]) +
          3 * ∫ x in M, A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2 ∂μHE[m] := by
      calc 2 * (∫ x in M, g n ‖x‖ ^ 2 * F x ∂μHE[m])
          = 2 * ∫ x in M, (p ‖x‖ * g n ‖x‖) ^ 2 * A2 x / ‖x‖ ^ 2 ∂μHE[m] := by
            congr 1
            refine integral_congr_ae (ae_of_all _ fun x => ?_)
            simp only [hF]
            ring
        _ ≤ ∫ x in M, A2 x * ∑ j : Fin P, (fderivWithin ℝ (fun y : Euclid P => p ‖y‖ * g n ‖y‖)
              M x ((Submodule.span ℝ (tangentSpace M x)).starProjection
                (EuclideanSpace.single j 1))) ^ 2 ∂μHE[m] := h3
        _ = ∫ x in M, A2 x * (p' ‖x‖ * g n ‖x‖ + p ‖x‖ * g' n ‖x‖) ^ 2 ∂μHE[m] := by
            refine integral_congr_ae ?_
            filter_upwards [hae (κ / 2) (by positivity), hae κ hκ', hae (1 / κ) (by positivity),
              hae (2 / κ) (by positivity), self_mem_ae_restrict hMmeas] with x h1 h2 h3 h4 hxM
            have hrad := hradial x (fun r => p r * g n r) _
              (hx0 x hxM) (hCN x hxM).1 ((hp _ (hxpos x hxM)).mul (hgd n _ h1 h2 h3 h4))
            exact congrArg (fun s => A2 x * s) hrad
        _ ≤ _ := hbound
        _ = _ := hsplit
    linarith
  -- Step 7: `κₙ → 0`; for `x ∈ M`, eventually `gₙ(|x|) = 1` and `gₙ'(|x|) = 0`
  have hev : ∀ x ∈ M, ∀ᶠ n : ℕ in atTop, g n ‖x‖ = 1 ∧ g' n ‖x‖ = 0 := by
    intro x hx
    have hr := hxpos x hx
    obtain ⟨N, hN⟩ := exists_nat_gt (max (1 / ‖x‖) ‖x‖)
    filter_upwards [eventually_ge_atTop N] with n hn
    have hn' : (N : ℝ) ≤ n := by exact_mod_cast hn
    have hm1 := le_max_left (1 / ‖x‖) ‖x‖
    have hm2 := le_max_right (1 / ‖x‖) ‖x‖
    have h1 : 1 / ((n : ℝ) + 2) < ‖x‖ := by
      rw [div_lt_iff₀ (by positivity)]
      have h : 1 / ‖x‖ < n + 2 := by linarith
      rw [div_lt_iff₀ hr] at h
      linarith
    have h2 : ‖x‖ < 1 / (1 / ((n : ℝ) + 2)) := by
      rw [one_div_one_div]
      linarith
    exact hg1 n ‖x‖ h1 h2
  have hXlim : Tendsto (fun n => ∫ x in M, g n ‖x‖ ^ 2 * F x ∂μHE[m]) atTop
      (𝓝 (∫ x in M, F x ∂μHE[m])) := by
    refine tendsto_integral_of_dominated_convergence F (fun n => (hXint n).aestronglyMeasurable)
      hFint (fun n => ae_of_all _ (hXbd n)) ?_
    rw [ae_restrict_iff' hMmeas]
    refine ae_of_all _ fun x hx => tendsto_const_nhds.congr' ?_
    filter_upwards [hev x hx] with n hn
    rw [hn.1]
    ring
  have hYlim : Tendsto (fun n => ∫ x in M, A2 x * p ‖x‖ ^ 2 * g' n ‖x‖ ^ 2 ∂μHE[m]) atTop
      (𝓝 0) := by
    have h := tendsto_integral_of_dominated_convergence (μ := μHE[m].restrict M)
      (f := fun _ => (0 : ℝ)) (fun x => 4 * F x) (fun n => (hYint n).aestronglyMeasurable)
      (hFint.const_mul 4) (fun n => (ae_restrict_iff' hMmeas).2 (ae_of_all _ (hYbd n))) ?_
    · simpa using h
    rw [ae_restrict_iff' hMmeas]
    refine ae_of_all _ fun x hx => tendsto_const_nhds.congr' ?_
    filter_upwards [hev x hx] with n hn
    rw [hn.2]
    ring
  -- Step 8: `(37/200)∫_M F ≤ 0`, so `∫_M F = 0`
  have hJ0 : ∫ x in M, F x ∂μHE[m] = 0 := by
    have hlim := le_of_tendsto_of_tendsto' (hXlim.const_mul (37 / 200)) (hYlim.const_mul 3) hkey
    rw [mul_zero] at hlim
    have hJnn : 0 ≤ ∫ x in M, F x ∂μHE[m] := integral_nonneg hFnn
    linarith
  -- Step 9: `|A|² = 0` a.e. on `M`
  have hAE : ∀ᵐ x ∂μHE[m], x ∈ M → A2 x = 0 := by
    have h := (integral_eq_zero_iff_of_nonneg_ae (ae_of_all _ hFnn) hFint).1 hJ0
    rw [EventuallyEq, ae_restrict_iff' hMmeas] at h
    filter_upwards [h] with x hx hxM
    have hFx : A2 x * p ‖x‖ ^ 2 / ‖x‖ ^ 2 = 0 := hx hxM
    have hr := hxpos x hxM
    have hpx := hp0 ‖x‖ hr
    rcases div_eq_zero_iff.1 hFx with h1 | h1
    · rcases mul_eq_zero.1 h1 with h2 | h2
      · exact h2
      · exact absurd h2 (pow_pos hpx 2).ne'
    · exact absurd h1 (pow_pos hr 2).ne'
  -- Step 10: `|A|² ≡ 0` on `M` (continuity and density one)
  have hA2zero : ∀ x ∈ M, A2 x = 0 := by
    intro x₀ hx₀
    by_contra hne
    have hpos : 0 < A2 x₀ := lt_of_le_of_ne (hA2nn x₀) (Ne.symm hne)
    obtain ⟨δ, hδ, hδA⟩ := Metric.continuousOn_iff.1 hA2cont x₀ hx₀ (A2 x₀) hpos
    have hev1 : ∀ᶠ s in 𝓝[>] (0 : ℝ),
        0 < μHE[m] (M ∩ ball x₀ s) / (unitBallVolume m * ENNReal.ofReal (s ^ m)) :=
      (hdens x₀ hx₀).eventually (lt_mem_nhds zero_lt_one)
    have hev2 : ∀ᶠ s in 𝓝[>] (0 : ℝ), s < δ :=
      eventually_nhdsWithin_of_eventually_nhds (eventually_lt_nhds hδ)
    obtain ⟨s, hs1, hs2⟩ := (hev1.and hev2).exists
    have hnull : μHE[m] (M ∩ ball x₀ s) = 0 := by
      refine measure_mono_null (fun y hy => ?_) (ae_iff.1 hAE)
      simp only [mem_ofPred_eq, not_imp]
      refine ⟨hy.1, ?_⟩
      have hd := hδA y hy.1 (lt_trans (mem_ball.1 hy.2) hs2)
      rw [Real.dist_eq] at hd
      have := (abs_lt.1 hd).1
      linarith
    rw [hnull, ENNReal.zero_div] at hs1
    exact lt_irrefl 0 hs1
  -- Step 11: `Dν(x)(P_xeⱼ) = 0` for all `j`, hence `Dν(x) = 0` on `T_x`
  intro x hx v hv
  have hA2x : A2 x = 0 := hA2zero x hx
  simp only [hA2] at hA2x
  have hj : ∀ j : Fin P, fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection
      (EuclideanSpace.single j 1)) = 0 := by
    intro j
    have h := (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => sq_nonneg _)).1 hA2x j
      (Finset.mem_univ j)
    exact norm_eq_zero.1 ((pow_eq_zero_iff two_ne_zero).1 h)
  have hcomp : (fderiv ℝ ν x).comp (Submodule.span ℝ (tangentSpace M x)).starProjection = 0 := by
    apply ContinuousLinearMap.coe_injective
    refine (EuclideanSpace.basisFun (Fin P) ℝ).toBasis.ext fun j => ?_
    simp [hj j]
  have hPv : (Submodule.span ℝ (tangentSpace M x)).starProjection v = v :=
    Submodule.starProjection_eq_self_iff.2 (Submodule.subset_span hv)
  have h := congrArg (fun L : Euclid P →L[ℝ] Euclid P => L v) hcomp
  simp only [ContinuousLinearMap.comp_apply, hPv, zero_apply] at h
  exact h

/-- **Integration by parts on a stationary hypersurface** (parent proof (4c)).  Let `M ⊆ A₀`
(`dim A₀ = m + 1`, `0 ∉ M`) be stationary away from `0`, with smooth unit normal `ν ∈ A₀` and the
Lipschitz approximation property (HL), and let `F` be `C²` near `M` with `F = f` on `M`.  For `φ`
locally Lipschitz on `M` and vanishing on `M` off a compact subset of `M`, both integrands are
`Hᵐ⌞M`-integrable and `∫_M Σⱼ δⱼφ δⱼf = −∫_M φ Σⱼ δⱼ(δⱼf)`, where `δⱼg(x) = D^M g(x)(Pₓeⱼ)`.

By normal_complement `Pₓeⱼ = Πeⱼ − ⟨ν(x), eⱼ⟩ν(x)` on `M`, so (tangent_fderiv) `δⱼf` and
`δⱼ(δⱼf)` are restrictions of `Gⱼ = DF(Πeⱼ − ⟨ν, eⱼ⟩ν)` and `DGⱼ(Πeⱼ − ⟨ν, eⱼ⟩ν)`.  With the (HL)
approximants `χₖ → φ` and a cut-off `β` equal to `1` on the supports, `Xₖ = χₖβ Σⱼ Gⱼeⱼ` is an
admissible field and `tr(Pₓ ∘ DXₖ(x)) = Σⱼ δⱼχₖ δⱼf + χₖ Σⱼ δⱼ(δⱼf)` on `M`, whose integral
vanishes by stationarity.  Let `k → ∞`: Cauchy–Schwarz and Hölder turn the `L²` convergence
`δχₖ → δφ` into `L¹` convergence of the first term, and dominated convergence handles the second. -/
theorem Submission.codim1_hcp_sc_stationary_integration_by_parts : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (0 : Euclid P) ∉ M → IsEmbeddedSubmanifold 1 m M → MeasurableSet M → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → (0 : Euclid P) ∉ tsupport X → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → ((∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → ∀ j : Fin P, AEStronglyMeasurable (fun x => fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) (μHE[m].restrict M)) ∧ ∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∃ (C' : Set (Euclid P)) (ζs : ℕ → Euclid P → ℝ), IsCompact C' ∧ C' ⊆ M ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ζs k) ∧ HasCompactSupport (ζs k)) ∧ (∀ k, ∀ x ∈ M, x ∉ C' → ζs k x = 0) ∧ TendstoUniformlyOn ζs ζ atTop M ∧ Tendsto (fun k => ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P, (fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) - fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) atTop (𝓝 0)) → ∀ (f F : Euclid P → ℝ) (O' : Set (Euclid P)), IsOpen O' → M ⊆ O' → ContDiffOn ℝ 2 F O' → (∀ y ∈ M, F y = f y) → ∀ φ : Euclid P → ℝ, LocallyLipschitzOn M φ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → φ x = 0) → Integrable (fun x => ∑ j : Fin P, fderivWithin ℝ φ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) * fderivWithin ℝ f M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) (μHE[m].restrict M) ∧ Integrable (fun x => φ x * ∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ f M y ((Submodule.span ℝ (tangentSpace M y)).starProjection (EuclideanSpace.single j 1))) M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) (μHE[m].restrict M) ∧ ∫ x in M, (∑ j : Fin P, fderivWithin ℝ φ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) * fderivWithin ℝ f M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ∂μHE[m] = -(∫ x in M, φ x * (∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ f M y ((Submodule.span ℝ (tangentSpace M y)).starProjection (EuclideanSpace.single j 1))) M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ∂μHE[m]) := by
  intro P m A₀ M ν hdim hMA hM0 hMsub hMmeas hMfin hstat hνO hν HL f F O' hO' hMO' hF hFf φ hφ hφC
  have hTan := Submission.codim1_hcp_sc_fderivWithin_tangent_eq
  have hNC := Submission.codim1_hcp_sc_tangent_normal_complement P m A₀ M ν hdim hMA hMsub hν
  obtain ⟨O, hO, hMO, hνs⟩ := hνO
  obtain ⟨HL1, HL2⟩ := HL
  obtain ⟨C, hC, hCM, hφ0⟩ := hφC
  -- `Pr x = Pₓ`, the orthogonal projection onto `span TₓM`
  obtain ⟨Pr, hPr⟩ : ∃ Pr : Euclid P → Euclid P →L[ℝ] Euclid P,
      ∀ x, Pr x = (Submodule.span ℝ (tangentSpace M x)).starProjection := ⟨_, fun _ => rfl⟩
  simp only [← hPr] at HL1 HL2 hstat ⊢
  have hPr_mem : ∀ x v, Pr x v ∈ Submodule.span ℝ (tangentSpace M x) := fun x v => by
    rw [hPr]; exact Submodule.starProjection_apply_mem _ v
  -- step 1 (smooth extensions): by normal_complement `Pₓeⱼ = p j x` on `M`, where
  -- `p j z = Πeⱼ − ⟨ν(z), eⱼ⟩ν(z)` is `C¹` on `U = (O ∩ O') \ {0} ⊇ M`; `Gⱼ(z) = DF(z)(p j z)` is
  -- `C¹` on `U`, and `δⱼf = Gⱼ`, `δⱼ(δⱼf) = DGⱼ(pⱼ)` on `M` (tangent_fderiv)
  set p : Fin P → Euclid P → Euclid P := fun j z =>
    A₀.starProjection (EuclideanSpace.single j 1) - inner ℝ (ν z) (EuclideanSpace.single j 1) • ν z
  have hPp : ∀ x ∈ M, ∀ j, Pr x (EuclideanSpace.single j 1) = p j x := fun x hx j => by
    rw [hPr]; exact (hNC x hx).2 _
  set U : Set (Euclid P) := (O ∩ O') \ {0}
  have hUo : IsOpen U := (hO.inter hO').sdiff isClosed_singleton
  have hMU : M ⊆ U := fun x hx =>
    ⟨⟨hMO hx, hMO' hx⟩, fun h0 => hM0 (by rwa [mem_singleton_iff.1 h0] at hx)⟩
  have hν1 : ContDiffOn ℝ 1 ν U :=
    (hνs.of_le (by exact_mod_cast le_top)).mono fun x hx => hx.1.1
  have hDF : ContDiffOn ℝ 1 (fderiv ℝ F) U :=
    (hF.fderiv_of_isOpen hO' (by norm_num)).mono fun x hx => hx.1.2
  have hp1 : ∀ j, ContDiffOn ℝ 1 (p j) U := fun j =>
    contDiffOn_const.sub ((hν1.inner ℝ contDiffOn_const).smul hν1)
  set G : Fin P → Euclid P → ℝ := fun j z => fderiv ℝ F z (p j z)
  have hG1 : ∀ j, ContDiffOn ℝ 1 (G j) U := fun j => hDF.clm_apply (hp1 j)
  have hGd : ∀ j, ∀ x ∈ U, HasFDerivAt (G j) (fderiv ℝ (G j) x) x := fun j x hx =>
    (((hG1 j).differentiableOn one_ne_zero).differentiableAt (hUo.mem_nhds hx)).hasFDerivAt
  have hdf : ∀ j, ∀ x ∈ M, fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1)) = G j x := by
    intro j x hx
    have hFx : HasFDerivAt F (fderiv ℝ F x) x :=
      ((hF.differentiableOn two_ne_zero).differentiableAt (hO'.mem_nhds (hMO' hx))).hasFDerivAt
    rw [hTan P ℝ M f _ x (hFx.hasFDerivWithinAt.congr' (fun y hy => (hFf y hy).symm) hx) _
      (hPr_mem x _), hPp x hx j]
  have hddf : ∀ j, ∀ x ∈ M, fderivWithin ℝ (fun y => fderivWithin ℝ f M y
      (Pr y (EuclideanSpace.single j 1))) M x (Pr x (EuclideanSpace.single j 1)) =
      fderiv ℝ (G j) x (p j x) := by
    intro j x hx
    rw [hTan P ℝ M _ _ x ((hGd j x (hMU hx)).hasFDerivWithinAt.congr' (fun y hy => hdf j y hy) hx)
      _ (hPr_mem x _), hPp x hx j]
  have hdf_cont : ∀ j, ContinuousOn
      (fun x => fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1))) M := fun j =>
    ((hG1 j).continuousOn.mono hMU).congr fun x hx => hdf j x hx
  have hlap_cont : ContinuousOn (fun x => ∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ f M y
      (Pr y (EuclideanSpace.single j 1))) M x (Pr x (EuclideanSpace.single j 1))) M :=
    continuousOn_finsetSum _ fun j _ =>
      ((((hG1 j).continuousOn_fderiv_of_isOpen hUo le_rfl).clm_apply
        (hp1 j).continuousOn).mono hMU).congr fun x hx => hddf j x hx
  -- step 2(b): if `g = 0` on `M \ K` (`K` closed), then `g` has tangential derivative `0` there
  have hvanish : ∀ (g : Euclid P → ℝ) (K : Set (Euclid P)), IsClosed K →
      (∀ y ∈ M, y ∉ K → g y = 0) → ∀ x ∈ M, x ∉ K →
      ∀ v ∈ Submodule.span ℝ (tangentSpace M x), fderivWithin ℝ g M x v = 0 := by
    intro g K hK hg x hx hxK v hv
    have h0 : HasFDerivWithinAt g (0 : Euclid P →L[ℝ] ℝ) M x := by
      refine (hasFDerivWithinAt_const (0 : ℝ) x M).congr_of_eventuallyEq ?_ (hg x hx hxK)
      filter_upwards [inter_mem_nhdsWithin M (hK.isOpen_compl.mem_nhds hxK)] with y hy
      exact hg y hy.1 hy.2
    simpa using hTan P ℝ M g 0 x h0 v hv
  have hvanish' : ∀ (g : Euclid P → ℝ) (K : Set (Euclid P)), IsClosed K →
      (∀ y ∈ M, y ∉ K → g y = 0) → ∀ x ∈ M, x ∉ K → DifferentiableAt ℝ g x →
      ∀ v ∈ Submodule.span ℝ (tangentSpace M x), fderiv ℝ g x v = 0 := by
    intro g K hK hg x hx hxK hd v hv
    rw [← hTan P ℝ M g _ x hd.hasFDerivAt.hasFDerivWithinAt v hv]
    exact hvanish g K hK hg x hx hxK v hv
  -- step 4: the (HL)(ii) approximants `χₖ` of `φ`, and the compact set `K = C ∪ C'' ⊆ M`
  obtain ⟨C'', χ, hC'', hC''M, hχs, hχ0, hχu, hχL2⟩ := HL2 φ hφ ⟨C, hC, hCM, hφ0⟩
  set K : Set (Euclid P) := C ∪ C''
  have hK : IsCompact K := hC.union hC''
  have hKM : K ⊆ M := union_subset hCM hC''M
  have hμK : (μHE[m].restrict M) K ≠ ∞ := by
    rw [Measure.restrict_apply hK.measurableSet, inter_comm]; exact hMfin K hK
  have hφK : ∀ x ∈ M, x ∉ K → φ x = 0 := fun x hx hxK => hφ0 x hx fun h => hxK (Or.inl h)
  have hχK : ∀ k, ∀ x ∈ M, x ∉ K → χ k x = 0 := fun k x hx hxK =>
    hχ0 k x hx fun h => hxK (Or.inr h)
  have hχ1 : ∀ k, ContDiff ℝ 1 (χ k) := fun k => (hχs k).1.of_le (by exact_mod_cast le_top)
  have hχd : ∀ k x, HasFDerivAt (χ k) (fderiv ℝ (χ k) x) x := fun k x =>
    ((hχ1 k).differentiable one_ne_zero x).hasFDerivAt
  have hdφK : ∀ j, ∀ x ∈ M, x ∉ K → fderivWithin ℝ φ M x (Pr x (EuclideanSpace.single j 1)) = 0 :=
    fun j x hx hxK => hvanish φ C hC.isClosed hφ0 x hx (fun h => hxK (Or.inl h)) _ (hPr_mem x _)
  have hdχK : ∀ k j, ∀ x ∈ M, x ∉ K → fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1)) = 0 :=
    fun k j x hx hxK => hvanish' (χ k) C'' hC''.isClosed (hχ0 k) x hx (fun h => hxK (Or.inr h))
      (hχd k x).differentiableAt _ (hPr_mem x _)
  have hdχ_cont : ∀ k j, ContinuousOn
      (fun x => fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1))) M := fun k j =>
    ((((hχ1 k).continuous_fderiv one_ne_zero).continuousOn.clm_apply (hp1 j).continuousOn).mono
      hMU).congr fun x hx => by simp only [hPp x hx j]
  -- step 3 (integrability): continuous on `M` and zero on `M \ K` implies integrable,
  -- since `Hᵐ(M ∩ K) < ∞`
  have hint : ∀ h : Euclid P → ℝ, ContinuousOn h M → (∀ x ∈ M, x ∉ K → h x = 0) →
      Integrable h (μHE[m].restrict M) := by
    intro h hc h0
    obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn (hc.mono hKM)
    refine Integrable.mono' (g := K.indicator fun _ => B)
      ((integrable_indicator_iff hK.measurableSet).2 (integrableOn_const hμK))
      (hc.aestronglyMeasurable hMmeas) ?_
    filter_upwards [ae_restrict_mem hMmeas] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK]; exact hB x hxK
    · rw [indicator_of_notMem hxK, h0 x hx hxK, norm_zero]
  have hIφB : Integrable (fun x => φ x * ∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ f M y
      (Pr y (EuclideanSpace.single j 1))) M x (Pr x (EuclideanSpace.single j 1)))
      (μHE[m].restrict M) :=
    hint _ (hφ.continuousOn.mul hlap_cont) fun x hx hxK => by rw [hφK x hx hxK, zero_mul]
  have hIA : ∀ k, Integrable (fun x => ∑ j : Fin P, fderiv ℝ (χ k) x
      (Pr x (EuclideanSpace.single j 1)) * fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1)))
      (μHE[m].restrict M) := fun k =>
    hint _ (continuousOn_finsetSum _ fun j _ => (hdχ_cont k j).mul (hdf_cont j))
      fun x hx hxK => Finset.sum_eq_zero fun j _ => by rw [hdχK k j x hx hxK, zero_mul]
  have hIB : ∀ k, Integrable (fun x => χ k x * ∑ j : Fin P, fderivWithin ℝ (fun y =>
      fderivWithin ℝ f M y (Pr y (EuclideanSpace.single j 1))) M x
      (Pr x (EuclideanSpace.single j 1))) (μHE[m].restrict M) := fun k =>
    hint _ ((hχ1 k).continuous.continuousOn.mul hlap_cont) fun x hx hxK => by
      rw [hχK k x hx hxK, zero_mul]
  -- step 5 (cut-off): `K ⊆ W₁` with `closure W₁ ⊆ U` compact, and a smooth `β : ℝᴾ → [0, 1]`
  -- with `support β = W₁` and `β = 1` exactly on `K`, so `Dβ = 0` on `K` (maxima of `β`)
  obtain ⟨W₁, hW₁o, hKW₁, hW₁U, hW₁c⟩ :=
    exists_open_between_and_isCompact_closure hK hUo (hKM.trans hMU)
  obtain ⟨β, hβs, hβr, hβsupp, hβ1⟩ :=
    exists_contDiff_support_eq_eq_one_iff (n := ⊤) hW₁o hK.isClosed hKW₁
  have hβ1' : ContDiff ℝ 1 β := hβs.of_le (by exact_mod_cast le_top)
  have hβts : tsupport β = closure W₁ := by rw [tsupport, hβsupp]
  have hβU : tsupport β ⊆ U := hβts ▸ hW₁U
  have hβc : HasCompactSupport β := by rw [HasCompactSupport, hβts]; exact hW₁c
  have hβK : ∀ x ∈ K, β x = 1 := fun x hx => (hβ1 x).1 hx
  have hDβ : ∀ x ∈ K, fderiv ℝ β x = 0 := fun x hx =>
    IsLocalMax.fderiv_eq_zero (Filter.Eventually.of_forall fun y => by
      rw [hβK x hx]; exact (hβr (mem_range_self y)).2)
  have hβd : ∀ x, HasFDerivAt β (fderiv ℝ β x) x := fun x =>
    (hβ1'.differentiable one_ne_zero x).hasFDerivAt
  -- `Xₖ = Σᵢ cₖᵢ eᵢ` with `cₖᵢ = 1_U χₖ β Gᵢ` is `C¹` with support in `tsupport β ⊆ U ∌ 0`
  set c : ℕ → Fin P → Euclid P → ℝ := fun k i => U.indicator fun z => χ k z * β z * G i z
    with hc_def
  set X : ℕ → Euclid P → Euclid P := fun k z =>
    ∑ i : Fin P, c k i z • EuclideanSpace.single i (1 : ℝ) with hX_def
  have hc_eq : ∀ k i, ∀ x ∈ U, c k i =ᶠ[𝓝 x] fun z => χ k z * β z * G i z := fun k i x hx => by
    filter_upwards [hUo.mem_nhds hx] with z hz
    simp only [hc_def, indicator_of_mem hz]
  have hc1 : ∀ k i, ContDiff ℝ 1 (c k i) := by
    intro k i
    refine contDiff_iff_contDiffAt.2 fun z => ?_
    by_cases hz : z ∈ tsupport β
    · exact ((((hχ1 k).contDiffAt.mul hβ1'.contDiffAt).mul
        ((hG1 i).contDiffAt (hUo.mem_nhds (hβU hz)))).congr_of_eventuallyEq
        (hc_eq k i z (hβU hz)))
    · refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
      filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hz] with w hw
      simp only [Pi.zero_apply] at hw
      simp [hc_def, hw]
  have hX1 : ∀ k, ContDiff ℝ 1 (X k) := fun k =>
    ContDiff.sum fun i _ => (hc1 k i).smul contDiff_const
  have hXsupp : ∀ k, support (X k) ⊆ tsupport β := by
    intro k z hz
    by_contra hzβ
    refine hz ?_
    have hβz : β z = 0 := image_eq_zero_of_notMem_tsupport hzβ
    classical
    simp [hX_def, hc_def, indicator_apply, hβz]
  have hXc : ∀ k, HasCompactSupport (X k) := fun k => hβc.mono' (hXsupp k)
  have hX0 : ∀ k, (0 : Euclid P) ∉ tsupport (X k) := fun k h0 =>
    (hβU (closure_minimal (hXsupp k) (isClosed_tsupport β) h0)).2 (mem_singleton _)
  -- step 6: for `x ∈ M`, `tr(Pₓ ∘ DXₖ(x)) = tr(DXₖ(x) ∘ Pₓ) = Σⱼ D(cₖⱼ)(x)(Pₓeⱼ)
  -- = Σⱼ δⱼχₖ δⱼf + χₖ Σⱼ δⱼ(δⱼf)` (product rule; `β = 1`, `Dβ = 0` on `K`, `χₖ = δχₖ = 0` off `K`)
  have htr : ∀ k, ∀ x ∈ M, LinearMap.trace ℝ (Euclid P) ((Pr x).toLinearMap ∘ₗ
      (fderiv ℝ (X k) x).toLinearMap) =
      ∑ j : Fin P, fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1)) *
        fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1)) +
      χ k x * ∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ f M y
        (Pr y (EuclideanSpace.single j 1))) M x (Pr x (EuclideanSpace.single j 1)) := by
    intro k x hx
    have hXd : fderiv ℝ (X k) x = ∑ i : Fin P,
        (fderiv ℝ (c k i) x).smulRight (EuclideanSpace.single i (1 : ℝ)) :=
      (HasFDerivAt.fun_sum fun i _ =>
        ((hc1 k i).differentiable one_ne_zero x).hasFDerivAt.smul_const _).fderiv
    rw [LinearMap.trace_comp_comm',
      LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin P) ℝ), Finset.mul_sum,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    have h1 : inner ℝ ((EuclideanSpace.basisFun (Fin P) ℝ) j)
        (((fderiv ℝ (X k) x).toLinearMap ∘ₗ (Pr x).toLinearMap)
          ((EuclideanSpace.basisFun (Fin P) ℝ) j)) =
        fderiv ℝ (c k j) x (Pr x (EuclideanSpace.single j 1)) := by
      rw [EuclideanSpace.basisFun_apply, LinearMap.comp_apply, ContinuousLinearMap.coe_coe,
        ContinuousLinearMap.coe_coe, hXd, EuclideanSpace.inner_single_left]
      simp [Pi.single_apply]
    have hprod : HasFDerivAt (fun z => χ k z * β z * G j z)
        ((χ k x * β x) • fderiv ℝ (G j) x +
          G j x • (χ k x • fderiv ℝ β x + β x • fderiv ℝ (χ k) x)) x :=
      ((hχd k x).fun_mul (hβd x)).fun_mul (hGd j x (hMU hx))
    rw [h1, (hc_eq k j x (hMU hx)).fderiv_eq, hprod.fderiv]
    simp only [add_apply, smul_apply, smul_eq_mul]
    rw [hdf j x hx, hddf j x hx, ← hPp x hx j]
    by_cases hxK : x ∈ K
    · rw [hβK x hxK, hDβ x hxK]
      simp only [zero_apply]
      ring
    · rw [hχK k x hx hxK, hdχK k j x hx hxK]
      ring
  -- step 7 (stationarity): `∫_M (Σⱼ δⱼχₖ δⱼf + χₖ Σⱼ δⱼ(δⱼf)) = 0`
  have hIk : ∀ k, ∫ x in M, (∑ j : Fin P, fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1)) *
      fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1)) +
      χ k x * ∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ f M y
        (Pr y (EuclideanSpace.single j 1))) M x (Pr x (EuclideanSpace.single j 1))) ∂μHE[m] = 0 :=
    fun k => (setIntegral_congr_fun hMmeas fun x hx => (htr k x hx).symm).trans
      (hstat (X k) (hX1 k) (hXc k) (hX0 k))
  -- step 8 (limit): `Σⱼ δⱼχₖ δⱼf → Σⱼ δⱼφ δⱼf` in `L¹`, since on `M`
  -- `|Σⱼ (δⱼχₖ − δⱼφ) δⱼf| ≤ (Σⱼ (δⱼχₖ − δⱼφ)²)^{1/2} · √B₂ · 1_K` (Cauchy–Schwarz in `j`; both
  -- sides vanish off `K`), then Hölder and (HL)(ii)
  have hCS : ∀ (a d : Fin P → ℝ) (B : ℝ), ∑ j, d j ^ 2 ≤ B →
      |∑ j, a j * d j| ≤ Real.sqrt (∑ j, a j ^ 2) * Real.sqrt B := by
    intro a d B hB
    refine (Real.abs_le_sqrt (Finset.sum_mul_sq_le_sq_mul_sq _ _ _)).trans ?_
    rw [← Real.sqrt_mul (Finset.sum_nonneg fun j _ => sq_nonneg _)]
    exact Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left hB (Finset.sum_nonneg fun j _ => sq_nonneg _))
  have hsq : ∀ a : Fin P → ℝ,
      ENNReal.ofReal (Real.sqrt (∑ j, a j ^ 2)) ^ (2 : ℝ) = ENNReal.ofReal (∑ j, a j ^ 2) :=
    fun a => by
      rw [ENNReal.ofReal_rpow_of_nonneg (Real.sqrt_nonneg _) zero_le_two, Real.rpow_two,
        Real.sq_sqrt (Finset.sum_nonneg fun j _ => sq_nonneg _)]
  obtain ⟨B₂, hB₂⟩ := hK.exists_bound_of_continuousOn
    ((continuousOn_finsetSum Finset.univ fun j _ => (hdf_cont j).pow 2).mono hKM)
  have hgm : AEMeasurable (K.indicator fun _ => ENNReal.ofReal (Real.sqrt B₂))
      (μHE[m].restrict M) := aemeasurable_const.indicator hK.measurableSet
  have hg2 : ∫⁻ x in M, (K.indicator (fun _ => ENNReal.ofReal (Real.sqrt B₂)) x) ^ (2 : ℝ)
      ∂μHE[m] ≠ ∞ := by
    have : (fun x => (K.indicator (fun _ => ENNReal.ofReal (Real.sqrt B₂)) x) ^ (2 : ℝ)) =
        K.indicator fun _ => ENNReal.ofReal (Real.sqrt B₂) ^ (2 : ℝ) := by
      funext x
      by_cases hx : x ∈ K
      · simp [hx]
      · simp [hx, ENNReal.zero_rpow_of_pos two_pos]
    rw [this, lintegral_indicator_const hK.measurableSet]
    exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg zero_le_two ENNReal.ofReal_ne_top) hμK
  have hAφm : AEStronglyMeasurable (fun x => ∑ j : Fin P, fderivWithin ℝ φ M x
      (Pr x (EuclideanSpace.single j 1)) * fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1)))
      (μHE[m].restrict M) :=
    Finset.aestronglyMeasurable_fun_sum _ fun j _ =>
      (HL1 φ hφ j).mul ((hdf_cont j).aestronglyMeasurable hMmeas)
  have hEst : ∀ k, ∫⁻ x in M, ‖(∑ j : Fin P, fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1)) *
      fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1))) -
      ∑ j : Fin P, fderivWithin ℝ φ M x (Pr x (EuclideanSpace.single j 1)) *
      fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1))‖ₑ ∂μHE[m] ≤
      (∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P, (fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1)) -
        fderivWithin ℝ φ M x (Pr x (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) ^ (1 / 2 : ℝ) *
      (∫⁻ x in M, (K.indicator (fun _ => ENNReal.ofReal (Real.sqrt B₂)) x) ^ (2 : ℝ) ∂μHE[m]) ^
        (1 / 2 : ℝ) := by
    intro k
    have hfm : AEMeasurable (fun x => ENNReal.ofReal (Real.sqrt (∑ j : Fin P,
        (fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1)) -
          fderivWithin ℝ φ M x (Pr x (EuclideanSpace.single j 1))) ^ 2))) (μHE[m].restrict M) :=
      (Finset.aemeasurable_fun_sum _ fun j _ =>
        ((((hdχ_cont k j).aestronglyMeasurable hMmeas).aemeasurable.sub
          (HL1 φ hφ j).aemeasurable).pow_const 2)).sqrt.ennreal_ofReal
    calc _ ≤ ∫⁻ x in M, ENNReal.ofReal (Real.sqrt (∑ j : Fin P,
            (fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1)) -
              fderivWithin ℝ φ M x (Pr x (EuclideanSpace.single j 1))) ^ 2)) *
            K.indicator (fun _ => ENNReal.ofReal (Real.sqrt B₂)) x ∂μHE[m] := by
          refine lintegral_mono_ae ?_
          filter_upwards [ae_restrict_mem hMmeas] with x hx
          rw [← Finset.sum_sub_distrib, Real.enorm_eq_ofReal_abs]
          simp_rw [← sub_mul]
          by_cases hxK : x ∈ K
          · rw [indicator_of_mem hxK, ← ENNReal.ofReal_mul (Real.sqrt_nonneg _)]
            exact ENNReal.ofReal_le_ofReal (hCS _ _ B₂ ((le_abs_self _).trans
              ((Real.norm_eq_abs _).symm.le.trans (hB₂ x hxK))))
          · rw [Finset.sum_eq_zero fun j _ => by
              rw [hdχK k j x hx hxK, hdφK j x hx hxK, sub_zero, zero_mul], abs_zero,
              ENNReal.ofReal_zero]
            exact zero_le
      _ ≤ _ := ENNReal.lintegral_mul_le_Lp_mul_Lq _ Real.HolderConjugate.two_two hfm hgm
      _ = _ := by simp only [hsq]
  have hL1 : Tendsto (fun k => ∫⁻ x in M, ‖(∑ j : Fin P, fderiv ℝ (χ k) x
      (Pr x (EuclideanSpace.single j 1)) * fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1))) -
      ∑ j : Fin P, fderivWithin ℝ φ M x (Pr x (EuclideanSpace.single j 1)) *
      fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1))‖ₑ ∂μHE[m]) atTop (𝓝 0) := by
    have h0 : Tendsto (fun k => (∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1)) -
          fderivWithin ℝ φ M x (Pr x (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) ^ (1 / 2 : ℝ))
        atTop (𝓝 0) := by
      have := ((ENNReal.continuous_rpow_const (y := (1 / 2 : ℝ))).tendsto 0).comp hχL2
      rwa [ENNReal.zero_rpow_of_pos (by norm_num)] at this
    have h1 := ENNReal.Tendsto.mul_const h0
      (Or.inr (ENNReal.rpow_ne_top_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2) hg2))
    rw [zero_mul] at h1
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h1 (fun k => zero_le) hEst
  -- first conjunct: `Σⱼ δⱼφ δⱼf = Aₖ − (Aₖ − Σⱼ δⱼφ δⱼf)`, `Aₖ = Σⱼ δⱼχₖ δⱼf`, where the last
  -- term has finite `L¹` norm for large `k`
  have hIφA : Integrable (fun x => ∑ j : Fin P, fderivWithin ℝ φ M x
      (Pr x (EuclideanSpace.single j 1)) * fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1)))
      (μHE[m].restrict M) := by
    obtain ⟨k, hk⟩ := (hL1.eventually (gt_mem_nhds ENNReal.zero_lt_top)).exists
    have hdiff : Integrable (fun x => (∑ j : Fin P, fderiv ℝ (χ k) x
        (Pr x (EuclideanSpace.single j 1)) * fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1))) -
        ∑ j : Fin P, fderivWithin ℝ φ M x (Pr x (EuclideanSpace.single j 1)) *
        fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1))) (μHE[m].restrict M) :=
      ⟨(hIA k).aestronglyMeasurable.sub hAφm, hasFiniteIntegral_iff_enorm.2 hk⟩
    refine ((hIA k).sub hdiff).congr (Eventually.of_forall fun x => ?_)
    simp only [Pi.sub_apply, sub_sub_cancel]
  have hTA : Tendsto (fun k => ∫ x in M, (∑ j : Fin P, fderiv ℝ (χ k) x
      (Pr x (EuclideanSpace.single j 1)) * fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1)))
      ∂μHE[m]) atTop (𝓝 (∫ x in M, (∑ j : Fin P, fderivWithin ℝ φ M x
      (Pr x (EuclideanSpace.single j 1)) * fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1)))
      ∂μHE[m])) :=
    tendsto_integral_of_L1 _ hAφm (Eventually.of_forall hIA) hL1
  -- `∫ χₖ Σⱼ δⱼ(δⱼf) → ∫ φ Σⱼ δⱼ(δⱼf)` by dominated convergence (`χₖ → φ` uniformly on `M`, and
  -- everything vanishes off `K`)
  obtain ⟨Φ, hΦ⟩ := hK.exists_bound_of_continuousOn (hφ.continuousOn.mono hKM)
  obtain ⟨L, hL⟩ := hK.exists_bound_of_continuousOn (hlap_cont.mono hKM)
  have hTB : Tendsto (fun k => ∫ x in M, χ k x * (∑ j : Fin P, fderivWithin ℝ (fun y =>
      fderivWithin ℝ f M y (Pr y (EuclideanSpace.single j 1))) M x
      (Pr x (EuclideanSpace.single j 1))) ∂μHE[m]) atTop (𝓝 (∫ x in M, φ x * (∑ j : Fin P,
      fderivWithin ℝ (fun y => fderivWithin ℝ f M y (Pr y (EuclideanSpace.single j 1))) M x
      (Pr x (EuclideanSpace.single j 1))) ∂μHE[m])) := by
    refine tendsto_integral_filter_of_dominated_convergence (K.indicator fun _ => (Φ + 1) * L)
      (Eventually.of_forall fun k => (hIB k).aestronglyMeasurable) ?_
      ((integrable_indicator_iff hK.measurableSet).2 (integrableOn_const hμK)) ?_
    · filter_upwards [Metric.tendstoUniformlyOn_iff.1 hχu 1 one_pos] with k hk
      filter_upwards [ae_restrict_mem hMmeas] with x hx
      by_cases hxK : x ∈ K
      · rw [indicator_of_mem hxK, norm_mul]
        have hΦx := hΦ x hxK
        have hkx := hk x hx
        rw [Real.dist_eq] at hkx
        rw [Real.norm_eq_abs] at hΦx ⊢
        have h1 : |χ k x| ≤ Φ + 1 := by
          have := abs_sub_abs_le_abs_sub (χ k x) (φ x)
          rw [abs_sub_comm] at this
          linarith
        exact mul_le_mul h1 (hL x hxK) (norm_nonneg _) (by linarith [abs_nonneg (φ x)])
      · rw [indicator_of_notMem hxK, hχK k x hx hxK, zero_mul, norm_zero]
    · filter_upwards [ae_restrict_mem hMmeas] with x hx
      exact (hχu.tendsto_at hx).mul_const _
  -- conclusion: `∫ Aₖ = −∫ χₖ Σⱼ δⱼ(δⱼf)` for every `k`; pass to the limit
  have hEq : ∫ x in M, (∑ j : Fin P, fderivWithin ℝ φ M x (Pr x (EuclideanSpace.single j 1)) *
      fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1))) ∂μHE[m] =
      -(∫ x in M, φ x * (∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ f M y
        (Pr y (EuclideanSpace.single j 1))) M x (Pr x (EuclideanSpace.single j 1))) ∂μHE[m]) := by
    have h1 : ∀ k, ∫ x in M, (∑ j : Fin P, fderiv ℝ (χ k) x (Pr x (EuclideanSpace.single j 1)) *
        fderivWithin ℝ f M x (Pr x (EuclideanSpace.single j 1))) ∂μHE[m] =
        -(∫ x in M, χ k x * (∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ f M y
          (Pr y (EuclideanSpace.single j 1))) M x (Pr x (EuclideanSpace.single j 1))) ∂μHE[m]) := by
      intro k
      have h := hIk k
      rw [integral_add (hIA k) (hIB k)] at h
      linarith
    exact tendsto_nhds_unique hTA ((tendsto_congr h1).2 hTB.neg)
  exact ⟨hIφA, hIφB, hEq⟩

/-- **Simons' Hardy-type inequality on a stable minimal hypercone** (Simon, Appendix B, proof of
B.2, inequalities (1)–(3)).  `P_x` is the orthogonal projection onto `T_xM`, `δ_j g(x)` the
tangential derivative `fderivWithin ℝ g M x (P_x e_j)`, `|A|²(x) = Σ_j |Dν(x)(P_x e_j)|²` and
`|A| = √|A|²`.  For `ψ` locally Lipschitz on `M` and vanishing on `M` off a compact `C ⊆ M`:
* `M = closure M \ {0}` is Borel; on `M`, `P_x = Π_{A₀} − ν(x) ⊗ ν(x)` (normal complement), so
  `|A|²` agrees on `M` with the `C²` function `Σ_j |Dν(Π_{A₀}e_j − (ν·e_j)ν)|²` on `O`, and
  `|A|` is the `ℓ²` norm of a `C¹` map, hence locally Lipschitz on `M`;
* by Rademacher, `ψ` and `|A|` are differentiable within `M` at a.e. point; there
  `δ_j(|A|ψ) = |A|δ_jψ + ψδ_j|A|`, `δ_jψ² = 2ψδ_jψ`, `δ_j|A|² = 2|A|δ_j|A|`, and `δ_j|A| = 0` where
  `|A| = 0` (`|A| ≥ 0` is minimal along tangent curves);  the Simons identity and the cone defect
  give `½Δ_M|A|² + |A|⁴ ≥ 2|A|²/|x|² + Σ_j(δ_j|A|)²` (B.2 (1)), hence a.e.
  `2Σ_j(δ_j(|A|ψ))² ≤ 2|A|²Σ_j(δ_jψ)² + ψ²Δ_M|A|² + 2ψ²|A|⁴ − 4ψ²|A|²/|x|² + Σ_jδ_jψ²δ_j|A|²`;
* every term on the right is integrable (`Σ_j(δ_jψ)² ∈ L¹` by the smooth approximations (HL)),
  stability with `ζ = |A|ψ` gives `∫|A|⁴ψ² ≤ ∫Σ_j(δ_j(|A|ψ))²` (B.2 (2)), and integration by parts
  gives `∫Σ_jδ_jψ²δ_j|A|² = −∫ψ²Δ_M|A|²`; combining, `2∫ψ²|A|²/|x|² ≤ ∫|A|²Σ_j(δ_jψ)²`
  (B.2 (3)). -/
theorem Submission.codim1_hcp_sc_simons_hardy_inequality : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (0 : Euclid P) ∉ M → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → closure M ⊆ insert 0 M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → (0 : Euclid P) ∉ tsupport X → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ x ∈ M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap) = 0) → (∀ ζ : Euclid P → ℝ, LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∫ x in M, (∑ j : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))‖ ^ 2) * ζ x ^ 2 ∂μHE[m] ≤ ∫ x in M, ∑ j : Fin P, (fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2 ∂μHE[m]) → ((∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → ∀ j : Fin P, AEStronglyMeasurable (fun x => fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) (μHE[m].restrict M)) ∧ ∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∃ (C' : Set (Euclid P)) (ζs : ℕ → Euclid P → ℝ), IsCompact C' ∧ C' ⊆ M ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ζs k) ∧ HasCompactSupport (ζs k)) ∧ (∀ k, ∀ x ∈ M, x ∉ C' → ζs k x = 0) ∧ TendstoUniformlyOn ζs ζ atTop M ∧ Tendsto (fun k => ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P, (fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) - fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) atTop (𝓝 0)) → ∀ ψ : Euclid P → ℝ, LocallyLipschitzOn M ψ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ψ x = 0) → 2 * (∫ x in M, ψ x ^ 2 * (∑ j : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))‖ ^ 2) / ‖x‖ ^ 2 ∂μHE[m]) ≤ ∫ x in M, (∑ j : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))‖ ^ 2) * (∑ j : Fin P, (fderivWithin ℝ ψ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m] := by
  intro P m A₀ M ν hA₀ hMA h0 hM hcl hcone hfin hstat hνO hν hH hstab hHL ψ hψ hψC
  obtain ⟨O, hO, hMO, hνC⟩ := hνO
  obtain ⟨C, hCc, hCM, hψ0⟩ := hψC
  -- `Pe x j = P_x e_j` and `A2 = |A|²`
  set Pe : Euclid P → Fin P → Euclid P := fun x j =>
    (Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)
  set A2 : Euclid P → ℝ := fun z => ∑ i : Fin P, ‖fderiv ℝ ν z (Pe z i)‖ ^ 2
  have hA2nn : ∀ y, 0 ≤ A2 y := fun y => Finset.sum_nonneg fun i _ => sq_nonneg _
  have hmem : ∀ x j, Pe x j ∈ Submodule.span ℝ (tangentSpace M x) := fun x j =>
    Submodule.starProjection_apply_mem _ _
  -- Step 0(a): `M = closure M \ {0}` is Borel, and `μ⌞M (C) < ∞`
  have hMmeas : MeasurableSet M := by
    have hMeq : M = closure M \ {0} := by
      ext x
      refine ⟨fun hx => ⟨subset_closure hx, fun hx0 => h0 ?_⟩, fun hx => ?_⟩
      · rwa [Set.mem_singleton_iff.mp hx0] at hx
      · rcases Set.mem_insert_iff.mp (hcl hx.1) with hx' | hx'
        · exact absurd (Set.mem_singleton_iff.mpr hx') hx.2
        · exact hx'
    rw [hMeq]
    exact isClosed_closure.measurableSet.diff (measurableSet_singleton 0)
  have hCmeas : MeasurableSet C := hCc.isClosed.measurableSet
  have hμMC : (μHE[m].restrict M) C ≠ ∞ := by
    rw [Measure.restrict_apply hCmeas, Set.inter_eq_left.mpr hCM]
    have h := hfin C hCc
    rwa [Set.inter_eq_right.mpr hCM] at h
  -- integrability on `M` of a.e.-strongly measurable functions bounded on `C`, zero on `M \ C`
  have hint : ∀ g : Euclid P → ℝ, AEStronglyMeasurable g (μHE[m].restrict M) →
      (∃ B, ∀ x ∈ C, ‖g x‖ ≤ B) → (∀ x ∈ M, x ∉ C → g x = 0) →
      Integrable g (μHE[m].restrict M) := by
    rintro g hg ⟨B, hB⟩ hg0
    refine ((integrableOn_const (C := B) hμMC).integrable_indicator hCmeas).mono' hg ?_
    filter_upwards [ae_restrict_mem hMmeas] with x hx
    by_cases hxC : x ∈ C
    · rw [Set.indicator_of_mem hxC]
      exact hB x hxC
    · simp [Set.indicator_of_notMem hxC, hg0 x hx hxC]
  have hintc : ∀ g : Euclid P → ℝ, ContinuousOn g M → (∀ x ∈ M, x ∉ C → g x = 0) →
      Integrable g (μHE[m].restrict M) := fun g hg hg0 =>
    hint g (hg.aestronglyMeasurable hMmeas) (hCc.exists_bound_of_continuousOn (hg.mono hCM)) hg0
  -- Step 0(c2): tangential derivatives of functions vanishing on `M \ C` vanish there
  have hzero : ∀ g : Euclid P → ℝ, (∀ x ∈ M, x ∉ C → g x = 0) →
      ∀ x ∈ M, x ∉ C → fderivWithin ℝ g M x = 0 := by
    intro g hg x hx hxC
    have hloc : g =ᶠ[𝓝[M] x] fun _ => (0 : ℝ) := by
      filter_upwards [inter_mem_nhdsWithin M (hCc.isClosed.isOpen_compl.mem_nhds hxC)] with y hy
      exact hg y hy.1 hy.2
    rw [hloc.fderivWithin_eq (hg x hx hxC), fderivWithin_const_apply]
  -- products of locally Lipschitz real functions are locally Lipschitz
  have hprod : ∀ f g : Euclid P → ℝ, LocallyLipschitzOn M f → LocallyLipschitzOn M g →
      LocallyLipschitzOn M (fun y => f y * g y) := by
    intro f g hf hg x hx
    obtain ⟨Kf, t, ht, hKf⟩ := hf hx
    obtain ⟨Kg, u, hu, hKg⟩ := hg hx
    have hbf : ∀ᶠ y in 𝓝[M] x, ‖f y‖ < ‖f x‖ + 1 :=
      Filter.Tendsto.eventually (hf.continuousOn x hx).norm (gt_mem_nhds (lt_add_one _))
    have hbg : ∀ᶠ y in 𝓝[M] x, ‖g y‖ < ‖g x‖ + 1 :=
      Filter.Tendsto.eventually (hg.continuousOn x hx).norm (gt_mem_nhds (lt_add_one _))
    refine ⟨Real.toNNReal ((‖g x‖ + 1) * Kf + (‖f x‖ + 1) * Kg),
      t ∩ u ∩ {y | ‖f y‖ < ‖f x‖ + 1 ∧ ‖g y‖ < ‖g x‖ + 1},
      inter_mem (inter_mem ht hu) (hbf.and hbg), ?_⟩
    refine LipschitzOnWith.of_dist_le_mul fun y hy z hz => ?_
    obtain ⟨⟨hyt, hyu⟩, hyf, -⟩ := hy
    obtain ⟨⟨hzt, hzu⟩, -, hzg⟩ := hz
    have h1 := hKf.dist_le_mul y hyt z hzt
    have h2 := hKg.dist_le_mul y hyu z hzu
    rw [Real.dist_eq] at h1 h2 ⊢
    have e : f y * g y - f z * g z = g z * (f y - f z) + f y * (g y - g z) := by ring
    calc |f y * g y - f z * g z| = |g z * (f y - f z) + f y * (g y - g z)| := by rw [e]
      _ ≤ |g z| * |f y - f z| + |f y| * |g y - g z| := by
          rw [← abs_mul, ← abs_mul]
          exact abs_add_le _ _
      _ ≤ (‖g x‖ + 1) * (Kf * dist y z) + (‖f x‖ + 1) * (Kg * dist y z) := by
          rw [← Real.norm_eq_abs (g z), ← Real.norm_eq_abs (f y)]
          exact add_le_add (mul_le_mul hzg.le h1 (abs_nonneg _) (by positivity))
            (mul_le_mul hyf.le h2 (abs_nonneg _) (by positivity))
      _ = _ := by
          rw [Real.coe_toNNReal _ (by positivity)]
          ring
  -- Step 0(b): on `M`, `P_y = Π_{A₀} − ν(y) ⊗ ν(y)`; the `C²` extension of `|A|²` to `O`
  have hNC := Submission.codim1_hcp_sc_tangent_normal_complement P m A₀ M ν hA₀ hMA (hM 1) hν
  have hPeq : ∀ y ∈ M, ∀ i : Fin P, Pe y i = A₀.starProjection (EuclideanSpace.single i 1) -
      inner ℝ (ν y) (EuclideanSpace.single i 1) • ν y := fun y hy i => (hNC y hy).2 _
  have hνc : ContDiffOn ℝ 2 ν O := contDiffOn_infty.1 hνC 2
  have hDν : ContDiffOn ℝ 2 (fun y => fderiv ℝ ν y) O :=
    (contDiffOn_infty.1 hνC 3).fderiv_of_isOpen hO (by norm_num)
  have hV : ∀ i : Fin P, ContDiffOn ℝ 2 (fun y => fderiv ℝ ν y
      (A₀.starProjection (EuclideanSpace.single i 1) -
        inner ℝ (ν y) (EuclideanSpace.single i 1) • ν y)) O := fun i =>
    hDν.clm_apply (contDiffOn_const.sub ((hνc.inner ℝ contDiffOn_const).smul hνc))
  have hF : ContDiffOn ℝ 2 (fun y => ∑ i : Fin P, ‖fderiv ℝ ν y
      (A₀.starProjection (EuclideanSpace.single i 1) -
        inner ℝ (ν y) (EuclideanSpace.single i 1) • ν y)‖ ^ 2) O :=
    ContDiffOn.sum fun i _ => (hV i).norm_sq ℝ
  have hAeq : ∀ y ∈ M, A2 y = ∑ i : Fin P, ‖fderiv ℝ ν y
      (A₀.starProjection (EuclideanSpace.single i 1) -
        inner ℝ (ν y) (EuclideanSpace.single i 1) • ν y)‖ ^ 2 := fun y hy =>
    Finset.sum_congr rfl fun i _ => by rw [hPeq y hy i]
  have hAcont : ContinuousOn A2 M := (hF.continuousOn.mono hMO).congr fun y hy => hAeq y hy
  -- `|A| = √|A|²` is the `ℓ²` norm of a `C¹` map on `O`, hence locally Lipschitz on `M`
  have hsLip : LocallyLipschitzOn M (fun y => Real.sqrt (A2 y)) := by
    intro x hx
    have hW : ContDiffOn ℝ 2 (fun y => WithLp.toLp 2 (fun i : Fin P => fderiv ℝ ν y
        (A₀.starProjection (EuclideanSpace.single i 1) -
          inner ℝ (ν y) (EuclideanSpace.single i 1) • ν y))) O :=
      PiLp.contDiff_toLp.comp_contDiffOn (contDiffOn_pi.mpr hV)
    obtain ⟨K, t, ht, hK⟩ :=
      ((hW.contDiffAt (hO.mem_nhds (hMO hx))).of_le (by norm_num)).exists_lipschitzOnWith
    refine ⟨K, t ∩ M, inter_mem (nhdsWithin_le_nhds ht) self_mem_nhdsWithin, ?_⟩
    have hnorm : ∀ y ∈ M, Real.sqrt (A2 y) = ‖WithLp.toLp 2 (fun i : Fin P => fderiv ℝ ν y
        (A₀.starProjection (EuclideanSpace.single i 1) -
          inner ℝ (ν y) (EuclideanSpace.single i 1) • ν y))‖ := fun y hy => by
      rw [PiLp.norm_eq_of_L2, hAeq y hy]
    refine LipschitzOnWith.of_dist_le_mul fun y hy z hz => ?_
    show dist (Real.sqrt (A2 y)) (Real.sqrt (A2 z)) ≤ K * dist y z
    rw [hnorm y hy.2, hnorm z hz.2]
    exact (dist_norm_norm_le _ _).trans ((dist_eq_norm _ _).symm.le.trans
      (hK.dist_le_mul y hy.1 z hz.1))
  have hψc : ContinuousOn ψ M := hψ.continuousOn
  have hζLip : LocallyLipschitzOn M (fun y => Real.sqrt (A2 y) * ψ y) := hprod _ _ hsLip hψ
  have hφLip : LocallyLipschitzOn M (fun y => ψ y ^ 2) := by
    simpa only [sq] using hprod ψ ψ hψ hψ
  have hζ0 : ∀ x ∈ M, x ∉ C → Real.sqrt (A2 x) * ψ x = 0 := fun x hx hxC => by
    rw [hψ0 x hx hxC, mul_zero]
  have hφ0 : ∀ x ∈ M, x ∉ C → ψ x ^ 2 = 0 := fun x hx hxC => by
    rw [hψ0 x hx hxC]
    ring
  -- Step 3 (integrability): `Σ_j (δ_jψ)²` is integrable, by the smooth approximations (HL)
  have hSint : Integrable (fun x => ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2)
      (μHE[m].restrict M) := by
    obtain ⟨C', ζs, -, -, hζs, -, -, hlim⟩ := hHL.2 ψ hψ ⟨C, hCc, hCM, hψ0⟩
    obtain ⟨k, hk⟩ := (hlim.eventually (gt_mem_nhds zero_lt_one)).exists
    obtain ⟨B, hB⟩ := ((hζs k).1.continuous_fderiv (by simp)).bounded_above_of_compact_support
      ((hζs k).2.fderiv ℝ)
    have hsupp : IsCompact (tsupport (ζs k)) := (hζs k).2
    refine ⟨Finset.aestronglyMeasurable_fun_sum _ fun j _ => (hHL.1 ψ hψ j).pow 2,
      (hasFiniteIntegral_iff_ofReal (Eventually.of_forall fun x =>
        Finset.sum_nonneg fun j _ => sq_nonneg _)).mpr ?_⟩
    have h2mul : ∀ X : ℝ, ENNReal.ofReal (2 * X) = 2 * ENNReal.ofReal X := fun X => by
      rw [ENNReal.ofReal_mul zero_le_two, ENNReal.ofReal_ofNat]
    have hpt : ∀ x, ENNReal.ofReal (∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2) ≤
        (tsupport (ζs k)).indicator (fun _ => ENNReal.ofReal (2 * P * B ^ 2)) x +
          2 * ENNReal.ofReal (∑ j : Fin P,
            (fderiv ℝ (ζs k) x (Pe x j) - fderivWithin ℝ ψ M x (Pe x j)) ^ 2) := by
      intro x
      have h1 : ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2 ≤
          2 * ∑ j : Fin P, (fderiv ℝ (ζs k) x (Pe x j)) ^ 2 + 2 * ∑ j : Fin P,
            (fderiv ℝ (ζs k) x (Pe x j) - fderivWithin ℝ ψ M x (Pe x j)) ^ 2 := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
        exact Finset.sum_le_sum fun j _ => by
          nlinarith [sq_nonneg (2 * fderiv ℝ (ζs k) x (Pe x j) - fderivWithin ℝ ψ M x (Pe x j))]
      have h2 : ENNReal.ofReal (2 * ∑ j : Fin P, (fderiv ℝ (ζs k) x (Pe x j)) ^ 2) ≤
          (tsupport (ζs k)).indicator (fun _ => ENNReal.ofReal (2 * P * B ^ 2)) x := by
        by_cases hx : x ∈ tsupport (ζs k)
        · rw [Set.indicator_of_mem hx]
          refine ENNReal.ofReal_le_ofReal ?_
          have hb : ∀ j, (fderiv ℝ (ζs k) x (Pe x j)) ^ 2 ≤ B ^ 2 := fun j => by
            have hPj : ‖Pe x j‖ ≤ 1 :=
              (Submodule.norm_starProjection_apply_le _ _).trans (by simp)
            have hle : |fderiv ℝ (ζs k) x (Pe x j)| ≤ B := by
              rw [← Real.norm_eq_abs]
              exact ((fderiv ℝ (ζs k) x).le_opNorm _).trans
                ((mul_le_mul (hB x) hPj (norm_nonneg _) ((norm_nonneg _).trans (hB x))).trans
                  (mul_one B).le)
            exact sq_le_sq' (abs_le.mp hle).1 (abs_le.mp hle).2
          have hsum := Finset.sum_le_sum fun j (_ : j ∈ Finset.univ) => hb j
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at hsum
          linarith
        · rw [Set.indicator_of_notMem hx, fderiv_of_notMem_tsupport ℝ hx]
          simp
      calc ENNReal.ofReal (∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2)
          ≤ ENNReal.ofReal (2 * ∑ j : Fin P, (fderiv ℝ (ζs k) x (Pe x j)) ^ 2 + 2 * ∑ j : Fin P,
              (fderiv ℝ (ζs k) x (Pe x j) - fderivWithin ℝ ψ M x (Pe x j)) ^ 2) :=
            ENNReal.ofReal_le_ofReal h1
        _ = ENNReal.ofReal (2 * ∑ j : Fin P, (fderiv ℝ (ζs k) x (Pe x j)) ^ 2) +
              2 * ENNReal.ofReal (∑ j : Fin P,
                (fderiv ℝ (ζs k) x (Pe x j) - fderivWithin ℝ ψ M x (Pe x j)) ^ 2) := by
            rw [ENNReal.ofReal_add (by positivity) (by positivity), h2mul (∑ j : Fin P,
              (fderiv ℝ (ζs k) x (Pe x j) - fderivWithin ℝ ψ M x (Pe x j)) ^ 2)]
        _ ≤ _ := add_le_add h2 le_rfl
    calc ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2) ∂μHE[m]
        ≤ ∫⁻ x in M, ((tsupport (ζs k)).indicator (fun _ => ENNReal.ofReal (2 * P * B ^ 2)) x +
          2 * ENNReal.ofReal (∑ j : Fin P,
            (fderiv ℝ (ζs k) x (Pe x j) - fderivWithin ℝ ψ M x (Pe x j)) ^ 2)) ∂μHE[m] :=
          lintegral_mono hpt
      _ = ENNReal.ofReal (2 * P * B ^ 2) * (μHE[m].restrict M) (tsupport (ζs k)) +
          2 * ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P,
            (fderiv ℝ (ζs k) x (Pe x j) - fderivWithin ℝ ψ M x (Pe x j)) ^ 2) ∂μHE[m] := by
          rw [lintegral_add_left (measurable_const.indicator (isClosed_tsupport _).measurableSet),
            lintegral_indicator_const (isClosed_tsupport _).measurableSet,
            lintegral_const_mul' _ _ ENNReal.ofNat_ne_top]
      _ < ∞ := by
          refine ENNReal.add_lt_top.mpr ⟨ENNReal.mul_lt_top ENNReal.ofReal_lt_top ?_,
            ENNReal.mul_lt_top ENNReal.ofNat_lt_top (hk.trans ENNReal.one_lt_top)⟩
          rw [Measure.restrict_apply (isClosed_tsupport _).measurableSet, Set.inter_comm]
          exact (hfin _ hsupp).lt_top
  -- the integrands of the final combination
  have hxne : ∀ x ∈ M, ‖x‖ ^ 2 ≠ 0 := fun x hx =>
    pow_ne_zero 2 (norm_ne_zero_iff.mpr fun h => h0 (h ▸ hx))
  have hIa : Integrable (fun x => A2 x * ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2)
      (μHE[m].restrict M) := by
    obtain ⟨B, hB⟩ := hCc.exists_bound_of_continuousOn (hAcont.mono hCM)
    refine (hSint.const_mul B).mono' ((hAcont.aestronglyMeasurable hMmeas).mul hSint.1) ?_
    filter_upwards [ae_restrict_mem hMmeas] with x hx
    have hS0 : 0 ≤ ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2 :=
      Finset.sum_nonneg fun j _ => sq_nonneg _
    by_cases hxC : x ∈ C
    · rw [norm_mul, Real.norm_of_nonneg hS0]
      exact mul_le_mul_of_nonneg_right (hB x hxC) hS0
    · have hS : ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2 = 0 := by
        simp [hzero ψ hψ0 x hx hxC]
      simp [hS]
  have hIe : Integrable (fun x => ψ x ^ 2 * A2 x ^ 2) (μHE[m].restrict M) :=
    hintc _ ((hψc.pow 2).mul (hAcont.pow 2)) fun x hx hxC => by simp [hψ0 x hx hxC]
  have hIf : Integrable (fun x => ψ x ^ 2 * A2 x / ‖x‖ ^ 2) (μHE[m].restrict M) :=
    hintc _ (((hψc.pow 2).mul hAcont).div (continuous_norm.pow 2).continuousOn hxne)
      fun x hx hxC => by simp [hψ0 x hx hxC]
  -- Step 4: integration by parts (stationary_ibp) with `φ = ψ²`, `f = |A|²`
  obtain ⟨hibp1, hibp2, hibp3⟩ :=
    Submission.codim1_hcp_sc_stationary_integration_by_parts P m A₀ M ν hA₀ hMA h0 (hM 1) hMmeas
      hfin hstat ⟨O, hO, hMO, hνC⟩ hν hHL A2 _ O hO hMO hF (fun y hy => (hAeq y hy).symm)
      (fun y => ψ y ^ 2) hφLip ⟨C, hCc, hCM, hφ0⟩
  have hIb : Integrable (fun x => ∑ j : Fin P, fderivWithin ℝ (fun y => ψ y ^ 2) M x (Pe x j) *
      fderivWithin ℝ A2 M x (Pe x j)) (μHE[m].restrict M) := hibp1
  have hId : Integrable (fun x => ψ x ^ 2 * ∑ j : Fin P,
      fderivWithin ℝ (fun y => fderivWithin ℝ A2 M y (Pe y j)) M x (Pe x j))
      (μHE[m].restrict M) := hibp2
  have hIbd : ∫ x in M, (∑ j : Fin P, fderivWithin ℝ (fun y => ψ y ^ 2) M x (Pe x j) *
      fderivWithin ℝ A2 M x (Pe x j)) ∂μHE[m] = -(∫ x in M, ψ x ^ 2 * (∑ j : Fin P,
      fderivWithin ℝ (fun y => fderivWithin ℝ A2 M y (Pe y j)) M x (Pe x j)) ∂μHE[m]) := hibp3
  -- the pointwise algebra of steps 1–2 (`a = |A|`, `p = ψ`, `L = Δ_M|A|²`, `N = |∇A|²`)
  have alg : ∀ (a p A N L r2 : ℝ) (u v w z1 z2 : Fin P → ℝ), A = a ^ 2 → 0 < r2 →
      L = 2 * N - 2 * A ^ 2 → 0 ≤ N →
      (0 < A → 2 * A ^ 2 / r2 + (∑ k, w k ^ 2) / 4 ≤ A * N) → (A = 0 → ∀ k, v k = 0) →
      (∀ j, w j = 2 * a * v j) → (∀ j, z1 j = a * u j + p * v j) → (∀ j, z2 j = 2 * p * u j) →
      2 * ∑ j, z1 j ^ 2 ≤ 2 * (A * ∑ j, u j ^ 2) + p ^ 2 * L + 2 * (p ^ 2 * A ^ 2) -
        4 * (p ^ 2 * A / r2) + ∑ j, z2 j * w j := by
    intro a p A N L r2 u v w z1 z2 hAa hr2 hL hN hcd hv0 hw hz1 hz2
    subst hAa hL
    simp only [hw, hz1, hz2] at hcd ⊢
    -- the pointwise Simons inequality (1): `2|A|²/r² + Σ_k (δ_k|A|)² ≤ |∇A|²`
    have hI : 2 * a ^ 2 / r2 + ∑ k, v k ^ 2 ≤ N := by
      rcases (sq_nonneg a).lt_or_eq with hA | hA
      · refine le_of_mul_le_mul_left ?_ hA
        have e : (∑ k, (2 * a * v k) ^ 2) / 4 = a ^ 2 * ∑ k, v k ^ 2 := by
          rw [Finset.mul_sum, Finset.sum_div]
          exact Finset.sum_congr rfl fun k _ => by ring
        calc a ^ 2 * (2 * a ^ 2 / r2 + ∑ k, v k ^ 2)
            = 2 * (a ^ 2) ^ 2 / r2 + (∑ k, (2 * a * v k) ^ 2) / 4 := by rw [e]; ring
          _ ≤ a ^ 2 * N := hcd hA
      · have hv := hv0 hA.symm
        simp only [hv, ← hA]
        simpa using hN
    have e1 : ∑ j, (a * u j + p * v j) ^ 2 =
        a ^ 2 * ∑ j, u j ^ 2 + 2 * a * p * ∑ j, u j * v j + p ^ 2 * ∑ j, v j ^ 2 := by
      rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib,
        ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun j _ => by ring
    have e2 : ∑ j, 2 * p * u j * (2 * a * v j) = 4 * a * p * ∑ j, u j * v j := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    have key : 2 * (a ^ 2 * ∑ j, u j ^ 2) + p ^ 2 * (2 * N - 2 * (a ^ 2) ^ 2) +
        2 * (p ^ 2 * (a ^ 2) ^ 2) - 4 * (p ^ 2 * a ^ 2 / r2) + 4 * a * p * ∑ j, u j * v j -
        2 * (a ^ 2 * ∑ j, u j ^ 2 + 2 * a * p * ∑ j, u j * v j + p ^ 2 * ∑ j, v j ^ 2) =
        2 * p ^ 2 * (N - (2 * a ^ 2 / r2 + ∑ k, v k ^ 2)) := by ring
    rw [e1, e2]
    linarith [key, mul_nonneg (mul_nonneg zero_le_two (sq_nonneg p)) (sub_nonneg.mpr hI)]
  -- Steps 1–2: the a.e. pointwise inequality
  have hSI := Submission.codim1_hcp_sc_simons_identity P m A₀ M ν hA₀ hMA hM ⟨O, hO, hMO, hνC⟩ hν hH
  have hCD := Submission.codim1_hcp_sc_cone_simons_defect P m A₀ M ν hA₀ hMA h0 hM hcone
    ⟨O, hO, hMO, hνC⟩ hν
  have hmin : ∀ (g : Euclid P → ℝ) (g' : Euclid P →L[ℝ] ℝ) (x : Euclid P), (∀ y, 0 ≤ g y) →
      g x = 0 → HasFDerivWithinAt g g' M x →
      ∀ w ∈ Submodule.span ℝ (tangentSpace M x), g' w = 0 := by
    intro g g' x hg hgx hd w hw
    have hT : tangentSpace M x ⊆ (LinearMap.ker (g' : Euclid P →ₗ[ℝ] ℝ) : Set (Euclid P)) := by
      rintro τ ⟨γ, -, hγM, hγ0, hγd⟩
      have h1 : HasDerivWithinAt (g ∘ γ) (g' τ) (Set.Ioo (-1) 1) 0 :=
        HasFDerivWithinAt.comp_hasDerivWithinAt (0 : ℝ) (by rw [hγ0]; exact hd)
          hγd.hasDerivWithinAt hγM
      have h2 : HasDerivAt (g ∘ γ) (g' τ) 0 :=
        h1.hasDerivAt (Ioo_mem_nhds (by norm_num) (by norm_num))
      have h3 : IsLocalMin (g ∘ γ) 0 := Eventually.of_forall fun t => by
        show g (γ 0) ≤ g (γ t)
        rw [hγ0, hgx]
        exact hg _
      exact LinearMap.mem_ker.mpr (h3.hasDerivAt_eq_zero h2)
    exact LinearMap.mem_ker.mp ((Submodule.span_le.mpr hT) hw)
  have hrad_ψ := Submission.codim1_hcp_sc_rademacher_submanifold P m M ψ (hM 1) hψ
  have hrad_s := Submission.codim1_hcp_sc_rademacher_submanifold P m M
    (fun y => Real.sqrt (A2 y)) (hM 1) hsLip
  have hpt : ∀ᵐ x ∂(μHE[m].restrict M),
      2 * ∑ j : Fin P, (fderivWithin ℝ (fun y => Real.sqrt (A2 y) * ψ y) M x (Pe x j)) ^ 2 ≤
        2 * (A2 x * ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2) +
          ψ x ^ 2 * ∑ j : Fin P,
            fderivWithin ℝ (fun y => fderivWithin ℝ A2 M y (Pe y j)) M x (Pe x j) +
          2 * (ψ x ^ 2 * A2 x ^ 2) - 4 * (ψ x ^ 2 * A2 x / ‖x‖ ^ 2) +
          ∑ j : Fin P, fderivWithin ℝ (fun y => ψ y ^ 2) M x (Pe x j) *
            fderivWithin ℝ A2 M x (Pe x j) := by
    filter_upwards [ae_restrict_mem hMmeas, hrad_ψ, hrad_s] with x hx hψd hsd
    have hψd' := hψd.hasFDerivWithinAt
    have hsd' := hsd.hasFDerivWithinAt
    -- Step 1(a)–(c): product rules within `M` and `tangent_fderiv`
    have hζd : ∀ j, fderivWithin ℝ (fun y => Real.sqrt (A2 y) * ψ y) M x (Pe x j) =
        Real.sqrt (A2 x) * fderivWithin ℝ ψ M x (Pe x j) +
          ψ x * fderivWithin ℝ (fun y => Real.sqrt (A2 y)) M x (Pe x j) := fun j => by
      have hd : HasFDerivWithinAt (fun y => Real.sqrt (A2 y) * ψ y)
          (Real.sqrt (A2 x) • fderivWithin ℝ ψ M x +
            ψ x • fderivWithin ℝ (fun y => Real.sqrt (A2 y)) M x) M x := hsd'.mul hψd'
      rw [Submission.codim1_hcp_sc_fderivWithin_tangent_eq P ℝ M _ _ x hd (Pe x j) (hmem x j)]
      simp only [add_apply, smul_apply, smul_eq_mul]
    have hφd : ∀ j, fderivWithin ℝ (fun y => ψ y ^ 2) M x (Pe x j) =
        2 * ψ x * fderivWithin ℝ ψ M x (Pe x j) := fun j => by
      have hd : HasFDerivWithinAt (fun y => ψ y ^ 2)
          (ψ x • fderivWithin ℝ ψ M x + ψ x • fderivWithin ℝ ψ M x) M x :=
        (hψd'.mul hψd').congr (fun y _ => sq (ψ y)) (sq (ψ x))
      rw [Submission.codim1_hcp_sc_fderivWithin_tangent_eq P ℝ M _ _ x hd (Pe x j) (hmem x j)]
      simp only [add_apply, smul_apply, smul_eq_mul]
      ring
    have hAd : ∀ j, fderivWithin ℝ A2 M x (Pe x j) =
        2 * Real.sqrt (A2 x) * fderivWithin ℝ (fun y => Real.sqrt (A2 y)) M x (Pe x j) :=
      fun j => by
        have hd : HasFDerivWithinAt A2
            (Real.sqrt (A2 x) • fderivWithin ℝ (fun y => Real.sqrt (A2 y)) M x +
              Real.sqrt (A2 x) • fderivWithin ℝ (fun y => Real.sqrt (A2 y)) M x) M x :=
          (hsd'.mul hsd').congr (fun y _ => (Real.mul_self_sqrt (hA2nn y)).symm)
            (Real.mul_self_sqrt (hA2nn x)).symm
        rw [Submission.codim1_hcp_sc_fderivWithin_tangent_eq P ℝ M _ _ x hd (Pe x j) (hmem x j)]
        simp only [add_apply, smul_apply, smul_eq_mul]
        ring
    -- Step 1(d): `δ_j|A| = 0` where `|A|² = 0`
    have hv0 : A2 x = 0 → ∀ k, fderivWithin ℝ (fun y => Real.sqrt (A2 y)) M x (Pe x k) = 0 :=
      fun hA k => hmin (fun y => Real.sqrt (A2 y)) _ x (fun y => Real.sqrt_nonneg _)
        (by simp only [hA, Real.sqrt_zero]) hsd' (Pe x k) (hmem x k)
    have hr2 : 0 < ‖x‖ ^ 2 := pow_pos (norm_pos_iff.mpr fun h => h0 (h ▸ hx)) 2
    exact alg (Real.sqrt (A2 x)) (ψ x) (A2 x) _ _ (‖x‖ ^ 2)
      (fun j => fderivWithin ℝ ψ M x (Pe x j))
      (fun j => fderivWithin ℝ (fun y => Real.sqrt (A2 y)) M x (Pe x j))
      (fun j => fderivWithin ℝ A2 M x (Pe x j))
      (fun j => fderivWithin ℝ (fun y => Real.sqrt (A2 y) * ψ y) M x (Pe x j))
      (fun j => fderivWithin ℝ (fun y => ψ y ^ 2) M x (Pe x j))
      (Real.sq_sqrt (hA2nn x)).symm hr2 (hSI x hx)
      (Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ =>
        Finset.sum_nonneg fun k _ => sq_nonneg _)
      (hCD x hx) hv0 hAd hζd hφd
  -- Step 3: stability with `ζ = |A|ψ` (B.2 (2)), where `|A|²ζ² = ψ²|A|⁴`
  have hstabζ : ∫ x in M, ψ x ^ 2 * A2 x ^ 2 ∂μHE[m] ≤
      ∫ x in M, ∑ j : Fin P,
        (fderivWithin ℝ (fun y => Real.sqrt (A2 y) * ψ y) M x (Pe x j)) ^ 2 ∂μHE[m] := by
    have h := hstab _ hζLip ⟨C, hCc, hCM, hζ0⟩
    have e : ∫ x in M, ψ x ^ 2 * A2 x ^ 2 ∂μHE[m] =
        ∫ x in M, A2 x * (Real.sqrt (A2 x) * ψ x) ^ 2 ∂μHE[m] := by
      congr 1
      funext x
      rw [mul_pow, Real.sq_sqrt (hA2nn x)]
      ring
    rw [e]
    exact h
  -- Step 5: integrate the pointwise inequality and combine (B.2 (3))
  have i1 : Integrable (fun x => 2 * (A2 x * ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2))
      (μHE[m].restrict M) := hIa.const_mul 2
  have i2 : Integrable (fun x => 2 * (A2 x * ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2) +
      ψ x ^ 2 * ∑ j : Fin P,
        fderivWithin ℝ (fun y => fderivWithin ℝ A2 M y (Pe y j)) M x (Pe x j))
      (μHE[m].restrict M) := i1.add hId
  have i3 : Integrable (fun x => 2 * (A2 x * ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2) +
      ψ x ^ 2 * ∑ j : Fin P,
        fderivWithin ℝ (fun y => fderivWithin ℝ A2 M y (Pe y j)) M x (Pe x j) +
      2 * (ψ x ^ 2 * A2 x ^ 2)) (μHE[m].restrict M) := i2.add (hIe.const_mul 2)
  have i4 : Integrable (fun x => 2 * (A2 x * ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2) +
      ψ x ^ 2 * ∑ j : Fin P,
        fderivWithin ℝ (fun y => fderivWithin ℝ A2 M y (Pe y j)) M x (Pe x j) +
      2 * (ψ x ^ 2 * A2 x ^ 2) - 4 * (ψ x ^ 2 * A2 x / ‖x‖ ^ 2)) (μHE[m].restrict M) :=
    i3.sub (hIf.const_mul 4)
  have hmono : ∫ x in M, 2 * ∑ j : Fin P,
        (fderivWithin ℝ (fun y => Real.sqrt (A2 y) * ψ y) M x (Pe x j)) ^ 2 ∂μHE[m] ≤
      ∫ x in M, (2 * (A2 x * ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2) +
          ψ x ^ 2 * ∑ j : Fin P,
            fderivWithin ℝ (fun y => fderivWithin ℝ A2 M y (Pe y j)) M x (Pe x j) +
          2 * (ψ x ^ 2 * A2 x ^ 2) - 4 * (ψ x ^ 2 * A2 x / ‖x‖ ^ 2) +
          ∑ j : Fin P, fderivWithin ℝ (fun y => ψ y ^ 2) M x (Pe x j) *
            fderivWithin ℝ A2 M x (Pe x j)) ∂μHE[m] :=
    integral_mono_of_nonneg (Eventually.of_forall fun x => mul_nonneg zero_le_two
      (Finset.sum_nonneg fun j _ => sq_nonneg _)) (i4.add hIb) hpt
  rw [integral_add i4 hIb, integral_sub i3 (hIf.const_mul 4), integral_add i2 (hIe.const_mul 2),
    integral_add i1 hId, integral_const_mul, integral_const_mul, integral_const_mul,
    integral_const_mul, hIbd] at hmono
  show 2 * (∫ x in M, ψ x ^ 2 * A2 x / ‖x‖ ^ 2 ∂μHE[m]) ≤
    ∫ x in M, A2 x * ∑ j : Fin P, (fderivWithin ℝ ψ M x (Pe x j)) ^ 2 ∂μHE[m]
  linarith

/-- **Tangent spaces of a submanifold lying in a linear subspace** (Simon Ch. 2, §4; step 1 of
the unit normal of a minimal hypercone plane): if `A₀ ⊆ ℝᴾ` is a linear subspace and `M ⊆ A₀` is
an embedded `C¹` `m`-dimensional submanifold, then every `T_xM`, `x ∈ M`, is an `m`-dimensional
linear subspace of `A₀`.  For a chart `ψ` with `ψ(v) = x`, `T_xM = Dψ(v)(ℝᵐ)`
(`Submission.chart_tangentSpace_eq_range_fderiv`), of dimension `m` as `Dψ(v)` is injective.  A
vector `γ'(0) ∈ T_xM` is the limit of the difference quotients `s⁻¹(γ(s) − γ(0)) ∈ A₀`,
`0 < |s| < 1`, so it lies in the closed subspace `A₀`. -/
theorem Submission.codim1_hcp_un_tangent_subspace : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → M ⊆ (A₀ : Set (Euclid P)) → ∀ x ∈ M, ∃ Q : Submodule ℝ (Euclid P), (Q : Set (Euclid P)) = tangentSpace M x ∧ Module.finrank ℝ Q = m ∧ Q ≤ A₀ := by
  intro P m A₀ M hM hMA x hx
  -- Step 1: a chart `(V, W, ψ)` at `x`, and `v ∈ V` with `ψ(v) = x`
  obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, himg, hprop, hD⟩ := hM x hx
  obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := himg ▸ ⟨hxW, hx⟩
  -- Step 2: `T_{ψ(v)}M = Dψ(v)(ℝᵐ)`, the underlying set of `Q = range Dψ(v)`
  have hT : tangentSpace M (ψ v) = Set.range (fderiv ℝ ψ v) :=
    Submission.chart_tangentSpace_eq_range_fderiv P m 1 M W V ψ v le_rfl hV hW hψ hinj himg
      hprop hD hv
  have hQ : (LinearMap.range (fderiv ℝ ψ v : Euclid m →ₗ[ℝ] Euclid P) : Set (Euclid P)) =
      tangentSpace M (ψ v) := by
    rw [hT, LinearMap.coe_range, ContinuousLinearMap.coe_coe]
  refine ⟨_, hQ, ?_, fun w hw => ?_⟩
  · -- Step 3: `Dψ(v)` is injective, so `dim Q = dim ℝᵐ = m`
    rw [LinearMap.finrank_range_of_inj (hD v hv), finrank_euclideanSpace_fin]
  · -- Step 4: `w = γ'(0)` for a `C¹` curve `γ` in `M` with `γ(0) = ψ(v)`
    obtain ⟨γ, -, hγM, hγ0, hγw⟩ : w ∈ tangentSpace M (ψ v) := hQ ▸ hw
    -- the difference quotients `s⁻¹(γ(s) − γ(0))`, `0 < |s| < 1`, lie in `A₀` as `M ⊆ A₀`
    have hev : ∀ᶠ s in 𝓝[≠] (0 : ℝ), s⁻¹ • (γ (0 + s) - γ 0) ∈ A₀ := by
      filter_upwards [mem_nhdsWithin_of_mem_nhds (Ioo_mem_nhds (neg_lt_zero.2 one_pos) one_pos)]
        with s hs
      refine A₀.smul_mem _ (A₀.sub_mem (hMA (hγM ?_)) (hMA (hγ0 ▸ hx)))
      rwa [zero_add]
    -- they tend to `w = γ'(0)`, and `A₀` is closed (finite-dimensional), so `w ∈ A₀`
    exact A₀.closed_of_finiteDimensional.mem_of_tendsto hγw.tendsto_slope_zero hev
/-- **Orthogonal projection onto a hyperplane of `A₀`** (Simon Ch. 2, §4, the splitting
`X = X^⊤ + X^⊥` with `X^⊥ = Σ_α (ν_α · X) ν_α` before 4.29, here with one unit normal inside
`A₀`; step 1 of the unit normal construction for the hypercone in Simon Appendix B, B.2, giving
`P_x = P_{A₀} − ν(x) ⊗ ν(x)`).  Let `Q ⊆ A₀ ⊆ ℝᴾ` be subspaces with `dim A₀ = m + 1` and
`dim Q = m`, and let `n ∈ A₀` be a unit vector orthogonal to `Q`.  Then
`P_Q w = P_{A₀} w − ⟪n, w⟫ n` for every `w`.  The line `ℝ ∙ n` lies in `A₀`, so
`(ℝ ∙ n)ᗮ ⊓ A₀` has dimension `m` and contains `Q`; hence `Q = (ℝ ∙ n)ᗮ ⊓ A₀`.  Now
`u = P_{A₀} w − ⟪n, w⟫ n` lies in `A₀` with `⟪n, u⟫ = ⟪P_{A₀} n, w⟫ − ⟪n, w⟫ = 0`, so `u ∈ Q`, and
`w − u = (w − P_{A₀} w) + ⟪n, w⟫ n` is orthogonal to `Q ⊆ A₀`; so `u = P_Q w`. -/
theorem Submission.codim1_hcp_un_hyperplane_projection : ∀ (P m : ℕ) (A₀ Q : Submodule ℝ (Euclid P)) (n : Euclid P), Module.finrank ℝ A₀ = m + 1 → Module.finrank ℝ Q = m → Q ≤ A₀ → n ∈ A₀ → ‖n‖ = 1 → (∀ v ∈ Q, inner ℝ n v = 0) → ∀ w : Euclid P, Q.starProjection w = A₀.starProjection w - inner ℝ n w • n := by
  intro P m A₀ Q n hA₀ hQ hQA hnA hn hnQ w
  -- Step 1: `Q = (ℝ ∙ n)ᗮ ⊓ A₀`, since `Q ≤ (ℝ ∙ n)ᗮ ⊓ A₀` and both have dimension `m`
  have hn0 : n ≠ 0 := by
    rintro rfl
    simp at hn
  have hle : Q ≤ (ℝ ∙ n)ᗮ ⊓ A₀ := fun v hv =>
    ⟨Submodule.mem_orthogonal_singleton_iff_inner_right.2 (hnQ v hv), hQA hv⟩
  have hdim : Module.finrank ℝ ((ℝ ∙ n)ᗮ ⊓ A₀ : Submodule ℝ (Euclid P)) = m := by
    have h := Submodule.finrank_add_inf_finrank_orthogonal
      ((Submodule.span_singleton_le_iff_mem n A₀).2 hnA)
    rw [finrank_span_singleton hn0, hA₀] at h
    omega
  have hQeq : Q = (ℝ ∙ n)ᗮ ⊓ A₀ := Submodule.eq_of_le_of_finrank_eq hle (hQ.trans hdim.symm)
  -- Step 2: `u := P_{A₀} w − ⟪n, w⟫ n` lies in `A₀` and is orthogonal to `n`, so `u ∈ Q`
  have hu : A₀.starProjection w - inner ℝ n w • n ∈ Q := by
    rw [hQeq]
    refine ⟨Submodule.mem_orthogonal_singleton_iff_inner_right.2 ?_,
      A₀.sub_mem (A₀.starProjection_apply_mem w) (A₀.smul_mem _ hnA)⟩
    rw [inner_sub_right, real_inner_smul_right, ← Submodule.inner_starProjection_left_eq_right,
      Submodule.starProjection_eq_self_iff.2 hnA, real_inner_self_eq_norm_sq, hn]
    ring
  -- Steps 3–4: `w − u = (w − P_{A₀} w) + ⟪n, w⟫ n` is orthogonal to `Q`, so `P_Q w = u`
  refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero hu fun v hv => ?_
  have h₁ : inner ℝ (w - A₀.starProjection w) v = 0 :=
    Submodule.inner_left_of_mem_orthogonal (hQA hv) (A₀.sub_starProjection_mem_orthogonal w)
  have h₂ : w - (A₀.starProjection w - inner ℝ n w • n) =
      (w - A₀.starProjection w) + inner ℝ n w • n := by
    abel
  rw [h₂, inner_add_left, real_inner_smul_left, h₁, hnQ v hv, mul_zero, add_zero]
/-- **Generalized cross product in an `(m + 1)`-dimensional subspace `A₀ ⊆ ℝᴾ`** (the volume
form of `A₀` and its `A₀`-representative; Simon Appendix B, the unit normal of a hypersurface of
`A₀ ≅ ℝ^{m+1}` with the orientation induced from `C`, used in B.2).  Fix an orthonormal basis
`a₀, …, a_m` of `A₀`, put `Ω(v₀, …, v_m) = det_a(P_{A₀} v₀, …, P_{A₀} v_m)`, an alternating
`(m + 1)`-form that only sees the `A₀`-components of its arguments, and
`N(w) = ∑ᵢ Ω(aᵢ, w) aᵢ ∈ A₀`; `N` is continuous because a multilinear map on `ℝᴾ` is a finite sum
of products of coordinates.  Expanding `P_{A₀} u = ∑ᵢ ⟪aᵢ, u⟫ aᵢ` gives `⟪N(w), u⟫ = Ω(u, w)`, so
`⟪N(w), w_j⟫ = Ω(w_j, w) = 0`.  For linearly independent `w_j ∈ A₀` some `u ∈ A₀` makes `(u, w)`
a basis of `A₀`, so `⟪N(w), u⟫ = Ω(u, w) ≠ 0`.  For orthonormal `w_j ∈ A₀`, extend them to an
orthonormal basis `(b₀, w)` of `A₀`; then `N(w) = ⟪N(w), b₀⟫ b₀` and `⟪N(w), b₀⟫ = Ω(b₀, w) = ±1`,
the determinant of a change of orthonormal basis. -/
theorem Submission.codim1_hcp_un_cross_product : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)), Module.finrank ℝ A₀ = m + 1 → ∃ N : Euclid P [⋀^Fin m]→L[ℝ] Euclid P, (∀ w : Fin m → Euclid P, N w ∈ A₀) ∧ (∀ (w : Fin m → Euclid P) (j : Fin m), inner ℝ (N w) (w j) = 0) ∧ (∀ w : Fin m → Euclid P, Orthonormal ℝ w → (∀ j, w j ∈ A₀) → ‖N w‖ = 1) ∧ ∀ w : Fin m → Euclid P, LinearIndependent ℝ w → (∀ j, w j ∈ A₀) → N w ≠ 0 := by
  intro P m A₀ hA
  -- step 1: an orthonormal basis `a` of `A₀` and the volume form `Ω(v) = det_a (P_{A₀} v)`
  let a : OrthonormalBasis (Fin (m + 1)) ℝ A₀ := (stdOrthonormalBasis ℝ A₀).reindex (finCongr hA)
  let pr : Euclid P →ₗ[ℝ] A₀ := (A₀.orthogonalProjectionOnto : Euclid P →ₗ[ℝ] A₀)
  let Ω : Euclid P [⋀^Fin (m + 1)]→ₗ[ℝ] ℝ := a.toBasis.det.compLinearMap pr
  have hΩ : ∀ v, Ω v = a.toBasis.det (fun j => pr (v j)) := fun v => rfl
  -- step 2: `N(w) = ∑ᵢ Ω(aᵢ, w) aᵢ`
  let N₀ : Euclid P [⋀^Fin m]→ₗ[ℝ] Euclid P :=
    ∑ i, (Ω.curryLeft (a i : Euclid P)).smulRight (a i : Euclid P)
  have hN₀ : ∀ w, N₀ w = ∑ i, Ω (Fin.cons (a i : Euclid P) w) • (a i : Euclid P) := fun w =>
    map_sum (AddMonoidHom.mk' (fun f : Euclid P [⋀^Fin m]→ₗ[ℝ] Euclid P => f w) fun _ _ => rfl) _ _
  -- continuity of `N₀`: expand every `w j` in the standard basis `e` of `ℝᴾ`
  have hcont : Continuous N₀ := by
    let e := EuclideanSpace.basisFun (Fin P) ℝ
    have hexp : (N₀ : (Fin m → Euclid P) → Euclid P) = fun w => ∑ r : Fin m → Fin P,
        (∏ j, inner ℝ (e (r j)) (w j)) • N₀ (fun j => e (r j)) := by
      funext w
      have h1 : N₀ w = N₀.toMultilinearMap (fun j => ∑ k, inner ℝ (e k) (w j) • e k) := by
        simp only [e.sum_repr']
        rfl
      rw [h1, MultilinearMap.map_sum]
      exact Finset.sum_congr rfl fun r _ => N₀.toMultilinearMap.map_smul_univ _ _
    rw [hexp]
    fun_prop
  let N : Euclid P [⋀^Fin m]→L[ℝ] Euclid P := { N₀ with cont := hcont }
  have hN : ∀ w, N w = N₀ w := fun w => rfl
  -- `u ↦ Ω(u, w)` is linear
  let ℓ : (Fin m → Euclid P) → Euclid P →ₗ[ℝ] ℝ := fun w =>
    { toFun := fun u => Ω (Fin.cons u w)
      map_add' := fun u v => Ω.map_vecCons_add w u v
      map_smul' := fun c u => Ω.map_vecCons_smul w c u }
  -- step 3: `⟨N(w), u⟩ = Ω(u, w)`
  have key : ∀ w u, inner ℝ (N₀ w) u = Ω (Fin.cons u w) := by
    intro w u
    -- `Ω(u, w) = Ω(P_{A₀} u, w)` and `P_{A₀} u = ∑ᵢ ⟨aᵢ, u⟩ aᵢ`
    have hproj : Ω (Fin.cons u w) = Ω (Fin.cons (pr u : Euclid P) w) := by
      rw [hΩ, hΩ]
      congr 1
      funext j
      refine Fin.cases ?_ (fun k => ?_) j
      · rw [Fin.cons_zero, Fin.cons_zero]
        exact (A₀.orthogonalProjectionOnto_mem_subspace_eq_self (pr u)).symm
      · simp
    have hsum : (pr u : Euclid P) = ∑ i, inner ℝ (a i : Euclid P) u • (a i : Euclid P) := by
      conv_lhs => rw [← a.sum_repr' (pr u)]
      simp [pr]
    rw [hproj, hsum, hN₀, sum_inner]
    change _ = ℓ w (∑ i, _)
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_smul, real_inner_smul_left, smul_eq_mul, mul_comm]
    rfl
  -- step 4 (i): `N(w) ∈ A₀`
  have hmem : ∀ w, N₀ w ∈ A₀ := by
    intro w
    rw [hN₀]
    exact A₀.sum_mem fun i _ => A₀.smul_mem _ (a i).2
  -- step 5 (ii): `⟨N(w), w_j⟩ = Ω(w_j, w) = 0`
  have horth : ∀ w (j : Fin m), inner ℝ (N₀ w) (w j) = 0 := by
    intro w j
    rw [key]
    exact Ω.map_eq_zero_of_eq (Fin.cons (w j) w) (i := 0) (j := j.succ) (by simp)
      (Fin.succ_ne_zero j).symm
  refine ⟨N, hmem, horth, ?_, ?_⟩
  · -- step 8 (iii)
    intro w hon hw
    let w' : Fin m → A₀ := fun j => ⟨w j, hw j⟩
    have hon' : Orthonormal ℝ w' := hon.codRestrict A₀ hw
    -- extend `w'` to an orthonormal basis `b` of `A₀` with `b (j + 1) = w' j`
    let v : Fin (m + 1) → A₀ := Fin.cons 0 w'
    have hdr : Orthonormal ℝ ((range (Fin.succ : Fin m → Fin (m + 1))).domRestrict v) := by
      have : (range (Fin.succ : Fin m → Fin (m + 1))).domRestrict v =
          w' ∘ (Equiv.ofInjective Fin.succ (Fin.succ_injective m)).symm := by
        funext x
        obtain ⟨_, j, rfl⟩ := x
        simp [v, Set.domRestrict]
      rw [this]
      exact hon'.comp _ (Equiv.injective _)
    obtain ⟨b, hb⟩ := Orthonormal.exists_orthonormalBasis_extension_of_card_eq (by simp [hA]) hdr
    have hbs : ∀ j, b j.succ = w' j := fun j =>
      (hb _ (mem_range_self j)).trans (Fin.cons_succ _ _ _)
    -- `Ω(b₀, w) = det_a b = ±1`
    have hpb : (fun j => pr ((Fin.cons (b 0 : Euclid P) w : Fin (m + 1) → Euclid P) j)) = ⇑b := by
      funext j
      refine Fin.cases ?_ (fun k => ?_) j
      · simp [pr]
      · rw [Fin.cons_succ, hbs]
        exact A₀.orthogonalProjectionOnto_mem_subspace_eq_self (w' k)
    have hdet : Ω (Fin.cons (b 0 : Euclid P) w) = 1 ∨ Ω (Fin.cons (b 0 : Euclid P) w) = -1 := by
      rw [hΩ, hpb]
      exact a.det_to_matrix_orthonormalBasis_real b
    -- `N(w) = ⟨b₀, N(w)⟩ b₀`
    obtain ⟨n', hn'⟩ : ∃ n' : A₀, (n' : Euclid P) = N₀ w := ⟨⟨N₀ w, hmem w⟩, rfl⟩
    have hexp : n' = inner ℝ (b 0) n' • b 0 := by
      conv_lhs => rw [← b.sum_repr' n']
      rw [Fin.sum_univ_succ]
      have : ∀ j : Fin m, inner ℝ (b j.succ) n' = 0 := by
        intro j
        rw [hbs, Submodule.coe_inner, hn', real_inner_comm]
        exact horth w j
      simp [this]
    have hn : ‖N₀ w‖ = |Ω (Fin.cons (b 0 : Euclid P) w)| := by
      rw [← hn', Submodule.norm_coe, hexp, norm_smul, b.orthonormal.1 0, mul_one, Real.norm_eq_abs,
        Submodule.coe_inner, hn', real_inner_comm, key]
    rw [hN, hn]
    rcases hdet with h | h <;> simp [h]
  · -- step 7 (iv)
    intro w hli hw hzero
    let w' : Fin m → A₀ := fun j => ⟨w j, hw j⟩
    have hli' : LinearIndependent ℝ w' := LinearIndependent.of_comp A₀.subtype hli
    -- a vector `u ∈ A₀ \ span w'`
    obtain ⟨u, hu⟩ : ∃ u : A₀, u ∉ Submodule.span ℝ (range w') := by
      by_contra! hcon
      have h1 := finrank_span_eq_card hli'
      have htop : Submodule.span ℝ (range w') = ⊤ := eq_top_iff.2 fun x _ => hcon x
      rw [htop, finrank_top, hA, Fintype.card_fin] at h1
      omega
    have hli2 : LinearIndependent ℝ (Fin.cons u w' : Fin (m + 1) → A₀) := hli'.finCons hu
    have hdet : IsUnit (a.toBasis.det (Fin.cons u w' : Fin (m + 1) → A₀)) :=
      (a.toBasis.is_basis_iff_det).1
        ⟨hli2, hli2.span_eq_top_of_card_eq_finrank' (by simp [hA])⟩
    apply hdet.ne_zero
    have h1 : (fun j => pr ((Fin.cons (u : Euclid P) w : Fin (m + 1) → Euclid P) j)) =
        (Fin.cons u w' : Fin (m + 1) → A₀) := by
      funext j
      refine Fin.cases ?_ (fun k => ?_) j
      · simp [pr]
      · rw [Fin.cons_succ, Fin.cons_succ]
        exact A₀.orthogonalProjectionOnto_mem_subspace_eq_self (w' k)
    rw [← h1, ← hΩ, ← key, ← hN, hzero, inner_zero_left]

/-- **Continuous unit normal from an orientation** (Simon 6.2.2; the normal `ν` of a hypersurface
in an `(m+1)`-plane `A₀`).  If `T_xM ⊆ A₀` for `x ∈ M`, `dim A₀ = m + 1` and `ξ` orients `M`, then
`ν₀(x) = Σ_k ξ(x)(β_k) e_k` is a continuous unit normal of `M` in `A₀`.  Here `N` is the cross
product of `A₀` (an alternating `m`-linear map into `A₀`, orthogonal to its arguments, unit on
orthonormal families in `A₀`) and `β_k = e_k · N(·)` are `m`-covectors, so `ν₀` is a continuous
linear image of `ξ`.  At `x ∈ M`, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τ_m` for an orthonormal basis `τ` of `T_xM`
gives `ν₀(x) = ±N(τ)`: a unit vector of `A₀` orthogonal to `span τ = T_xM`. -/
theorem Submission.codim1_hcp_un_orientation_normal : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ξ : Euclid P → MultiVector P m), Module.finrank ℝ A₀ = m + 1 → (∀ x ∈ M, tangentSpace M x ⊆ (A₀ : Set (Euclid P))) → IsOrientation m M ξ → ∃ ν₀ : Euclid P → Euclid P, ContinuousOn ν₀ M ∧ ∀ x ∈ M, ν₀ x ∈ A₀ ∧ ‖ν₀ x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν₀ x) v = 0 := by
  intro P m A₀ M ξ hA₀ hTA hξ
  obtain ⟨hξc, hξo⟩ := hξ
  -- step 1: the cross product `N` of `A₀`
  obtain ⟨N, hNA, hNorth, hNunit, -⟩ := Submission.codim1_hcp_un_cross_product P m A₀ hA₀
  -- step 2: the `m`-covectors `β_k = e_k · N(·)`
  let β : Fin P → Covector (Euclid P) m := fun k =>
    (EuclideanSpace.proj k : Euclid P →L[ℝ] ℝ).compContinuousAlternatingMap N
  -- step 3: `ν₀(x)` has coordinates `ξ(x)(β_k)`; it is continuous on `M` since `ξ` is
  let ν₀ : Euclid P → Euclid P := fun x =>
    (EuclideanSpace.equiv (Fin P) ℝ).symm fun k => ξ x (β k)
  refine ⟨ν₀, ?_, fun x hx => ?_⟩
  · exact (EuclideanSpace.equiv (Fin P) ℝ).symm.continuous.comp_continuousOn
      (continuousOn_pi.2 fun k => hξc.clm_apply continuousOn_const)
  -- step 4: `ξ(x) = ±τ₁ ∧ ⋯ ∧ τ_m` for an orthonormal basis `τ` of `Q = T_xM`, so `ν₀(x) = ±N(τ)`
  obtain ⟨Q, hQ, τ, hτ, hspan, hor⟩ := hξo x hx
  have hν : ν₀ x = N τ ∨ ν₀ x = -N τ := by
    rcases hor with h | h
    · left
      ext k
      simp [ν₀, β, h]
    · right
      ext k
      simp [ν₀, β, h]
  -- step 5: `τ_j ∈ Q = T_xM ⊆ A₀`, so `N(τ)` is a unit vector of `A₀`; it is orthogonal to
  -- every `τ_j`, hence to `span τ = Q = T_xM`
  have hτA : ∀ j, τ j ∈ A₀ := fun j => hTA x hx <| by
    rw [← hQ, ← hspan]
    exact Submodule.subset_span ⟨j, rfl⟩
  have hNspan : ∀ v ∈ Submodule.span ℝ (range τ), inner ℝ (N τ) v = 0 := by
    intro v hv
    induction hv using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, rfl⟩ := hy
      exact hNorth τ j
    | zero => exact inner_zero_right _
    | add y z _ _ hy hz => rw [inner_add_right, hy, hz, add_zero]
    | smul c y _ hy => rw [inner_smul_right, hy, mul_zero]
  have hNT : ∀ v ∈ tangentSpace M x, inner ℝ (N τ) v = 0 := fun v hv => hNspan v <| by
    rw [hspan, ← SetLike.mem_coe, hQ]
    exact hv
  rcases hν with hν | hν <;> rw [hν]
  · exact ⟨hNA τ, hNunit τ hτ hτA, hNT⟩
  · refine ⟨neg_mem (hNA τ), by rw [norm_neg, hNunit τ hτ hτA], fun v hv => ?_⟩
    rw [inner_neg_left, hNT v hv, neg_zero]
/-- **A `C^∞` chart has a `C^∞` ambient left inverse near each of its points** (Simon Ch. 2, §4,
4.4, inverse function theorem; steps 4 and 6 of the unit normal of the hypercone plane).  Let `ψ`
be `C^∞`, 1:1 and proper on the open set `V`, with `ψ(V) = W ∩ M` for an open `W` and every
`Dψ(z)` injective, and let `v₀ ∈ V`.  With `π` a linear left inverse of `Dψ(v₀)`, `φ = π ∘ ψ` has
`Dφ(v₀) = id`, so the inverse function theorem gives open sets `S ∋ v₀`, inside
`{z ∈ V : Dφ(z) injective}`, and `T ∋ φ(v₀)` with a `C^∞` inverse `φ⁻¹ : T → S`.  For
`B̄_r(ψ(v₀)) ⊆ W`, `C = V ∩ ψ⁻¹(B̄_r(ψ(v₀)))` is compact, so `ψ(C \ S)` is closed, and it misses
`ψ(v₀)` by injectivity.  Take `O = (B_r(ψ(v₀)) ∩ π⁻¹(T)) \ ψ(C \ S)` and `ρ = φ⁻¹ ∘ π`: every
`z ∈ M ∩ O` is `ψ(c)` with `c ∈ S`, and `ρ(z) = φ⁻¹(φ(c)) = c`. -/
theorem Submission.codim1_hcp_un_chart_retraction : ∀ (P d : ℕ) (M W : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen V → IsOpen W → ContDiffOn ℝ (⊤ : ℕ∞) ψ V → InjOn ψ V → ψ '' V = W ∩ M → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → v₀ ∈ V → ∃ (O : Set (Euclid P)) (ρ : Euclid P → Euclid d), IsOpen O ∧ ψ v₀ ∈ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ρ O ∧ MapsTo ρ O V ∧ ∀ z ∈ M ∩ O, ψ (ρ z) = z := by
  intro P d M W V ψ v₀ hV hW hψ hinj hψV hprop hDψ hv₀
  -- the exponent `∞` satisfies `1 ≤ ∞`, in particular `∞ ≠ 0`
  have h1 : (1 : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by exact_mod_cast le_top
  have h0 : ((⊤ : ℕ∞) : WithTop ℕ∞) ≠ 0 := (zero_lt_one.trans_le h1).ne'
  -- Step 2: a continuous linear left inverse `π` of the injective `Dψ(v₀)`
  obtain ⟨π₀, hπ₀⟩ := (fderiv ℝ ψ v₀ : Euclid d →ₗ[ℝ] Euclid P).exists_leftInverse_of_injective
    (LinearMap.ker_eq_bot.2 (hDψ v₀ hv₀))
  set π : Euclid P →L[ℝ] Euclid d := LinearMap.toContinuousLinearMap π₀
  -- Step 3: `φ = π ∘ ψ` is `C^∞` on `V`, and `Dφ(v₀) = π ∘ Dψ(v₀) = id`
  set φ : Euclid d → Euclid d := fun v => π (ψ v)
  have hφ : ContDiffOn ℝ (⊤ : ℕ∞) φ V := π.contDiff.comp_contDiffOn hψ
  have hdiff : ∀ z ∈ V, HasFDerivAt φ (fderiv ℝ φ z) z := fun z hz =>
    ((hφ.contDiffAt (hV.mem_nhds hz)).differentiableAt h0).hasFDerivAt
  have hDφ₀ : fderiv ℝ φ v₀ = ContinuousLinearMap.id ℝ (Euclid d) := by
    have hψv₀ : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ :=
      ((hψ.contDiffAt (hV.mem_nhds hv₀)).differentiableAt h0).hasFDerivAt
    have h : HasFDerivAt φ (π ∘L fderiv ℝ ψ v₀) v₀ := π.hasFDerivAt.comp v₀ hψv₀
    rw [h.fderiv]
    exact ContinuousLinearMap.ext fun u => LinearMap.congr_fun hπ₀ u
  -- an injective endomorphism of `ℝᵈ` is a continuous linear equivalence
  have equivOf : ∀ L : Euclid d →L[ℝ] Euclid d, Injective L →
      ∃ E : Euclid d ≃L[ℝ] Euclid d, (E : Euclid d →L[ℝ] Euclid d) = L := by
    intro L hL
    exact ⟨(LinearEquiv.ofBijective (L : Euclid d →ₗ[ℝ] Euclid d)
      ⟨hL, LinearMap.injective_iff_surjective.mp hL⟩).toContinuousLinearEquiv, by ext; rfl⟩
  -- `G = {z ∈ V : Dφ(z) injective}` is open (`Dφ` is continuous on `V`) and contains `v₀`
  set G := V ∩ (fderiv ℝ φ) ⁻¹' {L | Injective L}
  have hG : IsOpen G := (hφ.continuousOn_fderiv_of_isOpen hV h1).isOpen_inter_preimage hV
    ContinuousLinearMap.isOpen_injective
  have hv₀G : v₀ ∈ G := ⟨hv₀, show Injective (fderiv ℝ φ v₀) by
    rw [hDφ₀]; exact fun a b hab => hab⟩
  -- the inverse function theorem at `v₀`: an open partial homeomorphism `Φ = φ` with
  -- `v₀ ∈ Φ.source`
  obtain ⟨E₀, hE₀⟩ := equivOf _ hv₀G.2
  have hstrict : HasStrictFDerivAt φ (E₀ : Euclid d →L[ℝ] Euclid d) v₀ := by
    rw [hE₀]; exact (hφ.contDiffAt (hV.mem_nhds hv₀)).hasStrictFDerivAt h0
  set Φ := hstrict.toOpenPartialHomeomorph φ
  -- `S = Φ.source ∩ G ∋ v₀` and `T = Φ.target ∩ Φ⁻¹(S)` are open, and `φ(v₀) ∈ T`
  set S := Φ.source ∩ G
  have hS : IsOpen S := Φ.open_source.inter hG
  have hv₀S : v₀ ∈ S := ⟨hstrict.mem_toOpenPartialHomeomorph_source, hv₀G⟩
  set T := Φ.target ∩ Φ.symm ⁻¹' S
  have hT : IsOpen T := Φ.continuousOn_symm.isOpen_inter_preimage Φ.open_target hS
  have hφv₀T : π (ψ v₀) ∈ T := ⟨Φ.map_source hv₀S.1, show Φ.symm (Φ v₀) ∈ S by
    rw [Φ.left_inv hv₀S.1]; exact hv₀S⟩
  -- `Φ⁻¹` is `C^∞` at every `a ∈ T`, since `Dφ(Φ⁻¹(a))` is invertible
  have hsymm : ∀ a ∈ T, ContDiffAt ℝ (⊤ : ℕ∞) Φ.symm a := by
    intro a ha
    have hz : Φ.symm a ∈ G := ha.2.2
    obtain ⟨E, hE⟩ := equivOf _ hz.2
    exact Φ.contDiffAt_symm (f₀' := E) ha.1 (by rw [hE]; exact hdiff _ hz.1)
      (hφ.contDiffAt (hV.mem_nhds hz.1))
  -- Step 1 near `ψ(v₀)`: for `B̄_r(ψ(v₀)) ⊆ W`, `C = V ∩ ψ⁻¹(B̄_r(ψ(v₀)))` is compact by
  -- properness, so `ψ(C \ S)` is compact, hence closed
  have hψv₀W : ψ v₀ ∈ W := (hψV ▸ mem_image_of_mem ψ hv₀ : ψ v₀ ∈ W ∩ M).1
  obtain ⟨r, hr, hrW⟩ := nhds_basis_closedBall.mem_iff.1 (hW.mem_nhds hψv₀W)
  have hC : IsCompact (V ∩ ψ ⁻¹' closedBall (ψ v₀) r) := hprop _ hrW (isCompact_closedBall _ _)
  have hF : IsClosed (ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ v₀) r) \ S)) :=
    ((hC.diff hS).image_of_continuousOn (hψ.continuousOn.mono fun z hz => hz.1.1)).isClosed
  -- Step 4: `O = (B_r(ψ(v₀)) ∩ π⁻¹(T)) \ ψ(C \ S)` and `ρ = Φ⁻¹ ∘ π`, which maps `O` into `S ⊆ V`
  refine ⟨(ball (ψ v₀) r ∩ π ⁻¹' T) \ ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ v₀) r) \ S),
    fun z => Φ.symm (π z), (isOpen_ball.inter (hT.preimage π.continuous)).sdiff hF,
    ⟨⟨mem_ball_self hr, hφv₀T⟩, ?_⟩, fun z hz => ?_, fun z hz => hz.1.2.2.2.1, ?_⟩
  · -- `ψ(v₀) ∉ ψ(C \ S)`, by injectivity of `ψ` on `V`
    rintro ⟨c, ⟨⟨hcV, -⟩, hcS⟩, hc⟩
    exact hcS (hinj hcV hv₀ hc ▸ hv₀S)
  · -- `ρ` is `C^∞` at `z ∈ O`, as `π(z) ∈ T`
    exact ((hsymm (π z) hz.1.2).comp z π.contDiff.contDiffAt).contDiffWithinAt
  · -- `z ∈ M ∩ O` lies in `W ∩ M`, so `z = ψ(c)` with `c ∈ C`; `c ∈ S` as `z ∉ ψ(C \ S)`
    rintro z ⟨hzM, ⟨hzB, -⟩, hzF⟩
    obtain ⟨c, hcV, rfl⟩ : z ∈ ψ '' V := hψV ▸ ⟨hrW (ball_subset_closedBall hzB), hzM⟩
    have hcS : c ∈ S := by
      by_contra hcS
      exact hzF ⟨c, ⟨⟨hcV, ball_subset_closedBall hzB⟩, hcS⟩, rfl⟩
    -- `π(ψ(c)) = Φ(c)` and `Φ⁻¹(Φ(c)) = c`
    show ψ (Φ.symm (Φ c)) = ψ c
    rw [Φ.left_inv hcS.1]
/-- **Local smoothness of the unit normal** (the step "`ν₀` is smooth along `M`" in the
construction of the smooth unit normal of a hypersurface of `A₀`, for Simons' theorem, Simon B.2).
Let `M ⊆ A₀`, `dim A₀ = m + 1`, have `C^∞` charts and let `ν₀` be a continuous unit normal of `M` in
`A₀`.  Take a chart `ψ` with `ψ(v₀) = y` and the cross product `N` of `A₀`.  Then
`n(v) = N(Dψ(v)e₁, …, Dψ(v)eₘ)` is `C^∞` on `V`, lies in `A₀`, is nonzero and is normal to
`T_{ψ(v)}M = Dψ(v)(ℝᵐ)`, an `m`-plane `Q ⊆ A₀`.  With `n̂ = n(v)/|n(v)|`,
`P_Q w = P_{A₀} w − (n̂ · w) n̂`, so `ν₀(ψ(v)) = σ n̂` with `σ = ν₀(ψ(v)) · n̂ = ±1`.
A `C^∞` retraction `ρ` (`ψ(ρ(z)) = z` on `M ∩ O₁`) makes `s(z) = ν₀(z) · n(ρ(z))/|n(ρ(z))|` a
continuous `±1`-valued function on `M ∩ O₁`, so `s = s(y)` on `M ∩ O₁ ∩ B_δ(y)`, and
`g = s(y) n∘ρ/|n∘ρ|` is `C^∞` on `O = O₁ ∩ B_δ(y)` and equals `ν₀` on `M ∩ O`. -/
theorem Submission.codim1_hcp_un_normal_local_smooth : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν₀ : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (∀ y ∈ M, ∃ (V : Set (Euclid m)) (W : Set (Euclid P)) (ψ : Euclid m → Euclid P), IsOpen V ∧ IsOpen W ∧ y ∈ W ∧ ContDiffOn ℝ (⊤ : ℕ∞) ψ V ∧ InjOn ψ V ∧ ψ '' V = W ∩ M ∧ (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) ∧ ∀ z ∈ V, Injective (fderiv ℝ ψ z)) → ContinuousOn ν₀ M → (∀ x ∈ M, ν₀ x ∈ A₀ ∧ ‖ν₀ x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν₀ x) v = 0) → ∀ y ∈ M, ∃ (O : Set (Euclid P)) (g : Euclid P → Euclid P), IsOpen O ∧ y ∈ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) g O ∧ ∀ z ∈ M ∩ O, g z = ν₀ z := by
  intro P m A₀ M ν₀ hA₀ hMA hcharts hν₀c hν₀ y hy
  -- step 0: the `C^∞` charts are `C¹` charts, so `M` is an embedded `C¹` submanifold
  have hM1 : IsEmbeddedSubmanifold 1 m M := by
    intro x hx
    obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, himg, hprop, hder⟩ := hcharts x hx
    exact ⟨V, W, ψ, hV, hW, hxW, hψ.of_le (WithTop.coe_le_coe.2 le_top), hinj, himg, hprop, hder⟩
  -- step 1: a chart `(V, W, ψ)` with `ψ(v₀) = y`, and the cross product `N` of `A₀`
  obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hder⟩ := hcharts y hy
  obtain ⟨v₀, hv₀V, hψv₀⟩ : y ∈ ψ '' V := by rw [himg]; exact ⟨hyW, hy⟩
  obtain ⟨N, hNA, hNorth, -, hNne⟩ := Submission.codim1_hcp_un_cross_product P m A₀ hA₀
  set b := EuclideanSpace.basisFun (Fin m) ℝ
  -- `n(v) = N(Dψ(v)e₁, …, Dψ(v)eₘ)`
  set n : Euclid m → Euclid P := fun v => N fun j => fderiv ℝ ψ v (b j)
  have hψ1 : ContDiffOn ℝ (1 : ℕ) ψ V := hψ.of_le (WithTop.coe_le_coe.2 le_top)
  have hψM : ∀ v ∈ V, ψ v ∈ M := fun v hv => (himg ▸ mem_image_of_mem ψ hv : ψ v ∈ W ∩ M).2
  -- step 2: `T_{ψ(v)}M = Dψ(v)(ℝᵐ)` for `v ∈ V`
  have htan : ∀ v ∈ V, tangentSpace M (ψ v) = range (fderiv ℝ ψ v) := fun v hv =>
    Submission.chart_tangentSpace_eq_range_fderiv P m 1 M W V ψ v le_rfl hV hW hψ1 hinj himg
      hprop hder hv
  -- step 3: `n` is `C^∞` on `V` ...
  have hn : ContDiffOn ℝ (⊤ : ℕ∞) n V := by
    have hfd : ContDiffOn ℝ (⊤ : ℕ∞) (fderiv ℝ ψ) V :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hV).1 hψ).2
    have hN : ContDiff ℝ (⊤ : ℕ∞) N := by
      have h := N.toContinuousMultilinearMap.contDiff (n := ((⊤ : ℕ∞) : WithTop ℕ∞))
      rwa [ContinuousAlternatingMap.coe_toContinuousMultilinearMap] at h
    have hw : ContDiffOn ℝ (⊤ : ℕ∞) (fun v (j : Fin m) => fderiv ℝ ψ v (b j)) V :=
      contDiffOn_pi.2 fun j => hfd.clm_apply contDiffOn_const
    exact hN.comp_contDiffOn hw
  -- ... and, for `v ∈ V`, `T_{ψ(v)}M` is an `m`-plane `Q ⊆ A₀` with `0 ≠ n(v) ∈ A₀`, `n(v) ⊥ Q`
  have hnormal : ∀ v ∈ V, ∃ Q : Submodule ℝ (Euclid P), (Q : Set (Euclid P)) = tangentSpace M (ψ v) ∧
      Module.finrank ℝ Q = m ∧ Q ≤ A₀ ∧ n v ∈ A₀ ∧ n v ≠ 0 ∧ ∀ t ∈ Q, inner ℝ (n v) t = 0 := by
    intro v hv
    obtain ⟨Q, hQ, hQm, hQA⟩ :=
      Submission.codim1_hcp_un_tangent_subspace P m A₀ M hM1 hMA (ψ v) (hψM v hv)
    have hQr : ∀ t, t ∈ Q ↔ t ∈ range (fderiv ℝ ψ v) := fun t => by
      rw [← htan v hv, ← hQ, SetLike.mem_coe]
    -- `Dψ(v)e₁, …, Dψ(v)eₘ` are linearly independent vectors of `Q ⊆ A₀`
    have hli : LinearIndependent ℝ fun j => fderiv ℝ ψ v (b j) :=
      b.orthonormal.linearIndependent.map' (fderiv ℝ ψ v : Euclid m →ₗ[ℝ] Euclid P)
        (LinearMap.ker_eq_bot.2 (hder v hv))
    have hwA : ∀ j, fderiv ℝ ψ v (b j) ∈ A₀ := fun j => hQA ((hQr _).2 (mem_range_self _))
    refine ⟨Q, hQ, hQm, hQA, hNA _, hNne _ hli hwA, fun t ht => ?_⟩
    -- `t = Dψ(v)a = Σⱼ aⱼ Dψ(v)eⱼ` and `n(v) ⊥ Dψ(v)eⱼ`
    obtain ⟨a, rfl⟩ := (hQr t).1 ht
    rw [← b.sum_repr a, map_sum, inner_sum]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [map_smul, inner_smul_right, hNorth (fun j => fderiv ℝ ψ v (b j)) j, mul_zero]
  have hn0V : ∀ v ∈ V, n v ≠ 0 := fun v hv => by
    obtain ⟨-, -, -, -, -, h, -⟩ := hnormal v hv
    exact h
  -- step 4: `ν₀(ψ(v)) = σ n(v)/|n(v)|` with `σ = ν₀(ψ(v)) · n(v)/|n(v)| = ±1`, for `v ∈ V`
  have hline : ∀ v ∈ V, ν₀ (ψ v) = inner ℝ (‖n v‖⁻¹ • n v) (ν₀ (ψ v)) • (‖n v‖⁻¹ • n v) ∧
      |inner ℝ (‖n v‖⁻¹ • n v) (ν₀ (ψ v))| = 1 := by
    intro v hv
    obtain ⟨Q, hQ, hQm, hQA, hnA, hn0, hnQ⟩ := hnormal v hv
    obtain ⟨huA, hu1, huT⟩ := hν₀ (ψ v) (hψM v hv)
    -- `n(v)/|n(v)|` is a unit vector of `A₀` normal to `Q`
    have he1 : ‖‖n v‖⁻¹ • n v‖ = 1 := norm_smul_inv_norm hn0
    have heQ : ∀ t ∈ Q, inner ℝ (‖n v‖⁻¹ • n v) t = 0 := fun t ht => by
      rw [real_inner_smul_left, hnQ t ht, mul_zero]
    have hproj := Submission.codim1_hcp_un_hyperplane_projection P m A₀ Q (‖n v‖⁻¹ • n v) hA₀
      hQm hQA (A₀.smul_mem _ hnA) he1 heQ (ν₀ (ψ v))
    -- `P_Q ν₀(ψ(v)) = 0`, as `ν₀(ψ(v)) ⊥ T_{ψ(v)}M = Q`, and `P_{A₀} ν₀(ψ(v)) = ν₀(ψ(v))`
    have hQ0 : ν₀ (ψ v) ∈ Qᗮ := (Submodule.mem_orthogonal' Q _).2 fun t ht =>
      huT t (by rw [← hQ]; exact ht)
    rw [(Submodule.starProjection_apply_eq_zero_iff Q).2 hQ0,
      Submodule.starProjection_eq_self_iff.2 huA, eq_comm, sub_eq_zero] at hproj
    refine ⟨hproj, ?_⟩
    have h := congrArg norm hproj
    rwa [norm_smul, he1, mul_one, hu1, Real.norm_eq_abs, eq_comm] at h
  -- step 5: a `C^∞` retraction `ρ : O₁ → V` with `ψ(ρ(z)) = z` for `z ∈ M ∩ O₁`
  obtain ⟨O₁, ρ, hO₁, hyO₁, hρ, hρV, hψρ⟩ :=
    Submission.codim1_hcp_un_chart_retraction P m M W V ψ v₀ hV hW hψ hinj himg hprop hder hv₀V
  rw [hψv₀] at hyO₁
  -- `n̂ = n∘ρ/|n∘ρ|` is `C^∞` on `O₁`
  set nh : Euclid P → Euclid P := fun z => ‖n (ρ z)‖⁻¹ • n (ρ z)
  have hnρ : ContDiffOn ℝ (⊤ : ℕ∞) (fun z => n (ρ z)) O₁ := hn.comp hρ hρV
  have hnh : ContDiffOn ℝ (⊤ : ℕ∞) nh O₁ :=
    ((hnρ.norm ℝ fun z hz => hn0V _ (hρV hz)).inv fun z hz =>
      norm_ne_zero_iff.2 (hn0V _ (hρV hz))).smul hnρ
  -- step 6: on `M ∩ O₁`, `ν₀ = s n̂` with `s = ν₀ · n̂ = ±1`; `s` is continuous at `y` ...
  have hrep : ∀ z ∈ M ∩ O₁, ν₀ z = inner ℝ (nh z) (ν₀ z) • nh z ∧ |inner ℝ (nh z) (ν₀ z)| = 1 := by
    intro z hz
    have h := hline (ρ z) (hρV hz.2)
    rw [hψρ z hz] at h
    exact h
  have hs : ContinuousWithinAt (fun z => inner ℝ (nh z) (ν₀ z)) (M ∩ O₁) y :=
    (hnh.continuousOn.continuousAt (hO₁.mem_nhds hyO₁)).continuousWithinAt.inner
      ((hν₀c y hy).mono inter_subset_left)
  obtain ⟨δ, hδ, hδs⟩ := Metric.continuousWithinAt_iff.1 hs 1 one_pos
  -- ... so `s(z) = s(y)` for `z ∈ M ∩ O₁ ∩ B_δ(y)`: two values `±1` closer than `1` agree
  have hsign : ∀ z ∈ M ∩ O₁, dist z y < δ → inner ℝ (nh z) (ν₀ z) = inner ℝ (nh y) (ν₀ y) := by
    intro z hz hzy
    have h1 : |inner ℝ (nh z) (ν₀ z) - inner ℝ (nh y) (ν₀ y)| < 1 := by
      simpa only [Real.dist_eq] using hδs hz hzy
    rcases (abs_eq zero_le_one).1 (hrep z hz).2 with h | h <;>
      rcases (abs_eq zero_le_one).1 (hrep y ⟨hy, hyO₁⟩).2 with h' | h' <;>
      rw [h, h'] at h1 ⊢ <;> norm_num at h1
  -- step 7: `g = s(y) n̂` is `C^∞` on `O = O₁ ∩ B_δ(y)` and equals `ν₀` on `M ∩ O`
  refine ⟨O₁ ∩ ball y δ, fun z => inner ℝ (nh y) (ν₀ y) • nh z, hO₁.inter isOpen_ball,
    ⟨hyO₁, mem_ball_self hδ⟩, (hnh.mono inter_subset_left).const_smul _, ?_⟩
  rintro z ⟨hzM, hzO₁, hzy⟩
  rw [← hsign z ⟨hzM, hzO₁⟩ hzy]
  exact (hrep z ⟨hzM, hzO₁⟩).1.symm
/-- **Gluing local `C^∞` extensions** (Simon 7.5.8 via Appendix B: the step that makes the unit
normal of the hypercone plane `C^∞` on a neighbourhood of `M`; smooth partitions of unity, cf.
Simon Ch. 1, 4.5).  If every `y ∈ M` has an open `O_y ∋ y` and a map `g_y` that is `C^∞` on `O_y`
with `g_y = f` on `M ∩ O_y`, then some `ν` is `C^∞` on the open set `O = ⋃_{y ∈ M} O_y ⊇ M` and
`ν = f` on `M`.  `O` is open in `ℝᴾ`, hence a σ-compact Hausdorff `C^∞` manifold, and a smooth
partition of unity `(λᵢ)` on `O` subordinate to `{O_y}` glues the `g_y` to
`G = ∑ᵢ λᵢ g_{y(i)}`, which is `C^∞` on `O` with `G(x) = ∑ᵢ λᵢ(x) f(x) = f(x)` for `x ∈ M`
(`exists_contMDiffMap_forall_mem_convex_of_local` with the convex constraints `{f(p)}` for
`p ∈ M` and `F` otherwise).  Take `ν = G` on `O` and `ν = 0` off `O`. -/
theorem Submission.codim1_hcp_un_smooth_glue : ∀ (P : ℕ) (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (M : Set (Euclid P)) (f : Euclid P → F), (∀ y ∈ M, ∃ (O : Set (Euclid P)) (g : Euclid P → F), IsOpen O ∧ y ∈ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) g O ∧ ∀ z ∈ M ∩ O, g z = f z) → ∃ (ν : Euclid P → F) (O : Set (Euclid P)), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O ∧ ∀ x ∈ M, ν x = f x := by
  intro P F _ _ M f hloc
  classical
  -- step 1: the local extensions `g_y` on `O_y ∋ y`, and the open set `O = ⋃_{y ∈ M} O_y ⊇ M`
  choose! Oy g hOy hyO hg hgf using hloc
  let O : TopologicalSpace.Opens (Euclid P) := ⟨⋃ y ∈ M, Oy y, isOpen_biUnion hOy⟩
  have hMO : M ⊆ O := fun x hx => mem_biUnion hx (hyO x hx)
  -- step 2: `O` is locally compact (open in `ℝᴾ`), so it is a σ-compact Hausdorff `C^∞`
  -- manifold modelled on `ℝᴾ`
  have : LocallyCompactSpace O := O.isOpen.locallyCompactSpace
  -- step 3: a smooth partition of unity on `O` subordinate to `{O_y}` glues the `g_y` to a
  -- `C^∞` map `G` on `O` with `G p ∈ {f p}` for `p ∈ M`
  obtain ⟨G, hG⟩ := exists_contMDiffMap_forall_mem_convex_of_local
    (modelWithCornersSelf ℝ (Euclid P)) (M := O) (n := ⊤)
    (t := fun p => if (p : Euclid P) ∈ M then {f p} else univ)
    (fun p => by split_ifs <;> [exact convex_singleton _; exact convex_univ])
    (fun p => by
      -- near `p ∈ O_y`, `g_y` is `C^∞` on the open set `O ∩ O_y` and equals `f` on `M ∩ O_y`
      obtain ⟨y, hy, hpy⟩ := mem_iUnion₂.1 p.2
      refine ⟨Subtype.val ⁻¹' Oy y, (hOy y hy).preimage continuous_subtype_val |>.mem_nhds hpy,
        fun q => g y q, fun q hq => ?_, fun q hq => ?_⟩
      · exact (contMDiffAt_subtype_iff.2 (contMDiffAt_iff_contDiffAt.2
          ((hg y hy).contDiffAt ((hOy y hy).mem_nhds hq)))).contMDiffWithinAt
      · split_ifs with hqM
        · exact hgf y hy q ⟨hqM, hq⟩
        · exact mem_univ _)
  -- step 4: extend `G` by `0` off `O`, so `ν = G` on `O`
  set ν : Euclid P → F := fun z => if hz : z ∈ O then G ⟨z, hz⟩ else 0
  have hνG : ∀ p : O, ν p = G p := fun p => dite_eq_left p.2
  refine ⟨ν, O, O.isOpen, hMO, fun z hz => ?_, fun x hx => ?_⟩
  · -- `ν` is `C^∞` at `z ∈ O`, because it agrees with `G` on the open submanifold `O`
    have h : ContMDiffAt (modelWithCornersSelf ℝ (Euclid P)) (modelWithCornersSelf ℝ F) (⊤ : ℕ∞)
        (fun p : O => ν p) ⟨z, hz⟩ :=
      G.contMDiff.contMDiffAt.congr_of_eventuallyEq (Eventually.of_forall hνG)
    exact (contMDiffAt_iff_contDiffAt.1 (contMDiffAt_subtype_iff.1 h)).contDiffWithinAt
  · -- for `x ∈ M`, `ν x = G x ∈ {f x}`
    have h := hG ⟨x, hMO hx⟩
    rw [ite_eq_left hx] at h
    exact (hνG ⟨x, hMO hx⟩).trans h
/-- **Fundamental lemma of the calculus of variations on `M`** (step (7c) of the zero mean
curvature argument for `codim1_hcp_minimal_unit_normal`, with `div_M ν` replaced by `h`).  Let
`U` be open, `M ⊆ U` measurable, `h` continuous on `M`, `μ(M ∩ K) < ∞` for compact `K ⊆ U` and
`μ(M ∩ B_s(x)) > 0` for `x ∈ M`, `s > 0`.  If `∫_M φ h dμ = 0` for every `C^∞` function `φ` with
compact support and `tsupport φ ⊆ U`, then `h = 0` on `M`.  Otherwise, replacing `h` by `-h`,
`c < h < 3c` on `M ∩ B_δ(x₀)`, `c = h(x₀) / 2 > 0`.  A bump `φ ∈ [0, 1]` equal to `1` on
`B_{r/4}(x₀)` with `tsupport φ = K := closedBall(x₀, r/2) ⊆ U` (`r ≤ δ`) satisfies
`0 ≤ φ h ≤ 3c·1_K` on `M`, so `φ h` is integrable and `∫_M φ h dμ ≥ c μ(M ∩ B_{r/4}(x₀)) > 0`. -/
theorem Submission.codim1_hcp_un_fundamental_lemma : ∀ (P : ℕ) (μ : Measure (Euclid P)) (U M : Set (Euclid P)) (h : Euclid P → ℝ), IsOpen U → M ⊆ U → MeasurableSet M → ContinuousOn h M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ (M ∩ K) ≠ ∞) → (∀ x ∈ M, ∀ s : ℝ, 0 < s → 0 < μ (M ∩ ball x s)) → (∀ φ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ U → ∫ x in M, φ x * h x ∂μ = 0) → ∀ x ∈ M, h x = 0 := by
  intro P μ U M h hU hMU hM hh hfin hpos hint x₀ hx₀
  by_contra hne
  -- step 1: replacing `h` by `-h` if necessary, `0 < h x₀`; put `c = h x₀ / 2`
  wlog hx₀pos : 0 < h x₀ generalizing h
  · refine this (-h) hh.neg (fun φ hφ hφc hφU => ?_) (by simpa using hne) ?_
    · simp only [Pi.neg_apply, mul_neg, integral_neg, hint φ hφ hφc hφU, neg_zero]
    · simpa using lt_of_le_of_ne (not_lt.1 hx₀pos) hne
  set c := h x₀ / 2 with hc_def
  have hc : 0 < c := half_pos hx₀pos
  -- step 2: `c < h < 3c` on `M ∩ B_δ(x₀)`, and `B_r(x₀) ⊆ U` for some `r ∈ (0, δ]`
  obtain ⟨δ, hδ, hδh⟩ := Metric.continuousWithinAt_iff.1 (hh x₀ hx₀) c hc
  have hbound : ∀ x ∈ M, dist x x₀ < δ → c < h x ∧ h x < 3 * c := by
    intro x hx hxδ
    have hx' := hδh hx hxδ
    rw [Real.dist_eq, abs_lt] at hx'
    constructor <;> linarith
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU x₀ (hMU hx₀)
  obtain ⟨r, hr, hrδ, hrU⟩ : ∃ r, 0 < r ∧ r ≤ δ ∧ ball x₀ r ⊆ U :=
    ⟨min δ ε, lt_min hδ hε, min_le_left _ _, (ball_subset_ball (min_le_right _ _)).trans hεU⟩
  -- step 3: the bump `φ` (radii `r/4 < r/2`) is admissible, so `∫_M φ h dμ = 0`
  let φ : ContDiffBump x₀ := ⟨r / 4, r / 2, by positivity, by linarith⟩
  have hKU : closedBall x₀ (r / 2) ⊆ U := (closedBall_subset_ball (by linarith)).trans hrU
  have hzero := hint φ φ.contDiff φ.hasCompactSupport (φ.tsupport_eq.trans_subset hKU)
  -- step 4: `μ(M ∩ K) < ∞` and `0 ≤ φ h ≤ 3c·1_K` on `M`, so `φ h` is integrable on `M`
  have hKfin : μ (M ∩ closedBall x₀ (r / 2)) ≠ ∞ := hfin _ (isCompact_closedBall x₀ _) hKU
  have hKh : ∀ x ∈ M, x ∈ closedBall x₀ (r / 2) → 0 < h x ∧ h x < 3 * c := by
    intro x hx hxK
    have hx' := hbound x hx (lt_of_le_of_lt hxK (by linarith))
    exact ⟨hc.trans hx'.1, hx'.2⟩
  have hφK : ∀ x, x ∉ closedBall x₀ (r / 2) → φ x = 0 := fun x hxK =>
    φ.zero_of_le_dist (not_le.1 hxK).le
  have hnn : ∀ x ∈ M, 0 ≤ φ x * h x := by
    intro x hx
    by_cases hxK : x ∈ closedBall x₀ (r / 2)
    · exact mul_nonneg φ.nonneg (hKh x hx hxK).1.le
    · rw [hφK x hxK, zero_mul]
  have hdom : Integrable ((closedBall x₀ (r / 2)).indicator fun _ => 3 * c) (μ.restrict M) := by
    refine (integrable_indicator_iff measurableSet_closedBall).2 (integrableOn_const ?_)
    rw [Measure.restrict_apply measurableSet_closedBall, inter_comm]
    exact hKfin
  have hInt : IntegrableOn (fun x => φ x * h x) M μ := by
    refine hdom.mono' ((φ.continuous.continuousOn.mul hh).aestronglyMeasurable hM)
      (ae_restrict_of_forall_mem hM fun x hx => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (hnn x hx)]
    by_cases hxK : x ∈ closedBall x₀ (r / 2)
    · rw [indicator_of_mem hxK]
      exact (mul_le_of_le_one_left (hKh x hx hxK).1.le φ.le_one).trans (hKh x hx hxK).2.le
    · rw [indicator_of_notMem hxK, hφK x hxK, zero_mul]
  -- step 5: `∫_M φ h ≥ ∫_{M ∩ B_{r/4}} φ h ≥ c μ(M ∩ B_{r/4}) > 0`, contradicting step 3
  have hBfin : μ (M ∩ ball x₀ (r / 4)) ≠ ∞ := ne_top_of_le_ne_top hKfin
    (measure_mono (inter_subset_inter_right _
      (ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith)))))
  have h₁ : ∫ x in M ∩ ball x₀ (r / 4), φ x * h x ∂μ ≤ ∫ x in M, φ x * h x ∂μ :=
    setIntegral_mono_set hInt (ae_restrict_of_forall_mem hM hnn)
      (Eventually.of_forall fun x hx => hx.1)
  have h₂ : c * μ.real (M ∩ ball x₀ (r / 4)) ≤ ∫ x in M ∩ ball x₀ (r / 4), φ x * h x ∂μ := by
    refine setIntegral_ge_of_const_le_real (hM.inter measurableSet_ball) hBfin (fun x hx => ?_)
      (hInt.mono_set inter_subset_left)
    rw [φ.one_of_mem_closedBall (ball_subset_closedBall hx.2), one_mul]
    exact (hbound x hx.1 ((mem_ball.1 hx.2).trans (by linarith))).1.le
  have h₃ : 0 < μ.real (M ∩ ball x₀ (r / 4)) :=
    ENNReal.toReal_pos (hpos x₀ hx₀ _ (by positivity)).ne' hBfin
  linarith [mul_pos hc h₃]

/-- **Zero mean curvature** of an embedded `C¹` hypersurface `M` of a subspace `A₀`: `div_M ν`
is, up to sign, the mean curvature of `M` (Simon Ch. 2, 4.28), and it vanishes when `M` is
stationary (cf. Ch. 2, 5.5).  Here `M ⊆ U ∩ A₀` is `m`-dimensional, `dim A₀ = m + 1`,
`Hᵐ(M ∩ K) < ∞` for compact `K ⊆ U`, `∫_M div_M X dHᵐ = 0` for `X ∈ C¹_c(U; ℝᴾ)`, and `ν` is
`C^∞` on an open `O ⊇ M` with `ν(x) ∈ A₀` a unit normal of `T_xM` for `x ∈ M`; then
`div_M ν(x) = trace(P_x ∘ Dν(x)) = 0` on `M`.  `T_xM` is an `m`-dimensional subspace of `A₀`, so
`P_x = P_{A₀} − ν(x) ⊗ ν(x)` and `div_M ν(x) = trace(P_{A₀} ∘ Dν(x)) − ν(x) · Dν(x)ν(x)` is
continuous on `M`.  For `C^∞` `φ` with compact support in `O ∩ U`, `X = φν` is `C¹` with compact
support in `U` and `div_M X = φ div_M ν` on `M` (`P_xν(x) = 0`), so `∫_M φ div_M ν dHᵐ = 0`.  As
`M` is Borel and `Hᵐ(M ∩ B_s(x)) > 0` (density one), the fundamental lemma gives
`div_M ν ≡ 0` on `M`. -/
theorem Submission.codim1_hcp_un_zero_mean_curvature : ∀ (P m : ℕ) (U : Set (Euclid P)) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), IsOpen U → M ⊆ U → Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → IsEmbeddedSubmanifold 1 m M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → ∀ x ∈ M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap) = 0 := by
  intro P m U A₀ M ν hU hMU hA₀ hMA₀ hM hfin hstat hνO hνM
  obtain ⟨O, hO, hMO, hν⟩ := hνO
  -- Steps 1–2: `P_x w = P_{A₀} w − (ν(x) · w) ν(x)` for `x ∈ M`, as `span T_xM = T_xM ≤ A₀` has
  -- dimension `m`
  have hproj : ∀ x ∈ M, ∀ w : Euclid P, (Submodule.span ℝ (tangentSpace M x)).starProjection w =
      A₀.starProjection w - inner ℝ (ν x) w • ν x := by
    intro x hx w
    obtain ⟨hνA, hν1, hνT⟩ := hνM x hx
    obtain ⟨Q, hQ, hQm, hQA⟩ := Submission.codim1_hcp_un_tangent_subspace P m A₀ M hM hMA₀ x hx
    have hspan : Submodule.span ℝ (tangentSpace M x) = Q := by rw [← hQ, Submodule.span_eq]
    subst hspan
    exact Submission.codim1_hcp_un_hyperplane_projection P m A₀ _ (ν x) hA₀ hQm hQA hνA hν1
      (fun v hv => hνT v (by rw [← hQ]; exact hv)) w
  -- `P_x ν(x) = ν(x) − |ν(x)|² ν(x) = 0`
  have hPν : ∀ x ∈ M, (Submodule.span ℝ (tangentSpace M x)).starProjection (ν x) = 0 := by
    intro x hx
    obtain ⟨hνA, hν1, -⟩ := hνM x hx
    rw [hproj x hx, Submodule.starProjection_eq_self_iff.2 hνA, real_inner_self_eq_norm_sq, hν1]
    simp
  -- Step 3: on `M`, `div_M ν(x) = trace(P_{A₀} ∘ Dν(x)) − ν(x) · Dν(x)ν(x)`, the trace of
  -- `w ↦ (ν(x) · Dν(x)w) ν(x)` being `ν(x) · Dν(x)ν(x)`
  have hhF : ∀ x ∈ M, LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ ν x).toLinearMap) =
      LinearMap.trace ℝ (Euclid P) (A₀.starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap) -
        inner ℝ (ν x) (fderiv ℝ ν x (ν x)) := by
    intro x hx
    have hlin : (Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ ν x).toLinearMap =
        A₀.starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap -
          (innerₛₗ ℝ (ν x) ∘ₗ (fderiv ℝ ν x).toLinearMap).smulRight (ν x) := by
      refine LinearMap.ext fun w => ?_
      rw [LinearMap.comp_apply, ContinuousLinearMap.coe_coe, hproj x hx]
      simp
    rw [hlin, map_sub, LinearMap.trace_smulRight]
    simp
  -- the right-hand side is continuous on `O`: `ν` and `Dν` are continuous there, and
  -- `L ↦ trace(P_{A₀} ∘ L)` is linear on the finite-dimensional space of operators
  have htr : Continuous fun L : Euclid P →L[ℝ] Euclid P =>
      LinearMap.trace ℝ (Euclid P) (A₀.starProjection.toLinearMap ∘ₗ L.toLinearMap) := by
    let T : (Euclid P →L[ℝ] Euclid P) →ₗ[ℝ] ℝ :=
      { toFun := fun L =>
          LinearMap.trace ℝ (Euclid P) (A₀.starProjection.toLinearMap ∘ₗ L.toLinearMap)
        map_add' := fun L₁ L₂ => by simp [LinearMap.comp_add]
        map_smul' := fun c L => by simp [LinearMap.comp_smul] }
    exact T.continuous_of_finiteDimensional
  have hDν : ContinuousOn (fderiv ℝ ν) O := hν.continuousOn_fderiv_of_isOpen hO (by simp)
  have hνc : ContinuousOn ν O := hν.continuousOn
  have hcont : ContinuousOn (fun x => LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ ν x).toLinearMap)) M :=
    (((htr.comp_continuousOn hDν).sub (hνc.inner (hDν.clm_apply hνc))).mono hMO).congr hhF
  -- Step 4: `∫_M φ div_M ν dHᵐ = 0` for `C^∞` `φ` with compact support in `O ∩ U`, testing
  -- stationarity with `X = φν`
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  have htest : ∀ φ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ →
      tsupport φ ⊆ O ∩ U → ∫ x in M, φ x * LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ ν x).toLinearMap) ∂μHE[m] = 0 := by
    intro φ hφ hφc hφU
    -- (a) `X` is `C¹`: a product of `C^∞` maps on `O`, and `0` near each point off `O ⊇ tsupport φ`
    have hX : ContDiff ℝ 1 fun z => φ z • ν z := by
      refine contDiff_iff_contDiffAt.2 fun z => ?_
      by_cases hz : z ∈ O
      · exact (hφ.of_le (by simp)).contDiffAt.smul
          ((hν.of_le (by simp)).contDiffAt (hO.mem_nhds hz))
      · have hz' : z ∉ tsupport φ := fun h => hz (hφU h).1
        refine (contDiffAt_const (c := (0 : Euclid P))).congr_of_eventuallyEq ?_
        filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hz'] with y hy
        simp [hy]
    -- (b) `tsupport X ⊆ tsupport φ`, compact and contained in `U`
    have hXc : HasCompactSupport fun z => φ z • ν z := hφc.smul_right (f' := ν)
    have hXU : tsupport (fun z => φ z • ν z) ⊆ U :=
      (tsupport_smul_subset_left φ ν).trans (hφU.trans inter_subset_right)
    -- (c) `DX(x) = φ(x) Dν(x) + Dφ(x) ⊗ ν(x)` and `P_x ν(x) = 0`, so `div_M X = φ div_M ν` on `M`
    have hdiv : ∀ x ∈ M, φ x * LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ ν x).toLinearMap) = LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ (fun z => φ z • ν z) x).toLinearMap) := by
      intro x hx
      have hνx : DifferentiableAt ℝ ν x :=
        (hν.differentiableOn (by simp)).differentiableAt (hO.mem_nhds (hMO hx))
      rw [fderiv_fun_smul ((hφ.differentiable (by simp)) x) hνx]
      have hlin : (Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (φ x • fderiv ℝ ν x + (fderiv ℝ φ x).smulRight (ν x)).toLinearMap =
          φ x • ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
            (fderiv ℝ ν x).toLinearMap) := by
        refine LinearMap.ext fun w => ?_
        simp [hPν x hx]
      rw [hlin, map_smul, smul_eq_mul]
    -- (d) stationarity
    exact (setIntegral_congr_fun hMmeas hdiv).trans (hstat _ hX hXc hXU)
  -- Step 5: `Hᵐ(M ∩ B_s(x)) > 0`, since `Hᵐ(M ∩ B_t(x)) / (ωₘtᵐ) → 1` as `t ↓ 0`
  have hpos : ∀ x ∈ M, ∀ s : ℝ, 0 < s → 0 < μHE[m] (M ∩ ball x s) := by
    intro x hx s hs
    refine pos_iff_ne_zero.2 fun h0 => ?_
    have hzero : Tendsto (fun t : ℝ => μHE[m] (M ∩ ball x t) /
        (unitBallVolume m * ENNReal.ofReal (t ^ m))) (𝓝[>] 0) (𝓝 0) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Ioo_mem_nhdsGT hs] with t ht
      rw [measure_mono_null (inter_subset_inter_right M (ball_subset_ball ht.2.le)) h0,
        ENNReal.zero_div]
    exact zero_ne_one (tendsto_nhds_unique hzero
      (Submission.dimred_rpd_submanifold_density_one P m M x hM hx))
  -- Step 6: the fundamental lemma on the open set `O ∩ U ⊇ M`
  exact Submission.codim1_hcp_un_fundamental_lemma P μHE[m] (O ∩ U) M _ (hO.inter hU)
    (fun x hx => ⟨hMO hx, hMU hx⟩) hMmeas hcont
    (fun K hK hKU => hfin K hK (hKU.trans inter_subset_right)) hpos htest

/-- **Unit normal and minimality** (Simon, Appendix B, p. 229: `M` is "orientable, with
orientation induced from `C`"; Ch. 2, 4.23–4.29: `H = trace B` and, for a unit normal `ν`,
`H = −(div_M ν) ν`).  Let `M ⊆ U` be an embedded `C^∞` `m`-dimensional submanifold contained in
the `(m + 1)`-dimensional subspace `A₀`, oriented by `ξ`, with `Hᵐ(M ∩ K) < ∞` for compact
`K ⊆ U`, and stationary in `U`.  The tangent spaces of `M` lie in `A₀`, so `ξ` and a volume form
of `A₀` give a continuous unit normal `ν₀` of `M` in `A₀`.  In the `C^∞` charts of `M`, `ν₀` is
`±` the normalized cross product of the coordinate vectors, hence the restriction to `M` of a
`C^∞` map near each point of `M`, and a smooth partition of unity glues these maps into `ν`,
`C^∞` on an open `O ⊇ M`.  Testing stationarity with `X = φν` gives `∫_M φ div_M ν dHᵐ = 0` for
every test function `φ`, so the continuous function `div_M ν = trace(P_x ∘ Dν(x))` vanishes on
`M`. -/
theorem Submission.codim1_hcp_minimal_unit_normal : ∀ (P m : ℕ) (U : Set (Euclid P)) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)), IsOpen U → M ⊆ U → Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → (∃ ξ : Euclid P → MultiVector P m, IsOrientation m M ξ) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0) → ∃ (ν : Euclid P → Euclid P) (O : Set (Euclid P)), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O ∧ (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) ∧ ∀ x ∈ M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap) = 0 := by
  intro P m U A₀ M hU hMU hA₀ hMA₀ hr hξ hfin hstat
  -- step 1: `M` is in particular `C¹`, and each tangent space `TₓM` lies in `A₀`
  have h1 : IsEmbeddedSubmanifold 1 m M := hr 1
  have htan : ∀ x ∈ M, tangentSpace M x ⊆ (A₀ : Set (Euclid P)) := by
    intro x hx v hv
    obtain ⟨Q, hQ, -, hQA⟩ := Submission.codim1_hcp_un_tangent_subspace P m A₀ M h1 hMA₀ x hx
    rw [← hQ] at hv
    exact hQA hv
  -- steps 2-3: the orientation `ξ` and a volume form of `A₀` give a continuous unit normal `ν₀`
  obtain ⟨ξ, hξ⟩ := hξ
  obtain ⟨ν₀, hν₀c, hν₀⟩ := Submission.codim1_hcp_un_orientation_normal P m A₀ M ξ hA₀ htan hξ
  -- steps 4-5: in the `C^∞` charts of `M`, `ν₀` is locally the restriction of a `C^∞` map
  have hloc := Submission.codim1_hcp_un_normal_local_smooth P m A₀ M ν₀ hA₀ hMA₀
    (Submission.codim1_hcp_smooth_charts P m M hr) hν₀c hν₀
  -- step 6: a smooth partition of unity glues these into `ν`, `C^∞` on an open `O ⊇ M`
  obtain ⟨ν, O, hO, hMO, hνO, hνM⟩ := Submission.codim1_hcp_un_smooth_glue P (Euclid P) M ν₀ hloc
  have hν : ∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0 := by
    intro x hx
    rw [hνM x hx]
    exact hν₀ x hx
  -- step 7: stationarity tested with `X = φν` gives `div_M ν = trace(P_x ∘ Dν(x)) = 0` on `M`
  exact ⟨ν, O, hO, hMO, hνO, hν, Submission.codim1_hcp_un_zero_mean_curvature P m U A₀ M ν hU
    hMU hA₀ hMA₀ h1 hfin hstat ⟨O, hO, hMO, hνO⟩ hν⟩
/-- **Tangent projection of a hypersurface of `A₀`** (Simon Ch. 2, §4).  Let `M ⊆ A₀` be an
embedded `C¹` `m`-dimensional submanifold of `ℝᴾ`, `dim A₀ = m + 1`, and let `ν(x) ∈ A₀` be a unit
vector orthogonal to `T_xM` for each `x ∈ M`.  Then the orthogonal projection `P_x` onto
`span T_xM` is `P_x u = Πu − (ν(x)·u)ν(x)`, `Π` the orthogonal projection onto `A₀`, so
`x ↦ P_x u` is continuous on `M` when `ν` is.  `T_xM ⊆ A₀`, since the slopes of a `C¹` curve in
`M ⊆ A₀` lie in the closed subspace `A₀`; with `ν(x) ⊥ T_xM` this gives
`span T_xM ≤ H = (ℝν(x))ᗮ ∩ A₀`, and `dim H = m`.  A chart `ψ` with `ψ(v₀) = x` has
`T_xM = Dψ(v₀)(ℝᵐ)` with `Dψ(v₀)` injective, so `dim span T_xM = m` and `span T_xM = H`.  Finally
`p = Πu − (ν(x)·u)ν(x)` lies in `H` and `u − p ⊥ H`, so `P_x u = p`. -/
theorem Submission.codim1_hcp_stab_tangent_projection : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → IsEmbeddedSubmanifold 1 m M → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ x ∈ M, ∀ u : Euclid P, (Submodule.span ℝ (tangentSpace M x)).starProjection u = A₀.starProjection u - inner ℝ (ν x) u • ν x) ∧ (ContinuousOn ν M → ∀ u : Euclid P, ContinuousOn (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection u) M) := by
  intro P m A₀ M ν hdim hMA hM hν
  have hproj : ∀ x ∈ M, ∀ u : Euclid P, (Submodule.span ℝ (tangentSpace M x)).starProjection u =
      A₀.starProjection u - inner ℝ (ν x) u • ν x := by
    intro x hx u
    obtain ⟨hνA, hν1, hνT⟩ := hν x hx
    -- step 1: `T_xM ⊆ A₀`, as the slopes `t⁻¹(γ(t) − γ(0))` of a curve `γ` in `M ⊆ A₀` lie in
    -- the closed subspace `A₀`
    have hTA : tangentSpace M x ⊆ A₀ := by
      rintro v ⟨γ, -, hγM, -, hγv⟩
      have h0 : (0 : ℝ) ∈ Ioo (-1) 1 := ⟨by norm_num, one_pos⟩
      refine A₀.closed_of_finiteDimensional.mem_of_tendsto hγv.tendsto_slope_zero ?_
      filter_upwards [nhdsWithin_le_nhds (Ioo_mem_nhds (by norm_num : (-1 : ℝ) < 0) one_pos)]
        with t ht
      exact A₀.smul_mem _ (A₀.sub_mem (hMA (hγM (by rwa [zero_add]))) (hMA (hγM h0)))
    -- step 2: a chart `ψ` with `ψ(v₀) = x` gives `T_xM = Dψ(v₀)(ℝᵐ)`, `Dψ(v₀)` injective, so
    -- `span T_xM = Dψ(v₀)(ℝᵐ)` has dimension `m`
    obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, hψV, hproper, hDψ⟩ := hM x hx
    obtain ⟨v₀, hv₀, hxv⟩ : x ∈ ψ '' V := by
      rw [hψV]
      exact ⟨hxW, hx⟩
    have htan : tangentSpace M x = Set.range (fderiv ℝ ψ v₀) := by
      rw [← hxv]
      exact Submission.chart_tangentSpace_eq_range_fderiv P m 1 M W V ψ v₀ le_rfl hV hW hψ hinj
        hψV hproper hDψ hv₀
    have hspan : Submodule.span ℝ (tangentSpace M x) =
        LinearMap.range ((fderiv ℝ ψ v₀ : Euclid m →L[ℝ] Euclid P) : Euclid m →ₗ[ℝ] Euclid P) := by
      apply le_antisymm
      · rw [Submodule.span_le, htan]
        rintro _ ⟨y, rfl⟩
        exact ⟨y, rfl⟩
      · rintro _ ⟨y, rfl⟩
        apply Submodule.subset_span
        rw [htan]
        exact ⟨y, rfl⟩
    have hdimS : Module.finrank ℝ (Submodule.span ℝ (tangentSpace M x)) = m := by
      rw [hspan, LinearMap.finrank_range_of_inj (hDψ v₀ hv₀)]
      exact finrank_euclideanSpace_fin
    -- step 3: `span T_xM = H = (ℝν(x))ᗮ ⊓ A₀`: `span T_xM ≤ H`, and `dim H = (m + 1) − 1 = m`
    -- as `ℝν(x)` is a line in `A₀`
    have hν0 : ν x ≠ 0 := by
      intro h
      rw [h, norm_zero] at hν1
      exact zero_ne_one hν1
    have hdimH : Module.finrank ℝ ((ℝ ∙ ν x)ᗮ ⊓ A₀ : Submodule ℝ (Euclid P)) = m := by
      have h := Submodule.finrank_add_inf_finrank_orthogonal
        ((Submodule.span_singleton_le_iff_mem _ _).2 hνA)
      rw [finrank_span_singleton hν0, hdim] at h
      omega
    have hSH : Submodule.span ℝ (tangentSpace M x) = (ℝ ∙ ν x)ᗮ ⊓ A₀ := by
      refine Submodule.eq_of_le_of_finrank_eq ?_ (hdimS.trans hdimH.symm)
      rw [Submodule.span_le]
      intro v hv
      exact Submodule.mem_inf.2
        ⟨Submodule.mem_orthogonal_singleton_iff_inner_right.2 (hνT v hv), hTA hv⟩
    -- step 4: `p = Πu − (ν(x)·u)ν(x)` lies in `H`, and `u − p = (u − Πu) + (ν(x)·u)ν(x) ⊥ H`
    -- since `u − Πu ∈ A₀ᗮ`
    have hperp : u - A₀.starProjection u ∈ A₀ᗮ := A₀.sub_starProjection_mem_orthogonal u
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ?_ ?_
    · rw [hSH]
      refine Submodule.mem_inf.2 ⟨?_, A₀.sub_mem (A₀.starProjection_apply_mem u)
        (A₀.smul_mem _ hνA)⟩
      -- `ν(x)·Πu = ν(x)·u` and `ν(x)·ν(x) = 1`
      have h := Submodule.inner_right_of_mem_orthogonal hνA hperp
      rw [inner_sub_right] at h
      rw [Submodule.mem_orthogonal_singleton_iff_inner_right, inner_sub_right,
        real_inner_smul_right, real_inner_self_eq_norm_sq, hν1, one_pow, mul_one]
      linarith
    · intro w hw
      rw [hSH, Submodule.mem_inf, Submodule.mem_orthogonal_singleton_iff_inner_right] at hw
      have h : u - (A₀.starProjection u - inner ℝ (ν x) u • ν x) =
          (u - A₀.starProjection u) + inner ℝ (ν x) u • ν x := by
        abel
      rw [h, inner_add_left, real_inner_smul_left,
        Submodule.inner_left_of_mem_orthogonal hw.2 hperp, hw.1, mul_zero, add_zero]
  -- step 5: `x ↦ Πu − (ν(x)·u)ν(x)` is continuous on `M` when `ν` is, and equals `x ↦ P_x u`
  -- there
  refine ⟨hproj, fun hνc u => ?_⟩
  have hc : ContinuousOn (fun x => A₀.starProjection u - inner ℝ (ν x) u • ν x) M :=
    continuousOn_const.fun_sub ((hνc.inner continuousOn_const).fun_smul hνc)
  exact hc.congr fun x hx => hproj x hx u

/-- **Shape operator of a hypersurface in `A₀`** (Simon Ch. 2, 4.23–4.26, with the single unit
normal `ν`).  Let `M ⊆ A₀` be an embedded `C²` `m`-submanifold, `dim A₀ = m + 1`, and let the unit
normal `ν(y) ∈ A₀ ∩ (T_yM)^⊥` be `C¹` on an open `O ⊇ M`.  Then `Dν(x)` maps `S_x = span T_xM`
into itself and is symmetric there.  If `γ` is a `C¹` curve in `M` with `γ(0) = x`, `γ'(0) = τ`,
then `ν ∘ γ` stays in `A₀` and on the unit sphere, so `Dν(x)τ ∈ A₀` and `ν(x) · Dν(x)τ = 0`; the
tangent-projection formula `P_x u = Π_{A₀} u − (ν(x) · u) ν(x)` gives `P_x(Dν(x)τ) = Dν(x)τ`.
In a `C²` chart `ψ` with `x = ψ(v₀)`, `ν(ψ(v)) · Dψ(v)a = 0` on `V` since `Dψ(v)a ∈ T_{ψ(v)}M`;
differentiating at `v₀` in direction `b` gives `(Dν(x)Dψ(v₀)b) · Dψ(v₀)a = −ν(x) · D²ψ(v₀)(b, a)`,
which is symmetric in `a, b` by Schwarz, and `S_x = Dψ(v₀)(ℝᵐ)`. -/
theorem Submission.codim1_hcp_stab_shape_operator : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M O : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → IsEmbeddedSubmanifold 2 m M → IsOpen O → M ⊆ O → ContDiffOn ℝ 1 ν O → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → ∀ x ∈ M, ∀ τ ∈ Submodule.span ℝ (tangentSpace M x), fderiv ℝ ν x τ ∈ Submodule.span ℝ (tangentSpace M x) ∧ ∀ η ∈ Submodule.span ℝ (tangentSpace M x), inner ℝ η (fderiv ℝ ν x τ) = inner ℝ τ (fderiv ℝ ν x η) := by
  intro P m A₀ M O ν hdim hMA hM hO hMO hν hνM x hx
  -- step 0: `M` is also an embedded `C¹` submanifold, and `ν` is differentiable at `x ∈ O`
  have hM1 : IsEmbeddedSubmanifold 1 m M := by
    intro y hy
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hD⟩ := hM y hy
    exact ⟨V, W, ψ, hV, hW, hyW, hψ.of_le (by norm_num), hinj, himg, hprop, hD⟩
  have hνx : HasFDerivAt ν (fderiv ℝ ν x) x :=
    ((hν.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds (hMO hx))).hasFDerivAt
  -- step 1: a `C²` chart `ψ` with `x = ψ(v₀)`; `T_{ψ(v)}M = Dψ(v)(ℝᵐ)` for `v ∈ V`, so
  -- `S_x = Dψ(v₀)(ℝᵐ)`
  obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, himg, hprop, hD⟩ := hM x hx
  obtain ⟨v₀, hv₀, rfl⟩ : x ∈ ψ '' V := himg ▸ ⟨hxW, hx⟩
  have hT : ∀ v ∈ V, tangentSpace M (ψ v) = Set.range (fderiv ℝ ψ v) := fun v hv =>
    Submission.chart_tangentSpace_eq_range_fderiv P m 2 M W V ψ v (by norm_num) hV hW hψ hinj
      himg hprop hD hv
  have hS : Submodule.span ℝ (tangentSpace M (ψ v₀)) =
      LinearMap.range (fderiv ℝ ψ v₀ : Euclid m →ₗ[ℝ] Euclid P) := by
    rw [hT v₀ hv₀]
    exact Submodule.span_eq (LinearMap.range (fderiv ℝ ψ v₀ : Euclid m →ₗ[ℝ] Euclid P))
  -- the velocity at `0` of a curve staying in a (closed) subspace `K` near `0` lies in `K`
  have hvel : ∀ (K : Submodule ℝ (Euclid P)) (f : ℝ → Euclid P) (f' : Euclid P),
      HasDerivAt f f' 0 → (∀ᶠ s in 𝓝 0, f s ∈ K) → f' ∈ K := by
    intro K f f' hf hK
    refine K.closed_of_finiteDimensional.mem_of_tendsto hf.tendsto_slope ?_
    filter_upwards [nhdsWithin_le_nhds hK] with s hs
    rw [slope_def_module]
    exact K.smul_mem _ (K.sub_mem hs hK.self_of_nhds)
  intro τ hτ
  obtain ⟨a, rfl⟩ : ∃ a, fderiv ℝ ψ v₀ a = τ := LinearMap.mem_range.mp (hS ▸ hτ)
  refine ⟨?_, ?_⟩
  · -- step 2: a `C¹` curve `γ` in `M` with `γ(0) = x`, `γ'(0) = τ`, so `(ν ∘ γ)'(0) = Dν(x)τ`
    obtain ⟨γ, -, hγM, hγ0, hγ⟩ : fderiv ℝ ψ v₀ a ∈ tangentSpace M (ψ v₀) := by
      rw [hT v₀ hv₀]
      exact ⟨a, rfl⟩
    have hνγ : HasDerivAt (fun s => ν (γ s)) (fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ a)) 0 :=
      hνx.comp_hasDerivAt_of_eq 0 hγ hγ0.symm
    have hI : ∀ᶠ s in 𝓝 (0 : ℝ), γ s ∈ M :=
      Filter.mem_of_superset (Ioo_mem_nhds (by norm_num) (by norm_num)) fun s hs => hγM hs
    -- (a) `ν ∘ γ` stays in `A₀`, so `Dν(x)τ ∈ A₀`
    have hA : fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ a) ∈ A₀ :=
      hvel A₀ _ _ hνγ (hI.mono fun s hs => (hνM _ hs).1)
    -- (b) `(ν ∘ γ) · (ν ∘ γ) = 1`, so `ν(x) · Dν(x)τ = 0`
    have h1 := hνγ.inner ℝ hνγ
    have h2 : HasDerivAt (fun s => inner ℝ (ν (γ s)) (ν (γ s))) 0 0 :=
      (hasDerivAt_const (0 : ℝ) (1 : ℝ)).congr_of_eventuallyEq (hI.mono fun s hs => by
        simp only [real_inner_self_eq_norm_sq, (hνM _ hs).2.1, one_pow])
    have hn : inner ℝ (ν (ψ v₀)) (fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ a)) = 0 := by
      have h3 := h1.unique h2
      rw [hγ0] at h3
      have h4 := real_inner_comm (ν (ψ v₀)) (fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ a))
      linarith
    -- (c) `tangent_projection`: `P_x(Dν(x)τ) = Π(Dν(x)τ) − (ν(x) · Dν(x)τ) ν(x) = Dν(x)τ`
    have hP := (Submission.codim1_hcp_stab_tangent_projection P m A₀ M ν hdim hMA hM1 hνM).1
      (ψ v₀) hx (fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ a))
    rw [Submodule.starProjection_eq_self_iff.mpr hA, hn, zero_smul, sub_zero] at hP
    exact Submodule.starProjection_eq_self_iff.mp hP
  · intro η hη
    obtain ⟨b, rfl⟩ : ∃ b, fderiv ℝ ψ v₀ b = η := LinearMap.mem_range.mp (hS ▸ hη)
    -- `ψ` is `C²` on the open set `V`, so `ψ` and `Dψ` are differentiable at `v₀`
    have hψd : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ :=
      ((hψ.differentiableOn (by norm_num)).differentiableAt (hV.mem_nhds hv₀)).hasFDerivAt
    have hψ2 : HasFDerivAt (fderiv ℝ ψ) (fderiv ℝ (fderiv ℝ ψ) v₀) v₀ :=
      (((hψ.fderiv_of_isOpen hV (m := 1) (by norm_num)).differentiableOn
        one_ne_zero).differentiableAt (hV.mem_nhds hv₀)).hasFDerivAt
    -- steps 3–4: `f_c(v) = ν(ψ(v)) · Dψ(v)c` vanishes on `V`; differentiate at `v₀` along `d`
    have hstar : ∀ c d : Euclid m, inner ℝ (ν (ψ v₀)) (fderiv ℝ (fderiv ℝ ψ) v₀ d c) +
        inner ℝ (fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ d)) (fderiv ℝ ψ v₀ c) = 0 := by
      intro c d
      have hf := (hνx.comp v₀ hψd).inner ℝ (hψ2.clm_apply (hasFDerivAt_const c v₀))
      have h0 : HasFDerivAt (fun v => inner ℝ ((ν ∘ ψ) v) (fderiv ℝ ψ v c))
          (0 : Euclid m →L[ℝ] ℝ) v₀ := by
        refine (hasFDerivAt_const (0 : ℝ) v₀).congr_of_eventuallyEq ?_
        filter_upwards [hV.mem_nhds hv₀] with v hv
        have hvM : ψ v ∈ M := (himg ▸ mem_image_of_mem ψ hv : ψ v ∈ W ∩ M).2
        exact (hνM (ψ v) hvM).2.2 _ (by rw [hT v hv]; exact ⟨c, rfl⟩)
      simpa using congrArg (fun L => L d) (hf.unique h0)
    -- step 5 (Schwarz): `D²ψ(v₀)` is symmetric
    have hsymm : IsSymmSndFDerivAt ℝ ψ v₀ :=
      (hψ.contDiffAt (hV.mem_nhds hv₀)).isSymmSndFDerivAt (by simp)
    -- step 6: `(Dν(x)Dψ(v₀)b) · Dψ(v₀)a = −ν(x) · D²ψ(v₀)(b, a)` is symmetric in `a, b`
    have hab := hstar a b
    have hba := hstar b a
    rw [hsymm.eq b a] at hab
    have e1 := real_inner_comm (fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ a)) (fderiv ℝ ψ v₀ b)
    have e2 := real_inner_comm (fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ b)) (fderiv ℝ ψ v₀ a)
    linarith
/-- **Admissible ambient extension of the normal variation `ζν`** (stability of the hypercone;
`T_xM` as in Simon Ch. 2, §4).  Let `U, O ⊆ ℝᴾ` be open with `M ⊆ U ∩ O`, `ν` be `C^∞` on `O`
with `|ν| = 1` on `M`, and `ζ` be `C^∞` with `ζ = 0` on `M` off a compact `C ⊆ M`.  Take a compact
`L` with `C ⊆ int L ⊆ L ⊆ O ∩ U` and a `C^∞` cut-off `β` with support `int L` and `β = 1` on `C`.
Then `Z = βζν` is `C^∞` (near points of `O` a product of smooth maps, elsewhere locally `0`),
compactly supported in `U`, and `Z = ζν` on `M`.  Differentiating `Z ∘ γ = (ζ ∘ γ)(ν ∘ γ)` along a
`C¹` curve `γ` in `M` through `x` gives `DZ(x)γ'(0) = (Dζ(x)γ'(0))ν(x) + ζ(x)Dν(x)γ'(0)`.  Off
`tsupport Z`, `ζ = 0` on `M` near `x` (as `ν ≠ 0` on `M`), so `ζ ∘ γ = 0` near `0` and
`Dζ(x)γ'(0) = 0`.  Both identities extend to `span T_xM` by linearity. -/
theorem Submission.codim1_hcp_stab_variation_field : ∀ (P : ℕ) (U O M C : Set (Euclid P)) (ν : Euclid P → Euclid P) (ζ : Euclid P → ℝ), IsOpen U → IsOpen O → M ⊆ U → M ⊆ O → ContDiffOn ℝ (⊤ : ℕ∞) ν O → (∀ x ∈ M, ‖ν x‖ = 1) → ContDiff ℝ (⊤ : ℕ∞) ζ → IsCompact C → C ⊆ M → (∀ x ∈ M, x ∉ C → ζ x = 0) → ∃ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z ∧ HasCompactSupport Z ∧ tsupport Z ⊆ U ∧ (∀ x ∈ M, Z x = ζ x • ν x) ∧ (∀ x ∈ M, ∀ τ ∈ Submodule.span ℝ (tangentSpace M x), fderiv ℝ Z x τ = fderiv ℝ ζ x τ • ν x + ζ x • fderiv ℝ ν x τ) ∧ (∀ x ∈ M, x ∉ tsupport Z → ζ x = 0 ∧ ∀ τ ∈ Submodule.span ℝ (tangentSpace M x), fderiv ℝ ζ x τ = 0) := by
  intro P U O M C ν ζ hU hO hMU hMO hν hν1 hζ hC hCM hζC
  -- cut-off `β`: `C^∞`, `β = 1` on `C`, `tsupport β` compact inside `O ∩ U`
  obtain ⟨L, hLc, hCL, hLOU⟩ := exists_compact_between hC (hO.inter hU)
    fun x hx => ⟨hMO (hCM hx), hMU (hCM hx)⟩
  obtain ⟨β, hβ, -, hβsupp, hβ1⟩ :=
    exists_contDiff_support_eq_eq_one_iff (n := ⊤) isOpen_interior hC.isClosed hCL
  have hβL : tsupport β ⊆ L := by
    rw [tsupport, hβsupp]
    exact closure_minimal interior_subset hLc.isClosed
  have hβOU : tsupport β ⊆ O ∩ U := hβL.trans hLOU
  have hβc : HasCompactSupport β := hLc.of_isClosed_subset (isClosed_tsupport β) hβL
  have h1 : ((⊤ : ℕ∞) : WithTop ℕ∞) ≠ 0 := by simp
  have hζd : Differentiable ℝ ζ := hζ.differentiable h1
  -- `Z = β ζ ν`
  set Z : Euclid P → Euclid P := fun y => (β y * ζ y) • ν y with hZ
  have hZcd : ContDiff ℝ (⊤ : ℕ∞) Z := by
    refine contDiff_iff_contDiffAt.mpr fun y => ?_
    by_cases hy : y ∈ O
    · exact (hβ.contDiffAt.mul hζ.contDiffAt).smul (hν.contDiffAt (hO.mem_nhds hy))
    · have hy' : y ∉ tsupport β := fun h => hy (hβOU h).1
      have hev : Z =ᶠ[𝓝 y] fun _ => 0 := by
        filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hy'] with z hz
        simp [hZ, show β z = 0 from hz]
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hZM : ∀ x ∈ M, Z x = ζ x • ν x := by
    intro x hx
    by_cases hxC : x ∈ C
    · simp [hZ, (hβ1 x).mp hxC]
    · simp [hZ, hζC x hx hxC]
  have hZd : Differentiable ℝ Z := hZcd.differentiable h1
  refine ⟨Z, hZcd, hβc.mul_right.smul_right, ?_, hZM, ?_, ?_⟩
  · exact (tsupport_smul_subset_left _ _).trans
      (tsupport_mul_subset_left.trans (hβOU.trans inter_subset_right))
  · intro x hx τ hτ
    have hνd : HasFDerivAt ν (fderiv ℝ ν x) x :=
      ((hν.contDiffAt (hO.mem_nhds (hMO hx))).differentiableAt h1).hasFDerivAt
    induction hτ using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨γ, -, hγM, hγ0, hγ⟩ := hv
      have hA : HasDerivAt (Z ∘ γ) (fderiv ℝ Z x v) 0 :=
        (hZd x).hasFDerivAt.comp_hasDerivAt_of_eq 0 hγ hγ0.symm
      have hζγ : HasDerivAt (ζ ∘ γ) (fderiv ℝ ζ x v) 0 :=
        (hζd x).hasFDerivAt.comp_hasDerivAt_of_eq 0 hγ hγ0.symm
      have hνγ : HasDerivAt (ν ∘ γ) (fderiv ℝ ν x v) 0 :=
        hνd.comp_hasDerivAt_of_eq 0 hγ hγ0.symm
      have hev : Z ∘ γ =ᶠ[𝓝 0] (ζ ∘ γ) • (ν ∘ γ) := by
        filter_upwards [Ioo_mem_nhds (show (-1 : ℝ) < 0 by norm_num) one_pos] with s hs
        exact hZM _ (hγM hs)
      rw [(hA.congr_of_eventuallyEq hev.symm).unique (hζγ.smul hνγ), Function.comp_apply,
        Function.comp_apply, hγ0, add_comm]
    | zero => simp
    | add a b _ _ ha hb =>
      rw [map_add, map_add, map_add, ha, hb, add_smul, smul_add]
      abel
    | smul c a _ ha =>
      rw [map_smul, map_smul, map_smul, ha, smul_add, smul_eq_mul, mul_smul, smul_comm (ζ x) c]
  · intro x hx hxZ
    have hZ0 : ∀ᶠ y in 𝓝 x, Z y = 0 := notMem_tsupport_iff_eventuallyEq.mp hxZ
    have hζ0 : ∀ y ∈ M, Z y = 0 → ζ y = 0 := by
      intro y hy hZy
      rw [hZM y hy] at hZy
      refine (smul_eq_zero.mp hZy).resolve_right fun h => ?_
      have := hν1 y hy
      rw [h, norm_zero] at this
      exact zero_ne_one this
    refine ⟨hζ0 x hx hZ0.self_of_nhds, fun τ hτ => ?_⟩
    induction hτ using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨γ, -, hγM, hγ0, hγ⟩ := hv
      have hA : HasDerivAt (ζ ∘ γ) (fderiv ℝ ζ x v) 0 :=
        (hζd x).hasFDerivAt.comp_hasDerivAt_of_eq 0 hγ hγ0.symm
      have hev : ζ ∘ γ =ᶠ[𝓝 0] fun _ => (0 : ℝ) := by
        have hγt : Tendsto γ (𝓝 0) (𝓝 x) := hγ0 ▸ hγ.continuousAt.tendsto
        filter_upwards [hγt.eventually hZ0,
          Ioo_mem_nhds (show (-1 : ℝ) < 0 by norm_num) one_pos] with s hs hs'
        exact hζ0 _ (hγM hs') hs
      exact (hA.congr_of_eventuallyEq hev.symm).unique (hasDerivAt_const 0 0)
    | zero => simp
    | add a b _ _ ha hb => rw [map_add, ha, hb, add_zero]
    | smul c a _ ha => rw [map_smul, ha, smul_zero]
/-- **Uniform second-order expansion of `det (1 + tX + t²Y)`** (the expansion
`det (I + E) = 1 + tr E + ((tr E)² - tr (E²)) / 2 + O(|E|³)` behind the Taylor expansion of the
Jacobian in the second variation, Simon Ch. 2, 5.2–5.4).  With `A = X + tY`,
`det (1 + tA) = Σₖ eₖ(A) tᵏ`, where `eₖ(A)`, the `𝐗ᵏ`-coefficient of `det (1 + 𝐗A)`, is the sum of
the `k × k` principal minors: `e₀ = 1`, `e₁ = tr A`, and comparing `𝐗²`-coefficients in
`det (1 + 𝐗A) det (1 - 𝐗A) = det (1 - 𝐗²A²)` gives `e₂ = ((tr A)² - tr (A A)) / 2`.  The Leibniz
bound `|eₖ(A)| ≤ 2ᴺ N! bᴺ` (entries of `A` bounded by `b = 1 + 2|κ|`) controls the terms of order
`≥ 3`, and expanding `tr A`, `tr (A A)` in `t` costs at most `3 (N|κ|)² |t|³`. -/
theorem Submission.codim1_hcp_stab_det_second_order : ∀ (N : ℕ) (κ : ℝ), ∃ C : ℝ, ∀ n : ℕ, n ≤ N → ∀ X Y : Matrix (Fin n) (Fin n) ℝ, (∀ i j, |X i j| ≤ κ) → (∀ i j, |Y i j| ≤ κ) → ∀ t : ℝ, |t| ≤ 1 → |(1 + t • X + t ^ 2 • Y).det - (1 + t * X.trace + t ^ 2 * (Y.trace + (X.trace ^ 2 - (X * X).trace) / 2))| ≤ C * |t| ^ 3 := by
  intro N κ
  -- `b` bounds the entries of `X + tY`, `β` bounds every coefficient of `det (1 + 𝐗 (X + tY))`
  obtain ⟨b, hb⟩ : ∃ b : ℝ, b = 1 + 2 * |κ| := ⟨_, rfl⟩
  have hb1 : 1 ≤ b := by have := abs_nonneg κ; linarith
  have hb0 : 0 ≤ b := zero_le_one.trans hb1
  obtain ⟨β, hβ⟩ : ∃ β : ℝ, β = 2 ^ N * ((N.factorial : ℝ) * b ^ N) := ⟨_, rfl⟩
  have hβ0 : 0 ≤ β := by
    rw [hβ]; exact mul_nonneg (by positivity) (mul_nonneg (by positivity) (pow_nonneg hb0 N))
  refine ⟨N * β + 3 * (N * |κ|) ^ 2, ?_⟩
  intro n hn X Y hX hY t ht
  have hnN : (n : ℝ) ≤ N := by exact_mod_cast hn
  have hXk : ∀ i j, |X i j| ≤ |κ| := fun i j => (hX i j).trans (le_abs_self κ)
  have hYk : ∀ i j, |Y i j| ≤ |κ| := fun i j => (hY i j).trans (le_abs_self κ)
  -- Leibniz: a `k × k` determinant with entries bounded by `b` is at most `k! bᵏ`
  have hdet : ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (M : Matrix ι ι ℝ),
      (∀ i j, |M i j| ≤ b) → |M.det| ≤ (Fintype.card ι).factorial * b ^ Fintype.card ι := by
    intro ι _ _ M hM
    rw [Matrix.det_apply]
    calc |∑ σ : Equiv.Perm ι, Equiv.Perm.sign σ • ∏ i, M (σ i) i|
        ≤ ∑ σ : Equiv.Perm ι, |Equiv.Perm.sign σ • ∏ i, M (σ i) i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _σ : Equiv.Perm ι, b ^ Fintype.card ι := by
          refine Finset.sum_le_sum fun σ _ => ?_
          have hs : |Equiv.Perm.sign σ • ∏ i, M (σ i) i| = |∏ i, M (σ i) i| := by
            rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h
            · rw [h, one_smul]
            · rw [h, Units.neg_smul, one_smul, abs_neg]
          rw [hs, Finset.abs_prod]
          calc ∏ i, |M (σ i) i| ≤ ∏ _i : ι, b :=
                Finset.prod_le_prod₀ (fun i _ => abs_nonneg _) fun i _ => hM _ _
            _ = b ^ Fintype.card ι := by rw [Finset.prod_const, Finset.card_univ]
      _ = (Fintype.card ι).factorial * b ^ Fintype.card ι := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, nsmul_eq_mul]
  -- the coefficients of `det (1 + 𝐗 A)` are sums of principal minors, hence bounded by `β`
  have hcoeff : ∀ A : Matrix (Fin n) (Fin n) ℝ, (∀ i j, |A i j| ≤ b) → ∀ k : ℕ,
      |((1 + (Polynomial.X : Polynomial ℝ) • A.map Polynomial.C).det).coeff k| ≤ β := by
    intro A hA k
    rw [Matrix.coeff_det_one_add_X_smul_eq_sum_minors]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    refine (Finset.sum_le_sum (g := fun _ => (N.factorial : ℝ) * b ^ N) fun s _ => ?_).trans ?_
    · have hcard : Fintype.card s ≤ N :=
        (Fintype.card_le_of_injective _ Subtype.val_injective).trans (by simpa using hn)
      refine (hdet _ _ fun i j => hA _ _).trans ?_
      exact mul_le_mul (by exact_mod_cast Nat.factorial_le hcard) (pow_le_pow_right₀ hb1 hcard)
        (pow_nonneg hb0 _) (by positivity)
    · rw [Finset.sum_const, nsmul_eq_mul, Finset.card_powersetCard, Finset.card_univ,
        Fintype.card_fin, hβ]
      refine mul_le_mul_of_nonneg_right ?_ (mul_nonneg (by positivity) (pow_nonneg hb0 N))
      exact_mod_cast (Nat.choose_le_two_pow n k).trans (Nat.pow_le_pow_right two_pos hn)
  -- low coefficients: `e₀ = 1`, `e₁ = tr`, `e₂ = ((tr A)² - tr (A A)) / 2`
  have hc0 : ∀ M : Matrix (Fin n) (Fin n) ℝ,
      ((1 + (Polynomial.X : Polynomial ℝ) • M.map Polynomial.C).det).coeff 0 = 1 := by
    intro M
    rw [Matrix.det_one_add_X_smul]
    simp
  have hc2 : ∀ M : Matrix (Fin n) (Fin n) ℝ,
      ((1 + (Polynomial.X : Polynomial ℝ) • M.map Polynomial.C).det).coeff 2 =
        (M.trace ^ 2 - (M * M).trace) / 2 := by
    intro M
    -- `e₂(-M) = e₂(M)`: each `2 × 2` principal minor is unchanged by `M ↦ -M`
    have hneg : ((1 + (Polynomial.X : Polynomial ℝ) • (-M).map Polynomial.C).det).coeff 2 =
        ((1 + (Polynomial.X : Polynomial ℝ) • M.map Polynomial.C).det).coeff 2 := by
      rw [Matrix.coeff_det_one_add_X_smul_eq_sum_minors,
        Matrix.coeff_det_one_add_X_smul_eq_sum_minors]
      refine Finset.sum_congr rfl fun s hs => ?_
      have hs2 : s.card = 2 := (Finset.mem_powersetCard.1 hs).2
      have : (-M).submatrix (Subtype.val : s → Fin n) (Subtype.val : s → Fin n) =
          -(M.submatrix (Subtype.val : s → Fin n) (Subtype.val : s → Fin n)) := by
        ext i j; rfl
      rw [this, Matrix.det_neg, Fintype.card_coe, hs2]
      norm_num
    -- `det (1 + 𝐗 M) * det (1 + 𝐗 (-M)) = det (1 - 𝐗² M²)`
    have hprod : (1 + (Polynomial.X : Polynomial ℝ) • M.map Polynomial.C).det *
        (1 + (Polynomial.X : Polynomial ℝ) • (-M).map Polynomial.C).det =
          (1 + (-(Polynomial.X : Polynomial ℝ) ^ 2) • (M * M).map Polynomial.C).det := by
      rw [← Matrix.det_mul]
      congr 1
      rw [Matrix.map_mul, Matrix.map_neg _ (fun _ => Polynomial.C_neg)]
      simp only [add_mul, mul_add, one_mul, mul_one, Matrix.smul_mul, Matrix.mul_smul, smul_neg,
        mul_neg, smul_smul]
      module
    -- the `𝐗²` coefficient of `det (1 - 𝐗² M²)` is `-tr (M M)`
    have hrhs :
        ((1 + (-(Polynomial.X : Polynomial ℝ) ^ 2) • (M * M).map Polynomial.C).det).coeff 2 =
          -(M * M).trace := by
      rw [Matrix.det_one_add_smul, ← AddMonoidHom.map_trace Polynomial.C]
      simp [Polynomial.coeff_mul_X_pow', Polynomial.coeff_one, ← pow_mul]
    -- the `𝐗²` coefficient of the product is `e₂(M) + e₁(M) e₁(-M) + e₂(-M)`
    have hlhs := congrArg (fun p : Polynomial ℝ => p.coeff 2) hprod
    simp only [hrhs] at hlhs
    rw [Polynomial.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk] at hlhs
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add] at hlhs
    norm_num at hlhs
    rw [hc0, hc0, hneg, Matrix.coeff_det_one_add_X_smul_one,
      Matrix.coeff_det_one_add_X_smul_one, Matrix.trace_neg] at hlhs
    linarith
  -- traces of `X`, `Y` and of their products
  have htr1 : ∀ U : Matrix (Fin n) (Fin n) ℝ, (∀ i j, |U i j| ≤ |κ|) →
      |U.trace| ≤ N * |κ| := by
    intro U hU
    calc |U.trace| = |∑ i, U i i| := rfl
      _ ≤ ∑ i, |U i i| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin n, |κ| := Finset.sum_le_sum fun i _ => hU i i
      _ = n * |κ| := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ ≤ N * |κ| := mul_le_mul_of_nonneg_right hnN (abs_nonneg κ)
  have htr2 : ∀ U V : Matrix (Fin n) (Fin n) ℝ, (∀ i j, |U i j| ≤ |κ|) →
      (∀ i j, |V i j| ≤ |κ|) → |(U * V).trace| ≤ (N * |κ|) ^ 2 := by
    intro U V hU hV
    calc |(U * V).trace| = |∑ i, ∑ j, U i j * V j i| := by simp [Matrix.trace, Matrix.mul_apply]
      _ ≤ ∑ i, |∑ j, U i j * V j i| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i, ∑ j, |U i j * V j i| := Finset.sum_le_sum fun i _ => Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin n, ∑ _j : Fin n, |κ| * |κ| := by
          refine Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => ?_
          rw [abs_mul]
          exact mul_le_mul (hU i j) (hV j i) (abs_nonneg _) (abs_nonneg _)
      _ = (n * |κ|) ^ 2 := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
      _ ≤ (N * |κ|) ^ 2 := by gcongr
  -- `1 + tX + t²Y = 1 + tA` with `A = X + tY`, whose entries are bounded by `b`
  obtain ⟨A, hA⟩ : ∃ A : Matrix (Fin n) (Fin n) ℝ, A = X + t • Y := ⟨_, rfl⟩
  have hsplit : 1 + t • X + t ^ 2 • Y = 1 + t • A := by
    rw [hA]; module
  have hAb : ∀ i j, |A i j| ≤ b := by
    intro i j
    rw [hA, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, hb]
    calc |X i j + t * Y i j| ≤ |X i j| + |t * Y i j| := abs_add_le _ _
      _ = |X i j| + |t| * |Y i j| := by rw [abs_mul]
      _ ≤ |κ| + 1 * |κ| :=
          add_le_add (hXk i j) (mul_le_mul ht (hYk i j) (abs_nonneg _) zero_le_one)
      _ ≤ 1 + 2 * |κ| := by linarith
  -- `det (1 + tA) = 1 + t tr A + t² (e₂(A) + R)` with `|R| ≤ N β |t|`
  obtain ⟨p, hp⟩ : ∃ p : Polynomial ℝ,
      p = (1 + (Polynomial.X : Polynomial ℝ) • A.map Polynomial.C).det := ⟨_, rfl⟩
  have hq_coeff : ∀ k, p.divX.divX.coeff k = p.coeff (k + 2) := by
    intro k; simp only [Polynomial.coeff_divX]
  have hq_deg : p.divX.divX.natDegree < n + 1 := by
    rw [Nat.lt_succ_iff, Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro m hm
    rw [hq_coeff, hp, Matrix.coeff_det_one_add_X_smul_eq_sum_minors,
      Finset.powersetCard_eq_empty.2 (by rw [Finset.card_univ, Fintype.card_fin]; omega),
      Finset.sum_empty]
  have heval : Polynomial.eval t p.divX.divX = p.coeff 2 +
      ∑ i ∈ Finset.range n, p.divX.divX.coeff (i + 1) * t ^ (i + 1) := by
    rw [Polynomial.eval_eq_sum_range' hq_deg, Finset.sum_range_succ', pow_zero, mul_one,
      add_comm, hq_coeff]
  have hrem :
      |∑ i ∈ Finset.range n, p.divX.divX.coeff (i + 1) * t ^ (i + 1)| ≤ N * β * |t| := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ i ∈ Finset.range n, |p.divX.divX.coeff (i + 1) * t ^ (i + 1)|
        ≤ ∑ _i ∈ Finset.range n, β * |t| := by
          refine Finset.sum_le_sum fun i _ => ?_
          rw [abs_mul, abs_pow, hq_coeff, hp]
          exact mul_le_mul (hcoeff A hAb _)
            (pow_le_of_le_one (abs_nonneg t) ht (Nat.succ_ne_zero i)) (by positivity) hβ0
      _ = n * (β * |t|) := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      _ ≤ N * β * |t| := by
          rw [← mul_assoc]
          exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hnN hβ0) (abs_nonneg t)
  -- traces of `A` and `A A`
  have htrA : A.trace = X.trace + t * Y.trace := by
    rw [hA, Matrix.trace_add, Matrix.trace_smul, smul_eq_mul]
  have htrAA : (A * A).trace = (X * X).trace + t * ((X * Y).trace + (Y * X).trace) +
      t ^ 2 * (Y * Y).trace := by
    rw [hA]
    simp only [add_mul, mul_add, Matrix.smul_mul, Matrix.mul_smul, Matrix.trace_add,
      Matrix.trace_smul, smul_eq_mul, smul_smul]
    ring
  -- the difference is `t² R + t³ S`
  have hD : (1 + t • X + t ^ 2 • Y).det - (1 + t * X.trace + t ^ 2 * (Y.trace +
      (X.trace ^ 2 - (X * X).trace) / 2)) =
        t ^ 2 * ∑ i ∈ Finset.range n, p.divX.divX.coeff (i + 1) * t ^ (i + 1) +
          t ^ 3 * ((2 * X.trace * Y.trace - (X * Y).trace - (Y * X).trace) / 2 +
            t * (Y.trace ^ 2 - (Y * Y).trace) / 2) := by
    rw [hsplit, Matrix.det_one_add_smul, ← hp, heval, hp, hc2 A, htrA, htrAA]
    ring
  -- `|S| ≤ 3 (N |κ|)²`
  have hS : |(2 * X.trace * Y.trace - (X * Y).trace - (Y * X).trace) / 2 +
      t * (Y.trace ^ 2 - (Y * Y).trace) / 2| ≤ 3 * (N * |κ|) ^ 2 := by
    have hx := htr1 X hXk
    have hy := htr1 Y hYk
    have hxy := htr2 X Y hXk hYk
    have hyx := htr2 Y X hYk hXk
    have hyy := htr2 Y Y hYk hYk
    have ha : 0 ≤ (N : ℝ) * |κ| := by positivity
    have h1 : |X.trace * Y.trace| ≤ (N * |κ|) ^ 2 := by
      rw [abs_mul, sq]; exact mul_le_mul hx hy (abs_nonneg _) ha
    have h2 : |t * Y.trace ^ 2| ≤ (N * |κ|) ^ 2 := by
      rw [abs_mul, abs_pow]
      calc |t| * |Y.trace| ^ 2 ≤ 1 * (N * |κ|) ^ 2 :=
            mul_le_mul ht (pow_le_pow_left₀ (abs_nonneg _) hy 2) (by positivity) zero_le_one
        _ = (N * |κ|) ^ 2 := one_mul _
    have h3 : |t * (Y * Y).trace| ≤ (N * |κ|) ^ 2 := by
      rw [abs_mul]
      calc |t| * |(Y * Y).trace| ≤ 1 * (N * |κ|) ^ 2 :=
            mul_le_mul ht hyy (abs_nonneg _) zero_le_one
        _ = (N * |κ|) ^ 2 := one_mul _
    obtain ⟨h1l, h1r⟩ := abs_le.mp h1
    obtain ⟨h2l, h2r⟩ := abs_le.mp h2
    obtain ⟨h3l, h3r⟩ := abs_le.mp h3
    obtain ⟨hxyl, hxyr⟩ := abs_le.mp hxy
    obtain ⟨hyxl, hyxr⟩ := abs_le.mp hyx
    rw [abs_le]
    constructor <;> linarith
  rw [hD]
  calc _ ≤ |t ^ 2 * ∑ i ∈ Finset.range n, p.divX.divX.coeff (i + 1) * t ^ (i + 1)| +
        |t ^ 3 * ((2 * X.trace * Y.trace - (X * Y).trace - (Y * X).trace) / 2 +
          t * (Y.trace ^ 2 - (Y * Y).trace) / 2)| := abs_add_le _ _
    _ = |t| ^ 2 * |∑ i ∈ Finset.range n, p.divX.divX.coeff (i + 1) * t ^ (i + 1)| +
        |t| ^ 3 * |(2 * X.trace * Y.trace - (X * Y).trace - (Y * X).trace) / 2 +
          t * (Y.trace ^ 2 - (Y * Y).trace) / 2| := by rw [abs_mul, abs_mul, abs_pow, abs_pow]
    _ ≤ |t| ^ 2 * (N * β * |t|) + |t| ^ 3 * (3 * (N * |κ|) ^ 2) := by gcongr
    _ = (N * β + 3 * (N * |κ|) ^ 2) * |t| ^ 3 := by ring

/-- Second-order bound for the area Jacobian (Simon Ch. 2, 5.2–5.4, in the second variation of
area, Appendix B): if `‖L‖ ≤ Λ`, `trace(P_S L) = 0` and `|t| ≤ 1`, then
`√det(((I + tL)ι_S)*((I + tL)ι_S)) ≤ 1 + (t²/2) Σⱼ (|L uⱼ − P_S L uⱼ|² − uⱼ · L(P_S L uⱼ)) + C|t|³`,
`uⱼ = P_S eⱼ`.  In an orthonormal basis `τ` of `S` the Gram matrix of `T = (I + tL)ι_S` is
`1 + tX + t²Y` with `Xᵢⱼ = τᵢ · Lτⱼ + Lτᵢ · τⱼ`, `Yᵢⱼ = Lτᵢ · Lτⱼ`, entries bounded by `2|Λ| + Λ²`,
so `det_second_order` expands its determinant to second order.  Computing `trace(P_S R)` in the
bases `τ` and `(eⱼ)` gives `tr X = 2 trace(P_S L) = 0` and identifies the `t²`-coefficient with
the sum above (`R = L*L − L*P_S L − L P_S L`).  Finally `det(T*T) ≥ 0` (its eigenvalues are
`|Tv|² ≥ 0`) and `√y ≤ (1 + y)/2`. -/
theorem Submission.codim1_hcp_stab_jacobian_bound : ∀ (P : ℕ) (Λ : ℝ), ∃ C : ℝ, ∀ (S : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P), ‖L‖ ≤ Λ → LinearMap.trace ℝ (Euclid P) (S.starProjection.toLinearMap ∘ₗ L.toLinearMap) = 0 → ∀ t : ℝ, |t| ≤ 1 → Real.sqrt ((((ContinuousLinearMap.id ℝ (Euclid P) + t • L).comp S.subtypeL).adjoint ∘L ((ContinuousLinearMap.id ℝ (Euclid P) + t • L).comp S.subtypeL)).det) ≤ 1 + t ^ 2 / 2 * ∑ j : Fin P, (‖L (S.starProjection (EuclideanSpace.single j 1)) - S.starProjection (L (S.starProjection (EuclideanSpace.single j 1)))‖ ^ 2 - inner ℝ (S.starProjection (EuclideanSpace.single j 1)) (L (S.starProjection (L (S.starProjection (EuclideanSpace.single j 1)))))) + C * |t| ^ 3 := by
  intro P Λ
  -- step 1: the constant `C₁` of `det_second_order` for `N = P`, `κ = 2|Λ| + Λ²`; `C = C₁ / 2`
  obtain ⟨C₁, hC₁⟩ := Submission.codim1_hcp_stab_det_second_order P (2 * |Λ| + Λ ^ 2)
  refine ⟨C₁ / 2, ?_⟩
  intro S L hL htr t ht
  have hΛ : 0 ≤ Λ := (norm_nonneg L).trans hL
  -- step 2: an orthonormal basis `τ` of `S` (`dim S ≤ P`), and `P_S w = ∑ₖ (τₖ · w) τₖ`
  set n := Module.finrank ℝ S
  have hnP : n ≤ P := (Submodule.finrank_le S).trans_eq finrank_euclideanSpace_fin
  let τ : OrthonormalBasis (Fin n) ℝ S := stdOrthonormalBasis ℝ S
  have hτn : ∀ i, ‖(τ i : Euclid P)‖ = 1 := fun i => by
    rw [Submodule.norm_coe]; exact τ.norm_eq_one i
  have hτδ : ∀ i j, inner ℝ (τ i : Euclid P) (τ j : Euclid P) = if i = j then 1 else 0 :=
    fun i j => by rw [← Submodule.coe_inner]; exact τ.inner_eq_ite i j
  have hPexp : ∀ w : Euclid P,
      S.starProjection w = ∑ k, inner ℝ (τ k : Euclid P) w • (τ k : Euclid P) := by
    intro w
    rw [Submodule.starProjection_apply]
    conv_lhs => rw [← τ.sum_repr' (S.orthogonalProjectionOnto w)]
    simp only [Submodule.coe_sum, Submodule.coe_smul,
      Submodule.inner_orthogonalProjectionOnto_eq_of_mem_left]
  -- step 3: `trace(P_S ∘ R) = ∑ᵢ τᵢ · Rτᵢ = ∑ⱼ uⱼ · R uⱼ` for every linear `R` (`uⱼ = P_S eⱼ`)
  have htrτ : ∀ R : Euclid P →ₗ[ℝ] Euclid P,
      LinearMap.trace ℝ (Euclid P) (S.starProjection.toLinearMap ∘ₗ R) =
        ∑ i, inner ℝ (τ i : Euclid P) (R (τ i)) := by
    intro R
    -- `P_S = ι_S ∘ π_S`, so `trace(P_S ∘ R) = trace_S(π_S ∘ R ∘ ι_S)`
    have h1 : S.starProjection.toLinearMap ∘ₗ R =
        S.subtype ∘ₗ (S.orthogonalProjectionOnto.toLinearMap ∘ₗ R) :=
      LinearMap.ext fun _ => rfl
    rw [h1, LinearMap.trace_comp_comm', LinearMap.trace_eq_sum_inner _ τ]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [LinearMap.comp_apply, Submodule.subtype_apply, ContinuousLinearMap.coe_coe,
      Submodule.inner_orthogonalProjectionOnto_eq_of_mem_left]
  have htrE : ∀ R : Euclid P →ₗ[ℝ] Euclid P,
      LinearMap.trace ℝ (Euclid P) (S.starProjection.toLinearMap ∘ₗ R) =
        ∑ j : Fin P, inner ℝ (S.starProjection (EuclideanSpace.single j 1))
          (R (S.starProjection (EuclideanSpace.single j 1))) := by
    intro R
    -- `P_S ∘ R = P_S ∘ (P_S ∘ R)`, so `trace(P_S ∘ R) = trace(P_S ∘ R ∘ P_S)`
    have hPP : S.starProjection.toLinearMap ∘ₗ R =
        S.starProjection.toLinearMap ∘ₗ (S.starProjection.toLinearMap ∘ₗ R) :=
      LinearMap.ext fun x => by
        simp [Submodule.starProjection_eq_self_iff.mpr (S.starProjection_apply_mem (R x))]
    rw [hPP, LinearMap.trace_comp_comm',
      LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin P) ℝ)]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [LinearMap.comp_apply, ContinuousLinearMap.coe_coe, EuclideanSpace.basisFun_apply]
    exact (Submodule.inner_starProjection_left_eq_right S _ _).symm
  have hstar : ∀ R : Euclid P →ₗ[ℝ] Euclid P,
      ∑ j : Fin P, inner ℝ (S.starProjection (EuclideanSpace.single j 1))
          (R (S.starProjection (EuclideanSpace.single j 1))) =
        ∑ i, inner ℝ (τ i : Euclid P) (R (τ i)) :=
    fun R => (htrE R).symm.trans (htrτ R)
  -- step 4: the matrix of `G = T*T`, `T = (I + tL)ι_S`, in the basis `τ` is `1 + tX + t²Y`
  set T : S →L[ℝ] Euclid P := (ContinuousLinearMap.id ℝ (Euclid P) + t • L).comp S.subtypeL
  let M : Fin n → Fin n → ℝ := fun a b => inner ℝ (τ a : Euclid P) (L (τ b))
  let X : Matrix (Fin n) (Fin n) ℝ := Matrix.of fun i j => M i j + M j i
  let Y : Matrix (Fin n) (Fin n) ℝ := Matrix.of fun i j => inner ℝ (L (τ i)) (L (τ j))
  have hTapp : ∀ x : S, T x = (x : Euclid P) + t • L x := fun x => rfl
  have hmat : LinearMap.toMatrix τ.toBasis τ.toBasis (T.adjoint ∘L T).toLinearMap =
      1 + t • X + t ^ 2 • Y := by
    ext i j
    rw [LinearMap.toMatrix_apply, τ.coe_toBasis, τ.coe_toBasis_repr_apply, τ.repr_apply_apply]
    simp only [ContinuousLinearMap.coe_coe, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.adjoint_inner_right, hTapp, inner_add_left, inner_add_right,
      real_inner_smul_left, real_inner_smul_right, hτδ, Matrix.add_apply, Matrix.smul_apply,
      Matrix.one_apply, smul_eq_mul, X, Y, M, Matrix.of_apply,
      real_inner_comm (L (τ i)) (τ j : Euclid P)]
    ring
  have hdetG : (T.adjoint ∘L T).det = (1 + t • X + t ^ 2 • Y).det := by
    rw [← hmat, LinearMap.det_toMatrix]
  -- step 5: `|Xᵢⱼ| ≤ 2Λ ≤ κ`, `|Yᵢⱼ| ≤ Λ² ≤ κ`, and the expansion of `det_second_order`
  have hLτ : ∀ i, ‖L (τ i)‖ ≤ Λ := fun i => by
    have := L.le_opNorm (τ i : Euclid P)
    rw [hτn i, mul_one] at this
    exact this.trans hL
  have hM : ∀ a b, |M a b| ≤ Λ := fun a b => by
    refine (abs_real_inner_le_norm _ _).trans ?_
    rw [hτn a, one_mul]; exact hLτ b
  have hX : ∀ i j, |X i j| ≤ 2 * |Λ| + Λ ^ 2 := fun i j => by
    have h1 := abs_add_le (M i j) (M j i)
    have h2 := hM i j
    have h3 := hM j i
    have h4 : Λ ≤ |Λ| := le_abs_self Λ
    simp only [X, Matrix.of_apply]
    nlinarith [sq_nonneg Λ]
  have hY : ∀ i j, |Y i j| ≤ 2 * |Λ| + Λ ^ 2 := fun i j => by
    have h1 := abs_real_inner_le_norm (L (τ i)) (L (τ j))
    have h2 : ‖L (τ i)‖ * ‖L (τ j)‖ ≤ Λ * Λ :=
      mul_le_mul (hLτ i) (hLτ j) (norm_nonneg _) hΛ
    have h4 : 0 ≤ |Λ| := abs_nonneg Λ
    simp only [Y, Matrix.of_apply]
    nlinarith
  have hexp := hC₁ n hnP X Y hX hY t ht
  -- step 6: `tr X = 2 ∑ᵢ τᵢ · Lτᵢ = 2 trace(P_S ∘ L) = 0`
  have htrX : X.trace = 0 := by
    have h1 := htrτ L.toLinearMap
    rw [htr] at h1
    simp only [Matrix.trace, Matrix.diag, X, Matrix.of_apply, M]
    simp only [ContinuousLinearMap.coe_coe] at h1
    rw [Finset.sum_add_distrib, ← h1, add_zero]
  -- step 7: the `t²`-coefficient equals `Q`; `|w − P_S w|² = |w|² − w · P_S w`, and
  -- `R = L*L − L*P_S L − L P_S L` has `v · Rv = |Lv − P_S Lv|² − v · L(P_S Lv)`
  have hproj : ∀ w : Euclid P,
      ‖w - S.starProjection w‖ ^ 2 = ‖w‖ ^ 2 - inner ℝ w (S.starProjection w) := by
    intro w
    have h0 := Submodule.starProjection_inner_eq_zero (K := S) w (S.starProjection w)
      (S.starProjection_apply_mem w)
    rw [← real_inner_self_eq_norm_sq, ← real_inner_self_eq_norm_sq, inner_sub_right, h0,
      sub_zero, inner_sub_left, real_inner_comm (S.starProjection w) w]
  let R : Euclid P →ₗ[ℝ] Euclid P :=
    (L.adjoint ∘L L - L.adjoint ∘L (S.starProjection ∘L L) -
      L ∘L (S.starProjection ∘L L)).toLinearMap
  have hR : ∀ v : Euclid P, inner ℝ v (R v) =
      ‖L v - S.starProjection (L v)‖ ^ 2 - inner ℝ v (L (S.starProjection (L v))) := by
    intro v
    simp only [R, ContinuousLinearMap.coe_coe, sub_apply,
      ContinuousLinearMap.comp_apply, inner_sub_right, ContinuousLinearMap.adjoint_inner_right,
      hproj, real_inner_self_eq_norm_sq]
  -- by `(★)`, `Q = ∑ᵢ τᵢ · Rτᵢ = ∑ᵢ (|Lτᵢ|² − ∑ₖ Mₖᵢ² − ∑ₖ MₖᵢMᵢₖ)`, `Mₐᵦ = τₐ · Lτᵦ`
  have hQ : ∑ j : Fin P, (‖L (S.starProjection (EuclideanSpace.single j 1)) -
        S.starProjection (L (S.starProjection (EuclideanSpace.single j 1)))‖ ^ 2 -
        inner ℝ (S.starProjection (EuclideanSpace.single j 1))
          (L (S.starProjection (L (S.starProjection (EuclideanSpace.single j 1)))))) =
      ∑ i, (‖L (τ i)‖ ^ 2 - ∑ k, M k i * M k i - ∑ k, M k i * M i k) := by
    rw [Finset.sum_congr rfl fun j _ => (hR _).symm, hstar R]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hR, hproj, hPexp (L (τ i))]
    simp only [inner_sum, map_sum, map_smul, real_inner_smul_right, M,
      real_inner_comm (L (τ i))]
  -- `tr Y = ∑ᵢ |Lτᵢ|²` and `tr(X·X) = 2 ∑ᵢⱼ Mᵢⱼ² + 2 ∑ᵢⱼ MᵢⱼMⱼᵢ`
  have hc : Y.trace + (X.trace ^ 2 - (X * X).trace) / 2 =
      ∑ i, (‖L (τ i)‖ ^ 2 - ∑ k, M k i * M k i - ∑ k, M k i * M i k) := by
    have hYtr : Y.trace = ∑ i, ‖L (τ i)‖ ^ 2 := by
      simp only [Matrix.trace, Matrix.diag, Y, Matrix.of_apply, real_inner_self_eq_norm_sq]
    have hXX : (X * X).trace = ∑ i, ∑ j, (M i j + M j i) * (M j i + M i j) := by
      simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, X, Matrix.of_apply]
    have hswap : ∑ i, ∑ j, M i j * M i j = ∑ i, ∑ j, M j i * M j i := Finset.sum_comm
    have hexpand : ∑ i, ∑ j, (M i j + M j i) * (M j i + M i j) =
        ∑ i, ∑ j, M i j * M i j + ∑ i, ∑ j, M j i * M j i + 2 * ∑ i, ∑ j, M j i * M i j := by
      simp only [← Finset.sum_add_distrib, Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
    rw [htrX, hYtr, hXX, hexpand, hswap]
    simp only [Finset.sum_sub_distrib]
    ring
  -- step 8: `det G ≥ 0`: `G` is symmetric and its eigenvalues are `v · Gv = |Tv|² ≥ 0`
  have hsymm : (T.adjoint ∘L T).toLinearMap.IsSymmetric := by
    intro x y
    simp only [ContinuousLinearMap.coe_coe, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.adjoint_inner_left, ContinuousLinearMap.adjoint_inner_right]
  have hdet0 : 0 ≤ (T.adjoint ∘L T).det := by
    show 0 ≤ LinearMap.det (T.adjoint ∘L T).toLinearMap
    rw [hsymm.det_eq_prod_eigenvalues rfl]
    refine Finset.prod_nonneg fun i _ => ?_
    have := eigenvalue_nonneg_of_nonneg (hsymm.hasEigenvalue_eigenvalues rfl i) fun x => by
      simp only [ContinuousLinearMap.coe_coe, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.adjoint_inner_right, RCLike.re_to_real]
      exact real_inner_self_nonneg
    simpa using this
  -- step 9: `det G ≤ 1 + t²Q + C₁|t|³` and `√y ≤ (1 + y)/2` for `y ≥ 0`
  rw [hdetG] at hdet0 ⊢
  rw [hQ]
  rw [hc, htrX] at hexp
  have h1 := (abs_le.mp hexp).2
  have h2 : Real.sqrt (1 + t • X + t ^ 2 • Y).det ≤ (1 + (1 + t • X + t ^ 2 • Y).det) / 2 := by
    nlinarith [Real.sq_sqrt hdet0, sq_nonneg (Real.sqrt (1 + t • X + t ^ 2 • Y).det - 1)]
  linarith
/-- **Second-variation integrand of a normal variation** (Simon Ch. 2, 5.4 and 5.11–5.12, as used
for the stability inequality B.1): the linear algebra evaluating the second variation of area
along `Z = ζν`.  Let `P_S` be the orthogonal projection onto a subspace `S ⊆ ℝᴾ`, `ν₀ ⊥ S` a unit
vector, `N` a map with `N(S) ⊆ S` that is symmetric on `S`, and `Lτ = g(τ)ν₀ + ζNτ` for `τ ∈ S`.
With `u_j = P_Se_j ∈ S`, `trace(P_S ∘ R) = trace(P_S ∘ R ∘ P_S) = Σ_j u_j · Ru_j` for every `R`,
and `u_j · ν₀ = 0`, so `trace(P_S ∘ L) = ζ trace(P_S ∘ N)`.  As `P_Sν₀ = 0` and `P_SNu_j = Nu_j`,
`P_SLu_j = ζNu_j`; hence `Lu_j − P_SLu_j = g(u_j)ν₀` has squared length `g(u_j)²`, and
`u_j · L(P_SLu_j) = ζ² u_j · N(Nu_j) = ζ²|Nu_j|²` by the symmetry of `N` on `S`. -/
theorem Submission.codim1_hcp_stab_normal_variation_algebra : ∀ (P : ℕ) (S : Submodule ℝ (Euclid P)) (ν₀ : Euclid P) (N L : Euclid P →L[ℝ] Euclid P) (g : Euclid P →L[ℝ] ℝ) (ζ : ℝ), ‖ν₀‖ = 1 → (∀ v ∈ S, inner ℝ ν₀ v = 0) → (∀ τ ∈ S, N τ ∈ S) → (∀ τ ∈ S, ∀ η ∈ S, inner ℝ η (N τ) = inner ℝ τ (N η)) → (∀ τ ∈ S, L τ = g τ • ν₀ + ζ • N τ) → LinearMap.trace ℝ (Euclid P) (S.starProjection.toLinearMap ∘ₗ L.toLinearMap) = ζ * LinearMap.trace ℝ (Euclid P) (S.starProjection.toLinearMap ∘ₗ N.toLinearMap) ∧ ∑ j : Fin P, (‖L (S.starProjection (EuclideanSpace.single j 1)) - S.starProjection (L (S.starProjection (EuclideanSpace.single j 1)))‖ ^ 2 - inner ℝ (S.starProjection (EuclideanSpace.single j 1)) (L (S.starProjection (L (S.starProjection (EuclideanSpace.single j 1)))))) = ∑ j : Fin P, (g (S.starProjection (EuclideanSpace.single j 1))) ^ 2 - ζ ^ 2 * ∑ j : Fin P, ‖N (S.starProjection (EuclideanSpace.single j 1))‖ ^ 2 := by
  intro P S ν₀ N L g ζ hν hνS hNS hNsymm hL
  -- `ν₀ ⊥ S`, so `P_S ν₀ = 0` and `u · ν₀ = 0` for `u ∈ S`
  have hνS' : ∀ v ∈ S, inner ℝ v ν₀ = 0 := fun v hv => by rw [real_inner_comm]; exact hνS v hv
  have hPν : S.starProjection ν₀ = 0 :=
    (Submodule.starProjection_apply_eq_zero_iff S).mpr fun v hv => hνS' v hv
  -- `trace (P_S ∘ R) = trace (P_S ∘ R ∘ P_S) = Σ_j P_S e_j · R (P_S e_j)`
  have htr : ∀ R : Euclid P →L[ℝ] Euclid P,
      LinearMap.trace ℝ (Euclid P) (S.starProjection.toLinearMap ∘ₗ R.toLinearMap) =
        ∑ j : Fin P, inner ℝ (S.starProjection (EuclideanSpace.single j 1))
          (R (S.starProjection (EuclideanSpace.single j 1))) := by
    intro R
    have hPP : S.starProjection.toLinearMap ∘ₗ R.toLinearMap =
        S.starProjection.toLinearMap ∘ₗ (S.starProjection.toLinearMap ∘ₗ R.toLinearMap) := by
      ext x
      simp [Submodule.starProjection_eq_self_iff.mpr (S.starProjection_apply_mem (R x))]
    rw [hPP, LinearMap.trace_comp_comm',
      LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin P) ℝ)]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [EuclideanSpace.basisFun_apply]
    simp only [LinearMap.coe_comp, ContinuousLinearMap.coe_coe, Function.comp_apply]
    rw [← Submodule.inner_starProjection_left_eq_right]
  refine ⟨?_, ?_⟩
  · -- `u_j · L u_j = g(u_j) (u_j · ν₀) + ζ (u_j · N u_j) = ζ (u_j · N u_j)`
    rw [htr L, htr N, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hu : S.starProjection (EuclideanSpace.single j 1) ∈ S := S.starProjection_apply_mem _
    rw [hL _ hu, inner_add_right, real_inner_smul_right, real_inner_smul_right, hνS' _ hu]
    ring
  · rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hu : S.starProjection (EuclideanSpace.single j 1) ∈ S := S.starProjection_apply_mem _
    have hNu := hNS _ hu
    -- normal part: `P_S L u_j = ζ N u_j`, so `L u_j - P_S L u_j = g(u_j) ν₀`
    have hPL : S.starProjection (L (S.starProjection (EuclideanSpace.single j 1))) =
        ζ • N (S.starProjection (EuclideanSpace.single j 1)) := by
      rw [hL _ hu, map_add, map_smul, map_smul, hPν, smul_zero, zero_add,
        Submodule.starProjection_eq_self_iff.mpr hNu]
    have hnorm : ‖L (S.starProjection (EuclideanSpace.single j 1)) -
        S.starProjection (L (S.starProjection (EuclideanSpace.single j 1)))‖ ^ 2 =
        (g (S.starProjection (EuclideanSpace.single j 1))) ^ 2 := by
      rw [hPL, hL _ hu, add_sub_cancel_right, norm_smul, hν, mul_one, Real.norm_eq_abs, sq_abs]
    -- tangential part: `u_j · L (ζ N u_j) = ζ² u_j · N (N u_j) = ζ² |N u_j|²`
    have hinner : inner ℝ (S.starProjection (EuclideanSpace.single j 1))
        (L (S.starProjection (L (S.starProjection (EuclideanSpace.single j 1))))) =
        ζ ^ 2 * ‖N (S.starProjection (EuclideanSpace.single j 1))‖ ^ 2 := by
      rw [hPL, map_smul, hL _ hNu, inner_smul_right, inner_add_right, real_inner_smul_right,
        real_inner_smul_right, hνS' _ hu, hNsymm _ hNu _ hu, real_inner_self_eq_norm_sq]
      ring
    rw [hnorm, hinner]
/-- **A minimum of the area at `t = 0` forces a nonnegative second variation** (Simon,
Appendix B, before B.1: `d²/dt² Hⁿ(M_t)|_{t=0} ≥ 0` because `Hⁿ(M_t)` is minimal at `t = 0`;
abstract form, with `Hⁿ(M_t) = ∫ J_t dHⁿ` as in Ch. 2, §5).  Let `μ(E) < ∞` and `|q| ≤ B` on
`E`, and for `|t| < t₀` let `μ(E) ≤ ∫⁻_E J_t dμ` and `J_t ≤ 1 + (t²/2) q + C|t|³` on `E`.  Then
`∫_E q dμ ≥ 0`.  For small `0 < t < t₀` the bound `f_t = 1 + (t²/2) q + Ct³` is nonnegative on
`E`, so `μ(E) ≤ ∫_E f_t dμ = μ(E) + (t²/2) ∫_E q dμ + Ct³μ(E)`, i.e. `∫_E q dμ + 2Ctμ(E) ≥ 0`;
if `∫_E q dμ < 0`, a small enough `t` contradicts this. -/
theorem Submission.codim1_hcp_stab_second_variation_nonneg : ∀ (P : ℕ) (μ : Measure (Euclid P)) (E : Set (Euclid P)) (J : ℝ → Euclid P → ℝ) (q : Euclid P → ℝ) (B C t₀ : ℝ), MeasurableSet E → μ E ≠ ∞ → 0 < t₀ → AEStronglyMeasurable q (μ.restrict E) → (∀ x ∈ E, |q x| ≤ B) → (∀ t : ℝ, |t| < t₀ → μ E ≤ ∫⁻ x in E, ENNReal.ofReal (J t x) ∂μ) → (∀ t : ℝ, |t| < t₀ → ∀ x ∈ E, J t x ≤ 1 + t ^ 2 / 2 * q x + C * |t| ^ 3) → 0 ≤ ∫ x in E, q x ∂μ := by
  intro P μ E J q B C t₀ hE hμE ht₀ hq hqB hJ hJle
  -- step 1: `q` is integrable on `E`, being bounded by `B` there with `μ(E) < ∞`
  have : IsFiniteMeasure (μ.restrict E) := isFiniteMeasure_restrict.2 hμE
  have hqi : Integrable q (μ.restrict E) :=
    (integrable_const B).mono' hq (ae_restrict_of_forall_mem hE fun x hx => by
      rw [Real.norm_eq_abs]; exact hqB x hx)
  obtain ⟨m, hm_def⟩ : ∃ m : ℝ, μ.real E = m := ⟨_, rfl⟩
  obtain ⟨I, hI_def⟩ : ∃ I : ℝ, ∫ x in E, q x ∂μ = I := ⟨_, rfl⟩
  have hm : 0 ≤ m := hm_def ▸ measureReal_nonneg
  rw [hI_def]
  -- steps 3–5: for `0 < t < t₀` with `t (|B| + |C| + 1) ≤ 1`, comparing the area with the
  -- integral of the second-order bound `f = 1 + (t² / 2) q + C |t|³` gives `0 ≤ I + 2 C t m`
  have key : ∀ t : ℝ, 0 < t → t < t₀ → t * (|B| + |C| + 1) ≤ 1 → 0 ≤ I + 2 * C * t * m := by
    intro t ht htt₀ htK
    have hat : |t| = t := abs_of_pos ht
    have htt₀' : |t| < t₀ := by rw [hat]; exact htt₀
    have ht1 : t ≤ 1 := by
      nlinarith [mul_nonneg ht.le (abs_nonneg B), mul_nonneg ht.le (abs_nonneg C)]
    -- `f ≥ 1 - t (|B| + |C|) ≥ t > 0` on `E`
    have hf_nonneg : ∀ x ∈ E, 0 ≤ 1 + t ^ 2 / 2 * q x + C * |t| ^ 3 := by
      intro x hx
      rw [hat]
      have hqx := abs_le.mp (hqB x hx)
      have hB0 : 0 ≤ B := (abs_nonneg _).trans (hqB x hx)
      have ht2 : t ^ 2 ≤ t := pow_le_of_le_one ht.le ht1 (by norm_num)
      have ht3 : t ^ 3 ≤ t := pow_le_of_le_one ht.le ht1 (by norm_num)
      have h1 : t ^ 2 / 2 * (-B) ≤ t ^ 2 / 2 * q x :=
        mul_le_mul_of_nonneg_left hqx.1 (by positivity)
      have h2 : t ^ 2 / 2 * B ≤ t * B :=
        mul_le_mul_of_nonneg_right (by nlinarith [sq_nonneg t]) hB0
      have h3 : t * B ≤ t * |B| := mul_le_mul_of_nonneg_left (le_abs_self B) ht.le
      have h4 : -|C| * t ^ 3 ≤ C * t ^ 3 :=
        mul_le_mul_of_nonneg_right (neg_abs_le C) (by positivity)
      have h5 : |C| * t ^ 3 ≤ |C| * t := mul_le_mul_of_nonneg_left ht3 (abs_nonneg C)
      nlinarith
    -- `f` is integrable on `E`, with `∫_E f = m + (t² / 2) I + C |t|³ m`
    have hf1 : Integrable (fun x => 1 + t ^ 2 / 2 * q x) (μ.restrict E) :=
      (integrable_const 1).add (hqi.const_mul (t ^ 2 / 2))
    have hf2 : Integrable (fun _ : Euclid P => C * |t| ^ 3) (μ.restrict E) := integrable_const _
    have hfi : Integrable (fun x => 1 + t ^ 2 / 2 * q x + C * |t| ^ 3) (μ.restrict E) :=
      hf1.add hf2
    have hf_int : ∫ x in E, (1 + t ^ 2 / 2 * q x + C * |t| ^ 3) ∂μ =
        m + t ^ 2 / 2 * I + C * |t| ^ 3 * m := by
      rw [integral_add hf1 hf2, integral_add (integrable_const 1) (hqi.const_mul (t ^ 2 / 2)),
        integral_const_mul, setIntegral_const, setIntegral_const, smul_eq_mul, smul_eq_mul,
        hm_def, hI_def]
      ring
    -- area comparison: `μ(E) ≤ ∫⁻_E ofReal J_t ≤ ∫⁻_E ofReal f = ofReal (∫_E f)`
    have hle : μ E ≤ ENNReal.ofReal (m + t ^ 2 / 2 * I + C * |t| ^ 3 * m) := by
      calc μ E ≤ ∫⁻ x in E, ENNReal.ofReal (J t x) ∂μ := hJ t htt₀'
        _ ≤ ∫⁻ x in E, ENNReal.ofReal (1 + t ^ 2 / 2 * q x + C * |t| ^ 3) ∂μ :=
          setLIntegral_mono' hE fun x hx => ENNReal.ofReal_le_ofReal (hJle t htt₀' x hx)
        _ = ENNReal.ofReal (∫ x in E, (1 + t ^ 2 / 2 * q x + C * |t| ^ 3) ∂μ) :=
          (ofReal_integral_eq_lintegral_ofReal hfi (ae_restrict_of_forall_mem hE hf_nonneg)).symm
        _ = ENNReal.ofReal (m + t ^ 2 / 2 * I + C * |t| ^ 3 * m) := by rw [hf_int]
    have hval : 0 ≤ m + t ^ 2 / 2 * I + C * |t| ^ 3 * m := by
      rw [← hf_int]; exact setIntegral_nonneg hE hf_nonneg
    have hmle : m ≤ m + t ^ 2 / 2 * I + C * |t| ^ 3 * m :=
      calc m = μ.real E := hm_def.symm
        _ ≤ _ := ENNReal.toReal_le_of_le_ofReal hval hle
    rw [hat] at hmle
    have h' : 0 ≤ t ^ 2 / 2 * (I + 2 * C * t * m) := by nlinarith
    exact (mul_nonneg_iff_of_pos_left (by positivity)).mp h'
  -- step 6: if `I < 0`, then `t = min (t₀ / 2, 1 / (|B| + |C| + 1), -I / (4 (|C| + 1) (m + 1)))`
  -- gives `0 ≤ I + 2 C t m ≤ I / 2 < 0`
  by_contra hI
  replace hI : I < 0 := not_le.mp hI
  have hK : 0 < |B| + |C| + 1 := by positivity
  have hL : 0 < 4 * (|C| + 1) * (m + 1) := by positivity
  obtain ⟨t, ht_def⟩ : ∃ t : ℝ,
      t = min (min (t₀ / 2) (1 / (|B| + |C| + 1))) (-I / (4 * (|C| + 1) * (m + 1))) := ⟨_, rfl⟩
  have ht_pos : 0 < t := by
    rw [ht_def]
    exact lt_min (lt_min (by linarith) (by positivity)) (div_pos (by linarith) hL)
  have ht_t₀ : t < t₀ := by
    rw [ht_def]
    exact (min_le_left _ _).trans_lt ((min_le_left _ _).trans_lt (by linarith))
  have ht_K : t * (|B| + |C| + 1) ≤ 1 := by
    have : t ≤ 1 / (|B| + |C| + 1) := by
      rw [ht_def]; exact (min_le_left _ _).trans (min_le_right _ _)
    rwa [le_div_iff₀ hK] at this
  have ht_I : t * (4 * (|C| + 1) * (m + 1)) ≤ -I := by
    have : t ≤ -I / (4 * (|C| + 1) * (m + 1)) := by
      rw [ht_def]; exact min_le_right _ _
    rwa [le_div_iff₀ hL] at this
  have hkey := key t ht_pos ht_t₀ ht_K
  have h1 : C * t * m ≤ |C| * t * m :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self C) ht_pos.le) hm
  have h2 : |C| * t * m ≤ (|C| + 1) * (m + 1) * t := by
    nlinarith [mul_nonneg (abs_nonneg C) ht_pos.le, mul_nonneg hm ht_pos.le]
  nlinarith
/-- Small perturbations of the identity (Simon Ch. 2, §5, 5.1–5.2; step (1c) of the stability
proof for Appendix B.1).  Let `Z : ℝᴾ → ℝᴾ` be `C¹` with `‖DZ(x)‖ ≤ Λ` everywhere and `|t|Λ < 1`.
Then `Φ(x) = x + tZ(x)` has derivative `DΦ(x) = I + tDZ(x)`.  By the mean value inequality
`|Z(b) − Z(a)| ≤ Λ|b − a|`, so `Φ(a) = Φ(b)` gives `|a − b| = |t||Z(b) − Z(a)| ≤ |t|Λ|a − b|`,
forcing `a = b`.  Likewise `(I + tDZ(x))u = 0` gives `|u| ≤ |t|‖DZ(x)‖|u| ≤ |t|Λ|u|`, forcing
`u = 0`, so `DΦ(x)` is injective. -/
theorem Submission.codim1_hcp_stab_perturbation_injective : ∀ (P : ℕ) (Z : Euclid P → Euclid P) (Λ t : ℝ), ContDiff ℝ 1 Z → (∀ x, ‖fderiv ℝ Z x‖ ≤ Λ) → |t| * Λ < 1 → Injective (fun x => x + t • Z x) ∧ (∀ x, fderiv ℝ (fun x => x + t • Z x) x = ContinuousLinearMap.id ℝ (Euclid P) + t • fderiv ℝ Z x) ∧ ∀ x, Injective (fderiv ℝ (fun x => x + t • Z x) x) := by
  intro P Z Λ t hZ hDZ htΛ
  -- `Z` is `C¹`, hence differentiable everywhere
  have hZd : Differentiable ℝ Z := hZ.differentiable one_ne_zero
  -- step 1: `DΦ(x) = I + t DZ(x)` by the sum and constant-multiple rules
  have hderiv : ∀ x, fderiv ℝ (fun x => x + t • Z x) x =
      ContinuousLinearMap.id ℝ (Euclid P) + t • fderiv ℝ Z x := fun x =>
    ((hasFDerivAt_id x).fun_add ((hZd x).hasFDerivAt.fun_const_smul t)).fderiv
  -- step 2: mean value inequality on the convex set `ℝᴾ`, `|Z b - Z a| ≤ Λ |b - a|`
  have hlip : ∀ a b, ‖Z b - Z a‖ ≤ Λ * ‖b - a‖ := fun a b =>
    convex_univ.norm_image_sub_le_of_norm_fderiv_le (fun x _ => hZd x) (fun x _ => hDZ x)
      (mem_univ a) (mem_univ b)
  refine ⟨fun a b hab => ?_, hderiv, fun x => ?_⟩
  · -- step 3: `Φ a = Φ b` gives `a - b = t (Z b - Z a)`, so `|a - b| ≤ |t| Λ |a - b|`
    have h1 : a - b = t • (Z b - Z a) := by
      rw [smul_sub, sub_eq_sub_iff_add_eq_add, add_comm (t • Z b)]
      exact hab
    have h2 : ‖a - b‖ ≤ (|t| * Λ) * ‖a - b‖ :=
      calc ‖a - b‖ = |t| * ‖Z b - Z a‖ := by rw [h1, norm_smul, Real.norm_eq_abs]
        _ ≤ |t| * (Λ * ‖b - a‖) := mul_le_mul_of_nonneg_left (hlip a b) (abs_nonneg t)
        _ = (|t| * Λ) * ‖a - b‖ := by rw [norm_sub_rev b a, mul_assoc]
    -- if `a ≠ b`, dividing by `|a - b| > 0` gives `1 ≤ |t| Λ`
    by_contra hne
    have hpos : 0 < ‖a - b‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne)
    have : 1 ≤ |t| * Λ := le_of_mul_le_mul_right (by rwa [one_mul]) hpos
    linarith
  · -- step 4: `DΦ(x) = I + t DZ(x)` is linear, so it suffices that its kernel is trivial
    rw [hderiv x]
    refine (injective_iff_map_eq_zero _).mpr fun u hu => ?_
    -- `(I + t DZ(x)) u = 0` gives `u = -t DZ(x) u`, so `|u| ≤ |t| ‖DZ(x)‖ |u| ≤ |t| Λ |u|`
    have h1 : u = -(t • fderiv ℝ Z x u) := eq_neg_of_add_eq_zero_left hu
    have h2 : ‖u‖ ≤ (|t| * Λ) * ‖u‖ :=
      calc ‖u‖ = |t| * ‖fderiv ℝ Z x u‖ := by
            conv_lhs => rw [h1]
            rw [norm_neg, norm_smul, Real.norm_eq_abs]
        _ ≤ |t| * (‖fderiv ℝ Z x‖ * ‖u‖) :=
            mul_le_mul_of_nonneg_left ((fderiv ℝ Z x).le_opNorm u) (abs_nonneg t)
        _ ≤ |t| * (Λ * ‖u‖) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (hDZ x) (norm_nonneg u))
              (abs_nonneg t)
        _ = (|t| * Λ) * ‖u‖ := (mul_assoc _ _ _).symm
    -- if `u ≠ 0`, dividing by `|u| > 0` gives `1 ≤ |t| Λ`
    by_contra hne
    have hpos : 0 < ‖u‖ := norm_pos_iff.mpr hne
    have : 1 ≤ |t| * Λ := le_of_mul_le_mul_right (by rwa [one_mul]) hpos
    linarith

/-- **Simon, Appendix B, (B.1)**, the stability inequality for smooth `ζ`.  `M ⊆ A₀` is a smooth
`m`-dimensional hypersurface of the `(m + 1)`-plane `A₀` with unit normal `ν`, zero mean curvature
`trace(P_x ∘ Dν(x)) = 0`, and area not decreased by the deformations `x ↦ x + tZ(x)`; then
`∫_M |A|²ζ² ≤ ∫_M |∇^M ζ|²`, `|A|²(x) = Σⱼ |Dν(x)P_xeⱼ|²`, `|∇^M ζ|²(x) = Σⱼ (Dζ(x)P_xeⱼ)²`.
Take `Z = ζν` on `M`, compactly supported in `U`.  On `T_xM`, `DZ = (Dζ)ν + ζDν`, so
`trace(P_x ∘ DZ(x)) = ζ(x) trace(P_x ∘ Dν(x)) = 0`, and the Jacobian `J_t` of `Φ_t = id + tZ`
along `T_xM` satisfies `J_t ≤ 1 + (t²/2)q + C|t|³` with `q = |∇^M ζ|² − |A|²ζ²`.  On
`E = M ∩ spt Z`, minimality and the area formula give `Hᵐ(E) ≤ Hᵐ(Φ_t(E)) ≤ ∫_E J_t` for small
`|t|`, so `∫_E q ≥ 0`; and `q = 0` on `M \ E`. -/
theorem Submission.codim1_hcp_stab_smooth_case : ∀ (P m : ℕ) (U : Set (Euclid P)) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), IsOpen U → M ⊆ U → Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → MeasurableSet M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ x ∈ M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap) = 0) → (∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z → tsupport Z ⊆ U → ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → μHE[m] (M ∩ tsupport Z) ≤ μHE[m] ((fun x => x + t • Z x) '' (M ∩ tsupport Z))) → (∀ (E : Set (Euclid P)) (Φ : Euclid P → Euclid P), MeasurableSet E → E ⊆ M → ContDiff ℝ 1 Φ → InjOn Φ E → (∀ x ∈ E, Injective (fderiv ℝ Φ x)) → μHE[m] (Φ '' E) ≤ ∫⁻ x in E, ENNReal.ofReal (Real.sqrt ((((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L ((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det)) ∂μHE[m]) → ∀ ζ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∫ x in M, (∑ j : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))‖ ^ 2) * ζ x ^ 2 ∂μHE[m] ≤ ∫ x in M, ∑ j : Fin P, (fderiv ℝ ζ x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2 ∂μHE[m] := by
  intro P m U A₀ M ν hU hMU hA₀ hMA hM hMeas hfin hO hν htr hdef hArea ζ hζ hζc hC
  obtain ⟨O, hOo, hMO, hνO⟩ := hO
  obtain ⟨C', hC'c, hC'M, hζC'⟩ := hC
  have h1top : (1 : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := WithTop.coe_le_coe.mpr le_top
  -- `f₁ = Σⱼ (Dζ(x) P_x eⱼ)² = |∇^M ζ|²` and `g₂ = (Σⱼ |Dν(x) P_x eⱼ|²) ζ² = |A|² ζ²`
  obtain ⟨f₁, hf₁⟩ : ∃ f : Euclid P → ℝ, ∀ x, f x = ∑ j : Fin P,
      (fderiv ℝ ζ x ((Submodule.span ℝ (tangentSpace M x)).starProjection
        (EuclideanSpace.single j 1))) ^ 2 := ⟨_, fun _ => rfl⟩
  obtain ⟨g₂, hg₂⟩ : ∃ g : Euclid P → ℝ, ∀ x, g x = (∑ j : Fin P,
      ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection
        (EuclideanSpace.single j 1))‖ ^ 2) * ζ x ^ 2 := ⟨_, fun _ => rfl⟩
  -- step 1: the variation field `Z = ζν` on `M`
  obtain ⟨Z, hZ, hZc, hZU, -, hDZ, hZout⟩ := Submission.codim1_hcp_stab_variation_field P U O M C'
    ν ζ hU hOo hMU hMO hνO (fun x hx => (hν x hx).2.1) hζ hC'c hC'M hζC'
  -- step 2: `‖DZ‖ ≤ Λ`, the constant `C₀` of the Jacobian bound, and the time `t₀`
  have hZ1 : ContDiff ℝ 1 Z := hZ.of_le h1top
  obtain ⟨Λ, hΛ⟩ := (hZ1.continuous_fderiv one_ne_zero).bounded_above_of_compact_support
    (hZc.fderiv (𝕜 := ℝ))
  obtain ⟨C₀, hC₀⟩ := Submission.codim1_hcp_stab_jacobian_bound P Λ
  obtain ⟨t₀, ht₀, hdefZ⟩ := hdef Z hZ hZc hZU
  -- step 3: `x ↦ P_x u` is continuous on `M`, `Dν(x)` is a symmetric endomorphism of `T_xM`
  have hPcont : ∀ u : Euclid P,
      ContinuousOn (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection u) M :=
    (Submission.codim1_hcp_stab_tangent_projection P m A₀ M ν hA₀ hMA (hM 1) hν).2
      (hνO.continuousOn.mono hMO)
  have hshape := Submission.codim1_hcp_stab_shape_operator P m A₀ M O ν hA₀ hMA (hM 2) hOo hMO
    (hνO.of_le h1top) hν
  have hνD : ContinuousOn (fderiv ℝ ν) O := hνO.continuousOn_fderiv_of_isOpen hOo h1top
  have hζD : Continuous (fderiv ℝ ζ) := (hζ.of_le h1top).continuous_fderiv one_ne_zero
  -- step 4: the second-order bound for the Jacobian of `id + tDZ(x)` along `T_xM`, `x ∈ M`
  have hpt : ∀ x ∈ M, ∀ t : ℝ, |t| ≤ 1 →
      Real.sqrt ((((ContinuousLinearMap.id ℝ (Euclid P) + t • fderiv ℝ Z x).comp
        (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L
        ((ContinuousLinearMap.id ℝ (Euclid P) + t • fderiv ℝ Z x).comp
          (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det) ≤
        1 + t ^ 2 / 2 * (f₁ x - g₂ x) + C₀ * |t| ^ 3 := by
    intro x hx t ht
    obtain ⟨-, hνn, hνT⟩ := hν x hx
    -- `ν(x) ⊥ T_xM` extends to the span
    have hνS : ∀ v ∈ Submodule.span ℝ (tangentSpace M x), inner ℝ (ν x) v = 0 := by
      have hle : Submodule.span ℝ (tangentSpace M x) ≤ (ℝ ∙ ν x)ᗮ := Submodule.span_le.mpr
        fun w hw => Submodule.mem_orthogonal_singleton_iff_inner_right.mpr (hνT w hw)
      exact fun v hv => Submodule.mem_orthogonal_singleton_iff_inner_right.mp (hle hv)
    obtain ⟨htrZ, hQ⟩ := Submission.codim1_hcp_stab_normal_variation_algebra P
      (Submodule.span ℝ (tangentSpace M x)) (ν x) (fderiv ℝ ν x) (fderiv ℝ Z x) (fderiv ℝ ζ x)
      (ζ x) hνn hνS (fun τ hτ => (hshape x hx τ hτ).1)
      (fun τ hτ η hη => (hshape x hx τ hτ).2 η hη) (hDZ x hx)
    have htr0 : LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ Z x).toLinearMap) = 0 := by
      rw [htrZ, htr x hx, mul_zero]
    have h := hC₀ (Submodule.span ℝ (tangentSpace M x)) (fderiv ℝ Z x) (hΛ x) htr0 t ht
    rw [hQ] at h
    exact h.trans_eq (by rw [hf₁, hg₂]; ring)
  -- step 5: `E = M ∩ spt Z` is measurable with `Hᵐ(E) < ∞`; for `|t| < t₁`, `|t| < t₀`,
  -- `|t| ≤ 1` and `|t|Λ < 1`
  have hEmeas : MeasurableSet (M ∩ tsupport Z) := hMeas.inter (isClosed_tsupport Z).measurableSet
  have hEfin : μHE[m] (M ∩ tsupport Z) ≠ ∞ := hfin (tsupport Z) hZc hZU
  have hΛ0 : 0 ≤ Λ := (norm_nonneg _).trans (hΛ 0)
  obtain ⟨t₁, ht₁pos, ht₁⟩ : ∃ t₁ : ℝ, 0 < t₁ ∧
      ∀ t : ℝ, |t| < t₁ → |t| < t₀ ∧ |t| ≤ 1 ∧ |t| * Λ < 1 := by
    refine ⟨min (min t₀ 1) (1 / (Λ + 1)), lt_min (lt_min ht₀ one_pos) (by positivity),
      fun t ht => ?_⟩
    have h1 : |t| < min t₀ 1 := ht.trans_le (min_le_left _ _)
    have h2 : |t| < 1 / (Λ + 1) := ht.trans_le (min_le_right _ _)
    rw [lt_div_iff₀ (by linarith)] at h2
    refine ⟨h1.trans_le (min_le_left _ _), (h1.trans_le (min_le_right _ _)).le, ?_⟩
    nlinarith [abs_nonneg t]
  -- step 6: `Hᵐ(E) ≤ Hᵐ(Φ_t(E)) ≤ ∫_E J_t` and `J_t ≤ 1 + (t²/2)q + C₀|t|³` on `E`
  have harea : ∀ t : ℝ, |t| < t₁ → μHE[m] (M ∩ tsupport Z) ≤ ∫⁻ x in M ∩ tsupport Z,
      ENNReal.ofReal (Real.sqrt ((((fderiv ℝ (fun y => y + t • Z y) x).comp
        (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L
        ((fderiv ℝ (fun y => y + t • Z y) x).comp
          (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det)) ∂μHE[m] := by
    intro t ht
    obtain ⟨ht0, -, htΛ⟩ := ht₁ t ht
    obtain ⟨hinj, -, hDinj⟩ :=
      Submission.codim1_hcp_stab_perturbation_injective P Z Λ t hZ1 hΛ htΛ
    exact (hdefZ t ht0).trans (hArea (M ∩ tsupport Z) (fun y => y + t • Z y) hEmeas
      inter_subset_left (contDiff_id.add (hZ1.const_smul t)) hinj.injOn fun x _ => hDinj x)
  have hJ : ∀ t : ℝ, |t| < t₁ → ∀ x ∈ M ∩ tsupport Z,
      Real.sqrt ((((fderiv ℝ (fun y => y + t • Z y) x).comp
        (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L
        ((fderiv ℝ (fun y => y + t • Z y) x).comp
          (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det) ≤
        1 + t ^ 2 / 2 * (f₁ x - g₂ x) + C₀ * |t| ^ 3 := by
    intro t ht x hx
    obtain ⟨-, ht1, htΛ⟩ := ht₁ t ht
    obtain ⟨-, hD, -⟩ := Submission.codim1_hcp_stab_perturbation_injective P Z Λ t hZ1 hΛ htΛ
    rw [hD x]
    exact hpt x hx.1 t ht1
  -- step 7: `f₁`, `g₂` are continuous on `M`; `0 ≤ f₁ ≤ P B₁²` and `|g₂| ≤ P B₃² B₂²` on `M`
  have hf₁cont : ContinuousOn f₁ M :=
    (continuousOn_finsetSum _ fun j _ => (hζD.continuousOn.clm_apply (hPcont _)).pow 2).congr
      fun x _ => hf₁ x
  have hg₂cont : ContinuousOn g₂ M :=
    ((continuousOn_finsetSum _ fun j _ => ((hνD.mono hMO).clm_apply (hPcont _)).norm.pow 2).mul
      (hζ.continuous.continuousOn.pow 2)).congr fun x _ => hg₂ x
  have hopbd : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (L : Euclid P →L[ℝ] F)
      (B : ℝ) (u : Euclid P), ‖L‖ ≤ B → ‖u‖ ≤ 1 → ‖L u‖ ^ 2 ≤ B ^ 2 := by
    intro F _ _ L B u hL hu
    exact pow_le_pow_left₀ (norm_nonneg _)
      ((L.le_opNorm u).trans ((mul_le_of_le_one_right (norm_nonneg _) hu).trans hL)) 2
  have hPe : ∀ x (j : Fin P),
      ‖(Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)‖ ≤ 1 :=
    fun x j => ((Submodule.span ℝ (tangentSpace M x)).norm_starProjection_apply_le _).trans
      (by simp)
  obtain ⟨B₁, hB₁⟩ := hζD.bounded_above_of_compact_support (hζc.fderiv (𝕜 := ℝ))
  obtain ⟨B₂, hB₂⟩ := hζ.continuous.bounded_above_of_compact_support hζc
  obtain ⟨B₃, hB₃⟩ := hC'c.exists_bound_of_continuousOn (hνD.mono (hC'M.trans hMO))
  have hf₁nn : ∀ x, 0 ≤ f₁ x := fun x => by rw [hf₁]; positivity
  have hf₁bd : ∀ x, f₁ x ≤ P * B₁ ^ 2 := by
    intro x
    rw [hf₁]
    calc _ ≤ ∑ _j : Fin P, B₁ ^ 2 := Finset.sum_le_sum fun j _ => by
          simpa [Real.norm_eq_abs, sq_abs] using hopbd (fderiv ℝ ζ x) B₁ _ (hB₁ x) (hPe x j)
      _ = P * B₁ ^ 2 := by simp
  have hg₂bd : ∀ x ∈ M, |g₂ x| ≤ P * B₃ ^ 2 * B₂ ^ 2 := by
    intro x hx
    rw [hg₂]
    by_cases hxC : x ∈ C'
    · have ha : ∑ j : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection
          (EuclideanSpace.single j 1))‖ ^ 2 ≤ P * B₃ ^ 2 := by
        calc _ ≤ ∑ _j : Fin P, B₃ ^ 2 := Finset.sum_le_sum fun j _ =>
              hopbd (fderiv ℝ ν x) B₃ _ (hB₃ x hxC) (hPe x j)
          _ = P * B₃ ^ 2 := by simp
      have hz : ζ x ^ 2 ≤ B₂ ^ 2 := by
        simpa [Real.norm_eq_abs, sq_abs] using pow_le_pow_left₀ (norm_nonneg (ζ x)) (hB₂ x) 2
      rw [abs_of_nonneg (by positivity)]
      exact mul_le_mul ha hz (sq_nonneg _) (by positivity)
    · -- off `C'`, `ζ = 0`
      rw [hζC' x hx hxC, zero_pow two_ne_zero, mul_zero, abs_zero]
      positivity
  have hq_bd : ∀ x ∈ M ∩ tsupport Z, |f₁ x - g₂ x| ≤ P * B₁ ^ 2 + P * B₃ ^ 2 * B₂ ^ 2 := by
    intro x hx
    have h1 := hf₁nn x
    have h2 := hf₁bd x
    have h3 := abs_le.mp (hg₂bd x hx.1)
    rw [abs_le]
    constructor <;> linarith [h3.1, h3.2]
  have hf₁meas : AEStronglyMeasurable f₁ (μHE[m].restrict (M ∩ tsupport Z)) :=
    (hf₁cont.mono inter_subset_left).aestronglyMeasurable hEmeas
  have hg₂meas : AEStronglyMeasurable g₂ (μHE[m].restrict (M ∩ tsupport Z)) :=
    (hg₂cont.mono inter_subset_left).aestronglyMeasurable hEmeas
  -- step 8: the second variation is nonnegative, `∫_E q ≥ 0`
  have hE : 0 ≤ ∫ x in M ∩ tsupport Z, (f₁ x - g₂ x) ∂μHE[m] :=
    Submission.codim1_hcp_stab_second_variation_nonneg P μHE[m] (M ∩ tsupport Z)
      (fun t x => Real.sqrt ((((fderiv ℝ (fun y => y + t • Z y) x).comp
        (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L
        ((fderiv ℝ (fun y => y + t • Z y) x).comp
          (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det))
      (fun x => f₁ x - g₂ x) (P * B₁ ^ 2 + P * B₃ ^ 2 * B₂ ^ 2) C₀ t₁ hEmeas hEfin ht₁pos
      (hf₁meas.sub hg₂meas) hq_bd harea hJ
  -- step 9: `f₁ = g₂ = 0` on `M \ E`, since `ζ` and `Dζ` on `T_xM` vanish off `spt Z`
  have hout : ∀ x ∈ M \ (M ∩ tsupport Z), f₁ x = 0 ∧ g₂ x = 0 := by
    rintro x ⟨hxM, hxE⟩
    obtain ⟨hζ0, hDζ0⟩ := hZout x hxM fun h => hxE ⟨hxM, h⟩
    refine ⟨?_, by rw [hg₂, hζ0, zero_pow two_ne_zero, mul_zero]⟩
    rw [hf₁]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [hDζ0 _ ((Submodule.span ℝ (tangentSpace M x)).starProjection_apply_mem _),
      zero_pow two_ne_zero]
  -- step 10: `∫_M g₂ = ∫_E g₂ ≤ ∫_E f₁ = ∫_M f₁`
  have hf₁int : IntegrableOn f₁ (M ∩ tsupport Z) μHE[m] :=
    IntegrableOn.of_bound hEfin.lt_top hf₁meas (P * B₁ ^ 2) (ae_restrict_of_forall_mem hEmeas
      fun x _ => by rw [Real.norm_eq_abs, abs_of_nonneg (hf₁nn x)]; exact hf₁bd x)
  have hg₂int : IntegrableOn g₂ (M ∩ tsupport Z) μHE[m] :=
    IntegrableOn.of_bound hEfin.lt_top hg₂meas (P * B₃ ^ 2 * B₂ ^ 2) (ae_restrict_of_forall_mem
      hEmeas fun x hx => by rw [Real.norm_eq_abs]; exact hg₂bd x hx.1)
  have key : ∫ x in M, g₂ x ∂μHE[m] ≤ ∫ x in M, f₁ x ∂μHE[m] := by
    rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hMeas inter_subset_left
        fun x hx => (hout x hx).1,
      setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hMeas inter_subset_left
        fun x hx => (hout x hx).2]
    rw [integral_sub hf₁int hg₂int] at hE
    linarith
  simpa only [hf₁, hg₂] using key
/-- Convergence of Dirichlet energies, for an arbitrary measure `μ`: the limit
`∫_M |Dζₖ|² → ∫_M |∇^Mζ|²` that carries the stability inequality (Simon, App. B, B.1) from
smooth `ζₖ` to a locally Lipschitz `ζ`, as when B.1 is applied to the Lipschitz `|A|ζ` (App. B,
(2)).  Write `aₖ = Σⱼ Fₖⱼ²`, `b = Σⱼ Gⱼ²` and `dₖ = Σⱼ (Fₖⱼ − Gⱼ)²`.  Since `∫⁻ dₖ → 0`, `dₖ`
is integrable for all large `k`, and `b ≤ 2aₖ + 2dₖ` makes `b` integrable; also
`∫ dₖ = (∫⁻ dₖ).toReal → 0`.  From `x² − y² = (x − y)² + 2y(x − y)` and
`2|y(x − y)| ≤ εy² + ε⁻¹(x − y)²`, `|aₖ − b| ≤ εb + (1 + ε⁻¹)dₖ` pointwise for every `ε > 0`, so
`|∫ aₖ − ∫ b| ≤ ε ∫ b + (1 + ε⁻¹) ∫ dₖ`, which is small for small `ε` and then large `k`. -/
theorem Submission.codim1_hcp_stab_energy_convergence : ∀ (P : ℕ) (μ : Measure (Euclid P)) (F : ℕ → Fin P → Euclid P → ℝ) (G : Fin P → Euclid P → ℝ), (∀ k j, AEStronglyMeasurable (F k j) μ) → (∀ j, AEStronglyMeasurable (G j) μ) → (∀ k, Integrable (fun x => ∑ j : Fin P, (F k j x) ^ 2) μ) → Tendsto (fun k => ∫⁻ x, ENNReal.ofReal (∑ j : Fin P, (F k j x - G j x) ^ 2) ∂μ) atTop (𝓝 0) → Integrable (fun x => ∑ j : Fin P, (G j x) ^ 2) μ ∧ Tendsto (fun k => ∫ x, ∑ j : Fin P, (F k j x) ^ 2 ∂μ) atTop (𝓝 (∫ x, ∑ j : Fin P, (G j x) ^ 2 ∂μ)) := by
  intro P μ F G hF hG haint hd
  -- `dₖ = Σⱼ (Fₖⱼ − Gⱼ)²` and `b = Σⱼ Gⱼ²` are a.e. strongly measurable, and `dₖ ≥ 0`
  have hdm : ∀ k, AEStronglyMeasurable (fun x => ∑ j : Fin P, (F k j x - G j x) ^ 2) μ :=
    fun k => Finset.aestronglyMeasurable_fun_sum _ fun j _ => ((hF k j).sub (hG j)).pow 2
  have hbm : AEStronglyMeasurable (fun x => ∑ j : Fin P, (G j x) ^ 2) μ :=
    Finset.aestronglyMeasurable_fun_sum _ fun j _ => (hG j).pow 2
  have hd0 : ∀ k, 0 ≤ᵐ[μ] fun x => ∑ j : Fin P, (F k j x - G j x) ^ 2 :=
    fun k => ae_of_all _ fun x => Finset.sum_nonneg fun j _ => sq_nonneg _
  -- `∫⁻ dₖ < ∞`, so `dₖ` is integrable, for all large `k`
  have hdint : ∀ᶠ k in atTop, Integrable (fun x => ∑ j : Fin P, (F k j x - G j x) ^ 2) μ :=
    (hd.eventually_lt_const ENNReal.zero_lt_top).mono fun k hk =>
      ⟨hdm k, (hasFiniteIntegral_iff_ofReal (hd0 k)).2 hk⟩
  -- `b ≤ 2 (aₖ + dₖ)` with `aₖ = Σⱼ Fₖⱼ²`, since `y² ≤ 2x² + 2(x − y)²`; so `b` is integrable
  have hbint : Integrable (fun x => ∑ j : Fin P, (G j x) ^ 2) μ := by
    obtain ⟨k, hk⟩ := hdint.exists
    refine Integrable.mono' (((haint k).add hk).const_mul 2) hbm (ae_of_all _ fun x => ?_)
    rw [Real.norm_of_nonneg (Finset.sum_nonneg fun j _ => sq_nonneg _), Pi.add_apply,
      ← Finset.sum_add_distrib, Finset.mul_sum]
    exact Finset.sum_le_sum fun j _ => by nlinarith [sq_nonneg (2 * F k j x - G j x)]
  refine ⟨hbint, ?_⟩
  -- `∫ dₖ = (∫⁻ dₖ).toReal → 0`
  have hs : Tendsto (fun k => ∫ x, ∑ j : Fin P, (F k j x - G j x) ^ 2 ∂μ) atTop (𝓝 0) := by
    have h := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hd
    rw [ENNReal.toReal_zero] at h
    exact h.congr fun k => (integral_eq_lintegral_of_nonneg_ae (hd0 k) (hdm k)).symm
  -- `|x² − y²| ≤ εy² + (1 + ε⁻¹)(x − y)²`, from `x² − y² = (x − y)² + 2y(x − y)` and
  -- `ε⁻¹(εy ∓ (x − y))² = εy² ∓ 2y(x − y) + ε⁻¹(x − y)² ≥ 0`
  have hscal : ∀ ε : ℝ, 0 < ε → ∀ x y : ℝ,
      |x ^ 2 - y ^ 2| ≤ ε * y ^ 2 + (1 + ε⁻¹) * (x - y) ^ 2 := by
    intro ε hε x y
    have he : ε⁻¹ * ε = 1 := inv_mul_cancel₀ hε.ne'
    have h1 : ε⁻¹ * (ε * y - (x - y)) ^ 2 = ε * y ^ 2 - 2 * y * (x - y) + ε⁻¹ * (x - y) ^ 2 := by
      linear_combination (ε * y ^ 2 - 2 * y * (x - y)) * he
    have h2 : ε⁻¹ * (ε * y + (x - y)) ^ 2 = ε * y ^ 2 + 2 * y * (x - y) + ε⁻¹ * (x - y) ^ 2 := by
      linear_combination (ε * y ^ 2 + 2 * y * (x - y)) * he
    have h3 := mul_nonneg (inv_nonneg.2 hε.le) (sq_nonneg (ε * y - (x - y)))
    have h4 := mul_nonneg (inv_nonneg.2 hε.le) (sq_nonneg (ε * y + (x - y)))
    rw [abs_le]
    constructor <;> nlinarith [sq_nonneg (x - y)]
  -- given `η > 0`, take `ε > 0` with `ε ∫ b < η / 2` and `k` so large that `dₖ` is integrable and
  -- `(1 + ε⁻¹) ∫ dₖ < η / 2`; then `|∫ aₖ − ∫ b| ≤ ∫ (εb + (1 + ε⁻¹)dₖ) < η`
  rw [Metric.tendsto_atTop]
  intro η hη
  obtain ⟨ε, hε, hεb⟩ := exists_pos_mul_lt (half_pos hη) (∫ x, ∑ j : Fin P, (G j x) ^ 2 ∂μ)
  have hev : ∀ᶠ k in atTop, (1 + ε⁻¹) * ∫ x, ∑ j : Fin P, (F k j x - G j x) ^ 2 ∂μ < η / 2 := by
    have h := hs.const_mul (1 + ε⁻¹)
    rw [mul_zero] at h
    exact h.eventually_lt_const (half_pos hη)
  obtain ⟨K, hK⟩ := eventually_atTop.1 (hev.and hdint)
  refine ⟨K, fun k hk => ?_⟩
  obtain ⟨hk1, hk2⟩ := hK k hk
  rw [Real.dist_eq, ← integral_sub (haint k) hbint, ← Real.norm_eq_abs]
  calc ‖∫ x, (∑ j : Fin P, (F k j x) ^ 2) - ∑ j : Fin P, (G j x) ^ 2 ∂μ‖
      ≤ ∫ x, ε * ∑ j : Fin P, (G j x) ^ 2 + (1 + ε⁻¹) * ∑ j : Fin P, (F k j x - G j x) ^ 2 ∂μ := by
        refine norm_integral_le_of_norm_le ((hbint.const_mul ε).add (hk2.const_mul _))
          (ae_of_all _ fun x => ?_)
        rw [Real.norm_eq_abs, ← Finset.sum_sub_distrib, Finset.mul_sum, Finset.mul_sum,
          ← Finset.sum_add_distrib]
        exact (Finset.abs_sum_le_sum_abs _ _).trans
          (Finset.sum_le_sum fun j _ => hscal ε hε _ _)
    _ = ε * (∫ x, ∑ j : Fin P, (G j x) ^ 2 ∂μ) +
          (1 + ε⁻¹) * ∫ x, ∑ j : Fin P, (F k j x - G j x) ^ 2 ∂μ := by
        rw [integral_add (hbint.const_mul ε) (hk2.const_mul _), integral_const_mul,
          integral_const_mul]
    _ < η := by linarith

/-- **Density extension of the stability inequality** (Simon B.1, extension from smooth to locally
Lipschitz test functions).  Let `ζ` be locally Lipschitz on `M` and vanish on `M` off a compact
`C ⊆ M`.  By (hApprox)(ii) there are `C^∞` compactly supported `ζₖ`, vanishing on `M` off a
compact `C' ⊆ M`, with `ζₖ → ζ` uniformly on `M` and `∇^M ζₖ → ∇^M ζ` in `L²(Hᵐ⌞M)`.  A tangent
vector at `x ∈ M \ C'` is the velocity of a curve in `M` that avoids the closed set `C'` for small
times, so `Dζₖ(x)` vanishes on `span TₓM` and the smooth energies `∫_M |∇^M ζₖ|²` are integrable;
by energy convergence they tend to `∫_M |∇^M ζ|²`.  Dominated convergence on `C ∪ C'` gives
`∫_M w ζₖ² → ∫_M w ζ²`, and the smooth inequality for each `ζₖ` passes to the limit. -/
theorem Submission.codim1_hcp_stab_lipschitz_extension : ∀ (P m : ℕ) (M : Set (Euclid P)) (w : Euclid P → ℝ), MeasurableSet M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ M → μHE[m] K ≠ ∞) → ContinuousOn w M → (∀ u : Euclid P, ContinuousOn (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection u) M) → ((∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → ∀ j : Fin P, AEStronglyMeasurable (fun x => fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) (μHE[m].restrict M)) ∧ ∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∃ (C' : Set (Euclid P)) (ζs : ℕ → Euclid P → ℝ), IsCompact C' ∧ C' ⊆ M ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ζs k) ∧ HasCompactSupport (ζs k)) ∧ (∀ k, ∀ x ∈ M, x ∉ C' → ζs k x = 0) ∧ TendstoUniformlyOn ζs ζ atTop M ∧ Tendsto (fun k => ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P, (fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) - fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) atTop (𝓝 0)) → (∀ ζ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∫ x in M, w x * ζ x ^ 2 ∂μHE[m] ≤ ∫ x in M, ∑ j : Fin P, (fderiv ℝ ζ x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2 ∂μHE[m]) → ∀ ζ : Euclid P → ℝ, LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∫ x in M, w x * ζ x ^ 2 ∂μHE[m] ≤ ∫ x in M, ∑ j : Fin P, (fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2 ∂μHE[m] := by
  intro P m M w hM hfin hw hP hApprox hSmooth ζ hζ hC
  -- step 1: smooth approximants `ζₖ`, vanishing on `M` off a compact `C' ⊆ M`
  obtain ⟨C', ζs, hC'c, hC'M, hζs, hvan, hunif, hL2⟩ := hApprox.2 ζ hζ hC
  obtain ⟨C, hCc, hCM, -⟩ := hC
  have hζs1 : ∀ k, ContDiff ℝ 1 (ζs k) := fun k => (hζs k).1.of_le (by exact_mod_cast le_top)
  -- step 2: `Dζₖ(x)` vanishes on `span TₓM` for `x ∈ M \ C'`
  have hDvan : ∀ k, ∀ x ∈ M, x ∉ C' → ∀ u : Euclid P,
      fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection u) = 0 := by
    intro k x hxM hxC' u
    have htan : ∀ v ∈ tangentSpace M x, fderiv ℝ (ζs k) x v = 0 := by
      rintro v ⟨γ, -, hγM, hγ0, hγv⟩
      -- `γ(t) ∈ M \ C'` for small `|t|`, so `ζₖ ∘ γ = 0` near `0`
      have hev : (fun t => ζs k (γ t)) =ᶠ[𝓝 0] fun _ => (0 : ℝ) := by
        have hγC' : ∀ᶠ t in 𝓝 (0 : ℝ), γ t ∈ C'ᶜ := hγv.continuousAt.preimage_mem_nhds
          (hC'c.isClosed.isOpen_compl.mem_nhds (by rwa [hγ0]))
        filter_upwards [hγC', Ioo_mem_nhds (show (-1 : ℝ) < 0 by norm_num)
          (show (0 : ℝ) < 1 by norm_num)] with t ht ht'
        exact hvan k (γ t) (hγM ht') ht
      -- chain rule: `(ζₖ ∘ γ)'(0) = Dζₖ(x) v`
      have hd : HasDerivAt (fun t => ζs k (γ t)) (fderiv ℝ (ζs k) x v) 0 := by
        have hfx : HasFDerivAt (ζs k) (fderiv ℝ (ζs k) x) (γ 0) := by
          rw [hγ0]
          exact ((hζs1 k).differentiable one_ne_zero x).hasFDerivAt
        exact hfx.comp_hasDerivAt 0 hγv
      exact hd.unique ((hasDerivAt_const (0 : ℝ) (0 : ℝ)).congr_of_eventuallyEq hev)
    -- by linearity `Dζₖ(x)` vanishes on `span TₓM`, which contains `Pₓu`
    have hle : Submodule.span ℝ (tangentSpace M x) ≤
        LinearMap.ker (fderiv ℝ (ζs k) x : Euclid P →ₗ[ℝ] ℝ) :=
      Submodule.span_le.2 fun v hv => LinearMap.mem_ker.2 (htan v hv)
    exact LinearMap.mem_ker.1 (hle (Submodule.starProjection_apply_mem _ u))
  -- step 3: the smooth energies are integrable on `M` and converge, by energy convergence
  have hFc : ∀ k (j : Fin P), ContinuousOn (fun x => fderiv ℝ (ζs k) x
      ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) M :=
    fun k j => ((hζs1 k).continuous_fderiv one_ne_zero).continuousOn.clm_apply (hP _)
  have hC'fin : μHE[m].restrict M C' ≠ ∞ :=
    ne_top_of_le_ne_top (hfin C' hC'c hC'M) (Measure.restrict_apply_le _ _)
  have hFint : ∀ k, Integrable (fun x => ∑ j : Fin P, (fderiv ℝ (ζs k) x
      ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2)
      (μHE[m].restrict M) := by
    intro k
    have hc : ContinuousOn (fun x => ∑ j : Fin P, (fderiv ℝ (ζs k) x
        ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2)
        M :=
      continuousOn_finsetSum _ fun j _ => (hFc k j).pow 2
    -- bounded on the compact `C'`, zero on `M \ C'`
    obtain ⟨B, hB⟩ := hC'c.exists_bound_of_continuousOn (hc.mono hC'M)
    refine Integrable.mono' ((integrableOn_const (C := B) hC'fin).integrable_indicator
      hC'c.isClosed.measurableSet) (hc.aestronglyMeasurable hM)
      (ae_restrict_of_forall_mem hM fun x hx => ?_)
    by_cases hxC' : x ∈ C'
    · rw [indicator_of_mem hxC']
      exact hB x hxC'
    · rw [indicator_of_notMem hxC']
      simp [hDvan k x hx hxC']
  have hRHS := (Submission.codim1_hcp_stab_energy_convergence P (μHE[m].restrict M)
    (fun k j x => fderiv ℝ (ζs k) x
      ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)))
    (fun j x => fderivWithin ℝ ζ M x
      ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)))
    (fun k j => (hFc k j).aestronglyMeasurable hM) (hApprox.1 ζ hζ) hFint hL2).2
  -- step 4: `∫_M w ζₖ² → ∫_M w ζ²`, by dominated convergence on the compact `C ∪ C'`
  have hKc : IsCompact (C ∪ C') := hCc.union hC'c
  have hKM : C ∪ C' ⊆ M := union_subset hCM hC'M
  have hKfin : μHE[m].restrict M (C ∪ C') ≠ ∞ :=
    ne_top_of_le_ne_top (hfin _ hKc hKM) (Measure.restrict_apply_le _ _)
  obtain ⟨Bw, hBw⟩ := hKc.exists_bound_of_continuousOn (hw.mono hKM)
  obtain ⟨Bz, hBz⟩ := hKc.exists_bound_of_continuousOn (hζ.continuousOn.mono hKM)
  have hLHS : Tendsto (fun k => ∫ x in M, w x * ζs k x ^ 2 ∂μHE[m]) atTop
      (𝓝 (∫ x in M, w x * ζ x ^ 2 ∂μHE[m])) := by
    refine tendsto_integral_filter_of_dominated_convergence
      ((C ∪ C').indicator fun _ => Bw * (Bz + 1) ^ 2)
      (Eventually.of_forall fun k =>
        (hw.mul ((hζs k).1.continuous.continuousOn.pow 2)).aestronglyMeasurable hM) ?_
      ((integrableOn_const (C := Bw * (Bz + 1) ^ 2) hKfin).integrable_indicator
        hKc.isClosed.measurableSet)
      (ae_restrict_of_forall_mem hM fun x hx =>
        tendsto_const_nhds.mul ((hunif.tendsto_at hx).pow 2))
    -- for large `k`, `|ζₖ - ζ| < 1` on `M`; and `ζₖ = 0` on `M \ C'`
    filter_upwards [Metric.tendstoUniformlyOn_iff.1 hunif 1 one_pos] with k hk
    refine ae_restrict_of_forall_mem hM fun x hx => ?_
    by_cases hxK : x ∈ C ∪ C'
    · rw [indicator_of_mem hxK]
      simp only [norm_mul, norm_pow, Real.norm_eq_abs]
      have hwx : |w x| ≤ Bw := by simpa using hBw x hxK
      have hζx : |ζ x| ≤ Bz := by simpa using hBz x hxK
      have hdist := hk x hx
      rw [Real.dist_eq] at hdist
      have hζkx : |ζs k x| ≤ Bz + 1 := by
        have h := abs_sub_abs_le_abs_sub (ζs k x) (ζ x)
        rw [abs_sub_comm] at h
        linarith
      exact mul_le_mul hwx (pow_le_pow_left₀ (abs_nonneg _) hζkx 2) (by positivity)
        ((abs_nonneg _).trans hwx)
    · rw [indicator_of_notMem hxK, hvan k x hx fun h => hxK (Or.inr h)]
      simp
  -- step 5: pass to the limit in the smooth inequality for `ζₖ`
  exact le_of_tendsto_of_tendsto' hLHS hRHS fun k =>
    hSmooth (ζs k) (hζs k).1 (hζs k).2 ⟨C', hC'c, hC'M, hvan k⟩
/-- **Simon B.1 (stability inequality)**: let `M ⊆ A₀ ∩ U` be a smooth embedded hypersurface of
the `(m + 1)`-plane `A₀`, of locally finite `Hᵐ`-measure in `U`, with smooth unit normal `ν` and
zero mean curvature `trace(Pₓ ∘ Dν(x)) = 0`, whose area does not decrease under the deformations
`x ↦ x + tZ(x)`, `Z ∈ C^∞_c(U)`, `|t|` small.  Then `∫_M |A|²ζ² dHᵐ ≤ ∫_M |∇^Mζ|² dHᵐ` for every
`ζ` locally Lipschitz on `M` and vanishing on `M` off a compact subset of `M`.  `M` is Borel, and
`Pₓ = Π_{A₀} − ν(x) ⊗ ν(x)` makes `x ↦ Pₓu`, hence `|A|²`, continuous on `M`.  The second
variation of area along `Z = ζ̃ν` (Simon Ch. 2, 5.4), with `Hᵐ(Φ_t(M ∩ K))` given by the area
formula, proves B.1 for `C^∞` compactly supported `ζ̃`; smooth approximations converging uniformly
on `M`, with gradients converging in `L²(Hᵐ⌞M)`, extend it to locally Lipschitz `ζ`. -/
theorem Submission.codim1_hcp_stability_inequality : ∀ (P m : ℕ) (U : Set (Euclid P)) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), IsOpen U → M ⊆ U → Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ x ∈ M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap) = 0) → (∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z → tsupport Z ⊆ U → ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → μHE[m] (M ∩ tsupport Z) ≤ μHE[m] ((fun x => x + t • Z x) '' (M ∩ tsupport Z))) → ∀ ζ : Euclid P → ℝ, LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∫ x in M, (∑ j : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))‖ ^ 2) * ζ x ^ 2 ∂μHE[m] ≤ ∫ x in M, ∑ j : Fin P, (fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2 ∂μHE[m] := by
  intro P m U A₀ M ν hU hMU hA₀ hMA hM hfin hνO hν htr hmin ζ hζ hC
  -- `M` is Borel
  have hMmeas : MeasurableSet M :=
    (Submission.dimred_rpd_embedded_locally_closed P 1 m M (hM 1)).1
  obtain ⟨O, hO, hMO, hνC⟩ := hνO
  -- `x ↦ Pₓu` is continuous on `M`, since `Pₓu = Π_{A₀}u − (ν(x) · u) ν(x)` there
  have hproj := (Submission.codim1_hcp_stab_tangent_projection P m A₀ M ν hA₀ hMA (hM 1) hν).2
    (hνC.continuousOn.mono hMO)
  -- `Dν` is continuous on the open set `O ⊇ M`, so `|A|²(x) = Σⱼ |Dν(x)(Pₓeⱼ)|²` is continuous
  -- on `M`
  have hDν : ContinuousOn (fderiv ℝ ν) O :=
    hνC.continuousOn_fderiv_of_isOpen hO (by exact_mod_cast le_top)
  have hA : ContinuousOn (fun x => ∑ j : Fin P,
      ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection
        (EuclideanSpace.single j 1))‖ ^ 2) M := by
    refine continuousOn_finsetSum _ fun j _ => ?_
    exact (((hDν.mono hMO).clm_apply (hproj _)).norm).pow 2
  -- compact subsets of `M ⊆ U` have finite `Hᵐ`-measure
  have hfinM : ∀ K : Set (Euclid P), IsCompact K → K ⊆ M → μHE[m] K ≠ ∞ := by
    intro K hK hKM
    have hK' := hfin K hK (hKM.trans hMU)
    rwa [Set.inter_eq_right.2 hKM] at hK'
  -- step 1: B.1 for `C^∞` compactly supported `ζ̃`, the area formula giving `Hᵐ(Φ_t(M ∩ K))`
  have hsmooth := Submission.codim1_hcp_stab_smooth_case P m U A₀ M ν hU hMU hA₀ hMA hM hMmeas
    hfin ⟨O, hO, hMO, hνC⟩ hν htr hmin fun E Φ hE hEM hΦ hinj hDΦ =>
      (Submission.codim1_hcp_submanifold_area_formula P m M E Φ (hM 1) hE hEM hΦ hinj hDΦ).le
  -- step 2: locally Lipschitz `ζ`, through the smooth approximations of lipschitz_approx
  exact Submission.codim1_hcp_stab_lipschitz_extension P m M _ hMmeas hfinM hA hproj
    (Submission.codim1_hcp_lipschitz_smooth_approx P m M (hM 1)) hsmooth ζ hζ hC
/-- **Simons' theorem for smooth stable minimal hypercones** (Simon, Appendix B, Theorem B.2 for
smooth cones, `2 ≤ m ≤ 6`).  Let `M ⊆ A₀`, `dim A₀ = m + 1`, be a smooth embedded `m`-dimensional
cone with `0 ∉ M` and `closure M ⊆ M ∪ {0}`, of locally finite `Hᵐ`-measure and stationary away
from `0`, with smooth unit normal `ν` in `A₀`, zero mean curvature `trace(Pₓ ∘ Dν(x)) = 0`, and
stable in the sense of B.1.  Then `Dν(x)v = 0` for `x ∈ M` and `v ∈ TₓM`: the second fundamental
form vanishes.  As in the printed proof of B.2, Simons' identity B.8 and Lemma B.11 give
(1) `½Δ_M|A|² + |A|⁴ ≥ 2|x|⁻²|A|² + |∇^M|A||²`; B.1 with `ζ = |A|ψ`, integration by parts on `M`
(smooth approximation of Lipschitz functions on `M`) and (1) give
(3) `2∫_M ψ²|A|²|x|⁻² ≤ ∫_M |A|²|∇^Mψ|²` for locally Lipschitz `ψ` vanishing off a compact subset
of `M`.  Cut-offs and `ψ = r^{1+ε} max(1, r)^{1−m/2−2ε}`, `ε = 1/10`, whose integrals are finite
by dyadic scaling of `Hᵐ` on the cone, give `|A| = 0` `Hᵐ`-a.e. on `M`, hence everywhere, since
`Hᵐ⌞M` has density one at every point of `M`. -/
theorem Submission.codim1_hcp_stable_minimal_cone_flat : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), 2 ≤ m → m ≤ 6 → Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (0 : Euclid P) ∉ M → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → closure M ⊆ insert 0 M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → (0 : Euclid P) ∉ tsupport X → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ x ∈ M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap) = 0) → (∀ ζ : Euclid P → ℝ, LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∫ x in M, (∑ j : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))‖ ^ 2) * ζ x ^ 2 ∂μHE[m] ≤ ∫ x in M, ∑ j : Fin P, (fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2 ∂μHE[m]) → ∀ x ∈ M, ∀ v ∈ tangentSpace M x, fderiv ℝ ν x v = 0 := by
  intro P m A₀ M ν hm2 hm6 hdim hMA h0 hM hcl hcone hfin hstat hνO hν hH hstab
  -- smooth approximation of locally Lipschitz functions on the embedded `C¹` submanifold `M`
  have hL := Submission.codim1_hcp_lipschitz_smooth_approx P m M (hM 1)
  -- (3): Simons' inequality (1) (B.8, B.11), stability B.1 for `ζ = |A|ψ`, integration by parts
  have h3 := Submission.codim1_hcp_sc_simons_hardy_inequality P m A₀ M ν hdim hMA h0 hM hcl
    hcone hfin hstat hνO hν hH hstab hL
  -- (3) with cut-offs and `ψ = r^{1+ε} max(1, r)^{1−m/2−2ε}` gives `|A| = 0` a.e. on `M`, hence
  -- everywhere by density one of `Hᵐ⌞M`
  exact Submission.codim1_hcp_sc_hardy_cone_flat P m A₀ M ν hm2 hm6 hdim hMA h0 hM hcl hcone
    hfin hνO hν (fun z hz => Submission.dimred_rpd_submanifold_density_one P m M z (hM 1) hz) h3
/-- Chart localization (steps 1 and 4(a) of the nearest point retraction used in the proof of
Simon 7.4.3): if `ψ` is continuous and injective on `V`, `ψ(V) = W ∩ N` with `W` open, and `ψ` is
proper into `W` (`V ∩ ψ⁻¹(K)` is compact for compact `K ⊆ W`), then for `v₀ ∈ V` and `ε > 0` some
closed ball `B̄_ρ(ψ(v₀)) ⊆ W` has `N ∩ B̄_ρ(ψ(v₀)) ⊆ ψ(V ∩ B_ε(v₀))` and `N ∩ B̄_ρ(ψ(v₀))` compact.
With `B̄_{ρ₀}(ψ(v₀)) ⊆ W`, the set `C := (V ∩ ψ⁻¹(B̄_{ρ₀}(ψ(v₀)))) \ B_ε(v₀)` is compact, so
`ψ(C)` is compact; it misses `ψ(v₀)` by injectivity, so any `ρ ≤ ρ₀` with
`B̄_ρ(ψ(v₀)) ∩ ψ(C) = ∅` works, and `N ∩ B̄_ρ(ψ(v₀)) = ψ(V ∩ ψ⁻¹(B̄_ρ(ψ(v₀))))` is compact by
properness. -/
theorem Submission.dor_lmb_ret_chart_localization : ∀ (P d : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen W → ContinuousOn ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → v₀ ∈ V → ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ closedBall (ψ v₀) ρ ⊆ W ∧ N ∩ closedBall (ψ v₀) ρ ⊆ ψ '' (V ∩ ball v₀ ε) ∧ IsCompact (N ∩ closedBall (ψ v₀) ρ) := by
  intro P d N W V ψ v₀ hW hψ hinj himage hproper hv₀ ε hε
  -- Step 1: `y := ψ(v₀) ∈ W`, and `B̄_{ρ₀}(y) ⊆ W` for some `ρ₀ > 0`
  have hy : ψ v₀ ∈ W ∩ N := by
    rw [← himage]
    exact mem_image_of_mem ψ hv₀
  obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.1 hW _ hy.1
  have hρ₀W : closedBall (ψ v₀) (r / 2) ⊆ W :=
    (closedBall_subset_ball (half_lt_self hr)).trans hrW
  -- Step 2: `C := (V ∩ ψ⁻¹(B̄_{ρ₀}(y))) \ B_ε(v₀)` is compact
  have hC : IsCompact ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) \ ball v₀ ε) :=
    (hproper _ hρ₀W (isCompact_closedBall _ _)).diff isOpen_ball
  -- Step 3: `ψ(C)` is compact
  have hψC : IsCompact (ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) \ ball v₀ ε)) :=
    hC.image_of_continuousOn (hψ.mono fun _ hx => hx.1.1)
  -- Step 4: `y ∉ ψ(C)`, by injectivity of `ψ` on `V`
  have hyC : ψ v₀ ∉ ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) \ ball v₀ ε) := by
    rintro ⟨c, ⟨⟨hcV, -⟩, hcε⟩, hc⟩
    rw [hinj hcV hv₀ hc] at hcε
    exact hcε (mem_ball_self hε)
  -- Step 5: some `B_{ρ₂}(y)` misses `ψ(C)`; take `ρ ≤ ρ₀` with `ρ < ρ₂`
  obtain ⟨ρ₂, hρ₂, hρ₂C⟩ := Metric.isOpen_iff.1 hψC.isClosed.isOpen_compl _ hyC
  obtain ⟨ρ, hρ, hρρ₀, hρρ₂⟩ : ∃ ρ : ℝ, 0 < ρ ∧ ρ ≤ r / 2 ∧ ρ < ρ₂ :=
    ⟨min (r / 2) (ρ₂ / 2), lt_min (half_pos hr) (half_pos hρ₂), min_le_left _ _,
      (min_le_right _ _).trans_lt (half_lt_self hρ₂)⟩
  have hρW : closedBall (ψ v₀) ρ ⊆ W := (closedBall_subset_closedBall hρρ₀).trans hρ₀W
  -- every `z ∈ N ∩ B̄_ρ(y)` is `ψ(v)` with `v ∈ V`, `ψ(v) ∈ B̄_ρ(y)`
  have hpre : ∀ z ∈ N ∩ closedBall (ψ v₀) ρ, ∃ v ∈ V, ψ v ∈ closedBall (ψ v₀) ρ ∧ ψ v = z := by
    rintro z ⟨hzN, hzB⟩
    have hz : z ∈ ψ '' V := by
      rw [himage]
      exact ⟨hρW hzB, hzN⟩
    obtain ⟨v, hvV, rfl⟩ := hz
    exact ⟨v, hvV, hzB, rfl⟩
  refine ⟨ρ, hρ, hρW, ?_, ?_⟩
  · -- Step 6: inclusion
    intro z hz
    obtain ⟨v, hvV, hvB, rfl⟩ := hpre z hz
    refine ⟨v, ⟨hvV, ?_⟩, rfl⟩
    by_contra hvε
    exact hρ₂C (closedBall_subset_ball hρρ₂ hvB)
      ⟨v, ⟨⟨hvV, closedBall_subset_closedBall hρρ₀ hvB⟩, hvε⟩, rfl⟩
  · -- Step 7: `N ∩ B̄_ρ(y) = ψ(V ∩ ψ⁻¹(B̄_ρ(y)))` is compact
    have heq : N ∩ closedBall (ψ v₀) ρ = ψ '' (V ∩ ψ ⁻¹' closedBall (ψ v₀) ρ) := by
      apply Subset.antisymm
      · intro z hz
        obtain ⟨v, hvV, hvB, rfl⟩ := hpre z hz
        exact ⟨v, ⟨hvV, hvB⟩, rfl⟩
      · rintro _ ⟨v, ⟨hvV, hvB⟩, rfl⟩
        have hv : ψ v ∈ W ∩ N := by
          rw [← himage]
          exact mem_image_of_mem ψ hvV
        exact ⟨hv.2, hvB⟩
    rw [heq]
    exact (hproper _ hρW (isCompact_closedBall _ _)).image_of_continuousOn
      (hψ.mono inter_subset_left)
/-- **A `C¹` immersion into a subspace of the same dimension has relatively open image** (Simon,
App. B, Theorem B.2, the passage from `|A| ≡ 0` to a hyperplane).  Let `dim H = m`, `B ⊆ ℝᵐ` open,
`ψ` `C¹` on `B` with every `Dψ(v)` injective and `ψ(B) ⊆ H`.  With `π` the orthogonal projection
onto `H`, `g = π ∘ ψ : ℝᵐ → H` agrees with `ψ` on `B`, so `Dψ(v)` maps into `H` and `π ∘ Dψ(v)` is
an injective, hence bijective, linear map `ℝᵐ → H`.  By the inverse function theorem `g(B)` is a
neighbourhood of each `g(v)`, so `g(B)` is open in `H`, i.e. `ψ(B) = O ∩ H` with `O` open. -/
theorem Submission.codim1_hcp_fcp_immersion_image_open_in_subspace : ∀ (P m : ℕ) (H : Submodule ℝ (Euclid P)) (B : Set (Euclid m)) (ψ : Euclid m → Euclid P), Module.finrank ℝ H = m → IsOpen B → ContDiffOn ℝ 1 ψ B → (∀ v ∈ B, Injective (fderiv ℝ ψ v)) → ψ '' B ⊆ (H : Set (Euclid P)) → ∃ O : Set (Euclid P), IsOpen O ∧ O ∩ (H : Set (Euclid P)) = ψ '' B := by
  intro P m H B ψ hdim hB hψ hDψ hψH
  -- step 1: `π : ℝᴾ → H` is the orthogonal projection, `π(y) = y` on `H`, so `g = π ∘ ψ = ψ` on `B`
  set π : Euclid P →L[ℝ] H := H.orthogonalProjectionOnto
  have hπH : ∀ y ∈ H, (π y : Euclid P) = y := fun y hy =>
    congrArg Subtype.val (H.orthogonalProjectionOnto_mem_subspace_eq_self ⟨y, hy⟩)
  set g : Euclid m → H := fun w => π (ψ w)
  have hgψ : ∀ w ∈ B, (g w : Euclid P) = ψ w := fun w hw => hπH _ (hψH (mem_image_of_mem ψ hw))
  -- steps 2–5: `g(B)` is a neighbourhood of each of its points `g(v)`, `v ∈ B`
  have hopen : IsOpen (g '' B) := by
    rw [isOpen_iff_mem_nhds]
    rintro _ ⟨v, hv, rfl⟩
    -- step 2: `ψ` has strict derivative `L = Dψ(v)` at `v`, so `g` has strict derivative `π ∘ L`
    have hψv : HasStrictFDerivAt ψ (fderiv ℝ ψ v) v :=
      (hψ.contDiffAt (hB.mem_nhds hv)).hasStrictFDerivAt one_ne_zero
    set L := fderiv ℝ ψ v
    have hgv : HasStrictFDerivAt g (π.comp L) v := π.hasStrictFDerivAt.comp v hψv
    -- step 3: `ι ∘ π ∘ ψ = ψ` near `v`, so `L = ι ∘ π ∘ L`, i.e. `L` takes values in `H`
    have hιπψ : HasFDerivAt (fun w => (H.subtypeL.comp π) (ψ w)) ((H.subtypeL.comp π).comp L) v :=
      (H.subtypeL.comp π).hasFDerivAt.comp v hψv.hasFDerivAt
    have heq : ψ =ᶠ[𝓝 v] fun w => (H.subtypeL.comp π) (ψ w) :=
      Filter.eventually_of_mem (hB.mem_nhds hv) fun w hw => (hgψ w hw).symm
    have hLπ : L = (H.subtypeL.comp π).comp L :=
      hψv.hasFDerivAt.unique (hιπψ.congr_of_eventuallyEq heq)
    have hLH : ∀ a, (π (L a) : Euclid P) = L a := fun a => (DFunLike.congr_fun hLπ a).symm
    -- step 4: `π ∘ L` is injective, hence bijective as `dim ℝᵐ = m = dim H`: an isomorphism `E`
    have hinj : Injective (π.comp L) := fun a b hab => hDψ v hv <|
      calc L a = π (L a) := (hLH a).symm
        _ = π (L b) := congrArg Subtype.val hab
        _ = L b := hLH b
    have hsurj : Surjective (π.comp L) :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (f := (π.comp L : Euclid m →ₗ[ℝ] H))
        (by rw [finrank_euclideanSpace_fin, hdim])).mp hinj
    let E : Euclid m ≃L[ℝ] H :=
      (LinearEquiv.ofBijective (π.comp L : Euclid m →ₗ[ℝ] H) ⟨hinj, hsurj⟩).toContinuousLinearEquiv
    have hgE : HasStrictFDerivAt g (E : Euclid m →L[ℝ] H) v := hgv
    -- step 5: inverse function theorem: `g` maps `𝓝 v` onto `𝓝 (g v)`, and `B ∈ 𝓝 v`
    rw [← hgE.map_nhds_eq_of_equiv]
    exact image_mem_map (hB.mem_nhds hv)
  -- step 6: `g(B)` is open in `H`, so `g(B) = {h ∈ H | h ∈ O}` for an open `O ⊆ ℝᴾ`
  obtain ⟨O, hO, hOg⟩ := isOpen_induced_iff.mp hopen
  -- step 7: `O ∩ H = ψ(B)`
  refine ⟨O, hO, Subset.antisymm ?_ ?_⟩
  · rintro y ⟨hyO, hyH⟩
    obtain ⟨w, hw, hgw⟩ : (⟨y, hyH⟩ : H) ∈ g '' B := hOg ▸ hyO
    exact ⟨w, hw, (hgψ w hw).symm.trans (congrArg Subtype.val hgw)⟩
  · rintro _ ⟨w, hw, rfl⟩
    refine ⟨?_, hψH (mem_image_of_mem ψ hw)⟩
    have hgwO : g w ∈ Subtype.val ⁻¹' O := hOg ▸ mem_image_of_mem g hw
    exact hgψ w hw ▸ hgwO
/-- **A subspace of dimension at least `2` minus the origin is connected** (used in passing from
`|A| ≡ 0` to a hyperplane in Simon, App. B, Theorem B.2).  The half-spaces
`C_v = {x ∈ H : ⟨v, x⟩ > 0}` are convex subsets of `K = H ∖ {0}`.  Fix `x₀ ∈ K`; the dimension
formula gives `w ∈ K` with `⟨x₀, w⟩ = 0`, and `T = C_{x₀} ∪ C_w ∪ C_{-x₀}` is preconnected because
`x₀ + w ∈ C_{x₀} ∩ C_w` and `-x₀ + w ∈ C_w ∩ C_{-x₀}`.  Each `C_y`, `y ∈ K`, meets `T` (at `y` or
at `x₀ + y`), so `T ∪ C_y ⊆ K` is a preconnected set containing `x₀` and `y`. -/
theorem Submission.codim1_hcp_fcp_punctured_subspace_isConnected : ∀ (P : ℕ) (H : Submodule ℝ (Euclid P)), 2 ≤ Module.finrank ℝ H → IsConnected ((H : Set (Euclid P)) \ {0}) := by
  intro P H hH
  -- Step 1: the half-spaces `C_v = {x ∈ H : ⟨v, x⟩ > 0}` are convex, hence preconnected, and
  -- lie in `K = H ∖ {0}`
  set C : Euclid P → Set (Euclid P) := fun v => (H : Set (Euclid P)) ∩ {x | 0 < inner ℝ v x}
  have hCpre : ∀ v, IsPreconnected (C v) := fun v =>
    (H.convex.inter (convex_halfSpace_gt (innerₛₗ ℝ v).isLinear 0)).isPreconnected
  have hCK : ∀ v, C v ⊆ (H : Set (Euclid P)) \ {0} := by
    rintro v x ⟨hxH, hx : 0 < inner ℝ v x⟩
    refine ⟨hxH, fun h0 => ?_⟩
    rw [mem_singleton_iff.1 h0, inner_zero_right] at hx
    exact lt_irrefl 0 hx
  have hpos : ∀ y : Euclid P, y ≠ 0 → 0 < inner ℝ y y := fun y hy => real_inner_self_pos.2 hy
  -- Step 2: `H ≠ {0}`, so there is `x₀ ∈ H` with `x₀ ≠ 0`
  obtain ⟨x₀, hx₀H, hx₀⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
    (Submodule.one_le_finrank_iff.1 (by omega) : H ≠ ⊥)
  -- Step 3: a nonzero `w ∈ H ∩ (span{x₀})ᗮ`, by the dimension formula
  -- `dim (H ⊓ L) = dim H + dim L - dim (H ⊔ L) ≥ dim H - 1 ≥ 1`, `L = (span{x₀})ᗮ`
  obtain ⟨w, ⟨hwH, hwL⟩, hw⟩ : ∃ w, w ∈ H ⊓ (ℝ ∙ x₀)ᗮ ∧ w ≠ 0 := by
    refine Submodule.exists_mem_ne_zero_of_ne_bot (Submodule.one_le_finrank_iff.1 ?_)
    have h1 := Submodule.finrank_sup_add_finrank_inf_eq H (ℝ ∙ x₀)ᗮ
    have h2 := Submodule.finrank_add_finrank_orthogonal (ℝ ∙ x₀)
    have h3 := Submodule.finrank_le (H ⊔ (ℝ ∙ x₀)ᗮ)
    rw [finrank_span_singleton hx₀] at h2
    omega
  have hxw : inner ℝ x₀ w = 0 := Submodule.mem_orthogonal_singleton_iff_inner_right.1 hwL
  have hwx : inner ℝ w x₀ = 0 := (real_inner_comm x₀ w).trans hxw
  -- Step 4: `T = C_{x₀} ∪ C_w ∪ C_{-x₀}` is preconnected, as `x₀ + w ∈ C_{x₀} ∩ C_w` and
  -- `-x₀ + w ∈ C_w ∩ C_{-x₀}`
  have hT : IsPreconnected (C x₀ ∪ C w ∪ C (-x₀)) := by
    refine ((hCpre x₀).union (x₀ + w) ?_ ?_ (hCpre w)).union (-x₀ + w) (Or.inr ?_) ?_
      (hCpre (-x₀))
    · refine ⟨H.add_mem hx₀H hwH, ?_⟩
      show 0 < inner ℝ x₀ (x₀ + w)
      rw [inner_add_right, hxw, add_zero]
      exact hpos x₀ hx₀
    · refine ⟨H.add_mem hx₀H hwH, ?_⟩
      show 0 < inner ℝ w (x₀ + w)
      rw [inner_add_right, hwx, zero_add]
      exact hpos w hw
    · refine ⟨H.add_mem (H.neg_mem hx₀H) hwH, ?_⟩
      show 0 < inner ℝ w (-x₀ + w)
      rw [inner_add_right, inner_neg_right, hwx, neg_zero, zero_add]
      exact hpos w hw
    · refine ⟨H.add_mem (H.neg_mem hx₀H) hwH, ?_⟩
      show 0 < inner ℝ (-x₀) (-x₀ + w)
      rw [inner_add_right, inner_neg_left, inner_neg_left, inner_neg_right, hxw, neg_zero,
        add_zero, neg_neg]
      exact hpos x₀ hx₀
  -- Steps 5–7: `K` is nonempty, and every `y ∈ K` lies with `x₀` in a preconnected subset of `K`
  refine ⟨⟨x₀, hx₀H, hx₀⟩, isPreconnected_of_forall x₀ fun y ⟨hyH, hy⟩ => ?_⟩
  have hy0 : y ≠ 0 := hy
  have hyy : y ∈ C y := ⟨hyH, hpos y hy0⟩
  -- Step 5: `C_y` meets `T`, at `y` if `⟨x₀, y⟩ ≠ 0` and at `x₀ + y` if `⟨x₀, y⟩ = 0`
  obtain ⟨z, hzT, hzy⟩ : ∃ z, z ∈ C x₀ ∪ C w ∪ C (-x₀) ∧ z ∈ C y := by
    rcases lt_trichotomy 0 (inner ℝ x₀ y) with h | h | h
    · exact ⟨y, Or.inl (Or.inl ⟨hyH, h⟩), hyy⟩
    · refine ⟨x₀ + y, Or.inl (Or.inl ⟨H.add_mem hx₀H hyH, ?_⟩), H.add_mem hx₀H hyH, ?_⟩
      · show 0 < inner ℝ x₀ (x₀ + y)
        rw [inner_add_right, ← h, add_zero]
        exact hpos x₀ hx₀
      · show 0 < inner ℝ y (x₀ + y)
        rw [inner_add_right, real_inner_comm x₀ y, ← h, zero_add]
        exact hpos y hy0
    · refine ⟨y, Or.inr ⟨hyH, ?_⟩, hyy⟩
      show 0 < inner ℝ (-x₀) y
      rw [inner_neg_left]
      exact neg_pos.2 h
  -- Step 6: `T ∪ C_y` is a preconnected subset of `K` containing `x₀` and `y`
  refine ⟨C x₀ ∪ C w ∪ C (-x₀) ∪ C y, ?_, Or.inl (Or.inl (Or.inl ⟨hx₀H, hpos x₀ hx₀⟩)),
    Or.inr hyy, hT.union z hzT hzy (hCpre y)⟩
  exact union_subset (union_subset (union_subset (hCK x₀) (hCK w)) (hCK (-x₀))) (hCK y)

/-- **Local flatness of a flat hypercone** (the passage from `|A| ≡ 0` to a hyperplane in Simon,
Appendix B, Theorem B.2, on one chart).  Let `M ⊆ A₀` (`dim A₀ = m + 1`) be an embedded `C¹`
`m`-dimensional cone with a unit normal `ν` in `A₀`, differentiable on `M` with zero tangential
derivative.  Take a chart `ψ`, `ψ(v₀) = x`, and a ball `B = B_δ(v₀) ⊆ V`.  By the chain rule
`ν ∘ ψ` has zero derivative on `B`, so `ν ∘ ψ ≡ n := ν(x)` there; then `⟨n, ψ⟩` has derivative
`⟨ν(ψ(v)), Dψ(v) a⟩ = 0`, so `⟨n, ψ(v)⟩ = ⟨n, x⟩` on `B`.  Some `B̄_ρ(x)` has
`M ∩ B̄_ρ(x) ⊆ ψ(B)` and contains the cone point `(1 + s)x`, `s = ρ/(|x| + 1)`, which forces
`⟨n, x⟩ = 0`.  So `ψ(B)` lies in `H = A₀ ∩ n^⊥`, which has dimension `m`, and `ψ(B) = O' ∩ H`
with `O'` open (inverse function theorem); `O = B_ρ(x) ∩ O'` has `O ∩ M = O ∩ H`. -/
theorem Submission.codim1_hcp_fcp_local_plane : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → IsEmbeddedSubmanifold 1 m M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∀ x ∈ M, DifferentiableAt ℝ ν x) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ x ∈ M, ∀ v ∈ tangentSpace M x, fderiv ℝ ν x v = 0) → ∀ x ∈ M, ∃ H : Submodule ℝ (Euclid P), Module.finrank ℝ H = m ∧ H ≤ A₀ ∧ ∃ O : Set (Euclid P), IsOpen O ∧ x ∈ O ∧ O ∩ M = O ∩ (H : Set (Euclid P)) := by
  intro P m A₀ M ν hA₀ hMA₀ hM hcone hνd hνn hνflat x hx
  -- Step 1: a chart `ψ : V → W` with `ψ(v₀) = x`, a ball `B = B_δ(v₀) ⊆ V`, and
  -- `Dψ(v) a ∈ T_{ψ(v)}M` for `v ∈ V` (chart_tangent_space)
  obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, hψV, hproper, hDψ⟩ := hM x hx
  obtain ⟨v₀, hv₀, rfl⟩ : x ∈ ψ '' V := hψV ▸ ⟨hxW, hx⟩
  obtain ⟨δ, hδ, hBV⟩ := Metric.isOpen_iff.1 hV v₀ hv₀
  have hψ1 : ContDiffOn ℝ 1 ψ V := by exact_mod_cast hψ
  have hψd : ∀ v ∈ V, DifferentiableAt ℝ ψ v := fun v hv =>
    (hψ1.differentiableOn one_ne_zero).differentiableAt (hV.mem_nhds hv)
  have hψM : ∀ v ∈ V, ψ v ∈ M := fun v hv =>
    (show ψ v ∈ W ∩ M from hψV ▸ mem_image_of_mem ψ hv).2
  have htan : ∀ v ∈ V, ∀ a, fderiv ℝ ψ v a ∈ tangentSpace M (ψ v) := fun v hv a => by
    rw [Submission.chart_tangentSpace_eq_range_fderiv P m 1 M W V ψ v le_rfl hV hW hψ hinj hψV
      hproper hDψ hv]
    exact mem_range_self a
  have hB : IsPreconnected (ball v₀ δ) := (convex_ball v₀ δ).isPreconnected
  -- Step 2: `D(ν ∘ ψ)(v) a = Dν(ψ(v)) (Dψ(v) a) = 0` on `B`, so `ν(ψ(v)) = ν(x) =: n` on `B`
  have hνψ : ∀ v ∈ ball v₀ δ, ν (ψ v) = ν (ψ v₀) := by
    have hd : ∀ v ∈ ball v₀ δ, DifferentiableAt ℝ (ν ∘ ψ) v := fun v hv =>
      (hνd _ (hψM v (hBV hv))).comp v (hψd v (hBV hv))
    intro v hv
    refine isOpen_ball.is_const_of_fderiv_eq_zero (f := ν ∘ ψ) hB
      (fun w hw => (hd w hw).differentiableWithinAt) (fun w hw => ?_) hv (mem_ball_self hδ)
    rw [fderiv_comp w (hνd _ (hψM w (hBV hw))) (hψd w (hBV hw))]
    ext1 a
    exact hνflat _ (hψM w (hBV hw)) _ (htan w (hBV hw) a)
  obtain ⟨hnA, hnorm, -⟩ := hνn _ hx
  set n := ν (ψ v₀)
  clear_value n
  -- Step 3: `D⟨n, ψ⟩(v) a = ⟨ν(ψ(v)), Dψ(v) a⟩ = 0` on `B`, so `⟨n, ψ(v)⟩ = ⟨n, x⟩` on `B`
  have hnψ : ∀ v ∈ ball v₀ δ, inner ℝ n (ψ v) = inner ℝ n (ψ v₀) := by
    have hd : ∀ v ∈ ball v₀ δ, HasFDerivAt (fun w => innerSL ℝ n (ψ w))
        ((innerSL ℝ n).comp (fderiv ℝ ψ v)) v := fun v hv =>
      (innerSL ℝ n).hasFDerivAt.comp v (hψd v (hBV hv)).hasFDerivAt
    intro v hv
    refine isOpen_ball.is_const_of_fderiv_eq_zero (f := fun w => innerSL ℝ n (ψ w)) hB
      (fun w hw => (hd w hw).differentiableAt.differentiableWithinAt) (fun w hw => ?_) hv
      (mem_ball_self hδ)
    rw [(hd w hw).fderiv]
    ext1 a
    rw [ContinuousLinearMap.comp_apply, innerSL_apply_apply, ← hνψ w hw]
    exact (hνn _ (hψM w (hBV hw))).2.2 _ (htan w (hBV hw) a)
  -- Step 4: `M ∩ B̄_ρ(x) ⊆ ψ(B)` (chart_localization)
  obtain ⟨ρ, hρ, -, hloc, -⟩ := Submission.dor_lmb_ret_chart_localization P m M W V ψ v₀ hW
    hψ.continuousOn hinj hψV hproper hv₀ δ hδ
  -- Step 5: the cone point `(1 + s) x`, `s = ρ / (|x| + 1)`, lies in `M ∩ B̄_ρ(x) ⊆ ψ(B)`,
  -- so `(1 + s) ⟨n, x⟩ = ⟨n, x⟩` and `⟨n, x⟩ = 0`
  have hnx : inner ℝ n (ψ v₀) = 0 := by
    set s : ℝ := ρ / (‖ψ v₀‖ + 1) with hs_def
    have hs : 0 < s := div_pos hρ (by positivity)
    have hmem : (1 + s) • ψ v₀ ∈ M ∩ closedBall (ψ v₀) ρ := by
      refine ⟨hcone _ (by linarith) _ hx, ?_⟩
      rw [mem_closedBall, dist_eq_norm, add_smul, one_smul, add_sub_cancel_left, norm_smul,
        Real.norm_of_nonneg hs.le, hs_def, div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
      nlinarith [norm_nonneg (ψ v₀)]
    obtain ⟨v, ⟨-, hv⟩, hvx⟩ := hloc hmem
    have h := hnψ v hv
    rw [hvx, real_inner_smul_right] at h
    have h' : s * inner ℝ n (ψ v₀) = 0 := by linear_combination h
    exact (mul_eq_zero.1 h').resolve_left hs.ne'
  -- Step 6: `H = A₀ ∩ n^⊥` has dimension `m` and contains `ψ(B)`
  have hn0 : n ≠ 0 := by
    rintro rfl
    simp at hnorm
  set H : Submodule ℝ (Euclid P) := A₀ ⊓ (Submodule.span ℝ {n})ᗮ with hH
  have hHdim : Module.finrank ℝ H = m := by
    have hle : Submodule.span ℝ {n} ≤ A₀ := (Submodule.span_singleton_le_iff_mem n A₀).2 hnA
    have htop : A₀ ⊔ (Submodule.span ℝ {n})ᗮ = ⊤ :=
      top_unique <| (Submodule.sup_orthogonal_of_hasOrthogonalProjection
        (K := Submodule.span ℝ {n})).symm.le.trans (sup_le_sup_right hle _)
    have h1 := Submodule.finrank_sup_add_finrank_inf_eq A₀ (Submodule.span ℝ {n})ᗮ
    have h2 := Submodule.finrank_add_finrank_orthogonal (Submodule.span ℝ {n})
    rw [htop, finrank_top, finrank_euclideanSpace_fin, ← hH] at h1
    rw [finrank_span_singleton hn0, finrank_euclideanSpace_fin] at h2
    omega
  have hψBH : ψ '' ball v₀ δ ⊆ (H : Set (Euclid P)) := by
    rintro _ ⟨v, hv, rfl⟩
    refine Submodule.mem_inf.2 ⟨hMA₀ (hψM v (hBV hv)), ?_⟩
    rw [Submodule.mem_orthogonal_singleton_iff_inner_right, hnψ v hv, hnx]
  -- Step 7: `ψ(B) = O' ∩ H` with `O'` open (immersion_open)
  obtain ⟨O', hO', hO'H⟩ := Submission.codim1_hcp_fcp_immersion_image_open_in_subspace P m H
    (ball v₀ δ) ψ hHdim isOpen_ball (hψ1.mono hBV) (fun v hv => hDψ v (hBV hv)) hψBH
  -- Step 8: `O = B_ρ(x) ∩ O'` is open, contains `x`, and `O ∩ M = O ∩ H`
  refine ⟨H, hHdim, inf_le_left, ball (ψ v₀) ρ ∩ O', isOpen_ball.inter hO',
    ⟨mem_ball_self hρ, ?_⟩, Subset.antisymm ?_ ?_⟩
  · exact (show ψ v₀ ∈ O' ∩ (H : Set (Euclid P)) from
      hO'H ▸ mem_image_of_mem ψ (mem_ball_self hδ)).1
  · rintro y ⟨hyO, hyM⟩
    obtain ⟨v, ⟨-, hv⟩, rfl⟩ := hloc ⟨hyM, ball_subset_closedBall hyO.1⟩
    exact ⟨hyO, hψBH (mem_image_of_mem ψ hv)⟩
  · rintro y ⟨hyO, hyH⟩
    obtain ⟨v, hv, rfl⟩ : y ∈ ψ '' ball v₀ δ := hO'H ▸ ⟨hyO.2, hyH⟩
    exact ⟨hyO, hψM v (hBV hv)⟩
/-- **Globalization of local planarity** (the passage from `|A| ≡ 0` to a plane closing the proof
of Simon, Appendix B, Theorem B.2).  Let `M ⊆ ℝᴾ` be nonempty with `0 ∉ M` and
`closure M ⊆ M ∪ {0}`, and let `M` agree near each `x ∈ M` with some `m`-dimensional subspace
`H ⊆ A₀`, where `m ≥ 2` and `dim A₀ = m + 1`.  Then `M = H₀ \ {0}` with `dim H₀ = m`.

Two local planes at one point of `M` coincide (move from the point along `h ∈ H₁` inside both
neighbourhoods).  Let `U_H` be the union of all open `O` with `O ∩ M = O ∩ H`; it is open and
`U_H ∩ M = U_H ∩ H`.  If `dim H ≥ 2` and `U_H` meets `M`, then `U_H` and the open set
`G = ℝᴾ \ closure (U_H ∩ M)` cover the connected set `H \ {0}` (a point of `H \ {0}` in
`closure (U_H ∩ M)` lies in `M`, and its local plane is `H` by uniqueness at a nearby point of
`U_H ∩ M`) and are disjoint on it; `H \ {0}` contains a point of `U_H ∩ M`, which is not in `G`,
so `H \ {0} ⊆ U_H`.  Hence `H₀ \ {0} ⊆ M` for the local plane `H₀` at some `x₀ ∈ M`.  For `y ∈ M`
with local plane `H_y`, `dim (H₀ ∩ H_y) ≥ 2m − (m + 1) ≥ 1` inside `A₀`, so the two planes share
some `w ≠ 0`, and uniqueness at `w` gives `H_y = H₀`. -/
theorem Submission.codim1_hcp_fcp_locally_planar_is_plane : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)), 2 ≤ m → Module.finrank ℝ A₀ = m + 1 → M.Nonempty → (0 : Euclid P) ∉ M → closure M ⊆ insert 0 M → (∀ x ∈ M, ∃ H : Submodule ℝ (Euclid P), Module.finrank ℝ H = m ∧ H ≤ A₀ ∧ ∃ O : Set (Euclid P), IsOpen O ∧ x ∈ O ∧ O ∩ M = O ∩ (H : Set (Euclid P))) → ∃ H₀ : Submodule ℝ (Euclid P), Module.finrank ℝ H₀ = m ∧ M = (H₀ : Set (Euclid P)) \ {0} := by
  intro P m A₀ M hm hA₀ hMne h0M hcl hloc
  have hM0 : ∀ y ∈ M, y ∉ ({0} : Set (Euclid P)) := fun y hy h0 => h0M (h0 ▸ hy)
  -- Step 1: two local planes of `M` at the same point `y ∈ M` coincide
  have uniq_le : ∀ y ∈ M, ∀ (H₁ H₂ : Submodule ℝ (Euclid P)) (O₁ O₂ : Set (Euclid P)),
      IsOpen O₁ → IsOpen O₂ → y ∈ O₁ → y ∈ O₂ → O₁ ∩ M = O₁ ∩ (H₁ : Set (Euclid P)) →
      O₂ ∩ M = O₂ ∩ (H₂ : Set (Euclid P)) → H₁ ≤ H₂ := by
    intro y hy H₁ H₂ O₁ O₂ hO₁ hO₂ hy₁ hy₂ hM₁ hM₂ h hh
    have hyH₁ : y ∈ H₁ := (hM₁.subset ⟨hy₁, hy⟩).2
    have hyH₂ : y ∈ H₂ := (hM₂.subset ⟨hy₂, hy⟩).2
    -- `z = y + s h` with `0 < s`, `s |h| < ε` lies in `B_ε(y) ⊆ O₁ ∩ O₂`
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 (hO₁.inter hO₂) y ⟨hy₁, hy₂⟩
    obtain ⟨s, hs, hsε⟩ : ∃ s : ℝ, 0 < s ∧ s * ‖h‖ < ε := by
      refine ⟨ε / (2 * (‖h‖ + 1)), by positivity, ?_⟩
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
      nlinarith [mul_nonneg hε.le (norm_nonneg h)]
    have hz : y + s • h ∈ O₁ ∩ O₂ := hball <| by
      rwa [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul,
        Real.norm_of_nonneg hs.le]
    -- `z ∈ O₁ ∩ H₁ = O₁ ∩ M`, hence `z ∈ O₂ ∩ M = O₂ ∩ H₂`
    have hzM : y + s • h ∈ M :=
      (hM₁.symm.subset ⟨hz.1, H₁.add_mem hyH₁ (H₁.smul_mem s hh)⟩).2
    have hzH₂ : y + s • h ∈ H₂ := (hM₂.subset ⟨hz.2, hzM⟩).2
    -- `h = s⁻¹ ((y + s h) − y) ∈ H₂`
    have := H₂.smul_mem s⁻¹ (H₂.sub_mem hzH₂ hyH₂)
    rwa [add_sub_cancel_left, inv_smul_smul₀ hs.ne'] at this
  have uniq : ∀ y ∈ M, ∀ (H₁ H₂ : Submodule ℝ (Euclid P)) (O₁ O₂ : Set (Euclid P)),
      IsOpen O₁ → IsOpen O₂ → y ∈ O₁ → y ∈ O₂ → O₁ ∩ M = O₁ ∩ (H₁ : Set (Euclid P)) →
      O₂ ∩ M = O₂ ∩ (H₂ : Set (Euclid P)) → H₁ = H₂ :=
    fun y hy H₁ H₂ O₁ O₂ hO₁ hO₂ hy₁ hy₂ hM₁ hM₂ =>
      le_antisymm (uniq_le y hy H₁ H₂ O₁ O₂ hO₁ hO₂ hy₁ hy₂ hM₁ hM₂)
        (uniq_le y hy H₂ H₁ O₂ O₁ hO₂ hO₁ hy₂ hy₁ hM₂ hM₁)
  -- Step 2: `U_H`, the union of all open `O` with `O ∩ M = O ∩ H`, is open, contains each such
  -- `O`, and satisfies `U_H ∩ M = U_H ∩ H`
  obtain ⟨U, hUopen, hUsub, hUeq⟩ : ∃ U : Submodule ℝ (Euclid P) → Set (Euclid P),
      (∀ H, IsOpen (U H)) ∧
      (∀ (H : Submodule ℝ (Euclid P)) (O : Set (Euclid P)), IsOpen O →
        O ∩ M = O ∩ (H : Set (Euclid P)) → O ⊆ U H) ∧
      ∀ H, U H ∩ M = U H ∩ (H : Set (Euclid P)) := by
    refine ⟨fun H => ⋃₀ {O | IsOpen O ∧ O ∩ M = O ∩ (H : Set (Euclid P))},
      fun H => isOpen_sUnion fun O hO => hO.1, fun H O hO hOM => subset_sUnion_of_mem ⟨hO, hOM⟩,
      fun H => Subset.antisymm ?_ ?_⟩
    · rintro z ⟨hzU, hzM⟩
      obtain ⟨O, ⟨-, hOM⟩, hzO⟩ := mem_sUnion.1 hzU
      exact ⟨hzU, (hOM.subset ⟨hzO, hzM⟩).2⟩
    · rintro z ⟨hzU, hzH⟩
      obtain ⟨O, ⟨-, hOM⟩, hzO⟩ := mem_sUnion.1 hzU
      exact ⟨hzU, (hOM.symm.subset ⟨hzO, hzH⟩).2⟩
  -- Step 3: if `dim H ≥ 2` and `U_H ∩ M ≠ ∅`, then `H \ {0} ⊆ U_H`
  have hfill : ∀ H : Submodule ℝ (Euclid P), 2 ≤ Module.finrank ℝ H → (U H ∩ M).Nonempty →
      (H : Set (Euclid P)) \ {0} ⊆ U H := by
    rintro H hH ⟨y₀, hy₀U, hy₀M⟩
    -- (a) `H \ {0} ⊆ U_H ∪ G`, where `G = ℝᴾ \ closure (U_H ∩ M)`
    have hcover : (H : Set (Euclid P)) \ {0} ⊆ U H ∪ (closure (U H ∩ M))ᶜ := by
      rintro z ⟨-, hz0⟩
      by_cases hzc : z ∈ closure (U H ∩ M)
      · -- `z ∈ closure M \ {0} ⊆ M`; its local plane is `H`, by uniqueness at a nearby point
        refine Or.inl ?_
        have hzM : z ∈ M :=
          (Set.mem_insert_iff.1 (hcl (closure_mono inter_subset_right hzc))).resolve_left hz0
        obtain ⟨Hz, -, -, Oz, hOz, hzOz, hOzM⟩ := hloc z hzM
        obtain ⟨y, hyOz, hyU, hyM⟩ := _root_.mem_closure_iff.1 hzc Oz hOz hzOz
        rw [uniq y hyM Hz H Oz (U H) hOz (hUopen H) hyOz hyU hOzM (hUeq H)] at hOzM
        exact hUsub H Oz hOz hOzM hzOz
      · exact Or.inr hzc
    -- (b) `(H \ {0}) ∩ U_H ∩ G = ∅`, as `U_H ∩ H = U_H ∩ M`
    have hdisj : ((H : Set (Euclid P)) \ {0}) ∩ (U H ∩ (closure (U H ∩ M))ᶜ) = ∅ :=
      eq_empty_iff_forall_notMem.2 fun z ⟨hz, hzU, hzG⟩ =>
        hzG (subset_closure ((hUeq H).symm.subset ⟨hzU, hz.1⟩))
    -- (c) `H \ {0}` is connected and contains `y₀ ∈ U_H ∩ M`, which is not in `G`
    rcases isPreconnected_iff_subset_of_disjoint.1
      (Submission.codim1_hcp_fcp_punctured_subspace_isConnected P H hH).isPreconnected
      (U H) _ (hUopen H) isClosed_closure.isOpen_compl hcover hdisj with h | h
    · exact h
    · have hy₀ : y₀ ∈ (H : Set (Euclid P)) \ {0} :=
        ⟨((hUeq H).subset ⟨hy₀U, hy₀M⟩).2, hM0 y₀ hy₀M⟩
      exact absurd (subset_closure (show y₀ ∈ U H ∩ M from ⟨hy₀U, hy₀M⟩)) (h hy₀)
  -- each local plane `H` (`dim H = m ≥ 2`) of `M` at a point of `M` has `H \ {0} ⊆ U_H`
  have hplane : ∀ y ∈ M, ∀ (H : Submodule ℝ (Euclid P)) (O : Set (Euclid P)),
      Module.finrank ℝ H = m → IsOpen O → y ∈ O → O ∩ M = O ∩ (H : Set (Euclid P)) →
      (H : Set (Euclid P)) \ {0} ⊆ U H :=
    fun y hy H O hH hO hyO hOM => hfill H (hH ▸ hm) ⟨y, hUsub H O hO hOM hyO, hy⟩
  -- Step 4: the local plane `H₀` at some `x₀ ∈ M` has `H₀ \ {0} ⊆ U_{H₀} ∩ H₀ ⊆ M`
  obtain ⟨x₀, hx₀⟩ := hMne
  obtain ⟨H₀, hH₀, hH₀A, O₀, hO₀, hx₀O₀, hO₀M⟩ := hloc x₀ hx₀
  have hH₀U := hplane x₀ hx₀ H₀ O₀ hH₀ hO₀ hx₀O₀ hO₀M
  refine ⟨H₀, hH₀, Subset.antisymm ?_ fun z hz => ((hUeq H₀).symm.subset ⟨hH₀U hz, hz.1⟩).2⟩
  -- Step 5: `M ⊆ H₀ \ {0}`
  intro y hy
  obtain ⟨Hy, hHy, hHyA, Oy, hOy, hyOy, hOyM⟩ := hloc y hy
  have hHyU := hplane y hy Hy Oy hHy hOy hyOy hOyM
  -- `dim (H₀ ⊓ H_y) ≥ 2m − (m + 1) ≥ 1`, since `H₀ ⊔ H_y ≤ A₀`
  have hne : H₀ ⊓ Hy ≠ ⊥ := by
    intro hbot
    have hdim := Submodule.finrank_sup_add_finrank_inf_eq H₀ Hy
    rw [hbot, finrank_bot, add_zero, hH₀, hHy] at hdim
    have hle : m + m ≤ m + 1 :=
      calc m + m = Module.finrank ℝ ↥(H₀ ⊔ Hy) := hdim.symm
        _ ≤ Module.finrank ℝ ↥A₀ := Submodule.finrank_mono (sup_le hH₀A hHyA)
        _ = m + 1 := hA₀
    omega
  obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  obtain ⟨hw₀, hwy⟩ := Submodule.mem_inf.1 hw
  -- `w ∈ M` lies in `U_{H₀}` and `U_{H_y}`, so `H_y = H₀` by uniqueness at `w`
  have hwU₀ : w ∈ U H₀ := hH₀U (show w ∈ (H₀ : Set (Euclid P)) \ {0} from ⟨hw₀, hw0⟩)
  have hwUy : w ∈ U Hy := hHyU (show w ∈ (Hy : Set (Euclid P)) \ {0} from ⟨hwy, hw0⟩)
  have hwM : w ∈ M := ((hUeq H₀).symm.subset ⟨hwU₀, hw₀⟩).2
  have hHy₀ : Hy = H₀ :=
    uniq w hwM Hy H₀ (U Hy) (U H₀) (hUopen Hy) (hUopen H₀) hwUy hwU₀ (hUeq Hy) (hUeq H₀)
  exact ⟨hHy₀ ▸ (hOyM.subset ⟨hyOy, hy⟩).2, hM0 y hy⟩

/-- **Flat cones are planes** (Simon, Appendix B, proof of Theorem B.2: from `|A| ≡ 0` to a
hyperplane).  Let `dim A₀ = m + 1`, `m ≥ 2`, and let `M ⊆ A₀` be a nonempty embedded `C¹`
`m`-dimensional cone with `0 ∉ M` and `M̄ ⊆ M ∪ {0}`, whose unit normal `ν ∈ A₀` has zero
tangential derivative.  Then `M = H₀ \ {0}` for an `m`-dimensional subspace `H₀`.  Near each
`x ∈ M`, the chain rule and the mean value theorem in a chart make `ν` and then `z ↦ ν(x) · z`
constant, the cone rays force that constant to be `0`, and the inverse function theorem makes the
chart image open in `A₀ ∩ ν(x)^⊥`; so `M` agrees near `x` with an `m`-plane of `A₀`.  Such a set
is one punctured `m`-plane: `H \ {0}` is connected for `dim H ≥ 2`, `M̄ ⊆ M ∪ {0}` makes the part
of `M` modelled on `H` closed in `H \ {0}`, and two `m`-planes of `A₀` meet away from `0`. -/
theorem Submission.codim1_hcp_flat_cone_is_plane : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), 2 ≤ m → Module.finrank ℝ A₀ = m + 1 → M.Nonempty → M ⊆ (A₀ : Set (Euclid P)) → (0 : Euclid P) ∉ M → IsEmbeddedSubmanifold 1 m M → closure M ⊆ insert 0 M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∀ x ∈ M, DifferentiableAt ℝ ν x) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ x ∈ M, ∀ v ∈ tangentSpace M x, fderiv ℝ ν x v = 0) → ∃ H₀ : Submodule ℝ (Euclid P), Module.finrank ℝ H₀ = m ∧ M = (H₀ : Set (Euclid P)) \ {0} := by
  intro P m A₀ M ν hm hA₀ hne hMA₀ h0 hM hcl hcone hνd hν hDν
  -- Steps 1, 3, 4: near each `x ∈ M`, `M` coincides with an `m`-plane `H ≤ A₀`
  have hloc := Submission.codim1_hcp_fcp_local_plane P m A₀ M ν hA₀ hMA₀ hM hcone hνd hν hDν
  -- Steps 2, 5–8: these local planes globalize to one punctured `m`-plane `H₀ \ {0}`
  exact Submission.codim1_hcp_fcp_locally_planar_is_plane P m A₀ M hm hA₀ hne h0 hcl hloc

/-- **Simon, Appendix B, B.2 (Simons' theorem) for deformation-minimal `C¹` hypercones.**  Let
`2 ≤ m ≤ 6`, let `A₀ ⊆ ℝᴾ` be an `(m+1)`-dimensional subspace and let `M ⊆ A₀ \ {0}` be a
nonempty oriented embedded `C¹` `m`-submanifold with `closure M ⊆ M ∪ {0}`, `tM ⊆ M` for `t > 0`
and `Hᵐ(M ∩ K) < ∞` for compact `K`.  Suppose `Hᵐ(M ∩ K_Z) ≤ Hᵐ(Φ_t(M ∩ K_Z))` for small `|t|`,
where `Φ_t = id + tZ`, `Z` is smooth with compact support and `0 ∉ K_Z = spt Z`.  Then
`M = H₀ \ {0}` for an `m`-dimensional subspace `H₀`.
The argument works in the open set `U₀ = ℝᴾ \ {0}`: it contains `M`, and every deformation
field supported in `U₀` is admissible.
(1) The first variation vanishes, so `v(M, 1)` is stationary in `U₀` (Simon Ch. 2, 5.1–5.3).
(2) Allard–Schauder regularity (Simon Ch. 5, 7.1) makes `M` of class `Cʳ` for every `r`.
(3) The orientation and a volume form of `A₀` give a smooth unit normal `ν ∈ A₀` with
`div_M ν = 0`.
(4) The second variation gives the stability inequality B.1 (Simon Ch. 2, 5.11–5.12).
(5) Simons' identity B.8, the cone lemma B.11 and the test function `ψ = r^{1+ε} r₁^{1−m/2−2ε}`
(printed proof of B.2) force `D_τν = 0` for tangent `τ`.
(6) A cone whose unit normal has zero tangential derivative is a punctured hyperplane, as
`m ≥ 2`. -/
theorem Submission.codim1_deformation_minimal_hypercone_is_plane : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)), 2 ≤ m → m ≤ 6 → Module.finrank ℝ A₀ = m + 1 → M.Nonempty → M ⊆ (A₀ : Set (Euclid P)) → (0 : Euclid P) ∉ M → IsEmbeddedSubmanifold 1 m M → closure M ⊆ insert 0 M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∃ ξ : Euclid P → MultiVector P m, IsOrientation m M ξ) → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → (∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z → (0 : Euclid P) ∉ tsupport Z → ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → μHE[m] (M ∩ tsupport Z) ≤ μHE[m] ((fun x => x + t • Z x) '' (M ∩ tsupport Z))) → ∃ H₀ : Submodule ℝ (Euclid P), Module.finrank ℝ H₀ = m ∧ M = (H₀ : Set (Euclid P)) \ {0} := by
  intro P m A₀ M hm2 hm6 hA₀ hne hMA h0 hM hcl hcone hor hfin hdef
  -- the open set `U₀ = ℝᴾ \ {0}` contains `M`
  have hU : IsOpen ({0}ᶜ : Set (Euclid P)) := isOpen_compl_singleton
  have hMU : M ⊆ {0}ᶜ := fun x hx hx0 => h0 (mem_singleton_iff.mp hx0 ▸ hx)
  -- local finiteness of `Hᵐ⌞M` in `U₀`
  have hfinU : ∀ K : Set (Euclid P), IsCompact K → K ⊆ {0}ᶜ → μHE[m] (M ∩ K) ≠ ∞ :=
    fun K hK _ => hfin K hK
  -- a deformation field supported in `U₀` avoids the vertex, so it is admissible
  have hdefU : ∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z →
      tsupport Z ⊆ {0}ᶜ → ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ →
        μHE[m] (M ∩ tsupport Z) ≤ μHE[m] ((fun x => x + t • Z x) '' (M ∩ tsupport Z)) :=
    fun Z hZ hZc hZU => hdef Z hZ hZc fun hZ0 => hZU hZ0 (mem_singleton 0)
  -- (1) `v(M, 1)` is stationary in `U₀`
  have hstat := Submission.codim1_hcp_deformation_minimal_stationary P m {0}ᶜ M hU hMU hM hfinU
    hdefU
  -- (2) `M` is a `Cʳ` submanifold for every `r`
  have hsmooth := Submission.codim1_hcp_stationary_c1_smooth P m {0}ᶜ M (by omega) hU hMU hM
    hfinU hstat
  -- (3) a smooth unit normal `ν ∈ A₀` of `M` with `div_M ν = 0`
  obtain ⟨ν, O, hO, hMO, hνO, hν, hdivν⟩ := Submission.codim1_hcp_minimal_unit_normal P m {0}ᶜ
    A₀ M hU hMU hA₀ hMA hsmooth hor hfinU hstat
  -- (4) the stability inequality B.1
  have hstab := Submission.codim1_hcp_stability_inequality P m {0}ᶜ A₀ M ν hU hMU hA₀ hMA hsmooth
    hfinU ⟨O, hO, hMO, hνO⟩ hν hdivν hdefU
  -- (5) Simons' theorem: `D_τν = 0` for every tangent vector `τ`; stationarity in `U₀` is
  -- stationarity for the fields vanishing near the vertex
  have hflat := Submission.codim1_hcp_stable_minimal_cone_flat P m A₀ M ν hm2 hm6 hA₀ hMA h0
    hsmooth hcl hcone hfin
    (fun X hX hXc hX0 => hstat X hX hXc fun y hy hy0 => hX0 (mem_singleton_iff.mp hy0 ▸ hy))
    ⟨O, hO, hMO, hνO⟩ hν hdivν hstab
  -- (6) the flat cone `M` is a punctured `m`-plane; `ν` is differentiable on the open `O ⊇ M`
  exact Submission.codim1_hcp_flat_cone_is_plane P m A₀ M ν hm2 hA₀ hne hMA h0 hM hcl hcone
    (fun x hx => (hνO.contDiffAt (hO.mem_nhds (hMO hx))).differentiableAt (by simp)) hν hflat

/-- **`Hᵐ` of a ball in an `m`-plane** (Simon Ch. 2, §1 and Ch. 3: `Hᵐ = Lᵐ` on `ℝᵐ`): if
`H₀ ⊆ ℝᴾ` is an `m`-dimensional linear subspace and `ρ > 0`, then `Hᵐ(H₀ ∩ B_ρ(0)) = ωₘρᵐ`.
An orthonormal basis of `H₀` gives a linear isometry `ι : ℝᵐ → ℝᴾ` onto `H₀` with
`ι(B_ρ(0)) = H₀ ∩ B_ρ(0)`; `μHE[m]` is preserved by isometries and equals `volume` on `ℝᵐ`, where
`volume (B_ρ(0)) = ρᵐ ωₘ`. -/
theorem Submission.codim1_subspace_ball_euclideanHausdorff : ∀ (P m : ℕ) (H₀ : Submodule ℝ (Euclid P)), Module.finrank ℝ H₀ = m → ∀ ρ : ℝ, 0 < ρ → μHE[m] ((H₀ : Set (Euclid P)) ∩ ball 0 ρ) = unitBallVolume m * ENNReal.ofReal (ρ ^ m) := by
  intro P m H₀ hm ρ hρ
  -- an orthonormal basis of `H₀` indexed by `Fin m` gives `e : H₀ ≃ₗᵢ ℝᵐ`, and
  -- `ι = e⁻¹ : ℝᵐ → H₀ ⊆ ℝᴾ` is a linear isometry onto `H₀`
  let e : H₀ ≃ₗᵢ[ℝ] Euclid m := ((stdOrthonormalBasis ℝ H₀).reindex (finCongr hm)).repr
  let ι : Euclid m →ₗᵢ[ℝ] Euclid P := H₀.subtypeₗᵢ.comp e.symm.toLinearIsometry
  have hι : ∀ a, ι a = (e.symm a : Euclid P) := fun a => rfl
  -- `ι(B_ρ(0)) = H₀ ∩ B_ρ(0)`
  have himage : ι '' ball 0 ρ = (H₀ : Set (Euclid P)) ∩ ball 0 ρ := by
    ext z
    constructor
    · rintro ⟨a, ha, rfl⟩
      refine ⟨by rw [hι]; exact (e.symm a).2, ?_⟩
      rw [mem_ball_zero_iff] at ha ⊢
      rwa [LinearIsometry.norm_map]
    · rintro ⟨hz, hzρ⟩
      refine ⟨e ⟨z, hz⟩, ?_, by rw [hι, LinearIsometryEquiv.symm_apply_apply]⟩
      rw [mem_ball_zero_iff] at hzρ ⊢
      rwa [LinearIsometryEquiv.norm_map]
  -- isometry invariance of `μHE[m]`, `μHE[m] = volume` on `ℝᵐ`, and Haar scaling of balls
  rw [← himage, ι.isometry.euclideanHausdorffMeasure_image,
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
    Measure.addHaar_ball_of_pos (volume : Measure (Euclid m)) 0 hρ, finrank_euclideanSpace_fin,
    unitBallVolume]
  exact mul_comm _ _

/-- **Simons' theorem** (Simon, Appendix B, B.2) for a minimizing hypercone `C` that is regular
with density one off the vertex: `Θᵐ(μ_C, 0) ≤ 1`.  `M = spt C ∖ {0}` is a multiplicity-one
oriented `C¹` cone with `C = [[M]]`, so `M_W(C) ≤ Hᵐ(M ∩ W)`, with equality when the right side
is finite.  Minimality of `C` makes `M` area-minimizing under deformations supported off `0`, and
for `2 ≤ m ≤ 6` Simons' theorem gives `M = H₀ ∖ {0}` for an `m`-plane `H₀`.  Hence
`M_{B_ρ(0)}(C) ≤ Hᵐ(H₀ ∩ B_ρ(0)) = ωₘρᵐ` (trivially if `M = ∅`), and the density ratio is `≤ 1`. -/
theorem Submission.codim1_simons_regular_cone_density : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) m) (A₀ : Submodule ℝ (Euclid P)), 2 ≤ m → m ≤ 6 → Module.finrank ℝ A₀ = m + 1 → IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → C.support ⊆ (A₀ : Set (Euclid P)) → (∀ y ∈ C.support, y ≠ 0 → y ∈ regularSet C ∧ HasMassDensity C y 1) → ∀ θ : ℝ, HasMassDensity C 0 θ → θ ≤ 1 := by
  intro P m C A₀ hm2 hm6 hA₀ hmin hbdry hcone hsptA hreg θ hθ
  have hm1 : 1 ≤ m := by omega
  -- `M = spt C ∖ {0}` is an embedded `C¹` cone oriented by `ξ`, of locally finite `Hᵐ`-measure,
  -- and `C(ω) = ∫_M ⟨ω, ξ⟩ dHᵐ` for every test form `ω`
  obtain ⟨ξ, hMsub, hξ, hMcone, hMfin, hrep⟩ :=
    Submission.codim1_cone_offvertex_unit_multiplicity_rep P m C hm1 hmin.1 hcone hreg
  set M : Set (Euclid P) := C.support \ {0}
  -- `spt C` is closed, so `M` is Borel
  have hsptC : IsClosed C.support := isClosed_univ.sdiff C.isOpen_zeroRegion
  have hMmeas : MeasurableSet M := hsptC.measurableSet.diff (measurableSet_singleton (0 : Euclid P))
  -- `Λₘ` is a normed space, hence pseudo-metrizable, so the orientation `ξ`, continuous on the
  -- Borel set `M`, is a.e. strongly measurable for `Hᵐ⌞M`
  have : TopologicalSpace.PseudoMetrizableSpace (MultiVector P m) :=
    @UniformSpace.pseudoMetrizableSpace (MultiVector P m) PseudoMetricSpace.toUniformSpace
      (@EMetric.instIsCountablyGeneratedUniformity (MultiVector P m)
        PseudoMetricSpace.toPseudoEMetricSpace)
  -- multiplicity `θ' ≡ 1`: `M_W(C) ≤ Hᵐ(M ∩ W)`, with equality when `Hᵐ(M ∩ W) < ∞`
  have hmass : ∀ W : Set (Euclid P), IsOpen W →
      C.massOn W ≤ μHE[m] (M ∩ W) ∧ (μHE[m] (M ∩ W) ≠ ∞ → C.massOn W = μHE[m] (M ∩ W)) := by
    intro W hW
    have h := Submission.codim1_massOn_eq_lintegral_of_oriented_rep P m univ univ M C
      (fun _ => 1) ξ isOpen_univ subset_rfl hMmeas (subset_univ M) measurable_const
      (fun _ => zero_le_one) (hξ.1.aestronglyMeasurable hMmeas)
      (ae_restrict_of_forall_mem hMmeas fun y hy => (hξ.2 y hy).imp fun _ hQ => hQ.2)
      (fun ω _ => by simpa only [one_mul] using hrep ω) W hW (subset_univ W)
    simpa only [ENNReal.ofReal_one, setLIntegral_one] using h
  -- `M_{B_ρ(0)}(C) ≤ ωₘρᵐ` for every `ρ > 0`
  have hball : ∀ ρ : ℝ, 0 < ρ →
      C.massOn (ball 0 ρ) ≤ unitBallVolume m * ENNReal.ofReal (ρ ^ m) := by
    intro ρ hρ
    refine (hmass (ball 0 ρ) isOpen_ball).1.trans ?_
    rcases M.eq_empty_or_nonempty with hM | hM
    · -- `M = ∅`: the mass of `C` near the vertex vanishes
      rw [hM, empty_inter, measure_empty]
      exact zero_le
    · -- minimality: `Hᵐ(M ∩ spt Z) ≤ Hᵐ((id + tZ)(M ∩ spt Z))` for small `|t|`, `0 ∉ spt Z`
      have hdef := Submission.codim1_minimizing_piece_area_comparison P m C {0}ᶜ M ξ hm1 hmin
        hbdry isOpen_compl_singleton (fun x hx => hx.2) hMsub hξ (fun K hK _ => hMfin K hK)
        (fun ω _ => hrep ω) (fun W hW _ hfin => ((hmass W hW).2 hfin).ge)
      -- Simons' theorem: `M = H₀ ∖ {0}` for an `m`-dimensional subspace `H₀ ⊆ A₀`
      obtain ⟨H₀, hH₀, hMH₀⟩ := Submission.codim1_deformation_minimal_hypercone_is_plane P m A₀
        M hm2 hm6 hA₀ hM (sdiff_subset.trans hsptA) (fun h => h.2 (mem_singleton _)) hMsub
        ((closure_minimal sdiff_subset hsptC).trans
          (subset_insert_sdiff_singleton (0 : Euclid P) C.support))
        hMcone ⟨ξ, hξ⟩ hMfin fun Z hZ hZc h0 => hdef Z hZ hZc (subset_compl_singleton_iff.mpr h0)
      -- `Hᵐ(M ∩ B_ρ(0)) ≤ Hᵐ(H₀ ∩ B_ρ(0)) = ωₘρᵐ`
      rw [← Submission.codim1_subspace_ball_euclideanHausdorff P m H₀ hH₀ ρ hρ, hMH₀]
      exact measure_mono (inter_subset_inter_left _ sdiff_subset)
  -- the density ratio `M_{B_ρ(0)}(C) / (ωₘρᵐ)` is `≤ 1` for every `ρ > 0`, so `θ ≤ 1`
  refine ENNReal.ofReal_le_one.mp (le_of_tendsto hθ.2 (eventually_nhdsWithin_of_forall
    fun ρ hρ => ENNReal.div_le_of_le_mul ?_))
  rw [one_mul]
  exact hball ρ hρ

/-- **Push-forward of the De Giorgi boundary through a graph chart** (Simon 7.5, steps 3–4 of the
local unit representation of `∂[[E]]`).  Let `G(v) = x + ιv + u(v)` on `D = B_{δ₁}(0)`, with `ι`
a linear isometry and `u ⊥ range ι` of class `C¹`, and let `(B, ν)` be De Giorgi data in `D`.
Then `M′ = G(B ∩ B_{δ₁/2}(0)) ⊆ Z₀` and `ξ′(w) = J(π w)⁻¹ ξ̃(π w)`, `π(w) = ι*(w − x)`, satisfy
`−∫_B ⟨Φ_ω, ν⟩ dHⁿ = ∫_{M′} ⟨ω, ξ′⟩ dHⁿ` for every `n`-form `ω` supported in `Z₀`; here
`ξ̃(v)(α) = −Σⱼ (−1)ʲ α(DG(v)e_{j.succAbove ·}) ⟨eⱼ, ν(v)⟩` and `J` is the Jacobian of the area
formula.  Since `ι*ι = id` and `ι*u = 0`, `π ∘ G = id` on `D`, so `G` is an injective `C¹`
immersion and the area formula applies.  For a.e. `v ∈ B` the normal orientation gives an
orthonormal frame `σ` of `ν(v)^⊥` with `ξ̃(v)(α) = α(DG(v)σ)`, so `J(v) = √det⟨DG(v)σᵢ, DG(v)σₖ⟩`
is positive and `J(v)⁻¹ ξ̃(v)` is a unit orientation.  Off `B_{δ₁/2}(0)`, `G(v) ∉ Z₀ ⊇ spt ω`. -/
theorem Submission.codim1_lur_gauss_green_pushforward : ∀ (P n : ℕ) (x : Euclid P) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid P) (u : Euclid (n + 1) → Euclid P) (δ₁ δ₂ : ℝ) (B : Set (Euclid (n + 1))) (ν : Euclid (n + 1) → Euclid (n + 1)), 1 ≤ n → 0 < δ₁ → ContDiffOn ℝ 1 u (ball 0 δ₁) → (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, (∀ w : Euclid (n + 1), inner ℝ (ι w) (u v) = 0) ∧ ‖u v‖ < δ₂) → MeasurableSet B → B ⊆ ball 0 δ₁ → CountablyRectifiable n B → (∀ K : Set (Euclid (n + 1)), IsCompact K → K ⊆ ball 0 δ₁ → μHE[n] (B ∩ K) ≠ ∞) → Measurable ν → (∀ y ∈ B, ‖ν y‖ = 1) → (∀ᵐ y ∂(μHE[n].restrict B), HasApproximateTangentSpaceAt n B y (Submodule.span ℝ {ν y})ᗮ) → ∃ (M' : Set (Euclid P)) (ξ' : Euclid P → MultiVector P n), MeasurableSet M' ∧ M' ⊆ {w : Euclid P | ‖ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x)‖ < δ₁ / 2 ∧ ‖w - x - ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x))‖ < δ₂} ∧ CountablyRectifiable n M' ∧ μHE[n] M' ≠ ∞ ∧ AEStronglyMeasurable ξ' (μHE[n].restrict M') ∧ (∀ᵐ w ∂(μHE[n].restrict M'), ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ' w) Q) ∧ ∀ ω : DifferentialForm (Euclid P) n, tsupport ω ⊆ {w : Euclid P | ‖ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x)‖ < δ₁ / 2 ∧ ‖w - x - ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x))‖ < δ₂} → -∫ v in B, inner ℝ ((ball (0 : Euclid (n + 1)) δ₁).indicator (fun v => ∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) * ω (x + ι v + u v) (fun k => fderiv ℝ (fun y => x + ι y + u y) v (EuclideanSpace.single (j.succAbove k) 1))) • EuclideanSpace.single j (1 : ℝ)) v) (ν v) ∂μHE[n] = ∫ w in M', ξ' w (ω w) ∂μHE[n] := by
  intro P n x ι u δ₁ δ₂ B ν hn hδ₁ hu hperp hB hBD hBrect hBfin hν hν1 htan
  -- Notation: `A = ι*`, `π(w) = A(w − x)`, and the chart `G(v) = x + ιv + u(v)` on `D`.
  set A : Euclid P →L[ℝ] Euclid (n + 1) := ContinuousLinearMap.adjoint ι.toContinuousLinearMap
    with hA_def
  set G : Euclid (n + 1) → Euclid P := fun y => x + ι y + u y with hG_def
  -- Step 1 (chart facts): `Aι = id` and `A u(v) = 0` on `D` (`u(v) ⊥ range ι`), so `π(G v) = v`
  -- and `G v − x − ιπ(G v) = u v`; `G` is `C¹` on `D`, injective there, with injective `DG(v)`.
  have hAι : ∀ v, A (ι v) = v := fun v =>
    ContinuousLinearMap.ext_iff.mp (LinearIsometry.adjoint_comp_self ι) v
  have hAu : ∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, A (u v) = 0 := by
    intro v hv
    refine ext_inner_right ℝ fun w => ?_
    rw [hA_def, ContinuousLinearMap.adjoint_inner_left, inner_zero_left, real_inner_comm]
    exact (hperp v hv).1 w
  have hπG : ∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, A (G v - x) = v := by
    intro v hv
    have h : G v - x = ι v + u v := by
      simp only [hG_def]
      abel
    rw [h, map_add, hAι, hAu v hv, add_zero]
  have hresG : ∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, G v - x - ι (A (G v - x)) = u v := by
    intro v hv
    rw [hπG v hv]
    simp only [hG_def]
    abel
  have hGC1 : ContDiffOn ℝ 1 G (ball 0 δ₁) := by
    rw [hG_def]
    exact (contDiffOn_const.add ι.contDiff.contDiffOn).add hu
  obtain ⟨hGinj, hGd, -⟩ :=
    Submission.dgce_left_inverse_chart_embedded (n + 1) P G A x δ₁ hGC1 hπG
  have hGc : ContinuousOn G B := hGC1.continuousOn.mono hBD
  have hGiB : InjOn G B := hGinj.mono hBD
  -- Step 2: the area formula for `G` on `B`, with the approximate tangent planes `ν^⊥`.
  obtain ⟨hR1, hR2, J, hJm, -, hR3, hR4, hR5⟩ :=
    Submission.codim1_lur_rectifiable_area_formula n (n + 1) P (ball 0 δ₁) B G
      (fun v => (Submodule.span ℝ {ν v})ᗮ) hn isOpen_ball hGC1 hGinj (fun v hv => (hGd v hv).2)
      hB hBD hBrect hBfin htan
  -- Step 3: `B′ = B ∩ B_{δ₁/2}(0)` and `M′ = G(B′)`, Borel by Lusin–Souslin.
  have hB'm : MeasurableSet (B ∩ ball (0 : Euclid (n + 1)) (δ₁ / 2)) :=
    hB.inter measurableSet_ball
  have hB'B : B ∩ ball (0 : Euclid (n + 1)) (δ₁ / 2) ⊆ B := inter_subset_left
  have hM'm : MeasurableSet (G '' (B ∩ ball (0 : Euclid (n + 1)) (δ₁ / 2))) :=
    hB'm.image_of_continuousOn_injOn (hGc.mono hB'B) (hGiB.mono hB'B)
  -- Step 4: the Borel field `ξ̃(v)(α) = −Σⱼ (−1)ʲ α(DG(v)e_{j.succAbove ·}) ⟨eⱼ, ν(v)⟩` and
  -- `ξ′(w) = J(π w)⁻¹ ξ̃(π w)`.
  obtain ⟨ξt, hξtm, hξt⟩ := Submission.codim1_pfr_normal_multivector_measurable P n G ν hν
  have hπm : Measurable fun w : Euclid P => A (w - x) :=
    (A.continuous.comp (continuous_sub_right x)).measurable
  obtain ⟨ξ', hξ'⟩ : ∃ ξ' : Euclid P → MultiVector P n,
      ∀ w, ξ' w = (J (A (w - x)))⁻¹ • ξt (A (w - x)) := ⟨_, fun _ => rfl⟩
  have hξ'm : StronglyMeasurable ξ' := by
    rw [show ξ' = fun w => (J (A (w - x)))⁻¹ • ξt (A (w - x)) from funext hξ']
    exact (hJm.comp hπm).inv.stronglyMeasurable.smul (hξtm.comp_measurable hπm)
  -- Step 5 (pointwise algebra): for a.e. `v ∈ B` the normal orientation gives an orthonormal
  -- frame `σ` of `ν(v)^⊥` with `ξ̃(v)(α) = α(DG(v)σ)`; then `J(v) = √det⟨DG(v)σᵢ, DG(v)σₖ⟩ > 0`
  -- and `J(v)⁻¹ ξ̃(v)` is a unit orientation of `span DG(v)σ`.
  have hgood : ∀ᵐ v ∂(μHE[n].restrict B),
      0 < J v ∧ ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf ((J v)⁻¹ • ξt v) Q := by
    filter_upwards [ae_restrict_mem hB, hR3] with v hvB hJv
    obtain ⟨σ, hσo, hσspan, hσβ⟩ :=
      Submission.codim1_lur_normal_covector_orientation n (ν v) hn (hν1 v hvB)
    have hlin : LinearIndependent ℝ fun i => fderiv ℝ G v (σ i) :=
      hσo.linearIndependent.map' (fderiv ℝ G v : Euclid (n + 1) →ₗ[ℝ] Euclid P)
        (LinearMap.ker_eq_bot.mpr (hGd v (hBD hvB)).2)
    obtain ⟨hdet, hunit⟩ := Submission.codim1_lur_normalized_wedge_orientation P n _ hlin
    have hJeq := hJv σ hσo hσspan
    refine ⟨by rw [hJeq]; exact Real.sqrt_pos.mpr hdet, _, hunit _ fun α => ?_⟩
    -- `ξ̃(v)(α) = α(DG(v)σ)`: the normal orientation for `β = α ∘ DG(v)`
    rw [smul_apply, smul_eq_mul, hJeq]
    congr 1
    rw [hξt]
    exact (hσβ (α.compContinuousLinearMap (fderiv ℝ G v))).symm
  -- Step 6: unit orientations `Hⁿ`-a.e. on `M′`, by transferring step 5 through `G`.
  have horient := Submission.codim1_pfr_ae_transfer_to_image n (n + 1) P B
    (B ∩ ball (0 : Euclid (n + 1)) (δ₁ / 2)) G J
    (fun v => ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf ((J v)⁻¹ • ξt v) Q) hB hB'm hB'B
    hGc hGiB hR4 (hgood.mono fun v hv => hv.2)
  refine ⟨G '' (B ∩ ball (0 : Euclid (n + 1)) (δ₁ / 2)), ξ', hM'm, ?_,
    hR1.mono (image_mono hB'B), ?_, hξ'm.aestronglyMeasurable, ?_, ?_⟩
  · -- `M′ ⊆ Z₀`: `π(G v) = v` and `G v − x − ιπ(G v) = u v`.
    rintro _ ⟨v, ⟨hvB, hv2⟩, rfl⟩
    have hvD : v ∈ ball (0 : Euclid (n + 1)) δ₁ := hBD hvB
    rw [mem_ofPred_eq, hresG v hvD, hπG v hvD]
    exact ⟨mem_ball_zero_iff.mp hv2, (hperp v hvD).2⟩
  · -- `Hⁿ(M′) < ∞`: `M′ ⊆ G(B ∩ K)` for the compact `K = B̄_{δ₁/2}(0) ⊆ D`.
    exact ne_top_of_le_ne_top
      (hR2 _ (isCompact_closedBall 0 _) (closedBall_subset_ball (half_lt_self hδ₁)))
      (measure_mono (image_mono (inter_subset_inter_right B ball_subset_closedBall)))
  · filter_upwards [horient] with w hw
    obtain ⟨v, hvB', rfl, hv⟩ := hw
    rw [hξ', hπG v (hBD hvB'.1)]
    exact hv
  · -- Step 7: `−⟨Φ_ω, ν⟩ = 1_{B′} J · (ξ′(ω) ∘ G)` a.e. on `B`, then change variables.
    intro ω hω
    rw [← integral_neg]
    refine Submission.codim1_pfr_setIntegral_image_transfer n (n + 1) P B
      (B ∩ ball (0 : Euclid (n + 1)) (δ₁ / 2)) G J _ (fun w => ξ' w (ω w)) hB hB'm hB'B hGc hGiB
      hR5 ?_
    filter_upwards [ae_restrict_mem hB, hgood] with v hvB hv
    have hvD : v ∈ ball (0 : Euclid (n + 1)) δ₁ := hBD hvB
    -- `−⟨Φ_ω(v), ν(v)⟩ = ξ̃(v)(ω(G v))` on `D`
    refine (?_ : _ = ξt v (ω (G v))).trans ?_
    · rw [indicator_of_mem hvD, hξt, sum_inner]
      simp only [real_inner_smul_left, hG_def]
    · by_cases hvB' : v ∈ B ∩ ball (0 : Euclid (n + 1)) (δ₁ / 2)
      · rw [indicator_of_mem hvB', hξ', hπG v hvD, smul_apply, smul_eq_mul,
          ← mul_assoc, mul_inv_cancel₀ hv.1.ne', one_mul]
      · -- off `B′`, `|π(G v)| = |v| ≥ δ₁/2`, so `G v ∉ Z₀ ⊇ tsupport ω` and `ω(G v) = 0`
        have hGv : G v ∉ tsupport ω := fun h => by
          have h1 := (hω h).1
          rw [hπG v hvD] at h1
          exact hvB' ⟨hvB, mem_ball_zero_iff.mpr h1⟩
        rw [indicator_of_notMem hvB', image_eq_zero_of_notMem_tsupport hGv, map_zero]

/-- **Simon 7.5.2 (Remark)**, via Ch. 6, 2.35 and De Giorgi (Ch. 3, 4.3): near any `x ∈ N ∩ U`,
the boundary `T = ∂[[E]]` is a multiplicity-one current.  Over the graph chart
`G(v) = x + ιv + u(v)` of `N` on `D = B_{δ₁}(0) ⊆ ℝⁿ⁺¹`, the set `F = D ∩ G⁻¹(E)` has locally
finite perimeter in `D`, and De Giorgi gives its reduced boundary `B` with unit normal `ν`.  Put
`π(w) = ι*(w − x)` and `Z₀ = {‖π(w)‖ < δ₁/2, ‖w − x − ιπ(w)‖ < δ₂} ⊆ B̄_{δ₁+δ₂}(x) ⊆ U`, and let
`Φ_ω` be the vector field of `G^#ω`.  If `spt ω ⊆ Z₀`, then
`T(ω) = ∫_F div Φ_ω = −∫_B ⟨Φ_ω, ν⟩ dHⁿ = ∫_{M'} ⟨ω, ξ'⟩ dHⁿ`, where `M' ⊆ Z₀` and `ξ'` are the
push-forwards along `G` of `B ∩ B_{δ₁/2}(0)` and of the orientation of `ν^⊥`. -/
theorem Submission.codim1_rdo_local_unit_representation : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n) (x : Euclid P), 1 ≤ n → IsOpen U → InClassO n U N ξN → MeasurableSet E → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN → IsIntegerMultiplicity T → x ∈ N ∩ U → ∃ (Z₀ M' : Set (Euclid P)) (ξ' : Euclid P → MultiVector P n), IsOpen Z₀ ∧ x ∈ Z₀ ∧ Z₀ ⊆ U ∧ MeasurableSet M' ∧ M' ⊆ Z₀ ∧ CountablyRectifiable n M' ∧ μHE[n] M' ≠ ∞ ∧ AEStronglyMeasurable ξ' (μHE[n].restrict M') ∧ (∀ᵐ w ∂(μHE[n].restrict M'), ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ' w) Q) ∧ ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ Z₀ → T ω = ∫ w in M', ξ' w ((ω : DifferentialForm (Euclid P) n) w) ∂μHE[n] := by
  intro P n U N E ξN T x hn hU hN hE hEN hT hIM hx
  -- Step 0: the graph chart `G(v) = x + ιv + u(v)` of `N` near `x`, over `D = B_{δ₁}(0)`
  obtain ⟨ι, u, δ₁, δ₂, hδ₁, hδ₂, hball, -, hu, hchart, hgraph⟩ :=
    Submission.codim1_rdo_graph_chart P n U N ξN x hU hN.1 hN.2.1 hx
  -- Step 2: `F = D ∩ G⁻¹(E)` is Borel with locally finite perimeter in `D`
  obtain ⟨hF, hper⟩ := Submission.codim1_lur_chart_locally_finite_perimeter P n U N E ξN T x ι u
    δ₁ δ₂ hE hEN hT hIM hδ₁ hδ₂ hball hu hchart hgraph
  -- Step 3: De Giorgi: `∫_F div φ = −∫_B ⟨φ, ν⟩ dHⁿ` for `φ ∈ C¹_c(D)`
  obtain ⟨B, ν, hB, hBD, hBrect, hBfin, hν, hν1, hνtan, hGG⟩ :=
    Submission.codim1_rdo_de_giorgi_gauss_green n (ball 0 δ₁) _ hn isOpen_ball hF hper
  -- Step 4: push `B ∩ B_{δ₁/2}(0)` forward along `G` to the carrier `M'`
  obtain ⟨M', ξ', hM', hM'Z₀, hM'rect, hM'fin, hξ', hξ'or, hrep⟩ :=
    Submission.codim1_lur_gauss_green_pushforward P n x ι u δ₁ δ₂ B ν hn hδ₁
      (hu.of_le (by norm_num))
      (fun v hv => ⟨(hchart v hv).1, (hchart v hv).2.2.1.trans (half_lt_self hδ₂)⟩)
      hB hBD hBrect hBfin hν hν1 hνtan
  refine ⟨{w | ‖ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x)‖ < δ₁ / 2 ∧
      ‖w - x - ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x))‖ < δ₂},
    M', ξ', ?_, ?_, ?_, hM', hM'Z₀, hM'rect, hM'fin, hξ', hξ'or, fun ω hω => ?_⟩
  · -- `Z₀` is open
    have hπ : Continuous fun w => ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x) :=
      (ContinuousLinearMap.adjoint ι.toContinuousLinearMap).continuous.comp
        (continuous_id.sub continuous_const)
    exact (isOpen_lt (continuous_norm.comp hπ) continuous_const).inter
      (isOpen_lt (continuous_norm.comp ((continuous_id.sub continuous_const).sub
        (ι.continuous.comp hπ))) continuous_const)
  · -- `x ∈ Z₀`
    simp [half_pos hδ₁, hδ₂]
  · -- `Z₀ ⊆ B̄_{δ₁+δ₂}(x) ⊆ U`, since `‖w − x‖ ≤ ‖ιπ(w)‖ + ‖w − x − ιπ(w)‖`
    intro w hw
    refine hball (mem_closedBall_iff_norm.2 ?_)
    calc ‖w - x‖ = ‖ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x)) +
          (w - x - ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x)))‖ := by
          rw [add_sub_cancel]
      _ ≤ ‖ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x))‖ +
          ‖w - x - ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x))‖ :=
          norm_add_le _ _
      _ ≤ δ₁ + δ₂ := by
          rw [ι.norm_map]
          linarith [hw.1, hw.2]
  · -- Steps 1, 3, 4: `T(ω) = ∫_F div Φ_ω = −∫_B ⟨Φ_ω, ν⟩ dHⁿ = ∫_{M'} ⟨ω, ξ'⟩ dHⁿ`
    obtain ⟨hΦ, hΦc, hΦD, hTω⟩ := Submission.codim1_lur_chart_divergence_formula P n U N E ξN T
      x ι u δ₁ δ₂ hE hEN hT hδ₁ hδ₂ hu hchart hgraph ω _
      (hω.trans fun w hw => ⟨hw.1.trans (half_lt_self hδ₁), hw.2⟩) rfl
    rw [hTω, hGG _ hΦ hΦc hΦD]
    exact hrep _ hω

/-- **Simon 7.5.2 (‡)** (chapter-07.txt lines 757–770; Ch. 6, 2.35; Ch. 3, 1.8(2)–1.9 and 4.3):
if `T = ∂[[E]]` in `U` (`N ∈ 𝒪`, `E ⊆ N ∩ U`) is integer multiplicity, then the points `y` with
`Θⁿ(μ_T, y) = 1` are dense in `spt T`.  Let `x ∈ spt T ⊆ U ∩ N` and `ρ > 0`.  Near `x`, `T` is
the multiplicity-one current `[[M']]` of a countably `n`-rectifiable `M' ⊆ Z₀` with
`Hⁿ(M') < ∞` (graph chart of `N` over `TₓN`, De Giorgi's structure theorem for `G⁻¹(E)`), so
`M_W(T) = Hⁿ(M' ∩ W)` for open `W ⊆ Z₀`, and `Θⁿ(μ_T, y) = 1` wherever `M'` has density one,
i.e. `Hⁿ`-a.e. on `M'`.  `W' = Z₀ ∩ B_ρ(x)` is an open neighbourhood of `x ∈ spt T`, so
`Hⁿ(M' ∩ W') = M_{W'}(T) > 0` and some `y ∈ M' ∩ W'` has `Θⁿ(μ_T, y) = 1`; positive density
forces `y ∈ spt T`. -/
theorem Submission.codim1_region_density_one_dense : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n), 1 ≤ n → IsOpen U → InClassO n U N ξN → MeasurableSet E → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN → IsIntegerMultiplicity T → ∀ x ∈ T.support, ∀ ρ : ℝ, 0 < ρ → ∃ y ∈ T.support ∩ ball x ρ, HasMassDensity T y 1 := by
  intro P n U N E ξN T hn hU hO hE hEU hT hIM x hx ρ hρ
  -- `x ∈ spt T ⊆ U ∩ N`
  obtain ⟨-, hspt, -⟩ := Submission.codim1_region_support_cycle P n U N E ξN T hU hO hEU hT
  obtain ⟨hxU, hxN⟩ := hspt hx
  -- near `x`, `T = [[M']]`: `T(ω) = ∫_{M'} ⟨ω, ξ'⟩ dHⁿ` whenever `spt ω ⊆ Z₀`
  obtain ⟨Z₀, M', ξ', hZ₀, hxZ₀, hZ₀U, hM', hM'Z₀, hM'rect, hM'fin, hξ', hξ'Q, hrep⟩ :=
    Submission.codim1_rdo_local_unit_representation P n U N E ξN T x hn hU hO hE hEU hT hIM
      ⟨hxN, hxU⟩
  -- `M_W(T) = Hⁿ(M' ∩ W)` for open `W ⊆ Z₀` (multiplicity `θ' ≡ 1`; finite as `Hⁿ(M') < ∞`)
  have hmass : ∀ W : Set (Euclid P), IsOpen W → W ⊆ Z₀ → T.massOn W = μHE[n] (M' ∩ W) := by
    intro W hW hWZ₀
    have h := (Submission.codim1_massOn_eq_lintegral_of_oriented_rep P n U Z₀ M' T (fun _ => 1)
      ξ' hZ₀ hZ₀U hM' hM'Z₀ measurable_const (fun _ => zero_le_one) hξ' hξ'Q
      (fun ω hω => by simpa only [one_mul] using hrep ω hω) W hW hWZ₀).2
    simp only [ENNReal.ofReal_one, setLIntegral_one] at h
    exact h (measure_ne_top_of_subset inter_subset_left hM'fin)
  -- `W' = Z₀ ∩ B_ρ(x)` is an open neighbourhood of `x ∈ spt T`, so `Hⁿ(M' ∩ W') = M_{W'}(T) > 0`
  have hW' : IsOpen (Z₀ ∩ ball x ρ) := hZ₀.inter isOpen_ball
  have hpos : μHE[n] (M' ∩ (Z₀ ∩ ball x ρ)) ≠ 0 := by
    rw [← hmass _ hW' inter_subset_left]
    exact (Submission.codim1_rdo_massOn_pos_of_mem_support P n U _ T x hU hW'
      ⟨hxZ₀, mem_ball_self hρ⟩ hx).ne'
  -- `M'` has density one `Hⁿ`-a.e., and `Hⁿ⌞(M' ∩ W') ≠ 0`, so some such point lies in `W'`
  have := ae_neBot.mpr (mt Measure.restrict_eq_zero.mp hpos)
  obtain ⟨y, ⟨-, hyZ₀, hyx⟩, hy⟩ := ((ae_restrict_mem (hM'.inter hW'.measurableSet)).and
    ((Submission.codim1_rdo_rectifiable_ae_density_one P n M' hn hM' hM'rect hM'fin).filter_mono
      (ae_mono (Measure.restrict_mono inter_subset_left le_rfl)))).exists
  -- `Θⁿ(μ_T, y) = 1`: `M_{B_t(y)}(T) = Hⁿ(M' ∩ B_t(y))` once `B_t(y) ⊆ Z₀`
  obtain ⟨ε, hε, hεZ₀⟩ := Metric.isOpen_iff.mp hZ₀ y hyZ₀
  have hdens : HasMassDensity T y 1 := by
    refine ⟨zero_le_one, ?_⟩
    rw [ENNReal.ofReal_one]
    refine hy.congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hε] with t ht
    rw [hmass (ball y t) isOpen_ball ((ball_subset_ball ht.2.le).trans hεZ₀)]
  -- positive density forces `y ∈ spt T`
  exact ⟨y, ⟨Submission.codim1_rdo_density_pos_mem_support P n U T y 1 (hZ₀U hyZ₀) one_pos hdens,
    hyx⟩, hdens⟩

/-- **Lemma A-plane** (Simon 7.5, class `𝒪`, p. 197; used for the zero-scale limits of
7.5.3–7.5.5).  If `ξ` is a unit orientation of the subspace `Q ⊆ ℝᴾ`, then `dim Q = n + 1` and the
offset plane `A = Q − a = {y : y + a ∈ Q}`, oriented by the constant `ξ`, is in class `𝒪` of `ℝᴾ`.
The orthonormal `τ` of `ξ` is linearly independent and spans `Q`, so `dim Q = n + 1`; `A` is an
embedded `C²` `(n + 1)`-submanifold, and `T_yA = Q` for `y ∈ A`, so the constant `ξ` orients `A`;
`A` is closed (the preimage of the finite-dimensional, hence closed, `Q`) and contains `−a`. -/
theorem Submission.codim1_zsl_offset_plane_inClassO : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P (n + 1)) (a : Euclid P), IsUnitOrientationOf ξ Q → Module.finrank ℝ Q = n + 1 ∧ InClassO n (univ : Set (Euclid P)) {y | y + a ∈ Q} (fun _ => ξ) := by
  intro P n Q ξ a hξ
  obtain ⟨τ, hτ, hspan, -⟩ := id hξ
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  -- `dim Q = n + 1`: `τ` is a basis of `Q`
  · rw [← hspan, finrank_span_eq_card hτ.linearIndependent, Fintype.card_fin]
  -- `A` is an embedded `C²` `(n + 1)`-submanifold
  · exact Submission.codim1_zsl_op_translate_isEmbeddedSubmanifold P (n + 1) 2 Q τ a hτ hspan
  -- the constant `ξ` orients `A`, as `T_yA = Q` for every `y ∈ A`
  · exact ⟨continuousOn_const, fun y hy =>
      ⟨Q, (Submission.codim1_zsl_op_translate_tangentSpace_eq P Q a y hy).symm, hξ⟩⟩
  -- `A` is closed, so `closure A \ A = ∅`
  · have hA : IsClosed {y : Euclid P | y + a ∈ Q} :=
      Q.closed_of_finiteDimensional.preimage (continuous_add_const a)
    rw [hA.closure_eq, Set.sdiff_self, empty_inter]
  -- `−a ∈ A`
  · exact ⟨-a, show -a + a ∈ Q by rw [neg_add_cancel]; exact Q.zero_mem, mem_univ _⟩
theorem Submission.dgcr_bwd_graph_pullback_extDeriv : ∀ (m k : ℕ) (ι : Euclid (m + 1) →ₗᵢ[ℝ] Euclid (m + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (m + 1 + k)) (u : Euclid (m + 1) → Euclid k) (z : Euclid (m + 1 + k)) (ψ : DifferentialForm (Euclid (m + 1)) m) (v : Euclid (m + 1)), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → IsSmoothForm ψ → DifferentiableAt ℝ u v → exteriorDerivative (affinePullbackForm (ContinuousLinearMap.adjoint ι.toContinuousLinearMap) (-(ContinuousLinearMap.adjoint ι.toContinuousLinearMap z)) ψ) (z + ι v + ι' (u v)) (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ))) = exteriorDerivative ψ v (fun i => EuclideanSpace.single i (1 : ℝ)) := by
  intro m k ι ι' u z ψ v hperp hψ hu
  -- `L := ι*` is a left inverse of `ι` and annihilates the orthogonal factor `ι'`.
  have hLι : ∀ v', ContinuousLinearMap.adjoint ι.toContinuousLinearMap (ι v') = v' := by
    intro v'
    apply ext_inner_right ℝ
    intro y
    rw [ContinuousLinearMap.adjoint_inner_left]
    exact ι.inner_map_map v' y
  have hLι' : ∀ w, ContinuousLinearMap.adjoint ι.toContinuousLinearMap (ι' w) = 0 := by
    intro w
    apply ext_inner_right ℝ
    intro y
    rw [ContinuousLinearMap.adjoint_inner_left, inner_zero_left, real_inner_comm]
    exact hperp y w
  -- Chain rule for the graph map `Φ v = z + ι v + ι' (u v)`.
  have hD : fderiv ℝ (fun v => z + ι v + ι' (u v)) v =
      ι.toContinuousLinearMap + ι'.toContinuousLinearMap.comp (fderiv ℝ u v) := by
    have hι : HasFDerivAt (fun v => ι v) ι.toContinuousLinearMap v :=
      ι.toContinuousLinearMap.hasFDerivAt
    have hι' : HasFDerivAt (fun v => ι' (u v)) (ι'.toContinuousLinearMap.comp (fderiv ℝ u v)) v :=
      ι'.toContinuousLinearMap.hasFDerivAt.comp v hu.hasFDerivAt
    have h1 := ((hasFDerivAt_const z v).add hι).add hι'
    rw [zero_add] at h1
    exact h1.fderiv
  -- `d` commutes with the affine pull-back; the base point is `v` and the frame is `eᵢ`.
  rw [exteriorDerivative_affinePullbackForm _ _ hψ]
  simp only [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply]
  congr 1
  · simp [map_add, hLι, hLι']
  · funext i
    simp [hD, hLι, hLι']

theorem Submission.codim1_zsl_fl_divergence_lift : ∀ (n k : ℕ) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ y : Euclid (n + 1 + k), ∃ v w, y = ι v + ι' w) → ∃ K : ℝ, 0 < K ∧ ∀ h R : ℝ, 0 < h → ∀ φ : Euclid (n + 1) → Euclid (n + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ ball 0 R → (∀ v, ‖φ v‖ ≤ 1) → ∃ ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n, tsupport (ω : DifferentialForm (Euclid (n + 1 + k)) n) ⊆ ball 0 (R + 2 * h) ∧ (∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid (n + 1 + k)) n) y) ≤ 1) ∧ ∀ (g : Euclid (n + 1) → Euclid k) (v : Euclid (n + 1)), DifferentiableAt ℝ g v → ‖g v‖ < h → exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n) (ι v + ι' (g v)) (fun j => fderiv ℝ (fun w => ι w + ι' (g w)) v (EuclideanSpace.single j (1 : ℝ))) = K⁻¹ * LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ v).toLinearMap := by
  intro n k ι ι' hperp hspan
  classical
  set π : Euclid (n + 1 + k) →L[ℝ] Euclid (n + 1) :=
    ContinuousLinearMap.adjoint ι.toContinuousLinearMap with hπeq
  set π' : Euclid (n + 1 + k) →L[ℝ] Euclid k :=
    ContinuousLinearMap.adjoint ι'.toContinuousLinearMap with hπ'eq
  have hπι : ∀ v, π (ι v) = v := by
    intro v
    apply ext_inner_right ℝ
    intro y
    rw [hπeq, ContinuousLinearMap.adjoint_inner_left]
    exact ι.inner_map_map v y
  have hπι' : ∀ w, π (ι' w) = 0 := by
    intro w
    apply ext_inner_right ℝ
    intro y
    rw [hπeq, ContinuousLinearMap.adjoint_inner_left, inner_zero_left, real_inner_comm]
    exact hperp y w
  have hπ'ι' : ∀ w, π' (ι' w) = w := by
    intro w
    apply ext_inner_right ℝ
    intro y
    rw [hπ'eq, ContinuousLinearMap.adjoint_inner_left]
    exact ι'.inner_map_map w y
  have hπ'ι : ∀ v, π' (ι v) = 0 := by
    intro v
    apply ext_inner_right ℝ
    intro y
    rw [hπ'eq, ContinuousLinearMap.adjoint_inner_left, inner_zero_left]
    exact hperp v y
  have hnorm_le : ∀ y, ‖y‖ ≤ ‖π y‖ + ‖π' y‖ := by
    intro y
    obtain ⟨v, w, rfl⟩ := hspan y
    simp only [map_add, hπι, hπι', hπ'ι', hπ'ι, add_zero, zero_add]
    calc ‖ι v + ι' w‖ ≤ ‖ι v‖ + ‖ι' w‖ := norm_add_le _ _
      _ = ‖v‖ + ‖w‖ := by rw [LinearIsometry.norm_map, LinearIsometry.norm_map]
  choose β hβ using Submission.dgcr_bwd_coordinate_covector n
  let Θ : Euclid (n + 1) →L[ℝ] Covector (Euclid (n + 1)) n :=
    ∑ j : Fin (n + 1), (EuclideanSpace.proj j : Euclid (n + 1) →L[ℝ] ℝ).smulRight (β j)
  have hΘe : ∀ (z : Euclid (n + 1)) (i : Fin (n + 1)),
      Θ z (i.removeNth (fun l : Fin (n + 1) => EuclideanSpace.single l (1 : ℝ))) =
        (-1 : ℝ) ^ (i : ℕ) * z i := by
    intro z i
    have hΘz : Θ z = ∑ j, z j • β j := by simp [Θ]
    rw [hΘz, ContinuousAlternatingMap.sum_apply]
    simp only [ContinuousAlternatingMap.smul_apply, smul_eq_mul]
    rw [Finset.sum_eq_single i]
    · rw [hβ i i, ite_eq_left rfl]
      ring
    · intro j _ hji
      rw [hβ j i, ite_eq_right (Ne.symm hji), mul_zero]
    · intro hi
      exact absurd (Finset.mem_univ i) hi
  set N : ℝ := (Fintype.card (Fin n → Fin (n + 1 + k)) : ℝ) with hN
  set K : ℝ := Real.sqrt N * ‖Θ‖ * ‖π‖ ^ n + 1 with hK
  have hKpos : 0 < K := by positivity
  refine ⟨K, hKpos, ?_⟩
  intro h R hh φ hφ hφc hφs hφn
  let f : ContDiffBump (0 : Euclid k) := ⟨h, 2 * h, hh, by linarith⟩
  let α : DifferentialForm (Euclid (n + 1)) n := fun v => Θ (φ v)
  have hαsmooth : IsSmoothForm α := Θ.contDiff.comp hφ
  let ω₀ : DifferentialForm (Euclid (n + 1 + k)) n := fun y =>
    (K⁻¹ * f (π' y)) • affinePullbackForm π (-(π 0)) α y
  have hω₀smooth : IsSmoothForm ω₀ := by
    have h1 : ContDiff ℝ (⊤ : ℕ∞) (fun y => K⁻¹ * f (π' y)) :=
      contDiff_const.mul (f.contDiff.comp π'.contDiff)
    have h2 : ContDiff ℝ (⊤ : ℕ∞) (affinePullbackForm π (-(π 0)) α) :=
      affinePullbackForm_isSmoothForm π _ hαsmooth
    exact h1.smul h2
  set Q : Set (Euclid (n + 1 + k)) := {y | π y ∈ tsupport φ ∧ ‖π' y‖ ≤ 2 * h} with hQ
  have hQclosed : IsClosed Q :=
    ((isClosed_tsupport φ).preimage π.continuous).inter
      (isClosed_le (continuous_norm.comp π'.continuous) continuous_const)
  have hsuppQ : support ω₀ ⊆ Q := by
    intro y hy
    by_contra hyQ
    apply hy
    simp only [hQ, Set.mem_ofPred_eq, not_and_or, not_le] at hyQ
    rcases hyQ with h1 | h1
    · have h0 : φ (π y) = 0 := image_eq_zero_of_notMem_tsupport h1
      have hP : affinePullbackForm π (-(π 0)) α y = 0 := by
        ext m
        simp [affinePullbackForm, α, h0]
      show (K⁻¹ * f (π' y)) • affinePullbackForm π (-(π 0)) α y = 0
      rw [hP, smul_zero]
    · have h0 : f (π' y) = 0 := by
        rw [← Function.notMem_support, f.support_eq]
        simp only [mem_ball, dist_zero_right, not_lt]
        exact h1.le
      simp [ω₀, h0]
  have htsuppQ : tsupport ω₀ ⊆ Q := closure_minimal hsuppQ hQclosed
  have hQball : Q ⊆ ball 0 (R + 2 * h) := by
    rintro y ⟨hy1, hy2⟩
    have := hφs hy1
    rw [mem_ball, dist_zero_right] at this ⊢
    linarith [hnorm_le y]
  have hcpt : HasCompactSupport ω₀ :=
    (isCompact_closedBall (0 : Euclid (n + 1 + k)) (R + 2 * h)).of_isClosed_subset
      (isClosed_tsupport _) (htsuppQ.trans (hQball.trans ball_subset_closedBall))
  let ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n := ⟨ω₀, ⟨hω₀smooth, hcpt⟩, subset_univ _⟩
  refine ⟨ω, htsuppQ.trans hQball, ?_, ?_⟩
  · -- comass bound
    intro y
    change covectorEuclideanNorm (ω₀ y) ≤ 1
    have hM : ∀ I : Fin n → Fin (n + 1 + k),
        |ω₀ y (fun i => EuclideanSpace.basisFun (Fin (n + 1 + k)) ℝ (I i))| ≤
          K⁻¹ * (‖Θ‖ * ‖π‖ ^ n) := by
      intro I
      simp only [ω₀, ContinuousAlternatingMap.smul_apply, smul_eq_mul, affinePullbackForm,
        ContinuousAlternatingMap.compContinuousLinearMap_apply]
      rw [abs_mul]
      have hζ : |K⁻¹ * f (π' y)| ≤ K⁻¹ := by
        rw [abs_of_nonneg (mul_nonneg (inv_nonneg.2 hKpos.le) f.nonneg)]
        exact mul_le_of_le_one_right (inv_nonneg.2 hKpos.le) f.le_one
      have hα : |α (-(π 0) + π y) (π ∘ fun i => EuclideanSpace.basisFun (Fin (n + 1 + k)) ℝ (I i))| ≤
          ‖Θ‖ * ‖π‖ ^ n := by
        rw [← Real.norm_eq_abs]
        calc _ ≤ ‖α (-(π 0) + π y)‖ *
              ∏ i, ‖(π ∘ fun i => EuclideanSpace.basisFun (Fin (n + 1 + k)) ℝ (I i)) i‖ :=
              ContinuousAlternatingMap.le_opNorm _ _
          _ ≤ ‖Θ‖ * ∏ _i : Fin n, ‖π‖ := by
              gcongr with i
              · calc ‖Θ (φ (-(π 0) + π y))‖ ≤ ‖Θ‖ * ‖φ (-(π 0) + π y)‖ := Θ.le_opNorm _
                  _ ≤ ‖Θ‖ * 1 := by gcongr; exact hφn _
                  _ = ‖Θ‖ := mul_one _
              · calc ‖π (EuclideanSpace.basisFun (Fin (n + 1 + k)) ℝ (I i))‖
                    ≤ ‖π‖ * ‖EuclideanSpace.basisFun (Fin (n + 1 + k)) ℝ (I i)‖ := π.le_opNorm _
                  _ = ‖π‖ := by simp
          _ = ‖Θ‖ * ‖π‖ ^ n := by simp
      exact mul_le_mul hζ hα (abs_nonneg _) (inv_nonneg.2 hKpos.le)
    have hsum : (∑ I : Fin n → Fin (n + 1 + k), if StrictMono I then
        (ω₀ y (fun i => EuclideanSpace.basisFun (Fin (n + 1 + k)) ℝ (I i))) ^ 2 else 0) ≤ 1 := by
      calc _ ≤ ∑ _I : Fin n → Fin (n + 1 + k), (K⁻¹ * (‖Θ‖ * ‖π‖ ^ n)) ^ 2 := by
            apply Finset.sum_le_sum
            intro I _
            split_ifs
            · exact sq_le_sq' (abs_le.1 (hM I)).1 (abs_le.1 (hM I)).2
            · positivity
        _ = (Real.sqrt N * (K⁻¹ * (‖Θ‖ * ‖π‖ ^ n))) ^ 2 := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← hN, mul_pow (Real.sqrt N),
              Real.sq_sqrt (by positivity)]
        _ ≤ 1 ^ 2 := by
            gcongr
            rw [← mul_assoc, mul_comm (Real.sqrt N), mul_assoc, ← mul_assoc (Real.sqrt N),
              inv_mul_le_one₀ hKpos]
            linarith
        _ = 1 := one_pow 2
    unfold covectorEuclideanNorm
    calc _ ≤ Real.sqrt 1 := Real.sqrt_le_sqrt hsum
      _ = 1 := Real.sqrt_one
  · -- key identity
    intro g v hg hgv
    have hy₀ : π' (ι v + ι' (g v)) = g v := by simp [map_add, hπ'ι, hπ'ι']
    have hev : ω₀ =ᶠ[𝓝 (ι v + ι' (g v))] K⁻¹ • affinePullbackForm π (-(π 0)) α := by
      have hopen : IsOpen {y : Euclid (n + 1 + k) | ‖π' y‖ < h} :=
        isOpen_lt (continuous_norm.comp π'.continuous) continuous_const
      have hmem : ι v + ι' (g v) ∈ {y : Euclid (n + 1 + k) | ‖π' y‖ < h} := by
        simpa [hy₀] using hgv
      filter_upwards [hopen.mem_nhds hmem] with y hy
      have h1 : f (π' y) = 1 :=
        f.one_of_mem_closedBall (by simpa [mem_closedBall, dist_zero_right] using hy.le)
      simp [ω₀, h1]
    change exteriorDerivative ω₀ (ι v + ι' (g v)) _ = _
    rw [show exteriorDerivative ω₀ (ι v + ι' (g v)) =
        exteriorDerivative (K⁻¹ • affinePullbackForm π (-(π 0)) α) (ι v + ι' (g v)) from
        hev.extDeriv_eq, exteriorDerivative_smul]
    simp only [Pi.smul_apply, ContinuousAlternatingMap.smul_apply, smul_eq_mul]
    congr 1
    have h3 := Submission.dgcr_bwd_graph_pullback_extDeriv n k ι ι' g 0 α v hperp hαsmooth hg
    simp only [zero_add] at h3
    rw [h3]
    have hφd : DifferentiableAt ℝ φ v := (hφ.differentiable (by simp)).differentiableAt
    rw [exteriorDerivative_apply (hαsmooth.differentiable (by simp)).differentiableAt]
    have hfun : ∀ i : Fin (n + 1), (fun x => α x (i.removeNth
        (fun l : Fin (n + 1) => EuclideanSpace.single l (1 : ℝ)))) =
          fun x => (-1 : ℝ) ^ (i : ℕ) * φ x i := by
      intro i
      funext x
      exact hΘe (φ x) i
    simp only [hfun]
    have hder : ∀ i : Fin (n + 1), fderiv ℝ (fun x => (-1 : ℝ) ^ (i : ℕ) * φ x i) v
        (EuclideanSpace.single i (1 : ℝ)) =
          (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ φ v (EuclideanSpace.single i (1 : ℝ))) i := by
      intro i
      have hp : HasFDerivAt (fun x => φ x i)
          ((EuclideanSpace.proj i : Euclid (n + 1) →L[ℝ] ℝ).comp (fderiv ℝ φ v)) v :=
        (EuclideanSpace.proj i : Euclid (n + 1) →L[ℝ] ℝ).hasFDerivAt.comp v hφd.hasFDerivAt
      rw [(hp.const_mul ((-1 : ℝ) ^ (i : ℕ))).fderiv]
      simp
    simp only [hder]
    rw [LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin (n + 1)) ℝ)]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [EuclideanSpace.basisFun_apply, ContinuousLinearMap.coe_coe,
      EuclideanSpace.inner_single_left]
    rw [zsmul_eq_mul]
    push_cast
    rw [← mul_assoc, ← pow_add, ← two_mul, pow_mul]
    simp

theorem Submission.codim1_zsl_fl_perimeter_bound : ∀ (n k : ℕ) (Us : ℕ → Set (Euclid (n + 1 + k))) (Ss : (i : ℕ) → GeometricCurrentOn (Us i) n) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (b : Euclid k) (gs : ℕ → Euclid (n + 1) → Euclid k) (Fs : ℕ → Set (Euclid (n + 1))), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ y : Euclid (n + 1 + k), ∃ v w, y = ι v + ι' w) → (∀ i, MeasurableSet (Fs i)) → (∀ R : ℝ, 0 < R → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid (n + 1)) R, DifferentiableAt ℝ (gs i) w) → (∀ R ε : ℝ, 0 < R → 0 < ε → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid (n + 1)) R, ‖gs i w - b‖ < ε ∧ ‖fderiv ℝ (gs i) w‖ < ε) → (∀ R : ℝ, 0 < R → ∀ᶠ i in atTop, ∀ ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n, tsupport (ω : DifferentialForm (Euclid (n + 1 + k)) n) ⊆ ball 0 R → currentEval (Ss i) (ω : DifferentialForm (Euclid (n + 1 + k)) n) = ∫ w in Fs i ∩ ball 0 R, exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n) (ι w + ι' (gs i w)) (fun j => fderiv ℝ (fun w => ι w + ι' (gs i w)) w (EuclideanSpace.single j (1 : ℝ)))) → (∀ R : ℝ, 0 < R → ∃ c : ℝ, ∀ᶠ i in atTop, ∀ ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n, tsupport (ω : DifferentialForm (Euclid (n + 1 + k)) n) ⊆ ball 0 R → (∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid (n + 1 + k)) n) y) ≤ 1) → currentEval (Ss i) (ω : DifferentialForm (Euclid (n + 1 + k)) n) ≤ c) → ∀ R : ℝ, 0 < R → ∃ c : ℝ, ∀ᶠ i in atTop, ∀ φ : Euclid (n + 1) → Euclid (n + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ ball 0 R → (∀ v, ‖φ v‖ ≤ 1) → ∫ v in Fs i, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ v).toLinearMap ≤ c := by
  intro n k Us Ss ι ι' b gs Fs hperp hspan hFs hH1 hH2 hH3 hH4 R hR
  -- Constants: `K` from the divergence lift, `h := ‖b‖ + 1`, `R₂ := R + 2h`, `c := K c₂`.
  obtain ⟨K, hK, hlift⟩ := Submission.codim1_zsl_fl_divergence_lift n k ι ι' hperp hspan
  set h : ℝ := ‖b‖ + 1 with hh
  have hhpos : 0 < h := by positivity
  set R₂ : ℝ := R + 2 * h with hR₂
  have hR₂pos : 0 < R₂ := by positivity
  obtain ⟨c₂, hc₂⟩ := hH4 R₂ hR₂pos
  refine ⟨K * c₂, ?_⟩
  -- (H1)–(H4) at radius `R₂` (with `ε = 1` in (H2)) hold simultaneously for all large `i`.
  filter_upwards [hH1 R₂ hR₂pos, hH2 R₂ 1 hR₂pos one_pos, hH3 R₂ hR₂pos, hc₂] with i hi1 hi2 hi3 hi4
  intro φ hφ hφc hφs hφn
  -- The lifted test form is admissible in (H4) and represented by (H3).
  obtain ⟨ω, hωs, hωn, hωd⟩ := hlift h R hhpos φ hφ hφc hφs hφn
  have hle := hi4 ω hωs hωn
  rw [hi3 ω hωs] at hle
  -- On `B_{R₂}`, `gs i` is differentiable with `‖gs i w‖ < h`, so the integrand is `K⁻¹ div φ`.
  have hcongr : ∫ w in Fs i ∩ ball 0 R₂, exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n)
        (ι w + ι' (gs i w)) (fun j => fderiv ℝ (fun w => ι w + ι' (gs i w)) w
          (EuclideanSpace.single j (1 : ℝ))) =
      ∫ w in Fs i ∩ ball 0 R₂, K⁻¹ * LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ w).toLinearMap := by
    apply setIntegral_congr_fun ((hFs i).inter measurableSet_ball)
    intro w hw
    apply hωd (gs i) w (hi1 w hw.2)
    have := (hi2 w hw.2).1
    calc ‖gs i w‖ = ‖(gs i w - b) + b‖ := by rw [sub_add_cancel]
      _ ≤ ‖gs i w - b‖ + ‖b‖ := norm_add_le _ _
      _ < 1 + ‖b‖ := by linarith
      _ = h := by ring
  rw [hcongr, integral_const_mul] at hle
  -- `div φ` vanishes off `tsupport φ ⊆ B_R ⊆ B_{R₂}`, so the ball can be dropped.
  have hdiv : ∫ w in Fs i ∩ ball 0 R₂, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ w).toLinearMap =
      ∫ w in Fs i, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ w).toLinearMap := by
    refine (setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hFs i) inter_subset_left ?_).symm
    intro w hw
    have hwnot : w ∉ tsupport φ := fun hmem =>
      hw.2 ⟨hw.1, ball_subset_ball (by linarith) (hφs hmem)⟩
    have h0 : fderiv ℝ φ w = 0 :=
      image_eq_zero_of_notMem_tsupport (fun hmem => hwnot (tsupport_fderiv_subset ℝ hmem))
    simp [h0]
  rw [hdiv] at hle
  -- Multiply `K⁻¹ ∫_{Fs i} div φ ≤ c₂` by `K > 0`.
  have := mul_le_mul_of_nonneg_left hle hK.le
  rwa [← mul_assoc, mul_inv_cancel₀ hK.ne', one_mul] at this

/-- **Flat limit of the rescaled region boundaries** (Simon 7.5.3, 7.5.5; steps C1, D1, D5 and E3
of the supplied proof).  Let `Gᵢ(w) = ιw + ι'gᵢ(w)` with `gᵢ → b` in `C¹` on every ball (H1, H2),
`Sᵢ(ω) = ∫_{Fᵢ ∩ B_R} dω(Gᵢ)(DGᵢ e)` for `spt ω ⊆ B_R(0)` (H3), `Sᵢ` of locally bounded mass (H4),
and `Sᵢ ⇀ S`.  Then `S = ∂[[F]]` with `ξ_A = ιe₀ ∧ ⋯ ∧ ιeₙ` for a measurable `F` in the plane
`ι(ℝ^{n+1}) + ι'b`.  `codim1_zsl_fl_perimeter_bound` gives the local perimeter bounds of the `Fᵢ`,
`codim1_zsl_perimeter_compactness` a subsequence with `F_{σ i} → F'` in `L¹_loc`, and
`codim1_zsl_fl_graph_integral_tendsto` the limit `∫_{F' ∩ B_R} dω(G)(ιe)`, `G(w) = ιw + ι'b`, of
the integrals in (H3) along `σ`; with `Sᵢ ⇀ S` this is `S(ω)` when `spt ω ⊆ B_R(0)`.  As
`|G(w)| ≥ |w|`, the restriction to `B_R` can be dropped, and
`codim1_zsl_fl_isometry_image_setIntegral` moves the integral to `F := G(F')`. -/
theorem Submission.codim1_zsl_flat_graph_limit : ∀ (n k : ℕ) (Us : ℕ → Set (Euclid (n + 1 + k))) (Ss : (i : ℕ) → GeometricCurrentOn (Us i) n) (S : GeometricCurrentOn (univ : Set (Euclid (n + 1 + k))) n) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ξA : MultiVector (n + 1 + k) (n + 1)) (b : Euclid k) (gs : ℕ → Euclid (n + 1) → Euclid k) (Fs : ℕ → Set (Euclid (n + 1))), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ y : Euclid (n + 1 + k), ∃ v w, y = ι v + ι' w) → (∀ α : Covector (Euclid (n + 1 + k)) (n + 1), ξA α = α (fun j => ι (EuclideanSpace.single j (1 : ℝ)))) → ConvergesWeakly Ss S → (∀ i, MeasurableSet (Fs i)) → (∀ R : ℝ, 0 < R → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid (n + 1)) R, DifferentiableAt ℝ (gs i) w) → (∀ R ε : ℝ, 0 < R → 0 < ε → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid (n + 1)) R, ‖gs i w - b‖ < ε ∧ ‖fderiv ℝ (gs i) w‖ < ε) → (∀ R : ℝ, 0 < R → ∀ᶠ i in atTop, ∀ ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n, tsupport (ω : DifferentialForm (Euclid (n + 1 + k)) n) ⊆ ball 0 R → currentEval (Ss i) (ω : DifferentialForm (Euclid (n + 1 + k)) n) = ∫ w in Fs i ∩ ball 0 R, exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n) (ι w + ι' (gs i w)) (fun j => fderiv ℝ (fun w => ι w + ι' (gs i w)) w (EuclideanSpace.single j (1 : ℝ)))) → (∀ R : ℝ, 0 < R → ∃ c : ℝ, ∀ᶠ i in atTop, ∀ ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n, tsupport (ω : DifferentialForm (Euclid (n + 1 + k)) n) ⊆ ball 0 R → (∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid (n + 1 + k)) n) y) ≤ 1) → currentEval (Ss i) (ω : DifferentialForm (Euclid (n + 1 + k)) n) ≤ c) → ∃ F : Set (Euclid (n + 1 + k)), MeasurableSet F ∧ F ⊆ {y | ∃ w, y = ι w + ι' b} ∧ IsBoundaryOfRegion S F (fun _ => ξA) := by
  intro n k Us Ss S ι ι' ξA b gs Fs hperp hspan hξA hconv hFs hH1 hH2 hH3 hH4
  -- Part B: (H1)–(H4) give uniform local perimeter bounds for the `Fᵢ`.
  have hper := Submission.codim1_zsl_fl_perimeter_bound n k Us Ss ι ι' b gs Fs hperp hspan hFs
    hH1 hH2 hH3 hH4
  -- C1: BV compactness, `L^{n+1}((F_{σ i} Δ F') ∩ B_R) → 0` for every `R`.
  obtain ⟨σ, F', hσ, hF', hsymm⟩ := Submission.codim1_zsl_perimeter_compactness (n + 1) Fs hFs hper
  -- E1–E2: `F := G(F')` is measurable and `∫_F f dH^{n+1} = ∫_{F'} f ∘ G`.
  obtain ⟨hFmeas, htrans⟩ :=
    Submission.codim1_zsl_fl_isometry_image_setIntegral (n + 1) (n + 1 + k) ι (ι' b) F' hF'
  refine ⟨(fun w => ι w + ι' b) '' F', hFmeas, ?_, ?_⟩
  · rintro y ⟨w, -, rfl⟩
    exact ⟨w, rfl⟩
  · intro ω
    -- D1: `dω` is a test form, and `spt ω ⊆ B_R(0)` for some `R > 0`.
    have hωtest : IsTestForm (ω : DifferentialForm (Euclid (n + 1 + k)) n) := ω.property.1
    have hdω := exteriorDerivative_isTestForm hωtest
    obtain ⟨R, hRpos, hR⟩ :=
      hωtest.2.isCompact.isBounded.subset_ball_lt 0 (0 : Euclid (n + 1 + k))
    -- D2–D4: along `σ` the graph integrals tend to the integral over the flat graph `G`.
    have hσt : Tendsto σ atTop atTop := hσ.tendsto_atTop
    have hlim := Submission.codim1_zsl_fl_graph_integral_tendsto (n + 1) k (n + 1 + k) ι ι' b R
      (exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n)) (fun i => gs (σ i))
      (fun i => Fs (σ i)) F' hdω.1.continuous hdω.2 (fun i => hFs (σ i)) hF' (hsymm R)
      (hσt.eventually (hH1 R hRpos)) (fun ε hε => hσt.eventually (hH2 R ε hRpos hε))
    -- D5: by (H3) these integrals are eventually `S_{σ i}(ω)`, and `S_{σ i}(ω) → S(ω)`.
    have heq : (fun i => currentEval (Ss (σ i)) (ω : DifferentialForm (Euclid (n + 1 + k)) n))
        =ᶠ[atTop] fun i => ∫ w in Fs (σ i) ∩ ball 0 R,
          exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n) (ι w + ι' (gs (σ i) w))
            (fun j => fderiv ℝ (fun w => ι w + ι' (gs (σ i) w)) w
              (EuclideanSpace.single j (1 : ℝ))) := by
      filter_upwards [hσt.eventually (hH3 R hRpos)] with i hi
      exact hi ω hR
    have hS := tendsto_nhds_unique (((hconv ω).comp hσt).congr' heq) hlim
    -- E3: move the integral to `F = G(F')` and use `ξ_A(α) = α(ιe)`.
    rw [hS, htrans]
    simp only [hξA]
    symm
    -- `dω(G(w)) = 0` for `|w| ≥ R`, since `|G(w)|² = |w|² + |b|²` and `spt dω ⊆ B_R(0)`.
    apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hF' inter_subset_left
    rintro w ⟨hwF, hwB⟩
    have hwB' : R ≤ ‖w‖ := by
      by_contra hlt
      exact hwB ⟨hwF, by simpa using (not_le.1 hlt)⟩
    have hnorm : ‖w‖ ≤ ‖ι w + ι' b‖ := by
      have h2 : ‖ι w + ι' b‖ ^ 2 = ‖w‖ ^ 2 + ‖b‖ ^ 2 := by
        rw [norm_add_sq_real, hperp, LinearIsometry.norm_map, LinearIsometry.norm_map]
        ring
      nlinarith [norm_nonneg w, norm_nonneg (ι w + ι' b), sq_nonneg ‖b‖]
    have hnot : ι w + ι' b ∉
        tsupport (exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n)) := by
      intro hmem
      have := hR (tsupport_exteriorDerivative_subset _ hmem)
      rw [mem_ball, dist_zero_right] at this
      linarith
    rw [image_eq_zero_of_notMem_tsupport hnot]
    rfl

/-- **Blow-ups of `∂[[E]]` along a `C¹` graph flatten to `∂[[F]]` in a plane** (Simon 7.5.3 and
7.5.5, chapter-07.txt lines 790–901).  Near `x` the carrier `N` is the graph
`Γ(v) = x + ιv + ι'u(v)` of a `C¹` map `u` with `Du(0) = 0`, oriented by `ξN`.  If `T = ∂[[E]]`
has local mass bounds, `xᵢ → x` lie within `C₀λᵢ` of `N`, `λᵢ → 0` and `η_{xᵢ,λᵢ#}T ⇀ S`, then
`S = ∂[[F]]` with the constant orientation `ξN(x)`, for a measurable `F` in a plane
`{ιw + ι'b}`.  In chart coordinates `xᵢ = x + ιsᵢ + ι'tᵢ` the blow-ups live on the rescaled graphs
of `gᵢ(w) = λᵢ⁻¹(u(sᵢ + λᵢw) − tᵢ)`, which flatten in `C¹` to the constant `b` along a
subsequence; the flat limit lemma then identifies `S`. -/
theorem Submission.codim1_zsl_graph_blowup_limit : ∀ (n k : ℕ) (U N E : Set (Euclid (n + 1 + k))) (ξN : Euclid (n + 1 + k) → MultiVector (n + 1 + k) (n + 1)) (T : GeometricCurrentOn U n) (x : Euclid (n + 1 + k)) (xs : ℕ → Euclid (n + 1 + k)) (lams : ℕ → ℝ) (hlams : ∀ i, 0 < lams i) (S : GeometricCurrentOn (univ : Set (Euclid (n + 1 + k))) n) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (u : Euclid (n + 1) → Euclid k) (δ₁ δ₂ C₀ : ℝ), IsOpen U → MeasurableSet E → E ⊆ N → IsBoundaryOfRegion T E ξN → x ∈ U → Tendsto xs atTop (𝓝 x) → Tendsto lams atTop (𝓝 0) → (∃ C r₀ : ℝ, 0 < r₀ ∧ ∀ y ∈ ball x r₀, ∀ ρ : ℝ, 0 < ρ → ρ < r₀ → T.massOn (ball y ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → ConvergesWeakly (fun i => blowUp T (xs i) (lams i) (hlams i).ne') S → (∀ i, ∃ p ∈ N, dist p (xs i) ≤ C₀ * lams i) → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ y : Euclid (n + 1 + k), ∃ v w, y = ι v + ι' w) → 0 < δ₁ → 0 < δ₂ → ContDiffOn ℝ 1 u (ball 0 δ₁) → u 0 = 0 → fderiv ℝ u 0 = 0 → (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, u v ∈ ball (0 : Euclid k) δ₂) → N ∩ {y | ∃ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∃ w ∈ ball (0 : Euclid k) δ₂, y = x + ι v + ι' w} = (fun v => x + ι v + ι' (u v)) '' ball (0 : Euclid (n + 1)) δ₁ → (∀ α : Covector (Euclid (n + 1 + k)) (n + 1), ξN x α = α (fun j => ι (EuclideanSpace.single j (1 : ℝ)))) → (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∀ α : Covector (Euclid (n + 1 + k)) (n + 1), α (fun j => fderiv ℝ (fun v => x + ι v + ι' (u v)) v (EuclideanSpace.single j (1 : ℝ))) = Real.sqrt (((fderiv ℝ (fun v => x + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => x + ι v + ι' (u v)) v).det) * ξN (x + ι v + ι' (u v)) α) → ∃ (b : Euclid k) (F : Set (Euclid (n + 1 + k))), MeasurableSet F ∧ F ⊆ {y | ∃ w, y = ι w + ι' b} ∧ IsBoundaryOfRegion S F (fun _ => ξN x) := by
  intro n k U N E ξN T x xs lams hlams S ι ι' u δ₁ δ₂ C₀ hU hE hEN hT hxU hxs hlams0 hmass hconv
    hnear horth hspan hδ₁ hδ₂ hu _hu0 hDu0 _huδ₂ hchart hξx hξ
  -- Steps 1 and 3 (centre_offsets): `xᵢ = x + ι sᵢ + ι' tᵢ` with `sᵢ, tᵢ → 0`, and the points of
  -- `N` within `C₀λᵢ` of `xᵢ` give bounded offsets on the graph of `u`.
  obtain ⟨s, t, hst, hs, ht, hoff⟩ := Submission.codim1_zsl_gbl_centre_chart_offsets (n + 1) k
    (n + 1 + k) N x xs lams ι ι' u δ₁ δ₂ C₀ hxs hlams0 hlams hnear horth hspan hδ₁ hδ₂ hchart
  -- Steps 2, 4 and 5 (graph_flattening): along a subsequence `σ` the rescaled graph maps
  -- `gᵢ(w) = λᵢ⁻¹(u(sᵢ + λᵢw) − tᵢ)` converge in `C¹` on every ball to a constant `b`.
  obtain ⟨σ, b, hσ, hdiff, hflat⟩ := Submission.codim1_zsl_gbl_rescaled_graph_flattening (n + 1) k
    u δ₁ C₀ s t lams hδ₁ hu hDu0 hlams hs hlams0 hoff
  have hσt : Tendsto σ atTop atTop := hσ.tendsto_atTop
  -- Step 8 (graph_representation, fed by blowup_region and graph_area): at every scale `λᵢ` the
  -- parameter set `F'ᵢ` is measurable, and the blow-up is represented on the rescaled graph over
  -- every ball `B_R` satisfying the scale conditions.
  have hrep := fun i => Submission.codim1_zsl_gbl_blowUp_graph_representation n k U N E ξN T x
    (xs i) (lams i) (hlams i) ι ι' u δ₁ δ₂ (s i) (t i) hE hEN
    (Submission.codim1_zsl_blowUp_isBoundaryOfRegion (n + 1 + k) n U E ξN T (xs i) (lams i)
      (hlams i) hT)
    (fun g D A f hD hg hA hAD =>
      Submission.codim1_zsl_graph_area_formula (n + 1) k ι ι' g D A f horth hD hg hA hAD)
    horth hspan hu hchart hξ (hst i)
  -- Step 6: for every `R` the scale conditions hold for all large `i`, because `sᵢ, tᵢ, λᵢ → 0`,
  -- `xᵢ → x` and `ball(x, r) ⊆ U`.
  obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hU x hxU
  have hscale : ∀ R : ℝ, ∀ᶠ i in atTop, ‖s i‖ + lams i * R < δ₁ ∧ ‖t i‖ + lams i * R < δ₂ ∧
      ball (xs i) (lams i * R) ⊆ U := by
    intro R
    have h₁ : Tendsto (fun i => ‖s i‖ + lams i * R) atTop (𝓝 0) := by
      simpa using (tendsto_norm_zero.comp hs).add (hlams0.mul_const R)
    have h₂ : Tendsto (fun i => ‖t i‖ + lams i * R) atTop (𝓝 0) := by
      simpa using (tendsto_norm_zero.comp ht).add (hlams0.mul_const R)
    have h₃ : Tendsto (fun i => lams i * R + dist (xs i) x) atTop (𝓝 0) := by
      simpa using (hlams0.mul_const R).add (tendsto_iff_dist_tendsto_zero.1 hxs)
    filter_upwards [h₁.eventually_lt_const hδ₁, h₂.eventually_lt_const hδ₂,
      h₃.eventually_lt_const hr] with i hi₁ hi₂ hi₃
    exact ⟨hi₁, hi₂, (ball_subset_ball' hi₃.le).trans hrU⟩
  -- Step 9 (flat_limit) along `σ`: weak convergence passes to the subsequence; (H1)–(H2) are the
  -- `C¹` flattening, (H3) the graph representation and (H4) the mass bound of step 7.
  obtain ⟨F, hFmeas, hFplane, hFS⟩ := Submission.codim1_zsl_flat_graph_limit n k
    (fun i => dilation (xs (σ i)) (lams (σ i)) '' U)
    (fun i => blowUp T (xs (σ i)) (lams (σ i)) (hlams (σ i)).ne') S ι ι' (ξN x) b
    (fun i w => (lams (σ i))⁻¹ • (u (s (σ i) + lams (σ i) • w) - t (σ i)))
    (fun i => {w : Euclid (n + 1) | s (σ i) + lams (σ i) • w ∈ ball (0 : Euclid (n + 1)) δ₁ ∧
      x + ι (s (σ i) + lams (σ i) • w) + ι' (u (s (σ i) + lams (σ i) • w)) ∈ E})
    horth hspan hξx (fun ω => (hconv ω).comp hσt) (fun i => (hrep (σ i)).1) hdiff hflat
    (fun R _ => (hσt.eventually (hscale R)).mono fun i hi ω hω =>
      (hrep (σ i)).2 R hi.1 hi.2.1 hi.2.2 ω hω)
    (fun R hR => by
      obtain ⟨c, hc⟩ := Submission.codim1_zsl_gbl_blowUp_mass_bound (n + 1 + k) n U T x xs lams
        hlams hxs hlams0 hmass R hR
      exact ⟨c, hσt.eventually hc⟩)
  exact ⟨b, F, hFmeas, hFplane, hFS⟩

/-- **Zero-scale limits of blow-ups of `∂[[E]]` with moving centres** (Simon 7.5.3–7.5.5,
chapter-07.txt lines 790–901, as used for 7.5.8).  Let `N ∈ 𝒪` in `U` be oriented by `ξ_N`,
`T = ∂[[E]]` with `E ⊆ N ∩ U`, `M_{B_ρ(y)}(T) ≤ Cρⁿ` near `x ∈ U`, `xᵢ → x`, `λᵢ → 0⁺` and
`η_{xᵢ,λᵢ#}T ⇀ S` with `spt S ≠ ∅`.  Then `S = ∂[[F]]` for a Borel set `F` in an affine
`(n+1)`-plane `A = Q − a` of class `𝒪` of `ℝᴾ`, oriented by the constant `ξ_A = ξ_N(x)`.
`spt S ≠ ∅` gives `x ∈ N` and `dist(xᵢ, N) = O(λᵢ)`; a chart of `N` at `x` forces
`P = n + 1 + k`; in the oriented graph chart `v ↦ x + ιv + ι'u(v)` of `N` over `T_xN = range ι`
the blow-ups converge to `∂[[F]]` with `F ⊆ {ιw + ι'b}`; and `ξ_N(x) = ιe₀ ∧ ⋯ ∧ ιeₙ` orients
`Q := range ι`, so `a := −ι'b`. -/
theorem Submission.codim1_zero_scale_limit_offset_plane : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n) (x : Euclid P) (xs : ℕ → Euclid P) (lams : ℕ → ℝ) (hlams : ∀ i, 0 < lams i) (S : GeometricCurrentOn (univ : Set (Euclid P)) n), 1 ≤ n → IsOpen U → InClassO n U N ξN → MeasurableSet E → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN → x ∈ U → Tendsto xs atTop (𝓝 x) → Tendsto lams atTop (𝓝 0) → (∃ C r₀ : ℝ, 0 < r₀ ∧ ∀ y ∈ ball x r₀, ∀ ρ : ℝ, 0 < ρ → ρ < r₀ → T.massOn (ball y ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → ConvergesWeakly (fun i => blowUp T (xs i) (lams i) (hlams i).ne') S → S.support.Nonempty → ∃ (Q : Submodule ℝ (Euclid P)) (a : Euclid P) (F : Set (Euclid P)) (ξA : MultiVector P (n + 1)), Module.finrank ℝ Q = n + 1 ∧ InClassO n (univ : Set (Euclid P)) {y | y + a ∈ Q} (fun _ => ξA) ∧ MeasurableSet F ∧ F ⊆ {y | y + a ∈ Q} ∧ IsBoundaryOfRegion S F (fun _ => ξA) := by
  intro P n U N E ξN T x xs lams hlams S _hn hU hO hE hEU hT hx hxs hlams0 hmass hconv hS
  obtain ⟨hNsub, hNor, hNcl, -⟩ := hO
  have hEN : E ⊆ N := fun y hy => (hEU hy).1
  -- `dist(xᵢ, N) = O(λᵢ)` and `x ∈ N`, since `spt S ≠ ∅`
  obtain ⟨hxN, C₀, -, hp⟩ := Submission.codim1_zsl_blowUp_centres_near P n U N E ξN T x xs lams
    hlams S hNcl hEN hT hx hxs hlams0 hconv hS
  -- a chart of `N` at `x` has an injective derivative `ℝ^{n+1} → ℝᴾ`, so `P = n + 1 + k`
  obtain ⟨k, rfl⟩ : ∃ k, P = n + 1 + k := by
    obtain ⟨V, W, ψ, -, -, hxW, -, -, hψV, -, hinj⟩ := hNsub x hxN
    obtain ⟨z, hz, -⟩ : x ∈ ψ '' V := by
      rw [hψV]
      exact ⟨hxW, hxN⟩
    have h := LinearMap.finrank_le_finrank_of_injective
      (f := (fderiv ℝ ψ z : Euclid (n + 1) →ₗ[ℝ] Euclid P)) (hinj z hz)
    rw [finrank_euclideanSpace_fin, finrank_euclideanSpace_fin] at h
    exact ⟨P - (n + 1), by omega⟩
  -- the oriented graph chart of `N` at `x` over `T_xN = range ι`
  obtain ⟨ι, ι', u, δ₁, δ₂, horth, hspan, hδ₁, hδ₂, hu, hu0, hdu0, hub, hchart, hξx, hξ⟩ :=
    Submission.codim1_zsl_oriented_graph_chart n k N ξN x hNsub hNor hxN
  -- the blow-ups converge to `∂[[F]]`, `F` in the plane `{ιw + ι'b}`
  obtain ⟨b, F, hF, hFsub, hSF⟩ := Submission.codim1_zsl_graph_blowup_limit n k U N E ξN T x xs
    lams hlams S ι ι' u δ₁ δ₂ C₀ hU hE hEN hT hx hxs hlams0 hmass hconv hp horth hspan hδ₁ hδ₂ hu
    hu0 hdu0 hub hchart hξx hξ
  -- `ξ_N(x) = ιe₀ ∧ ⋯ ∧ ιeₙ` is a unit orientation of `Q := range ι`
  have hQ : IsUnitOrientationOf (ξN x) (LinearMap.range ι.toLinearMap) := by
    refine ⟨fun j => ι (EuclideanSpace.single j (1 : ℝ)),
      EuclideanSpace.orthonormal_single.comp_linearIsometry ι, ?_, Or.inl hξx⟩
    have he : (fun j => ι (EuclideanSpace.single j (1 : ℝ))) =
        ι.toLinearMap ∘ (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis := by
      funext j
      simp
    rw [he, range_comp, ← Submodule.map_span, Module.Basis.span_eq, ← LinearMap.range_eq_map]
  -- the offset plane `A = Q − a`, `a := −ι'b`, is in class `𝒪` of `ℝᴾ`, and `F ⊆ A`
  obtain ⟨hrank, hclass⟩ :=
    Submission.codim1_zsl_offset_plane_inClassO (n + 1 + k) n _ (ξN x) (-ι' b) hQ
  refine ⟨LinearMap.range ι.toLinearMap, -ι' b, F, ξN x, hrank, hclass, hF, fun y hy => ?_, hSF⟩
  obtain ⟨w, rfl⟩ := hFsub hy
  show ι w + ι' b + -ι' b ∈ LinearMap.range ι.toLinearMap
  rw [add_neg_cancel_right]
  exact LinearMap.mem_range_self _ w

end GMT.Ch07
