      Differentiable ℝ G → ∀ {r ε Λ₂ : ℝ},
      (∀ p q : E, ‖p‖ ≤ r → ‖q‖ ≤ r → ‖fderiv ℝ G p - fderiv ℝ G q‖ ≤ Λ₂ * ‖p - q‖) →
