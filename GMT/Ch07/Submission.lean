    intro f hf
    have e2 : inner ℝ (toH₀ f) ψ = ∫ x, inner ℝ (f x) (ψ x) ∂μ := by
      rw [hip]
      refine integral_congr_ae ?_
      filter_upwards [hcoe f hf] with x hx
      rw [hx]
    rw [← e2]
    exact ((tendsto_const_nhds (x := toH₀ f)).inner (𝕜 := ℝ) hψ).congr fun n =>
