      have hkey : ∀ v ∈ T, ∀ w ∈ T, ‖v - w‖ ≤ 2 * C A' * ‖Φ v - Φ w‖ := by
        intro v hv w hw
        have h2 : ‖L.starProjection (A' (v - w))‖ ≤
