        rfl
      have hH'Φ : ∀ u ∈ T, π₁ (Φ u) + Lᗮ.starProjection (h₁ (Φ u)) = F' u := by
        intro u hu
        have e1 : π₁ (Φ u) = L.starProjection (F' u) := by
          rw [hπ₁, hΦ, hΛ, LinearIsometryEquiv.apply_symm_apply, Submodule.starProjection_apply]
