                sq_le_sq' (abs_le.1 (hpt x hx j κ)).1 (abs_le.1 (hpt x hx j κ)).2
          _ = m * k * (6 * (CH * lam / (R / 2)) * r) ^ 2 := by simp; ring
      calc ∫ x in ball x₀ r, ∑ j : Fin m, ‖(fderiv ℝ h x - ⨍ z in ball x₀ r, fderiv ℝ h z)
            (EuclideanSpace.single j (1 : ℝ))‖ ^ 2
