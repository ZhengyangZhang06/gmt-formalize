    rw [(hFd a ha).fderiv]
    ext v
    constructor
    · intro hv
      simp only [tangentSpace, mem_ofPred_eq] at hv
      obtain ⟨γ, -, hγM, hγ0, hγv⟩ := hv
      have hFZ : γ 0 ∈ {z : Euclid P | ∃ a ∈ ball (0 : Euclid m) s,
