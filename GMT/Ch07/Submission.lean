        t⁻¹ • (((G (p + D) - G p) - (G (q + D) - G q)) + (G (q + D) - G (q + t • a))) := by
      rw [← smul_sub]
      congr 1
      abel
    have htpos : 0 < |t| := abs_pos.mpr ht
    have hX : ‖t⁻¹ • (G (p + D) - G p) - t⁻¹ • (G (q + t • a) - G q)‖ ≤
