  refine Submission.cbr_ci_pw_mu_uniform_of_equilipschitz n (closedBall 0 R)
    (fun k x => ∫ y in ball 0 (2 * R), u k y * φ (x - y)) (c * ∫ y, φ y) (L * Λ)
