      have := h4 y
      rw [huy] at this
      exact hy (le_antisymm this.2 this.1)
    have hbddA : ∀ u : Euclid (m + 1) → ℝ, Continuous u → (∀ y, 0 ≤ u y) →
        ∀ K, IsCompact K → K ⊆ D → support u ⊆ K → BddAbove (S '' A u) := by
      intro u hu hu0 K hK hKD huK
