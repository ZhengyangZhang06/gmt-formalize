            apply measure_mono
            intro x ⟨hx, hxC⟩
            obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hx
            have : χ j x ≠ 0 := fun h => hj (by simp [h])
            refine mem_iUnion.2 ⟨j, thickening_subset_cthickening _ _ (hχsupp j ▸ this), ?_⟩
            exact fun hxj => hxC (mem_iUnion.2 ⟨j, hxj⟩)
