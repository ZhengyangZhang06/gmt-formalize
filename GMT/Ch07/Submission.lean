    · -- `H_j → H` uniformly: `‖H_j - H‖ ≤ ‖Fs j - F‖ + A B (‖Gs j - G‖ + ‖Fs j - F‖)`
      rw [Metric.tendstoUniformly_iff]
      intro ε hε
      have hden : 0 < 1 + 2 * (A * B) := by positivity
