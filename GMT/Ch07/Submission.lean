    have h0 : (μHE[m].restrict R₀.carrier) ((Lᗮ : Set (Euclid P))ᶜ) = 0 := by
      rw [Measure.restrict_apply (Submodule.isClosed_orthogonal L).measurableSet.compl]
      convert measure_empty (μ := (μHE[m] : Measure (Euclid P)))
      ext z
      simp only [mem_inter_iff, mem_compl_iff, mem_empty_iff_false, iff_false, not_and]
      intro hz hzR
      exact hz (hR₀L hzR)
    exact withDensity_absolutelyContinuous _ _ h0
  · -- `μ(A) = ∫_L μ₀(A - t) dt`
    intro A hA
    have h1 : R.measure A =
        ∫⁻ x in R.carrier, A.indicator (fun x => (R.mult x : ℝ≥0∞)) x ∂μHE[n] := by
      rw [IMRep.measure, withDensity_apply _ hA, lintegral_indicator hA]
    rw [h1, (hC1 _ (hθm.indicator hA)).2]
    apply lintegral_congr_ae
    filter_upwards [hstar] with t ht
    obtain ⟨Rt, hRtC, hRtθ, -, -, hRtmeas⟩ := ht
    have h2 : ∫⁻ x in R.carrier ∩ {x | L.starProjection x = t},
        A.indicator (fun x => (R.mult x : ℝ≥0∞)) x ∂μHE[m] = Rt.measure A := by
      rw [IMRep.measure, withDensity_apply _ hA, hRtC, hRtθ, lintegral_indicator hA]
    rw [h2, hRtmeas A hA,
      show (fun y : Euclid P => y + t) = (fun y => t + y) from funext fun y => add_comm y t]
  · -- the product formula
    intro flat hflat ω
    have hflat_add : ∀ α β, flat (α + β) = flat α + flat β := fun α β => by
      ext v
      simp only [hflat, ContinuousAlternatingMap.add_apply]
    have hflat_smul : ∀ (c : ℝ) α, flat (c • α) = c • flat α := fun c α => by
      ext v
      simp only [hflat, ContinuousAlternatingMap.smul_apply]
    have := Submission.lcn_covector_finiteDimensional P n
    obtain ⟨flatL, hflatL⟩ : ∃ flatL : Covector (Euclid P) n →L[ℝ] Covector (Euclid P) m,
        ∀ α, flatL α = flat α :=
      ⟨LinearMap.toContinuousLinearMap ⟨⟨flat, hflat_add⟩, hflat_smul⟩, fun _ => rfl⟩
    -- at a good point, `ξ(α) = ζ(♭α)`
    have hflatgood : ∀ (Ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)),
        IsUnitOrientationOf Ξ Q → L ≤ Q → ∀ α, Ξ α = (Ξ.comp lift) (flat α) := by
      intro Ξ Q hΞ hLQ α
      obtain ⟨g, -, -, hgL, hsign⟩ := hstruct Ξ Q hΞ hLQ
      rw [ContinuousLinearMap.comp_apply]
      rcases hsign with h | h
      · rw [h, h, hlift _ g hgL, hflat]
      · rw [h, h, hlift _ g hgL, hflat]
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ω.property.1.1.continuous
    obtain ⟨C, hC⟩ := hωc.bounded_above_of_compact_support ω.property.1.2
    have hint0 : Integrable (fun x => (R.mult x : ℝ) *
        R.orient x ((ω : DifferentialForm (Euclid P) n) x)) (μHE[n].restrict R.carrier) :=
      (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n univ
        (tsupport (ω : DifferentialForm (Euclid P) n)) R ω C ω.property.1.2 (subset_univ _)
        hωc.aestronglyMeasurable (fun x hx => image_eq_zero_of_notMem_tsupport hx) hC).1
    have hae : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
        (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x) =
          (R.mult x : ℝ) * ζ x (flat ((ω : DifferentialForm (Euclid P) n) x)) := by
      filter_upwards [hgood] with x hx
      obtain ⟨hxe, Q, -, hQo, hLQ⟩ := hx
      rw [hζ_def, hxe, ← hflatgood _ Q hQo hLQ]
    have hmeas_h : Measurable fun x =>
        (R.mult x : ℝ) * ζ x (flat ((ω : DifferentialForm (Euclid P) n) x)) := by
      have h1 : StronglyMeasurable fun x =>
          ζ x (flatL ((ω : DifferentialForm (Euclid P) n) x)) :=
        (continuous_fst.clm_apply continuous_snd).comp_stronglyMeasurable
          (hζsm.prodMk (flatL.continuous.comp hωc).stronglyMeasurable)
      simp only [hflatL] at h1
      exact hθr.mul h1.measurable
    have hint : Integrable (fun x => (R.mult x : ℝ) *
        ζ x (flat ((ω : DifferentialForm (Euclid P) n) x))) (μHE[n].restrict R.carrier) :=
      hint0.congr hae
    rw [hrep ω]
    show ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)
      ∂μHE[n] = _
    rw [integral_congr_ae hae, hsigned _ hmeas_h hint]
    apply integral_congr_ae
    filter_upwards [hstar] with t ht
    obtain ⟨Rt, hRtC, hRtθ, hRtξ, hRtact, -⟩ := ht
    have hγ : IsTestForm (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∧
        tsupport (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ⊆ univ := by
      refine ⟨⟨?_, ?_⟩, subset_univ _⟩
      · have : (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) =
            fun y => flatL ((ω : DifferentialForm (Euclid P) n) (t + y)) :=
          funext fun y => (hflatL _).symm
        rw [this]
        exact flatL.contDiff.comp (ω.property.1.1.comp (contDiff_const.add contDiff_id))
      · have : (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) =
            flatL ∘ ((ω : DifferentialForm (Euclid P) n) ∘ (Homeomorph.addLeft t)) :=
          funext fun y => (hflatL _).symm
        rw [this]
        exact (ω.property.1.2.comp_homeomorph (Homeomorph.addLeft t)).comp_left (map_zero flatL)
    have hce : currentEval S₀ (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) =
        S₀ ⟨_, hγ⟩ := by
      unfold currentEval
      rw [dite_eq_left hγ]
    have hRtact' : Rt.action (fun x => flat ((ω : DifferentialForm (Euclid P) n) x)) =
        ∫ x in R.carrier ∩ {x | L.starProjection x = t},
          (R.mult x : ℝ) * ζ x (flat ((ω : DifferentialForm (Euclid P) n) x)) ∂μHE[m] := by
      simp only [IMRep.action, hRtC, hRtθ, hRtξ]
    rw [hce, hS₀ ⟨_, hγ⟩, ← hRtact', hRtact]
    show R₀.action (fun y => flat ((ω : DifferentialForm (Euclid P) n) (y + t))) =
      R₀.action (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y)))
    simp only [add_comm]
/-- **Simon 7.3.5** (chapter-07.txt lines 410–418: `∂S₀ = 0`, and `S₀` is a cone if `S` is; the
book leaves the proof to the reader).  Let `S = [[L]] × S₀`, i.e. `S(ω) = ∫_L S₀(♭ω(t + ·)) dHᵈ(t)`
with `♭α(v) = α(f₁, …, f_d, v₁, …, vₘ)` for an orthonormal frame `f` of `L`, `d = dim L`, where
`S₀ = τ(M₀, θ₀, ζ₀)` and `μ₀(ℝᴾ ∖ L⊥) = 0`.  Then `∂S = 0 ⇒ ∂S₀ = 0` and `S` a cone `⇒ S₀` a cone.
`Hᵐ(M₀ ∖ L⊥) = 0`, so the approximate tangent planes of `M₀` lie in the flat `L⊥`
(`atsm_approxTangent_le_of_flat`) and `S₀(γ)` only depends on `γ(y)(w)`, `y ∈ L⊥`, `w ∈ (L⊥)ᵐ`.
For a test form `β` let `Ω_β(x) = ϕ(px) · (f¹ ∧ ⋯ ∧ fᵈ ∧ β)(x − px)`, `p` the projection onto `L`,
`ϕ ≥ 0` a bump with `ϕ(0) > 0`, the wedge being a normalized alternatization.  On `L⊥`,
`♭Ω_β(t + y) = ϕ(t) β(y)` and, expanding `d` by `alternatizeUncurryFin`,
`♭dΩ_β(t + y) = (−1)ᵈ ϕ(t) dβ(y)`; with `c = ∫_L ϕ dHᵈ > 0` (`Hᵈ⌞L` is the volume of `L`),
`0 = S(dΩ_β) = (−1)ᵈ c S₀(dβ)`.  Dilations preserve `L` and `L⊥` and scale `Hᵈ⌞L` by `λᵈ`, so
`c S₀(β) = S(Ω_β) = S(η_{0,λ}^# Ω_β) = c S₀(η_{0,λ}^# β)`. -/
theorem Submission.dimred_cs_sos_boundary_cone_transfer : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)) (f : Fin (Module.finrank ℝ L) → Euclid P) (S₀ : GeometricCurrentOn (univ : Set (Euclid P)) (n - Module.finrank ℝ L)) (R₀ : IMRep (univ : Set (Euclid P)) (n - Module.finrank ℝ L)) (hd : Module.finrank ℝ L < n), 0 < Module.finrank ℝ L → Orthonormal ℝ f → (∀ i, f i ∈ L) → R₀.Represents S₀ → R₀.measure (Lᗮ : Set (Euclid P))ᶜ = 0 → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) (n - Module.finrank ℝ L), (∀ (α : Covector (Euclid P) n) (v : Fin (n - Module.finrank ℝ L) → Euclid P), flat α v = α (Fin.append f v ∘ Fin.cast (Nat.add_sub_of_le hd.le).symm)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, S ω = ∫ t in (L : Set (Euclid P)), currentEval S₀ (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[Module.finrank ℝ L]) → (BoundaryVanishes S → BoundaryVanishes S₀) ∧ (IsConeCurrent S → IsConeCurrent S₀) := by
  intro P n S L
  generalize hdL : Module.finrank ℝ L = d
  intro f S₀ R₀ hd _hd0 hf hfL hR₀ hnull hPF
  -- write `n = d + m`, `m = m' + 1`, with `m` a variable
  have hPF' : ∀ (h : n = d + (n - d))
      (flat : Covector (Euclid P) n → Covector (Euclid P) (n - d)),
      (∀ (α : Covector (Euclid P) n) (v : Fin (n - d) → Euclid P),
        flat α v = α (Fin.append f v ∘ Fin.cast h)) →
      ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
        S ω = ∫ t in (L : Set (Euclid P)),
          currentEval S₀ (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[d] :=
    fun _ => hPF
  clear hPF
  have hnm : n = d + (n - d) := (Nat.add_sub_of_le hd.le).symm
  revert S₀ R₀ hR₀ hnull hPF' hnm
  generalize n - d = k
  intro S₀ R₀ hR₀ hnull hPF' hnm
  subst hnm
  obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := ⟨k - 1, by omega⟩
  have hLc : IsClosed (L : Set (Euclid P)) := L.closed_of_finiteDimensional
  have hLm : MeasurableSet (L : Set (Euclid P)) := hLc.measurableSet
  have hfperp : ∀ a, ∀ y ∈ Lᗮ, inner ℝ (f a) y = 0 := fun a y hy =>
    Submodule.inner_right_of_mem_orthogonal (hfL a) hy
  -- `p` is the orthogonal projection onto `L`
  obtain ⟨p, hpL, hpLp⟩ : ∃ p : Euclid P →L[ℝ] Euclid P, (∀ t ∈ L, p t = t) ∧
      ∀ y ∈ Lᗮ, p y = 0 :=
    ⟨L.starProjection, fun t ht => Submodule.starProjection_eq_self_iff.mpr ht,
      fun y hy => (Submodule.starProjection_apply_eq_zero_iff L).mpr hy⟩
  have hpsplit : ∀ t ∈ L, ∀ y ∈ Lᗮ, p (t + y) = t := fun t ht y hy => by
    rw [map_add, hpL t ht, hpLp y hy, add_zero]
  -- a bump `ϕ ≥ 0` with `ϕ(0) > 0`
  obtain ⟨ϕ, hϕs, hϕc, hϕn, hϕ0⟩ : ∃ ϕ : Euclid P → ℝ,
      ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) ϕ ∧ HasCompactSupport ϕ ∧ (∀ x, 0 ≤ ϕ x) ∧ 0 < ϕ 0 := by
    let b : ContDiffBump (0 : Euclid P) := ⟨1, 2, zero_lt_one, one_lt_two⟩
    refine ⟨b, b.contDiff, b.hasCompactSupport, fun x => b.nonneg, ?_⟩
    rw [b.one_of_mem_closedBall (Metric.mem_closedBall_self zero_le_one)]
    exact one_pos
  -- `Hᵈ⌞L` is the volume of `L`; `cϕ = ∫_L ϕ dHᵈ > 0` is invariant under dilations
  have hint : ∀ g : Euclid P → ℝ,
      ∫ t in (L : Set (Euclid P)), g t ∂μHE[d] = ∫ x : L, g x := by
    intro g
    have hmap : (μHE[d] : Measure (Euclid P)).restrict (L : Set (Euclid P)) =
        Measure.map (Subtype.val : L → Euclid P) volume := by
      rw [← InnerProductSpace.euclideanHausdorffMeasure_eq_volume, hdL,
        isometry_subtype_coe.map_euclideanHausdorffMeasure, Subtype.range_coe_subtype]
      rfl
    rw [hmap]
    exact (MeasurableEmbedding.subtype_coe hLm).integral_map g
  obtain ⟨cϕ, hcϕ_eq⟩ : ∃ c : ℝ, ∫ x : L, ϕ x = c := ⟨_, rfl⟩
  have hcϕ : 0 < cϕ := by
    rw [← hcϕ_eq]
    refine Continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero (x := 0)
      (hϕs.continuous.comp continuous_subtype_val)
      (hϕc.comp_isClosedEmbedding hLc.isClosedEmbedding_subtypeVal) (fun x => hϕn _) ?_
    simpa using hϕ0.ne'
  -- `μ₀(ℝᴾ ∖ L⊥) = 0` gives `Hᵐ⁺¹(M₀ ∖ L⊥) = 0`, since `θ₀ > 0` on `M₀`
  have hnull' : μHE[m + 1] (R₀.carrier \ (Lᗮ : Set (Euclid P))) = 0 := by
    have hθ : AEMeasurable (fun x => (R₀.mult x : ℝ≥0∞)) (μHE[m + 1].restrict R₀.carrier) :=
      (measurable_from_nat.comp R₀.measurable_mult).aemeasurable
    have h := (withDensity_apply_eq_zero' hθ).mp hnull
    rw [Measure.restrict_apply' R₀.measurableSet_carrier] at h
    refine measure_mono_null (fun x hx => ?_) h
    refine ⟨⟨?_, hx.2⟩, hx.1⟩
    simpa using (R₀.mult_pos x hx.1).ne'
  -- Step 1: `S₀(γ)` only depends on `γ(y)(w)` for `y ∈ L⊥`, `w ∈ (L⊥)ᵐ⁺¹`: the approximate
  -- tangent planes of `M₀` lie in the flat `L⊥` (`atsm_approxTangent_le_of_flat`)
  have hclaim1 : ∀ γ γ' : TestFormOn (univ : Set (Euclid P)) (m + 1),
      (∀ y ∈ Lᗮ, ∀ w : Fin (m + 1) → Euclid P, (∀ i, w i ∈ Lᗮ) →
        (γ : DifferentialForm (Euclid P) (m + 1)) y w =
          (γ' : DifferentialForm (Euclid P) (m + 1)) y w) →
      S₀ γ = S₀ γ' := by
    intro γ γ' hγ
    rw [hR₀ γ, hR₀ γ', IMRep.action, IMRep.action]
    refine integral_congr_ae ?_
    have hae : ∀ᵐ x ∂(μHE[m + 1].restrict R₀.carrier), x ∈ Lᗮ := by
      rw [ae_restrict_iff' R₀.measurableSet_carrier, ae_iff]
      refine measure_mono_null (fun x hx => ?_) hnull'
      simp only [Set.mem_ofPred_eq, not_imp] at hx
      exact hx
    filter_upwards [hae, R₀.orients] with x hxL hx
    obtain ⟨Q, hQ, τ, -, hspan, hξ⟩ := hx
    have hQL : Q ≤ Lᗮ :=
      Submission.atsm_approxTangent_le_of_flat P (m + 1) (Lᗮ : Set (Euclid P)) R₀.carrier x Q Lᗮ
        hnull' (fun ε hε => ⟨1, one_pos, fun z hz _ => ⟨z - x, Lᗮ.sub_mem hz hxL, by
          rw [sub_self, norm_zero]; positivity⟩⟩) hQ
    have hτL : ∀ i, τ i ∈ Lᗮ := fun i =>
      hQL (hspan ▸ Submodule.subset_span (Set.mem_range_self i))
    have h := hγ x hxL τ hτL
    rcases hξ with h' | h' <;> simp only [h', h]
  -- Step 0: the interior product `♭α(v) = α(f₁, …, f_d, v₁, …, vₘ₊₁)`, continuous linear in `α`
  obtain ⟨flat, hflat⟩ : ∃ flat : Covector (Euclid P) (d + (m + 1)) →L[ℝ] Covector (Euclid P) (m + 1),
      ∀ α v, flat α v = α (Fin.append f v) := by
    have happ : ∀ v : Fin (m + 1) → Euclid P,
        (fun i => Sum.elim f v (finSumFinEquiv.symm i)) = Fin.append f v := by
      intro v
      funext i
      refine Fin.addCases (fun a => ?_) (fun j => ?_) i
      · rw [finSumFinEquiv_symm_apply_castAdd, Sum.elim_inl, Fin.append_left]
      · rw [finSumFinEquiv_symm_apply_natAdd, Sum.elim_inr, Fin.append_right]
    let flat0 : Covector (Euclid P) (d + (m + 1)) → Covector (Euclid P) (m + 1) := fun α =>
      { toContinuousMultilinearMap :=
          (α.toContinuousMultilinearMap.domDomCongr finSumFinEquiv.symm).currySum f
        map_eq_zero_of_eq' := fun v i j hij hne => by
          change (α.toContinuousMultilinearMap.domDomCongr finSumFinEquiv.symm).currySum f v = 0
          rw [ContinuousMultilinearMap.currySum_apply, ContinuousMultilinearMap.domDomCongr_apply,
            happ v]
          exact α.map_eq_zero_of_eq (Fin.append f v) (i := Fin.natAdd d i) (j := Fin.natAdd d j)
            (by rw [Fin.append_right, Fin.append_right, hij])
            (fun h => hne (Fin.natAdd_inj d |>.mp h)) }
    have hflat0 : ∀ α v, flat0 α v = α (Fin.append f v) := by
      intro α v
      show (α.toContinuousMultilinearMap.domDomCongr finSumFinEquiv.symm).currySum f v = _
      rw [ContinuousMultilinearMap.currySum_apply, ContinuousMultilinearMap.domDomCongr_apply,
        happ]
      rfl
    have hadd : ∀ α β, flat0 (α + β) = flat0 α + flat0 β := fun α β => by
      ext v
      simp only [hflat0, ContinuousAlternatingMap.add_apply]
    have hsmul : ∀ (c : ℝ) α, flat0 (c • α) = c • flat0 α := fun c α => by
      ext v
      simp only [hflat0, ContinuousAlternatingMap.smul_apply]
    have := Submission.lcn_covector_finiteDimensional P (d + (m + 1))
    exact ⟨LinearMap.toContinuousLinearMap ⟨⟨flat0, hadd⟩, hsmul⟩, hflat0⟩
  have hS : ∀ ω : TestFormOn (univ : Set (Euclid P)) (d + (m + 1)),
      S ω = ∫ t in (L : Set (Euclid P)), currentEval S₀
        (fun y => flat ((ω : DifferentialForm (Euclid P) (d + (m + 1))) (t + y))) ∂μHE[d] :=
    hPF' rfl flat (fun α v => by rw [hflat]; rfl)
  -- the slices `y ↦ ♭F(t + y)` of a test form `F` are test forms, and `S₀` evaluates them
  -- through any test form agreeing with them on `L⊥ × (L⊥)ᵐ⁺¹`
  have hslice : ∀ (F : DifferentialForm (Euclid P) (d + (m + 1))) (hF : IsTestForm F)
      (t : Euclid P) (G : TestFormOn (univ : Set (Euclid P)) (m + 1)),
      (∀ y ∈ Lᗮ, ∀ w : Fin (m + 1) → Euclid P, (∀ i, w i ∈ Lᗮ) →
        F (t + y) (Fin.append f w) = (G : DifferentialForm (Euclid P) (m + 1)) y w) →
      currentEval S₀ (fun y => flat (F (t + y))) = S₀ G := by
    intro F hF t G hFG
    have hsl : IsTestForm (fun y => flat (F (t + y))) :=
      ⟨flat.contDiff.comp (hF.1.comp (contDiff_const.add contDiff_id)),
        (hF.2.comp_homeomorph (Homeomorph.addLeft t)).comp_left (map_zero flat)⟩
    rw [currentEval, dite_eq_left ⟨hsl, subset_univ _⟩]
    refine hclaim1 _ _ fun y hy w hw => ?_
    rw [← hFG y hy w hw]
    exact hflat _ _
  -- Step 2: the forms `Ω_β(x) = ϕ(p x) · lift(β(x − p x))` are test forms
  have hΩtest : ∀ (k k' : ℕ) (lift : Covector (Euclid P) k →L[ℝ] Covector (Euclid P) k')
      (β : DifferentialForm (Euclid P) k), IsTestForm β →
      IsTestForm (fun x => ϕ (p x) • lift (β (x - p x))) := by
    intro k k' lift β hβ
    refine ⟨(hϕs.comp p.contDiff).smul
      (lift.contDiff.comp (hβ.1.comp (contDiff_id.sub p.contDiff))), ?_⟩
    obtain ⟨R₁, hR₁⟩ := hϕc.isCompact.isBounded.subset_closedBall 0
    obtain ⟨R₂, hR₂⟩ := hβ.2.isCompact.isBounded.subset_closedBall 0
    refine HasCompactSupport.intro (K := closedBall 0 (R₁ + R₂)) (isCompact_closedBall _ _)
      fun x hx => ?_
    by_cases h1 : p x ∈ tsupport ϕ
    · by_cases h2 : x - p x ∈ tsupport β
      · refine absurd ?_ hx
        rw [mem_closedBall_zero_iff]
        calc ‖x‖ = ‖p x + (x - p x)‖ := by rw [add_sub_cancel]
          _ ≤ ‖p x‖ + ‖x - p x‖ := norm_add_le _ _
          _ ≤ R₁ + R₂ := add_le_add (mem_closedBall_zero_iff.mp (hR₁ h1))
            (mem_closedBall_zero_iff.mp (hR₂ h2))
      · rw [image_eq_zero_of_notMem_tsupport h2, map_zero, smul_zero]
    · rw [image_eq_zero_of_notMem_tsupport h1, zero_smul]
  -- the lift `β ↦ f¹ ∧ ⋯ ∧ fᵈ ∧ β`, the normalized alternatization of `Π(u ∘ castAdd)·β(u ∘ natAdd)`:
  -- (L1) `lift β (f, w) = β(w)` for `w ∈ (L⊥)ᵏ`; (L2) `lift β u = 0` if some `fₐ ⊥ u`
  have hlift : ∀ k : ℕ, ∃ lift : Covector (Euclid P) k →L[ℝ] Covector (Euclid P) (d + k),
      (∀ (B : Covector (Euclid P) k) (w : Fin k → Euclid P), (∀ i, w i ∈ Lᗮ) →
        lift B (Fin.append f w) = B w) ∧
      (∀ (B : Covector (Euclid P) k) (u : Fin (d + k) → Euclid P) (a : Fin d),
        (∀ l, inner ℝ (f a) (u l) = 0) → lift B u = 0) := by
    intro k
    let Pm : ContinuousMultilinearMap ℝ (fun _ : Fin d => Euclid P) ℝ :=
      (ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin d) ℝ).compContinuousLinearMap
        fun a => innerSL ℝ (f a)
    let M : Covector (Euclid P) k →
        ContinuousMultilinearMap ℝ (fun _ : Fin (d + k) => Euclid P) ℝ := fun B =>
      ((Pm.smulRight B.toContinuousMultilinearMap).uncurrySum).domDomCongr finSumFinEquiv
    have hM : ∀ B u, M B u =
        (∏ a, inner ℝ (f a) (u (Fin.castAdd k a))) * B (fun j => u (Fin.natAdd d j)) := by
      intro B u
      simp only [M, Pm, ContinuousMultilinearMap.domDomCongr_apply,
        ContinuousMultilinearMap.uncurrySum_apply, ContinuousMultilinearMap.smulRight_apply,
        ContinuousMultilinearMap.compContinuousLinearMap_apply,
        ContinuousMultilinearMap.mkPiAlgebra_apply, innerSL_apply_apply, Function.comp_apply,
        finSumFinEquiv_apply_left]
      rfl
    have hMadd : ∀ B B', M (B + B') = M B + M B' := fun B B' => by
      ext u
      simp only [hM, add_apply, ContinuousAlternatingMap.add_apply, mul_add]
    have hMsmul : ∀ (c : ℝ) B, M (c • B) = c • M B := fun c B => by
      ext u
      simp only [hM, smul_apply, ContinuousAlternatingMap.smul_apply,
        smul_eq_mul]
      ring
    have halt : ∀ (c : ℝ) (N : ContinuousMultilinearMap ℝ (fun _ : Fin (d + k) => Euclid P) ℝ),
        ContinuousMultilinearMap.alternatization (c • N) =
          c • ContinuousMultilinearMap.alternatization N := fun c N => by
      ext u
      simp only [ContinuousMultilinearMap.alternatization_apply_apply,
        smul_apply, ContinuousAlternatingMap.smul_apply, Finset.smul_sum]
      exact Finset.sum_congr rfl fun σ _ => smul_comm _ _ _
    let lift0 : Covector (Euclid P) k → Covector (Euclid P) (d + k) := fun B =>
      ((k.factorial : ℝ)⁻¹) • ContinuousMultilinearMap.alternatization (M B)
    have hladd : ∀ B B', lift0 (B + B') = lift0 B + lift0 B' := fun B B' => by
      simp only [lift0, hMadd, map_add, smul_add]
    have hlsmul : ∀ (c : ℝ) B, lift0 (c • B) = c • lift0 B := fun c B => by
      simp only [lift0, hMsmul, halt, smul_comm c]
    have hlift0 : ∀ B u, lift0 B u =
        (k.factorial : ℝ)⁻¹ * ∑ σ : Equiv.Perm (Fin (d + k)), Equiv.Perm.sign σ • M B (u ∘ σ) := by
      intro B u
      simp only [lift0, ContinuousAlternatingMap.smul_apply,
        ContinuousMultilinearMap.alternatization_apply_apply, smul_eq_mul]
    have := Submission.lcn_covector_finiteDimensional P k
    refine ⟨LinearMap.toContinuousLinearMap ⟨⟨lift0, hladd⟩, hlsmul⟩, ?_, ?_⟩
    · -- (L1): only the permutations fixing `1, …, d` contribute, each `β(w)`
      intro B w hw
      show lift0 B (Fin.append f w) = B w
      rw [hlift0]
      -- `π ↦ id_d ⊕ π`
      let ι : Equiv.Perm (Fin k) → Equiv.Perm (Fin (d + k)) := fun π =>
        finSumFinEquiv.permCongr (Equiv.Perm.sumCongr 1 π)
      have hιc : ∀ π a, ι π (Fin.castAdd k a) = Fin.castAdd k a := by
        intro π a
        simp [ι, Equiv.permCongr_apply]
      have hιn : ∀ π j, ι π (Fin.natAdd d j) = Fin.natAdd d (π j) := by
        intro π j
        simp [ι, Equiv.permCongr_apply]
      have hιinj : Function.Injective ι := by
        intro π π' h
        ext j
        have h' := congrArg (fun σ : Equiv.Perm (Fin (d + k)) => σ (Fin.natAdd d j)) h
        simp only [hιn] at h'
        exact congrArg Fin.val ((Fin.natAdd_inj d).mp h')
      have hsum : ∑ σ : Equiv.Perm (Fin (d + k)), Equiv.Perm.sign σ • M B (Fin.append f w ∘ σ) =
          ∑ _π : Equiv.Perm (Fin k), B w := by
        symm
        refine Fintype.sum_of_injective ι hιinj _ _ (fun σ hσ => ?_) (fun π => ?_)
        · by_cases hfix : ∀ a, σ (Fin.castAdd k a) = Fin.castAdd k a
          · -- `σ` fixes `1, …, d`, so `σ = ι π`
            refine absurd ?_ hσ
            let τ := finSumFinEquiv.symm.permCongr σ
            have hτ : MapsTo τ (range Sum.inl) (range Sum.inl) := by
              rintro _ ⟨a, rfl⟩
              exact ⟨a, by simp [τ, Equiv.permCongr_apply, hfix]⟩
            obtain ⟨⟨σ₁, σ₂⟩, h12⟩ := Equiv.Perm.mem_sumCongrHom_range_of_perm_mapsTo_inl hτ
            refine ⟨σ₂, Equiv.ext fun i => ?_⟩
            refine Fin.addCases (fun a => ?_) (fun j => ?_) i
            · rw [hιc, hfix]
            · rw [hιn]
              have h' := congrArg (fun τ' : Equiv.Perm (Fin d ⊕ Fin k) => τ' (Sum.inr j)) h12
              simp only [Equiv.Perm.sumCongrHom_apply, Equiv.Perm.sumCongr_apply, Sum.map_inr,
                τ, Equiv.permCongr_apply, Equiv.symm_symm, finSumFinEquiv_apply_right] at h'
              rw [← finSumFinEquiv_apply_right, h', Equiv.apply_symm_apply]
          · -- some `σ(a) ≠ a`, `a ≤ d`: the factor `⟨fₐ, (f, w)_{σ(a)}⟩` vanishes
            push Not at hfix
            obtain ⟨a, ha⟩ := hfix
            rw [hM, Finset.prod_eq_zero (Finset.mem_univ a), zero_mul, smul_zero]
            show inner ℝ (f a) (Fin.append f w (σ (Fin.castAdd k a))) = 0
            revert ha
            generalize σ (Fin.castAdd k a) = i
            refine Fin.addCases (fun b hb => ?_) (fun j _ => ?_) i
            · rw [Fin.append_left]
              exact hf.2 fun h => hb (h ▸ rfl)
            · rw [Fin.append_right]
              exact hfperp a (w j) (hw j)
        · -- `ι π` contributes `sgn π · β(w ∘ π) = β(w)`
          rw [hM]
          have h1 : ∏ a, inner ℝ (f a) ((Fin.append f w ∘ ι π) (Fin.castAdd k a)) = 1 := by
            refine Finset.prod_eq_one fun a _ => ?_
            rw [Function.comp_apply, hιc, Fin.append_left, real_inner_self_eq_norm_sq, hf.1 a,
              one_pow]
          have h2 : (fun j => (Fin.append f w ∘ ι π) (Fin.natAdd d j)) = w ∘ π := by
            funext j
            rw [Function.comp_apply, hιn, Fin.append_right, Function.comp_apply]
          have h3 := B.toAlternatingMap.map_perm w π
          rw [ContinuousAlternatingMap.coe_toAlternatingMap] at h3
          rw [h1, one_mul, h2, h3, Equiv.Perm.sign_permCongr, Equiv.Perm.sign_sumCongr,
            Equiv.Perm.sign_one, one_mul, smul_smul, Int.units_mul_self, one_smul]
      rw [hsum, Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin,
        nsmul_eq_mul, ← mul_assoc, inv_mul_cancel₀ (by positivity), one_mul]
    · -- (L2): every term has a factor `⟨fₐ, u_{σ(a)}⟩ = 0`
      intro B u a hu
      show lift0 B u = 0
      rw [hlift0, Finset.sum_eq_zero, mul_zero]
      intro σ _
      rw [hM, Finset.prod_eq_zero (Finset.mem_univ a) (hu _), zero_mul, smul_zero]
  refine ⟨fun hSb => ?_, fun hSc => ?_⟩
  · -- Step 3: `∂S = 0 ⇒ ∂S₀ = 0`
    obtain ⟨lift, hL1, hL2⟩ := hlift m
    have hSb' : (S : GeometricCurrentOn (univ : Set (Euclid P)) (d + m + 1)).boundary = 0 := hSb
    show S₀.boundary = 0
    ext β
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply]
    have hβ : IsTestForm (β : DifferentialForm (Euclid P) m) := β.property.1
    obtain ⟨Ω, hΩ_eq⟩ : ∃ Ω : DifferentialForm (Euclid P) (d + m),
        Ω = fun x => ϕ (p x) • lift ((β : DifferentialForm (Euclid P) m) (x - p x)) := ⟨_, rfl⟩
    have hΩ : IsTestForm Ω := hΩ_eq ▸ hΩtest m (d + m) lift _ hβ
    -- `DΩ(x)[h] = ϕ(px) lift(Dβ(qx)[qh]) + Dϕ(px)[ph] lift(β(qx))`, `q = I − p`
    have hderiv : ∀ x h, fderiv ℝ Ω x h =
        ϕ (p x) • lift (fderiv ℝ (β : DifferentialForm (Euclid P) m) (x - p x) (h - p h)) +
          (fderiv ℝ ϕ (p x) (p h)) • lift ((β : DifferentialForm (Euclid P) m) (x - p x)) := by
      intro x h
      have hc : HasFDerivAt (fun y => ϕ (p y)) ((fderiv ℝ ϕ (p x)).comp p) x :=
        (hϕs.differentiable (by simp) (p x)).hasFDerivAt.comp x p.hasFDerivAt
      have hq : HasFDerivAt (fun y : Euclid P => y - p y)
          (ContinuousLinearMap.id ℝ (Euclid P) - p) x :=
        (hasFDerivAt_id x).sub p.hasFDerivAt
      have hb : HasFDerivAt (fun y => lift ((β : DifferentialForm (Euclid P) m) (y - p y)))
          (lift.comp ((fderiv ℝ (β : DifferentialForm (Euclid P) m) (x - p x)).comp
            (ContinuousLinearMap.id ℝ (Euclid P) - p))) x :=
        lift.hasFDerivAt.comp x ((hβ.1.differentiable (by simp) (x - p x)).hasFDerivAt.comp x hq)
      have hΩd : HasFDerivAt (fun y => ϕ (p y) • lift ((β : DifferentialForm (Euclid P) m) (y - p y)))
          _ x := hc.smul hb
      rw [hΩ_eq, hΩd.fderiv]
      rfl
    -- `dΩ(x)(f, w) = (−1)ᵈ ϕ(px) dβ(qx)(w)` for `w ∈ (L⊥)ᵐ⁺¹`
    have hkey : ∀ x (w : Fin (m + 1) → Euclid P), (∀ i, w i ∈ Lᗮ) →
        exteriorDerivative Ω x (Fin.append f w : Fin (d + (m + 1)) → Euclid P) =
          (-1 : ℝ) ^ d * (ϕ (p x) *
            exteriorDerivative (β : DifferentialForm (Euclid P) m) (x - p x) w) := by
      intro x w hw
      have hsplit : ∀ F : Fin (d + m + 1) → ℝ, ∑ i, F i =
          ∑ a : Fin d, F (Fin.castAdd (m + 1) a) + ∑ j : Fin (m + 1), F (Fin.natAdd d j) :=
        fun F => Fin.sum_univ_add (a := d) (b := m + 1) F
      -- the terms `i = a ≤ d` vanish by (L2)
      have hterm_c : ∀ a : Fin d, (fderiv ℝ Ω x
          ((Fin.append f w : Fin (d + (m + 1)) → Euclid P) (Fin.castAdd (m + 1) a)))
          (Fin.removeNth (n := d + m) (Fin.castAdd (m + 1) a)
            (Fin.append f w : Fin (d + (m + 1)) → Euclid P)) = 0 := by
        intro a
        have hu : ∀ l, inner ℝ (f a)
            (Fin.removeNth (n := d + m) (Fin.castAdd (m + 1) a)
              (Fin.append f w : Fin (d + (m + 1)) → Euclid P) l) = 0 := by
          intro l
          have hne := Fin.succAbove_ne (Fin.castAdd (m + 1) a : Fin (d + m + 1)) l
          rw [Fin.removeNth]
          revert hne
          generalize (Fin.castAdd (m + 1) a : Fin (d + m + 1)).succAbove l = i
          refine Fin.addCases (m := d) (n := m + 1) (fun b hb => ?_) (fun j _ => ?_) i
          · rw [Fin.append_left]
            exact hf.2 fun h => hb (h ▸ rfl)
          · rw [Fin.append_right]
            exact hfperp a (w j) (hw j)
        rw [hderiv, ContinuousAlternatingMap.add_apply, ContinuousAlternatingMap.smul_apply,
          ContinuousAlternatingMap.smul_apply, hL2 _ _ a hu, hL2 _ _ a hu, smul_zero, smul_zero,
          add_zero]
      -- `(f, w)` with `w_j` removed is `(f, ŵ_j)`
      have hrem : ∀ j : Fin (m + 1), Fin.removeNth (n := d + m) (Fin.natAdd d j)
          (Fin.append f w : Fin (d + (m + 1)) → Euclid P) =
            (Fin.append f (Fin.removeNth j w) : Fin (d + m) → Euclid P) := by
        intro j
        funext l
        refine Fin.addCases (fun b => ?_) (fun l' => ?_) l
        · have h' : (Fin.natAdd d j : Fin (d + m + 1)).succAbove (Fin.castAdd m b) =
              Fin.castAdd (m + 1) b :=
            Fin.succAbove_of_castSucc_lt _ _
              (Fin.lt_def.mpr (Nat.lt_of_lt_of_le b.isLt (Nat.le_add_right _ _)))
          rw [Fin.removeNth, h', Fin.append_left, Fin.append_left]
        · have hlt : (Fin.natAdd d l' : Fin (d + m)).castSucc < (Fin.natAdd d j : Fin (d + m + 1)) ↔
              l'.castSucc < j := by
            rw [Fin.lt_def, Fin.lt_def]
            exact Nat.add_lt_add_iff_left
          have h' : (Fin.natAdd d j : Fin (d + m + 1)).succAbove (Fin.natAdd d l') =
              Fin.natAdd d (j.succAbove l') := by
            by_cases h : l'.castSucc < j
            · rw [Fin.succAbove_of_castSucc_lt _ _ h, Fin.succAbove_of_castSucc_lt _ _ (hlt.mpr h)]
              rfl
            · rw [Fin.succAbove_of_le_castSucc _ _ (not_lt.mp h),
                Fin.succAbove_of_le_castSucc _ _ (not_lt.mp (mt hlt.mp h))]
              rfl
          rw [Fin.removeNth, h', Fin.append_right, Fin.append_right, Fin.removeNth]
      -- the terms `i = d + j` give `ϕ(px) Dβ(qx)[w_j](ŵ_j)` by (L1), as `p w_j = 0`
      have hterm_n : ∀ j : Fin (m + 1), (fderiv ℝ Ω x
          ((Fin.append f w : Fin (d + (m + 1)) → Euclid P) (Fin.natAdd d j)))
          (Fin.removeNth (n := d + m) (Fin.natAdd d j)
            (Fin.append f w : Fin (d + (m + 1)) → Euclid P)) =
            ϕ (p x) * (fderiv ℝ (β : DifferentialForm (Euclid P) m) (x - p x) (w j))
              (Fin.removeNth j w) := by
        intro j
        rw [Fin.append_right, hrem, hderiv, hpLp _ (hw j), sub_zero, map_zero, zero_smul,
          add_zero, ContinuousAlternatingMap.smul_apply, hL1 _ (Fin.removeNth j w) fun l => hw _,
          smul_eq_mul]
      show ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ Ω x)
          (Fin.append f w : Fin (d + (m + 1)) → Euclid P) =
        (-1 : ℝ) ^ d * (ϕ (p x) * ContinuousAlternatingMap.alternatizeUncurryFin
          (fderiv ℝ (β : DifferentialForm (Euclid P) m) (x - p x)) w)
      rw [ContinuousAlternatingMap.alternatizeUncurryFin_apply,
        ContinuousAlternatingMap.alternatizeUncurryFin_apply, hsplit]
      simp only [hterm_c, hterm_n, smul_zero, Finset.sum_const_zero, zero_add, Fin.val_natAdd,
        zsmul_eq_mul, Int.cast_pow, Int.cast_neg, Int.cast_one, Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    -- by Step 1, `S₀(♭dΩ(t + ·)) = (−1)ᵈ ϕ(t) S₀(dβ)`; integrate over `L`
    have hdΩ : IsTestForm (exteriorDerivative Ω) := exteriorDerivative_isTestForm hΩ
    have hsl_eq : ∀ t ∈ L, currentEval S₀ (fun y => flat (exteriorDerivative Ω (t + y))) =
        ϕ t * ((-1 : ℝ) ^ d * S₀ (exteriorDerivativeTestOn univ m β)) := by
      intro t ht
      rw [hslice _ hdΩ t (((-1 : ℝ) ^ d * ϕ t) • exteriorDerivativeTestOn univ m β)
        fun y hy w hw => ?_, map_smul, smul_eq_mul]
      · ring
      rw [hkey (t + y) w hw, hpsplit t ht y hy, add_sub_cancel_left]
      show _ = ((-1 : ℝ) ^ d * ϕ t) * exteriorDerivative (β : DifferentialForm (Euclid P) m) y w
      ring
    have h1 := hS (exteriorDerivativeTestOn univ (d + m) ⟨Ω, hΩ, subset_univ _⟩)
    have h0 : S (exteriorDerivativeTestOn univ (d + m) ⟨Ω, hΩ, subset_univ _⟩) = 0 := by
      have h := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) (d + m) =>
        T ⟨Ω, hΩ, subset_univ _⟩) hSb'
      exact h
    have h2 : (∫ t in (L : Set (Euclid P)),
        currentEval S₀ (fun y => flat (exteriorDerivative Ω (t + y))) ∂μHE[d]) =
          cϕ * ((-1 : ℝ) ^ d * S₀ (exteriorDerivativeTestOn univ m β)) := by
      rw [setIntegral_congr_fun hLm fun t ht => hsl_eq t ht, integral_mul_const, hint, hcϕ_eq]
    have h3 := h0.symm.trans (h1.trans h2)
    rcases mul_eq_zero.mp h3.symm with h | h
    · exact absurd h hcϕ.ne'
    · rcases mul_eq_zero.mp h with h' | h'
      · exact absurd h' (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
      · exact h'
  · -- Step 4: cones
    obtain ⟨lift, hL1, -⟩ := hlift (m + 1)
    intro lam hlam β
    have hβ : IsTestForm (β : DifferentialForm (Euclid P) (m + 1)) := β.property.1
    have hprop : IsProperMap (fun x : Euclid P => -(lam⁻¹ • (0 : Euclid P)) + dilationCLM P lam x) := by
      convert ((Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hlam.ne')).trans
        (Homeomorph.addLeft (-(lam⁻¹ • (0 : Euclid P))))).isProperMap using 1
      funext y
      simp [dilationCLM]
    -- `η^#γ(x)(v) = λ⁻ᵏ γ(λ⁻¹x)(v)`
    have hη : ∀ (k : ℕ) (γ : DifferentialForm (Euclid P) k) (x : Euclid P) (v : Fin k → Euclid P),
        affinePullbackForm (dilationCLM P lam) (-(lam⁻¹ • (0 : Euclid P))) γ x v =
          lam⁻¹ ^ k * γ (lam⁻¹ • x) v := by
      intro k γ x v
      simp only [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply,
        dilationCLM, smul_apply, ContinuousLinearMap.id_apply, smul_zero,
        neg_zero, zero_add, Function.comp_def]
      rw [ContinuousAlternatingMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
        Fintype.card_fin, smul_eq_mul]
    -- `currentEval (η_{0,λ#}T) γ = T(η^#γ)`
    have hblow : ∀ (k : ℕ) (T : GeometricCurrentOn (univ : Set (Euclid P)) k)
        (γ : TestFormOn (univ : Set (Euclid P)) k),
        currentEval (blowUp T 0 lam hlam.ne') (γ : DifferentialForm (Euclid P) k) =
          T ⟨affinePullbackForm (dilationCLM P lam) (-(lam⁻¹ • (0 : Euclid P)))
            (γ : DifferentialForm (Euclid P) k),
            affinePullbackForm_isTestForm _ _ hprop γ.property.1, subset_univ _⟩ := by
      intro k T γ
      have hsurj : tsupport (γ : DifferentialForm (Euclid P) k) ⊆ dilation 0 lam '' univ :=
        fun y _ => ⟨lam • y, mem_univ _, by simp [dilation, dilationCLM, hlam.ne']⟩
      rw [currentEval, dite_eq_left ⟨γ.property.1, hsurj⟩]
      rfl
    obtain ⟨Ω, hΩ_eq⟩ : ∃ Ω : DifferentialForm (Euclid P) (d + (m + 1)),
        Ω = fun x => ϕ (p x) • lift ((β : DifferentialForm (Euclid P) (m + 1)) (x - p x)) :=
      ⟨_, rfl⟩
    have hΩ : IsTestForm Ω := hΩ_eq ▸ hΩtest (m + 1) (d + (m + 1)) lift _ hβ
    have hΩev : ∀ t ∈ L, ∀ y ∈ Lᗮ, ∀ w : Fin (m + 1) → Euclid P, (∀ i, w i ∈ Lᗮ) →
        Ω (t + y) (Fin.append f w) = ϕ t * (β : DifferentialForm (Euclid P) (m + 1)) y w := by
      intro t ht y hy w hw
      rw [hΩ_eq, ContinuousAlternatingMap.smul_apply, hL1 _ w hw, hpsplit t ht y hy,
        add_sub_cancel_left, smul_eq_mul]
    -- `S(Ω) = cϕ S₀(β)`
    have hSΩ : S ⟨Ω, hΩ, subset_univ _⟩ = cϕ * S₀ β := by
      rw [hS]
      have hev : ∀ t ∈ L, currentEval S₀ (fun y => flat (Ω (t + y))) = ϕ t * S₀ β := by
        intro t ht
        rw [hslice Ω hΩ t (ϕ t • β) fun y hy w hw => ?_, map_smul, smul_eq_mul]
        rw [hΩev t ht y hy w hw]
        rfl
      rw [setIntegral_congr_fun hLm fun t ht => hev t ht, integral_mul_const, hint, hcϕ_eq]
    -- `S(η^#Ω) = cϕ S₀(η^#β)`, using `μHE[d](λA) = λᵈ μHE[d](A)` on `L`
    have hηΩ : IsTestForm (affinePullbackForm (dilationCLM P lam) (-(lam⁻¹ • (0 : Euclid P))) Ω) :=
      affinePullbackForm_isTestForm _ _ hprop hΩ
    obtain ⟨ηβ, hηβ⟩ : ∃ ηβ : TestFormOn (univ : Set (Euclid P)) (m + 1),
        (ηβ : DifferentialForm (Euclid P) (m + 1)) =
          affinePullbackForm (dilationCLM P lam) (-(lam⁻¹ • (0 : Euclid P)))
            (β : DifferentialForm (Euclid P) (m + 1)) :=
      ⟨⟨_, affinePullbackForm_isTestForm _ _ hprop hβ, subset_univ _⟩, rfl⟩
    have hSηΩ : S ⟨_, hηΩ, subset_univ _⟩ = cϕ * S₀ ηβ := by
      rw [hS]
      have hev : ∀ t ∈ L, currentEval S₀ (fun y => flat
          (affinePullbackForm (dilationCLM P lam) (-(lam⁻¹ • (0 : Euclid P))) Ω (t + y))) =
            (lam⁻¹ ^ d * ϕ (lam⁻¹ • t)) * S₀ ηβ := by
        intro t ht
        rw [hslice _ hηΩ t ((lam⁻¹ ^ d * ϕ (lam⁻¹ • t)) • ηβ) fun y hy w hw => ?_, map_smul,
          smul_eq_mul]
        rw [hη, smul_add, hΩev _ (L.smul_mem _ ht) _ (Lᗮ.smul_mem _ hy) w hw]
        show _ = (lam⁻¹ ^ d * ϕ (lam⁻¹ • t)) * (ηβ : DifferentialForm (Euclid P) (m + 1)) y w
        rw [hηβ, hη, pow_add]
        ring
      rw [setIntegral_congr_fun hLm fun t ht => hev t ht, integral_mul_const, hint]
      rw [show (∫ x : L, lam⁻¹ ^ d * ϕ (lam⁻¹ • (x : Euclid P))) = cϕ from ?_]
      have h := MeasureTheory.Measure.integral_comp_inv_smul_of_nonneg (volume : Measure L)
        (fun x : L => ϕ x) hlam.le
      simp only [Submodule.coe_smul] at h
      rw [integral_const_mul, h, hdL, hcϕ_eq, smul_eq_mul, ← mul_assoc, inv_pow,
        inv_mul_cancel₀ (pow_ne_zero _ hlam.ne'), one_mul]
    -- the cone property of `S` gives `cϕ S₀(η^#β) = cϕ S₀(β)`
    have hcone := hSc lam hlam ⟨Ω, hΩ, subset_univ _⟩
    rw [hblow] at hcone
    rw [hblow]
    have h : cϕ * S₀ ηβ = cϕ * S₀ β := by
      rw [← hSηΩ, ← hSΩ]
      exact hcone
    have h' : S₀ ηβ = S₀ β := mul_left_cancel₀ hcϕ.ne' h
    rw [← h']
    exact congrArg S₀ (Subtype.ext hηβ.symm)

/-- **Simon Ch. 6, 2.30–2.32 and 3.10**, cone filling in a subspace: let `m ≥ 1`, `V ⊆ ℝᴾ` a
linear subspace, and `X ∈ 𝒟_m(ℝᴾ)` integer multiplicity with `∂X = 0`, `spt X` compact and
`spt X ⊆ V`.  Then the cone `Y = 0 ⨯ X ∈ 𝒟_{m+1}(ℝᴾ)` is integer multiplicity, `∂Y = X`, and
`spt Y` is compact and contained in `V`.  Write `m = q + 1`.  `X` has a representation with carrier
in `spt X` and finite mass, and an integral Lipschitz parametrization `(Gᵢ, Aᵢ, wᵢ, cᵢ)` with
`Gᵢ(Aᵢ) ⊆ spt X` (`dimred_cs_sos_cfs_compact_im_param`).  The cone `Y(ω) = X(ζ Kω)` has `∂Y = X`
and compact support in `{s x : s ∈ [0, 1], x ∈ spt X}` (`dimred_cs_sos_cfs_cone_current`).  The
maps `(s, u) ↦ s Gᵢ(u)` parametrize `Y` (`dimred_cs_sos_cfs_cone_param`), so `Y` is integer
multiplicity (`dimred_cs_sos_cfs_param_series_im`; Simon 6.3.9 applied to the cone gives 6.3.10).
Finally `s x ∈ V` for `x ∈ spt X ⊆ V`, since `V` is a subspace. -/
theorem Submission.dimred_cs_sos_cone_filling_in_subspace : ∀ (P m : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) m) (V : Submodule ℝ (Euclid P)), 0 < m → IsIntegerMultiplicity X → BoundaryVanishes X → IsCompact X.support → X.support ⊆ (V : Set (Euclid P)) → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Y ∧ Y.boundary = X ∧ IsCompact Y.support ∧ Y.support ⊆ (V : Set (Euclid P)) := by
  intro P m X V hm hX hbX hcX hXV
  -- write `m = q + 1`; then `BoundaryVanishes X` reads `∂X = 0`
  obtain ⟨q, rfl⟩ : ∃ q, m = q + 1 := ⟨m - 1, by omega⟩
  have hbX' : X.boundary = 0 := hbX
  -- step 7: a representation `R` of `X` with carrier in `spt X` and finite mass, and an integral
  -- Lipschitz parametrization `(Gᵢ, Aᵢ, wᵢ, cᵢ)` of `X` with `Gᵢ(Aᵢ) ⊆ spt X`
  obtain ⟨R, hRX, hRsub, hRfin, G, A, w, c, hG, hA, hw, hc, hGd, hGA, hwi, hcb, hfin, hXG⟩ :=
    Submission.dimred_cs_sos_cfs_compact_im_param P (q + 1) X hX hcX
  -- steps 0 and 3–6: the cone `Y = 0 ⨯ X`, with `∂Y = X`, compact support in the cone over
  -- `spt X`, and `Y(ω) = X(η)` for a test form `η` equal to `Kω` on `spt X`
  obtain ⟨Y, hYb, hYc, hYsub, hYX⟩ :=
    Submission.dimred_cs_sos_cfs_cone_current P q X R hRX hRsub hRfin hbX' hcX
  -- step 8: the maps `(s, u) ↦ s Gᵢ(u)` give an integral Lipschitz parametrization of `Y`
  obtain ⟨H, B, w', c', hH, hB, hw', hc', hwi', hcb', hfin', hYH⟩ :=
    Submission.dimred_cs_sos_cfs_cone_param P q X Y G A w c hcX hG hA hw hc hGd hGA hwi hcb hfin
      hXG hYX
  -- step 9 (Simon 6.3.10): `Y` is integer multiplicity
  have hYim : IsIntegerMultiplicity Y :=
    Submission.dimred_cs_sos_cfs_param_series_im P (q + 1) Y H B w' c' hH hB hw' hc' hwi' hcb'
      hfin' hYH
  -- step 10: `spt Y ⊆ {s x : s ∈ [0, 1], x ∈ spt X} ⊆ V`, since `V` is a subspace
  refine ⟨Y, hYim, hYb, hYc, fun y hy => ?_⟩
  obtain ⟨s, -, x, hx, rfl⟩ := hYsub hy
  exact V.smul_mem s (hXV hx)

/-- **Simon Lemma 7.3.5 (p. 190), minimality of `S₀`.**  If the minimizing `S ∈ 𝒟ₙ(ℝᴾ)` is the
product `[[L]] × S₀` (measure identity and action formula; `d = dim L ≥ 1`, `f` an orthonormal
frame of `L`) of `L` with an integer multiplicity cycle `S₀ ∈ 𝒟ₘ(ℝᴾ)`, `m = n − d`, concentrated
on `L^⊥`, then `S₀` is minimizing in `L^⊥`.

Suppose `M_{W₀}(S₀') < M_{W₀}(S₀)` for a competitor `S₀'` with `spt(S₀' − S₀)` a compact subset
of `L^⊥ ∩ W₀`.  The cycle `X₀ = S₀' − S₀` is integer multiplicity and bounds a cone `Y₀` with
compact support in `L^⊥`.  For `r > 0` the cube cycle `Z = [[Q_r]] × X₀ + E'` gives the
competitor `S + Z` for `S`, so `(2r)^d M_{W₀}(S₀) ≤ (2r)^d M_{W₀}(S₀') + 2d(2r)^{d−1} M(Y₀)`.
Both masses are finite, so this fails for `r > d M(Y₀)/(M_{W₀}(S₀) − M_{W₀}(S₀'))`. -/
theorem Submission.dimred_cs_sos_minimality_transfer : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)) (f : Fin (Module.finrank ℝ L) → Euclid P) (S₀ : GeometricCurrentOn (univ : Set (Euclid P)) (n - Module.finrank ℝ L)) (R₀ : IMRep (univ : Set (Euclid P)) (n - Module.finrank ℝ L)) (hd : Module.finrank ℝ L < n), 0 < Module.finrank ℝ L → Orthonormal ℝ f → (∀ i, f i ∈ L) → IsMinimizingIn S univ → R.Represents S → R₀.Represents S₀ → BoundaryVanishes S₀ → R₀.measure (Lᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → R.measure A = ∫⁻ t in (L : Set (Euclid P)), R₀.measure ((fun y => t + y) ⁻¹' A) ∂μHE[Module.finrank ℝ L]) → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) (n - Module.finrank ℝ L), (∀ (α : Covector (Euclid P) n) (v : Fin (n - Module.finrank ℝ L) → Euclid P), flat α v = α (Fin.append f v ∘ Fin.cast (Nat.add_sub_of_le hd.le).symm)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, S ω = ∫ t in (L : Set (Euclid P)), currentEval S₀ (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[Module.finrank ℝ L]) → IsMinimizingIn S₀ (Lᗮ : Set (Euclid P)) := by
  intro P n S R L f S₀ R₀ hd hk hf hfL hSmin hR hR₀ hS₀ hR₀L hmeas hprod
  have hm : 0 < n - Module.finrank ℝ L := Nat.sub_pos_of_lt hd
  -- `f` is an orthonormal family of `dim L` vectors of `L`, so it spans `L`.
  have hspan : Submodule.span ℝ (Set.range f) = L := by
    refine Submodule.eq_of_le_of_finrank_eq
      (Submodule.span_le.2 (Set.range_subset_iff.2 hfL)) ?_
    rw [finrank_span_eq_card hf.linearIndependent, Fintype.card_fin]
  refine ⟨⟨R₀, hR₀⟩, ?_⟩
  intro W₀ S₀' hW₀ hW₀cc hS₀' hsame hXc hXsupp
  by_contra hlt
  rw [not_le] at hlt
  -- `X₀ = S₀' − S₀` is an integer multiplicity cycle with compact support in `L^⊥`.
  have hXIM : IsIntegerMultiplicity (S₀' - S₀) :=
    Submission.rsd_isIntegerMultiplicity_int_combination P _ univ S₀' S₀ (S₀' - S₀) 1 (-1)
      isOpen_univ hS₀' ⟨R₀, hR₀⟩ fun ω => by
        change S₀' ω - S₀ ω = _
        push_cast
        ring
  have hXbd : BoundaryVanishes (S₀' - S₀) := by
    have key : ∀ (j : ℕ) (A B : GeometricCurrentOn (univ : Set (Euclid P)) j),
        SameBoundary A B → BoundaryVanishes B → BoundaryVanishes (A - B) := by
      intro j A B hAB hB
      cases j with
      | zero => trivial
      | succ j =>
        have hAB' : A.boundary = B.boundary := hAB
        refine GeometricCurrentOn.ext fun ω => ?_
        rw [GeometricCurrentOn.zero_apply]
        change A.boundary ω - B.boundary ω = 0
        rw [hAB', sub_self]
    exact key _ S₀' S₀ hsame hS₀
  -- The cone `Y₀` over `X₀`: `∂Y₀ = X₀`, `spt Y₀` compact in `L^⊥`.
  obtain ⟨Y₀, ⟨RY, hRY⟩, hYbd, hYc, hYL⟩ :=
    Submission.dimred_cs_sos_cone_filling_in_subspace P _ (S₀' - S₀) Lᗮ hm hXIM hXbd hXc
      fun x hx => (hXsupp hx).1
  -- `M_{W₀}(S₀) = μ₀(W₀) ≤ μ₀(closure W₀) < ∞`.
  have hu : S₀.massOn W₀ ≠ ∞ := by
    have hcl : MeasurableSet (closure W₀) := isClosed_closure.measurableSet
    rw [Submission.imrep_represents_massOn_eq_measure P _ univ W₀ S₀ R₀ isOpen_univ hR₀ hW₀
      (subset_univ _)]
    refine ne_top_of_le_ne_top ?_ (measure_mono subset_closure)
    rw [IMRep.measure, withDensity_apply _ hcl, Measure.restrict_restrict hcl, inter_comm]
    exact R₀.locallyIntegrable_mult _ hW₀cc.1 (subset_univ _)
  have hv : S₀'.massOn W₀ ≠ ∞ := ne_top_of_lt hlt
  -- `M(Y₀) = μ_{Y₀}(ℝᴾ) = μ_{Y₀}(spt Y₀) < ∞`.
  have hM : Y₀.mass ≠ ∞ := by
    have hYm : MeasurableSet Y₀.support := hYc.isClosed.measurableSet
    have hnull : RY.measure (Y₀.support)ᶜ = 0 := by
      rw [IMRep.measure, withDensity_apply _ hYm.compl, Measure.restrict_restrict hYm.compl]
      refine setLIntegral_measure_zero _ _ ?_
      rw [inter_comm, ← sdiff_eq]
      exact Submission.imrep_carrier_sdiff_support_null P _ univ Y₀ RY isOpen_univ hRY
    change Y₀.massOn univ ≠ ∞
    rw [Submission.imrep_represents_massOn_eq_measure P _ univ univ Y₀ RY isOpen_univ hRY
      isOpen_univ subset_rfl, ← measure_add_measure_compl hYm, hnull, add_zero,
      IMRep.measure, withDensity_apply _ hYm, Measure.restrict_restrict hYm, inter_comm]
    exact RY.locallyIntegrable_mult _ hYc (subset_univ _)
  -- For every `r > 0`, the cube cycle `Z = [[Q_r]] × X₀ + E'` and minimality of `S` give
  -- `(2r)^d M_{W₀}(S₀) ≤ (2r)^d M_{W₀}(S₀') + 2d(2r)^{d−1} M(Y₀)`.
  have hYL' : Y₀.support ⊆ ((Submodule.span ℝ (Set.range f))ᗮ : Set (Euclid P)) := by
    rw [hspan]
    exact hYL
  obtain ⟨R₀', hR₀'⟩ := hS₀'
  have hbox : ∀ r : ℝ, 0 < r →
      ENNReal.ofReal ((2 * r) ^ Module.finrank ℝ L) * S₀.massOn W₀ ≤
        ENNReal.ofReal ((2 * r) ^ Module.finrank ℝ L) * S₀'.massOn W₀ +
          ENNReal.ofReal (2 * (Module.finrank ℝ L : ℝ) * (2 * r) ^ (Module.finrank ℝ L - 1)) *
            Y₀.mass := by
    intro r hr
    obtain ⟨Z, E', hZ, hZbd, hZc, hZsupp, hE', hZact⟩ :=
      Submission.dimred_cs_sos_mt_cube_cycle P _ _ n f (Nat.add_sub_of_le hd.le).symm
        (S₀' - S₀) Y₀ r hk hm hf hXIM ⟨RY, hRY⟩ hYbd hYc hYL' hr
    exact (Submission.dimred_cs_sos_mt_competitor_mass P _ _ n f
      (Nat.add_sub_of_le hd.le).symm L S R S₀ S₀' R₀ R₀' W₀ Y₀.support Z E' r hk hm hf hspan
      hSmin hR hR₀ hR₀' hR₀L hmeas hprod hW₀ hW₀cc.1 hXsupp hYc hr hZ hZbd hZc hZsupp
      hZact).trans (add_le_add le_rfl hE')
  -- In real numbers, `r = (d M(Y₀) + 1)/(M_{W₀}(S₀) − M_{W₀}(S₀'))` violates this.
  have huv : (S₀'.massOn W₀).toReal < (S₀.massOn W₀).toReal :=
    (ENNReal.toReal_lt_toReal hv hu).2 hlt
  obtain ⟨r, hr, hrr⟩ : ∃ r : ℝ, 0 < r ∧
      r * ((S₀.massOn W₀).toReal - (S₀'.massOn W₀).toReal) =
        (Module.finrank ℝ L : ℝ) * Y₀.mass.toReal + 1 :=
    ⟨_, div_pos (by positivity) (sub_pos.2 huv), div_mul_cancel₀ _ (sub_pos.2 huv).ne'⟩
  have hfin₁ : ENNReal.ofReal ((2 * r) ^ Module.finrank ℝ L) * S₀'.massOn W₀ ≠ ∞ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top hv
  have hfin₂ : ENNReal.ofReal (2 * (Module.finrank ℝ L : ℝ) *
      (2 * r) ^ (Module.finrank ℝ L - 1)) * Y₀.mass ≠ ∞ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top hM
  have hreal := ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨hfin₁, hfin₂⟩) (hbox r hr)
  rw [ENNReal.toReal_add hfin₁ hfin₂, ENNReal.toReal_mul, ENNReal.toReal_mul,
    ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity),
    ENNReal.toReal_ofReal (by positivity)] at hreal
  have hpow : (2 * r) ^ Module.finrank ℝ L = 2 * r * (2 * r) ^ (Module.finrank ℝ L - 1) := by
    rw [← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ Module.finrank ℝ L)]
  rw [hpow] at hreal
  have hc : 0 < (2 * r) ^ (Module.finrank ℝ L - 1) := pow_pos (by positivity) _
  have h4 : (2 * r) ^ (Module.finrank ℝ L - 1) *
      (r * ((S₀.massOn W₀).toReal - (S₀'.massOn W₀).toReal)) =
        (2 * r) ^ (Module.finrank ℝ L - 1) *
          ((Module.finrank ℝ L : ℝ) * Y₀.mass.toReal + 1) := by
    rw [hrr]
  linarith

/-- **Simon 7.3.5** (chapter-07.txt lines 410–418, proof "left to the reader"): a minimizing
cone `S = τ(M, θ, ξ)` in `ℝᴾ` with `∂S = 0` that is invariant under the translations `τ_v`,
`v ∈ L`, where `d = dim L < n` and `L ⊆ TₓM` for `μ`-a.e. `x`, splits off its spine:
`S = [[L]] × S₀` for an integer multiplicity `S₀ ∈ 𝒟_{n−d}(ℝᴾ)` that is minimizing in `L⊥`, has
`∂S₀ = 0`, is a cone, has `spt S₀ ⊆ L⊥`, `μ₀(ℝᴾ ∖ L⊥) = 0` and `μ(A) = ∫_L μ₀(A − t) dHᵈ(t)`.
If `d = 0`, then `L = {0}`, `L⊥ = ℝᴾ` and `H⁰⌞{0}` is the unit point mass at `0`, so `S₀ = S`,
`R₀ = R` work.  If `d ≥ 1`, fix an orthonormal basis `f₁, …, f_d` of `L`.  Slicing by the
projection onto `L` and the translation invariance give `S₀ = τ(R₀)` with the support, null-set
and measure statements and `S(ω) = ∫_L S₀(♭ω(t + ·)) dHᵈ(t)`, `♭α(v) = α(f₁, …, f_d, v)`
(`dimred_cs_sos_product_decomposition`).  Testing this identity with the forms
`ϕ(px) dt¹ ∧ ⋯ ∧ dtᵈ ∧ q^#β` passes `∂S = 0` and the cone property to `S₀`
(`dimred_cs_sos_boundary_cone_transfer`), and the competitors
`S + [[Q_R]] × X₀ − (−1)^{d−1}[[∂Q_R]] × (0 ⨯ X₀)` show that `S₀` is minimizing in `L⊥`
(`dimred_cs_sos_minimality_transfer`). -/
theorem Submission.dimred_cs_split_off_spine : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)), Module.finrank ℝ L < n → n ≤ P → IsMinimizingIn S univ → BoundaryVanishes S → IsConeCurrent S → (∀ v ∈ L, ∀ ω : TestFormOn (univ : Set (Euclid P)) n, currentEval (blowUp S (-v) 1 one_ne_zero) (ω : DifferentialForm (Euclid P) n) = S ω) → R.Represents S → (∀ᵐ x ∂R.measure, ∀ v ∈ L, (approxTangentPlane n R.carrier x).starProjection v = v) → ∃ (S₀ : GeometricCurrentOn (univ : Set (Euclid P)) (n - Module.finrank ℝ L)) (R₀ : IMRep (univ : Set (Euclid P)) (n - Module.finrank ℝ L)), R₀.Represents S₀ ∧ IsMinimizingIn S₀ (Lᗮ : Set (Euclid P)) ∧ BoundaryVanishes S₀ ∧ IsConeCurrent S₀ ∧ S₀.support ⊆ (Lᗮ : Set (Euclid P)) ∧ R₀.measure (Lᗮ : Set (Euclid P))ᶜ = 0 ∧ ∀ A : Set (Euclid P), MeasurableSet A → R.measure A = ∫⁻ t in (L : Set (Euclid P)), R₀.measure ((fun y => t + y) ⁻¹' A) ∂μHE[Module.finrank ℝ L] := by
  intro P n S R L hd _hnP hmin hbd hcone htrans hR htan
  rcases Nat.eq_zero_or_pos (Module.finrank ℝ L) with hd0 | hdpos
  · -- `d = 0`: `L = {0}`, so `L⊥ = ℝᴾ` and `n − d = n`; take `S₀ = S` and `R₀ = R`.
    obtain rfl : L = ⊥ := Submodule.finrank_eq_zero.mp hd0
    rw [hd0, Nat.sub_zero, Submodule.bot_orthogonal_eq_top, Submodule.top_coe,
      Submodule.bot_coe]
    refine ⟨S, R, hR, hmin, hbd, hcone, subset_univ _, by rw [compl_univ, measure_empty],
      fun A _ => ?_⟩
    -- `∫_{{0}} μ(A − t) dH⁰(t) = μ(A) H⁰({0}) = μ(A)`: `H⁰ = μH[0]` is the counting measure.
    rw [lintegral_singleton, Measure.euclideanHausdorffMeasure_zero,
      Measure.hausdorffMeasure_zero_singleton, mul_one]
    simp only [zero_add, preimage_id']
  · -- `d ≥ 1`: an orthonormal basis `f₁, …, f_d` of `L`.
    obtain ⟨f, hf, hfL⟩ : ∃ f : Fin (Module.finrank ℝ L) → Euclid P,
        Orthonormal ℝ f ∧ ∀ i, f i ∈ L :=
      ⟨L.subtypeₗᵢ ∘ stdOrthonormalBasis ℝ L,
        (stdOrthonormalBasis ℝ L).orthonormal.comp_linearIsometry L.subtypeₗᵢ,
        fun i => (stdOrthonormalBasis ℝ L i).2⟩
    -- `S = [[L]] × S₀`: `S₀ = τ(R₀)`, `spt S₀ ⊆ L⊥`, `μ₀(ℝᴾ ∖ L⊥) = 0`, `μ = Hᵈ⌞L ⊗ μ₀` and
    -- `S(ω) = ∫_L S₀(♭ω(t + ·)) dHᵈ(t)`.
    obtain ⟨S₀, R₀, hR₀, hspt, hnull, hmeas, hprod⟩ :=
      Submission.dimred_cs_sos_product_decomposition P n S R L f hd hdpos hf hfL htrans hR htan
    -- `∂S = 0` and the cone property pass to `S₀`.
    obtain ⟨hbd₀, hcone₀⟩ :=
      Submission.dimred_cs_sos_boundary_cone_transfer P n S L f S₀ R₀ hd hdpos hf hfL hR₀ hnull
        hprod
    have hbdS₀ : BoundaryVanishes S₀ := hbd₀ hbd
    -- Minimality passes to `S₀`: otherwise large-cube product competitors would beat `S`.
    have hmin₀ : IsMinimizingIn S₀ (Lᗮ : Set (Euclid P)) :=
      Submission.dimred_cs_sos_minimality_transfer P n S R L f S₀ R₀ hd hdpos hf hfL hmin hR hR₀
        hbdS₀ hnull hmeas hprod
    exact ⟨S₀, R₀, hR₀, hmin₀, hbdS₀, hcone₀ hcone, hspt, hnull, hmeas⟩

/-- **Simon 7.3.1, footnote 2** (orthogonal projection onto a subspace does not increase area):
if `T ∈ 𝒟ₘ(ℝᴾ)`, `m ≥ 1`, is minimizing in the subspace `V` and `spt T ⊆ V`, then `T` is
minimizing in `ℝᴾ`.  Let `q` be the orthogonal projection onto `V`; `μ_T(ℝᴾ \ V) = 0` since
`spt μ_T = spt T`.  For a competitor `S` with `K' = spt(S − T)` a compact subset of `W`, the
current `S'' = T + q_#(S − T)` is a competitor in `V` inside `W* = {x : qx ∈ q(W), |x − qx| < 1}`,
with `S'' − T = q_#(S − T)` supported in `q(K')`.  With `A = q(W)`, `μ_S = μ_T` off `K'` gives
`μ_T(W) + μ_T(A \ W) ≤ μ_T(W*) = M_{W*}(T) ≤ M_{W*}(S'') ≤ μ_S(q⁻¹(A)) ≤ μ_S(W) + μ_T(A \ W)`,
and the finite term `μ_T(A \ W)` cancels. -/
theorem Submission.dimred_cs_minimizing_of_minimizing_in_subspace : ∀ (P m : ℕ) (T : GeometricCurrentOn (univ : Set (Euclid P)) m) (V : Submodule ℝ (Euclid P)), 0 < m → IsMinimizingIn T (V : Set (Euclid P)) → T.support ⊆ (V : Set (Euclid P)) → IsMinimizingIn T univ := by
  intro P m T V hm hTV hsptV
  obtain _ | k := m
  · exact absurd hm (lt_irrefl 0)
  obtain ⟨⟨RT, hRT⟩, hmin⟩ := hTV
  -- `q = V.starProjection` is the identity on `V` and has range in `V`
  have hqV : ∀ x, V.starProjection x ∈ V := fun x => V.starProjection_apply_mem x
  have hqid : ∀ x ∈ V, V.starProjection x = x := fun x hx =>
    Submodule.starProjection_eq_self_iff.2 hx
  have hqq : ∀ x, V.starProjection (V.starProjection x) = V.starProjection x := fun x =>
    hqid _ (hqV x)
  have hVcl : IsClosed (V : Set (Euclid P)) := V.closed_of_finiteDimensional
  -- Step 1: `μ_T(ℝᴾ \ V) = 0`, because `spt μ_T = spt T ⊆ V`
  obtain ⟨hmassT, hsptT⟩ :=
    Submission.dor_imrep_massOn_eq_measure_and_support P (k + 1) univ T RT isOpen_univ hRT
  have hTV0 : RT.measure ((V : Set (Euclid P))ᶜ) = 0 := by
    refine measure_mono_null ?_ (Measure.measure_compl_support (μ := RT.measure))
    intro x hxV hxμ
    refine hxV (hsptV ?_)
    rw [hsptT]
    exact ⟨mem_univ x, hxμ⟩
  -- `μ_T` is finite on compact sets
  have hTfin : ∀ K : Set (Euclid P), IsCompact K → RT.measure K ≠ ∞ := by
    intro K hK
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact RT.locallyIntegrable_mult K hK (subset_univ K)
  refine ⟨⟨RT, hRT⟩, fun W S hW hWc hS hST hK hKW => ?_⟩
  -- Step 2: `X = S − T` is integer multiplicity with `∂X = 0`, and `K' = spt X ⊆ W`
  have hK'W : (S - T).support ⊆ W := fun x hx => (hKW hx).2
  have hXval : ∀ ω, (S - T) ω = S ω - T ω := fun ω => rfl
  obtain ⟨RX, hRX⟩ :=
    Submission.dtc_isIntegerMultiplicity_sub P (k + 1) univ S T isOpen_univ hm hS ⟨RT, hRT⟩
  have hXbdry : BoundaryVanishes (S - T) := by
    have hST' : S.boundary = T.boundary := hST
    show (S - T).boundary = 0
    ext φ
    show S.boundary φ - T.boundary φ = 0
    rw [hST', sub_self]
  -- `Y = q_#X`, and the competitor `S'' = T − ((Y − Y) − Y)`, i.e. `S'' = T + Y`
  obtain ⟨Y, hYim, hYspt, hYbdry, hYval⟩ :=
    Submission.dimred_cs_sp_linear_pushforward P (k + 1) (S - T) RX V.starProjection hm hRX hK
  obtain ⟨S'', hS''⟩ : ∃ S'' : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1),
      S'' = T - ((Y - Y) - Y) := ⟨_, rfl⟩
  have hS''val : ∀ ω, S'' ω = T ω + Y ω := fun ω => by
    rw [hS'']
    show T ω - ((Y ω - Y ω) - Y ω) = T ω + Y ω
    ring
  have hS''T : S'' - T = Y := by
    ext ω
    show S'' ω - T ω = Y ω
    rw [hS''val]
    ring
  have hS''im : IsIntegerMultiplicity S'' := by
    have hYY :=
      Submission.dtc_isIntegerMultiplicity_sub P (k + 1) univ Y Y isOpen_univ hm hYim hYim
    rw [hS'']
    exact Submission.dtc_isIntegerMultiplicity_sub P (k + 1) univ T _ isOpen_univ hm ⟨RT, hRT⟩
      (Submission.dtc_isIntegerMultiplicity_sub P (k + 1) univ _ Y isOpen_univ hm hYY hYim)
  have hS''bdry : SameBoundary S'' T := by
    have hY0 : Y.boundary = 0 := hYbdry hXbdry
    show S''.boundary = T.boundary
    ext φ
    have hYφ : Y.boundary φ = 0 := by rw [hY0]; rfl
    have h1 : S''.boundary φ = T.boundary φ + Y.boundary φ :=
      hS''val (exteriorDerivativeTestOn univ k φ)
    rw [h1, hYφ, add_zero]
  -- Step 3: the window `W* = {x : qx ∈ A, |x − qx| < 1}` with `A = q(W)`
  obtain ⟨A, hA⟩ : ∃ A : Set (Euclid P), A = V.starProjection '' W := ⟨_, rfl⟩
  obtain ⟨Wst, hWst⟩ : ∃ Wst : Set (Euclid P),
      Wst = {x | V.starProjection x ∈ A ∧ ‖x - V.starProjection x‖ < 1} := ⟨_, rfl⟩
  have hAWst : A ⊆ Wst := by
    rw [hWst, hA]
    rintro _ ⟨w, hw, rfl⟩
    refine ⟨⟨w, hw, (hqq w).symm⟩, ?_⟩
    rw [hqq, sub_self, norm_zero]
    exact one_pos
  have hWVst : W ∩ V ⊆ Wst := by
    rw [hWst, hA]
    rintro x ⟨hxW, hxV⟩
    refine ⟨⟨x, hxW, rfl⟩, ?_⟩
    rw [hqid x hxV, sub_self, norm_zero]
    exact one_pos
  have hpre : V.starProjection ⁻¹' Wst ⊆ V.starProjection ⁻¹' A := by
    rw [hWst]
    intro x hx
    have h := hx.1
    rwa [hqq] at h
  have hWst_open : IsOpen Wst := by
    have hpreA : V.starProjection ⁻¹' A =
        ⋃ (v : Euclid P) (_ : V.starProjection v = 0), (fun x => x + v) ⁻¹' W := by
      rw [hA]
      ext x
      simp only [mem_preimage, mem_image, mem_iUnion, exists_prop]
      constructor
      · rintro ⟨w, hw, hwx⟩
        refine ⟨w - x, by rw [map_sub, hwx, sub_self], ?_⟩
        rwa [add_sub_cancel]
      · rintro ⟨v, hv, hxv⟩
        exact ⟨x + v, hxv, by rw [map_add, hv, add_zero]⟩
    have h1 : IsOpen (V.starProjection ⁻¹' A) := by
      rw [hpreA]
      exact isOpen_biUnion fun v _ => hW.preimage (continuous_id.add continuous_const)
    have h2 : IsOpen {x : Euclid P | ‖x - V.starProjection x‖ < 1} :=
      isOpen_lt (continuous_norm.comp (continuous_id.sub V.starProjection.continuous))
        continuous_const
    rw [hWst]
    exact h1.inter h2
  have hWst_cpt : IsCompact (closure Wst) := by
    obtain ⟨r, hr⟩ := (hWc.1.isBounded.subset subset_closure).subset_closedBall (0 : Euclid P)
    refine (isCompact_closedBall (0 : Euclid P) (r + 1)).of_isClosed_subset isClosed_closure
      (closure_minimal ?_ isClosed_closedBall)
    rw [hWst, hA]
    rintro x ⟨⟨w, hw, hwx⟩, hx1⟩
    rw [mem_closedBall_zero_iff]
    calc ‖x‖ = ‖V.starProjection x + (x - V.starProjection x)‖ := by rw [add_sub_cancel]
      _ ≤ ‖V.starProjection x‖ + ‖x - V.starProjection x‖ := norm_add_le _ _
      _ ≤ r + 1 := by
        refine add_le_add ?_ hx1.le
        rw [← hwx]
        exact (Submodule.norm_starProjection_apply_le (K := V) w).trans
          (mem_closedBall_zero_iff.1 (hr hw))
  -- `S'' − T = Y` is supported in the compact set `q(K') ⊆ V ∩ W*`
  have hYcl : IsClosed Y.support := isClosed_univ.sdiff Y.isOpen_zeroRegion
  have hS''cpt : IsCompact (S'' - T).support := by
    rw [hS''T]
    exact (hK.image V.starProjection.continuous).of_isClosed_subset hYcl hYspt
  have hS''spt : (S'' - T).support ⊆ (V : Set (Euclid P)) ∩ Wst := by
    rw [hS''T]
    intro y hy
    obtain ⟨x, hx, rfl⟩ := hYspt hy
    exact ⟨hqV x, hAWst (hA ▸ ⟨x, hK'W hx, rfl⟩)⟩
  -- minimality of `T` in `V`: `M_{W*}(T) ≤ M_{W*}(S'')`
  have hminW := hmin Wst S'' hWst_open ⟨hWst_cpt, subset_univ _⟩ hS''im hS''bdry hS''cpt hS''spt
  -- Step 4: `M_{W*}(S'') ≤ μ_S(q⁻¹(W*))` for the representation `R` of `S = T + X`
  obtain ⟨R, hRact, hRmass⟩ :=
    Submission.dimred_cs_sp_projected_massOn_le P (k + 1) T (S - T) S'' RT RX V hRT hRX hTV0 hK
      (fun ω => by rw [hS''val, hYval])
  have hRS : R.Represents S := fun ω => by
    rw [hRact, hXval]
    ring
  obtain ⟨hmassS, -⟩ :=
    Submission.dor_imrep_massOn_eq_measure_and_support P (k + 1) univ S R isOpen_univ hRS
  -- Step 5: `S = T` off `K'`, so `μ_S = μ_T` there
  have hagree : ∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1),
      tsupport (ω : DifferentialForm (Euclid P) (k + 1)) ⊆ (S - T).supportᶜ → S ω = T ω := by
    intro ω hω
    have h0 := Submission.dtc_vanish_off_support P (k + 1) univ (S - T) ω
      (Set.disjoint_left.2 fun x hx => hω hx)
    rw [hXval] at h0
    exact sub_eq_zero.1 h0
  have hloc := Submission.dimred_cs_sp_measure_restrict_eq_of_agree P (k + 1) S T R RT
    (S - T).supportᶜ hK.isClosed.isOpen_compl hRS hRT hagree
  have hsubK : V.starProjection ⁻¹' A \ W ⊆ (S - T).supportᶜ := fun x hx hxK => hx.2 (hK'W hxK)
  have hlocW : R.measure (V.starProjection ⁻¹' A \ W) =
      RT.measure (V.starProjection ⁻¹' A \ W) := by
    rw [← Measure.restrict_eq_self R.measure hsubK, hloc,
      Measure.restrict_eq_self RT.measure hsubK]
  have hdisj : Disjoint (W ∩ V) (A \ W) := Set.disjoint_left.2 fun x hx hx' => hx'.2 hx.1
  have hfin : RT.measure (A \ W) ≠ ∞ :=
    ne_top_of_le_ne_top (hTfin _ hWst_cpt)
      (measure_mono (sdiff_subset.trans (hAWst.trans subset_closure)))
  -- `μ_T(W) + μ_T(A \ W) ≤ μ_S(W) + μ_T(A \ W)`
  have hchain : RT.measure W + RT.measure (A \ W) ≤ R.measure W + RT.measure (A \ W) :=
    calc RT.measure W + RT.measure (A \ W)
        = RT.measure (W ∩ V) + RT.measure (A \ W) := by rw [measure_inter_conull hTV0]
      _ = RT.measure ((W ∩ V) ∪ (A \ W)) :=
        (measure_union' hdisj (hW.measurableSet.inter hVcl.measurableSet)).symm
      _ ≤ RT.measure Wst := measure_mono (union_subset hWVst (sdiff_subset.trans hAWst))
      _ = T.massOn Wst := (hmassT Wst hWst_open).symm
      _ ≤ S''.massOn Wst := hminW
      _ ≤ R.measure (V.starProjection ⁻¹' Wst) := hRmass Wst
      _ ≤ R.measure (V.starProjection ⁻¹' A) := measure_mono hpre
      _ ≤ R.measure (W ∪ (V.starProjection ⁻¹' A \ W)) :=
        measure_mono (subset_union_right.trans union_sdiff_self.symm.subset)
      _ ≤ R.measure W + R.measure (V.starProjection ⁻¹' A \ W) := measure_union_le _ _
      _ = R.measure W + RT.measure (V.starProjection ⁻¹' A \ W) := by rw [hlocW]
      _ ≤ R.measure W + RT.measure (A \ W) := by
        refine add_le_add le_rfl ?_
        calc RT.measure (V.starProjection ⁻¹' A \ W)
            = RT.measure ((V.starProjection ⁻¹' A \ W) ∩ V) := (measure_inter_conull hTV0).symm
          _ ≤ RT.measure (A \ W) := measure_mono fun x ⟨⟨hxA, hxW⟩, hxV⟩ =>
            ⟨by rwa [mem_preimage, hqid x hxV] at hxA, hxW⟩
  -- Step 6: cancel `μ_T(A \ W) < ∞`, so `M_W(T) = μ_T(W) ≤ μ_S(W) = M_W(S)`
  rw [hmassT W hW, hmassS W hW]
  exact ENNReal.le_of_add_le_add_right hfin hchain
/-- **Invariant minimizing cycles are cones that split off their spine** (Simon Lemma 7.3.5, with
the invariance step of the proof of 7.3.3 and footnote 2 of 7.3.1).  Let `S ∈ 𝒟ₙ(ℝᴾ)` be
minimizing with `∂S = 0`, and `L ⊆ ℝᴾ` a subspace with `d = dim L < n` such that the density of
`S` is invariant under `w ↦ y + λw` (`y ∈ L`, `λ > 0`).  If `n > P` then `S = 0`.  Otherwise fix
`S = τ(M, θ, ξ)` and `μ = θHⁿ⌞M`: by monotonicity `Θ(S, ·)` exists everywhere, and by 7.1.2
(`U = N = ℝᴾ`) `v(M, θ)` is stationary.  The invariance of `Θ` makes `μ` invariant under
translations by `L` and `n`-homogeneous, so the monotonicity identity gives `x ∈ TₓM` and
`L ⊆ TₓM` for `μ`-a.e. `x`; hence `S` is a cone and is invariant under translations by `L`
(homotopy formula).  Slicing by the projection onto `L` gives `S = [[L]] × S₀`, where `S₀` is a cone
cycle in `L^⊥`, minimizing in `L^⊥` (product competitors) and hence in `ℝᴾ` (orthogonal
projection), and `μ = Hᵈ⌞L ⊗ μ_{S₀}`; supports and densities correspond through this product. -/
theorem Submission.dimred_invariant_cone_splitting : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)), Module.finrank ℝ L < n → IsMinimizingIn S univ → BoundaryVanishes S → (∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ (w : Euclid P) (θ : ℝ), HasMassDensity S w θ → HasMassDensity S (y + lam • w) θ) → IsConeCurrent S ∧ (∀ v ∈ L, ∀ ω : TestFormOn (univ : Set (Euclid P)) n, currentEval (blowUp S (-v) 1 one_ne_zero) (ω : DifferentialForm (Euclid P) n) = S ω) ∧ ∃ S₀ : GeometricCurrentOn (univ : Set (Euclid P)) (n - Module.finrank ℝ L), IsMinimizingIn S₀ univ ∧ BoundaryVanishes S₀ ∧ IsConeCurrent S₀ ∧ S₀.support ⊆ (Lᗮ : Set (Euclid P)) ∧ (∀ t ∈ L, ∀ y ∈ Lᗮ, (t + y ∈ S.support ↔ y ∈ S₀.support)) ∧ ∀ t ∈ L, ∀ y ∈ Lᗮ, ∀ θ : ℝ, (HasMassDensity S (t + y) θ ↔ HasMassDensity S₀ y θ) := by
  intro P n S L hd hmin hbd hinv
  -- `n > P`: every `n`-current in `ℝᴾ` vanishes
  rcases lt_or_ge P n with hPn | hnP
  · exact Submission.dimred_cs_high_degree_case P n S L hPn
  have hn : 0 < n := (Nat.zero_le _).trans_lt hd
  -- `ℝᵐ` is an embedded `C²` `m`-submanifold of itself (identity chart)
  have huniv : ∀ m : ℕ, IsEmbeddedSubmanifold 2 m (univ : Set (Euclid m)) := fun m y _ =>
    ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiffOn_id, injOn_id _,
      by simp, fun K _ hK => by simpa using hK, fun z _ => by
        rw [fderiv_id, ContinuousLinearMap.coe_id']; exact injective_id⟩
  obtain ⟨R, hR⟩ := hmin.1
  -- `Θ(S, x)` exists at every `x` (monotonicity with `U = N = ℝᴾ`)
  obtain ⟨-, -, ⟨Θ, hΘ, -⟩, -⟩ := Submission.dimred_minimizing_monotonicity P n P univ univ S
    hn hnP le_rfl isOpen_univ (huniv P) (by simp) (by rwa [inter_self]) (by simp) hbd
  -- `v(M, θ)` is stationary in `ℝᴾ` (7.1.2 with `U = N = ℝᴾ`, where every vector is tangent)
  have hstat : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
      R.firstVariation X = 0 := by
    obtain ⟨k, rfl⟩ : ∃ k, P = n + k := ⟨P - n, by omega⟩
    intro X hX hXc
    refine (Submission.minimizing_implies_stationary n k k le_rfl univ univ S isOpen_univ
      (huniv (n + k)) (by simp) (subset_univ _) (by rwa [inter_self]) hbd R hR).1 X hX hXc
      (subset_univ _) fun y _ => ⟨fun t => y + t • X y,
        (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffOn, mapsTo_univ _ _,
        by simp, by simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (X y)).const_add y⟩
  -- `μ` is invariant under translations by `L` and `n`-homogeneous
  obtain ⟨htrans, hscale⟩ := Submission.dimred_cs_measure_invariant_of_density_invariant P n S R L
    hn hR (fun x => ⟨Θ x, hΘ x (mem_univ x)⟩) hinv
  -- `x ∈ TₓM` and `L ⊆ TₓM` for `μ`-a.e. `x`
  have htan := Submission.dimred_cs_spine_tangent_of_invariant_measure P n R L hn hstat htrans
    hscale
  -- (a) `S` is a cone; (b) `S` is invariant under translations by `L`
  have hcone : IsConeCurrent S := Submission.dimred_cs_cone_of_radial_tangency P n S R hn hR hbd
    (htan.mono fun x hx => hx.1)
  have htr : ∀ v ∈ L, ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
      currentEval (blowUp S (-v) 1 one_ne_zero) (ω : DifferentialForm (Euclid P) n) = S ω :=
    fun v hv => Submission.dimred_cs_translation_invariant_of_tangency P n S R v hn hR hbd
      (htan.mono fun x hx => hx.2 v hv)
  refine ⟨hcone, htr, ?_⟩
  -- `S = [[L]] × S₀`: `S₀` is a cone cycle in `L^⊥`, minimizing in `L^⊥`, `μ = Hᵈ⌞L ⊗ μ_{S₀}`
  obtain ⟨S₀, R₀, hR₀, hmin₀, hbd₀, hcone₀, hspt₀, hnull₀, hprod⟩ :=
    Submission.dimred_cs_split_off_spine P n S R L hd hnP hmin hbd hcone htr hR
      (htan.mono fun x hx => hx.2)
  -- `S₀` is minimizing in `ℝᴾ` (orthogonal projection onto `L^⊥`; `n − d ≥ 1`)
  have hmin₀' : IsMinimizingIn S₀ univ :=
    Submission.dimred_cs_minimizing_of_minimizing_in_subspace P (n - Module.finrank ℝ L) S₀ Lᗮ
      (by omega) hmin₀ hspt₀
  -- `Θ(S₀, y)` exists at every `y` (monotonicity for `S₀`)
  obtain ⟨-, -, ⟨Θ₀, hΘ₀, -⟩, -⟩ := Submission.dimred_minimizing_monotonicity P
    (n - Module.finrank ℝ L) P univ univ S₀ (by omega) (by omega) le_rfl isOpen_univ (huniv P)
    (by simp) (by rwa [inter_self]) (by simp) hbd₀
  -- supports and densities correspond through `μ = Hᵈ⌞L ⊗ μ_{S₀}`
  obtain ⟨hsupp, hdens⟩ := Submission.dimred_cs_product_support_density P n L S S₀ R R₀ hd hR hR₀
    hnull₀ hprod fun y _ => ⟨Θ₀ y, hΘ₀ y (mem_univ y)⟩
  exact ⟨S₀, hmin₀', hbd₀, hcone₀, hspt₀, hsupp, hdens⟩

theorem Submission.codim1_zsl_fl_perimeter_bound : ∀ (n k : ℕ) (Us : ℕ → Set (Euclid (n + 1 + k))) (Ss : (i : ℕ) → GeometricCurrentOn (Us i) n) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (b : Euclid k) (gs : ℕ → Euclid (n + 1) → Euclid k) (Fs : ℕ → Set (Euclid (n + 1))), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ y : Euclid (n + 1 + k), ∃ v w, y = ι v + ι' w) → (∀ i, MeasurableSet (Fs i)) → (∀ R : ℝ, 0 < R → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid (n + 1)) R, DifferentiableAt ℝ (gs i) w) → (∀ R ε : ℝ, 0 < R → 0 < ε → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid (n + 1)) R, ‖gs i w - b‖ < ε ∧ ‖fderiv ℝ (gs i) w‖ < ε) → (∀ R : ℝ, 0 < R → ∀ᶠ i in atTop, ∀ ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n, tsupport (ω : DifferentialForm (Euclid (n + 1 + k)) n) ⊆ ball 0 R → currentEval (Ss i) (ω : DifferentialForm (Euclid (n + 1 + k)) n) = ∫ w in Fs i ∩ ball 0 R, exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n) (ι w + ι' (gs i w)) (fun j => fderiv ℝ (fun w => ι w + ι' (gs i w)) w (EuclideanSpace.single j (1 : ℝ)))) → (∀ R : ℝ, 0 < R → ∃ c : ℝ, ∀ᶠ i in atTop, ∀ ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n, tsupport (ω : DifferentialForm (Euclid (n + 1 + k)) n) ⊆ ball 0 R → (∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid (n + 1 + k)) n) y) ≤ 1) → currentEval (Ss i) (ω : DifferentialForm (Euclid (n + 1 + k)) n) ≤ c) → ∀ R : ℝ, 0 < R → ∃ c : ℝ, ∀ᶠ i in atTop, ∀ φ : Euclid (n + 1) → Euclid (n + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ ball 0 R → (∀ v, ‖φ v‖ ≤ 1) → ∫ v in Fs i, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ v).toLinearMap ≤ c := by
  intro n k Us Ss ι ι' b gs Fs hperp hspan hFs hH1 hH2 hH3 hH4 R hR
  -- Constants: `K` from the divergence lift, `h := ‖b‖ + 1`, `R₂ := R + 2h`, `c := K c₂`.
  obtain ⟨K, hK, hlift⟩ := Submission.codim1_zsl_fl_divergence_lift n k ι ι' hperp hspan
  set h : ℝ := ‖b‖ + 1 with hh
  have hhpos : 0 < h := by positivity
  set R₂ : ℝ := R + 2 * h with hR₂
  have hR₂pos : 0 < R₂ := by positivity
  obtain ⟨c₂, hc₂⟩ := hH4 R₂ hR₂pos
  refine ⟨K * c₂, ?_⟩
  -- (H1)–(H4) at radius `R₂` (with `ε = 1` in (H2)) hold simultaneously for all large `i`.
  filter_upwards [hH1 R₂ hR₂pos, hH2 R₂ 1 hR₂pos one_pos, hH3 R₂ hR₂pos, hc₂] with i hi1 hi2 hi3 hi4
  intro φ hφ hφc hφs hφn
  -- The lifted test form is admissible in (H4) and represented by (H3).
  obtain ⟨ω, hωs, hωn, hωd⟩ := hlift h R hhpos φ hφ hφc hφs hφn
  have hle := hi4 ω hωs hωn
  rw [hi3 ω hωs] at hle
  -- On `B_{R₂}`, `gs i` is differentiable with `‖gs i w‖ < h`, so the integrand is `K⁻¹ div φ`.
  have hcongr : ∫ w in Fs i ∩ ball 0 R₂, exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n)
        (ι w + ι' (gs i w)) (fun j => fderiv ℝ (fun w => ι w + ι' (gs i w)) w
          (EuclideanSpace.single j (1 : ℝ))) =
      ∫ w in Fs i ∩ ball 0 R₂, K⁻¹ * LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ w).toLinearMap := by
    apply setIntegral_congr_fun ((hFs i).inter measurableSet_ball)
    intro w hw
    apply hωd (gs i) w (hi1 w hw.2)
    have := (hi2 w hw.2).1
    calc ‖gs i w‖ = ‖(gs i w - b) + b‖ := by rw [sub_add_cancel]
      _ ≤ ‖gs i w - b‖ + ‖b‖ := norm_add_le _ _
      _ < 1 + ‖b‖ := by linarith
      _ = h := by ring
  rw [hcongr, integral_const_mul] at hle
  -- `div φ` vanishes off `tsupport φ ⊆ B_R ⊆ B_{R₂}`, so the ball can be dropped.
  have hdiv : ∫ w in Fs i ∩ ball 0 R₂, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ w).toLinearMap =
      ∫ w in Fs i, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ w).toLinearMap := by
    refine (setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hFs i) inter_subset_left ?_).symm
    intro w hw
    have hwnot : w ∉ tsupport φ := fun hmem =>
      hw.2 ⟨hw.1, ball_subset_ball (by linarith) (hφs hmem)⟩
    have h0 : fderiv ℝ φ w = 0 :=
      image_eq_zero_of_notMem_tsupport (fun hmem => hwnot (tsupport_fderiv_subset ℝ hmem))
    simp [h0]
  rw [hdiv] at hle
  -- Multiply `K⁻¹ ∫_{Fs i} div φ ≤ c₂` by `K > 0`.
  have := mul_le_mul_of_nonneg_left hle hK.le
  rwa [← mul_assoc, mul_inv_cancel₀ hK.ne', one_mul] at this

/-- **Flat limit of the rescaled region boundaries** (Simon 7.5.3, 7.5.5; steps C1, D1, D5 and E3
of the supplied proof).  Let `Gᵢ(w) = ιw + ι'gᵢ(w)` with `gᵢ → b` in `C¹` on every ball (H1, H2),
`Sᵢ(ω) = ∫_{Fᵢ ∩ B_R} dω(Gᵢ)(DGᵢ e)` for `spt ω ⊆ B_R(0)` (H3), `Sᵢ` of locally bounded mass (H4),
and `Sᵢ ⇀ S`.  Then `S = ∂[[F]]` with `ξ_A = ιe₀ ∧ ⋯ ∧ ιeₙ` for a measurable `F` in the plane
`ι(ℝ^{n+1}) + ι'b`.  `codim1_zsl_fl_perimeter_bound` gives the local perimeter bounds of the `Fᵢ`,
`codim1_zsl_perimeter_compactness` a subsequence with `F_{σ i} → F'` in `L¹_loc`, and
`codim1_zsl_fl_graph_integral_tendsto` the limit `∫_{F' ∩ B_R} dω(G)(ιe)`, `G(w) = ιw + ι'b`, of
the integrals in (H3) along `σ`; with `Sᵢ ⇀ S` this is `S(ω)` when `spt ω ⊆ B_R(0)`.  As
`|G(w)| ≥ |w|`, the restriction to `B_R` can be dropped, and
`codim1_zsl_fl_isometry_image_setIntegral` moves the integral to `F := G(F')`. -/
theorem Submission.codim1_zsl_flat_graph_limit : ∀ (n k : ℕ) (Us : ℕ → Set (Euclid (n + 1 + k))) (Ss : (i : ℕ) → GeometricCurrentOn (Us i) n) (S : GeometricCurrentOn (univ : Set (Euclid (n + 1 + k))) n) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ξA : MultiVector (n + 1 + k) (n + 1)) (b : Euclid k) (gs : ℕ → Euclid (n + 1) → Euclid k) (Fs : ℕ → Set (Euclid (n + 1))), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ y : Euclid (n + 1 + k), ∃ v w, y = ι v + ι' w) → (∀ α : Covector (Euclid (n + 1 + k)) (n + 1), ξA α = α (fun j => ι (EuclideanSpace.single j (1 : ℝ)))) → ConvergesWeakly Ss S → (∀ i, MeasurableSet (Fs i)) → (∀ R : ℝ, 0 < R → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid (n + 1)) R, DifferentiableAt ℝ (gs i) w) → (∀ R ε : ℝ, 0 < R → 0 < ε → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid (n + 1)) R, ‖gs i w - b‖ < ε ∧ ‖fderiv ℝ (gs i) w‖ < ε) → (∀ R : ℝ, 0 < R → ∀ᶠ i in atTop, ∀ ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n, tsupport (ω : DifferentialForm (Euclid (n + 1 + k)) n) ⊆ ball 0 R → currentEval (Ss i) (ω : DifferentialForm (Euclid (n + 1 + k)) n) = ∫ w in Fs i ∩ ball 0 R, exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n) (ι w + ι' (gs i w)) (fun j => fderiv ℝ (fun w => ι w + ι' (gs i w)) w (EuclideanSpace.single j (1 : ℝ)))) → (∀ R : ℝ, 0 < R → ∃ c : ℝ, ∀ᶠ i in atTop, ∀ ω : TestFormOn (univ : Set (Euclid (n + 1 + k))) n, tsupport (ω : DifferentialForm (Euclid (n + 1 + k)) n) ⊆ ball 0 R → (∀ y, covectorEuclideanNorm ((ω : DifferentialForm (Euclid (n + 1 + k)) n) y) ≤ 1) → currentEval (Ss i) (ω : DifferentialForm (Euclid (n + 1 + k)) n) ≤ c) → ∃ F : Set (Euclid (n + 1 + k)), MeasurableSet F ∧ F ⊆ {y | ∃ w, y = ι w + ι' b} ∧ IsBoundaryOfRegion S F (fun _ => ξA) := by
  intro n k Us Ss S ι ι' ξA b gs Fs hperp hspan hξA hconv hFs hH1 hH2 hH3 hH4
  -- Part B: (H1)–(H4) give uniform local perimeter bounds for the `Fᵢ`.
  have hper := Submission.codim1_zsl_fl_perimeter_bound n k Us Ss ι ι' b gs Fs hperp hspan hFs
    hH1 hH2 hH3 hH4
  -- C1: BV compactness, `L^{n+1}((F_{σ i} Δ F') ∩ B_R) → 0` for every `R`.
  obtain ⟨σ, F', hσ, hF', hsymm⟩ := Submission.codim1_zsl_perimeter_compactness (n + 1) Fs hFs hper
  -- E1–E2: `F := G(F')` is measurable and `∫_F f dH^{n+1} = ∫_{F'} f ∘ G`.
  obtain ⟨hFmeas, htrans⟩ :=
    Submission.codim1_zsl_fl_isometry_image_setIntegral (n + 1) (n + 1 + k) ι (ι' b) F' hF'
  refine ⟨(fun w => ι w + ι' b) '' F', hFmeas, ?_, ?_⟩
  · rintro y ⟨w, -, rfl⟩
    exact ⟨w, rfl⟩
  · intro ω
    -- D1: `dω` is a test form, and `spt ω ⊆ B_R(0)` for some `R > 0`.
    have hωtest : IsTestForm (ω : DifferentialForm (Euclid (n + 1 + k)) n) := ω.property.1
    have hdω := exteriorDerivative_isTestForm hωtest
    obtain ⟨R, hRpos, hR⟩ :=
      hωtest.2.isCompact.isBounded.subset_ball_lt 0 (0 : Euclid (n + 1 + k))
    -- D2–D4: along `σ` the graph integrals tend to the integral over the flat graph `G`.
    have hσt : Tendsto σ atTop atTop := hσ.tendsto_atTop
    have hlim := Submission.codim1_zsl_fl_graph_integral_tendsto (n + 1) k (n + 1 + k) ι ι' b R
      (exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n)) (fun i => gs (σ i))
      (fun i => Fs (σ i)) F' hdω.1.continuous hdω.2 (fun i => hFs (σ i)) hF' (hsymm R)
      (hσt.eventually (hH1 R hRpos)) (fun ε hε => hσt.eventually (hH2 R ε hRpos hε))
    -- D5: by (H3) these integrals are eventually `S_{σ i}(ω)`, and `S_{σ i}(ω) → S(ω)`.
    have heq : (fun i => currentEval (Ss (σ i)) (ω : DifferentialForm (Euclid (n + 1 + k)) n))
        =ᶠ[atTop] fun i => ∫ w in Fs (σ i) ∩ ball 0 R,
          exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n) (ι w + ι' (gs (σ i) w))
            (fun j => fderiv ℝ (fun w => ι w + ι' (gs (σ i) w)) w
              (EuclideanSpace.single j (1 : ℝ))) := by
      filter_upwards [hσt.eventually (hH3 R hRpos)] with i hi
      exact hi ω hR
    have hS := tendsto_nhds_unique (((hconv ω).comp hσt).congr' heq) hlim
    -- E3: move the integral to `F = G(F')` and use `ξ_A(α) = α(ιe)`.
    rw [hS, htrans]
    simp only [hξA]
    symm
    -- `dω(G(w)) = 0` for `|w| ≥ R`, since `|G(w)|² = |w|² + |b|²` and `spt dω ⊆ B_R(0)`.
    apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hF' inter_subset_left
    rintro w ⟨hwF, hwB⟩
    have hwB' : R ≤ ‖w‖ := by
      by_contra hlt
      exact hwB ⟨hwF, by simpa using (not_le.1 hlt)⟩
    have hnorm : ‖w‖ ≤ ‖ι w + ι' b‖ := by
      have h2 : ‖ι w + ι' b‖ ^ 2 = ‖w‖ ^ 2 + ‖b‖ ^ 2 := by
        rw [norm_add_sq_real, hperp, LinearIsometry.norm_map, LinearIsometry.norm_map]
        ring
      nlinarith [norm_nonneg w, norm_nonneg (ι w + ι' b), sq_nonneg ‖b‖]
    have hnot : ι w + ι' b ∉
        tsupport (exteriorDerivative (ω : DifferentialForm (Euclid (n + 1 + k)) n)) := by
      intro hmem
      have := hR (tsupport_exteriorDerivative_subset _ hmem)
      rw [mem_ball, dist_zero_right] at this
      linarith
    rw [image_eq_zero_of_notMem_tsupport hnot]
    rfl

/-- **Blow-ups of `∂[[E]]` along a `C¹` graph flatten to `∂[[F]]` in a plane** (Simon 7.5.3 and
7.5.5, chapter-07.txt lines 790–901).  Near `x` the carrier `N` is the graph
`Γ(v) = x + ιv + ι'u(v)` of a `C¹` map `u` with `Du(0) = 0`, oriented by `ξN`.  If `T = ∂[[E]]`
has local mass bounds, `xᵢ → x` lie within `C₀λᵢ` of `N`, `λᵢ → 0` and `η_{xᵢ,λᵢ#}T ⇀ S`, then
`S = ∂[[F]]` with the constant orientation `ξN(x)`, for a measurable `F` in a plane
`{ιw + ι'b}`.  In chart coordinates `xᵢ = x + ιsᵢ + ι'tᵢ` the blow-ups live on the rescaled graphs
of `gᵢ(w) = λᵢ⁻¹(u(sᵢ + λᵢw) − tᵢ)`, which flatten in `C¹` to the constant `b` along a
subsequence; the flat limit lemma then identifies `S`. -/
theorem Submission.codim1_zsl_graph_blowup_limit : ∀ (n k : ℕ) (U N E : Set (Euclid (n + 1 + k))) (ξN : Euclid (n + 1 + k) → MultiVector (n + 1 + k) (n + 1)) (T : GeometricCurrentOn U n) (x : Euclid (n + 1 + k)) (xs : ℕ → Euclid (n + 1 + k)) (lams : ℕ → ℝ) (hlams : ∀ i, 0 < lams i) (S : GeometricCurrentOn (univ : Set (Euclid (n + 1 + k))) n) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (u : Euclid (n + 1) → Euclid k) (δ₁ δ₂ C₀ : ℝ), IsOpen U → MeasurableSet E → E ⊆ N → IsBoundaryOfRegion T E ξN → x ∈ U → Tendsto xs atTop (𝓝 x) → Tendsto lams atTop (𝓝 0) → (∃ C r₀ : ℝ, 0 < r₀ ∧ ∀ y ∈ ball x r₀, ∀ ρ : ℝ, 0 < ρ → ρ < r₀ → T.massOn (ball y ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → ConvergesWeakly (fun i => blowUp T (xs i) (lams i) (hlams i).ne') S → (∀ i, ∃ p ∈ N, dist p (xs i) ≤ C₀ * lams i) → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ y : Euclid (n + 1 + k), ∃ v w, y = ι v + ι' w) → 0 < δ₁ → 0 < δ₂ → ContDiffOn ℝ 1 u (ball 0 δ₁) → u 0 = 0 → fderiv ℝ u 0 = 0 → (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, u v ∈ ball (0 : Euclid k) δ₂) → N ∩ {y | ∃ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∃ w ∈ ball (0 : Euclid k) δ₂, y = x + ι v + ι' w} = (fun v => x + ι v + ι' (u v)) '' ball (0 : Euclid (n + 1)) δ₁ → (∀ α : Covector (Euclid (n + 1 + k)) (n + 1), ξN x α = α (fun j => ι (EuclideanSpace.single j (1 : ℝ)))) → (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∀ α : Covector (Euclid (n + 1 + k)) (n + 1), α (fun j => fderiv ℝ (fun v => x + ι v + ι' (u v)) v (EuclideanSpace.single j (1 : ℝ))) = Real.sqrt (((fderiv ℝ (fun v => x + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => x + ι v + ι' (u v)) v).det) * ξN (x + ι v + ι' (u v)) α) → ∃ (b : Euclid k) (F : Set (Euclid (n + 1 + k))), MeasurableSet F ∧ F ⊆ {y | ∃ w, y = ι w + ι' b} ∧ IsBoundaryOfRegion S F (fun _ => ξN x) := by
  intro n k U N E ξN T x xs lams hlams S ι ι' u δ₁ δ₂ C₀ hU hE hEN hT hxU hxs hlams0 hmass hconv
    hnear horth hspan hδ₁ hδ₂ hu _hu0 hDu0 _huδ₂ hchart hξx hξ
  -- Steps 1 and 3 (centre_offsets): `xᵢ = x + ι sᵢ + ι' tᵢ` with `sᵢ, tᵢ → 0`, and the points of
  -- `N` within `C₀λᵢ` of `xᵢ` give bounded offsets on the graph of `u`.
  obtain ⟨s, t, hst, hs, ht, hoff⟩ := Submission.codim1_zsl_gbl_centre_chart_offsets (n + 1) k
    (n + 1 + k) N x xs lams ι ι' u δ₁ δ₂ C₀ hxs hlams0 hlams hnear horth hspan hδ₁ hδ₂ hchart
  -- Steps 2, 4 and 5 (graph_flattening): along a subsequence `σ` the rescaled graph maps
  -- `gᵢ(w) = λᵢ⁻¹(u(sᵢ + λᵢw) − tᵢ)` converge in `C¹` on every ball to a constant `b`.
  obtain ⟨σ, b, hσ, hdiff, hflat⟩ := Submission.codim1_zsl_gbl_rescaled_graph_flattening (n + 1) k
    u δ₁ C₀ s t lams hδ₁ hu hDu0 hlams hs hlams0 hoff
  have hσt : Tendsto σ atTop atTop := hσ.tendsto_atTop
  -- Step 8 (graph_representation, fed by blowup_region and graph_area): at every scale `λᵢ` the
  -- parameter set `F'ᵢ` is measurable, and the blow-up is represented on the rescaled graph over
  -- every ball `B_R` satisfying the scale conditions.
  have hrep := fun i => Submission.codim1_zsl_gbl_blowUp_graph_representation n k U N E ξN T x
    (xs i) (lams i) (hlams i) ι ι' u δ₁ δ₂ (s i) (t i) hE hEN
    (Submission.codim1_zsl_blowUp_isBoundaryOfRegion (n + 1 + k) n U E ξN T (xs i) (lams i)
      (hlams i) hT)
    (fun g D A f hD hg hA hAD =>
      Submission.codim1_zsl_graph_area_formula (n + 1) k ι ι' g D A f horth hD hg hA hAD)
    horth hspan hu hchart hξ (hst i)
  -- Step 6: for every `R` the scale conditions hold for all large `i`, because `sᵢ, tᵢ, λᵢ → 0`,
  -- `xᵢ → x` and `ball(x, r) ⊆ U`.
  obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hU x hxU
  have hscale : ∀ R : ℝ, ∀ᶠ i in atTop, ‖s i‖ + lams i * R < δ₁ ∧ ‖t i‖ + lams i * R < δ₂ ∧
      ball (xs i) (lams i * R) ⊆ U := by
    intro R
    have h₁ : Tendsto (fun i => ‖s i‖ + lams i * R) atTop (𝓝 0) := by
      simpa using (tendsto_norm_zero.comp hs).add (hlams0.mul_const R)
    have h₂ : Tendsto (fun i => ‖t i‖ + lams i * R) atTop (𝓝 0) := by
      simpa using (tendsto_norm_zero.comp ht).add (hlams0.mul_const R)
    have h₃ : Tendsto (fun i => lams i * R + dist (xs i) x) atTop (𝓝 0) := by
      simpa using (hlams0.mul_const R).add (tendsto_iff_dist_tendsto_zero.1 hxs)
    filter_upwards [h₁.eventually_lt_const hδ₁, h₂.eventually_lt_const hδ₂,
      h₃.eventually_lt_const hr] with i hi₁ hi₂ hi₃
    exact ⟨hi₁, hi₂, (ball_subset_ball' hi₃.le).trans hrU⟩
  -- Step 9 (flat_limit) along `σ`: weak convergence passes to the subsequence; (H1)–(H2) are the
  -- `C¹` flattening, (H3) the graph representation and (H4) the mass bound of step 7.
  obtain ⟨F, hFmeas, hFplane, hFS⟩ := Submission.codim1_zsl_flat_graph_limit n k
    (fun i => dilation (xs (σ i)) (lams (σ i)) '' U)
    (fun i => blowUp T (xs (σ i)) (lams (σ i)) (hlams (σ i)).ne') S ι ι' (ξN x) b
    (fun i w => (lams (σ i))⁻¹ • (u (s (σ i) + lams (σ i) • w) - t (σ i)))
    (fun i => {w : Euclid (n + 1) | s (σ i) + lams (σ i) • w ∈ ball (0 : Euclid (n + 1)) δ₁ ∧
      x + ι (s (σ i) + lams (σ i) • w) + ι' (u (s (σ i) + lams (σ i) • w)) ∈ E})
    horth hspan hξx (fun ω => (hconv ω).comp hσt) (fun i => (hrep (σ i)).1) hdiff hflat
    (fun R _ => (hσt.eventually (hscale R)).mono fun i hi ω hω =>
      (hrep (σ i)).2 R hi.1 hi.2.1 hi.2.2 ω hω)
    (fun R hR => by
      obtain ⟨c, hc⟩ := Submission.codim1_zsl_gbl_blowUp_mass_bound (n + 1 + k) n U T x xs lams
        hlams hxs hlams0 hmass R hR
      exact ⟨c, hσt.eventually hc⟩)
  exact ⟨b, F, hFmeas, hFplane, hFS⟩

/-- **Zero-scale limits of blow-ups of `∂[[E]]` with moving centres** (Simon 7.5.3–7.5.5,
chapter-07.txt lines 790–901, as used for 7.5.8).  Let `N ∈ 𝒪` in `U` be oriented by `ξ_N`,
`T = ∂[[E]]` with `E ⊆ N ∩ U`, `M_{B_ρ(y)}(T) ≤ Cρⁿ` near `x ∈ U`, `xᵢ → x`, `λᵢ → 0⁺` and
`η_{xᵢ,λᵢ#}T ⇀ S` with `spt S ≠ ∅`.  Then `S = ∂[[F]]` for a Borel set `F` in an affine
`(n+1)`-plane `A = Q − a` of class `𝒪` of `ℝᴾ`, oriented by the constant `ξ_A = ξ_N(x)`.
`spt S ≠ ∅` gives `x ∈ N` and `dist(xᵢ, N) = O(λᵢ)`; a chart of `N` at `x` forces
`P = n + 1 + k`; in the oriented graph chart `v ↦ x + ιv + ι'u(v)` of `N` over `T_xN = range ι`
the blow-ups converge to `∂[[F]]` with `F ⊆ {ιw + ι'b}`; and `ξ_N(x) = ιe₀ ∧ ⋯ ∧ ιeₙ` orients
`Q := range ι`, so `a := −ι'b`. -/
theorem Submission.codim1_zero_scale_limit_offset_plane : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n) (x : Euclid P) (xs : ℕ → Euclid P) (lams : ℕ → ℝ) (hlams : ∀ i, 0 < lams i) (S : GeometricCurrentOn (univ : Set (Euclid P)) n), 1 ≤ n → IsOpen U → InClassO n U N ξN → MeasurableSet E → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN → x ∈ U → Tendsto xs atTop (𝓝 x) → Tendsto lams atTop (𝓝 0) → (∃ C r₀ : ℝ, 0 < r₀ ∧ ∀ y ∈ ball x r₀, ∀ ρ : ℝ, 0 < ρ → ρ < r₀ → T.massOn (ball y ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → ConvergesWeakly (fun i => blowUp T (xs i) (lams i) (hlams i).ne') S → S.support.Nonempty → ∃ (Q : Submodule ℝ (Euclid P)) (a : Euclid P) (F : Set (Euclid P)) (ξA : MultiVector P (n + 1)), Module.finrank ℝ Q = n + 1 ∧ InClassO n (univ : Set (Euclid P)) {y | y + a ∈ Q} (fun _ => ξA) ∧ MeasurableSet F ∧ F ⊆ {y | y + a ∈ Q} ∧ IsBoundaryOfRegion S F (fun _ => ξA) := by
  intro P n U N E ξN T x xs lams hlams S _hn hU hO hE hEU hT hx hxs hlams0 hmass hconv hS
  obtain ⟨hNsub, hNor, hNcl, -⟩ := hO
  have hEN : E ⊆ N := fun y hy => (hEU hy).1
  -- `dist(xᵢ, N) = O(λᵢ)` and `x ∈ N`, since `spt S ≠ ∅`
  obtain ⟨hxN, C₀, -, hp⟩ := Submission.codim1_zsl_blowUp_centres_near P n U N E ξN T x xs lams
    hlams S hNcl hEN hT hx hxs hlams0 hconv hS
  -- a chart of `N` at `x` has an injective derivative `ℝ^{n+1} → ℝᴾ`, so `P = n + 1 + k`
  obtain ⟨k, rfl⟩ : ∃ k, P = n + 1 + k := by
    obtain ⟨V, W, ψ, -, -, hxW, -, -, hψV, -, hinj⟩ := hNsub x hxN
    obtain ⟨z, hz, -⟩ : x ∈ ψ '' V := by
      rw [hψV]
      exact ⟨hxW, hxN⟩
    have h := LinearMap.finrank_le_finrank_of_injective
      (f := (fderiv ℝ ψ z : Euclid (n + 1) →ₗ[ℝ] Euclid P)) (hinj z hz)
    rw [finrank_euclideanSpace_fin, finrank_euclideanSpace_fin] at h
    exact ⟨P - (n + 1), by omega⟩
  -- the oriented graph chart of `N` at `x` over `T_xN = range ι`
  obtain ⟨ι, ι', u, δ₁, δ₂, horth, hspan, hδ₁, hδ₂, hu, hu0, hdu0, hub, hchart, hξx, hξ⟩ :=
    Submission.codim1_zsl_oriented_graph_chart n k N ξN x hNsub hNor hxN
  -- the blow-ups converge to `∂[[F]]`, `F` in the plane `{ιw + ι'b}`
  obtain ⟨b, F, hF, hFsub, hSF⟩ := Submission.codim1_zsl_graph_blowup_limit n k U N E ξN T x xs
    lams hlams S ι ι' u δ₁ δ₂ C₀ hU hE hEN hT hx hxs hlams0 hmass hconv hp horth hspan hδ₁ hδ₂ hu
    hu0 hdu0 hub hchart hξx hξ
  -- `ξ_N(x) = ιe₀ ∧ ⋯ ∧ ιeₙ` is a unit orientation of `Q := range ι`
  have hQ : IsUnitOrientationOf (ξN x) (LinearMap.range ι.toLinearMap) := by
    refine ⟨fun j => ι (EuclideanSpace.single j (1 : ℝ)),
      EuclideanSpace.orthonormal_single.comp_linearIsometry ι, ?_, Or.inl hξx⟩
    have he : (fun j => ι (EuclideanSpace.single j (1 : ℝ))) =
        ι.toLinearMap ∘ (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis := by
      funext j
      simp
    rw [he, range_comp, ← Submodule.map_span, Module.Basis.span_eq, ← LinearMap.range_eq_map]
  -- the offset plane `A = Q − a`, `a := −ι'b`, is in class `𝒪` of `ℝᴾ`, and `F ⊆ A`
  obtain ⟨hrank, hclass⟩ :=
    Submission.codim1_zsl_offset_plane_inClassO (n + 1 + k) n _ (ξN x) (-ι' b) hQ
  refine ⟨LinearMap.range ι.toLinearMap, -ι' b, F, ξN x, hrank, hclass, hF, fun y hy => ?_, hSF⟩
  obtain ⟨w, rfl⟩ := hFsub hy
  show ι w + ι' b + -ι' b ∈ LinearMap.range ι.toLinearMap
  rw [add_neg_cancel_right]
  exact LinearMap.mem_range_self _ w

/-- **Lattice chains are integer multiplicity** (Simon Ch. 6, proof of 5.1: "the fact that `P`,
`R` are integer multiplicity … should be evident").  Let `T(ω) = Σ_{p ∈ s} ∫_{Q₁} β_p
ω(Φ_p(y))(e_p) dy`, where `p = (z, ι)` has `ι` strictly increasing, `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}`,
`e_p = (e_{ι(0)}, …, e_{ι(m)})` and `Q₁ = (0, 1)ⁿ`.  Then `T = τ(N, θ, ξ)`, where `N` is the union
of the open faces `A_p = Φ_p(Q₁)` with `β_p ≠ 0`, `θ = |β_p|` and `ξ = sgn(β_p) e_p^*` on `A_p`
(`e_p^*(α) = α(e_p)`).  The face facts (`Φ_p` an isometry, `A_p ⊆ F_p` closed with `Hⁿ(F_p) = 1`,
`∫_{F_p} f dHⁿ = ∫_{Q₁} f ∘ Φ_p`, `A_p ∩ F_q = ∅` for `q ≠ p`) make the `A_p` disjoint Borel sets
of measure `≤ 1`, so `(N, θ, ξ)` is Borel, countably `n`-rectifiable and locally integrable; near
`x ∈ A_p`, `N` coincides with `x + V_p`, `V_p = span e_p` (the other faces are closed and miss
`x`), so `TₓN = V_p`, oriented by `±e_p`; and face by face its action is `T(ω)`. -/
theorem Submission.dor_lmb_fcd_fr_lattice_chain_im : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) → IsIntegerMultiplicity T := by
  intro P m s β T hmono hT
  classical
  -- Step 1: the face facts, in the notation `Q₁`, `Φ_p`, `F_p`, `e_p`
  obtain ⟨Q₁, hQ₁⟩ : ∃ Q : Set (Euclid (m + 1)), Q = {y | ∀ i, 0 < y i ∧ y i < 1} := ⟨_, rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → Euclid P,
      Φ = fun p y => WithLp.toLp 2 (fun i => (p.1 i : ℝ)) +
        ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P),
      F = fun p => {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧
        x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} := ⟨_, rfl⟩
  obtain ⟨e, he⟩ : ∃ e : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Fin (m + 1) → Euclid P,
      e = fun p k => EuclideanSpace.single (p.2 k) (1 : ℝ) := ⟨_, rfl⟩
  have hFG := fun p (hp : p ∈ s) => Submission.dor_lmb_fcd_fr_face_geometry P m p (hmono p hp)
  have hFmeas : ∀ p ∈ s, μHE[m + 1] (F p) = 1 := fun p hp => by
    rw [hF]; exact (hFG p hp).2.1
  have hFint : ∀ p ∈ s, ∀ f : Euclid P → ℝ,
      ∫ x in F p, f x ∂μHE[m + 1] = ∫ y in Q₁, f (Φ p y) := fun p hp f => by
    rw [hF, hQ₁, hΦ]; exact (hFG p hp).2.2.2.1 f
  have hΦF : ∀ p ∈ s, ∀ y ∈ Q₁, Φ p y ∈ F p := fun p hp y hy => by
    rw [hQ₁] at hy
    rw [hF, hΦ]
    exact (hFG p hp).2.2.2.2.1 y fun i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hiso : ∀ p ∈ s, Isometry (Φ p) := fun p hp => Isometry.of_dist_eq fun y y' => by
    rw [hΦ]; exact (hFG p hp).2.2.2.2.2.1 y y'
  have hFclosed : ∀ p ∈ s, IsClosed (F p) := fun p hp => by
    rw [hF]; exact (hFG p hp).2.2.2.2.2.2.2.1
  have hΦnotF : ∀ p ∈ s, ∀ q ∈ s, q ≠ p → ∀ y ∈ Q₁, Φ p y ∉ F q :=
    fun p hp q hq hqp y hy => by
      rw [hQ₁] at hy
      rw [hF, hΦ]
      exact (hFG p hp).2.2.2.2.2.2.2.2 q (hmono q hq) hqp y hy
  have hQ₁open : IsOpen Q₁ := by
    rw [hQ₁, ofPred_forall]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (PiLp.continuous_apply 2 _ i)).inter
        (isOpen_lt (PiLp.continuous_apply 2 _ i) continuous_const)
  -- the open faces `A_p = Φ_p(Q₁) ⊆ F_p`: Borel, pairwise disjoint, `Hⁿ(A_p) ≤ 1`
  obtain ⟨A, hA⟩ : ∃ A : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P),
      A = fun p => Φ p '' Q₁ := ⟨_, rfl⟩
  have hAmem : ∀ p x, x ∈ A p ↔ ∃ y ∈ Q₁, Φ p y = x := fun p x => by
    rw [hA]; exact Iff.rfl
  have hAmeas : ∀ p ∈ s, MeasurableSet (A p) := fun p hp => by
    rw [hA]
    exact (hiso p hp).isClosedEmbedding.measurableEmbedding.measurableSet_image.mpr
      hQ₁open.measurableSet
  have hAF : ∀ p ∈ s, A p ⊆ F p := fun p hp x hx => by
    obtain ⟨y, hy, rfl⟩ := (hAmem p x).mp hx
    exact hΦF p hp y hy
  have hAdisj : ∀ p ∈ s, ∀ q ∈ s, p ≠ q → Disjoint (A p) (A q) := fun p hp q hq hpq => by
    refine Set.disjoint_left.mpr fun x hxp hxq => ?_
    obtain ⟨y, hy, rfl⟩ := (hAmem p x).mp hxp
    exact hΦnotF p hp q hq (Ne.symm hpq) y hy (hAF q hq hxq)
  have hAfin : ∀ p ∈ s, μHE[m + 1] (A p) ≤ 1 := fun p hp =>
    (measure_mono (hAF p hp)).trans (hFmeas p hp).le
  -- Step 2: the triple `N = ⋃_{β_p ≠ 0} A_p`, `θ = Σ_p |β_p| 1_{A_p}`,
  -- `ξ = Σ_p sgn(β_p) 1_{A_p} e_p^*`
  obtain ⟨s', hs'⟩ : ∃ s' : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P)),
      s' = s.filter fun p => β p ≠ 0 := ⟨_, rfl⟩
  have hs's : ∀ p ∈ s', p ∈ s := fun p hp => by
    rw [hs'] at hp; exact (Finset.mem_filter.mp hp).1
  have hs'β : ∀ p ∈ s', β p ≠ 0 := fun p hp => by
    rw [hs'] at hp; exact (Finset.mem_filter.mp hp).2
  obtain ⟨N, hN⟩ : ∃ N : Set (Euclid P), N = ⋃ p ∈ s', A p := ⟨_, rfl⟩
  have hNmem : ∀ x, x ∈ N ↔ ∃ p ∈ s', x ∈ A p := fun x => by
    rw [hN]; simp only [mem_iUnion, exists_prop]
  have hNmeas : MeasurableSet N := by
    rw [hN]; exact Finset.measurableSet_biUnion s' fun p hp => hAmeas p (hs's p hp)
  obtain ⟨θ, hθ⟩ : ∃ θ : Euclid P → ℕ,
      θ = fun x => ∑ p ∈ s', (A p).indicator (fun _ => (β p).natAbs) x := ⟨_, rfl⟩
  obtain ⟨ξ, hξ⟩ : ∃ ξ : Euclid P → MultiVector P (m + 1),
      ξ = fun x => ∑ p ∈ s', (A p).indicator
        (fun _ => ((β p).sign : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p)) x :=
    ⟨_, rfl⟩
  -- on `A_p` (`β_p ≠ 0`), by disjointness, `θ = |β_p|` and `ξ = sgn(β_p) e_p^*`
  have hθA : ∀ p ∈ s', ∀ x ∈ A p, θ x = (β p).natAbs := fun p hp x hx => by
    rw [hθ]
    beta_reduce
    rw [Finset.sum_eq_single_of_mem p hp, indicator_of_mem hx]
    intro q hq hqp
    exact indicator_of_notMem (fun hxq => Set.disjoint_left.mp
      (hAdisj p (hs's p hp) q (hs's q hq) (Ne.symm hqp)) hx hxq) _
  have hξA : ∀ p ∈ s', ∀ x ∈ A p,
      ξ x = ((β p).sign : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p) :=
    fun p hp x hx => by
      rw [hξ]
      beta_reduce
      rw [Finset.sum_eq_single_of_mem p hp, indicator_of_mem hx]
      intro q hq hqp
      exact indicator_of_notMem (fun hxq => Set.disjoint_left.mp
        (hAdisj p (hs's p hp) q (hs's q hq) (Ne.symm hqp)) hx hxq) _
  -- Step 3: measurability, positivity, rectifiability, local integrability
  have hθmeas : Measurable θ := by
    rw [hθ]
    exact Finset.measurable_sum s' fun p hp => measurable_const.indicator (hAmeas p (hs's p hp))
  have hξmeas : StronglyMeasurable ξ := by
    -- `Λₙ(ℝᴾ)` is a topological additive group; its `ContinuousAdd` is not found by inference
    have : ContinuousAdd (MultiVector P (m + 1)) :=
      (inferInstance : IsTopologicalAddGroup (MultiVector P (m + 1))).toContinuousAdd
    rw [hξ]
    exact Finset.stronglyMeasurable_fun_sum s' fun p hp =>
      stronglyMeasurable_const.indicator (hAmeas p (hs's p hp))
  have hθpos : ∀ x ∈ N, 0 < θ x := fun x hx => by
    obtain ⟨p, hp, hxp⟩ := (hNmem x).mp hx
    rw [hθA p hp x hxp]
    exact Int.natAbs_pos.mpr (hs'β p hp)
  -- `N ⊆ ⋃_{j < |s'|} Φ_{p_j}(ℝⁿ)`, each `Φ_p` being `1`-Lipschitz
  have hrect : CountablyRectifiable (m + 1) N := by
    refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion
      (fun j : ℕ => if h : j < s'.card then range (Φ (s'.equivFin.symm ⟨j, h⟩)) else ∅)
      fun j => ?_).mono fun x hx => ?_
    · beta_reduce
      split_ifs with h
      · exact Poincare.SimonGMT.Chapter03.countablyRectifiable_range
          (hiso _ (hs's _ (s'.equivFin.symm ⟨j, h⟩).2)).lipschitzWith
      · exact Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
    · obtain ⟨p, hp, hxp⟩ := (hNmem x).mp hx
      obtain ⟨y, -, rfl⟩ := (hAmem p x).mp hxp
      refine mem_iUnion.mpr ⟨s'.equivFin ⟨p, hp⟩, ?_⟩
      rw [dite_eq_left (s'.equivFin ⟨p, hp⟩).2]
      simp only [Fin.eta, Equiv.symm_apply_apply]
      exact mem_range_self y
  -- `∫_{N ∩ K} θ dHⁿ ≤ Σ_p |β_p| Hⁿ(A_p) < ∞`
  have hθint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ∫⁻ x in N ∩ K, (θ x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ := by
    intro K _ _
    refine ne_top_of_le_ne_top ?_ (lintegral_mono_set inter_subset_left)
    rw [hN, lintegral_biUnion_finset
      (fun p hp q hq hpq => hAdisj p (hs's p hp) q (hs's q hq) hpq)
      fun p hp => hAmeas p (hs's p hp)]
    refine ENNReal.sum_ne_top.mpr fun p hp => ?_
    rw [setLIntegral_congr_fun (g := fun _ => ((β p).natAbs : ℝ≥0∞)) (hAmeas p (hs's p hp))
      fun x hx => by rw [hθA p hp x hx], setLIntegral_const]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ne_top_of_le_ne_top ENNReal.one_ne_top (hAfin p (hs's p hp)))
  -- Step 4: at `x ∈ A_p`, `TₓN = V_p = span e_p`, unit-oriented by `ξ(x) = ±e_p^*`
  have horth : ∀ p ∈ s, Orthonormal ℝ (e p) := fun p hp => by
    have h : e p = (EuclideanSpace.basisFun (Fin P) ℝ) ∘ p.2 := by
      funext k
      rw [he]
      simp only [Function.comp_apply, EuclideanSpace.basisFun_apply]
    rw [h]
    exact (EuclideanSpace.basisFun (Fin P) ℝ).orthonormal.comp p.2 (hmono p hp).injective
  have hunit : ∀ p ∈ s', IsUnitOrientationOf
      (((β p).sign : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p))
      (Submodule.span ℝ (range (e p))) := fun p hp => by
    refine ⟨e p, horth p (hs's p hp), rfl, ?_⟩
    rcases lt_or_gt_of_ne (hs'β p hp) with h | h
    · refine Or.inr fun α => ?_
      rw [Int.sign_eq_neg_one_of_neg h]
      simp
    · refine Or.inl fun α => ?_
      rw [Int.sign_eq_one_of_pos h]
      simp
  have htan : ∀ p ∈ s', ∀ x ∈ A p,
      HasApproximateTangentSpaceAt (m + 1) N x (Submodule.span ℝ (range (e p))) := by
    intro p hp x hx
    have hps := hs's p hp
    obtain ⟨y₀, hy₀, rfl⟩ := (hAmem p x).mp hx
    -- `B_{r₁}(y₀) ⊆ Q₁`
    obtain ⟨r₁, hr₁, hball₁⟩ := Metric.isOpen_iff.mp hQ₁open y₀ hy₀
    -- `B_{r₂}(x)` misses the closed faces `F_q`, `q ∈ s' \ {p}`
    have hGclosed : IsClosed (⋃ q ∈ s'.erase p, F q) :=
      isClosed_biUnion_finset fun q hq => hFclosed q (hs's q (Finset.mem_of_mem_erase hq))
    have hxG : Φ p y₀ ∉ ⋃ q ∈ s'.erase p, F q := by
      simp only [mem_iUnion, exists_prop, not_exists, not_and]
      intro q hq
      exact hΦnotF p hps q (hs's q (Finset.mem_of_mem_erase hq)) (Finset.ne_of_mem_erase hq)
        y₀ hy₀
    obtain ⟨r₂, hr₂, hball₂⟩ := Metric.isOpen_iff.mp hGclosed.isOpen_compl _ hxG
    refine Submission.dor_lmb_fcd_fr_local_plane_tangent P (m + 1) N (Φ p y₀) _ (min r₁ r₂)
      ?_ (lt_min hr₁ hr₂) fun y hy => ?_
    · rw [finrank_span_eq_card (horth p hps).linearIndependent, Fintype.card_fin]
    have hy₁ : dist y (Φ p y₀) < r₁ := (mem_ball.mp hy).trans_le (min_le_left _ _)
    have hy₂ : y ∉ ⋃ q ∈ s'.erase p, F q :=
      hball₂ (mem_ball.mpr ((mem_ball.mp hy).trans_le (min_le_right _ _)))
    constructor
    · -- `y ∈ N` forces `y ∈ A_p`, so `y − x = Σ_k (y₁ − y₀)_k e_{ι(k)} ∈ V_p`
      intro hyN
      obtain ⟨q, hq, hyq⟩ := (hNmem y).mp hyN
      have hqp : q = p := by
        by_contra hqp
        exact hy₂ (mem_iUnion₂.mpr ⟨q, Finset.mem_erase.mpr ⟨hqp, hq⟩, hAF q (hs's q hq) hyq⟩)
      rw [hqp] at hyq
      obtain ⟨y₁, -, rfl⟩ := (hAmem p y).mp hyq
      have hdiff : Φ p y₁ - Φ p y₀ = ∑ k, (y₁ k - y₀ k) • e p k := by
        rw [hΦ, he]
        simp only [sub_smul, Finset.sum_sub_distrib, add_sub_add_left_eq_sub]
      rw [hdiff]
      exact sum_mem fun k _ => Submodule.smul_mem _ _ (Submodule.subset_span (mem_range_self k))
    · -- `y − x = Σ_k c_k e_{ι(k)}` with `|c| = |y − x| < r₁`, so `y = Φ_p(y₀ + c) ∈ A_p`
      intro hyV
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hyV
      have hΦc : Φ p (y₀ + WithLp.toLp 2 c) = y := by
        have h : Φ p (y₀ + WithLp.toLp 2 c) = Φ p y₀ + ∑ k, c k • e p k := by
          rw [hΦ, he]
          simp only [PiLp.add_apply, add_smul, Finset.sum_add_distrib, add_assoc]
        rw [h, hc, add_sub_cancel]
      have hc₁ : y₀ + WithLp.toLp 2 c ∈ Q₁ := by
        apply hball₁
        rw [mem_ball, ← (hiso p hps).dist_eq, hΦc]
        exact hy₁
      exact (hNmem y).mpr ⟨p, hp, (hAmem p y).mpr ⟨_, hc₁, hΦc⟩⟩
  have horients : ∀ x ∈ N, ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt (m + 1) N x Q ∧ IsUnitOrientationOf (ξ x) Q := by
    intro x hx
    obtain ⟨p, hp, hxp⟩ := (hNmem x).mp hx
    exact ⟨_, htan p hp x hxp, by rw [hξA p hp x hxp]; exact hunit p hp⟩
  -- `R = (N, θ, ξ)` is an `IMRep` in `ℝ^P`
  refine ⟨⟨N, θ, ξ, hNmeas, subset_univ N, hrect, hθmeas, hθpos, hθint,
    hξmeas.aestronglyMeasurable, ae_restrict_of_forall_mem hNmeas horients⟩, fun ω => ?_⟩
  -- Step 5: `R` represents `T`, face by face
  show T ω = ∫ x in N, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1]
  obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid P) (m + 1)) := ContDiff.continuous hsmooth
  obtain ⟨C, hC⟩ := hcpt.exists_bound_of_continuous hωc
  -- on `A_p`: `θ ⟨ω, ξ⟩ = |β_p| sgn(β_p) ω(e_p) = β_p ω(e_p)`
  have hpt : ∀ p ∈ s', ∀ x ∈ A p, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) =
      (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p) := fun p hp x hx => by
    rw [hθA p hp x hx, hξA p hp x hx, smul_apply,
      ContinuousAlternatingMap.apply_apply, smul_eq_mul, ← mul_assoc]
    congr 1
    have h : (((β p).sign * ((β p).natAbs : ℤ) : ℤ) : ℝ) = (β p : ℝ) := by
      rw [Int.sign_mul_natAbs]
    rw [Int.cast_mul, Int.cast_natCast] at h
    rw [mul_comm]
    exact h
  -- integrability on each face: `|β_p ω(x)(e_p)| ≤ |β_p| sup ‖ω‖ ∏_k ‖e_{ι(k)}‖`, `Hⁿ(A_p) ≤ 1`
  have hintA : ∀ p ∈ s', IntegrableOn
      (fun x => (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x)) (A p)
      μHE[m + 1] := by
    intro p hp
    have hps := hs's p hp
    have hcont : Continuous fun x =>
        (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p) :=
      continuous_const.mul
        ((ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p)).continuous.comp hωc)
    refine IntegrableOn.congr_fun ?_ (fun x hx => (hpt p hp x hx).symm) (hAmeas p hps)
    refine Measure.integrableOn_of_bounded (M := |(β p : ℝ)| * (C * ∏ k, ‖e p k‖))
      (ne_top_of_le_ne_top ENNReal.one_ne_top (hAfin p hps)) hcont.aestronglyMeasurable
      (Eventually.of_forall fun x => ?_)
    rw [norm_mul, Real.norm_eq_abs]
    gcongr
    exact ((((ω : DifferentialForm (Euclid P) (m + 1)) x).le_opNorm (e p)).trans
      (by gcongr; exact hC x))
  -- on each face, `∫_{A_p} β_p ω(e_p) dHⁿ = ∫_{F_p} 1_{A_p} β_p ω(e_p) dHⁿ`
  -- `= ∫_{Q₁} β_p ω(Φ_p y)(e_p) dy`
  have hface : ∀ p ∈ s', ∫ x in A p, (θ x : ℝ) *
      ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] =
      ∫ y in Q₁, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y) (e p) := by
    intro p hp
    have hps := hs's p hp
    calc ∫ x in A p, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1]
        = ∫ x in A p, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p)
            ∂μHE[m + 1] := setIntegral_congr_fun (hAmeas p hps) fun x hx => hpt p hp x hx
      _ = ∫ x in F p, (A p).indicator
            (fun x => (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p)) x
            ∂μHE[m + 1] := by
          rw [integral_indicator (hAmeas p hps), Measure.restrict_restrict (hAmeas p hps),
            inter_eq_left.mpr (hAF p hps)]
      _ = ∫ y in Q₁, (A p).indicator
            (fun x => (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p)) (Φ p y) :=
          hFint p hps _
      _ = ∫ y in Q₁, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y) (e p) :=
          setIntegral_congr_fun hQ₁open.measurableSet fun y hy =>
            indicator_of_mem ((hAmem p _).mpr ⟨y, hy, rfl⟩) _
  -- sum over the disjoint faces; the faces with `β_p = 0` contribute nothing
  rw [hT ω, hN, integral_biUnion_finset s' (fun p hp => hAmeas p (hs's p hp))
    (fun p hp q hq hpq => hAdisj p (hs's p hp) q (hs's q hq) hpq) hintA,
    Finset.sum_congr rfl hface, hs', Finset.sum_filter_of_ne]
  · subst hQ₁ hΦ he
    rfl
  · intro p _ hp0 hβ
    exact hp0 (by simp [hβ])
/-- **Total variation of a smooth function by duality with smooth test fields** (parent step 5:
`∫_W |Dw|` is bounded by the supremum of `∫ Dw · g` over `C^∞` fields `g` with compact support in
`W` and `|g| ≤ 1`).  Let `F = (Dw(·) eᵢ)ᵢ` be the gradient field of `w`, so `⟪F, h⟫ = Dw · h` and
`|F| = ‖Dw‖`; `F` is `C^∞`, and bounded by `M` on the compact set `closure W`.  Given `ε > 0`, the
smooth cut-off `rsd_mw_tfa_smooth_cutoff` (for `vol⌞W`) gives `χ ∈ C_c^∞(W)` with `0 ≤ χ ≤ 1` and
`vol (W ∩ {χ ≠ 1}) < ε`.  The field `g = χ F / √(|F|² + ε²)` is admissible, and
`Dw · g = ψ := χ |F|² / √(|F|² + ε²)`, which vanishes off `W`, so `∫_W ψ ≤ V`.  On `W`,
`|F| ≤ ψ + |M| 1_{χ ≠ 1} + ε` (if `χ = 1`, use `a ≤ a² / √(a² + ε²) + ε`; otherwise `|F| ≤ M`).
Integrating, `∫_W |F| ≤ V + (|M| + vol W) ε`, and `ε → 0` gives the claim. -/
theorem Submission.dor_lmb_fcd_cp_smooth_duality : ∀ (P : ℕ) (w : Euclid P → ℝ) (W : Set (Euclid P)) (V : ℝ), IsOpen W → Bornology.IsBounded W → ContDiff ℝ (⊤ : ℕ∞) w → (∀ g : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ W → (∀ y, ‖g y‖ ≤ 1) → ∫ y, fderiv ℝ w y (g y) ≤ V) → ∫ y in W, ‖fderiv ℝ w y‖ ≤ V := by
  intro P w W V hWo hWb hw hV
  -- Step 1: the gradient field `F y = (Dw(y) eᵢ)ᵢ`, with `⟪F y, h⟫ = Dw(y) h` and `‖F y‖ = ‖Dw(y)‖`
  set F : Euclid P → Euclid P :=
    fun y => WithLp.toLp 2 (fun i => fderiv ℝ w y (EuclideanSpace.single i 1))
  have hinner : ∀ y h, inner ℝ (F y) h = fderiv ℝ w y h := by
    intro y h
    have hh : h = ∑ i, h i • EuclideanSpace.single i (1 : ℝ) := by
      ext j
      simp [Finset.sum_apply, Pi.single_apply]
    conv_rhs => rw [hh]
    simp [F, PiLp.inner_apply, map_sum, map_smul]
  have hFc : ContDiff ℝ (⊤ : ℕ∞) F := by
    have hD : ContDiff ℝ (⊤ : ℕ∞) (fun y => fderiv ℝ w y) :=
      hw.fderiv_right (by exact_mod_cast le_top)
    have : ContDiff ℝ (⊤ : ℕ∞) (fun y => (WithLp.linearEquiv 2 ℝ (Fin P → ℝ)).symm
        (fun i => fderiv ℝ w y (EuclideanSpace.single i 1))) := by
      apply (LinearEquiv.toContinuousLinearEquiv
        (WithLp.linearEquiv 2 ℝ (Fin P → ℝ)).symm).contDiff.comp
      exact contDiff_pi.2 fun i => hD.clm_apply contDiff_const
    simpa [F] using this
  have hFn : ∀ y, ‖F y‖ = ‖fderiv ℝ w y‖ := by
    intro y
    have hdual : InnerProductSpace.toDual ℝ (Euclid P) (F y) = fderiv ℝ w y := by
      ext h
      simp [InnerProductSpace.toDual_apply_apply, hinner]
    rw [← hdual, LinearIsometryEquiv.norm_map]
  simp_rw [← hFn]
  -- Step 2: `vol W < ∞`, `closure W` is compact, `‖F‖ ≤ M` on `closure W`, `‖F‖` integrable on `W`
  have hWm : volume W < ∞ := hWb.measure_lt_top
  have hWc : IsCompact (closure W) := hWb.isCompact_closure
  obtain ⟨M, hM⟩ := hWc.exists_bound_of_continuousOn hFc.continuous.continuousOn
  have hFi : IntegrableOn (fun y => ‖F y‖) W :=
    (hFc.continuous.norm.continuousOn.integrableOn_compact hWc).mono_set subset_closure
  -- the scalar inequality `a ≤ a² / S + ε` for `a ≤ S ≤ a + ε`
  have alg : ∀ ε a S : ℝ, 0 < S → a ≤ S → S ≤ a + ε → a ≤ S⁻¹ * a ^ 2 + ε := by
    intro ε a S hS haS hSa
    rw [inv_mul_eq_div, ← sub_le_iff_le_add, le_div_iff₀ hS]
    nlinarith [sq_nonneg (S - a), mul_nonneg hS.le (sub_nonneg.2 hSa)]
  -- Step 3: for every `ε > 0`, `∫_W ‖F‖ ≤ V + (|M| + vol W) ε`
  have key : ∀ ε : ℝ, 0 < ε → ∫ y in W, ‖F y‖ ≤ V + (|M| + volume.real W) * ε := by
    intro ε hε
    -- the smooth cut-off `χ` with compact support in `W` and `vol (W ∩ {χ ≠ 1}) < ε`
    have hfin : IsFiniteMeasure (volume.restrict W) := isFiniteMeasure_restrict.2 hWm.ne
    obtain ⟨χ, hχ, hχc, hχW, hχ01, hχm⟩ :=
      Submission.rsd_mw_tfa_smooth_cutoff P (volume.restrict W) W hfin hWo
        (by rw [Measure.restrict_apply' hWo.measurableSet, compl_inter_self, measure_empty]) ε hε
    -- the regularised length `s = √(‖F‖² + ε²)` and the test field `g = χ s⁻¹ F`
    set s : Euclid P → ℝ := fun y => √(‖F y‖ ^ 2 + ε ^ 2)
    have hspos : ∀ y, 0 < s y := by
      intro y
      show 0 < √(‖F y‖ ^ 2 + ε ^ 2)
      positivity
    have hsc : ContDiff ℝ (⊤ : ℕ∞) s :=
      ((hFc.norm_sq ℝ).add contDiff_const).sqrt fun y =>
        (by positivity : (0 : ℝ) < ‖F y‖ ^ 2 + ε ^ 2).ne'
    have hFs : ∀ y, ‖F y‖ ≤ s y := by
      intro y
      show ‖F y‖ ≤ √(‖F y‖ ^ 2 + ε ^ 2)
      exact (Real.le_sqrt (norm_nonneg _) (by positivity)).2 (le_add_of_nonneg_right (sq_nonneg ε))
    have hsF : ∀ y, s y ≤ ‖F y‖ + ε := by
      intro y
      show √(‖F y‖ ^ 2 + ε ^ 2) ≤ ‖F y‖ + ε
      rw [Real.sqrt_le_left (by positivity)]
      nlinarith [mul_nonneg (norm_nonneg (F y)) hε.le]
    have hgc : ContDiff ℝ (⊤ : ℕ∞) (fun y => χ y • ((s y)⁻¹ • F y)) :=
      hχ.smul ((hsc.inv fun y => (hspos y).ne').smul hFc)
    have hgcs : HasCompactSupport (fun y => χ y • ((s y)⁻¹ • F y)) :=
      hχc.smul_right (f' := fun y => (s y)⁻¹ • F y)
    have hgt : tsupport (fun y => χ y • ((s y)⁻¹ • F y)) ⊆ W :=
      (tsupport_smul_subset_left χ fun y => (s y)⁻¹ • F y).trans hχW
    have hg1 : ∀ y, ‖χ y • ((s y)⁻¹ • F y)‖ ≤ 1 := by
      intro y
      have hc0 : 0 ≤ (s y)⁻¹ * ‖F y‖ := mul_nonneg (inv_nonneg.2 (hspos y).le) (norm_nonneg _)
      have hc1 : (s y)⁻¹ * ‖F y‖ ≤ 1 := by
        rw [inv_mul_le_iff₀ (hspos y), mul_one]
        exact hFs y
      rw [norm_smul, norm_smul, Real.norm_of_nonneg (hχ01 y).1,
        Real.norm_of_nonneg (inv_nonneg.2 (hspos y).le)]
      exact (mul_le_of_le_one_left hc0 (hχ01 y).2).trans hc1
    -- `Dw(y) (g y) = ψ y := χ y s(y)⁻¹ ‖F y‖²`; `ψ` vanishes off `W`, so `∫_W ψ ≤ V`
    set ψ : Euclid P → ℝ := fun y => χ y * ((s y)⁻¹ * ‖F y‖ ^ 2)
    have hDg : ∀ y, fderiv ℝ w y (χ y • ((s y)⁻¹ • F y)) = ψ y := by
      intro y
      show fderiv ℝ w y (χ y • ((s y)⁻¹ • F y)) = χ y * ((s y)⁻¹ * ‖F y‖ ^ 2)
      rw [← hinner, inner_smul_right, inner_smul_right, real_inner_self_eq_norm_sq]
    have hψ0W : ∀ y ∉ W, ψ y = 0 := by
      intro y hy
      have h0 : χ y = 0 := image_eq_zero_of_notMem_tsupport fun h => hy (hχW h)
      show χ y * ((s y)⁻¹ * ‖F y‖ ^ 2) = 0
      rw [h0, zero_mul]
    have hψV : ∫ y in W, ψ y ≤ V := by
      rw [setIntegral_eq_integral_of_forall_compl_eq_zero hψ0W]
      calc ∫ y, ψ y = ∫ y, fderiv ℝ w y (χ y • ((s y)⁻¹ • F y)) := by simp_rw [hDg]
        _ ≤ V := hV (fun y => χ y • ((s y)⁻¹ • F y)) hgc hgcs hgt hg1
    -- pointwise on `W`: `‖F‖ ≤ ψ + |M| 1_{χ ≠ 1} + ε`
    have hEm : MeasurableSet {x | χ x ≠ 1} :=
      (isOpen_ne_fun hχ.continuous continuous_const).measurableSet
    have hpt : ∀ y ∈ W,
        ‖F y‖ ≤ ψ y + Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y + ε := by
      intro y hy
      by_cases hy1 : χ y = 1
      · have hyE : y ∉ {x | χ x ≠ 1} := fun h => h hy1
        rw [indicator_of_notMem hyE, add_zero]
        show ‖F y‖ ≤ χ y * ((s y)⁻¹ * ‖F y‖ ^ 2) + ε
        rw [hy1, one_mul]
        exact alg ε _ _ (hspos y) (hFs y) (hsF y)
      · have hyE : y ∈ {x | χ x ≠ 1} := hy1
        rw [indicator_of_mem hyE]
        have hψ0 : 0 ≤ ψ y :=
          mul_nonneg (hχ01 y).1 (mul_nonneg (inv_nonneg.2 (hspos y).le) (sq_nonneg _))
        have h1 := hM y (subset_closure hy)
        have h2 := le_abs_self M
        show ‖F y‖ ≤ ψ y + |M| + ε
        linarith
    -- integrate over `W`
    have hψc : Continuous ψ :=
      hχ.continuous.mul ((hsc.continuous.inv₀ fun y => (hspos y).ne').mul
        (hFc.continuous.norm.pow 2))
    have hψi : IntegrableOn ψ W :=
      (hψc.continuousOn.integrableOn_compact hWc).mono_set subset_closure
    have hEi : IntegrableOn (Set.indicator {x | χ x ≠ 1} fun _ => |M|) W :=
      (integrableOn_const hWm.ne).indicator hEm
    have hψEi : IntegrableOn (fun y => ψ y + Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y) W :=
      hψi.add hEi
    have hεi : IntegrableOn (fun _ => ε) W := integrableOn_const hWm.ne
    have hEε : (volume.restrict W).real {x | χ x ≠ 1} ≤ ε :=
      (ENNReal.toReal_lt_of_lt_ofReal hχm).le
    calc ∫ y in W, ‖F y‖
        ≤ ∫ y in W, (ψ y + Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y + ε) :=
          setIntegral_mono_on hFi (hψEi.add hεi) hWo.measurableSet hpt
      _ = (∫ y in W, ψ y) + (∫ y in W, Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y) +
            ∫ y in W, ε := by
          rw [integral_add hψEi hεi, integral_add hψi hEi]
      _ = (∫ y in W, ψ y) + (volume.restrict W).real {x | χ x ≠ 1} * |M| +
            volume.real W * ε := by
          rw [integral_indicator_const _ hEm, setIntegral_const, smul_eq_mul, smul_eq_mul]
      _ ≤ V + (|M| + volume.real W) * ε := by
          nlinarith [mul_le_mul_of_nonneg_right hEε (abs_nonneg M)]
  -- Step 4: let `ε → 0`
  refine le_of_forall_pos_le_add fun η hη => ?_
  have hL : 0 ≤ volume.real W := measureReal_nonneg
  have hpos : 0 < |M| + volume.real W + 1 := by positivity
  have h1 := key (η / (|M| + volume.real W + 1)) (div_pos hη hpos)
  have h2 : (|M| + volume.real W) * (η / (|M| + volume.real W + 1)) ≤ η := by
    rw [← mul_div_assoc, div_le_iff₀ hpos]
    nlinarith
  linarith
/-- **Change of scale `x ↦ λx`** (Simon 6.5.3, chapter-06.txt lines 1458–1459: the scaled
Deformation Theorem follows from 6.5.1 "by first changing scale `x → ρ⁻¹x`, then applying 5.1,
then changing scale back by `x → ρx`").  `dil k λ X = δ_{λ#}X` is the push-forward 6.2.23 along
`δ_λ(x) = λx`, `dil k λ X (ω) = X(δ_λ^#ω)` with `(δ_λ^#ω)(x) = λᵏ ω(λx)`, built from the proper
affine push-forward `GeometricCurrentOn.affinePushforward` (`λ ≠ 0`; `dil k λ X = X` otherwise).
It is additive, `δ_{λ⁻¹#}δ_{λ#} = id`, scales mass by `λᵏ` (`Submission.cmcdt_dil_mass_eq`),
preserves integer multiplicity (`Submission.cmcdt_dil_isIntegerMultiplicity`), commutes with `∂`
(6.2.24(1)), moves vanishing sets by `δ_λ`, and `Hᵏ`-integrals over `δ_λ(A)` scale by `λᵏ`
(`Submission.euclid_hausdorff_dilation_change_of_variables` with `δ_λ⁻¹(δ_λ(A)) = A`). -/
theorem Submission.dor_lmb_fcd_dilation : ∀ P : ℕ, ∃ dil : ∀ k : ℕ, ℝ → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) k, ∀ (k : ℕ) (lam : ℝ), 0 < lam → (∀ X Y : GeometricCurrentOn (univ : Set (Euclid P)) k, dil k lam (X - Y) = dil k lam X - dil k lam Y) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, dil k lam⁻¹ (dil k lam X) = X) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, (dil k lam X).mass = ENNReal.ofReal (lam ^ k) * X.mass) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, IsIntegerMultiplicity X → IsIntegerMultiplicity (dil k lam X)) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (dil (k + 1) lam X).boundary = dil k lam X.boundary) ∧ (∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (E : Set (Euclid P)), (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → X ω = 0) → ∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) ((fun x => lam • x) '' E) → dil k lam X ω = 0) ∧ (∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (ω : TestFormOn (univ : Set (Euclid P)) k), ∃ η : TestFormOn (univ : Set (Euclid P)) k, (∀ x, (η : DifferentialForm (Euclid P) k) x = lam ^ k • (ω : DifferentialForm (Euclid P) k) (lam • x)) ∧ dil k lam X ω = X η) ∧ ∀ (A : Set (Euclid P)) (g : Euclid P → ℝ), ∫ y in (fun x => lam • x) '' A, g y ∂μHE[k] = lam ^ k * ∫ x in A, g (lam • x) ∂μHE[k] := by
  intro P
  -- Step 0: `δ_λ(x) = 0 + (λ·id)x = λx` is a homeomorphism for `λ ≠ 0`, hence proper.
  have hproper : ∀ lam : ℝ, lam ≠ 0 → IsProperMap
      (fun x : Euclid P => (0 : Euclid P) + (lam • ContinuousLinearMap.id ℝ (Euclid P)) x) := by
    intro lam hlam
    convert (Homeomorph.smulOfNeZero (α := Euclid P) lam hlam).isProperMap using 1
    funext x
    simp
  -- Step 1: `dil k λ X = δ_{λ#}X` (6.2.23) for `λ ≠ 0`, `X` otherwise; `dil k λ X (ω) = X(δ_λ^#ω)`.
  obtain ⟨dil, hdil⟩ : ∃ dil : ∀ k : ℕ, ℝ → GeometricCurrentOn (univ : Set (Euclid P)) k →
      GeometricCurrentOn (univ : Set (Euclid P)) k,
      ∀ (k : ℕ) (lam : ℝ), lam ≠ 0 → ∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) k)
        (ω η : TestFormOn (univ : Set (Euclid P)) k),
        (η : DifferentialForm (Euclid P) k) = affinePullbackForm
          (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) →
        dil k lam X ω = X η := by
    classical
    refine ⟨fun k lam X => if hlam : lam ≠ 0 then
      (X.restrictDomain (subset_univ _)).affinePushforward
        (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (hproper lam hlam) else X, ?_⟩
    intro k lam hlam X ω η hη
    simp only [dite_eq_left hlam, GeometricCurrentOn.affinePushforward_apply,
      GeometricCurrentOn.restrictDomain_apply]
    congr 1
    exact Subtype.ext hη.symm
  refine ⟨dil, fun k lam hlam => ?_⟩
  have hlam0 : lam ≠ 0 := hlam.ne'
  refine ⟨fun X Y => ?_, fun X => ?_, fun X => ?_, fun X hX => ?_, fun X => ?_,
    fun X E hXE ω hω => ?_, fun X ω => ?_, fun A g => ?_⟩
  -- Step 2 (sub): `δ_{λ#}(X − Y)(ω) = (X − Y)(δ_λ^#ω) = X(δ_λ^#ω) − Y(δ_λ^#ω)`.
  · ext ω
    obtain ⟨η, hη, -⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    change dil k lam (X - Y) ω = dil k lam X ω - dil k lam Y ω
    rw [hdil k lam hlam0 (X - Y) ω η hη, hdil k lam hlam0 X ω η hη, hdil k lam hlam0 Y ω η hη]
    rfl
  -- Step 3 (inverse): `δ_λ^#(δ_{λ⁻¹}^#ω)(x) = λᵏλ⁻ᵏ ω(λ⁻¹λx) = ω(x)`.
  · ext ω
    obtain ⟨ζ, hζ, hζx⟩ := Submission.cmcdt_dil_pullback_testForm P k lam⁻¹ (inv_ne_zero hlam0) ω
    obtain ⟨η, hη, hηx⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ζ
    have hηω : η = ω := by
      refine Subtype.ext (funext fun x => ?_)
      change (η : DifferentialForm (Euclid P) k) x = (ω : DifferentialForm (Euclid P) k) x
      rw [hηx x, hζx, smul_smul, ← mul_pow, mul_inv_cancel₀ hlam0, one_pow, one_smul,
        inv_smul_smul₀ hlam0]
    rw [hdil k lam⁻¹ (inv_ne_zero hlam0) (dil k lam X) ω ζ hζ, hdil k lam hlam0 X ζ η hη, hηω]
  -- Step 4 (mass): `M(δ_{λ#}X) = λᵏ M(X)`.
  · exact Submission.cmcdt_dil_mass_eq P k lam hlam X (dil k lam X) (hdil k lam hlam0 X)
  -- Step 5 (integer multiplicity): `δ_{λ#}τ(M, θ, ξ) = τ(λM, θ(·/λ), ξ(·/λ))`.
  · exact Submission.cmcdt_dil_isIntegerMultiplicity P k lam hlam X (dil k lam X)
      (hdil k lam hlam0 X) hX
  -- Step 6 (boundary): `d(δ_λ^#ω) = δ_λ^#(dω)` (naturality of `d`, 6.2.24(1)).
  · ext ω
    obtain ⟨η, hη, -⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    rw [GeometricCurrentOn.boundary_apply, hdil k lam hlam0 X.boundary ω η hη,
      GeometricCurrentOn.boundary_apply]
    refine hdil (k + 1) lam hlam0 X _ _ ?_
    change exteriorDerivative (η : DifferentialForm (Euclid P) k) =
      affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0
        (exteriorDerivative (ω : DifferentialForm (Euclid P) k))
    rw [hη]
    exact exteriorDerivative_affinePullbackForm _ 0 ω.property.1.1
  -- Step 7 (vanishing): `tsupport δ_λ^#ω ⊆ δ_λ⁻¹(tsupport ω)`, which is disjoint from `E`.
  · obtain ⟨η, hη, -⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    rw [hdil k lam hlam0 X ω η hη]
    refine hXE η (Set.disjoint_left.2 fun x hx hxE => ?_)
    rw [hη] at hx
    have hx' : lam • x ∈ tsupport (ω : DifferentialForm (Euclid P) k) := by
      simpa using tsupport_affinePullbackForm_subset _ 0 _ hx
    exact Set.disjoint_left.1 hω hx' ⟨x, hxE, rfl⟩
  -- Step 8 (action): `η = δ_λ^#ω` has `η(x) = λᵏ ω(λx)`.
  · obtain ⟨η, hη, hηx⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    exact ⟨η, hηx, hdil k lam hlam0 X ω η hη⟩
  -- Step 9 (change of variables): `M = δ_λ(A)` with `δ_λ⁻¹(δ_λ(A)) = A`, then `λᵏλ⁻ᵏ = 1`.
  · have h := (Submission.euclid_hausdorff_dilation_change_of_variables P k lam hlam
      ((fun x : Euclid P => lam • x) '' A)).2.2 g
    rw [Set.preimage_image_eq A (smul_right_injective (Euclid P) hlam0)] at h
    rw [h, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ hlam0, one_pow, one_mul]

/-- **Cauchy subsequence for the flat distance** (Simon Ch. 6, proof of 7.2, chapter-06.txt
lines 2100–2114: "apply (1) with `ε = 1, 1/2, 1/4` etc. to extract a subsequence `{T_{j_r}}` …
`d(T_{j_{r+1}}, T_{j_r}) < 2^{-r}`", so `T_{j_{r+1}} − T_{j_r} = ∂R_r + S_r`).  If for every
`ε > 0` some finite `𝒬` has, for each `j`, a `Q ∈ 𝒬` and integer multiplicity `R, S` with
`X_j − Q = ∂R + S` and `M(R) + M(S) < ε`, then some subsequence has
`X_{θ(r+1)} − X_{θ(r)} = ∂R_r + S_r` with `R_r, S_r` integer multiplicity and
`M(R_r) + M(S_r) ≤ 2^{-r}`.  For `ε_r = 2^{-r-1}`, every infinite `I ⊆ ℕ` has an infinite fibre
`J` of `j ↦ Q_r(j)` (pigeonhole); for `j, l ∈ J` the differences `R_r(j) − R_r(l)`,
`S_r(j) − S_r(l)` are integer multiplicity with `M(R_r(j) − R_r(l)) + M(S_r(j) − S_r(l)) < 2ε_r`,
so the diagonal extraction applies. -/
theorem Submission.dor_lmb_fc_cauchy_subseq : ∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ ε : ℝ≥0∞, 0 < ε → ∃ 𝒬 : Set (GeometricCurrentOn U (m + 1)), 𝒬.Finite ∧ ∀ j, ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)), IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn U (m + 1), X j ω - Q ω = R.boundary ω + S ω) ∧ R.mass + S.mass < ε) → ∃ θ : ℕ → ℕ, StrictMono θ ∧ ∀ r, ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)), IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn U (m + 1), X (θ (r + 1)) ω - X (θ r) ω = R.boundary ω + S ω) ∧ R.mass + S.mass ≤ (2⁻¹ : ℝ≥0∞) ^ r := by
  intro P m U X hU hnet
  -- Step 1: for `ε_r = 2^{-r-1}`, the finite nets `𝒬_r` and decompositions
  -- `X_j − Q_r(j) = ∂R_r(j) + S_r(j)` with `M(R_r(j)) + M(S_r(j)) < ε_r`
  have hε : ∀ r : ℕ, (0 : ℝ≥0∞) < (2⁻¹ : ℝ≥0∞) ^ (r + 1) := fun r =>
    ENNReal.pow_pos (ENNReal.inv_pos.2 ENNReal.ofNat_ne_top) _
  choose Qs hQs Q hQ R S hR hS hXQ hRS using fun r => hnet _ (hε r)
  -- Step 2: diagonal extraction for `C r j l`: `X_j − X_l = ∂R + S`, `M(R) + M(S) ≤ 2^{-r}`
  refine Submission.cmc_fc_cs_diagonal_subseq (fun r j l =>
    ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)),
      IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧
      (∀ ω : TestFormOn U (m + 1), X j ω - X l ω = R.boundary ω + S ω) ∧
      R.mass + S.mass ≤ (2⁻¹ : ℝ≥0∞) ^ r) fun r I hI => ?_
  -- Step 3: pigeonhole: `j ↦ Q_r(j)` takes values in the finite `𝒬_r`, so some fibre
  -- `I ∩ Q_r⁻¹(q)` is infinite
  obtain ⟨q, -, hq⟩ : ∃ q ∈ Qs r, (I ∩ {j | Q r j = q}).Infinite := by
    by_contra h
    have hfin : (⋃ q ∈ Qs r, I ∩ {j | Q r j = q}).Finite :=
      (hQs r).biUnion fun q hq => by
        by_contra hinf
        exact h ⟨q, hq, hinf⟩
    exact hI (hfin.subset fun j hj => mem_biUnion (hQ r j) ⟨hj, rfl⟩)
  refine ⟨I ∩ {j | Q r j = q}, inter_subset_left, hq, fun j hj l hl => ?_⟩
  -- Step 4: subtract the two decompositions with the same `q`; the differences are integer
  -- multiplicity and `M(R_r(j) − R_r(l)) + M(S_r(j) − S_r(l)) < 2ε_r = 2^{-r}`
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1
  refine ⟨R r j - R r l, S r j - S r l, hsub P _ U _ _ hU (hR r j) (hR r l),
    hsub P _ U _ _ hU (hS r j) (hS r l), fun ω => ?_, ?_⟩
  · have hj' : Q r j = q := hj.2
    have hl' : Q r l = q := hl.2
    have h1 := hXQ r j ω
    have h2 := hXQ r l ω
    rw [hj'] at h1
    rw [hl'] at h2
    change X j ω - X l ω = ((R r j).boundary ω - (R r l).boundary ω) + (S r j ω - S r l ω)
    linarith
  · calc (R r j - R r l).mass + (S r j - S r l).mass
        ≤ ((R r j).mass + (R r l).mass) + ((S r j).mass + (S r l).mass) :=
          add_le_add (Submission.cmc_fc_cs_massOn_sub_le P (m + 2) U U (R r j) (R r l))
            (Submission.cmc_fc_cs_massOn_sub_le P (m + 1) U U (S r j) (S r l))
      _ = ((R r j).mass + (S r j).mass) + ((R r l).mass + (S r l).mass) :=
          add_add_add_comm _ _ _ _
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ (r + 1) + (2⁻¹ : ℝ≥0∞) ^ (r + 1) :=
          add_le_add (hRS r j).le (hRS r l).le
      _ = (2⁻¹ : ℝ≥0∞) ^ r := by
          rw [pow_succ, ← div_eq_mul_inv, ENNReal.add_halves]
/-- **Simon Ch. 6, proof of 7.2 (p. 172), the series step** `T − T_{j_ℓ} = ∂R^{(ℓ)} + S^{(ℓ)}`.
If `X_r ⇀ X_∞` in `U` and `X_{r+1} − X_r = ∂R_r + S_r` with `R_r`, `S_r` integer multiplicity
and `M(R_r) + M(S_r) ≤ 2^{−r}`, then for each `ℓ` the `M`-absolutely convergent tails
`R' = Σ_{r ≥ ℓ} R_r`, `S' = Σ_{r ≥ ℓ} S_r` are integer multiplicity (3.13, via
`dor_lmb_fc_im_series`) with `M(R') + M(S') ≤ 2·2^{−ℓ}`; telescoping
`X_{ℓ+N} − X_ℓ = Σ_{r<N} (∂R_{ℓ+r} + S_{ℓ+r})` and letting `N → ∞` gives `X_∞ − X_ℓ = ∂R' + S'`. -/
theorem Submission.dor_lmb_fc_series_limit : ∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)) (Xlim : GeometricCurrentOn U (m + 1)) (R : ℕ → GeometricCurrentOn U (m + 2)) (S : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → WeaklyConvergesOn X Xlim → (∀ r, IsIntegerMultiplicity (R r) ∧ IsIntegerMultiplicity (S r) ∧ (∀ ω : TestFormOn U (m + 1), X (r + 1) ω - X r ω = (R r).boundary ω + S r ω) ∧ (R r).mass + (S r).mass ≤ (2⁻¹ : ℝ≥0∞) ^ r) → ∀ ℓ : ℕ, ∃ (R' : GeometricCurrentOn U (m + 2)) (S' : GeometricCurrentOn U (m + 1)), IsIntegerMultiplicity R' ∧ IsIntegerMultiplicity S' ∧ (∀ ω : TestFormOn U (m + 1), Xlim ω - X ℓ ω = R'.boundary ω + S' ω) ∧ R'.mass + S'.mass ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := by
  intro P m U X Xlim R S hU hX hRS ℓ
  -- the tails have total mass at most `Σ_r 2^{−ℓ−r} = 2·2^{−ℓ} < ∞`
  have hgeom : ∑' r, (2⁻¹ : ℝ≥0∞) ^ (ℓ + r) = 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := by
    simp_rw [pow_add]
    rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric_two, mul_comm]
  have hfin : ∑' r, (2⁻¹ : ℝ≥0∞) ^ (ℓ + r) ≠ ∞ := by
    rw [hgeom]
    exact ENNReal.mul_ne_top ENNReal.ofNat_ne_top
      (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 two_ne_zero))
  have hRfin : ∑' r, (R (ℓ + r)).mass ≠ ∞ := ne_top_of_le_ne_top hfin <|
    ENNReal.tsum_le_tsum fun r => le_self_add.trans (hRS (ℓ + r)).2.2.2
  have hSfin : ∑' r, (S (ℓ + r)).mass ≠ ∞ := ne_top_of_le_ne_top hfin <|
    ENNReal.tsum_le_tsum fun r => le_add_self.trans (hRS (ℓ + r)).2.2.2
  -- 3.13: the tails sum to integer multiplicity `R' = Σ_r R_{ℓ+r}` and `S' = Σ_r S_{ℓ+r}`
  obtain ⟨R', hR', hRsum, hRmass⟩ := Submission.dor_lmb_fc_im_series P (m + 1) U
    (fun r => R (ℓ + r)) hU (fun r => (hRS (ℓ + r)).1) hRfin
  obtain ⟨S', hS', hSsum, hSmass⟩ := Submission.dor_lmb_fc_im_series P m U
    (fun r => S (ℓ + r)) hU (fun r => (hRS (ℓ + r)).2.1) hSfin
  refine ⟨R', S', hR', hS', fun ω => ?_, ?_⟩
  · -- telescoping: `X_{ℓ+N}(ω) − X_ℓ(ω) = Σ_{r<N} (∂R_{ℓ+r}(ω) + S_{ℓ+r}(ω))`
    have htel : ∀ N : ℕ, X (ℓ + N) ω - X ℓ ω =
        ∑ r ∈ Finset.range N, ((R (ℓ + r)).boundary ω + S (ℓ + r) ω) := by
      intro N
      induction N with
      | zero => simp
      | succ N ih =>
        rw [Finset.sum_range_succ, ← ih, ← (hRS (ℓ + N)).2.2.1 ω, ← add_assoc ℓ N 1]
        ring
    -- let `N → ∞`: the left side tends to `X_∞(ω) − X_ℓ(ω)`, the right side to `∂R'(ω) + S'(ω)`
    have hlim : Tendsto (fun N => X (ℓ + N) ω - X ℓ ω) atTop (𝓝 (Xlim ω - X ℓ ω)) :=
      ((hX ω).comp (tendsto_atTop_mono (fun N => Nat.le_add_left N ℓ) tendsto_id)).sub_const _
    have hsum : HasSum (fun r => (R (ℓ + r)).boundary ω + S (ℓ + r) ω)
        (R'.boundary ω + S' ω) :=
      (hRsum (exteriorDerivativeTestOn U (m + 1) ω)).add (hSsum ω)
    exact tendsto_nhds_unique (hlim.congr htel) hsum.tendsto_sum_nat
  · calc R'.mass + S'.mass
        ≤ ∑' r, (R (ℓ + r)).mass + ∑' r, (S (ℓ + r)).mass := add_le_add hRmass hSmass
      _ = ∑' r, ((R (ℓ + r)).mass + (S (ℓ + r)).mass) := ENNReal.tsum_add.symm
      _ ≤ ∑' r, (2⁻¹ : ℝ≥0∞) ^ (ℓ + r) := ENNReal.tsum_le_tsum fun r => (hRS (ℓ + r)).2.2.2
      _ = 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := hgeom
/-- **Locality of approximate tangent spaces** (Simon Ch. 3, Remark 1.5(2); proof of 3.1.6 "⇒",
chapter-03.txt lines 113–143).  If `U ⊆ ℝᴾ` is open and `A ⊆ B ⊆ U` are Borel with
`Hⁿ(B ∩ K) < ∞` for every compact `K ⊆ U`, then for `Hⁿ`-a.e. `x ∈ A`, `B` and `A` have the same
approximate tangent spaces at `x`.  `D = B \ A` is Borel with `Hⁿ(D ∩ K) < ∞` for compact `K ⊆ U`,
so by the upper density theorem `Hⁿ(D ∩ B̄_ρ(x))/ρⁿ → 0` as `ρ ↓ 0` for `Hⁿ`-a.e. `x ∈ U ∖ D`,
hence for `Hⁿ⌞A`-a.e. `x`.  At such `x ∈ A ⊆ U`, a closed ball `B̄_{r₀}(x) ⊆ U` is compact, so
`Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`, and the blow-ups of `B` and `A` at `x` have asymptotically equal
integrals. -/
theorem Submission.dor_lmb_approx_tangent_locality : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Steps 1–3: `D = B \ A` has finite measure on compact subsets of `U`, so its `n`-density
  -- vanishes at `Hⁿ`-a.e. point of `U ∖ D`
  have hdens := Submission.regcomp_atl_local_density_zero P n U (B \ A) hU (hB.diff hA)
    fun K hK hKU => ne_top_of_le_ne_top (hfin K hK hKU)
      (measure_mono (inter_subset_inter_left K sdiff_subset))
  -- Step 7: `Hⁿ⌞A`-a.e. `x` lies in `A`, hence in `U` and outside `D`
  filter_upwards [ae_restrict_of_ae hdens, ae_restrict_mem hA] with x hx hxA
  have hxU : x ∈ U := hBU (hAB hxA)
  -- Step 4: a closed ball `B̄_{r₀}(x) ⊆ U` is compact, so `Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x hxU
  have hsub : closedBall x (ε / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hε)).trans hball
  -- Steps 5–6: comparison of the blow-up integrals of `B` and `A` at `x`
  exact Submission.regcomp_atl_tangent_iff_of_density_zero P n A B x (ε / 2) hA hB hAB
    (half_pos hε) (hfin _ (isCompact_closedBall x (ε / 2)) hsub) (hx hxU fun h => h.2 hxA)

/-- **Simon Ch. 6, Remark 3.2(1)**, with a mass bound (chapter-06.txt lines 755–757): if
`T₁ = τ(M₁, θ₁, ξ₁)` and `T₂ = τ(M₂, θ₂, ξ₂)` in the open set `U` and `S = p₁T₁ + p₂T₂` with
`p₁, p₂ ∈ ℤ`, then `S = τ(M, θ, ξ)` for an integer multiplicity triple `R = (M, θ, ξ)` in `U` with
`μ_R ≤ |p₁| μ_{R₁} + |p₂| μ_{R₂}`.  Tangent locality and the sign of the orientations on
`M₁ ∩ M₂` give `R` with `1_M θ ξ = p₁ 1_{M₁} θ₁ ξ₁ + p₂ 1_{M₂} θ₂ ξ₂` `Hⁿ`-a.e.  Integrating this
identity against `ω ∈ 𝒟ⁿ(U)` gives `τ(R)(ω) = p₁T₁(ω) + p₂T₂(ω) = S(ω)`.  Evaluating it at a
covector norming `ξ` gives `θ 1_M ≤ |p₁| θ₁ 1_{M₁} + |p₂| θ₂ 1_{M₂}` a.e., hence the mass bound. -/
theorem Submission.dor_lmb_int_combination_imrep : ∀ (P n : ℕ) (U : Set (Euclid P)) (T₁ T₂ S : GeometricCurrentOn U n) (R₁ R₂ : IMRep U n) (p₁ p₂ : ℤ), IsOpen U → R₁.Represents T₁ → R₂.Represents T₂ → (∀ ω : TestFormOn U n, S ω = (p₁ : ℝ) * T₁ ω + (p₂ : ℝ) * T₂ ω) → ∃ R : IMRep U n, R.Represents S ∧ R.measure ≤ (p₁.natAbs : ℝ≥0∞) • R₁.measure + (p₂.natAbs : ℝ≥0∞) • R₂.measure := by
  intro P n U T₁ T₂ S R₁ R₂ p₁ p₂ hU h₁ h₂ hS
  -- Steps 2–6: an IMRep `R = (M, θ, ξ)` in `U` with
  -- `1_M θ ξ = p₁ 1_{M₁} θ₁ ξ₁ + p₂ 1_{M₂} θ₂ ξ₂` `Hⁿ`-a.e. (the identity (†) of step 5)
  obtain ⟨R, hR⟩ := Submission.rsdic_exists_imrep_int_combination P n U R₁ R₂ p₁ p₂ hU
  -- Steps 5 and 8: (†) bounds `θ 1_M` a.e., so `μ_R ≤ |p₁| μ_{R₁} + |p₂| μ_{R₂}`
  refine ⟨R, fun ω => ?_,
    Submission.dor_lmb_ic_measure_le_of_weighted_orient_eq P n U R₁ R₂ R p₁ p₂ hR⟩
  -- Step 7: integrating (†) against `ω` gives `τ(R)(ω) = p₁T₁(ω) + p₂T₂(ω) = S(ω)`
  rw [hS ω, h₁ ω, h₂ ω, Submission.rsdic_imrep_action_int_combination P n U R₁ R₂ R p₁ p₂ hR ω]

/-- **Restriction of an integer multiplicity current to a Borel set** (Simon Ch. 6, 4.5(2); e.g.
`Rⱼ⌞W_α` and `T⌞W_α` in the proof of 7.2.4): for a triple `R = (M, θ, ξ)` in `U` and Borel `A`,
`R' = (M ∩ A, θ, ξ)` is again a triple in `U`, it represents a current `S = τ(M, θ, ξ)⌞A` in
`𝒟ₙ(U)`, and `μ_{R'} = μ_R⌞A`.

As `θ ≥ 1` on `M`, `Hⁿ(M ∩ K) < ∞` for compact `K ⊆ U`.  So tangent locality for `M ∩ A ⊆ M`
gives `T_x(M ∩ A) = T_xM` for `Hⁿ`-a.e. `x ∈ M ∩ A`, and `ξ` still orients `M ∩ A`.  The triple
`R'` defines a current by Simon 6.3.1, and `(Hⁿ⌞(M ∩ A))θ = ((Hⁿ⌞M)θ)⌞A` because restriction to
the Borel set `A` commutes with taking densities. -/
theorem Submission.dor_lmb_imrep_restrict_current : ∀ (P n : ℕ) (U A : Set (Euclid P)) (R : IMRep U n), IsOpen U → MeasurableSet A → ∃ (S : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents S ∧ R'.carrier = R.carrier ∩ A ∧ R'.mult = R.mult ∧ R'.orient = R.orient ∧ R'.measure = R.measure.restrict A := by
  intro P n U A R hU hA
  -- Step 2(a): `Hⁿ(M ∩ K) < ∞` for compact `K ⊆ U`
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (R.carrier ∩ K) ≠ ∞ :=
    fun K hK hKU => (Submission.rsd_imrep_compact_measure_ne_top P n U R K hK hKU).1
  -- Step 2(b): `M ∩ A` and `M` have the same approximate tangent spaces `Hⁿ`-a.e. on `M ∩ A`
  have hloc := Submission.dor_lmb_approx_tangent_locality P n U (R.carrier ∩ A) R.carrier hU
    (R.measurableSet_carrier.inter hA) R.measurableSet_carrier inter_subset_left
    R.carrier_subset hfin
  -- Steps 1 and 2(c): `R' = (M ∩ A, θ, ξ)` is a triple in `U`
  obtain ⟨R', hc, hm, ho⟩ := Submission.regcomp_rim_sub_imrep P n U (R.carrier ∩ A) R R.mult
    (R.measurableSet_carrier.inter hA) inter_subset_left R.measurable_mult
    (fun x hx => R.mult_pos x hx.1) (fun x _ => le_rfl) (hloc.mono fun x hx Q hQ => (hx Q).1 hQ)
  -- Step 3: `R'` represents a current `S`
  obtain ⟨S, hS⟩ := Submission.dtc_imrep_current P n U R'
  refine ⟨S, R', hS, hc, hm, ho, ?_⟩
  -- Step 4: `(Hⁿ⌞(M ∩ A))θ = ((Hⁿ⌞M)θ)⌞A`
  simp only [IMRep.measure, hc, hm]
  rw [restrict_withDensity hA, Measure.restrict_restrict hA, inter_comm]

/-- **Slicing by a Lipschitz function** (Simon Ch. 6, 4.1–4.5, chapter-06.txt lines 1156–1310),
assuming (C1): `M_W(T) = μ_R(W)` for open `W` and `spt T = U ∩ spt μ_R` whenever `R` represents
`T`.  If `T = τ(M, θ, ξ) ∈ 𝒟_{n+1}(U)`, `∂T = τ(M', θ', ξ')` and `f` is `L`-Lipschitz, there are
`P_t ∈ 𝒟ₙ(U)` with `∫ M_W(P_t) dt ≤ L M_W(T)` for every open `W` such that, for `L¹`-a.e. `t`,
`P_t` is integer multiplicity, `P_t(ω) = 0` if `spt ω ∩ f⁻¹(t) = ∅`, and
`P_t(ω) = ∫_{M ∩ {f < t}} θ⟨dω, ξ⟩ dH^{n+1} − ∫_{M' ∩ {f < t}} θ'⟨ω, ξ'⟩ dHⁿ` (Simon 4.5(2)).

The slices `R_t = (M_t, θ_t, ξ_t)`, `M_t ⊆ f⁻¹(t)`, satisfy `∫ μ_{R_t}(W) dt ≤ L μ_T(W)` (co-area)
and the averaged identity for the cut-offs `γ_{a,b}(f)`.  `P_t` is the current represented by
`R_t ⌞ ℝᴾ`, which has the data of `R_t`, so `M_W(P_t) = μ_{R_t}(W)` by (C1).  `P_t(ω) = 0` when
`ω` vanishes on `M_t ⊆ f⁻¹(t)`.  Lebesgue differentiation of the averaged identity, with a null
set independent of `ω`, gives the slice identity for a.e. `t`. -/
theorem Submission.dor_lmb_slicing_lipschitz : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] := by
  intro hC1 P n U T RT RB f L hU hRT hRB hf
  -- Steps 1, 2(a)–(c), 4(b)–(c), 5(a)–(f): slices `R_t = (M_t, θ_t, ξ_t)` with `M_t ⊆ f⁻¹(t)`,
  -- the co-area mass bound and the averaged slice identity
  obtain ⟨Rs, hcarrier, hmass, hint, havg⟩ := Submission.dor_lmbs_imrep_slice_family
    Submission.dor_lmb_approx_tangent_locality P n U T RT RB f L hU hRT hRB hf
  -- Step 2(d): `P_t` is the current represented by `R_t ⌞ ℝᴾ` (borel_restriction, `A = ℝᴾ`)
  choose Ps Rs' hrep hcarrier' hmult' horient' hmeasure' using fun t =>
    Submission.dor_lmb_imrep_restrict_current P n U univ (Rs t) hU MeasurableSet.univ
  -- `R_t ⌞ ℝᴾ` has the carrier, multiplicity and orientation of `R_t`, so `P_t(ω) = τ(R_t)(ω)`
  have hPs : ∀ t (ω : TestFormOn U n),
      Ps t ω = (Rs t).action (ω : DifferentialForm (Euclid P) n) := by
    intro t ω
    rw [hrep t ω]
    simp only [IMRep.action, hcarrier' t, hmult' t, horient' t, inter_univ]
  refine ⟨Ps, fun W hW => ?_, ?_⟩
  · -- Step 4: `M_W(P_t) = μ_{R_t ⌞ ℝᴾ}(W) = μ_{R_t}(W)` and `M_W(T) = μ_T(W)` by (C1)
    have hPW : (fun t => (Ps t).massOn W) = fun t => (Rs t).measure W := by
      funext t
      rw [(hC1 P n U (Ps t) (Rs' t) hU (hrep t)).1 W hW, hmeasure' t, Measure.restrict_univ]
    rw [hPW, (hC1 P (n + 1) U T RT hU hRT).1 W hW]
    exact hmass W hW.measurableSet
  · -- Steps 5(g) and 6: the slice identity for a.e. `t`, for all `ω` at once
    filter_upwards [Submission.dor_lmbs_slice_identity_of_averages P n U RT RB Rs f hU
      hf.continuous.measurable (fun ω => (hint ω).locallyIntegrable) havg] with t ht
    -- Step 2(c): `R_t ⌞ ℝᴾ` is an integer multiplicity triple representing `P_t`
    refine ⟨⟨Rs' t, hrep t⟩, fun ω hω => ?_, fun ω => (hPs t ω).trans (ht ω)⟩
    -- Step 3: if `spt ω ∩ f⁻¹(t) = ∅`, then `ω = 0` on `M_t ⊆ f⁻¹(t)`
    rw [hPs t ω, IMRep.action]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [image_eq_zero_of_notMem_tsupport fun hxω => disjoint_left.1 hω hxω (hcarrier t hx),
      map_zero, mul_zero]
/-- **`C¹` local inverse at a point with invertible derivative** (steps 6–7 of
`dor_lmb_ret_normal_coordinates`).  If `Φ` is `C¹` on an open `U ∋ z₀` and `DΦ(z₀) = Λ` is a
continuous linear equivalence (`X` complete), then on some ball `B_ρ(z₀) ⊆ U` the map `Φ` has a
left inverse `G`, and for every open `W ⊆ B_ρ(z₀)` the image `Φ(W)` is open and `G` is `C¹` on it.
`G` is the inverse of the inverse function theorem's open partial homeomorphism `H` (`H = Φ`), and
`ρ` is small enough that `B_ρ(z₀)` lies in the source of `H` and `DΦ` is invertible on it. -/
theorem Submission.dor_lmb_ret_nc_local_inverse : ∀ (X Y : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] [NormedAddCommGroup Y] [NormedSpace ℝ Y] (Φ : X → Y) (U : Set X) (z₀ : X) (Λ : X ≃L[ℝ] Y), IsOpen U → z₀ ∈ U → ContDiffOn ℝ 1 Φ U → HasFDerivAt Φ (Λ : X →L[ℝ] Y) z₀ → ∃ ρ : ℝ, 0 < ρ ∧ ball z₀ ρ ⊆ U ∧ ∃ G : Y → X, (∀ z ∈ ball z₀ ρ, G (Φ z) = z) ∧ ∀ W : Set X, W ⊆ ball z₀ ρ → IsOpen W → IsOpen (Φ '' W) ∧ ContDiffOn ℝ 1 G (Φ '' W) := by
  intro X Y _ _ _ _ _ Φ U z₀ Λ hU hz₀ hΦ hΦ'
  have hUz₀ : U ∈ 𝓝 z₀ := hU.mem_nhds hz₀
  -- Step 1: the inverse function theorem at `z₀` gives an open partial homeomorphism `H` with
  -- underlying function `Φ` and `z₀ ∈ H.source`.
  have hstrict : HasStrictFDerivAt Φ (Λ : X →L[ℝ] Y) z₀ :=
    (hΦ.contDiffAt hUz₀).hasStrictFDerivAt' hΦ' one_ne_zero
  obtain ⟨H, hHΦ, hz₀S⟩ : ∃ H : OpenPartialHomeomorph X Y, (H : X → Y) = Φ ∧ z₀ ∈ H.source :=
    ⟨hstrict.toOpenPartialHomeomorph Φ, hstrict.toOpenPartialHomeomorph_coe,
      hstrict.mem_toOpenPartialHomeomorph_source⟩
  -- Step 2: `DΦ` is continuous at `z₀` with `DΦ(z₀) = Λ`, and the invertible maps form an open
  -- set, so `DΦ` is invertible near `z₀`.
  have hB : fderiv ℝ Φ ⁻¹' range ((↑) : (X ≃L[ℝ] Y) → X →L[ℝ] Y) ∈ 𝓝 z₀ := by
    refine ((hΦ.continuousOn_fderiv_of_isOpen hU le_rfl).continuousAt hUz₀).preimage_mem_nhds ?_
    rw [hΦ'.fderiv]
    exact Λ.nhds
  -- Step 3: choose `ρ` with `B_ρ(z₀) ⊆ H.source ∩ U ∩ {DΦ invertible}` and put `G = H⁻¹`.
  obtain ⟨ρ, hρ, hball⟩ :=
    Metric.mem_nhds_iff.1 (inter_mem (inter_mem (H.open_source.mem_nhds hz₀S) hUz₀) hB)
  refine ⟨ρ, hρ, fun z hz => (hball hz).1.2, H.symm, fun z hz => ?_, fun W hW hWo => ?_⟩
  · -- Step 4: `G (Φ z) = z` on the ball, which lies in the source of `H`.
    rw [← hHΦ]
    exact H.left_inv (hball hz).1.1
  · -- Step 5: `W` lies in the source of `H`, so `Φ '' W = H '' W` is open.
    have hWS : W ⊆ H.source := fun z hz => (hball (hW hz)).1.1
    rw [← hHΦ]
    refine ⟨H.isOpen_image_of_subset_source hWo hWS, ?_⟩
    -- Step 6: at `y = H z`, `z ∈ W`, the map `H = Φ` is `C¹` with invertible derivative
    -- `DΦ(z) = e`, so `H⁻¹` is `C¹` at `y`.
    rintro _ ⟨z, hzW, rfl⟩
    obtain ⟨⟨hzS, hzU⟩, e, he⟩ := hball (hW hzW)
    have hΦz : ContDiffAt ℝ 1 Φ z := hΦ.contDiffAt (hU.mem_nhds hzU)
    have hd : HasFDerivAt Φ (e : X →L[ℝ] Y) z := by
      rw [show (e : X →L[ℝ] Y) = fderiv ℝ Φ z from he]
      exact (hΦz.differentiableAt one_ne_zero).hasFDerivAt
    rw [← hHΦ] at hΦz hd
    have h₁ : HasFDerivAt (H : X → Y) (e : X →L[ℝ] Y) (H.symm (H z)) := by
      rwa [H.left_inv hzS]
    have h₂ : ContDiffAt ℝ 1 (H : X → Y) (H.symm (H z)) := by
      rwa [H.left_inv hzS]
    exact (H.contDiffAt_symm (H.map_source hzS) h₁ h₂).contDiffWithinAt
/-- **Normal coordinates, linear part** (parent proof, steps 1 and 5, with `L` in place of
`Dψ(v₀)`).  For an injective linear `L : ℝ^d → ℝ^P`, the map `Λ(w, k) = L w + k` is a continuous
linear isomorphism `ℝ^d × (range L)^⊥ ≅ ℝ^P`: it is injective, since `L w + k = 0` puts `k` in
`range L ∩ (range L)^⊥ = 0` and then `w = 0`; both sides have dimension `P`; and a linear
isomorphism between finite-dimensional spaces is continuous. -/
theorem Submission.dor_lmb_ret_nc_linear_iso : ∀ (P d : ℕ) (L : Euclid d →L[ℝ] Euclid P), Injective L → ∃ Λ : (Euclid d × ↥(L.range)ᗮ) ≃L[ℝ] Euclid P, ∀ (w : Euclid d) (k : ↥(L.range)ᗮ), Λ (w, k) = L w + k := by
  intro P d L hL
  -- Step 1: `Λ₀ = L ∘ pr₁ + ι ∘ pr₂`, so `Λ₀ (w, k) = L w + k`
  let Λ₀ : (Euclid d × ↥(L.range)ᗮ) →ₗ[ℝ] Euclid P :=
    (L : Euclid d →ₗ[ℝ] Euclid P) ∘ₗ LinearMap.fst ℝ (Euclid d) ↥(L.range)ᗮ +
      (L.range)ᗮ.subtype ∘ₗ LinearMap.snd ℝ (Euclid d) ↥(L.range)ᗮ
  -- Step 2: `L w + k = 0` puts `k = L (-w)` in `range L ∩ (range L)^⊥ = 0`, then `w = 0`
  have hinj : Injective Λ₀ := by
    refine (injective_iff_map_eq_zero Λ₀).2 ?_
    rintro ⟨w, k⟩ h
    change L w + (k : Euclid P) = 0 at h
    have hk : (k : Euclid P) ∈ L.range ⊓ (L.range)ᗮ :=
      ⟨LinearMap.mem_range.2 ⟨-w, by simpa using neg_eq_of_add_eq_zero_right h⟩, k.2⟩
    rw [Submodule.inf_orthogonal_eq_bot, Submodule.mem_bot] at hk
    have hw : w = 0 := (injective_iff_map_eq_zero L).1 hL w (by simpa [hk] using h)
    exact Prod.ext hw (Subtype.ext hk)
  -- Step 3: `dim (ℝ^d × (range L)^⊥) = dim range L + dim (range L)^⊥ = P`
  have hdim : Module.finrank ℝ (Euclid d × ↥(L.range)ᗮ) = Module.finrank ℝ (Euclid P) := by
    rw [Module.finrank_prod,
      ← LinearMap.finrank_range_of_inj (f := (L : Euclid d →ₗ[ℝ] Euclid P)) hL]
    exact (L.range).finrank_add_finrank_orthogonal
  -- Step 4: injective with equal finite dimensions, hence bijective
  have hsurj : Surjective Λ₀ :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).1 hinj
  -- Step 5: a linear equivalence in finite dimensions is continuous
  exact ⟨(LinearEquiv.ofBijective Λ₀ ⟨hinj, hsurj⟩).toContinuousLinearEquiv, fun w k => rfl⟩
/-- **Normal-coordinate map calculus.**  Let `V ⊆ ℝᵈ` be open, `v₀ ∈ V`, `ψ : ℝᵈ → ℝᴾ` and
`Q : ℝᵈ → L(ℝᴾ, ℝᴾ)` be `C¹` on `V`, and `Q(v₀)k = 0` for `k ∈ E`.  Then
`Φ(v, k) = ψ(v) + k − Q(v)k` is `C¹` on `V × E` (chain rule along `pr₁`, `ContDiffOn.clm_apply`),
and by the chain and product rules its derivative at `(v₀, 0)` is
`(w, h) ↦ Dψ(v₀)w + h − Q(v₀)h − (DQ(v₀)w)(0) = Dψ(v₀)w + h`. -/
theorem Submission.dor_lmb_ret_nc_map_calculus : ∀ (P d : ℕ) (E : Submodule ℝ (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (Q : Euclid d → (Euclid P →L[ℝ] Euclid P)) (v₀ : Euclid d), IsOpen V → v₀ ∈ V → ContDiffOn ℝ 1 ψ V → ContDiffOn ℝ 1 Q V → (∀ k ∈ E, Q v₀ k = 0) → ContDiffOn ℝ 1 (fun z : Euclid d × E => ψ z.1 + (z.2 : Euclid P) - Q z.1 (z.2 : Euclid P)) (V ×ˢ univ) ∧ HasFDerivAt (fun z : Euclid d × E => ψ z.1 + (z.2 : Euclid P) - Q z.1 (z.2 : Euclid P)) ((fderiv ℝ ψ v₀).comp (ContinuousLinearMap.fst ℝ (Euclid d) E) + E.subtypeL.comp (ContinuousLinearMap.snd ℝ (Euclid d) E)) (v₀, 0) := by
  intro P d E V ψ Q v₀ hV hv₀ hψ hQ hQ0
  -- `pr₁` maps `V × E` into `V`; `ι ∘ pr₂` is continuous linear.
  have hpr : MapsTo (Prod.fst : Euclid d × E → Euclid d) (V ×ˢ univ) V := fun z hz => hz.1
  have hι : ContDiff ℝ 1 (fun z : Euclid d × E => (z.2 : Euclid P)) :=
    (E.subtypeL.comp (ContinuousLinearMap.snd ℝ (Euclid d) E)).contDiff
  -- `Φ = ψ ∘ pr₁ + ι ∘ pr₂ − (Q ∘ pr₁)(ι ∘ pr₂)` is `C¹` on `V × E`.
  refine ⟨((hψ.comp contDiffOn_fst hpr).add hι.contDiffOn).sub
    ((hQ.comp contDiffOn_fst hpr).clm_apply hι.contDiffOn), ?_⟩
  -- `ψ` and `Q` are differentiable at `v₀ ∈ V`, `V` open.
  have hVn : V ∈ 𝓝 v₀ := hV.mem_nhds hv₀
  have hψd : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ :=
    (hψ.contDiffAt hVn).differentiableAt_one.hasFDerivAt
  have hQd : HasFDerivAt Q (fderiv ℝ Q v₀) v₀ :=
    (hQ.contDiffAt hVn).differentiableAt_one.hasFDerivAt
  -- Chain rule along `pr₁`, and the derivative of `ι ∘ pr₂`.
  have d1 : HasFDerivAt (fun z : Euclid d × E => ψ z.1)
      ((fderiv ℝ ψ v₀).comp (ContinuousLinearMap.fst ℝ (Euclid d) E)) (v₀, (0 : E)) :=
    hψd.comp (v₀, (0 : E)) hasFDerivAt_fst
  have d2 : HasFDerivAt (fun z : Euclid d × E => (z.2 : Euclid P))
      (E.subtypeL.comp (ContinuousLinearMap.snd ℝ (Euclid d) E)) (v₀, (0 : E)) :=
    (E.subtypeL.comp (ContinuousLinearMap.snd ℝ (Euclid d) E)).hasFDerivAt
  have dQ : HasFDerivAt (fun z : Euclid d × E => Q z.1)
      ((fderiv ℝ Q v₀).comp (ContinuousLinearMap.fst ℝ (Euclid d) E)) (v₀, (0 : E)) :=
    hQd.comp (v₀, (0 : E)) hasFDerivAt_fst
  -- Product rule for application, then `Q(v₀)h = 0` for `h ∈ E`.
  convert (d1.add d2).sub (dQ.clm_apply d2) using 1
  refine ContinuousLinearMap.ext fun z => ?_
  simp [hQ0 _ z.2.2]
/-- **Tangent projections of a `C²` immersion** (step 2(a) of the nearest point retraction onto `N`
used for Simon 7.4.3): if `ψ` is `C²` on the open set `V ⊆ ℝᵈ` and `D(v) = Dψ(v)` is injective for
`v ∈ V`, then `v ↦ P̂(v)`, the orthogonal projection of `ℝᴾ` onto `range D(v)`, is `C¹` on `V`.
The Gram operator `G = DᵀD` is `C¹` on `V` and invertible there (`⟪G w, w⟫ = |D w|²`); inversion
is smooth at units, so `R = D G⁻¹ Dᵀ` is `C¹`.  For `h ∈ ℝᴾ`, `R(v) h = D(v) y` with
`G(v) y = D(v)ᵀ h`, so `⟪h − R(v) h, D(v) x⟫ = ⟪D(v)ᵀ h − G(v) y, x⟫ = 0` and `R(v) = P̂(v)`. -/
theorem Submission.dor_lmb_ret_tangent_projection : ∀ (P d : ℕ) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P), IsOpen V → ContDiffOn ℝ 2 ψ V → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → ContDiffOn ℝ 1 (fun v => (fderiv ℝ ψ v).range.starProjection) V := by
  intro P d V ψ hV hψ hinj
  -- `D(v) = Dψ(v)` is `C¹` on the open set `V`
  have hD : ContDiffOn ℝ 1 (fun v => fderiv ℝ ψ v) V := hψ.fderiv_of_isOpen hV (by norm_num)
  -- transposition `A ↦ Aᵀ` is a bounded real-linear map, so `v ↦ D(v)ᵀ` is `C¹`
  have hadj : IsBoundedLinearMap ℝ
      (fun A : Euclid d →L[ℝ] Euclid P => ContinuousLinearMap.adjoint A) :=
    ⟨⟨fun A B => map_add _ A B, fun c A => by
      rw [LinearIsometryEquiv.map_smulₛₗ]; rfl⟩,
      ⟨1, one_pos, fun A => by rw [LinearIsometryEquiv.norm_map, one_mul]⟩⟩
  have hDt : ContDiffOn ℝ 1 (fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v)) V :=
    hadj.contDiff.comp_contDiffOn hD
  -- the Gram operator `G(v) = D(v)ᵀ D(v)` is `C¹` on `V`
  set G : Euclid d → Euclid d →L[ℝ] Euclid d :=
    fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v with hG_def
  have hG : ContDiffOn ℝ 1 G V := hDt.clm_comp hD
  -- `G(v)` is invertible: `⟪G(v) w, w⟫ = |D(v) w|²` and `D(v)` is injective
  have hGunit : ∀ v ∈ V, IsUnit (G v) := by
    intro v hv
    have hGinj : Injective (G v) := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      apply hinj v hv
      rw [map_zero]
      have hnorm : ‖fderiv ℝ ψ v w‖ ^ 2 = 0 := by
        rw [← real_inner_self_eq_norm_sq, ← ContinuousLinearMap.adjoint_inner_left]
        change inner ℝ (G v w) w = 0
        rw [hw, inner_zero_left]
      exact norm_eq_zero.mp (pow_eq_zero_iff two_ne_zero |>.mp hnorm)
    exact ContinuousLinearMap.isUnit_iff_bijective.mpr
      ⟨hGinj, (LinearMap.injective_iff_surjective (f := (G v : Euclid d →ₗ[ℝ] Euclid d))).mp hGinj⟩
  -- inversion is smooth at units, so `v ↦ G(v)⁻¹` is `C¹` on `V`
  have hGinv : ContDiffOn ℝ 1 (fun v => Ring.inverse (G v)) V := by
    intro v hv
    obtain ⟨u, hu⟩ := hGunit v hv
    have hinv := contDiffAt_ringInverse ℝ (n := 1) u
    rw [hu] at hinv
    exact hinv.comp_contDiffWithinAt v (hG v hv)
  -- `R(v) = D(v) G(v)⁻¹ D(v)ᵀ` is `C¹` on `V`
  have hR : ContDiffOn ℝ 1 (fun v => fderiv ℝ ψ v ∘L
      (Ring.inverse (G v) ∘L ContinuousLinearMap.adjoint (fderiv ℝ ψ v))) V :=
    hD.clm_comp (hGinv.clm_comp hDt)
  refine hR.congr fun v hv => ?_
  -- `R(v) h = D(v) y ∈ range D(v)` with `G(v) y = D(v)ᵀ h`, so `h - R(v) h ⊥ range D(v)`
  ext1 h
  set y := Ring.inverse (G v) (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) h)
  have hGy : G v y = ContinuousLinearMap.adjoint (fderiv ℝ ψ v) h := by
    rw [← mul_apply_eq_comp, Ring.mul_inverse_cancel _ (hGunit v hv), one_apply_eq_self]
  change _ = fderiv ℝ ψ v y
  refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero
    (LinearMap.mem_range_self (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P) y) ?_
  rintro _ ⟨x, rfl⟩
  rw [ContinuousLinearMap.coe_coe, ← ContinuousLinearMap.adjoint_inner_left, map_sub]
  change inner ℝ (_ - G v y) x = 0
  rw [hGy, sub_self, inner_zero_left]
/-- **Normal-space transfer** (step 3(c) of the nearest point retraction onto a `C²`
submanifold).  Let `Q`, `Q'` be the orthogonal projections onto `T`, `T'` with
`dim T = dim T'` and `‖Q' - Q‖ ≤ 1/2`.  For `e ∈ Tᗮ` we have `Q e = 0`, so
`‖Q' e‖ = ‖(Q' - Q) e‖ ≤ ‖e‖/2` and `‖e‖ ≤ 2 ‖e - Q' e‖`.  Hence `e ↦ e - Q' e` is an
injective linear map `Tᗮ → T'ᗮ`; as `dim Tᗮ = dim T'ᗮ` it is onto, and the preimage `e` of
`n ∈ T'ᗮ` satisfies `e - Q' e = n` and `‖e‖ ≤ 2 ‖n‖`. -/
theorem Submission.dor_lmb_ret_normal_space_transfer : ∀ (P : ℕ) (T T' : Submodule ℝ (Euclid P)), Module.finrank ℝ T = Module.finrank ℝ T' → ‖T'.starProjection - T.starProjection‖ ≤ 1 / 2 → ∀ n ∈ T'ᗮ, ∃ e ∈ Tᗮ, e - T'.starProjection e = n ∧ ‖e‖ ≤ 2 * ‖n‖ := by
  intro P T T' hdim hQ n hn
  -- Step 1: `L e := e - Q' e` maps `Tᗮ` linearly into `T'ᗮ`
  let L : Tᗮ →ₗ[ℝ] T'ᗮ :=
    ((LinearMap.id - (T'.starProjection : Euclid P →ₗ[ℝ] Euclid P)).domRestrict Tᗮ).codRestrict
      T'ᗮ fun e => T'.sub_starProjection_mem_orthogonal (e : Euclid P)
  have hL : ∀ e : Tᗮ, ((L e : T'ᗮ) : Euclid P) = e - T'.starProjection e := fun e => rfl
  -- Step 2: for `e ∈ Tᗮ`, `Q e = 0`, so `‖Q' e‖ ≤ ‖e‖ / 2` and `‖e‖ ≤ 2 ‖e - Q' e‖`
  have hlow : ∀ e ∈ Tᗮ, ‖e‖ ≤ 2 * ‖e - T'.starProjection e‖ := by
    intro e he
    have hQe : T'.starProjection e = (T'.starProjection - T.starProjection) e := by
      rw [sub_apply, T.starProjection_apply_eq_zero_iff.mpr he, sub_zero]
    have h₁ : ‖T'.starProjection e‖ ≤ 1 / 2 * ‖e‖ := by
      rw [hQe]
      exact ((T'.starProjection - T.starProjection).le_opNorm e).trans
        (mul_le_mul_of_nonneg_right hQ (norm_nonneg e))
    have h₂ : ‖e‖ ≤ ‖e - T'.starProjection e‖ + ‖T'.starProjection e‖ := by
      simpa using norm_add_le (e - T'.starProjection e) (T'.starProjection e)
    linarith
  -- Step 3: `L` is injective, since `L e = 0` forces `‖e‖ ≤ 0`
  have hinj : Function.Injective L := by
    refine (injective_iff_map_eq_zero L).mpr fun e he => ?_
    have h := hlow e e.2
    rw [← hL, he, ZeroMemClass.coe_zero, norm_zero, mul_zero] at h
    exact Subtype.ext (norm_le_zero_iff.mp h)
  -- Step 4: `dim Tᗮ = dim T'ᗮ`, so the injective map `L` is onto `T'ᗮ`
  have hdim' : Module.finrank ℝ Tᗮ = Module.finrank ℝ T'ᗮ := by
    have h₁ := T.finrank_add_finrank_orthogonal
    have h₂ := T'.finrank_add_finrank_orthogonal
    omega
  obtain ⟨e, he⟩ := (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim').mp hinj ⟨n, hn⟩
  -- Step 5: the preimage `e` of `n` satisfies `e - Q' e = n` and `‖e‖ ≤ 2 ‖n‖`
  have hen : (e : Euclid P) - T'.starProjection e = n := by rw [← hL, he]
  exact ⟨e, e.2, hen, hen ▸ hlow e e.2⟩

/-- **Normal coordinates** (step 3 of the nearest point retraction onto a `C²` submanifold).
Let `P̂(v)` be the orthogonal projection onto `range Dψ(v)` and `E = (range Dψ(v₀))ᗮ`.  The map
`Φ(v, e) = ψ(v) + e - P̂(v) e` is `C¹` on `V × E` with `DΦ(v₀, 0)(w, k) = Dψ(v₀) w + k`, an
isomorphism `ℝᵈ × E ≃ ℝᴾ`, so `Φ` has a `C¹` local inverse `G` on `O = Φ(B_{δ₁}(v₀, 0))`; put
`g = pr₁ ∘ G` and `δ = δ₁/2`, with `‖P̂(v) - P̂(v₀)‖ ≤ 1/2` on `B_{δ₁}(v₀)`.  A normal vector
`n` at `ψ(v)` with `|n| < δ` is `e - P̂(v) e` for some `e ∈ E` with `|e| ≤ 2|n| < δ₁`, so
`ψ(v) + n = Φ(v, e) ∈ O` and `g(ψ(v) + n) = v`. -/
theorem Submission.dor_lmb_ret_normal_coordinates : ∀ (P d : ℕ) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen V → ContDiffOn ℝ 2 ψ V → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → v₀ ∈ V → ∃ (δ : ℝ) (O : Set (Euclid P)) (g : Euclid P → Euclid d), 0 < δ ∧ closedBall v₀ δ ⊆ V ∧ IsOpen O ∧ ContDiffOn ℝ 1 g O ∧ ∀ v ∈ ball v₀ δ, ∀ n : Euclid P, (fderiv ℝ ψ v).range.starProjection n = 0 → ‖n‖ < δ → ψ v + n ∈ O ∧ g (ψ v + n) = v := by
  intro P d V ψ v₀ hV hψ hinj hv₀
  -- `P̂(v)` is the orthogonal projection onto `range Dψ(v)`, and `E = (range Dψ(v₀))ᗮ`
  set Q : Euclid d → Euclid P →L[ℝ] Euclid P := fun v => (fderiv ℝ ψ v).range.starProjection
  set E : Submodule ℝ (Euclid P) := (fderiv ℝ ψ v₀).rangeᗮ
  -- Step 2: `P̂` is `C¹` on `V`
  have hQ : ContDiffOn ℝ 1 Q V := Submission.dor_lmb_ret_tangent_projection P d V ψ hV hψ hinj
  -- Steps 3–4: `Φ(v, e) = ψ(v) + e - P̂(v) e` is `C¹` on `V × E`, and
  -- `DΦ(v₀, 0)(w, k) = Dψ(v₀) w + k` because `P̂(v₀) k = 0` for `k ∈ E`
  obtain ⟨hΦ, hΦ'⟩ := Submission.dor_lmb_ret_nc_map_calculus P d E V ψ Q v₀ hV hv₀
    (hψ.of_le (by norm_num)) hQ fun k hk => (Submodule.starProjection_apply_eq_zero_iff _).mpr hk
  set Φ : Euclid d × E → Euclid P := fun z => ψ z.1 + (z.2 : Euclid P) - Q z.1 (z.2 : Euclid P)
  -- Step 5: `Λ(w, k) = Dψ(v₀) w + k` is an isomorphism `ℝᵈ × E ≃ ℝᴾ`, and `Λ = DΦ(v₀, 0)`
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : (Euclid d × E) ≃L[ℝ] Euclid P,
      ∀ (w : Euclid d) (k : E), Λ (w, k) = fderiv ℝ ψ v₀ w + k :=
    Submission.dor_lmb_ret_nc_linear_iso P d (fderiv ℝ ψ v₀) (hinj v₀ hv₀)
  have hΛΦ : HasFDerivAt Φ (Λ : Euclid d × E →L[ℝ] Euclid P) (v₀, 0) :=
    hΦ'.congr_fderiv <| ContinuousLinearMap.ext fun ⟨w, k⟩ => by simp [hΛ]
  -- Steps 6–7: inverse function theorem for `Φ` at `(v₀, 0)`
  obtain ⟨ρ, hρ, hρV, G, hG, hGW⟩ := Submission.dor_lmb_ret_nc_local_inverse (Euclid d × E)
    (Euclid P) Φ (V ×ˢ univ) (v₀, 0) Λ (hV.prod isOpen_univ) ⟨hv₀, mem_univ _⟩ hΦ hΛΦ
  -- Step 8: `‖P̂(v) - P̂(v₀)‖ < 1/2` on `B_{δ₂}(v₀)`; take `0 < δ₁ ≤ min ρ δ₂`
  obtain ⟨δ₂, hδ₂, hδ₂Q⟩ := Metric.continuousAt_iff.mp
    (hQ.continuousOn.continuousAt (hV.mem_nhds hv₀)) (1 / 2) one_half_pos
  obtain ⟨δ₁, hδ₁, hδ₁ρ, hδ₁δ₂⟩ : ∃ δ₁ : ℝ, 0 < δ₁ ∧ δ₁ ≤ ρ ∧ δ₁ ≤ δ₂ :=
    ⟨min ρ δ₂, lt_min hρ hδ₂, min_le_left _ _, min_le_right _ _⟩
  have hB : ball ((v₀, 0) : Euclid d × E) δ₁ ⊆ ball (v₀, 0) ρ := ball_subset_ball hδ₁ρ
  have hW := hGW _ hB isOpen_ball
  -- `B_{δ₁}(v₀) ⊆ V`, as `(v, 0) ∈ B_ρ(v₀, 0) ⊆ V × E`
  have hball : ball v₀ δ₁ ⊆ V := by
    intro v hv
    have hv0 : ((v, 0) : Euclid d × E) ∈ ball (v₀, 0) δ₁ := by
      rw [← ball_prod_same]
      exact mk_mem_prod hv (mem_ball_self hδ₁)
    exact (mem_prod.mp (hρV (hB hv0))).1
  -- Step 9: `δ = δ₁/2`, `O = Φ(B_{δ₁}(v₀, 0))` and `g = pr₁ ∘ G`
  refine ⟨δ₁ / 2, Φ '' ball (v₀, 0) δ₁, fun x => (G x).1, half_pos hδ₁,
    (closedBall_subset_ball (half_lt_self hδ₁)).trans hball, hW.1, hW.2.fst, ?_⟩
  -- Step 10: let `v ∈ B_δ(v₀)` and `n ⊥ range Dψ(v)` with `|n| < δ`
  intro v hv n hn hnδ
  have hv₁ : v ∈ ball v₀ δ₁ := ball_subset_ball (half_le_self hδ₁.le) hv
  have hvV : v ∈ V := hball hv₁
  -- `dim range Dψ(v₀) = d = dim range Dψ(v)` and `‖P̂(v) - P̂(v₀)‖ ≤ 1/2`
  have hdim : Module.finrank ℝ (fderiv ℝ ψ v₀).range =
      Module.finrank ℝ (fderiv ℝ ψ v).range :=
    (LinearMap.finrank_range_of_inj (f := (fderiv ℝ ψ v₀ : Euclid d →ₗ[ℝ] Euclid P))
      (hinj v₀ hv₀)).trans
      (LinearMap.finrank_range_of_inj (f := (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P))
        (hinj v hvV)).symm
  have hQv : ‖Q v - Q v₀‖ ≤ 1 / 2 := by
    rw [← dist_eq_norm]
    exact (hδ₂Q ((mem_ball.mp hv₁).trans_le hδ₁δ₂)).le
  -- normal-space transfer: `n = e - P̂(v) e` for some `e ∈ E` with `|e| ≤ 2|n| < δ₁`
  obtain ⟨e, he, hen, hle⟩ := Submission.dor_lmb_ret_normal_space_transfer P _ _ hdim hQv n
    ((Submodule.starProjection_apply_eq_zero_iff _).mp hn)
  have hz : ((v, ⟨e, he⟩) : Euclid d × E) ∈ ball (v₀, 0) δ₁ := by
    rw [← ball_prod_same]
    refine mk_mem_prod hv₁ (mem_ball_zero_iff.mpr ?_)
    change ‖e‖ < δ₁
    linarith
  -- so `ψ(v) + n = Φ(v, e) ∈ O` and `G(ψ(v) + n) = (v, e)`, i.e. `g(ψ(v) + n) = v`
  have hΦz : Φ (v, ⟨e, he⟩) = ψ v + n := by
    change ψ v + e - (fderiv ℝ ψ v).range.starProjection e = ψ v + n
    rw [add_sub_assoc, hen]
  have hGz : G (ψ v + n) = (v, ⟨e, he⟩) := by
    rw [← hΦz]
    exact hG _ (hB hz)
  exact ⟨⟨_, hz, hΦz⟩, congrArg Prod.fst hGz⟩

/-- **Nearest-point retraction near a chart point** (proof of Simon 7.4.3: the nearest-point
projection onto the embedded `C²` submanifold `N` near `y = ψ(v₀)`).  Normal coordinates give
`δ`, `O`, `g` with `g(ψ(v) + n) = v` for `v ∈ B_δ(v₀)` and `n ⊥ range Dψ(v)`, `|n| < δ`; chart
localization with `ε = δ` gives a compact `K = N ∩ B̄_ρ(y) ⊆ ψ(V ∩ B_δ(v₀))`.  For `x ∈ B_r(y)`,
`r = min(ρ/2, δ)`, the distance from `x` to `K` is attained at some `p = ψ(v)`, `v ∈ B_δ(v₀)`, and
points of `N \ K` are farther away, so `p` is nearest in `N`.  The first-order condition for
`|x − ψ(·)|²` at `v` makes `x − p` normal to `range Dψ(v)`; as `|x − p| ≤ |x − y| < δ`, normal
coordinates give `x = ψ(v) + (x − p) ∈ O` and `g(x) = v`. -/
theorem Submission.dor_lmb_ret_nearest_point : ∀ (P d : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen V → IsOpen W → ContDiffOn ℝ 2 ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → v₀ ∈ V → ∃ (r δ : ℝ) (g : Euclid P → Euclid d), 0 < r ∧ 0 < δ ∧ closedBall v₀ δ ⊆ V ∧ ContDiffOn ℝ 1 g (ball (ψ v₀) r) ∧ MapsTo g (ball (ψ v₀) r) (ball v₀ δ) ∧ (∀ x ∈ ball (ψ v₀) r, ∀ z ∈ N, ‖x - ψ (g x)‖ ≤ ‖x - z‖) ∧ (∀ x ∈ ball (ψ v₀) r, (fderiv ℝ ψ (g x)).range.starProjection (x - ψ (g x)) = 0) ∧ ∀ x ∈ N ∩ ball (ψ v₀) r, ψ (g x) = x := by
  intro P d N W V ψ v₀ hV hW hψ hinj himg hprop hDψ hv₀
  -- normal coordinates: `g(ψ(v) + n) = v` for `v ∈ B_δ(v₀)` and normal `n` with `|n| < δ`
  obtain ⟨δ, O, g, hδ, hδV, -, hgO, hrec⟩ :=
    Submission.dor_lmb_ret_normal_coordinates P d V ψ v₀ hV hψ hDψ hv₀
  -- chart localization with `ε = δ`: `K = N ∩ B̄_ρ(y)` is compact and lies in `ψ(V ∩ B_δ(v₀))`
  obtain ⟨ρ, hρ, -, hKψ, hK⟩ := Submission.dor_lmb_ret_chart_localization P d N W V ψ v₀ hW
    hψ.continuousOn hinj himg hprop hv₀ δ hδ
  -- `ψ(V) ⊆ N`, so `y ∈ K`
  have hψN : ∀ w ∈ V, ψ w ∈ N := fun w hw => (himg ▸ mem_image_of_mem ψ hw : ψ w ∈ W ∩ N).2
  have hyK : ψ v₀ ∈ N ∩ closedBall (ψ v₀) ρ := ⟨hψN v₀ hv₀, mem_closedBall_self hρ.le⟩
  have hr : 0 < min (ρ / 2) δ := lt_min (half_pos hρ) hδ
  -- for `x ∈ B_r(y)`: a nearest point `ψ(v)` of `N`, with `x − ψ(v)` normal and `g(x) = v`
  have key : ∀ x ∈ ball (ψ v₀) (min (ρ / 2) δ), ∃ v ∈ ball v₀ δ,
      (∀ z ∈ N, ‖x - ψ v‖ ≤ ‖x - z‖) ∧
        (fderiv ℝ ψ v).range.starProjection (x - ψ v) = 0 ∧ x ∈ O ∧ g x = v := by
    intro x hx
    rw [mem_ball, dist_eq_norm, lt_min_iff] at hx
    obtain ⟨hxρ, hxδ⟩ := hx
    -- the distance from `x` to `K` is attained at some `p ∈ K`
    obtain ⟨p, hpK, hpmin⟩ := hK.exists_isMinOn ⟨ψ v₀, hyK⟩
      ((continuous_const.sub continuous_id).norm.continuousOn :
        ContinuousOn (fun z => ‖x - z‖) _)
    rw [isMinOn_iff] at hpmin
    have hpy : ‖x - p‖ ≤ ‖x - ψ v₀‖ := hpmin _ hyK
    -- points of `N \ K` are at distance `> ρ - ρ / 2 > |x - y|` from `x`
    have hnear : ∀ z ∈ N, ‖x - p‖ ≤ ‖x - z‖ := by
      intro z hz
      by_cases hzK : z ∈ closedBall (ψ v₀) ρ
      · exact hpmin z ⟨hz, hzK⟩
      rw [mem_closedBall, dist_eq_norm, not_le] at hzK
      have htri : ‖z - ψ v₀‖ ≤ ‖x - ψ v₀‖ + ‖x - z‖ := by
        simpa using norm_sub_le (x - ψ v₀) (x - z)
      linarith
    -- `p = ψ(v)` with `v ∈ V ∩ B_δ(v₀)`
    obtain ⟨v, ⟨hvV, hvδ⟩, rfl⟩ := hKψ hpK
    -- `w ↦ |x − ψ(w)|²` has a local minimum at `v`, as `ψ(V) ⊆ N` and `V` is open
    have hmin : IsLocalMin (fun w => ‖x - ψ w‖ ^ 2) v := by
      filter_upwards [hV.mem_nhds hvV] with w hw
      exact pow_le_pow_left₀ (norm_nonneg _) (hnear _ (hψN w hw)) 2
    have hDv : HasFDerivAt ψ (fderiv ℝ ψ v) v :=
      ((hψ.differentiableOn two_ne_zero).differentiableAt (hV.mem_nhds hvV)).hasFDerivAt
    -- its derivative `w ↦ −2⟨x − ψ(v), Dψ(v)w⟩` vanishes, so `x − ψ(v) ⊥ range Dψ(v)`
    have h0 := hmin.hasFDerivAt_eq_zero (hDv.const_sub x).norm_sq
    have hnormal : (fderiv ℝ ψ v).range.starProjection (x - ψ v) = 0 := by
      rw [Submodule.starProjection_apply_eq_zero_iff, Submodule.mem_orthogonal]
      rintro _ ⟨w, rfl⟩
      have h := congrArg (fun L => L w) h0
      simp only [_root_.smul_apply, ContinuousLinearMap.comp_apply, _root_.neg_apply,
        innerSL_apply_apply, inner_neg_right, _root_.zero_apply, smul_neg, neg_eq_zero,
        smul_eq_zero] at h
      rw [real_inner_comm]
      exact h.resolve_left two_ne_zero
    -- normal coordinates recover `v` from `x = ψ(v) + (x − ψ(v))`, `|x − ψ(v)| < δ`
    obtain ⟨hxO, hgx⟩ := hrec v hvδ (x - ψ v) hnormal (hpy.trans_lt hxδ)
    rw [add_sub_cancel] at hxO hgx
    exact ⟨v, hvδ, hnear, hnormal, hxO, hgx⟩
  refine ⟨min (ρ / 2) δ, δ, g, hr, hδ, hδV,
    hgO.mono fun x hx => (key x hx).elim fun _ h => h.2.2.2.1, fun x hx => ?_, fun x hx => ?_,
    fun x hx => ?_, fun x hx => ?_⟩
  · obtain ⟨v, hvδ, -, -, -, hgx⟩ := key x hx
    rwa [hgx]
  · obtain ⟨v, -, hnear, -, -, hgx⟩ := key x hx
    rwa [hgx]
  · obtain ⟨v, -, -, hnormal, -, hgx⟩ := key x hx
    rwa [hgx]
  · -- a point of `N` is its own nearest point
    obtain ⟨v, -, hnear, -, -, hgx⟩ := key x hx.2
    have h := hnear x hx.1
    rw [sub_self, norm_zero, norm_le_zero_iff, sub_eq_zero] at h
    rw [hgx, h]
/-- **Tangent identity** (step 6(c) of the C¹-retraction proof): if `proj` is differentiable at
`x ∈ O`, `O` open, and fixes every point of `N ∩ O`, then `Dproj(x) v = v` for every
`v ∈ T_xN`.  Write `v = γ'(0)` with `γ((−1, 1)) ⊆ N`, `γ(0) = x`; by continuity `γ` stays in `O`
near `0`, so `proj ∘ γ = γ` near `0`.  The chain rule gives `(proj ∘ γ)'(0) = Dproj(x) v`, and
uniqueness of derivatives gives `Dproj(x) v = γ'(0) = v`. -/
theorem Submission.dor_lmb_ret_fderiv_tangent_eq : ∀ (P : ℕ) (N O : Set (Euclid P)) (proj : Euclid P → Euclid P) (x : Euclid P), IsOpen O → x ∈ O → DifferentiableAt ℝ proj x → (∀ z ∈ N ∩ O, proj z = z) → ∀ v ∈ tangentSpace N x, fderiv ℝ proj x v = v := by
  intro P N O proj x hO hxO hproj hfix v hv
  obtain ⟨γ, -, hγN, hγ0, hγ⟩ := hv
  -- `γ` is continuous at `0` and `γ 0 = x ∈ O`, so `γ s ∈ O` for `s` near `0`
  have hγO : ∀ᶠ s in 𝓝 (0 : ℝ), γ s ∈ O :=
    hγ.continuousAt (by rw [hγ0]; exact hO.mem_nhds hxO)
  -- on `(−1, 1)` the curve lies in `N`, hence `proj ∘ γ = γ` near `0`
  have heq : proj ∘ γ =ᶠ[𝓝 0] γ := by
    filter_upwards [hγO, Ioo_mem_nhds neg_one_lt_zero zero_lt_one] with s hsO hsI
    exact hfix (γ s) ⟨hγN hsI, hsO⟩
  -- chain rule: `proj ∘ γ` has derivative `Dproj(x) v` at `0`
  have hcomp : HasDerivAt (proj ∘ γ) (fderiv ℝ proj x v) 0 :=
    hproj.hasFDerivAt.comp_hasDerivAt_of_eq 0 hγ hγ0.symm
  -- so does `γ`, and derivatives are unique
  exact (hcomp.congr_of_eventuallyEq heq.symm).unique hγ
/-- **Differentiated normality estimate** (step 7(b)–(e) of the parent retraction proof, with an
abstract `Q` in place of `P̂`).  Put `v = g(x)`, `ν = x − ψ(v)`, `A = Dg(x)`, `B = Dψ(v)` and
`C = DQ(v)`.  Differentiating `z ↦ Q(g(z))(z − ψ(g(z)))`, which vanishes on the open `O ∋ x`,
gives `Q(v)(h − BAh) + (C(Ah))ν = 0`; as `Q(v)` fixes the range of `B`, `BAh = Q(v)h + (C(Ah))ν`.
With `|Ah| ≤ b|BAh|` this gives `|BAh| ≤ |h| + s|BAh|` for `s = ab|ν| ≤ 1/2`, hence
`|BAh| ≤ (1 + 2s)|h|` because `(1 + 2s)(1 − s) ≥ 1`. -/
theorem Submission.dor_lmb_ret_derivative_estimate : ∀ (P d : ℕ) (O : Set (Euclid P)) (g : Euclid P → Euclid d) (ψ : Euclid d → Euclid P) (Q : Euclid d → (Euclid P →L[ℝ] Euclid P)) (x : Euclid P) (a b : ℝ), IsOpen O → x ∈ O → DifferentiableAt ℝ g x → DifferentiableAt ℝ ψ (g x) → DifferentiableAt ℝ Q (g x) → (∀ z ∈ O, Q (g z) (z - ψ (g z)) = 0) → (Q (g x)).comp (fderiv ℝ ψ (g x)) = fderiv ℝ ψ (g x) → ‖Q (g x)‖ ≤ 1 → 0 ≤ a → 0 ≤ b → ‖fderiv ℝ Q (g x)‖ ≤ a → (∀ w : Euclid d, ‖w‖ ≤ b * ‖fderiv ℝ ψ (g x) w‖) → a * b * ‖x - ψ (g x)‖ ≤ 1 / 2 → ‖fderiv ℝ (ψ ∘ g) x‖ ≤ 1 + 2 * (a * b) * ‖x - ψ (g x)‖ := by
  intro P d O g ψ Q x a b hO hx hg hψ hQ hzero hQB hQ1 ha hb hDQ hinj hs
  set A := fderiv ℝ g x
  set B := fderiv ℝ ψ (g x)
  set C := fderiv ℝ Q (g x)
  set ν := x - ψ (g x)
  -- `F(z) = Q(g(z))(z − ψ(g(z)))` has derivative `h ↦ Q(v)(h − BAh) + (C(Ah))ν` at `x`
  have hF : HasFDerivAt (fun z => Q (g z) (z - ψ (g z)))
      ((Q (g x)).comp (ContinuousLinearMap.id ℝ (Euclid P) - B.comp A) + (C.comp A).flip ν) x :=
    (hQ.hasFDerivAt.comp x hg.hasFDerivAt).clm_apply
      ((hasFDerivAt_id x).sub (hψ.hasFDerivAt.comp x hg.hasFDerivAt))
  -- `F` vanishes on the open neighbourhood `O` of `x`, so `DF(x) = 0`
  have hF0 : HasFDerivAt (fun z => Q (g z) (z - ψ (g z))) (0 : Euclid P →L[ℝ] Euclid P) x :=
    (hasFDerivAt_const (0 : Euclid P) x).congr_of_eventuallyEq
      (Filter.eventually_of_mem (hO.mem_nhds hx) hzero)
  have hDF := hF.unique hF0
  have hs0 : 0 ≤ a * b * ‖ν‖ := mul_nonneg (mul_nonneg ha hb) (norm_nonneg _)
  -- `D(ψ ∘ g)(x) = B ∘ A`; bound `|BAh|` for each `h`
  rw [fderiv_comp x hψ hg]
  refine ContinuousLinearMap.opNorm_le_bound _ (by linarith) fun h => ?_
  show ‖B (A h)‖ ≤ (1 + 2 * (a * b) * ‖ν‖) * ‖h‖
  -- `BAh = Q(v)h + (C(Ah))ν`, using `Q(v)(BAh) = BAh`
  have h1 : Q (g x) (h - B (A h)) + C (A h) ν = 0 := by
    simpa using DFunLike.congr_fun hDF h
  have h2 : Q (g x) (B (A h)) = B (A h) := DFunLike.congr_fun hQB (A h)
  have hkey : B (A h) = Q (g x) h + C (A h) ν := by
    rw [map_sub, h2, sub_add_eq_add_sub, sub_eq_zero] at h1
    exact h1.symm
  -- `|Q(v)h| ≤ |h|` and `|(C(Ah))ν| ≤ a|Ah||ν| ≤ ab|ν||BAh|`
  have hQh : ‖Q (g x) h‖ ≤ ‖h‖ :=
    ((Q (g x)).le_opNorm h).trans (by simpa using mul_le_mul_of_nonneg_right hQ1 (norm_nonneg h))
  have hCh : ‖C (A h) ν‖ ≤ a * b * ‖ν‖ * ‖B (A h)‖ :=
    calc ‖C (A h) ν‖ ≤ ‖C (A h)‖ * ‖ν‖ := (C (A h)).le_opNorm ν
      _ ≤ ‖C‖ * ‖A h‖ * ‖ν‖ := by gcongr; exact C.le_opNorm (A h)
      _ ≤ a * (b * ‖B (A h)‖) * ‖ν‖ := by gcongr; exact hinj (A h)
      _ = a * b * ‖ν‖ * ‖B (A h)‖ := by ring
  have hle : ‖B (A h)‖ ≤ ‖h‖ + a * b * ‖ν‖ * ‖B (A h)‖ :=
    calc ‖B (A h)‖ = ‖Q (g x) h + C (A h) ν‖ := by rw [← hkey]
      _ ≤ ‖Q (g x) h‖ + ‖C (A h) ν‖ := norm_add_le _ _
      _ ≤ ‖h‖ + a * b * ‖ν‖ * ‖B (A h)‖ := add_le_add hQh hCh
  -- `(1 − s)|BAh| ≤ |h|` and `(1 + 2s)(1 − s) = 1 + s(1 − 2s) ≥ 1` for `0 ≤ s ≤ 1/2`
  nlinarith [mul_nonneg (sub_nonneg.mpr hle) (by linarith : (0 : ℝ) ≤ 1 + 2 * (a * b * ‖ν‖)),
    mul_nonneg (mul_nonneg hs0 (by linarith : (0 : ℝ) ≤ 1 - 2 * (a * b * ‖ν‖)))
      (norm_nonneg (B (A h)))]
/-- Uniform injectivity on a compact set (step 2(b) of the nearest point retraction used in the
proof of Simon 7.4.3): if `L : ℝᵈ → L(ℝᵈ, ℝᴾ)` is continuous on the compact set `K` and `L(v)` is
injective for every `v ∈ K`, then some `b ≥ 0` has `|w| ≤ b |L(v)w|` for all `v ∈ K`, `w ∈ ℝᵈ`.
The continuous function `(v, w) ↦ |L(v)w|` attains its minimum `m` on the compact set
`S := K × {|w| = 1}`; `m > 0` by injectivity, and `b := m⁻¹` works since
`m ≤ |L(v)(w / |w|)| = |L(v)w| / |w|` for `w ≠ 0`.  If `S = ∅` (`K = ∅` or `d = 0`), every `w` is
`0` for `v ∈ K`, and `b := 0` works. -/
theorem Submission.dor_lmb_ret_uniform_injectivity : ∀ (P d : ℕ) (K : Set (Euclid d)) (L : Euclid d → (Euclid d →L[ℝ] Euclid P)), IsCompact K → ContinuousOn L K → (∀ v ∈ K, Injective (L v)) → ∃ b : ℝ, 0 ≤ b ∧ ∀ v ∈ K, ∀ w : Euclid d, ‖w‖ ≤ b * ‖L v w‖ := by
  intro P d K L hK hL hinj
  -- `w / |w|` is a unit vector for `w ≠ 0`
  have hunit : ∀ w : Euclid d, w ≠ 0 → ‖w‖⁻¹ • w ∈ sphere (0 : Euclid d) 1 := by
    intro w hw
    rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.2 hw)]
  rcases (K ×ˢ sphere (0 : Euclid d) 1).eq_empty_or_nonempty with hS | hS
  · -- `S = ∅`: for `v ∈ K` every `w` is `0`, so `b := 0` works
    refine ⟨0, le_rfl, fun v hv w => ?_⟩
    have hw : w = 0 := by
      by_contra hw
      have hmem : (v, ‖w‖⁻¹ • w) ∈ K ×ˢ sphere (0 : Euclid d) 1 := ⟨hv, hunit w hw⟩
      rw [hS] at hmem
      exact hmem
    rw [hw, norm_zero, zero_mul]
  · -- `(v, w) ↦ |L(v)w|` attains its minimum `m = |L(v₁)w₁|` on the compact set `S`
    obtain ⟨⟨v₁, w₁⟩, ⟨hv₁, hw₁⟩, hmin⟩ := (hK.prod (isCompact_sphere _ _)).exists_isMinOn hS
      ((hL.comp continuousOn_fst fun _ hp => hp.1).clm_apply continuousOn_snd).norm
    -- `m > 0`, since `w₁ ≠ 0` and `L(v₁)` is injective
    have hw₁0 : w₁ ≠ 0 := ne_zero_of_mem_unit_sphere ⟨w₁, hw₁⟩
    have hm : 0 < ‖L v₁ w₁‖ :=
      norm_pos_iff.2 fun h => hw₁0 (hinj v₁ hv₁ (by rw [h, map_zero]))
    refine ⟨‖L v₁ w₁‖⁻¹, inv_nonneg.2 (norm_nonneg _), fun v hv w => ?_⟩
    rcases eq_or_ne w 0 with rfl | hw
    · rw [norm_zero, map_zero, norm_zero, mul_zero]
    -- `m ≤ |L(v)(w / |w|)| = |L(v)w| / |w|`, i.e. `m |w| ≤ |L(v)w|`
    have hle : ‖L v₁ w₁‖ ≤ ‖w‖⁻¹ * ‖L v w‖ :=
      calc ‖L v₁ w₁‖ ≤ ‖L v (‖w‖⁻¹ • w)‖ := isMinOn_iff.1 hmin (v, ‖w‖⁻¹ • w) ⟨hv, hunit w hw⟩
        _ = ‖w‖⁻¹ * ‖L v w‖ := by rw [map_smul, norm_smul, norm_inv, norm_norm]
    exact (le_inv_mul_iff₀ hm).2 ((le_inv_mul_iff₀' (norm_pos_iff.2 hw)).1 hle)

/-- **Nearest point retraction near `y ∈ N`** (step 1(a) of the limsup mass bound: the tubular
neighbourhood theorem, Foote 1984, written out in a chart).  Take a `C²` chart `ψ : V → W ∩ N`
with `ψ(v₀) = y`.  `dor_lmb_ret_nearest_point` gives `g` on `B_{r'}(y)` such that `π := ψ ∘ g` is
the nearest point map onto `N`: it is `C¹`, fixes `N ∩ B_{r'}(y)`, and `x − π(x)` is normal to `N`
at `π(x)`.  On `B̄_δ(v₀)`, `a` bounds the derivative of the tangent projection `P̂(v)` (`C¹` by
`dor_lmb_ret_tangent_projection`), and `|w| ≤ b|Dψ(v)w|` (`dor_lmb_ret_uniform_injectivity`).
Take `r ≤ r'` with `B̄_r(y) ⊆ U` and `2abr ≤ 1`.  Then `Dπ(x)v = v` on `T_xN`
(`dor_lmb_ret_fderiv_tangent_eq`).  Differentiating `P̂(g x)(x − π(x)) = 0` gives
`‖Dπ(x)‖ ≤ 1 + 2ab|x − π(x)|` (`dor_lmb_ret_derivative_estimate`), and `|x − π(x)| ≤ |x − y|`
because `y ∈ N`.  The hypothesis `(N̄ \ N) ∩ U = ∅` is not used. -/
theorem Submission.dor_lmb_c1_retraction : ∀ (P d : ℕ) (U N : Set (Euclid P)) (y : Euclid P), IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → y ∈ N ∩ U → ∃ (r c : ℝ) (proj : Euclid P → Euclid P), 0 < r ∧ 0 ≤ c ∧ closedBall y r ⊆ U ∧ ContDiffOn ℝ 1 proj (ball y r) ∧ MapsTo proj (ball y r) N ∧ (∀ x ∈ N ∩ ball y r, proj x = x) ∧ (∀ x ∈ N ∩ ball y r, ∀ v ∈ tangentSpace N x, fderiv ℝ proj x v = v) ∧ ∀ x ∈ ball y r, ‖fderiv ℝ proj x‖ ≤ 1 + c * dist x y := by
  intro P d U N y hU hN _ hy
  -- Step 1: a `C²` chart `ψ : V → W ∩ N` with `ψ(v₀) = y`
  obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hDinj⟩ := hN y hy.1
  have hψ2 : ContDiffOn ℝ 2 ψ V := by exact_mod_cast hψ
  obtain ⟨v₀, hv₀, rfl⟩ : y ∈ ψ '' V := by
    rw [himg]
    exact ⟨hyW, hy.1⟩
  -- Step 2: the nearest point map `π = ψ ∘ g` on `B_{r'}(y)`, with `g(B_{r'}(y)) ⊆ B_δ(v₀)`
  obtain ⟨r', δ, g, hr', -, hδV, hg, hgδ, hnear, hnormal, hfix⟩ :=
    Submission.dor_lmb_ret_nearest_point P d N W V ψ v₀ hV hW hψ2 hinj himg hprop hDinj hv₀
  have hgV : MapsTo g (ball (ψ v₀) r') V := fun x hx => hδV (ball_subset_closedBall (hgδ hx))
  have hπ : ContDiffOn ℝ 1 (ψ ∘ g) (ball (ψ v₀) r') := (hψ2.of_le one_le_two).comp hg hgV
  -- Step 3: the tangent projection `P̂(v)` is `C¹` on `V`; `a` bounds `‖DP̂‖` on `B̄_δ(v₀)`
  have hQ : ContDiffOn ℝ 1 (fun v => (fderiv ℝ ψ v).range.starProjection) V :=
    Submission.dor_lmb_ret_tangent_projection P d V ψ hV hψ2 hDinj
  obtain ⟨a₀, ha₀⟩ := (isCompact_closedBall v₀ δ).exists_bound_of_continuousOn
    ((hQ.continuousOn_fderiv_of_isOpen hV le_rfl).mono hδV)
  obtain ⟨a, ha, hDQ⟩ : ∃ a : ℝ, 0 ≤ a ∧ ∀ v ∈ closedBall v₀ δ,
      ‖fderiv ℝ (fun v => (fderiv ℝ ψ v).range.starProjection) v‖ ≤ a :=
    ⟨max a₀ 0, le_max_right _ _, fun v hv => (ha₀ v hv).trans (le_max_left _ _)⟩
  -- Step 4: `|w| ≤ b|Dψ(v)w|` for `v ∈ B̄_δ(v₀)`
  obtain ⟨b, hb, hDψ⟩ := Submission.dor_lmb_ret_uniform_injectivity P d (closedBall v₀ δ)
    (fderiv ℝ ψ) (isCompact_closedBall v₀ δ)
    ((hψ2.continuousOn_fderiv_of_isOpen hV one_le_two).mono hδV) fun v hv => hDinj v (hδV hv)
  have hab : 0 ≤ a * b := mul_nonneg ha hb
  -- Step 5: `r ≤ r'` with `B̄_r(y) ⊆ U` and `2abr ≤ 1`
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.mp hU (ψ v₀) hy.2
  obtain ⟨r, hr, hrr', hrε, hrab⟩ : ∃ r : ℝ, 0 < r ∧ r ≤ r' ∧ r ≤ ε / 2 ∧
      r ≤ 1 / (2 * (a * b) + 1) :=
    ⟨min (min r' (ε / 2)) (1 / (2 * (a * b) + 1)),
      lt_min (lt_min hr' (half_pos hε)) (one_div_pos.mpr (by linarith)),
      (min_le_left _ _).trans (min_le_left _ _), (min_le_left _ _).trans (min_le_right _ _),
      min_le_right _ _⟩
  have hball : ball (ψ v₀) r ⊆ ball (ψ v₀) r' := ball_subset_ball hrr'
  refine ⟨r, 2 * (a * b), ψ ∘ g, hr, mul_nonneg zero_le_two hab,
    (closedBall_subset_ball (by linarith)).trans hεU, hπ.mono hball, fun x hx => ?_,
    fun x hx => hfix x ⟨hx.1, hball hx.2⟩, fun x hx v hv => ?_, fun x hx => ?_⟩
  · -- Step 6: `π(B_r(y)) ⊆ ψ(V) ⊆ N`
    have h : ψ (g x) ∈ ψ '' V := mem_image_of_mem ψ (hgV (hball hx))
    rw [himg] at h
    exact h.2
  · -- Step 7: `π` fixes `N ∩ B_r(y)`, so `Dπ(x)v = v` for `v ∈ T_xN`
    exact Submission.dor_lmb_ret_fderiv_tangent_eq P N (ball (ψ v₀) r) (ψ ∘ g) x isOpen_ball hx.2
      ((hπ.contDiffAt (isOpen_ball.mem_nhds (hball hx.2))).differentiableAt one_ne_zero)
      (fun z hz => hfix z ⟨hz.1, hball hz.2⟩) v hv
  · -- Step 8: differentiate `P̂(g z)(z − π(z)) = 0`; here `|x − π(x)| ≤ |x − y| < r`
    have hx' := hball hx
    have hgx : g x ∈ closedBall v₀ δ := ball_subset_closedBall (hgδ hx')
    have hxπ : ‖x - ψ (g x)‖ ≤ dist x (ψ v₀) := by
      rw [dist_eq_norm]
      exact hnear x hx' (ψ v₀) hy.1
    have hsmall : a * b * ‖x - ψ (g x)‖ ≤ 1 / 2 := by
      have h2ab : 0 < 2 * (a * b) + 1 := by linarith
      calc a * b * ‖x - ψ (g x)‖ ≤ a * b * (1 / (2 * (a * b) + 1)) :=
            mul_le_mul_of_nonneg_left (hxπ.trans ((mem_ball.mp hx).le.trans hrab)) hab
        _ ≤ 1 / 2 := by
          rw [mul_one_div, div_le_iff₀ h2ab]
          linarith
    have hcomp : ((fderiv ℝ ψ (g x)).range.starProjection).comp (fderiv ℝ ψ (g x)) =
        fderiv ℝ ψ (g x) := by
      refine ContinuousLinearMap.ext fun w => ?_
      rw [ContinuousLinearMap.comp_apply]
      exact Submodule.starProjection_eq_self_iff.mpr (LinearMap.mem_range_self _ w)
    have hest := Submission.dor_lmb_ret_derivative_estimate P d (ball (ψ v₀) r') g ψ
      (fun v => (fderiv ℝ ψ v).range.starProjection) x a b isOpen_ball hx'
      ((hg.contDiffAt (isOpen_ball.mem_nhds hx')).differentiableAt one_ne_zero)
      ((hψ2.contDiffAt (hV.mem_nhds (hδV hgx))).differentiableAt two_ne_zero)
      ((hQ.contDiffAt (hV.mem_nhds (hδV hgx))).differentiableAt one_ne_zero) hnormal hcomp
      (Submodule.starProjection_norm_le _) ha hb (hDQ _ hgx) (hDψ _ hgx) hsmall
    linarith [mul_le_mul_of_nonneg_left hxπ (mul_nonneg zero_le_two hab)]

/-- **Cut-off at a good level** (Simon 7.2.4, displays (3)–(7) and (10), chapter-07.txt lines
187–246, with the Lipschitz slicing function `f = |· − y|` of Simon Ch. 6, 4.5): let
`T − T' = ∂R + S` in `U` with `T, T', S, R` integer multiplicity, and `B̄_{ρ'}(y) ⊆ U`.  Then for
some `t ∈ (ρ, ρ')` there are an integer multiplicity cycle `X` (constructed as `∂(R⌞B_t(y))`)
vanishing on forms supported off `B̄_t(y)`, and a triple `RY` representing `Y = T' + X`, with
`μ_{RY}(B̄_t(y)) ≤ M_{B_{ρ'}(y)}(T) + M_{B_{ρ'}(y)}(S) + (2/(ρ' − ρ)) M_{B_{ρ'}(y)}(R)`.

Slice `R` by `|· − y|` and choose `t` so that the slice `P_t` is good, `μ_{T'}(∂B_t(y)) = 0` and
`M_{B_{ρ'}(y)}(P_t) ≤ 2 M_{B_{ρ'}(y)}(R)/(ρ' − ρ)`; put `X := (∂R)⌞B_t(y) + P_t`.  On `B_t(y)`,
`Y = T' + ∂R = T − S`; on `∂B_t(y)`, `μ_{RY} ≤ μ_{T'} + μ_{(∂R)⌞B_t(y)} + μ_{P_t}` and only the
last term charges the sphere. -/
theorem Submission.dor_lmb_good_level_cut : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T T' S : GeometricCurrentOn U n) (R : GeometricCurrentOn U (n + 1)) (y : Euclid P) (ρ ρ' : ℝ), IsOpen U → 0 < n → IsIntegerMultiplicity T → IsIntegerMultiplicity T' → IsIntegerMultiplicity S → IsIntegerMultiplicity R → (∀ ω : TestFormOn U n, T ω - T' ω = R.boundary ω + S ω) → 0 < ρ → ρ < ρ' → closedBall y ρ' ⊆ U → ∃ (t : ℝ) (X Y : GeometricCurrentOn U n) (RY : IMRep U n), ρ < t ∧ t < ρ' ∧ IsIntegerMultiplicity X ∧ BoundaryVanishes X ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (closedBall y t) → X ω = 0) ∧ (∀ ω : TestFormOn U n, Y ω = T' ω + X ω) ∧ RY.Represents Y ∧ RY.measure (closedBall y t) ≤ T.massOn (ball y ρ') + S.massOn (ball y ρ') + ENNReal.ofReal (2 / (ρ' - ρ)) * R.massOn (ball y ρ') := by
  intro hC1 P n U T T' S R y ρ ρ' hU _hn hTim hT'im hSim hRim hrel _hρ hρρ' hball
  -- Step 1(a): representations of `T`, `T'`, `S` and `R`
  obtain ⟨RT, hRT⟩ := hTim
  obtain ⟨RT', hRT'⟩ := hT'im
  obtain ⟨RS, hRS⟩ := hSim
  obtain ⟨RR, hRR⟩ := hRim
  -- Step 1(b): a representation of `T − T'`, then one of `∂R = (T − T') − S`
  have hsub : ∀ ω : TestFormOn U n, (T - T') ω = T ω - T' ω := fun ω => rfl
  obtain ⟨RD, hRD, -⟩ := Submission.dor_lmb_int_combination_imrep P n U T T' (T - T') RT RT'
    1 (-1) hU hRT hRT' fun ω => by
      rw [hsub ω]
      push_cast
      ring
  obtain ⟨RB, hRB, -⟩ := Submission.dor_lmb_int_combination_imrep P n U (T - T') S R.boundary
    RD RS 1 (-1) hU hRD hRS fun ω => by
      rw [hsub ω]
      push_cast
      linarith [hrel ω]
  -- Step 2: slice `R` by the 1-Lipschitz function `|· − y|`; `{|· − y| < t} = B_t(y)`
  obtain ⟨Ps, hPmass, hPae⟩ := Submission.dor_lmb_slicing_lipschitz hC1 P n U R RR RB
    (fun x => dist x y) 1 hU hRR hRB (LipschitzWith.dist_left y)
  -- Step 3: `μ_{T'}(B̄_{ρ'}(y)) < ∞`, as `B̄_{ρ'}(y)` is a compact subset of `U`
  have hT'fin : RT'.measure (closedBall y ρ') ≠ ∞ := by
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact RT'.locallyIntegrable_mult _ (isCompact_closedBall y ρ') hball
  -- Step 4: a level `t ∈ (ρ, ρ')` where the slice is good, `μ_{T'}(∂B_t(y)) = 0`, and
  -- `M_{B_{ρ'}(y)}(P_t) ≤ (2/(ρ' − ρ)) M_{B_{ρ'}(y)}(R)`
  have hPint : ∫⁻ s, (Ps s).massOn (ball y ρ') ≤ R.massOn (ball y ρ') := by
    simpa only [ENNReal.coe_one, one_mul] using (hPmass _ isOpen_ball).2
  obtain ⟨t, hρt, htρ', ⟨⟨RP, hRP⟩, -, hPt⟩, hsph, hPtmass⟩ :=
    Submission.dor_lmb_glc_good_radius P RT'.measure y ρ ρ' (fun s => (Ps s).massOn (ball y ρ'))
      (R.massOn (ball y ρ')) _ hρρ' hT'fin (hPmass _ isOpen_ball).1 hPint hPae
  -- Step 5: `D = (∂R)⌞B_t(y)`, represented by `RBt = (M_B ∩ B_t(y), θ_B, ξ_B)`
  obtain ⟨D, RBt, hRBt, hcar, hmult, hor, hmeas⟩ :=
    Submission.dor_lmb_imrep_restrict_current P n U (ball y t) RB hU measurableSet_ball
  have hD : ∀ ω : TestFormOn U n, D ω = ∫ x in RB.carrier ∩ ball y t,
      (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] := by
    intro ω
    rw [hRBt ω, IMRep.action, hcar, hmult, hor]
  -- Step 6: the cut cycle `X = D + P_t`
  obtain ⟨X, hXDP, hXbd, hXoff, hXin⟩ :=
    Submission.dor_lmb_glc_cut_cycle P n U R RR RB D (Ps t) y t hRR hD hPt
  -- Step 6(c): `X` is integer multiplicity, with `μ_{RX} ≤ μ_{RB}⌞B_t(y) + μ_{RP}`
  obtain ⟨RX, hRX, hRXle⟩ := Submission.dor_lmb_int_combination_imrep P n U D (Ps t) X RBt RP
    1 1 hU hRBt hRP fun ω => by
      rw [hXDP ω]
      push_cast
      ring
  -- Step 7: `Y = T' + X`, with `μ_{RY} ≤ μ_{T'} + μ_{RX}`
  let Y : GeometricCurrentOn U n :=
    { toCurrent := T'.toCurrent + X.toCurrent
      continuous' := fun ωs h => by
        simpa using (T'.continuous' ωs h).add (X.continuous' ωs h) }
  have hY : ∀ ω : TestFormOn U n, Y ω = T' ω + X ω := fun ω => rfl
  obtain ⟨RY, hRY, hRYle⟩ := Submission.dor_lmb_int_combination_imrep P n U T' X Y RT' RX
    1 1 hU hRT' hRX fun ω => by
      rw [hY ω]
      push_cast
      ring
  -- Step 8: on `B_t(y)`, `Y = T' + ∂R = T − S`, so `μ_{RY}(B_t(y)) = M_{B_t(y)}(Y)` is at most
  -- `M_{B_{ρ'}(y)}(T) + M_{B_{ρ'}(y)}(S)`
  have hYin : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball y t →
      Y ω = T ω - S ω := by
    intro ω hω
    rw [hY ω, hXin ω hω]
    linarith [hrel ω]
  have hBt : RY.measure (ball y t) ≤ T.massOn (ball y ρ') + S.massOn (ball y ρ') := by
    rw [← (hC1 P n U Y RY hU hRY).1 _ isOpen_ball]
    calc Y.massOn (ball y t) ≤ T.massOn (ball y t) + S.massOn (ball y t) :=
          Submission.dor_lmb_glc_massOn_sub_le P n U (ball y t) T S Y hYin
      _ ≤ T.massOn (ball y ρ') + S.massOn (ball y ρ') :=
          add_le_add (T.massOn_mono (ball_subset_ball htρ'.le))
            (S.massOn_mono (ball_subset_ball htρ'.le))
  -- Step 9: on `∂B_t(y)`, only `μ_{RP}` can charge the sphere, and
  -- `μ_{RP}(∂B_t(y)) ≤ μ_{RP}(B_{ρ'}(y)) = M_{B_{ρ'}(y)}(P_t)`
  have hSt : RY.measure (sphere y t) ≤
      ENNReal.ofReal (2 / (ρ' - ρ)) * R.massOn (ball y ρ') := by
    have hY3 : RY.measure (sphere y t) ≤
        RT'.measure (sphere y t) + (RBt.measure (sphere y t) + RP.measure (sphere y t)) := by
      have h1 := Measure.le_iff'.1 hRYle (sphere y t)
      have h2 := Measure.le_iff'.1 hRXle (sphere y t)
      simp only [Int.natAbs_one, Nat.cast_one, one_smul, Measure.coe_add, Pi.add_apply] at h1 h2
      exact h1.trans (add_le_add le_rfl h2)
    have hRBt0 : RBt.measure (sphere y t) = 0 := by
      rw [hmeas, Measure.restrict_apply isClosed_sphere.measurableSet,
        sphere_disjoint_ball.inter_eq, measure_empty]
    calc RY.measure (sphere y t)
        ≤ RT'.measure (sphere y t) + (RBt.measure (sphere y t) + RP.measure (sphere y t)) := hY3
      _ = RP.measure (sphere y t) := by rw [hsph, hRBt0, zero_add, zero_add]
      _ ≤ RP.measure (ball y ρ') :=
          measure_mono (sphere_subset_closedBall.trans (closedBall_subset_ball htρ'))
      _ = (Ps t).massOn (ball y ρ') := ((hC1 P n U (Ps t) RP hU hRP).1 _ isOpen_ball).symm
      _ ≤ ENNReal.ofReal (2 / (ρ' - ρ)) * R.massOn (ball y ρ') := hPtmass
  -- Step 10: `B̄_t(y) = B_t(y) ∪ ∂B_t(y)`
  refine ⟨t, X, Y, RY, hρt, htρ', ⟨RX, hRX⟩, hXbd, hXoff, hY, hRY, ?_⟩
  calc RY.measure (closedBall y t) = RY.measure (ball y t ∪ sphere y t) := by
        rw [ball_union_sphere]
    _ ≤ RY.measure (ball y t) + RY.measure (sphere y t) := measure_union_le _ _
    _ ≤ T.massOn (ball y ρ') + S.massOn (ball y ρ') +
          ENNReal.ofReal (2 / (ρ' - ρ)) * R.massOn (ball y ρ') := add_le_add hBt hSt

/-- **Comparison with the projected competitor** (Simon 7.2.4, proof of (8)–(9),
chapter-07.txt lines 222–246, with the competitor projected into `N` by `π`; README erratum 5,
`Nᵢ = N`).  Assume (C1): `M_W(T) = μ_R(W)` for open `W` and `spt T = U ∩ spt μ_R` whenever `R`
represents `T`.  Put `F = B̄_t(y)`, `G = B_{3ρ}(y)`, `Λ = 1 + 3cρ`; if `t < 0` then `F = ∅`.
1. `π(y) = y`, and the mean value inequality with `‖Dπ‖ ≤ 1 + ct` on `F` gives
   `|π(x) − y| ≤ (1 + ct)t < 3ρ` on `F` (as `4cρ ≤ 1`), so `π(F) ⊆ (U ∩ N) ∩ G`.
2. By (C1), `X = 0` off `F` gives `Hⁿ(M_X \ F) = 0`, and `spt Z ⊆ N` gives `Hⁿ(M_Z \ N) = 0`.
3. `π(x) = x` and `ξ_Z(x)(α ∘ Dπ(x)) = ξ_Z(x)(α)` for `Hⁿ`-a.e. `x ∈ M_Z ∩ G` (`fix_orient`).
4. `Q_π = π_#X` is an integer multiplicity cycle with compact support in `π(F)` (`pf_current`,
   `pf_integer`, `pf_boundary`).
5. `Z' = Z + Q_π` is integer multiplicity (`int_combination`), `∂Z' = ∂Z` and
   `spt(Z' − Z) = spt Q_π`, so minimality of `Z` in `U ∩ N` gives `M_G(Z) ≤ M_G(Z')`.
6. `M_G(Z') ≤ Λⁿ μ_Y(G)` (`competitor_mass`), hence `μ_Z(G) ≤ Λⁿ μ_Y(G)` by (C1).
7. `Y = Z` on the open set `G \ F`, so `μ_Y(G \ F) = μ_Z(G \ F) < ∞`.  Splitting
   `G = F ∪ (G \ F)` and cancelling `μ_Z(G \ F)` gives
   `μ_Z(F) ≤ Λⁿ μ_Y(F) + (Λⁿ − 1) μ_Z(G \ F) ≤ Λⁿ μ_Y(F) + (Λⁿ − 1) μ_Z(G)`. -/
theorem Submission.dor_lmb_projected_competitor_comparison : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P d n : ℕ) (U N : Set (Euclid P)) (Z X Y : GeometricCurrentOn U n) (RZ RY : IMRep U n) (proj : Euclid P → Euclid P) (y : Euclid P) (r c ρ t : ℝ), IsOpen U → 0 < n → IsEmbeddedSubmanifold 2 d N → IsMinimizingIn Z (U ∩ N) → Z.support ⊆ N → BoundaryVanishes Z → RZ.Represents Z → IsIntegerMultiplicity X → BoundaryVanishes X → (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (closedBall y t) → X ω = 0) → (∀ ω : TestFormOn U n, Y ω = Z ω + X ω) → RY.Represents Y → y ∈ N → 0 ≤ c → 0 < ρ → 3 * ρ < r → 4 * c * ρ ≤ 1 → t < 2 * ρ → closedBall y (3 * ρ) ⊆ U → ContDiffOn ℝ 1 proj (ball y r) → MapsTo proj (ball y r) N → (∀ x ∈ N ∩ ball y r, proj x = x) → (∀ x ∈ N ∩ ball y r, ∀ v ∈ tangentSpace N x, fderiv ℝ proj x v = v) → (∀ x ∈ ball y r, ‖fderiv ℝ proj x‖ ≤ 1 + c * dist x y) → RZ.measure (closedBall y t) ≤ ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (closedBall y t) + ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) * RZ.measure (ball y (3 * ρ)) := by
  intro hC1 P d n U N Z X Y RZ RY proj y r c ρ t hU hn hN hZmin hZsupp _hZbd hRZ hXim hXbd hXvan
    hY hRY hyN hc hρ hρr hcρ ht hGU hproj hmaps hfix hdfix hnorm
  -- If `t < 0` then `F = B̄_t(y) = ∅`
  rcases lt_or_ge t 0 with ht0 | ht0
  · rw [closedBall_eq_empty.2 ht0, measure_empty]
    exact zero_le
  obtain ⟨RX, hRX⟩ := hXim
  -- `F ⊆ G ⊆ B_r(y)`, `G ⊆ U`, and `G ⊂⊂ U`
  have hFG : closedBall y t ⊆ ball y (3 * ρ) := closedBall_subset_ball (by linarith)
  have hGr : ball y (3 * ρ) ⊆ ball y r := ball_subset_ball hρr.le
  have hFr : closedBall y t ⊆ ball y r := hFG.trans hGr
  have hGU' : ball y (3 * ρ) ⊆ U := ball_subset_closedBall.trans hGU
  have hFU : closedBall y t ⊆ U := hFG.trans hGU'
  have hclG : closure (ball y (3 * ρ)) = closedBall y (3 * ρ) :=
    closure_ball y (by linarith : (0 : ℝ) < 3 * ρ).ne'
  have hGcc : CompactlyContained (ball y (3 * ρ)) U := by
    refine ⟨?_, ?_⟩ <;> rw [hclG]
    · exact isCompact_closedBall y _
    · exact hGU
  -- Step 1: `π(y) = y` and `|π(x) − y| ≤ (1 + ct)t < 3ρ` on `F`, so `π(F) ⊆ (U ∩ N) ∩ G`
  have hdiff : ∀ z ∈ ball y r, DifferentiableAt ℝ proj z := fun z hz =>
    (hproj.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds hz)
  have hprojy : proj y = y := hfix y ⟨hyN, mem_ball_self (by linarith)⟩
  have hπF : ∀ x ∈ closedBall y t, proj x ∈ ball y (3 * ρ) := by
    intro x hx
    have hbound : ∀ z ∈ closedBall y t, ‖fderiv ℝ proj z‖ ≤ 1 + c * t := fun z hz =>
      (hnorm z (hFr hz)).trans
        (by nlinarith [mul_le_mul_of_nonneg_left (mem_closedBall.1 hz) hc])
    have hmvt := (convex_closedBall y t).norm_image_sub_le_of_norm_fderiv_le
      (fun z hz => hdiff z (hFr hz)) hbound (mem_closedBall_self ht0) hx
    have hxy : ‖x - y‖ ≤ t := by
      rw [← dist_eq_norm]
      exact mem_closedBall.1 hx
    rw [mem_ball, dist_eq_norm]
    calc ‖proj x - y‖ = ‖proj x - proj y‖ := by rw [hprojy]
      _ ≤ (1 + c * t) * ‖x - y‖ := hmvt
      _ ≤ (1 + c * t) * t := mul_le_mul_of_nonneg_left hxy (by nlinarith)
      _ < 3 * ρ := by
        nlinarith [mul_nonneg (mul_nonneg hc ht0) (by linarith : (0 : ℝ) ≤ 2 * ρ - t),
          mul_nonneg ht0 (by linarith : (0 : ℝ) ≤ 1 - 4 * c * ρ)]
  have hπFG : proj '' closedBall y t ⊆ ball y (3 * ρ) := by
    rintro _ ⟨x, hx, rfl⟩
    exact hπF x hx
  have hπFU : proj '' closedBall y t ⊆ U := hπFG.trans hGU'
  have hπFN : proj '' closedBall y t ⊆ N := by
    rintro _ ⟨x, hx, rfl⟩
    exact hmaps (hFr hx)
  -- `Hⁿ(M ∩ S) ≤ μ_R(S)` for Borel `S`, since `θ ≥ 1` on `M`
  have hcarrier_le : ∀ (R : IMRep U n) (S : Set (Euclid P)), MeasurableSet S →
      μHE[n] (R.carrier ∩ S) ≤ R.measure S := by
    intro R S hS
    rw [IMRep.measure, withDensity_apply _ hS, Measure.restrict_restrict hS]
    calc μHE[n] (R.carrier ∩ S) = ∫⁻ _ in S ∩ R.carrier, (1 : ℝ≥0∞) ∂μHE[n] := by
          rw [setLIntegral_one, inter_comm]
      _ ≤ ∫⁻ x in S ∩ R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
          setLIntegral_mono' (hS.inter R.measurableSet_carrier) fun x hx =>
            Nat.one_le_cast.2 (R.mult_pos x hx.2)
  -- `μ_R(K) < ∞` for compact `K ⊆ U`
  have hfin : ∀ (R : IMRep U n) (K : Set (Euclid P)), IsCompact K → K ⊆ U → R.measure K ≠ ∞ := by
    intro R K hK hKU
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact R.locallyIntegrable_mult K hK hKU
  -- Step 2(a): by (C1), `μ_X(U \ F) = M_{U \ F}(X) = 0`, so `Hⁿ(M_X \ F) = 0`
  have hXF : μHE[n] (RX.carrier \ closedBall y t) = 0 := by
    have hopen : IsOpen (U \ closedBall y t) := hU.sdiff isClosed_closedBall
    have hmass : X.massOn (U \ closedBall y t) = 0 := by
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (X ω) ≤ 0
      rw [hXvan ω (Disjoint.mono_left hω.1 Set.disjoint_sdiff_left), ENNReal.ofReal_zero]
    have hmeas : RX.measure (U \ closedBall y t) = 0 := by
      rw [← (hC1 P n U X RX hU hRX).1 _ hopen, hmass]
    have hsub : RX.carrier \ closedBall y t ⊆ RX.carrier ∩ (U \ closedBall y t) :=
      fun x hx => ⟨hx.1, RX.carrier_subset hx.1, hx.2⟩
    refine measure_mono_null hsub (le_antisymm ?_ zero_le)
    exact (hcarrier_le RX _ hopen.measurableSet).trans hmeas.le
  -- Step 2(b): by (C1), `U ∩ spt μ_Z = spt Z ⊆ N`, so `Hⁿ(M_Z \ N) = 0`
  have hZN : μHE[n] (RZ.carrier \ N) = 0 := by
    have hsupp := (hC1 P n U Z RZ hU hRZ).2
    have hsub : RZ.carrier \ N ⊆ RZ.carrier ∩ RZ.measure.supportᶜ := by
      intro x hx
      refine ⟨hx.1, fun hxs => hx.2 (hZsupp ?_)⟩
      rw [hsupp]
      exact ⟨RZ.carrier_subset hx.1, hxs⟩
    refine measure_mono_null hsub (le_antisymm ?_ zero_le)
    calc μHE[n] (RZ.carrier ∩ RZ.measure.supportᶜ) ≤ RZ.measure RZ.measure.supportᶜ :=
          hcarrier_le RZ _ Measure.isClosed_support.isOpen_compl.measurableSet
      _ = 0 := Measure.measure_compl_support
  -- Step 3 (`fix_orient`): `π` fixes `Z` on `G`
  have hN1 : IsEmbeddedSubmanifold 1 d N := by
    intro z hz
    obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, himg, hprop, hrank⟩ := hN z hz
    exact ⟨V, W, ψ, hV, hW, hzW, hψ.of_le (by exact_mod_cast (show (1 : ℕ) ≤ 2 by norm_num)),
      hinj, himg, hprop, hrank⟩
  have hfixZ := Submission.dor_lmb_pc_imrep_orient_fixed_by_retraction P n d U N (ball y (3 * ρ))
    RZ proj hN1 isOpen_ball.measurableSet hZN (fun x hx => hfix x ⟨hx.1, hGr hx.2⟩)
    (fun x hx v hv => hdfix x ⟨hx.1, hGr hx.2⟩ v hv)
  -- Step 4 (`pf_current`, `pf_integer`, `pf_boundary`): the projected cycle `Q_π = π_#X`
  obtain ⟨Q, hQ, hQcpt, hQsupp⟩ := Submission.dor_lmb_pc_pushforward_current_exists P n U
    (closedBall y t) (ball y r) RX proj hU (isCompact_closedBall y t) hFU hXF isOpen_ball hFr hproj
    hπFU
  have hQim : IsIntegerMultiplicity Q :=
    Submission.dor_lmb_pc_pushforward_isIntegerMultiplicity
      Submission.dor_lmb_approx_tangent_locality P n U (closedBall y t) (ball y r) RX proj Q hU hn
      (isCompact_closedBall y t) hFU hXF isOpen_ball hFr hproj hπFU hQ
  have hQbd : BoundaryVanishes Q :=
    Submission.dor_lmb_pc_pushforward_boundaryVanishes P n U (closedBall y t) (ball y r) RX proj X Q
      hU (isCompact_closedBall y t) hFU hXF isOpen_ball hFr hproj hRX hXbd hQ
  -- Step 5: the competitor `Z' = Z + Q_π`
  obtain ⟨Z', hZ'⟩ : ∃ Z' : GeometricCurrentOn U n, ∀ ω, Z' ω = Z ω + Q ω :=
    ⟨{ toCurrent := Z.toCurrent + Q.toCurrent
       continuous' := fun ωs h => by
         simpa using (Z.continuous' ωs h).add (Q.continuous' ωs h) }, fun ω => rfl⟩
  -- (a) `Z'` is integer multiplicity (`int_combination` with `p₁ = p₂ = 1`)
  obtain ⟨RQ, hRQ⟩ := hQim
  obtain ⟨RZ', hRZ', -⟩ := Submission.dor_lmb_int_combination_imrep P n U Z Q Z' RZ RQ 1 1 hU hRZ
    hRQ fun ω => by rw [hZ' ω]; push_cast; ring
  -- (b) `∂Z' = ∂Z`, as `∂Q_π = 0`
  have hSB : SameBoundary Z' Z := by
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    have hQ0 : Q.boundary = 0 := hQbd
    show Z'.boundary = Z.boundary
    ext η
    have h0 : Q (exteriorDerivativeTestOn U m η) = 0 := by
      rw [← GeometricCurrentOn.boundary_apply, hQ0, GeometricCurrentOn.zero_apply]
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, hZ', h0, add_zero]
  -- (c) `Z' − Z = Q_π`, with compact support in `π(F) ⊆ (U ∩ N) ∩ G`
  have hZ'Z : Z' - Z = Q := by
    ext ω
    show Z' ω - Z ω = Q ω
    rw [hZ' ω]
    ring
  -- (d) minimality of `Z` in `U ∩ N`, tested on `W = G`
  have hmin : Z.massOn (ball y (3 * ρ)) ≤ Z'.massOn (ball y (3 * ρ)) := by
    refine hZmin.2 (ball y (3 * ρ)) Z' isOpen_ball hGcc ⟨RZ', hRZ'⟩ hSB ?_ ?_
    · rw [hZ'Z]
      exact hQcpt
    · rw [hZ'Z]
      intro z hz
      have hz' := hQsupp hz
      exact ⟨⟨hπFU hz', hπFN hz'⟩, hπFG hz'⟩
  -- Step 6 (`competitor_mass`): `M_G(Z') ≤ Λⁿ μ_Y(G)`, so `μ_Z(G) ≤ Λⁿ μ_Y(G)` by (C1)
  have hmass := Submission.dor_lmb_pc_competitor_massOn_le P n U (ball y (3 * ρ)) (ball y r) RZ RX
    RY Y Z' proj (1 + 3 * c * ρ) hU isOpen_ball hGcc isOpen_ball hGr hproj
    (by nlinarith [mul_nonneg hc hρ.le])
    (fun x hx => (hnorm x (hGr hx)).trans
      (by nlinarith [mul_le_mul_of_nonneg_left (mem_ball.1 hx).le hc]))
    hRY (fun ω => by rw [hY ω, hRZ ω, hRX ω]) hfixZ
    (measure_mono_null (sdiff_subset_sdiff_right hFG) hXF) (fun ω => by rw [hZ' ω, hRZ ω, hQ ω])
  have hmain : RZ.measure (ball y (3 * ρ)) ≤
      ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (ball y (3 * ρ)) := by
    rw [← (hC1 P n U Z RZ hU hRZ).1 (ball y (3 * ρ)) isOpen_ball]
    exact hmin.trans hmass
  -- Step 7: `Y = Z` on forms supported in the open set `G \ F`, so `μ_Y(G \ F) = μ_Z(G \ F)`
  have hGFopen : IsOpen (ball y (3 * ρ) \ closedBall y t) := isOpen_ball.sdiff isClosed_closedBall
  have hYZ : RY.measure (ball y (3 * ρ) \ closedBall y t) =
      RZ.measure (ball y (3 * ρ) \ closedBall y t) := by
    rw [← (hC1 P n U Y RY hU hRY).1 _ hGFopen, ← (hC1 P n U Z RZ hU hRZ).1 _ hGFopen]
    unfold GeometricCurrentOn.massOn
    congr 1
    refine Set.image_congr fun ω hω => ?_
    show ENNReal.ofReal (Y ω) = ENNReal.ofReal (Z ω)
    rw [hY ω, hXvan ω (Disjoint.mono_left hω.1 Set.disjoint_sdiff_left), add_zero]
  -- split `G = F ∪ (G \ F)` and cancel the finite `μ_Z(G \ F)`
  have hFm : MeasurableSet (closedBall y t) := measurableSet_closedBall
  have hZsplit := measure_inter_add_sdiff (μ := RZ.measure) (ball y (3 * ρ)) hFm
  have hYsplit := measure_inter_add_sdiff (μ := RY.measure) (ball y (3 * ρ)) hFm
  rw [inter_eq_right.2 hFG] at hZsplit hYsplit
  have hbfin : RZ.measure (ball y (3 * ρ) \ closedBall y t) ≠ ∞ :=
    ne_top_of_le_ne_top (hfin RZ _ (isCompact_closedBall y (3 * ρ)) hGU)
      (measure_mono (sdiff_subset.trans ball_subset_closedBall))
  have hL : ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) =
      ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) + 1 := by
    have h1 : (1 : ℝ) ≤ (1 + 3 * c * ρ) ^ n := one_le_pow₀ (by nlinarith [mul_nonneg hc hρ.le])
    rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_add (sub_nonneg.2 h1) zero_le_one, sub_add_cancel]
  have hLb : ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RZ.measure (ball y (3 * ρ) \ closedBall y t) =
      ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) * RZ.measure (ball y (3 * ρ) \ closedBall y t) +
        RZ.measure (ball y (3 * ρ) \ closedBall y t) := by
    rw [hL, add_mul, one_mul]
  have key : RZ.measure (closedBall y t) + RZ.measure (ball y (3 * ρ) \ closedBall y t) ≤
      (ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (closedBall y t) +
        ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) * RZ.measure (ball y (3 * ρ) \ closedBall y t)) +
      RZ.measure (ball y (3 * ρ) \ closedBall y t) := by
    calc RZ.measure (closedBall y t) + RZ.measure (ball y (3 * ρ) \ closedBall y t)
        = RZ.measure (ball y (3 * ρ)) := hZsplit
      _ ≤ ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (ball y (3 * ρ)) := hmain
      _ = ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (closedBall y t) +
          ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RZ.measure (ball y (3 * ρ) \ closedBall y t) := by
        rw [← hYsplit, hYZ, mul_add]
      _ = _ := by rw [hLb, add_assoc]
  calc RZ.measure (closedBall y t)
      ≤ ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (closedBall y t) +
        ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) * RZ.measure (ball y (3 * ρ) \ closedBall y t) :=
        ENNReal.le_of_add_le_add_right hbfin key
    _ ≤ _ := by
        gcongr
        exact sdiff_subset
/-- Cut-off lift of a form to the cylinder `C = {z + ιv + ι'w : v ∈ B_s(0), w ∈ B_h(0)}`: with
`L = ι*`, `Q = ι'*(· − z)` and the normal cut-off `η` of `u(spt ψ)` (`dgcr_bwd_normal_cutoff`),
`φ = (η ∘ Q) · P^#ψ` is a test form in `U` supported in `C` that agrees with
`P^#ψ = affinePullbackForm L (−Lz) ψ` near every graph point `z + ιv + ι'u(v)`, `v ∈ B_s(0)`. -/
theorem Submission.dgcr_bwd_graph_cutoff_lift : ∀ (m k : ℕ) (U : Set (Euclid (m + 1 + k))) (ι : Euclid (m + 1) →ₗᵢ[ℝ] Euclid (m + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (m + 1 + k)) (u : Euclid (m + 1) → Euclid k) (z : Euclid (m + 1 + k)) (s h : ℝ) (ψ : DifferentialForm (Euclid (m + 1)) m), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ x : Euclid (m + 1 + k), ∃ v : Euclid (m + 1), ∃ w : Euclid k, x = ι v + ι' w) → 0 < h → ContinuousOn u (ball 0 s) → (∀ v ∈ ball (0 : Euclid (m + 1)) s, u v ∈ ball (0 : Euclid k) h) → {x | ∃ v ∈ ball (0 : Euclid (m + 1)) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → IsSmoothForm ψ → HasCompactSupport ψ → tsupport ψ ⊆ ball (0 : Euclid (m + 1)) s → ∃ φ : TestFormOn U m, tsupport (φ : DifferentialForm (Euclid (m + 1 + k)) m) ⊆ {x | ∃ v ∈ ball (0 : Euclid (m + 1)) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ∧ ∀ v ∈ ball (0 : Euclid (m + 1)) s, (φ : DifferentialForm (Euclid (m + 1 + k)) m) =ᶠ[𝓝 (z + ι v + ι' (u v))] affinePullbackForm (ContinuousLinearMap.adjoint ι.toContinuousLinearMap) (-(ContinuousLinearMap.adjoint ι.toContinuousLinearMap z)) ψ := by
  intro m k U ι ι' u z s h ψ hperp hspan hh hu hmaps hCU hψs hψc hψsupp
  set L := ContinuousLinearMap.adjoint ι.toContinuousLinearMap with hL
  set L' := ContinuousLinearMap.adjoint ι'.toContinuousLinearMap with hL'
  -- Adjoint identities: `Lι = id`, `Lι' = 0`, `L'ι = 0`, `L'ι' = id`.
  have hLι : ∀ v', L (ι v') = v' := by
    intro v'
    apply ext_inner_right ℝ
    intro y
    rw [hL, ContinuousLinearMap.adjoint_inner_left]
    exact ι.inner_map_map v' y
  have hLι' : ∀ w, L (ι' w) = 0 := by
    intro w
    apply ext_inner_right ℝ
    intro y
    rw [hL, ContinuousLinearMap.adjoint_inner_left, inner_zero_left, real_inner_comm]
    exact hperp y w
  have hL'ι : ∀ v', L' (ι v') = 0 := by
    intro v'
    apply ext_inner_right ℝ
    intro y
    rw [hL', ContinuousLinearMap.adjoint_inner_left, inner_zero_left]
    exact hperp v' y
  have hL'ι' : ∀ w, L' (ι' w) = w := by
    intro w
    apply ext_inner_right ℝ
    intro y
    rw [hL', ContinuousLinearMap.adjoint_inner_left]
    exact ι'.inner_map_map w y
  -- Orthogonal decomposition `x = z + ι(L(x − z)) + ι'(L'(x − z))`.
  have hdec : ∀ x, z + ι (L (x - z)) + ι' (L' (x - z)) = x := by
    intro x
    obtain ⟨v₀, w₀, hx⟩ := hspan (x - z)
    have h1 : L (x - z) = v₀ := by rw [hx, map_add, hLι, hLι', add_zero]
    have h2 : L' (x - z) = w₀ := by rw [hx, map_add, hL'ι, hL'ι', zero_add]
    rw [h1, h2]
    calc z + ι v₀ + ι' w₀ = z + (ι v₀ + ι' w₀) := add_assoc _ _ _
      _ = z + (x - z) := by rw [hx]
      _ = x := add_sub_cancel z x
  -- Normal cut-off `η ≡ 1` near the compact set `u(spt ψ) ⊆ B_h(0)`.
  have hK : IsCompact (tsupport ψ) := hψc
  obtain ⟨η, hηs, hηc, hηsupp, hη1⟩ := Submission.dgcr_bwd_normal_cutoff k (u '' tsupport ψ) h hh
    (hK.image_of_continuousOn (hu.mono hψsupp))
    (by rintro _ ⟨v, hv, rfl⟩; exact hmaps v (hψsupp hv))
  have hPr : Continuous (fun x : Euclid (m + 1 + k) => L (x - z)) :=
    L.continuous.comp (continuous_id.sub continuous_const)
  have hQ : Continuous (fun x : Euclid (m + 1 + k) => L' (x - z)) :=
    L'.continuous.comp (continuous_id.sub continuous_const)
  have hPapply : ∀ x, affinePullbackForm L (-(L z)) ψ x = (ψ (L (x - z))).compContinuousLinearMap L := by
    intro x
    simp only [affinePullbackForm, map_sub, neg_add_eq_sub]
  -- The test form `φ = (η ∘ Q) · P^#ψ`.
  let φ : DifferentialForm (Euclid (m + 1 + k)) m :=
    fun x => η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x
  have hφs : IsSmoothForm φ := by
    have hηQ : ContDiff ℝ (⊤ : ℕ∞) (fun x : Euclid (m + 1 + k) => η (L' (x - z))) :=
      hηs.comp (L'.contDiff.comp (contDiff_id.sub contDiff_const))
    exact hηQ.smul (affinePullbackForm_isSmoothForm L (-(L z)) hψs)
  -- Support: `spt φ ⊆ F(spt ψ × spt η) ⊆ C`, where `F(v, w) = z + ιv + ι'w`.
  let F : Euclid (m + 1) × Euclid k → Euclid (m + 1 + k) := fun p => z + ι p.1 + ι' p.2
  have hF : Continuous F := by
    have h1 : Continuous (fun p : Euclid (m + 1) × Euclid k => ι p.1) := ι.continuous.comp continuous_fst
    have h2 : Continuous (fun p : Euclid (m + 1) × Euclid k => ι' p.2) := ι'.continuous.comp continuous_snd
    exact (continuous_const.add h1).add h2
  have hS : IsClosed {x : Euclid (m + 1 + k) | L (x - z) ∈ tsupport ψ ∧ L' (x - z) ∈ tsupport η} :=
    ((isClosed_tsupport ψ).preimage hPr).inter ((isClosed_tsupport η).preimage hQ)
  have hsuppS : support φ ⊆ {x | L (x - z) ∈ tsupport ψ ∧ L' (x - z) ∈ tsupport η} := by
    intro x hx
    by_contra hcon
    apply hx
    rcases not_and_or.mp hcon with h1 | h1
    · have h0 : ψ (L (x - z)) = 0 := image_eq_zero_of_notMem_tsupport h1
      have hP0 : affinePullbackForm L (-(L z)) ψ x = 0 := by
        rw [hPapply, h0]
        ext w
        simp
      show η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x = 0
      rw [hP0, smul_zero]
    · have h0 : η (L' (x - z)) = 0 := image_eq_zero_of_notMem_tsupport h1
      show η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x = 0
      rw [h0, zero_smul]
  have hsupp : tsupport φ ⊆ F '' (tsupport ψ ×ˢ tsupport η) := by
    refine (closure_minimal hsuppS hS).trans ?_
    rintro x ⟨hx1, hx2⟩
    exact ⟨(L (x - z), L' (x - z)), ⟨hx1, hx2⟩, hdec x⟩
  have hFC : F '' (tsupport ψ ×ˢ tsupport η) ⊆
      {x | ∃ v ∈ ball (0 : Euclid (m + 1)) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
    rintro _ ⟨⟨v, w⟩, ⟨hv, hw⟩, rfl⟩
    exact ⟨v, hψsupp hv, w, hηsupp hw, rfl⟩
  have hcomp : IsCompact (F '' (tsupport ψ ×ˢ tsupport η)) := (hK.prod hηc).image hF
  refine ⟨⟨φ, ⟨hφs, hcomp.of_isClosed_subset (isClosed_tsupport _) hsupp⟩,
    (hsupp.trans hFC).trans hCU⟩, hsupp.trans hFC, ?_⟩
  -- Germ at a graph point: `η ∘ Q ≡ 1` there if `v ∈ spt ψ`, else `P^#ψ ≡ 0` there.
  intro v hv
  have hQv : L' (z + ι v + ι' (u v) - z) = u v := by
    rw [add_assoc z, add_sub_cancel_left, map_add, hL'ι, hL'ι', zero_add]
  have hPv : L (z + ι v + ι' (u v) - z) = v := by
    rw [add_assoc z, add_sub_cancel_left, map_add, hLι, hLι', add_zero]
  by_cases hvK : v ∈ tsupport ψ
  · have hev : ∀ᶠ y in 𝓝 (u v), η y = 1 := hη1 (u v) ⟨v, hvK, rfl⟩
    have hT := hQ.tendsto (z + ι v + ι' (u v))
    rw [hQv] at hT
    filter_upwards [hT.eventually hev] with x hx
    show η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x = affinePullbackForm L (-(L z)) ψ x
    rw [hx, one_smul]
  · have hopen : IsOpen {x : Euclid (m + 1 + k) | L (x - z) ∉ tsupport ψ} :=
      (isClosed_tsupport ψ).isOpen_compl.preimage hPr
    filter_upwards [hopen.mem_nhds (show L (z + ι v + ι' (u v) - z) ∉ tsupport ψ by rw [hPv]; exact hvK)] with x hx
    have h0 : ψ (L (x - z)) = 0 := image_eq_zero_of_notMem_tsupport hx
    have hP0 : affinePullbackForm L (-(L z)) ψ x = 0 := by
      rw [hPapply, h0]
      ext w
      simp
    show η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x = affinePullbackForm L (-(L z)) ψ x
    rw [hP0, smul_zero]

/-- Step 13 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem): if `∂T = 0` and `T` integrates forms supported in the cylinder
`C` over the graph `Φ(v) = z + ι v + ι' (u v)`, `v ∈ D = B_s(0)`, with density `G`, then `G` has
vanishing weak derivatives: `∫_D G ∂ⱼa = 0` for smooth `a` with compact support in `D`.  Write
`n = m + 1`.  The `m`-form `ψ = a • βⱼ` on `ℝⁿ` has `dψ(e₀, …, e_m) = ∂ⱼa`, and its cut-off lift
`φ ∈ 𝒟ᵐ(U)` is supported in `C` and equals `Pr^#ψ` near every graph point, so
`dφ(Φ(v))(DΦ(v)e) = dψ(v)(e) = ∂ⱼa(v)` on `D`.  Hence `0 = ∂T(φ) = T(dφ) = ∫_D G ∂ⱼa`. -/
theorem Submission.dgcr_graph_boundary_weak_derivatives : ∀ (n k : ℕ) (U : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s h : ℝ) (G : Euclid n → ℝ), 0 < n → BoundaryVanishes T → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → 0 < h → ContDiffOn ℝ 1 u (ball 0 s) → (∀ v ∈ ball (0 : Euclid n) s, u v ∈ ball (0 : Euclid k) h) → {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = ∫ v in ball (0 : Euclid n) s, G v * (ω : DifferentialForm (Euclid (n + k)) n) (z + ι v + ι' (u v)) (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ)))) → ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ ball (0 : Euclid n) s → ∀ j : Fin n, ∫ v in ball (0 : Euclid n) s, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0 := by
  intro n k U T ι ι' u z s h G hn hT hperp hs hh hu hmaps hCU hrep a ha hac has j
  -- `n = m + 1`, so `∂T = 0` reads `T.boundary = 0`
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hn.ne'
  -- the `m`-form `ψ = a • βⱼ` on `ℝⁿ`: `spt ψ ⊆ spt a` and `dψ(x)(e₀, …, e_m) = ∂ⱼa(x)`
  obtain ⟨ψ, hψs, hψa, hψd⟩ := Submission.dgcr_bwd_coordinate_form m a j ha
  -- the test form `φ = (η ∘ Q) • Pr^#ψ ∈ 𝒟ᵐ(U)`: `spt φ ⊆ C` and `φ = Pr^#ψ` near each `Φ(v)`
  obtain ⟨φ, hφC, hφψ⟩ := Submission.dgcr_bwd_graph_cutoff_lift m k U ι ι' u z s h ψ hperp
    (Submission.dgcr_orthogonal_coordinates (m + 1) k ι ι' hperp).1 hh hu.continuousOn hmaps hCU
    hψs (hac.mono' ((subset_tsupport ψ).trans hψa)) (hψa.trans has)
  -- `T(dφ) = ∂T(φ) = 0`
  have hT0 : T (exteriorDerivativeTestOn U m φ) = 0 := by
    have hT' : T.boundary = 0 := hT
    rw [← GeometricCurrentOn.boundary_apply, hT', GeometricCurrentOn.zero_apply]
  -- `spt dφ ⊆ spt φ ⊆ C`, so `T(dφ)` is the graph integral of `dφ`
  rw [hrep _ ((tsupport_exteriorDerivative_subset
    (φ : DifferentialForm (Euclid (m + 1 + k)) m)).trans hφC)] at hT0
  refine Eq.trans ?_ hT0
  refine setIntegral_congr_fun measurableSet_ball fun v hv => ?_
  -- on `D`: `dφ(Φ(v))(DΦ(v)e) = d(Pr^#ψ)(Φ(v))(DΦ(v)e) = dψ(v)(e) = ∂ⱼa(v)`
  have hud : DifferentiableAt ℝ u v :=
    (hu.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds hv)
  have hdφ : exteriorDerivative (φ : DifferentialForm (Euclid (m + 1 + k)) m) (z + ι v + ι' (u v)) =
      exteriorDerivative (affinePullbackForm (ContinuousLinearMap.adjoint ι.toContinuousLinearMap)
        (-(ContinuousLinearMap.adjoint ι.toContinuousLinearMap z)) ψ) (z + ι v + ι' (u v)) :=
    (hφψ v hv).extDeriv_eq
  change G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) =
    G v * exteriorDerivative (φ : DifferentialForm (Euclid (m + 1 + k)) m) (z + ι v + ι' (u v))
      (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ)))
  rw [hdφ, Submission.dgcr_bwd_graph_pullback_extDeriv m k ι ι' u z ψ v hperp hψs hud, hψd v]
/-- **Mollification approximates a `C¹_c` function in a directional derivative** (step 3 of the
extension from smooth to `C¹` tests in the graph-cycle regularity step of Simon 7.4.3).  For
`φ ∈ C¹_c(ℝⁿ)`, `δ > 0`, a direction `v` and `ε > 0` there is `ψ ∈ C^∞_c(ℝⁿ)` with `spt ψ` in the
closed `δ`-neighbourhood of `spt φ` and `|Dψ(x)v − Dφ(x)v| ≤ ε` for all `x`.  Take `r₀ > 0` with
`|∂ᵥφ(a) − ∂ᵥφ(b)| < ε` when `|a − b| < r₀` (`∂ᵥφ` is continuous with compact support), a
normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`, and `ψ = ρ ⋆ φ`; then
`∂ᵥψ = ρ ⋆ ∂ᵥφ`, which is within `ε` of `∂ᵥφ`. -/
theorem Submission.dgcr_stc_mollify_C1_fderiv_approx : ∀ (n : ℕ) (φ : Euclid n → ℝ), ContDiff ℝ 1 φ → HasCompactSupport φ → ∀ (δ : ℝ), 0 < δ → ∀ (v : Euclid n) (ε : ℝ), 0 < ε → ∃ ψ : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ ∧ HasCompactSupport ψ ∧ tsupport ψ ⊆ cthickening δ (tsupport φ) ∧ ∀ x, |fderiv ℝ ψ x v - fderiv ℝ φ x v| ≤ ε := by
  intro n φ hφ hφc δ hδ v ε hε
  -- `∂ᵥφ = Dφ(·) v` is continuous with compact support, hence uniformly continuous: it varies by
  -- less than `ε` on balls of radius `r₀`
  have hDφ : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  have hDφc : HasCompactSupport (fderiv ℝ φ) := hφc.fderiv ℝ
  have hg : Continuous fun x => fderiv ℝ φ x v := hDφ.clm_apply continuous_const
  have hgc : HasCompactSupport fun x => fderiv ℝ φ x v :=
    hDφc.comp_left (g := fun A : Euclid n →L[ℝ] ℝ => A v) rfl
  obtain ⟨r₀, hr₀, hr₀g⟩ :=
    Metric.uniformContinuous_iff.mp (hgc.uniformContinuous_of_continuous hg) ε hε
  -- a normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`; `ψ = ρ ⋆ φ`
  obtain ⟨ρ, hρ, hρc, hρ0, hρ1, hρs⟩ :=
    Submission.dgcr_stc_exists_normalized_mollifier n (min r₀ δ) (lt_min hr₀ hδ)
  have hρi : LocallyIntegrable ρ volume := hρ.continuous.locallyIntegrable
  let L := ContinuousLinearMap.lsmul ℝ ℝ (E := ℝ)
  -- `spt ψ ⊆ spt ρ + spt φ ⊆ B_r(0) + spt φ`, inside the closed set `cthickening δ (spt φ)`
  have hsupp : tsupport (convolution ρ φ L volume) ⊆ cthickening δ (tsupport φ) := by
    refine closure_minimal (fun z hz => ?_) isClosed_cthickening
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_add.mp (support_convolution_subset L hz)
    refine mem_cthickening_of_dist_le _ b δ _ (subset_tsupport φ hb) ?_
    rw [dist_eq_norm, add_sub_cancel_right]
    exact (mem_ball_zero_iff.mp (hρs ha)).le.trans (min_le_right r₀ δ)
  -- `ψ` is smooth, and compactly supported as `cthickening δ (spt φ)` is compact
  refine ⟨convolution ρ φ L volume,
    hρc.contDiff_convolution_left L hρ hφ.continuous.locallyIntegrable,
    (IsCompact.cthickening hφc).of_isClosed_subset (isClosed_tsupport _) hsupp, hsupp, fun x => ?_⟩
  -- `Dψ(x) v = (ρ ⋆ ∂ᵥφ)(x)`
  rw [(hφc.hasFDerivAt_convolution_right L hρi hφ x).fderiv,
    convolution_precompR_apply L hρi hDφc hDφ x v, ← Real.dist_eq]
  -- `ρ ≥ 0`, `∫ ρ = 1`, `spt ρ ⊆ B_r(0)` and `|∂ᵥφ(y) − ∂ᵥφ(x)| < ε` on `B_r(x)`
  exact dist_convolution_le hε.le hρs hρ0 hρ1 hg.aestronglyMeasurable fun y hy =>
    (hr₀g ((mem_ball.mp hy).trans_le (min_le_left r₀ δ))).le

/-- Step 14 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem): weak derivatives tested against `C^∞` functions may be
tested against `C¹` functions.  If `∫_D G ∂ⱼa = 0` for every `a ∈ C_c^∞(D)`, then `∫ G ∂ᵢφ = 0`
for every `φ ∈ C_c¹(D)`.  On the compact set `K = cthickening δ (spt φ) ⊆ D`, `G` is integrable
and `∂ᵢφ` is bounded.  The mollified tests `ψ` satisfy `spt ψ ⊆ K` and `|∂ᵢψ − ∂ᵢφ| ≤ ε`, so
`∫_K G ∂ᵢφ = 0` in the limit; every integrand vanishes off `K`. -/
theorem Submission.dgcr_smooth_tests_to_C1_tests : ∀ (n : ℕ) (D : Set (Euclid n)) (G : Euclid n → ℝ), IsOpen D → LocallyIntegrableOn G D volume → (∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ D → ∀ j : Fin n, ∫ v in D, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0) → ∀ φ : Euclid n → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∀ i : Fin n, ∫ x, G x * fderiv ℝ φ x ((EuclideanSpace.basisFun (Fin n) ℝ) i) = 0 := by
  intro n D G hD hG htest φ hφ hφc hφD i
  rw [EuclideanSpace.basisFun_apply]
  -- step 1: `K = cthickening δ (tsupport φ) ⊆ D` is compact and `G` is integrable on `K`
  obtain ⟨δ, hδ, hKD⟩ := hφc.isCompact.exists_cthickening_subset_open hD hφD
  have hK : IsCompact (cthickening δ (tsupport φ)) := hφc.isCompact.cthickening
  have hGK : IntegrableOn G (cthickening δ (tsupport φ)) volume :=
    hG.integrableOn_compact_subset hKD hK
  -- `G ∂ᵢu` vanishes off `K` when `tsupport u ⊆ K`
  have hvan : ∀ u : Euclid n → ℝ, tsupport u ⊆ cthickening δ (tsupport φ) →
      ∀ x ∉ cthickening δ (tsupport φ), G x * fderiv ℝ u x (EuclideanSpace.single i 1) = 0 :=
    fun u hu x hx => by rw [fderiv_of_notMem_tsupport ℝ fun h => hx (hu h), zero_apply, mul_zero]
  -- step 2: `∂ᵢφ` is continuous, hence bounded on `K`
  have hf : Continuous fun x => fderiv ℝ φ x (EuclideanSpace.single i 1) :=
    (hφ.continuous_fderiv one_ne_zero).clm_apply continuous_const
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hf.continuousOn
  -- step 3: the integral over `ℝⁿ` is the integral over `K`
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (hvan φ (self_subset_cthickening _))]
  -- step 4: smooth tests `ψ` with `tsupport ψ ⊆ K` approximate `∂ᵢφ` uniformly on `K`
  refine Submission.dgcr_stc_setIntegral_mul_eq_zero_of_uniform_approx n
    (cthickening δ (tsupport φ)) G (fun x => fderiv ℝ φ x (EuclideanSpace.single i 1)) C
    isClosed_cthickening.measurableSet hGK hf.aestronglyMeasurable
    (fun x hx => (Real.norm_eq_abs _).symm.trans_le (hC x hx)) fun ε hε => ?_
  obtain ⟨ψ, hψ, hψc, hψK, hψε⟩ := Submission.dgcr_stc_mollify_C1_fderiv_approx n φ hφ hφc δ hδ
    (EuclideanSpace.single i 1) ε hε
  refine ⟨fun x => fderiv ℝ ψ x (EuclideanSpace.single i 1),
    ((hψ.continuous_fderiv (by simp)).clm_apply continuous_const).aestronglyMeasurable,
    fun x _ => (abs_sub_comm _ _).trans_le (hψε x), ?_⟩
  -- `∫_K G ∂ᵢψ = ∫ G ∂ᵢψ = ∫_D G ∂ᵢψ`, which vanishes as `ψ` is a smooth test in `D`
  have hvanD : ∀ x ∉ D, G x * fderiv ℝ ψ x (EuclideanSpace.single i 1) = 0 :=
    fun x hx => hvan ψ hψK x fun h => hx (hKD h)
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero (hvan ψ hψK),
    ← setIntegral_eq_integral_of_forall_compl_eq_zero hvanD]
  exact htest ψ hψ hψc (hψK.trans hKD) i

/-- **An integer multiplicity cycle carried by a `C¹` graph is regular** (Simon 7.4.3, p. 194,
"Hence by Allard's Theorem 5.2 of Ch. 5 we have `y ∈ reg T`", with the Constancy Theorem 6.2.34).
Let `T = τ(M, θ, ξ) ∈ 𝒟ₙ(U)` with `∂T = 0`, `ι`, `ι'` linear isometries with orthogonal ranges,
`Φ(v) = z + ιv + ι'u(v)` for a `C¹` map `u` on `B_s(0)` with `u(0) = 0`, and
`C = {z + ιv + ι'w : |v| < s, |w| < h} ⊆ U`.  If `spt μ_T ∩ C = Σ := Φ(B_s(0))` and `z ∈ spt T`,
then `z ∈ reg T`.  `Σ` is an embedded `C¹` submanifold through `z = Φ(0)` with a continuous unit
orientation `ξ_Σ`, and `T(ω) = ∫_Σ g ⟨ω, ξ_Σ⟩ dHⁿ` for `spt ω ⊆ C`, with `G = g ∘ Φ` locally
integrable and integer-valued on `B_s(0)`.  By the area formula and
`α(DΦe₁, …, DΦeₙ) = JΦ ⟨α, ξ_Σ⟩`, `T(ω) = ∫_{B_s(0)} G ω(Φ)(DΦe₁, …, DΦeₙ) dv`; `∂T = 0` kills
the weak derivatives of `G`, so `G = m ∈ ℤ` a.e. on the connected ball and `T = m[[Σ]]` in `C`.
`m ≠ 0` as `z ∈ spt T`, and `ρ = min(s, h)/2` gives `B̄_ρ(z) ⊆ C`. -/
theorem Submission.dor_graph_supported_cycle_regular : ∀ (n k : ℕ) (U : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (R : IMRep U n) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s h : ℝ), 0 < n → IsOpen U → R.Represents T → BoundaryVanishes T → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → 0 < h → ContDiffOn ℝ 1 u (ball 0 s) → u 0 = 0 → {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} = (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s → z ∈ T.support → z ∈ regularSet T := by
  intro n k U T R ι ι' u z s h hn _hU hRT hbd horth hs hh hu hu0 hCU hspt hzT
  -- step 1: orthogonal coordinates `x − z = ιv + ι'w` with `‖x − z‖² = ‖v‖² + ‖w‖²`
  obtain ⟨hdec, hpyth⟩ := Submission.dgcr_orthogonal_coordinates n k ι ι' horth
  have hle : ∀ (v : Euclid n) (w : Euclid k), ‖v‖ ≤ ‖ι v + ι' w‖ ∧ ‖w‖ ≤ ‖ι v + ι' w‖ := by
    intro v w
    have h2 := hpyth v w
    constructor <;> nlinarith [norm_nonneg v, norm_nonneg w, norm_nonneg (ι v + ι' w)]
  have huniq : ∀ (v v' : Euclid n) (w w' : Euclid k), ι v + ι' w = ι v' + ι' w' → w = w' := by
    intro v v' w w' heq
    have h0 : ι (v - v') + ι' (w - w') = 0 := by
      rw [map_sub, map_sub, sub_add_sub_comm, heq, sub_self]
    have h1 := (hle (v - v') (w - w')).2
    rw [h0, norm_zero] at h1
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h1)
  -- `ρ := min(s, h)/2`, so `B̄_ρ(z) ⊆ C ⊆ U`
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = min s h / 2 := ⟨_, rfl⟩
  have hρ : 0 < ρ := by rw [hρdef]; exact half_pos (lt_min hs hh)
  have hρs : ρ < s := by rw [hρdef]; linarith [min_le_left s h, lt_min hs hh]
  have hρh : ρ < h := by rw [hρdef]; linarith [min_le_right s h, lt_min hs hh]
  have hclosed : closedBall z ρ ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
    intro x hx
    obtain ⟨v, w, hvw⟩ := hdec (x - z)
    have hxz : ‖ι v + ι' w‖ ≤ ρ := by rw [← hvw, ← dist_eq_norm]; exact hx
    refine ⟨v, ?_, w, ?_, ?_⟩
    · rw [mem_ball_zero_iff]; exact ((hle v w).1.trans hxz).trans_lt hρs
    · rw [mem_ball_zero_iff]; exact ((hle v w).2.trans hxz).trans_lt hρh
    · rw [add_assoc, ← hvw, add_sub_cancel]
  have hballC : ball z ρ ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} :=
    ball_subset_closedBall.trans hclosed
  -- `‖v‖ ≤ ‖Φ(v) − z‖`, `z = Φ(0) ∈ Σ`, and `u(B_s(0)) ⊆ B_h(0)` because `Σ ⊆ C`
  have hnorm : ∀ v : Euclid n, ‖v‖ ≤ ‖z + ι v + ι' (u v) - z‖ := fun v => by
    rw [add_assoc, add_sub_cancel_left]; exact (hle v (u v)).1
  have hzS : z ∈ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s :=
    ⟨0, mem_ball_self hs, by simp [hu0]⟩
  have huh : ∀ v ∈ ball (0 : Euclid n) s, u v ∈ ball (0 : Euclid k) h := by
    intro v hv
    have hmem : z + ι v + ι' (u v) ∈ R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
      rw [hspt]; exact ⟨v, hv, rfl⟩
    obtain ⟨v', -, w', hw', heq⟩ := hmem.2
    rw [add_assoc, add_assoc] at heq
    rwa [huniq v v' (u v) w' (add_left_cancel heq)]
  -- step 2: `Σ` is an embedded `C¹` submanifold with `T_{Φ(v)}Σ = range DΦ(v)`, oriented by `ξ`
  obtain ⟨hinj, hdiff, hemb, htan⟩ := Submission.dgcr_graph_chart_embedded n k ι ι' u z s horth hs hu
  obtain ⟨ξ, β, hξc, hβc, hξβ, hξo, hjac⟩ :=
    Submission.dgcr_graph_orientation_jacobian n k ι ι' u z s hn horth hs hu
  have hor : IsOrientation n ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ξ := by
    refine ⟨hξc, ?_⟩
    rintro _ ⟨v, hv, rfl⟩
    exact ⟨_, (htan v hv).symm, hξo v hv⟩
  -- step 3: an integer density `g` on `Σ` with `T(ω) = ∫_Σ g ⟨ω, ξ⟩ dHⁿ` for `spt ω ⊆ C`
  obtain ⟨g, hgloc, hgint, hgrep⟩ := Submission.dgcr_graph_integer_density_on_graph n k U T R ι ι' u z
    s h ξ β hn hRT horth hs hh hu hCU hspt hβc hξβ hξo
  -- step 4: area formula `∫_Σ F dHⁿ = ∫_{B_s(0)} JΦ · F ∘ Φ dLⁿ`, `JΦ = √det(DΦ* DΦ)`
  have harea : ∀ F : Euclid (n + k) → ℝ, ∫ x in (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, F x ∂μHE[n] = ∫ v in ball (0 : Euclid n) s, Real.sqrt (((fderiv ℝ (fun v => z + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => z + ι v + ι' (u v)) v).det) * F (z + ι v + ι' (u v)) := by
    intro F
    have h4 := Poincare.SimonGMT.Chapter02.integral_area_formula_of_injective_derivative
      measurableSet_ball (fun v hv => (hdiff v hv).1) (fun v hv => (hdiff v hv).2) hinj F
    rw [finrank_euclideanSpace_fin, EuclideanSpace.euclideanHausdorffMeasure_eq_volume n] at h4
    rw [h4]
    refine setIntegral_congr_fun measurableSet_ball fun v _ => ?_
    simp only [smul_eq_mul, Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_sqrt_det_adjoint_comp]
  -- with `α(DΦe₁, …, DΦeₙ) = JΦ ⟨α, ξ⟩`: `T(ω) = ∫_{B_s(0)} G ω(Φ)(DΦe₁, …, DΦeₙ) dv`, `G = g ∘ Φ`
  have hrepD : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = ∫ v in ball (0 : Euclid n) s, g (z + ι v + ι' (u v)) * (ω : DifferentialForm (Euclid (n + k)) n) (z + ι v + ι' (u v)) (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ))) := by
    intro ω hω
    rw [hgrep ω hω, harea]
    refine setIntegral_congr_fun measurableSet_ball fun v hv => ?_
    simp only [hjac v hv]
    ring
  -- step 5: `∂T = 0` gives `∫ G ∂ⱼa = 0` for all tests `a`; distributional constancy on `B_s(0)`
  have hBT := Submission.dgcr_graph_boundary_weak_derivatives n k U T ι ι' u z s h
    (fun v => g (z + ι v + ι' (u v))) hn hbd horth hs hh hu huh hCU hrepD
  have hSC := Submission.dgcr_smooth_tests_to_C1_tests n (ball (0 : Euclid n) s)
    (fun v => g (z + ι v + ι' (u v))) isOpen_ball hgloc hBT
  obtain ⟨c, hc⟩ := Poincare.SimonGMT.Chapter08.ae_eq_const_of_weak_coordinate_derivatives_zero
    hgloc isOpen_ball (convex_ball (0 : Euclid n) s).isPreconnected hSC
  -- the constant is an integer `m`: `G` is integer-valued a.e. and `Lⁿ(B_s(0)) > 0`
  obtain ⟨v₀, -, hv₀c, m, hv₀m⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae
    (measure_ball_pos volume (0 : Euclid n) hs).ne' (hc.and hgint)
  have hGm : ∀ᵐ v ∂(volume.restrict (ball (0 : Euclid n) s)), g (z + ι v + ι' (u v)) = m := by
    filter_upwards [hc] with v hv
    exact hv.trans (hv₀c.symm.trans hv₀m)
  -- step 6: `T = m[[Σ]]` in `C`
  have hrepm : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = (m : ℝ) * ∫ x in (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, ξ x ((ω : DifferentialForm (Euclid (n + k)) n) x) ∂μHE[n] := by
    intro ω hω
    rw [hrepD ω hω, harea, ← integral_const_mul]
    refine integral_congr_ae ?_
    filter_upwards [hGm, ae_restrict_mem measurableSet_ball] with v hv hvD
    rw [hv, hjac v hvD]
  -- step 7: `m ≠ 0`, since otherwise `T` vanishes in `B_ρ(z)` and `z ∉ spt T`
  have hm0 : m ≠ 0 := by
    intro hm
    subst hm
    have hvan : T.VanishesOn (ball z ρ) := by
      intro ω hω
      rw [hrepm ω (hω.trans hballC), Int.cast_zero, zero_mul]
    exact hzT.2 (Set.mem_sUnion.2 ⟨ball z ρ, ⟨isOpen_ball,
      (isCompact_closedBall z ρ).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      closure_ball_subset_closedBall.trans (hclosed.trans hCU), hvan⟩, mem_ball_self hρ⟩)
  -- step 8: `Hⁿ(Σ ∩ K) ≤ Hⁿ(Φ(B̄_ρ(0))) < ∞` for `K ⊆ B_ρ(z)`
  have hfin : ∀ K : Set (Euclid (n + k)), IsCompact K → K ⊆ ball z ρ → μHE[n] (((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ∩ K) ≠ ∞ := by
    intro K _ hK
    refine ne_top_of_le_ne_top
      ((Submission.dgcr_graph_measure_bounds n k ι ι' u z s horth hs hu).2 ρ hρs) (measure_mono ?_)
    rintro _ ⟨⟨v, -, rfl⟩, hvK⟩
    refine ⟨v, ?_, rfl⟩
    have hv := hK hvK
    rw [mem_ball, dist_eq_norm] at hv
    rw [mem_closedBall_zero_iff]
    exact (hnorm v).trans hv.le
  exact ⟨hzT, ρ, hρ, hballC.trans hCU, m, (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, ξ,
    hm0, hzS, hemb, hor, hfin, fun ω hω => hrepm ω (hω.trans hballC)⟩

/-- **Low-density points of a minimizing current are regular** (Simon 7.4.2–7.4.4, pp. 194–195:
"by Allard's 5.2 of Ch. 5 there is `δ > 0` such that `sing S = {Θ ≥ 1 + δ}`", applied at the
point itself as in 7.4.3 with `Tⱼ = T`, `yⱼ = y`; Lemma 7.1.2 justifies the use of Allard's
Theorem 5.2 of Ch. 5).  If `P < n` no `d` is admissible.  Otherwise `P = n + k`; take `δ₀`, `γ`
from `codim1_ldr_allard_bounded_curvature_graph` with `ε = 1/2` and put `δ = δ₀/2`.  Let
`T = τ(M, θ, ξ)`: `M_W(T) = μ_T(W)`, `spt T = U ∩ spt μ_T` and `Hⁿ(M \ N) ≤ Hⁿ(M \ spt T) = 0`, so
the varifold of `T` is stationary in `N ∩ U` (7.1.2) and has generalized mean curvature `H`,
`|H| ≤ κ`, in `B_{2r₀}(x)`.  As `Θⁿ(μ_T, x) < 1 + δ₀/2`, with `tⁿ = (1 + δ₀)/(1 + δ₀/2)` we get
`μ_T(B̄_ρ(x)) ≤ μ_T(B_{tρ}(x)) ≤ (1 + δ₀)ωₙρⁿ` for small `ρ`; with also `ρ ≤ r₀` and `κρ ≤ δ₀`,
Allard's theorem makes `spt μ_T ∩ B_{γρ}(x)` the graph of `Φ(v) = x + ιv + ι'u(v)`, `u(0) = 0`,
`|Du| ≤ 1/2`.  On `C = {x + ιv + ι'w : |v|, |w| < γρ/2} ⊆ B_{γρ}(x)` orthogonal coordinates are
unique and `|u(v)| ≤ |v|/2`, so `spt μ_T ∩ C = Φ(B_{γρ/2}(0))`, and
`dor_graph_supported_cycle_regular` gives `x ∈ reg T`. -/
theorem Submission.codim1_low_density_points_regular : ∀ (P n : ℕ), 1 ≤ n → ∃ δ : ℝ, 0 < δ ∧ ∀ (d : ℕ) (U N : Set (Euclid P)) (T : GeometricCurrentOn U n), n ≤ d → d ≤ P → IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T → ∀ x ∈ T.support, ∀ θ : ℝ, HasMassDensity T x θ → θ < 1 + δ → x ∈ regularSet T := by
  intro P n hn
  have hn0 : 0 < n := by omega
  -- no admissible `d` if `P < n`; otherwise `P = n + k` and `δ = δ₀/2` from Allard (`ε = 1/2`)
  rcases lt_or_ge P n with hPn | hnP
  · exact ⟨1, one_pos, fun d _ _ _ hnd hdP => absurd (hnd.trans hdP) (not_le.2 hPn)⟩
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnP
  obtain ⟨δ₀, γ, hδ₀, hγ, hγ1, hallard⟩ :=
    Submission.codim1_ldr_allard_bounded_curvature_graph n k hn0 (1 / 2) one_half_pos
  refine ⟨δ₀ / 2, half_pos hδ₀, ?_⟩
  intro d U N T hnd hdP hU hN hcl hmin hspt hbd x hx θ hθ hθlt
  obtain ⟨ℓ, rfl⟩ := Nat.exists_eq_add_of_le hnd
  have hℓk : ℓ ≤ k := by omega
  -- `T = τ(M, θ, ξ)`: `M_W(T) = μ_T(W)`, `spt T = U ∩ spt μ_T`, and `Hⁿ(M \ N) = 0`
  obtain ⟨R, hRT⟩ := hmin.1
  obtain ⟨hmass, hsupp⟩ :=
    Submission.dor_imrep_massOn_eq_measure_and_support (n + k) n U T R hU hRT
  have hxμ : x ∈ R.measure.support := by rw [hsupp] at hx; exact hx.2
  have hTN : T.support ⊆ N := fun y hy => (hspt hy).2
  have hMN : μHE[n] (R.carrier \ N) = 0 :=
    measure_mono_null (sdiff_subset_sdiff_right hTN)
      (Submission.imrep_carrier_sdiff_support_null (n + k) n U T R hU hRT)
  -- the varifold of `T` is stationary in `N ∩ U` (Simon 7.1.2)
  have hstat : R.IsStationaryAlong N :=
    Submission.codim1_ldr_stationaryAlong_of_minimizing (n + k) n (n + ℓ) U N T R hU hN hcl
      (by rw [inter_comm]; exact hmin) hbd hRT hMN
  -- generalized mean curvature `H`, `|H| ≤ κ`, in `B_{2r₀}(x)`, where `B̄_{3r₀}(x) ⊆ U`
  obtain ⟨r₀, κ, hr₀, hκ, hr₀U, hmc⟩ := Submission.dor_stationary_mean_curvature_monotonicity n k
    ℓ hℓk hn0 U N x hU hN hcl ⟨hTN hx, (hspt hx).1⟩
  obtain ⟨⟨H, hHm, hHκ, hHvar⟩, -⟩ := hmc T R hRT hTN hstat
  -- `Θⁿ(μ_T, x) < 1 + δ₀/2`: `μ_T(B_r(x)) < (1 + δ₀/2) ωₙ rⁿ` for `0 < r < ρ₁`
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  obtain ⟨ρ₁, hρ₁, hdens⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 (hθ.2.eventually
    (gt_mem_nhds ((ENNReal.ofReal_lt_ofReal_iff (by positivity)).2 hθlt)))
  have hρ₁0 : 0 < ρ₁ := hρ₁
  have hdens' : ∀ r : ℝ, 0 < r → r < ρ₁ → R.measure (ball x r) <
      ENNReal.ofReal (1 + δ₀ / 2) * (unitBallVolume n * ENNReal.ofReal (r ^ n)) := by
    intro r hr hr₁
    have h : T.massOn (ball x r) / (unitBallVolume n * ENNReal.ofReal (r ^ n)) <
        ENNReal.ofReal (1 + δ₀ / 2) := hdens ⟨hr, hr₁⟩
    rw [← hmass _ isOpen_ball]
    exact (ENNReal.div_lt_iff (Or.inl (mul_ne_zero hω0 (ENNReal.ofReal_pos.2 (pow_pos hr n)).ne'))
      (Or.inl (ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top))).1 h
  -- `t > 1` with `(1 + δ₀/2) tⁿ = 1 + δ₀`
  obtain ⟨t, htn, ht1⟩ : ∃ t : ℝ, (1 + δ₀ / 2) * t ^ n = 1 + δ₀ ∧ 1 < t := by
    refine ⟨((1 + δ₀) / (1 + δ₀ / 2)) ^ ((n : ℝ)⁻¹), ?_, Real.one_lt_rpow
      ((one_lt_div (by positivity)).2 (by linarith)) (inv_pos.2 (Nat.cast_pos.2 hn0))⟩
    rw [Real.rpow_inv_natCast_pow (by positivity) hn0.ne']
    exact mul_div_cancel₀ _ (by positivity)
  have ht0 : 0 < t := one_pos.trans ht1
  -- the radius `ρ = min(r₀, δ₀/(κ + 1), ρ₁/(2t))`: `ρ ≤ r₀`, `(κ + 1)ρ ≤ δ₀` and `tρ < ρ₁`
  obtain ⟨ρ, hρ, hρr₀, hρκ, htρ⟩ :
      ∃ ρ : ℝ, 0 < ρ ∧ ρ ≤ r₀ ∧ ρ * (κ + 1) ≤ δ₀ ∧ t * ρ < ρ₁ := by
    refine ⟨min (min r₀ (δ₀ / (κ + 1))) (ρ₁ / (2 * t)),
      lt_min (lt_min hr₀ (div_pos hδ₀ (by linarith))) (div_pos hρ₁0 (by positivity)),
      (min_le_left _ _).trans (min_le_left _ _),
      (le_div_iff₀ (by linarith)).1 ((min_le_left _ _).trans (min_le_right _ _)), ?_⟩
    have h := (le_div_iff₀ (by positivity)).1 (min_le_right (min r₀ (δ₀ / (κ + 1))) (ρ₁ / (2 * t)))
    nlinarith
  -- `μ_T(B̄_ρ(x)) ≤ μ_T(B_{tρ}(x)) ≤ (1 + δ₀/2) ωₙ (tρ)ⁿ = (1 + δ₀) ωₙ ρⁿ`
  have hball : R.measure (closedBall x ρ) ≤
      ENNReal.ofReal (1 + δ₀) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) := by
    have h1 : ENNReal.ofReal ((t * ρ) ^ n) = ENNReal.ofReal (t ^ n) * ENNReal.ofReal (ρ ^ n) := by
      rw [mul_pow, ENNReal.ofReal_mul (pow_nonneg ht0.le n)]
    have h2 : ENNReal.ofReal (1 + δ₀) = ENNReal.ofReal (1 + δ₀ / 2) * ENNReal.ofReal (t ^ n) := by
      rw [← ENNReal.ofReal_mul (by linarith : (0 : ℝ) ≤ 1 + δ₀ / 2), htn]
    calc R.measure (closedBall x ρ) ≤ R.measure (ball x (t * ρ)) :=
          measure_mono (closedBall_subset_ball (lt_mul_of_one_lt_left hρ ht1))
      _ ≤ ENNReal.ofReal (1 + δ₀ / 2) * (unitBallVolume n * ENNReal.ofReal ((t * ρ) ^ n)) :=
          (hdens' _ (mul_pos ht0 hρ) htρ).le
      _ = ENNReal.ofReal (1 + δ₀) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) := by
          rw [h1, h2]; ring
  -- Allard's theorem in `W = B_{2r₀}(x)` at `z = x`
  have hWU : ball x (2 * r₀) ⊆ U :=
    ball_subset_closedBall.trans ((closedBall_subset_closedBall (by linarith)).trans hr₀U)
  obtain ⟨ι, ι', u, horth, hu0, hu, hDu, hgraph⟩ := hallard U (ball x (2 * r₀)) R H κ ρ x
    isOpen_ball hWU hρ (closedBall_subset_ball (by linarith)) hHm hHκ hHvar hxμ hball
    (by nlinarith)
  -- the cylinder `C = {x + ιv + ι'w : |v|, |w| < s}`, `s = γρ/2`, lies in `B_{γρ}(x) ⊆ U`
  obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = γ * ρ / 2 := ⟨_, rfl⟩
  have hγρ : 0 < γ * ρ := mul_pos hγ hρ
  have hs : 0 < s := by rw [hs_def]; exact half_pos hγρ
  have hsγ : ball (0 : Euclid n) s ⊆ ball 0 (γ * ρ) := ball_subset_ball (by linarith)
  have hCB : {y | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s, y = x + ι v + ι' w} ⊆
      ball x (γ * ρ) := by
    rintro _ ⟨v, hv, w, hw, rfl⟩
    rw [mem_ball_zero_iff] at hv hw
    rw [mem_ball, dist_eq_norm, add_assoc, add_sub_cancel_left]
    calc ‖ι v + ι' w‖ ≤ ‖ι v‖ + ‖ι' w‖ := norm_add_le _ _
      _ = ‖v‖ + ‖w‖ := by rw [ι.norm_map, ι'.norm_map]
      _ < s + s := add_lt_add hv hw
      _ = γ * ρ := by rw [hs_def]; ring
  have hCU : {y | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s, y = x + ι v + ι' w} ⊆
      U := hCB.trans ((ball_subset_ball (by nlinarith)).trans hWU)
  -- `|u(v)| ≤ |v|/2` on `B_{γρ}(0)` (mean value inequality with `u(0) = 0`, `|Du| ≤ 1/2`)
  have hu_half : ∀ v ∈ ball (0 : Euclid n) (γ * ρ), ‖u v‖ ≤ 1 / 2 * ‖v‖ := by
    intro v hv
    have h := (convex_ball (0 : Euclid n) (γ * ρ)).norm_image_sub_le_of_norm_fderiv_le
      (fun y hy => (hu.differentiableOn_one y hy).differentiableAt (isOpen_ball.mem_nhds hy))
      hDu (mem_ball_self hγρ) hv
    rwa [hu0, sub_zero, sub_zero] at h
  -- `spt μ_T ∩ C = Φ(B_s(0))`: orthogonal coordinates are unique
  have hgraphC : R.measure.support ∩
      {y | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s, y = x + ι v + ι' w} =
      (fun v => x + ι v + ι' (u v)) '' ball (0 : Euclid n) s := by
    ext y
    constructor
    · rintro ⟨hyμ, v, hv, w, hw, rfl⟩
      have hy : x + ι v + ι' w ∈ R.measure.support ∩ ball x (γ * ρ) :=
        ⟨hyμ, hCB ⟨v, hv, w, hw, rfl⟩⟩
      rw [hgraph] at hy
      obtain ⟨⟨v', -, hv'⟩, -⟩ := hy
      have h0 : x + ι v' + ι' (u v') = x + ι v + ι' w := hv'
      have h1 : ι (v' - v) = ι' (w - u v') := by
        rw [map_sub, map_sub, ← sub_eq_zero, ← sub_eq_zero.2 h0]
        abel
      have h2 := horth (v' - v) (w - u v')
      rw [← h1] at h2
      have h3 : v' = v :=
        sub_eq_zero.1 (ι.injective ((inner_self_eq_zero.1 h2).trans (map_zero ι).symm))
      subst h3
      exact ⟨_, hv, h0⟩
    · rintro ⟨v, hv, rfl⟩
      have hwC : u v ∈ ball (0 : Euclid k) s := by
        have h1 := hu_half v (hsγ hv)
        have h2 := mem_ball_zero_iff.1 hv
        rw [mem_ball_zero_iff]
        linarith [norm_nonneg v]
      have hyC : x + ι v + ι' (u v) ∈
          {y | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s, y = x + ι v + ι' w} :=
        ⟨v, hv, u v, hwC, rfl⟩
      have hy : x + ι v + ι' (u v) ∈
          ((fun v => x + ι v + ι' (u v)) '' ball (0 : Euclid n) (γ * ρ)) ∩ ball x (γ * ρ) :=
        ⟨⟨v, hsγ hv, rfl⟩, hCB hyC⟩
      rw [← hgraph] at hy
      exact ⟨hy.1, hyC⟩
  -- `T` is an integer multiplicity cycle carried by the `C¹` graph `Φ(B_s(0))` near `x`
  exact Submission.dor_graph_supported_cycle_regular n k U T R ι ι' u x s s hn0 hU hRT hbd horth hs
    hs (hu.mono hsγ) hu0 hCU hgraphC hx

/-- **ε-regularity for stationary cycles**, the book's appeal to Allard's theorem in Simon 7.4.3
(chapter-07.txt lines 624–631; Allard's theorem is Ch. 5, 5.2).  Near `y₀ ∈ N ∩ U`, the varifold
`v(M, θ)` of a cycle `T = τ(M, θ, ξ)` stationary in `U ∩ N` has generalized mean curvature
`|H| ≤ κ` in `B_{2r_c}(y₀)` (Ch. 4, 2.7).  If `z ∈ spt T` is near `y₀` and
`M_{B_ρ(z)}(T) ≤ (1 + δ)ωₙρⁿ`, then `μ_R(B̄_{ρ'}(z)) ≤ (1 + δ₁)ωₙρ'ⁿ` for a slightly smaller
`ρ'`, because `M_W(T) = μ_R(W)` and `z ∈ spt μ_R`.  Allard's theorem (gradient bound `1/4`) then
makes `spt μ_R ∩ B_{γρ'}(z)` the graph of a `C¹` map `u` over an `n`-plane through `z`.  In the
cylinder of radius `γρ'/4` about `z`, `spt μ_R` is exactly that graph, so `z ∈ reg T` by the
Constancy Theorem argument (Ch. 6, 2.34). -/
theorem Submission.dor_stationary_cycle_epsilon_regularity : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n →
    ∀ (U N : Set (Euclid (n + k))) (y₀ : Euclid (n + k)), IsOpen U →
    IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → y₀ ∈ N ∩ U →
    ∃ r₀ δ : ℝ, 0 < r₀ ∧ 0 < δ ∧ ∀ (T : GeometricCurrentOn U n) (R : IMRep U n),
      R.Represents T → T.support ⊆ N → BoundaryVanishes T → R.IsStationaryAlong N →
      ∀ z ∈ T.support, dist z y₀ < r₀ → ∀ ρ : ℝ, 0 < ρ → ρ ≤ r₀ →
        T.massOn (ball z ρ) ≤ ENNReal.ofReal (1 + δ) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) →
        z ∈ regularSet T := by
  intro n k ℓ hℓk hn U N y₀ hU hN hNcl hy₀
  -- The mean curvature bound `κ` and the first variation formula on `B_{2r_c}(y₀)`.
  obtain ⟨rc, κ, hrc, hκ, hrcU, hmc⟩ :=
    Submission.dor_stationary_mean_curvature_monotonicity n k ℓ hℓk hn U N y₀ hU hN hNcl hy₀
  -- Allard's constants `δ₁`, `γ` for the gradient bound `1/4`.
  obtain ⟨δ₁, γ, hδ₁, hγ, hγ1, hallard⟩ :=
    Submission.dor_allard_bounded_curvature_graph n k hn (1 / 4) (by norm_num)
  have hκ1 : 0 < κ + 1 := by linarith
  refine ⟨min (rc / 2) (δ₁ / (κ + 1)), δ₁ / 2, lt_min (half_pos hrc) (div_pos hδ₁ hκ1),
    half_pos hδ₁, ?_⟩
  intro T R hR hTN hTb hstat z hz hzy ρ hρ hρr₀ hmass
  obtain ⟨hρrc, hρδ⟩ := le_min_iff.1 hρr₀
  have hzy' : dist z y₀ < rc / 2 := (lt_min_iff.1 hzy).1
  -- `M_W(T) = μ_R(W)` for open `W`, and `spt T = U ∩ spt μ_R`; so `z ∈ spt μ_R`.
  obtain ⟨hmassEq, hsupp⟩ :=
    Submission.dor_imrep_massOn_eq_measure_and_support (n + k) n U T R hU hR
  have hzR : z ∈ R.measure.support := by
    have h := hz
    rw [hsupp] at h
    exact h.2
  obtain ⟨⟨H, hHm, hHκ, hHfv⟩, -⟩ := hmc T R hR hTN hstat
  -- A smaller radius `ρ' = tρ`, `t = 1 - d/n`, with `(1 + δ₁/2)ρⁿ ≤ (1 + δ₁)ρ'ⁿ` (Bernoulli).
  set d : ℝ := δ₁ / (2 * (1 + δ₁)) with hd
  have hd0 : 0 < d := div_pos hδ₁ (by linarith)
  have hd1 : d < 1 := by
    rw [hd, div_lt_one (by linarith)]
    linarith
  have hδd : (1 + δ₁) * (1 - d) = 1 + δ₁ / 2 := by
    rw [hd]
    field_simp
    ring
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast hn
  set t : ℝ := 1 - d / n with ht
  have hdn : d / n ≤ d := div_le_self hd0.le hnR
  have hdn0 : 0 < d / n := div_pos hd0 (by linarith)
  have ht0 : 0 < t := by linarith
  have ht1 : t < 1 := by linarith
  have hbern : 1 - d ≤ t ^ n := by
    have h := one_add_mul_le_pow (show (-2 : ℝ) ≤ -(d / n) by linarith) n
    have e1 : (n : ℝ) * -(d / n) = -d := by
      field_simp
    have e2 : (1 : ℝ) + -(d / n) = t := by
      rw [ht]
      ring
    rw [e1, e2] at h
    linarith
  set ρ' : ℝ := t * ρ with hρ'
  have hρ'0 : 0 < ρ' := mul_pos ht0 hρ
  have hρ'ρ : ρ' < ρ := mul_lt_of_lt_one_left hρ ht1
  have hreal : (1 + δ₁ / 2) * ρ ^ n ≤ (1 + δ₁) * ρ' ^ n := by
    have hρn : 0 ≤ ρ ^ n := pow_nonneg hρ.le n
    calc (1 + δ₁ / 2) * ρ ^ n = (1 + δ₁) * ((1 - d) * ρ ^ n) := by
          rw [← hδd]
          ring
      _ ≤ (1 + δ₁) * (t ^ n * ρ ^ n) := by
          gcongr
      _ = (1 + δ₁) * ρ' ^ n := by
          rw [hρ', mul_pow]
  -- Allard's mass hypothesis on the closed ball `B̄_{ρ'}(z) ⊆ B_ρ(z)`.
  have hmass' : R.measure (closedBall z ρ') ≤
      ENNReal.ofReal (1 + δ₁) * unitBallVolume n * ENNReal.ofReal (ρ' ^ n) := by
    calc R.measure (closedBall z ρ') ≤ R.measure (ball z ρ) :=
          measure_mono (closedBall_subset_ball hρ'ρ)
      _ = T.massOn (ball z ρ) := (hmassEq _ isOpen_ball).symm
      _ ≤ ENNReal.ofReal (1 + δ₁ / 2) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) := hmass
      _ ≤ ENNReal.ofReal (1 + δ₁) * unitBallVolume n * ENNReal.ofReal (ρ' ^ n) := by
          rw [mul_right_comm, mul_right_comm (ENNReal.ofReal (1 + δ₁)),
            ← ENNReal.ofReal_mul (show (0 : ℝ) ≤ 1 + δ₁ / 2 by linarith),
            ← ENNReal.ofReal_mul (show (0 : ℝ) ≤ 1 + δ₁ by linarith)]
          gcongr
  -- Allard's curvature hypothesis `κρ' ≤ δ₁`.
  have hκρ' : κ * ρ' ≤ δ₁ := by
    have h1 : ρ' * (κ + 1) ≤ δ₁ := (le_div_iff₀ hκ1).1 (hρ'ρ.le.trans hρδ)
    have h2 : ρ' * (κ + 1) = κ * ρ' + ρ' := by ring
    linarith
  -- `B̄_{ρ'}(z) ⊆ W := B_{2r_c}(y₀) ⊆ U`.
  have hWU : ball y₀ (2 * rc) ⊆ U :=
    (ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith))).trans hrcU
  have hBW : closedBall z ρ' ⊆ ball y₀ (2 * rc) := by
    intro x hx
    rw [mem_closedBall] at hx
    rw [mem_ball]
    calc dist x y₀ ≤ dist x z + dist z y₀ := dist_triangle _ _ _
      _ < 2 * rc := by linarith
  -- Allard: `spt μ_R ∩ B_{γρ'}(z)` is the graph of `u` over `ι(ℝⁿ)`, with `‖Du‖ ≤ 1/4`.
  obtain ⟨ι, ι', u, horth, hu0, hu, hDu, hgraph⟩ :=
    hallard U (ball y₀ (2 * rc)) R H κ ρ' z isOpen_ball hWU hρ'0 hBW hHm hHκ hHfv hzR hmass'
      hκρ'
  -- The cylinder `{z + ι v + ι' w : |v|, |w| < s}`, `s = γρ'/4`, lies in `B_{γρ'}(z) ⊆ U`.
  set s : ℝ := γ * ρ' / 4 with hs
  have hγρ' : 0 < γ * ρ' := mul_pos hγ hρ'0
  have hs0 : 0 < s := by linarith
  have hsγ : s < γ * ρ' := by linarith
  have hγρ'ρ' : γ * ρ' ≤ ρ' := mul_le_of_le_one_left hρ'0.le hγ1
  have hnorm : ∀ (v : Euclid n) (w : Euclid k), dist (z + ι v + ι' w) z ≤ ‖v‖ + ‖w‖ := by
    intro v w
    rw [dist_eq_norm, add_assoc, add_sub_cancel_left]
    calc ‖ι v + ι' w‖ ≤ ‖ι v‖ + ‖ι' w‖ := norm_add_le _ _
      _ = ‖v‖ + ‖w‖ := by rw [ι.norm_map, ι'.norm_map]
  have hcyl : {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s,
      x = z + ι v + ι' w} ⊆ ball z (γ * ρ') := by
    rintro x ⟨v, hv, w, hw, rfl⟩
    rw [mem_ball_zero_iff] at hv hw
    rw [mem_ball]
    calc dist (z + ι v + ι' w) z ≤ ‖v‖ + ‖w‖ := hnorm v w
      _ < γ * ρ' := by linarith
  have hcylU : {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s,
      x = z + ι v + ι' w} ⊆ U :=
    hcyl.trans ((ball_subset_ball hγρ'ρ').trans (ball_subset_closedBall.trans (hBW.trans hWU)))
  -- `|u(v)| ≤ |v|/4` on `B_{γρ'}(0)` (mean value inequality, `u(0) = 0`).
  have hu_le : ∀ v ∈ ball (0 : Euclid n) (γ * ρ'), ‖u v‖ ≤ 1 / 4 * ‖v‖ := by
    intro v hv
    have h := (convex_ball (0 : Euclid n) (γ * ρ')).norm_image_sub_le_of_norm_fderiv_le
      (fun x hx => (hu.differentiableOn_one x hx).differentiableAt (isOpen_ball.mem_nhds hx))
      hDu (mem_ball_self hγρ') hv
    simpa [hu0] using h
  -- In the cylinder, `spt μ_R` is exactly the graph over `B_s(0)`: the ranges of `ι`, `ι'` are
  -- orthogonal, so a graph point `z + ι v' + ι' u(v')` equal to `z + ι v + ι' w` has `v' = v`.
  have hsupp_eq : R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s,
      ∃ w ∈ ball (0 : Euclid k) s, x = z + ι v + ι' w} =
      (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s := by
    ext x
    constructor
    · rintro ⟨hxR, hxC⟩
      have hxB := hcyl hxC
      obtain ⟨v, hv, w, -, rfl⟩ := hxC
      have hx : z + ι v + ι' w ∈ R.measure.support ∩ ball z (γ * ρ') := ⟨hxR, hxB⟩
      rw [hgraph] at hx
      obtain ⟨⟨v', -, hv'⟩, -⟩ := hx
      have hsum : ι v' + ι' (u v') = ι v + ι' w := by
        simpa only [add_assoc, add_right_inj] using hv'
      have hdiff : ι (v' - v) = ι' (w - u v') := by
        rw [map_sub, map_sub, sub_eq_sub_iff_add_eq_add, hsum, add_comm (ι v)]
      have hzero : ι (v' - v) = 0 := by
        rw [← inner_self_eq_zero (𝕜 := ℝ)]
        nth_rewrite 2 [hdiff]
        exact horth _ _
      have hvv : v' = v := by
        have h0 : ‖v' - v‖ = 0 := by
          rw [← ι.norm_map, hzero, norm_zero]
        exact sub_eq_zero.1 (norm_eq_zero.1 h0)
      subst hvv
      exact ⟨v', hv, hv'⟩
    · rintro ⟨v, hv, rfl⟩
      have hvs : ‖v‖ < s := mem_ball_zero_iff.1 hv
      have hvγ : v ∈ ball (0 : Euclid n) (γ * ρ') := ball_subset_ball hsγ.le hv
      have huv : ‖u v‖ < s := by
        have h := hu_le v hvγ
        linarith [norm_nonneg v]
      have hxB : z + ι v + ι' (u v) ∈ ball z (γ * ρ') := by
        rw [mem_ball]
        calc dist (z + ι v + ι' (u v)) z ≤ ‖v‖ + ‖u v‖ := hnorm v (u v)
          _ < γ * ρ' := by linarith
      have hx : z + ι v + ι' (u v) ∈
          ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) (γ * ρ')) ∩ ball z (γ * ρ') :=
        ⟨⟨v, hvγ, rfl⟩, hxB⟩
      rw [← hgraph] at hx
      exact ⟨hx.1, v, hv, u v, mem_ball_zero_iff.2 huv, rfl⟩
  -- Constancy over the base disc (`dor_graph_supported_cycle_regular`): `z ∈ reg T`.
  exact Submission.dor_graph_supported_cycle_regular n k U T R ι ι' u z s s hn hU hR hTb horth
    hs0 hs0 (hu.mono (ball_subset_ball hsγ.le)) hu0 hcylU hsupp_eq hz

namespace Submission

/-- Integer median of an integer-valued function on the open unit cube `Q₁ ⊆ ℝ^{m+1}` (Simon
Ch. 6, 5.1, (31) and (35)): some `β ∈ ℤ` has `Lⁿ(Q₁ ∩ {β ≤ u}) ≥ 1/2`, `Lⁿ(Q₁ ∩ {u ≤ β}) ≥ 1/2`
and `|β| ≤ 2 ∫_{Q₁} |u|`.  `β` is the least integer with `Lⁿ(Q₁ ∩ {u ≤ β}) ≥ 1/2`; integrality
makes `{β ≤ u}` the complement of `{u ≤ β - 1}`, and Chebyshev's inequality for `|u|` gives both
the existence of `β` and the bound. -/
theorem dor_lmb_fcd_cp_integer_median : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ), (∀ y, ∃ z : ℤ, u y = z) → IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → ∃ β : ℤ, 1 / 2 ≤ volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} ∩ {y | (β : ℝ) ≤ u y}) ∧ 1 / 2 ≤ volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} ∩ {y | u y ≤ (β : ℝ)}) ∧ |(β : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y| := by
  intro m u hZ hu
  set Q : Set (Euclid (m + 1)) := {y | ∀ i, 0 < y i ∧ y i < 1} with hQ
  -- Step 0: `Q₁` is the preimage of the box `(0, 1)ⁿ` under the measure-preserving coordinate map,
  -- so it is measurable with `Lⁿ(Q₁) = 1`.
  have hbox : MeasurableSet (univ.pi fun _ : Fin (m + 1) => Ioo (0 : ℝ) 1) :=
    MeasurableSet.univ_pi fun _ => measurableSet_Ioo
  have hQeq : Q = WithLp.ofLp ⁻¹' (univ.pi fun _ : Fin (m + 1) => Ioo (0 : ℝ) 1) := by
    ext y
    simp [Q, Set.mem_pi]
  have hQm : MeasurableSet Q := by
    rw [hQeq]
    exact (PiLp.volume_preserving_ofLp (Fin (m + 1))).measurable hbox
  have hQ1 : volume Q = 1 := by
    rw [hQeq, (PiLp.volume_preserving_ofLp (Fin (m + 1))).measure_preimage hbox.nullMeasurableSet,
      Real.volume_pi_Ioo]
    simp
  -- Work with the probability measure `μ = Lⁿ⌞Q₁`; `Lⁿ(Q₁ ∩ s) = μ(s)` for every set `s`.
  set μ : Measure (Euclid (m + 1)) := volume.restrict Q with hμQ
  have hμ : ∀ s, volume (Q ∩ s) = μ s := fun s => by
    rw [hμQ, Measure.restrict_apply' hQm, inter_comm]
  have hμuniv : μ univ = 1 := by rw [← hμ, inter_univ, hQ1]
  have : IsFiniteMeasure μ := ⟨by rw [hμuniv]; exact ENNReal.one_lt_top⟩
  simp only [hμ]
  set I := ∫ y, |u y| ∂μ with hI
  have hI0 : 0 ≤ I := integral_nonneg fun y => abs_nonneg _
  -- Chebyshev: `ε μ({ε ≤ |u|}) ≤ ∫ |u| dμ`; no measurability of `u` is needed.
  have hmarkov : ∀ ε : ℝ, ε * μ.real {y | ε ≤ |u y|} ≤ I := fun ε =>
    mul_meas_ge_le_integral_of_nonneg (Eventually.of_forall fun y => abs_nonneg _)
      (Integrable.abs (μ := μ) hu) ε
  have hhalf : ((1 : ℝ≥0∞) / 2).toReal = 1 / 2 := by norm_num
  -- Tails: for `N > 2 ∫ |u|`, `μ({N ≤ |u|}) < 1/2`.
  obtain ⟨N, hN⟩ := exists_nat_gt (2 * I)
  have hNpos : (0 : ℝ) < N := lt_of_le_of_lt (by linarith) hN
  have htail : μ {y | (N : ℝ) ≤ |u y|} < 1 / 2 := by
    have h1 := hmarkov N
    have h2 : μ.real {y | (N : ℝ) ≤ |u y|} < 1 / 2 := not_le.1 fun h => by nlinarith
    rw [← hhalf, measureReal_def] at h2
    exact (ENNReal.toReal_lt_toReal (measure_ne_top μ _) (by norm_num)).1 h2
  -- `μ(A) + μ(B) ≥ 1` and `μ(B) < 1/2` force `μ(A) ≥ 1/2`.
  have hcompl : ∀ a b : ℝ≥0∞, 1 ≤ a + b → b < 1 / 2 → 1 / 2 ≤ a := by
    intro a b hab hb
    refine not_lt.1 fun h => ?_
    have h' := ENNReal.add_lt_add h hb
    rw [ENNReal.add_halves] at h'
    exact absurd hab (not_le.2 h')
  -- Steps 1–2: the least integer `β` with `μ({u ≤ β}) ≥ 1/2` (Simon (31)).  It exists since
  -- `μ({u ≤ N}) ≥ 1/2` while `μ({u ≤ z}) < 1/2` for `z < -N`.
  have hS : ∃ z : ℤ, 1 / 2 ≤ μ {y | u y ≤ z} := by
    refine ⟨N, hcompl _ (μ {y | u y ≤ ((N : ℤ) : ℝ)}ᶜ) (hμuniv ▸ measure_univ_le_add_compl _)
      (lt_of_le_of_lt (measure_mono fun y hy => ?_) htail)⟩
    simp only [mem_compl_iff, mem_ofPred_eq, not_le, Int.cast_natCast] at hy ⊢
    exact hy.le.trans (le_abs_self _)
  have hSb : ∃ b : ℤ, ∀ z : ℤ, 1 / 2 ≤ μ {y | u y ≤ z} → b ≤ z := by
    refine ⟨-N, fun z hz => not_lt.1 fun hlt => ?_⟩
    have hz' : (z : ℝ) ≤ -(N : ℝ) := by exact_mod_cast hlt.le
    refine absurd hz (not_le.2 (lt_of_le_of_lt (measure_mono fun y hy => ?_) htail))
    simp only [mem_ofPred_eq] at hy ⊢
    linarith [neg_abs_le (u y)]
  obtain ⟨β, hβ, hβmin⟩ := Int.exists_least_of_bdd hSb hS
  have hβ1 : μ {y | u y ≤ ((β - 1 : ℤ) : ℝ)} < 1 / 2 :=
    not_le.1 fun h => by have := hβmin (β - 1) h; omega
  -- Step 3: by integrality `{β ≤ u}ᶜ = {u ≤ β - 1}`, so `μ({β ≤ u}) ≥ 1 - μ({u ≤ β - 1}) ≥ 1/2`.
  have hup : 1 / 2 ≤ μ {y | (β : ℝ) ≤ u y} := by
    refine hcompl _ _ ?_ hβ1
    calc (1 : ℝ≥0∞) = μ univ := hμuniv.symm
      _ ≤ μ {y | (β : ℝ) ≤ u y} + μ {y | (β : ℝ) ≤ u y}ᶜ := measure_univ_le_add_compl _
      _ ≤ μ {y | (β : ℝ) ≤ u y} + μ {y | u y ≤ ((β - 1 : ℤ) : ℝ)} := by
        gcongr
        intro y hy
        simp only [mem_compl_iff, mem_ofPred_eq, not_le] at hy ⊢
        obtain ⟨k, hk⟩ := hZ y
        rw [hk] at hy ⊢
        have hk' : k < β := by exact_mod_cast hy
        have hk'' : k ≤ β - 1 := by omega
        exact_mod_cast hk''
  refine ⟨β, hup, hβ, ?_⟩
  -- Step 4 (Simon (35)): `{|β| ≤ |u|}` contains `{β ≤ u}` (`β ≥ 0`) or `{u ≤ β}` (`β ≤ 0`), so it
  -- has measure `≥ 1/2`, and Chebyshev gives `|β| / 2 ≤ ∫ |u|`.
  have hbig : 1 / 2 ≤ μ {y | |(β : ℝ)| ≤ |u y|} := by
    rcases le_total 0 β with h0 | h0
    · refine hup.trans (measure_mono fun y hy => ?_)
      simp only [mem_ofPred_eq] at hy ⊢
      have h0' : (0 : ℝ) ≤ β := by exact_mod_cast h0
      rw [abs_of_nonneg h0']
      exact hy.trans (le_abs_self _)
    · refine hβ.trans (measure_mono fun y hy => ?_)
      simp only [mem_ofPred_eq] at hy ⊢
      have h0' : (β : ℝ) ≤ 0 := by exact_mod_cast h0
      rw [abs_of_nonpos h0']
      exact (neg_le_neg hy).trans (neg_le_abs _)
  have hbig' : 1 / 2 ≤ μ.real {y | |(β : ℝ)| ≤ |u y|} := by
    have h := ENNReal.toReal_mono (measure_ne_top μ _) hbig
    rwa [hhalf, ← measureReal_def] at h
  have h4 := hmarkov |(β : ℝ)|
  nlinarith [abs_nonneg (β : ℝ)]
/-- Deviation from a `θ`-median `β` is controlled by the double-integral oscillation (Simon Ch. 2,
Lemma 2.7, proof): `∫_W |v − β| ≤ (1 + θ⁻¹) |W|⁻¹ ∫_W ∫_W |v(x) − v(y)|`.  With the mean
`v̄ = |W|⁻¹ ∫_W v`, `|v x − v̄| ≤ |W|⁻¹ ∫_W |v x − v y| dy`; Markov's inequality on the half
`{β ≤ v}` or `{v ≤ β}` on the far side of `β` from `v̄` gives `|W| |v̄ − β| ≤ θ⁻¹ ∫_W |v − v̄|`. -/
theorem dor_lmb_fcd_cp_median_deviation : ∀ (P : ℕ) (W : Set (Euclid P)) (v : Euclid P → ℝ) (β θ : ℝ), MeasurableSet W → volume W ≠ ∞ → IntegrableOn v W → 0 < θ → θ * (volume W).toReal ≤ (volume (W ∩ {y | β ≤ v y})).toReal → θ * (volume W).toReal ≤ (volume (W ∩ {y | v y ≤ β})).toReal → ∫ y in W, |v y - β| ≤ (1 + θ⁻¹) * ((volume W).toReal)⁻¹ * ∫ x in W, ∫ y in W, |v x - v y| := by
  intro P W v β θ hW hWfin hv hθ hge hle
  -- `volume⌞W` is a finite measure; write `m = |W|`
  have : IsFiniteMeasure (volume.restrict W) := isFiniteMeasure_restrict.mpr hWfin
  set m := (volume W).toReal
  -- Step 0: if `|W| = 0`, then `volume⌞W = 0` and both sides vanish
  rcases (ENNReal.toReal_nonneg : 0 ≤ m).eq_or_lt with hm | hm
  · have hW0 : volume W = 0 :=
      ((ENNReal.toReal_eq_zero_iff _).mp hm.symm).resolve_right hWfin
    simp [Measure.restrict_eq_zero.mpr hW0]
  -- Step 1: integrability; the partial integral is integrable by Fubini
  have hvi : Integrable v (volume.restrict W) := hv
  have hint : ∀ c : ℝ, Integrable (fun x => |v x - c|) (volume.restrict W) := fun c =>
    (hvi.sub (integrable_const c)).abs
  have hprod : Integrable (fun p : Euclid P × Euclid P => |v p.1 - v p.2|)
      ((volume.restrict W).prod (volume.restrict W)) :=
    ((hvi.comp_fst _).sub (hvi.comp_snd _)).abs
  have hG : Integrable (fun x => ∫ y in W, |v x - v y|) (volume.restrict W) :=
    hprod.integral_prod_left
  -- Step 2: with the mean `v̄ = |W|⁻¹ ∫_W v`, `|v x − v̄| ≤ |W|⁻¹ ∫_W |v x − v y| dy`
  set vbar := m⁻¹ * ∫ y in W, v y with hvbar
  have hpt : ∀ x, |v x - vbar| ≤ m⁻¹ * ∫ y in W, |v x - v y| := by
    intro x
    have h1 : ∫ y in W, (v x - v y) = m * v x - ∫ y in W, v y := by
      rw [integral_sub (integrable_const _) hvi, integral_const, measureReal_restrict_apply_univ,
        smul_eq_mul]
      rfl
    have h2 : v x - vbar = m⁻¹ * ∫ y in W, (v x - v y) := by
      rw [h1, hvbar, mul_sub, ← mul_assoc, inv_mul_cancel₀ hm.ne', one_mul]
    rw [h2, abs_mul, abs_of_pos (inv_pos.mpr hm)]
    exact mul_le_mul_of_nonneg_left abs_integral_le_integral_abs (inv_nonneg.mpr hm.le)
  have hJ : ∫ x in W, |v x - vbar| ≤ m⁻¹ * ∫ x in W, ∫ y in W, |v x - v y| := by
    rw [← integral_const_mul]
    exact integral_mono (hint vbar) (hG.const_mul _) hpt
  -- Step 3: `|v − v̄| ≥ |β − v̄|` on the half on the far side of `β`, which has measure `≥ θ|W|`
  set I := ∫ x in W, |v x - vbar| with hI
  have hmeas : θ * m ≤ (volume.restrict W).real {x | |β - vbar| ≤ |v x - vbar|} := by
    rcases le_total vbar β with hb | hb
    · refine hge.trans ?_
      rw [show (volume (W ∩ {y | β ≤ v y})).toReal = (volume.restrict W).real {y | β ≤ v y} by
        rw [Measure.real, Measure.restrict_apply' hW, Set.inter_comm]]
      refine measureReal_mono (fun x (hx : β ≤ v x) => ?_)
      show |β - vbar| ≤ |v x - vbar|
      rw [abs_of_nonneg (sub_nonneg.mpr hb), abs_of_nonneg (by linarith)]
      linarith
    · refine hle.trans ?_
      rw [show (volume (W ∩ {y | v y ≤ β})).toReal = (volume.restrict W).real {y | v y ≤ β} by
        rw [Measure.real, Measure.restrict_apply' hW, Set.inter_comm]]
      refine measureReal_mono (fun x (hx : v x ≤ β) => ?_)
      show |β - vbar| ≤ |v x - vbar|
      rw [abs_of_nonpos (sub_nonpos.mpr hb), abs_of_nonpos (by linarith)]
      linarith
  -- Markov's inequality for `|v − v̄|` at level `|β − v̄|`
  have hM : |β - vbar| * (volume.restrict W).real {x | |β - vbar| ≤ |v x - vbar|} ≤ I :=
    mul_meas_ge_le_integral_of_nonneg (ae_of_all _ fun x => abs_nonneg _) (hint vbar) _
  have hmed : m * |vbar - β| ≤ θ⁻¹ * I := by
    rw [abs_sub_comm, le_inv_mul_iff₀ hθ]
    calc θ * (m * |β - vbar|) = |β - vbar| * (θ * m) := by ring
      _ ≤ |β - vbar| * (volume.restrict W).real {x | |β - vbar| ≤ |v x - vbar|} :=
        mul_le_mul_of_nonneg_left hmeas (abs_nonneg _)
      _ ≤ I := hM
  -- Step 4: triangle inequality `|v − β| ≤ |v − v̄| + |v̄ − β|`
  have htri : ∫ y in W, |v y - β| ≤ I + m * |vbar - β| := by
    have h3 : ∫ y in W, (|v y - vbar| + |vbar - β|) = I + m * |vbar - β| := by
      rw [integral_add (hint vbar) (integrable_const _), integral_const,
        measureReal_restrict_apply_univ, smul_eq_mul]
      rfl
    rw [← h3]
    exact integral_mono (hint β) ((hint vbar).add (integrable_const _))
      fun y => abs_sub_le (v y) vbar β
  calc ∫ y in W, |v y - β| ≤ I + m * |vbar - β| := htri
    _ ≤ I + θ⁻¹ * I := by linarith
    _ = (1 + θ⁻¹) * I := by ring
    _ ≤ (1 + θ⁻¹) * (m⁻¹ * ∫ x in W, ∫ y in W, |v x - v y|) :=
        mul_le_mul_of_nonneg_left hJ (by positivity)
    _ = (1 + θ⁻¹) * m⁻¹ * ∫ x in W, ∫ y in W, |v x - v y| := by ring
/-- Fubini identity for mixed points on the cube `Q_δ = {y | ∀ i, δ < y i < 1 - δ}`: if `a_k(x, y)`
takes the coordinates `j < k` from `y` and the others from `x`, then
`∫_{Q_δ} ∫_{Q_δ} h(a_k(x, y)) dy dx = vol(Q_δ) ∫_{Q_δ} h`.  The swap `σ` exchanging `x_j` and `y_j`
for `j < k` is an involution preserving `vol ⊗ vol` (a factorwise product of swaps and identities)
and `Q_δ × Q_δ`, so Fubini on the finite measure space `Q_δ × Q_δ` turns the left side into
`∫_{Q_δ × Q_δ} h(x)`. -/
theorem dor_lmb_fcd_cp_mixed_point_integral : ∀ (m : ℕ) (δ : ℝ) (k : Fin (m + 1)) (h : Euclid (m + 1) → ℝ), IntegrableOn h {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} → ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ∫ y in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, h (WithLp.toLp 2 (fun j => if j < k then y j else x j)) = (volume {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}).toReal * ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, h x := by
  intro m δ k h hh
  set Q : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} with hQ
  -- the coordinate swap on `(Fin (m+1) → ℝ)²`
  have hτ : MeasurePreserving (fun p : (Fin (m + 1) → ℝ) × (Fin (m + 1) → ℝ) =>
      ((fun j => if j < k then p.2 j else p.1 j), (fun j => if j < k then p.1 j else p.2 j)))
      (volume.prod volume) (volume.prod volume) := by
    set A := MeasurableEquiv.arrowProdEquivProdArrow ℝ ℝ (Fin (m + 1))
    have hA : MeasurePreserving A (Measure.pi fun _ : Fin (m + 1) => (volume : Measure ℝ).prod volume)
        ((volume : Measure (Fin (m + 1) → ℝ)).prod volume) :=
      measurePreserving_arrowProdEquivProdArrow ℝ ℝ (Fin (m + 1)) (fun _ => volume) (fun _ => volume)
    let f : Fin (m + 1) → ℝ × ℝ → ℝ × ℝ := fun j => if j < k then Prod.swap else id
    have hf : ∀ j, MeasurePreserving (f j) ((volume : Measure ℝ).prod volume)
        ((volume : Measure ℝ).prod volume) := by
      intro j
      by_cases hj : j < k
      · simp only [f, hj, ite_true]
        exact Measure.measurePreserving_swap
      · simp only [f, hj, ite_false]
        exact MeasurePreserving.id _
    have hP := measurePreserving_pi (fun _ : Fin (m + 1) => (volume : Measure ℝ).prod volume)
      (fun _ : Fin (m + 1) => (volume : Measure ℝ).prod volume) hf
    have hcomp := (hA.comp hP).comp hA.symm
    convert hcomp using 1
    funext p
    ext j
    · by_cases hj : j < k <;>
        simp [A, f, hj, MeasurableEquiv.arrowProdEquivProdArrow, Equiv.arrowProdEquivProdArrow]
    · by_cases hj : j < k <;>
        simp [A, f, hj, MeasurableEquiv.arrowProdEquivProdArrow, Equiv.arrowProdEquivProdArrow]
  -- the same swap on `Euclid (m+1) × Euclid (m+1)`
  set σ : Euclid (m + 1) × Euclid (m + 1) → Euclid (m + 1) × Euclid (m + 1) := fun p =>
    (WithLp.toLp 2 (fun j => if j < k then p.2 j else p.1 j),
      WithLp.toLp 2 (fun j => if j < k then p.1 j else p.2 j)) with hσdef
  have hσ : MeasurePreserving σ (volume.prod volume) (volume.prod volume) := by
    have h1 := (PiLp.volume_preserving_ofLp (Fin (m + 1))).prod (PiLp.volume_preserving_ofLp (Fin (m + 1)))
    have h2 := (PiLp.volume_preserving_toLp (Fin (m + 1))).prod (PiLp.volume_preserving_toLp (Fin (m + 1)))
    have := (h2.comp hτ).comp h1
    convert this using 1
    funext p
    rfl
  have hσσ : ∀ p, σ (σ p) = p := by
    intro p
    ext j
    · by_cases hj : j < k <;> simp [hσdef, hj]
    · by_cases hj : j < k <;> simp [hσdef, hj]
  let σe : (Euclid (m + 1) × Euclid (m + 1)) ≃ᵐ (Euclid (m + 1) × Euclid (m + 1)) :=
    { toFun := σ
      invFun := σ
      left_inv := hσσ
      right_inv := hσσ
      measurable_toFun := hσ.measurable
      measurable_invFun := hσ.measurable }
  have hemb : MeasurableEmbedding σ := σe.measurableEmbedding
  have hpre : σ ⁻¹' (Q ×ˢ Q) = Q ×ˢ Q := by
    ext p
    simp only [mem_preimage, mem_prod, hQ, mem_ofPred_eq, hσdef]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨fun i => ?_, fun i => ?_⟩
      · by_cases hi : i < k
        · simpa [hi] using h2 i
        · simpa [hi] using h1 i
      · by_cases hi : i < k
        · simpa [hi] using h1 i
        · simpa [hi] using h2 i
    · rintro ⟨h1, h2⟩
      refine ⟨fun i => ?_, fun i => ?_⟩
      · by_cases hi : i < k
        · simpa [hi] using h2 i
        · simpa [hi] using h1 i
      · by_cases hi : i < k
        · simpa [hi] using h1 i
        · simpa [hi] using h2 i
  have hQm : MeasurableSet Q := by
    have : Q = ⋂ i, ({y : Euclid (m + 1) | δ < y i} ∩ {y | y i < 1 - δ}) := by
      ext y; simp [hQ]
    rw [this]
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const (by fun_prop)).inter (measurableSet_lt (by fun_prop) measurable_const)
  have hσQ : MeasurePreserving σ ((volume.prod volume).restrict (Q ×ˢ Q))
      ((volume.prod volume).restrict (Q ×ˢ Q)) := by
    have := hσ.restrict_preimage_emb hemb (Q ×ˢ Q)
    rwa [hpre] at this
  have hrestr : (volume.restrict Q).prod (volume.restrict Q) =
      ((volume : Measure (Euclid (m + 1))).prod volume).restrict (Q ×ˢ Q) :=
    Measure.prod_restrict Q Q
  have hQfin : volume Q ≠ ∞ := by
    have hb : Bornology.IsBounded Q := by
      rw [Metric.isBounded_iff_subset_closedBall (0 : Euclid (m + 1))]
      refine ⟨Real.sqrt (((m : ℝ) + 1) * (|δ| + |1 - δ|) ^ 2), fun y hy => ?_⟩
      rw [mem_closedBall, dist_zero_right, EuclideanSpace.norm_eq]
      apply Real.sqrt_le_sqrt
      calc ∑ i, ‖y i‖ ^ 2 ≤ ∑ _i : Fin (m + 1), (|δ| + |1 - δ|) ^ 2 := by
            apply Finset.sum_le_sum
            intro i _
            have := hy i
            rw [Real.norm_eq_abs]
            have h1 : |y i| ≤ |δ| + |1 - δ| := by
              rw [abs_le]
              constructor <;> cases abs_cases δ <;> cases abs_cases (1 - δ) <;> linarith [this.1, this.2]
            exact pow_le_pow_left₀ (abs_nonneg _) h1 2
        _ = ((m : ℝ) + 1) * (|δ| + |1 - δ|) ^ 2 := by simp
    exact hb.measure_lt_top.ne
  have hfin : IsFiniteMeasure (volume.restrict Q) := isFiniteMeasure_restrict.2 hQfin
  -- integrability of `p ↦ h p.1` on `Q × Q`
  have hint1 : Integrable (fun p : Euclid (m + 1) × Euclid (m + 1) => h p.1)
      ((volume.restrict Q).prod (volume.restrict Q)) := hh.comp_fst (volume.restrict Q)
  have hint2 : Integrable (fun p => h (σ p).1) ((volume.restrict Q).prod (volume.restrict Q)) := by
    rw [hrestr] at hint1 ⊢
    exact (hσQ.integrable_comp_emb hemb).2 hint1
  -- compute
  have e1 : ∫ x in Q, ∫ y in Q, h (WithLp.toLp 2 (fun j => if j < k then y j else x j)) =
      ∫ p, h (σ p).1 ∂((volume.restrict Q).prod (volume.restrict Q)) := by
    rw [integral_prod _ hint2]
  have e2 : ∫ p, h (σ p).1 ∂((volume.restrict Q).prod (volume.restrict Q)) =
      ∫ p, h p.1 ∂((volume.restrict Q).prod (volume.restrict Q)) := by
    rw [hrestr]
    exact hσQ.integral_comp hemb (fun p => h p.1)
  have e3 : ∫ p, h p.1 ∂((volume.restrict Q).prod (volume.restrict Q)) =
      (volume Q).toReal * ∫ x in Q, h x := by
    rw [integral_prod _ hint1]
    simp only [integral_const, Measure.real, smul_eq_mul, Measure.restrict_apply MeasurableSet.univ,
      univ_inter]
    rw [integral_const_mul]
  rw [e1, e2, e3]
/-- Fubini along the `k`-th coordinate of the cube `Q_δ = (δ, 1 − δ)^{m+1}` (Simon Ch. 2,
proof of Lemma 2.7): for `h` integrable on `Q_δ`,
`∫_{Q_δ} ∫_δ^{1−δ} h(x[k ↦ t]) dt dx = (1 − 2δ) ∫_{Q_δ} h`.  The slice swap
`ρ(x, t) = (x[k ↦ t], x_k)` is a measure-preserving involution of `Euclid (m + 1) × ℝ` that maps
`Q_δ × (δ, 1 − δ)` onto itself. -/
theorem dor_lmb_fcd_cp_slice_integral : ∀ (m : ℕ) (δ : ℝ) (k : Fin (m + 1)) (h : Euclid (m + 1) → ℝ), IntegrableOn h {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} → ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ∫ t in Ioo δ (1 - δ), h (WithLp.toLp 2 (Function.update (WithLp.ofLp x) k t)) = (1 - 2 * δ) * ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, h x := by
  intro m δ k h hh
  set Q : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} with hQ
  -- Step 0: if `δ ≥ 1/2` the cube is empty and both sides vanish.
  rcases le_or_gt (1 / 2) δ with hδ | hδ
  · have hQe : Q = ∅ := by
      ext y
      simp only [hQ, mem_ofPred_eq, mem_empty_iff_false, iff_false, not_forall]
      exact ⟨0, fun h0 => by linarith [h0.1, h0.2]⟩
    simp [hQe]
  -- Step 2: the slice swap on `(Fin (m + 1) → ℝ) × ℝ` preserves volume.  Under
  -- `piFinSuccAbove` it is `((a, b), c) ↦ ((c, b), a)`, a composition of swaps and
  -- reassociations.
  have hρ : MeasurePreserving (fun p : (Fin (m + 1) → ℝ) × ℝ => (Function.update p.1 k p.2, p.1 k))
      (volume.prod volume) (volume.prod volume) := by
    set e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (m + 1) => ℝ) k
    have he : MeasurePreserving e (volume : Measure (Fin (m + 1) → ℝ))
        ((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))) :=
      volume_preserving_piFinSuccAbove (fun _ : Fin (m + 1) => ℝ) k
    set T : (ℝ × (Fin m → ℝ)) × ℝ → (ℝ × (Fin m → ℝ)) × ℝ := fun q => ((q.2, q.1.2), q.1.1) with hTdef
    have hT : MeasurePreserving T (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume)
        (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume) := by
      have s1 : MeasurePreserving (Prod.map Prod.swap id : (ℝ × (Fin m → ℝ)) × ℝ → ((Fin m → ℝ) × ℝ) × ℝ)
          (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume)
          (((volume : Measure (Fin m → ℝ)).prod (volume : Measure ℝ)).prod volume) :=
        Measure.measurePreserving_swap.prod (MeasurePreserving.id _)
      have s2 := measurePreserving_prodAssoc (volume : Measure (Fin m → ℝ)) (volume : Measure ℝ)
        (volume : Measure ℝ)
      have s3 : MeasurePreserving (Prod.map id Prod.swap : (Fin m → ℝ) × (ℝ × ℝ) → (Fin m → ℝ) × (ℝ × ℝ))
          ((volume : Measure (Fin m → ℝ)).prod ((volume : Measure ℝ).prod volume))
          ((volume : Measure (Fin m → ℝ)).prod ((volume : Measure ℝ).prod volume)) :=
        (MeasurePreserving.id _).prod Measure.measurePreserving_swap
      have s4 := (measurePreserving_prodAssoc (volume : Measure (Fin m → ℝ)) (volume : Measure ℝ)
        (volume : Measure ℝ)).symm
      have s5 : MeasurePreserving (Prod.map Prod.swap id : ((Fin m → ℝ) × ℝ) × ℝ → (ℝ × (Fin m → ℝ)) × ℝ)
          (((volume : Measure (Fin m → ℝ)).prod (volume : Measure ℝ)).prod volume)
          (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume) :=
        Measure.measurePreserving_swap.prod (MeasurePreserving.id _)
      have := s5.comp (s4.comp (s3.comp (s2.comp s1)))
      convert this using 1
      funext q
      rfl
    have hE2 : MeasurePreserving (e.prodCongr (MeasurableEquiv.refl ℝ))
        ((volume : Measure (Fin (m + 1) → ℝ)).prod (volume : Measure ℝ))
        (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume) :=
      he.prod (MeasurePreserving.id _)
    have hfull := (hE2.symm.comp hT).comp hE2
    convert hfull using 1
    funext p
    ext j
    · simp only [Function.comp, e, T]
      simp [MeasurableEquiv.prodCongr, MeasurableEquiv.piFinSuccAbove_symm_apply,
        MeasurableEquiv.piFinSuccAbove_apply]
    · simp [e, T, MeasurableEquiv.prodCongr, MeasurableEquiv.piFinSuccAbove_symm_apply,
        MeasurableEquiv.piFinSuccAbove_apply]
  -- Steps 1–2: the same map `ρ` on `Euclid (m + 1) × ℝ` (via `ofLp`/`toLp`) is a
  -- measure-preserving involution, hence a measurable embedding.
  set ρ : Euclid (m + 1) × ℝ → Euclid (m + 1) × ℝ := fun p =>
    (WithLp.toLp 2 (Function.update (WithLp.ofLp p.1) k p.2), p.1 k) with hρdef
  have hρE : MeasurePreserving ρ (volume.prod volume) (volume.prod volume) := by
    have h1 := (PiLp.volume_preserving_ofLp (Fin (m + 1))).prod (MeasurePreserving.id (volume : Measure ℝ))
    have h2 := (PiLp.volume_preserving_toLp (Fin (m + 1))).prod (MeasurePreserving.id (volume : Measure ℝ))
    have := (h2.comp hρ).comp h1
    convert this using 1
    funext p
    rfl
  have hρρ : ∀ p, ρ (ρ p) = p := by
    intro p
    ext j
    · by_cases hj : j = k
      · subst hj; simp [hρdef]
      · simp [hρdef]
    · simp [hρdef]
  let ρe : (Euclid (m + 1) × ℝ) ≃ᵐ (Euclid (m + 1) × ℝ) :=
    { toFun := ρ
      invFun := ρ
      left_inv := hρρ
      right_inv := hρρ
      measurable_toFun := hρE.measurable
      measurable_invFun := hρE.measurable }
  have hemb : MeasurableEmbedding ρ := ρe.measurableEmbedding
  -- Step 3: `ρ⁻¹(Q × I) = Q × I`, so `ρ` preserves `(vol⌞Q) ⊗ (vol⌞I)`.
  set I : Set ℝ := Ioo δ (1 - δ) with hI
  have hpre : ρ ⁻¹' (Q ×ˢ I) = Q ×ˢ I := by
    ext p
    simp only [mem_preimage, mem_prod, hQ, mem_ofPred_eq, hρdef, hI, mem_Ioo]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨fun i => ?_, ?_⟩
      · by_cases hi : i = k
        · subst hi; simpa using h2
        · simpa [hi] using h1 i
      · simpa using h1 k
    · rintro ⟨h1, h2⟩
      refine ⟨fun i => ?_, ?_⟩
      · by_cases hi : i = k
        · subst hi; simpa using h2
        · simpa [hi] using h1 i
      · exact h1 k
  have hρQ : MeasurePreserving ρ ((volume.prod volume).restrict (Q ×ˢ I))
      ((volume.prod volume).restrict (Q ×ˢ I)) := by
    have := hρE.restrict_preimage_emb hemb (Q ×ˢ I)
    rwa [hpre] at this
  have hrestr : (volume.restrict Q).prod (volume.restrict I) =
      ((volume : Measure (Euclid (m + 1))).prod (volume : Measure ℝ)).restrict (Q ×ˢ I) :=
    Measure.prod_restrict Q I
  -- Step 4: `(x, t) ↦ h x` and `(x, t) ↦ h (x[k ↦ t])` are integrable on `Q × I`.
  have hfinI : IsFiniteMeasure (volume.restrict I) := isFiniteMeasure_restrict.2 (by simp [hI])
  have hint1 : Integrable (fun p : Euclid (m + 1) × ℝ => h p.1)
      ((volume.restrict Q).prod (volume.restrict I)) := hh.comp_fst (volume.restrict I)
  have hint2 : Integrable (fun p => h (ρ p).1) ((volume.restrict Q).prod (volume.restrict I)) := by
    rw [hrestr] at hint1 ⊢
    exact (hρQ.integrable_comp_emb hemb).2 hint1
  -- Step 5: Fubini, the change of variables `ρ`, and `vol(I) = 1 − 2δ`.
  have e1 : ∫ x in Q, ∫ t in I, h (WithLp.toLp 2 (Function.update (WithLp.ofLp x) k t)) =
      ∫ p, h (ρ p).1 ∂((volume.restrict Q).prod (volume.restrict I)) := by
    rw [integral_prod _ hint2]
  have e2 : ∫ p, h (ρ p).1 ∂((volume.restrict Q).prod (volume.restrict I)) =
      ∫ p, h p.1 ∂((volume.restrict Q).prod (volume.restrict I)) := by
    rw [hrestr]
    exact hρQ.integral_comp hemb (fun p => h p.1)
  have e3 : ∫ p, h p.1 ∂((volume.restrict Q).prod (volume.restrict I)) =
      (1 - 2 * δ) * ∫ x in Q, h x := by
    rw [integral_prod _ hint1]
    simp only [integral_const, Measure.real, smul_eq_mul, Measure.restrict_apply MeasurableSet.univ,
      univ_inter, hI, Real.volume_Ioo]
    rw [integral_const_mul, ENNReal.toReal_ofReal (by linarith)]
    ring
  rw [e1, e2, e3]
/-- One coordinate step of the Poincaré inequality on the cube `Q_δ`: the points
`a_k(x, y)`, `b_k(x, y)` differ only in the `k`-th coordinate, so by the fundamental theorem of
calculus `|v(a_k) − v(b_k)| ≤ Φ(a_k) := ∫_{(δ, 1−δ)} |∂_k v(a_k[t])| dt`.  Integrating, the
mixed-point identity gives `∫∫ Φ(a_k) = |Q_δ| ∫_{Q_δ} Φ` and the slice identity gives
`∫_{Q_δ} Φ = (1 − 2δ) ∫_{Q_δ} |∂_k v|`. -/
theorem dor_lmb_fcd_cp_coordinate_step : ∀ (m : ℕ) (v : Euclid (m + 1) → ℝ) (δ : ℝ) (k : Fin (m + 1)), ContDiff ℝ 1 v → 0 ≤ δ → δ < 1 / 2 → ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ∫ y in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) - v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| ≤ (1 - 2 * δ) * (volume {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}).toReal * ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, |fderiv ℝ v x (EuclideanSpace.single k 1)| := by
  intro m v δ k hv _ _
  set Q : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} with hQ
  -- `Q` is open, and contained in the compact cube `K = [δ, 1 − δ]^{m+1}`.
  have hQo : IsOpen Q := by
    have hQi : Q = ⋂ i, ({y : Euclid (m + 1) | δ < y i} ∩ {y | y i < 1 - δ}) := by
      ext y
      simp [hQ]
    rw [hQi]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (PiLp.continuous_apply 2 _ i)).inter
        (isOpen_lt (PiLp.continuous_apply 2 _ i) continuous_const)
  have hQm : MeasurableSet Q := hQo.measurableSet
  set K : Set (Euclid (m + 1)) := WithLp.toLp 2 '' Set.pi univ fun _ => Icc δ (1 - δ)
  have hKc : IsCompact K :=
    (isCompact_univ_pi fun _ => isCompact_Icc).image (PiLp.continuous_toLp 2 _)
  have hQK : Q ⊆ K := fun y hy => ⟨WithLp.ofLp y, fun i _ => ⟨(hy i).1.le, (hy i).2.le⟩, rfl⟩
  -- `∂_k v` is continuous.
  have hfd : Continuous (fderiv ℝ v) := hv.continuous_fderiv one_ne_zero
  have hgc : Continuous fun p : Euclid (m + 1) => |fderiv ℝ v p (EuclideanSpace.single k 1)| :=
    (hfd.clm_apply continuous_const).abs
  -- `p[t]`, the point `p` with `k`-th coordinate `t`, is `p + (t − p_k) e_k`.
  have hupd : ∀ (p : Euclid (m + 1)) (t : ℝ),
      WithLp.toLp 2 (Function.update (WithLp.ofLp p) k t) =
        p + (t - p k) • EuclideanSpace.single k (1 : ℝ) := by
    intro p t
    ext j
    by_cases hj : j = k
    · subst hj
      simp
    · simp [hj]
  -- `Φ(p) = ∫_{(δ, 1−δ)} |∂_k v(p[t])| dt` is continuous.
  set Φ : Euclid (m + 1) → ℝ := fun p => ∫ t in Ioo δ (1 - δ),
    |fderiv ℝ v (WithLp.toLp 2 (Function.update (WithLp.ofLp p) k t)) (EuclideanSpace.single k 1)|
    with hΦ
  have hΦc : Continuous Φ := by
    have hGc : Continuous fun z : Euclid (m + 1) × ℝ =>
        |fderiv ℝ v (WithLp.toLp 2 (Function.update (WithLp.ofLp z.1) k z.2))
          (EuclideanSpace.single k 1)| := by
      simp_rw [hupd]
      exact hgc.comp (by fun_prop)
    have hΦ' : Φ = fun p => ∫ t in Icc δ (1 - δ),
        |fderiv ℝ v (WithLp.toLp 2 (Function.update (WithLp.ofLp p) k t))
          (EuclideanSpace.single k 1)| := by
      funext p
      exact integral_Icc_eq_integral_Ioo.symm
    rw [hΦ']
    exact continuous_parametric_integral_of_continuous
      (f := fun p t => |fderiv ℝ v (WithLp.toLp 2 (Function.update (WithLp.ofLp p) k t))
        (EuclideanSpace.single k 1)|) hGc isCompact_Icc
  -- `(x, y) ↦ Φ(a_k(x, y))` is continuous.
  have hac : Continuous fun z : Euclid (m + 1) × Euclid (m + 1) =>
      (WithLp.toLp 2 (fun j => if j < k then z.2 j else z.1 j) : Euclid (m + 1)) := by
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun j => ?_)
    exact continuous_if_const _ (fun _ => by fun_prop) (fun _ => by fun_prop)
  have hFc : Continuous fun z : Euclid (m + 1) × Euclid (m + 1) =>
      Φ (WithLp.toLp 2 (fun j => if j < k then z.2 j else z.1 j)) := hΦc.comp hac
  -- Integrability: continuous functions are integrable on the compact `K ⊇ Q`.
  have hI1 : IntegrableOn (fun p => |fderiv ℝ v p (EuclideanSpace.single k 1)|) Q :=
    (hgc.continuousOn.integrableOn_compact hKc).mono_set hQK
  have hI2 : IntegrableOn Φ Q := (hΦc.continuousOn.integrableOn_compact hKc).mono_set hQK
  have hI3 : ∀ x : Euclid (m + 1), IntegrableOn
      (fun y : Euclid (m + 1) => Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j))) Q :=
    fun x => ((hFc.comp (continuous_const.prodMk continuous_id)).continuousOn.integrableOn_compact
      hKc).mono_set hQK
  have hI4 : IntegrableOn (fun x : Euclid (m + 1) =>
      ∫ y in Q, Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j))) Q := by
    have hprod : Integrable (fun z : Euclid (m + 1) × Euclid (m + 1) =>
        Φ (WithLp.toLp 2 (fun j => if j < k then z.2 j else z.1 j)))
        ((volume.restrict Q).prod (volume.restrict Q)) := by
      rw [Measure.prod_restrict]
      exact (hFc.continuousOn.integrableOn_compact (hKc.prod hKc)).mono_set (prod_mono hQK hQK)
    exact hprod.integral_prod_left
  -- Step 1: the fundamental theorem of calculus along `t ↦ a_k[t]`.
  have hpt : ∀ x ∈ Q, ∀ y ∈ Q,
      |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| ≤
        Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j)) := by
    intro x hx y hy
    set a : Euclid (m + 1) := WithLp.toLp 2 (fun j => if j < k then y j else x j) with ha
    set ℓ : ℝ → Euclid (m + 1) := fun t => a + (t - a k) • EuclideanSpace.single k (1 : ℝ)
      with hℓ
    have hak : a k = x k := by simp [ha]
    have hℓx : ℓ (x k) = a := by simp [hℓ, hak]
    have hℓy : ℓ (y k) = WithLp.toLp 2 (fun j => if j ≤ k then y j else x j) := by
      ext j
      rcases lt_trichotomy j k with h | h | h
      · simp [hℓ, ha, h, le_of_lt h, ne_of_lt h]
      · subst h
        simp [hℓ, ha]
      · simp [hℓ, ha, not_lt.2 (le_of_lt h), not_le.2 h, (ne_of_lt h).symm]
    have hℓd : ∀ t, HasDerivAt ℓ (EuclideanSpace.single k (1 : ℝ)) t := by
      intro t
      have := (((hasDerivAt_id' t).sub_const (a k)).smul_const
        (EuclideanSpace.single k (1 : ℝ))).const_add a
      rw [one_smul] at this
      exact this
    have hderiv : ∀ t, HasDerivAt (fun t => v (ℓ t))
        (fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)) t := fun t =>
      ((hv.differentiable one_ne_zero (ℓ t)).hasFDerivAt).comp_hasDerivAt t (hℓd t)
    have hcont : Continuous fun t => fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1) :=
      (hfd.comp (by fun_prop)).clm_apply continuous_const
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hderiv t)
      (hcont.intervalIntegrable (x k) (y k))
    simp only [hℓx, hℓy] at hftc
    have hsub : Set.uIoc (x k) (y k) ⊆ Ioo δ (1 - δ) := by
      intro t ht
      rcases Set.mem_uIoc.1 ht with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact ⟨by linarith [(hx k).1], by linarith [(hy k).2]⟩
      · exact ⟨by linarith [(hy k).1], by linarith [(hx k).2]⟩
    rw [abs_sub_comm, ← hftc]
    calc |∫ t in x k..y k, fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)|
        = ‖∫ t in x k..y k, fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)‖ :=
          (Real.norm_eq_abs _).symm
      _ ≤ ∫ (t : ℝ) in Set.uIoc (x k) (y k), ‖fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)‖ :=
          intervalIntegral.norm_integral_le_integral_norm_uIoc
      _ ≤ ∫ (t : ℝ) in Ioo δ (1 - δ), ‖fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)‖ :=
          setIntegral_mono_set
            (hcont.norm.continuousOn.integrableOn_Icc.mono_set Ioo_subset_Icc_self)
            (Eventually.of_forall fun t => norm_nonneg _) hsub.eventuallyLE
      _ = Φ a := by
          simp only [hΦ, hℓ, ← hupd, Real.norm_eq_abs]
  -- Step 3: integrate the pointwise bound.
  have hstep : ∫ x in Q, ∫ y in Q, |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| ≤
      ∫ x in Q, ∫ y in Q, Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j)) := by
    refine integral_mono_of_nonneg
      (Eventually.of_forall fun x => integral_nonneg fun y => abs_nonneg _) hI4 ?_
    filter_upwards [ae_restrict_mem hQm] with x hx
    refine integral_mono_of_nonneg (Eventually.of_forall fun y => abs_nonneg _) (hI3 x) ?_
    filter_upwards [ae_restrict_mem hQm] with y hy
    exact hpt x hx y hy
  -- Steps 4–6: the mixed-point and slice identities.
  calc _ ≤ ∫ x in Q, ∫ y in Q, Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j)) := hstep
    _ = (volume Q).toReal * ∫ x in Q, Φ x :=
        Submission.dor_lmb_fcd_cp_mixed_point_integral m δ k Φ hI2
    _ = (volume Q).toReal *
        ((1 - 2 * δ) * ∫ x in Q, |fderiv ℝ v x (EuclideanSpace.single k 1)|) := by
        congr 1
        exact Submission.dor_lmb_fcd_cp_slice_integral m δ k
          (fun p => |fderiv ℝ v p (EuclideanSpace.single k 1)|) hI1
    _ = _ := by ring
/-- **Poincaré inequality on the cube `Q_δ = (δ, 1 − δ)^{m+1}` for `C¹` functions** (the "usual
Poincaré inequality for smooth functions" invoked in Simon Ch. 2, proof of Lemma 2.7, here on a
cube of side `1 − 2δ`):
`∫_Q ∫_Q |v(x) − v(y)| dy dx ≤ (m + 1)(1 − 2δ) Lⁿ(Q) ∫_Q ‖Dv‖`.  Along the coordinate path from
`x` to `y`, `v x − v y` telescopes into the `m + 1` coordinate steps bounded by
`dor_lmb_fcd_cp_coordinate_step`; every integrand is continuous on the compact cube
`[δ, 1 − δ]^{m+1} ⊇ Q`, hence integrable, and `|Dv(x) eₖ| ≤ ‖Dv(x)‖`. -/
theorem dor_lmb_fcd_cp_smooth_poincare : ∀ (m : ℕ) (v : Euclid (m + 1) → ℝ) (δ : ℝ), ContDiff ℝ 1 v → 0 ≤ δ → δ < 1 / 2 → ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ∫ y in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, |v x - v y| ≤ ((m : ℝ) + 1) * (1 - 2 * δ) * (volume {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}).toReal * ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ‖fderiv ℝ v x‖ := by
  intro m v δ hv hδ0 hδ
  -- Step 1: telescoping along the coordinate path `W₀ = x, …, W_{m+1} = y`
  have htel : ∀ x y : Euclid (m + 1), v x - v y = ∑ k : Fin (m + 1),
      (v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))) := by
    intro x y
    set W : ℕ → Euclid (m + 1) :=
      fun n => WithLp.toLp 2 (fun j => if (j : ℕ) < n then y j else x j) with hW
    have h0 : W 0 = x := by
      simp [hW]
    have hN : W (m + 1) = y := by
      have hlt : ∀ j : Fin (m + 1), (j : ℕ) < m + 1 := fun j => j.is_lt
      simp only [hW, hlt, ite_true]
    have hk : ∀ k : Fin (m + 1),
        v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
          v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j)) = v (W k) - v (W (k + 1)) := by
      intro k
      have e1 : (fun j : Fin (m + 1) => if j < k then y j else x j) =
          (fun j : Fin (m + 1) => if (j : ℕ) < (k : ℕ) then y j else x j) := by
        funext j
        simp only [Fin.lt_def]
      have e2 : (fun j : Fin (m + 1) => if j ≤ k then y j else x j) =
          (fun j : Fin (m + 1) => if (j : ℕ) < (k : ℕ) + 1 then y j else x j) := by
        funext j
        simp only [Fin.le_iff_val_le_val, Nat.lt_succ_iff]
      rw [e1, e2]
    rw [Finset.sum_congr rfl (fun k _ => hk k),
      Fin.sum_univ_eq_sum_range (fun n => v (W n) - v (W (n + 1))) (m + 1),
      Finset.sum_range_sub', h0, hN]
  have habs : ∀ x y : Euclid (m + 1), |v x - v y| ≤ ∑ k : Fin (m + 1),
      |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| := by
    intro x y
    rw [htel x y]
    exact Finset.abs_sum_le_sum_abs _ _
  -- Step 2: integrability; `Q_δ` lies in the compact cube `K = [δ, 1 − δ]^{m+1}`
  set Q : Set (Euclid (m + 1)) := {y | ∀ i, δ < y i ∧ y i < 1 - δ}
  set K : Set (Euclid (m + 1)) := {y | ∀ i, δ ≤ y i ∧ y i ≤ 1 - δ}
  have hQK : Q ⊆ K := fun y hy i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hKc : IsCompact K := by
    have hKeq : K = WithLp.toLp 2 '' Set.pi univ (fun _ : Fin (m + 1) => Icc δ (1 - δ)) := by
      ext y
      constructor
      · intro hy
        exact ⟨WithLp.ofLp y, fun i _ => hy i, rfl⟩
      · rintro ⟨z, hz, rfl⟩ i
        exact hz i (mem_univ i)
    rw [hKeq]
    exact (isCompact_univ_pi fun _ => isCompact_Icc).image (PiLp.continuous_toLp 2 _)
  have hint : ∀ g : Euclid (m + 1) → ℝ, Continuous g → IntegrableOn g Q :=
    fun g hg => (hg.continuousOn.integrableOn_compact hKc).mono_set hQK
  have hint2 : ∀ F : Euclid (m + 1) × Euclid (m + 1) → ℝ, Continuous F →
      Integrable F ((volume.restrict Q).prod (volume.restrict Q)) := by
    intro F hF
    rw [Measure.prod_restrict]
    exact (hF.continuousOn.integrableOn_compact (hKc.prod hKc)).mono_set (prod_mono hQK hQK)
  -- the coordinate points depend continuously on `(x, y)`
  have hlt : ∀ k : Fin (m + 1), Continuous fun p : Euclid (m + 1) × Euclid (m + 1) =>
      (WithLp.toLp 2 (fun j => if j < k then p.2 j else p.1 j) : Euclid (m + 1)) := by
    intro k
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun j => ?_)
    exact continuous_if_const _ (fun _ => (PiLp.continuous_apply 2 _ j).comp continuous_snd)
      fun _ => (PiLp.continuous_apply 2 _ j).comp continuous_fst
  have hle : ∀ k : Fin (m + 1), Continuous fun p : Euclid (m + 1) × Euclid (m + 1) =>
      (WithLp.toLp 2 (fun j => if j ≤ k then p.2 j else p.1 j) : Euclid (m + 1)) := by
    intro k
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun j => ?_)
    exact continuous_if_const _ (fun _ => (PiLp.continuous_apply 2 _ j).comp continuous_snd)
      fun _ => (PiLp.continuous_apply 2 _ j).comp continuous_fst
  have hF0 : Continuous fun p : Euclid (m + 1) × Euclid (m + 1) => |v p.1 - v p.2| :=
    ((hv.continuous.comp continuous_fst).sub (hv.continuous.comp continuous_snd)).abs
  have hFk : ∀ k : Fin (m + 1), Continuous fun p : Euclid (m + 1) × Euclid (m + 1) =>
      |v (WithLp.toLp 2 (fun j => if j < k then p.2 j else p.1 j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then p.2 j else p.1 j))| :=
    fun k => ((hv.continuous.comp (hlt k)).sub (hv.continuous.comp (hle k))).abs
  have hfac : 0 ≤ (1 - 2 * δ) * (volume Q).toReal :=
    mul_nonneg (by linarith) ENNReal.toReal_nonneg
  -- Steps 3–4: integrate the telescoping bound, apply `coordinate_step`, and `|Dv eₖ| ≤ ‖Dv‖`
  calc ∫ x in Q, ∫ y in Q, |v x - v y|
      ≤ ∫ x in Q, ∑ k : Fin (m + 1), ∫ y in Q,
          |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
            v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| := by
        refine integral_mono (hint2 _ hF0).integral_prod_left
          (integrable_finsetSum _ fun k _ => (hint2 _ (hFk k)).integral_prod_left) fun x => ?_
        have hx : ∀ k : Fin (m + 1), IntegrableOn (fun y : Euclid (m + 1) =>
            |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
              v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))|) Q :=
          fun k => hint _ ((hFk k).comp (Continuous.prodMk_right x))
        exact (integral_mono (hint _ (hF0.comp (Continuous.prodMk_right x)))
          (integrable_finsetSum _ fun k _ => hx k) (habs x)).trans_eq
          (integral_finsetSum _ fun k _ => hx k)
    _ = ∑ k : Fin (m + 1), ∫ x in Q, ∫ y in Q,
          |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
            v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| :=
        integral_finsetSum _ fun k _ => (hint2 _ (hFk k)).integral_prod_left
    _ ≤ ∑ k : Fin (m + 1), (1 - 2 * δ) * (volume Q).toReal *
          ∫ x in Q, |fderiv ℝ v x (EuclideanSpace.single k 1)| :=
        Finset.sum_le_sum fun k _ => Submission.dor_lmb_fcd_cp_coordinate_step m v δ k hv hδ0 hδ
    _ ≤ ∑ _k : Fin (m + 1), (1 - 2 * δ) * (volume Q).toReal * ∫ x in Q, ‖fderiv ℝ v x‖ := by
        refine Finset.sum_le_sum fun k _ => mul_le_mul_of_nonneg_left ?_ hfac
        have hDv : Continuous (fderiv ℝ v) := hv.continuous_fderiv one_ne_zero
        refine integral_mono (hint _ (hDv.clm_apply continuous_const).abs) (hint _ hDv.norm)
          fun x => ?_
        calc |fderiv ℝ v x (EuclideanSpace.single k 1)|
            = ‖fderiv ℝ v x (EuclideanSpace.single k 1)‖ := (Real.norm_eq_abs _).symm
          _ ≤ ‖fderiv ℝ v x‖ * ‖EuclideanSpace.single k (1 : ℝ)‖ := (fderiv ℝ v x).le_opNorm _
          _ = ‖fderiv ℝ v x‖ := by simp
    _ = ((m : ℝ) + 1) * (1 - 2 * δ) * (volume Q).toReal * ∫ x in Q, ‖fderiv ℝ v x‖ := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        push_cast
        ring
/-- Simon Ch. 2, Lemma 2.5 on the cube `Q₁ = (0, 1)^{m+1}`: if `∫_{Q₁} u div g ≤ V` for every
smooth `g` with compact support in `Q₁` and `|g| ≤ 1`, then `u_η = η * 1_{Q₁} u` is smooth and
`∫_{Q_δ} |Du_η| ≤ V` whenever `spt η ⊆ B_δ(0)`.  For `g` with compact support in `Q_δ`, the
mollified field `G = η * g` is admissible, and `∫ Du_η · g = −∫_{Q₁} u div G = ∫_{Q₁} u div(−G)`. -/
theorem dor_lmb_fcd_cp_mollified_variation : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ) (V δ : ℝ) (η : Euclid (m + 1) → ℝ), IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → 0 < δ → ContDiff ℝ (⊤ : ℕ∞) η → HasCompactSupport η → (∀ z, 0 ≤ η z) → (∀ z, η (-z) = η z) → ∫ z, η z = 1 → support η ⊆ ball (0 : Euclid (m + 1)) δ → ContDiff ℝ (⊤ : ℕ∞) (convolution η (Set.indicator {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} u) (ContinuousLinearMap.lsmul ℝ ℝ) volume) ∧ ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ‖fderiv ℝ (convolution η (Set.indicator {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} u) (ContinuousLinearMap.lsmul ℝ ℝ) volume) x‖ ≤ V := by
  intro m u V δ η hu hH hδ hη hηc hη0 heven hη1 hηs
